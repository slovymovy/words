                    {
                        "sense_id": "87c899a5-7a1c-36af-87c8-ae52c5af2f74",
                        "entry_id": "2bb3a756-d5e7-3f6b-8b28-b9d437e6521d",
                        "glosses": [
                            "een draaiende, trechtervormige uitstulping onder een wolk tijdens een onweersbui"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "718f5ae6-de22-4528-ab78-938df8c2a481",
                                "sense_id": "87c899a5-7a1c-36af-87c8-ae52c5af2f74",
                                "text": "De tornado's raasden over de vlakten van Kansas en Nebraska."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63d71e5d-0ba3-4c71-8675-5d8a7c9c527c",
                        "source_entry_id": "2bb3a756-d5e7-3f6b-8b28-b9d437e6521d",
                        "source_sense_id": "87c899a5-7a1c-36af-87c8-ae52c5af2f74",
                        "source_sense_description": "een draaiende, trechtervormige uitstulping onder een wolk tijdens een onweersbui",
                        "target_lang_word": "Tornado",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tornado",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                        "entry_id": "5688bc98-c509-3be7-82ff-1e6c99955428",
                                        "glosses": [
                                            "kleinräumiger Wirbelsturm, der in einer Superzelle entstehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbfff7dc-e74d-42b2-8b14-6c1f261e414f",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "Der letzte Tornado zerstörte viele Häuser."
                                            },
                                            {
                                                "example_id": "4d386fe9-4646-4460-acf2-b88c86ca21a4",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Wasserhosen sind Luftwirbel, ähnlich wie Tornados, aber kleiner und nicht so zerstörerisch.“"
                                            },
                                            {
                                                "example_id": "e482e4a7-e5c2-4396-8f98-529710d1152c",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Nun kroch ich auf der Oberseite des Schanzkleids nach achtern, inmitten eines unglaublich schrecklichen und höllischen Getöses aus Donner und Geschrei und grellen Blitzen, während der Wind die ganze Zeit wie ein Tornado blies.“"
                                            },
                                            {
                                                "example_id": "c5fa7107-ca65-4e56-828f-f8d08fbdbd84",
                                                "sense_id": "fc20a71c-bf6b-3870-bded-a57d5cdd5ef1",
                                                "text": "„Tornados ebneten weite Landstriche ein, Tausende von Menschen kamen zu Land und zu Wasser um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f54875b4-fe96-3d78-951c-e1a6626e3a3e",
                                        "entry_id": "5688bc98-c509-3be7-82ff-1e6c99955428",
                                        "glosses": [
                                            "Katamaran für zwei Personen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "52cfb66a-899c-365a-b76d-e6ac0828055b",
                                        "entry_id": "5688bc98-c509-3be7-82ff-1e6c99955428",
                                        "glosses": [
                                            "Kampfflugzeug der NATO"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6320bb7-f458-4886-96b0-47602cbc6e93",
                                                "sense_id": "52cfb66a-899c-365a-b76d-e6ac0828055b",
                                                "text": "Er stürzte aus unerklärlichen Gründen mit seinem Tornado ab."
                                            },
                                            {
                                                "example_id": "bfe7ab7c-1aff-431c-8b54-2beec3349eed",
                                                "sense_id": "52cfb66a-899c-365a-b76d-e6ac0828055b",
                                                "text": "„2007 sagte die Bundesregierung auf Anfrage der NATO die Entsendung von Tornados zu; im Juni 2008 stellte die Bundeswehr eine schnelle Einsatztruppe für Nordafghanistan, die konkret für Kampfeinsätze vorgesehen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dfb2cbbb-3448-475d-9a36-9fd1cb59f543",
                        "source_entry_id": "2bb3a756-d5e7-3f6b-8b28-b9d437e6521d",
                        "source_sense_id": "87c899a5-7a1c-36af-87c8-ae52c5af2f74",
                        "source_sense_description": "een draaiende, trechtervormige uitstulping onder een wolk tijdens een onweersbui",
                        "target_lang_word": "tornado",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tornado",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7eb07b7-073c-3eff-b3e1-bdcf97677e78",
                                        "entry_id": "3f1f14db-3a14-3e10-91ab-e9ed213dc91e",
                                        "glosses": [
                                            "A violent wind in the form of a mobile, rapidly rotating, funnel cloud that has contacted the ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289da82c-568a-4dc9-a230-02a55ae5d1da",
                                                "sense_id": "c7eb07b7-073c-3eff-b3e1-bdcf97677e78",
                                                "text": "An extreme version of vorticity is a vortex. The vortex is a spinning, cyclonic mass of fluid, which can be observed in the rotation of water going down a drain, as well as in smoke rings, tornados and hurricanes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tornado",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0996226-1759-3d95-8f23-78e5cf66bed0",
                                        "entry_id": "2618e014-90a6-34e0-b32f-c4634721569b",
                                        "glosses": [
                                            "To sweep through something violently."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3eb0355-5c83-4b01-a931-edde9b974f7b",
                                                "sense_id": "a0996226-1759-3d95-8f23-78e5cf66bed0",
                                                "text": "And so on Friday nights, James Torin tornadoed through six beers, a carton of cigarettes, a coffee table littered with lottery tickets, and unrequited dreams."
                                            },
                                            {
                                                "example_id": "27dc917b-840a-4c64-8d7a-3495e074e363",
                                                "sense_id": "a0996226-1759-3d95-8f23-78e5cf66bed0",
                                                "text": "They come every night,\nthose cavernous trains, tornadoing\nthe frozen house,\na madness feeling for the door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fc7ea4-ac31-4bea-ad07-2ecc92145b73",
                        "source_entry_id": "2bb3a756-d5e7-3f6b-8b28-b9d437e6521d",
                        "source_sense_id": "87c899a5-7a1c-36af-87c8-ae52c5af2f74",
                        "source_sense_description": "een draaiende, trechtervormige uitstulping onder een wolk tijdens een onweersbui",
                        "target_lang_word": "tornade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tornade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c365480f-8e47-34d8-a68a-5e90aa4d87bf",
                                        "entry_id": "fd35abdb-be3e-3ba0-9798-f9f46e7744d1",
                                        "glosses": [
                                            "Bourrasque violente en tourbillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6242f9c5-7ca9-4000-a950-b4998cd2dab3",
                                                "sense_id": "c365480f-8e47-34d8-a68a-5e90aa4d87bf",
                                                "text": "Mais qu’une tornade, qu’un grain même éclatât à ce moment, et c’était la mort presque immédiate."
                                            },
                                            {
                                                "example_id": "beb18f27-0873-4602-8907-8b7213e0ef77",
                                                "sense_id": "c365480f-8e47-34d8-a68a-5e90aa4d87bf",
                                                "text": "Lorsque je me suis retournée, j'ai aperçu Mina qui se dirigeait vers moi à la vitesse d'une tornade, le foulard bleu pétrole noué autour de son cou se soulevant comme les ailes d'un oiseau."
                                            },
                                            {
                                                "example_id": "fdab25d0-8a11-4302-a368-02b2bae101c3",
                                                "sense_id": "c365480f-8e47-34d8-a68a-5e90aa4d87bf",
                                                "text": "T'as vu tes slibars ? On dirait les voiles d'un trois-mâts après une tornade. Et ton odeur de crabe moisi, t'as senti ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29d1dbe2-d66e-3857-a864-344850e5f5d9",
                                        "entry_id": "fd35abdb-be3e-3ba0-9798-f9f46e7744d1",
                                        "glosses": [
                                            "Quelque chose qui emporte par sa violence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a792e89-d63d-47b7-bd0b-d3322ed43147",
                                                "sense_id": "29d1dbe2-d66e-3857-a864-344850e5f5d9",
                                                "text": "Au Mexique, ils en ont de plus piquants [des piments], une vraie tornade infernale que l’on met dans tous les plats, parfois même dans la salade de fruits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
