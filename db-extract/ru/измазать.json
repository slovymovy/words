                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2faf23be-9ae8-4ac9-a11d-8e9cb2da0ece",
                                "sense_id": "1c3ddf87-e41e-3ce4-b67a-dba4b15f47ee",
                                "text": "Матрёна бе́гала среди́ мужчи́н, суети́лась и помога́ла нака́тывать брёвна на са́ни. Тут заме́тил я, что она́ в мое́й телогре́йке, уже́ изма́зала рукава́ о льди́стую грязь брёвен",
                                "translation": "Matryona ran among the men, chitchatted and helped rolling logs up to the sleigh, whereupon I noticed she was wearing my padded jacket and had already smeared its sleeves with the logs' iced dirt",
                                "english": "Matryona ran among the men, chitchatted and helped rolling logs up to the sleigh, whereupon I noticed she was wearing my padded jacket and had already smeared its sleeves with the logs' iced dirt"
                            }
                        ]
