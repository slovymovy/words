                ],
                "senses": [
                    {
                        "sense_id": "b4c7f278-5068-34c2-9e18-a33d24bc569e",
                        "entry_id": "d0cd0256-318f-375d-a2f8-f6af8d9fe554",
                        "glosses": [
                            "dąs"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a1f8fb35-5716-41ca-acb5-2fc96f8d000d",
                                "sense_id": "b4c7f278-5068-34c2-9e18-a33d24bc569e",
                                "text": "Nie strzelaj mi tu fochów gówniarzu, gdy do ciebie mówię!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "570e28a3-475e-360c-8297-dc032e5f5258",
                        "entry_id": "d0cd0256-318f-375d-a2f8-f6af8d9fe554",
                        "glosses": [
                            "figiel"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14885c09-2007-4278-8ac3-bc8044cc07ec",
                        "source_entry_id": "d0cd0256-318f-375d-a2f8-f6af8d9fe554",
                        "source_sense_id": "b4c7f278-5068-34c2-9e18-a33d24bc569e",
                        "target_lang_word": "sulk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sulk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c42d380d-ab78-3b14-aa3b-02a5d7459380",
                                        "entry_id": "084b37d8-306d-38d9-9a36-5d6fb2da38c6",
                                        "glosses": [
                                            "To express ill humor or offence by remaining sullenly silent or withdrawn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12a6617b-8c77-4842-8acf-ae65857fc675",
                                                "sense_id": "c42d380d-ab78-3b14-aa3b-02a5d7459380",
                                                "text": "Mr. Riach, who had been to the college, spoke to me like a friend when he was not sulking, and told me many curious things, […]"
                                            },
                                            {
                                                "example_id": "64b206a0-cec5-4b86-808b-79837a1c5ff1",
                                                "sense_id": "c42d380d-ab78-3b14-aa3b-02a5d7459380",
                                                "text": "You crossed her last wish in death and yet you sulk with me because I don’t whinge like some hired mute from Lalouette’s."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sulk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba94929-7580-3e44-b118-15f3c023f9e2",
                                        "entry_id": "6ecf9aea-1cdb-3cf1-bdf7-d1fc26fca843",
                                        "glosses": [
                                            "A state of sulking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a3dc42-da11-4e48-b498-f5d6c2e46121",
                                                "sense_id": "0ba94929-7580-3e44-b118-15f3c023f9e2",
                                                "text": "Leo has been in a sulk all morning."
                                            },
                                            {
                                                "example_id": "f416a89d-4d8f-4b9c-89e8-0cedf6056747",
                                                "sense_id": "0ba94929-7580-3e44-b118-15f3c023f9e2",
                                                "text": "He thanks our miserable Liberal agent, an unbeliever called Donald Somebody, see the caption, who since the court's arrival on his territory has retired into a fuming sulk from which he has only tonight emerged."
                                            },
                                            {
                                                "example_id": "290c8cd7-bc27-4ee7-9c12-d536729c870a",
                                                "sense_id": "0ba94929-7580-3e44-b118-15f3c023f9e2",
                                                "text": "\"[…] home during the holidays,\" said the Doctor with a good-humoured laugh, \"but a fit of the sulks is no very uncommon thing for him;\" and then he added,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6066d5c-ac0e-3688-be2a-7edf8a23bcfb",
                                        "entry_id": "6ecf9aea-1cdb-3cf1-bdf7-d1fc26fca843",
                                        "glosses": [
                                            "A fit of sulking; a sulking mood."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5d7b1c0-e1c2-45c1-bbde-003524cddc46",
                                                "sense_id": "a6066d5c-ac0e-3688-be2a-7edf8a23bcfb",
                                                "text": "The Puddin', who had got the sulks over Sam's remark that fifteen goes of steak and kidney were enough for any self-respecting man, protested against the singing, which, he said, disturbed his gravy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c604fb49-21b8-331a-953f-63c4cb2791b6",
                                        "entry_id": "6ecf9aea-1cdb-3cf1-bdf7-d1fc26fca843",
                                        "glosses": [
                                            "A person who sulks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c93119d6-66aa-435d-bdc8-ee43fd720793",
                                                "sense_id": "c604fb49-21b8-331a-953f-63c4cb2791b6",
                                                "text": "Don't be such a sulk, Leo!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sulk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "153e602e-2e79-344a-af51-62dfc6773330",
                                        "entry_id": "d6ce5d72-8c8e-3392-8746-2da86ccb0df1",
                                        "glosses": [
                                            "A furrow."
                                        ],
                                        "tags": [],
