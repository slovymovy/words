        "ru-extract.jsonl": [
            {
                "entry_id": "245c61e0-6dbe-3e44-9150-bad1f65bde16",
                "word": "домком",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d6881a4-0e7c-3747-b106-7c59d864cf78",
                        "entry_id": "245c61e0-6dbe-3e44-9150-bad1f65bde16",
                        "glosses": [
                            "самостоятельно, ведя своё хозяйство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c208d0cb-2438-4f96-936b-7b03e36d1e6a",
                                "sense_id": "5d6881a4-0e7c-3747-b106-7c59d864cf78",
                                "text": "А ты, душенька, похозяйничай здесь без меня; пора привыкать: нынче девушка, а завтра сама, может быть, будешь жить домком."
                            },
                            {
                                "example_id": "2e7eb0a3-cbc9-4d05-9404-648b385d4405",
                                "sense_id": "5d6881a4-0e7c-3747-b106-7c59d864cf78",
                                "text": "Фирс жил в гостях; теперь домком живёт."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
