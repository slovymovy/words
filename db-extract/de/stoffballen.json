                        "glosses": [
                            "langes Stück Stoff, das zu einem Ballen zusammengerollt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a03837a-4af0-4c9e-bef1-897204704830",
                                "sense_id": "d2b15f72-c79b-3262-8b0b-33254ee857f1",
                                "text": "„Lai-bau händigte ihm zunächst eine Empfehlungskarte aus, und die Träger überreichten ein paar Stoffballen aus Nanking und dreißig Unzen Silber.“"
                            },
                            {
                                "example_id": "c9c9748f-d1e5-4db7-8382-ec316f3cacf5",
                                "sense_id": "d2b15f72-c79b-3262-8b0b-33254ee857f1",
                                "text": "„Aber schon trafen die ersten Laufburschen mit Stoffballen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
