                                                "sense_id": "f89f0bab-ba0c-375b-928f-2ae72eeafd86",
                                                "text": "Druhou komorou českého parlamentu je Senát."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29927fbe-6d25-33c5-aeaa-1d5a3cd4c091",
