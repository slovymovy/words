                        "peler une orange"
                    ]
                },
                {
                    "sense_id": "44127ac8-a12d-370c-8c8d-6b468c564103",
                    "sense_definition": "Perdre des morceaux de peau superficielle à la suite d'un coup de soleil ou d'une brûlure.",
