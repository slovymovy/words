                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fb7d88-451d-45bb-ba97-347d3611ed7e",
                                "sense_id": "00f93767-35cb-32ec-bc17-1faeac2d3a8e",
                                "text": "Mieszkańcami Ryna są przede wszystkim Kazachowie."
