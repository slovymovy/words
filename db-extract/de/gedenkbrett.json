                "senses": [
                    {
                        "sense_id": "05b25fed-951b-3c1c-a817-746a5a2642cf",
                        "entry_id": "5c933ab3-869e-3cb9-9779-c8d9264693c4",
                        "glosses": [
                            "mit Farbe, Gravuren oder gefrästen Verzierungen versehenes, längliches Holzbrett zur Erinnerung an ein Ereignis oder eine Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d80739f-a65c-4fe9-9a0d-49bfbab87776",
                                "sense_id": "05b25fed-951b-3c1c-a817-746a5a2642cf",
                                "text": "„Im Rahmen der aktiven Trauerarbeit haben Interessierte im MGH die Möglichkeit, mit Holz und Acrylfarbe ein Gedenkbrett der Größe zwei mal 0,3 Meter zu gestalten.“"
                            },
                            {
                                "example_id": "935b3bb0-6182-4ec4-bb7f-fd1374ae78f7",
                                "sense_id": "05b25fed-951b-3c1c-a817-746a5a2642cf",
                                "text": "„Die abgebildete Gedenkbrettgruppe befindet sich bei Widdersdorf und zeigt neben neun Gedenkbrettern auch zwei Gedenksteine.“"
                            },
                            {
                                "example_id": "94baa9e0-7ee6-4257-872d-7bae5207f05b",
                                "sense_id": "05b25fed-951b-3c1c-a817-746a5a2642cf",
                                "text": "„Das Gedenkbrett ist für Frau Hedwig Eiber, es wurde 2009 angebracht.“"
                            },
                            {
                                "example_id": "0f9a1c6a-2ffd-4be9-85ef-7e8150687fac",
                                "sense_id": "05b25fed-951b-3c1c-a817-746a5a2642cf",
                                "text": "„Während der Totenehrung anlässlich des 125. Gründungsjubiläums der Feuerwehr Sperlhammer bei der Dorfkapelle am Samstagabend erteilte Stadtpfarrer Herbert Mader auch drei neu aufgestellten Gedenkbrettern den kirchlichen Segen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
