    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "786fbacc-d489-3d49-983f-d8a0fbc001ab",
                    "sense_definition": "Reduced by a specific number or quantity in a mathematical operation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten <w>minus</w> four equals six.",
                            "target_lang_translations": {
                                "ru": "Десять <w>минус</w> четыре равно шести.",
                                "zh": "十<w>减</w>四等于六。"
                            }
                        },
                        {
                            "text": "The teacher asked the students to calculate twelve <w>minus</w> five.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников вычислить двенадцать <w>минус</w> пять.",
                                "zh": "老师让学生们计算十二<w>减</w>五。"
                            }
                        }
                    ],
                    "antonyms": [
                        "plus"
                    ],
                    "common_phrases": [
                        "ten minus four",
                        "minus equals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшенный на определенное число или количество в математической операции.",
                        "zh": "在数学运算中减少特定的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "математический знак вычитания"
                            },
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "за вычетом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减",
                                "target_lang_sense_clarification": "数学运算中的减法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6b04404-fe7a-38bf-934b-33ef0493f496",
                    "sense_definition": "Lacking or without something that is usually present.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the party <w>minus</w> his shoes after the long walk.",
                            "target_lang_translations": {
                                "ru": "После долгой прогулки он пришел на вечеринку <w>без</w> туфель.",
                                "zh": "长途跋涉后，他<w>没</w>穿鞋就到了聚会。"
                            }
                        },
                        {
                            "text": "I had to leave the house <w>minus</w> my coat because I was in a hurry.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось выйти из дома <w>без</w> пальто, потому что я очень спешил.",
                                "zh": "因为赶时间，我<w>没</w>穿外套就出了门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lacking",
                        "without"
                    ],
                    "common_phrases": [
                        "minus my coat",
                        "minus his glasses"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in a slightly humorous or informal way"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие чего-либо, что обычно присутствует.",
                        "zh": "缺少通常存在的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без",
                                "target_lang_sense_clarification": "отсутствие предмета"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "разговорное обозначение потери или отсутствия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没有",
                                "target_lang_sense_clarification": "表示缺少某物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7588a64f-b22b-3cfd-bf2f-88ad7a00f401",
                    "sense_definition": "Being below zero on a scale, especially for temperature.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "scale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>minus</w> ten degrees outside today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на улице <w>минус</w> десять градусов.",
                                "zh": "今天外面是<w>零下</w>十度。"
                            }
                        },
                        {
                            "text": "The temperature dropped to <w>minus</w> five during the night.",
                            "target_lang_translations": {
                                "ru": "Ночью температура упала до <w>минус</w> пяти.",
                                "zh": "夜间气温降到了<w>零下</w>五度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "below zero"
                    ],
                    "common_phrases": [
                        "minus ten degrees",
                        "minus five"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ниже нуля по шкале, особенно для температуры.",
                        "zh": "在刻度上低于零，尤指温度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "отрицательная температура"
                            },
                            {
                                "target_lang_word": "ниже нуля",
                                "target_lang_sense_clarification": "о температуре"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "零下",
                                "target_lang_sense_clarification": "指温度低于零度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d656d150-b9e3-3caf-9845-80e9bf067c0d",
                    "sense_definition": "Representing a negative quantity or a reduction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant noted a <w>minus</w> number in the final report.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер отметил <w>отрицательное</w> число в итоговом отчете.",
                                "zh": "会计在最终报告中记录了一个<w>负</w>数。"
                            }
                        },
                        {
                            "text": "We need to account for the <w>minus</w> values in this spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Нам нужно учесть <w>отрицательные</w> значения в этой таблице.",
                                "zh": "我们需要核算这张电子表格中的<w>负</w>值。"
                            }
                        }
                    ],
                    "synonyms": [
                        "negative"
                    ],
                    "common_phrases": [
                        "minus number",
                        "minus value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представляющий отрицательную величину или уменьшение.",
                        "zh": "表示负数或减少。"
                    },
