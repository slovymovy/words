                        "examples": [
                            {
                                "example_id": "b7d788a5-9e5d-4f76-b4d6-556d4e29a94d",
                                "sense_id": "778ae406-cbe4-3a74-90c2-b0a7e5b3657f",
                                "text": "Kuipers wil dat er in zijn zaak bijna honderd getuigen worden gehoord, onder wie wethouder Arends en oud-burgemeester Bijl van de gemeente Emmen. De voormalige motorclubleider zegt dat zij kunnen verklaren dat er jarenlang een goede verstandhouding is geweest tussen No Surrender en de gemeente."
                            },
                            {
                                "example_id": "e4314bf9-a650-480b-908e-dcedbecb6a0e",
                                "sense_id": "778ae406-cbe4-3a74-90c2-b0a7e5b3657f",
                                "text": "Afgelopen maart zijn er twee aanslagen gepleegd op de woning van de clubleider. Beide keren was een explosief gebruikt."
                            }
                        ]
