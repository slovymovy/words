                    },
                    {
                        "translation_id": "3312ead9-3e7a-434c-a1e2-1af998f7a37a",
                        "source_entry_id": "bdadbeaf-9958-3281-b710-9da3f6bcba42",
                        "source_sense_id": "97b894a5-87b1-3c96-99aa-0146afc90450",
