                "senses": [
                    {
                        "sense_id": "d7448039-738c-3093-a3fa-8788284815e6",
                        "entry_id": "5ff4e47e-11cd-33a6-b21e-00e9cb4e9bcb",
                        "glosses": [
                            "Priester, der in einer Diözese dient (und nicht im Kloster eines Ordens)"
                        ],
                        "tags": [
                            "römisch-katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "7d3009e2-04e4-4052-a109-40638deb1a1d",
                                "sense_id": "d7448039-738c-3093-a3fa-8788284815e6",
                                "text": "Diözesanpriester sind in der Regel einer Diözese inkardiniert, in welcher sie zur Seelsorge in den Gemeinden oder für andere Dienste eingesetzt werden. Die klassischen Aufgaben sind das Volk Gottes zu lehren, zu führen und durch Sakramentenspendung zu heiligen."
                            },
                            {
                                "example_id": "f0fb64a4-0f49-463d-8f58-22c88fdc2818",
                                "sense_id": "d7448039-738c-3093-a3fa-8788284815e6",
                                "text": "„Der Heilige Stuhl approbierte kürzlich die Statuten eines neuen Instituts für die Ausbildung von Diözesanpriestern in Rom. […] Das neue Bildungszentrum für Priester, das vor wenigen Tagen geöffnet wurde, steht allen Diözesanpriestern offen …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
