{
    "word_family": [
        "wahnsinnig",
        "Wahn",
        "wahnhaft",
        "Wahnsinnstat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a6dfdc9-e3fc-3180-b62f-9604a3b5ee58",
                    "sense_definition": "etwas Außergewöhnliches, Extremes oder Überwältigendes, das großes Erstaunen oder Begeisterung auslöst",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Konzert gestern Abend war der reinste <w>Wahnsinn</w>.",
                            "target_lang_translations": {
                                "en": "The concert last night was completely <w>insane</w>."
                            }
                        },
                        {
                            "text": "Diese Aussicht von der Bergspitze ist einfach der <w>Wahnsinn</w>.",
                            "target_lang_translations": {
                                "en": "This view from the mountaintop is simply <w>incredible</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "der reinste Wahnsinn",
                        "einfach der Wahnsinn"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "something extraordinary, extreme, or incredible that causes great amazement or enthusiasm"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "incredible",
                                "target_lang_sense_clarification": "used to describe something amazing or overwhelmingly great"
                            },
                            {
                                "target_lang_word": "unreal",
                                "target_lang_sense_clarification": "extraordinary or mind-blowing"
                            },
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "informal description for something wildly impressive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92a944f6-e20b-3b09-877a-f3dc2eb68d3d",
                    "sense_definition": "völlig unvernünftiges, unbesonnenes oder gefährliches Verhalten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es ist reiner <w>Wahnsinn</w>, bei diesem starken Sturm mit dem Boot herauszufahren.",
                            "target_lang_translations": {
                                "en": "It is sheer <w>madness</w> to take the boat out in such a heavy storm."
                            }
                        },
                        {
                            "text": "Ohne Sicherheitsausrüstung auf das Dach zu klettern ist der helle <w>Wahnsinn</w>.",
                            "target_lang_translations": {
                                "en": "Climbing onto the roof without safety equipment is absolute <w>insanity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Irrsinn",
                        "Verrücktheit"
                    ],
                    "antonyms": [
                        "Vernunft"
                    ],
                    "common_phrases": [
                        "reiner Wahnsinn"
                    ],
                    "target_lang_definitions": {
                        "en": "utterly unreasonable, reckless, or dangerous behavior; foolishness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "madness",
                                "target_lang_sense_clarification": "reckless folly or foolish behavior"
                            },
                            {
                                "target_lang_word": "insanity",
                                "target_lang_sense_clarification": "extreme foolishness or dangerously reckless action"
                            },
                            {
                                "target_lang_word": "folly",
                                "target_lang_sense_clarification": "lack of good sense or foolishness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f078326-dbfe-392b-b3a7-5b85be03b00d",
                    "sense_definition": "Zustand schwerer geistiger Verwirrung oder Geisteskrankheit, bei dem der Realitätsbezug verloren geht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte König zeigte immer deutlichere Zeichen von <w>Wahnsinn</w> und erkannte seine eigenen Kinder nicht mehr.",
                            "target_lang_translations": {
                                "en": "The old king showed increasingly clear signs of <w>madness</w> and no longer recognized his own children."
                            }
                        },
                        {
                            "text": "Nach vielen Jahren der Einsamkeit schien der Einsiedler dem <w>Wahnsinn</w> verfallen zu sein.",
                            "target_lang_translations": {
                                "en": "After many years of solitude, the hermit seemed to have succumbed to <w>insanity</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Irrsinn"
                    ],
                    "common_phrases": [
                        "in den Wahnsinn treiben",
                        "dem Wahnsinn verfallen"
                    ],
                    "target_lang_definitions": {
                        "en": "a state of severe mental derangement or illness characterized by loss of touch with reality"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insanity",
                                "target_lang_sense_clarification": "state of severe mental illness or unsound mind"
                            },
                            {
                                "target_lang_word": "madness",
                                "target_lang_sense_clarification": "mental derangement or state of being mad"
                            },
                            {
                                "target_lang_word": "lunacy",
                                "target_lang_sense_clarification": "mental illness or derangement"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "31abcd4a-31ef-3462-8a34-dd6e5ee56df8",
                    "sense_definition": "Ausruf der großen Überraschung, der Fassungslosigkeit oder der Begeisterung",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wahnsinn</w>, du hast die schwierige Prüfung tatsächlich auf Anhieb bestanden!",
                            "target_lang_translations": {
                                "en": "<w>Wow</w>, you actually passed that difficult exam on the first try!"
                            }
                        },
                        {
                            "text": "Wie schnell dieses Auto beschleunigen kann, <w>Wahnsinn</w>!",
                            "target_lang_translations": {
                                "en": "How fast this car can accelerate, it's <w>unbelievable</w>!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an exclamation of great surprise, disbelief, or excitement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wow",
                                "target_lang_sense_clarification": "exclamation of astonishment or admiration"
                            },
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "used as an exclamation of disbelief or amazement"
                            },
                            {
                                "target_lang_word": "unbelievable",
                                "target_lang_sense_clarification": "exclamation of astonishment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
