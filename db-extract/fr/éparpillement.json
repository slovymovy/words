                "senses": [
                    {
                        "sense_id": "963642e8-6184-3a7a-8a23-6ab9539cb390",
                        "entry_id": "bf414ca1-50fd-3d25-b0fb-f424ad891a9c",
                        "glosses": [
                            "Action d’éparpiller ou état de ce qui est éparpillé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef49b973-b035-4a53-b9f3-972076af16a2",
                                "sense_id": "963642e8-6184-3a7a-8a23-6ab9539cb390",
                                "text": "Défaut de cohésion, voilà quel était le point faible d'où dérivaient l'éparpillement des efforts, les tiraillements entre les bureaux, entre les hommes!"
                            },
                            {
                                "example_id": "40e50cc8-6584-46e0-9c58-546c064b3c01",
                                "sense_id": "963642e8-6184-3a7a-8a23-6ab9539cb390",
                                "text": "Les communes rurales y sont bien rarement groupées; elles sont au contraire disséminées, sur l'immense et fécond plateau, en un éparpillement de fermes; …."
                            }
                        ]
                    }
                ],
