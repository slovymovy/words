                            },
                            {
                                "target_lang_word": "предвариловка",
                                "target_lang_sense_clarification": "предварительное заключение, разг."
                            },
                            {
                                "target_lang_word": "санкция",
                                "target_lang_sense_clarification": "санкция на арест, жарг."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e647574-cdfd-3a3c-9f17-0e7bc73f87c5",
                    "sense_definition": "dolna szczęka u młodego konia",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Weterynarz dokładnie obejrzał <w>sanki</w> źrebaka, sprawdzając prawidłowy rozwój jego uzębienia.",
                            "target_lang_translations": {
                                "ru": "Ветеринар внимательно осмотрел <w>нижнюю челюсть</w> жеребёнка, проверяя правильность развития его зубов."
                            }
                        },
                        {
                            "text": "U młodego konia <w>sanki</w> nie były jeszcze w pełni wykształcone.",
                            "target_lang_translations": {
                                "ru": "У молодой лошади <w>нижняя челюсть</w> ещё не сформировалась полностью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нижняя челюсть молодого коня"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нижняя челюсть",
                                "target_lang_sense_clarification": "анатомический термин у лошадей"
                            },
                            {
                                "target_lang_word": "подчелюсток",
                                "target_lang_sense_clarification": "нижняя часть челюсти"
                            }
