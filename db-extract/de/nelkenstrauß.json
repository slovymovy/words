                "senses": [
                    {
                        "sense_id": "9aa5718d-5981-368b-8a6f-d107628d259c",
                        "entry_id": "faf4ae3f-579c-362d-95a4-e296c72cfee7",
                        "glosses": [
                            "Blumenstrauß aus Nelken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145ada4d-c5a3-4421-89d7-67090cfc48b0",
                                "sense_id": "9aa5718d-5981-368b-8a6f-d107628d259c",
                                "text": "„Nelkensträuße erfüllten die Luft mit dem süßen Duft von Verwesung.“"
                            },
                            {
                                "example_id": "20546e14-f125-413e-b37b-050c6cf34632",
                                "sense_id": "9aa5718d-5981-368b-8a6f-d107628d259c",
                                "text": "„Die Menschen, denen sie gehörten, waren vor langer Zeit verstorben, dennoch lagen frische Blumen bei den Steinen, Nelkensträuße und Töpfe mit Begonien, hier und dort auch sommergrüne Büsche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
