                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "26e5561b-9e61-4f80-95a1-c8de96b1375d",
                        "entry_id": "37885c76-79de-3b3e-8e21-34ad49ace21f",
                        "tags": [
                            "present",
                            "singular",
