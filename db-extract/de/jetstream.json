                "senses": [
                    {
                        "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                        "entry_id": "3a92b611-42af-3095-a4c3-488acdbfec4f",
                        "glosses": [
                            "starke Windströmung im Bereich der oberen Troposphäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd54761d-976f-4f89-8b65-27e2a29eaee5",
                                "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                                "text": "„Die Jetstreams in der oberen Troposphäre bzw. Stratosphäre lassen sich den Forschern zufolge nicht als Quelle erneuerbarer Energien nutzen.“"
                            },
                            {
                                "example_id": "79b933cf-4959-4489-b8d1-4ffc92b959af",
                                "sense_id": "37ba9e37-be3f-3ea7-8993-112e74b0f192",
                                "text": "„Die Potsdamer Forscher haben sich auf die Teile des Jetstreams konzentriert, die besonders schnell ziehen und ungefähr im Wochenrhythmus abwechselnd dominante Hoch- und Tiefdruckgebiete über Europa schieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
