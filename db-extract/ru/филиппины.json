                                        "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                        "entry_id": "5f85b85c-7bae-303d-95ba-aafb7d75ecec",
                                        "glosses": [
                                            "Inselgruppe und Staat in Südostasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e31c70-ac5e-4b27-b61b-13000a8e4ec8",
                                                "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                                "text": "Er kommt von den Philippinen."
                                            },
                                            {
                                                "example_id": "6448f805-5712-422f-bb6e-9f79b49b0b48",
                                                "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                                "text": "Manila ist die Hauptstadt der Philippinen."
                                            },
                                            {
                                                "example_id": "01b9522a-05ab-46b9-9f5d-e0f08ed8f9eb",
                                                "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                                "text": "„Einer der bislang mächtigsten Taifune ist mit verheerender Zerstörungskraft über die Philippinen hereingebrochen.“"
                                            },
                                            {
                                                "example_id": "633962bf-eb31-4991-9b1b-56ca09587fa3",
                                                "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                                "text": "„Die Zahl der besonders zerstörerischen Supertaifune hat sich auf den Philippinen in den letzten Jahren vervielfacht.“"
                                            },
                                            {
                                                "example_id": "0379a8ed-1eeb-4920-ab57-a422b8fc96e4",
                                                "sense_id": "a8801bd3-6b02-3c74-a323-145b875751c4",
                                                "text": "„Dabei hatte jeder im Viertel gewusst, dass Martys älterer Bruder Bertram (»Chubby«) 1944 über den Philippinen abgeschossen worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
