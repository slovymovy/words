                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dceebc71-4eaf-4ebb-b9ee-6ceba6caea5e",
                                "sense_id": "d8efb713-f924-376d-810a-0331d7fb0621",
                                "text": "„Erinnern wir uns der Trias der Schulphilosophie, die bei allem und jedem die Quiddität, die Qualität und die Quantität betrachtet, so wollen wir unsere These damit hier so interpretieren, daß bei allem und jedem neben den Fragen nach dem Was und dem Wie auch die Frage nach dem Wieviel sinnvoll ist.“"
                            }
                        ],
