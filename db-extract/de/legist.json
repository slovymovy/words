                "senses": [
                    {
                        "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                        "entry_id": "adf90de8-02e1-3c07-80e0-3d27b21f239b",
                        "glosses": [
                            "Jurist, der sich mit Gesetzestexten beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34973c59-540f-4644-bce5-c94ff3746d3a",
                                "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                                "text": "„Im österreichischen Sprachgebrauch ist Legist (Latein lex = Gesetz) die Berufsbezeichnung für Juristen, die ausschließlich oder überwiegend mit dem Ausarbeiten von Gesetzes- oder Verordnungstexten betraut sind.“"
                            },
                            {
                                "example_id": "6e13dddd-4f27-4b3c-b888-2f231b3545f1",
                                "sense_id": "8fa17804-cc8f-3a5a-81e7-4a7e1d609e50",
                                "text": "„Ziel dieses Leitfadens ist es demgemäß der Legistin bzw. dem Legisten das nötige Gespür dafür zu geben, ob die facettenreichen Anforderungen der IKT durch den zu erstellenden bzw. vorliegenden Entwurf erfüllt sind, oder aber ob Anpassungsbedarf besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
