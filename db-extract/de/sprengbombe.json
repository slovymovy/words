                "senses": [
                    {
                        "sense_id": "7fcdff62-53c3-3db7-ac70-c16a2117778c",
                        "entry_id": "c3b4f4df-61dd-3acc-8d67-d58a87e88aa0",
                        "glosses": [
                            "Bombe, deren Wirkung vor allem auf ihrer Sprengkraft beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e7c660-b253-4108-8c8e-b0d7bc864f5e",
                                "sense_id": "7fcdff62-53c3-3db7-ac70-c16a2117778c",
                                "text": "„Im April waren in dieser Gegend eine Menge Sprengbomben gefallen, die hatten den Bahnhof treffen sollen, alle daneben.“"
                            },
                            {
                                "example_id": "43d8e532-57cf-424d-9106-027456c49cf9",
                                "sense_id": "7fcdff62-53c3-3db7-ac70-c16a2117778c",
                                "text": "„Bis Februar warfen die Amerikaner hauptsächlich Sprengbomben und Luftminen ab.“"
                            },
                            {
                                "example_id": "33627c09-a021-4d11-bb94-67cdea7309e9",
                                "sense_id": "7fcdff62-53c3-3db7-ac70-c16a2117778c",
                                "text": "„Mehr als zwanzig Minuten lang zitterten sie im Keller, während sechs amerikanische Bomberstaffeln mehr als 500 Tonnen Spreng- und Brandbomben über der Stadt abwarfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
