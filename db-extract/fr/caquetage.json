                                "target_senses": [
                                    {
                                        "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                                        "glosses": [
                                            "aanhoudend kakelen door kippen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a56ef08-a96a-4f52-8839-6ef04d8a4662",
                                                "sense_id": "656a9722-fede-36d8-ada4-491cb447abb9",
                                                "text": "Alles van de kip, in een kippenhok vol gekakel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                        "entry_id": "fe4ac5c9-2bdf-3f4a-9f59-476b0ca3e00f",
                                        "glosses": [
                                            "aanhoudend babbelen door mensen / zinloos geklets"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e43d2fc-22b3-4283-ae0a-d0692b63f823",
                                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                                "text": "Als ik onzeker word van dat gekakel, dan zeg ik dan naderhand tegen productie, dan spreken zij de anderen erop aan.’’"
                                            },
                                            {
                                                "example_id": "d92c6716-b86b-40ef-816f-6be5b574bcb7",
                                                "sense_id": "5be9b907-eddc-30f2-b364-7a88a6303542",
                                                "text": "Wat blijven we als samenleving toch moeite houden met het overbruggen van verschillen tussen mensen; keer op keer schiet deze gedachte door mijn hoofd als ik de laatste populistische klaagzang over de 'mislukte integratie'met weerzin tot me neem. Leiders zouden juist het niveau van het oppervlakkige gekakel over de negatieve aspecten van culturele diversiteit moeten overstijgen. En dan vooral politieke leiders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
