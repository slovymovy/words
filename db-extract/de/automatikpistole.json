                "senses": [
                    {
                        "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                        "entry_id": "51cd7fbb-3e30-34d1-98fe-c6d7579b111a",
                        "glosses": [
                            "Pistole, die nach Abgabe eines Schusses teilweise oder vollständig selbsttätig erneut schussbereit wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c634cc00-67a5-45c9-909b-1940e2fbd43b",
                                "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                                "text": "„Bislang habe ich mich noch nicht erschossen, wie mein Onkel Douglas es tat. Ich habe mir eine Automatikpistole gekauft und hätte fast diesen Schritt vollzogen, doch gewisse Träume hinderten mich daran.“"
                            },
                            {
                                "example_id": "2ce43e0c-b93d-40b8-9ff7-9a3f56738246",
                                "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                                "text": "„Die Waffe ist fünfunddreißig Jahre alt, aber die verlässlichste Automatikpistole der Welt.“"
                            },
                            {
                                "example_id": "7af0d6b5-85c1-4241-9cf6-c3a28061385c",
                                "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                                "text": "„Seine fleischige Hand hielt eine Automatikpistole, deren Edelstahl im hellen Licht bedrohlich glänzte.“"
                            },
                            {
                                "example_id": "b67e7ddd-3e05-4118-9c9c-901e54dbdd5a",
                                "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                                "text": "„Aus seiner vorderen Hosentasche holte er den Schalldämpfer und schraubte ihn auf die Automatikpistole.“"
                            },
                            {
                                "example_id": "4b9372b4-2a17-4a83-b659-0139a1d53396",
                                "sense_id": "4f08338e-0fc3-37de-bd27-4b032f8f75b1",
                                "text": "„Wie zufällig öffnete er sein Jackett ein kleines bisschen weiter, so dass der Kolben einer Automatikpistole zum Vorschein kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
