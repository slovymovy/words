                        "glosses": [
                            "De manière lancinante."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "1348dbd9-9a1a-4f96-82b4-453826bd1d38",
                                "sense_id": "eb953da5-4353-3e40-986e-bc9c41f74c4d",
                                "text": "Leurs gloussements alternés et démultipliés d’expirations brisées, reprises et continuées, lui donnent l’impression que la nuit, tout entière enrouée et castrée, se livre déployée à un lent gargarisme bleui lancinamment au suc du méthylène."
                            },
                            {
                                "example_id": "cd3f2d26-8faf-4b87-b531-432ceb761344",
                                "sense_id": "eb953da5-4353-3e40-986e-bc9c41f74c4d",
                                "text": "Dehors, sur la place vide, la neige tombe lancinamment, comme moi."
                            }
                        ]
                    }
