                "senses": [
                    {
                        "sense_id": "77ced1a3-47dd-3df5-af19-96d1f1e7f3dd",
                        "entry_id": "7269dd94-196a-3bbc-9579-72a62317dc56",
                        "glosses": [
                            "ботан. такой, зародыш которого содержит одну семядолю"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9141cced-4eeb-3781-ab63-75130176c0a3",
                        "entry_id": "7269dd94-196a-3bbc-9579-72a62317dc56",
                        "glosses": [
                            "биол. относящийся к классу покрытосемянных растений, зародыш которых имеет одну семядолю"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a8e620-f0d7-4b5d-920f-422a6aa867cc",
                                "sense_id": "9141cced-4eeb-3781-ab63-75130176c0a3",
                                "text": "Отдел цветковых растений делится на два класса: двудольных и однодольных (магнолиопсиды и лилиопсиды)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54d27b37-2f3a-4c57-bbc3-db6dbdabd5d4",
                        "source_entry_id": "7269dd94-196a-3bbc-9579-72a62317dc56",
                        "source_sense_description": "о растении",
                        "target_lang_word": "monocotyledonous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monocotyledonous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                        "entry_id": "9a22cc82-08c6-36e7-9eb0-a7613fb76949",
                                        "glosses": [
                                            "Of or pertaining to a flowering plant having a seed with one embryonic leaf (a single cotyledon)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c54d47f-4cb8-4a2b-9c32-b86cac0e64d1",
                                                "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                                "text": "Strange to say, the islet of Ronde, about 16 miles north of Mauritius, forms a separate biological kingdom, possessing one peculiar species of cabbage-palm, some lizards, two snakes, and relatively more monocotyledonous plants than any other region in the world."
                                            }
                                        ]
