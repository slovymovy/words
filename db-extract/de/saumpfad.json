                        "cross_references": []
                    },
                    {
                        "translation_id": "a8b52627-3134-47b4-ba0f-52afcd80c235",
                        "source_entry_id": "163c9cc0-5922-3fb6-9f0b-075f843f154d",
                        "source_sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                        "source_sense_description": "schmaler, für Lasttiere begehbarer Weg im Gebirge",
                        "target_lang_word": "mountain trail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "78735fbd-f540-4eb8-8604-c29df2ee40d7",
                        "source_entry_id": "163c9cc0-5922-3fb6-9f0b-075f843f154d",
                        "source_sense_id": "d1aa5e6c-6996-3e40-b3bd-0a49a5ae6757",
                        "source_sense_description": "schmaler, für Lasttiere begehbarer Weg im Gebirge",
                        "target_lang_word": "bridle path",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bridle path",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4564ff6-c3a8-38b0-b1fb-aba5b665e858",
                                        "entry_id": "455fb512-65af-38a9-93de-6efa302561f7",
                                        "glosses": [
                                            "An established trail used by riders mounted on horses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de9f3c4d-370f-4878-af28-df58b5fe54bd",
                                                "sense_id": "f4564ff6-c3a8-38b0-b1fb-aba5b665e858",
                                                "text": "A party came round the angle of a rock, along the narrow bridle-path, in single file; two ladies on horseback, followed by as many gentlemen on foot, and preceded by the usual guide."
                                            },
                                            {
                                                "example_id": "d855d387-8d6e-441f-aadd-8744446744d6",
                                                "sense_id": "f4564ff6-c3a8-38b0-b1fb-aba5b665e858",
                                                "text": "It was not a bridle-path—merely a pedestrian's track, and the boughs spread horizontally at a height not greater than seven feet above the ground, which made it impossible to ride erect beneath them."
                                            },
                                            {
                                                "example_id": "5d683f8e-d8a5-4c4e-b146-db26f612ff5f",
                                                "sense_id": "f4564ff6-c3a8-38b0-b1fb-aba5b665e858",
                                                "text": "Then in the evening, he came suddenly upon Sue riding a spirited black horse in a bridle path at the upper end of the park."
                                            },
                                            {
                                                "example_id": "665113db-2606-43a2-8cc0-e17200fa0e3d",
                                                "sense_id": "f4564ff6-c3a8-38b0-b1fb-aba5b665e858",
                                                "text": "Some complaints about the Prospect Park trails seem to reflect the ever-present realities of urban horseback riding. Joggers and even bikers wander onto the bridle path."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
