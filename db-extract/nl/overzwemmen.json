                "senses": [
                    {
                        "sense_id": "45b6b5ee-dfd8-3378-b129-c6e554a727c9",
                        "entry_id": "0751f059-6601-308a-ae05-e37475579438",
                        "glosses": [
                            "door zwemmen een water oversteken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d662be1a-98c2-4fc1-b0dd-aea91789cea3",
                                "sense_id": "45b6b5ee-dfd8-3378-b129-c6e554a727c9",
                                "text": "Fransman wil Grote Oceaan in 5 maanden overzwemmen: Een Fransman wil volgend jaar een nog niet eerder vertoonde zwemtocht maken. Benoît Lecomte (44) is van plan de Grote Oceaan over te steken. De 8800 kilometer lange tocht van de Japanse hoofdstad Tokio naar San Francisco in de Verenigde Staten gaat ongeveer 5 maanden duren."
                            },
                            {
                                "example_id": "48fafaab-b568-4dec-9ee4-0ab7d172b2e4",
                                "sense_id": "45b6b5ee-dfd8-3378-b129-c6e554a727c9",
                                "text": "Instructeurs van de Luchtmobiele Brigade begeleiden de jongeren bij de oefeningen, zoals het overzwemmen van het ijskoude water in het natuurbad."
                            }
                        ]
                    }
