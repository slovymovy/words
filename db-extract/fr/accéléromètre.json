        "fr-extract.jsonl": [
            {
                "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                "word": "accéléromètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0bb9365d-cfd1-41bf-a424-3165fb7e99cf",
                        "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "accéléromètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "63aae66d-6d77-37d1-adbc-bf2f737704fa",
                        "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                        "glosses": [
                            "Instrument donnant un enregistrement proportionnel à l’accélération d’un mouvement."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "eb941bbe-2552-43d6-bd5d-59667c3b53c6",
                                "sense_id": "63aae66d-6d77-37d1-adbc-bf2f737704fa",
                                "text": "Grâce à un accéléromètre, dispositif qui mesure l’accélération, c’est-à-dire les variations de vitesse au cours du temps, sans référence externe, on peut, connaissant notre vitesse et notre position initiales, déduire notre vitesse et notre position à chaque instant."
                            }
                        ]
                    },
                    {
                        "sense_id": "483cde78-97b4-34e7-8478-5970092d3b4e",
                        "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                        "glosses": [
                            "Capteur qui transforme une accélération en un signal, souvent électrique, qui lui est proportionnel. — (Jean-Michel Courty et Édouard Kierlik, La Physique buissonnière, Éditions Belin – Pour la science, Paris, 2010, page 40)"
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "653746d9-70a7-4ffc-9ec9-2b4849da130a",
                                "sense_id": "483cde78-97b4-34e7-8478-5970092d3b4e",
                                "text": "Le système est couplé avec des données de gyroscope et d’accéléromètre pour le haut, le bas et la ligne d’horizon, développe Thomas Dexmier, vice-président associé EMEA chargé des solutions entreprise chez HTC Vive."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f4bbcae-ec60-4088-84be-64edd02843be",
                        "source_entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                        "target_lang_word": "accelerometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accelerometer",
