                                    {
                                        "sense_id": "604efab2-2e1a-3262-8f79-b24b2d3f30b4",
                                        "entry_id": "5d297200-4eb5-3a01-a774-f4f7c751a266",
                                        "glosses": [
                                            "den Menschen in den Mittelpunkt stellend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd90193-fb21-4550-a4e3-6a389f17b482",
                                                "sense_id": "604efab2-2e1a-3262-8f79-b24b2d3f30b4",
                                                "text": "Unsere Vorstellung von der belebten Welt ist stark anthropozentrisch."
                                            },
                                            {
                                                "example_id": "4b3f7088-8807-48f0-a118-718903eb6385",
                                                "sense_id": "604efab2-2e1a-3262-8f79-b24b2d3f30b4",
                                                "text": "Wer hat ein noch anthropozentrischeres Weltbild als wir?"
                                            },
                                            {
                                                "example_id": "6390684f-b7a3-4e54-8d41-b4f2dbfd4ee9",
                                                "sense_id": "604efab2-2e1a-3262-8f79-b24b2d3f30b4",
                                                "text": "„Das Mittelalter war geozentrisch und anthropozentrisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
