        "fr-extract.jsonl": [
            {
                "entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                "word": "jaunasse",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38681a81-28c8-4e3d-b8dd-18d0750f4aeb",
                        "entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "jaunasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                        "entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                        "glosses": [
                            "Tirant sur le jaune."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "dd860bd9-1da5-4cf8-a449-543ddeec0e00",
                                "sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                                "text": "Le ciel est jaunasse, parcouru de volutes floues, comme si un haut-fourneau géant avait explosé là-bas au nord, projetant ses cendres incandescentes sur toute la ville."
                            },
                            {
                                "example_id": "01da4b95-2ba5-4663-8bd3-7e9d820d807e",
                                "sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                                "text": "Ils conseillent de guerre, les mecs. S’arrêtent sur la décision suivante : ils vont lester les jambes des deux Français de plots de ciment, puis ils prendront une vedette automobile et iront les débastinguer dans le Rio de la Plata, aux eaux jaunasses."
                            },
                            {
                                "example_id": "8231bdbd-a8ab-4370-abff-ce3cce9a2db2",
                                "sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                                "text": "– J’espère que tu vas retrouver ton teint normal, lui avait-elle dit ce matin-là, alors qu’il était nettement moins jaunasse que deux semaines auparavant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74dd1e8b-52f6-4234-a57b-10713fa040aa",
                        "source_entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                        "source_sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                        "target_lang_word": "yellowish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yellowish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4b90301-036d-31a8-886d-2b6b8a569ec9",
                                        "entry_id": "e1807fbc-8954-3d62-b73c-cacb50ef0699",
                                        "glosses": [
                                            "Somewhat yellow in colour."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a72b4a0-f024-4c49-8deb-aee02c4a5590",
                                                "sense_id": "d4b90301-036d-31a8-886d-2b6b8a569ec9",
                                                "text": "But, like more than one similar North Wales beauty-spot, there had to be (at least at the time of which I write), a quarry, or ironworks, or some kind of industrial plant, which lay perpetually under a cloud of yellowish smoke—literally a blot on the landscape."
                                            },
                                            {
                                                "example_id": "0294f411-c15f-4d99-a8d0-0a6b0c038084",
                                                "sense_id": "d4b90301-036d-31a8-886d-2b6b8a569ec9",
                                                "text": "A biologist has named a newly discovered species of moth after our next president. The Neopalpa donaldtrumpi is a wee little creature found in parts of California and Baja, Mexico. […] It seems nature favors fancy golden hairdos as much as the man himself (who could forget China’s beloved Trump bird?), because the N. donaldtrumpi sports a very familiar-looking crown of yellowish scales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c23d5a00-8cd1-4d7b-ae76-2f75bd3bec7d",
                        "source_entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                        "source_sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                        "target_lang_word": "yellowy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yellowy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c26d00f-2728-3410-82d9-99a4a02159dd",
                                        "entry_id": "cb28bd21-8381-32e5-bd6d-adf8776a35a1",
                                        "glosses": [
                                            "Somewhat yellow; yellowish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ba0ec-3bc2-4fc8-a2ab-8113a8a348f7",
                                                "sense_id": "5c26d00f-2728-3410-82d9-99a4a02159dd",
                                                "text": "Let the daisy, yellow-hearted,\nWith its white leaves starry-parted,\nAnd the cowslips, yellowy pale,\nServe her as a flowery veil—"
                                            },
                                            {
                                                "example_id": "3f2e5b30-816e-46e9-9b87-2ea75c339da8",
                                                "sense_id": "5c26d00f-2728-3410-82d9-99a4a02159dd",
                                                "text": "[…] the worn-out antiquity of Sulaco, so characteristic with its stuccoed houses and barred windows, with the great yellowy-white walls of abandoned convents behind the rows of sombre green cypresses […]"
                                            },
                                            {
                                                "example_id": "63ff1cfa-e231-4e14-bbc3-a22a4bc70a2a",
                                                "sense_id": "5c26d00f-2728-3410-82d9-99a4a02159dd",
                                                "text": "I start the truck, drive west along the highway built on the dry bed of the Teays. There’s wide bottoms, and the hills on either side have yellowy billows the sun can’t burn off."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2f5619c-ba0c-4f43-bc06-94dc4ce75aee",
                        "source_entry_id": "e71a1e2c-ec2a-37d5-b5a7-be59aa78e2d6",
                        "source_sense_id": "53d35a19-e973-3a72-aed6-940927314132",
                        "target_lang_word": "gelig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "00a76cec-129f-3268-a40e-90a252aa94b0",
                                        "entry_id": "7d17f744-8eaa-39a4-b9a1-a43c15b38ff0",
                                        "glosses": [
                                            "een beetje geel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673358af-34a1-44dc-9620-c6f74550275e",
                                                "sense_id": "00a76cec-129f-3268-a40e-90a252aa94b0",
                                                "text": "Na zijn val had zijn gezicht iets geligs."
                                            },
                                            {
                                                "example_id": "cf24f540-4d68-4766-b60a-195455730679",
                                                "sense_id": "00a76cec-129f-3268-a40e-90a252aa94b0",
                                                "text": "Met waterverf schilderde ik het gelige landschap waar ik de afgelopen dagen doorheen was gekomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53908d55-3b13-3598-b662-de0bc62200ad",
                                        "entry_id": "7d17f744-8eaa-39a4-b9a1-a43c15b38ff0",
                                        "glosses": [
                                            "op geel lijkend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9dc0036-b5b9-4de7-a53b-751fc9b3a754",
                                                "sense_id": "53908d55-3b13-3598-b662-de0bc62200ad",
                                                "text": "Dit groen is bijna gelig."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gelig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9d762403-830f-362e-a004-d37f6b2005cc",
                                        "entry_id": "a70ecd1b-8ae9-36aa-8392-6d32bb637e35",
                                        "glosses": [
                                            "toestand waarin iemand alsmaar uitgestrekt rust"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1552577d-903c-4e9c-97a0-0250c4e68932",
                                                "sense_id": "9d762403-830f-362e-a004-d37f6b2005cc",
                                                "text": "Dat gelig van jou de hele dag, daar wordt ik echt heel moe van."
                                            }
