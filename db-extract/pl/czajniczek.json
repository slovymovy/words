                                "target_senses": [
                                    {
                                        "sense_id": "b0c3f78c-b7a5-3807-89f2-64c8180cf6cb",
                                        "entry_id": "8b77e253-d373-316b-a0c5-a89665a06202",
                                        "glosses": [
                                            "A vessel for brewing and serving tea, typically with a handle and spout."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be2b3f2b-968e-4a6f-8404-ecadc499f6ac",
                        "source_entry_id": "e781bd23-cd6e-3850-9b87-f51a6556774d",
                        "source_sense_id": "7f27c816-0c33-3029-a3c5-c265ffbf7ee4",
                        "target_lang_word": "théière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27c15c14-bf60-39f9-ac23-70fbb4a00f6d",
                                        "entry_id": "d6ff47ac-8465-35c1-a4c3-8ccc605562de",
                                        "glosses": [
                                            "Récipient servant à faire infuser le thé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01a41c5-4052-4651-815d-c36547cbb480",
                                                "sense_id": "27c15c14-bf60-39f9-ac23-70fbb4a00f6d",
                                                "text": "Entre temps notre hôte fouille dans ses coffres et en tire un plateau de cuivre, une petite théière en métal blanc, une boîte contenant du thé vert, un paquet de menthe, un pain de sucre, une demi-douzaine de petits verres peinturlurés : tout ce qu’il faut pour préparer et servir le fameux breuvage national."
                                            },
                                            {
                                                "example_id": "715126c3-cb12-45fe-ac0e-d75d5e9f89e1",
                                                "sense_id": "27c15c14-bf60-39f9-ac23-70fbb4a00f6d",
                                                "text": "Ce n’était pas elle qui en avait acheté mais sa colocatrice, une théière frémissante toujours à la main, du temps où les deux étudiantes partageaient un appartement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbfa9b27-9c87-345f-9004-74bc22d1fbb5",
                                        "entry_id": "d6ff47ac-8465-35c1-a4c3-8ccc605562de",
                                        "glosses": [
                                            "Vespasienne."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a39b44e-5682-4823-857a-08ffc94dafa0",
                                                "sense_id": "dbfa9b27-9c87-345f-9004-74bc22d1fbb5",
                                                "text": "— Que veux-tu dire ?\n— La théière. Vous savez bien, quoi : la vespasienne du parc. On appelle ça chez Mme de Monceau. Non ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "théière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "beea7703-cb5f-35dd-bbc2-1bfd0d5cd39e",
                                        "entry_id": "80b963ee-c267-3749-a0e0-7c58ba368020",
                                        "glosses": [
                                            "Féminin singulier de théier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "534e2c1f-8eed-4c05-b791-752068536415",
                        "source_entry_id": "e781bd23-cd6e-3850-9b87-f51a6556774d",
                        "source_sense_id": "7f27c816-0c33-3029-a3c5-c265ffbf7ee4",
                        "target_lang_word": "Teekanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teekanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                        "entry_id": "e9d992be-eb6c-3753-a9e5-1b6a129cbd62",
                                        "glosses": [
                                            "(bauchige) Kanne, in der Tee oder Kräuteraufgüsse zubereitet und warmgehalten werden und die zum Servieren dieser Art von Aufgüssen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c08915e1-f0a0-48eb-b72b-c595d2c7dfd6",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "Teekannen gibt es in verschiedensten Farben, Formen und Größen."
                                            },
                                            {
                                                "example_id": "6f84b934-3c0c-4b2b-8f1b-47e101b30e51",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Die Teekanne blies noch Wölkchen aus der Tülle, und Sonnenlicht strömte durch die offenen Fenster.“"
                                            },
                                            {
                                                "example_id": "9765aaaf-3861-4793-990f-9d3e05335ad9",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Die Kaffeekanne war verschwunden und an ihre Stelle war eine silberne Teekanne getreten.“"
                                            },
                                            {
                                                "example_id": "2c77c223-965e-4efe-8b06-6559035c568f",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Sie stellte die Teekanne ab und legte die Hände um ihre dampfende Tasse.“"
                                            },
                                            {
                                                "example_id": "4774a218-4363-4ba3-b361-d6d098bab023",
                                                "sense_id": "915d97f8-e698-3684-b5ee-b61cf1da29a9",
                                                "text": "„Didier spielte ein bisschen an der Teekanne herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
