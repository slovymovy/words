    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                "word": "ineptitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "27079236-68e5-4099-8e5c-cb9ce6cf6624",
                        "entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "tags": [
                            "plural"
                        ],
                        "form": "ineptitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29b5141f-0c03-3966-93a9-c684a2333057",
                        "entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "glosses": [
                            "The quality of being inept."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5123ac95-9c7e-49a1-b154-1b69dd9a8169",
                                "sense_id": "29b5141f-0c03-3966-93a9-c684a2333057",
                                "text": "The curse has been Spanish ineptitude feeding Gibraltarian intransigence. Border hold-ups are counterproductive to winning hearts and minds, as were blundering Argentinian landings on the outer Falklands."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a2d8daf-6fe8-3096-9fc0-70782ceea190",
                        "entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "glosses": [
                            "An instance of being inept."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ec9882f8-c6fa-4d6b-94c5-4c50cdd4b075",
                                "sense_id": "8a2d8daf-6fe8-3096-9fc0-70782ceea190",
                                "text": "He droned on with platitudes and ineptitudes while Malone whispered to Enid that if Alasha was a fair specimen of the population it was just as well that his native land was safely engulfed in the Atlantic Ocean."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60b4c02e-4fbd-446b-ba0a-118f55b44e87",
                        "source_entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "source_sense_description": "the quality of being inept",
                        "target_lang_word": "dwaasheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dwaasheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3331c442-01c2-30e4-bea2-eca575db618c",
                                        "entry_id": "c8b1ff9b-3e05-3587-b742-5599c77b1091",
                                        "glosses": [
                                            "de toestand van dwaas zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08bc3b7a-068a-4ca4-a011-42b1a6020f90",
                                                "sense_id": "3331c442-01c2-30e4-bea2-eca575db618c",
                                                "text": "Dat is de dwaasheid gekroond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                        "entry_id": "c8b1ff9b-3e05-3587-b742-5599c77b1091",
                                        "glosses": [
                                            "een dwaze handeling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32fd4a6-7b3e-4a5f-a046-bf85d14c7054",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Hij beging opnieuw dwaasheden, waarvoor hij zwaar gestraft werd."
                                            },
                                            {
                                                "example_id": "3185e904-8bf6-4c0d-bea0-0f5559cef445",
                                                "sense_id": "92a1f1ec-e608-31fa-a615-4c7cf3fd04a9",
                                                "text": "Dit boek helpt ons om een kalmere, authentiekere, soms luchtigere relatie aan te gaan met de dwaasheden en obsessies van onze tijd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "196c60f0-b713-48c1-be97-2d7d1036512a",
                        "source_entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "source_sense_description": "the quality of being inept",
                        "target_lang_word": "stupidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stupidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                                        "glosses": [
                                            "Pesanteur d’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2eaf931-6878-4229-b64f-a9f5662dce18",
                                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                                "text": "Ses petits cheveux gris, coupés ras, exprimaient l’indéfinissable stupidité des animaux à sang froid."
                                            },
                                            {
                                                "example_id": "6f90cf17-7ede-4bdb-a395-1faad1dd157d",
                                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                                "text": "De tout temps le public a été mal éduqué. Il demande inlassablement à l’art d’être populaire, de répondre à ses goûts, de flatter son absurde vanité, de lui dire ce qu’on lui a déjà dit auparavant, de lui montrer ce qu’il devrait être las de voir, de l’amuser quand il se sent lourd d’avoir trop mangé, et de distraire son esprit quand il est fatigué de sa propre stupidité. L’art ne doit jamais chercher à être populaire ; c’est au public de se faire artiste lui-même."
                                            },
                                            {
                                                "example_id": "036d4aaa-78c8-4ad9-b8e8-2ff90fa4e4f3",
                                                "sense_id": "68c2ed07-87c8-36d5-b8ac-f4600e86980a",
                                                "text": "C'est contre sa bigoterie, sa stupidité, la stupidité mesquine des médiocres qui veulent briser les ailes du génie, que Thea Kronborg devra livrer la plus dure des luttes qui la mèneront finalement au succès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18fa5feb-2d98-3eae-b29e-791b5f12efe2",
                                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                                        "glosses": [
                                            "Parole ou action stupide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e9545f5-79a2-4c1e-b616-c25833218e35",
                                                "sense_id": "18fa5feb-2d98-3eae-b29e-791b5f12efe2",
                                                "text": "On nous dit en vain que le grec s’est réfugié dans l’enseignement supérieur, qu'il demeure entier dans quelques chaires et dans quelques bibliothèques. C'est ici la plus grande stupidité que l'on ait dite dans les temps modernes, où pourtant on ne s'est pas privé de dire des stupidités. C'est comme si l'on disait que les anciens Égyptiens vivent et revivent dans les momies des sarcophages des salles basses du Louvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792361b6-edbf-3acc-90b9-99901a589075",
                                        "entry_id": "95ca1278-e8f9-3e9b-84e1-a1339e3f3351",
                                        "glosses": [
                                            "Privation d’esprit et de jugement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9dc5cf4-116d-47eb-ab57-2ebbac1f51e4",
                                                "sense_id": "792361b6-edbf-3acc-90b9-99901a589075",
                                                "text": "Quand je pense à cette séparation, ce que je retrouve dans ma mémoire, c’est le sentiment de stupidité et d’anéantissement qui me prit tout entier quand je fus dans la rue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dea727e1-06d4-4d6b-967d-2e2868143552",
                        "source_entry_id": "41e6d61d-b0e8-37a4-8f41-987b7cab6e2c",
                        "source_sense_description": "the quality of being inept",
                        "target_lang_word": "Unfähigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unfähigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                        "entry_id": "c026aef2-3cf2-3c57-b418-ffe75b6d18f0",
                                        "glosses": [
                                            "der (angeborene) Zustand, zu etwas nicht fähig oder nicht in der Lage zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc6a979-0526-4ab4-a8a8-01efd210dff1",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "Mit der Unfähigkeit, mit den Menschen nicht umgehen zu können, hatte er nie wirklich eine Chance im Berufsleben."
                                            },
                                            {
                                                "example_id": "0ce866f9-e18a-4d78-8b08-341a8c0b6803",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Diese Terrorpanikmache nutzt dem Staat, den regierenden Parteibonzen, die damit von eigenen Problemen, der eigenen Unfähigkeit ablenken können.“"
                                            },
                                            {
                                                "example_id": "3ce80a7f-6ba6-466a-a0c7-71433604c9ef",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Ich dachte an die chronische Unfähigkeit meiner Landsleute, sich einer solchen Ordnung zu unterwerfen.“"
                                            },
                                            {
                                                "example_id": "5caf9651-2ce9-4dc3-ac8c-b27fc82a2b9e",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Seiner Unfähigkeit zur prinzipiellen Sinngebung, zur Einfühlung auch, versucht Schmidt durch Reisen zu entgehen.“"
                                            },
                                            {
                                                "example_id": "80547872-983c-4137-853d-35230f505945",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Was mich so unruhig macht, ist die Unfähigkeit, mich zu beschränken oder, wie mein Agent Zohnerer sagen würde, zu konzentrieren.“"
                                            },
                                            {
                                                "example_id": "560ef93b-b3ba-4f32-a703-a28bcb7c98c2",
                                                "sense_id": "30819077-0ff9-3aec-95ff-d318229a52d1",
                                                "text": "„Der Staat, der gerade in Berlin immer wieder seine Unfähigkeit beweist, soll alles richten, während der freie Markt angeblich nichts als eine profitgierige, ‚neoliberale‘ Verirrung ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
