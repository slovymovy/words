                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5c197c0-cea6-3fcd-a8a0-75c36e3992f8",
                        "entry_id": "75271e3c-878c-3b5a-8ffe-e117c2eed50e",
                        "glosses": [
                            "het bouwen van iets aan een ander gebouw"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dd62b32e-1ac6-3f7c-af58-2aa40999ee05",
                        "entry_id": "75271e3c-878c-3b5a-8ffe-e117c2eed50e",
                        "glosses": [
                            "het aangebouwde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0defb0-75ba-4126-a1b8-15c5f935828b",
                                "sense_id": "dd62b32e-1ac6-3f7c-af58-2aa40999ee05",
                                "text": "De slaapkamer komt in de nieuwe aanbouw."
                            },
                            {
                                "example_id": "3c287b6f-b2fd-4c32-9917-298a63e1cc0c",
                                "sense_id": "dd62b32e-1ac6-3f7c-af58-2aa40999ee05",
                                "text": "Het oude kasteel heeft vele aanbouwen."
                            },
                            {
                                "example_id": "419fc691-8447-41da-8cdf-fc27e678f440",
                                "sense_id": "dd62b32e-1ac6-3f7c-af58-2aa40999ee05",
                                "text": "Tegen haar verwachting in leidt de deur niet naar de binnenplaats, maar naar een van de bijgebouwen: een lage, langgerekte aanbouw."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ade05d-c2f7-402c-a6b0-e663da2a9dea",
                        "source_entry_id": "75271e3c-878c-3b5a-8ffe-e117c2eed50e",
                        "target_lang_word": "Anbau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad7e587-ef04-3beb-a23c-3cfaa376b2d7",
                                        "entry_id": "0c032dce-173a-3f91-84db-66d00eafb4e0",
                                        "glosses": [
                                            "Kultivierung von Nutz- oder Zierpflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011c7f62-fb0e-448c-910a-41c0382b356f",
                                                "sense_id": "8ad7e587-ef04-3beb-a23c-3cfaa376b2d7",
                                                "text": "„Man meinte Palmenwälder u. baumartige Farrenkräuter zu unterscheiden; ja es wurde die Frage ventilirt: ob das Klima des Mondes wohl dem Anbau der Brunnenkresse gestatte?“"
                                            },
                                            {
                                                "example_id": "24719b40-d069-4186-9ee7-b32c051f0722",
                                                "sense_id": "8ad7e587-ef04-3beb-a23c-3cfaa376b2d7",
                                                "text": "„Anschaulich und außergewöhnlich umfassend schildert er die Historie des Anbaus, des Handels und der gesellschaftlichen Bedeutung des Genussmittels.“"
                                            },
                                            {
                                                "example_id": "b445fde3-157f-46b7-8630-4c5793348416",
                                                "sense_id": "8ad7e587-ef04-3beb-a23c-3cfaa376b2d7",
                                                "text": "„Beim Anbau und bei der Verarbeitung der Rohstoffe wie Mais oder Soja fallen jedoch andere Umweltbelastungen an und drücken so auf die Gesamt-Ökobilanz.“"
                                            },
                                            {
                                                "example_id": "23e85737-d1fd-495a-9e68-be3a976a20b0",
                                                "sense_id": "8ad7e587-ef04-3beb-a23c-3cfaa376b2d7",
                                                "text": "„Der Anbau von Gerste, Zuckerrüben, Sonnenblumen, Faserflachs und Rotklee ist in den letzten Jahrzehnten auf Kosten von Hafer, Futterrüben und Kartoffeln erweitert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d7215ec8-32cd-3b08-a867-5ebf23f22aed",
                                        "entry_id": "0c032dce-173a-3f91-84db-66d00eafb4e0",
                                        "glosses": [
                                            "bauliche Tätigkeit zur Erweiterung eines Bauwerks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47922ba2-5143-404a-a5af-1cb4657bc7c0",
                                                "sense_id": "d7215ec8-32cd-3b08-a867-5ebf23f22aed",
                                                "text": "„Da mußten Fenster existiert haben - doch die waren beim direkten Anbau des Nachbarhauses zugemauert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Anbau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd55cb10-d0be-3759-b5c7-f757f424566c",
                                        "entry_id": "3addd573-e821-324f-b15d-0a7e2619017b",
                                        "glosses": [
                                            "angefügter Gebäudeteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5f4fb1-6a0b-4cde-97e5-2df783aa0704",
                                                "sense_id": "bd55cb10-d0be-3759-b5c7-f757f424566c",
                                                "text": "Diese Stube, die wie die ganze eine Hälfte des Hauses ein Anbau war, war größer und vornehmer."
                                            },
                                            {
                                                "example_id": "f37c840d-70b0-4993-9183-9fb011ed0adf",
                                                "sense_id": "bd55cb10-d0be-3759-b5c7-f757f424566c",
                                                "text": "In dem modernen Anbau sollen Service-Einrichtungen wie Cafeteria und Bibliothek untergebracht werden, aber auch vorübergehende Ausstellungen zu sehen sein."
                                            },
                                            {
                                                "example_id": "56c9a856-de0a-4334-8002-aa70fba0e079",
                                                "sense_id": "bd55cb10-d0be-3759-b5c7-f757f424566c",
                                                "text": "„Um das Haus herum waren endlos viele kleine Anbauten aus Brettern, Kistenlatten und Blech zusammengenagelt, immer einer an dem anderen.“"
                                            },
                                            {
                                                "example_id": "ecb0eba3-f38e-4c09-aa46-57f00f4d0626",
                                                "sense_id": "bd55cb10-d0be-3759-b5c7-f757f424566c",
                                                "text": "„Und auch für viel Geld sind Architekten nicht zu finden, die es reizte, einen schönen Anbau zu entwerfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "377e6666-757d-4a43-a0d0-0ec024f624f6",
                        "source_entry_id": "75271e3c-878c-3b5a-8ffe-e117c2eed50e",
