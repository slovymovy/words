    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                "word": "doyenne",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "180eb172-fab3-4c81-89b7-485a1632c5f0",
                        "entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "tags": [
                            "plural"
                        ],
                        "form": "doyennes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "685edfc0-7573-387a-ae50-d59b41017743",
                        "entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "glosses": [
                            "A female doyen."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "18594ad3-8c68-35fe-95e0-d75d740e458e",
                        "entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "glosses": [
                            "The senior or eldest female member of a group, especially one who is most or highly respected."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26bbe000-2499-4380-b5c9-d274d97b7653",
                                "sense_id": "18594ad3-8c68-35fe-95e0-d75d740e458e",
                                "text": "Helen Thomas is frequently referred to as \"the doyenne of the White House press corps\"."
                            },
                            {
                                "example_id": "ccb0592f-5308-4362-83fc-1441df97a9d2",
                                "sense_id": "18594ad3-8c68-35fe-95e0-d75d740e458e",
                                "text": "The French, who celebrated her as the doyenne of humanity, had their own theories about why she lived so long, noting that she used to eat more than two pounds of chocolate a week and treat her skin with olive oil, rode a bicycle until she was 100, and only quit smoking five years ago."
                            },
                            {
                                "example_id": "e70815f1-0a80-450d-9a9b-0e586e1aa52a",
                                "sense_id": "18594ad3-8c68-35fe-95e0-d75d740e458e",
                                "text": "There were encouraged and facilitated by Anna Wintour, doyenne of the fashion industry, who decided with [Hillary] Clinton that the couple should have a bigger wedding while attending their engagement bash."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e9fe1a0-ceb2-3ed6-8f7d-4e3368ccc8f1",
                        "entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "glosses": [
                            "A woman who is highly experienced and knowledgeable in a particular field, subject, or line of work; expert."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b6efdb8-8fb2-4d36-a3ac-1df8939a41ca",
                        "source_entry_id": "121455d7-d839-3f33-ab6b-a093df5d34b2",
                        "source_sense_description": "female doyen",
                        "target_lang_word": "doyenne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doyenne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebff466-86db-3d54-af62-b54af7366e78",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Celle qui est la plus ancienne suivant l’ordre de réception dans un corps, dans une compagnie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66feafd1-3f9f-3fc4-8d89-efdb806e21f9",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "La plus ancienne en âge. On dit aussi en ce sens doyenne d’âge, mais seulement dans les assemblées ou compagnies délibérantes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0dbe147-71d5-373f-8546-8a9069ad9ae4",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Nom désignant l’ambassadrice ayant passé le plus de temps dans le pays d’accueil (si le titre de doyen ne revient pas au nonce apostolique). Elle a dès lors le rôle de porte-parole du corps diplomatique auprès du chef du protocole du pays d’accueil sur les questions administratives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "876ba8b0-6229-4faa-8bf7-6776541b6926",
                                                "sense_id": "a0dbe147-71d5-373f-8546-8a9069ad9ae4",
                                                "text": "Ce fait a d’ailleurs suscité des commentaires de la part de certains invités de l’ambassadrice égyptienne et doyenne du corps diplomatique, Magda Nasr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d374a5df-6a41-3e68-ab67-ba6144099419",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Titre de dignité ecclésiastique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70d4acc7-a2b1-425c-a3f7-f568f3f83d9b",
                                                "sense_id": "d374a5df-6a41-3e68-ab67-ba6144099419",
                                                "text": "Le général Flavia Byekwaso, la première porte-parole de l’armée, le révérend Can. Rebecca Nyegenye, la première femme doyenne de la cathédrale de l’Église d’Ouganda, la juge Faith Mwondha et la première femme présidente du conseil d’administration de l’Ouganda Bible Society, ont reçu des plaques en reconnaissance de leur contribution à l’élimination des barrières entre les sexes sur les lieux de travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d794538-4a8d-3138-9c2e-f9d4742c4540",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Titre de la première dignité dans les facultés d’une université."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c0a0473-876a-38b7-b1b7-6b1dc3de6b1e",
                                        "entry_id": "a153e7a4-eb0c-3260-a53d-6fdb4ae37ae5",
                                        "glosses": [
                                            "Épouse d’un doyen."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "doyenne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3817a537-1121-3a15-aac1-fb9a513c231c",
                                        "entry_id": "710d65cc-fea4-35b9-8d0f-2475606daaba",
