                        "examples": [
                            {
                                "example_id": "26798da2-2837-46a2-9ba7-2856e891cc23",
                                "sense_id": "13618cfe-d820-315a-87a7-903078b761f0",
                                "text": "„Wir wollen eine humanitäre Aufnahmepolitik, bei der der Bund und die Länder kooperativ zusammenarbeiten und die die Aufnahmebereitschaft von Kommunen und Ländern nicht mehr ignoriert.“"
                            },
                            {
                                "example_id": "3c832802-78dd-46eb-920a-f14a242daa12",
                                "sense_id": "13618cfe-d820-315a-87a7-903078b761f0",
                                "text": "„Abseits der technischen Umsetzbarkeit geht es um Fragen gesellschaftlicher Akzeptanz und der Aufnahmebereitschaft für Neues.“"
                            },
                            {
                                "example_id": "349eaff3-3836-4a34-8c51-9b1860a2ab59",
                                "sense_id": "13618cfe-d820-315a-87a7-903078b761f0",
                                "text": "„Zusätzlich wirkt sich Ressourcenaktivierung über bedürfnisbefriedigende Erfahrungen indirekt auf die Aufnahmebereitschaft der Person für therapeutische Inhalte aus.“"
                            }
                        ],
