                {
                    "sense_id": "004864c5-b546-32a0-99cc-7bd0f3d1c161",
                    "sense_definition": "Attitude exagérée, comédie ou simulation destinée à tromper, émouvoir ou attirer l'attention.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Arrête ton <w>cinéma</w> et dis-moi simplement ce qui s'est passé.",
                            "target_lang_translations": {
                                "en": "Stop the <w>drama</w> and just tell me what happened.",
                                "ru": "Хватит ломать <w>комедию</w> и просто скажи мне, что случилось.",
                                "nl": "Hou op met je <w>aanstellerij</w> en vertel me gewoon wat er gebeurd is.",
                                "de": "Hör mit dem <w>Theater</w> auf und sag mir einfach, was passiert ist.",
                                "pl": "Przestań <w>robić teatr</w> i po prostu powiedz mi, co się stało.",
                                "it": "Smettila con il <w>teatro</w> e dimmi semplicemente cos'è successo.",
                                "cs": "Přestaň s tím <w>divadlem</w> a řekni mi prostě, co se stalo.",
                                "tr": "Şu <w>tiyatroyu</w> bırak da bana ne olduğunu söyle.",
                                "es": "Deja ya el <w>numerito</w> y dime simplemente qué ha pasado.",
                                "zh": "别再搞这些<w>表演</w>了，直接告诉我发生了什么。"
                            }
                        },
                        {
                            "text": "Tout le monde a compris que sa colère n'était que du pur <w>cinéma</w>.",
                            "target_lang_translations": {
                                "en": "Everyone could tell their anger was just pure <w>theatrics</w>.",
                                "ru": "Все поняли, что его гнев был не более чем <w>комедией</w>.",
                                "nl": "Iedereen zag dat zijn woede pure <w>komedie</w> was.",
                                "de": "Alle haben gemerkt, dass seine Wut nur reine <w>Schauspielerei</w> war.",
                                "pl": "Wszyscy zrozumieli, że jego złość to czysta <w>komedia</w>.",
                                "it": "Tutti hanno capito che la sua rabbia era solo pura <w>commedia</w>.",
                                "cs": "Všichni poznali, že jeho vztek byl jen čistá <w>komedie</w>.",
