        "ru-extract.jsonl": [
            {
                "entry_id": "3c096ea5-f365-37f7-95d5-4f691c9b25a2",
                "word": "нечаянно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                        "entry_id": "3c096ea5-f365-37f7-95d5-4f691c9b25a2",
                        "glosses": [
                            "наречие к нечаянный; без умысла или намерения"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "e1382aec-de8c-4884-a8bd-8b7a40cf108b",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "— Варя! — сказал он, строго глядя на нее, — я выстрелил в себя нечаянно."
                            },
                            {
                                "example_id": "93b8c8ab-015c-4cd5-afae-6004463df5e8",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "Почему я не пошёл к ним навстречу, а спрятался, — не знаю; всё случилось нечаянно, в высшей степени безотчётно."
                            },
                            {
                                "example_id": "e0d726b1-3fe5-4f55-b1bb-2fc32ed88819",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "— Ты это нечаянно брякнул, это вырвалось. Тем драгоценнее признание: стало быть, тебе уж знакомая тема, об этом уж думал, о сладострастье-то."
                            },
                            {
                                "example_id": "f1617903-e7d1-43c2-b142-b4aeb99c90c6",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "Эта умерла по ошибке: выпила нечаянно яд, приготовленный мною для тёщи."
                            },
                            {
                                "example_id": "78c2b715-edaf-4a68-8a44-bc459c2e9926",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "Уснула она нечаянно, пока другие искали копейку."
                            },
                            {
                                "example_id": "eb6168e1-008a-473d-9e47-db8ce0983f7d",
                                "sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                                "text": "Он искал морского пути в Восточную Индию и не нашёл его, а открыл нечаянно нам Америку…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8c714ec-a517-4d75-9561-6808871aa1d9",
                        "source_entry_id": "3c096ea5-f365-37f7-95d5-4f691c9b25a2",
                        "source_sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                        "target_lang_word": "by accident",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "by accident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "Accidentally; unintentionally; without meaning to; as the result of an event not expected, aided, or willingly planned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f654d342-2a72-425a-923e-85aa318ddee3",
                                                "sense_id": "c63bcfd1-f2f5-36a9-8884-188d5030a459",
                                                "text": "Sorry. I knocked over the vase by accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "As the result of some undesigned, unintended, unrelated, natural, or random occurrence; as the unexpected and unforeseen result of formerly unrelated factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9044340e-d76e-403e-9ab6-c5066abc12dc",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The car got totaled by accident; a giant snowdrift fell off the church roof."
                                            },
                                            {
                                                "example_id": "bb05287d-8655-471c-92c0-d7edc7f45dd8",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The only way that project still exists today is by accident; I thought we closed it years ago."
                                            },
                                            {
                                                "example_id": "cebd0362-7c33-4da9-adc8-3450947d4aec",
                                                "sense_id": "79438e5a-6187-383e-9aef-5dfbaf143e68",
                                                "text": "The scholar thinks the quote and the parable were spoken on different occasions and only by accident were brought together here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                        "entry_id": "9bf1118c-654a-341c-8c05-15ee53d0a411",
                                        "glosses": [
                                            "By chance; unexpectedly; as the result of an unrelated series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aa47827-163d-4fd5-a6b2-2fe90e6f2f51",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "I hadn't seen her for years, but I ran into her by accident at the store."
                                            },
                                            {
                                                "example_id": "9079f2a3-7c5f-477f-8e47-7e5e935eda84",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "She overheard the information by accident."
                                            },
                                            {
                                                "example_id": "e719d215-78f7-45f7-aeb0-a25544be378d",
                                                "sense_id": "92265f56-f8a3-328b-bb1f-8e9805ff5788",
                                                "text": "Thou cam'st not to thy place by accident: It is the very place God meant for thee."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "by accident",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                        "entry_id": "9c8e2dca-c723-34cc-9f44-e6a18cb23f73",
                                        "glosses": [
                                            "Accidental; as the result of some unforeseen happening or series of events; unexpected; resulting from an event without the foresight, expectation, aid, or design of the person by whose agency it was caused; unintentional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786d10c7-77ca-4237-b8ca-be0d4608d3d9",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "The victim's death was by accident."
                                            },
                                            {
                                                "example_id": "fc16ab94-e72b-4077-b512-d6c3152e38fa",
                                                "sense_id": "53634e61-e90c-32f5-a8ea-05a3157db713",
                                                "text": "That the injury was by accident is not questioned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4f416f8-9aee-40a2-abc2-8850ac440d90",
                        "source_entry_id": "3c096ea5-f365-37f7-95d5-4f691c9b25a2",
                        "source_sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                        "target_lang_word": "accidentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accidentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "In an accidental manner; by chance, unexpectedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eb2e364-3619-410e-a956-2710d6881dd0",
                                                "sense_id": "95f70e60-e5fc-363f-9bef-95bee6365684",
                                                "text": "He discovered penicillin largely accidentally."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                        "entry_id": "56564c53-bc48-3eee-88c5-f3227804f822",
                                        "glosses": [
                                            "Unintentionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463b1f23-a913-4af8-85a3-cc2a14842eb0",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "He accidentally exposed the bacteria to mold spores."
                                            },
                                            {
                                                "example_id": "a2dae667-cc40-4d6f-95ad-40eeece0483b",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "As I arrived at the foot of the hill I overtook two ladies, whom I passed. As I did so, I brushed one of them accidently on the arm."
                                            },
                                            {
                                                "example_id": "0e549a77-c563-44a0-a3f2-5e21da031a33",
                                                "sense_id": "286befc9-3d60-3ccf-b703-bc73931ed4a9",
                                                "text": "Robins, of Torquay, had denied a single charge of causing unnecessary suffering to an animal. She claimed the microwave was accidentally turned on by one of the cats after the kitten got inside. But Knutton said the kitten was too small to even get onto the work surface."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b806d7e6-e544-4a28-bcf0-b9e27c666f21",
                        "source_entry_id": "3c096ea5-f365-37f7-95d5-4f691c9b25a2",
                        "source_sense_id": "b0252ee2-ee4c-3ee6-8dbc-2b763d77b46c",
                        "target_lang_word": "inadvertently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inadvertently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                        "entry_id": "f1758a9a-c536-367f-a001-714221579f06",
                                        "glosses": [
                                            "Unintentionally; because of an oversight."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c29052-9aa4-4215-9057-f8475f3fca36",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "'Dear me! I may have inadvertently touched the handle,' said he."
                                            },
                                            {
                                                "example_id": "42f7a729-0e98-4aef-babe-9bfdd1c01f4d",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "Neven Subotic hooked a volley wide after Ramsey inadvertently headed a Reus free-kick back into the danger zone, and Blaszczykowski was also off target when he met Kevin Grosskreutz's cross."
                                            },
                                            {
                                                "example_id": "e211a2f4-14fb-4867-8a96-d0015ac6e181",
                                                "sense_id": "bcdf109b-3c07-37b6-81f0-4f94a508fd1c",
                                                "text": "for the living human, who in grief may share deeply personal data with the commercial entity that owns the bot, but also for the ghost, which might inadvertently reveal a n old family secret from beyond the grave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
