{
    "word_family": [
        "gossiper",
        "gossipy",
        "gossipmonger",
        "gossipry"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de765805-569f-32cf-ae02-2161eaa5bcb0",
                    "sense_definition": "Idle talk about someone’s private or personal matters, especially about someone not present.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "private_talk_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to listen to the malicious <w>gossip</w> circulating around the office.",
                            "target_lang_translations": {
                                "ru": "Она отказалась слушать злобные <w>сплетни</w>, циркулирующие по офису.",
                                "zh": "她拒绝听办公室里流传的那些恶毒的<w>闲话</w>。"
                            }
                        },
                        {
                            "text": "Have you heard the latest <w>gossip</w> about the new neighbors moving in next door?",
                            "target_lang_translations": {
                                "ru": "Ты слышал последние <w>сплетни</w> о новых соседях, въезжающих рядом?",
                                "zh": "你听到关于隔壁新搬来的邻居的最新<w>八卦</w>了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "rumor",
                        "hearsay",
                        "scandal",
                        "dirt",
                        "tittle-tattle",
                        "scuttlebutt",
                        "chatter",
                        "talk"
                    ],
                    "antonyms": [
                        "fact",
                        "truth"
                    ],
                    "common_phrases": [
                        "latest gossip",
                        "juicy gossip",
                        "spread gossip",
                        "piece of gossip",
                        "hear gossip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговоры или слухи о чьих-либо личных делах, часто непроверенные или злонамеренные.",
                        "zh": "关于他人私事或个人事务的闲谈，通常指背后议论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спле́тни",
                                "target_lang_sense_clarification": "idle talk, rumors (plural)"
                            },
                            {
                                "target_lang_word": "слу́хи",
                                "target_lang_sense_clarification": "rumors, hearsay"
                            },
                            {
                                "target_lang_word": "спле́тня",
                                "target_lang_sense_clarification": "a piece of gossip (singular)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲话",
                                "target_lang_sense_clarification": "idle talk, gossip"
                            },
                            {
                                "target_lang_word": "流言蜚语",
                                "target_lang_sense_clarification": "rumors and gossip"
                            },
                            {
                                "target_lang_word": "八卦",
                                "target_lang_sense_clarification": "gossip (colloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "455bb8c8-3fb6-37f7-8237-7818dd8089fa",
                    "sense_definition": "Someone who likes to talk about other people's private or personal business.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "private_talk_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't tell him your secrets because he is a terrible <w>gossip</w> who cannot keep quiet.",
                            "target_lang_translations": {
                                "ru": "Не рассказывай ему свои секреты, потому что он ужасный <w>сплетник</w>, который не умеет молчать.",
                                "zh": "别告诉他你的秘密，他是个藏不住话的<w>长舌妇</w>。"
                            }
                        },
                        {
                            "text": "The town <w>gossip</w> knew everyone's business before they even knew it themselves.",
                            "target_lang_translations": {
                                "ru": "Главная городская <w>сплетница</w> знала о делах каждого еще до того, как они сами об этом узнавали.",
                                "zh": "镇上那个<w>爱嚼舌根的人</w>在当事人自己知道之前，就已经掌握了所有人的私事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "busybody",
                        "tattletale",
                        "blabbermouth",
                        "gossipmonger",
                        "rumormonger"
                    ],
                    "common_phrases": [
                        "town gossip",
                        "bit of a gossip",
                        "old gossip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который любит обсуждать чужую личную жизнь и распространять слухи.",
                        "zh": "喜欢谈论他人私事或传播流言的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спле́тник",
                                "target_lang_sense_clarification": "male gossip"
                            },
                            {
                                "target_lang_word": "спле́тница",
                                "target_lang_sense_clarification": "female gossip"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱嚼舌根的人",
                                "target_lang_sense_clarification": "someone who likes to gossip"
                            },
                            {
                                "target_lang_word": "长舌妇",
                                "target_lang_sense_clarification": "a gossiping woman (derogatory)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "358e678b-f89f-3dc6-ad1f-73332c5abba1",
                    "sense_definition": "A genre in contemporary media, usually focused on the personal affairs of celebrities.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "private_talk_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She buys a <w>gossip</w> magazine every week to read about her favorite movie stars.",
                            "target_lang_translations": {
                                "ru": "Она покупает журнал <w>сплетен</w> каждую неделю, чтобы почитать о своих любимых кинозвездах.",
                                "zh": "她每周都买一本<w>八卦</w>杂志，看她最喜欢的电影明星的消息。"
                            }
                        },
                        {
                            "text": "I generally dislike celebrity <w>gossip</w>, but this story about the royal family caught my attention.",
                            "target_lang_translations": {
                                "ru": "Я обычно не люблю <w>сплетни</w> о знаменитостях, но эта история о королевской семье привлекла мое внимание.",
                                "zh": "我通常不喜欢名人的<w>八卦</w>，但这个关于皇室的故事引起了我的注意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "celebrity gossip",
                        "gossip column",
                        "gossip magazine",
                        "gossip blog"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр в современных СМИ, обычно сосредоточенный на личной жизни знаменитостей.",
                        "zh": "当代媒体中专注于名人私生活的内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светская хроника",
                                "target_lang_sense_clarification": "society news, celebrity news"
                            },
                            {
                                "target_lang_word": "спле́тни",
                                "target_lang_sense_clarification": "gossip (content)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "娱乐新闻",
                                "target_lang_sense_clarification": "entertainment news"
                            },
                            {
                                "target_lang_word": "八卦新闻",
                                "target_lang_sense_clarification": "celebrity gossip news"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88e5c2b5-664e-361c-848a-03908440055c",
                    "sense_definition": "A sponsor; a godfather or godmother.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "godparent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical play, the character asked his <w>gossip</w> to hold the child during the ceremony.",
                            "target_lang_translations": {
                                "ru": "В исторической пьесе персонаж попросил своего <w>кума</w> подержать ребенка во время церемонии.",
                                "zh": "在那部历史剧中，角色请求他的<w>教父</w>在仪式上抱着孩子。"
                            }
                        },
                        {
                            "text": "He acted as a <w>gossip</w> for his best friend's newborn son at the church.",
                            "target_lang_translations": {
                                "ru": "Он выступил в роли <w>крёстного</w> для новорожденного сына своего лучшего друга в церкви.",
                                "zh": "他在教堂里担任了他挚友刚出生的儿子的<w>教父</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "godparent",
                        "sponsor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крёстный отец или крёстная мать; кум или кума (устаревшее значение).",
                        "zh": "教父或教母（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кум",
                                "target_lang_sense_clarification": "godfather of one's child (archaic/traditional)"
                            },
                            {
                                "target_lang_word": "крёстный",
                                "target_lang_sense_clarification": "godfather"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "教父",
                                "target_lang_sense_clarification": "godfather"
                            },
                            {
                                "target_lang_word": "教母",
                                "target_lang_sense_clarification": "godmother"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "533a6a66-ace6-345b-abd2-83f86fb5f2a3",
                    "sense_definition": "To talk about someone else's private or personal business, especially in a manner that spreads the information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "private_talk_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The neighbors love to <w>gossip</w> about what happens on our quiet street.",
                            "target_lang_translations": {
                                "ru": "Соседи обожают <w>сплетничать</w> о том, что происходит на нашей тихой улице.",
                                "zh": "邻居们很喜欢对我们这条安静街道上发生的事<w>说闲话</w>。"
                            }
                        },
                        {
                            "text": "It is considered very rude to <w>gossip</w> about your friends behind their backs.",
                            "target_lang_translations": {
                                "ru": "Считается очень невежливым <w>сплетничать</w> о своих друзьях у них за спиной.",
                                "zh": "在朋友背后<w>嚼舌根</w>被认为是非常无礼的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blab",
                        "tattle",
                        "dish",
                        "badmouth",
                        "talk out of turn",
                        "chat",
                        "whisper"
                    ],
                    "common_phrases": [
                        "gossip about",
                        "love to gossip",
                        "stop gossiping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обсуждать чужую личную жизнь, особенно распространяя слухи.",
                        "zh": "谈论他人的私事，尤指传播未经证实的信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спле́тничать",
                                "target_lang_sense_clarification": "to spread gossip"
                            },
                            {
                                "target_lang_word": "суда́чить",
                                "target_lang_sense_clarification": "to gossip/judge (colloquial)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说闲话",
                                "target_lang_sense_clarification": "to gossip"
                            },
                            {
                                "target_lang_word": "嚼舌根",
                                "target_lang_sense_clarification": "to gossip (idiomatic)"
                            },
                            {
                                "target_lang_word": "八卦",
                                "target_lang_sense_clarification": "to gossip (colloquial)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8caa695f-7860-3965-a03a-a303d5614e44",
                    "sense_definition": "To talk idly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idle_talk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We used to sit on the front porch and <w>gossip</w> for hours about nothing in particular.",
                            "target_lang_translations": {
                                "ru": "Мы обычно сидели на крыльце и часами <w>болтали</w> ни о чем.",
                                "zh": "我们过去常坐在前廊上，漫无目的地<w>闲聊</w>几个小时。"
                            }
                        },
                        {
                            "text": "They met to <w>gossip</w> over coffee and catch up on old times.",
                            "target_lang_translations": {
                                "ru": "Они встретились, чтобы <w>поболтать</w> за кофе и вспомнить старые времена.",
                                "zh": "他们见面喝咖啡<w>闲聊</w>，叙叙旧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chat",
                        "chatter",
                        "natter",
                        "chinwag",
                        "prattle"
                    ],
                    "common_phrases": [
                        "gossip over coffee",
                        "sit and gossip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести непринужденную беседу, болтать.",
                        "zh": "进行闲谈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болта́ть",
                                "target_lang_sense_clarification": "to chat, to chatter"
                            },
                            {
                                "target_lang_word": "секре́тничать",
                                "target_lang_sense_clarification": "to share secrets, to whisper"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闲聊",
                                "target_lang_sense_clarification": "to chat idly"
                            },
                            {
                                "target_lang_word": "唠嗑",
                                "target_lang_sense_clarification": "to chat (colloquial)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e399d7c4-b4dc-3017-969e-91bd9b5238c6",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gossip</w> was known in the community for his extensive library of rare books.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Госсип</w> был известен в обществе своей обширной библиотекой редких книг.",
                                "zh": "<w>戈西普</w>先生因其收藏的大量珍本书籍而在社区中闻名。"
                            }
                        },
                        {
                            "text": "We looked up the name <w>Gossip</w> in the local telephone directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали фамилию <w>Госсип</w> в местном телефонном справочнике.",
                                "zh": "我们在当地电话簿里查找了<w>戈西普</w>这个名字。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Госсип",
                                "target_lang_sense_clarification": "transliteration"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戈西普",
                                "target_lang_sense_clarification": "transliteration of the surname Gossip"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}