                                                "example_id": "c39e2933-a64e-4c64-9692-96f603620899",
                                                "sense_id": "2cef7c62-45b5-3048-8e7a-50cef3234280",
                                                "text": "No company comes / But a rabble of tenants, and rusty dull rums."
