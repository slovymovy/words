        "fr-extract.jsonl": [
            {
                "entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                "word": "nécessairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb3b1e71-8bd4-34a3-84c9-ced19cf42f86",
                        "entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "glosses": [
                            "D’une façon nécessaire ; par un besoin absolu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f938444-cfc9-420b-b595-b5cf61f60ba3",
                                "sense_id": "cb3b1e71-8bd4-34a3-84c9-ced19cf42f86",
                                "text": "Il faut nécessairement manger pour vivre."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                        "entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "glosses": [
                            "Infailliblement ; forcément ; inévitablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67208b5-dbab-4627-8cb9-d732a2e6e1b2",
                                "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                                "text": "Sur une exoplanète, même avec les mêmes éléments de base, l’environnement (atmosphère, eau, température, etc.) diffère nécessairement de celui de notre planète."
                            },
                            {
                                "example_id": "ebe9cc6e-40b2-46fa-bd6c-35c54726dca8",
                                "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                                "text": "[…], j'ajoute qu'ils gardent toutefois les apparences : leur chef, le major Lee, est porté sur la bouteille, c'est vrai, mais ses lieutenants ne sont pas nécessairement de mauvais garçons."
                            },
                            {
                                "example_id": "06d445d1-77e3-4d60-8c34-817ba59bf47b",
                                "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                                "text": "Si je ne suis le temps, je me perds, parce que ma vie demeure arrêtée ; et d’autre part, si je suis le temps, qui se perd et coule toujours, je me perds nécessairement avec lui."
                            },
                            {
                                "example_id": "8fc1be5a-06a4-43e7-a65f-942a8bff041f",
                                "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                                "text": "A mesure que l’élasticité des vapeurs diminue, les matières sont projetées à une moindre distance, et les rapilli noirs qui sortent les premiers, lorsque la lave a cessé de couler, doivent nécessairement parvenir plus loin que les rapilli blancs."
                            },
                            {
                                "example_id": "7a974b5c-56c6-4865-b05d-ddfe7e36e11d",
                                "sense_id": "cdf74981-136f-32ce-bc4d-588e32d7958e",
                                "text": "Mais il y a une grande différence entre se représenter une chose comme existant nécessairement, et se la représenter nécessairement comme existante."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1324ae7-7d37-37c8-b474-750554c89600",
                        "entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "glosses": [
                            "Il s’emploie par opposition à librement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a3f5748-1605-4ed4-a4e3-afabac3816b0",
                        "source_entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "target_lang_word": "notwendig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notwendig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b1a9a1d-4819-36b2-a756-c188343fd4fe",
                                        "entry_id": "19176aa5-5761-370c-8cbd-9ea6191df903",
                                        "glosses": [
                                            "unter allen Umständen erforderlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca460c2-f57b-4074-9189-a7432e370534",
                                                "sense_id": "9b1a9a1d-4819-36b2-a756-c188343fd4fe",
                                                "text": "Die Regierung verabschiedete eine notwendige Gesetzesreform."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c150987-39e1-37ad-a190-6166c2a8b451",
                                        "entry_id": "19176aa5-5761-370c-8cbd-9ea6191df903",
                                        "glosses": [
                                            "in der Konsequenz unvermeidbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2986b7-8d34-4c7f-960a-fb1b169a4ce9",
                                                "sense_id": "3c150987-39e1-37ad-a190-6166c2a8b451",
                                                "text": "Ist die Arbeitslosigkeit eine notwendige Folge des technischen Fortschritts?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44db21ad-28bb-46e5-9878-49e58323f80d",
                        "source_entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "target_lang_word": "vonnöten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vonnöten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "337c1fcc-8882-3e56-9961-545eac92b681",
                                        "entry_id": "a081d5f6-07f7-34b7-b1be-8a694ae1822f",
                                        "glosses": [
                                            "für einen bestimmten Zweck zwingend, nachdrücklich geboten, nötig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d971c4-3a6c-4a8c-baf4-9d564579ada2",
                                                "sense_id": "337c1fcc-8882-3e56-9961-545eac92b681",
                                                "text": "Größere Beteiligung am Prozess ist vonnöten."
                                            },
                                            {
                                                "example_id": "1c1e4ace-0c54-402e-b85e-8b37ae53f523",
                                                "sense_id": "337c1fcc-8882-3e56-9961-545eac92b681",
                                                "text": "Um dieses Problem zu bewältigen, ist viel Erfahrung vonnöten."
                                            },
                                            {
                                                "example_id": "2db8dbb4-fe1f-4804-a71b-a52446c06861",
                                                "sense_id": "337c1fcc-8882-3e56-9961-545eac92b681",
                                                "text": "Es ist eine Menge Disziplin vonnöten, um die Prüfungen zu bestehen."
                                            },
                                            {
                                                "example_id": "d4779626-0e01-4b29-a6a1-8d24eec196da",
                                                "sense_id": "337c1fcc-8882-3e56-9961-545eac92b681",
                                                "text": "„›Es ist wahr‹, sagte er, ›in meiner Kasse wirst du keinen großen Vorrat antreffen: aber ich hinterlasse dir sechzig Millionen vergnügte, wohl genährte, wohl gekleidete, wohl gesittete, fleißige und unsrer Regierung wohl geneigte Untertanen, welche, sobald du sie zum Besten des Staats vonnöten hast, mit allen ihren Fähigkeiten, mit allem ihrem Vermögen, mit allem Blut in ihren Adern, freiwillig dein eigen sind.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "921927dd-3b1c-4a06-b7e9-c1a31ac1b2a4",
                        "source_entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "target_lang_word": "necessarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necessarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                        "entry_id": "a235f6aa-322a-3eb3-9b85-6bedeefe0837",
                                        "glosses": [
                                            "Inevitably; of necessity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acc75b67-f1d2-4283-b953-7fb4a0795006",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "It is not necessarily true that children get their morals from their parents."
                                            },
                                            {
                                                "example_id": "cdce5b1d-007b-40d1-b345-97f2940540ab",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "But clever cities will not necessarily be better ones."
                                            },
                                            {
                                                "example_id": "05607629-a489-405f-a83c-d7200b806f09",
                                                "sense_id": "481c84eb-eb4e-3811-9e07-3a079109b8da",
                                                "text": "Oregon’s uptick in marijuana sales along the Idaho border doesn’t necessarily mean that it’s all Idahoans who are lighting up, Lehner said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9769996f-e923-46b8-87ef-0d465a0b9f14",
                        "source_entry_id": "b904423b-5746-3414-9d8f-037c6c89d67e",
                        "target_lang_word": "inevitably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inevitably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "In a manner that is impossible to avoid or prevent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08800aaa-6923-483d-aa77-7be4292fad13",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Inevitably, all creatures eventually die."
                                            },
                                            {
                                                "example_id": "5827a595-83c6-484b-9bc4-c0a5881c1a61",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The sun inevitably rises."
                                            },
                                            {
                                                "example_id": "06bf50fd-b154-4936-9eb2-e3fe5abba149",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Despite the town's best efforts, the dam inevitably gave way."
                                            },
                                            {
                                                "example_id": "db8f225d-9ab6-4e49-ba19-07d68df88c12",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The inevitably cold winter approaches."
                                            },
                                            {
                                                "example_id": "409248be-d951-46c3-b7e3-0eca0be61dc0",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "In a period of transition from steam to diesel, many of the schemes are inevitably of an interim nature and only on full dieselisation will the final pattern be determined and full benefit derived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "As usual; predictably; as expected."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94f48e5-d72a-4b55-8a4f-83af29ec993e",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Inevitably, the next-door neighbour began to mow his lawn just as she lays down her head after a long night shift."
                                            },
                                            {
                                                "example_id": "0ee46b52-0abd-4d75-a09e-3a3829bb3924",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The child inevitably began to cry when his mother went to work."
                                            },
                                            {
                                                "example_id": "28c305d3-4fc2-4be3-b7f6-117a34258d46",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The inevitably long line of customers queued for the latest 'Harry Potter'."
                                            },
                                            {
                                                "example_id": "4930ca80-51b7-41c5-8c1a-f41c6cec8d05",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Far from it: direct military intervention by a Western state – even if Prime Minister Nuri al-Maliki is requesting it – would dramatically worsen the situation, and ISIS, contrary to what pro-interventionists might say, would inevitably come out on top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
