                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1491228-3cda-4876-b5e8-e280854ad18e",
                                "sense_id": "dfa997cf-4ab2-381f-aa98-91e5be7f16c4",
                                "text": "„Er kratzte sich am Cap und bemerkte, dass vielen Leuten nicht klar wäre, welche Schwierigkeiten ein völlig gewöhnlicher Linienbus bereiten könnte, wenn asphaltiert werden sollte.“"
                            },
                            {
                                "example_id": "c67b63cf-382b-4982-a081-6e0fdf30dbd1",
                                "sense_id": "dfa997cf-4ab2-381f-aa98-91e5be7f16c4",
                                "text": "„Mitten auf der Strecke, wo die Küstenstraße besonders eng war, kam ihnen der andere Linienbus entgegen.“"
                            }
                        ],
