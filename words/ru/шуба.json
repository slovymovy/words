    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5e4f6b3-6928-3a6d-baa5-be5bb0c9da90",
                    "sense_definition": "Верхняя зимняя одежда из меха или на меху.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой в России все носят теплую <w>шубу</w>.",
                            "target_lang_translations": {
                                "en": "In winter in Russia, everyone wears a warm <w>fur coat</w>."
                            }
                        },
                        {
                            "text": "Она купила новую длинную <w>шубу</w> к зиме.",
                            "target_lang_translations": {
                                "en": "She bought a new long <w>fur coat</w> for the winter."
                            }
                        }
                    ],
                    "common_phrases": [
                        "натуральная шуба",
                        "дорогая шуба"
                    ],
                    "target_lang_definitions": {
                        "en": "An outer winter garment made of fur or lined with fur."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fur coat",
                                "target_lang_sense_clarification": "A garment worn for warmth in winter."
                            }
                        ]
