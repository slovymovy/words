                ],
                "senses": [
                    {
                        "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                        "entry_id": "f686550c-ed1b-36b2-9725-e1777ce8cd42",
                        "glosses": [
                            "ein rotierendes kreisrundes Schneidwerkzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c6892a6-d4cb-4e00-883f-b3d7ac58ecab",
                                "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                                "text": "„Hier können der Stahlboden und damit die Messerscheibe an einem kleinen Kunststoffgriff auf- und mit eingelegter Nuss wieder zugedreht werden.“"
                            },
                            {
                                "example_id": "36f41f63-344a-4e11-b688-3fce7d07b6f4",
                                "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                                "text": "„In der Holzputzerei wird das Holz zuerst auf Kreissägen auf die für die nachfolgenden Arbeitsmaschinen passende Länge geschnitten, worauf dann dessen Schälung an meist senkrecht umlaufenden Messerscheiben erfolgt.“"
                            },
                            {
                                "example_id": "be84941f-1675-45ee-9231-5bb5dc933e44",
                                "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                                "text": "„Die Messerscheiben sind von Gehäusen umgeben, die je einen schräg nach unten gegen die Messerseite hinführenden Führungsschacht tragen.“"
                            },
                            {
                                "example_id": "101ca8b4-02fd-4eff-ba78-6ef98969379f",
                                "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                                "text": "„Die drehende Bewegung dieser Messerscheibe erreicht eine hohe Schnittgeschwindigkeit, erreicht ferner, den abgeschnittenen Rübenkopf mit Kraut auf die Seite zu bringen und das Verstopfen am Messer zu verhüten.“"
                            },
                            {
                                "example_id": "265bb25c-206a-4a08-a7e7-b40c2d468561",
                                "sense_id": "03639009-d86a-3549-a29e-f2d480d23a44",
                                "text": "„Rübenschneider mit konischer Schneidtrommel oder senkrechter Messerscheibe sind zum Nachstopfen und Lockern des Schneidgutes mit einem Holzstößel auszurüsten, der an der Maschine entsprechend befestigt sein muß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
