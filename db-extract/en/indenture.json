                    {
                        "translation_id": "b29646b3-795d-4b28-8973-639f0509b8a7",
                        "source_entry_id": "cc372fde-b1da-361f-b82a-1248c1a427da",
                        "source_sense_description": "contract",
                        "target_lang_word": "Arbeitsvertrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeitsvertrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                        "entry_id": "6ae7212f-6654-3177-a72b-62757143202c",
                                        "glosses": [
                                            "ein Vertrag zwischen Arbeitnehmer und Arbeitgeber, der wesentliche tarifliche oder außertarifliche Abmachungen, im rechtlichen Rahmen, schriftlich festhält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca95f442-c1e9-4bbc-afd9-3c9a7cc3528d",
                                                "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                                "text": "Dieser Arbeitsvertrag ist rechtswidrig, es müssen Anpassungen gemacht werden."
                                            },
                                            {
                                                "example_id": "92a2759b-8ffe-484f-8f44-c05191483b38",
                                                "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                                "text": "Er hat den Arbeitsvertrag und darf morgen anfangen."
                                            },
                                            {
                                                "example_id": "5082f9be-2048-4e0c-bb70-0365dc3d0785",
                                                "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                                "text": "„Ich wollte zu dem einen Prozent (derjenigen) gehören, die einen festen Arbeitsvertrag ergattern.“"
                                            },
                                            {
                                                "example_id": "4ecbc9ef-caad-4f3d-8546-0b16dd74a761",
                                                "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                                "text": "„Toms Professor wurde der Arbeitsvertrag nicht verlängert.“"
                                            },
                                            {
                                                "example_id": "790965d8-0bf0-41da-9c2d-886cd4e17f4c",
                                                "sense_id": "7e7d11d8-ea92-3366-abaf-ced91441dadf",
                                                "text": "„Frau Castrup legte einen vorgefertigten Arbeitsvertrag auf den Tisch, trug Hennis Namen und einige Daten ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9156d631-c6c9-4c80-9b97-88eb3b64a7fa",
