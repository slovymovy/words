        "fr-extract.jsonl": [
            {
                "entry_id": "f125bbd2-4704-33d5-b16d-0e917456c221",
                "word": "porte-voix",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6766cdc5-3527-4c75-9996-dcc3c7907600",
                        "entry_id": "f125bbd2-4704-33d5-b16d-0e917456c221",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "portevoix"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8961c2bf-0904-3f03-9bdb-e6193a57aa8d",
                        "entry_id": "f125bbd2-4704-33d5-b16d-0e917456c221",
                        "glosses": [
                            "Tuyau de métal, en forme de trompette droite et largement évasée, qui sert à porter la voix au loin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc24a739-6702-408b-8c07-24f16c1a3d07",
                                "sense_id": "8961c2bf-0904-3f03-9bdb-e6193a57aa8d",
                                "text": "Et comme un auto-car bondé d'Américains stoppait non loin de nous, il cria tout à coup, les mains en porte-voix."
                            },
                            {
                                "example_id": "34566d5a-5a2c-475d-a110-75ebcb0b23bc",
                                "sense_id": "8961c2bf-0904-3f03-9bdb-e6193a57aa8d",
                                "text": "Il vit alors 30 bateaux ornés d’un dragon émerger du fond du lac ainsi qu’un bateau doré, couvert de parasols, pavoisé de pavillons, sur lequel se tenaient trois seigneurs, vêtus d’habits rouges et armés de porte-voix à l’aide desquels ils commandaient la manœuvre des autres bateaux."
                            },
                            {
                                "example_id": "559add4a-f2a2-4d98-aac5-e11fa56d6e18",
                                "sense_id": "8961c2bf-0904-3f03-9bdb-e6193a57aa8d",
                                "text": "Le mégaphone électronique a succédé au porte-voix."
                            }
                        ]
                    },
                    {
                        "sense_id": "102941d7-42cb-3199-907e-7a7dfaadfe2c",
                        "entry_id": "f125bbd2-4704-33d5-b16d-0e917456c221",
                        "glosses": [
                            "Personne qui n’exprime que des idées qui lui sont dictées par une autre personne ou un groupe."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3da300c1-1248-4378-8eb6-65a0f6b4851c",
                                "sense_id": "102941d7-42cb-3199-907e-7a7dfaadfe2c",
                                "text": "Blanquiste et boulangiste, révolutionnaire de gauche et de droite, idéaliste et démagogue, il s’était fait le porte-voix de cent causes contradictoires."
                            },
                            {
                                "example_id": "0f651fb4-8914-45fd-97ab-a27832dd16ad",
                                "sense_id": "102941d7-42cb-3199-907e-7a7dfaadfe2c",
                                "text": "Lundi, quatre nouveaux députés, élus à la fin juin, ont fait leur entrée aux Communes. Aussitôt dans leur siège, ils sont entrés dans le moule, celui de porte-voix. Trop heureux de poser une question, ils s’en sont tenus au message convenu par leur parti."
                            },
                            {
                                "example_id": "c2645521-619a-41bc-87f5-df8dffd9b69a",
                                "sense_id": "102941d7-42cb-3199-907e-7a7dfaadfe2c",
                                "text": "Hebe Pastor de Bonafini, porte-voix des « Mères de la place de Mai », est décédée dimanche à l’âge de 93 ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f4d7c6e-6fb4-48df-b817-96795d0f8e99",
