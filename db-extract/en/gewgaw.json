            },
            {
                "entry_id": "7d02748c-ce95-3281-a3c0-b2aedbd6c4cb",
                "word": "gewgaw",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "10a689df-d24c-409a-be41-324558d6aa24",
