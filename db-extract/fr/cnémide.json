                                        "entry_id": "0ea8bb26-7715-3e55-882d-6afc33e5c7b5",
                                        "glosses": [
                                            "A piece of armour that protects the leg, especially the shin, and occasionally the tops of the feet."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192aa841-5bca-48c1-b70a-c828e7d081b2",
                                                "sense_id": "dcc356e6-0433-3b8a-a352-056924be1801",
                                                "text": "And through the stained windows bright, / From o'er the red-tiled eaves, / The sunlight blazed with colored light / On golden helms and greaves."
                                            },
                                            {
                                                "example_id": "8f32bca1-2cc6-41de-adb6-1e5599e0f9d1",
                                                "sense_id": "dcc356e6-0433-3b8a-a352-056924be1801",
                                                "text": "Then he cast off his breast-plate, thigh pieces, and greaves, while Alleyne followed his example."
                                            }
                                        ]
