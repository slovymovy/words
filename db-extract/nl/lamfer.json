                        "examples": [
                            {
                                "example_id": "47edc596-ce8f-4f37-9ca2-e2168828f5eb",
                                "sense_id": "fab417cc-6d5b-3671-a16a-45821beeeabc",
                                "text": "Vanaf de late 13de en vooral in de 14de eeuw werd de kaproen opgenomen in de garderobe van de adel. Uiteraard onderging ze onmiddellijk allerlei verfraaiingen. Allereerst werd kostbare textiel, zoals fijn laken en fluweel gebruikt voor de vervaardiging ervan. Het manteltje en de kap namen vervolgens in omvang toe en de punt van de kap, de lamfer, werd steeds langer en kon zelfs tot de grond reiken."
                            },
                            {
                                "example_id": "077d0c2b-e2bb-425e-a9fb-943377c91023",
                                "sense_id": "fab417cc-6d5b-3671-a16a-45821beeeabc",
                                "text": "De figuur draagt een blauw hoofddeksel met afhangende doek (lamfer) en een wijde geplooide beige mantel die rood gevoerd is."
                            }
                        ]
                    }
