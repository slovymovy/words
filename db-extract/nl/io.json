                        ]
                    },
                    {
                        "translation_id": "e65ca891-1325-4822-bc93-02b4f96a6c31",
                        "source_entry_id": "2d26041c-e114-3435-a6cf-3fac1eed04b9",
                        "source_sense_id": "8e053466-0e14-3411-bcf9-4716e425ba77",
                        "target_lang_word": "Io",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Io",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17baeeb5-c390-3138-af4a-68b3d8de2304",
                                        "entry_id": "aec046c0-4fcd-38fc-b15b-e62087aab708",
                                        "glosses": [
                                            "Fille d’Inachus, maîtresse de Zeus, qui la transforma en génisse."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b656572-ceec-4197-a9b3-1f55f219ddeb",
                                                "sense_id": "17baeeb5-c390-3138-af4a-68b3d8de2304",
                                                "text": "Pyrene divinisé fut censé être le père d’Io, d’abord prêtresse de Junon, puis changée en vache. Piquée par un Taon, Io se mit à fuir devant elle, jusqu’à ce qu’elle arriva sur les bords du Nil, où elle reprit sa première forme et épousa Osiris."
                                            },
                                            {
                                                "example_id": "4deb05e6-e217-4ce5-b4d8-e595b0e7583d",
                                                "sense_id": "17baeeb5-c390-3138-af4a-68b3d8de2304",
                                                "text": "Alors arrive une victime innocente de Zeus, lo , fille d’Inachus , poursuivie dans ses courses errantes par l’amour de Zeus et par la jalousie d’Héra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933328eb-3a26-35c1-aeb6-eba1145979b2",
                                        "entry_id": "aec046c0-4fcd-38fc-b15b-e62087aab708",
                                        "glosses": [
                                            "Satellite naturel de la planète Jupiter, une des quatre lunes galiléennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c584def-ae60-4725-946f-0b61c2a03dbc",
                                                "sense_id": "933328eb-3a26-35c1-aeb6-eba1145979b2",
                                                "text": "Les satellites des planètes géantes peuvent se classer en différents groupes. Jupiter possède quatre gros satellites découverts par Galilée au début du XVIIᵉ siècle : Io, Europe, Ganymède et Callisto, appelés satellites galiléens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ae1cf6-06b1-3d4d-909d-a3a1392d4f7f",
                                        "entry_id": "aec046c0-4fcd-38fc-b15b-e62087aab708",
                                        "glosses": [
                                            "(85) Io, une planète mineure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
