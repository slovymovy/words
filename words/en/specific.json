                            {
                                "target_lang_word": "видовой",
                                "target_lang_sense_clarification": "биологический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecaad49f-81f6-3fed-9139-901cd9eec8a0",
                    "sense_definition": "Relating to a value divided by mass or another standardizing measure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>specific</w> gravity of the liquid was measured in the laboratory.",
                            "target_lang_translations": {
                                "ru": "<w>Удельный</w> вес жидкости был измерен в лаборатории."
                            }
                        },
                        {
                            "text": "Engineers calculated the <w>specific</w> orbital energy of the satellite.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали <w>удельную</w> орбитальную энергию спутника."
                            }
                        }
                    ],
                    "common_phrases": [
                        "specific gravity",
                        "specific energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к значению, деленному на массу или другую стандартизирующую меру."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удельный",
                                "target_lang_sense_clarification": "физическая величина на единицу массы"
                            },
                            {
                                "target_lang_word": "относительный",
                                "target_lang_sense_clarification": "сравнительный показатель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c0f30f7-9c73-3c13-a925-e0bafd7e5d59",
