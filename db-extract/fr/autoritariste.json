                "senses": [
                    {
                        "sense_id": "62638233-799b-342b-9d18-3c03a0d3b599",
                        "entry_id": "b2d13e68-e795-30be-8e3f-bf3aa792a1a8",
                        "glosses": [
                            "Autoritaire, relatif à l’autoritarisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be7dc794-1fd7-4f3c-bd7e-347f10a7f64d",
                                "sense_id": "62638233-799b-342b-9d18-3c03a0d3b599",
                                "text": "Cette autoritariste loi spéciale du bâillon des procureurs et des juristes de l'État, s'ajoute à tout ce qui la précède, en termes d’abus, au chapitre de l'errance politique, de l’obscurantisme libéral et du boycott d’une enquête publique sur les possibles alliances du politique avec le criminel, alliances dont les allégations sont trop nombreuses et spécifiques, pour être balayées sous les carpettes rouges qu'écrasent les fauteuils de l’actuel gouvernement de Jean Charest."
                            },
                            {
                                "example_id": "54eda6fa-70bd-4ef6-8c52-29e37336c236",
                                "sense_id": "62638233-799b-342b-9d18-3c03a0d3b599",
                                "text": "Pour certains bénévoles et contributeurs, cette affaire et ses suites sont devenues l’un des symboles d’un manque criant de transparence, d’une concentration des pouvoirs et de pratiques autoritaristes au sein de la direction."
                            }
                        ]
                    }
