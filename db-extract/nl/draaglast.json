                "senses": [
                    {
                        "sense_id": "2d2daba9-0eaf-393c-9021-c5c0c4be9622",
                        "entry_id": "7b009cc8-6a29-3877-85cc-38b640535eca",
                        "glosses": [
                            "dat wat een constructie moet dragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d49cf00c-bf7d-49e7-b37c-79a33f761cd6",
                                "sense_id": "2d2daba9-0eaf-393c-9021-c5c0c4be9622",
                                "text": "Volgens Rijkswaterstaat kan er uit het oogpunt van veiligheid slechts verkeer tot een maximale draaglast van 38 ton over de bruggen. De dienst vraagt wegbeheerders zoals de provincie Overijssel daarom om ervoor te zorgen dat zwaarder verkeer niet meer over de zwakke bruggen rijdt."
                            }
                        ]
                    },
                    {
                        "sense_id": "d58cb714-4621-3ca3-b9d1-be09ed31d0a1",
                        "entry_id": "7b009cc8-6a29-3877-85cc-38b640535eca",
                        "glosses": [
                            "dat wat een persoon draagt aan ellende"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "49ad0454-16dc-4a10-bdfd-240f1be9f8f7",
                                "sense_id": "d58cb714-4621-3ca3-b9d1-be09ed31d0a1",
                                "text": "Ons onderzoek toont aan dat juist uitsluiting en stigmatisering belangrijke factoren zijn die bijdragen aan de draaglast van de ziekte en medebepalend zijn voor de ervaren kwaliteit van leven."
                            }
                        ]
                    }
                ],
