                "entry_id": "24f1a9d3-75be-3491-9ac0-99e9f143b072",
                "word": "pétasite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0c77d988-8181-4507-b57a-392f54143a6d",
                        "entry_id": "24f1a9d3-75be-3491-9ac0-99e9f143b072",
                        "tags": [
                            "plural"
                        ],
                        "form": "pétasites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36e12d84-10dd-32cc-aa1b-4cd088b545b7",
                        "entry_id": "24f1a9d3-75be-3491-9ac0-99e9f143b072",
                        "glosses": [
                            "Plantes de la famille des astéracées comprenant environ quinze espèces de vivaces dioïques, rhizomateuses, originaires d’Europe, d’Asie et d’Amérique du Nord."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe3427d-37c5-4449-933c-e593b4388233",
                                "sense_id": "36e12d84-10dd-32cc-aa1b-4cd088b545b7",
                                "text": "Le pétasite (Petasites japonicus) fleurit tôt au printemps, avant l’apparition de ses feuilles, car ses bourgeons floraux sont déjà formés en automne."
                            },
                            {
                                "example_id": "b8bf1f47-07cf-465b-9a1b-1a2c2079d67f",
                                "sense_id": "36e12d84-10dd-32cc-aa1b-4cd088b545b7",
                                "text": "En me penchant pour observer, comme l’inspecteur des Eaux et Forêts me l’avait conseillé, je pus remarquer une quantité de petits grains couleur terre cuite posés sur les grandes feuilles de la pétasite, sur les vieilles bornes et sur la mousse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c932c614-d655-4cb5-952f-e2f2fb0f17c3",
                        "source_entry_id": "24f1a9d3-75be-3491-9ac0-99e9f143b072",
                        "source_sense_id": "36e12d84-10dd-32cc-aa1b-4cd088b545b7",
                        "target_lang_word": "Pestwurz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pestwurz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                        "entry_id": "a46a8c11-58ba-354c-9c58-b3d7f1d68827",
                                        "glosses": [
                                            "eine mehrjährige, krautige Pflanze mit zahlreichen Blüten in Traubenform und breiten Blättern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c1c49e-1568-4a0b-a8f7-243f596f910f",
                                                "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                                "text": "Die Pestwurz kommt in Europa vor und wächst hauptsächlich an Bächen und Flussufern."
                                            },
                                            {
                                                "example_id": "57615b35-a559-44ad-9efa-48c2b80cd74e",
                                                "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                                "text": "Rasch beginnen Hochstauden wie Pestwurz und Alpen Milchlattich die einstige Alm zu erobern."
                                            },
                                            {
                                                "example_id": "585dd8f9-b2a9-4f98-a97d-2955fcbfaa98",
                                                "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                                "text": "»Die Pestwurz sieht an der Unterseite silbrig aus. Wenn sich die Blätter nach oben drehen, bedeutet das, dass es bald regnen wird.«"
                                            },
                                            {
                                                "example_id": "74855701-f9f3-4047-94c4-2708fa38ced1",
                                                "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                                "text": "Laut einer Studie der Schmerzklinik Kiel kann das Extrakt der Pestwurz Migräneattacken um 58 Prozent reduzieren."
                                            },
                                            {
                                                "example_id": "e2f84cdf-3a49-4715-aa72-1ac871e35050",
                                                "sense_id": "3f156ffe-eaa6-36d5-9aad-758aa9a24024",
                                                "text": "Viele Pflanzen bilden Pyrrolizidinalkaloide, einige von ihnen sind in der Volksmedizin als Heilkräuter bekannt. Huflattich etwa, Beinwell oder Pestwurz. Von Huflattich und Pestwurz gibt es mittlerweile nahezu PA-freie Züchtungen, die zu pflanzlichen Arzneimitteln verarbeitet werden dürfen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
