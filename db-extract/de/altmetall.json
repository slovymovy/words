                "senses": [
                    {
                        "sense_id": "0b5793f4-6118-3d2f-80fa-0030cf0ee2a3",
                        "entry_id": "8b9a5c77-4c9d-3d86-90cd-0712dcf80180",
                        "glosses": [
                            "Gegenstände aus Metall, die übrig bleiben oder wiedergewonnen werden, wenn die Objekte, in denen sie enthalten waren, außer Gebrauch kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a7795e-6922-4bd7-a4bf-fbeb68a3e628",
                                "sense_id": "0b5793f4-6118-3d2f-80fa-0030cf0ee2a3",
                                "text": "Altmetalle sind oft wertvolle Rohstoffe."
                            },
                            {
                                "example_id": "223da9d9-ca68-4a0d-8f84-3dc29f049d4b",
                                "sense_id": "0b5793f4-6118-3d2f-80fa-0030cf0ee2a3",
                                "text": "„Im ersten vorchristlichen Jahrhundert wurde in größerem Maße Altmetall recycelt, wohl nicht aus Umweltbewusstsein, sondern weil die Stadt wirtschaftlich schwächelte und es an Ressourcen mangelte.“"
                            },
                            {
                                "example_id": "0bf20cff-af68-4a5b-9035-7737b3e1dba4",
                                "sense_id": "0b5793f4-6118-3d2f-80fa-0030cf0ee2a3",
                                "text": "„Schmiede recycelten Altmetall, vermutlich weil sie kein Eisenerz mehr hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
