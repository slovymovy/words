                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abnormität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                                        "glosses": [
                                            "Abweichung vom Üblichen/Normalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f81c9b2-a756-4045-b079-38e9cd80e939",
                                                "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                                                "text": "„Das Böse ist für den Kriminalpsychiater Kröber keine Abnormität, sondern ein Teil des Menschseins – es ist der Preis der Entscheidungsfreiheit jedes Einzelnen im Sinne der biblischen Schöpfungsgeschichte.“"
                                            },
                                            {
                                                "example_id": "b63b9263-051b-4a97-b9e8-690b1f2fe7fb",
                                                "sense_id": "609d34d6-d518-364c-9beb-a904c3b7e02d",
                                                "text": "„Sie hatten schon so manche Abnormität gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6446d4b2-cae8-3ea7-a287-1b77486fde38",
                                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                                        "glosses": [
                                            "krankhafte Erscheinung"
                                        ],
                                        "tags": [
                                            "meist Medizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a5b8f62-8bdb-4453-bdf4-0052ada9604f",
                                                "sense_id": "6446d4b2-cae8-3ea7-a287-1b77486fde38",
                                                "text": "Bei ihr wurde eine Abnormität im Gehirn festgestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d3fe4468-010a-313d-9fc1-a0b8feddb9b9",
                                        "entry_id": "e53fd2e8-ed65-30bd-b955-b5a035435946",
                                        "glosses": [
                                            "Wesen, das missgebildet ist"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43516eba-40eb-49c8-b674-8fe32fc2e294",
                                                "sense_id": "d3fe4468-010a-313d-9fc1-a0b8feddb9b9",
                                                "text": "Früher wurden Abnormitäten auf Jahrmärkten als Attraktion zur Schau gestellt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0b92934-41ab-4e32-9f25-f4bf3a48bcb4",
                        "source_entry_id": "e6ff11ce-a3e2-3d01-bdb9-70d2a300649c",
                        "source_sense_id": "4a990ef5-ba49-3031-b0ae-9dc9805d5397",
                        "target_lang_word": "Anomalie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anomalie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                        "entry_id": "91b0cb7a-1867-39a6-8370-94af5dbc2428",
                                        "glosses": [
                                            "eine Abweichung vom Allgemeinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c68caff-b188-4f69-a89f-eee51430a114",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Auch in der nächsten Generation fand sich diese Anomalie.“"
                                            },
                                            {
                                                "example_id": "8e7aefc7-e8fe-4365-9e62-c6d00a89d016",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Bei der Messung traten Anomalien auf."
                                            },
                                            {
                                                "example_id": "8a42ea27-bb18-4b61-b405-fc2780d21c55",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Ohne die Anomalie des Wassers frören winters alle Flüsse bis auf den Grund, es könnten dann wohl in unseren Breiten keine Fische dauerhaft existieren."
                                            },
                                            {
                                                "example_id": "40d345e9-1a66-4f4b-93c9-39b33b2a5ba7",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "Es kommt oft zu Anomalien im Erdmagnetfeld."
                                            },
                                            {
                                                "example_id": "b1248063-00c9-43c8-bbd5-2c83d6b216e5",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Sie hatte signifikante Hinweise aus ihren Beobachtungen gewonnen, dass solche Anomalien immerhin auch auf dem Mond auftraten, und, so vermutete sie, auch weit über die Mondbahn hinaus denkbar seien.“"
                                            },
                                            {
                                                "example_id": "034f47a4-513f-4618-92e4-e9db2a7b1f0c",
                                                "sense_id": "e6dfd072-9f75-358c-bca8-aed3c3daa0a7",
                                                "text": "„Das gilt in erster Linie für die Geschlechtsmoral: wo nach Freud das Unbewußte die meisten Anomalien regiert, kann wissenschaftlich nicht mehr von einem bewußten Laster die Rede sein – wogegen sich allerdings die Jurisdiktion noch immer leidenschaftlich sperrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
