                        "glosses": [
                            "een nazi-Duits vernietigings- en concentratiekamp bij de Poolse stad Auschwitz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ec89d3-1948-4377-89ca-f1f3542a54f1",
                                "sense_id": "6c66fa12-2308-331a-a0bc-d20db2771b43",
                                "text": "Herbert schreef: 'In Auschwitz en in Hiroshima is de tol die we betaald hebben beschreven in grootboeken en gebeiteld in grafstenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0d829b11-b06a-4bc3-84af-e8ae05e4dcfa",
                        "source_entry_id": "c0d2333c-4d4b-3a6d-854d-54ac16651950",
                        "source_sense_id": "8ea1bc77-335f-3ad2-8ed8-cf065334c19c",
