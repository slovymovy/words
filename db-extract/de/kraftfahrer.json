                    {
                        "sense_id": "0fd58d21-202f-3f8a-b655-3ef0c659af3c",
                        "entry_id": "2278db83-f4de-3c6d-9e80-be28c8646c4b",
                        "glosses": [
                            "Person, die ein Kraftfahrzeug fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a9545b-9141-426b-8b96-06652da6f9b3",
                                "sense_id": "0fd58d21-202f-3f8a-b655-3ef0c659af3c",
                                "text": "„Die Kraftfahrer schimpften nur und fuhren weiter.“"
                            },
                            {
                                "example_id": "52e1277a-f854-496d-9607-d1028cd4ea5a",
                                "sense_id": "0fd58d21-202f-3f8a-b655-3ef0c659af3c",
                                "text": "„So reizvoll uns Kraftfahrern diese neue Möglichkeit winterlicher Freizeitgestaltung auch erscheint, lässt sie uns doch besorgt auf das Frühjahr blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
