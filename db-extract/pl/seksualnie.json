                                                "example_id": "053be14f-cd38-466a-b634-9ee5a6ac0480",
                                                "sense_id": "4ae37a94-b8e0-3955-9688-3144f5e6610a",
                                                "text": "A parrot is a sexually reproducing organism."
                                            },
