                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "God <w>rede</w> zijn ziel in deze moeilijke tijden.",
                            "target_lang_translations": {
