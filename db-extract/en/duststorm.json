    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                "word": "duststorm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e9eaabc7-0cdb-41eb-888a-d3c0e05d2d47",
                        "entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "tags": [
                            "plural"
                        ],
                        "form": "duststorms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                        "entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "glosses": [
                            "A phenomenon in which gale- to hurricane-force winds blow soil particles up into a planet's atmosphere."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fedb9ea-aac9-4060-9d43-d0a38d4cfb73",
                                "sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                                "text": "Near-synonyms: sandstorm (broadly synonymous), haboob"
                            },
                            {
                                "example_id": "3e4c8908-225f-4a47-acee-bc391ac52517",
                                "sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                                "text": "In the 1930s, duststorms in the central U.S. were responsible for crippling damage to countless farms."
                            },
                            {
                                "example_id": "13eafc83-6f2e-4434-8421-c7058f954043",
                                "sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                                "text": "I saw a dust-storm at Kueichow which lasted for seven hours, burying some hovels and much agricultural country, and even producing a metamorphosis of the rocky bed of the Yangtze. Such storms have been observed as far east as Shanghai, but their occurrence at Kueichow shows that their area is not limited to the Great Plain or even to the region east of the mountain barrier between HUPEH and SZE CHUAN."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b2d9cfe-2ba8-49a9-a3e1-9b58f521c1a2",
                        "source_entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "source_sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                        "source_sense_description": "A storm of dust",
                        "target_lang_word": "stofstorm",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b70db58c-ea45-4a99-ba0d-beaa9fbf4049",
                        "source_entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "source_sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                        "source_sense_description": "A storm of dust",
                        "target_lang_word": "tempête de sable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tempête de sable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                        "entry_id": "21b4abd1-9a7a-39f7-97a3-733ad504dc8d",
                                        "glosses": [
                                            "Phénomène météorologique produit par des vents violents provoquant la déflation et le transport des particules de sable dans l’atmosphère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2910b6-f552-4175-bf16-11ce47726ab3",
                                                "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                                "text": "Trois cent cinquante vols annulés, des millions d’habitants en train de suffoquer et une Cité interdite comme effacée : Pékin essuie lundi 15 mars sa plus grosse tempête de sable depuis dix ans, réduisant la visibilité à quelques centaines de mètres et aggravant encore la pollution d’origine humaine."
                                            },
                                            {
                                                "example_id": "60d44b2d-d6bc-4286-9fac-bb4381fe491e",
                                                "sense_id": "f5e665c5-de71-30c9-82d3-4b6c17cf28ab",
                                                "text": "Des tempêtes de sable ont provoqué des hospitalisations, des fermetures d'école et des perturbations du trafic aérien dans plusieurs pays du Moyen-Orient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2961755-a982-4ac0-ae09-c9df13471926",
                        "source_entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "source_sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                        "source_sense_description": "A storm of dust",
                        "target_lang_word": "Sandsturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandsturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                        "entry_id": "3963f94e-ad62-31d7-b42d-62e57c0a5846",
                                        "glosses": [
                                            "Sturm oder starker Wind, der Sand mit sich führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12e5ee92-3993-4864-ab93-3aa1ecbf022e",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "Einige Sandstürme transportieren bis zu 100 Millionen Tonnen Sand über zum Teil sehr große Entfernungen!"
                                            },
                                            {
                                                "example_id": "29041fee-59ff-4df8-a947-d66372297e87",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Ihr neues Haus war ein Zelt, das einem starken Sandsturm schwerlich trotzen konnte.“"
                                            },
                                            {
                                                "example_id": "58282dc7-3463-4757-a327-ed512d9997a2",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Am Ende des Tages war der Regen verebbt, doch der heftige Wind war nun in einen Sandsturm übergegangen – Hunderte von Leuten, die in Motorradbrillen Schlange standen, um Essen zu fassen, waren ein sonderbarer, aber amüsanter Anblick.“"
                                            },
                                            {
                                                "example_id": "535bf21a-3c5d-419f-8a7e-6517f459767f",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Ferris’ Rückflug von Abu Dhabi verzögerte sich wegen eines Sandsturms, und so war es schon nach Mitternacht, als er endlich auf dem Queen-Alia-Flughafen landete.“"
                                            },
                                            {
                                                "example_id": "5f1916f5-de68-45fb-8740-f8f32ef90bb2",
                                                "sense_id": "921afc2f-eda8-388d-bd6c-88afd417a602",
                                                "text": "„Sandstürme kommen im Frühling im Norden Chinas häufig vor, oft kommt der Sand aus der Wüste Gobi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a78c9509-8fd0-4649-8fd0-06d96d462131",
                        "source_entry_id": "ab7b44c2-0920-3454-b154-97f1f3e02d4c",
                        "source_sense_id": "2bac7f4e-339b-36f2-8092-8c5d8a396c4d",
                        "source_sense_description": "A storm of dust",
                        "target_lang_word": "Staubsturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Staubsturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                        "entry_id": "6c0f7882-6f99-3d02-9b4c-f1379cfc2d55",
                                        "glosses": [
                                            "Sturm oder starker Wind, der Staub mit sich führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1433e583-a219-460d-88fd-95ea38511d6d",
                                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                                "text": "„Die Erosion wurde aufgehalten, Staubstürme sind selten geworden, aber ganz Island färbt sich jetzt violett.“"
                                            },
                                            {
                                                "example_id": "113f6a41-eeed-452a-a126-2e075f02897c",
                                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                                "text": "„Trotz der Staubstürme, die nach allen Richtungen die Augen blendeten, ging der Streitmachtführer an der Spitze seines Heeres zum Angriff über.“"
                                            },
                                            {
                                                "example_id": "26dc368e-f9b8-4b97-a29e-f87801a44c2a",
                                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                                "text": "„Kinder überstehen noch viel Schlimmeres, sagte Augie sich mit einem unbehaglichen Gefühl. Er dachte an die Staubstürme im Mittleren Westen zur Zeit der Weltwirtschaftskrise.“"
                                            },
                                            {
                                                "example_id": "4642cceb-2821-40cf-9e41-b1eb354b1f4c",
                                                "sense_id": "81cbb7a9-985f-32c7-8ced-15fce5f69291",
                                                "text": "„Staubstürme, die Partikel aus der Sahara nach Europa tragen, kommen seit Jahren regelmäßig vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
