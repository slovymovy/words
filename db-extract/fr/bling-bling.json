                                    {
                                        "sense_id": "3c24e819-c9a1-36b6-9f35-f0ad081d394a",
                                        "entry_id": "63ae0b31-dc13-37bc-b657-9c882ffa185b",
                                        "glosses": [
                                            "Shiny jewelry that displays wealth, such as a diamond ring or a stylish gold necklace or bracelet."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d81970d-a2de-46bb-a57d-af3adf30fe6a",
                                                "sense_id": "3c24e819-c9a1-36b6-9f35-f0ad081d394a",
                                                "text": "Gay men often seek out diamonds, and some purchases are “bling bling,” according to Jillian Rebol, the manager of Ultra Diamonds (soon to be Kay Jeweler’s) in Chicago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
