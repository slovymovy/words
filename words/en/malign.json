{
    "word_family": [
        "malignant",
        "malignity",
        "malignly",
        "maligner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d3e65d9-6a42-3dad-bbb7-d213ea653c6f",
                    "sense_definition": "To make false, harmful, or defamatory statements about someone or something; to slander.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defame",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unfair to <w>malign</w> his character when he is not here to defend himself.",
                            "target_lang_translations": {
                                "ru": "Несправедливо <w>очернять</w> его репутацию, когда он не может себя защитить."
                            }
                        },
                        {
                            "text": "The media often <w>maligned</w> the politician, spreading rumors that were completely untrue.",
                            "target_lang_translations": {
                                "ru": "СМИ часто <w>клеветали</w> на политика, распространяя слухи, которые были абсолютной ложью."
                            }
                        }
                    ],
                    "synonyms": [
                        "slander",
                        "defame",
                        "vilify",
                        "traduce"
                    ],
                    "common_phrases": [
                        "malign someone's character",
                        "unfairly maligned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать ложные, вредные или клеветнические заявления о ком-либо или чём-либо; клеветать, очернять."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очернять",
                                "target_lang_sense_clarification": "порочить репутацию"
                            },
                            {
                                "target_lang_word": "клеветать",
                                "target_lang_sense_clarification": "распространять ложные сведения"
                            },
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "наносить вред доброму имени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61aae814-b986-36fd-9282-e5cfac0214ef",
                    "sense_definition": "To treat with malice, show hatred toward, or abuse.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They would <w>malign</w> and abuse anyone who dared to disagree with their strict rules.",
                            "target_lang_translations": {
                                "ru": "Они были готовы <w>травить</w> и оскорблять любого, кто осмеливался не согласиться с их строгими правилами."
                            }
                        },
                        {
                            "text": "Throughout history, minority groups have been <w>maligned</w> and mistreated by those in power.",
                            "target_lang_translations": {
                                "ru": "На протяжении всей истории меньшинства подвергались <w>гонениям</w> и жестокому обращению со стороны тех, кто находился у власти."
                            }
                        }
                    ],
                    "synonyms": [
                        "abuse",
                        "mistreat",
                        "wrong"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться со злобой, проявлять ненависть или подвергать нападкам и жестокому обращению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "подвергать нападкам и преследованию"
                            },
                            {
                                "target_lang_word": "притеснять",
                                "target_lang_sense_clarification": "несправедливо угнетать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "df6f2661-5085-3915-8c3e-725ca6f5e856",
                    "sense_definition": "Evil, harmful, or malevolent in nature, intent, or influence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harmful_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house seemed to possess a <w>malign</w> influence that made everyone feel uneasy.",
                            "target_lang_translations": {
                                "ru": "Казалось, старый дом обладал каким-то <w>пагубным</w> влиянием, из-за которого все чувствовали себя неловко."
                            }
                        },
                        {
                            "text": "She believed that some <w>malign</w> force was actively working to ruin her plans.",
                            "target_lang_translations": {
                                "ru": "Она верила, что какая-то <w>злая</w> сила активно пытается разрушить её планы."
                            }
                        }
                    ],
                    "synonyms": [
                        "malevolent",
                        "evil",
                        "harmful",
                        "malicious"
                    ],
                    "antonyms": [
                        "benign"
                    ],
                    "common_phrases": [
                        "malign influence",
                        "malign presence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злой, вредоносный или пагубный по своей природе, намерению или влиянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пагубный",
                                "target_lang_sense_clarification": "оказывающий вредное влияние"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "несущий зло, пугающий"
                            },
                            {
                                "target_lang_word": "вредный",
                                "target_lang_sense_clarification": "причиняющий вред"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6536745-b2d1-321f-9f52-6aeee059de36",
                    "sense_definition": "Malignant, cancerous, or highly infectious (of a disease or tumor).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical_malignancy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biopsy revealed a <w>malign</w> growth that required immediate surgical removal.",
                            "target_lang_translations": {
                                "ru": "Биопсия выявила <w>злокачественное</w> новообразование, требовавшее немедленного хирургического удаления."
                            }
                        },
                        {
                            "text": "Doctors were concerned about the <w>malign</w> ulcers spreading to other tissues.",
                            "target_lang_translations": {
                                "ru": "Врачи были обеспокоены тем, что <w>злокачественные</w> язвы распространяются на другие ткани."
                            }
                        }
                    ],
                    "synonyms": [
                        "malignant",
                        "cancerous"
                    ],
                    "antonyms": [
                        "benign"
                    ],
                    "common_phrases": [
                        "malign growth",
                        "malign tumor"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In medical contexts, 'malignant' is now much more commonly used than 'malign'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злокачественный или инфекционный (о болезни или опухоли)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злокачественный",
                                "target_lang_sense_clarification": "о новообразованиях и болезнях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}