                ],
                "senses": [
                    {
                        "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                        "entry_id": "f7d7ca56-47e4-3ee8-9701-bb6b252a8c44",
                        "glosses": [
                            "Handlung, die darin besteht, anderen einen Vorschlag zu machen, etwas Bestimmtes zu tun oder zu unterlassen, wenn es um Lüftung geht, ohne selbst für das Misslingen oder gar Schäden dadurch zu haften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a83acee-02f9-4489-9002-49e5786664c9",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "Eine Lüftungsempfehlung kann richtig oder auch total falsch sein; klingt meistens wie „ein bisschen schwanger“!"
                            },
                            {
                                "example_id": "0b0acb98-c819-4fac-b0fa-cf66cf1ce668",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Schließlich sind in allen Unterrichtsstunden auch vor Einführung der Lüftungsempfehlung kleinere Lüftungsunterbrechungen vorgenommen worden, und sei es nur durch – wenig wirksame - Kipplüftung.“"
                            },
                            {
                                "example_id": "7440fc60-366a-46f6-a6be-b2c59e4743fa",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Durch einen Vergleich mit der Innenluftfeuchte kann eine Lüftungsempfehlung (aus Sicht der Luftfeuchtigkeit) gegeben werden.“"
                            },
                            {
                                "example_id": "dee2ed06-5b4c-4520-b1b8-9a345e24d91c",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Diese Lüftungsvorgänge konnten mit den Lüftungsempfehlungen der Lüftungsampel verglichen werden.“"
                            },
                            {
                                "example_id": "91e43674-ca5c-40ac-8482-e42639672a99",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Nach der bisherigen Lüftungsempfehlung sollte eine Stoßbelüftung durch kurzzeitige weite Öffnung von zwei Fenstern oder Fenster und Außentür erfolgen.“"
                            },
                            {
                                "example_id": "56f9e85a-9b73-447f-94c8-e785ffee45a6",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Die Lüftungsempfehlung sei der Beweis dafür, dass es immer noch eine Schadstoffbelastung gebe.“"
                            },
                            {
                                "example_id": "d0b767ad-0aa5-40cf-b80b-b014e2a58af1",
                                "sense_id": "0c4a6441-c655-3366-ab93-0f0af8ccbb1c",
                                "text": "„Die Lüftungsempfehlungen richten sich nach der täglich produzierten Feuchtelast im Zusammenhang mit dem jeweiligen Gebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
