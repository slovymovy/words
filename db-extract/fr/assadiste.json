                    {
                        "sense_id": "a53ac965-898d-3369-aa8d-b355e7c29517",
                        "entry_id": "10ea23d7-9509-3603-9dce-a8349e36a71a",
                        "glosses": [
                            "Relatif à la famille Assad, au régime de Hafez-el-Assad et Bachar el-Assad ou à l’assadisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf6eb16-87d2-48f0-82c4-445823c1d714",
                                "sense_id": "a53ac965-898d-3369-aa8d-b355e7c29517",
                                "text": "L’État assadiste est fondé sur l’extermination et non sur une simple « répression », et en tant que tel il constitue davantage un problème universel qu’un problème exclusivement syrien."
                            },
                            {
                                "example_id": "daf108b9-511d-4a49-8d9f-6e2bdf5d062a",
                                "sense_id": "a53ac965-898d-3369-aa8d-b355e7c29517",
                                "text": "Très vite, la propagande assadiste s’est saisie du prétexte pour disqualifier ces images et imposer les siennes: à la guerre des armes s’est superposée une guerre des récits."
                            }
                        ]
                    }
                ],
