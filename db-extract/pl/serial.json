                                                "example_id": "e50868ce-539f-41b6-9538-2496dc6aebf1",
                                                "sense_id": "d6a0ba88-337a-36df-a9ea-f501030ac882",
                                                "text": "Beliebte Serien im Fernsehen waren bzw. sind „Dallas“, „Lindenstraße“, „Raumschiff Enterprise“ und „Gute Zeiten, Schlechte Zeiten“."
                                            },
