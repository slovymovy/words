                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac85f679-add4-4f53-83af-5df9d352bd73",
                                                "sense_id": "4a36edc1-0f0d-39aa-af61-85bc6da9e185",
                                                "text": "„Das Leckerli ist in den beiden Appenzeller Halbkantonen sowie im Toggenburg ganzjährig verbreitet. In Ausserrhoden ist das Leckerli besonders in der Fasnachtszeit beliebt, in Innerrhoden gilt es hingegen als typisches Landsgemeindegebäck.“"
                                            }
