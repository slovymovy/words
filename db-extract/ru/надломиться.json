                        "target_lang_word": "se casser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se casser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "631291db-6cb7-3532-8471-6c90218666f6",
                                        "entry_id": "12e57e31-659b-3bb8-9f9f-acc10035266b",
                                        "glosses": [
                                            "Partir, s’en aller."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57e15d95-dc13-4898-b95f-c3168d37bba3",
                                                "sense_id": "631291db-6cb7-3532-8471-6c90218666f6",
                                                "text": "Casse-toi, pauv’ con !"
                                            },
                                            {
                                                "example_id": "ad76ea9e-aa06-4cff-a2a4-47fed2c69512",
                                                "sense_id": "631291db-6cb7-3532-8471-6c90218666f6",
                                                "text": "– À cette heure-ci, c’est fermé. Je sais où la clef est planquée. On passe en scred, on prend une bouteille, on se casse."
                                            },
                                            {
                                                "example_id": "ec9db244-76ce-4860-aa79-11b832a4b3ed",
                                                "sense_id": "631291db-6cb7-3532-8471-6c90218666f6",
                                                "text": "On se casse, les gars ! Les flics se pointent !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37723d50-9426-38cd-8de9-3c10d2226dc7",
                                        "entry_id": "12e57e31-659b-3bb8-9f9f-acc10035266b",
                                        "glosses": [
                                            "Forme pronominale de casser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af888816-c385-4f44-b094-4b4b072af259",
                                                "sense_id": "37723d50-9426-38cd-8de9-3c10d2226dc7",
                                                "text": "Le verre se casse facilement."
                                            },
                                            {
                                                "example_id": "155022c0-bf01-4211-a9d4-6caccc482fbe",
                                                "sense_id": "37723d50-9426-38cd-8de9-3c10d2226dc7",
                                                "text": "Le vieillard semblait plier sous le poids de la chape de brocart, dont les plis somptueux se cassaient derrière lui."
                                            },
                                            {
                                                "example_id": "e65914fe-7b19-4426-80d3-2eb8771656e1",
                                                "sense_id": "37723d50-9426-38cd-8de9-3c10d2226dc7",
                                                "text": "La vieille criait si fort que la voix se cassait dans sa gorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
