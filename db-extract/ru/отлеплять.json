                                "target_senses": [
                                    {
                                        "sense_id": "dd38c300-0a64-3302-882f-2a450857ba5c",
                                        "entry_id": "8182ec9f-4e0c-37d7-85da-1d598a3fd8ec",
                                        "glosses": [
                                            "To free from the condition of being stuck."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f073e265-9489-40c4-a8af-29c587f7e22c",
                                                "sense_id": "dd38c300-0a64-3302-882f-2a450857ba5c",
                                                "text": "Add the rice and sauté until the first few grains begin to brown (about 3 minutes). Add peas, stock, and salt. Mix well and be sure to scrape the bottom of the pan to unstick any rice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cbec45-d7c3-331c-a1b9-fac2ca07a415",
                                        "entry_id": "8182ec9f-4e0c-37d7-85da-1d598a3fd8ec",
                                        "glosses": [
                                            "To become freed from a stuck condition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d4b64d-c4c7-4fa6-940c-14f417d4ca6b",
                                                "sense_id": "79cbec45-d7c3-331c-a1b9-fac2ca07a415",
                                                "text": "Starting to panic, I stepped back and put my foot right through the door. Outside, Nelson laughed. The door unstuck. I hopped on one leg as it swung outward, carrying my boot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc516432-a628-3d41-8a06-43606a1ad6d3",
                                        "entry_id": "8182ec9f-4e0c-37d7-85da-1d598a3fd8ec",
                                        "glosses": [
                                            "To leave the ground during takeoff."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
