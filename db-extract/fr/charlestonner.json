                "senses": [
                    {
                        "sense_id": "61b881a8-a382-3545-a00b-7242ddf24a7b",
                        "entry_id": "7acb9eca-d724-3c68-bfd9-056b0f7884f6",
                        "glosses": [
                            "Danser le charleston."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1102b997-3b86-4746-91a3-b41e49746f8e",
                                "sense_id": "61b881a8-a382-3545-a00b-7242ddf24a7b",
                                "text": "Elle en aura fait, non pas de ces petites poupées gentilles qui savent charlestonner, pianoter, se servir avec art de la poudre de riz et du rouge, mais sont incapables de faire un pot-au-feu réussi."
                            },
                            {
                                "example_id": "2eb2f759-3c3d-4b78-aa62-e4282e64c2b7",
                                "sense_id": "61b881a8-a382-3545-a00b-7242ddf24a7b",
                                "text": "Une connaissance qui a été assez ahurie de vous voir foxtrotter et charlestonner en pleine période d'entraînement !"
                            }
                        ]
                    },
                    {
                        "sense_id": "9a6e28c6-cf5e-393a-b7bb-25ee70b6c8ba",
                        "entry_id": "7acb9eca-d724-3c68-bfd9-056b0f7884f6",
                        "glosses": [
                            "S’agiter vivement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "81feee16-7afb-4826-8075-6f08a4f18237",
                                "sense_id": "9a6e28c6-cf5e-393a-b7bb-25ee70b6c8ba",
                                "text": "Les propos du gros garçon se mirent à charlestonner dans son cerveau où la lucidité s'insinuait souverainement."
                            }
                        ]
                    }
                ],
