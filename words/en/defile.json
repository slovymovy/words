{
    "word_family": [
        "defilement",
        "defiler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95e81d0c-3dd3-3bfe-9a32-c07ff8ef864e",
                    "sense_definition": "To violate, desecrate, or treat something sacred or special with disrespect.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "desecrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vandals attempted to <w>defile</w> the ancient temple by spray-painting vulgar slogans across its walls.",
                            "target_lang_translations": {
                                "ru": "Вандалы попытались <w>осквернить</w> древний храм, разрисовав его стены вульгарными лозунгами из баллончика."
                            }
                        },
                        {
                            "text": "Many citizens felt that burning the flag would deeply <w>defile</w> their national heritage.",
                            "target_lang_translations": {
                                "ru": "Многие граждане сочли, что сожжение флага глубоко <w>поругает</w> их национальное наследие."
                            }
                        }
                    ],
                    "synonyms": [
                        "desecrate",
                        "profane",
                        "violate"
                    ],
                    "antonyms": [
                        "sanctify",
                        "hallow"
                    ],
                    "common_phrases": [
                        "defile a sanctuary",
                        "defile sacred ground"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осквернять, попирать или относиться с неуважением к чему-либо священному или дорогому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осквернять",
                                "target_lang_sense_clarification": "святыню, памятник, память"
                            },
                            {
                                "target_lang_word": "поругать",
                                "target_lang_sense_clarification": "относиться кощунственно, святотатствовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82957b49-668f-3e85-817a-1b0cd5789710",
                    "sense_definition": "To make something physically dirty, foul, or polluted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pollute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toxic waste continues to <w>defile</w> the pristine mountain stream, threatening the local wildlife.",
                            "target_lang_translations": {
                                "ru": "Токсичные отходы продолжают <w>загрязнять</w> первозданный горный ручей, угрожая местной дикой природе."
                            }
                        },
                        {
                            "text": "Heavy industrial runoff threatened to <w>defile</w> the surrounding fertile soil.",
                            "target_lang_translations": {
                                "ru": "Обильные промышленные стоки грозили <w>загрязнить</w> окружающую плодородную почву."
                            }
                        }
                    ],
                    "synonyms": [
                        "pollute",
                        "contaminate",
                        "soil",
                        "befoul",
                        "sully"
                    ],
                    "antonyms": [
                        "purify",
                        "clean"
                    ],
                    "common_phrases": [
                        "defile the water",
                        "defile the landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загрязнять, делать физически нечистым, грязным или отравленным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнять",
                                "target_lang_sense_clarification": "природу, воду, среду"
                            },
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "делать грязным"
                            },
                            {
                                "target_lang_word": "марать",
                                "target_lang_sense_clarification": "физически загрязнять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76c3a868-68e2-3870-b5eb-8a01b4a892a7",
                    "sense_definition": "To corrupt or tarnish someone's moral purity, character, or reputation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corrupt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to accept bribes, stating that dishonest money would only <w>defile</w> his honor.",
                            "target_lang_translations": {
                                "ru": "Он отказался брать взятки, заявив, что нечестные деньги лишь <w>запятнают</w> его честь."
                            }
                        },
                        {
                            "text": "The scandalous rumors were deliberately spread to <w>defile</w> her untarnished reputation.",
                            "target_lang_translations": {
                                "ru": "Скандальные слухи распускались намеренно, чтобы <w>опорочить</w> её безупречную репутацию."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "tarnish",
                        "taint",
                        "besmirch"
                    ],
                    "common_phrases": [
                        "defile one's reputation",
                        "defile one's conscience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порочить, пятнать моральную чистоту, честь или репутацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "честь, доброе имя"
                            },
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "репутацию, совесть"
                            },
                            {
                                "target_lang_word": "осквернять",
                                "target_lang_sense_clarification": "мораль, духовную чистоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aa7b558-db68-332d-9c94-7e844c5a2687",
                    "sense_definition": "To march in a single line or file.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "march",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhausted infantry began to <w>defile</w> past the checkpoint one by one.",
                            "target_lang_translations": {
                                "ru": "Изнурённая пехота начала по одному <w>дефилировать</w> мимо контрольно-пропускного пункта."
                            }
                        },
                        {
                            "text": "Spectators watched the soldiers <w>defile</w> through the narrow town square.",
                            "target_lang_translations": {
                                "ru": "Зрители наблюдали, как солдаты <w>дефилировали</w> через узкую городскую площадь."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "military usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или маршировать узким строем, цепочкой или колонной по одному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефилировать",
                                "target_lang_sense_clarification": "шествовать, проходить строем"
                            },
                            {
                                "target_lang_word": "идти гуськом",
                                "target_lang_sense_clarification": "двигаться друг за другом в узком месте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e90a876e-95e1-3b62-b748-170063e8f0b1",
                    "sense_definition": "A narrow passage or gorge, especially one between mountains where passage must occur in narrow file.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passageway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army was ambushed as it marched through a rocky mountain <w>defile</w>.",
                            "target_lang_translations": {
                                "ru": "Армия попала в засаду, когда проходила через скалистую горную <w>теснину</w>."
                            }
                        },
                        {
                            "text": "A narrow <w>defile</w> between the cliffs formed the only entrance to the hidden valley.",
                            "target_lang_translations": {
                                "ru": "Узкое <w>дефиле</w> между скалами служило единственным входом в скрытую долину."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain defile",
                        "narrow defile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий проход, ущелье или дефиле, особенно между горами, преодолимое только узкой колонной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефиле",
                                "target_lang_sense_clarification": "узкий проход в военном деле или географии"
                            },
                            {
                                "target_lang_word": "теснина",
                                "target_lang_sense_clarification": "узкое ущелье, горный проход"
                            },
                            {
                                "target_lang_word": "узкий проход",
                                "target_lang_sense_clarification": "горная щель, узкий путь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}