                "senses": [
                    {
                        "sense_id": "e2157d31-add6-383c-bff1-f399ed2b9a8c",
                        "entry_id": "e5521b7a-f0fe-364f-a24d-f1f92245dcb7",
                        "glosses": [
                            "Faire gérer l’historique des différentes versions des fichiers d’un logiciel ou d’une base de données avec le logiciel Subversion, dont le nom est souvent abrégé en SVN."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a109d9-2973-4804-8591-78b1c6572524",
                                "sense_id": "e2157d31-add6-383c-bff1-f399ed2b9a8c",
                                "text": "C’est donc plus simple de migrer, de backuper, de SVNiser etc… ^([sic : etc.])"
                            },
                            {
                                "example_id": "7bd1a75d-f97c-4e62-a669-431f06b6dbaa",
                                "sense_id": "e2157d31-add6-383c-bff1-f399ed2b9a8c",
                                "text": "Je viens de me poser une 2.1 SVN sur mon serveur local et mon premier réflexe fut donc de SVNiser les plugins du _core_"
                            },
                            {
                                "example_id": "185da430-4405-434b-a399-ab1dbf3945f2",
                                "sense_id": "e2157d31-add6-383c-bff1-f399ed2b9a8c",
                                "text": "Pour ceux qui utilisent Eclipse/Subclipse pour SVNiser leur code Windows/Linux, tout retour d’expérience sur ces problèmes d’encodage seraiut ^([sic : serait]) le bienvenu."
                            }
                        ]
                    }
