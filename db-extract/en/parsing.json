                        "sense_id": "8bc8f57a-77c6-3436-8663-a4972562c003",
                        "entry_id": "96863519-b106-3b0b-9346-8384b7986269",
                        "glosses": [
                            "The act or process in which an agent (person or computer) parses something (a text, a program)."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad521da-9ea9-42de-a08c-9eb7339d7921",
                                "sense_id": "8bc8f57a-77c6-3436-8663-a4972562c003",
                                "text": "Parsing an Old English text can be difficult."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e4efc7f-fea9-3d17-8ff2-ea57d7a17af7",
                        "entry_id": "96863519-b106-3b0b-9346-8384b7986269",
                        "glosses": [
                            "An instance of that act or process; a parse."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "3299a939-eeb6-435d-9acd-001d724aedfd",
                                "sense_id": "0e4efc7f-fea9-3d17-8ff2-ea57d7a17af7",
                                "text": "A parsing of a sentence about a horse can yield several possible results."
                            }
                        ]
                    },
                    {
                        "sense_id": "721a170d-8edd-3bd5-b781-f2b6f222b41d",
                        "entry_id": "96863519-b106-3b0b-9346-8384b7986269",
                        "glosses": [
                            "Any result of such an instance; a parse; an acceptation."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e24a213-cfee-44dc-b159-bf9f6b510658",
                                "sense_id": "721a170d-8edd-3bd5-b781-f2b6f222b41d",
                                "text": "Upon review, for the word horse, the parsing \"animal\" was rejected in favor of the parsing \"piece of gymnastic equipment\"."
                            }
                        ]
                    }
