        "de-extract.jsonl": [
            {
                "entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                "word": "nebenbei",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                        "entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                        "glosses": [
                            "während einer anderen (Haupt-)Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd4befb8-b8af-42d0-9152-6b8906bb42ba",
                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                "text": "Der alte Schotte ließ das Geheimnis des Erfolgs ganz nebenbei fallen."
                            },
                            {
                                "example_id": "1634659c-de11-4bbc-b1de-27734afa225a",
                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                "text": "Nur als so nebenbei bemerkt: die ulkige Zeichnung kostet ein paar tausend Euro."
                            },
                            {
                                "example_id": "816a3c29-f27b-4227-87f2-a76c24686934",
                                "sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                                "text": "„Sebastian Kehl steht kurz vor dem Abschluss eines Studiengangs bei der UEFA und macht nebenbei den ersten Trainerschein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c01d0c-d351-4771-8cb8-a0ff7ba08ff4",
                        "source_entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                        "source_sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                        "source_sense_description": "während einer anderen (Haupt-)Handlung",
                        "target_lang_word": "incidentally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incidentally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "In an incidental manner; not of central or critical importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b18655a-4885-4610-8372-d8101270ff84",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "The book discussed the subject, but only incidentally."
                                            },
                                            {
                                                "example_id": "85f78577-5969-4326-9f67-0d33d541dffe",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "Nor, will the tragic dramatist who would depict mortal indomitableness in its fullest sweep and direct swing, ever forget a hint, incidentally so important in his art, as the one now alluded to."
                                            },
                                            {
                                                "example_id": "d20e5e45-a0c3-4f4b-9cc5-576c62104c92",
                                                "sense_id": "f8953b75-661a-339e-887d-f304be9c3e0a",
                                                "text": "Not everybody welcomes standardisation as a principle, because it reduces variety (and, incidentally, tends to dispose of the quainter and more picturesque anomalies)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3dae669-506e-3e72-a2cf-e4166a91a1a3",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "By chance; in an unplanned way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba32c772-4122-369f-929a-1ccd8f20e5eb",
                                        "entry_id": "de101744-4505-3cbf-b51d-a67cd4015425",
                                        "glosses": [
                                            "Parenthetically, by the way."
                                        ],
                                        "tags": [
                                            "conjunctive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc46fd99-35b8-4620-9315-1b0232d9680b",
                                                "sense_id": "ba32c772-4122-369f-929a-1ccd8f20e5eb",
                                                "text": "Incidentally, did you hear anything new from your brother yesterday?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20534f3a-29c6-4ba6-8db5-3b7b766d9018",
                        "source_entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                        "source_sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                        "source_sense_description": "während einer anderen (Haupt-)Handlung",
                        "target_lang_word": "in passing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in passing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                        "entry_id": "12ac6dc3-5e1f-37e6-a5c3-ea167f68d968",
                                        "glosses": [
                                            "Incidentally; as a brief diversion from another topic etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eb190d8-1e23-47b5-8c0f-5ccd97ee5805",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "We mostly talked about his mother's illness, but he told me in passing that he'd won a small prize in the lottery."
                                            },
                                            {
                                                "example_id": "340337aa-8de3-496a-845b-9ca06cba05ad",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "Did she mention my name just in passing?"
                                            },
                                            {
                                                "example_id": "281b2da4-0e80-4edc-bab7-1c73bf96290d",
                                                "sense_id": "5d93456c-30a2-3096-98a3-0b563d93a5af",
                                                "text": "And that number, 400 million[subscribers], does not account for the people who watch MrBeast’s videos in passing, or who are aware of his cultural presence because of their children, or who just sort of know who he is but don’t have any intricate awareness as to why he is famous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a0642d7-0351-4a63-8f64-a810028b6811",
                        "source_entry_id": "712ee4b5-c827-37c0-b0ca-aa6b7d6b4842",
                        "source_sense_id": "4385c11f-9316-3fe6-b4c3-6f5b4f149f88",
                        "source_sense_description": "während einer anderen (Haupt-)Handlung",
                        "target_lang_word": "en passant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en passant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "En faisant avec quelque sorte de précipitation et sans y avoir donné le temps nécessaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce26b0e5-0fa2-46f4-9f91-1d237f566b24",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je n’ai pas eu le loisir d’examiner l’endroit, je ne l’ai vu qu’en passant."
                                            },
                                            {
                                                "example_id": "5e61dcc1-c9c4-49fe-bdae-cba42d441375",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je ne lui ai parlé de votre affaire qu’en passant."
                                            },
                                            {
                                                "example_id": "fe87bf55-d1e2-464e-b9a6-1b8a731bfd5c",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "J’ai traité cet appel comme n’importe quel autre, sans enjeu d’aucune sorte, un petit signe en passant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "Se dit, en interrompant le fil d’une conversation, pour parler succinctement d’une chose qui se présente à l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e1e6b1-acc3-4f9d-b790-9dd0afaa3658",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Nous dirons en passant que les céréales sont beaucoup moins sujettes à la verse en Champagne que dans d'autres contrées."
                                            },
                                            {
                                                "example_id": "a5ed221b-b9d9-42e8-8ea1-80fa3aa1242b",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Un peu de ridicule et de bizarrerie se mêle infailliblement à cette époque transitoire de l’âge des garçons, et il me faut bien indiquer cette note en passant."
                                            },
                                            {
                                                "example_id": "9dd02069-9bcd-4fb9-823f-6a7d19d92682",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Je mentionne, en passant, les méfaits du micronationalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
