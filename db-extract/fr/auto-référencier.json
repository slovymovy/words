                        "glosses": [
                            "Se référencier soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a7f928d-a7f8-4d3a-b35b-ade9abfc6d74",
                                "sense_id": "9841052b-e721-3143-8fbe-6638f2381365",
                                "text": "L’univers de l’objet virtuel est « tout autre », il a le pouvoir de s’auto-référencier et de rendre ainsi inutile ou parodique le jeu des comparaisons avec une réalité extérieure."
                            },
                            {
                                "example_id": "e1264735-51b9-4ae2-93ed-c4f90ddff945",
                                "sense_id": "9841052b-e721-3143-8fbe-6638f2381365",
                                "text": "Mais au delà de toute considération spécifique, il faut avoir clairement à l’esprit que la capacité de s’auto-référencier à des systèmes de signification ne peut pas valoir seulement pour nos « scientistes »."
                            }
                        ]
                    }
