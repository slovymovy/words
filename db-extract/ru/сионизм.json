                "senses": [
                    {
                        "sense_id": "1c03e2a6-e0ce-30f3-91ec-b7cf9339867c",
                        "entry_id": "5b58f1f2-3d58-3177-8994-c7414ec58fb5",
                        "glosses": [
                            "еврейское национальное движение, установившее своей целью объединение еврейского народа на его исторической родине"
                        ],
                        "tags": [],
