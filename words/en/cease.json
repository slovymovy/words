                                "ru": "Солдатам приказали немедленно <w>прекратить</w> огонь.",
                                "nl": "De soldaten kregen het bevel om onmiddellijk het vuren te <w>staken</w>.",
                                "pl": "Żołnierzom rozkazano natychmiast <w>zaprzestać</w> ognia.",
                                "de": "Den Soldaten wurde befohlen, das Feuer sofort <w>einzustellen</w>.",
                                "fr": "Il a été ordonné aux soldats de <w>cesser</w> le feu immédiatement.",
                                "it": "Ai soldati è stato ordinato di <w>cessare</w> il fuoco immediatamente.",
                                "cs": "Vojákům bylo nařízeno okamžitě <w>zastavit</w> palbu.",
                                "tr": "Askerlere derhal ateşi <w>kesmeleri</w> emredildi.",
                                "es": "Se ordenó a los soldados <w>cesar</w> el fuego inmediatamente.",
                                "zh": "士兵们接到命令，立即<w>停止</w>射击。"
                            }
                        }
