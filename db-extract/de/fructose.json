                ],
                "senses": [
                    {
                        "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                        "entry_id": "36e60c58-929c-3021-9287-57c6b66db0f8",
                        "glosses": [
                            "Zucker mit der Summenformel C₆H₁₂O₆"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a56b520-2680-4202-9330-461440448a5f",
                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                "text": "Fructose hat eine höhere Süßkraft als alle anderen Zucker."
                            },
                            {
                                "example_id": "b2fbedf4-df08-4b68-8acb-6fa5581c4c51",
                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                "text": "In den meisten Früchten ist Fructose."
                            },
                            {
                                "example_id": "62aa1535-c65d-4243-a8a6-a75e64439383",
                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                "text": "Fructose ist gut wasserlöslich."
                            },
                            {
                                "example_id": "5a6f8c28-d921-42dc-80d7-e5539ef023ee",
                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                "text": "„Die Molekülformel von Fructose stimmt mit der von Glucose überein.“"
                            },
                            {
                                "example_id": "cda84eeb-22b3-4dd3-a77f-62688b1d1a99",
                                "sense_id": "03086df9-afec-335c-aee6-2cb19f030e7f",
                                "text": "„Die auch als Fruchtzucker bezeichnete Fructose ist ein weiteres, in süßen Früchten und im Honig vorkommendes Monosaccharid.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10df2157-f31e-4def-85e4-1b7930020157",
