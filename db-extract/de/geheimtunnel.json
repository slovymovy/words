                        "examples": [
                            {
                                "example_id": "df400686-f2bc-4aab-b74a-03ef3248ad65",
                                "sense_id": "25d0b80f-9a20-3e2b-b96f-5bfcb297c467",
                                "text": "„Als Polly jünger war, haben sie sich beide oft in diesen Geheimtunneln vor der Nanny versteckt, aber inzwischen ist seine Schwester zu groß geworden, um noch hineinzupassen.“"
                            },
                            {
                                "example_id": "b333cf1b-31c0-4688-9be4-009c2166ef1e",
                                "sense_id": "25d0b80f-9a20-3e2b-b96f-5bfcb297c467",
                                "text": "„›Und nach sechs bis acht Stunden, wenn unser Hubschrauber landet, ziehen wir uns über den Geheimtunnel zum See unten zurück.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
