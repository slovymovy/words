                                    },
                                    {
                                        "sense_id": "110dfc29-9a20-329a-b36c-ff98e2068d83",
                                        "entry_id": "57dbda84-6950-3ccf-9c6c-540a0128a58a",
                                        "glosses": [
                                            "жарг. сожительница"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b53f04-50e1-4bf4-a40a-18c9a352e51f",
                                                "sense_id": "110dfc29-9a20-329a-b36c-ff98e2068d83",
                                                "text": "Примчалась она после тюрьмы к Лехе своему, а дверь открыла шмара в рыжем парике."
                                            }
                                        ]
                                    },
