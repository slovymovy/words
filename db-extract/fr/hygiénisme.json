                "senses": [
                    {
                        "sense_id": "aa2d43f7-8c60-3bd0-a9f4-914584575683",
                        "entry_id": "aa8ada4f-41a8-3da7-b910-465f53c448eb",
                        "glosses": [
                            "Courant de pensée développé au cours du XIXᵉ siècle et mettant en avant l’importance de l’hygiène pour la santé humaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619fcf46-7883-47f5-bb53-27a1f114939e",
                                "sense_id": "aa2d43f7-8c60-3bd0-a9f4-914584575683",
                                "text": "L’hygiénisme a milité en faveur de la salubrité des villes et des campagnes, de bonnes pratiques alimentaires et de l’exercice physique et du sport."
                            },
                            {
                                "example_id": "ad965a92-c0d1-4e8e-9774-b8692a4df1e5",
                                "sense_id": "aa2d43f7-8c60-3bd0-a9f4-914584575683",
                                "text": "En 1879, Jules Verne met en scène l’hygiénisme dans son roman Les Cinq Cents Millions de la Bégum."
                            },
                            {
                                "example_id": "216e94fe-8e17-4756-a763-2ea96b0e2cd3",
                                "sense_id": "aa2d43f7-8c60-3bd0-a9f4-914584575683",
                                "text": "Et il serait en effet simpliste d’imaginer un mouvement cohérent qui réunisse le soutien au libéralisme et le rejet de l’hygiénisme."
                            }
                        ]
                    }
                ],
