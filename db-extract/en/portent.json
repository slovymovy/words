                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab4cfb01-3f21-4bfe-9bda-4879e712523b",
                        "source_entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
                        "source_sense_description": "omen",
                        "target_lang_word": "Omen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Omen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                        "entry_id": "1948c2f4-7853-32d2-a042-ebdff16d3ddc",
                                        "glosses": [
                                            "ein Vorzeichen, Anzeichen, eine Vorahnung im Sinnbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269c3ab8-7c63-4d09-99c9-19733d8b0558",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "Das ist ein gutes Omen."
                                            },
                                            {
                                                "example_id": "dcf5cab8-f30d-4f79-a1b2-2ce2a7ddf840",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "Aufziehende dunkle Wolken sind ein Omen für Regen."
                                            },
                                            {
                                                "example_id": "e2e9cbaa-3c16-4e5f-a588-1b763ca1b0fa",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "„Als schlechtes Omen galt es auch, wenn man einen Geistlichen neben dem Friedhof traf.“"
                                            },
                                            {
                                                "example_id": "6aa6f1eb-7674-4bba-81f7-f071fdcbc26f",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "„Daß Nikolai am Tag der Kriegserklärung auf die Welt kam, hatten seine Eltern nie als ein böses Omen betrachtet.“"
                                            },
                                            {
                                                "example_id": "980f1cb2-45db-4660-9c05-d5b52652afbf",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "„Im religiösen Bereich waren Schafe die gängigsten Opfertiere, was sich auch daran zeigt, daß sich der wichtigste Bereich der mesopotamischen Vorzeichenwissenschaft mit der Interpretation von Omina beschäftigte, die aus den Eingeweiden von Opferschafen gelesen werden konnten.“"
                                            },
                                            {
                                                "example_id": "470084f0-8758-4f9e-b80a-4a83af160503",
                                                "sense_id": "b1ca1a66-2f55-3aca-b210-898e80849981",
                                                "text": "„Einige nahmen das als böses Omen und rieten davon ab, den Marsch fortzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1859755a-01a1-4faa-a268-a0843fcaa5a3",
                        "source_entry_id": "db8f1d0a-a159-309f-912a-27d73c2d24f5",
