                    ]
                },
                {
                    "sense_id": "4651bc21-3d36-3962-82b7-e8a5b2cdd656",
                    "sense_definition": "Bien différent par sa nature, son importance ou sa complexité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Préparer un repas simple est facile, mais cuisiner pour cent personnes est une tout <w>autre</w> affaire."
                        },
                        {
                            "text": "Ce projet semblait modeste au départ, mais il s'agit en réalité d'un bien <w>autre</w> défi."
                        }
                    ],
                    "common_phrases": [
                        "une tout autre affaire",
                        "une tout autre histoire"
