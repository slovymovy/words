                        "tags": [],
                        "examples": [
                            {
                                "example_id": "797df930-069b-4ee1-bc2c-64aa0edd509d",
                                "sense_id": "bb1cbb30-0c70-38cd-9d7a-b706dcb5d079",
                                "text": "„Das Seltenerdvorkommen im Fen Carbonatite Complex könnte zukünftig rund zehn Prozent des europäischen Bedarfs an Seltenen Erden decken.“"
                            },
                            {
                                "example_id": "7555205a-cac1-4944-9e8d-702f1302751f",
                                "sense_id": "bb1cbb30-0c70-38cd-9d7a-b706dcb5d079",
                                "text": "„Seltenerdvorkommen sind unausweichlich mit Radioaktivität und dem Umgang mit ihr verbunden.“"
                            },
                            {
                                "example_id": "7b661ab6-4465-417d-9993-d77145bd8953",
                                "sense_id": "bb1cbb30-0c70-38cd-9d7a-b706dcb5d079",
                                "text": "„China ist aber nicht das einzige Land mit Seltenerdvorkommen.“"
                            },
                            {
                                "example_id": "de32f6d8-3168-4565-9708-5921b3f7fa19",
                                "sense_id": "bb1cbb30-0c70-38cd-9d7a-b706dcb5d079",
                                "text": "„Deutschland verfügt nur über wenige Seltenerdvorkommen.“"
                            }
