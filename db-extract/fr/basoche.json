                "senses": [
                    {
                        "sense_id": "46b13e2a-2594-3657-9e03-48d713f898f2",
                        "entry_id": "de2ffef1-773e-33b4-ba36-b4f3598a0d61",
                        "glosses": [
                            "Communauté des clercs de procureurs au parlement, à Paris et dans les provinces de l’ancienne France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3e1fcf-9032-4d2c-85d3-a8b0d721568a",
                                "sense_id": "46b13e2a-2594-3657-9e03-48d713f898f2",
                                "text": "C’est à Paris que la civilisation a germé, […], que se sont fondées la hanse pour les marchands, imitée en Allemagne, et la basoche pour les clercs, imitée en Angleterre, […]."
                            },
                            {
                                "example_id": "e4174dec-a77f-4b29-9cc3-b48ef776ceda",
                                "sense_id": "46b13e2a-2594-3657-9e03-48d713f898f2",
                                "text": "C’était leur jour, leur fête des fous, leur saturnale, l’orgie annuelle de la basoche et de l’école."
                            }
                        ]
                    },
                    {
                        "sense_id": "26351e4e-baf9-36fe-aa5b-727b9fbe8b2c",
                        "entry_id": "de2ffef1-773e-33b4-ba36-b4f3598a0d61",
                        "glosses": [
                            "Les gens de justice et du palais."
                        ],
                        "tags": [
                            "collectively",
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "14ff4e8e-6fdf-4a1f-bf80-f8e0f61ee009",
                                "sense_id": "26351e4e-baf9-36fe-aa5b-727b9fbe8b2c",
                                "text": "Il appartient à la basoche."
                            },
                            {
                                "example_id": "8e357129-a968-4e36-a025-d898cd96e07c",
                                "sense_id": "26351e4e-baf9-36fe-aa5b-727b9fbe8b2c",
                                "text": "Deux jeunes gens, assis devant la table, étaient en train de manger paisiblement le déjeuner de pain et de fromage traditionnel en tous les pays de basoche."
                            },
                            {
                                "example_id": "4682669a-b8dd-43c2-9ee3-43503026a43e",
                                "sense_id": "26351e4e-baf9-36fe-aa5b-727b9fbe8b2c",
                                "text": "Les Maugouverts de paroisse, la veine pantagruélique, les abbayes majeures (enfants de la ville ou basoche), le langage « courtoisien » et l’expression poétique séant à leurs jeux amoureux."
                            }
                        ]
                    }
