                        "cross_references": [
                            {
                                "target_word": "Badewanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90c1aed5-f109-30c6-9a21-015d895f25ba",
                                        "entry_id": "2ee6f1f0-5fce-32fc-b165-c2122b7d7ce4",
                                        "glosses": [
                                            "Wanne im Badezimmer mit zumeist länglicher Form zum Baden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77e5e5b-be65-4551-9ea9-bb426fc0dae2",
                                                "sense_id": "90c1aed5-f109-30c6-9a21-015d895f25ba",
                                                "text": "„Diese Drohung erinnerte Charlotte Corday an ihre Mission, welche sie eine Zeitlang über dem Abscheu vor dem Morde vergessen hatte; sie näherte sich der Badewanne, zog ihr Messer und senkte es Marat in die Brust.“"
                                            },
                                            {
                                                "example_id": "5633301f-6ad5-4b2e-88a7-45a638823482",
                                                "sense_id": "90c1aed5-f109-30c6-9a21-015d895f25ba",
                                                "text": "„Das Boot durfte ich in die Badewanne mitnehmen.“"
                                            },
                                            {
                                                "example_id": "e8b8b0c6-c541-4850-817c-a0a822d6594c",
                                                "sense_id": "90c1aed5-f109-30c6-9a21-015d895f25ba",
                                                "text": "„Vals Badewanne war weitaus luxuriöser als die in Bobbys Haus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c3171ff-ea23-47a0-bb7e-83ce6ebcaf4f",
