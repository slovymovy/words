                "senses": [
                    {
                        "sense_id": "ec01a93a-27ba-34ae-b4aa-515edde13033",
                        "entry_id": "24dd7e72-47e8-311a-ba93-5a1cb1b31e62",
                        "glosses": [
                            "Bestreben/Ziel und Maßnahmen, Produkte zu garantieren, die den Anforderungen entsprechen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c319c44-ebeb-4318-a306-1daca08543a8",
                                "sense_id": "ec01a93a-27ba-34ae-b4aa-515edde13033",
                                "text": "„Unter traditioneller Qualitätssicherung wird im folgenden eine Qualitätssicherung verstanden, deren Schwerpunkt auf der Fehlerentdeckung und nicht auf der Fehlervermeidung liegt und die überwiegend manuell durchgeführt wird.“"
                            },
                            {
                                "example_id": "f508012b-526e-4b7e-abe7-47d6ff9b0b35",
                                "sense_id": "ec01a93a-27ba-34ae-b4aa-515edde13033",
                                "text": "„Qualitätssicherung in der Bakteriologie umfaßt die Gesamtheit aller Maßnahmen, die auf eine Optimierung der bakteriologisch-diagnostischen Leistung ausgerichtet sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
