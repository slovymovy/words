                    {
                        "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                        "entry_id": "e0dd0774-5a63-32a7-95fc-863048328ecb",
                        "glosses": [
                            "A freshwater pond stocked with fish; especially one formerly attached to a monastery etc as a source of food."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7419d6cd-be42-40db-a17e-62829072e461",
                                "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                                "text": "Constructed of hard flint stone, which came as ballast from England and is now painted coral white, the house has a fishpond, or catchment, roof, dating from 1788, to collect rainwater."
                            },
                            {
                                "example_id": "32054096-b421-49f3-91d7-92636659bc24",
                                "sense_id": "70bfd1fc-f5d1-33d8-8f71-419255a35adb",
                                "text": "Incarcerated in earth-filled boxes, the hapless annelids face execution in the morning. Death by immersion in fishponds, death by cruel hooks."
                            }
                        ]
                    }
                ],
