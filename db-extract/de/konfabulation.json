                "senses": [
                    {
                        "sense_id": "76bbe87a-24e4-3f47-a801-286ff5804fb5",
                        "entry_id": "c55608b3-e67c-3c4e-9e90-d1413433e6f3",
                        "glosses": [
                            "Ausfüllen von Gedächtnislücken mit Erfundenem (v.a. bei Patienten mit Demenz)"
                        ],
                        "tags": [
                            "Psychiatrie"
                        ],
                        "examples": [
                            {
                                "example_id": "125ecf97-4677-4aa3-93ca-ada4b8e52bf6",
                                "sense_id": "76bbe87a-24e4-3f47-a801-286ff5804fb5",
