                ],
                "senses": [
                    {
                        "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                        "entry_id": "d34ef015-1384-3a2a-a906-4ef944ac26cc",
                        "glosses": [
                            "Maßnahme, bei der man einen Teppich von Verschmutzungen befreit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2673f5fc-166c-4771-8569-413277226ae4",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Die Verteidigung führte […] an, dass die gesundheitlichen Probleme des Mannes auf seine jahrelange Arbeit mit Chemikalien zur Teppichreinigung zurückgingen.“"
                            },
                            {
                                "example_id": "9851f579-3f9b-4376-bc30-0956fee4ac9b",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Meist nutzen die dubiosen Teppichwäscher Werbeflugblätter. Darauf wird eine Teppichreinigung per Hand gezeigt. Der versprochene Reinigungspreis liegt bei weniger als zehn Euro pro Quadratmeter - Vor-Ort-Service mit kostenloser Abholung inklusive.“"
                            },
                            {
                                "example_id": "9416c174-ba3a-4ebe-b251-58720172b333",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Skrupellose Banden schwatzen älteren Personen Teppichreinigungen auf. Diese sind masslos überteuert.“"
                            },
                            {
                                "example_id": "b045fb94-f6dc-41f5-887c-d4d8394c47f4",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Wegen Wucherpreisen bei der Teppichreinigung mussten sich am Mittwoch (28.08.2019) zwei Männer vor dem Amtsgericht Bocholt verantworten.“"
                            },
                            {
                                "example_id": "c5e59f20-19e2-4481-994f-b49e6c39f93b",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Zur Teppichreinigung lohnt es sich, ein Teppichreinigungsgerät zu benutzen.“"
                            },
                            {
                                "example_id": "c1c81ad5-76b6-4915-a450-502456c58a36",
                                "sense_id": "1362e2ea-696d-3565-9811-50e31eeda388",
                                "text": "„Früher […] klopfte man seine Teppiche im Freien aus. Und im Winter legte man sie mit der Florseite auf die geschlossene Schneedecke. \"Das ist auch heute keine schlechte Idee\", meint Lange. Ähnlich wie bei der professionellen Teppichreinigung wird der Flor dabei mit Wasser gespült.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8abe6d2f-1465-33b4-8531-44a7997dbbd5",
                        "entry_id": "d34ef015-1384-3a2a-a906-4ef944ac26cc",
                        "glosses": [
                            "Unternehmen, dessen Geschäftsmodell auf [1] beruht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d85d8a1-fb63-47e4-a276-c66642d44259",
                                "sense_id": "8abe6d2f-1465-33b4-8531-44a7997dbbd5",
                                "text": "„Neulich kam uns eine Teppichreinigung über den Weg, die eine Bioreinigung des Teppichs versprach, was immer das heißt. Das konnten sie uns dann auch nicht erklären.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
