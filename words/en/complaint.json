{
    "word_family": [
        "complain",
        "complainant",
        "complainer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7c9dafa-5d89-38ef-8f26-80c7e8cd83cc",
                    "sense_definition": "A statement that something is wrong, unsatisfactory, or unacceptable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer made a <w>complaint</w> about the poor service at the restaurant.",
                            "target_lang_translations": {
                                "ru": "Клиент подал <w>жалобу</w> на плохое обслуживание в ресторане.",
                                "zh": "顾客对餐厅糟糕的服务提出了<w>投诉</w>。"
                            }
                        },
                        {
                            "text": "We received several <w>complaints</w> regarding the noise level from the construction site.",
                            "target_lang_translations": {
                                "ru": "Мы получили несколько <w>жалоб</w> касательно уровня шума со строительной площадки.",
                                "zh": "我们收到了几起关于施工现场噪音水平的<w>投诉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a complaint",
                        "file a complaint",
                        "customer complaint",
                        "noise complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление о том, что что-то не так, неудовлетворительно или неприемлемо.",
                        "zh": "对某事感到不满或认为其不可接受而提出的陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "выражение недовольства"
                            },
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "требование об устранении нарушения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投诉",
                                "target_lang_sense_clarification": "针对服务或产品提出的正式不满"
                            },
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "表达不满的言论"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "278be2ee-d39b-33d4-99f8-e2ec04968e91",
                    "sense_definition": "A reason for dissatisfaction or unhappiness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no <w>complaints</w> about how the team performed during the project.",
                            "target_lang_translations": {
                                "ru": "У меня нет <w>претензий</w> к тому, как команда сработала во время проекта.",
                                "zh": "对于团队在项目期间的表现，我没有任何<w>不满</w>。"
                            }
                        },
                        {
                            "text": "His only <w>complaint</w> was the lack of fresh coffee in the break room.",
                            "target_lang_translations": {
                                "ru": "Его единственной <w>претензией</w> было отсутствие свежего кофе в комнате отдыха.",
                                "zh": "他唯一的<w>怨言</w>就是休息室里没有现磨咖啡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have no complaints",
                        "cause for complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причина недовольства или неудовлетворенности.",
                        "zh": "不满或不愉快的原因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "претензия",
                                "target_lang_sense_clarification": "основание для недовольства"
                            },
                            {
                                "target_lang_word": "недовольство",
                                "target_lang_sense_clarification": "чувство неудовлетворенности"
                            },
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "повод для сетования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不满",
                                "target_lang_sense_clarification": "对现状不满意的情绪"
                            },
                            {
                                "target_lang_word": "怨言",
                                "target_lang_sense_clarification": "抱怨的话语或理由"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93892e42-f94d-3429-990d-52bb94eb728f",
                    "sense_definition": "An illness or medical condition, usually affecting a specific part of the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She suffers from a recurring stomach <w>complaint</w> that requires a special diet.",
                            "target_lang_translations": {
                                "ru": "Она страдает от периодического желудочного <w>недомогания</w>, требующего специальной диеты.",
                                "zh": "她患有一种反复发作的胃部<w>疾病</w>，需要特殊的饮食。"
                            }
                        },
                        {
                            "text": "The doctor treated him for a minor skin <w>complaint</w>.",
                            "target_lang_translations": {
                                "ru": "Врач лечил его от незначительного кожного <w>заболевания</w>.",
                                "zh": "医生为他治疗了一种轻微的皮肤<w>不适</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heart complaint",
                        "stomach complaint",
                        "minor complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Болезнь или медицинское состояние, обычно затрагивающее определенную часть тела.",
                        "zh": "一种疾病或身体状况，通常影响身体的特定部位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недомогание",
                                "target_lang_sense_clarification": "расстройство здоровья"
                            },
                            {
                                "target_lang_word": "недуг",
                                "target_lang_sense_clarification": "болезнь"
                            },
                            {
                                "target_lang_word": "заболевание",
                                "target_lang_sense_clarification": "медицинское состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疾病",
                                "target_lang_sense_clarification": "身体的病症"
                            },
                            {
                                "target_lang_word": "不适",
                                "target_lang_sense_clarification": "身体上的小毛病"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e463f31c-2b18-3adb-983b-f2dde912c82a",
                    "sense_definition": "A formal legal document stating the facts and reasons for a lawsuit, filed by the plaintiff.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer drafted a <w>complaint</w> to initiate the civil lawsuit against the corporation.",
                            "target_lang_translations": {
                                "ru": "Адвокат составил <w>исковое заявление</w> для возбуждения гражданского иска против корпорации.",
                                "zh": "律师起草了一份<w>起诉状</w>，以启动针对该公司的民事诉讼。"
                            }
                        },
                        {
                            "text": "The defendant must respond to the <w>complaint</w> within thirty days of receiving it.",
                            "target_lang_translations": {
                                "ru": "Ответчик должен ответить на <w>исковое заявление</w> в течение тридцати дней после его получения.",
                                "zh": "被告必须在收到<w>起诉状</w>后的三十天内做出回应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plaint"
                    ],
                    "common_phrases": [
                        "file a complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный юридический документ, излагающий факты и основания иска, подаваемый истцом.",
                        "zh": "由原告提交的，陈述诉讼事实和理由的正式法律文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исковое заявление",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "иск",
                                "target_lang_sense_clarification": "судебное требование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起诉状",
                                "target_lang_sense_clarification": "法律诉讼中的正式文件"
                            },
                            {
                                "target_lang_word": "诉状",
                                "target_lang_sense_clarification": "法律诉讼中的正式文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e04f556-0304-3958-9e08-c01162ed4bfc",
                    "sense_definition": "A formal charge accusing someone of a crime, made to an authority.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police filed a <w>complaint</w> against the suspect for theft.",
                            "target_lang_translations": {
                                "ru": "Полиция оформила <w>заявление</w> на подозреваемого в краже.",
                                "zh": "警方对嫌疑人提出了盗窃罪的<w>控告</w>。"
                            }
                        },
                        {
                            "text": "The magistrate reviewed the criminal <w>complaint</w> before issuing a warrant.",
                            "target_lang_translations": {
                                "ru": "Судья рассмотрел уголовную <w>жалобу</w> перед выдачей ордера.",
                                "zh": "地方法官在签发逮捕令前审查了刑事<w>控告</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charge",
                        "criminal complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное обвинение в совершении преступления, поданное властям.",
                        "zh": "向有关当局提出的正式犯罪指控。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление",
                                "target_lang_sense_clarification": "официальное сообщение о преступлении"
                            },
                            {
                                "target_lang_word": "жалоба",
                                "target_lang_sense_clarification": "обвинение (в порядке частного обвинения)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "控告",
                                "target_lang_sense_clarification": "正式指控某人犯罪"
                            },
                            {
                                "target_lang_word": "报案",
                                "target_lang_sense_clarification": "向警方报告犯罪行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}