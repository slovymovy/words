                ],
                "senses": [
                    {
                        "sense_id": "d2fc8363-477d-3b9c-8a76-80f2743073c5",
                        "entry_id": "96d5da17-07c2-3723-8a51-446e89c5479c",
                        "glosses": [
                            "To bury; to place in a grave."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a158f651-f2d5-457e-a41a-9057d78b9934",
                                "sense_id": "d2fc8363-477d-3b9c-8a76-80f2743073c5",
                                "text": "But if these black adventures I survive, / Ev'n till this mortal body be ingrav'd, / You shall be lord of that which you have sav'd."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e035694-fbfb-31f2-8043-fb96fcb8a8cc",
                        "entry_id": "96d5da17-07c2-3723-8a51-446e89c5479c",
                        "glosses": [
                            "To cause death."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e71464e6-bd3d-4b56-acc3-c7256275d829",
                                "sense_id": "8e035694-fbfb-31f2-8043-fb96fcb8a8cc",
                                "text": "Millions of people were enslaved and ingraved in the Gulag forced labor camps."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5d355f0-b609-308c-b8f1-580d97f70522",
                        "entry_id": "96d5da17-07c2-3723-8a51-446e89c5479c",
                        "glosses": [
                            "Obsolete form of engrave."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8bd9bbe7-75fb-4d9f-b74a-730007b97159",
                                "sense_id": "b5d355f0-b609-308c-b8f1-580d97f70522",
                                "text": "[…]M. Anthony Bos, who both etched and ingraved in a Stile of his own, did not ſucceed ſo well;[…]."
                            },
                            {
                                "example_id": "584d7ea9-9341-41b7-b7de-4c26757ae005",
                                "sense_id": "b5d355f0-b609-308c-b8f1-580d97f70522",
                                "text": "Even in Ashmole's plate of the feast of Saint George, in the Hall at Windsor, (ingraved by Hollar,) the Knights may be seen, feeding themselves with their fingers: one only appears to be using a fork or spoon."
                            },
                            {
                                "example_id": "77c82047-d356-4be5-9794-70719e3407bc",
                                "sense_id": "b5d355f0-b609-308c-b8f1-580d97f70522",
                                "text": "Behold this fruit, whose gleaming rind ingrav'n / \"For the most fair,\"' would seem to award it thine, […]"
                            },
                            {
                                "example_id": "8aebb329-3706-4eb9-b82c-f7a700c140fc",
                                "sense_id": "b5d355f0-b609-308c-b8f1-580d97f70522",
                                "text": "1991, Giorgio Vasari, Julia Conaway Bondanella, Peter Bondanella (translators), The Lives of the Artists, [from 1550, G. Vasari, Le Vite de' più eccellenti pittori, scultori, e architettori da Cimabue insino a' tempi nostri], page 91,\nThis work, with its border decorations ingraved with festoons of fruit and animals all cast in metal, cost twenty-two thousand florins, while the bronze doors themselves weighed thirty-four thousand pounds."
                            }
                        ]
                    }
