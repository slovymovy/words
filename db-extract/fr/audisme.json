                        "glosses": [
                            "Discrimination et hostilité manifestées à l'égard des sourds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "585550c6-eea9-45b2-888d-9059651bac14",
                                "sense_id": "a669a0b3-03a6-3a86-969d-578002363d04",
                                "text": "L’audisme est fondée sur l’idée que l’audition soit prioritaire, sous prétexte que la société est à 99% audiophonatoire, tout en déniant la LSF ou même le bilinguisme."
                            },
                            {
                                "example_id": "087a6516-490e-4374-ae97-e1a0fe05c48d",
                                "sense_id": "a669a0b3-03a6-3a86-969d-578002363d04",
                                "text": "L’oppression systémique affecte de façon particulière les personnes sourdes et malentendantes, notamment à travers l’audisme."
                            }
                        ]
                    }
