                                    {
                                        "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                                        "entry_id": "84e453a7-fc81-313a-9ea1-5ae01864a2de",
                                        "glosses": [
                                            "Matériau émettant de la lumière suite à l’absorption d’un rayonnement ionisant (photon ou particule chargée)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aedbc95-f46e-42e4-90b0-c20ab3d1e858",
                                                "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                                                "text": "Sur la face externe de cette fibre optique est déposé le scintillateur assurant la conversion photons X à photons lumineux, sur la face interne est déposée la couche photosensible."
                                            },
                                            {
                                                "example_id": "a21f5d9c-fe7c-49f1-8ed4-7c30c7ebfa24",
                                                "sense_id": "a5cae15f-f26d-3dda-b67b-db59f963a76e",
                                                "text": "Un rayonnement traversant un scintillateur solide ou liquide provoque sur sa trajectoire l’excitation d’un certain nombre de molécules qui restituent l’énergie ainsi absorbée sous forme de photons lumineux."
                                            }
                                        ]
                                    }
