                        "sense_id": "3948e302-af2c-3a80-b8f2-f86c24def1b3",
                        "entry_id": "177c2cfb-b304-3b82-bd02-5c8f8445452e",
                        "glosses": [
                            "aardappelen die gebruikt worden om in het land te poten (=in de grond stoppen), uit deze pootaardappelen ontstaan dan de aardappelplanten waar men de ondergrondse knollen van kan oogsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5979998b-997e-4367-875d-6cf860caad7e",
                                "sense_id": "3948e302-af2c-3a80-b8f2-f86c24def1b3",
                                "text": "Rusland gaat de importstop van Nederlandse pootaardappelen herzien. De Russische dienst die de gezondheid van planten controleert, komt binnenkort op inspectie. Bij een positieve uitslag kan de export van pootaardappelen naar Rusland ter waarde van 10 miljoen euro worden hervat."
                            },
                            {
                                "example_id": "46fab994-b070-423f-8122-ed744932f8e2",
                                "sense_id": "3948e302-af2c-3a80-b8f2-f86c24def1b3",
                                "text": "De Arizona wordt al sinds 2013 verbouwd in Kenia. Agrico levert er rond de 1.000 ton per jaar, en de Keniase boeren verbouwen die hoeveelheid tot er 15 duizend ton is. Dat is genoeg om 7.500 kleine boeren in het land van pootaardappelen te voorzien. Na het succes in Kenia kan de Arizona ook in andere landen worden verbouwd."
                            }
                        ]
                    }
