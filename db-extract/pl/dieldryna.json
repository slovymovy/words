                "translations": [
                    {
                        "translation_id": "63fda351-4aae-488c-8086-36cea5432c3d",
                        "source_entry_id": "5f031a9e-0702-3877-9100-d99eeb00a019",
                        "source_sense_id": "d0f705b8-46d0-3cd4-a535-616c579948f5",
                        "target_lang_word": "dieldrin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dieldrin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6074a965-f036-3273-a8b0-a3fe283715bc",
                                        "entry_id": "8c2fcae0-5f35-3f50-8795-4927fc41f47c",
                                        "glosses": [
                                            "A cyclodiene insecticide, related to aldrin, that is a persistent organic pollutant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72d33e70-4171-4951-bfd3-6c35be4658c7",
                        "source_entry_id": "5f031a9e-0702-3877-9100-d99eeb00a019",
                        "source_sense_id": "d0f705b8-46d0-3cd4-a535-616c579948f5",
                        "target_lang_word": "dieldrine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dieldrine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f95109e5-5316-3edd-995b-d024d073bc28",
                                        "entry_id": "39b04502-917e-378d-be8d-2bbf13ad804e",
                                        "glosses": [
                                            "Composé organochloré, de formule brute C₁₂H₈Cl₆O, à usage insecticide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d98fd3c1-6694-4f4b-8aad-64e9beef37fe",
                                                "sense_id": "f95109e5-5316-3edd-995b-d024d073bc28",
                                                "text": "On a détecté dans le milieu marin : des hydrocarbures aliphatiques issus des chlorures de vinyle, des composés du D.D.T., des biphényles polychlorés, des dieldrines, endrines, hexachloro-benzène, etc."
                                            },
                                            {
                                                "example_id": "f763b22a-f6cc-4485-9591-fe11d021497d",
                                                "sense_id": "f95109e5-5316-3edd-995b-d024d073bc28",
                                                "text": "Les résidus d'insecticides les plus couramment rencontrés dans ces deux retenues sont le DDE, le DDD, le DDT et la dieldrine."
                                            },
                                            {
                                                "example_id": "0498a531-7fa5-45a0-8b1a-100c04d93955",
                                                "sense_id": "f95109e5-5316-3edd-995b-d024d073bc28",
                                                "text": "Il est interdit de mettre sur le marché, de détenir en vue de la vente, de céder à titre onéreux ou gratuit ou d'utiliser en l'état ou dans des préparations, du chlordane, de l'heptachlore, de l'hexachlorocyclohexane contenant moins de 99 % d'isomère gamma, du HHDN ou aldrine, de l'HEOD ou dieldrine et de l'endrine."
                                            },
                                            {
                                                "example_id": "0202594d-522c-424c-9897-f732e58f148a",
                                                "sense_id": "f95109e5-5316-3edd-995b-d024d073bc28",
                                                "text": "L’usage de la dieldrine dans l’agriculture – très toxique pour l’être humain et l’environnement – est interdit depuis 1972, les deux produits – l’aldrine est un cancérogène – ont été totalement prohibés en 1992, soit trente ans avant qu’un contrôle en détecte dans les produits de Delphine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
