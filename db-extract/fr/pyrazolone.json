                "senses": [
                    {
                        "sense_id": "0eab86a6-ee8c-36e1-a905-c46406f5dcda",
                        "entry_id": "45fe4784-7f5d-30f4-8c0b-bc2e33116ca1",
                        "glosses": [
                            "Composé cyclique de formule chimique brute C₃H₄N₂O, dont de nombreux dérivés ont été ou sont utilisés en pharmacologie ou comme colorants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c00f968-5d8f-4361-b674-9626615e17a3",
                                "sense_id": "0eab86a6-ee8c-36e1-a905-c46406f5dcda",
                                "text": "Des hormones, telles que la cortisone et l’ACTH, les salycilés, les dérivés de la pyrazolone, le cincophène et ses analogues ont une action anti-inflammatoire marquée."
                            },
                            {
                                "example_id": "e3848961-4186-4734-97ee-f33fa04df543",
                                "sense_id": "0eab86a6-ee8c-36e1-a905-c46406f5dcda",
                                "text": "Il ne faut jamais associer d’autres médicaments myélotoxiques à un traitement par les dérivés de la pyrazolone."
                            }
                        ]
                    },
                    {
                        "sense_id": "58aee1ca-f6de-39c7-82f2-f806b44cc76e",
                        "entry_id": "45fe4784-7f5d-30f4-8c0b-bc2e33116ca1",
                        "glosses": [
                            "Nom générique de tous ces dérivés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a42791ce-3bdd-4f8f-bb9e-466ee80ac49e",
                                "sense_id": "58aee1ca-f6de-39c7-82f2-f806b44cc76e",
                                "text": "Le métamizole sodium … Au début des années 70, il est apparu que son utilisation, comme celle de quelques autres pyrazolones, avait entraîné des réactions secondaires graves et parfois fatales, et notamment dans les cas de dyscrasie du sang …."
                            }
                        ]
                    }
