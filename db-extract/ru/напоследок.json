                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2ced7a-6be7-4fa2-89fe-8ccdea3b2782",
                                                "sense_id": "42b1bd57-7289-3158-8a3f-3b28a0548ae6",
                                                "text": "Horst und Irma kamen zuletzt an."
                                            },
                                            {
                                                "example_id": "baa2aea8-c26c-4d55-9d83-9b44fc7913bf",
                                                "sense_id": "42b1bd57-7289-3158-8a3f-3b28a0548ae6",
                                                "text": "Das Orchester der Titanic soll bis zuletzt gespielt haben."
                                            },
                                            {
                                                "example_id": "14a23958-6566-4374-8d97-2761ceb93211",
                                                "sense_id": "42b1bd57-7289-3158-8a3f-3b28a0548ae6",
                                                "text": "„Zuletzt schrieben Versicherer Rekordgewinne und Banken profitierten von gestiegenen Zinsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fc7b156-3260-3c7e-91a2-bade84ff3eec",
                                        "entry_id": "9a89d1ec-100f-38ad-86fb-ed006e53b34a",
                                        "glosses": [
                                            "in letzter Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c7dba06-33db-43d5-8e17-a5f1055dd882",
                                                "sense_id": "7fc7b156-3260-3c7e-91a2-bade84ff3eec",
                                                "text": "Unter den zuletzt schwierigen Wetterverhältnissen war eine Rettung kaum mehr zu erwarten."
                                            },
                                            {
                                                "example_id": "32d25711-08c6-45ac-a127-bd7678b3b5c6",
                                                "sense_id": "7fc7b156-3260-3c7e-91a2-bade84ff3eec",
                                                "text": "„Zuletzt hat der Bordnetz- und Kabelhersteller den Gewinn dank hoher Sondereffekte und großer Nachfrage aus der Autoindustrie jedoch wieder mehr als verdoppelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04c3d884-9a92-47e8-a898-08aae831b872",
                        "source_entry_id": "598413db-0449-3dcb-a982-9ebdeeaecca2",
