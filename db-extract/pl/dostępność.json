                    },
                    {
                        "translation_id": "278d7cbc-5c79-4ac8-8e91-3eb8d25dce8f",
                        "source_entry_id": "44bcc089-d839-367d-b58c-448e36ebd66f",
                        "source_sense_id": "3ef67991-04e6-3497-847e-4b8d3338da9d",
                        "target_lang_word": "Zugänglichkeit",
