{
    "word_family": [
        "number",
        "numerical",
        "numerically",
        "innumerable",
        "enumerate",
        "numeracy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a00bf81c-c8fb-3ce9-b3f6-f53dd7b49c7a",
                    "sense_definition": "Existing in great numbers; many.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "many_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library contains <w>numerous</w> books on the subject.",
                            "target_lang_translations": {
                                "ru": "В библиотеке содержатся <w>многочисленные</w> книги по этому предмету.",
                                "zh": "图书馆里有关于这个主题的<w>许多</w>书。"
                            }
                        },
                        {
                            "text": "She has visited the museum on <w>numerous</w> occasions.",
                            "target_lang_translations": {
                                "ru": "Она посещала музей в <w>многочисленных</w> случаях.",
                                "zh": "她曾在<w>众多</w>场合参观过这家博物馆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "many",
                        "multiple"
                    ],
                    "common_phrases": [
                        "numerous occasions",
                        "numerous attempts",
                        "numerous sources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в большом количестве; многие.",
                        "zh": "指数量很多；许多。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многочи́сленный",
                                "target_lang_sense_clarification": "о большом количестве предметов или событий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "表示数量多，常用作定语"
                            },
                            {
                                "target_lang_word": "众多",
                                "target_lang_sense_clarification": "形容数量很多，书面语色彩较浓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d72a70d-f868-3130-86ca-e615073810db",
                    "sense_definition": "Consisting of a large number of individuals or parts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "populous_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>numerous</w> crowd waited for the gates to open.",
                            "target_lang_translations": {
                                "ru": "<w>Многочисленная</w> толпа ждала открытия ворот.",
                                "zh": "<w>众多</w>的人群在等待大门开启。"
                            }
                        },
                        {
                            "text": "He belonged to a <w>numerous</w> family with ten siblings.",
                            "target_lang_translations": {
                                "ru": "Он принадлежал к <w>многочисленной</w> семье с десятью братьями и сестрами.",
                                "zh": "他出生在一个有十个兄弟姐妹的<w>庞大</w>家庭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manifold"
                    ],
                    "antonyms": [
                        "unnumerous"
                    ],
                    "common_phrases": [
                        "numerous family",
                        "numerous class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из большого числа людей или частей.",
                        "zh": "由大量个体或部分组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многочи́сленный",
                                "target_lang_sense_clarification": "о группе людей или совокупности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庞大",
                                "target_lang_sense_clarification": "形容规模、数量或组织巨大"
                            },
                            {
                                "target_lang_word": "众多",
                                "target_lang_sense_clarification": "形容群体或成员数量多"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "6e768dc0-79b6-37c0-b050-9d89fe1fbe1c",
                    "sense_definition": "An indefinite large number of.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "many_det",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>numerous</w> reasons why we should proceed.",
                            "target_lang_translations": {
                                "ru": "Существуют <w>многочисленные</w> причины, почему нам следует продолжать.",
                                "zh": "我们应该继续下去有<w>许多</w>理由。"
                            }
                        },
                        {
                            "text": "<w>Numerous</w> studies have confirmed these findings.",
                            "target_lang_translations": {
                                "ru": "<w>Многочисленные</w> исследования подтвердили эти выводы.",
                                "zh": "<w>大量</w>研究已经证实了这些发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "many"
                    ],
                    "antonyms": [
                        "a few",
                        "a couple of",
                        "a handful of"
                    ],
                    "common_phrases": [
                        "numerous times",
                        "numerous people",
                        "numerous ways"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределенно большое количество чего-либо.",
                        "zh": "指不确定的、大量的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многочи́сленный",
                                "target_lang_sense_clarification": "в значении «многие»"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "表示不确定的多量"
                            },
                            {
                                "target_lang_word": "大量",
                                "target_lang_sense_clarification": "表示数量很大"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}