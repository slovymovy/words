                "senses": [
                    {
                        "sense_id": "3afde18d-6217-3aee-8c19-8d4bf61b3108",
                        "entry_id": "f2386f01-b49f-389b-ada6-645ac4e57b16",
                        "glosses": [
                            "Qui n’émet plus de dioxyde de carbone lors de sa production d’énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533daa25-1d10-439d-91b2-2f1b4c01a086",
                                "sense_id": "3afde18d-6217-3aee-8c19-8d4bf61b3108",
                                "text": "La priorité devrait être donnée à une électricité décarbonée, issue de ressources renouvelables."
                            },
                            {
                                "example_id": "cb812926-9c4a-4773-9d62-616f9cec7256",
                                "sense_id": "3afde18d-6217-3aee-8c19-8d4bf61b3108",
                                "text": "Cependant, aucune réflexion de fond n’étant menée sur nos besoins en énergie et nos modes de production et de consommation, la « transition » énergétique consiste essentiellement à essayer de remplacer le pétrole par des énergies renouvelables : hydroélectrique, éolienne, solaire et bioénergies (dont les biocarburants) principalement, sans oublier le nucléaire, la première des énergies « décarbonées » en France, ce qui devrait nous alerter sur le fait que « décarboné » ne veut pas dire propre."
                            },
                            {
                                "example_id": "30dbd413-ca28-4036-8f3b-36cc9e9d9c00",
                                "sense_id": "3afde18d-6217-3aee-8c19-8d4bf61b3108",
                                "text": "L’avenir énergétique de la France repose sur la substitution des combustibles fossiles par la production massive d’électricité décarbonée, renouvelable et nucléaire."
                            }
                        ]
                    }
