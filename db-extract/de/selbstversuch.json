                "senses": [
                    {
                        "sense_id": "f9a53932-fcd2-349b-b022-06e88f90e130",
                        "entry_id": "6a2ba175-e78e-3368-8932-2decac179363",
                        "glosses": [
                            "Erprobung von Verfahren am eigenen Körper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c60db55-499a-489e-bebb-3c4b3b3acfd6",
                                "sense_id": "f9a53932-fcd2-349b-b022-06e88f90e130",
                                "text": "„Allen, die einen Selbstversuch planen, sei eher von diesem abgeraten, da es heute weniger gefährliche Wege gibt, das medizinische Wissen zu erweitern.“"
                            },
                            {
                                "example_id": "56840a2e-d461-4c2a-9834-bcfb31fa52bf",
                                "sense_id": "f9a53932-fcd2-349b-b022-06e88f90e130",
                                "text": "„Mit diesem Skandal enden auf Jahrzehnte Jüngers Selbstversuche mit psychotropen Substanzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
