                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70710db1-8d72-4475-880e-5f4d601de5ef",
                                "sense_id": "c70514ce-8df2-33de-84b9-d3684df4bca0",
                                "text": "Twee dakluiken van een rondvaartboot belandden woensdagavond in de gracht nadat de boot De Museumbrug op de grens van Zuid en Centrum raakte."
                            },
                            {
                                "example_id": "9a40118d-0457-48b0-9c25-1f1f7aa0feed",
                                "sense_id": "c70514ce-8df2-33de-84b9-d3684df4bca0",
                                "text": "Het open dakluik van de 'kluiskamer' van Ibn Ghaldoun. Het luik op het schooldak waardoor de scholieren de eindexamens hebben weten te bemachtigen, bleek niet te zijn afgesloten. Het was echter wel de toegang tot de 'afgesloten' kluiskamer van Ibn Ghaldoun waar alle eindexamens lagen."
                            }
                        ]
                    }
