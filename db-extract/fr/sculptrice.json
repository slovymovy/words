                                        "sense_id": "6246f4b7-5049-3116-b60f-b561d198948d",
                                        "entry_id": "149c1388-ef72-305e-842c-848fe3444316",
                                        "glosses": [
                                            "Künstlerin, die plastische Figuren aus verschiedenen Materialien herstellt"
                                        ],
                                        "tags": [],
