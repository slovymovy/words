                            {
                                "example_id": "77dd6d42-a44f-4cc9-93a4-ae94610bd10e",
                                "sense_id": "35ba6357-3b6e-3a47-be57-061419cbeadd",
                                "text": "„Eine Rückschau auf Jenaer Eisenbahnbauprojekte mit öffentlicher Beteiligung zeigt, Kostenexplosionen gab es auch bei uns.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
