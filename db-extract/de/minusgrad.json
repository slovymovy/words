                        "sense_id": "dd12584b-2c68-3336-b3c3-53a4ba195192",
                        "entry_id": "7a8bd652-259b-3893-8775-fde038b83d2e",
                        "glosses": [
                            "Grad unter dem Gefrierpunkt (0 °C)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d09c0402-21f6-404d-bd74-fc90a13ae608",
                                "sense_id": "dd12584b-2c68-3336-b3c3-53a4ba195192",
                                "text": "Das Wasser des Baches gefror bei den langanhaltenden Minusgraden."
                            },
                            {
                                "example_id": "53241268-2f5e-492d-aa92-237db1caf3db",
                                "sense_id": "dd12584b-2c68-3336-b3c3-53a4ba195192",
                                "text": "„Es war erst halb acht, und die Sonne stand nicht besonders hoch am diesigen Himmel, aber dennoch fühlte sich die Kleidung sofort schwer an, und der Körper hatte Mühe, sich nach zehn Stunden von ein paar Minusgraden in Kopenhagen auf dreißig Plusgrade umzustellen.“"
                            },
                            {
                                "example_id": "197ebdd4-351f-4a2c-b15a-08d4281190a9",
                                "sense_id": "dd12584b-2c68-3336-b3c3-53a4ba195192",
                                "text": "„Auch im Winter bei Minusgraden dürfen Energieversorger weiter den Strom abklemmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
