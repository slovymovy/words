                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huile de coco",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7dec353-4cf3-3767-a485-5856479eeeeb",
                                        "entry_id": "11717a4c-91ee-32a9-bca0-6e0b6575e203",
                                        "glosses": [
                                            "Huile obtenue par pression de la pulpe, appelée coprah, de la noix de coco."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "816ef4f8-add9-4b3f-8d63-079d8adc6da8",
                                                "sense_id": "e7dec353-4cf3-3767-a485-5856479eeeeb",
                                                "text": "[…] certaines huiles de substitution sont pires. Ainsi, l’huile de coco (ou huile de coprah) possède 85 % d’acides gras saturés contre « seulement » 50 % pour l’huile de palme !"
                                            },
                                            {
                                                "example_id": "684476c2-9170-4cc5-9fe6-fe1a6bf41ff5",
                                                "sense_id": "e7dec353-4cf3-3767-a485-5856479eeeeb",
                                                "text": "Mélangez les œufs, la farine de matza, l’ail, le gingembre haché finement, l’huile de coco, les herbes ciselées finement, le shot d’huile et d’eau."
                                            },
                                            {
                                                "example_id": "9215dde2-15f9-42bf-be16-d25ca11a65a0",
                                                "sense_id": "e7dec353-4cf3-3767-a485-5856479eeeeb",
                                                "text": "De l'écossage inhumain des noix de cajou par les femmes en Inde à la destruction des sols pour l’huile de coco, en passant par la consommation d'eau et de pesticides des avocatiers, les raisons ne manquent pas pour se tourner vers les produits locaux et éthiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76415334-6b2e-4479-b864-305ccc3dd788",
                        "source_entry_id": "fdc75d6c-085b-32f4-a9d8-f3a3c792aa0d",
                        "source_sense_id": "21f99e3d-8432-3de2-a930-cd38020bb784",
