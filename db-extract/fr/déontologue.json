                    {
                        "sense_id": "c32a883d-0525-3bc9-b747-f82db24b3d72",
                        "entry_id": "068801da-363b-32a1-ad9a-d0ed3cf352ff",
                        "glosses": [
                            "Personne chargée, au sein d’une entreprise, de contrôler la conformité des actes et des procédures aux lois et aux règles de bonne conduite, et de sensibiliser le personnel à celles-ci."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "0ba28986-b8b9-4aae-b7b8-f95f00b9b7b3",
                                "sense_id": "c32a883d-0525-3bc9-b747-f82db24b3d72",
                                "text": "Le déontologue doit assurer le respect des lois, règlements et usages professionnels, coordonner les relations de son établissement avec les autorités de marché, mettre en place des procédures de contrôle adéquates et fiables, lutter contre le blanchiment des capitaux."
                            },
                            {
                                "example_id": "10fb58ea-871f-41ba-82f9-87f39fbb48b5",
                                "sense_id": "c32a883d-0525-3bc9-b747-f82db24b3d72",
                                "text": "Tout élu local peut consulter un référent déontologue chargé de lui apporter tout conseil utile au respect des principes déontologiques consacrés dans la charte de l'élu local."
                            }
                        ]
                    }
                ],
