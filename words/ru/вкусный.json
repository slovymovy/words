{
    "word_family": [
        "вкус",
        "вкусно",
        "вкуснятина",
        "вкусовой"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "03292956-300e-3a4b-87fa-fa8a13f0297f",
                    "sense_definition": "Имеющий приятный вкус, доставляющий удовольствие при еде.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это клубничное мороженое очень сладкое и <w>вкусное</w>.",
                            "target_lang_translations": {
                                "en": "This strawberry ice cream is very sweet and <w>delicious</w>."
                            }
                        },
                        {
                            "text": "Мама приготовила на ужин очень <w>вкусный</w> суп.",
                            "target_lang_translations": {
                                "en": "Mom made a very <w>tasty</w> soup for dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "аппетитный"
                    ],
                    "antonyms": [
                        "невкусный",
                        "безвкусный"
                    ],
                    "common_phrases": [
                        "вкусный обед",
                        "вкусный ужин"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a pleasant flavor, providing enjoyment when eating."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delicious",
                                "target_lang_sense_clarification": "Highly pleasant to the sense of taste."
                            },
                            {
                                "target_lang_word": "tasty",
                                "target_lang_sense_clarification": "Having a satisfying or pleasant flavor."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fd71eea-7152-3513-84fd-398af06a5c44",
                    "sense_definition": "Приятный, доставляющий удовольствие (в переносном смысле).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он рассказал очень <w>вкусную</w> историю о своих приключениях.",
                            "target_lang_translations": {
                                "en": "He told a very <w>delightful</w> story about his adventures."
                            }
                        },
                        {
                            "text": "У него был такой <w>вкусный</w> голос, что все слушали его с удовольствием.",
                            "target_lang_translations": {
                                "en": "He had such a <w>pleasant</w> voice that everyone listened to him with pleasure."
                            }
                        }
                    ],
                    "synonyms": [
                        "смачный"
                    ],
                    "target_lang_definitions": {
                        "en": "Pleasant, providing enjoyment (in a figurative sense)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delightful",
                                "target_lang_sense_clarification": "Highly pleasing or charming in a figurative context."
                            },
                            {
                                "target_lang_word": "enjoyable",
                                "target_lang_sense_clarification": "Giving pleasure or satisfaction."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71fefe49-dff5-38fc-acae-dcf12b774efa",
                    "sense_definition": "Вызывающий яркое представление о чем-то аппетитном или приятном.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор написал очень <w>вкусное</w> описание летнего сада.",
                            "target_lang_translations": {
                                "en": "The author wrote a very <w>vivid</w> description of the summer garden."
                            }
                        },
                        {
                            "text": "Это было <w>вкусное</w> и детальное описание праздничного стола.",
                            "target_lang_translations": {
                                "en": "It was a <w>rich</w> and detailed description of the festive table."
                            }
                        }
                    ],
                    "synonyms": [
                        "красочный"
                    ],
                    "target_lang_definitions": {
                        "en": "Evoking a vivid impression of something appetizing or pleasant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vivid",
                                "target_lang_sense_clarification": "Producing powerful feelings or strong, clear images in the mind."
                            },
                            {
                                "target_lang_word": "evocative",
                                "target_lang_sense_clarification": "Bringing strong images, memories, or feelings to mind."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}