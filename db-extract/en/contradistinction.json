                        "sense_id": "af60f34a-7d77-3584-bfc5-234f1329e6de",
                        "entry_id": "fde6e272-ee8a-310f-93d8-0661fe8fb2a9",
                        "glosses": [
                            "Distinction by contrast; the provision of one example against which another example may be defined."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0f8555f-6c12-4b22-98e7-fbc7127e0cc0",
                                "sense_id": "af60f34a-7d77-3584-bfc5-234f1329e6de",
                                "text": "We used hamburgers and soda in contradistinction to healthy food."
                            },
                            {
                                "example_id": "b7e2101e-10a7-480a-adce-83db998e6823",
                                "sense_id": "af60f34a-7d77-3584-bfc5-234f1329e6de",
                                "text": "The doctrine that everything is God, in contradistinction to the doctrine that God is everything."
                            },
                            {
                                "example_id": "435d7d70-89fe-4656-98be-c4a2c42cdcfe",
                                "sense_id": "af60f34a-7d77-3584-bfc5-234f1329e6de",
                                "text": "Captain John Smith gives the name Reef Knot in 1627. Dana gives the name Square Knot in 1841. Few sailors speak of Square Knot except in contradistinction to Granny Knot but it is the common shore name for the knot and is in good repute among sailors."
                            },
                            {
                                "example_id": "26725a93-d89f-48cf-b1e6-6557b31ca70b",
                                "sense_id": "af60f34a-7d77-3584-bfc5-234f1329e6de",
                                "text": "It will be noted that on this service, in contradistinction to that from and to Bristol, extra trains are provided to cope with peak-hour conditions; [...]."
                            }
                        ]
                    },
