                                "target_senses": [
                                    {
                                        "sense_id": "9d3a2606-99ae-37be-841e-6bba84506bd0",
                                        "entry_id": "a0981be8-e3bb-3766-a1c3-9f1c1803719a",
                                        "glosses": [
                                            "körperlich beeinträchtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9db3037-704a-4d1a-a9de-5f89202652ef",
                                                "sense_id": "9d3a2606-99ae-37be-841e-6bba84506bd0",
                                                "text": "„Zum Glück ist da die sanfte, gebrechliche Urgroßmutter, die ihr von der Sklaverei erzählt und von den sechzehn Kindern, die sie von ihrem weißen Herrn bekommen hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
