                                    {
                                        "sense_id": "93c038be-66dd-36f7-970d-efa0227ee61b",
                                        "entry_id": "635d1891-9f6a-3848-976b-79da24c1aa92",
                                        "glosses": [
                                            "Variante de talith."
                                        ],
                                        "tags": [
                                            "Judaism",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "032820d7-ac0d-44b3-9673-8cba82df7928",
                                                "sense_id": "93c038be-66dd-36f7-970d-efa0227ee61b",
                                                "text": "Le Taled est un Voile blanc & quarré avec des cordons & des houpes."
                                            },
                                            {
                                                "example_id": "7bebb8d1-6d89-42bc-8e56-b2bea3965156",
                                                "sense_id": "93c038be-66dd-36f7-970d-efa0227ee61b",
                                                "text": "C’est aussi pendant la prière du matin que les Juifs se servent du Taled & du Teffilin."
                                            },
                                            {
                                                "example_id": "7ddd4f24-2cf2-4782-bce9-5fe5c6fa5af6",
                                                "sense_id": "93c038be-66dd-36f7-970d-efa0227ee61b",
                                                "text": "Il ne s’arrête point, et continue ; il porte\nLe taled blanc où pend le zizith à cinq nœuds"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
