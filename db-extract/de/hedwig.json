                "senses": [
                    {
                        "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                        "entry_id": "9789abda-0426-3938-86b7-8521458925dc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5368619-12ff-4a69-b42b-496c29affe4c",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Frau Hedwig ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "cebd248f-73fa-4209-8d56-904b0c90fc25",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Herr Hedwig wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0a3f0a32-7fc5-4ea0-b79c-27bf390a027a",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Die Hedwigs fahren heute nach Kassel."
                            },
                            {
                                "example_id": "d1ff125b-e0a2-45f3-900c-e306c9ac6654",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Der Hedwig trägt nie die Pullover, die die Hedwig ihm strickt."
                            },
                            {
                                "example_id": "aab24369-2adc-4835-adb7-a5880b4b58c1",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hedwig kommt, geht der Herr Hedwig.“"
                            },
                            {
                                "example_id": "db2b1116-2adf-4a30-89d0-7565edcf227e",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Hedwig kommt und geht."
                            },
                            {
                                "example_id": "a66f1958-dd0e-4897-b9e0-6ee190000f81",
                                "sense_id": "4d663d91-85d0-3fec-8f00-bb65030c0053",
                                "text": "Hedwigs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
