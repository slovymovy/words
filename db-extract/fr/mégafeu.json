                    {
                        "sense_id": "9068aeb2-06e3-358a-adf1-025baf024022",
                        "entry_id": "6c13fddb-281e-37f6-b839-db2950a1baca",
                        "glosses": [
                            "Incendie qui ravage une très grande surface, typiquement plus de 1 000 ou 10 000 hectares."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b62102-d67e-49fe-b678-ac76858eb1f8",
                                "sense_id": "9068aeb2-06e3-358a-adf1-025baf024022",
                                "text": "Elle peut se vivre sur le mode tragique d’une pandémie ou d’un mégafeu de forêt qui, avec l’ombre de la mort, redonne à nos vies la conscience de leur précarité."
                            },
                            {
                                "example_id": "973b2793-595b-45a3-b34c-fff3155faa0a",
                                "sense_id": "9068aeb2-06e3-358a-adf1-025baf024022",
                                "text": "Les mégafeux, en revanche, sont appelés à se multiplier à la faveur du changement climatique et de la sécheresse."
                            },
                            {
                                "example_id": "f02b4378-b50f-43a8-967c-59c08073ce80",
                                "sense_id": "9068aeb2-06e3-358a-adf1-025baf024022",
                                "text": "Mais combien ont coûté le Covid-19, les mégafeux, la désertification ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae7de802-cead-49a6-b248-9f7021696799",
                        "source_entry_id": "6c13fddb-281e-37f6-b839-db2950a1baca",
                        "source_sense_id": "9068aeb2-06e3-358a-adf1-025baf024022",
                        "target_lang_word": "megafire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megafire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0b441f-d902-39bf-800f-ab3b6b4bd3d5",
                                        "entry_id": "3c64482c-ea1c-3eeb-89db-9a7783dc4b68",
                                        "glosses": [
                                            "A very large wildfire, typically one covering more than 100,000 acres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a220947-9d13-4cbd-aba8-383487cebf6e",
                                                "sense_id": "7d0b441f-d902-39bf-800f-ab3b6b4bd3d5",
                                                "text": "This increase means that almost every aspect of the Earth’s climate system is now influenced by humanity, and the consequences – droughts, heatwaves, megafires, melting glaciers and rising oceans – are now well understood."
                                            },
                                            {
                                                "example_id": "f29b13a3-c641-477d-809c-ec952e0e8a59",
                                                "sense_id": "7d0b441f-d902-39bf-800f-ab3b6b4bd3d5",
                                                "text": "There remains much that can be done to limit the damage to come, to brace against the coming megafires and superstorms and save lives and hold onto a thriving civilization."
                                            },
                                            {
                                                "example_id": "f4fd1f70-d43e-4626-8265-a53023f38637",
                                                "sense_id": "7d0b441f-d902-39bf-800f-ab3b6b4bd3d5",
                                                "text": "Across the Western United States, a summer of record-breaking drought, heat waves and megafires exacerbated by climate change is forcing millions of people to confront an inescapable string of disasters that challenge the future of growth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
