                    {
                        "sense_id": "11e1d0d4-fe91-3df1-99bf-0dfb174c4d89",
                        "entry_id": "3d3684a9-ff37-388e-ac40-9e49aa5fb82b",
                        "glosses": [
                            "A beetle of the species Scarabaeus sacer, sacred to the ancient Egyptians."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8bd633ec-482d-382d-855d-5998f48b7068",
                        "entry_id": "3d3684a9-ff37-388e-ac40-9e49aa5fb82b",
                        "glosses": [
                            "Any species of beetle belonging to the family Scarabaeidae."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ddc063d4-2047-3d5a-a982-fc57b31cee3d",
                        "entry_id": "3d3684a9-ff37-388e-ac40-9e49aa5fb82b",
                        "glosses": [
                            "A symbol, seal, amulet, or gem fashioned to resemble the sacred beetle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc475b6-40be-45ed-872b-5eef62ccb0b8",
                                "sense_id": "ddc063d4-2047-3d5a-a982-fc57b31cee3d",
                                "text": "The scarab, which is a very small one, Leo had insisted upon having set in a massive gold ring, such as is generally used for signets, and it was this very ring that I now picked up."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0aadaea-17dd-4e4b-a717-b40cbaccb767",
                        "source_entry_id": "3d3684a9-ff37-388e-ac40-9e49aa5fb82b",
