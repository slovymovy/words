                "senses": [
                    {
                        "sense_id": "773d4c3e-e72d-3a42-8015-a708c3eae62f",
                        "entry_id": "52ee6121-1b09-3700-b752-d79b0cf1943c",
                        "glosses": [
                            "Clore soi-même (ce qu'on avait pourtant ouvert)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55dd6266-4255-4e75-886f-149ce1589563",
                                "sense_id": "773d4c3e-e72d-3a42-8015-a708c3eae62f",
                                "text": "Ca a été dit et répété maintes fois, notamment concernant la possibilité d'effacer ses propres messages ou d'auto-clore son sujet, ici-même, sur PQS."
                            },
                            {
                                "example_id": "4e56c69a-93fb-4e46-a3c2-db0251e684fb",
                                "sense_id": "773d4c3e-e72d-3a42-8015-a708c3eae62f",
                                "text": "Donc, j'auto-clos ce topic, à moins que d'autres personnes soient intéressées et veuillent continuer..."
                            }
                        ]
                    },
                    {
                        "sense_id": "66c0e148-d211-32b6-aba8-d3a606c9ff99",
                        "entry_id": "52ee6121-1b09-3700-b752-d79b0cf1943c",
                        "glosses": [
                            "Se clore tout seul, sans intervention extérieure."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "05d8ddeb-9f47-4afb-aa56-7f5716ad44ad",
                                "sense_id": "66c0e148-d211-32b6-aba8-d3a606c9ff99",
                                "text": "Notre équipe composée officiellement de 3 membres, et officieusement de 2 et 1 paillasson, a délibérément laissé l'autre topique s'auto-clore, gniahahahahahahahaha."
                            }
                        ]
                    }
