                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e64a4e6-72a4-3972-b449-2be83fbd4d2d",
                        "entry_id": "c6a409fe-d706-33d4-87c1-0e12df121fab",
                        "glosses": [
                            "Qui est ou a été précédemment mentionné dans une énumération, un tableau, une matrice ou une grille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a73b9aa8-f9a0-4819-822e-8954d444a02c",
                                "sense_id": "0e64a4e6-72a4-3972-b449-2be83fbd4d2d",
                                "text": "Dans un tableau, les éléments ditos sont marqués par des tirets (—) en Europe, par des guillemets fermants (») au Québec, par des guillemets droits (\") aux États-Unis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28c2a8d8-5ed0-4871-a457-5c9ba3cf727b",
                        "source_entry_id": "c6a409fe-d706-33d4-87c1-0e12df121fab",
                        "source_sense_id": "0e64a4e6-72a4-3972-b449-2be83fbd4d2d",
                        "target_lang_word": "wie schon gesagt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d1035711-4bfe-4ef1-8142-548fb5a7613d",
                        "source_entry_id": "c6a409fe-d706-33d4-87c1-0e12df121fab",
                        "source_sense_id": "0e64a4e6-72a4-3972-b449-2be83fbd4d2d",
                        "target_lang_word": "ditto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ditto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "That which was stated before, the aforesaid, the above, the same, likewise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b94dad-af31-47a3-babe-65b88bf34312",
                                                "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                                "text": "[...] they entered a dismal-looking parlour, whose brick-red walls and ditto curtains were scantily lighted by a single lamp, though it was of the last new patent—[…]"
                                            },
                                            {
                                                "example_id": "fe845bfd-dea1-4ad1-804b-4c6c8cf41c87",
                                                "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                                "text": "[…]a spacious table in the centre, and a variety of smaller dittos in the corners:[…]"
                                            },
                                            {
                                                "example_id": "aa2248f1-1d64-4933-9881-f3f7f1f0ad42",
                                                "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                                "text": "Well say he's got the constitution of a dinosaur, recuperative powers ditto. And as we both know, I'm a bright young medic with a miraculous touch. Well why then, when I returned, there wasn't a trace of that wound on his forehead. Not even a bruise. It was like he had never been injured."
                                            },
                                            {
                                                "example_id": "ae8a9844-c98d-4422-9bad-5d0959e27983",
                                                "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                                "text": "The opening shot of \"Crystal Skull\" shows the playful side of director Steven Spielberg, who seems to have a weak spot for cute animals. See \"AI Artificial Intelligence\" for Exhibit A. Ditto for executive producer George Lucas. See \"Return of the Jedi\" for Exhibit B."
                                            },
                                            {
                                                "example_id": "0eacfbc2-da2f-4613-a921-dc597e40a7ca",
                                                "sense_id": "fa53fa42-0414-331e-9d52-e8b93572aa4c",
                                                "text": "He has created for himself a honed, primed-for-victory body and is working hard on a ditto mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6330cb45-5467-3b14-a5a5-d82585de46f7",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "A duplicate or copy of a document, particularly one created by a spirit duplicator."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f1621e1-22f3-47ac-a169-196753ef3a0b",
                                                "sense_id": "6330cb45-5467-3b14-a5a5-d82585de46f7",
                                                "text": "Please run off twenty-four dittos of this assignment, for my students."
                                            },
                                            {
                                                "example_id": "0143d17a-2c43-4c35-9f22-9b50e18bd3dc",
                                                "sense_id": "6330cb45-5467-3b14-a5a5-d82585de46f7",
                                                "text": "Mr. Zappadia gave each student a ditto of a black-and-white cow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ba9a8b6-c77b-3efc-bd36-0f4a5a7b92b0",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "A copy; an imitation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97dc9895-05a6-4c71-92ca-c066028ea2e0",
                                                "sense_id": "4ba9a8b6-c77b-3efc-bd36-0f4a5a7b92b0",
                                                "text": "\"You've got to look good to feel good,\" she announces, a ditto of television slogans."
                                            },
                                            {
                                                "example_id": "572064ed-c2a9-4785-8199-5087e92f6af7",
                                                "sense_id": "4ba9a8b6-c77b-3efc-bd36-0f4a5a7b92b0",
                                                "text": "Last year, Argenta-Oreana blanked the Chiefs 23-0 in a second-round game Dee-Mack coach Jim McDonald said was \"pretty much a ditto\" of what transpired Saturday."
                                            },
                                            {
                                                "example_id": "c1de73f5-2b53-422e-bdf5-530f956e8a67",
                                                "sense_id": "4ba9a8b6-c77b-3efc-bd36-0f4a5a7b92b0",
                                                "text": "The intent of the policy, she said, is \"not to put everybody in a ditto environment,\" where all are expected to look and act exactly like all others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a3163ab-9fb8-3762-b6da-c3a8f4e9e5ad",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "The ditto mark, 〃; a symbol, represented by two apostrophes, inverted commas, or quotation marks (\\\" \\\"), indicating that the item preceding is to be repeated."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8935c646-0dcb-38e0-8e16-a546dcd643ab",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "A suit of clothes of the same color throughout."
                                        ],
                                        "tags": [
                                            "historical",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6250ce52-8e54-37e3-b38e-3dc8b83d91b2",
                                        "entry_id": "49a663f0-4cdd-3b97-a079-200f0c59ca85",
                                        "glosses": [
                                            "Synonym of worksheet (“a sheet of paper or computerized document”)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ditto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20b4408a-2191-38ef-9bbf-f7137c4518c0",
                                        "entry_id": "876158e5-05a0-3fcc-8d3b-452ee1998541",
                                        "glosses": [
                                            "As said before, likewise."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c06b5d-3eda-48b1-932c-480315da2a31",
                                                "sense_id": "20b4408a-2191-38ef-9bbf-f7137c4518c0",
                                                "text": "The inflationary effect of injecting $1 billion into the economy could be dire; ditto the impact on the tumbling bolivar of treating foreign reserves as if they were the government's piggy-bank."
                                            },
                                            {
                                                "example_id": "bcc06425-de50-4653-bfdd-04b2a1deb693",
                                                "sense_id": "20b4408a-2191-38ef-9bbf-f7137c4518c0",
                                                "text": "Some of the players were concerned about what the future held for them – given that one of the measures involved Chelsea not being able to operate in the transfer market or offer new contracts. Ditto many members of staff."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ditto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28bf615c-086b-33f1-b5f9-c35ce5ea2f91",
                                        "entry_id": "f83fd699-0f63-3a24-8728-45247f49b8de",
                                        "glosses": [
                                            "To repeat the aforesaid, the earlier action etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd42a6e-376c-473c-a8b4-34a664543736",
                                                "sense_id": "28bf615c-086b-33f1-b5f9-c35ce5ea2f91",
                                                "text": "The Communists believed that Prakasam, the Prime Minister, never tried to check the bureaucracy but dittoed every action of the corrupt officials and police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c5c2cc6-795c-3451-8baa-6c495e94b132",
                                        "entry_id": "f83fd699-0f63-3a24-8728-45247f49b8de",
                                        "glosses": [
                                            "To make a copy using a ditto machine."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8bbb02-fb7c-4d1b-beab-b05079d4df96",
                                                "sense_id": "4c5c2cc6-795c-3451-8baa-6c495e94b132",
                                                "text": "But they were all purple, Dittoed—worn, torn, stained with coffee."
                                            },
                                            {
                                                "example_id": "2601bae3-7188-495a-a2b8-0035a7062435",
                                                "sense_id": "4c5c2cc6-795c-3451-8baa-6c495e94b132",
                                                "text": "I was going to join a commune of my friends. I sort of issued a declaration of independence which I dittoed up and put in everybody's mail box in the department."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ditto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a307946b-1fc8-32de-8535-e133d927a982",
                                        "entry_id": "adf1f4a8-5675-3bb3-8b4c-47c5b8785fed",
                                        "glosses": [
                                            "Used as an expression of agreement with what another person has said, or to indicate that what they have said equally applies to the person being addressed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "164ed9d2-c05d-48a9-bb49-6c93f2e4f0f4",
                                                "sense_id": "a307946b-1fc8-32de-8535-e133d927a982",
                                                "text": "I'm really busy today! —Ditto!"
                                            },
                                            {
                                                "example_id": "fa499809-53d4-4f31-a99f-25bb3853542f",
                                                "sense_id": "a307946b-1fc8-32de-8535-e133d927a982",
                                                "text": "\"Besides, if I'm only a sort of thing in his dream, what are you, I should like to know?\" \"Ditto,\" said Tweedledum. \"Ditto, ditto!\" cried Tweedledee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
