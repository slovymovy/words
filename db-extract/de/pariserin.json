                "senses": [
                    {
                        "sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                        "entry_id": "ec3a1461-ad7d-3859-b22b-dd8a6f09db4a",
                        "glosses": [
                            "Einwohnerin der Stadt Paris"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce8f907-65a9-4d12-be00-222d0b492ff1",
                                "sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                                "text": "Meine Mutter ist Pariserin."
                            },
                            {
                                "example_id": "eb5f757a-bd78-468c-88bd-7f4046f20684",
                                "sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                                "text": "„Der Gang der Pariserin ist hektisch und damit perfekt an den Lebensrhythmus dieses stressigen Lebens angepasst.“"
                            },
                            {
                                "example_id": "76d22550-4e9e-47d9-b024-e47dc8be3421",
                                "sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                                "text": "„Daddy kannte bereits seit Mitte der Zwanzigerjahre eine Pariserin namens Yvonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "052073df-85c1-4c5a-b9e5-b3c679ac04d7",
                        "source_entry_id": "ec3a1461-ad7d-3859-b22b-dd8a6f09db4a",
                        "source_sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                        "source_sense_description": "Einwohnerin der Stadt Paris",
                        "target_lang_word": "Parisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                        "entry_id": "d6cf8ff7-a3d2-30e7-abbb-840ca9128a41",
                                        "glosses": [
                                            "A native, citizen and/or inhabitant of Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b528304-dcf2-49f7-9195-ccc48ea35aa8",
                                                "sense_id": "547089c2-375b-38c4-a316-1469e214691b",
                                                "text": "Not all of France was inundated by the nationalist wave – it was predominantly young, intelligent Parisians who embraced the new bellicism […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Parisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                        "entry_id": "de66880e-b0bb-3ee9-908b-758355ca22ab",
                                        "glosses": [
                                            "Of, relating, or pertaining to Paris, France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42138cde-4ae1-42e0-ae49-e37b1176438b",
                                                "sense_id": "32537e1b-c081-3156-8282-12a510a74c2c",
                                                "text": "He lived in Paris for ten years, and became more Parisian than the natives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bc8147f-f1bf-4d73-a5bd-ce4e0e91dbb9",
                        "source_entry_id": "ec3a1461-ad7d-3859-b22b-dd8a6f09db4a",
                        "source_sense_id": "4b4c4257-3684-3441-a164-b7be5e328942",
                        "source_sense_description": "Einwohnerin der Stadt Paris",
                        "target_lang_word": "Parisienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parisienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                        "entry_id": "1de6930d-8c8e-3ae2-afbb-00e8383cfac7",
                                        "glosses": [
                                            "Habitante de Paris, commune française située dans la région Île-de-France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e68d905e-b868-4acf-9366-fa080d343e34",
                                                "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                                "text": "Toutefois, la Parisienne de Paris est ce qu’on a imaginé de mieux jusqu’à ce jour en fait de femme…"
                                            },
                                            {
                                                "example_id": "791c1818-4b6f-4f6b-9043-617a199f316f",
                                                "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                                "text": "Une Parisienne amoureuse dément sa nature et manque à sa fonction, qui est d’être à tous, comme une œuvre d’art. C’en est une, et la plus merveilleuse que l’industrie de l’homme ait jamais produite. C’est un prestigieux artifice, dû au concours de tous les arts mécaniques et de tous les arts libéraux, c’est l’œuvre commune, c’est le bien commun. Son devoir est de paraître."
                                            },
                                            {
                                                "example_id": "664898c4-c438-439a-a329-7bfc0e989d93",
                                                "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                                "text": "Il est bien difficile de dire ce que c’est qu’une Parisienne. En revanche, on voit très bien ce que c’est qu’une femme qui n’est pas parisienne."
                                            },
                                            {
                                                "example_id": "8092d913-7526-4e61-94a1-012904873444",
                                                "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                                "text": "Et sais-tu ce que je me disais à l’instant, en t’apercevant, si gracieuse, qui cueillais les fleurs parmi la rosée du matin ? Que les jeunes Parisiennes, et même que les houris qui nous attendent au paradis sont, à coup sûr, moins belles que toi…"
                                            },
                                            {
                                                "example_id": "53f67e09-0692-4cae-9bd8-7e05d68d3594",
                                                "sense_id": "c9bad527-d603-346b-9dc9-8c530c5af9d5",
                                                "text": "Mais, c'est au moment où la Parisienne est la plus charmante, au moment où sous un soleil de plomb, par un de ces temps où l'orage menaçant suffoque, elle chemine, abritée sous l'ombrelle, suant ainsi qu'une gargoulette, l'oeil meurtri par le chaud, le teint moite, la mine alanguie et vannée, que sa senteur s'échappe, rectifiée par le filtre des linges, tout à la fois délicieusement hardie et timidement fine !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1d49728-6639-4f14-a878-a3475e500a73",
                        "source_entry_id": "ec3a1461-ad7d-3859-b22b-dd8a6f09db4a",
