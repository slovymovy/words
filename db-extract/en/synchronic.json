                                    {
                                        "sense_id": "472ba2be-c54f-3b31-901e-e1db88bbe829",
                                        "entry_id": "57e115a5-1710-360c-9e0b-c378ee5bf94f",
                                        "glosses": [
                                            "Qui est relatif à ce qui se fait dans le même temps."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b632236-cfb8-4d7b-8a28-ce2f7843de37",
                                                "sense_id": "472ba2be-c54f-3b31-901e-e1db88bbe829",
                                                "text": "L’histoire de l’humanité n’est nullement synchronique en ses diverses parties. Tremblons. En ce moment peut-être la religion de l’avenir se fait et se fait sans nous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5be34f0-c708-30cf-ae0a-26d4a9111e1a",
                                        "entry_id": "57e115a5-1710-360c-9e0b-c378ee5bf94f",
                                        "glosses": [
                                            "Relatif à un système linguistique à un moment donné, sans considérer les évolutions dans le passé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
