                "senses": [
                    {
                        "sense_id": "17b42686-b9ce-3386-9293-3c9686822f3c",
                        "entry_id": "07d6eec0-40d1-3a30-b9ec-7d744c3b0431",
                        "glosses": [
                            "lulánek, pinďourek, pindík (penis)"
                        ],
                        "tags": [
                            "Bavarian",
                            "colloquially",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "8aa18232-0605-4e82-b8a1-e5d8efafe609",
                                "sense_id": "17b42686-b9ce-3386-9293-3c9686822f3c",
                                "text": "Schleunigst packte mein Suffkomplize sein Zumpferl zurück in die Hose, wobei er gleichzeitig die Flucht anzutreten versuchte.",
                                "translation": "Můj spoluchlastač si fofrem zastrkával lulana zpátky do kalhot, přičemž se zároveň pokoušel vzít nohy na ramena."
                            },
                            {
                                "example_id": "f279e777-4848-4aaf-80b0-8a4e82c1b422",
                                "sense_id": "17b42686-b9ce-3386-9293-3c9686822f3c",
                                "text": "Annerl, setz dich auf dieses Stockerl und saug mir mein Zumpferl! Sofort!",
                                "translation": "Andulko, hačni si na tuhle stoličku a dej mi pusinku! Hned!"
                            }
                        ]
                    }
                ],
