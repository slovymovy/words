                        ],
                        "examples": [
                            {
                                "example_id": "4f451211-6c5e-4002-83e0-ae91b5e8d5e8",
                                "sense_id": "d5b08f2f-5be6-32a9-992b-a27f944ea543",
                                "text": "Einer der weltweit führenden Klimasünder scheint die schleichende globale Klimakatastrophe endlich ernst zu nehmen. Der neue Premierminister Anthony Albanese hat Australien am Donnerstag auf ein strengeres Emissionsreduktionsziel verpflichtet.",
                                "translation": "One of the world's leading climate offenders finally seems to be taking the slow global climate catastrophe seriously. New Prime Minister Anthony Albanese committed Australia to a tougher emissions reduction target on Thursday.",
                                "english": "One of the world's leading climate offenders finally seems to be taking the slow global climate catastrophe seriously. New Prime Minister Anthony Albanese committed Australia to a tougher emissions reduction target on Thursday."
                            },
                            {
                                "example_id": "2d35b737-b067-4480-ae9b-6cb5061017e6",
                                "sense_id": "d5b08f2f-5be6-32a9-992b-a27f944ea543",
                                "text": "Wäre die internationale Schifffahrt ein Land, würde sie zu den Top-Klimasündern gehören – sogar noch vor Deutschland.",
                                "translation": "If international shipping were a country, it would be one of the top climate offenders – even ahead of Germany.",
                                "english": "If international shipping were a country, it would be one of the top climate offenders – even ahead of Germany."
                            }
                        ]
                    }
