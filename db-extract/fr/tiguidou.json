                                "example_id": "aa800488-17f8-4b17-a869-05638d0cd175",
                                "sense_id": "7f15ff52-1563-3d74-9a5f-287c5c6376b3",
                                "text": "J'ai réussi à rallier tous les membres de mon association. Si Danièle pouvait faire la même chose avec la sienne, ce serait tiguidou.",
                                "translation": "I managed to rally all the members of my group. If Danièle could do the same with hers, that would be just peachy.",
                                "english": "I managed to rally all the members of my group. If Danièle could do the same with hers, that would be just peachy."
                            },
                            {
                                "example_id": "0d002800-09d7-42a9-b4af-2bc9fee88755",
                                "sense_id": "7f15ff52-1563-3d74-9a5f-287c5c6376b3",
                                "text": "Toi, tu t'occupes de la production, moi, je m'occupe de la vente, et ça va être tiguidou!",
                                "translation": "You handle the production, I'll handle the sales, and everything will be perfectly fine!",
                                "english": "You handle the production, I'll handle the sales, and everything will be perfectly fine!"
                            }
                        ]
                    }
