                                                "example_id": "3a361359-8ad7-44cb-abf5-0d206184a78a",
                                                "sense_id": "9fbc9feb-e44f-3da4-9a04-d91189772e8d",
                                                "text": "„Über ihrer Nasenwurzel bildete sich eine scharfe senkrechte Falte.“"
                                            },
