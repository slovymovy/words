                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa13935-77d3-4677-9c8f-e514ea55bea9",
                                "sense_id": "a830ac8f-ef3f-3215-9784-5db7bc81c4fd",
                                "text": "Механизировали резание металла, вырубку углов, гибку, склепку."
