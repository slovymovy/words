                "senses": [
                    {
                        "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                        "entry_id": "e3bc32a4-4e9f-37f7-9a01-2a2048d37825",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73476b45-e624-4434-bf0c-0cbc41829fcb",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Frau Bodenstedt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "57d36356-9147-44a1-a8b6-5b3723a127b8",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Herr Bodenstedt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b6704364-94ca-4030-a05a-24d38c3aca1d",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Die Bodenstedts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "60f219db-d686-4295-98d1-60c1e59ba0eb",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Der Bodenstedt trägt nie die Pullover, die die Bodenstedt ihm strickt."
                            },
                            {
                                "example_id": "4e7f65db-1f2d-4ff5-a1d3-e10cb17e1471",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bodenstedt kommt, geht der Herr Bodenstedt.“"
                            },
                            {
                                "example_id": "a5e300e5-8fc8-485a-8eff-ed4f861207c9",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Bodenstedt kommt und geht."
                            },
                            {
                                "example_id": "7a474877-6dd5-4ee4-8433-49cbebd77b1d",
                                "sense_id": "9e035d8d-2a45-3b74-9b60-eaed144b2f1f",
                                "text": "Bodenstedts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
