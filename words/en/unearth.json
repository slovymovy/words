{
    "word_family": [
        "earth",
        "earthly",
        "unearthly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2222661b-45f6-32db-bbab-764165977a70",
                    "sense_definition": "To dig up or remove something from under the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excavate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists managed to <w>unearth</w> ancient artifacts during the dig.",
                            "target_lang_translations": {
                                "tr": "Arkeologlar kazı sırasında antik eserleri <w>gün yüzüne çıkarmayı</w> başardılar."
                            }
                        },
                        {
                            "text": "Workers unexpectedly <w>unearthed</w> buried bones while laying new pipes.",
                            "target_lang_translations": {
                                "tr": "İşçiler yeni boruları döşerken beklenmedik bir şekilde gömülü kemikler <w>kazıp çıkardılar</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unearth artifacts",
                        "unearth remains"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi toprağı kazarak yerin altından çıkarmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "topraktan çıkarmak",
                                "target_lang_sense_clarification": "kazı yaparak yer altından çıkarmak"
                            },
                            {
                                "target_lang_word": "kazıp çıkarmak",
                                "target_lang_sense_clarification": "kazarak gün ışığına çıkarmak"
                            },
                            {
                                "target_lang_word": "gün yüzüne çıkarmak",
                                "target_lang_sense_clarification": "gömülü nesneleri ortaya çıkarmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23f13e12-aa87-32fa-a158-164629262599",
                    "sense_definition": "To discover or bring out something that was hidden or forgotten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discover",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist worked hard to <w>unearth</w> the hidden truth about the scandal.",
                            "target_lang_translations": {
                                "tr": "Gazeteci, skandalla ilgili gizli gerçeği <w>ortaya çıkarmak</w> için çok çalıştı."
                            }
                        },
                        {
                            "text": "After weeks of searching the archives, researchers <w>unearthed</w> forgotten letters.",
                            "target_lang_translations": {
                                "tr": "Arşivleri haftalarca araştırdıktan sonra araştırmacılar unutulmuş mektupları <w>ortaya çıkardılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bring to light",
                        "disclose"
                    ],
                    "common_phrases": [
                        "unearth the truth",
                        "unearth evidence",
                        "unearth secrets"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gizli kalmış veya unutulmuş bir şeyi araştırıp ortaya çıkarmak, keşfetmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ortaya çıkarmak",
                                "target_lang_sense_clarification": "gizli veya unutulmuş şeyleri açığa çıkarmak"
                            },
                            {
                                "target_lang_word": "gün ışığına çıkarmak",
                                "target_lang_sense_clarification": "saklanan bir gerçeği veya belgeyi aydınlatmak"
                            },
                            {
                                "target_lang_word": "bulmak",
                                "target_lang_sense_clarification": "araştırma sonucu varlığı bilinmeyen veya unutulmuş bir şeye rastlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf9715c-6527-3819-b616-db89a258ac59",
                    "sense_definition": "To drive or draw an animal out of its burrow or underground lair.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "excavate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunting dogs attempted to <w>unearth</w> a badger from its underground burrow.",
                            "target_lang_translations": {
                                "tr": "Av köpekleri bir porsuğu yer altındaki ininden <w>çıkarmaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "The gamekeeper managed to <w>unearth</w> the fox after tracking it across the field.",
                            "target_lang_translations": {
                                "tr": "Av koruyucusu, tarlada takip ettikten sonra tilkiyi ininden <w>çıkarmayı</w> başardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unearth a badger",
                        "unearth a fox"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir hayvanı yer altındaki ininden veya yuvasından dışarı çıkarmak ya da kovalamak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ininden çıkarmak",
                                "target_lang_sense_clarification": "av hayvanını yuvasından dışarı sürmek"
                            },
                            {
                                "target_lang_word": "yuvasından çıkarmak",
                                "target_lang_sense_clarification": "hayvanı yer altındaki saklandığı yerden çıkarmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}