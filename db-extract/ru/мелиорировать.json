                                        "sense_id": "023c1e2e-68b2-3d5b-aab3-7271417fdc0e",
                                        "entry_id": "d3824130-aa11-372d-800b-8dd42fc53e1d",
                                        "glosses": [
                                            "To make better; to improve; to solve a problem."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff4b1e61-280e-4953-a488-40742052028f",
                                                "sense_id": "023c1e2e-68b2-3d5b-aab3-7271417fdc0e",
                                                "text": "They offered some compromises in an effort to meliorate the disagreement."
                                            },
                                            {
                                                "example_id": "c55cbf0b-63bc-4978-bd27-cbed35a3cd24",
                                                "sense_id": "023c1e2e-68b2-3d5b-aab3-7271417fdc0e",
                                                "text": "Nature by art we nobly meliorate."
                                            },
                                            {
                                                "example_id": "df976631-1d11-4546-946a-382d7b3364d9",
                                                "sense_id": "023c1e2e-68b2-3d5b-aab3-7271417fdc0e",
                                                "text": "June 8, 1783, George Washington, Circular to the States\n[…] and the pure and benign light of revelation have had a meliorating influence on mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb680b71-e674-393d-9ae0-9dd4ae064643",
                                        "entry_id": "d3824130-aa11-372d-800b-8dd42fc53e1d",
                                        "glosses": [
                                            "To become better."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5ad73e3-eea0-4a99-b4ae-7ee713af7519",
                        "source_entry_id": "72258859-1cac-3489-91c5-dc4739a3f5a1",
