                    {
                        "sense_id": "cd0bf434-fcb7-3936-a880-7d4be7a23132",
                        "entry_id": "cc7c0011-1025-3ba3-961c-4df6dac1c2ac",
                        "glosses": [
                            "Racine brunâtre d’une saveur âcre et nauséabonde, de la famille des rubiacées, originaire d’Amérique du Sud, et qu’on emploie en médecine pour ses propriétés émétiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3a8f968-c51b-41af-b11a-5271db29aa2d",
                                "sense_id": "cd0bf434-fcb7-3936-a880-7d4be7a23132",
                                "text": "Chaque jour, une infirmière lui avait fait ingurgiter de l’ipéca, elle avait vomi et elle en avait à chaque fois discuté avec son thérapeute pour « décatastrophiser », comme disent les tenants des TCC."
                            },
                            {
                                "example_id": "97d20d56-4abe-4e32-877e-e01c95e86772",
                                "sense_id": "cd0bf434-fcb7-3936-a880-7d4be7a23132",
                                "text": "- De l’ipéca ! poursuis-je... C’est-à-dire un vomitif très puissant et vieux comme mes robes !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
