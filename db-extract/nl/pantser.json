                    {
                        "sense_id": "549cebc6-6248-3bbd-bfdf-c3a2e54714e6",
                        "entry_id": "c8a65bd6-a1f3-382e-a9df-215923d4562c",
                        "glosses": [
                            "een beschermende laag om dieren of voorwerpen, een soort harnas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ae51b85-2471-43fe-906d-3b7d93579461",
                                "sense_id": "549cebc6-6248-3bbd-bfdf-c3a2e54714e6",
                                "text": "Door zijn pantser was de ridder nog in leven na de klap met het zwaard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5eff0cc-6a70-4d5c-bd9e-ea5dcb8efcb3",
                        "source_entry_id": "c8a65bd6-a1f3-382e-a9df-215923d4562c",
                        "source_sense_id": "549cebc6-6248-3bbd-bfdf-c3a2e54714e6",
                        "source_sense_description": "een beschermende laag om dieren of voorwerpen",
                        "target_lang_word": "Panzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Panzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5834f39a-864e-3cb5-91a5-4582b9d0b23d",
                                        "entry_id": "888fd639-abe4-3c49-a894-53ea7eaec865",
                                        "glosses": [
                                            "hartes, dickes, vor Verletzung oder Beschädigung schützendes Kleidungsstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5aa530f-6523-4dd7-b95c-58cd88e779ec",
                                                "sense_id": "5834f39a-864e-3cb5-91a5-4582b9d0b23d",
                                                "text": "Durch ihren Panzer sind die Gürteltiere gut vor Feinden geschützt."
                                            },
                                            {
                                                "example_id": "2a8027e2-bd46-4b12-b000-9d10640883b8",
                                                "sense_id": "5834f39a-864e-3cb5-91a5-4582b9d0b23d",
                                                "text": "„Ich lief also am Ufer entlang und suchte das Wasser nach so einem rötlichen Panzer ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3f3ff61-a55d-3c86-98b0-928817389d22",
                                        "entry_id": "888fd639-abe4-3c49-a894-53ea7eaec865",
                                        "glosses": [
                                            "harte, dicke, vor Verletzung oder Beschädigung schützende Außenschicht an Fahr- und Flugzeugen, Gebäuden und Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df898852-0559-3661-bc06-28ffb1f88ae9",
                                        "entry_id": "888fd639-abe4-3c49-a894-53ea7eaec865",
                                        "glosses": [
                                            "harte, verdickte Haut oder Schale bei Tieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f792bff-c853-4e7d-bbcd-ae800c25f8b3",
                                                "sense_id": "df898852-0559-3661-bc06-28ffb1f88ae9",
                                                "text": "„Ihr fast runder Panzer war auffallend flach und mit einer dicken Haut überzogen, welche die knochigen Umrisse deutlich überragte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                        "entry_id": "888fd639-abe4-3c49-a894-53ea7eaec865",
                                        "glosses": [
                                            "gepanzertes (mit einem Panzer^([2]) versehenes) Fahrzeug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dedbab5f-3123-4f30-a998-9c1057897d0c",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„Wahrscheinlich hat schon die Kavallerieabteilung sie beschlagnahmt, die auf die ersten Panzer folgte.“"
                                            },
                                            {
                                                "example_id": "329f2a80-15db-4789-a325-84e2294fbe06",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„Mit den in der Frühe des 11. April 1945 einfahrenden amerikanischen Panzern ist in Kirchhorst der Krieg zu Ende.“"
                                            },
                                            {
                                                "example_id": "dccbd5fc-e10d-4a6a-84a7-449240eef634",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„Polen hat mehr als 200 Panzer aus sowjetischer Produktion an Kiew abgegeben.“"
                                            },
                                            {
                                                "example_id": "62d74e8a-3555-4874-8e3b-cd04b723a4af",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„Der T-34 (von russisch танк für Panzer) war ein mittlerer Panzer aus sowjetischer Produktion.“"
                                            },
                                            {
                                                "example_id": "96c82168-b60a-440b-a0c0-4ab1296bc9a2",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "[Leopard 2:] „Mit dem Restlichtverstärker für den Fahrer ist der Panzer voll nacht- und eingeschränkt allwetterkampffähig.“"
                                            },
                                            {
                                                "example_id": "0aad8344-1b07-4358-ac72-e6cc33cfd2a8",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„Infolge der beim Durchschlag verursachten extremen Wärme kommt es im Panzer meist zu Sekundärexplosionen.“"
                                            },
                                            {
                                                "example_id": "2a8eab5d-7117-448d-b0d7-c1c0b52da395",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„FDP und Grüne hingegen befürworten Lieferungen schwerer Waffen an die Ukraine, darunter auch moderne westliche Panzer.“"
                                            },
                                            {
                                                "example_id": "6c2446a2-5534-4ff9-8683-eab6053d026a",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "[Die ukrainische Armee will] „bereits 2077 Panzer, 4484 gepanzerte Fahrzeuge, 236 Flugzeuge und 207 Hubschrauber abgeschossen haben.“"
                                            },
                                            {
                                                "example_id": "b2c79cc1-5793-4c18-b927-9d880117ddad",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "„In einer Erklärung teilte das Pentagon mit, dass Taiwan Reparaturteile für Panzer und Kampffahrzeuge,“ […] „angefordert habe.“"
                                            },
                                            {
                                                "example_id": "602bd3ec-8eb9-4016-ac51-e758603ce6a8",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "[Die türkische Armee hat] „am vergangenen Samstag (20. Januar) eine großangelegte militärische Offensive gegen die kurdischen \"Volksverteidigungseinheiten\" (YPG) gestartet und ist auch mit Panzern und Bodentruppen auf syrisches Gebiet vorgedrungen.“"
                                            },
                                            {
                                                "example_id": "fef84694-d75e-4467-9b20-9c11412498cf",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "[Die Türkei setzt] „schwere Artillerie und Panzer ein.“"
                                            },
                                            {
                                                "example_id": "e888a055-0f26-455e-9ec9-78068f706429",
                                                "sense_id": "281cdd45-9f7b-3313-887b-c507f78d6374",
                                                "text": "[17. Juni 1953:] „Die Hoffnungen der Demonstrierenden wurden schon im Lauf des Nachmittags zerstört, als sowjetische Panzer auffuhren um den Aufstand niederzuschlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2fadc6d7-bc2d-3112-a931-c23328232c6c",
                                        "entry_id": "888fd639-abe4-3c49-a894-53ea7eaec865",
