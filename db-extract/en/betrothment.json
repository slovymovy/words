                "translations": [
                    {
                        "translation_id": "0e5e61cd-ce25-4897-a481-71a30d51ad78",
                        "source_entry_id": "a0bf0efa-7b4a-3b53-8d74-c3c40dd68ebc",
                        "source_sense_id": "61ecde00-dcfd-30a6-aefe-bfc654897538",
                        "source_sense_description": "die Verlobung",
                        "target_lang_word": "Verlobung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verlobung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                        "entry_id": "8fb0d999-43e0-323e-a1aa-f31d36dd3d6c",
                                        "glosses": [
                                            "das Versprechen, eine Person (den Verlobten beziehungsweise die Verlobte) zu heiraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314421d5-ebcf-4e20-b35a-8e013f2bb0a1",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "Die Verlobung der beiden fand heute statt."
                                            },
                                            {
                                                "example_id": "0b744582-1f90-4a99-8e4a-5b89bd97600b",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Da soll etwas geschieden werden, das eigentlich noch gar nicht angefangen hat, es ist ein Mittelding zwischen einer handfesten Ehescheidung und einer zurückgegangenen Verlobung.“"
                                            },
                                            {
                                                "example_id": "4e51830a-37b7-4df5-bd51-2100533ee7a0",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Wenn sie, vielleicht nach einem halben Jahre, das Gefühl haben würde, ihn doch nicht von ganzem Herzen zu lieben, so würde sie durchaus recht daran tun, von der Verlobung zurückzutreten.“"
                                            },
                                            {
                                                "example_id": "97e7b3bb-6f5f-48c3-83a1-9e8f56e4a7ec",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„So kam es, daß er am selben Tag, an dem, nach gegenseitigem Abkommen, seine Verlobung mit Victoire veröffentlicht werden sollte, Berlin verließ.“"
                                            },
                                            {
                                                "example_id": "ed5cc680-6577-4184-a4e2-fbab15b3452f",
                                                "sense_id": "05dcd32d-52a1-3404-9810-0d99a12e1f9a",
                                                "text": "„Erst nach ihrer Verlobung löste sie sich langsam aus den größten Zwängen der Gutsverwaltung und plante ein neues Leben mit Jochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
