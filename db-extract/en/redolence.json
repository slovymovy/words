                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "d9234506-5549-453c-bdaa-7c503ad4ea4b",
                                "sense_id": "b908981a-2621-35c2-a160-1c0ed397e181",
                                "text": "Loola au naturel with a musky redolence which, on second thought, has something really rather fascinating about it."
                            }
                        ]
                    }
                ],
