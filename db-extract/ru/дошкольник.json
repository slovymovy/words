                                    }
                                ]
                            },
                            {
                                "target_word": "preschool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "355456a6-973a-3f45-893d-bf03e161d21c",
                                        "entry_id": "0c5ff7d0-f5b0-3291-8e3e-1fabe0e86ad6",
                                        "glosses": [
                                            "A nursery school."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eafbdb6-f127-4d85-8d75-d761dec817d2",
                                                "sense_id": "355456a6-973a-3f45-893d-bf03e161d21c",
                                                "text": "What could you do with the transumer trend in your agency? What about a coffee cart where parents pick up their children from preschool or classes?"
                                            },
                                            {
                                                "example_id": "37729193-774b-4df3-bdf9-142672d37433",
                                                "sense_id": "355456a6-973a-3f45-893d-bf03e161d21c",
                                                "text": "In a study published in late July in the Journal of Sleep Research, researchers looked at how 1,619 children in China were doing in terms of sleep. The children, ages 4, 5 and 6, were recruited from 11 preschools in the province of Guizhou, in the city of Zunyi, about 650 miles from Wuhan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfdbaae9-5bdb-34e0-9053-30eabd7a30c7",
                                        "entry_id": "0c5ff7d0-f5b0-3291-8e3e-1fabe0e86ad6",
                                        "glosses": [
                                            "A school including nursery and kindergarten. It is succeeded by elementary school."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "preschool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06d60067-211b-30b7-8048-713fdf99c278",
                                        "entry_id": "02af0c6a-ce9f-34c2-9217-5c30db5f3bc4",
