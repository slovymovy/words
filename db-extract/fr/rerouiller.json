                "senses": [
                    {
                        "sense_id": "95b5f681-a071-36e9-94f2-b52067a3bafb",
                        "entry_id": "d7405090-2989-3aa1-ad4c-990c7671907b",
                        "glosses": [
                            "Rouiller à nouveau."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4b75fb34-a1c2-460a-9882-31079f89f5dd",
                                "sense_id": "95b5f681-a071-36e9-94f2-b52067a3bafb",
                                "text": "Le problème qui va se poser sur ce que tu as fais, c'est que ça va rerouiller : la peinture n'adhère pas sur le métal en direct, l'humidité va s'infiltrer sous la peinture. il faut toujours mettre un anti rouille (zinc, chromate ou époxy)."
                            },
                            {
                                "example_id": "1a29cb72-5d40-41d1-8631-819d80757601",
                                "sense_id": "95b5f681-a071-36e9-94f2-b52067a3bafb",
                                "text": "Si tu ne fais pas non plus ces 2 opérations tes skis vont rerouiller et la peinture ne tiendra pas."
                            },
                            {
                                "example_id": "ecbf25c5-c2e6-47cc-8ec6-b4a09b67f6c9",
                                "sense_id": "95b5f681-a071-36e9-94f2-b52067a3bafb",
                                "text": "Mais bon c'est vachement sensible, ça a tendance à rerouiller facilement, c'est pour ça que je conseille un travail de vrai pro !"
                            }
                        ]
                    }
