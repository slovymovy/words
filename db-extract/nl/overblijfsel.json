                "senses": [
                    {
                        "sense_id": "8bdc83e2-1770-37b9-b427-3292ba776050",
                        "entry_id": "0b8e37b6-a109-3c1a-8061-820582a8a993",
                        "glosses": [
                            "datgene dat nog resteert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9408c65-6fd0-46c8-89d2-fad42a6f02a9",
                                "sense_id": "8bdc83e2-1770-37b9-b427-3292ba776050",
                                "text": "Dit zijn de schamele overblijfselen van wat eens een glorierijke cultuur geweest moet zijn."
                            },
                            {
                                "example_id": "253bf52d-4c53-476a-8834-6300aa2457d2",
                                "sense_id": "8bdc83e2-1770-37b9-b427-3292ba776050",
                                "text": "Toen destijds het Kanaal door Zuid-Beveland werd verbreed, moest een complete buurt, Hansweert-Oost, worden afgebroken. De gedempte kanaalarm die het overblijfsel is van deze kanaalverlegging vormt nu een lege zone tussen het nieuwe kanaal en het dorp. Ook bij eerdere dijkversterkingen moesten veel woningen het veld ruimen."
                            }
                        ]
                    }
                ],
