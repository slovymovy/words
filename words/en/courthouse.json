    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "78fc8208-7b94-3148-80d7-19178898f291",
                    "sense_definition": "A public building where legal trials and other court proceedings are held.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer walked into the <w>courthouse</w> to attend the morning hearing.",
                            "target_lang_translations": {
                                "zh": "律师走进<w>法院</w>去参加上午的听证会。"
                            }
                        },
                        {
                            "text": "Many people gathered outside the <w>courthouse</w> to wait for the verdict.",
                            "target_lang_translations": {
                                "zh": "许多人聚集在<w>法院</w>外等待判决结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "court"
                    ],
                    "common_phrases": [
                        "outside the courthouse",
                        "local courthouse"
                    ],
                    "target_lang_definitions": {
                        "zh": "进行法律审判和其他法庭诉讼的公共建筑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "法院",
                                "target_lang_sense_clarification": "指进行司法审判的机构及其办公场所。"
                            },
                            {
                                "target_lang_word": "法庭",
                                "target_lang_sense_clarification": "指审理案件的场所或机构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c950e76-db85-32f5-90af-10b7ca188f7b",
                    "sense_definition": "A public building in the United States that serves as the administrative center for a county.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Residents visited the county <w>courthouse</w> to register their new property deeds.",
                            "target_lang_translations": {
                                "zh": "居民们前往<w>县政府大楼</w>登记他们的新房产契据。"
                            }
                        },
                        {
                            "text": "The historic <w>courthouse</w> serves as the main office for all local government records.",
                            "target_lang_translations": {
                                "zh": "这座历史悠久的<w>县政府大楼</w>是所有地方政府记录的主要办公地点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "county courthouse"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国县级行政中心，通常负责处理政府记录和行政事务的公共建筑。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "县政府大楼",
                                "target_lang_sense_clarification": "指美国县级行政办公中心。"
                            },
                            {
                                "target_lang_word": "县法院",
                                "target_lang_sense_clarification": "在美国语境下，兼具司法与行政功能的县级办公场所。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}