    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa7c0d66-35d4-3f3f-81f7-c1cc46519465",
                    "sense_definition": "Partie terminale du cæcum en forme de petit tube, couramment sujette à l'inflammation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a retiré son <w>appendice</w> infecté pour éviter des complications graves."
                        },
                        {
                            "text": "Le patient souffre d'une vive douleur au ventre provoquée par son <w>appendice</w> enflammé."
                        }
                    ],
                    "common_phrases": [
                        "appendice vermiforme"
                    ]
                },
                {
                    "sense_id": "3d811329-75ee-305c-a38c-7dcef088f847",
                    "sense_definition": "Texte ou document ajouté à la fin d'un livre ou d'un écrit pour fournir des compléments d'information.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a placé les documents historiques dans un <w>appendice</w> à la fin de l'ouvrage."
                        },
                        {
                            "text": "Vous trouverez des explications détaillées sur cette méthode dans l'<w>appendice</w> du rapport."
                        }
                    ],
                    "synonyms": [
                        "annexe",
                        "addenda",
                        "supplément"
                    ],
                    "common_phrases": [
                        "publier en appendice"
                    ]
                },
                {
                    "sense_id": "c39d9c2a-2736-3244-b3d8-a8fb3c0194ee",
                    "sense_definition": "Partie saillante ou prolongement qui fait suite au corps ou à un organe chez un être vivant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains insectes possèdent un étrange <w>appendice</w> sur la tête pour détecter la nourriture."
                        },
                        {
                            "text": "Ce poisson des abysses utilise un <w>appendice</w> lumineux pour attirer ses proies dans l'obscurité."
                        }
                    ],
                    "synonyms": [
                        "prolongement"
                    ],
                    "common_phrases": [
                        "appendice nasal"
                    ]
                },
                {
                    "sense_id": "7956449f-31f0-37bc-823d-fc9ee6eb3bbb",
                    "sense_definition": "Élément secondaire qui s'ajoute à une chose principale dont il dépend ou semble dépendre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce petit bâtiment moderne semble être un simple <w>appendice</w> du château médiéval."
                        },
                        {
                            "text": "Cette nouvelle commission consultative fonctionne comme un modeste <w>appendice</w> du ministère."
                        }
                    ],
                    "synonyms": [
                        "accessoire",
                        "prolongement"
                    ],
                    "common_phrases": [
                        "simple appendice"
                    ]
                }
            ]
        }
    ]
