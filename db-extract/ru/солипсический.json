                                "target_senses": [
                                    {
                                        "sense_id": "417f0b81-9cdf-350e-985a-f84708e3d91a",
                                        "entry_id": "4689a692-c70b-39ae-99a7-1934acb0215f",
                                        "glosses": [
                                            "che si riferisce al solipsismo o ai solipsisti"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddddaf93-d328-4123-ba63-c8d09fe4edf7",
                        "source_entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "target_lang_word": "solipsistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solipsistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfae6340-90a4-3d10-9f6d-1cc10089cbc9",
                                        "entry_id": "0f6c312b-3dfd-3787-8262-bfb7d2c4781f",
                                        "glosses": [
                                            "den Solipsismus betreffend oder auch der philosophischen Idee des Solipsismus folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314680fb-702e-4ba3-bf93-32451eac05cf",
                                                "sense_id": "dfae6340-90a4-3d10-9f6d-1cc10089cbc9",
                                                "text": "In der Frage nach der Verallgemeinerbarkeit von Maximen zu Normen wird nicht auf die Ermöglichung einer Handlungsgemeinschaft hingewirkt, sondern eine solipsistische Bemühung um die eigene Rechtfertigung geliefert."
                                            },
                                            {
                                                "example_id": "24bc9bb2-c23a-47bc-83c5-8b39d17c41ad",
                                                "sense_id": "dfae6340-90a4-3d10-9f6d-1cc10089cbc9",
                                                "text": "Humboldt kennt kein solipsistisches Ich, dessen Äußerung nur auf es selbst zurückweist."
                                            },
                                            {
                                                "example_id": "3fc66038-4a9c-4828-b60c-adee365399fb",
                                                "sense_id": "dfae6340-90a4-3d10-9f6d-1cc10089cbc9",
                                                "text": "Manche sagen, das Milgram-Experiment »erhellt nichts als sich selbst«, eine harte Kritik, die den komplizierten Versuchsaufbau als bloßes solipsistisches Theater ansieht, das seine eigenen Machenschaften und Murmeleien unter die Lupe nimmt, mit den Worten von Henderikus Stam: »Sind wir nicht schlau?«"
                                            },
                                            {
                                                "example_id": "d476dc0d-ce92-4aee-9f78-1b1b13199626",
                                                "sense_id": "dfae6340-90a4-3d10-9f6d-1cc10089cbc9",
                                                "text": "Gegenwärtig herrscht das repräsentationistische Extrem vor; zu anderen Zeiten war die solipsistische Sicht vorherrschend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01fb137d-0195-4114-886a-b6a73b6c3050",
                        "source_entry_id": "45b93f02-d284-365a-94ac-41aac1658661",
                        "target_lang_word": "solipsystyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
