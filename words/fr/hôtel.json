                    "frequency": "High",
                    "semantic_group_id": "hotel_hebergement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons réservé une chambre dans un <w>hôtel</w> près de la gare."
                        },
                        {
                            "text": "Cet <w>hôtel</w> possède une belle piscine et un restaurant."
                        },
                        {
                            "text": "Pendant nos vacances, nous dormons dans un petit <w>hôtel</w> au bord de la mer."
                        }
                    ],
                    "synonyms": [
                        "palace",
                        "auberge",
                        "pension"
                    ],
                    "common_phrases": [
