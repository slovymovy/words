{
    "word_family": [
        "inferior",
        "inferiorly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "46fef402-d0cd-3121-bcf6-a280a31f47f7",
                    "sense_definition": "The state or quality of being lower in status, quality, or ability than others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inferiority_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She struggled with a deep sense of <w>inferiority</w> throughout her school years.",
                            "target_lang_translations": {
                                "ru": "Она боролась с глубоким чувством <w>неполноценности</w> на протяжении всех школьных лет."
                            }
                        },
                        {
                            "text": "The company's products suffered from a perceived <w>inferiority</w> compared to those of its competitors.",
                            "target_lang_translations": {
                                "ru": "Продукция компании страдала от воспринимаемого <w>более низкого качества</w> по сравнению с продукцией конкурентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "worseness"
                    ],
                    "antonyms": [
                        "superiority"
                    ],
                    "common_phrases": [
                        "feeling of inferiority",
                        "sense of inferiority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или качество того, кто или что ниже по статусу, качеству или способностям по сравнению с другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неполноценность",
                                "target_lang_sense_clarification": "ощущение или качество более низкого уровня"
                            },
                            {
                                "target_lang_word": "неполноценность",
                                "target_lang_sense_clarification": "в психологическом контексте (комплекс неполноценности)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9934a7b-8f59-3a0e-827b-2a5cc4641697",
                    "sense_definition": "An instance of inferior value, quality, or standard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inferiority_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The inspector pointed out the technical <w>inferiority</w> of the materials used in the construction.",
                            "target_lang_translations": {
                                "ru": "Инспектор указал на техническое <w>несовершенство</w> материалов, использованных в строительстве."
                            }
                        },
                        {
                            "text": "We must address the apparent <w>inferiority</w> of our current software version.",
                            "target_lang_translations": {
                                "ru": "Мы должны устранить очевидное <w>отставание</w> нашей текущей версии программного обеспечения."
                            }
                        }
                    ],
                    "synonyms": [
                        "worseness"
                    ],
                    "antonyms": [
                        "superiority"
                    ],
                    "common_phrases": [
                        "technical inferiority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или проявление более низкого качества, ценности или стандарта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "более низкое качество",
                                "target_lang_sense_clarification": "о качестве материалов или продукции"
                            },
                            {
                                "target_lang_word": "неполноценность",
                                "target_lang_sense_clarification": "несоответствие стандартам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76571c23-ba00-3c10-9da4-7593ba55d9ae",
                    "sense_definition": "The state of being at a competitive disadvantage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disadvantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their numerical <w>inferiority</w> made it impossible to win the battle.",
                            "target_lang_translations": {
                                "ru": "Их численное <w>меньшинство</w> сделало победу в битве невозможной."
                            }
                        },
                        {
                            "text": "The team had to overcome their physical <w>inferiority</w> with better strategy.",
                            "target_lang_translations": {
                                "ru": "Команде пришлось компенсировать свою физическую <w>слабость</w> лучшей стратегией."
                            }
                        }
                    ],
                    "antonyms": [
                        "superiority"
                    ],
                    "common_phrases": [
                        "numerical inferiority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние нахождения в невыгодном положении по сравнению с соперником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "численное меньшинство",
                                "target_lang_sense_clarification": "о численном превосходстве противника"
                            },
                            {
                                "target_lang_word": "слабость",
                                "target_lang_sense_clarification": "физическое или стратегическое отставание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a449b5-6415-38b1-ab18-cf72ae73bf21",
                    "sense_definition": "An inferior power or lower position in a hierarchy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hierarchy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treaty forced the nation into a position of permanent political <w>inferiority</w>.",
                            "target_lang_translations": {
                                "ru": "Договор вынудил страну занять позицию постоянного политического <w>подчинения</w>."
                            }
                        },
                        {
                            "text": "He resented his <w>inferiority</w> within the corporate structure.",
                            "target_lang_translations": {
                                "ru": "Его возмущало свое <w>подчиненное положение</w> в корпоративной структуре."
                            }
                        }
                    ],
                    "antonyms": [
                        "superiority"
                    ],
                    "common_phrases": [
                        "position of inferiority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более низкое положение или подчиненный статус в иерархии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подчиненное положение",
                                "target_lang_sense_clarification": "в социальной или политической структуре"
                            },
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "более низкий статус в иерархии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}