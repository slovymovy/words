        "fr-extract.jsonl": [
            {
                "entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                "word": "musc",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "784037ae-c121-44bd-ab73-532ed4bb4735",
                        "entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "muscs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8beb1a05-6e60-3a61-9d1f-beabb3adf997",
                        "entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                        "glosses": [
                            "Matière brune odorante que contient une poche située dans le ventre de certains cervidés d’Asie centrale."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3c82f155-7145-472f-a7b3-ff3b7c0dc01e",
                                "sense_id": "8beb1a05-6e60-3a61-9d1f-beabb3adf997",
                                "text": "Il est des parfums frais comme des chairs d’enfants,\nDoux comme les hautbois, verts comme les prairies,\n— Et d'autres, corrompus, riches et triomphants,\nAyant l’expansion des choses infinies,\nComme l’ambre, le musc, le benjoin et l’encens,\nQui chantent les transports de l’esprit et des sens."
                            },
                            {
                                "example_id": "287fab3a-ed1d-4a6d-ba12-307c5f47eb69",
                                "sense_id": "8beb1a05-6e60-3a61-9d1f-beabb3adf997",
                                "text": "Le musc pur, soluble dans l’eau chaude presque en totalité, l’est également dans l’alcool et l’éther."
                            },
                            {
                                "example_id": "3f85e04c-df27-4628-a960-86ce59b376e9",
                                "sense_id": "8beb1a05-6e60-3a61-9d1f-beabb3adf997",
                                "text": "Ce vêtement sent le musc."
                            },
                            {
                                "example_id": "bc9862cf-bd32-41c8-9c07-29664f37323b",
                                "sense_id": "8beb1a05-6e60-3a61-9d1f-beabb3adf997",
                                "text": "Un grain de musc."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd526f66-5265-3e35-823e-b3712ecfa60b",
                        "entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                        "glosses": [
                            "Parfum préparé avec cette substance."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "61278267-ba4e-4948-bb06-f4691b807e82",
                                "sense_id": "dd526f66-5265-3e35-823e-b3712ecfa60b",
                                "text": "Albert, à part, tirant un petit flacon de sa poche.– Voilà mon idée… C’est du musc… Avec ça, on sent un homme à quinze pas."
                            },
                            {
                                "example_id": "57c6f48f-7b07-470a-99b4-e6a9ea05683e",
                                "sense_id": "dd526f66-5265-3e35-823e-b3712ecfa60b",
                                "text": "Le Marquis.– Et puis le musc ! Il n’y a que les coiffeurs (regardant Gargaret) et les imbéciles qui se mettent du musc."
                            },
                            {
                                "example_id": "b0388820-2c72-4085-a4b7-8af0ed545099",
                                "sense_id": "dd526f66-5265-3e35-823e-b3712ecfa60b",
                                "text": "Tirant négligemment des bouts de voilette ou des mouchoirs brodés qui traînaient dans ses poches, il les donnait à respirer à ses amis, qui s’extasiaient sur l’odeur du patchouli et du musc. Une immense considération rejaillissait sur lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "e99acf35-ee2f-349d-a88f-e62c014fb630",
                        "entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                        "glosses": [
                            "Cervidé qui habite les pentes les plus raides et sauvages des hauts sommets de l'Asie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbf6eff2-36ba-4f99-83b8-83b0a7771a3c",
                        "source_entry_id": "da73d48c-c659-3885-ad90-45c82bc957ef",
                        "target_lang_word": "Moschus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moschus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53937980-bbd0-358c-b1dc-fc5eb1f20d44",
                                        "entry_id": "4995b194-f5d3-388f-8329-3c68637fc97f",
                                        "glosses": [
                                            "Sekret aus der Drüse eines Moschushirsches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6bbfc0-5c3b-425f-944a-f0560138b9e8",
                                                "sense_id": "53937980-bbd0-358c-b1dc-fc5eb1f20d44",
                                                "text": "„Die Luft in der Stube war angefüllt mit dem Duft von Moschus und Narde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                        "entry_id": "4995b194-f5d3-388f-8329-3c68637fc97f",
                                        "glosses": [
                                            "Duftstoff, der als Produkt aus dem Sekret [1] gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7362138c-b0a0-4e98-ab6a-b2de64b671b0",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Ihre Haut roch nach Moschus und einer herben Minznote.“"
                                            },
                                            {
                                                "example_id": "9f4ac9f0-1e78-4e62-b1d7-5294a94d2521",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Aber die rochen ja alle so, nach Patschuli oder Moschus.“"
                                            },
                                            {
                                                "example_id": "6ca580dd-d394-45e7-b167-3098efb5a260",
                                                "sense_id": "5d7ecf1d-1c0a-3df6-b07e-80d5c801d179",
                                                "text": "„Ich gehorchte respektvoll, aber ein Pestgeruch von Moschus, der mich an einen Leichnam erinnerte, hätte mich beinahe ohnmächtig gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17ffbf4f-cbd5-46e9-8524-6c06a3af3d08",
