                        ]
                    },
                    {
                        "translation_id": "a2f0a2ea-c8fc-4635-918a-aa199a8b2cf8",
                        "source_entry_id": "ef9d9c4a-d256-3a80-94dd-22cfc0aff990",
                        "source_sense_id": "b34905c1-7fba-36c3-9c90-7179a863dd5c",
                        "source_sense_description": "to add and ignite alcohol to food",
                        "target_lang_word": "flamber",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flamber",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4fc93d4-fde5-316b-b287-df2faad326b0",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Produire de la flamme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4dcffe8-4ac1-4d4e-b876-9ad5b4558319",
                                                "sense_id": "f4fc93d4-fde5-316b-b287-df2faad326b0",
                                                "text": "Elle était prochaine, cette catastrophe, car les toits flambaient et les murs n'étaient pas assez solides pour résister longtemps encore à l’action dévorante de ce feu infernal."
                                            },
                                            {
                                                "example_id": "623ba3a1-0ccf-4500-a84f-c111fdbca72d",
                                                "sense_id": "f4fc93d4-fde5-316b-b287-df2faad326b0",
                                                "text": "Un livre à demi ouvert sur mes genoux croisés, je suis assis devant la cheminée, où flambe le premier feu de la saison."
                                            },
                                            {
                                                "example_id": "8c469030-e15b-4cbe-aaab-f2391fb4b414",
                                                "sense_id": "f4fc93d4-fde5-316b-b287-df2faad326b0",
                                                "text": "Les forges flambent, les creusets rougissent dans tous les hameaux: au Mazy, à Issancourt, à Ville-sur-Lumes. Plus loin, des flots de fumée noire décèlent les forges de Moraimont, Vivier-au-Court et Vrigne-aux-Bois."
                                            },
                                            {
                                                "example_id": "c3f40fb8-e315-4e03-9d17-ff14464d0027",
                                                "sense_id": "f4fc93d4-fde5-316b-b287-df2faad326b0",
                                                "text": "Tous les villages de la vallée de l’Ardre flambaient. Le bourg fortifié de Neuville n'était plus qu'un brasier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805937a7-3646-3894-ab48-8e483abea11d",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Augmenter fortement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a64968-1324-4453-87d3-87eb7d2031c6",
                                                "sense_id": "805937a7-3646-3894-ab48-8e483abea11d",
                                                "text": "Nous exportons ce coton, nous sommes donc dépendants des marchés mondiaux. En 2008, lors des émeutes de la faim, le prix du blé a flambé et notre pain importé est devenu très cher. Nous devons être autonomes au niveau alimentaire et économique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ee29741-9e2e-3b68-b6a7-fa3ecd76d276",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Se déformer dans une direction perpendiculaire à la force appliquée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57e32238-7d2d-4fe1-8b9e-8e3d8a8ceea5",
                                                "sense_id": "8ee29741-9e2e-3b68-b6a7-fa3ecd76d276",
                                                "text": "Le vérin avait tendance à flamber sous le poids de la charge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b8be99-b3f2-3dc1-a5d8-d7dad4d02bf0",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Passer sur le feu."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae834f5-4d6d-44d7-9478-704f72189fe6",
                                                "sense_id": "a9b8be99-b3f2-3dc1-a5d8-d7dad4d02bf0",
                                                "text": "En cuisine, on flambe une volaille plumée pour enlever son duvet et ses plumes résiduelles."
                                            },
                                            {
                                                "example_id": "f05b423c-33c5-4d45-a41f-a687173e5a1d",
                                                "sense_id": "a9b8be99-b3f2-3dc1-a5d8-d7dad4d02bf0",
                                                "text": "Pour aseptiser des instruments de chirurgie, on peut les flamber en les passant à la flamme de l’alcool."
                                            },
                                            {
                                                "example_id": "668f13f6-432e-439b-9bf3-e479f8886309",
                                                "sense_id": "a9b8be99-b3f2-3dc1-a5d8-d7dad4d02bf0",
                                                "text": "[…] le restaurateur lui conseilla de voir un dentiste qui dans une villa voisine regrettait le départ d’un jeune homme, employé la veille encore à nettoyer la motocyclette et à flamber les instruments de chirurgie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67adfff9-f408-369a-9354-f59a6497e0c5",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Arroser d’alcool fort une préparation et enflammer cet alcool."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd280c58-84a2-45d7-86df-38321ddc3e9d",
                                                "sense_id": "67adfff9-f408-369a-9354-f59a6497e0c5",
                                                "text": "Flamber une crèpe au Grand Marnier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a55bd7d-b3e2-3545-8896-7ad115865a21",
                                        "entry_id": "77bdf200-1120-3205-b68b-db09e0c595f8",
                                        "glosses": [
                                            "Dépenser beaucoup d’argent, particulièrement au jeu."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f06be91-03bb-46e2-9cd7-28d93c0ae8ba",
                                                "sense_id": "5a55bd7d-b3e2-3545-8896-7ad115865a21",
                                                "text": "La légende raconte que tous les trois, Niels, Milo et Baptiste, un soir qu’ils avaient un peu d’argent à flamber et dînaient dans un grand restaurant, ont fait la promesse de mettre fin à leurs jours."
                                            },
                                            {
                                                "example_id": "95425a5f-4af2-42f6-9161-2f053d159a51",
                                                "sense_id": "5a55bd7d-b3e2-3545-8896-7ad115865a21",
                                                "text": "Il était peut-être pas si loin, rue des Gravilliers chez le gros Napoléon... un rade où ça flambait lorsque le rideau de fer était baissé... que se retrouvaient là les plus purs arsouilles du secteur."
                                            },
                                            {
                                                "example_id": "e355d086-a3c0-4637-b372-f779bfc20301",
                                                "sense_id": "5a55bd7d-b3e2-3545-8896-7ad115865a21",
                                                "text": "- Elle flambe, dit Milan. Il expliqua à Hélène la signification que le mot a prise dans l’argot des joueurs, avec quel bonheur il exprime à la fois la flamme intérieure qui les dévore, le flux et le reflux du sang entre l’annonce et le dénouement du coup, les égarements et l’exaltation de leur passion."
                                            }
                                        ]
                                    }
                                ]
                            }
