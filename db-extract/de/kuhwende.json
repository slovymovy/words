                "senses": [
                    {
                        "sense_id": "31b96eef-ff8f-388c-8a7b-84d2d2070e05",
                        "entry_id": "c0eff0dc-a2bb-3d98-893f-225dc6327cbf",
                        "glosses": [
                            "eine Form der Wende, bei der ein Segelboot mit dem Bug durch den Wind geht und die Wendung so lange fortsetzt, bis es ungefähr an der Ausgangsstelle ankommt, ein Manöver, das bei Mann-über-Bord gefahren wird und die Rettung einleitet, in einer Neuschöpfung auch Q-Wende genannt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8048bc80-7b05-4540-bd9e-5896ebacfb1a",
                                "sense_id": "31b96eef-ff8f-388c-8a7b-84d2d2070e05",
                                "text": "Die Kuhwende kann, bei viel Wind, anstelle der Halse gefahren werden, da die Halse unter Umständen gefährlich sein kann. Dabei wird bei der Wende die eigene Kiellinie durchfahren."
                            },
                            {
                                "example_id": "77f93c96-e7bc-49a1-a66f-f150403fd5a6",
                                "sense_id": "31b96eef-ff8f-388c-8a7b-84d2d2070e05",
                                "text": "Der Name ist von der Form des Buchstaben Q abgeleitet, allerdings werden die Formen Kuh-Wende und Q-Wende heute in der Literatur gleichberechtigt verwendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8551d61e-06a2-3fc7-a419-5f899a86a0b0",
                        "entry_id": "c0eff0dc-a2bb-3d98-893f-225dc6327cbf",
                        "glosses": [
                            "eine Form der Halse, bei der ein Segelboot mit dem Heck durch den Wind geht und die Wendung solange fortsetzt, bis es wieder grob in die gleiche Richtung weitersegelt, diesmal aber auf dem anderen Bug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af072462-1463-4cdc-bc3f-b7cb2deb2fc6",
                                "sense_id": "8551d61e-06a2-3fc7-a419-5f899a86a0b0",
                                "text": "Der Wortteil Wende in Kuhwende hat nichts mit Wende als Überstaggehen zu tun. Auch eine Identität mit der aussprachegleichen Neuschöpfung Q-Wende besteht nicht."
                            },
                            {
                                "example_id": "d0135ae6-2b33-4226-bdd3-5cea672c1e2a",
                                "sense_id": "8551d61e-06a2-3fc7-a419-5f899a86a0b0",
                                "text": "Kuhwende: beim Kreuzen durchgeführte Drehung des Schiffes mit dem Heck durch den Wind. Wurde früher von schwer manövrierenden Seglern angewendet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
