                        "sense_id": "0d47eebd-e48e-3e74-82c4-05e30be5da63",
                        "entry_id": "cf0b232d-5da2-3f20-861d-449c233f0dbe",
                        "glosses": [
                            "Habitant de la Cisjordanie ou personne qui en est originaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14aa548e-6d11-4d57-9c91-f682b1dc161f",
                                "sense_id": "0d47eebd-e48e-3e74-82c4-05e30be5da63",
                                "text": "Durant la période 1949-1967, le régime jordanien fut déterminé à empêcher les Cisjordaniens de constituer un leadership politique pan-cisjordanien."
                            },
                            {
                                "example_id": "d47ae616-a54b-49e5-91a4-c094cf7fb01c",
                                "sense_id": "0d47eebd-e48e-3e74-82c4-05e30be5da63",
                                "text": "La circulation des marchandises est devenue difficile et coûteuse, les Cisjordaniens étant obligés d’emprunter une route plus longue et plus dangereuse (Wadi AI-Nar) pour passer du Nord au Sud et inversement."
                            }
                        ]
                    }
