                "senses": [
                    {
                        "sense_id": "d5f1f7c8-b485-3a2f-8390-ac06b9799ad8",
                        "entry_id": "0d0addcb-8088-3240-b6f1-836dae63bd80",
                        "glosses": [
                            "Ausbreitung der Germanen in vorchristlicher Zeit nach West- und Südeuropa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a81fac-4da4-4402-aa68-34362d156ce0",
                                "sense_id": "d5f1f7c8-b485-3a2f-8390-ac06b9799ad8",
                                "text": "„Bei den Arbeiten am Fundament stieß man auf mehrere kreisrunde Schächte verschiedener Tiefe, in denen sich Schutt und Tonscherben befanden, die wahrscheinlich aus der Zeit der Völkerwanderung stammten.“"
                            },
                            {
                                "example_id": "ad714ff3-b618-4031-8ce4-df08f97da496",
                                "sense_id": "d5f1f7c8-b485-3a2f-8390-ac06b9799ad8",
                                "text": "„Erst im Zuge der Völkerwanderung seien die Slawen gekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7028173-08b7-3dbd-b282-745c9d8b0997",
                        "entry_id": "0d0addcb-8088-3240-b6f1-836dae63bd80",
                        "glosses": [
                            "Auswanderung einer großen Anzahl von Menschen in Gebiete, aus denen sie nicht stammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6f4cfbd-ec92-4be3-b8ed-0be088915006",
                                "sense_id": "e7028173-08b7-3dbd-b282-745c9d8b0997",
                                "text": "„Längst ist von einer neuen, globalen Völkerwanderung die Rede.“"
                            },
                            {
                                "example_id": "c0f3c5b0-8721-43de-a524-cf72ea8c5b53",
                                "sense_id": "e7028173-08b7-3dbd-b282-745c9d8b0997",
                                "text": "„Es muss eine regelrechte Völkerwanderung der Jungen und Jüngsten gewesen sein.“"
                            },
                            {
                                "example_id": "eb794191-5dab-4392-bb1a-a0ee34dc14da",
                                "sense_id": "e7028173-08b7-3dbd-b282-745c9d8b0997",
                                "text": "„Riesige Heerscharen von Flüchtlingen, Verschleppten und Gefangenen bevölkerten in der größten Völkerwanderung der Neuzeit die Landstraßen, Besiegte wie Befreite.“"
                            },
                            {
                                "example_id": "a33cc57c-bc91-4a9c-b48f-b9216d2e0410",
                                "sense_id": "e7028173-08b7-3dbd-b282-745c9d8b0997",
                                "text": "„Es zeigt meine Großmutter als Schwesternschülerin gemeinsam mit Kolleginnen, ein Dutzend junger Mädchen mit so unterschiedlichem Aussehen, dass man in den Gesichtern von der Völkerwanderung lesen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
