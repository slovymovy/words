                "senses": [
                    {
                        "sense_id": "3af4a01c-55ff-300e-a685-3336dd4b5014",
                        "entry_id": "e5e20da6-c808-33d7-911e-c5a16588ac4c",
                        "glosses": [
                            "physikalisch-chemisches Trennverfahren, bei der das Probengemisch zwischen zwei nicht mischbaren Phasen separiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f23365d-9efe-4ae7-92d9-ad2b24d26ce4",
                                "sense_id": "3af4a01c-55ff-300e-a685-3336dd4b5014",
                                "text": "Für die Chromatographie sind die Herstellung des Flusses der mobilen Phase, die Injektion der zu trennenden Probe, die eigentliche Trennung und die Detektion nötig."
                            },
                            {
                                "example_id": "53262a7f-82c0-4e1f-9b19-ab6ad52a6a20",
                                "sense_id": "3af4a01c-55ff-300e-a685-3336dd4b5014",
                                "text": "Die Chromatographie ist zweifellos die in allen Wissenschaftsbereichen am häufigsten verwendete analytische Trennmethode."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac3db563-4613-4190-bb9e-9cb2896cb69b",
                        "source_entry_id": "e5e20da6-c808-33d7-911e-c5a16588ac4c",
                        "source_sense_id": "3af4a01c-55ff-300e-a685-3336dd4b5014",
                        "source_sense_description": "Trennverfahren, bei der das Probengemisch zwischen zwei nicht mischbaren Phasen separiert wird",
                        "target_lang_word": "chromatography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chromatography",
