                    {
                        "translation_id": "10ac25c3-fc1f-4dad-9644-b7af02fe5716",
                        "source_entry_id": "51221db4-7253-3b22-88a2-dfcef0a59109",
                        "source_sense_id": "c7efead0-3de5-3e3a-99bf-e1ecfd590e75",
                        "source_sense_description": "een bonus vanwege een specifieke situatie",
                        "target_lang_word": "Zuschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "(erhöhtes) Entgelt, das man für Sonderleistungen oder in bestimmten Situationen bezahlen muss oder bekommt"
                                        ],
                                        "tags": [
                                            "Finanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24ab3769-b15b-4be9-888b-32857597d6df",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag durch erhöhte Transportkosten wird laufend angepasst."
                                            },
                                            {
                                                "example_id": "9cf9d8ca-1d97-44fc-a97a-2010d8181340",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der Zuschlag für die Schnellzugverbindung kann auch beim Schaffner gelöst werden."
                                            },
                                            {
                                                "example_id": "65a17a1c-1780-4fba-985f-b252e478b9aa",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Der inoffizielle und illegale Zuschlag für Touristen beträgt mindestens 20 %."
                                            },
                                            {
                                                "example_id": "06f82a97-5a03-421a-a003-a9699e1fd300",
                                                "sense_id": "aa66d76c-bef4-3cc0-90eb-0a5a4cbe10aa",
                                                "text": "Die Zuschläge zum Arbeitslohn für Sonntags-, Feiertags- und Nachtarbeit bewegen sich zwischen 25 und 190 % und sind zusätzlich sozialversicherungsfrei und steuerfrei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Auftragserteilung, Geschäftsabschluss, Versteigerungsentscheidung (traditionell bzw. meist durch einen Schlag besiegelt)"
                                        ],
                                        "tags": [
                                            "Handel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46db6166-f5cd-4593-bbd3-947670495cd0",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Bei der Versteigerung erhielt ein telefonisches Angebot den Zuschlag."
                                            },
                                            {
                                                "example_id": "02e81db3-090c-432b-a24f-50b068efe20e",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "Nachdem Istanbul den Zuschlag erhalten hatte, hat Serhan Ada bei der Gestaltung des Kulturhauptstadt-Programmes mitgearbeitet."
                                            },
                                            {
                                                "example_id": "edcad24d-130c-4717-a142-7ac410d116f9",
                                                "sense_id": "b8e60380-4074-3a40-83db-e5a44e4d47f7",
                                                "text": "„Die Bundesnetzagentur hat den Zuschlag für den Bau von 79 neuen Windrädern erteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                        "entry_id": "6f4d7b83-2b0b-36b9-a792-03b763dfe006",
                                        "glosses": [
                                            "Zusätze bei Mischungen wie Legierungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b321258-316d-4606-af1a-aa80f9e48c62",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "Durch Zuschlag von Mangan soll Stahl widerstandsfähiger gemacht werden."
                                            },
                                            {
                                                "example_id": "d664f3b7-48f5-4370-9969-3c01f4dee5c5",
                                                "sense_id": "487eb97b-b751-3a91-9644-d2663b89b6a1",
                                                "text": "„Der Hochofen wird abwechselnd mit Koks und dem Gemisch aus Eisenerz und Zuschlägen, dem Möller, beschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0547f064-21dd-41de-b76c-3842fc3be916",
                        "source_entry_id": "51221db4-7253-3b22-88a2-dfcef0a59109",
                        "source_sense_id": "c7efead0-3de5-3e3a-99bf-e1ecfd590e75",
