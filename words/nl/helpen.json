                    "sense_id": "c35e882f-34c1-34d6-a03d-f0ab8828d438",
                    "sense_definition": "iemand bijstaan of ondersteunen bij een handeling of in een moeilijke situatie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ondersteuning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kan ik u ergens mee <w>helpen</w>?",
                            "target_lang_translations": {
                                "en": "Can I <w>help</w> you with anything?"
                            }
                        },
                        {
                            "text": "Mijn broer <w>helpt</w> me altijd met mijn huiswerk voor wiskunde.",
                            "target_lang_translations": {
                                "en": "My brother always <w>helps</w> me with my math homework."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijstaan",
                        "ondersteunen"
                    ],
                    "antonyms": [
                        "tegenwerken",
                        "hinderen"
                    ],
                    "common_phrases": [
                        "iemand helpen",
                        "mee helpen",
                        "graag helpen"
                    ],
                    "target_lang_definitions": {
                        "en": "to assist or support someone in an action or in a difficult situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "help",
                                "target_lang_sense_clarification": "to provide assistance"
                            },
                            {
                                "target_lang_word": "assist",
                                "target_lang_sense_clarification": "to help someone with a task"
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "to give emotional or practical aid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05ac29b-3e75-35a8-a8c0-f9f8fbe77151",
                    "sense_definition": "iemand aan iets helpen of iets voor iemand regelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voorzien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bedankt dat je mij aan dat truitje hebt <w>geholpen</w>!",
                            "target_lang_translations": {
                                "en": "Thanks for <w>helping</w> me get that sweater!"
                            }
                        },
                        {
                            "text": "De makelaar <w>hielp</w> ons aan een prachtig nieuw appartement in de stad.",
                            "target_lang_translations": {
                                "en": "The real estate agent <w>helped</w> us find a beautiful new apartment in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezorgen",
                        "verschaffen"
                    ],
                    "common_phrases": [
                        "iemand aan iets helpen"
                    ],
                    "target_lang_definitions": {
                        "en": "to help someone obtain something or to arrange something for someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to help someone obtain something"
                            },
                            {
                                "target_lang_word": "provide",
                                "target_lang_sense_clarification": "to supply or arrange something for someone"
                            },
                            {
                                "target_lang_word": "set up with",
                                "target_lang_sense_clarification": "to provide someone with something needed"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd0e906f-57e2-3ba8-b08f-fb2051235f07",
                    "sense_definition": "iemand verslaafd maken of ergens ongewenst afhankelijk van maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "negatieve_invloed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die vriendengroep had haar aan de drank <w>geholpen</w>.",
                            "target_lang_translations": {
                                "en": "That group of friends had <w>gotten</w> her hooked on alcohol."
                            }
                        },
                        {
                            "text": "Het is triest hoe hij zijn broer aan de drugs heeft <w>geholpen</w>.",
                            "target_lang_translations": {
                                "en": "It is sad how he <w>got</w> his brother onto drugs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aan de drank helpen",
                        "aan de drugs helpen"
                    ],
                    "target_lang_definitions": {
                        "en": "to cause someone to become addicted or undesirably dependent on something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get someone hooked",
                                "target_lang_sense_clarification": "to cause an addiction"
                            },
                            {
                                "target_lang_word": "get someone onto",
                                "target_lang_sense_clarification": "to introduce someone to a harmful substance"
                            }
                        ]
                    }
                }
