                    },
                    {
                        "translation_id": "019af349-7478-4f8f-86bb-c204809bf2a3",
                        "source_entry_id": "0fae09dc-2ab0-3b29-9289-2cc212535d2e",
                        "source_sense_id": "f7a28f26-2fc4-335b-b230-994fb70410d8",
                        "source_sense_description": "study of algae",
                        "target_lang_word": "phycologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phycologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fd599aa-37eb-3843-a124-456f08732adf",
                                        "entry_id": "db5af684-6da8-3069-9913-30dd1b48beba",
                                        "glosses": [
                                            "Science consacrée à l'étude des algues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4057e8d3-7bcb-4a19-ba61-e5a941181405",
                                                "sense_id": "9fd599aa-37eb-3843-a124-456f08732adf",
                                                "text": "Algologie et algologue sont deux mots hybrides et barbares qui finiront par disparaître un jour des ouvrages de botanique, et seront remplacés par ceux plus corrects de Phycologie et phycologiste …."
                                            },
                                            {
                                                "example_id": "69991306-61fd-492e-9f84-bbb1fcd7dd44",
                                                "sense_id": "9fd599aa-37eb-3843-a124-456f08732adf",
                                                "text": "Notre collection de phycologie (CANA) compte 26 640 spécimens. Plus de 300 d’entre eux sont des spécimens types. … Les diatomées forment à peu près les deux tiers de la collection, mais tous les types d'algues y sont représentés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c923bd-9765-4d5e-80a0-523c4a79d042",
                        "source_entry_id": "0fae09dc-2ab0-3b29-9289-2cc212535d2e",
                        "source_sense_id": "f7a28f26-2fc4-335b-b230-994fb70410d8",
                        "source_sense_description": "study of algae",
                        "target_lang_word": "algologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a83dfc29-f749-3148-8271-bf3015ff01f7",
                                        "entry_id": "ed52c2b4-e175-3c42-849f-ac7ea5d470bd",
                                        "glosses": [
                                            "Étude de la douleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ed83d-1d5d-431d-b5d4-514b0efbae90",
                                                "sense_id": "a83dfc29-f749-3148-8271-bf3015ff01f7",
                                                "text": "Cette prise en charge présente deux axes : un premier non spécifique qui doit être assuré dès la consultation d’algologie et quel que soit le type de douleur."
                                            },
                                            {
                                                "example_id": "7a1a24c1-a250-4c98-ade7-78d617522e2a",
                                                "sense_id": "a83dfc29-f749-3148-8271-bf3015ff01f7",
                                                "text": "Nous n'avons jamais fait l'effort de comprendre un tant soit peu les algues. En témoigne jusqu'au terme d'algologie, forgé pour désigner leur étude mais désignant également la branche de la médecine qui traite de la douleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "algologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf0d9c5c-e5ba-34df-a882-a90c89d377ed",
                                        "entry_id": "26f83816-a169-3170-aa83-e0c1fec900cd",
                                        "glosses": [
                                            "Phycologie, étude des algues."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45acd43c-e285-4393-bfb6-34947a3cafee",
                                                "sense_id": "cf0d9c5c-e5ba-34df-a882-a90c89d377ed",
                                                "text": "Voici un nouveau traité d’algologie d’une conception bien différente des livres classiques et même des ouvrages récents sur les algues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54933b48-4e19-43ef-b4d6-4224057d7bb1",
                        "source_entry_id": "0fae09dc-2ab0-3b29-9289-2cc212535d2e",
                        "source_sense_id": "f7a28f26-2fc4-335b-b230-994fb70410d8",
                        "source_sense_description": "study of algae",
                        "target_lang_word": "Phykologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phykologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab207aa8-123f-3b77-ad71-1c81f320e020",
                                        "entry_id": "b12ffefa-6dfd-321c-a6cd-48c38f0bb97d",
                                        "glosses": [
                                            "Wissenschaft von den Algen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c11c9a-24da-4b36-80a5-0df1e6295eb9",
                                                "sense_id": "ab207aa8-123f-3b77-ad71-1c81f320e020",
                                                "text": "„Im Jahre 1843 erschien eine Arbeit von Lamouroux, worin dieser Gelehrte, den man als den Vater der Phykologie betrachten kann, die ersten Grundsteine einer neuen Klassification der Algen legte, während sie bis dahin nur nach sehr unvollkommener, eigentlich aber gar keiner, Methode von seinen Vorgängern klassificirt worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e5517cd-2537-45b7-a795-fb91928a624c",
