                        "cross_references": [
                            {
                                "target_word": "kiełbasa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                        "entry_id": "86cab037-6c21-35c5-bd2b-e600ee084bfa",
                                        "glosses": [
                                            "Alternative form of kielbasa."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5addb3c-8437-4582-9109-95ea1658d0e9",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "Polish music, the Polish language, a display of photographs from the President’s trip to Poland and, of course, an array of Polish foods such as: kiełbasa, pierogi,[…]"
                                            },
                                            {
                                                "example_id": "95aa3de3-4d71-4351-a8be-aeda464a9421",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "Bring the sauce to a boil and into it place the kiełbasa, cut into pieces diagonally. The kiełbasa may also be served in a spicily seasoned onion or tomato sauce."
                                            },
                                            {
                                                "example_id": "988b170b-b6b6-4f6e-8657-926c7ef58b9b",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "The food is good and inexpensive, and includes daily specials like kiełbasa, pierogi, and gołąbki."
                                            },
                                            {
                                                "example_id": "40df4161-636f-437d-86e7-9bb5b2a99b33",
                                                "sense_id": "2ea5dd7d-b6c3-31b6-aaa2-b642b568275c",
                                                "text": "What would be a typical Polish meal? Around these parts Polish people say it is gołąbki, pierogi and kiełbasa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "183d8fa7-50e7-49e9-9644-f48816349fd1",
                        "source_entry_id": "e5e8b5b2-261c-3d08-a17e-7b775af2d266",
                        "source_sense_id": "95e817e7-9e76-3638-a0ae-a4b4b90829eb",
                        "target_lang_word": "kielbasa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kielbasa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64fac888-84ac-3fad-b401-5a3b1d4434de",
                                        "entry_id": "ad8528ce-361c-3b2e-83dd-f0aab45dbe61",
                                        "glosses": [
                                            "A spicy, smoked sausage of a particular kind from Eastern Europe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0824b15-999e-4b51-8a9d-0eec8881c0e4",
                                                "sense_id": "64fac888-84ac-3fad-b401-5a3b1d4434de",
                                                "text": "Congressmen gleefully wolfed down every imaginable version of the hot dog – smoked kielbasas, jumbo grillers, Big & Juicy's, kosher dogs and spiced dogs […]"
                                            },
                                            {
                                                "example_id": "29224c57-8fd9-48fc-8cde-438b9962970a",
                                                "sense_id": "64fac888-84ac-3fad-b401-5a3b1d4434de",
                                                "text": "Heritage Foods now offers linguiça from the sausage maker the Mayor, in Richmond, Va. The signature Portuguese sausage harbors the paprika spice of chorizo but with the fire dampened, and a finer texture, but it brings on the garlic like kielbasa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393babc7-9481-346c-9f86-1ef6bbe15265",
                                        "entry_id": "ad8528ce-361c-3b2e-83dd-f0aab45dbe61",
                                        "glosses": [
                                            "Penis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73adc8d2-03ad-46e0-8c10-5c695f474bb7",
                                                "sense_id": "393babc7-9481-346c-9f86-1ef6bbe15265",
                                                "text": "Eric Andre: Do you think God's got a cooter or a big-ass kielbasa?\nQuincy: He's got it all.\nEric Andre: That's gross."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
