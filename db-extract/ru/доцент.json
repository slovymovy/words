                                        "glosses": [
                                            "A person who gives lectures, especially as a profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24b40681-ccc9-4064-90b4-147892c5b91a",
                                                "sense_id": "a4f94348-6462-3dfd-8ad9-628ddc9ab50c",
                                                "text": "The lecturers are expert on lecturing on the subject, but they offer the splatterdash method of disseminating information with no point of view of their own."
                                            },
                                            {
                                                "example_id": "83b5d58a-b989-4d97-bf18-582a85ac6519",
                                                "sense_id": "a4f94348-6462-3dfd-8ad9-628ddc9ab50c",
                                                "text": "Mr. Abel, who lives in Westport, Conn., has earned his bread as a writer and lecturer on problem-solving tactics, and he has earned a reputation as a duke of dupery since 1959, when he masterminded the Society for Indecency to Naked Animals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343ece38-4007-3300-9775-5f87807b8394",
                                        "entry_id": "f8610418-05d0-3923-bec3-dabf5cbfca9a",
                                        "glosses": [
                                            "A member of a university or college below the rank of assistant professor or reader; docent; lector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5166cb46-8606-3703-882c-5bc0e1b24ecb",
                                        "entry_id": "f8610418-05d0-3923-bec3-dabf5cbfca9a",
                                        "glosses": [
