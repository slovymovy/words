                            {
                                "target_lang_word": "отношения",
                                "target_lang_sense_clarification": "социальные контакты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2ae8924-03f1-3b63-95ed-bd1d1d681c1b",
                    "sense_definition": "A knot or something used to fasten or hold things together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a small <w>tie</w> to keep the cables organized behind the desk.",
                            "target_lang_translations": {
                                "ru": "Она использовала маленькую <w>стяжку</w>, чтобы упорядочить кабели за столом."
                            }
                        },
                        {
                            "text": "Make sure the <w>tie</w> is secure so the bag doesn't open.",
                            "target_lang_translations": {
                                "ru": "Убедись, что <w>завязка</w> надежна, чтобы мешок не открылся."
                            }
                        }
                    ],
                    "common_phrases": [
                        "twist tie",
                        "cable tie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Узел или приспособление, используемое для скрепления или удержания вещей вместе."
                    },
                    "translations": {
