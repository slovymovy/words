                                "target_senses": [
                                    {
                                        "sense_id": "4594a26b-a9da-3059-9b54-d6ed2e4c37ba",
                                        "entry_id": "d48f31b7-861b-35eb-8b28-a759ef042b2c",
                                        "glosses": [
                                            "een hooggebleven of omhooggedreven stuk land omgeven door afgeschoven slenken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c3b39e-d020-4c26-a471-01b7f6bfab29",
                                                "sense_id": "4594a26b-a9da-3059-9b54-d6ed2e4c37ba",
                                                "text": "Deze horsten bestaan uit continentaal materiaal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ffd05b-3692-377a-900a-5527cdd908fc",
                                        "entry_id": "d48f31b7-861b-35eb-8b28-a759ef042b2c",
                                        "glosses": [
                                            "het nest van een roofvogel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf5bd6c0-dbfc-425d-803d-3799b438f4a1",
                                                "sense_id": "e9ffd05b-3692-377a-900a-5527cdd908fc",
                                                "text": "Een havik heeft daar zijn horst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
