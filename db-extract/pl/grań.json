                    {
                        "sense_id": "c3e421e7-bcc1-3c53-912b-16c7d8c96816",
                        "entry_id": "28149e1f-cea3-3fc6-8530-51319fd6522b",
                        "glosses": [
                            "grzbiet górski o bardzo stromych zboczach, zwykle wąski i skalisty"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07536f7c-dd79-4133-a757-ea6087a72147",
                                "sense_id": "c3e421e7-bcc1-3c53-912b-16c7d8c96816",
                                "text": "Koledzy szykują się do zimowego przejścia grani Tatr Zachodnich."
                            },
                            {
                                "example_id": "18f3f2d9-b6e6-4b44-a820-b33a76a840ee",
                                "sense_id": "c3e421e7-bcc1-3c53-912b-16c7d8c96816",
                                "text": "(…) widzicie tę grań, tu o pięćdziesiąt metrów niżej poczynającą się u stóp urwistej ściany?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eb2d021e-cc7f-3191-a3cf-4eb7e19b17af",
                        "entry_id": "28149e1f-cea3-3fc6-8530-51319fd6522b",
                        "glosses": [
                            "ostre zetknięcie się ścian lub innych płaszczyzn"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d1bbb256-eeb9-4161-a8d5-3785f1b1f91e",
                                "sense_id": "eb2d021e-cc7f-3191-a3cf-4eb7e19b17af",
                                "text": "Lira mi pękła na grani ołtarza,"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "754bff78-0716-32e6-9b7d-79910d9a3875",
