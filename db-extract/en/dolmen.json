                                        "entry_id": "13e22f03-022f-37f0-a6c5-c4340260ae3e",
                                        "glosses": [
                                            "prehistoryczna budowla megalityczna o charakterze grobowca, składająca się z głazów wkopanych pionowo w ziemię i wielkiego płaskiego bloku skalnego, który był na nich ułożony"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f8c571-49f8-4506-891f-836360745f44",
                                                "sense_id": "65b1d48c-1f7b-3677-9909-be6083743b8d",
                                                "text": "W rozwoju grobów megalitycznych kultur nadmorskich najstarszą forma jest dolmen, złożony z samych kamieni bocznych, ustawionych na powierzchni i przykrytych wspólną płytą."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
