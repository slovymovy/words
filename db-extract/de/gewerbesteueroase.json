                ],
                "senses": [
                    {
                        "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                        "entry_id": "934b2da4-349b-3e35-815c-112b9de6fd2c",
                        "glosses": [
                            "Gemeinde/Kommune, die einen möglichst niedrigen Gewerbesteuersatz festlegt und dadurch Unternehmen mit Sitz in Gemeinden mit durchschnittlichen oder hohen Gewerbesteuersätzen zum Betriebssitzwechsel in die Gewerbesteueroase veranlasst"
                        ],
                        "tags": [
                            "Steuern"
                        ],
                        "examples": [
                            {
                                "example_id": "e9ebcd95-4132-4530-a7f7-3ebfb93f254a",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Die Falke-Gruppe unterhält offenbar in einer deutschen Gewerbesteueroase Briefkastenfirmen für die Sockenmarke Burlington.“"
                            },
                            {
                                "example_id": "b23f0d19-9b70-4eb5-ba82-7a71202b7889",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "[…] \"»Die Gewerbesteueroasen sind genauso wie die internationalen Oasen ein Ort für Steuerflucht.«\""
                            },
                            {
                                "example_id": "479fc4d5-fba2-427e-a766-3db2ba27aeba",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Die Bürgermeisterin von Zossen, Wiebke Schwarzweller, weist den Vorwurf zurück, ihre Stadt sei eine \"Gewerbesteueroase\" und betreibe \"unfairen Wettbewerb\".“"
                            },
                            {
                                "example_id": "3e828252-0f3c-4b59-984f-93e534100837",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„In Grünwald gibt es inzwischen fast so viele Firmen wie Einwohner. Und die bayerische Kleinstadt ist längst nicht die einzige Gewerbesteueroase in Deutschland.“"
                            },
                            {
                                "example_id": "024e9418-af55-4201-a4b8-07dff2f0526e",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "[Schlagzeile:] „Gewerbesteueroase – Grünwald, bitte zahlen“"
                            },
                            {
                                "example_id": "6702911b-cb05-4f2b-87e7-18a248525558",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Bislang unbekannte Ermittlungen im Skandal um das NRW-Landesarchiv in Duisburg könnten zum bundesweiten Präzedenzfall für Gewerbesteueroasen werden.“"
                            },
                            {
                                "example_id": "603c545d-4bb8-4d28-94dc-dc935853f479",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Eine Betriebsstätte, die nur zum Schein in einer \"Gewerbesteueroase\" angemeldet wird, könnte dagegen gegen das Gesetz verstoßen.“"
                            },
                            {
                                "example_id": "31e38736-02c0-4a19-80b3-ea7112fab35d",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Seit 2004 beträgt der Hebesatz gemäß § 16 Abs. 4 Satz 2 GewStG mindestens 200 %. Damit will der Gesetzgeber sog. Gewerbesteueroasen (zum Beispiel Norderfriedrichskoog, welches lange Zeit einen Hebesatz von Null hatte) verhindern.“"
                            },
                            {
                                "example_id": "232027d9-78ad-4352-8905-a44eb4951a9b",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Gewerbesteueroasen waren dem Bund und auch den Ländern ein Dorn im Auge, seit 2004 ist ein Mindesthebesatz von 200 Prozent vorgeschrieben.“"
                            },
                            {
                                "example_id": "d43afdf0-8901-43b0-8892-710281b4f522",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "[Die Kleinstadt Monheim am Rhein arbeitet seit einigen Jahren] „an ihrem Ruf als Kulturstadt. Möglich machen das sprudelnde Einnahmen einer Gewerbesteueroase.“"
                            },
                            {
                                "example_id": "86c949df-2714-4df3-acaa-1299378f0bcc",
                                "sense_id": "140e0c76-547d-3576-bf60-4519c00f6d5e",
                                "text": "„Eine weitere Gestaltung zur Reduzierung der Gewerbesteuerbelastung kann in der Zwischenschaltung einer Gesellschaft in einer nationalen Gewerbesteueroase bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
