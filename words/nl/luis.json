        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a2041f9-eec9-3a09-b8d3-50cbb227c885",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>luizen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>luis</w> hem erin met een slimme list.",
                            "target_lang_translations": {
                                "en": "I <w>trick</w> him into it with a clever ruse.",
                                "ru": "Я <w>подставляю</w> его с помощью хитрой уловки.",
                                "fr": "Je le <w>piège</w> avec une ruse intelligente."
                            }
                        },
                        {
                            "text": "Als ik de hond <w>luis</w>, vind ik hopelijk geen parasieten.",
                            "target_lang_translations": {
                                "en": "When I <w>delouse</w> the dog, I hope I won't find any parasites.",
                                "ru": "Когда я <w>вычесываю вшей</w> у собаки, я надеюсь, что не найду паразитов.",
                                "fr": "Quand j'<w>épouille</w> le chien, j'espère ne trouver aucun parasite."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'to delouse' or 'to frame'.",
                        "ru": "1-е лицо единственного числа настоящего времени от глагола «luizen» (искать вшей или подставлять).",
                        "fr": "Première personne du singulier du présent de l'indicatif de 'épouiller' ou 'piéger'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "delouse",
                                "target_lang_sense_clarification": "remove lice"
