                "senses": [
                    {
                        "sense_id": "b5668e80-de8c-3fb0-83e0-4513cc9c88bd",
                        "entry_id": "e69d916a-d1a7-3609-b4d4-78b106be3501",
                        "glosses": [
                            "Faire perdre son caractère cisaillé à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017b4d7e-a1bb-4783-9756-c06c87061c95",
                                "sense_id": "b5668e80-de8c-3fb0-83e0-4513cc9c88bd",
                                "text": "Il resterait à tenter, par méthode de rétrotectonique, de “ décisailler ” cet écheveau de failles, pour reconstituer la paléogéographie originelle ; mais est-ce bien réaliste ?"
                            },
                            {
                                "example_id": "ca9133bd-ba9f-4adc-9fb0-970a03c370c1",
                                "sense_id": "b5668e80-de8c-3fb0-83e0-4513cc9c88bd",
                                "text": "Pour décisailler, la fonction GetDups, compare les deux champs des images capturées en entrelacé afin de décider si une image de la capture numérique correspond à une image pleine ou un mélange de deux images du film original en 8 mm ou S8."
                            },
                            {
                                "example_id": "b129adbb-2c12-4500-b08e-daab0d701451",
                                "sense_id": "b5668e80-de8c-3fb0-83e0-4513cc9c88bd",
                                "text": "Fichier décisaillé : 93 images toutes bonnes sans cisaillement et sans aucun double"
                            }
                        ]
                    },
                    {
                        "sense_id": "5208c646-fe62-3390-848f-6b2ea5e70e0a",
                        "entry_id": "e69d916a-d1a7-3609-b4d4-78b106be3501",
                        "glosses": [
                            "Cisailler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7021c879-a587-43ea-875c-f87109799a47",
                                "sense_id": "5208c646-fe62-3390-848f-6b2ea5e70e0a",
                                "text": "J’ peux leur casser la gueule, Mimi, si tu veux, dit Ti-Paul à Mimi et Ti-Paul est ben bâti, quasiment comme une armoire ancienne, je m’y connais dans l’ massacre, chus dans l’découpage d’la viande toute la journée et y a des jours que j’ me demande pourquoi que c’est pas la ventripaille des gens que je décisaille pas en p’tits morceaux pour la suspendre au clou de fer !"
                            }
                        ]
                    }
