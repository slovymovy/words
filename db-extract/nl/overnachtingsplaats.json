                    {
                        "translation_id": "2b09289f-1cae-4b0f-b6b0-e3ef662b36b0",
                        "source_entry_id": "4c7d9ce6-1353-330f-93c8-a1ea0db7b289",
                        "source_sense_id": "a9a52d70-1a69-3a0b-ab82-14b31d9793b3",
                        "target_lang_word": "stadium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stadium",
