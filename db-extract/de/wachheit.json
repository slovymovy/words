                                        "examples": [
                                            {
                                                "example_id": "a572f65b-b551-42bb-91da-df274fa3be50",
                                                "sense_id": "b2953c7b-11a6-392c-b50c-692edb1c3103",
                                                "text": "\"I sat up in bed with that feeling of broad awakeness and alertness which comes to us sometimes, and caught my breath as I listened, for through the stillness of the night came the unmistakable sound of a gentle tapping from behind the paneling of the wall."
                                            },
                                            {
                                                "example_id": "01916eff-2c37-4ce5-9070-5e012dd617eb",
                                                "sense_id": "b2953c7b-11a6-392c-b50c-692edb1c3103",
                                                "text": "The kind of awakeness that allows you to be appropriate to whatever moment you're in."
                                            },
                                            {
                                                "example_id": "0c51c6b0-b0d2-428e-849f-d284f997baf4",
                                                "sense_id": "b2953c7b-11a6-392c-b50c-692edb1c3103",
                                                "text": "By that measure, Nehlig's team found, the brain activity of animals given caffeine rose in brain regions involved in locomotion, mood, and awakeness."
                                            }
                                        ]
                                    }
