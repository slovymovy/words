                        "form": "die Ägyptologen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                        "entry_id": "c8109e84-3f1c-39ce-87dd-1bee07783ff3",
                        "glosses": [
                            "Fachmann beziehungsweise Wissenschaftler auf dem Gebiet der Ägyptologie, der Erforschung des Alten Ägyptens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9550fe48-6dc3-48cd-a70c-df4e39ad358d",
                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                "text": "„Ich war auch bei der Ankunft in bester Stimmung, durch ein Gespräch, das ich in letzter Minute mit einem Ägyptologen gehabt hatte, der bei uns als Nachtbote arbeiten wollte.“"
                            },
                            {
                                "example_id": "992e1172-bfcf-4834-ac8c-96dead051be1",
                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                "text": "„Auch an der Universität Wien blickt die Afrikanistik auf eine große Tradition zurück, die 1873 mit dem Ägyptologen Leo Reinisch einsetzte.“"
                            },
                            {
                                "example_id": "4eefdf51-be49-4c1a-be99-33e7ec374728",
                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                "text": "„Als erster ließ er mit Hilfe von Ägyptologen Stempel für Hieroglyphen schneiden, ca. 1500 Zeichen - ein deutlicher Impuls für die Ägyptologie.“"
                            },
                            {
                                "example_id": "acfeb149-1bc1-44de-8aee-8491c4720d68",
                                "sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                                "text": "„Diesmal hat der Schreiber kein Mitleid mit ungeübten Ägyptologen und stellt uns ein Bein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "481354c6-7cc0-4866-87ea-9e83b241467b",
                        "source_entry_id": "c8109e84-3f1c-39ce-87dd-1bee07783ff3",
                        "source_sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                        "target_lang_word": "Egyptologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Egyptologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc57d2c7-40ba-3693-919d-a4efba47287f",
                                        "entry_id": "d123b27e-0232-3cb2-9196-cd5b6b0c351c",
                                        "glosses": [
                                            "A person; one who is skilled in or professes or practices Egyptology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2adf24d5-2592-4e82-96dc-0403d5704b97",
                                                "sense_id": "fc57d2c7-40ba-3693-919d-a4efba47287f",
                                                "text": "An Egyptologist's mind immediately turns to the ancient Egyptian counterpart to such an imagined protosactuary: a reed hut that all late Egyptian temples, in their archaizing longing to return to the origins, sought to emulate in stone through the typically Egyptian temple features of inward-sloping walls, torus and corvetto cornice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6f0b9dc-4208-4c26-9a55-94d3f96b77c7",
                        "source_entry_id": "c8109e84-3f1c-39ce-87dd-1bee07783ff3",
                        "source_sense_id": "bedc02a1-a098-3501-a5de-84686c04c54c",
                        "target_lang_word": "égyptologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égyptologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                        "entry_id": "5c266a2a-78b9-3b3a-bb46-10b07d85a798",
                                        "glosses": [
                                            "Archéologue spécialisé en égyptologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05cb8b0-df76-4614-a56d-181b9b606f8d",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Dominique Farout, égyptologue et commissaire français de la rétrospective de 2023, y était."
                                            },
                                            {
                                                "example_id": "a2a0d82a-c8bd-4267-b7c4-b0f8c4bfadd5",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Je vais ajouter ici quelques autres considérations de l’égyptologue français relatives à ces éléments."
                                            },
                                            {
                                                "example_id": "b7863d93-4026-480f-aaa5-88110d5bc0f6",
                                                "sense_id": "27fc9ab7-a457-3d57-a39c-7402a20257fa",
                                                "text": "Selon l’égyptologue biomédicale Sofia Aziz, le souverain égyptien aurait perdu la vie dans un accident de char dû à une conduite sous l’emprise de l’alcool."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
