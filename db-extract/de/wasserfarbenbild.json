                "senses": [
                    {
                        "sense_id": "a1ec16f0-2dd2-3619-8862-c7d3e3e3618f",
                        "entry_id": "9c1ad89f-c39a-3d47-a064-476b1a2c0530",
                        "glosses": [
                            "mit Hilfe von Wasserfarben kreiertes Bild"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "765bb2af-fea3-470f-9040-f7d7b3405e59",
                                "sense_id": "a1ec16f0-2dd2-3619-8862-c7d3e3e3618f",
                                "text": "„Auf dem Dachboden der Familie stapeln sich seither Ölkreide-Zeichnungen, Wasserfarbenbilder und Ölgemälde von Karl Eschmann, der von 1953 bis 1970 im Bauordnungsamt der Stadt als Farbenfachmann arbeitete und in seiner Freizeit malte, was das Zeug hielt.“"
                            },
                            {
                                "example_id": "3b484b51-88b6-4a09-a846-1191766e5dbe",
                                "sense_id": "a1ec16f0-2dd2-3619-8862-c7d3e3e3618f",
                                "text": "„In der Diele hing das gerahmte Wasserfarbenbild einer Ente mit Schal und einem großen Schlapphut auf dem Kopf.“"
                            },
                            {
                                "example_id": "8fb9961e-dbf3-402b-a973-8fa9b1913eb3",
                                "sense_id": "a1ec16f0-2dd2-3619-8862-c7d3e3e3618f",
                                "text": "„Der Abend verwischte in ihrer Erinnerung wie ein Wasserfarbenbild.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
