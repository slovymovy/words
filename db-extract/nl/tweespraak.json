                                        "examples": [
                                            {
                                                "example_id": "7c56bef1-3ac9-425f-ad66-39418ef0d7d2",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "Gone now are the \"high-minded\" style, the \"adapted from literature\" feel, the voice-over narration, and the abstract conversationing about ideas, values..."
                                            },
                                            {
                                                "example_id": "fb9f2a69-892d-44de-be7c-4d90947bcf0a",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "...he has breakfasted me, dined me, conversationed me, absolutely caressed me. He has been really most kind and paternal..."
                                            },
                                            {
                                                "example_id": "185f9472-e987-46b0-9dea-f4194da76f23",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "After all this conversationing, Scottie, my usual dance partner, was getting antsy and wanted to dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
