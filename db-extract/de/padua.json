                                "sense_id": "e31c9c0c-3122-3451-afe0-bb6dcb5e2b94",
                                "text": "„Mehr noch: Erinnerungen lassen sich durch manipulierte Fotos nachträglich modifizieren, wie die amerikanische Psychologieprofessorin Elizabeth Loftus in einem Experiment mit Studenten an der Universität Padua nachwies.“"
                            },
                            {
                                "example_id": "9ae0e488-c07f-44fc-b2ba-69693369f813",
                                "sense_id": "e31c9c0c-3122-3451-afe0-bb6dcb5e2b94",
                                "text": "„Die Universität Padua aber hatte Weltruf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
