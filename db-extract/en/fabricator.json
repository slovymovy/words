                    {
                        "sense_id": "36766aa0-952e-311f-9b05-cbd24426bc53",
                        "entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
                        "glosses": [
                            "A person who fabricates or manufactures something; a manufacturer"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0b3757b6-2e44-3777-972b-375ed9bc2728",
                        "entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
                        "glosses": [
                            "A person who makes a fabrication of something; a counterfeiter or falsifier"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95d4c413-9da8-4ac4-851d-6b91a735bf56",
                        "source_entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
                        "source_sense_description": "person who fabricates or manufactures",
                        "target_lang_word": "fabricant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabricant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                        "entry_id": "5ee9507e-f5b1-34f4-aa6e-1bd11a6c06ee",
                                        "glosses": [
                                            "Industriel ou artisan qui fabrique ou qui fait fabriquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fb0542-6f5f-494f-81d6-2a53fd42ca7a",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si les fabricants vantent ses propriétés anxiolytiques, anti-inflammatoires, neuroprotectrices et antalgiques, l’association invite à en nuancer la fiabilité."
                                            },
                                            {
                                                "example_id": "1bca39d3-5f00-4c2a-acd1-99f34951da42",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si l’Allemagne n’a point conquis encore la place qui devrait lui revenir dans le monde économique […], cela tient à ce que, pendant longtemps, ses fabricants crurent qu'il était habile d’inonder le marché avec de la camelote ; bien que la production allemande se soit fort améliorée depuis quelques années, elle ne jouit point encore d’une très haute considération."
                                            },
                                            {
                                                "example_id": "41b82e74-c6c3-4c77-ba5e-431dc79455ac",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Les docteurs du Talmud ne donnaient-ils pas eux-mêmes l'exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d'épingles, etc. ?"
                                            },
                                            {
                                                "example_id": "c5fc0ff8-2dd4-40b1-bb53-ed67da2edbd7",
                                                "sense_id": "9d151483-36f9-3a99-9877-71e36fe84a0b",
                                                "text": "Si j'étais fabricant de gilets en Kevlar, j'aurais peut-être envie de faire appel à un arachnologue, autrement dit à un spécialiste des araignées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d01e48d-225d-43a4-b2f4-57e57299cfab",
                        "source_entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
                        "source_sense_description": "person who fabricates or manufactures",
                        "target_lang_word": "fabricante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabricante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "395ccc3a-6dee-3556-8d71-7fb98d000829",
                                        "entry_id": "62eb394a-889e-3252-84a8-68a2ceb247d5",
                                        "glosses": [
                                            "Industrielle ou artisane qui fabrique ou qui fait fabriquer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0db40e-cfc7-4b7f-9bd8-e18a6db479d2",
                                                "sense_id": "395ccc3a-6dee-3556-8d71-7fb98d000829",
                                                "text": "Une ancienne fabricante de camembert qui a dirigé une fromagerie dans les années 1930 m’a donné sa version des origines du camembert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da7e6fa8-52e1-4726-906b-d8c717ecef44",
                        "source_entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
                        "source_sense_description": "counterfeiter or falsifier",
                        "target_lang_word": "fabricateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fabricateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3d8e5aa-0d29-3bdf-a9a8-f07ff84e4fe4",
                                        "entry_id": "f0a66178-bf31-3e38-9945-b34a8c5211ef",
                                        "glosses": [
                                            "Celui qui confectionne quelque chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214259a4-c0fb-39ea-ae47-617c847c07d7",
                                        "entry_id": "f0a66178-bf31-3e38-9945-b34a8c5211ef",
                                        "glosses": [
                                            "Celui qui produit une œuvre intellectuelle ou artistique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6402899f-f4ae-337c-9dfd-2bc7d660ff06",
                                        "entry_id": "f0a66178-bf31-3e38-9945-b34a8c5211ef",
                                        "glosses": [
                                            "Celui qui produit un objet de mauvaise qualité, une pensée trompeuse (à la différence de fabricant, terme neutre)."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94aced1c-c34e-43fe-86d8-aae8488c9263",
                                                "sense_id": "6402899f-f4ae-337c-9dfd-2bc7d660ff06",
                                                "text": "Fabricateur de fausse monnaie."
                                            },
                                            {
                                                "example_id": "2d5cd5b9-3201-4085-ac82-b0796081e6b7",
                                                "sense_id": "6402899f-f4ae-337c-9dfd-2bc7d660ff06",
                                                "text": "Fabricateur de faux billets de banque."
                                            },
                                            {
                                                "example_id": "20e21c70-f9da-44f3-9485-42757632c8ce",
                                                "sense_id": "6402899f-f4ae-337c-9dfd-2bc7d660ff06",
                                                "text": "Fabricateur de fausses nouvelles."
                                            },
                                            {
                                                "example_id": "f23c299a-d328-4565-8ea6-9f0b49444db8",
                                                "sense_id": "6402899f-f4ae-337c-9dfd-2bc7d660ff06",
                                                "text": "Non, je ne suis pas de ces amants en imagination, fabricateurs de beauté, artisans de bonté, doreurs d’idéal, démiurges de la félicité. La réalité, moi, je la connais ; pis même, je la suspecte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b3b01eb-2523-40ef-bf70-b6a4b3751686",
                        "source_entry_id": "e10bea1e-4423-394c-b23a-6f2d5da267bc",
