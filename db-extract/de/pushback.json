                "senses": [
                    {
                        "sense_id": "cfd8c78c-e7b7-37da-8971-181e4dec0e6c",
                        "entry_id": "94377d63-e767-3cf9-99bf-737a9c2037eb",
                        "glosses": [
                            "pushback (summary expulsion of asylum seekers)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "85f31c1e-fff1-4482-b7eb-1bc93e80b4ca",
                                "sense_id": "cfd8c78c-e7b7-37da-8971-181e4dec0e6c",
                                "text": "Im Mittelmeer verhalten wir uns großzügig bei Pushbacks. Die deutsche Bundespolizei bildet saudi-arabische Grenzschützer nahe dem Jemen aus, damit sie auf äthiopische Geflüchtete schießen lernen. Was sollen wir denn noch tun?“"
                            },
                            {
                                "example_id": "c541e90f-5c8a-4510-8e68-508646d6ae30",
                                "sense_id": "cfd8c78c-e7b7-37da-8971-181e4dec0e6c",
                                "text": "Nicht mal die hochgerüsteten EU-Außengrenzen in Griechenland samt brutaler Pushbacks oder die hohen Todeszahlen auf dem Mittelmeer sorgen dafür, dass weniger Geflüchtete kommen."
                            }
                        ]
                    }
