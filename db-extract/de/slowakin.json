                                            {
                                                "example_id": "ef635476-57d0-4c7f-9797-0a36afa0bc80",
                                                "sense_id": "5a9476a7-827a-38af-bf48-e389c9ad90b3",
                                                "text": "Les Magyars ne surent même pas défendre les Slovaques contre l’invasion étrangère. En 1244, ils furent écrasés par mes Mongols qui se répandirent sur le pays."
                                            },
                                            {
                                                "example_id": "764d084c-826a-44db-9671-646bec96bf36",
                                                "sense_id": "5a9476a7-827a-38af-bf48-e389c9ad90b3",
                                                "text": "La première femme de Papa était une gadji – une Slovaque. Elle provenait d'une famille extrêmement pauvre qui comptait quatre sœurs et un frère."
                                            }
                                        ]
