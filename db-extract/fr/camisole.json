            {
                "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                "word": "camisole",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eb45d5b7-9ec8-4b13-97f8-04c540401fdd",
                        "entry_id": "af5dff87-fb5c-34fc-86ba-1d333c2f3a5f",
                        "tags": [
