                                                "example_id": "6371a442-ce9d-493d-981d-32d06d6ce12d",
                                                "sense_id": "71a3f348-d6a8-3dcd-ae0c-a2fab9b5471c",
                                                "text": "„Vor den Häusern reihten sich gut gepflegte Beete mit Tomaten, Paprika, Gurken und Salat.“"
                                            }
