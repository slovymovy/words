                        "cross_references": [
                            {
                                "target_word": "verre organique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8c1540a-ee86-3be7-82c9-d456a2bc24f3",
                                        "entry_id": "2421e56c-3e8d-3e14-ae0e-36b296008dcc",
                                        "glosses": [
                                            "Nom donné aux matières plastiques qui servent à fabriquer, entre autre, la majorité des verres de lunette."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84baa47-075d-4b7a-b98b-05ca8dc9c915",
                                                "sense_id": "b8c1540a-ee86-3be7-82c9-d456a2bc24f3",
                                                "text": "Les lunettes sont plus souvent en «verre organique» qu'en verre minéral aujourd'hui; autrement dit, leurs verres sont en plastique,…."
                                            },
                                            {
                                                "example_id": "1733bf7d-0293-4740-bd68-cf25d52b8fc3",
                                                "sense_id": "b8c1540a-ee86-3be7-82c9-d456a2bc24f3",
                                                "text": "La résistance à l'impact du verre organique est supérieure à celle du verre minéral. Par contre, le verre minéral se raye beaucoup moins facilement que le verre organique."
                                            },
                                            {
                                                "example_id": "9f44b7ba-10e6-4dc7-8c3a-245dde0261c2",
                                                "sense_id": "b8c1540a-ee86-3be7-82c9-d456a2bc24f3",
                                                "text": "… sur une curieuse découverte sous le nom de Pollopas d'un véritable verre organique, perméable aux radiations ultra-violettes, qui se carbonise à 200° sans fusion préalable, obtenu dans des conditions colloïdo-chimiques précise en condensant l'urée et le formol sous le contrôle de l'indice pH du milieu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87c40ca3-b096-4bd5-9378-26f9a67784ec",
                        "source_entry_id": "95ba5c5c-8e7c-384c-b8f2-41e2ade7695d",
