                "senses": [
                    {
                        "sense_id": "b96142b4-926b-39e9-8ea4-daab44c2e0f3",
                        "entry_id": "0a52c618-9372-390b-bf5d-b687bb20810e",
                        "glosses": [
                            "An excessive or sudden increase or flood (of something)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374ea049-4513-4392-99c5-e7e71bf7c89f",
                                "sense_id": "b96142b4-926b-39e9-8ea4-daab44c2e0f3",
                                "text": "[The trial] drew a crowd […] that almost stormed the City Hall corridors. Three policement were needed to keep back the overswell."
                            },
                            {
                                "example_id": "d931afb9-361d-4ea0-a4f4-faff0c2ad480",
                                "sense_id": "b96142b4-926b-39e9-8ea4-daab44c2e0f3",
                                "text": "1983, Kenneth A. McClane, “From a Silent Center” in A Tree Beyond Telling, San Francisco: Black Scholar Press, p. 31,\nwhen no Jihad / opens the conceived / to distention, the reedy creek / to overswells / of mudwallow:"
                            },
                            {
                                "example_id": "b3dcb50c-7848-46ee-8048-db4b354f1508",
                                "sense_id": "b96142b4-926b-39e9-8ea4-daab44c2e0f3",
                                "text": "I could feel that my overswell of emotions had communicated itself to him."
                            }
                        ]
                    }
                ],
                "translations": [],
