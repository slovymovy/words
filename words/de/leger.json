                    "frequency": "Middle",
                    "semantic_group_id": "kleidung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für die Firmenfeier im Sommer ist ganz <w>legere</w> Kleidung völlig ausreichend.",
                            "target_lang_translations": {
                                "en": "For the company party in the summer, completely <w>casual</w> clothing is entirely sufficient."
                            }
                        },
                        {
                            "text": "Er geht freitags meistens eher <w>leger</w> gekleidet zur Arbeit ins Büro.",
                            "target_lang_translations": {
                                "en": "On Fridays, he usually goes to work in the office dressed rather <w>casually</w>."
