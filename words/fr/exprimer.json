                    "sense_definition": "Manifester une pensée, un sentiment ou une opinion au moyen du langage, du geste ou de l'art.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants ont le droit d'<w>exprimer</w> leur opinion pendant le débat en classe."
                        },
                        {
                            "text": "Elle n'arrive pas toujours à <w>exprimer</w> ses sentiments devant des personnes inconnues."
                        }
                    ],
                    "synonyms": [
