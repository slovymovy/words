                    }
                ],
                "senses": [
                    {
                        "sense_id": "4097fed6-cfef-32a8-8f48-15177de69ab3",
                        "entry_id": "c3b4fd15-396c-3cb3-9ad9-cf933c4e3653",
                        "glosses": [
                            "ein Indianervolk, ein Indianerstamm, der im Südosten der USA ansässig ist"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "766fbcc4-dfd2-4490-8218-b224ccaf9cd8",
                                "sense_id": "4097fed6-cfef-32a8-8f48-15177de69ab3",
                                "text": "„Er war aus England eingewandert, lebte unter den Creek und heiratete die Tochter eines Häuptlings.“"
                            },
                            {
                                "example_id": "70003a5c-1c1c-4790-8865-7682c4198176",
                                "sense_id": "4097fed6-cfef-32a8-8f48-15177de69ab3",
                                "text": "„Einen ganz ähnlichen Mythos kennen die nordamerikanischen Indianerstämme der Creek und Cherokee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c3d86691-5819-3694-96b7-5ce8b298d09c",
                        "entry_id": "c3b4fd15-396c-3cb3-9ad9-cf933c4e3653",
                        "glosses": [
                            "ein Angehöriger des gleichnamigen Indianervolks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d30f8064-99d6-4620-bb0f-a9f323ed862d",
                                "sense_id": "c3d86691-5819-3694-96b7-5ce8b298d09c",
                                "text": "„Unter diesen Kriegern fand unser Creek einige seiner rothen Brüder – Schawnees- und Delawares-Indianer, die von den fernen Gränzen von Missouri hergewandert waren.“"
                            },
                            {
                                "example_id": "e39e2247-19b6-43c0-ac9c-be3ab1a9829a",
                                "sense_id": "c3d86691-5819-3694-96b7-5ce8b298d09c",
                                "text": "„Schließlich nahmen einige der Creek doch noch am Krieg teil.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
