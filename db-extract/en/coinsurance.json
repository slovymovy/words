                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "franchise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ede7b501-3a31-3b9d-bff9-fb6c72c6a68b",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Exemption, immunité, liberté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1061066c-34c4-4d94-98fb-7bcca710f3a7",
                                                "sense_id": "ede7b501-3a31-3b9d-bff9-fb6c72c6a68b",
                                                "text": "Jamais ils ne permettent à un castor étranger de venir s’établir auprès d’eux, et souvent ils combattent avec la plus grande violence pour assurer la franchise de leur territoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f9d627-2403-376d-a2ef-64948838532c",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Droit d’asile attaché à certains lieux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6bd73c1-3744-40b0-8ba4-140c18cd4067",
                                                "sense_id": "a4f9d627-2403-376d-a2ef-64948838532c",
                                                "text": "Les hôtels des ambassadeurs sont lieux de franchise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b138594-27b8-3463-860e-436ad81f16de",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Exemption fiscale accordée sur un territoire ou à un groupe."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "195fca9c-65e4-4a06-b5b0-888ec98b5b06",
                                                "sense_id": "9b138594-27b8-3463-860e-436ad81f16de",
                                                "text": "La franchise du port de Cadiz est un événement d’une haute importance, non-seulement pour cette ville, mais pour l’Espagne et pour l’Europe entière."
                                            },
                                            {
                                                "example_id": "f38c6bc8-75c8-4ede-9f62-1e4a0738ab6f",
                                                "sense_id": "9b138594-27b8-3463-860e-436ad81f16de",
                                                "text": "[…] à deux pas de la frontière, les douaniers tolèrent l’entrée en franchise de certaines denrées belges, meilleur marché qu’en-deçà."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73be8e56-7493-3242-b773-9966ef40095a",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Exemption des droits de poste accordée à certaines personnes, à certaines administrations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec36ea4-9c44-4ca0-8dce-2e76675e927c",
                                                "sense_id": "73be8e56-7493-3242-b773-9966ef40095a",
                                                "text": "L’évêque de Nevers expédia cette lettre, en franchise postale, à tous les maires de son diocèse, les priant de leur prêter leur concours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "623d19eb-2236-350a-8503-a3ed291f768b",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Sincérité, loyauté, droiture naturelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ecc1936-f062-416c-a66c-6a7af7744762",
                                                "sense_id": "623d19eb-2236-350a-8503-a3ed291f768b",
                                                "text": "Eh bien ! reprit Bois-Guilbert, je parlerai avec autant de franchise que jamais le fit une pénitente crédule à son père spirituel, au confessionnal."
                                            },
                                            {
                                                "example_id": "3ac62358-0c06-4178-a9bb-e37d1bc796cb",
                                                "sense_id": "623d19eb-2236-350a-8503-a3ed291f768b",
                                                "text": "Solange, Dieu merci! n'est ni une prude, ni une sotte, et elle vous saura gré de votre franchise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82afe82b-0955-3e75-8fc9-d2680751c361",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Qualité de ce qui est franc, hardi."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40c0811c-bedf-4be4-a2d8-dfa3f87d4133",
                                                "sense_id": "82afe82b-0955-3e75-8fc9-d2680751c361",
                                                "text": "La franchise du crayon, du pinceau, du ciseau. - La franchise du dessin, du coloris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57b301a2-f988-3f1e-a4d7-40726323b212",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Concession commerciale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "413247c6-54e9-3158-b31b-9eaf72f24225",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Délégation."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3498b219-212d-407b-ae91-397ed5a1c3c5",
                                                "sense_id": "413247c6-54e9-3158-b31b-9eaf72f24225",
                                                "text": "Vient enfin la phase de « déploiement stratégique » marquée par la création d’un système de franchise permettant la démultiplication de l’action et de contrer les reductio ad versaillum du groupuscule."
                                            },
                                            {
                                                "example_id": "9bf6ddc8-4a92-45ca-a7f7-8cb4f0317e6a",
                                                "sense_id": "413247c6-54e9-3158-b31b-9eaf72f24225",
                                                "text": "Mais cette franchise d'Al-Qaïda a brutalement été mise en lumière : l'organisation a revendiqué, mercredi 14 janvier, l'attaque contre Charlie Hebdo menée par les frères Kouachi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45e9ba3-dc0d-3997-b365-a95ffcb27630",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Somme restant à la charge de l’assuré dans le cas où survient un sinistre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82b5d943-03d5-31a6-ab4d-d4a3c64474ec",
                                        "entry_id": "91ba2509-db4b-3a6c-892e-3d936d59fbbe",
                                        "glosses": [
                                            "Équipe sportive admise dans une ligue professionnelle par achat d'une franchise, par opposition au système de promotion et relégation des clubs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
