                        "glosses": [
                            "Droit que l’on payait pour emprunter un pont ou un bac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aae2413-9969-4faf-b51a-a869cb0fd05c",
                                "sense_id": "070e2358-5925-387d-a343-288bf66afaf8",
                                "text": "…appel au Conseil; droit de pontonage sur deux petits ponts de l’Hers appelés de Montaudran et de Velours ou d’Isalguier, le revenu desquels ne suffit pas pour les tenir réparés."
                            },
                            {
                                "example_id": "8784d544-2055-4bca-b134-2318df14d05a",
                                "sense_id": "070e2358-5925-387d-a343-288bf66afaf8",
                                "text": "15 septembre 1372: Le seigneur de Combron vend au seigneur de Saillant entre autres les droits de péage et de pontonage sur le pont du Saillant."
                            },
                            {
                                "example_id": "a5d05fc7-35fe-453b-a9a1-a6037d265fa0",
                                "sense_id": "070e2358-5925-387d-a343-288bf66afaf8",
                                "text": "La déclaration de 25 mai 1763 autorisa le libre transport des grains et denrées d’une province dans une autre, sans déclarations ni permissions préalables, sans droits de péage, passage, pontonage ou travers."
                            }
                        ]
