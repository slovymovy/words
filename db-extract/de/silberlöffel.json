                "senses": [
                    {
                        "sense_id": "ba580170-74b1-3632-81d7-98459858b524",
                        "entry_id": "7cfdd4b8-8007-33c5-b458-97be4e83f7b8",
                        "glosses": [
                            "Löffel aus Silber/ versilberter Löffel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8961a325-80e2-465f-b1e1-a0e4c83b18f4",
                                "sense_id": "ba580170-74b1-3632-81d7-98459858b524",
                                "text": "„Sekt bleibt frisch, wenn man einen Silberlöffel in die Flasche steckt.“"
                            },
                            {
                                "example_id": "37406a6b-c197-4daf-bd14-a04c6e869ec6",
                                "sense_id": "ba580170-74b1-3632-81d7-98459858b524",
                                "text": "„Meine Anverwandten pflegen ja eher den gepflegten, stets sogenannten Nutella-Schlecker, bei dem ein möglichst alter, möglichst tiefer großer Silberlöffel sachgerecht beladen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f27c243-a59c-43b0-9118-fc5aafa93843",
                        "source_entry_id": "7cfdd4b8-8007-33c5-b458-97be4e83f7b8",
                        "source_sense_id": "ba580170-74b1-3632-81d7-98459858b524",
                        "source_sense_description": "Löffel aus Silber/ versilberter Löffel",
                        "target_lang_word": "silver spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silver spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d51123f-4e51-3fbc-b73a-d4dd3ffcbccf",
                                        "entry_id": "975e0d5b-5333-356c-99ca-5e54c4f0f84b",
                                        "glosses": [
                                            "Wealth passed down or inherited."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "308b70f6-41eb-4e94-a670-7113750561f4",
                                                "sense_id": "0d51123f-4e51-3fbc-b73a-d4dd3ffcbccf",
                                                "text": "He was born with a silver spoon and an upturned nose. He didn't lose the latter when he squandered the former."
                                            },
                                            {
                                                "example_id": "56cd6196-d195-4785-b3c3-6a78b9f13be8",
                                                "sense_id": "0d51123f-4e51-3fbc-b73a-d4dd3ffcbccf",
                                                "text": "Some folks are born silver spoon in hand / Lord, don't they help themselves, yeah"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
