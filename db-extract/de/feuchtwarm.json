                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                        "entry_id": "8c538baf-091c-39ea-bbb9-10d42129c80a",
                        "glosses": [
                            "Atmosphäre oder Luftmasse, die eine hohe Temperatur hat und erhebliche Feuchtigkeit aufgenommen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b0beb0-1753-4a63-96ed-63c1fc962b81",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "[Hurrikans:] „Die Stürme aber sind keine Ausnahme, sondern die meteorologische Regel, geboren aus feuchtwarmem Seewetter und der Erddrehung.“"
                            },
                            {
                                "example_id": "cf2b7dee-ecd4-4a14-9a56-bf525b25f2c5",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Bei feuchtwarmem Wetter kann die Vermehrung der Spanischen Wegschnecke extreme Ausmaße annehmen.“"
                            },
                            {
                                "example_id": "770478c9-2064-4776-a187-2ff4b2bb0be4",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "[See Genezareth:] „Begünstigt durch das feuchtwarme Klima rund um den See ist auch die Landwirtschaft von Bedeutung.“"
                            },
                            {
                                "example_id": "33e0bd9d-9bc5-4671-a063-74350fe645ae",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Im Tropenhaus, in dem extra ein feuchtwarmes Klima geschaffen wurde, kann ich mir Kakaobäume im Original anschauen.“"
                            },
                            {
                                "example_id": "91a85dd6-e856-4670-8192-edd5cb84f68e",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Diese Tiefdruckrinne trennte feuchtwarme Luft in Ostdeutschland von mäßig warmer in Südwestdeutschland.“"
                            },
                            {
                                "example_id": "10df8fda-41cf-488c-ac9a-175ac34b2d3c",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Nebel kann sich bei Abkühlung unter den Taupunkt, bei Zunahme des Wasserdampfes durch Verdunstung und/oder Mischung von feuchtwarmer mit kalter Luft bilden.“"
                            },
                            {
                                "example_id": "51985bff-e067-4c0c-9ad0-3580a395d095",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "[Tropische Wirbelstürme:] „Über Land verlieren sie schnell ihre Kraft, da der Nachschub feuchtwarmer Luftmassen fehlt.“"
                            },
                            {
                                "example_id": "dc7c55a8-ba7c-486a-9b7d-087cc0a27435",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "[Waschmaschinen:] „[Keime] finden im feuchtwarmen Klima einen idealen Lebensraum vor, um zu wachsen und zu gedeihen.“"
                            },
                            {
                                "example_id": "a3dd1839-8d3e-4cac-913a-e2b5632c660c",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„[…] das feuchtwarme Klima ist ein ideales Umfeld für Bakterien und Viren aller Art.“"
                            },
                            {
                                "example_id": "beb59e46-1485-4b21-a495-85f57b0b3183",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Generell sollte Rohkost immer gewaschen werden, rät die Verbraucherzentrake NRW. Aber bei den Sprossen ist es noch einmal besonders wichtig. Denn schon die Samen können mit Bakterien verunreinigt sein, die sich im feuchtwarmen Keimklima schnell vermehren.“"
                            },
                            {
                                "example_id": "fd903b14-2204-4998-9ffd-0a69f02aa320",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Nepals Landschaft ist alles andere als eintönig. Ihr Variantenreichtum beginnt bei weiten Graslandschaften, reicht über feuchtwarme Regen- und Pinienwälder bis hinauf in schneebedeckte Gipfel.“"
                            },
                            {
                                "example_id": "d75376a5-1f3b-4579-9572-6f9490b5d79e",
                                "sense_id": "f8afee3e-f7fe-3413-a3dd-4b097614c2ab",
                                "text": "„Vor allem in feuchtwarmen Häusern fühlen sich Kakerlaken sehr wohl. Denn das Einzige, was diese wechselwarmen Insekten nicht gut ertragen, ist Trockenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
