                ],
                "senses": [
                    {
                        "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                        "entry_id": "a8d86911-b066-3411-ac0d-269aa705d7b4",
                        "glosses": [
                            "Winkel, der den Grad der Schräglage/Steigung/Neigung bestimmt; die Steigung einer Geraden oder Ebene angebender Winkel"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "685f339c-65aa-42fd-bcc0-4e0ea524ac20",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Für den Vergleich werden beispielhaft 2 Pyramiden mit quadratischer Grundfläche angenommen, einer mit dem Neigungswinkel von 20° und eine andere mit dem Neigungswinkel von 35°.“"
                            },
                            {
                                "example_id": "ccd29f6e-3ff8-4644-9620-0ac9712768cc",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Der Neigungswinkel des Graphen einer Funktion wird bezüglich der positiven x-Achse gemessen.“"
                            },
                            {
                                "example_id": "b615a6ae-c0e8-45e0-90ec-d465f58222e0",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Unter dem Neigungswinkel einer Ebene gegen eine der Tafeln wird der Neigungswinkel von irgend einer gleichnamigen Falllinie der Ebene verstanden.“"
                            },
                            {
                                "example_id": "44265dfa-f67e-4c99-b245-20d357e41b5a",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Beim Ablesen der Länge und besonders des Neigungswinkels muß die Kette straff angezogen sein.“"
                            },
                            {
                                "example_id": "d9edf852-1ecb-48bb-8995-8a0d7ae5b455",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Die zutage tretenden Schichten eines Gesteins zeigen Neigungswinkel ihrer Gehänge, die von dem Gefüge und der Festigkeit des Gesteins abhängig sind.“"
                            },
                            {
                                "example_id": "8bf356ca-1b11-48fd-8042-9b80c9d0706b",
                                "sense_id": "7f742074-dcaa-3673-ab70-11e2f4f499a8",
                                "text": "„Wie würden Sie den Neigungswinkel berechnen, wenn die Fluggeschwindigkeit und der Radius der Kurve gegeben sind?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
