                    {
                        "translation_id": "f91ce54f-d21e-467a-9d84-75ecc86b35a2",
                        "source_entry_id": "67859b12-d13f-3056-8d1e-2e11f5b740fa",
                        "source_sense_id": "a3cc738f-25e7-3b68-aeee-ee00b231f00a",
                        "target_lang_word": "appui",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appui",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee11a09b-3160-3208-b76d-0e079995f7f9",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Ce qui sert à soutenir une chose ou une personne pour l’empêcher de tomber, de chanceler, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ad51dac-d9e5-42f1-962c-05fd68381783",
                                                "sense_id": "ee11a09b-3160-3208-b76d-0e079995f7f9",
                                                "text": "Une grande terrasse dallée, entourée d’un mur à hauteur d’appui, s’étendait devant la porte d’entrée."
                                            },
                                            {
                                                "example_id": "6d2d0e09-fe94-4223-aa31-08917bc38933",
                                                "sense_id": "ee11a09b-3160-3208-b76d-0e079995f7f9",
                                                "text": "Mettre un appui, des appuis à un mur. Cette muraille a besoin d’appui. Si on ne donne un appui à cet arbre, le vent l’abattra."
                                            },
                                            {
                                                "example_id": "a94ad104-0819-43fe-b582-f6959f96102d",
                                                "sense_id": "ee11a09b-3160-3208-b76d-0e079995f7f9",
                                                "text": "Le point d’appui d’une poutre, d’un linteau. Cela vous servira d’appui. Ce vieillard ne peut marcher sans un appui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64bf952a-90d5-3a09-a143-d07e26c61d4f",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Ce sur quoi on s’appuie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280d119c-7d7b-461b-8f31-76351852c331",
                                                "sense_id": "64bf952a-90d5-3a09-a143-d07e26c61d4f",
                                                "text": "L’appui de cette croisée est dangereux, il est trop bas. Tablette d’appui. Barre d'appui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b6fa96-4d7e-339d-8340-4966e96cd8be",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "La partie d’une fenêtre, d’une balustrade, etc., sur laquelle on peut s’appuyer."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eddcf0f1-bb4c-4193-a4ea-e083b23c8e9b",
                                                "sense_id": "b5b6fa96-4d7e-339d-8340-4966e96cd8be",
                                                "text": "L'ensemble du linteau, de deux poteaux d’huisserie et de l’appui E, constitue l’huisserie d'une porte ou d'une fenêtre."
                                            },
                                            {
                                                "example_id": "f9a9aea7-d0a5-45a6-80db-80305e323235",
                                                "sense_id": "b5b6fa96-4d7e-339d-8340-4966e96cd8be",
                                                "text": "Capestang, en parlant ainsi, enjambait l'appui de la fenêtre."
                                            },
                                            {
                                                "example_id": "f4beb339-af98-4ed2-8960-9128ffdf9e27",
                                                "sense_id": "b5b6fa96-4d7e-339d-8340-4966e96cd8be",
                                                "text": "La dame s’accoudait maintenant à la fenêtre, étalant ses bouteilles sur la pierre d’appui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5afed802-241d-3cfa-a4ee-9a90924ed492",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Le point d’appui d’un levier; Le point du levier qui est fixe, ou censé tel, et autour duquel s’opère sa rotation."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ddcceb9-5891-3834-bd14-f26b04731745",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Sensation que fait éprouver à la main du cavalier l’action du mors sur les barres du cheval."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06dc98eb-8e18-4316-a134-53e66f585578",
                                                "sense_id": "5ddcceb9-5891-3834-bd14-f26b04731745",
                                                "text": "Ce cheval a l’appui bon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e4563bf-07bb-3b12-ac8d-822b98b03c6a",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Temps pendant lequel, dans la marche, le pied du cheval pose sur le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdf39b1-3ca9-46c7-9514-39e5421f768f",
                                                "sense_id": "6e4563bf-07bb-3b12-ac8d-822b98b03c6a",
                                                "text": "Note : Que l’on nomme autrement foulée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7348cf11-21e2-3ca0-8a98-f841bed0c366",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Élévation plus ou moins sensible de la voix dans le phrasé."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73742a6d-37fa-431f-a360-58a3bc05ae1e",
                                                "sense_id": "7348cf11-21e2-3ca0-8a98-f841bed0c366",
                                                "text": "L’accent tonique marque un appui de la voix sur la voyelle qui le porte."
                                            },
                                            {
                                                "example_id": "16098889-084f-43a1-9671-a910c7b364d8",
                                                "sense_id": "7348cf11-21e2-3ca0-8a98-f841bed0c366",
                                                "text": "– Rose, Rose, Rose, dit Hélène dont la voix sans appuis changea trois fois de timbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3aaddc2-44c6-321b-9cc9-8fa494da45ca",
                                        "entry_id": "f07cedc1-813a-362e-8d0d-e80f2095a140",
                                        "glosses": [
                                            "Aide ; protection."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b621cd2-2482-41e5-a4ef-613b77c89832",
                                                "sense_id": "d3aaddc2-44c6-321b-9cc9-8fa494da45ca",
                                                "text": "Euphrasie. Je conçois parfaitement... en votre qualité d'avocat de M. le comte, vous cherchez à m'effrayer... vous voudriez que nous nous privassions nous-mêmes de l’appui d'une personne qui nous est dévouée."
                                            },
                                            {
                                                "example_id": "6cea961c-e1ec-4cb6-bd53-a08788466620",
                                                "sense_id": "d3aaddc2-44c6-321b-9cc9-8fa494da45ca",
                                                "text": "Pour les littérateurs Allemands il ne leur a manqué rien jusqu’içi qu'un centre réel, un appui de la part d'un gouvernement suffisamment éclairé."
                                            },
                                            {
                                                "example_id": "9a82eacf-6123-40f2-bbc8-d69c098fadde",
                                                "sense_id": "d3aaddc2-44c6-321b-9cc9-8fa494da45ca",
                                                "text": "Désirant ainsi croiser lectures, rencontres, et dépouillages d’archives, ce livre n'aurait pu exister sans les témoignages, les conseils, les appuis, l'aide et l'amitié d'un certain nombre de personnes."
                                            },
                                            {
                                                "example_id": "2f66e6d9-d9a4-44a9-8627-8833473b76d3",
                                                "sense_id": "d3aaddc2-44c6-321b-9cc9-8fa494da45ca",
                                                "text": "La Shell apporte aussi aux associés le précieux appui de sa flotte de tankers."
