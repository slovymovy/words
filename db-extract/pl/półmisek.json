                        "entry_id": "e66b293f-fe9a-3e6d-9e87-1c64864bc4d1",
                        "glosses": [
                            "rodzaj płaskiego dużego naczynia, służącego do podawania potraw, przystawek lub przekąsek na stół"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eac0040b-dbb7-4cee-b77f-d21def33834d",
                                "sense_id": "0485747c-40e0-38f3-9fd4-0f53a1132aab",
                                "text": "Na stole pojawił się półmisek z kluchami i dzban ze zsiadłym mlekiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "00dfea02-2174-3149-95e5-3609fa9a886b",
                        "entry_id": "e66b293f-fe9a-3e6d-9e87-1c64864bc4d1",
                        "glosses": [
                            "zawartość półmiska (1.1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db83acfa-d617-482d-a56a-e02f9bbd584e",
                                "sense_id": "00dfea02-2174-3149-95e5-3609fa9a886b",
                                "text": "Ile czasu zajmuje ci przygotowanie półmiska tych kruchych ciastek?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
