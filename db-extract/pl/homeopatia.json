                                    {
                                        "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                        "entry_id": "08bb784e-1744-39d3-b9a1-b9b7b196b210",
                                        "glosses": [
                                            "A system of treating diseases with small amounts of substances which, in larger amounts, would produce the observed symptoms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faea31d7-827e-4062-bbb1-80a341cb68ac",
                                                "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                                "text": "I am sure that if doctors (for instance) were first taught how to use some of the other methods of homeopathy effectively, particularly the therapeutics and organ-based methods, they would be much more able to incorporate these into their practices […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3393d3c0-0d38-473a-afe2-28856c8921f3",
                        "source_entry_id": "b7eae806-ea4e-3009-b0ca-57269d883487",
                        "source_sense_id": "eac252ed-5aa7-33d2-8f1a-b00ec3c5ebc2",
                        "target_lang_word": "順勢療法",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "順勢療法",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "aefd0a2f-ac38-37af-b3cb-84941c2b09c6",
                                        "entry_id": "f2a8783e-166e-3cc4-8122-2a41fe17fabe",
                                        "glosses": [
                                            "一種替代療法，其理論稱如果某個物質能在健康的人身上引起病人患某病時的病症，將此物質稀釋震盪處理後就能治療該病症。"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3e06ed-ba59-41b5-a418-20a25c12d0e5",
                        "source_entry_id": "b7eae806-ea4e-3009-b0ca-57269d883487",
                        "source_sense_id": "eac252ed-5aa7-33d2-8f1a-b00ec3c5ebc2",
                        "target_lang_word": "顺势疗法",
                        "target_lang_code": "zh",
