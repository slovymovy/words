{
    "word_family": [
        "zonnescherm"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "45038e61-cb21-3c92-8493-55ec4871bd5e",
                    "sense_definition": "Een draagbaar scherm dat bescherming biedt tegen de zon.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zonwering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij nam haar <w>parasol</w> mee naar het strand om in de schaduw te zitten.",
                            "target_lang_translations": {
                                "ru": "Она взяла свой <w>солнцезащитный зонт</w> на пляж, чтобы посидеть в тени."
                            }
                        },
                        {
                            "text": "Het is erg heet vandaag, dus ik zet de <w>parasol</w> in de tuin op.",
                            "target_lang_translations": {
                                "ru": "Сегодня очень жарко, поэтому я ставлю <w>солнцезащитный зонт</w> в саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "zonnescherm"
                    ],
                    "common_phrases": [
                        "parasol opzetten",
                        "onder de parasol"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносной зонт, защищающий от солнца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнцезащитный зонт",
                                "target_lang_sense_clarification": "обычный переносной зонт от солнца"
                            },
                            {
                                "target_lang_word": "пляжный зонт",
                                "target_lang_sense_clarification": "зонт, используемый на пляже"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e72654cc-4404-3942-809d-c9ed55004c21",
                    "sense_definition": "Een vast of inklapbaar scherm dat bescherming biedt tegen direct zonlicht.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zonwering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij hebben een groot <w>zonnescherm</w> aan de gevel van ons huis gemonteerd.",
                            "target_lang_translations": {
                                "ru": "Мы установили большую <w>маркизу</w> на фасаде нашего дома."
                            }
                        },
                        {
                            "text": "Het <w>zonnescherm</w> houdt de woonkamer lekker koel tijdens de warme middag.",
                            "target_lang_translations": {
                                "ru": "<w>Маркиза</w> сохраняет гостиную приятно прохладной в жаркий полдень."
                            }
                        }
                    ],
                    "synonyms": [
                        "parasol",
                        "zonwering"
                    ],
                    "common_phrases": [
                        "zonnescherm uitdraaien"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стационарный или складной навес, защищающий от прямых солнечных лучей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркиза",
                                "target_lang_sense_clarification": "складной навес над окном или дверью"
                            },
                            {
                                "target_lang_word": "тент",
                                "target_lang_sense_clarification": "навес из ткани для защиты от солнца"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}