                "senses": [
                    {
                        "sense_id": "d8782176-2800-395c-b498-ad75eefa6aac",
                        "entry_id": "72c1110b-c82c-3a10-add4-1ffcc9c583e0",
                        "glosses": [
                            "eines der Entwicklungsstadien, die im Spracherwerb vor der vollständigen Beherrschung der betreffenden Sprache erreicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfccedc6-2636-4e62-bccf-e169d10ce080",
                                "sense_id": "d8782176-2800-395c-b498-ad75eefa6aac",
                                "text": "„Diese Arbeit beschäftigt sich mit der Interimsprache bosnischer Immigranten, welche sich zum Zeitpunkt des Interviews bereits drei Jahre in Österreich aufhielten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75a2106d-efd9-3b57-aa5a-413554fdf18f",
                        "entry_id": "72c1110b-c82c-3a10-add4-1ffcc9c583e0",
                        "glosses": [
                            "Sprachform, die der zwischensprachlichen Kommunikation dient und auch Elemente der Sprache des Adressaten enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b340594-63dc-4ea3-8b04-4b32cf0f55da",
                                "sense_id": "75a2106d-efd9-3b57-aa5a-413554fdf18f",
                                "text": "„Dennoch soll hier dem - manchmal auch von den Skandinaviern selbst verbreiteten - Eindruck entgegengetreten werden, daß sich die Skandinavier vornehmlich mit dieser Art von Interlanguage/Interimsprache Skandinaviska untereinander verständigen würden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9070ee1c-2a3d-4866-9ef5-ea39e057cbf2",
                        "source_entry_id": "72c1110b-c82c-3a10-add4-1ffcc9c583e0",
                        "source_sense_id": "d8782176-2800-395c-b498-ad75eefa6aac",
                        "target_lang_word": "interlanguage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlanguage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "826c52ae-8d07-3de6-b2eb-76329ace890d",
                                        "entry_id": "d6fb7bb2-8862-32d3-8827-afa47e9b9370",
                                        "glosses": [
                                            "A language generated by a student of a foreign language that incorporates aspects of their native language and the target language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44483272-3f2a-45a8-a9fb-f34bd44a6e69",
                                                "sense_id": "826c52ae-8d07-3de6-b2eb-76329ace890d",
                                                "text": "Trasyanka and Surzhyk are interlanguages: a Belarusian–Russian and a Ukrainian–Russian mixed language."
                                            },
                                            {
                                                "example_id": "7bd27177-5277-4278-bcdb-b2768e6a1ab1",
                                                "sense_id": "826c52ae-8d07-3de6-b2eb-76329ace890d",
                                                "text": "The learner's selection from his/her store of interlanguage rules is not haphazard but systematic and predictable, based as it is on his/her existing rule system in much the same way as the native speaker bases his/her speech on the internalized knowledge of the L1 system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e55678b9-8922-3625-acfd-5e84e1b6dc11",
                                        "entry_id": "d6fb7bb2-8862-32d3-8827-afa47e9b9370",
                                        "glosses": [
                                            "A lingua franca, a common language used by speakers of different languages"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e179dc-1fd5-4c66-8905-c1e605196880",
                                                "sense_id": "e55678b9-8922-3625-acfd-5e84e1b6dc11",
                                                "text": "Latin used to be the European interlanguage. Currently English widely serves this purpose."
                                            },
                                            {
                                                "example_id": "88c76d50-8041-43ce-9520-d769d344e98c",
                                                "sense_id": "e55678b9-8922-3625-acfd-5e84e1b6dc11",
                                                "text": "As [David] Bellos points out, those born as English speakers are now a minority of English speakers: most speak it as a second language. English is the world’s biggest interlanguage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200d7fe6-b587-3534-b125-a41371ddca06",
                                        "entry_id": "d6fb7bb2-8862-32d3-8827-afa47e9b9370",
                                        "glosses": [
                                            "A pidgin or creole"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
