                ],
                "senses": [
                    {
                        "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                        "entry_id": "57ebb06e-2578-3e79-a393-5e4a623a56ef",
                        "glosses": [
                            "Gedenksäule zur Erinnerung an eine örtlich überstandene Pest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a786f4d3-f0f2-4b17-8d28-2b64f6db7a2b",
                                "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                                "text": "„Pestsäulen findet man häufig auf Markt- u. Brunnenplätzen süddeutscher Städte, errichtet aufgrund von Pestgelübden und den Pestpatronen der jeweiligen Städte gewidmet.“"
                            },
                            {
                                "example_id": "75ab2174-4a60-43d5-9e1e-632537e98955",
                                "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                                "text": "„Als die Pest erloschen war, wurde an der Pestsäule am 17. Juni 1680 ein feierliches Dankesfest abgehalten, bei dem der Augustiner Abraham a Sancta Clara seine Rede „Danck und Denckzahl“ hielt.“"
                            },
                            {
                                "example_id": "796ac5ae-58b6-4d89-90ff-3c030e6f864f",
                                "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                                "text": "„Als Antwort auf die letzte große Wiener Pestepidemie am Graben in der Wiener Innenstadt errichtet wurde die Pestsäule Vorbild für viele weitere Mahnmale dieser Art in der Donaumonarchie.“"
                            },
                            {
                                "example_id": "212c7cd1-8963-401e-8d10-570763002772",
                                "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                                "text": "„Für ihn sei es selbstverständlich, für die anstehende Restaurierung der Betsäule, auch als Pestsäule bekannt, zu spenden.“"
                            },
                            {
                                "example_id": "84571393-c711-4faa-8daf-628ff7f490c6",
                                "sense_id": "c65cb1e3-1283-3ffe-9619-8c6bbe6bd6a8",
                                "text": "„In Österreich kommen zahlreiche Pestsäulen vor, die, besonders im Barock, auch in Deutschland anzutreffen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
