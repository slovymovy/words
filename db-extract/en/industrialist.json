                "senses": [
                    {
                        "sense_id": "396740a8-c535-3873-855c-e61ee5c698f4",
                        "entry_id": "8179555a-6586-36bc-bae0-31c633a96300",
                        "glosses": [
                            "A person involved in the ownership or management of an industrial enterprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d1a5c1-9d1f-4b1e-96c5-76fe2e09cbeb",
                                "sense_id": "396740a8-c535-3873-855c-e61ee5c698f4",
                                "text": "Brian Donlevy is a wealthy industrialist who survives an attempted murder when his wife's boyfriend is killed in a car crash."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2811048-827d-3be8-9dca-43ced0c8fbe6",
                        "entry_id": "8179555a-6586-36bc-bae0-31c633a96300",
                        "glosses": [
                            "One who performs or enjoys industrial music."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "626f1505-9be6-4092-bf0b-1ac3e7cafe8c",
                                "sense_id": "a2811048-827d-3be8-9dca-43ced0c8fbe6",
                                "text": "Like a lot of second-wave industrialists, Skinny Puppy's attraction to rhythm wasn't consciously political, but based in the pleasure of making and moving to a beat; Key was, after all, a drummer."
                            }
                        ]
                    }
                ],
