                                                "sense_id": "c953ae4c-ed79-37d6-adca-9708df11fa27",
                                                "text": "Sie waren seit der Grundschulzeit eng befreundet beziehungsweise unzertrennlich."
                                            },
                                            {
                                                "example_id": "635e1bbe-ac1d-4d0e-b6fc-a4bfd9973139",
                                                "sense_id": "c953ae4c-ed79-37d6-adca-9708df11fa27",
                                                "text": "„Dieses Bild der Keltinnen als große, starke, eigenwillige und mutige beziehungsweise kriegerische Frauen ist weitverbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e85b24ff-5915-39eb-84e8-832618c3ace2",
                                        "entry_id": "8938fad1-d40e-3a42-8e53-96e935aa8552",
                                        "glosses": [
                                            "und im anderen Fall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
