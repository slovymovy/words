                            {
                                "example_id": "c314fd42-733a-4cb6-908f-2a6bfebef048",
                                "sense_id": "47444927-dc66-3fc7-9b86-1f88df6e4bd1",
                                "text": "He arrived at the party, nattily dressed and eager to socialize."
                            },
                            {
                                "example_id": "39336add-ecaf-4670-ab15-08847cee74f0",
                                "sense_id": "47444927-dc66-3fc7-9b86-1f88df6e4bd1",
                                "text": "Perhaps the attitude of the city was best personified by a nattily-dressed gentleman who wormed his way into the hearing room at around 8:00 p.m. He did not ask what was going on, nor whom to address his extemporaneous remarks. \"I just wanted to come in and be recorded against this,\" he said, and then left."
                            },
                            {
                                "example_id": "ea8daa3e-199a-4aaf-a63c-2e975c28df54",
                                "sense_id": "47444927-dc66-3fc7-9b86-1f88df6e4bd1",
                                "text": "It was a tantalizing promise, delivered with Donald Trump’s trademark panache: As dealmaker in chief, he would quickly end world conflicts that had defied his predecessors and their nattily dressed legions of career diplomats."
                            }
                        ]
                    }
