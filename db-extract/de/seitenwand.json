                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d9061ce-b955-4c6c-a99f-fa0d23bbf8b0",
                                "sense_id": "2f1633e6-105b-38d3-b5ad-12a8435258b3",
                                "text": "„Runde Tische und Rohrstühle stehen an den Seitenwänden ungeordnet durcheinander, doch lassen sie den Mittelraum völlig frei..“"
                            },
                            {
                                "example_id": "5f71f4f5-d754-4de0-9439-bcba9bfd2103",
                                "sense_id": "2f1633e6-105b-38d3-b5ad-12a8435258b3",
                                "text": "„Und da waren die Pfirsichspaliere an einer Seitenwand des Hauses.“"
                            }
                        ],
