                                                "example_id": "88e230d1-d212-4393-9717-af7e0cc028fe",
                                                "sense_id": "93b4c0bc-4847-3e5b-b342-35ef029663b7",
                                                "text": "adverbial: Fünfzig Jahre alt zu sein bedeutet nicht unbedingt, auch nicht appetitlich zu wirken."
                                            },
                                            {
                                                "example_id": "b4ff00b3-459a-4393-bfc4-b032e6c07a1a",
                                                "sense_id": "93b4c0bc-4847-3e5b-b342-35ef029663b7",
                                                "text": "adverbial: Schon der Buchdeckel sah nicht appetitlich aus."
                                            },
                                            {
                                                "example_id": "05ca0ba8-042f-4151-817d-bd9333ed46a4",
                                                "sense_id": "93b4c0bc-4847-3e5b-b342-35ef029663b7",
                                                "text": "„Ich zog mit meiner Familie von einer Dachstube in die nächste, von denen man jedoch nicht auf die Seine, sondern auf einige der weniger appetitlichen Straßen von Bangor herunterblickte, diejenigen, in denen die Streifenwagen der Polizei immer Samstag nachts um zwei aufzutauchen scheinen“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
