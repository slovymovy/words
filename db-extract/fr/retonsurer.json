                        "glosses": [
                            "Tonsurer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a512421-841f-405c-bb0d-ad37446508a0",
                                "sense_id": "38ac0aff-7183-36d4-bdd7-d545afc0194f",
                                "text": "L'abbé de Tencin, envisageant à nouveau de faire obtenir un bénéfice ecclésiastique à son neveu, écrit qu'il faudra faire retonsurer le chevalier, qui est le nom sous lequel on désigne alors Jean-Louis dans la correspondance familiale."
                            },
                            {
                                "example_id": "8596594b-2fa6-439f-972d-368a6649f9d1",
                                "sense_id": "38ac0aff-7183-36d4-bdd7-d545afc0194f",
                                "text": "Le pacha, retonsuré, mène ses moines comme des soldats."
                            }
                        ]
                    }
