                                    },
                                    {
                                        "sense_id": "bc199fc6-60dd-38ab-be37-87276545ac83",
                                        "entry_id": "ea88ecd7-efb4-3b2a-a67f-45fee8a5f51c",
                                        "glosses": [
                                            "Pasar por una persona para llevarla a otro lugar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4c0c0e-4d18-4848-b658-d743ab3e8280",
                                                "sense_id": "bc199fc6-60dd-38ab-be37-87276545ac83",
                                                "text": "Te busco a las nueve para acompañarte al baile."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "934b3040-b232-39c1-a4b7-021abd2b2e96",
                                        "entry_id": "ea88ecd7-efb4-3b2a-a67f-45fee8a5f51c",
                                        "glosses": [
