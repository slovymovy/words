                "senses": [
                    {
                        "sense_id": "53c48fca-ff6f-3c58-a1d4-dca22394fa78",
                        "entry_id": "4fe3e0ed-e4bc-3bdb-b2f3-a1351e3ddb39",
                        "glosses": [
                            "Qui concerne les holons, qui en a les caractéristiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533d225e-1fb4-45ad-b470-071e0de35837",
                                "sense_id": "53c48fca-ff6f-3c58-a1d4-dca22394fa78",
                                "text": "L’introduction du concept de holon ou de « produit holonique » (information et physique) lors de la phase de modélisation permet d’identifier et de classifier l’ensemble des informations concernant le produit."
                            },
                            {
                                "example_id": "e35b4cbe-5c48-466d-a74d-3c5317646fdd",
                                "sense_id": "53c48fca-ff6f-3c58-a1d4-dca22394fa78",
                                "text": "La structure holonique d’une route est la suivante : une route est divisée en liens ; un lien représente une ligne à sens unique de la route ; un segment est composé de deux points échangeurs de voies et au moins un lien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "037d9f95-b507-46dd-9f7d-a972eb21e5bd",
                        "source_entry_id": "4fe3e0ed-e4bc-3bdb-b2f3-a1351e3ddb39",
                        "source_sense_id": "53c48fca-ff6f-3c58-a1d4-dca22394fa78",
                        "target_lang_word": "holonic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holonic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b275b873-13a0-321a-885a-606022fb808c",
                                        "entry_id": "89974a26-56b8-33e4-a96b-2212a71215e7",
                                        "glosses": [
                                            "Pertaining to holons; involving something that is simultaneously a self-contained entity and a part of a larger system."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ac797e7-3a3f-46b4-b237-9894c249db0f",
                                                "sense_id": "b275b873-13a0-321a-885a-606022fb808c",
                                                "text": "In force of its undecidable and holonic character, global sustainability can only be attained by resorting to suitable heuristics designed to guide global evolution."
                                            },
                                            {
                                                "example_id": "8f85f1e8-bf3f-4ac8-b901-01bdb9573f1f",
                                                "sense_id": "b275b873-13a0-321a-885a-606022fb808c",
                                                "text": "The ego is still there and thus the unconsciousness as well, but one is temporarily unconscious of the fact that there is a seam between ones ego and any other holonic faction."
                                            },
                                            {
                                                "example_id": "fe29dcc5-6649-4acf-916f-1996de88cf7f",
                                                "sense_id": "b275b873-13a0-321a-885a-606022fb808c",
                                                "text": "Early attempts in designing holonic manufacturing systems have taken a more technically oriented approach."
                                            },
                                            {
                                                "example_id": "f8829f67-849a-4b24-ad43-6ef8bc3f0315",
                                                "sense_id": "b275b873-13a0-321a-885a-606022fb808c",
                                                "text": "With this holonic knowledge, therapy participants establish a space wherein additional information can emerge from and assimilate with previous knowledge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
