                },
                {
                    "sense_id": "72391752-1610-3720-adca-a3b18ad507a4",
                    "sense_definition": "Qui inspire la méfiance, la suspicion ou le malaise ; louche, suspect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "étrangeté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un type <w>chelou</w> attendait devant l'immeuble sans dire un mot.",
                            "target_lang_translations": {
                                "en": "A <w>shady</w> guy was waiting outside the building without saying a word.",
                                "ru": "Какой-то тип <w>подозрительный</w> ждал у подъезда и не проронил ни слова.",
                                "nl": "Een <w>louche</w> vent wachtte zonder een woord te zeggen voor het gebouw.",
                                "de": "Ein <w>zwielichtiger</w> Typ wartete vor dem Gebäude, ohne ein Wort zu sagen.",
                                "pl": "Jakiś <w>podejrzany</w> typ czekał przed budynkiem i nie powiedział ani słowa.",
                                "it": "Un tipo <w>sospetto</w> aspettava davanti al palazzo senza dire una parola.",
                                "cs": "Před domem čekal nějaký <w>podezřelý</w> chlap a nepromluvil ani slovo.",
                                "tr": "Binanın önünde tek kelime etmeden bekleyen <w>şüpheli</w> bir adam vardı.",
                                "es": "Un tipo <w>sospechoso</w> esperaba frente al edificio sin decir ni una palabra.",
                                "zh": "一个<w>可疑</w>的男人在楼下等着，一句话也不说。"
                            }
                        },
                        {
                            "text": "Cette proposition me paraît trop belle pour être honnête, elle est très <w>cheloue</w>.",
                            "target_lang_translations": {
                                "en": "This offer seems too good to be true to me; it's very <w>suspicious</w>.",
                                "ru": "Мне это предложение кажется слишком хорошим, чтобы быть честным; оно очень <w>подозрительное</w>.",
                                "nl": "Dit voorstel lijkt me te mooi om waar te zijn, het is erg <w>verdacht</w>.",
                                "de": "Dieses Angebot kommt mir zu schön vor, um ehrlich zu sein; es ist sehr <w>verdächtig</w>.",
                                "pl": "Ta propozycja wydaje mi się zbyt dobra, żeby była uczciwa; jest bardzo <w>podejrzana</w>.",
                                "it": "Questa proposta mi sembra troppo bella per essere vera: è molto <w>losca</w>.",
                                "cs": "Ta nabídka mi připadá příliš dobrá, než aby byla pravdivá; je velmi <w>podezřelá</w>.",
                                "tr": "Bu teklif bana gerçek olamayacak kadar iyi geliyor; çok <w>şüpheli</w>.",
                                "es": "Esta propuesta me parece demasiado buena para ser verdad; es muy <w>sospechosa</w>.",
                                "zh": "这个提议好得不像是真的，我觉得很<w>可疑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "louche"
                    ],
                    "antonyms": [
                        "net"
                    ],
                    "traits": [
