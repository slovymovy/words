                        "sense_id": "377d79e9-05ce-3f67-bb34-601f522e89b5",
                        "entry_id": "932187a0-047d-3bcc-ad35-887ff1e244c7",
                        "glosses": [
                            "A portent, a token."
                        ],
                        "tags": [
                            "archaic",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "51265e7d-dddd-42b7-8923-03ff0b1e53f8",
                                "sense_id": "377d79e9-05ce-3f67-bb34-601f522e89b5",
                                "text": "We ask'd of God that some ostent might clear / Our cloudy business, who gave us sign."
                            },
                            {
                                "example_id": "296f431a-46b1-4804-8a41-e2dac08fe291",
                                "sense_id": "377d79e9-05ce-3f67-bb34-601f522e89b5",
                                "text": "Latinus, frighted with this dire ostent, / For counsel to his father Faunus went,"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
