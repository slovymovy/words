                "senses": [
                    {
                        "sense_id": "ec94ebf8-3194-395d-a910-446cfcc83e6e",
                        "entry_id": "362ce45d-3ad2-33c4-a016-2d08085a84fd",
                        "glosses": [
                            "Having a negative view of mankind. This may express itself as, e.g., distrust, dislike, hate, or contempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c58237fb-0731-436a-9d5b-d922d7501417",
                                "sense_id": "ec94ebf8-3194-395d-a910-446cfcc83e6e",
                                "text": "[C]hildren, ſervants, are falſe, fraudful, foul, if the miſanthropic man, who is father and maſter, lets fall among them, in his outbreaks of paſſion, his opinion that they are ſo."
                            },
                            {
                                "example_id": "96aab176-7a00-4e06-b364-0deda7cd1d6a",
                                "sense_id": "ec94ebf8-3194-395d-a910-446cfcc83e6e",
                                "text": "The torturers of any form of life torture the life. In this they are not only abominators of form, but haters of nature; and the violationist school is misozoic, life-hating; in continuation of that which it also is, misanthropic, or an enemy of mankind."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb3fcd72-b62a-45b8-917b-d42a9ef83e6e",
                        "source_entry_id": "362ce45d-3ad2-33c4-a016-2d08085a84fd",
                        "source_sense_id": "ec94ebf8-3194-395d-a910-446cfcc83e6e",
                        "source_sense_description": "disliking or hating mankind",
                        "target_lang_word": "misanthropique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misanthropique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee9dfc79-f1ab-30ea-b90a-9188f33c7338",
                                        "entry_id": "adffad85-bea0-35a4-bcca-7ef5be0bd824",
                                        "glosses": [
                                            "Qui a rapport à la misanthropie, qui en a le caractère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d5ef2a0-b346-4a4a-8f11-d0a18ca605f9",
                                                "sense_id": "ee9dfc79-f1ab-30ea-b90a-9188f33c7338",
                                                "text": "Néanmoins cette volupté d’amour-propre fut dominée chez elle par la misanthropique malice qu’avait engendrée la blessure affreuse qui déjà lui semblait seulement un mécompte."
                                            },
                                            {
                                                "example_id": "7029dd3f-80e5-44d3-90dd-c489d437c103",
                                                "sense_id": "ee9dfc79-f1ab-30ea-b90a-9188f33c7338",
                                                "text": "Or, si votre maîtresse n’est pas morte, si c’est elle que nous venons de voir, vous la retrouverez un jour ou l’autre. Et peut-être, mon Dieu, ajouta-t-il avec cet accent misanthropique qui lui était propre, peut-être plus tôt que vous ne voudrez !"
                                            },
                                            {
                                                "example_id": "2ec1702a-a7b2-4880-a907-0aea2de64ec6",
                                                "sense_id": "ee9dfc79-f1ab-30ea-b90a-9188f33c7338",
                                                "text": "De notoriété publique Houellebecq était un solitaire à fortes tendances misanthropiques, c’est à peine s’il adressait la parole à son chien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
