                        "examples": [
                            {
                                "example_id": "db98335c-e11f-4a4e-a481-0ffb8243f030",
                                "sense_id": "d268a2d0-97e4-35b0-b2a2-bb91f4fd71d2",
                                "text": "Fortunately the magneto's power was limited, or the rods would have circled the table until one of the men had proved that he had real huevos, the implication being that the rest of the men were pussies."
                            },
                            {
                                "example_id": "2b10b13d-d2da-447a-9750-df41380b6030",
                                "sense_id": "d268a2d0-97e4-35b0-b2a2-bb91f4fd71d2",
                                "text": "In this business a man has to have balls, real huevos, Dwayne.”"
                            },
                            {
                                "example_id": "be4aaa4d-4db4-4d6d-9132-1d53bc33a972",
                                "sense_id": "d268a2d0-97e4-35b0-b2a2-bb91f4fd71d2",
                                "text": "They also think you've got some pretty big huevos to be as close to him as you are."
                            }
                        ]
