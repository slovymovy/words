                                                "sense_id": "fe56d7ef-8385-3c0b-a9d2-171c26e5a71a",
                                                "text": "Die Neapolitaner unterstanden vor der endgültigen Eroberung durch die napoleonischen Truppen der Monarchie der Bourbonen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
