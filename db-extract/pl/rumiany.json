                                        "examples": [
                                            {
                                                "example_id": "f90df705-5626-49ae-ad03-f738bc90a3a6",
                                                "sense_id": "b90aa7b9-c62d-3cd1-a576-6e8a4a97e250",
                                                "text": "Bei Temperaturen unter dem Gefrierpunkt sieht man viele rotwangige Menschen auf der Straße."
                                            }
