                    "frequency": "High",
                    "semantic_group_id": "blocage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La clé est restée <w>coincée</w> dans la serrure de la porte d'entrée."
                        },
                        {
                            "text": "Nous sommes restés <w>coincés</w> dans l'ascenseur pendant plus d'une heure."
