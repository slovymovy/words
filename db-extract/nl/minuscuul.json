                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cd0f2b4-6194-31a8-b588-a57bf770f751",
                                        "entry_id": "7d952bc2-ada3-3980-9c0f-7c9d9d02e7f5",
                                        "glosses": [
                                            "Très petit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45c54a08-efbe-4098-b763-1a7f8b9bf7f1",
                                                "sense_id": "9cd0f2b4-6194-31a8-b588-a57bf770f751",
                                                "text": "Le rivage n’était pas entièrement continu, le récif était frangé d’îles qui présentaient entre elles de minuscules passes."
                                            },
                                            {
                                                "example_id": "15242e41-c9ef-4d21-b1d9-0007e312a293",
                                                "sense_id": "9cd0f2b4-6194-31a8-b588-a57bf770f751",
                                                "text": "Kara essuya ses yeux humides et regarda autour d'elle. La minuscule boutique était bourrée d'articles de sorcellerie."
                                            },
                                            {
                                                "example_id": "f9d12fc1-d98b-4fe3-ba9b-67c5c1e7d70b",
                                                "sense_id": "9cd0f2b4-6194-31a8-b588-a57bf770f751",
                                                "text": "Dans le centre-ville, elle est heureuse comme un poisson dans l'eau. Elle a son petit atelier, un beau salon, une chambre et une minuscule cuisine qui lui suffit pour elle toute seule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71dba7d8-3731-33e2-add6-70276b898c4b",
                                        "entry_id": "7d952bc2-ada3-3980-9c0f-7c9d9d02e7f5",
                                        "glosses": [
                                            "Sans importance."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eca55e6-9a11-4ea5-b00a-274396255e9b",
                                                "sense_id": "71dba7d8-3731-33e2-add6-70276b898c4b",
                                                "text": "Un événement minuscule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc93c37e-547d-32a5-80de-eeeb135bddb4",
                                        "entry_id": "7d952bc2-ada3-3980-9c0f-7c9d9d02e7f5",
                                        "glosses": [
                                            "Petite en parlant d’une lettre, par opposition à majuscule et capitale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03dc669b-c4b0-4054-8263-a20cafed6bbb",
                                                "sense_id": "dc93c37e-547d-32a5-80de-eeeb135bddb4",
                                                "text": "J’écris uniquement avec des lettres minuscules."
                                            },
                                            {
                                                "example_id": "83a526cc-94f2-490e-a60f-83831c9784bf",
                                                "sense_id": "dc93c37e-547d-32a5-80de-eeeb135bddb4",
                                                "text": "Cette phrase contient des caractères minuscules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6810b2a1-d3eb-3166-8b1f-322a205ee536",
                                        "entry_id": "7d952bc2-ada3-3980-9c0f-7c9d9d02e7f5",
                                        "glosses": [
                                            "Petite en parlant d’une lettre, par opposition à majuscule et capitale.",
                                            "Qui utilise de petites lettres et non des capitales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a592d05b-1611-4f17-8526-bfdbd38cbe0e",
                                                "sense_id": "6810b2a1-d3eb-3166-8b1f-322a205ee536",
                                                "text": "Un alphabet minuscule est composé de lettres minuscules."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minuscule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                        "entry_id": "4c4bcbb0-7dc6-3aca-9b29-78866839909a",
                                        "glosses": [
                                            "Petite lettre comme a, b, c, par opposition à la capitale, de plus grand format comme A, B, C."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ac7993-8d60-4605-b50b-a342ba49f1a4",
                                                "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                                "text": "Le caractère anguleux et allongé des minuscules des premières années du 13ᵉ siècle s'est maintenant étendu à toutes les majuscules, la fourche à l'extrémité des hastes montantes tend à s'écarter encore, on ne trouve quasiment plus de perluettes ni de « e » cédillés, les abréviations plus communes au 13ᵉ siècle comme le « ; » pour le est sont maintenant intégrées et le pied de mouche est connu ([…])."
                                            },
                                            {
                                                "example_id": "3013d02e-1ba9-40ee-8288-4c5c49063ee1",
                                                "sense_id": "a4b691d4-57f5-370b-b43a-4430365adf01",
                                                "text": "On écrit champagne avec une minuscule quand il s’agit du vin de Champagne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b744838-ba17-3a65-9b31-8c097e7ea447",
                                        "entry_id": "4c4bcbb0-7dc6-3aca-9b29-78866839909a",
                                        "glosses": [
                                            "Petite capitale, par opposition aux grandes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d996416e-b92c-4ccd-96c3-35b4d5aa2813",
                                                "sense_id": "9b744838-ba17-3a65-9b31-8c097e7ea447",
                                                "text": "Les petites capitales, ou minuscules, ont la forme des grandes capitales et la grosseur des lettres du bas-de-casse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
