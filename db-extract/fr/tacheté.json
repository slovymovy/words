                "senses": [
                    {
                        "sense_id": "e7b83467-20c6-309c-bcce-682ca9583a34",
                        "entry_id": "8fb1bcd5-6a23-372e-a821-a392482c818d",
                        "glosses": [
                            "Marqué de diverses taches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35bf1d3e-b708-4040-926b-39e197003adb",
                                "sense_id": "e7b83467-20c6-309c-bcce-682ca9583a34",
                                "text": "Des fleurs tachetées de rouge."
                            },
                            {
                                "example_id": "fef6504c-a5be-49ae-9868-e647f18aaec4",
                                "sense_id": "e7b83467-20c6-309c-bcce-682ca9583a34",
                                "text": "Un chien blanc tacheté de jaune."
                            },
                            {
                                "example_id": "f3f70730-4b73-4a39-bdd9-64c8882b9fea",
                                "sense_id": "e7b83467-20c6-309c-bcce-682ca9583a34",
                                "text": "Cet homme, sans chaperon et sans veste, au regard abruti, à la barbe et aux sourcils tachetés de plâtre, c'était son père!"
                            }
                        ]
                    },
                    {
                        "sense_id": "75c22bfd-a1b6-3923-8707-2c980ede1a80",
                        "entry_id": "8fb1bcd5-6a23-372e-a821-a392482c818d",
                        "glosses": [
                            "Parsemé de taches de couleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9e5f4a7-ad2a-4341-a7f1-930daa1ccd23",
                                "sense_id": "75c22bfd-a1b6-3923-8707-2c980ede1a80",
                                "text": "Ici, on dort d'un sommeil parfumé, tacheté de soleil et d'ombres."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f8d6041-538b-358a-b94a-ecb79e34eb65",
                        "entry_id": "8fb1bcd5-6a23-372e-a821-a392482c818d",
                        "glosses": [
                            "Bariolé, coloré."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ecd1f346-bd24-4c99-a2eb-ee26b040cfed",
                                "sense_id": "0f8d6041-538b-358a-b94a-ecb79e34eb65",
                                "text": "Cette langue tachetée et superbe que parlèrent Claudien, Rutilius et Ausone."
                            }
                        ]
                    }
                ],
