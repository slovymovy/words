                                        "entry_id": "d9f5147d-a0e5-37ef-a256-76d391eb1180",
                                        "glosses": [
                                            "Zone périplanétaire en forme de bulle allongée, engendrée par le vent solaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e880ea24-168d-4258-bd07-02aa5e5c4b4b",
                                                "sense_id": "af6eddd7-500c-3d88-92bc-d238bfd9bb28",
                                                "text": "L’héliosphère, grosse bulle créée par le vent solaire et le champ magnétique de notre étoile, englobe les planètes et le Soleil. Elle s’étend à partir de celui-ci dans toutes les directions sur une distance d'environ 115 UA."
                                            }
                                        ]
                                    }
                                ]
                            }
