                                        "sense_id": "f313e98c-8f60-36ed-a67a-4b5aac475758",
                                        "entry_id": "8a85ec65-b814-3261-b8b5-d201e1d50f93",
                                        "glosses": [
                                            "Participe passé masculin singulier de détecter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5330891-2a3f-4fc2-bd2c-5bc2a46470b6",
                                                "sense_id": "f313e98c-8f60-36ed-a67a-4b5aac475758",
                                                "text": "On a détecté sa présence sur des secteurs où l’eau est de très moyenne qualité, à l’image du Gouessant (Côtes-d'Armor)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa15d40f-9434-4b41-9c0c-777ad8be8718",
                        "source_entry_id": "8e21d94b-2fea-343c-8892-99af93cd6edc",
                        "source_sense_id": "252aab5a-0df7-3cea-89a5-d203c27ff695",
                        "source_sense_description": "Referring to something that has been noticed",
                        "target_lang_word": "entdecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entdecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa41584-1e80-3990-9d9f-48d16f8d42ef",
                                        "entry_id": "a1e2ad90-246d-3c01-bb45-5edcf09bbb92",
                                        "glosses": [
                                            "jemanden oder etwas erstmals finden, herausfinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46cee957-76fc-4ddd-9798-59550fc42a80",
                                                "sense_id": "5fa41584-1e80-3990-9d9f-48d16f8d42ef",
                                                "text": "Clyde Tombaugh entdeckte 1930 den Pluto."
                                            },
                                            {
                                                "example_id": "42c8ab90-6cbd-461f-91a6-14653fb3d79f",
                                                "sense_id": "5fa41584-1e80-3990-9d9f-48d16f8d42ef",
                                                "text": "Der Schotte John Napier entdeckte die Logarithmen und erfand das Rechnen mit Logarithmentafeln."
                                            },
                                            {
                                                "example_id": "3b67948f-223f-4d9f-b469-36ec22b8877f",
                                                "sense_id": "5fa41584-1e80-3990-9d9f-48d16f8d42ef",
                                                "text": "„Die großen Reiche Asiens – die Osmanen, Perser, Moguln und Chinesen – bekamen sehr bald mit, dass die Europäer einen neuen Kontinent entdeckt hatten.“"
                                            },
                                            {
                                                "example_id": "b89d21ee-a226-4ead-9398-70c69cf3f841",
                                                "sense_id": "5fa41584-1e80-3990-9d9f-48d16f8d42ef",
                                                "text": "„Wissenschaftler haben im Nordostatlantik bereits mehr als 1.000 Fässer mit Atommüll entdeckt, die verschiedene Staaten dort vor Jahrzehnten entsorgt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c0bc4fe0-3f87-3a22-ba8b-93401967da00",
                                        "entry_id": "a1e2ad90-246d-3c01-bb45-5edcf09bbb92",
                                        "glosses": [
                                            "sich jemandem gegenüber offenbaren"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f18e75d-8058-4a73-84e5-d13ed819f26b",
                                                "sense_id": "c0bc4fe0-3f87-3a22-ba8b-93401967da00",
                                                "text": "In der Pubertät entdeckt man sich selbst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f652f75-0d24-4c76-8144-cb1f6f0f8e11",
