                        "glosses": [
                            "een Chinese behandelingsmethode waarbij, ter genezing van een kwaal of ter bestrijding van pijn, op bepaalde plaatsen naalden in de huid worden gestoken"
                        ],
                        "tags": [],
                        "examples": [
