                        "examples": [
                            {
                                "example_id": "ea4d856d-c444-4d49-bd83-6ea6dd2af976",
                                "sense_id": "5490e371-4384-3abc-b51a-5992be9a705e",
                                "text": "Zijn eerste aanvechting was om zo snel mogelijk naar het strand te zwemmen, of tenminste naar een plek waar hij de zeebodem weer kon zien, maar na een paar minuten werd zijn ademhaling al rustiger."
                            },
                            {
                                "example_id": "95f9013a-6be9-4c81-8ffa-24983f6a66cc",
                                "sense_id": "5490e371-4384-3abc-b51a-5992be9a705e",
                                "text": "De aanvechting om simpelweg weg te lopen en te doen alsof ze de hele scène nooit had gezien, had ze succesvol onderdrukt."
                            }
                        ]
                    }
                ],
