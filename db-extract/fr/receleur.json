                        ],
                        "form": "recéleur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                        "entry_id": "4a32ddc2-a7c7-38cc-afbf-ebb23318b4c2",
                        "glosses": [
                            "Celui qui recèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83533774-491f-4684-8426-7fec758622b3",
                                "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                                "text": "Il y avait autrefois peine de mort contre les receleurs."
                            },
                            {
                                "example_id": "d107e4c2-aeb6-4b7c-b221-9cb171133f18",
                                "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                                "text": "On a découvert le receleur des objets volés."
                            },
                            {
                                "example_id": "7cc23411-e47c-4280-b7ca-6fa651a3f97d",
                                "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                                "text": "Elle a été punie comme receleuse."
                            },
                            {
                                "example_id": "a5bef364-59e6-45df-8254-a8f0943ea991",
                                "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                                "text": "S’il n’y avait point de receleurs, il n’y aurait point de voleurs."
                            },
                            {
                                "example_id": "21dd045f-f275-4662-8654-248e66044cd8",
                                "sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                                "text": "Professionnel des affaires véreuses, le receleur est un personnage dangereux que le législateur a constamment cherché à frapper sévèrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45620862-b800-4532-a183-7d34fed78c6e",
                        "source_entry_id": "4a32ddc2-a7c7-38cc-afbf-ebb23318b4c2",
                        "source_sense_id": "3f056694-f417-3ba1-8400-33b4aa6f78a2",
                        "target_lang_word": "Hehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                        "entry_id": "b87801c3-aa1d-3f35-a3ca-dd9088ed5f58",
                                        "glosses": [
                                            "Person, die gestohlenes Gut verkauft oder anders verwertet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1759e2ca-a285-41e5-aa5c-7163ad10ec8f",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "Auch wer gestohlene Sachen unwissentlich billig kauft und dann weiterverkauft, kann als Hehler bestraft werden."
                                            },
                                            {
                                                "example_id": "a1ca09d1-75c4-4a75-bfa3-ff4bec992a31",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "„Stevenson erfaßte statt seiner den Sohn, der ebenfalls herbeigesprungen war, den Verbrecher zu halten; ein zweiter Blitz verriet ihnen aber die fliehende Gestalt des Hehlers, und auch Weston, den die erste Überraschung fast gelähmt hatte, floh der Stelle zu, auf der sie eben die Umzäunung betreten.“"
                                            },
                                            {
                                                "example_id": "dbbfc3f0-fe3b-43f0-ae1d-aced03a6c122",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "„Luigi sah aus wie der Schauspieler Orson Welles, betrieb ein kleines, schmutziges Freßlokal und war außerdem Hehler, Fälscher und Bandenchef.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14881097-2f77-40ad-a287-611901e6c423",
                        "source_entry_id": "4a32ddc2-a7c7-38cc-afbf-ebb23318b4c2",
