                    {
                        "form_id": "1a0131f9-02b6-40d6-999e-726f53554a9d",
                        "entry_id": "5d797c2b-07c4-34aa-ac68-cf7975e5d790",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Gemeinderat"
                    },
                    {
                        "form_id": "eca9342d-0947-43e6-845e-18c4e2516079",
                        "entry_id": "5d797c2b-07c4-34aa-ac68-cf7975e5d790",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gemeinderäte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
                        "entry_id": "5d797c2b-07c4-34aa-ac68-cf7975e5d790",
                        "glosses": [
                            "Organ mit exekutiven Aufgaben, das eine Gemeinde vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5556a6b3-191f-44dd-abd1-b3f08c4691f6",
                                "sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
                                "text": "„Der Gemeinderat kann zur Erleichterung seiner Aufgaben vorberatende Ausschüsse einsetzen.“"
                            },
                            {
                                "example_id": "f67301e2-cb94-44cb-9e0a-76c03862debb",
                                "sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
                                "text": "„Der Gemeinderat jedoch hält an der Hotelanlage fest: Einstimmig votierten die Kommunalpolitiker dafür, die Planungen fortzusetzen.“"
                            },
                            {
                                "example_id": "bb4c1546-5e99-4edf-b756-ac381c0e0d52",
                                "sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
                                "text": "„Er ist Mitglied im Gemeinderat und im Vorstand der evangelischen Kirchengemeinde; gelegentlich hält er die Sonntagspredigt, weil der Pfarrer frühzeitig senil und unfähig geworden ist.“"
                            },
                            {
                                "example_id": "11eaf021-a1fb-43d7-953a-0478d49f59b6",
                                "sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
                                "text": "„Sie trafen ihn in seinem Gärtchen, wo er die Mitglieder des Gemeinderats erwartete, die gerade zusammentreten sollten, um über die Anschaffung eines Meßgewandes zu beraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a32e1f30-dcbe-3c58-9661-3f10c955b438",
                        "entry_id": "5d797c2b-07c4-34aa-ac68-cf7975e5d790",
                        "glosses": [
                            "Mitglied des Gemeinderats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0501e57-4404-46ae-9b67-80719c1751dd",
                                "sense_id": "a32e1f30-dcbe-3c58-9661-3f10c955b438",
                                "text": "„Hier konterte Gemeinderat Hans-Peter Wich mit dem Argument, dass auch bei einer Kreditaufnahme letztlich noch ein gewisser Ertrag erwirtschaftet werden könne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87b093a1-e58b-4dad-a4e7-42acda2a3e42",
                        "source_entry_id": "5d797c2b-07c4-34aa-ac68-cf7975e5d790",
                        "source_sense_id": "ba02369a-f538-311f-bb9c-7b6e961dc314",
