                    {
                        "translation_id": "4b6d2df4-e1e6-4131-9417-97635e5423a3",
                        "source_entry_id": "0e6b7f91-e670-3e03-ad33-e45efac0b51e",
                        "source_sense_id": "826621f8-f5e0-3154-8b2f-c479bd131cc8",
                        "target_lang_word": "Eschatologie",
                        "target_lang_code": "de",
