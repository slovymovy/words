                                        "entry_id": "d77b9979-947e-30c3-909e-28f66cbc5ca6",
                                        "glosses": [
                                            "jemanden oder etwas illegal über eine Staatsgrenze oder durch eine Kontrolle bringen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0970acd-d06e-42af-9252-a671641626ec",
                                                "sense_id": "83ebce88-a458-3d5d-93d5-06ddc2e8ea22",
                                                "text": "Das Geld war ihm gezahlt worden, um einen Mann aus Somalia illegal nach München zu schleusen."
                                            },
                                            {
                                                "example_id": "e84fd871-2ee6-4e08-a912-f62b31cde8f6",
                                                "sense_id": "83ebce88-a458-3d5d-93d5-06ddc2e8ea22",
                                                "text": "Er schleuste in diesen Jahren Hunderte ins sichere Ausland."
                                            },
                                            {
                                                "example_id": "07659962-382e-4987-aa02-85998ec143dc",
                                                "sense_id": "83ebce88-a458-3d5d-93d5-06ddc2e8ea22",
                                                "text": "Ich weiß nicht, wie ich die Blumen durch den Zoll schleusen soll, Pflanzen zu importieren ist doch verboten, oder?"
                                            }
