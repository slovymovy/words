                "senses": [
                    {
                        "sense_id": "42fda2b0-5efb-3fac-bddd-32db6d2ec422",
                        "entry_id": "b9e20b3e-6683-3335-aaa4-c0cf747e364c",
                        "glosses": [
                            "Ort, der erreicht werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8343ca51-5fc9-44a2-b226-ffa83d8ad80a",
                                "sense_id": "42fda2b0-5efb-3fac-bddd-32db6d2ec422",
                                "text": "Die Sendung hat ihren Bestimmungsort nie erreicht."
                            },
                            {
                                "example_id": "8081bbb5-6f43-480d-ac9d-0c384daadec8",
                                "sense_id": "42fda2b0-5efb-3fac-bddd-32db6d2ec422",
                                "text": "„Ihr Bestimmungsort war Oldenburg in Niedersachsen, eine Stadt in der britischen Besatzungszone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
