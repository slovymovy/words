                "senses": [
                    {
                        "sense_id": "30b6a619-f43c-3577-96c2-f0071c4a9e9c",
                        "entry_id": "94a0d2b8-41e8-3552-8623-d83a12e683f9",
                        "glosses": [
                            "Faire perdre son caractère économique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f708a4-5ca8-42f1-a865-a662879f93e8",
                                "sense_id": "30b6a619-f43c-3577-96c2-f0071c4a9e9c",
                                "text": "Les « sociologues » allemands, après l’intermède que constituent le « Socialisme de la chaire » et l’ « Organicisme », vont donc s’employer à déséconomiser et déshistoriser la société."
                            },
                            {
                                "example_id": "ae5da6d0-1324-4b92-a3c3-404febeb67b1",
                                "sense_id": "30b6a619-f43c-3577-96c2-f0071c4a9e9c",
                                "text": "Foucault nous invite donc à « déséconomiser » des notions telles que marché, entreprise, information, règle, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7fdb0ac-fa3c-337c-a581-38035160cee2",
                        "entry_id": "94a0d2b8-41e8-3552-8623-d83a12e683f9",
                        "glosses": [
                            "Ne plus s’économiser."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "1eb99277-44df-4cd7-bc6f-ed120251429d",
                                "sense_id": "c7fdb0ac-fa3c-337c-a581-38035160cee2",
                                "text": "Êtes-vous prêts à vous déséconomiser ?"
                            }
                        ]
                    }
