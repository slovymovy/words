                ],
                "senses": [
                    {
                        "sense_id": "1a93e611-3a56-3520-a982-7e0dce42e348",
                        "entry_id": "0e285077-531e-3a95-a438-3a219dd11ab1",
                        "glosses": [
                            "weites Gebiet, offenes Feld; Flur, Gefilde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f4f3afc-2b34-49c4-a5bd-a154626304d9",
                                "sense_id": "1a93e611-3a56-3520-a982-7e0dce42e348",
                                "text": "„Step rozmókł i zmienił się w wielką kałużę, słońce zaś w południe dogrzewało tak mocno, że — dziw nad dziwy! — w województwie bracławskiem i na Dzikich polach zielona ruń okryła stepy i rozłogi już w połowie grudnia.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0998c2b0-07c7-3f21-959c-33d34e712488",
                        "entry_id": "0e285077-531e-3a95-a438-3a219dd11ab1",
                        "glosses": [
                            "Ausläufer"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1abdf1cd-b740-42fb-b50e-ea1aa692fac2",
                        "source_entry_id": "0e285077-531e-3a95-a438-3a219dd11ab1",
                        "source_sense_id": "1a93e611-3a56-3520-a982-7e0dce42e348",
                        "source_sense_description": "weites Gebiet, offenes Feld; Flur, Gefilde",
                        "target_lang_word": "Flur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                        "entry_id": "5be18533-9588-3118-a26e-d026e0eb6152",
                                        "glosses": [
                                            "Raum zwischen Hauseingang und Treppenhaus oder zwischen Haustür und Wohnbereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4698b56-29ec-417f-ae27-d38e69d58c36",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "Da steht ein Pferd auf'm Flur! – (Schlager)"
                                            },
                                            {
                                                "example_id": "db097e3f-216d-4ea7-a73c-0285859b4807",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "Die Garderobe ist im Flur."
                                            },
                                            {
                                                "example_id": "9406e6c2-5b05-438e-af6f-524d96a6ea25",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "„Jetzt muß sie im ersten Stockwerk innehalten, ihre Hand wird im Dunkel des Flurs nach den Bogen des gewellten Geländers tasten, ihr Fuß die schiefe, ausgetretene Treppe suchen, die zum zweiten Stockwerk führt.“"
                                            },
                                            {
                                                "example_id": "3431be3a-3f79-4a22-b636-a330977eb37f",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "„Der Flur führte von der Haustür direkt in die Küche und weiter bis ins Schlafzimmer.“"
                                            },
                                            {
                                                "example_id": "5726f99f-cc23-478f-b7fb-2f6c4b10ace5",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "„Ich machte die Tür zu, ging den Flur runter und raus zu meinem Wagen, stieg ein und ließ den Motor an.“"
                                            },
                                            {
                                                "example_id": "88cf83df-6b5f-4420-ac65-d8961af48736",
                                                "sense_id": "0188e3a2-a000-37ec-bec7-fb232d3f35e4",
                                                "text": "„Manchmal bin ich versucht, den Reißverschluss der Tasche zuzuziehen, wenn ich sie im Flur stehen sehe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c57b14d2-ef6c-3fde-9333-cf8cd6dc9c84",
                                        "entry_id": "5be18533-9588-3118-a26e-d026e0eb6152",
                                        "glosses": [
                                            "langer Gang in öffentlichen Gebäuden, von denen die einzelnen Dienstzimmer abgehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8b1649-be75-45c7-89ea-70182cff31f0",
                                                "sense_id": "c57b14d2-ef6c-3fde-9333-cf8cd6dc9c84",
                                                "text": "Sie ging den ganzen Flur hinunter bis zum letzten Zimmer auf der rechten Seite."
                                            },
                                            {
                                                "example_id": "c6bb9870-d160-48c1-a335-a75d0116edcf",
                                                "sense_id": "c57b14d2-ef6c-3fde-9333-cf8cd6dc9c84",
                                                "text": "Sie können gerne auf dem Flur warten, während ich ihnen die Angaben heraussuche."
                                            },
                                            {
                                                "example_id": "7a756054-dae7-4b84-a171-1784a5cf8e55",
                                                "sense_id": "c57b14d2-ef6c-3fde-9333-cf8cd6dc9c84",
                                                "text": "„Im Spital lagen die Verletzten bis auf die Flure.“"
                                            },
                                            {
                                                "example_id": "bf163746-8e0a-4211-9445-36d48be9d383",
                                                "sense_id": "c57b14d2-ef6c-3fde-9333-cf8cd6dc9c84",
                                                "text": "„Immer wieder kamen Zöllner herein, immer wieder ging der, der sie verhörte, hinaus, und schließlich wurde sie auf den Flur geschickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Flur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "936ebf37-821d-3f05-b801-27d3abea9a9e",
                                        "entry_id": "e8fd2934-05f4-37e8-a645-29cc90b97e58",
                                        "glosses": [
                                            "Fläche, die landwirtschaftlich genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
