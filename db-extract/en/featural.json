                "senses": [
                    {
                        "sense_id": "6ff2970a-50ce-3c03-bb8a-c0367944a819",
                        "entry_id": "433dc868-9667-397e-b8c2-7fb57986e86b",
                        "glosses": [
                            "Of or pertaining to features."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "96fbd6ef-93ad-47d7-8938-b196c8baea87",
                                "sense_id": "6ff2970a-50ce-3c03-bb8a-c0367944a819",
                                "text": "As Xu and Carey have shown, while children may be aware of property or featural distinctions between objects, they do not use them to distinguish unique individuals (Xu and Carey 1996)."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2b6cfe2-ba25-3254-8e83-60a3172ebc9d",
                        "entry_id": "433dc868-9667-397e-b8c2-7fb57986e86b",
                        "glosses": [
                            "Being or relating to a writing system whose symbols encode phonological features of the sounds that they correspond to."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc5d7c3e-173d-4428-a454-57ef7cff6c43",
                                "sense_id": "b2b6cfe2-ba25-3254-8e83-60a3172ebc9d",
                                "text": "As a featural alphabet, Hangeul bears some similarities with scientifically created writing systems invented centuries later, such as the Visible Speech system invented by Alexander Melville Bell."
                            },
                            {
                                "example_id": "8ece25ca-8bf4-49dd-8200-dc5c522259d6",
                                "sense_id": "b2b6cfe2-ba25-3254-8e83-60a3172ebc9d",
                                "text": "Because of its systematic categorization of sounds, with corresponding graphic interpretation, some linguists have come to consider han'gŭl a \"featural\" system."
                            },
                            {
                                "example_id": "8a5e4996-18ab-4b42-85d7-eb0386cbeaf7",
                                "sense_id": "b2b6cfe2-ba25-3254-8e83-60a3172ebc9d",
                                "text": "The same author also cites Pitman's shorthand as an example of a ‘featural’ writing system ."
                            }
                        ]
                    }
                ],
