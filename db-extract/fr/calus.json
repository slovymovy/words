        "fr-extract.jsonl": [
            {
                "entry_id": "17e54a68-a9c6-3845-8dcf-87bd82371aa4",
                "word": "calus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c2042ab-6d60-324e-a857-5bf0a525439b",
                        "entry_id": "17e54a68-a9c6-3845-8dcf-87bd82371aa4",
                        "glosses": [
                            "Durillon produit par le frottement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feee32cf-f9e8-4707-9f0c-944f90f7c2da",
                                "sense_id": "8c2042ab-6d60-324e-a857-5bf0a525439b",
                                "text": "Le seul produit de la terre cultivée par des mains laborieuses, endurcies de calus et mouillées de larmes, doit des tributs à la puissance législatrice et exécutrice."
                            },
                            {
                                "example_id": "d1628cf1-3f55-4179-897e-5155ee3b715a",
                                "sense_id": "8c2042ab-6d60-324e-a857-5bf0a525439b",
                                "text": "Et on le battait en disant : « Je te rends le mal ». Son corps était couvert de calus et de cicatrices."
                            },
                            {
                                "example_id": "e70fbc99-4c9d-42cf-8cfe-915aa2346e82",
                                "sense_id": "8c2042ab-6d60-324e-a857-5bf0a525439b",
                                "text": "Elle prend ma main dans sa main, et elle la presse. C’est la première fois de sa vie.\nJe ne connaissais que le calus de ses doigts, l’acier de ses yeux et le vinaigre de sa voix : en ce moment, elle eut une minute d’abandon, un accès de tendresse, une faiblesse d’âme, elle laissa aller doucement sa main et son cœur."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a623ed9-cca5-3885-9644-134a2f7a0d52",
                        "entry_id": "17e54a68-a9c6-3845-8dcf-87bd82371aa4",
                        "glosses": [
                            "Endurcissement de cœur."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "46d368b4-a6a7-4379-998a-9c2fbe9896cc",
                                "sense_id": "0a623ed9-cca5-3885-9644-134a2f7a0d52",
                                "text": "Les souffrances de la misère, au lieu de lui attendrir le cœur, y avaient fait des calus."
                            },
                            {
                                "example_id": "c6ca9fa5-cfb5-478d-95fe-bb467ee0de48",
                                "sense_id": "0a623ed9-cca5-3885-9644-134a2f7a0d52",
                                "text": "Peut-être ne parvient-on à rien sans s'être fait des calus aux endroits les plus sensibles du cœur."
                            },
                            {
                                "example_id": "e5e8cc57-144b-48fc-b648-ffee6f80e30d",
                                "sense_id": "0a623ed9-cca5-3885-9644-134a2f7a0d52",
                                "text": "Elles n’étaient pas de ces désœuvrées qui proscrivent, comme déshonorant, le saint calus du travail, et n’en rougissaient point."
                            }
                        ]
                    },
                    {
                        "sense_id": "1921a1f7-3e7a-3376-924e-0cedecd1db05",
                        "entry_id": "17e54a68-a9c6-3845-8dcf-87bd82371aa4",
                        "glosses": [
                            "Cal, sorte de soudure qui réunit les fragments d’un os."
                        ],
