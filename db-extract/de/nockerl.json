                "senses": [
                    {
                        "sense_id": "4389d578-0fcd-3daa-becd-ab322f106b4c",
                        "entry_id": "bd22c8d2-1800-3ca5-abce-190f42baa6b1",
                        "glosses": [
                            "mit einem Löffel aus einer süßen oder salzigen Masse Gestochenes, das eine typische Form hat"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "2222829e-660f-4e7f-b0a9-d20e2c730387",
                                "sense_id": "4389d578-0fcd-3daa-becd-ab322f106b4c",
                                "text": "Nockerl sind eine beliebte Suppeneinlage."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52a54cb7-8d09-3004-8522-20dfa358baf7",
                        "entry_id": "bd22c8d2-1800-3ca5-abce-190f42baa6b1",
                        "glosses": [
                            "Beilage zu Speisen mit Sauce; aus Mehl und Wasser beziehungsweise Mehl, Eiern, Fett und Milch, die durch ein Nockerlsieb in kochendes Wasser gedrückt werden und jeweils eine Größe von circa 1 cm erreichen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "e9688c0c-c95e-4ad8-83d2-d7c614c4aa15",
                                "sense_id": "52a54cb7-8d09-3004-8522-20dfa358baf7",
                                "text": "Es hat Paprikahendel mit Nockerl gegeben."
                            },
                            {
                                "example_id": "f4582660-9aa1-4596-8969-7a1130d64e30",
                                "sense_id": "52a54cb7-8d09-3004-8522-20dfa358baf7",
                                "text": "Mit dem nachträglichen Zufügen anderer Zutaten wird aus einfachen Nockerln eine Hauptspeise."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dd9370e3-3eea-30b2-a9c5-9b4b64ab9748",
                        "entry_id": "bd22c8d2-1800-3ca5-abce-190f42baa6b1",
