                                    {
                                        "sense_id": "e8102293-e6dc-3f8f-82e7-e03ec5a90194",
                                        "entry_id": "3f00d7c9-b1d8-352a-a9ac-6a8a5541c2ea",
                                        "glosses": [
                                            "Lugar donde se reúne el ganado para llevarlo a los mercados."
                                        ],
                                        "tags": [],
