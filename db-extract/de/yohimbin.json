                                        "glosses": [
                                            "A toxic crystalline compound obtained from the bark of the yohimbe tree, used as an adrenergic blocking agent and also as an aphrodisiac in the treatment of impotence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d2450f-0376-4d14-864e-74390081e9c5",
                                                "sense_id": "4a0eb4f7-c1c5-329b-90ca-662ce806eb70",
                                                "text": "Aphrodisin: A proprietary preparation compounded of the aphrodisiac yohimbine, together with aronacein, extract of miura puama, and other ingredients."
                                            }
                                        ]
                                    }
                                ]
