                        "target_lang_word": "dose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69e81d88-9208-30a2-a80f-899036f5a5f0",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "A measured portion of medicine taken at any one time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5ed8d77-1617-41ed-bc92-85ab87f3fabb",
                                                "sense_id": "69e81d88-9208-30a2-a80f-899036f5a5f0",
                                                "text": "Why did he give you only a single 500 mg dose? The correct dosage of this antibiotic is one 500 mg tablet twice a day for 10 days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05a2ee37-e821-30bf-ab75-1251962dedb0",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "The quantity of an agent (not always active), substance, or radiation administered or experienced at any one time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92995042-e845-47ce-92c2-7317fbdca27a",
                                                "sense_id": "05a2ee37-e821-30bf-ab75-1251962dedb0",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death. Nowadays workers are exposed to far lower doses and manganism is rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049ceab5-0c49-3921-9cb1-5795019535b6",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "Anything disagreeable that must be taken."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43c05df8-348b-354d-81c5-0f861d388aea",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "A good measure or lengthy experience of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "728c34a4-05b7-46fa-8042-876e35552a63",
                                                "sense_id": "43c05df8-348b-354d-81c5-0f861d388aea",
                                                "text": "“I had then, as you remember, just returned to London after a lot of Indian Ocean, Pacific, China Seas - a regular dose of the East - six years or so, and I was loafing about, hindering you fellows in your work and invading your homes, just as though I had got a heavenly mission to civilise you.”"
                                            },
                                            {
                                                "example_id": "195669be-4ae9-4bc3-b88b-3828f959c93d",
                                                "sense_id": "43c05df8-348b-354d-81c5-0f861d388aea",
                                                "text": "The prospect of becoming a father is a dose of reality that threatens to bring his dream world crashing down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25bab59b-b57c-3ed1-9127-eee39bd2c56c",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "A venereal infection."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6b1516-f74e-4b94-aa46-b503912efd0d",
                                                "sense_id": "25bab59b-b57c-3ed1-9127-eee39bd2c56c",
                                                "text": "Don't give a dose to the one you love most. / Give her some marmalade... give her some toast."
                                            },
                                            {
                                                "example_id": "1b3b5d67-cae3-47e8-b8cd-319e11432117",
                                                "sense_id": "25bab59b-b57c-3ed1-9127-eee39bd2c56c",
                                                "text": "It would be very expensive to cure a dose here, as well as unbelievably painful."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7312f202-e3b8-334f-b031-6e5e534df6dd",
                                        "entry_id": "416073b0-05de-3aad-9cc2-609d221f56ee",
                                        "glosses": [
                                            "A cold; a common, viral illness of the nasal passage, sometimes with fever."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d186497-1c35-4e44-803d-250583d00552",
                                                "sense_id": "7312f202-e3b8-334f-b031-6e5e534df6dd",
                                                "text": "There's a dose going round."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb901ce-4e55-308f-9bde-5fd9ca55a316",
                                        "entry_id": "d8143cc8-799c-34ca-89a0-1466c810dc77",
                                        "glosses": [
                                            "To administer a dose (of medicine) to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82ecdc87-75e4-4386-a683-1d5d0212e429",
                                                "sense_id": "cdb901ce-4e55-308f-9bde-5fd9ca55a316",
                                                "text": "\"She thought herself broad awake, and I have dosed her with an opiate.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6072f3-4c5b-34fb-9a65-83d137af7b9a",
                                        "entry_id": "d8143cc8-799c-34ca-89a0-1466c810dc77",
                                        "glosses": [
                                            "To prescribe a dose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08682b0c-4350-3349-8ae8-ac370007800e",
                                        "entry_id": "d8143cc8-799c-34ca-89a0-1466c810dc77",
                                        "glosses": [
                                            "To surreptitiously administer a dose of an incapacitating drug (to an unwilling subject); to roofie."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2994366-28d8-4e70-90f4-132a181a2978",
                                                "sense_id": "08682b0c-4350-3349-8ae8-ac370007800e",
                                                "text": "The defense never conceded that their clients had administered chloral [hydrate], but Death and Campbell said initially—during their contested station house confessions—that McAlister had dosed [Jennie Bosschieter's] drink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4f63972-22b5-34ae-bdfe-a7ce2dbeb938",
                                        "entry_id": "d8143cc8-799c-34ca-89a0-1466c810dc77",
                                        "glosses": [
                                            "To transmit a venereal disease to."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bba969db-1cfb-4b55-9c71-95ea22843a75",
                                                "sense_id": "d4f63972-22b5-34ae-bdfe-a7ce2dbeb938",
                                                "text": "Sometime back, one of your scarlet sisters dosed me proper."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67f30cc6-ea73-393e-b4a2-e9bfbbbc9170",
                                        "entry_id": "78d3c4fe-78af-30d4-8a96-9d3951c0d41f",
                                        "glosses": [
                                            "Archaic form of doze."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644d589c-4602-429b-a560-f15799ab04bc",
                                                "sense_id": "67f30cc6-ea73-393e-b4a2-e9bfbbbc9170",
                                                "text": "Just at the dawning of the day, I fell into a dose more like sleep than any I had during the whole night, in which I dreamed that I saw a river as clear as crystal […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a12a6dbc-29e7-3036-bf36-526994db6b3f",
                                        "entry_id": "7f3f34d6-ce10-31e6-a1b1-bce8f62efcba",
                                        "glosses": [
                                            "Archaic form of doze."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d680ccb-5707-4bda-9228-6502648a65bb",
                                                "sense_id": "a12a6dbc-29e7-3036-bf36-526994db6b3f",
                                                "text": "It was to me a marvellous experience; to be here, propped up with pillows in a dimly-lighted room, the night-nurse idly dosing by the fire; the sound of the everlasting wind in my ears, howling outside […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de37ab89-91ad-43d7-95eb-a45fa65ac3ed",
                        "source_entry_id": "48b9a265-1a52-32a8-9b4b-4010e80672e8",
                        "source_sense_id": "d2254d13-6292-3623-8d74-7029e20e8bc5",
                        "source_sense_description": "hoeveelheid van een geneesmiddel die je per keer moet innemen",
                        "target_lang_word": "dose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a166e176-e76e-3e9b-bdcf-fa87eaeb5edf",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité et proportion déterminées des ingrédients qui entrent dans la composition d’un remède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91af6e3d-a643-4d0b-8b79-23ea518a74c5",
                                                "sense_id": "a166e176-e76e-3e9b-bdcf-fa87eaeb5edf",
                                                "text": "Le dawamesk, assez agréable au goût, se prend à la dose de 30 grammes, soit dissous dans une tasse de café à l’eau , soit en nature et sans aucune préparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b2fc30-09dc-36e1-85d7-53ec6e62eff6",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité d’un médicament que l’on en doit prendre en une fois."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab9ef2df-b799-4fb9-92f9-9cc08a06fb86",
                                                "sense_id": "d9b2fc30-09dc-36e1-85d7-53ec6e62eff6",
                                                "text": "dose prescrite : quantité de médicaments que l’on doit prendre à chaque prise."
                                            },
                                            {
                                                "example_id": "1dd0673c-3542-4ea3-9af7-2eadbf1d4836",
                                                "sense_id": "d9b2fc30-09dc-36e1-85d7-53ec6e62eff6",
                                                "text": "Vous ne soignerez pas votre animal mieux ni plus vite en lui donnant plus de médicament que la dose exacte qu’il lui faut. Beaucoup de médicaments sont vendus avec les doses déjà calculées."
                                            },
                                            {
                                                "example_id": "767e0152-ba2c-480d-bbf2-dc4f1841ebb0",
                                                "sense_id": "d9b2fc30-09dc-36e1-85d7-53ec6e62eff6",
                                                "text": "À l’heure où nous écrivons ces lignes, 42,8 millions de Français ont reçu au moins une dose de vaccin contre la Covid-19."
                                            },
                                            {
                                                "example_id": "2ea979ec-7271-4cbd-a9ea-2f0794deb85a",
                                                "sense_id": "d9b2fc30-09dc-36e1-85d7-53ec6e62eff6",
                                                "text": "Après deux doses du vaccin de Pfizer-BioNTech, les \"preuves d'infection\" (détectées par les tests PCR) diminuent de 92%, selon une grande étude israélienne (en anglais) menée en février sur 1,2 million de patients."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97aa5722-2d2a-3ce7-be75-c576dbb4c2ea",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité d’un médicament que l’on en doit prendre en une fois.",
                                            "Quantité d’un médicament — comme un pesticide — que l’on en met en une fois dans les cultures."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8542933-c40b-430a-bb59-1f8f56df2a28",
                                                "sense_id": "97aa5722-2d2a-3ce7-be75-c576dbb4c2ea",
                                                "text": "Le grand avantage du D.D. dans les cultures maraîchères semble être que l’on peut traiter à des doses élevées qui permettent d’obtenir des pépinières bien désinfectées, ce qui empêche une infestation des planches saines par transplantation de plantules déjà infectées."
                                            },
                                            {
                                                "example_id": "33944bf4-2744-481e-ae1c-6333b45b2601",
                                                "sense_id": "97aa5722-2d2a-3ce7-be75-c576dbb4c2ea",
                                                "text": "Dans son message du 19 avril, l’Institut betteravier recommande d’augmenter de 25% la dose de phenmédiphame (type Betanal), en fonction du stade de la betterave."
                                            },
                                            {
                                                "example_id": "3256be5d-9ecb-45a3-aa6c-b86b5d66dccc",
                                                "sense_id": "97aa5722-2d2a-3ce7-be75-c576dbb4c2ea",
                                                "text": "Ces diverses opérations pourraient être complétées par l’épandage de scories pulvérulentes à faible dose qui continueraient l’action de la chaux ; à dose plus élevée, ces scories amèneraient la destruction des Mousses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6923f19c-d741-3c42-8db8-454414c4c190",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité de poison ou de drogue prise en une seule fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85ddcd8-b1d8-4822-9c23-ba1dc11c7d62",
                                                "sense_id": "6923f19c-d741-3c42-8db8-454414c4c190",
                                                "text": "M. Vulpian a vu que, chez des animaux empoisonnés par la strychnine, lorsque la dose de poison n’était pas trop forte, les convulsions trop énergiques, l’appareil respiratoire échappait à l’action convulsivante du poison."
                                            },
                                            {
                                                "example_id": "f6761473-b7a8-41fd-89b3-11fb65668037",
                                                "sense_id": "6923f19c-d741-3c42-8db8-454414c4c190",
                                                "text": "Ça n’était pas un gros shoot, poursuivit Goñi, une petite dose, mais assez pour se mettre à rêver merveilleusement dans un demi-sommeil. Ce qui est vraiment intéressant, c’est qu’il ne semblait pas être un consommateur régulier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51f88f0f-8fa0-38d5-801b-450c085cf94b",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité ou proportion de tout ingrédient d’un composé quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1437c1e1-3634-4634-8095-eef673cef4a3",
                                                "sense_id": "51f88f0f-8fa0-38d5-801b-450c085cf94b",
                                                "text": "Dans le métal dont on fait les cloches, on met une certaine dose de zinc."
                                            },
                                            {
                                                "example_id": "df53ed09-2cc3-44e0-8feb-4eb4c25d758b",
                                                "sense_id": "51f88f0f-8fa0-38d5-801b-450c085cf94b",
                                                "text": "La dose de sel, de poivre, qu’on doit mettre dans une sauce."
                                            },
                                            {
                                                "example_id": "adf8754b-1c97-4981-b1a8-d362e09fcd15",
                                                "sense_id": "51f88f0f-8fa0-38d5-801b-450c085cf94b",
                                                "text": "Nombeko ne tarda pas à comprendre qu’il mêlait au moins deux doses de fiction pour une dose de réalité, mais elle estimait que c’était aussi bien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da480ea9-b9b3-3043-9ab3-4946213fa377",
                                        "entry_id": "59465df8-3c97-337f-a8b6-af062cd6f01b",
                                        "glosses": [
                                            "Quantité d’énergie communiquée à un milieu par un rayonnement ionisant."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aced81c0-55aa-4045-910c-e64cfd66325b",
                                                "sense_id": "da480ea9-b9b3-3043-9ab3-4946213fa377",
                                                "text": "Tandis que la matière égrène les secondes, les prestataires se relaient sous le dôme du bâtiment réacteur, et les agents plus loin en salle des machines ou derrière les écrans de contrôle, les uns nomades, les autres sédentaires, ceux qui prennent les doses et ceux qui organisent, avec souvent entre les deux groupes des rapports compliqués."
                                            },
                                            {
                                                "example_id": "2ca71d7c-9a5a-4c53-8688-c3e2cc23b826",
                                                "sense_id": "da480ea9-b9b3-3043-9ab3-4946213fa377",
                                                "text": "Dose létale, quantité de radiations que l’on considère comme étant mortelle pour l’être humain."
                                            }
                                        ]
                                    }
                                ]
                            },
