                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bc7f06f-14f7-4fd4-b155-59127ee913b8",
                                                "sense_id": "b1fba796-f802-3ea8-a906-ff084f564482",
                                                "text": "Ce parti a des opinions nazies."
                                            },
                                            {
                                                "example_id": "73e25054-12b3-4dba-aca8-bb9cca40e13b",
                                                "sense_id": "b1fba796-f802-3ea8-a906-ff084f564482",
                                                "text": "Il a tenu des propos nazis."
                                            }
