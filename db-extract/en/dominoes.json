                    {
                        "translation_id": "1eed2389-84e3-483c-9825-f49e54e3c90e",
                        "source_entry_id": "b0411c12-1613-3bd3-83ca-6629efe5a2c6",
                        "source_sense_id": "db477673-14fa-38ce-9bf2-ef02e9eb54e3",
