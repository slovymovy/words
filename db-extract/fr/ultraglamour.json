                        "examples": [
                            {
                                "example_id": "3c895897-e2a4-4181-92e3-c2bc9dbbb792",
                                "sense_id": "27fc31b1-9a2b-3dbe-b62f-d0c7e59268a9",
                                "text": "Olivier Rousteing, chez Balmain, est loué pour « son style ultraglamour et flamboyant » qui lui a assuré le succès auprès d’un public jeune, international et connecté."
                            },
                            {
                                "example_id": "decafe4b-1d3d-4a8a-9608-43993c9c7545",
                                "sense_id": "27fc31b1-9a2b-3dbe-b62f-d0c7e59268a9",
                                "text": "Force est de constater que le couple ultraglamour est très attendu pour leurs retrouvailles à l’écran dans ce qui s’annonce comme un grand film romantique d’aventures."
                            },
                            {
                                "example_id": "aeb3cbc4-9f80-4b8f-996b-3748b51b3f16",
                                "sense_id": "27fc31b1-9a2b-3dbe-b62f-d0c7e59268a9",
                                "text": "Aujourd’hui, on fait miroiter le métier d’agent de joueurs. Dans les films, on présente le type ultraglamour, entouré de mannequins et plein d’argent."
                            }
                        ]
                    }
