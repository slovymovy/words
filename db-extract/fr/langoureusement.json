        "fr-extract.jsonl": [
            {
                "entry_id": "e499466a-a819-36a2-823a-ab519317f2a7",
                "word": "langoureusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6454c80f-c2dc-30b8-aa93-4161f5a7c4ef",
                        "entry_id": "e499466a-a819-36a2-823a-ab519317f2a7",
                        "glosses": [
                            "D’une manière langoureuse ; avec langueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59473b38-d686-43a1-ad19-bb84dfa25710",
                                "sense_id": "6454c80f-c2dc-30b8-aa93-4161f5a7c4ef",
                                "text": "Comme, en se relevant après cet exercice, ils s’aperçoivent que leurs genoux sont ankylosés, ils font intimement d’amères réflexions. Mais il leur suffit de se regarder langoureusement pour les oublier aussitôt..."
                            },
                            {
                                "example_id": "dacae3e5-2ba3-4eae-8456-e3e98dfe2db0",
                                "sense_id": "6454c80f-c2dc-30b8-aa93-4161f5a7c4ef",
                                "text": "Leur premier verre absorbé, une fille aux jambes aussi longues qu'une minute de coiffeur, vint se positionner langoureusement sur le tabouret avoisinant son collègue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1634caa5-fd96-4790-824b-0080c377f2c2",
                        "source_entry_id": "e499466a-a819-36a2-823a-ab519317f2a7",
                        "source_sense_id": "6454c80f-c2dc-30b8-aa93-4161f5a7c4ef",
                        "target_lang_word": "languishingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languishingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a64722-e5f7-3198-908b-f76e791989c3",
                                        "entry_id": "0e2a82a0-835b-3587-a985-4e4fe752dd2e",
                                        "glosses": [
                                            "In a languishing manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71f72f85-4d2e-41a6-901b-fb6098994b52",
                                                "sense_id": "f7a64722-e5f7-3198-908b-f76e791989c3",
                                                "text": "She looked languishingly at him as he danced with another woman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fd48ca7-e46e-4645-92e6-84dfbf02d76b",
                        "source_entry_id": "e499466a-a819-36a2-823a-ab519317f2a7",
                        "source_sense_id": "6454c80f-c2dc-30b8-aa93-4161f5a7c4ef",
                        "target_lang_word": "languorously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "languorously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                        "entry_id": "a5c76311-f45c-3dd5-b080-8d38c85252f6",
                                        "glosses": [
                                            "In a languorous manner; without exertion; lazily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d699f0-9f37-41eb-a6fc-b5fceb83c183",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "I stretched languorously, and then remained in bed."
                                            },
                                            {
                                                "example_id": "8c21985f-3f6a-46b6-98fb-81977ac63742",
                                                "sense_id": "2cb3bf24-9728-341b-a309-2d867bb526c3",
                                                "text": "\"I did!\" She had reached the barricades, and leaned over them languorously. \"I can't take all the credit, though, just, you know, most of it.\" She folded her arms over the edge, and kicked back both of her feet again and again. \"Somebody once told me I have a mind like a steel trap.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
