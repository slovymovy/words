                        "source_sense_id": "1330aef1-6b06-3ead-9d05-a3bfce71c84d",
                        "source_sense_description": "berg opgebouwd uit losse stenen die uit een mijn zijn gekomen als bijproduct van de mijnbouw",
                        "target_lang_word": "terril",
                        "target_lang_code": "fr",
