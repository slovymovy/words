                    {
                        "translation_id": "c4ad3fac-8ab3-426c-b9a2-dcbca8294338",
                        "source_entry_id": "3fbe9d17-3d0a-30b7-b422-9a3fa89d96b8",
                        "source_sense_id": "7c68a2c9-dd2c-329a-b2d3-5ae6cb34c85c",
                        "target_lang_word": "Kristallnacht",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kristallnacht",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6043ab-9029-34eb-82ee-f55775104314",
                                        "entry_id": "737f4a28-acd8-30f2-9a03-1c92db60f0f7",
                                        "glosses": [
                                            "The night of November 9–10, 1938, when a state-organized night of terror was staged against Jews in Germany and Austria."
                                        ],
                                        "tags": [
                                            "Nazism",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8194b0fd-8eee-4f4f-a611-388cceefc2ed",
                                                "sense_id": "7a6043ab-9029-34eb-82ee-f55775104314",
                                                "text": "The Kristallnacht was a monumental development in Nazi anti-Jewish policy for several reasons. It was the single instance of large-scale, public, and organized physical violence against Jews inside Germany before the Second World War."
                                            },
                                            {
                                                "example_id": "0e43b803-594f-41c6-bed0-0c264c0edb44",
                                                "sense_id": "7a6043ab-9029-34eb-82ee-f55775104314",
                                                "text": "This is a very dangerous drift in our American thinking. Kristallnacht was unthinkable in 1930; is its descendant “progressive” radicalism unthinkable now?"
                                            },
                                            {
                                                "example_id": "8523a888-d5c9-4318-8d10-5d4e62cc26be",
                                                "sense_id": "7a6043ab-9029-34eb-82ee-f55775104314",
                                                "text": "Arnold Schwarzenegger issued a stinging rebuke of Donald Trump on Sunday, comparing the riot at the US Capitol which the president incited to Kristallnacht, the night in November 1938 when Nazi thugs attacked Jewish Germans and their property, a harbinger of horrors to come."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
