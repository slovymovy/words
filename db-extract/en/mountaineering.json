                                    {
                                        "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                        "entry_id": "a8986773-bb02-3d0e-9fbf-3debbe475f44",
                                        "glosses": [
                                            "Sport qui consiste à faire des ascensions dans les Alpes et, par extension, dans n’importe quelles montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a7a887-d75c-4d0d-9803-d939f96be56a",
                                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                                "text": "L’alpinisme se développe de plus en plus."
                                            },
                                            {
                                                "example_id": "ba635814-1572-41a8-b000-32bd2fc88111",
                                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                                "text": "La passion, les émotions de l’alpinisme."
                                            },
                                            {
                                                "example_id": "d8e85722-84e8-4c26-b7c4-84fac491cc91",
                                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                                "text": "Les surprises, les dangers de l’alpinisme."
                                            },
                                            {
                                                "example_id": "8b1ae4a4-4448-4bff-b93d-82ce68b6fdbb",
                                                "sense_id": "02280c90-c81d-34c7-bd2d-bc5456304c0c",
                                                "text": "Lʼalpinisme nʼest plus maintenant quʼune question dʼargent et dʼorganisation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f526d6c-1fb0-40b9-8fc2-a26df81ca058",
                        "source_entry_id": "c4f937ff-da28-3722-bc6c-116eb057e227",
                        "source_sense_id": "324f3a1e-18e1-379d-9ec8-a1b643f59092",
                        "source_sense_description": "sport",
                        "target_lang_word": "Bergsteigen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bergsteigen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58d6944e-5264-3227-ad13-b5265fd83a28",
                                        "entry_id": "79c8a57e-21c7-3d5e-8489-fa43cc5b3455",
                                        "glosses": [
                                            "einfaches Bergwandern, alpines Klettern oder sogenanntes Höhenbergsteigen in den sauerstoffarmen Regionen der Sieben- und Achttausender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d4e3d5-a99a-44e3-a2a3-67605179a24a",
                                                "sense_id": "58d6944e-5264-3227-ad13-b5265fd83a28",
                                                "text": "„Was die Erfahrung des Bergsteigens zu einer Metapher des Lebens überhaupt werden lässt und sogar noch zum Sinnbild für die Suche nach dem ewigen Seelenheil, ist die Verbindung der kulturell positiv besetzten Vorstellung der Höhe mit der Abforderung einer körperlichen Leistung.“"
                                            },
                                            {
                                                "example_id": "179c322d-9fb7-4ed8-834f-d9627d8cefdc",
                                                "sense_id": "58d6944e-5264-3227-ad13-b5265fd83a28",
                                                "text": "„Auch beim Bergsteigen lässt sich heute manch gut zahlender fitnessschwacher Tourist nicht nur auf das Matterhorn, sondern sogar auf den Everest am kurzen Seil hinaufschleppen.“"
                                            },
                                            {
                                                "example_id": "cd09acfb-235b-4163-baa1-1b816b249e13",
                                                "sense_id": "58d6944e-5264-3227-ad13-b5265fd83a28",
                                                "text": "„Bergsteigen heißt nicht nur Klettern: Wenn sich Bergsteiger zum Gipfel aufmachen, müssen sie auch wegloses Gelände, Felswände, Schneefelder und Gletscher überwinden.“"
                                            },
                                            {
                                                "example_id": "11306ca8-9725-48af-91c3-9707bc3fefbc",
                                                "sense_id": "58d6944e-5264-3227-ad13-b5265fd83a28",
                                                "text": "„Zu oft werden die Gefahren beim Bergsteigen von Laien unterschätzt, sagt Ernst Vogt, Leiter der Bergsteigerredaktion beim Bayerischen Rundfunk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
