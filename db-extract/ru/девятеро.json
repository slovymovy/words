                "translations": [
                    {
                        "translation_id": "5cf1ca73-c28a-4ccd-9c48-42a71ae03256",
                        "source_entry_id": "d476a9e8-59d9-310c-9f28-dc73a86a19f3",
                        "target_lang_word": "nine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb2aa71b-044a-3a3b-9db8-6ace0f28877a",
                                        "entry_id": "c002d20f-763a-31e8-8117-7e2e96f79eb8",
                                        "glosses": [
                                            "A numerical value equal to 9; the number following eight and preceding ten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2947bdcc-91b6-4411-ba5a-cd23fdc5254e",
                                                "sense_id": "eb2aa71b-044a-3a3b-9db8-6ace0f28877a",
                                                "text": "Would they want me to vote my conscience or would they want us to unanimously go the whole nine yards, declare him sane and possibly have the trial end up in a death sentence?"
                                            },
                                            {
                                                "example_id": "23df991b-d3f4-4e45-b0a6-410a8c389936",
                                                "sense_id": "eb2aa71b-044a-3a3b-9db8-6ace0f28877a",
                                                "text": "Of course, for a number to have a biography, we need to assume that none of its digits are present more than nine times."
                                            },
                                            {
                                                "example_id": "af7a6fe5-cedd-4ed4-8743-a7b089ed25e2",
                                                "sense_id": "eb2aa71b-044a-3a3b-9db8-6ace0f28877a",
                                                "text": "Tamunowari Tetenta, a 20-year-old mechanical engineering student, says he has attempted to register for his NIN on nine different occasions in Port Harcourt, a city southeast of Lagos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce0fb2f7-69da-3ca0-b89f-3f1b5f32e95f",
                                        "entry_id": "c002d20f-763a-31e8-8117-7e2e96f79eb8",
                                        "glosses": [
                                            "Describing a group or set with nine elements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59b8dc12-93ae-4f7c-b77d-603d6c958494",
                                                "sense_id": "ce0fb2f7-69da-3ca0-b89f-3f1b5f32e95f",
                                                "text": "A cat has nine lives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f989d560-743a-3e88-827e-ca078c926cac",
                                        "entry_id": "30fc0184-b98f-3cd6-98e2-2d6adccf6500",
                                        "glosses": [
                                            "The digit or figure 9."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1cbbfc0-7a5a-42b5-862b-7b8d9d6738fe",
                                                "sense_id": "f989d560-743a-3e88-827e-ca078c926cac",
                                                "text": "Indeed, if a number does not have nines, you can remove or add zeroes at the end of a biography to get another biography of the same number."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65da5daf-ee7d-3224-9120-d1e193afcb6f",
                                        "entry_id": "30fc0184-b98f-3cd6-98e2-2d6adccf6500",
                                        "glosses": [
                                            "A playing card with nine pips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fbd4db78-7604-3d0d-86da-282f6173f631",
                                        "entry_id": "30fc0184-b98f-3cd6-98e2-2d6adccf6500",
                                        "glosses": [
                                            "A nine-millimeter semi-automatic pistol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc0fd46-85d3-47fc-bc53-23a9314d4b17",
                                                "sense_id": "fbd4db78-7604-3d0d-86da-282f6173f631",
                                                "text": "Hiro risks turning on a small flashlight, uses it to rummage around the yatcht, picking up valuable stuff: a few bottles of (presumably) drinkable water, some food, extra ammunition for his nine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1623ca-ac6e-33fc-8dd7-17c849981415",
                                        "entry_id": "30fc0184-b98f-3cd6-98e2-2d6adccf6500",
                                        "glosses": [
                                            "A statistical unit of proportion (of reliability, purity, etc.)."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1190d9dc-1bfc-4b8b-aa05-8eab52e46d89",
                                                "sense_id": "3f1623ca-ac6e-33fc-8dd7-17c849981415",
                                                "text": "They guaranteed that our Web site would have 99.99% uptime, or four nines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cabc7d24-6a11-3600-bd25-d4c0999c65eb",
                                        "entry_id": "30fc0184-b98f-3cd6-98e2-2d6adccf6500",
                                        "glosses": [
                                            "A baseball club, team, or lineup (composed of nine players)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe0f5cd-e158-491d-97a0-18f974fea0f1",
                                                "sense_id": "cabc7d24-6a11-3600-bd25-d4c0999c65eb",
                                                "text": "The St. Louis club is the only nine in the league which gives its patrons the right to see a full game or no pay."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
