                                        "entry_id": "0c759fc3-f7ff-38de-a893-0233c246bcd6",
                                        "glosses": [
                                            "Lied mit weihnachtlichem Text, gesungen vorwiegend in der Weihnachtszeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f88850-031a-4408-91ad-0514991303e3",
                                                "sense_id": "4cc7dba3-d30c-36b9-a710-ceb1b03fd9d9",
                                                "text": "„Lasst uns ein Weihnachtslied singen!“"
                                            },
                                            {
                                                "example_id": "acf70945-94ab-44c0-a2e7-05271da56abf",
                                                "sense_id": "4cc7dba3-d30c-36b9-a710-ceb1b03fd9d9",
                                                "text": "„Einige Weihnachtslieder hatten es ihm mächtig angetan.“"
                                            },
                                            {
                                                "example_id": "62f421ab-93d2-43bd-8a57-01c63a5a11ad",
                                                "sense_id": "4cc7dba3-d30c-36b9-a710-ceb1b03fd9d9",
                                                "text": "„Noch bis vor kurzem konnte er keine Weihnachtslieder ertragen; heute ist das anders.“"
                                            },
                                            {
                                                "example_id": "d0238067-221a-457e-bc77-861397bc177a",
                                                "sense_id": "4cc7dba3-d30c-36b9-a710-ceb1b03fd9d9",
                                                "text": "„Abends hörten sie die anderen Kinder unten Weihnachtslieder singen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
