                "translations": [
                    {
                        "translation_id": "2af2e6dc-7443-4044-a2e8-1f38c5e08c50",
                        "source_entry_id": "6c7eb5aa-3724-328f-869b-0de5e8e8b544",
                        "source_sense_id": "2d726d64-52e5-3abc-9738-28b982b9ef03",
                        "source_sense_description": "Physik, Elementarteilchenphysik: Baryon, das ein s-Quark besitzt",
                        "target_lang_word": "超子",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "超子",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "9cfc17b6-5bc4-3e06-9d4e-5ff6587ff2ee",
                                        "entry_id": "89d3b333-33c0-3956-a29b-83d33faf9ab6",
