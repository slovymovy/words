{
    "word_family": [
        "gluey",
        "unglue"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b6a604e-5aaf-367a-8d19-b62da7475f5a",
                    "sense_definition": "A sticky substance used for joining things together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_glue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used strong <w>glue</w> to fix the broken handle of the mug.",
                            "target_lang_translations": {
                                "ru": "Я использовал прочный <w>клей</w>, чтобы починить сломанную ручку кружки.",
                                "zh": "我用了强力<w>胶水</w>修好了杯子断掉的把手。"
                            }
                        },
                        {
                            "text": "Be careful not to get any <w>glue</w> on your fingers while working.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы <w>клей</w> не попал тебе на пальцы во время работы.",
                                "zh": "工作时小心别让<w>胶水</w>弄到手指上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "super glue",
                        "glue stick",
                        "bottle of glue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Липкое вещество, используемое для склеивания предметов.",
                        "zh": "一种用于将物体粘合在一起的粘性物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "вещество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胶水",
                                "target_lang_sense_clarification": "粘合剂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91654e2c-f305-34d7-9ee4-c3ffc0c3699d",
                    "sense_definition": "Something that keeps people, groups, or things united or connected.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_bond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Shared values act as the <w>glue</w> that holds this community together.",
                            "target_lang_translations": {
                                "ru": "Общие ценности действуют как <w>клей</w>, который скрепляет это сообщество.",
                                "zh": "共同的价值观是维系这个社区的<w>纽带</w>。"
                            }
                        },
                        {
                            "text": "Trust is the essential <w>glue</w> in any long-term relationship.",
                            "target_lang_translations": {
                                "ru": "Доверие — это необходимый <w>клей</w> в любых долгосрочных отношениях.",
                                "zh": "信任是任何长期关系中必不可少的<w>粘合剂</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bond"
                    ],
                    "common_phrases": [
                        "social glue",
                        "glue that holds"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что объединяет людей, группы или предметы; связующее звено.",
                        "zh": "指使人、群体或事物保持团结或联系的纽带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клей",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "связующее звено",
                                "target_lang_sense_clarification": "метафора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纽带",
                                "target_lang_sense_clarification": "比喻联系"
                            },
                            {
                                "target_lang_word": "粘合剂",
                                "target_lang_sense_clarification": "比喻团结力量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fcca7122-3bc1-3c73-8131-82f4e965b876",
                    "sense_definition": "To join or attach things using a sticky substance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_glue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>glue</w> the picture onto the center of the page.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>приклей</w> картинку в центр страницы.",
                                "zh": "请把这张照片<w>粘</w>在页面中央。"
                            }
                        },
                        {
                            "text": "He tried to <w>glue</w> the pieces of the vase back together.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>склеить</w> осколки вазы.",
                                "zh": "他试图把花瓶的碎片<w>粘合</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "attach",
                        "bond",
                        "paste"
                    ],
                    "common_phrases": [
                        "glue together",
                        "glue onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или прикреплять предметы с помощью клея.",
                        "zh": "使用粘性物质将物体连接或固定在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приклеить",
                                "target_lang_sense_clarification": "прикрепить к поверхности"
                            },
                            {
                                "target_lang_word": "склеить",
                                "target_lang_sense_clarification": "соединить части"
                            },
                            {
                                "target_lang_word": "клеить",
                                "target_lang_sense_clarification": "процесс склеивания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粘",
                                "target_lang_sense_clarification": "粘贴"
                            },
                            {
                                "target_lang_word": "粘合",
                                "target_lang_sense_clarification": "连接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b3ff8a3-ea0e-304f-9b6f-3d176d58eb61",
                    "sense_definition": "To look at something with great attention and for a long time, as if attached to it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_fixation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were <w>glued</w> to the television all morning.",
                            "target_lang_translations": {
                                "ru": "Дети всё утро <w>не отлипали</w> от телевизора.",
                                "zh": "孩子们整个上午都<w>盯着</w>电视看。"
                            }
                        },
                        {
                            "text": "Her eyes were <w>glued</w> to the stage during the entire performance.",
                            "target_lang_translations": {
                                "ru": "Её глаза были <w>прикованы</w> к сцене во время всего представления.",
                                "zh": "演出期间，她的目光始终<w>盯着</w>舞台。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "glued to the screen",
                        "eyes glued to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смотреть на что-то с большим вниманием и долго, словно будучи привязанным к этому.",
                        "zh": "指长时间全神贯注地注视某物，仿佛被吸引住了一样。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прилипнуть",
                                "target_lang_sense_clarification": "разг., не отходить"
                            },
                            {
                                "target_lang_word": "приковать",
                                "target_lang_sense_clarification": "о взгляде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盯着",
                                "target_lang_sense_clarification": "注视"
                            },
                            {
                                "target_lang_word": "目不转睛",
                                "target_lang_sense_clarification": "形容专注"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}