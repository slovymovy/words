                                        "entry_id": "127b1fc2-6c45-34e6-9380-da13bba48390",
                                        "glosses": [
                                            "Ensemble de petites taches, semblables à des points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68bc2bb3-a62c-46b1-ac8d-705a81d3e0af",
