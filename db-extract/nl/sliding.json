                                        "examples": [
                                            {
                                                "example_id": "84a59b42-561d-4ae5-989f-9e53a20893aa",
                                                "sense_id": "4cd6ec2c-31f4-3587-8865-0e818258b74b",
                                                "text": "Beware thou ſlide not by it, leſt thou fall before him that lieth in wait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e9b71eb-87d1-3ef1-bf4e-68165b3599a1",
                                        "entry_id": "c41d6541-52db-3613-9d60-bbb3a7be82cd",
                                        "glosses": [
                                            "To pass along smoothly or unobservedly; to move gently onward without friction or hindrance."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faeda886-d900-467e-bff3-9d51cdb476a1",
                                                "sense_id": "3e9b71eb-87d1-3ef1-bf4e-68165b3599a1",
                                                "text": "A ship or boat slides through the water."
                                            },
                                            {
                                                "example_id": "72f5b261-c1a4-4a4f-9742-070413d44411",
                                                "sense_id": "3e9b71eb-87d1-3ef1-bf4e-68165b3599a1",
                                                "text": "Ages shall slide away without perceiving."
                                            },
                                            {
                                                "example_id": "240ac052-be09-4d73-bee1-65d1c55d22ec",
                                                "sense_id": "3e9b71eb-87d1-3ef1-bf4e-68165b3599a1",
                                                "text": "Begin vvith Senſe, of ev'ry Art the Soul, / Parts anſw'ring parts ſhall ſlide into a VVhole, […]"
                                            },
                                            {
                                                "example_id": "16e9950b-bc2a-402d-91b0-c8cfd1920075",
                                                "sense_id": "3e9b71eb-87d1-3ef1-bf4e-68165b3599a1",
                                                "text": "All night no ruder air perplex\n⁠Thy sliding keel, till Phosphor, bright\n⁠As our pure love, thro’ early light\nShall glimmer on the dewy decks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb1f9e5-08d0-3c9c-b03a-d071f99a8847",
                                        "entry_id": "c41d6541-52db-3613-9d60-bbb3a7be82cd",
                                        "glosses": [
                                            "To decrease in amount or value."
