                            {
                                "target_lang_word": "техническая комиссия",
                                "target_lang_sense_clarification": "официальная процедура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "技术检查",
                                "target_lang_sense_clarification": "赛车术语"
                            },
                            {
                                "target_lang_word": "车检",
                                "target_lang_sense_clarification": "车辆状况检查"
                            }
                        ]
                    }
