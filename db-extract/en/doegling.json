                        "glosses": [
                            "A northern bottlenose whale (Hyperoodon ampullatus), from which oil was once obtained."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61df28e3-73b1-4c3e-809a-4ea32fc63043",
                                "sense_id": "7a8f91a7-f2c7-3ecb-93a4-aeacb2e772f7",
                                "text": "This acid is, moreover, not combined with oxide of lipyl in the Doegling train-oil, (at least it yields no glycerine on saponification,) but probably with doeglic oxide, C₂₄H₂₅O, a body similar to the ether-like haloid bases, whose existence and composition Scharling, however, only infers from the analysis of the unsaponified Doegling train-oil and the absence of glycerine."
                            },
                            {
                                "example_id": "8ebce62e-3de2-4d6c-92fc-67d84e698abc",
                                "sense_id": "7a8f91a7-f2c7-3ecb-93a4-aeacb2e772f7",
                                "text": "Doegling Train Oil. From the doegling (the Balœna rostrata of Chemnitz, Hyperodon of later zoologists), a kind of dolphin."
                            },
                            {
                                "example_id": "f8e31a63-d93b-493d-98c4-844b37b6b7f8",
                                "sense_id": "7a8f91a7-f2c7-3ecb-93a4-aeacb2e772f7",
                                "text": "An ointment base said to be a mixture of soap, carnauba wax, and doegling oil."
                            }
                        ]
                    }
