                    {
                        "translation_id": "2faada77-0287-44e6-952d-176c76090c4a",
                        "source_entry_id": "47f59780-fbca-3363-9df5-8c4cf9bf9649",
                        "source_sense_id": "4df2ef6e-d2e7-323b-9905-e76da790e121",
                        "target_lang_word": "mutieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mutieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0702561f-91b0-3d05-9ec8-657242678990",
                                        "entry_id": "08d22896-6677-375e-9fad-d97a86999392",
                                        "glosses": [
                                            "sich plötzlich verändern (Gen, Erbgut)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a13d57-ffa1-4087-8267-b598729e4a65",
                                                "sense_id": "0702561f-91b0-3d05-9ec8-657242678990",
                                                "text": "Wenn das Erbgut einer Spezies mutiert, können dadurch neue Arten entstehen."
                                            },
                                            {
                                                "example_id": "08257a63-4724-431a-9fea-5cab01957dc0",
                                                "sense_id": "0702561f-91b0-3d05-9ec8-657242678990",
                                                "text": "„Es liegt daran, dass ich in Warschau immer erst einige Stunden brauche, ehe ich zum richtigen Polen mutiere.“"
                                            },
                                            {
                                                "example_id": "a8aa3ac8-da6e-49b6-8cb1-ceb607fe42e5",
                                                "sense_id": "0702561f-91b0-3d05-9ec8-657242678990",
                                                "text": "„Der Druck ist nirgends größer als beim Ryder Cup. Fantastische Spieler mutierten schon zu Mäusen, Außenseiter zu Riesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "824dfe2d-1ba4-3728-a34e-f66ba9655804",
                                        "entry_id": "08d22896-6677-375e-9fad-d97a86999392",
                                        "glosses": [
                                            "sich im Stimmwechsel, im Stimmbruch befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1117fc0-0982-4d06-9b0e-7c664bbd58c8",
                                                "sense_id": "824dfe2d-1ba4-3728-a34e-f66ba9655804",
                                                "text": "Im Alter von 14 bis 16 Jahren mutieren die Jungen und bekommen eine tiefere Stimme durch die hormonellen Veränderungen in der Pubertät. Das Eintrittsalter zum Stimmbruch hat sich in den letzten Jahrzehnten verschoben und es scheint, dass Jungen in immer jüngeren Alter mutieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
