                            {
                                "example_id": "25fbb767-bec3-48ab-b239-6a38b59d502a",
                                "sense_id": "c9d4cd31-c47f-3ddf-99a6-16fbb79b69d4",
                                "text": "Les étranges figures dont tout Mangarévien bigarrait sa peau, jointes à sa longue barbe et sa chevelure flottante, lui donnaient un air martial et terrible, que ne démentait pas son caractère; car il passait, avant sa conversion, pour le plus féroce insulaire de l'Océanie."
                            },
                            {
                                "example_id": "d4137bb5-6d5e-40e2-8d41-991ce3c7ea90",
                                "sense_id": "c9d4cd31-c47f-3ddf-99a6-16fbb79b69d4",
                                "text": "Une place d’honneur m'avait été réservée et une charmante Mangarevienne m'avait couronné de fleurs."
                            }
                        ]
                    }
