                "senses": [
                    {
                        "sense_id": "fa9336e6-4641-344e-a1fc-027ba6b7ceec",
                        "entry_id": "b7cded5e-4dc1-3319-985f-11ad52e90b2d",
                        "glosses": [
                            "hastig, schnell, aber nicht gleichmäßig (und wenn möglich mit Lärm) verlaufend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39ef9b52-6dc4-4042-843f-4885dcfa5ce4",
                                "sense_id": "fa9336e6-4641-344e-a1fc-027ba6b7ceec",
                                "text": "Durch die Erschütterung kam die Lawine holterdiepolter den Hang herunter."
                            },
                            {
                                "example_id": "70392d5a-5dc5-4f31-aa2d-1ae0011de9f1",
                                "sense_id": "fa9336e6-4641-344e-a1fc-027ba6b7ceec",
                                "text": "„Er wird sich von Goebbels ebenso freundlich, wie er jetzt im Kaiserhof mit ihm parliert, Bedenkzeit ausbitten, um holterdiepolter den Zug nach Paris zu besteigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fa34cee-7d89-46d8-8157-3bd841c4a48c",
                        "source_entry_id": "b7cded5e-4dc1-3319-985f-11ad52e90b2d",
                        "source_sense_id": "fa9336e6-4641-344e-a1fc-027ba6b7ceec",
                        "source_sense_description": "hastig, schnell, aber nicht gleichmäßig (und wenn möglich mit Lärm) verlaufend",
                        "target_lang_word": "helter-skelter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "helter-skelter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37f4735a-cecb-3a13-98ba-85221d124050",
                                        "entry_id": "90e63935-48da-3f4c-806b-c3776604563e",
                                        "glosses": [
                                            "In confused, disorderly haste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69624e21-983b-4f13-a6be-b17a1c8ce07f",
                                                "sense_id": "37f4735a-cecb-3a13-98ba-85221d124050",
                                                "text": "The winds knocked huge trees helter-skelter all over my garden."
                                            },
                                            {
                                                "example_id": "b0a074b3-873c-450b-aa12-30a25f667f00",
                                                "sense_id": "37f4735a-cecb-3a13-98ba-85221d124050",
                                                "text": "But the butterflies were dead. A whiff of rotten eggs had vanquished the pale clouded yellows which came pelting across the orchard and up Dods Hill and away on to the moor, now lost behind a furze bush, then off again helter-skelter in a broiling sun."
                                            },
                                            {
                                                "example_id": "83b4c599-17fd-4579-a275-001285da9d5a",
                                                "sense_id": "37f4735a-cecb-3a13-98ba-85221d124050",
                                                "text": "Pellets, once released from the funnel, would bounce helter-skelter, left or right, against the pins […] to ultimately gather in the lower compartments in a pile which resembles a normal curve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "helter-skelter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25ef0ed2-6287-39df-adf5-d59a86f66d0b",
                                        "entry_id": "e34fbd4d-e6a5-3cbc-a2b6-57784b48c198",
                                        "glosses": [
                                            "Carelessly hurried and confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12502181-1031-473f-ad29-ac3066b31394",
                                                "sense_id": "25ef0ed2-6287-39df-adf5-d59a86f66d0b",
                                                "text": "After World War II, from 1945 until the early 1960s, the helter-skelter growth of the reprint industry went largely unheeded by the general publishing industry, then under its own mounting pressures to publish new works for a growing reading public and ever-larger numbers of educational institutions."
                                            },
                                            {
                                                "example_id": "52789f44-ce7c-4328-9f1a-f3404fda2556",
                                                "sense_id": "25ef0ed2-6287-39df-adf5-d59a86f66d0b",
                                                "text": "Although his existential thoughts seem to have been tossed onto the page in helter-skelter fashion, what Gilboa does here is to open his mind and heart to the reader through verbal jaggedness and poetic unneatness."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "helter-skelter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c690bb0c-8a23-35f2-a9f4-1cb8d74aabd9",
                                        "entry_id": "2ab62533-d3e4-3516-bf8c-c1edb63a667d",
                                        "glosses": [
                                            "Confusion or turmoil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ec65b0a-d1ef-4627-88c0-848232592ac9",
                                                "sense_id": "c690bb0c-8a23-35f2-a9f4-1cb8d74aabd9",
                                                "text": "‘I hardly know, — I imagine that it was with some dim idea of Marjorie’s being able to get in if she returned while I was absent, — but the truth is I was in such a condition of helter skelter that I am not prepared to swear that I had any reasonable reason.’"
                                            },
                                            {
                                                "example_id": "a2111954-1f5a-410a-9019-5bb46b5fd118",
                                                "sense_id": "c690bb0c-8a23-35f2-a9f4-1cb8d74aabd9",
                                                "text": "(Oh, oh, oh) / I'm looking for some shelter / (Oh, oh, oh) / From the helter-skelter / (Oh, oh, oh) / Just keep me away from / All who conspire / (Enemy fire...)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdf818e4-82e6-3211-9778-5383bbbb0b81",
                                        "entry_id": "2ab62533-d3e4-3516-bf8c-c1edb63a667d",
                                        "glosses": [
                                            "An amusement ride consisting of a slide that spirals down around the exterior of a tapering central tower."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b2b827-a98b-4797-95b0-febb5857d7a6",
                                                "sense_id": "cdf818e4-82e6-3211-9778-5383bbbb0b81",
                                                "text": "He is finishing, this week, a remarkable thing called a helter skelter: This is a circular building 50 feet high which people climb, by means of an interior winding stair. At the top they each take a seat in a semicircular wooden trough which curls around the outside of the house, gradually leading towards the ground with a terrific rush, they slide down this and are rapidly delivered on to the grass below."
                                            },
                                            {
                                                "example_id": "546c1709-0019-42b9-9489-c51a917b83ce",
                                                "sense_id": "cdf818e4-82e6-3211-9778-5383bbbb0b81",
                                                "text": "For gentler sliding fun, you can take a ride on the helter-skelter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
