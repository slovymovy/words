                "senses": [
                    {
                        "sense_id": "b82a3a1c-8e0c-3de8-807e-d40b214d3eff",
                        "entry_id": "2a23a3b3-b132-33e7-bd0f-2eb13d380209",
                        "glosses": [
                            "dotyczący sfery psychicznej i społecznej"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "7184a312-ef27-4124-86e2-1872d51716eb",
                                "sense_id": "b82a3a1c-8e0c-3de8-807e-d40b214d3eff",
                                "text": "Wyniki tego badania nie dostarczają niestety wyjaśnienia psychospołecznych korzyści uczestnictwa w społeczności internetowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
