                "senses": [
                    {
                        "sense_id": "149e1d1e-c987-3566-b88c-f194c4e15bc7",
                        "entry_id": "e9a7e2ce-27e9-30ff-8c6d-c6bc0c5d6ea7",
                        "glosses": [
                            "хим. соль, содержащая шестивалентный кислотный остаток MnO₄^₂- марганца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49fbd465-2a83-4a57-8ebb-b469e32159ae",
                                "sense_id": "149e1d1e-c987-3566-b88c-f194c4e15bc7",
                                "text": "В зависимости от среды степень окисления марганца изменяется по-разному в кислой среде марганец восстанавливается до Mn₂+, в нейтральной — до диоксида, а в щелочной до манганата."
                            },
                            {
                                "example_id": "084bf922-ce42-4c8c-967d-a45ec68ed3fc",
                                "sense_id": "149e1d1e-c987-3566-b88c-f194c4e15bc7",
                                "text": "Калия манганат — сильный окислитель. При воздействии концентрированной серной кислотой в присутствии спирта, эфира и горючих материалов дает взрыв."
                            }
                        ]
                    }
