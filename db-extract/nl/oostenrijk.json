                ],
                "senses": [
                    {
                        "sense_id": "fc975d67-1ba7-386c-8fdc-8f30c1c4363c",
                        "entry_id": "e5325fa9-a358-3990-81ac-f0376816b3c8",
                        "glosses": [
                            "een republiek in Midden-Europa grenzend aan Zwitserland en Liechtenstein in het westen, aan Duitsland en Tsjechië in het noorden, aan Slowakije en Hongarije in het oosten en aan Italië en Slovenië in het zuiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d071cdd8-b3d5-4727-ad1b-40ba494ca15b",
                                "sense_id": "fc975d67-1ba7-386c-8fdc-8f30c1c4363c",
                                "text": "Wij gaan altijd skiën in Oostenrijk."
                            },
                            {
                                "example_id": "a5c31e25-52e6-4759-9750-72fa6f1ceb57",
                                "sense_id": "fc975d67-1ba7-386c-8fdc-8f30c1c4363c",
                                "text": "Het was de 18-jarige Goldie uit Oostenrijk, een energieke stuiterbal met een opvallend harde stem."
                            },
                            {
                                "example_id": "1441b720-0f53-47e8-8830-061effdd3884",
                                "sense_id": "fc975d67-1ba7-386c-8fdc-8f30c1c4363c",
                                "text": "Het uitgangspunt van haar verslag dreunt met zware bastonen: dat haar eigen financiële schuld in het niet valt bij wat van haar Joodse familie, de échte slachtoffers, is afgenomen en nooit teruggegeven; bij de schuld die tot op de dag van vandaag in het DNA van Duitsland en Oostenrijk verweven is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ea222d9-39fd-417c-a8e4-ecb4c2c014fc",
                        "source_entry_id": "e5325fa9-a358-3990-81ac-f0376816b3c8",
