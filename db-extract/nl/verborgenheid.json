                    }
                ],
                "translations": [
                    {
                        "translation_id": "56f962b6-14de-4a10-b29d-d842af87ba43",
                        "source_entry_id": "949f4e00-d76e-33f4-8455-75897d1c9a92",
                        "source_sense_id": "ac9ab544-fa59-3ea0-a262-e46259d98873",
                        "source_sense_description": "iets dat verborgen is",
                        "target_lang_word": "mystery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "Something secret or unexplainable; an unknown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406f3c89-607f-42f8-a097-732163be5df4",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The truth behind the events remains a mystery."
                                            },
                                            {
                                                "example_id": "9fe22593-18c5-4ccd-afc0-59f188312db5",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "3c2b2354-9ced-4e48-880d-192ba31c2fb6",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The fate of the railway from Ballater to Braemar has been invested with an air of mystery, which has never been completely dispelled. It has been suggested that Queen Victoria was opposed to a railway in the vicinity of Balmoral Castle, and intervened personally to secure the abandonment of the line beyond Ballater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "Someone or something with an obscure or puzzling nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0ebd51-94bf-4cb8-b0fd-c27ab8caa751",
                                                "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                                "text": "That man is a mystery."
                                            },
                                            {
                                                "example_id": "3a838141-1cb2-4878-a0d0-54dbf08a038c",
                                                "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                                "text": "Then I had a good think on the subject of the hocussing of Cigarette, and I was reluctantly bound to admit that once again the man in the corner had found the only possible solution to the mystery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a334e0d-84ba-3cb7-a910-39d590f00106",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "An account, story, book, film, or play, often with the theme of crime or murder, with a surprise ending that explains all the strange events that have occurred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9de9278f-e3c9-3a73-b106-4ee31e367499",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A mystery play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce4a44b4-23ce-40a9-a568-0043237353c4",
                                                "sense_id": "9de9278f-e3c9-3a73-b106-4ee31e367499",
                                                "text": "The Moralities displayed something more of art and invention than the Mysteries; in them virtues, vices and qualities were personified, and something like a plot was frequently to be discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29af858-1f84-3c68-9264-9ae7ed69c805",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A secret or mystical meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b889160-239c-494f-8c6f-08f6544c8575",
                                                "sense_id": "a29af858-1f84-3c68-9264-9ae7ed69c805",
                                                "text": "[…] and, not knowing the meaning or misterie of her pollicie, forgat no termes of reproche or rigorous rebuke against his chast doughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a996965f-46c5-3b84-9df3-ecd68652a1eb",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A religious truth not understandable by the application of human reason alone (without divine aid)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e15f69f-355a-48ea-a50f-291b32eaad0c",
                                                "sense_id": "a996965f-46c5-3b84-9df3-ecd68652a1eb",
                                                "text": "1744 (first printed), Jonathan Swift, A Sermon on the Trinity\nIf God should please to reveal unto us this great mystery of the Trinity, or some other mysteries in our holy religion, we should not be able to understand them, unless he would bestow on us some new faculties of the mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9453c6-ddc9-3cc0-a2fc-e797db3ae2d2",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A sacrament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcceb77c-6ac8-471e-b5de-2e9dc1df0bf1",
                                                "sense_id": "0d9453c6-ddc9-3cc0-a2fc-e797db3ae2d2",
                                                "text": "There are seven mysteries, or sacraments, in the Greek church, viz. baptism, the chrism (a rite peculiar to this church), the eucharist, confession, ordination, marriage, and the holy oil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A secret religious celebration, admission to which was usually through initiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a83738e-b464-403e-b1fa-a4bd99257552",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "the Eleusinian mysteries"
                                            },
                                            {
                                                "example_id": "65351919-0c10-4427-9915-e1b880cd128e",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "the Mysteries of Mithras"
                                            },
                                            {
                                                "example_id": "1ba7ccea-bccd-4843-897f-16c85e08f353",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "There’s no initiation either into such mysteries."
                                            },
                                            {
                                                "example_id": "00848fee-5f58-4f7a-8a4b-e85fe13f70eb",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "It is, indeed, part of the ritual of the candidate for adeptship into the British mysteries, resembling that for the neophyte into the Osirian, Cabiric or Orphean mysteries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfc7a04-d363-3b2b-84ff-6923346be989",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A particular event or series of events in the life of Christ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77f4d25-8ecc-4ad9-9ce5-12583120c7b8",
                                                "sense_id": "3dfc7a04-d363-3b2b-84ff-6923346be989",
                                                "text": "The second decade of the Rosary concerns the Sorrowful mysteries, such as the crucifixion and the crowning with thorns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e775720b-470c-395e-add0-568a801f6425",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A craft, art or trade; specifically a guild of craftsmen."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41773170-c170-45e4-874d-08c11fcd7151",
                                                "sense_id": "e775720b-470c-395e-add0-568a801f6425",
                                                "text": "The trades, the crafts, the mysteries, would all be losers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50cef99d-d36c-4762-8d19-a178dfb9ddfc",
                        "source_entry_id": "949f4e00-d76e-33f4-8455-75897d1c9a92",
                        "source_sense_id": "ac9ab544-fa59-3ea0-a262-e46259d98873",
                        "source_sense_description": "iets dat verborgen is",
                        "target_lang_word": "secret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "secret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "A piece of knowledge that is hidden and intended to be kept hidden."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2f7f8e-b227-4100-9d3b-4837e94775a0",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "\"Can you keep a secret?\" \"Yes.\" \"So can I.\""
                                            },
                                            {
                                                "example_id": "cb8203d9-a4f6-4518-83b4-6b3c4eb08059",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "To tell our own secrets is generally folly, but that folly is without guilt; to communicate those with which we are intrusted is always treachery"
                                            },
                                            {
                                                "example_id": "0d664713-297f-48ab-9fb2-3ab73fa8412e",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Well, mistress, I am sorry this is a matter I cannot aid you in—it goes against my conscience, and it is an affair above my condition, and beyond my management;—but I will keep your secret."
                                            },
                                            {
                                                "example_id": "ec68d0ef-7c76-4244-9f1a-bdb6e33712f6",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Barla Von: Most people think I deal in finances, but my real currency is knowledge. I trade information and it has made me very wealthy.\nBarla Von: But the Shadow Broker is the true master. Every day, he buys and sells secrets that could topple governments, always giving them to the highest bidder."
                                            },
                                            {
                                                "example_id": "51911e71-9296-44c4-9a1c-2c54b701281c",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "Now we are liberal with our innermost secrets, spraying them into the public ether with a generosity our forebears could not have imagined. Where we once sent love letters in a sealed envelope, or stuck photographs of our children in a family album, now such private material is despatched to servers and clouds operated by people we don't know and will never meet."
                                            },
                                            {
                                                "example_id": "a59911cd-f5c2-4b72-b98f-3ec975b1aea6",
                                                "sense_id": "b99368b2-42b2-3843-b702-1ca40fe91318",
                                                "text": "The storage of cryptographic secrets is one of the paramount requirements in building trustworthy systems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fa91c8-75a2-3416-bb60-2b3693d9a299",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "The key or principle by which something is made clear; the knack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eb529b3-3cd4-4cdc-b7e7-7ad4a65b7768",
                                                "sense_id": "28fa91c8-75a2-3416-bb60-2b3693d9a299",
                                                "text": "The secret to a long-lasting marriage is compromise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "644330c6-1357-3e29-a255-a38f0e6b2009",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Something not understood or known."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dd1c66a-1b34-45f9-bb37-452546fb3077",
                                                "sense_id": "644330c6-1357-3e29-a255-a38f0e6b2009",
                                                "text": "Thou knewſt by name, and all th' ethereal powers, / All ſecrets of the deep, all Natures works,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3027190-32b9-3de5-87b2-ec3af8e95a8a",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Private seclusion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a91313d-ab0a-4a17-834e-b40eec9138ff",
                                                "sense_id": "f3027190-32b9-3de5-87b2-ec3af8e95a8a",
                                                "text": "The work was done in secret, so that nobody could object."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5580da84-ca9f-3d68-94d1-71326a8bee94",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "The genital organs."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15521f03-fa88-3596-b89f-781f156781c5",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "A form of steel skullcap."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8fdf0499-b829-30ad-b293-e7a47314b71e",
                                        "entry_id": "6fc4bbb6-72c9-3bfa-9b5e-8cebd8ebd85d",
                                        "glosses": [
                                            "Any prayer spoken inaudibly and not aloud; especially, one of the prayers in the Tridentine Mass, immediately following the \\\"orate, fratres\\\", said inaudibly by the celebrant."
                                        ],
                                        "tags": [
                                            "countable",
