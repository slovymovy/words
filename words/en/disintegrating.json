    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "789e8ab4-7d0b-3472-a9ec-415a78fd8c98",
                    "sense_definition": "present participle of <w>disintegrate</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "break_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient paper was slowly <w>disintegrating</w> into tiny fragments from the moisture.",
                            "target_lang_translations": {
                                "ru": "Древняя бумага от влаги медленно <w>распадалась</w> на крошечные фрагменты."
                            }
                        },
                        {
                            "text": "Their political alliance is rapidly <w>disintegrating</w> after the recent election scandal.",
                            "target_lang_translations": {
                                "ru": "Их политический союз стремительно <w>разваливается</w> после недавнего предвыборного скандала."
                            }
                        }
                    ],
                    "synonyms": [
                        "decaying",
                        "crumbling",
                        "decomposing"
                    ],
                    "common_phrases": [
                        "rapidly disintegrating",
                        "slowly disintegrating"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола disintegrate: распадающийся на части, разрушающийся или распадающийся (об организациях, союзах)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распадающийся",
                                "target_lang_sense_clarification": "делящийся на части, разрушающийся физически или социально"
                            },
                            {
                                "target_lang_word": "разрушающийся",
                                "target_lang_sense_clarification": "теряющий целостность, структуру"
                            },
                            {
                                "target_lang_word": "разваливающийся",
                                "target_lang_sense_clarification": "рушащийся на куски, гибнущий (о союзах, планах)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46c0aa77-975b-31ed-ad81-4ebee0cc3d02",
                    "sense_definition": "Causing disintegration or breaking into smaller parts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "break_down",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh winter weather acted as a <w>disintegrating</w> force on the ancient stone walls.",
                            "target_lang_translations": {
                                "ru": "Суровая зимняя погода подействовала как <w>разрушительная</w> сила на древние каменные стены."
                            }
                        },
                        {
                            "text": "Scientists tested the <w>disintegrating</w> effects of the acid on various industrial polymers.",
                            "target_lang_translations": {
                                "ru": "Учёные протестировали <w>разрушающее</w> действие кислоты на различные промышленные полимеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "destructive",
                        "disruptive"
                    ],
                    "common_phrases": [
                        "disintegrating force",
                        "disintegrating effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий распад, дезинтеграцию или дробление на мелкие части; дезинтегрирующий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дезинтегрирующий",
                                "target_lang_sense_clarification": "приводящий к распаду или разложению"
                            },
                            {
                                "target_lang_word": "разрушительный",
                                "target_lang_sense_clarification": "вызывающий физическое или структурное разрушение"
                            },
                            {
                                "target_lang_word": "разрушающий",
                                "target_lang_sense_clarification": "действующий на разделение, дробление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}