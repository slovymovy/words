                        "glosses": [
                            "Entourer de bolduc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "827a62d8-8f6a-4288-950e-a7eb3c1d4939",
                                "sense_id": "87610554-be7c-3e9b-a5a2-02af0979e943",
                                "text": "Je crois que je ne pourrai plus toucher un bolduc sans penser à la séance du jour; au fait je n'ai pas commencé les petits paquets à bolduquer."
                            },
                            {
                                "example_id": "e3143505-bf64-42f8-ac2f-5fc754596af7",
                                "sense_id": "87610554-be7c-3e9b-a5a2-02af0979e943",
                                "text": "Bolduquer des paquets de romans cadeaux."
                            },
                            {
                                "example_id": "054e8820-d7b7-4d74-834f-5d9735b9ddd8",
                                "sense_id": "87610554-be7c-3e9b-a5a2-02af0979e943",
                                "text": "Résultat : deux heures à découper, scotcher, bolduquer..."
                            }
                        ]
                    }
