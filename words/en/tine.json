                },
                {
                    "sense_id": "9218b3e5-746b-3cd7-9962-d736b8859f29",
                    "sense_definition": "A type of wild vetch or climbing plant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The field was overgrown with wild <w>tine</w>.",
                            "target_lang_translations": {
                                "ru": "Поле заросло дикой <w>викой</w>."
                            }
                        },
                        {
                            "text": "Farmers often consider the <w>tine</w> to be a troublesome weed.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто считают <w>вику</w> сорняком, доставляющим много хлопот."
                            }
