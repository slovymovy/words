                                    {
                                        "sense_id": "28536da0-cf47-33c5-aaa9-d31aa3265174",
                                        "entry_id": "d2285cf2-c373-3a04-89eb-b6af2a22d700",
                                        "glosses": [
                                            "eine technische Neuheit erdenken; eine Erfindung machen"
