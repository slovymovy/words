                "senses": [
                    {
                        "sense_id": "4551cd04-7e9b-36d1-848f-2b0cebfeb79a",
                        "entry_id": "27893a02-9b24-3d72-8765-556c37d3a968",
                        "glosses": [
                            "Acquérir de nouveau ce qu’on avait perdu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64cfab8d-a141-4219-ab2d-aec6fc5dc0c8",
                                "sense_id": "4551cd04-7e9b-36d1-848f-2b0cebfeb79a",
                                "text": "Phillips Kay avait déjà vu (1834) que des membres, ayant perdu l'irritabilité musculaire, pouvaient la réacquérir par une injection de sang artériel ou veineux."
                            },
                            {
                                "example_id": "5aa6aabc-ef04-4dd9-8b7b-0dea398c5281",
                                "sense_id": "4551cd04-7e9b-36d1-848f-2b0cebfeb79a",
                                "text": "or, comment comprendre, en cas pareil, le droit de résolution, puisque, immédiatement après la résolution prononcée, le voisin aurait encore et toujours le droit, en vertu de l'article 661, de réacquérir la mitoyenneté !"
                            }
                        ]
                    }
