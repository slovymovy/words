                    "sense_id": "cb65bf55-5d22-32b2-bf3a-90acc6421398",
                    "sense_definition": "de eigenschap van iemand die respect verdient door een beheerste en eerbiedwaardige houding",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ondanks de moeilijke situatie wist de koningin haar <w>waardigheid</w> te behouden.",
                            "target_lang_translations": {
                                "en": "Despite the difficult situation, the queen managed to maintain her <w>dignity</w>."
                            }
                        },
                        {
                            "text": "Je moet altijd je <w>waardigheid</w> behouden en niet reageren op gemene opmerkingen.",
                            "target_lang_translations": {
                                "en": "You must always maintain your <w>dignity</w> and not react to mean remarks."
                            }
                        }
                    ],
                    "common_phrases": [
                        "je waardigheid behouden",
                        "menselijke waardigheid"
                    ],
                    "target_lang_definitions": {
