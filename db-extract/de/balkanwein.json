                "senses": [
                    {
                        "sense_id": "d3b8de1d-da74-3c30-9f10-adb788cb9382",
                        "entry_id": "4a8ec984-ac4a-335a-88fa-6b2fb62b7287",
                        "glosses": [
                            "Wein, der auf dem Balkan angebaut wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e3703d8-2444-4117-b7ad-d722a714b653",
                                "sense_id": "d3b8de1d-da74-3c30-9f10-adb788cb9382",
                                "text": "„Der Vranec ist ein typischer Balkanwein.“"
                            },
                            {
                                "example_id": "9ec25c43-52b7-4a29-b9eb-a0cb89815b1b",
                                "sense_id": "d3b8de1d-da74-3c30-9f10-adb788cb9382",
                                "text": "„Ich denke, der Balkan sollte eine gemeinsame Marke schaffen, so etwas wie Balkanwein.“"
                            },
                            {
                                "example_id": "e802d032-55e4-4397-a28d-6d6d433e30d6",
                                "sense_id": "d3b8de1d-da74-3c30-9f10-adb788cb9382",
                                "text": "„Dazwischen liegen abgedroschene Walzer von Lehár, Lanner, den Straußens und Waldteufel, Charakterstücke (\"Heinzelmännchens Wachparade\"), idyllische Szenen (\"Die Mühle im Schwarzwald\"), virtuoser Geigenkitsch (\"Balkanwein\"), Musicals und Filmmusiken und all die Volksmusikpotpourris, von \"Kinderlandexpress\" bis hin zu \"Es singt der Rhein\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
