                                "fr": "Ma mère est <w>arrivée</w> à vélo."
                            }
                        },
                        {
                            "text": "Ik zag hem in een gloednieuwe auto komen <w>aanrijden</w>.",
                            "target_lang_translations": {
                                "en": "I saw him <w>drive up</w> in a brand-new car.",
                                "fr": "Je l'ai vu <w>arriver</w> dans une voiture flambant neuve."
                            }
                        }
                    ],
                    "synonyms": [
                        "aankomen",
                        "arriveren"
                    ],
                    "antonyms": [
                        "wegrijden",
                        "vertrekken"
                    ],
                    "common_phrases": [
