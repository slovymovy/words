                        "source_entry_id": "32d72305-e6da-3727-b8b5-d5f10895929a",
                        "target_lang_word": "Milchbart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchbart",
