                "senses": [
                    {
                        "sense_id": "ce053153-cc34-36de-a813-0e8b2687912d",
                        "entry_id": "0e92feeb-4bd3-305f-ba75-c561f7f60b53",
                        "glosses": [
                            "электроход, на котором электрогенераторы приводятся в действие дизелями."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49d3a274-9a72-4dca-9a49-da1aa98f89c5",
                                "sense_id": "ce053153-cc34-36de-a813-0e8b2687912d",
                                "text": "В силовых установках дизель-электроходов потребителем энергии двигателя также является электрогенератор, питающий своим током гребные и вспомогательные электромоторы."
                            },
                            {
                                "example_id": "adba1889-8052-4f0f-80b1-c644085134aa",
                                "sense_id": "ce053153-cc34-36de-a813-0e8b2687912d",
                                "text": "Сегодня дизель-электрохоход «Обь», приняв на борт 4 019 тонн различного груза для третьей антарктической экспедиции, вышел в рейс."
                            }
                        ]
                    }
