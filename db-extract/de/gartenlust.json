                "senses": [
                    {
                        "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                        "entry_id": "b8b7fcda-64f1-3c40-a8ad-ebac0adbb9b2",
                        "glosses": [
                            "Freude/Lust an der Gestaltung und Pflege von Gartenanlagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c200da6-4be3-40c5-84c7-b0ae7ff93088",
                                "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                                "text": "„Es steht jetzt im Landschaftsteil des Schlossparks, dort wo beispielsweise auch die Gartenlust immer stattfindet.“"
                            },
                            {
                                "example_id": "829c82ac-49a1-472b-888c-2518dbca70c9",
                                "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                                "text": "„Englische Gartenkunst und Gartenlust äußern sich in vielen Spielarten, und jede Scholle ist ein Hort ganz persönlicher Befindlichkeit.“"
                            },
                            {
                                "example_id": "998dc37e-68cb-46e6-a3c3-8191691592c6",
                                "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                                "text": "„Kenntnisreich und mit ansteckender Gartenlust weist der Autor auf die absichtsvolle Gestaltung der Anlagen hin, auf Götter, Philosophen und den gern aufgestellten Herkules, der Stärke und Klugheit des Hausherrn symbolisierte.“"
                            },
                            {
                                "example_id": "cd3f4b0c-146e-4f35-90ac-bcb292d4a4e0",
                                "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                                "text": "„Die Gartenlust der Kunst, Blumen und Früchte zu malen, wird, von Holland gesäugt, seit 1670 in Hamburg geübt und geschätzt, von den Meistern Stuven und Tamm bis zu Amelie Ruths und Paul Mechlen.“"
                            },
                            {
                                "example_id": "49273ab0-2a94-4444-bf11-24d1ecbce7a1",
                                "sense_id": "ffe775ff-e620-3b59-b8e7-a5cf91f49e4f",
                                "text": "„Auch Friedrichs Schwestern Wilhelmine von Bayreuth und Königin Luise Ulrike von Schweden betrieben mit leidenschaftlicher Gartenlust die Ausgestaltung ihrer Sehnsuchtsorte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
