                    ]
                },
                {
                    "sense_id": "900586b5-f13f-342d-afb5-c38812dffd06",
                    "sense_definition": "Полученный в результате практической деятельности или эксперимента.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "experimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После проведения экспериментальной части работы студенты получают <w>опытные</w> данные для их обработки."
                        },
                        {
                            "text": "Все <w>опытные</w> результаты подтвердили правильность выдвинутой научной гипотезы."
                        }
                    ],
                    "synonyms": [
                        "практический"
                    ],
                    "antonyms": [
