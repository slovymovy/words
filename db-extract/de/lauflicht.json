                ],
                "senses": [
                    {
                        "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                        "entry_id": "cd460c0c-117f-39b8-a65f-806a566f0e5f",
                        "glosses": [
                            "Reihe von in einer Richtung nacheinander angeordneten Lichtquellen, die so geschaltet oder programmiert sind, dass sie der Reihe nach ein- und ausgeschaltet werden, wodurch für das menschliche Auge der Eindruck entsteht, als würde das Licht „laufen“ oder „wandern“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "776cfc85-8066-404d-8437-63e1ce237912",
                                "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                                "text": "„Weißes, dynamisches Lauflicht soll die Fahrgäste zur Haltposition des Zuges leiten.“"
                            },
                            {
                                "example_id": "b5dac4b5-20ed-4e51-b07a-52bfbefaf177",
                                "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                                "text": "„Zusätzlich zu einem superhellen Scheinwerfer verfügt der Mavaro Neo über ein schön in den Gepäckträger und die Vorderseite des Rahmens (Steuerrohr) integriertes Lauflicht, um Sie bei allen Lichtverhältnissen besser sichtbar zu machen.“"
                            },
                            {
                                "example_id": "62119e60-9030-4a3d-a5cb-fa80806cdec5",
                                "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                                "text": "„Es lässt sich in drei verschiedenen Stufen einstellen, darunter als Dauerlicht, im Blink-Modus und als Lauflicht.“"
                            },
                            {
                                "example_id": "acb735bd-f473-4773-93e8-49567d1d7bc3",
                                "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                                "text": "„Der Chaser ermöglicht es Ihnen Lauflichter und Blinkeffekte zu programmieren, bewegte Scheinwerfer (z.B. Moving Heads) zu steuern oder Farbverläufe über die Zeit zu generieren.“"
                            },
                            {
                                "example_id": "13adbd9a-2801-445e-a0c0-9d758d56f629",
                                "sense_id": "7de6170c-d7e9-3466-8420-effa69b00c28",
                                "text": "„Am heutigen Tag wollen wir ein Lauflicht programmieren, das Beispiel aus dem Handbuch ist gut beschrieben ABER auch sehr umständlich, denn es werden lediglich 3 Geschwindigkeiten angeboten, mit Pausen von 400 ms, 200ms und 100ms.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                        "entry_id": "cd460c0c-117f-39b8-a65f-806a566f0e5f",
                        "glosses": [
                            "speziell für Läufer entwickeltes tragbares Licht; Lichtquelle, die zum Tragen beim Laufen gedacht ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "e40e698d-7ce2-404c-bb78-21df9644390d",
                                "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                                "text": "„Auch für Läufer und Läuferinnen ist es wichtig während des joggen alles zu erkennen, dafür eignet sich ideal dieses Lauflicht.“"
                            },
                            {
                                "example_id": "4756794a-7828-405d-92b1-a900e1f3ae35",
                                "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                                "text": "„Wenn ich endlich wieder richtig fit bin, teste ich ein Lauflicht von Decathlon- wird ja mittlerweile schon so früh duster, dass man kaum noch im Hellen laufen kann…“"
                            },
                            {
                                "example_id": "2b588c4a-bbed-48ec-a249-7740402fe5d5",
                                "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                                "text": "„Dieses Lauflicht erfüllt voll und ganz die Bedürfnisse von Läufern für bergauf und bergab sowie gerade Straßen, um Ihre Sicherheit zu schützen und versehentliche Stolperfallen zu vermeiden.“"
                            },
                            {
                                "example_id": "1135337b-0b8d-4eb5-893e-81502fcb20bf",
                                "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                                "text": "„Wetterfestes Sicherheitslicht: Die Lauflichter für Läufer sind leicht und wasserfest.“"
                            },
                            {
                                "example_id": "86377fe4-8d7a-4a0e-ba9c-58b64054eab7",
                                "sense_id": "5f4d5d55-64ad-3472-8d03-7bda77649a22",
                                "text": "„Diese Lauflichter für Läufer werden Sie jederzeit sicher und geschützt halten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
