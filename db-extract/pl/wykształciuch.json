                "translations": [
                    {
                        "translation_id": "9b64fa29-f770-4c01-87f4-5946f337ffe1",
                        "source_entry_id": "08041905-f68a-3a7a-84de-faf5c1c0e265",
                        "source_sense_id": "fec3d584-d899-30a5-b8c9-7f2a3f52a0f0",
                        "target_lang_word": "clever clogs",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clever clogs",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "759fb10f-7217-3765-b12c-1b07ed48d90e",
                                        "entry_id": "17db2ec3-276c-3f8a-a301-0811b675407b",
                                        "glosses": [
                                            "Somebody who is rather too clever; a smart aleck; sometimes used as an epithet."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a871db80-c624-40f5-bf10-f7c955acadcc",
                                                "sense_id": "759fb10f-7217-3765-b12c-1b07ed48d90e",
                                                "text": "'Not in itself,' said the Doctor, holding the gun at arm's length. 'But you tell me, what happens if some clever clogs gets this in his lab? Finds out how it works? The human race gets the secret of Dalek weapons. You'll all be dead by Wednesday week.'"
                                            },
                                            {
                                                "example_id": "4408fef9-8521-4b18-abcc-276efb70b98e",
                                                "sense_id": "759fb10f-7217-3765-b12c-1b07ed48d90e",
                                                "text": "'All right then, clever-clogs,' said Yasmin. 'Any idea which one?'"
                                            },
                                            {
                                                "example_id": "aea7be45-36c5-4668-86e0-0180c21e8645",
                                                "sense_id": "759fb10f-7217-3765-b12c-1b07ed48d90e",
                                                "text": "'Yes, perfect. Mr Clever Clogs has done it again!'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
