                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b7be004-2a57-4a4c-98c5-8c5b7c7e4a25",
                                "sense_id": "b446b456-4810-3d63-b20d-f5b413930c33",
                                "text": "De locomotief en onze wagon stonden vlak bij de trap die naar het bovengedeelte van het station leidde, waar winkels, kaartloketten en restaurants waren."
                            },
                            {
                                "example_id": "68a52f9f-11c7-4d35-8bf9-dfb592475a41",
                                "sense_id": "b446b456-4810-3d63-b20d-f5b413930c33",
                                "text": "Op beelden is te zien dat het bovengedeelte van de bus helemaal in elkaar gedrukt is. De ramen zijn weg en het dak is tegen de bovenkant van de stoelen aangedrukt."
                            }
                        ]
                    }
