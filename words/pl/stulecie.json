                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W ubiegłym <w>stuleciu</w> technologia rozwinęła się w niesamowitym tempie.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>столетии</w> технологии развивались с невероятной скоростью.",
                                "en": "In the last <w>century</w>, technology developed at an incredible pace.",
                                "nl": "In de vorige <w>eeuw</w> ontwikkelde de technologie zich in een ongelooflijk tempo.",
                                "de": "Im vergangenen <w>Jahrhundert</w> entwickelte sich die Technologie in einem unglaublichen Tempo.",
                                "fr": "Au <w>siècle</w> dernier, la technologie s'est développée à un rythme incroyable.",
                                "it": "Nel <w>secolo</w> scorso la tecnologia si è sviluppata a un ritmo incredibile.",
                                "cs": "V minulém <w>století</w> se technologie vyvíjely neuvěřitelným tempem.",
                                "tr": "Geçtiğimiz <w>yüzyılda</w> teknoloji inanılmaz bir hızla gelişti.",
                                "es": "En el pasado <w>siglo</w>, la tecnología se desarrolló a un ritmo increíble.",
                                "zh": "在上个<w>世纪</w>，科技以惊人的速度发展。"
                            }
                        },
                        {
                            "text": "Oto waza sprzed trzech <w>stuleci</w>; jest bardzo cenna.",
                            "target_lang_translations": {
                                "ru": "Вот ваза, созданная три <w>столетия</w> назад; она очень ценная.",
                                "en": "Here is a vase from three <w>centuries</w> ago; it is very valuable.",
                                "nl": "Dit is een vaas van drie <w>eeuwen</w> geleden; hij is zeer waardevol.",
                                "de": "Hier ist eine Vase von vor drei <w>Jahrhunderten</w>; sie ist sehr wertvoll.",
                                "fr": "Voici un vase vieux de trois <w>siècles</w> ; il a une grande valeur.",
                                "it": "Ecco un vaso risalente a tre <w>secoli</w> fa; è molto prezioso.",
                                "cs": "Tohle je váza z doby před třemi <w>stoletími</w>; je velmi cenná.",
                                "tr": "İşte üç <w>asır</w> öncesinden kalma bir vazo; çok değerlidir.",
                                "es": "Aquí hay un jarrón de hace tres <w>siglos</w>; es muy valioso.",
                                "zh": "这是一个三个<w>世纪</w>前的花瓶；它非常珍贵。"
                            }
                        }
                    ],
