                "senses": [
                    {
                        "sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                        "entry_id": "791bd8b1-a412-3108-85a1-8fbf1540be72",
                        "glosses": [
                            "een beoefenaar van de psychologie"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c31725b9-933c-432f-ac09-1a010bb830c1",
                                "sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                                "text": "De negentiende-eeuwse Amerikaanse psycholoog G. Stanley Hall merkte bijvoorbeeld ooit op dat enig kind zijn 'een ziekte op zichzelf' is."
                            },
                            {
                                "example_id": "c8d5854b-b9bc-464d-bd0f-d506cea3afd1",
                                "sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                                "text": "Dat leeftijdsverschil zou er ook nog voor kunnen zorgen, zegt een Nederlandse psycholoog wanneer ik haar de hypothese van die twee Amerikaanse wetenschappers voorleg, dat kinderen uit hetzelfde gezin vaak specifieke rollen krijgen toebedeeld."
                            },
                            {
                                "example_id": "4704d5c9-4577-4de5-9082-9ee353782ee5",
                                "sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                                "text": "'Nieuwe vaders en moeders', schreef een psycholoog die begin jaren tachtig de balans van het onderzoek naar ouderschap opmaakte, 'rapporteren dat ze slaaptijd, televisietijd, sekstijd en zelfs wc-tijd tekortkomen', met dank aan hun borelingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7759bc7-0532-377d-ad5b-5f3a321010de",
                        "entry_id": "791bd8b1-a412-3108-85a1-8fbf1540be72",
                        "glosses": [
                            "hulpverlener die mensen helpt bij psychische problemen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed76107-af9e-472a-9e47-0d173be38c88",
                                "sense_id": "d7759bc7-0532-377d-ad5b-5f3a321010de",
                                "text": "De psycholoog probeerde zijn patiënt te doorgronden."
                            },
                            {
                                "example_id": "0338d37a-983c-4e27-a323-94f314bad7e0",
                                "sense_id": "d7759bc7-0532-377d-ad5b-5f3a321010de",
                                "text": "Misschien had ik beter naar een een psycholoog kunnen gaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c86aedf3-c9ba-4486-9cf9-2a9567023cf5",
                        "source_entry_id": "791bd8b1-a412-3108-85a1-8fbf1540be72",
                        "source_sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                        "source_sense_description": "een beoefenaar van de psychologie",
                        "target_lang_word": "Psychologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                        "entry_id": "dedfefcb-bb36-38d5-ba5e-e19292091a91",
                                        "glosses": [
                                            "jemand, der ein Studium der Psychologie, der Wissenschaft vom Erleben und Verhalten des Menschen, erfolgreich abgeschlossen hat"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6a2728a-92d3-4f23-99eb-b4215d9c8573",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Wiegt das Interesse an der Geheimhaltung bestimmter Tatsachen weniger als der Schutz von Leben, Gesundheit etc., darf der Psychologe die Verschwiegenheitspflicht brechen.“"
                                            },
                                            {
                                                "example_id": "78d767ed-4a68-49ff-a285-ad4e82fffbbc",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Um dem abzuhelfen, machten sich Soziologen, Analytiker, Gynäkologen, Psychologen und diverse Sachbuchautoren an die Arbeit.“"
                                            },
                                            {
                                                "example_id": "6c0a7ea1-ddba-49cc-8f9a-72cdd7f1b819",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„In einem berühmten Experiment ließ ein Psychologe jedesmal eine Glocke erklingen, wenn er einem Hund Futter gab.“"
                                            },
                                            {
                                                "example_id": "5123100f-b585-4f81-a4d1-06e1127059ee",
                                                "sense_id": "34244bbc-1fe4-3080-8ff6-32f902925a60",
                                                "text": "„Ähnliche Modelle der transgenerationalen Weitergabe erkannten Psychologen später bei den Kindern der Vietnam-Krieg-Veteranen und den Kindern von Kriegsflüchtlingen, zum Beispiel aus dem Kosovo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95f8f7ea-7cc0-4a0b-a42f-2952cefe0074",
                        "source_entry_id": "791bd8b1-a412-3108-85a1-8fbf1540be72",
                        "source_sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                        "source_sense_description": "een beoefenaar van de psychologie",
                        "target_lang_word": "psychologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                        "entry_id": "36101ee3-f286-36d4-b962-273ca7f546c7",
                                        "glosses": [
                                            "An expert in the field of psychology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fc10a0c-9a0d-43ea-ac56-7c6b0c4ae086",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "In 2009, the Obama Administration released guidelines on enhanced interrogation written in 2003 and 2004 by the CIA Office of Medical Services. ^((OMS).1-3(appendix F)) The OMS guidelines, even in redacted form, and opinions from the US Department of Justice's (DOJ’s) Office of Legal Counsel show that CIA physicians, psychologists, and other health care personnel had important roles in enhanced interrogation."
                                            },
                                            {
                                                "example_id": "1630121e-1cb8-4117-bc64-64ec776e1d7a",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "Investigating why IBM salespeople were so successful, researchers found that IBM set easy targets for their salespeople rather than targets that were difficult to reach and so most of their salespeople achieved their targets. IBM had hired psychologists to define optimum motivational goals for their salespeople and it was discovered that if the targets were achievable the salespeople became very confident and motivated (unlike their demotivated cousins in rival companies) and went out and sold even more computers."
                                            },
                                            {
                                                "example_id": "6ebd5c8d-7122-4a01-8396-f6313e7031f0",
                                                "sense_id": "1584eb68-03c9-3e09-ba57-fdb8a5899047",
                                                "text": "Self-help programs can give people the nudge they need to see a psychologist or encourage healthy changes, but that is not always the case, experts say. […] Redding’s study asked four psychologists with expertise in anxiety and depressive disorders to rate each self-help book on five criteria: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a5226d5-445f-426b-ac89-2f9d01196c76",
                        "source_entry_id": "791bd8b1-a412-3108-85a1-8fbf1540be72",
                        "source_sense_id": "74176bc7-9a82-3681-8a72-98fa2ee50efa",
                        "source_sense_description": "een beoefenaar van de psychologie",
                        "target_lang_word": "psychologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb3c31b-021a-3f88-bdec-eae8b5ccf344",
                                        "entry_id": "d8d9e45a-e6b3-3a68-8245-2df48e1a9f1f",
                                        "glosses": [
                                            "Professionnel spécialisé en psychologie."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d77f717e-339c-4032-9774-b01fac7aaa4b",
                                                "sense_id": "8bb3c31b-021a-3f88-bdec-eae8b5ccf344",
                                                "text": "L’homme a inventé les dieux et il a créé l’amour avec son cortège de sensibleries ridicules ou criminelles. L’amour a donné naissance au poète, puis au psychologue et, pour couronner l’humaine sottise, à cet enfonceur de portes ouvertes qui s’est baptisé psychanalyste — le paladin du refoulement et l'écuyer servant la Haute Dame Libido."
                                            },
                                            {
                                                "example_id": "ad367012-1457-4a17-819e-4c7fa3a32d99",
                                                "sense_id": "8bb3c31b-021a-3f88-bdec-eae8b5ccf344",
                                                "text": "Je me suis amusé à rechercher comment, tel journaliste sérieux et compétent, tel historien, tel psychologue, avaient pu reprendre à leur compte la fable du 80%; chacun en fait la répétait pour l’avoir trop souvent lue."
                                            },
                                            {
                                                "example_id": "f114215f-5bf5-468a-9bec-f6bbd2a7394b",
                                                "sense_id": "8bb3c31b-021a-3f88-bdec-eae8b5ccf344",
                                                "text": "Une peste de psychologue, que mes parents m’avaient emmené voir sur le conseil d’une prof complètement tarée, avait parlé de « nonchaloir oriental » pour expliquer ces accès de paresse."
                                            },
                                            {
                                                "example_id": "df7f259e-b6f7-4e2f-9ce9-bf0d9db615a2",
                                                "sense_id": "8bb3c31b-021a-3f88-bdec-eae8b5ccf344",
                                                "text": "Dans tous ces récits des victimes apparaissent des figures protectrices, celles qui ont dit « je te crois » et qui ont agi en conséquence : une mère ou un parent, un enseignant, une policière ou un gendarme, l’avocat général à l’audience malgré l’acquittement, une psychologue ou un médecin, un éducateur, la littérature, une émission, un article dans un journal, le témoignage d’une autre victime, un groupe de parole sur l’inceste, un film, la description des troubles de stress post-traumatique. Quelqu’un, une voix, un point fixe qui permet de ne pas se croire folle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d6695ff-d87c-34c5-88a4-306cc4a111c3",
                                        "entry_id": "d8d9e45a-e6b3-3a68-8245-2df48e1a9f1f",
                                        "glosses": [
                                            "Celui qui a une grande connaissance du comportement humain."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0591d9-eeac-47c3-b2e7-28c9506f20e0",
                                                "sense_id": "5d6695ff-d87c-34c5-88a4-306cc4a111c3",
                                                "text": "Racine est un grand psychologue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b158c4f2-fe35-32a9-9400-64b6278521c3",
                                        "entry_id": "d8d9e45a-e6b3-3a68-8245-2df48e1a9f1f",
                                        "glosses": [
                                            "Celui qui sait se rendre compte des sentiments d’autrui."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c5a938-c537-43af-b02e-924f53c24b3b",
                                                "sense_id": "b158c4f2-fe35-32a9-9400-64b6278521c3",
                                                "text": "Raïssouli est évidemment un profond psychologue qui connaît nos petites faiblesses et sait comment il faut nous prendre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "psychologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fbe33c8d-2498-3266-842c-48f16ccfb0c2",
                                        "entry_id": "144f653d-6bb3-31bf-963e-c1f65f642288",
                                        "glosses": [
                                            "Qui sait se rendre compte des sentiments d’autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a88dfce-7259-4439-8a42-a3964aa3d3d5",
                                                "sense_id": "fbe33c8d-2498-3266-842c-48f16ccfb0c2",
                                                "text": "Bien qu’il n’en sache pas exactement la trame,\nJe jurerais qu’il sait fort bien ce qu’il en est ;\nCar l’habitude l’a rendu fin psychologue.\nIl m’a vu m’éloigner de mon pas le plus rogue."
                                            },
                                            {
                                                "example_id": "500df4c9-10f0-4ec2-8a84-c9117a9f55ad",
                                                "sense_id": "fbe33c8d-2498-3266-842c-48f16ccfb0c2",
                                                "text": "Il est précis, net, raisonneur jusqu’à la sécheresse. Mais il est aussi très psychologue. Il s’adresse à la raison plutôt qu’au cœur. Il appartient bien à ce siècle par la rigueur de son analyse, l’inflexibilité de sa logique, le mépris de l’imagination."
                                            }
                                        ]
                                    }
                                ]
                            },
