                        "entry_id": "93f94b76-26d6-3c79-9ba0-68e034e435cc",
                        "glosses": [
                            "выцвести, стать менее ярким, блёклым под действием солнца"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
