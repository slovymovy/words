                "senses": [
                    {
                        "sense_id": "3e407da1-e046-30b0-8059-0a5e58d57824",
                        "entry_id": "407d5fb3-22c3-3119-a5cc-76449bcb42ae",
                        "glosses": [
                            "Maßnahme, die das Ziel hat eine Einsparung (Kostensenkung) zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b67a1bb-26bd-41c4-8127-1aceb8279233",
                                "sense_id": "3e407da1-e046-30b0-8059-0a5e58d57824",
                                "text": "„Keine andere Sparmaßnahme soll in den kommenden Jahren so viel Geld in die Staatskassen spülen.“"
                            },
                            {
                                "example_id": "0717f58c-b6eb-44ef-9737-e6b2ff31ca89",
                                "sense_id": "3e407da1-e046-30b0-8059-0a5e58d57824",
                                "text": "„Schulrätin Marianne Konrad will das Flex-Modell hingegen nicht als Sparmaßnahme sehen - im Gegenteil: Für den Differenzierungsunterricht sei ein Zusatzlehrer notwendig, außerdem dürfe eine Kombi-Klasse maximal 25 statt 29 Schüler haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
