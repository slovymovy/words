                "senses": [
                    {
                        "sense_id": "cf5885ef-6e53-3b58-8d75-ac7f17799cdc",
                        "entry_id": "3a4ae7aa-265f-33e7-8a78-887eb11265eb",
                        "glosses": [
                            "To combine with oxygen or otherwise make an oxide."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c7d6b593-d5bb-44e5-89df-4e0461834fb9",
                                "sense_id": "cf5885ef-6e53-3b58-8d75-ac7f17799cdc",
                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb9b995b-b36c-3963-973d-aa956188c294",
                        "entry_id": "3a4ae7aa-265f-33e7-8a78-887eb11265eb",
                        "glosses": [
                            "To increase the valence (or the positive charge) of an element by removing electrons."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6326f510-8ec7-3f88-b627-e17dd0745845",
                        "entry_id": "3a4ae7aa-265f-33e7-8a78-887eb11265eb",
                        "glosses": [
                            "To coat something with an oxide."
                        ],
                        "tags": [],
                        "examples": []
                    },
