                                "target_senses": [
                                    {
                                        "sense_id": "ba7b1a31-4df3-3d83-8751-87add4062483",
                                        "entry_id": "3e2cc2c4-5069-3994-bc81-4399cddaa83d",
                                        "glosses": [
                                            "A cylinder with elliptical cross-section."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272a7bd9-edc3-4e13-861c-056d58aade7b",
                                                "sense_id": "ba7b1a31-4df3-3d83-8751-87add4062483",
                                                "text": "The intrados of a simple vault is generally formed of the portion of the surface of a cylinder, cylindroid, or sphere, never greater than that of half the solid; and the springing lines of the coussinet, which terminate the walls from which the vault rises, are generally straight lines, parallel to the axis of the cylinder or cylindroid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e510638c-eccb-32c6-a30d-e6fc7c06cf66",
                                        "entry_id": "3e2cc2c4-5069-3994-bc81-4399cddaa83d",
                                        "glosses": [
                                            "A certain three-dimensional surface described by a moving straight line, used to illustrate the motions of a rigid body and the forces that act upon it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a8127eb-9090-314b-ab55-661b364bccd8",
                                        "entry_id": "3e2cc2c4-5069-3994-bc81-4399cddaa83d",
                                        "glosses": [
                                            "A ribbon-like mucous cast frequently found in the urine in cases of mild irritation of the kidney."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
