                                        "glosses": [
                                            "A radar dome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea41deb4-0b74-4f6b-903e-7e0df28570b1",
                                                "sense_id": "a677dc05-caec-3b85-a4d0-adb6f4fd794c",
                                                "text": "Radar antennas were distributed in large quantities throughout the base, half of them in white radomes that looked as if some gigantic bird had laid a clutch of eggs at random."
                                            },
                                            {
                                                "example_id": "d8b9fef2-e841-4da7-a020-119db31d225c",
                                                "sense_id": "a677dc05-caec-3b85-a4d0-adb6f4fd794c",
                                                "text": "And it took my mother just twenty or so minutes to get to her new job at the NSA, whose boxy futuristic headquarters, topped with radomes and sheathed in copper to seal in the communications signals, forms the heart of Fort Meade."
                                            }
                                        ]
                                    }
