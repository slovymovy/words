                ],
                "senses": [
                    {
                        "sense_id": "4741eba8-6d0a-3909-b146-8618df805344",
                        "entry_id": "e37559e3-46fa-377d-b0f0-bcef3721955f",
                        "glosses": [
                            "Verband auf Landesebene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50d89f7e-2b77-483b-a9fe-5d907cfff905",
                                "sense_id": "4741eba8-6d0a-3909-b146-8618df805344",
                                "text": "„Der Streit um den richtigen Umgang mit dem Entscheid tobt seit Wochen. Zuletzt sorgte im größten Landesverband der FDP in Nordrhein-Westfalen ein Brief des Landesvorsitzenden Daniel Bahr an seine Mitglieder für Ärger, weil er sich darin gegen den Antrag der Schäffler-Gruppe aussprach.“"
                            },
                            {
                                "example_id": "a10ffacb-ecfe-4971-a9ca-2894d38712ac",
                                "sense_id": "4741eba8-6d0a-3909-b146-8618df805344",
                                "text": "„Auch der bayerische Landesverband war stark von Akademikern geprägt.“"
                            },
                            {
                                "example_id": "b299e92a-5574-4569-9a77-479c1868d382",
                                "sense_id": "4741eba8-6d0a-3909-b146-8618df805344",
                                "text": "„In den Landesverbänden befehden sich Mandatsträger, und auf Bundesebene tobt ein Machtkampf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
