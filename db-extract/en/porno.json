                                        "sense_id": "5971e047-222c-3dc5-b9e1-e0269c2a0b8d",
                                        "entry_id": "cf9b4359-f98e-3487-bd03-545dd605df68",
                                        "glosses": [
                                            "Pornographique, relatif à la pornographie."
