                        "entry_id": "900a2dff-c71e-34e3-baee-29041eae3d0b",
                        "tags": [
                            "vocative",
                            "plural",
                            "nonvirile"
                        ],
                        "form": "teoforyczne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b7a002d-340c-34d0-a121-2c91a4f574a1",
                        "entry_id": "900a2dff-c71e-34e3-baee-29041eae3d0b",
                        "glosses": [
                            "zawierający w sobie imię bóstwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61665e87-6ea3-43fd-883c-11b0f1aa3298",
                                "sense_id": "8b7a002d-340c-34d0-a121-2c91a4f574a1",
                                "text": "Wśród biblijnych imion teoforycznych wymieniane jest także imię Jezus."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd529bde-d4a5-404f-bf9c-116c10d104a6",
                        "source_entry_id": "900a2dff-c71e-34e3-baee-29041eae3d0b",
                        "source_sense_id": "8b7a002d-340c-34d0-a121-2c91a4f574a1",
                        "target_lang_word": "theophoric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theophoric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bfe5fae-ff57-329d-8aec-e0b31a70ff6c",
                                        "entry_id": "271a3999-dc69-3fd9-a463-8293aea0734c",
                                        "glosses": [
                                            "Containing the name of a deity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ba32862-b49d-4406-aa86-1c5c1196f9af",
                                                "sense_id": "0bfe5fae-ff57-329d-8aec-e0b31a70ff6c",
                                                "text": "Elizabeth is still a common theophoric name, even though El is becoming less well known."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81197d14-c6e2-47bb-a012-ebd428dd9b3f",
                        "source_entry_id": "900a2dff-c71e-34e3-baee-29041eae3d0b",
                        "source_sense_id": "8b7a002d-340c-34d0-a121-2c91a4f574a1",
                        "target_lang_word": "theophorous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theophorous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da16cc4-c645-3eec-91f0-8fab7fe30e39",
                                        "entry_id": "ffe143d5-9cd8-3ab7-af7b-4fd1e2524574",
                                        "glosses": [
                                            "Synonym of theophoric"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e51b46c-5e28-403e-bb37-0cf65b3be9f2",
                                                "sense_id": "0da16cc4-c645-3eec-91f0-8fab7fe30e39",
                                                "text": "An objection to the Kenite hypothesis has been raised by T. J . Meek, on the basis that Jochebed, the name of Moses' mother, is a theophorous name containing as a prefix the element yō, implying that the family of Moses were Yahweh worshippers."
                                            },
                                            {
                                                "example_id": "882bdf2b-8e7c-4a5c-9742-d3b0ef31fd17",
                                                "sense_id": "0da16cc4-c645-3eec-91f0-8fab7fe30e39",
                                                "text": "Names of this sort, theophorous or basilophorous, were regularly given to foreigners residing in Egypt from the New Kingdom onwards, if not earlier; even Joseph was no exception."
                                            },
                                            {
                                                "example_id": "4bc9a869-97cf-4a80-96ed-18397e6ab598",
                                                "sense_id": "0da16cc4-c645-3eec-91f0-8fab7fe30e39",
                                                "text": "The majority of the theophorous elements are based on Yah rather than el. Daiches believed that this was intended to make a clear theological distinction from el, which was a widely used Semitic term for a divinity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ca728bf-3d4f-4389-be0a-4fff8e62535a",
                        "source_entry_id": "900a2dff-c71e-34e3-baee-29041eae3d0b",
                        "source_sense_id": "8b7a002d-340c-34d0-a121-2c91a4f574a1",
                        "target_lang_word": "théophore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théophore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02ab501e-3245-3a5a-89a6-2a480badbb3f",
                                        "entry_id": "b9f74b80-fc7b-326d-aee4-76d7e0d8d2d3",
                                        "glosses": [
                                            "Qui porte Dieu en soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a14ef023-101a-4787-8de8-f1a0bbd75095",
                                                "sense_id": "02ab501e-3245-3a5a-89a6-2a480badbb3f",
                                                "text": "On les [les chrétiens] appella encore Gnostiques, c’est-à-dire hommes doüés de science & d’intelligence ; & quelquefois Théophores & Christophores, c’est-à-dire temples de Dieu, temples du Christ. On trouve dans quelques peres, mais rarement, les Chrétiens désignés par le nom même de Christs, ou consacrés à Dieu par les onctions saintes du baptême & de la confirmation."
                                            },
                                            {
                                                "example_id": "e64cd446-6c69-4725-bf58-13150d54ec9b",
                                                "sense_id": "02ab501e-3245-3a5a-89a6-2a480badbb3f",
                                                "text": "Saint Ignace, surnommé Théophore, c’est-à-dire porte-Dieu, était originaire d’Antioche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10297e0c-56f6-3a96-99b2-a3ccdbfc4c4e",
                                        "entry_id": "b9f74b80-fc7b-326d-aee4-76d7e0d8d2d3",
                                        "glosses": [
                                            "Qui porte un nom de dieu."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f6a8c3b-2845-4fe3-96e9-c2c1487f563f",
                                                "sense_id": "10297e0c-56f6-3a96-99b2-a3ccdbfc4c4e",
                                                "text": "M. Clermont Ganneau s’applique à décomposer en ses divers éléments le nom théophore d’Abdousibos."
                                            },
                                            {
                                                "example_id": "4ace3b37-7901-42e0-b69f-95cf851fd59b",
                                                "sense_id": "10297e0c-56f6-3a96-99b2-a3ccdbfc4c4e",
                                                "text": "Le verbe […] se reconstruit à partir de l’origine, tandis que bien des qualifications pâtissent encore de longs siècles d’immobilisme théophore."
                                            },
                                            {
                                                "example_id": "84632b76-df38-4db4-a37f-e6f7bbc532ac",
                                                "sense_id": "10297e0c-56f6-3a96-99b2-a3ccdbfc4c4e",
                                                "text": "Le culte de Ḫebat était très développé au Kizzuwatna et en Syrie du Nord. Plusieurs reines hittites de la dynastie impériale (d’origine hourrite), ont porté un nom théophore de Ḫebat : par exemple, la célèbre reine Puduḫepa, la femme du roi Ḫattušili iii."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
