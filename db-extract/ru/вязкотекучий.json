                                        "sense_id": "02bf08b9-5194-305d-bb93-1c7a1281a935",
                                        "entry_id": "5e2d464c-1e93-3704-b8f0-4ce0f8888128",
                                        "glosses": [
                                            "von hoher Viskosität, wenig fließfähig"
                                        ],
                                        "tags": [
                                            "bei Flüssigkeiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc748574-3e82-45ed-b931-c97a2b11197f",
                                                "sense_id": "02bf08b9-5194-305d-bb93-1c7a1281a935",
                                                "text": "Man muss den Sirup einkochen, bis er richtig zähflüssig wird."
                                            },
                                            {
                                                "example_id": "84f4ff4f-6cc8-4be6-a2fb-30d343900703",
                                                "sense_id": "02bf08b9-5194-305d-bb93-1c7a1281a935",
                                                "text": "Bitumen ist eine schwarze, zähflüssige Masse."
                                            }
                                        ],
