                        "sense_id": "17e6671e-3df4-3932-92ba-8e3c421def45",
                        "entry_id": "4aabbfca-a9af-3247-a129-585ed01d93a3",
                        "glosses": [
                            "Scandinavische krijger, behorend tot de noordelijke tak van de Germanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08d8aed-5273-4f01-983b-61be9eeb12b4",
                                "sense_id": "17e6671e-3df4-3932-92ba-8e3c421def45",
                                "text": "Vikingen namen toen zij hier kwamen prachtige schatten met zich mee, machtige strijders waren hun leiders zwierven al over zee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55b2df1a-9391-43a6-b490-7cc0629a7da0",
