                    {
                        "sense_id": "1b19749e-f8ca-3d98-91dd-48e37c8d068a",
                        "entry_id": "2c6eb85f-30b4-3d0e-8eb3-1e46557e648b",
                        "glosses": [
                            "Qui est atteint de monomanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ece5399a-44b3-447c-af07-23f25ce2aab7",
                                "sense_id": "1b19749e-f8ca-3d98-91dd-48e37c8d068a",
                                "text": "Lorenzo.– Brutus était un fou, un monomane, et rien de plus."
                            },
                            {
                                "example_id": "52ba4c19-d4ef-4bf7-aed9-49ef484416f9",
                                "sense_id": "1b19749e-f8ca-3d98-91dd-48e37c8d068a",
                                "text": "Il est monomane."
                            }
                        ]
                    },
                    {
                        "sense_id": "70d64c5e-ed9c-3a56-be98-5d27f5d85870",
                        "entry_id": "2c6eb85f-30b4-3d0e-8eb3-1e46557e648b",
                        "glosses": [
