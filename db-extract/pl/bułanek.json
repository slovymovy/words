                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b025f52d-a94a-4b9b-a6d4-106095c054b9",
                                "sense_id": "d6ea38bc-e366-3953-9197-81ec3dbe25c8",
                                "text": "Myślałem przez chwilę, że nas z bułankiem wichura pogrzebie!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0231e344-e8ef-4559-9e25-962b739eae93",
                        "source_entry_id": "d5119d39-ade3-3994-a360-27ed519ef402",
                        "source_sense_id": "d6ea38bc-e366-3953-9197-81ec3dbe25c8",
                        "target_lang_word": "саврас",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "саврас",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1763eee-094e-30d6-a846-24737d9fd22f",
                                        "entry_id": "8064fd0e-f246-3402-99c6-9d44f160d3e7",
                                        "glosses": [
                                            "саврасая лошадь, саврасый конь"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "819f8168-1ae6-3d1c-94a2-ce98c2c86058",
                                        "entry_id": "8064fd0e-f246-3402-99c6-9d44f160d3e7",
                                        "glosses": [
                                            "простая рабочая лошадь, простой рабочий конь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e66a3fd-0d99-4c8d-b577-5af95d8a6c3a",
                                                "sense_id": "819f8168-1ae6-3d1c-94a2-ce98c2c86058",
                                                "text": "Улица, вечерняя улица, вечерняя улица века, рысаки, саврасы, были повсюду."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d877587f-14eb-333a-bc84-5d81d9fdb797",
                                        "entry_id": "8064fd0e-f246-3402-99c6-9d44f160d3e7",
                                        "glosses": [
                                            "перен., устар. то же, что саврас без узды; человек, предающийся кутежам и разгулу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44bf1ca6-1135-4782-991b-5d8e3ab3a9dc",
                                                "sense_id": "d877587f-14eb-333a-bc84-5d81d9fdb797",
                                                "text": "«Живёт так, кое-как», говорили соседи. В этом слове так сосредоточивалось представление об экскурсиях в лес в компании кутящих городских саврасов, о пьяных ночах с песнями в бабкиной избе, о неделях впроголодь с выпрашиваньем у соседок взаймы муки или круп…"
                                            },
                                            {
                                                "example_id": "6ed1d972-c26e-4f62-8448-f9fe94712382",
                                                "sense_id": "d877587f-14eb-333a-bc84-5d81d9fdb797",
                                                "text": "В последнее время он очень кутил и вообще держал себя настоящим саврасом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
