                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1906d0d0-faf7-409f-a3dc-aa2b7087dfaa",
                        "source_entry_id": "f3d6c39d-4b70-3053-adb4-76a492e6aa21",
                        "source_sense_id": "a5dc95cb-ab1e-3567-8c4e-9ea6495688d2",
                        "target_lang_word": "heuristique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heuristique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fad51fe-792c-378b-8c72-c80b820aa08b",
                                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                                        "glosses": [
                                            "Art d’inventer, de faire des découvertes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35961f89-9849-314d-ac98-a4d0bec8c763",
                                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                                        "glosses": [
                                            "Art de repérer de manière exhaustive toute la documentation relative à un sujet d’étude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44bc8fa-126b-4b9b-a2b9-1e1598af1849",
                                                "sense_id": "35961f89-9849-314d-ac98-a4d0bec8c763",
                                                "text": "Certaines enquêtes ne retiennent que les études qui leur paraissent de bonne qualité ; d’autres sont moins exigeantes et il est probable que les précautionnistes ou les écologistes ont tendance à privilégier les travaux les plus pessimistes, au nom de l’heuristique de la peur, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58a1b629-6a43-3118-91ab-567155dbbadc",
                                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                                        "glosses": [
                                            "Discipline qui se propose de dégager les règles de la recherche scientifique et de la découverte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "185829f9-da84-377f-b9b3-1f7d96b26bdf",
                                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                                        "glosses": [
                                            "Suite d'opérations mentales simples conduisant à une prise de décision rapide, ou à l’estimation d’un risque par exemple."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee61050f-63be-3ac7-897e-727e0e44735e",
                                        "entry_id": "36e60aa8-b102-3ad1-874f-39935fb23de7",
                                        "glosses": [
                                            "Méthode de résolution de problèmes non fondée sur un modèle formel et qui n’aboutit pas nécessairement à une solution optimale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "heuristique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de878b84-2803-3a4c-acfc-467828cff4de",
                                        "entry_id": "05777c7c-44e4-36ed-9edf-4d5c9e050ac7",
                                        "glosses": [
                                            "Qui aide à la recherche, à la découverte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51e267cf-2650-4ce0-b1cf-d8c91c95cfb3",
                                                "sense_id": "de878b84-2803-3a4c-acfc-467828cff4de",
                                                "text": "Les utilisateurs peuvent fixer un seuil au-delà duquel de tels messages sont considérés comme des pourriels. Les filtres heuristiques analysent et trient les messages en fonction de critères fixes."
                                            },
                                            {
                                                "example_id": "dcf03b9d-e762-4ac6-8c65-0a51c40427f5",
                                                "sense_id": "de878b84-2803-3a4c-acfc-467828cff4de",
                                                "text": "C’est sans doute la pire des mystifications frontistes : Hollande n’incarne en rien une alternative au « système », mais il en est le révélateur au sens heuristique."
                                            },
                                            {
                                                "example_id": "b9ec41d4-d048-4bc0-ba2b-ff0fbeba118a",
                                                "sense_id": "de878b84-2803-3a4c-acfc-467828cff4de",
                                                "text": "Ce procédé heuristique ne lui est pas propre : en auditeur attentif des mythes et histoires ojibwa, il est coutumier d’une méthodologie analogue, qu’emploient les humains qui l’entourent lorsqu’ils tentent de comprendre les agissements des êtres qui peuplent leur milieu : il faut pouvoir se mettre temporairement à leur place pour se poser la question du monde depuis leur perspective, que l’on teinte souvent d’humour et de plaisanterie pour se prémunir des puissances de pensée et d’agir de ces autres dont on sait pertinemment qu’elles peuvent nous déborder à tout moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d59bc911-4e08-3d46-bf31-6c50729136fd",
                                        "entry_id": "05777c7c-44e4-36ed-9edf-4d5c9e050ac7",
                                        "glosses": [
                                            "Qui incite l'élève à découvrir par lui-même ce qu'on veut lui enseigner. Pédagogie heuristique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3efe2667-b3eb-35ba-ae75-73da924dce62",
                                        "entry_id": "05777c7c-44e4-36ed-9edf-4d5c9e050ac7",
                                        "glosses": [
                                            "Qui nous guide dans la vie quotidienne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
