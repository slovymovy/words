    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60c9b8ba-8168-3044-90aa-b01f97a8f2fd",
                    "sense_definition": "przyjść na świat; wydać krzyk przyjściem na świat w wyniku porodu",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "narodziny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W małej wiosce <w>narodził</w> się chłopiec o niezwykłym talencie muzycznym.",
                            "target_lang_translations": {
                                "en": "In a small village, a boy with an extraordinary musical talent <w>was born</w>."
                            }
                        },
                        {
                            "text": "Gdy wreszcie <w>narodziło</w> się długo wyczekiwane dziecko, rodzice płakali ze szczęścia.",
                            "target_lang_translations": {
                                "en": "When the long-awaited child <w>was</w> finally <w>born</w>, the parents wept with joy."
                            }
                        }
                    ],
                    "synonyms": [
                        "urodzić się",
                        "przyjść na świat"
                    ],
                    "common_phrases": [
                        "narodzić się na nowo"
                    ],
                    "target_lang_definitions": {
                        "en": "to be born; to come into the world through birth (used reflexively: narodzić się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be born",
                                "target_lang_sense_clarification": "to come into life from birth"
                            },
                            {
                                "target_lang_word": "come into the world",
                                "target_lang_sense_clarification": "to be born"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2edee90-87f1-39c1-bdff-eeabb9232950",
                    "sense_definition": "powstać, uformować się lub zacząć istnieć w sposób metaforyczny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "powstanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego głowie nagle <w>narodził</w> się genialny plan ratunku dla firmy.",
                            "target_lang_translations": {
                                "en": "A brilliant plan to save the company suddenly <w>was born</w> in his mind."
                            }
                        },
                        {
                            "text": "Podczas wspólnych podróży <w>narodziła</w> się między nimi piękna i trwała przyjaźń.",
                            "target_lang_translations": {
                                "en": "During their travels together, a beautiful and lasting friendship <w>arose</w> between them."
                            }
                        }
                    ],
                    "common_phrases": [
                        "narodził się pomysł",
                        "narodziła się nadzieja"
                    ],
                    "target_lang_definitions": {
                        "en": "to arise, come into being, or develop metaphorically (used reflexively: narodzić się)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be born",
                                "target_lang_sense_clarification": "metaphorical, of ideas or feelings"
                            },
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "to come into existence"
                            },
                            {
                                "target_lang_word": "spring up",
                                "target_lang_sense_clarification": "to originate or appear suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "446a0e31-82c4-3502-bc7e-740f4d4d1900",
                    "sense_definition": "wydać na świat liczne potomstwo",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wydanie potomstwa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Królowa <w>narodziła</w> wielu synów, ale tylko jeden z nich zdołał objąć tron.",
                            "target_lang_translations": {
                                "en": "The queen <w>bore</w> many sons, but only one of them managed to take the throne."
                            }
                        },
                        {
                            "text": "Stara kronika wspomina, że kobieta ta <w>narodziła</w> liczne dzieci w czasach pokoju.",
                            "target_lang_translations": {
                                "en": "The old chronicle mentions that this woman <w>gave birth to</w> numerous children in peacetime."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "używane rzadziej lub w odcieniu przestarzałym"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to give birth to numerous offspring"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "give birth to multiple children"
                            },
                            {
                                "target_lang_word": "give birth to",
                                "target_lang_sense_clarification": "produce offspring, typically multiple"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f35b1233-8ba2-3bae-933f-1c98f34b7551",
                    "sense_definition": "urodzić dziecko",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wydanie potomstwa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dawne pieśni opowiadały o niewieście, która <w>narodziła</w> syna w trudnych warunkach.",
                            "target_lang_translations": {
                                "en": "Ancient songs told of a woman who <w>gave birth to</w> a son under harsh circumstances."
                            }
                        },
                        {
                            "text": "Matka <w>narodziła</w> pierworodnego w najmroźniejszy dzień tamtej srogiej zimy.",
                            "target_lang_translations": {
                                "en": "The mother <w>bore</w> her firstborn on the coldest day of that severe winter."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "użycie przechodnie w znaczeniu 'urodzić' jest archaiczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to give birth to a child (archaic transitive use)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give birth to",
                                "target_lang_sense_clarification": "bear a child"
                            },
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "archaic or literary, to birth"
                            },
                            {
                                "target_lang_word": "beget",
                                "target_lang_sense_clarification": "archaic, to bring into being"
                            }
                        ]
                    }
                }
            ]
