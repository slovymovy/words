                        ],
                        "examples": [
                            {
                                "example_id": "42523963-da5a-438a-b66d-97326d09960a",
                                "sense_id": "6c6c3eab-456a-3127-af2c-cdd587262f52",
                                "text": "Dolly werd getroffen door de schoonheid van haar mooie hoofd met de zwarte krullen die van onder de hoge hoed tevoorschijn sprongen, haar volle schouders en haar slanke taille, van haar hele rustige, gracieuze verschijning in het zwarte rijkostuum."
                            },
                            {
                                "example_id": "77812bf6-1fc2-4341-abac-85099ddfb821",
                                "sense_id": "6c6c3eab-456a-3127-af2c-cdd587262f52",
                                "text": "Gekleed in een klassiek rijkostuum beschrijft hij met veel kennis van zaken de aanspanningen van de Twentse Rijtuigenvereniging ‘Koets’n Keerls’ die gisteren in Tubbergen werd verreden."
                            }
                        ]
                    }
