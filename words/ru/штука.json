{
    "word_family": [
        "штучный",
        "штучка",
        "штуковина",
        "поштучный",
        "поштучно"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a579aefb-8a53-389f-a201-d5170d355ff4",
                    "sense_definition": "Отдельный предмет при счёте, экземпляр чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "counting_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, взвесьте мне пять <штук> этих красных яблок.",
                            "target_lang_translations": {
                                "en": "Please weigh five <pieces> of these red apples for me.",
                                "de": "Bitte wiegen Sie mir fünf <Stück> dieser roten Äpfel ab."
                            }
                        },
                        {
                            "text": "В коробке осталась только одна <штука>, остальные мы уже съели.",
                            "target_lang_translations": {
                                "en": "There is only one <piece> left in the box, we already ate the rest.",
                                "de": "In der Schachtel ist nur noch ein <Stück>, den Rest haben wir schon gegessen."
                            }
                        }
                    ],
                    "synonyms": [
                        "экземпляр",
                        "единица"
                    ],
                    "antonyms": [
                        "совокупность"
                    ],
                    "common_phrases": [
                        "пять штук",
                        "пара штук",
                        "несколько штук",
                        "цена за штуку"
                    ],
                    "target_lang_definitions": {
                        "en": "An individual item when counting, a copy of something.",
                        "de": "Ein einzelner Gegenstand beim Zählen oder ein Exemplar von etwas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "piece",
                                "target_lang_sense_clarification": "single item"
                            },
                            {
                                "target_lang_word": "thing",
                                "target_lang_sense_clarification": "individual object"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stück",
                                "target_lang_sense_clarification": "allgemeiner Zahlklassifikator für Dinge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "109d8102-f40a-3015-927e-99ff553e9cc9",
                    "sense_definition": "Неопределённый предмет, вещь или явление (часто используется, когда говорящий не может или не хочет называть объект точно).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "object_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Что это за странная <штука> лежит у тебя на столе?",
                            "target_lang_translations": {
                                "en": "What is that strange <thing> lying on your table?",
                                "de": "Was ist das für ein seltsames <Ding>, das bei dir auf dem Tisch liegt?"
                            }
                        },
                        {
                            "text": "Жизнь — это очень сложная и интересная <штука>.",
                            "target_lang_translations": {
                                "en": "Life is a very complicated and interesting <thing>.",
                                "de": "Das Leben ist eine sehr komplizierte und interessante <Sache>."
                            }
                        }
                    ],
                    "synonyms": [
                        "вещь",
                        "предмет",
                        "объект",
                        "фиговина",
                        "хреновина",
                        "хрень"
                    ],
                    "antonyms": [
                        "понятие"
                    ],
                    "common_phrases": [
                        "странная штука",
                        "интересная штука",
                        "вот так штука",
                        "полезная штука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An indefinite object, thing, or phenomenon (often used when the speaker cannot or does not want to name the object precisely).",
                        "de": "Ein unbestimmter Gegenstand, eine Sache oder ein Phänomen (oft verwendet, wenn der Sprecher das Objekt nicht genau benennen kann oder will)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thing",
                                "target_lang_sense_clarification": "object or entity"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "unspecified matter"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ding",
                                "target_lang_sense_clarification": "Gegenstand, dessen Eigenschaften nicht näher bezeichnet sind"
                            },
                            {
                                "target_lang_word": "Sache",
                                "target_lang_sense_clarification": "allgemeiner Begriff für einen Sachverhalt oder Gegenstand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de40e02b-4753-3a7d-8595-c39453b91fe2",
                    "sense_definition": "Ловкий трюк, хитрость, неожиданная выходка или сложное обстоятельство.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trick_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вся <штука> в том, что мы совершенно не знаем правильного ответа.",
                            "target_lang_translations": {
                                "en": "The <thing> is that we absolutely don't know the right answer.",
                                "de": "Die ganze <Sache> ist, dass wir die richtige Antwort überhaupt nicht kennen."
                            }
                        },
                        {
                            "text": "Он выкинул такую <штуку>, что все гости были просто в шоке.",
                            "target_lang_translations": {
                                "en": "He pulled such a <trick> that all the guests were simply shocked.",
                                "de": "Er hat so einen <Streich> gespielt, dass alle Gäste einfach schockiert waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "трюк",
                        "фокус"
                    ],
                    "common_phrases": [
                        "выкинуть штуку",
                        "вот в чём штука",
                        "хитрая штука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A clever trick, ruse, unexpected prank, or complex circumstance.",
                        "de": "Ein geschickter Trick, eine List, ein unerwarteter Streich oder ein komplexer Umstand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trick",
                                "target_lang_sense_clarification": "prank or ruse"
                            },
                            {
                                "target_lang_word": "thing",
                                "target_lang_sense_clarification": "crux or central point"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trick",
                                "target_lang_sense_clarification": "geschickte List oder Täuschung"
                            },
                            {
                                "target_lang_word": "Sache",
                                "target_lang_sense_clarification": "der Kernpunkt oder die eigentliche Angelegenheit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1c12594-70a1-336d-a04d-bb0e30c21df1",
                    "sense_definition": "Тысяча денежных единиц (обычно рублей или долларов).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот ремонт обошёлся мне в целую <штуку> долларов.",
                            "target_lang_translations": {
                                "en": "This renovation cost me a whole <grand>.",
                                "de": "Diese Renovierung hat mich einen ganzen <Tausender> gekostet."
                            }
                        },
                        {
                            "text": "Он попросил одолжить ему одну <штуку> до следующей зарплаты.",
                            "target_lang_translations": {
                                "en": "He asked to borrow one <grand> until the next paycheck.",
                                "de": "Er hat mich gebeten, ihm einen <Tausender> bis zum nächsten Gehalt zu leihen."
                            }
                        }
                    ],
                    "synonyms": [
                        "косарь",
                        "тонна"
                    ],
                    "common_phrases": [
                        "штука баксов",
                        "две штуки",
                        "полторы штуки"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A thousand monetary units (usually rubles or dollars).",
                        "de": "Tausend Geldeinheiten (meist Rubel oder Dollar)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "thousand units of currency"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Riesen",
                                "target_lang_sense_clarification": "umgangssprachlich für tausend Einheiten einer Währung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe75afbf-93a9-36a6-9848-1354b1bf6967",
                    "sense_definition": "Цельный кусок ткани фабричного производства (рулон).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fabric_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Купец привёз на ярмарку целую <штуку> дорогого красного бархата.",
                            "target_lang_translations": {
                                "en": "The merchant brought a whole <piece> of expensive red velvet to the fair.",
                                "de": "Der Händler brachte ein ganzes <Stück> teuren roten Samt auf den Markt."
                            }
                        },
                        {
                            "text": "На пошив этих костюмов ушла одна <штука> серого полотна.",
                            "target_lang_translations": {
                                "en": "One <piece> of gray linen went into making these suits.",
                                "de": "Für das Nähen dieser Anzüge wurde ein <Stück> graues Leinen verbraucht."
                            }
                        }
                    ],
                    "synonyms": [
                        "кусок",
                        "отрез"
                    ],
                    "common_phrases": [
                        "штука сукна",
                        "штука полотна",
                        "штука холста"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A whole piece of factory-produced fabric (a roll).",
                        "de": "Ein ganzes Stück fabrikgefertigten Stoffes (eine Rolle)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "piece",
                                "target_lang_sense_clarification": "length of fabric"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stoffballen",
                                "target_lang_sense_clarification": "eine Rolle Stoff"
                            },
                            {
                                "target_lang_word": "Stück",
                                "target_lang_sense_clarification": "ein Teil eines Ganzen oder ein Abschnitt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
