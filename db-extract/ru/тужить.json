                                    },
                                    {
                                        "sense_id": "76d06197-99f1-354b-80c3-d71b64f39c9c",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To harm."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9c2a6de-8ab8-3cbb-9b15-6154beaa4c97",
                                        "entry_id": "43497215-0d0a-39ee-9c25-2303d863e9cf",
                                        "glosses": [
                                            "To submit or file a grievance (about)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d4e53c5-f253-4c12-9d4b-2cd0fdcbd5eb",
                                                "sense_id": "e9c2a6de-8ab8-3cbb-9b15-6154beaa4c97",
                                                "text": "Even if the executive director rules against the employee on appeal, the employee can still grieve the termination to the superintendent followed by an appeal to the … Board of Trustees."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b9b0d6-fabe-3060-86bf-cab507b39a2e",
                                        "entry_id": "0528c36c-dbf6-3fbd-a164-65ce1dd328ee",
                                        "glosses": [
                                            "A governor of a town or province."
                                        ],
