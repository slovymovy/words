                "senses": [
                    {
                        "sense_id": "08c7127c-6983-38e7-bc81-ff4479893d88",
                        "entry_id": "3e143213-0386-3fdc-b3a1-72957245c53e",
                        "glosses": [
                            "öffentliche (Zwangs-)Versteigerung"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "8d644919-10b7-42aa-9937-a2076ef5d065",
                                "sense_id": "08c7127c-6983-38e7-bc81-ff4479893d88",
                                "text": "„Wer selbst nicht vom Fach ist, sollte sich von einem Bauexperten oder einem Architekten begleiten lassen, um die zu ersteigernde Immobilie vor der Gant genau unter die Lupe zu nehmen.“"
                            },
                            {
                                "example_id": "f5305fd3-7095-4b9c-b9c9-7e263b00a56c",
                                "sense_id": "08c7127c-6983-38e7-bc81-ff4479893d88",
                                "text": "„An dem Tage, als von Obrigkeits wegen das goldglänzende Schild am Hause eingezogen und die Gant verkündet wurde, weinte alles, groß und klein, und ließ sich den ganzen Tag nicht am Fenster und nicht auf der Gasse sehen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
