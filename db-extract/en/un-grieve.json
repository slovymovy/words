                    {
                        "sense_id": "abbfaaf9-de0a-3ca3-bbcb-92878973eff4",
                        "entry_id": "991f0428-9f2f-364f-8c4b-0cc982161a83",
                        "glosses": [
                            "To stop or cause to stop grieving because the cause of grief is removed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70cf7587-66b0-4f4c-9d07-77cd4492daff",
                                "sense_id": "abbfaaf9-de0a-3ca3-bbcb-92878973eff4",
                                "text": "God was deeply grieved and there was no one to un-grieve Him quickly enough."
                            },
                            {
                                "example_id": "500af69e-d325-4857-9172-64073a860479",
                                "sense_id": "abbfaaf9-de0a-3ca3-bbcb-92878973eff4",
                                "text": "They've grieved you for years and now they're being asked to un-grieve you, and, sadly, that just isn't something that very many people understand because, well, it's never been a possibility before now."
                            },
                            {
                                "example_id": "e0d842b8-49e2-44ac-92a0-96321b4715c7",
                                "sense_id": "abbfaaf9-de0a-3ca3-bbcb-92878973eff4",
                                "text": "“Mind telling me what you were doing?” “I needed to un-grieve God.”"
                            }
                        ]
                    }
                ],
