                "senses": [
                    {
                        "sense_id": "a1d83b62-6db4-395e-b75d-62a8e69524b8",
                        "entry_id": "50729f2c-692c-3aba-a29e-780c84ca101c",
                        "glosses": [
                            "разг. приблизительный расчёт, подсчёт, предварительное заключение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06eb6eda-fb5e-4ebe-80c1-aa1e9296b876",
                                "sense_id": "a1d83b62-6db4-395e-b75d-62a8e69524b8",
                                "text": "Обходя «нечистый якорь» с левой стороны, Фёдоров внимательно смотрел под ноги, опасаясь споткнуться и одновременно радуясь приличной прозрачности воды, которая, по самым скромным прикидкам, составляла метров тринадцать."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3b89a57-51d2-35bf-a71d-de1893f3ca7a",
                        "entry_id": "50729f2c-692c-3aba-a29e-780c84ca101c",
                        "glosses": [
                            "спорт., проф. контрольное упражнение перед соревнованием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "737f8e92-9658-4c44-a16e-cb29d92d308b",
                                "sense_id": "b3b89a57-51d2-35bf-a71d-de1893f3ca7a",
                                "text": "По специальной плавательной подготовке рекомендуется еженедельно проводить контрольные прикидки на основную дистанцию, а также на отдельные её части."
                            }
                        ]
                    }
