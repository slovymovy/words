                "senses": [
                    {
                        "sense_id": "cb977ef2-1ea9-34ae-b430-39c6702490a6",
                        "entry_id": "202f3541-d253-3840-a893-0976355a9a0a",
                        "glosses": [
                            "Zelt, das für Offiziere (und nicht für die Mannschaft) bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddeab488-9003-4bd6-bbc5-e25ca4da5e99",
                                "sense_id": "cb977ef2-1ea9-34ae-b430-39c6702490a6",
                                "text": "Der Militärarzt verordnete dem Verwundeten ein Klistier und ging in das Offizerszelt."
                            },
                            {
                                "example_id": "2fe8ce5e-13f9-4769-bdd1-1c4485a82cba",
                                "sense_id": "cb977ef2-1ea9-34ae-b430-39c6702490a6",
                                "text": "„Wir bogen um das Gebüsch und ritten nach dem Quell, an welchem das Offizierszelt bereits errichtet war.“"
                            },
                            {
                                "example_id": "eb4b3ea7-6501-48e6-85c4-0e62889e30b3",
                                "sense_id": "cb977ef2-1ea9-34ae-b430-39c6702490a6",
                                "text": "„Der stämmige Obergefreite Alfred Bär trat ins Offizierszelt, wo deutsche und französische Militärs das Ende des Manövers ‚Colibri‘ feierten, und griff sich das Bierglas aus der Hand des Generals Jacques Massu.“"
                            },
                            {
                                "example_id": "ef00d8b1-dcde-44af-9e08-e44cc7494112",
                                "sense_id": "cb977ef2-1ea9-34ae-b430-39c6702490a6",
                                "text": "„Immerhin vermittelt ein originales preußisches Offizierszelt ebenso Anschauung wie ein Gemälde von der Zerstörung Dresdens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
