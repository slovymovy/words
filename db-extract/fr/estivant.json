                "senses": [
                    {
                        "sense_id": "b7deebf3-083b-30b8-9420-13f33a6b1a07",
                        "entry_id": "5a49494a-a3a6-311c-b9ea-4aaf92a03378",
                        "glosses": [
                            "Touriste de la saison estivale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57858b16-4d20-45ba-a284-9215f7d614dd",
                                "sense_id": "b7deebf3-083b-30b8-9420-13f33a6b1a07",
                                "text": "De son côté, l’estivant français aimait, en faisant l’économie du voyage, retrouver à Dinard ce qu’il chérissait outre-Manche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2cf5491b-68f5-4add-a15f-2bf8e63bdd81",
                        "source_entry_id": "5a49494a-a3a6-311c-b9ea-4aaf92a03378",
                        "source_sense_id": "b7deebf3-083b-30b8-9420-13f33a6b1a07",
                        "target_lang_word": "Sommerfrischler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommerfrischler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e2a81b2-b3be-324b-96bf-003707e0cf09",
                                        "entry_id": "1e4e89d7-9146-35f4-9c66-0f1f91ca79f3",
                                        "glosses": [
                                            "jemand, der die Sommerfrische genießt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c7dc7d1-f98a-41a9-acad-338222eefccf",
                                                "sense_id": "3e2a81b2-b3be-324b-96bf-003707e0cf09",
                                                "text": "„Er riß das alte, baufällige Haus ab und stellte einen stattlichen Neubau hin, der eine freundliche Gaststube, ein Vereinszimmer, einen hübschen Laden und im Dachgeschosse drei Fremdenzimmer enthielt, die er sofort an Sommerfrischler vermieten konnte.“"
                                            },
                                            {
                                                "example_id": "fda01793-035f-4aa8-a3fd-8e64bc066abf",
                                                "sense_id": "3e2a81b2-b3be-324b-96bf-003707e0cf09",
                                                "text": "„Die Sommerfrischler hüpfen auf einem Fuß, das andere Bein angelegt wie Flamingos.“"
                                            },
                                            {
                                                "example_id": "6f71c83c-1c32-410e-af49-00c30be51318",
                                                "sense_id": "3e2a81b2-b3be-324b-96bf-003707e0cf09",
                                                "text": "„Dr. Owlglass stenographierte in der Lokalbahn den Kompetenzstreit zwischen einem Sommerfrischler und dem Stationsvorsteher mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e335e4b3-b974-4798-9dcc-5b8194afcff9",
                        "source_entry_id": "5a49494a-a3a6-311c-b9ea-4aaf92a03378",
                        "source_sense_id": "b7deebf3-083b-30b8-9420-13f33a6b1a07",
                        "target_lang_word": "Sommergast",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sommergast",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c0e374-7d81-38a0-9d7b-d2734f4a5f12",
                                        "entry_id": "369fd98f-353c-36c0-864f-bbd1c6d4528f",
                                        "glosses": [
                                            "Person, die einen Urlaub/Ferien an einem Urlaubs-/Ferienort im Sommer verbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577f5ec8-a2a5-4279-a0ea-cc719c3b6506",
                                                "sense_id": "e2c0e374-7d81-38a0-9d7b-d2734f4a5f12",
                                                "text": "„In Ostende waren fast gar keine Sommergäste mehr.“"
                                            },
                                            {
                                                "example_id": "7277a358-4e06-49f2-a899-15441e940ac4",
                                                "sense_id": "e2c0e374-7d81-38a0-9d7b-d2734f4a5f12",
                                                "text": "„Im Unterschied zu den Skiurlaubern im Winter kamen die Sommergäste beinahe alle aus den nachbarlichen Regionen Mitteleuropas, wo stattliches Körpergewicht als ein Zeichen von Wohlstand gilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
