                "senses": [
                    {
                        "sense_id": "dc1279e4-bafc-3d00-b174-2abdf31b2ada",
                        "entry_id": "1d2f3109-849f-3890-a208-5a054d789631",
                        "glosses": [
                            "Déconfiner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4a9886e-2b12-444f-8f58-cf1506677f65",
                                "sense_id": "dc1279e4-bafc-3d00-b174-2abdf31b2ada",
                                "text": "Quand ça va repartir à la hausse avec le déconfinement ça permettra de ne pas reconfiner ou alors plus tard puis de redéconfiner plus tôt."
                            },
                            {
                                "example_id": "3b1877d1-13b2-445b-8de9-d6c15755e3d9",
                                "sense_id": "dc1279e4-bafc-3d00-b174-2abdf31b2ada",
                                "text": "On peut se déconfiner, reconfiner, redéconfiner... trois ou quatre fois, normalement ça tient, d'après notre comité scientifique."
                            },
                            {
                                "example_id": "b7fc8cac-d8b4-4b88-92c8-0f0eb57883ab",
                                "sense_id": "dc1279e4-bafc-3d00-b174-2abdf31b2ada",
                                "text": "Je lis ce matin qu'il est possible qu'on déconfine, qu'on reconfine, qu'on redéconfine au fil du temps… jusqu'à la découverte d'un vaccin."
                            }
                        ]
                    }
