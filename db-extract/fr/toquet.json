        "fr-extract.jsonl": [
            {
                "entry_id": "7756d7d8-4e5f-37b0-929e-3f5123eb0bd2",
                "word": "toquet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f506578d-0049-4d3e-ae0b-e519699d9c8c",
                        "entry_id": "7756d7d8-4e5f-37b0-929e-3f5123eb0bd2",
                        "tags": [
                            "plural"
                        ],
                        "form": "toquets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                        "entry_id": "7756d7d8-4e5f-37b0-929e-3f5123eb0bd2",
                        "glosses": [
                            "Sorte de petite toque, de bonnet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d16eedb-2fcf-4fd2-ad63-98d917234550",
                                "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                                "text": "[…] : puis il […] se coiffa d’un toquet de velours noir sans plume ni pierreries, s’enveloppa d’un manteau de couleur sombre, […]."
                            },
                            {
                                "example_id": "b64b72fa-b09e-420e-b8ac-e215c71cc583",
                                "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                                "text": "Une fois ce ne fut pas seulement une femme à bec d’oiseau que je vis, mais comme un oiseau même : la robe et jusqu’au toquet de Mme de Guermantes étaient en fourrures et, ne laissant ainsi voir aucune étoffe, elle semblait naturellement fourrée, comme certains vautours dont le plumage épais, uni, fauve et doux, a l’air d’une sorte de pelage."
                            },
                            {
                                "example_id": "5f04a2e2-b2f6-4421-afb7-d088dff01936",
                                "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                                "text": "Elle était charmante en tweed farine de lin, coiffée d’un petit toquet de cuir fauve."
                            },
                            {
                                "example_id": "42ffab68-c554-4ffc-9e86-936578431db7",
                                "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                                "text": "Quelques hommes seulement prirent part aux obsèques et peu de femmes même, de celles qui profitent de toutes les occasions pour sortir leurs vêtements noirs, leurs toquets de crêpe et qui aiment renifler l’odeur de l’encens."
                            },
                            {
                                "example_id": "b66d5847-6802-490b-a05e-aca2d9667a22",
                                "sense_id": "4026410d-7481-3b52-9b36-75398b4c3fa5",
                                "text": "Dans sa jeunesse, on faisait beaucoup le toquet en duvets avec voilette. C’était gracieux. Dans ce temps-là les femmes savaient s’habiller."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "18bc8186-e9cc-3951-b3a1-d8c4f80ff6ed",
                "word": "toquet",
