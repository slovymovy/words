                                        "entry_id": "25a4a42e-3f49-33d6-b922-98c43d4a9b1e",
                                        "glosses": [
                                            "Wand- oder Deckenverzierung aus Stuck^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23e1e12b-3bb2-49ae-a28a-e0707dc5f290",
                                                "sense_id": "6f0a1a7a-daae-3cf5-a5d0-50a784817cc6",
                                                "text": "Der Saal war reichlich mit Stuck verziert."
                                            },
                                            {
                                                "example_id": "e32748d9-6e92-458b-a8a5-5976e2fa55e6",
                                                "sense_id": "6f0a1a7a-daae-3cf5-a5d0-50a784817cc6",
                                                "text": "„In den Wohnungen gab es ein Badezimmer, Stuck an den Decken und Kachelöfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
