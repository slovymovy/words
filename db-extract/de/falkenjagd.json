                "senses": [
                    {
                        "sense_id": "9f3c101f-a7d2-35db-a64d-ff0e7c08a2fd",
                        "entry_id": "ddc64e86-1bc2-37c0-b86b-a8949ff31ae1",
                        "glosses": [
                            "die Jagd mit abgerichteten Falken oder anderen Greifvögeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69568daa-8ece-4ca7-8322-54d930be9978",
                                "sense_id": "9f3c101f-a7d2-35db-a64d-ff0e7c08a2fd",
                                "text": "„Er schreibt zur Falkenjagd das Standardwerk \"Über die Kunst, mit Vögeln zu jagen\" und schart Wissenschaftler um sich.“"
                            },
                            {
                                "example_id": "c9aec987-5c5e-4ec2-a42a-b7fb754d588c",
                                "sense_id": "9f3c101f-a7d2-35db-a64d-ff0e7c08a2fd",
                                "text": "„Der Staufer begeisterte sich so sehr für die Falkenjagd wie kein anderer Herrscher des Mittelalters.“"
                            },
                            {
                                "example_id": "bbd36f43-75c5-4860-a20b-0fbd6011bdcf",
                                "sense_id": "9f3c101f-a7d2-35db-a64d-ff0e7c08a2fd",
                                "text": "„Neben als Ackerland genutzten Flächen unterhalten die Scheichs in der Wüste beispielsweise weitläufige Residenzen mit eigener Flughafenlogistik und bringen ihr eigenes Personal für Falkenjagden mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
