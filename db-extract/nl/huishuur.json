                        "cross_references": [
                            {
                                "target_word": "rent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A payment made by a tenant at intervals in order to lease a property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c19c77-0380-4686-8ee9-65efa4a2a6ac",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "I am asking £300 a week rent."
                                            },
                                            {
                                                "example_id": "aef436fd-6a86-4e99-94fb-cd4c249c359a",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything."
                                            },
                                            {
                                                "example_id": "4c918a88-5523-43cf-8b8c-6d5bdffef982",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "We never ever argue, we never calculate / The currency we've spent / I love you, you pay my rent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccc7169-9a35-394d-be16-ae818891827e",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A similar payment for the use of a product, equipment or a service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5386c1a3-9832-3191-9e48-ed2d894fa7aa",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A profit from possession of a valuable right, as a restricted license to engage in a trade or business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d86d2d6c-f036-421f-9ea9-c79e9556d76d",
                                                "sense_id": "5386c1a3-9832-3191-9e48-ed2d894fa7aa",
                                                "text": "A New York city taxicab license earns more than $10,000 a year in rent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d744f6-67ea-3e9b-a228-f1e5a901c599",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "An object for which rent is charged or paid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f566749-295a-3aa0-b18a-8d6d3229d7b1",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "Income; revenue."
                                        ],
                                        "tags": [
                                            "countable",
