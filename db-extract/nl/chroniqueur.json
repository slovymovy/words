                                        "sense_id": "bfa530f0-94ef-36bb-9d3b-62622ba0b02c",
                                        "entry_id": "df4dae0e-f8f5-3c0b-a768-5f4a12ae9f30",
                                        "glosses": [
                                            "Persona que recaba y redacta información de acontecimientos históricos o de actualidad."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ab056142-d66a-319e-99e0-fac6a3ddf12d",
                                        "entry_id": "df4dae0e-f8f5-3c0b-a768-5f4a12ae9f30",
