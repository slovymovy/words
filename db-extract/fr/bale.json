                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dc9d6255-fda6-38de-b4e2-6e0705294600",
                        "entry_id": "ec080f2d-f5fc-3e17-9654-8a86c2e52922",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3578e88-6767-447c-9852-553775b69348",
                                "sense_id": "dc9d6255-fda6-38de-b4e2-6e0705294600",
                                "text": "C’est ce qu’évoque Jake Gyllenhaal dans Variety, en rappelant la délicatesse du cinéaste quand il ne lui a pas donné le rôle de Batman, confié à Christian Bale."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f3bd17dc-9b85-3eb0-a9c5-3acfe01ab7c5",
                "word": "bale",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e744a8f-65a9-4591-87f8-fc046e5f7249",
                        "entry_id": "f3bd17dc-9b85-3eb0-a9c5-3acfe01ab7c5",
