                "senses": [
                    {
                        "sense_id": "c6d12aaf-ad02-3110-9042-b58d70f6111a",
                        "entry_id": "b04ac58e-631b-3bd3-af38-746b97e3bf2a",
                        "glosses": [
                            "durch die Kriegsmarine ausgeübte Kontrolle zur See"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078cfa49-7315-4b91-9c23-555f455b6e75",
                                "sense_id": "c6d12aaf-ad02-3110-9042-b58d70f6111a",
                                "text": "„Dadurch, dass Russland zur dominierenden Macht im Nord- und Südkaukasus geworden war, gewann es auch die Seeherrschaft im Kaspischen Meer.“"
                            },
                            {
                                "example_id": "9cba5ac0-b6a0-43ff-b606-24b7a1780dd3",
                                "sense_id": "c6d12aaf-ad02-3110-9042-b58d70f6111a",
                                "text": "„Obwohl Italien bei Kriegseintritt erheblich mehr Uboote als Deutschland besaß, war die »Regia Marina« (Königliche Marine) nicht in der Lage, die Seeherrschaft im Mittelmeer zu erringen.“"
                            },
                            {
                                "example_id": "6d0740d1-b732-476e-a915-2ed290f6f7d9",
                                "sense_id": "c6d12aaf-ad02-3110-9042-b58d70f6111a",
                                "text": "„So ist es schon seit Jahrhunderten – seit die Kontrolle des afrikanischen Südzipfels zu einem strategisch wichtigen Vorteil im Ringen um die Seeherrschaft auf dem Globus wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
