                },
                {
                    "sense_id": "55c9d52f-4763-36e4-a796-9c2b33b69538",
                    "sense_definition": "A very short period of time; a moment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stayed there for only a brief <w>spurt</w> before moving along.",
                            "target_lang_translations": {
                                "zh": "她只在那里停留了短短的<w>片刻</w>便继续前行。",
                                "es": "Se quedó allí solo un breve <w>rato</w> antes de continuar."
                            }
                        },
                        {
                            "text": "Wait here for a <w>spurt</w> while I check the door.",
                            "target_lang_translations": {
                                "zh": "在这儿等<w>一会儿</w>，我去查看一下门。",
                                "es": "Espera aquí un <w>instante</w> mientras reviso la puerta."
                            }
                        }
                    ],
