                                "target_lang_word": "verschrikkelijk",
                                "target_lang_sense_clarification": "van ernstige gevolgen of situaties"
                            },
                            {
                                "target_lang_word": "vreselijk",
                                "target_lang_sense_clarification": "zeer ernstig of beangstigend"
                            },
                            {
                                "target_lang_word": "rampzalig",
                                "target_lang_sense_clarification": "catastrofaal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0d23ff0-f103-3b4f-a133-1106d70ca9ef",
                    "sense_definition": "Warning of bad things to come; suggesting that something terrible will happen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "omens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds and sudden silence were seen as <w>dire</w> omens by the sailors.",
                            "target_lang_translations": {
                                "ru": "Темные тучи и внезапная тишина были восприняты моряками как <w>зловещие</w> предзнаменования.",
                                "nl": "De donkere wolken en plotselinge stilte werden door de zeelieden gezien als <w>onheilspellende</w> voortekenen."
                            }
                        },
                        {
                            "text": "The prophet issued a <w>dire</w> warning about the upcoming famine.",
                            "target_lang_translations": {
                                "ru": "Пророк выступил с <w>грозным</w> предупреждением о грядущем голоде.",
                                "nl": "De profeet uitte een <w>onheilspellende</w> waarschuwing over de naderende hongersnood."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominous",
                        "portentous",
                        "sinister",
                        "foreboding"
                    ],
                    "antonyms": [
                        "auspicious",
                        "encouraging"
