                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "748ae70c-17de-3401-bf38-571a5db2a1c8",
                                        "entry_id": "17278367-540b-383d-a461-4057a9ee89c5",
