                "word": "psilophyte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "219f8bd4-afad-4ba3-b714-a1b55ae030d5",
                        "entry_id": "ab04949d-7927-3690-b935-2cff3c5d4b84",
