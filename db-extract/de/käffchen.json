                        "examples": [
                            {
                                "example_id": "36cd7bf1-114a-4d6d-83cf-0e3d87b24672",
                                "sense_id": "15566a4c-9a29-3e7b-9449-b3b46d32d5c5",
                                "text": "Hast du Lust, ein Käffchen trinken zu gehen?"
                            },
                            {
                                "example_id": "02a2f166-bf1a-4da9-bc2f-9acfa5d45857",
                                "sense_id": "15566a4c-9a29-3e7b-9449-b3b46d32d5c5",
                                "text": "Zwischendurch sollten wir uns ein Käffchen gönnen."
                            },
                            {
                                "example_id": "90a79671-c735-411e-9056-e320c5365d86",
                                "sense_id": "15566a4c-9a29-3e7b-9449-b3b46d32d5c5",
                                "text": "Soll ich uns schnell ein Käffchen machen?"
                            },
                            {
                                "example_id": "05e46107-e53c-40e3-8250-ad54933370c6",
                                "sense_id": "15566a4c-9a29-3e7b-9449-b3b46d32d5c5",
                                "text": "Am liebsten trinke ich cremige Käffchen."
                            }
                        ],
