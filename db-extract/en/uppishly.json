                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4dc41c4-af1e-4382-a13f-683c9dfaed9c",
                                "sense_id": "98866686-dba4-3853-82d7-f8538d6cf1d5",
                                "text": "“Miss Betty’s at the church now gettin’ married!” announced Marie uppishly, “and you’d best be gettin’ out of here right away, for the wedding party’s due to arrive any minute now […]”"
                            },
                            {
                                "example_id": "75888cee-edc2-4d4e-9f9e-57798ef9fc9a",
                                "sense_id": "98866686-dba4-3853-82d7-f8538d6cf1d5",
                                "text": "Miguel watched uppishly and without comment."
                            },
                            {
                                "example_id": "76d8234e-0d01-49d9-a9bb-c8be35a5d28b",
                                "sense_id": "98866686-dba4-3853-82d7-f8538d6cf1d5",
                                "text": "“I have all I need of Zoos in this nursery, thank you,” said Mary Poppins, uppishly. “Hyenas, orang-outangs, all of you. Sit up straight, and no more nonsense.”"
                            }
                        ]
                    },
