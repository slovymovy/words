                        "examples": [
                            {
                                "example_id": "cafaa523-0d94-4340-8a11-0133cbd11741",
                                "sense_id": "143e537f-ad0c-3f3f-a8f5-6cde1ba5cd8c",
                                "text": "Tijdens de autoloze zondag is een groot deel van Brussel autovrij, waardoor voetgangers, fietsers, skaters of jongeren op rolschaatsen vrij baan hebben. Maar geen speed pedelecs[sic!] dus, de fiets die tot meer dan 40 kilometer per uur kan. Ook bromfietsen en motoren zijn niet welkom. De Fietsersbond vindt de maatregel overdreven. Gewone elektrische fietsen zijn wel toegelaten."
                            },
                            {
                                "example_id": "9e90e936-47be-4ec3-9f35-2905639cd632",
                                "sense_id": "143e537f-ad0c-3f3f-a8f5-6cde1ba5cd8c",
                                "text": "Het vernieuwde skatepark krijgt een oppervlakte van zo'n 600 vierkante meter. Eind oktober is de opening. Professionale skaters geven daarbij acte de presence. Begin oktober gaat een aannemer het terrein bij de brandweerkazerne asfalteren."
                            }
                        ]
                    }
