                "senses": [
                    {
                        "sense_id": "54288ae0-2b94-3448-b287-1faeb983d5a0",
                        "entry_id": "9364dbb5-e68f-3c31-bcbd-f5e3c5563992",
                        "glosses": [
                            "das Ufer mit steilem Hang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5b538a7-f1a3-4218-8818-ce6c96271ba3",
                                "sense_id": "54288ae0-2b94-3448-b287-1faeb983d5a0",
                                "text": "„Unter dem Steilufer lag eine Straße voll Lagerhäuser.“"
                            },
                            {
                                "example_id": "ab20fd46-a9cd-4057-9ce4-5747e5d9f8c1",
                                "sense_id": "54288ae0-2b94-3448-b287-1faeb983d5a0",
                                "text": "„Hoch über dem Steilufer der Ostsee ragen die beiden Türme dieses Mammut-Gebildes in den sattblauen Septemberhimmel.“"
                            },
                            {
                                "example_id": "aafc9954-a335-4a25-a2a6-c3e47cf07f21",
                                "sense_id": "54288ae0-2b94-3448-b287-1faeb983d5a0",
                                "text": "„Der Tempelbezirk selbst, im Nordwesten der Stadt unmittelbar am Steilufer gelegen, wurde u-förmig gestaltet und mit einer Arkadenmauer umsäumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
