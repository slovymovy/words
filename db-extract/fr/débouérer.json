                ],
                "senses": [
                    {
                        "sense_id": "23edba7e-2bed-33f4-86d4-031419d526cb",
                        "entry_id": "4724927c-9263-3c47-9319-ba664b91eddd",
                        "glosses": [
                            "Démêler."
                        ],
                        "tags": [
                            "Limousin"
                        ],
                        "examples": [
                            {
                                "example_id": "eff6eaf1-6293-43b1-830b-352a5e766ce5",
                                "sense_id": "23edba7e-2bed-33f4-86d4-031419d526cb",
                                "text": "Une parole de bienvenue que le Commissaire Lagarce – chargé de débouérer l'affaire – serait bien avisé de prendre au pied de la lettre."
                            },
                            {
                                "example_id": "f934447a-ac27-4316-b62a-b23d44903437",
                                "sense_id": "23edba7e-2bed-33f4-86d4-031419d526cb",
                                "text": "Il faut dire que le paysan limousin savait très bien débouérer ses affaires, et s'y connaissait à merveille pour vous rouler dans la farine."
                            },
                            {
                                "example_id": "2109f4f1-3241-48e7-b17d-4e5e17307c76",
                                "sense_id": "23edba7e-2bed-33f4-86d4-031419d526cb",
                                "text": "Chez Bénédicte Bonnet on sait encore blanchir et débouérer les châtaignes, je pense qu'elle n'a aucune leçon \"d'authenticité paysanne\" à recevoir de votre part."
                            }
                        ]
                    }
