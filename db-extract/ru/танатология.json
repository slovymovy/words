                "senses": [
                    {
                        "sense_id": "0372b4b2-0283-33d7-aae5-822f508acf73",
                        "entry_id": "e13b11df-b8c9-3bb5-8717-f8daa8386266",
                        "glosses": [
                            "раздел теоретической и практической медицины, изучающий состояние организма в конечной стадии патологического процесса, динамику и механизмы умирания, непосредственные причины смерти, клинические, биохимические и морфологические проявления постепенного прекращения жизнедеятельности организма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9755ee77-25fb-4880-9520-146dce92a51a",
                                "sense_id": "0372b4b2-0283-33d7-aae5-822f508acf73",
                                "text": "Мы сейчас затронули вопросы смерти, относящиеся к науке танатологии. К сожалению, в нашей стране танатологии как науки нет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0dbfa5c-be90-4046-8166-a98bcb53cd20",
                        "source_entry_id": "e13b11df-b8c9-3bb5-8717-f8daa8386266",
                        "source_sense_id": "0372b4b2-0283-33d7-aae5-822f508acf73",
                        "target_lang_word": "thanatology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thanatology",
