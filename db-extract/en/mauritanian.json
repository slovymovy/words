                                            {
                                                "example_id": "f4808753-db4d-4485-8730-acc724c301cc",
                                                "sense_id": "16628e11-ef20-3334-8ef4-49f9da0c88b8",
                                                "text": "Das römische Heer, das vom Fluß Molochath wieder zurückkehrte, sah sich eines Abends plötzlich umringt von ungeheuren Massen mauretanischer und numidischer Reiterei."
                                            },
                                            {
                                                "example_id": "29c27472-d0f8-4c5e-96b1-434c16d9130d",
                                                "sense_id": "16628e11-ef20-3334-8ef4-49f9da0c88b8",
                                                "text": "So entspricht ein mauretanischer Ouguiya fünf Khoums. Letzteres bedeutet übersetzt einfach „Fünftel“. Ouguiya dagegen geht auf das arabische Wort für „Unze“ zurück."
                                            }
                                        ],
