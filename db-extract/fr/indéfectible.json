        "fr-extract.jsonl": [
            {
                "entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
                "word": "indéfectible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "89e76cb9-cea5-4f18-ae92-18c47c5df83c",
                        "entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "indéfectibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                        "entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
                        "glosses": [
                            "Qui ne peut défaillir, cesser d’être."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "46b44bd5-12ab-4a0c-9041-432d53fd9369",
                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                "text": "L’Eglise, elle est indéfectible, elle est suradmirable, elle est immense…"
                            },
                            {
                                "example_id": "d5fdd614-b277-4ec9-8f86-43c38ec25618",
                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                "text": "En sa qualité d'ami indéfectible, le Grand Mestre se trouve placé sous la sauvegarde personnelle de la reine régente."
                            },
                            {
                                "example_id": "c5aba9c7-d989-4f4b-8aa8-7fb075534d29",
                                "sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                                "text": "Debout en face de Léna, Preeti noue à son poignet un rakhi, un petit cordon tressé. Selon la tradition, il est considéré comme sacré et matérialise le lien entre elles, désormais indéfectible."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca650f6f-095e-4935-bc27-b37a00d47b01",
                        "source_entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
                        "source_sense_id": "79afe81f-210a-3636-ac1e-0865dc556537",
                        "target_lang_word": "unfehlbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfehlbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                        "entry_id": "57c14571-f3c6-38c7-aece-f1f62ccd3a8d",
                                        "glosses": [
                                            "keine Fehler machend, sich nie irrend; in seinen Entscheidungen und Urteilen keinem Fehler oder Irrtum unterworfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2c8f4c-8726-4d82-a91a-adda1a97437a",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Besonders dann, wenn er [Bernd Stromberg] emotional aufgewühlt ist, spricht er nur in halben Sätzen, gibt sich aber trotzdem als fast unfehlbarer Chef aus."
                                            },
                                            {
                                                "example_id": "4240c4c2-a619-452d-9229-2da8eec6ce18",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Mao wurde nicht länger als unfehlbarer Heiliger verehrt, sondern kritisch hinterfragt."
                                            },
                                            {
                                                "example_id": "e80766d2-4348-4dec-be64-33539a43528e",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Der Gutachter weiß, dass er nicht unfehlbar ist."
                                            },
                                            {
                                                "example_id": "040d373f-95b5-4dc3-877d-3ae11860b626",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Vor 140 Jahren, im Dezember 1869,wurde das Erste Vatikanische Konzil eröffnet. Im Kampf gegen liberale Strömungen ließ sich Papst Pius IX. dabei für unfehlbar erklären."
                                            },
                                            {
                                                "example_id": "60cfe970-9420-4679-9333-ff174035426d",
                                                "sense_id": "029b1299-6b33-34a9-aa4c-c88378182568",
                                                "text": "Mit seinem weißen Haar, seiner sonoren Stimme und der ruhigen, überlegenen Ausstrahlung war Greene auf die Darstellung moralisch unfehlbarer Autoritätsfiguren spezialisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "141ae343-10fa-471e-bda6-c02f84e94bb6",
                        "source_entry_id": "91e22d5e-c5ae-3f09-ad89-9e53874b8650",
