                    {
                        "translation_id": "b981cc19-0e81-405a-a718-022088c122b9",
                        "source_entry_id": "4a561236-0543-36a8-a3f4-47d1d75d0b03",
                        "source_sense_id": "58f3c656-6147-31c4-a715-8b7d3c2028aa",
                        "target_lang_word": "mom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                                        "entry_id": "fe254b3c-8823-3fb8-9448-9c78ba533c19",
                                        "glosses": [
                                            "Mother."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "South-Africa",
                                            "US",
                                            "West-Midlands",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26db4349-eff0-4119-ae75-6c98e4c16e13",
                                                "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                                                "text": "To find out what moms really want this year, we turned to the best source possible: our own mothers."
                                            },
                                            {
                                                "example_id": "33316b96-ce3e-4c58-815f-6435f75b7229",
                                                "sense_id": "865d2b5f-6f44-31b4-bb29-83367c3ad1b9",
                                                "text": "At a very early age, Knowles says she was taught not to draw any attention to herself. “Pretty is as pretty does,” her mom used to say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49be5914-d432-3d0b-884f-a41855368176",
                                        "entry_id": "fe254b3c-8823-3fb8-9448-9c78ba533c19",
                                        "glosses": [
                                            "Mother.",
                                            "used as a term of address for one's wife"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "South-Africa",
                                            "US",
                                            "West-Midlands",
                                            "broadly",
                                            "colloquial",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "716e1d74-4a57-4aca-a230-6a4b1b3752ad",
                                                "sense_id": "49be5914-d432-3d0b-884f-a41855368176",
                                                "text": "(spoken by the father) I don't share it with mom! Right, mom?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92becee3-de74-3850-92f7-fb7432dd604c",
                                        "entry_id": "fe254b3c-8823-3fb8-9448-9c78ba533c19",
                                        "glosses": [
                                            "An adult female owner of a pet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07de551b-0375-3ea7-a73e-c7ea17656fed",
                                        "entry_id": "f8a38132-d3a8-3d2c-850c-860c787e7653",
                                        "glosses": [
                                            "To care for in a motherly way."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd1ca4a3-7a69-40ec-baf9-d663b495254b",
                                                "sense_id": "07de551b-0375-3ea7-a73e-c7ea17656fed",
                                                "text": "The shock of my news had worn off, and now she'd want to know where I was, how I was doing, and she'd sniff out that I was with someone. “I just wanted to check in on you.” That was Mom. Totally unashamed about momming me."
                                            },
                                            {
                                                "example_id": "2b25968f-8fee-40e7-85ab-da590d15f9d5",
                                                "sense_id": "07de551b-0375-3ea7-a73e-c7ea17656fed",
                                                "text": "He tried to tell me how to live, to mom me, I told him fuck off, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9e1417c-3bf8-45d0-995a-adca4745c8a7",
                        "source_entry_id": "4a561236-0543-36a8-a3f4-47d1d75d0b03",
                        "source_sense_id": "58f3c656-6147-31c4-a715-8b7d3c2028aa",
                        "target_lang_word": "mommy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mommy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43d2c27a-82f5-377c-b672-5b1b87fc308f",
                                        "entry_id": "fbf62e31-fd87-3deb-9969-4fbe6c3e2860",
                                        "glosses": [
                                            "To treat someone like a mother would; to mother someone."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mommy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                                        "entry_id": "f90bb331-f7d2-313c-9b03-047cc75448c3",
                                        "glosses": [
                                            "Characteristic of a mother; motherly."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "informal",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d82f93b-f410-477f-a23a-884a349ba00e",
                                                "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                                                "text": "She is the mommiest of mommies."
                                            },
                                            {
                                                "example_id": "d958b164-f7dc-48ba-b7c7-e9933457428d",
                                                "sense_id": "eea2c2e7-56dc-3ad4-ac55-ad4c4c0a6683",
                                                "text": "I am smack-dab in the middle of the mommiest years of my life. There are toys strewn across my once-pristine floors, goldfish crackers in my couch cushions, and empty juice boxes in my car."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mommy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                                        "entry_id": "0494f0e2-006a-363a-8a84-12c3c9cbc3a4",
                                        "glosses": [
                                            "Mother."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "childish",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4d3b17c-0ff9-44c3-af56-c09ac17736ec",
                                                "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                                                "text": "The only bad-karma-reducing sposie on the market is a new line of biodegradable (meaning here \"useless\") sposie that won't last through the lightest of baby pees and will force you to change baby approximately once every thirty seconds, thereby completely undoing any so-called karma reduction. Only bad mommies use sposies."
                                            },
                                            {
                                                "example_id": "4740bb8a-b9a6-4874-a52f-4adb74b94e75",
                                                "sense_id": "7fb98d17-25a3-3292-a000-6edc1abd5ae2",
                                                "text": "They will never part even though in mommy's heart she wishes daddy would leave forever. One grief-some January 25 mommy rested never to return for her and daddy went on a walk. “Where is mommy”, said baby but daddy couldn't talk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f72e39-c67e-357c-8e70-5d375073b5f7",
                                        "entry_id": "0494f0e2-006a-363a-8a84-12c3c9cbc3a4",
                                        "glosses": [
                                            "A sexually attractive mother."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3f4016f-bb88-3067-a8f3-03399e23de59",
                                        "entry_id": "0494f0e2-006a-363a-8a84-12c3c9cbc3a4",
                                        "glosses": [
                                            "Any sexually attractive woman."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
