                                "example_id": "6fa4a942-602d-43d5-9d9a-930574664dbe",
                                "sense_id": "c968b113-a9a4-39ae-aa05-60339758ea34",
                                "text": "„Im Juli, August und September 1940 fand über den Ärmelkanal, Süd- und Ostengland die bis dahin größte Luftschlacht der Weltgeschichte statt.“"
                            },
                            {
                                "example_id": "97c19e52-c521-4b0a-b59e-182538ac1245",
                                "sense_id": "c968b113-a9a4-39ae-aa05-60339758ea34",
                                "text": "„Die Luftschlacht ist jetzt auf der ganzen Breite des Küstenbogens entbrannt.“"
                            }
