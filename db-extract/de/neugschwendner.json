                "senses": [
                    {
                        "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                        "entry_id": "db2fd865-61ec-3709-927c-1bf48e412ba8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e0558c-e540-40a2-ac28-ace2f2536f16",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Frau Neugschwendner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "38373454-1245-4cd0-a54c-de3b336c4162",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Herr Neugschwendner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b4bf4f7f-8b4e-4b0e-a8ab-6a41f0633ca5",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Die Neugschwendner fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0e659049-1d14-4e8f-bc62-be8e6e2b411f",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Der Neugschwendner trägt nie die Schals, die die Neugschwendner ihm strickt."
                            },
                            {
                                "example_id": "78f8f3b9-2674-40e8-b005-e583622021a5",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Neugschwendner kommt, geht der Herr Neugschwendner.“"
                            },
                            {
                                "example_id": "894d9869-ec12-48c8-bc83-301daa467c94",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Neugschwendner kommt und geht."
                            },
                            {
                                "example_id": "17550da1-2b31-48d9-b7ef-aef185c57d25",
                                "sense_id": "5e55522e-8150-3d3a-8529-1f8e92e781f8",
                                "text": "Neugschwendners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
