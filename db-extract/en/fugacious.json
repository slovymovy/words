                                                "sense_id": "5ed812bf-c8e8-3ce2-908e-7b3821b186eb",
                                                "text": "Bij deze temperaturen is zink een vrij vluchtige substantie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a78e90b-db17-33a6-b36b-c2af94a79ab1",
                                        "entry_id": "b8901a2f-dca7-33f7-b83f-73d22c524bc6",
                                        "glosses": [
                                            "zonder al te veel aandacht voor alle details"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e15c0614-fa1d-45fe-be62-561e651a3ac3",
                                                "sense_id": "7a78e90b-db17-33a6-b36b-c2af94a79ab1",
                                                "text": "Bij een vluchtig onderzoek kwam dit al snel boven water."
                                            },
                                            {
                                                "example_id": "0d9ae3cf-d428-42a0-81ff-8d401fa85a2e",
                                                "sense_id": "7a78e90b-db17-33a6-b36b-c2af94a79ab1",
                                                "text": "Ik wierp een vluchtige blik de afgrond in, prikte het handvat van mijn ijsbijl diep de sneeuw in en plaatste mijn voet voorzichtig in het eerste voetspoor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
