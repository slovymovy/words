                ],
                "senses": [
                    {
                        "sense_id": "2c4850b2-e56d-30b9-9940-37fe29ec2122",
                        "entry_id": "adf3a4e3-e9c8-34e2-bf25-500dc22903c6",
                        "glosses": [
                            "умирать, дохнуть, подыхать, издыхать, околевать"
                        ],
                        "tags": [
                            "о животном"
                        ],
                        "examples": [
                            {
                                "example_id": "e4ce25cd-9cfd-443d-99d2-4c25a50f7b7f",
                                "sense_id": "2c4850b2-e56d-30b9-9940-37fe29ec2122",
                                "text": "Десяток псов с расколотыми черепами, с отбитыми задами крутились по земле, сдыхали в корчах."
                            }
                        ]
                    },
                    {
                        "sense_id": "03d4187a-5caa-3819-b346-083bf7747363",
                        "entry_id": "adf3a4e3-e9c8-34e2-bf25-500dc22903c6",
                        "glosses": [
                            "уничиж. : умирать"
                        ],
                        "tags": [
                            "о человеке"
                        ],
                        "examples": [
                            {
                                "example_id": "8dc378c4-f5ed-43b3-967a-03edfb6a96a7",
                                "sense_id": "03d4187a-5caa-3819-b346-083bf7747363",
                                "text": "Куда, у меня две ходки было на лесоповал, в Архангельскую область, и пил я тогда так, что сам удивлялся ― как это я не сдыхаю."
                            }
                        ]
                    },
                    {
                        "sense_id": "e02d7d6d-a8d5-39a5-bfda-40176721dcde",
                        "entry_id": "adf3a4e3-e9c8-34e2-bf25-500dc22903c6",
                        "glosses": [
                            "перен., разг. переставать функционировать, обычно неожиданно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db412a97-3e0b-4dd7-9ea7-4963e7a3e1ea",
                                "sense_id": "e02d7d6d-a8d5-39a5-bfda-40176721dcde",
                                "text": "На взлете сдыхал мотор, он прибавил другим. Машина накренилась, стойка влезла в бак."
                            }
                        ]
                    }
                ],
