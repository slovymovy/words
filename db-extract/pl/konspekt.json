                        "translation_id": "495d3bca-7e14-4376-8fa6-b4d0ab6dff88",
                        "source_entry_id": "45982d9b-5b7e-3340-9fe5-177375af5549",
                        "source_sense_id": "4ca6ba2d-91c1-3639-a4f9-a9ae1b47b644",
                        "target_lang_word": "résumé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résumé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e15339c-9bc4-3a7e-a1eb-12392ae150ae",
                                        "entry_id": "ec5c6086-a6c6-3f0a-8305-bf47f06a3edc",
                                        "glosses": [
                                            "Ce qui résume un texte, un discours, un propos, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28dc660e-c4ff-419b-902c-ad0054701019",
                                                "sense_id": "9e15339c-9bc4-3a7e-a1eb-12392ae150ae",
                                                "text": "Le résumé d’un discours."
                                            },
                                            {
                                                "example_id": "aeb56ae8-43aa-4e06-b902-1c5a8434e4ee",
                                                "sense_id": "9e15339c-9bc4-3a7e-a1eb-12392ae150ae",
                                                "text": "Le résumé des débats d’un procès criminel."
                                            },
                                            {
                                                "example_id": "abd611b4-1b3e-418f-8b56-e9ff88cf8446",
                                                "sense_id": "9e15339c-9bc4-3a7e-a1eb-12392ae150ae",
                                                "text": "En aucun cas, le résumé n’est une « simple amputation » ou un « grossier élagage »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc63bd7-9d53-3537-97b3-9128a497364d",
                                        "entry_id": "ec5c6086-a6c6-3f0a-8305-bf47f06a3edc",
                                        "glosses": [
                                            "Toutes sortes de précis ou abrégés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9286906e-b0b4-4815-97fc-bf4400cc4320",
                                                "sense_id": "0bc63bd7-9d53-3537-97b3-9128a497364d",
                                                "text": "Résumé de l’histoire de France."
                                            },
                                            {
                                                "example_id": "dcb1f419-5346-472f-b658-f31fa8e21cfc",
                                                "sense_id": "0bc63bd7-9d53-3537-97b3-9128a497364d",
                                                "text": "Réviser son histoire dans un résumé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "résumé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c91c26e-7517-39f5-95a5-a3bd75753817",
                                        "entry_id": "ebfb7f50-9e2e-3f0a-bde4-9b81eeef4719",
                                        "glosses": [
                                            "Participe passé masculin singulier de résumer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3921a08a-1a0d-4890-94fc-6eb6f6235e05",
                                                "sense_id": "5c91c26e-7517-39f5-95a5-a3bd75753817",
                                                "text": "J’ai résumé les refus de Lucien par son invective hautaine de mari fidèle et d’honnête homme : « Garde l’Europe, j’ai ma femme ! » et pour le reste j’ai théâtrifié la scène de mon mieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ba66374-e54d-48c0-89e2-6014dd77eb76",
                        "source_entry_id": "45982d9b-5b7e-3340-9fe5-177375af5549",
                        "source_sense_id": "4ca6ba2d-91c1-3639-a4f9-a9ae1b47b644",
                        "target_lang_word": "abrégé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                        "entry_id": "8f4cfec8-e442-3372-a921-60859a312ae0",
                                        "glosses": [
                                            "Écrit ou discours dans lequel on rend d’une manière succincte ce qui est ou ce qui pourrait être plus développé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b04884-bdd5-47ff-9bfd-8cf2b4099c6b",
                                                "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                                "text": "Mézeray a fait lui-même un abrégé de sa grande Histoire de France."
                                            },
                                            {
                                                "example_id": "b1e02b78-4732-4e52-a63e-e7d276fb5247",
                                                "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                                "text": "On a réduit toute cette science en abrégé ; on en a fait un abrégé."
                                            },
                                            {
                                                "example_id": "5d23a51a-e358-4e71-a37f-018d69f8a9ba",
                                                "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                                "text": "Indiquez-moi un bon abrégé d’astronomie."
                                            },
                                            {
                                                "example_id": "284fb214-3aee-4408-b33a-83de386f34f6",
                                                "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                                "text": "Voici l’abrégé de sa vie."
                                            },
                                            {
                                                "example_id": "328985f7-4f12-40b9-92e2-23ba4523d1c4",
                                                "sense_id": "fc3b6dd8-a6fa-3554-ad60-eb4ea8b62298",
                                                "text": "L’homme offre un abrégé des merveilles de l’univers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c91116-15e6-37cd-a2ef-f874ea73e8cc",
                                        "entry_id": "8f4cfec8-e442-3372-a921-60859a312ae0",
                                        "glosses": [
                                            "Points essentiels d’une proposition, d’une réclamation, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dbf6ce4-9d06-4789-83c6-2fffe43526db",
                                                "sense_id": "42c91116-15e6-37cd-a2ef-f874ea73e8cc",
                                                "text": "Donnez-moi un abrégé de votre affaire."
                                            },
                                            {
                                                "example_id": "f50b545c-a927-45ac-8274-3bee38f8b9e0",
                                                "sense_id": "42c91116-15e6-37cd-a2ef-f874ea73e8cc",
                                                "text": "Ma théorie est que l’individu représente dans son développement la lignée de ses ancêtres, et que les brusques orientations vers le bien ou le mal sont dues à une influence maîtresse qui puise sa source dans l’hérédité : l’individu ne serait, somme toute, que l’abrégé de l’histoire de sa famille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc97b9a-f833-3e13-a16a-ff2049d3cd83",
                                        "entry_id": "8f4cfec8-e442-3372-a921-60859a312ae0",
                                        "glosses": [
                                            "Abrégé pneumatique : Système de clavier à commande pneumatique à dépression destiné aux orgues et imaginé par le facteur d’orgue Prosper-Antoine Moitessier de Montpellier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abrégé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "026bf961-4da4-378a-b17a-359b710f0e80",
                                        "entry_id": "bdb28e68-4a4d-33ee-b301-b69dbe09170c",
                                        "glosses": [
                                            "Qui est abrégé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aea17b06-02e4-450a-8667-267e8283c500",
                                                "sense_id": "026bf961-4da4-378a-b17a-359b710f0e80",
                                                "text": "On voit par ce tableau abrégé de l’histoire religieuse de l’ancien continent, qu’il n’y a pas un point des trois parties de l’ancien monde où l’on ne trouve établi le culte de la Nature et de ses agents principaux."
                                            },
                                            {
                                                "example_id": "7b8f3535-71c5-424f-837f-5f0de978740c",
                                                "sense_id": "026bf961-4da4-378a-b17a-359b710f0e80",
                                                "text": "Il les récita d'une haleine, sans en omettre un seul mot, tandis que Guilleragues en écrivait les parties essentielles sous sa dictée, en une forme abrégée et indéchiffrable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abrégé",
                                "target_lang_code": "fr",
                                "target_senses": [
