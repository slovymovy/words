                ],
                "senses": [
                    {
                        "sense_id": "edb0db73-1e67-3710-b524-dfdbe14bf4a4",
                        "entry_id": "91bbfdd0-4282-34c1-b171-0752e5fe4cd7",
                        "glosses": [
                            "intensiv grün"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f248da1-33bf-421e-9a20-514dd803ba71",
                                "sense_id": "edb0db73-1e67-3710-b524-dfdbe14bf4a4",
                                "text": "„Er trug ein knallgrünes Hemd und eine weite khakifarbene Hose, dazu braune Mokassins, die ihm jemand anders gekauft haben musste - sie wirkten viel zu lässig für einen Biochemiker.“"
                            },
                            {
                                "example_id": "375cb811-f5b4-497c-b48d-128bdb6cb72d",
                                "sense_id": "edb0db73-1e67-3710-b524-dfdbe14bf4a4",
                                "text": "„Die Beule schwabbelt an ihrem Bein runter. Ploppt unter dem Gummiband hervor. Schießt knallgrün über den Bürgersteig, verschwindet in einem Gulli und rumpelt und pumpelt noch ein bisschen in dunklen Eisenschächten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
