        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37be915a-bdcd-3948-8a95-0caf01e41ee9",
                    "sense_definition": "Participe présent de <w>exiger</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>exigeant</w> des résultats immédiats, le directeur a mis une pression inutile sur l'équipe.",
                            "target_lang_translations": {
                                "en": "By <w>demanding</w> immediate results, the director put unnecessary pressure on the team.",
                                "ru": "<w>Требуя</w> немедленных результатов, директор оказал на команду ненужное давление.",
                                "de": "Indem der Direktor sofortige Ergebnisse <w>verlangte</w>, setzte er das Team unnötig unter Druck.",
                                "es": "Al <w>exigir</w> resultados inmediatos, el director sometió al equipo a una presión innecesaria.",
                                "zh": "主管<w>要求</w>团队立即拿出成果，给大家带来了不必要的压力。"
                            }
                        },
                        {
                            "text": "Elle a réussi à négocier son contrat tout en <w>exigeant</w> de meilleures conditions de travail.",
                            "target_lang_translations": {
                                "en": "She managed to negotiate her contract while <w>demanding</w> better working conditions.",
                                "ru": "Ей удалось договориться о своём контракте, одновременно <w>требуя</w> лучших условий работы.",
                                "de": "Sie konnte ihren Vertrag aushandeln und <w>forderte</w> dabei bessere Arbeitsbedingungen.",
                                "es": "Logró negociar su contrato <w>exigiendo</w> mejores condiciones de trabajo.",
                                "zh": "她成功谈妥了自己的合同，同时<w>要求</w>更好的工作条件。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb meaning to demand or require.",
                        "ru": "Причастие настоящего времени от глагола «требовать», означающее настаивать на чём-либо или нуждаться в чём-либо.",
                        "de": "Partizip Präsens von »fordern«; bedeutet auf etwas bestehen oder etwas notwendig machen.",
                        "es": "Participio presente de «exigir», que significa pedir algo con insistencia o hacer necesario algo.",
                        "zh": "动词“exiger”的现在分词，表示提出要求或需要某种条件。"
