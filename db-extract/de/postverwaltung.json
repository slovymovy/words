                "senses": [
                    {
                        "sense_id": "bc3416d6-3aee-3d34-9402-01deb84969d6",
                        "entry_id": "b1d6a682-2fb5-3923-a659-d8dac68d5bd7",
                        "glosses": [
                            "Gesamtheit der Institutionen, die die Einrichtungen und Dienste der Post organisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e0fbcd-fcae-44f8-a5bc-af6b01c74bf0",
                                "sense_id": "bc3416d6-3aee-3d34-9402-01deb84969d6",
                                "text": "„In der Bizone wurde der Postdienst auf der Grundlage der früheren deutschen Postverwaltungen weiter aufgebaut.“"
                            },
                            {
                                "example_id": "b3a438d2-fb2f-4d92-a184-63c05fde0b21",
                                "sense_id": "bc3416d6-3aee-3d34-9402-01deb84969d6",
                                "text": "„Zahlreiche europäische Postverwaltungen führten Post zu, die Zahl der je Flug beförderten Postsendungen stieg von 20000 im Jahr 1934 auf 90000 im Jahr 1939.“"
                            },
                            {
                                "example_id": "3d986261-62bb-4701-836c-ceecb66d0b33",
                                "sense_id": "bc3416d6-3aee-3d34-9402-01deb84969d6",
                                "text": "„Die Postverwaltung hat anfangs versucht, ihn von seinen Gängen abzuhalten, und sogar seine Einsperrung beantragt; doch die Leute haben sich widersetzt, und man läßt ihn jetzt in Ruhe.“"
                            }
                        ],
