                "senses": [
                    {
                        "sense_id": "1ea9f5ee-adf4-325b-ab82-8124096a8629",
                        "entry_id": "1c44bcd1-e8d3-3116-bf49-b30110826b36",
                        "glosses": [
                            "wiersz o tematyce biesiadnej, wesołej lub rubasznej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b496f99-6ecf-434c-8eb9-1a131aabb530",
                                "sense_id": "1ea9f5ee-adf4-325b-ab82-8124096a8629",
                                "text": "Anakreontyki antyczne zniekształciły ponadto wizerunek poety, kreśląc jego portret jako pijaka i rozpustnika […]"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bfb0d17-9e63-4401-9b88-11bd0ec7b75c",
                        "source_entry_id": "1c44bcd1-e8d3-3116-bf49-b30110826b36",
                        "source_sense_id": "1ea9f5ee-adf4-325b-ab82-8124096a8629",
                        "target_lang_word": "anacreontic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anacreontic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32e99ac0-a112-368c-92c7-b6967be2712f",
                                        "entry_id": "264cdb2b-8b03-3088-bd4d-9467ca2d702f",
                                        "glosses": [
                                            "Pertaining to the style of the Greek poet Anacreon, who wrote of wine and love; (specifically) designating a metre based on an anaclastic ionic dimeter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0de61579-01c5-3fa4-a111-fdd2dc06673f",
                                        "entry_id": "264cdb2b-8b03-3088-bd4d-9467ca2d702f",
                                        "glosses": [
                                            "Characterised by festivity and the celebration of love and/or drinking; bacchanalian, amorous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74b6708-4958-44d5-89ab-e763bbac0949",
                                                "sense_id": "0de61579-01c5-3fa4-a111-fdd2dc06673f",
                                                "text": "[T]he false Thecla […] had initiated me into the anacreontic diversions and fruitions of men and women."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anacreontic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9e15ca-9124-3c4b-be34-7934d280b3e6",
                                        "entry_id": "e8c0b895-ab77-3f64-bd20-9a0b9a42e0d5",
                                        "glosses": [
                                            "A short lyrical piece about love and wine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1574b2b-e6bc-4dfa-8010-b1d1ab19725e",
                        "source_entry_id": "1c44bcd1-e8d3-3116-bf49-b30110826b36",
                        "source_sense_id": "1ea9f5ee-adf4-325b-ab82-8124096a8629",
                        "target_lang_word": "vers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                        "entry_id": "25b115c0-2e04-3429-adf3-fb588fcc1892",
                                        "glosses": [
                                            "Suite de mots rythmés selon la quantité, l’accentuation, le nombre des syllabes ou le retour de la rime."
                                        ],
                                        "tags": [
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0add5a2a-cc84-45ab-a6c7-50da5fa257ba",
                                                "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "e7e915b7-d2dd-44b8-b03e-fc683cbb56d4",
                                                "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                                "text": "Ah ! Deubel, qui t'es si mal suicidé, quelle attirance avaient sous terre ton corps pourri et dans mon être l'écho douloureux de tes vers ?."
                                            },
                                            {
                                                "example_id": "c30dc141-a8fb-441d-951a-12cb246f6c91",
                                                "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                                "text": "L’aisance avec laquelle les poètes juifs maniaient le vers français permet de supposer que leur talent a dû s’exercer dans les genres les plus variés."
                                            },
                                            {
                                                "example_id": "1990d2d3-42e9-492c-838f-7c729fdbf700",
                                                "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                                "text": "La poésie du Divan et la poésie populaire, issues de classes sociales différentes, ont su parfois puiser aux mêmes sources d’inspiration : mais ce qui forme entre elles cloison étanche, c'est la forme de la langue : la poésie du Divan emploie le vers métrique, la poésie populaire le vers syllabique."
                                            },
                                            {
                                                "example_id": "f6f6e32e-52a4-493a-93a7-c749c932489a",
                                                "sense_id": "08d267da-2947-3e6e-b62f-3a39f550d04b",
                                                "text": "Ainsi le dithyrambe, chant liturgique en l'honneur de Dionysos diffère de l’iambe dont le pied comporte un son bref suivi d'un long avec des vers dodécamétriques alternant avec des octamétriques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606c577f-64f4-3779-89d7-55403584c015",
                                        "entry_id": "25b115c0-2e04-3429-adf3-fb588fcc1892",
                                        "glosses": [
                                            "L'ensemble de la poésie d'un auteur ou d'une école."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff94f94-604a-488b-8aaf-528d50e0a7f1",
                                                "sense_id": "606c577f-64f4-3779-89d7-55403584c015",
                                                "text": "Le vers de Corneille, de Racine."
                                            },
                                            {
                                                "example_id": "623c9287-67ef-426e-b3a0-026bdc64bdef",
                                                "sense_id": "606c577f-64f4-3779-89d7-55403584c015",
                                                "text": "Le vers classique, le vers romantique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ef3308a-1a19-3c98-9778-a9bb40c67eb1",
                                        "entry_id": "bf220ea6-27ca-392f-b08f-37511809ad6a",
                                        "glosses": [
                                            "En direction de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf30fd7-87b6-49d0-b2d8-93460afb6ce3",
                                                "sense_id": "0ef3308a-1a19-3c98-9778-a9bb40c67eb1",
                                                "text": "Cette marche avait pour but de s'assurer si l'ennemi, signalé à Vouziers et à Grandpré, ne rétrogradait pas vers Stenay ou s'il continuait sa marche sur Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5bceabf-332d-3196-a71a-710f8927e069",
                                        "entry_id": "bf220ea6-27ca-392f-b08f-37511809ad6a",
                                        "glosses": [
                                            "."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64790f20-192a-43d1-8572-c571f27bdb4e",
                                                "sense_id": "d5bceabf-332d-3196-a71a-710f8927e069",
                                                "text": "Le scepticisme est donc le premier pas vers la vérité"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2445bdc7-e9e1-3803-8970-6c45027a7806",
                                        "entry_id": "bf220ea6-27ca-392f-b08f-37511809ad6a",
                                        "glosses": [
                                            "Du côté de (sans mouvement)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f378e6-3636-4272-a228-574ee849fa6c",
                                                "sense_id": "2445bdc7-e9e1-3803-8970-6c45027a7806",
                                                "text": "Vers le sud, vers la gauche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a160a116-a45b-337c-a338-d541018be687",
                                        "entry_id": "bf220ea6-27ca-392f-b08f-37511809ad6a",
                                        "glosses": [
                                            "Aux environs de, aux alentours de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d46d743-9d60-4587-b56b-f3d975c96a6b",
                                                "sense_id": "a160a116-a45b-337c-a338-d541018be687",
                                                "text": "Vers Livourne, nous rencontrâmes les vingt voiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c882baa5-819e-3fde-8858-ef229014c3c6",
                                        "entry_id": "bf220ea6-27ca-392f-b08f-37511809ad6a",
                                        "glosses": [
                                            "À telle époque, à tel moment, environ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd209e73-7222-49b3-862b-38b32c7718a5",
                                                "sense_id": "c882baa5-819e-3fde-8858-ef229014c3c6",
                                                "text": "Son mariage aura lieu vers la mi-octobre."
                                            },
                                            {
                                                "example_id": "93e74f5f-94f2-4315-a53f-b9e7e483440d",
                                                "sense_id": "c882baa5-819e-3fde-8858-ef229014c3c6",
                                                "text": "C’est arrivé vers minuit."
                                            },
                                            {
                                                "example_id": "1b1542d7-e38f-4b99-abe8-dbe3cf15c50f",
                                                "sense_id": "c882baa5-819e-3fde-8858-ef229014c3c6",
                                                "text": "Un jeudi, avec Roger, on revenait de traîner je sais pas où, il était vers les midi et demi, on se magnait le train, on crevait de faim, on allait se faire engueuler mais on connaissait la parade : ne pas se séparer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9be07a-0bf4-3b4d-8243-50981aea6c54",
                                        "entry_id": "5ad3b59c-841d-327d-9401-f678e2602ff7",
                                        "glosses": [
                                            "Pluriel de ver."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99685a25-9e9e-4d0b-bb05-839bbe3107fd",
                                                "sense_id": "cd9be07a-0bf4-3b4d-8243-50981aea6c54",
                                                "text": "Les bêtes si méfiantes qui s’abattaient à la croûle sur les fagnes pour en extraire les vers, ne prenaient point garde aux filets tendus à plat sur le sol; elles s’y empêtraient et tous leurs efforts étaient vains. Elles ne pouvaient s’en dépêtrer ou arracher le bâtonnet qui les fixe."
                                            },
                                            {
                                                "example_id": "63d732dd-8018-416c-ad18-bd952ed11532",
                                                "sense_id": "cd9be07a-0bf4-3b4d-8243-50981aea6c54",
                                                "text": "« Je n’ai pas de pitié, pas de pitié ! Plus les vers se débattent, plus j’ai envie de les écraser. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a57dfc7e-3600-4dc4-b96a-db377c688b10",
                        "source_entry_id": "1c44bcd1-e8d3-3116-bf49-b30110826b36",
