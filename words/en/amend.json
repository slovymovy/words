{
    "word_family": [
        "amendment",
        "amendable",
        "amends"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "baac9ca3-2576-30e0-9933-5971038e484a",
                    "sense_definition": "To make a formal alteration in legislation, a report, or a document by adding, deleting, or rephrasing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "change_text",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee voted to <w>amend</w> the bill before the final reading.",
                            "target_lang_translations": {
                                "ru": "Комитет проголосовал за то, чтобы <w>внести поправки</w> в законопроект перед окончательным чтением.",
                                "tr": "Komite, son okumadan önce tasarıda <w>değişiklik yapmak</w> için oy kullandı."
                            }
                        },
                        {
                            "text": "You may need to <w>amend</w> your tax return if you made a mistake.",
                            "target_lang_translations": {
                                "ru": "Вам может потребоваться <w>внести изменения</w> в налоговую декларацию, если вы допустили ошибку.",
                                "tr": "Bir hata yaptıysanız vergi beyannamenizi <w>düzeltmeniz</w> gerekebilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "correct"
                    ],
                    "common_phrases": [
                        "amend the law",
                        "amend the constitution",
                        "amend a contract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить официальные изменения в законодательство, отчет или документ путем добавления, удаления или перефразирования.",
                        "tr": "Yasa, rapor veya belge üzerinde ekleme, çıkarma veya yeniden ifade etme yoluyla resmi bir değişiklik yapmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вносить поправки",
                                "target_lang_sense_clarification": "в законодательство или официальные документы"
                            },
                            {
                                "target_lang_word": "вносить изменения",
                                "target_lang_sense_clarification": "общий термин для изменения документов"
                            },
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "корректировать ошибки в документах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değişiklik yapmak",
                                "target_lang_sense_clarification": "yasa veya resmi belgelerde"
                            },
                            {
                                "target_lang_word": "değiştirmek",
                                "target_lang_sense_clarification": "tasarı veya sözleşme metnini"
                            },
                            {
                                "target_lang_word": "düzeltmek",
                                "target_lang_sense_clarification": "belgedeki hataları gidermek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d880dad3-055e-35fa-9a61-02c00709e906",
                    "sense_definition": "To make something better or improve a situation or behavior.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "improve_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He promised to <w>amend</w> his ways and become a more responsible citizen.",
                            "target_lang_translations": {
                                "ru": "Он пообещал <w>исправить</w> свое поведение и стать более ответственным гражданином.",
                                "tr": "Yolunu <w>düzeltmeye</w> ve daha sorumlu bir vatandaş olmaya söz verdi."
                            }
                        },
                        {
                            "text": "We must take steps to <w>amend</w> the situation before it causes more problems.",
                            "target_lang_translations": {
                                "ru": "Мы должны принять меры, чтобы <w>исправить</w> ситуацию, пока она не вызвала еще больше проблем.",
                                "tr": "Daha fazla soruna yol açmadan önce durumu <w>iyileştirmek</w> için adımlar atmalıyız."
                            }
                        }
                    ],
                    "synonyms": [
                        "improve",
                        "ameliorate",
                        "correct"
                    ],
                    "common_phrases": [
                        "amend one's ways"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо лучше или улучшать ситуацию или поведение.",
                        "tr": "Bir şeyi daha iyi hale getirmek veya bir durumu ya da davranışı iyileştirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исправлять",
                                "target_lang_sense_clarification": "поведение или ошибки"
                            },
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "ситуацию или качество"
                            },
                            {
                                "target_lang_word": "совершенствовать",
                                "target_lang_sense_clarification": "делать более совершенным"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düzeltmek",
                                "target_lang_sense_clarification": "davranış veya durumu"
                            },
                            {
                                "target_lang_word": "iyileştirmek",
                                "target_lang_sense_clarification": "durumu veya gidişatı"
                            },
                            {
                                "target_lang_word": "ıslah etmek",
                                "target_lang_sense_clarification": "davranış veya gidişatı daha iyiye götürmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "454094ec-52db-357e-998e-53185656ff7e",
                    "sense_definition": "An act of correcting a mistake or providing compensation for a wrong.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to make an <w>amend</w> for his past errors, though it was difficult.",
                            "target_lang_translations": {
                                "ru": "Он пытался предоставить <w>компенсацию</w> за свои прошлые ошибки, хотя это было трудно.",
                                "tr": "Zor olsa da geçmişteki hataları için bir <w>telafi</w> yapmaya çalıştı."
                            }
                        },
                        {
                            "text": "The apology served as an <w>amend</w> for the misunderstanding between them.",
                            "target_lang_translations": {
                                "ru": "Извинение послужило <w>возмещением</w> за недоразумение между ними.",
                                "tr": "Özür, aralarındaki yanlış anlaşılma için bir <w>telafi</w> işlevi gördü."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make amends"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in the plural form 'amends'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по исправлению ошибки или предоставлению компенсации за причиненный вред.",
                        "tr": "Bir hatayı düzeltme veya yapılan bir haksızlığı telafi etme eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компенсация",
                                "target_lang_sense_clarification": "возмещение ущерба"
                            },
                            {
                                "target_lang_word": "возмещение",
                                "target_lang_sense_clarification": "искупление вины"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "telafi",
                                "target_lang_sense_clarification": "hata veya zararı giderme"
                            },
                            {
                                "target_lang_word": "tazminat",
                                "target_lang_sense_clarification": "zararı karşılama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288a3abc-b321-3ca5-b1d6-fc42eebbb212",
                    "sense_definition": "A change or alteration made to a document; a clipping of the word amendment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "change_text_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have sent the document back with a few <w>amends</w> for you to review.",
                            "target_lang_translations": {
                                "ru": "Я отправил документ обратно с несколькими <w>правками</w> для ознакомления.",
                                "tr": "İncelemeniz için belgeyi birkaç <w>düzeltmeyle</w> geri gönderdim."
                            }
                        },
                        {
                            "text": "Please check the <w>amends</w> in the contract before signing it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте <w>правки</w> в договоре перед его подписанием.",
                                "tr": "Lütfen imzalamadan önce sözleşmedeki <w>değişiklikleri</w> kontrol edin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение или правка, внесенная в документ; сокращение от слова amendment.",
                        "tr": "Bir belgede yapılan değişiklik veya düzeltme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правка",
                                "target_lang_sense_clarification": "исправление в тексте"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "перемена в документе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "düzeltme",
                                "target_lang_sense_clarification": "metin üzerindeki değişiklik"
                            },
                            {
                                "target_lang_word": "değişiklik",
                                "target_lang_sense_clarification": "belgede yapılan revizyon"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d2a33cd4-aca1-3d3e-8b26-8dbed23fe23f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Amend</w> was known for his contributions to the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Аменд</w> был известен своим вкладом в местную библиотеку.",
                                "tr": "Bay <w>Amend</w>, yerel kütüphaneye yaptığı katkılarla tanınıyordu."
                            }
                        },
                        {
                            "text": "We met a family named <w>Amend</w> during our travels.",
                            "target_lang_translations": {
                                "ru": "Во время наших путешествий мы встретили семью по фамилии <w>Аменд</w>.",
                                "tr": "Seyahatlerimiz sırasında soyadı <w>Amend</w> olan bir aileyle tanıştık."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "tr": "Bir soyadı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Аменд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Amend",
                                "target_lang_sense_clarification": "soyadı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}