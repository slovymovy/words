                "senses": [
                    {
                        "sense_id": "430609ce-4a31-3d9b-8f56-8d090c04f124",
                        "entry_id": "86d94dd5-cd34-3b66-a108-9faabd1ff07c",
                        "glosses": [
                            "ein Virus-Eiweiß, gegen das das Immunsystem des befallenen Organismus Antikörper bildet"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "4692013a-bcc1-4276-a73f-86b3d39142e4",
                                "sense_id": "430609ce-4a31-3d9b-8f56-8d090c04f124",
                                "text": "„Mit ihrer Hilfe kann man das Auftreten und die Lokalisation von Virusantigen in der Zelle in Abhängigkeit von der Zeit nach Infektion auf direktem Wege untersuchen.“"
                            },
                            {
                                "example_id": "353e8bad-e2d3-4d1a-9ccf-df83c1c79412",
                                "sense_id": "430609ce-4a31-3d9b-8f56-8d090c04f124",
                                "text": "„Von den untersuchten transplantablen VX-Carcinomen ließ sich beim Tumor VX7 noch Virusantigen im Kern der Geschwulstzellen nachweisen […].“"
                            },
                            {
                                "example_id": "3877c99e-bb72-43bb-9204-ab9a72b55046",
                                "sense_id": "430609ce-4a31-3d9b-8f56-8d090c04f124",
                                "text": "„Die Produktion der Virusantigene erfolgt zunächst an Strukturen der Wirtszelle, ohne daß ein Einbau in Virusteilchen unbedingt erfolgen müßte.“"
                            },
                            {
                                "example_id": "42787e92-e05c-4737-b007-2b3adcf33712",
                                "sense_id": "430609ce-4a31-3d9b-8f56-8d090c04f124",
                                "text": "„Die Überprüfung der zellulären Immunantwort bei Anwendung des LTT und unter Verwendung von bestimmten Virusantigenen als Mitogen bei MS-Patienten und Kontrollpersonen läßt keine Präferenz für bestimmte Virusarten erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
