                    {
                        "sense_id": "781479df-8f61-30a0-87f1-f236cdacfee4",
                        "entry_id": "9cfccda8-3b62-34a8-8f2b-7d71919240fd",
                        "glosses": [
                            "ouders en hun minderjarige kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b127c144-aac5-41c9-9409-3268f6e9f220",
                                "sense_id": "781479df-8f61-30a0-87f1-f236cdacfee4",
                                "text": "Maar de wrede waarheid is dat Hollywood - en met name de Academy - hecht aan het kerngezin en, hoe moet ik dit zeggen zonder ongevoelig te klinken, tja, misschien kan dat niet: normaal gesproken wordt er maar eens in de tien jaar een Brokeback Mountain gemaakt."
                            },
                            {
                                "example_id": "640f5971-4e5d-4729-addc-6fd12c306aca",
                                "sense_id": "781479df-8f61-30a0-87f1-f236cdacfee4",
                                "text": "Ook zal de minister strenger kijken naar gezinsmigratie en -hereniging. Alleen het zogenoemde 'kerngezin' komt in aanmerking voor een komst naar Nederland, dus partners en minderjarige kinderen. Opa's, oma's, neven en nichten vallen daar dus buiten."
                            }
                        ]
                    }
