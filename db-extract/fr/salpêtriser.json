                "senses": [
                    {
                        "sense_id": "2397eb30-6345-3485-999a-58b985a2ab6f",
                        "entry_id": "3d6c3d8e-1fdb-384c-adc3-78465751970e",
                        "glosses": [
                            "Variante de salpêtrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb85fe7-c3c8-4b5a-b396-70d1aa50e102",
                                "sense_id": "2397eb30-6345-3485-999a-58b985a2ab6f",
                                "text": "L'infection se généralise, salpêtrise les murs, engloutit les quelques tradivarius qu'on sauverait à la Noël. Renonce, renonce, renonce.^([sic])"
                            },
                            {
                                "example_id": "aa3b6a6d-5e2b-42e6-b9d7-24b19e7944f0",
                                "sense_id": "2397eb30-6345-3485-999a-58b985a2ab6f",
                                "text": "À droite, au-dessus de ces premiers empêtrés et jonchés de planches et de mottes de terre éboulées, un mauvais mur plâtreux se lève droit, tout salpêtrisé d’humidité, avec, au milieu, un petit égout, en forme de tuile creuse, qui bave."
                            }
                        ]
                    }
