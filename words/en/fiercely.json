{
    "word_family": [
        "fierce",
        "fierceness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                    "sense_definition": "In a violent, aggressive, or intense manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind blew <w>fiercely</w> against the windows during the storm.",
                            "target_lang_translations": {
                                "pl": "Podczas burzy wiatr <w>ostro</w> uderzał w okna.",
                                "de": "Während des Sturms blies der Wind <w>heftig</w> gegen die Fenster.",
                                "es": "El viento soplaba <w>con fuerza</w> contra las ventanas durante la tormenta.",
                                "fr": "Le vent soufflait <w>violemment</w> contre les fenêtres pendant la tempête.",
                                "ru": "Во время бури ветер <w>неистово</w> бился в окна."
                            }
                        },
                        {
                            "text": "The two animals fought <w>fiercely</w> over the piece of food.",
                            "target_lang_translations": {
                                "pl": "Dwa zwierzęta <w>zawzięcie</w> walczyły o kawałek jedzenia.",
                                "de": "Die beiden Tiere kämpften <w>erbittert</w> um das Stück Futter.",
                                "es": "Los dos animales pelearon <w>fieramente</w> por el trozo de comida.",
                                "fr": "Les deux animaux se sont battus <w>avec acharnement</w> pour le morceau de nourriture.",
                                "ru": "Два животных <w>яростно</w> дрались за кусок еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "violently",
                        "aggressively",
                        "savagely"
                    ],
                    "antonyms": [
                        "gently",
                        "mildly"
                    ],
                    "common_phrases": [
                        "fought fiercely",
                        "blew fiercely"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób gwałtowny, agresywny lub bardzo intensywny.",
                        "de": "Auf gewaltsame, aggressive oder sehr heftige Art und Weise.",
                        "es": "De manera violenta, agresiva o sumamente intensa.",
                        "fr": "D'une manière violente, agressive ou intense.",
                        "ru": "Жестоким, агрессивным или чрезвычайно буйным образом."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gwałtownie",
                                "target_lang_sense_clarification": "w sposób nagły lub bardzo intensywny"
                            },
                            {
                                "target_lang_word": "zawzięcie",
                                "target_lang_sense_clarification": "z dużą determinacją i uporem"
                            },
                            {
                                "target_lang_word": "ostro",
                                "target_lang_sense_clarification": "dotkliwie lub przenikliwie (np. o pogodzie)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "heftig",
                                "target_lang_sense_clarification": "mit großer Wucht oder Intensität"
                            },
                            {
                                "target_lang_word": "erbittert",
                                "target_lang_sense_clarification": "mit großer Härte und Verbissenheit kämpfend"
                            },
                            {
                                "target_lang_word": "wütend",
                                "target_lang_sense_clarification": "aggressiv oder voller Zorn"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fieramente",
                                "target_lang_sense_clarification": "con fiereza o salvajismo"
                            },
                            {
                                "target_lang_word": "ferozmente",
                                "target_lang_sense_clarification": "con agresividad o violencia"
                            },
                            {
                                "target_lang_word": "con fuerza",
                                "target_lang_sense_clarification": "con gran ímpetu o intensidad física"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "avec acharnement",
                                "target_lang_sense_clarification": "avec violence et ténacité"
                            },
                            {
                                "target_lang_word": "violemment",
                                "target_lang_sense_clarification": "avec une grande force ou brutalité"
                            },
                            {
                                "target_lang_word": "âprement",
                                "target_lang_sense_clarification": "de façon âpre ou disputée"
                            },
                            {
                                "target_lang_word": "férocement",
                                "target_lang_sense_clarification": "d'une manière agressive et cruelle"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "яростно",
                                "target_lang_sense_clarification": "с неистовой силой, гневом или агрессией"
                            },
                            {
                                "target_lang_word": "свирепо",
                                "target_lang_sense_clarification": "с жестокостью, беспощадно"
                            },
                            {
                                "target_lang_word": "неистово",
                                "target_lang_sense_clarification": "с неукротимой силой или буйством"
                            },
                            {
                                "target_lang_word": "ожесточённо",
                                "target_lang_sense_clarification": "с упорством и ожесточением (например, в борьбе)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                    "sense_definition": "To a very high or extreme degree.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>fiercely</w> independent and prefers to live alone.",
                            "target_lang_translations": {
                                "pl": "Jest <w>niezwykle</w> niezależna i woli mieszkać sama.",
                                "de": "Sie ist <w>äußerst</w> unabhängig und zieht es vor, alleine zu leben.",
                                "es": "Ella es <w>extremadamente</w> independiente y prefiere vivir sola.",
                                "fr": "Elle est <w>farouchement</w> indépendante et préfère vivre seule.",
                                "ru": "Она <w>чрезвычайно</w> независима и предпочитает жить одна."
                            }
                        },
                        {
                            "text": "The company is <w>fiercely</w> competitive in the global market.",
                            "target_lang_translations": {
                                "pl": "Firma jest <w>skrajnie</w> konkurencyjna na rynku globalnym.",
                                "de": "Das Unternehmen ist auf dem globalen Markt <w>extrem</w> konkurrenzfähig.",
                                "es": "La empresa es <w>ferozmente</w> competitiva en el mercado global.",
                                "fr": "L'entreprise est <w>extrêmement</w> compétitive sur le marché mondial.",
                                "ru": "Компания <w>отчаянно</w> борется за первенство на мировом рынке."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensely",
                        "extremely",
                        "strongly"
                    ],
                    "common_phrases": [
                        "fiercely competitive",
                        "fiercely independent",
                        "fiercely loyal"
                    ],
                    "target_lang_definitions": {
                        "pl": "W bardzo wysokim lub ekstremalnym stopniu.",
                        "de": "In einem sehr hohen oder extremen Maße; außerordentlich.",
                        "es": "En grado muy alto o extremo; con vehemencia o intensidad.",
                        "fr": "À un degré extrême ou très élevé.",
                        "ru": "В чрезвычайно высокой или крайней степени."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezwykle",
                                "target_lang_sense_clarification": "w bardzo wysokim stopniu"
                            },
                            {
                                "target_lang_word": "bardzo",
                                "target_lang_sense_clarification": "w znacznym stopniu"
                            },
                            {
                                "target_lang_word": "skrajnie",
                                "target_lang_sense_clarification": "w sposób ekstremalny"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "äußerst",
                                "target_lang_sense_clarification": "in sehr hohem oder extremem Maße"
                            },
                            {
                                "target_lang_word": "zutiefst",
                                "target_lang_sense_clarification": "von ganzem Herzen oder vollkommen (z. B. loyal)"
                            },
                            {
                                "target_lang_word": "hart",
                                "target_lang_sense_clarification": "stark ausgeprägt (z. B. umkämpft)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ferozmente",
                                "target_lang_sense_clarification": "de forma sumamente intensa o implacable"
                            },
                            {
                                "target_lang_word": "sumamente",
                                "target_lang_sense_clarification": "en grado extremo"
                            },
                            {
                                "target_lang_word": "extremadamente",
                                "target_lang_sense_clarification": "en grado máximo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "farouchement",
                                "target_lang_sense_clarification": "résolument et sans concession"
                            },
                            {
                                "target_lang_word": "extrêmement",
                                "target_lang_sense_clarification": "au plus haut point"
                            },
                            {
                                "target_lang_word": "ardemment",
                                "target_lang_sense_clarification": "avec passion ou intensité"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "в очень сильной, высшей степени"
                            },
                            {
                                "target_lang_word": "яростно",
                                "target_lang_sense_clarification": "с исключительной страстью или пылом"
                            },
                            {
                                "target_lang_word": "отчаянно",
                                "target_lang_sense_clarification": "предельно сильно, бескомпромиссно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
