                "senses": [
                    {
                        "sense_id": "84222d3e-2d55-35de-812d-46d1a78f8600",
                        "entry_id": "71805ba3-95dc-3ba4-b6f1-e7a3502e8cae",
                        "glosses": [
                            "a diminutive, Andryusha, of the male given name Андре́й (Andréj)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc80bc84-8bce-423f-992e-d65c0c7d95dc",
                                "sense_id": "84222d3e-2d55-35de-812d-46d1a78f8600",
                                "text": "— Вот, Андрю́ша, почита́йте статьи́ отца́, — сказа́ла она́, подава́я ему́ па́чку брошю́р и о́ттисков. — Прекра́сные статьи́. Он отли́чно пи́шет.",
                                "translation": "“Here, Andryusha; read father’s articles,” she said, giving him a bundle of pamphlets and proofs. “They are splendid articles. He writes capitally.”",
                                "english": "“Here, Andryusha; read father’s articles,” she said, giving him a bundle of pamphlets and proofs. “They are splendid articles. He writes capitally.”"
                            }
                        ]
                    }
                ],
