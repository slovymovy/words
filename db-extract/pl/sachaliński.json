                        "source_sense_id": "d56c1990-83c1-3fd9-91a8-6e02b726d472",
                        "target_lang_word": "сахалинский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сахалинский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8703c488-596f-376d-bc98-5b08d8dd383e",
                                        "entry_id": "9d0d8354-1745-3435-b2cc-80041a867cda",
                                        "glosses": [
                                            "относящийся к острову Сахалин, связанный с ним"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe79669-cfa9-4c11-8d24-38caa79a35a0",
                                                "sense_id": "8703c488-596f-376d-bc98-5b08d8dd383e",
                                                "text": "В сахалинской тайге, где на каждом шагу приходится преодолевать горы валежного леса, жёсткий, путающийся в ногах багульник или бамбук, тонуть по пояс в болотах и ручьях, отмахиваться от ужасной мошки, — даже вольные сытые ходоки делают не больше 8 вёрст в сутки, человек же, истощённый тюрьмой, питающийся в тайге гнилушками с солью и не знающий, где север, а где юг, не делает в общем и 3–5 вёрст."
                                            },
                                            {
                                                "example_id": "776f2441-77b8-4127-be59-70500709f06a",
                                                "sense_id": "8703c488-596f-376d-bc98-5b08d8dd383e",
                                                "text": "В своём по сути документальном «Острове Сахалин» Чехов с благоговением рассказывает о сахалинском священнике миссионере Симеоне Казанском, служившем там в 1870-х годах .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f408bf86-86c9-3a08-bbde-add0201dce9a",
                                        "entry_id": "9d0d8354-1745-3435-b2cc-80041a867cda",
                                        "glosses": [
                                            "относящийся к Сахалинской области, связанный с ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6dbac10-10de-4c6f-8af5-b758df7a1853",
                                                "sense_id": "f408bf86-86c9-3a08-bbde-add0201dce9a",
                                                "text": "К слову, исполнять обязанности сахалинского главы будет бывший вице-президент нефтяной компании Сергей Караганов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
