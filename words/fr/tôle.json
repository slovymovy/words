                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe locale a pris une véritable <w>tôle</w> lors de la finale du championnat.",
                            "target_lang_translations": {
                                "en": "The local side took a real <w>thrashing</w> in the championship final.",
                                "ru": "В финале чемпионата местная команда потерпела настоящий <w>разгром</w>.",
                                "de": "Die örtliche Mannschaft kassierte im Finale der Meisterschaft eine echte <w>Klatsche</w>.",
                                "es": "El equipo local sufrió una auténtica <w>paliza</w> en la final del campeonato.",
                                "zh": "当地队在锦标赛决赛中遭遇了一场真正的<w>惨败</w>。"
                            }
                        },
                        {
                            "text": "Il n'avait pas ouvert ses livres et a récolté une sacrée <w>tôle</w> en chimie.",
                            "target_lang_translations": {
                                "en": "He had not opened his books and got a <w>terrible mark</w> in chemistry.",
                                "ru": "Он не открывал учебники и получил по химии жуткую <w>двойку</w>.",
                                "de": "Er hatte seine Bücher nicht aufgeschlagen und kassierte in Chemie eine dicke <w>Sechs</w>.",
                                "es": "No había abierto los libros y se llevó un <w>cate</w> monumental en química.",
                                "zh": "他没有翻开过书本，结果化学考了一个很难看的<w>低分</w>。"
                            }
