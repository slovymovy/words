                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "f0906b5a-9365-3415-8b2d-5dc2bea78722",
                        "entry_id": "6b4735dc-2e18-3c10-81cc-5a9cd77a9a3f",
                        "glosses": [
                            "Gruppieren und anschließende Zusammenfassen von Daten (auch Datenaggregierung)"
                        ],
                        "tags": [
                            "Statistik"
                        ],
                        "examples": [
                            {
                                "example_id": "d718e62f-8021-450c-97d7-6b8cd360ec1b",
                                "sense_id": "f0906b5a-9365-3415-8b2d-5dc2bea78722",
                                "text": "Das durchschnittliche Einkommen pro Land wird durch Aggregierung der Daten gewonnen."
