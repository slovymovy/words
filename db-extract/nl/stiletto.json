                                "target_senses": [
                                    {
                                        "sense_id": "8b372851-3ba1-31c2-a1a9-09c7194c9d6e",
                                        "entry_id": "6ac06976-2644-3ce2-a9b1-eff5365baba5",
                                        "glosses": [
                                            "A folding knife with a blade which opens automatically (under spring pressure) when a button is pressed."
                                        ],
                                        "tags": [],
