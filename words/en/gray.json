                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unit_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient received a radiation dose of two <w>grays</w> during the treatment.",
                            "target_lang_translations": {
