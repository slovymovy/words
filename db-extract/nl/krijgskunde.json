                        "glosses": [
                            "de wetenschap van het oorlog voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd82b234-181d-496e-b12d-d3252666a721",
                                "sense_id": "7825e9f9-ae1d-3d5f-9084-765860544309",
                                "text": "Denis Davydov met zijn Russische instinct begreep als eerste de betekenis van die schrikwekkende knuppel die zonder naar de regels van de krijgskunde te vragen de Fransen vernietigde, en hem komt de eer toe dat hij de eerste stap heeft gezet tot de legalisering van deze wijze van oorlogvoeren."
                            },
                            {
                                "example_id": "78d8ef94-9b59-4fa2-9dce-d202f3509f08",
                                "sense_id": "7825e9f9-ae1d-3d5f-9084-765860544309",
                                "text": "De Hongaarse regering wil verplichte lessen krijgskunde invoeren op school. Dat heeft de staatssecretaris voor Onderwijs Zoltan Maruzsa gezegd in de regeringsgezinde krant ‘Magyar Idök’."
                            }
                        ]
                    }
