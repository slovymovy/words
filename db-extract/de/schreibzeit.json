                ],
                "senses": [
                    {
                        "sense_id": "30453231-e9fd-39ac-aefe-66d73451be1f",
                        "entry_id": "2e1a55e8-73d5-37db-9788-dbc23da196ba",
                        "glosses": [
                            "Zeitpunkt, -raum, zu dem etwas geschrieben wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55ffde6e-b686-4e48-be97-2875a1530b4d",
                                "sense_id": "30453231-e9fd-39ac-aefe-66d73451be1f",
                                "text": "„So werden beispielsweise in einem Briefkopf mit der Absenderangabe Schreiber, Schreibort und durch das Datum die Schreibzeit fixiert.“"
                            },
                            {
                                "example_id": "71a94001-09f2-4543-9826-814a5dc15641",
                                "sense_id": "30453231-e9fd-39ac-aefe-66d73451be1f",
                                "text": "„So begründete er unter Mitarbeit seiner Studierenden den Schweizer Teil des internationalen Unternehmens des Kataloges der datierten Handschriften (siehe unten: Werke), in welchem alle mittelalterlichen Buchhandschriften verzeichnet werden, welche Angaben zum Schreibort, zur Schreibzeit oder einen Schreibernamen enthalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a74403f-4bea-338f-8a48-d98a5cb64db6",
                        "entry_id": "2e1a55e8-73d5-37db-9788-dbc23da196ba",
                        "glosses": [
                            "Zeitdauer, während der geschrieben wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55039e11-45e9-4734-8447-dedfc459bf8d",
                                "sense_id": "9a74403f-4bea-338f-8a48-d98a5cb64db6",
                                "text": "„Im Jahre 1931 legte er bei der Industrie- und Handelskammer die Prüfung in Kurzschrift bei einer Schreibzeit von 10 Minuten mit 300 Silben pro Minute ab.“"
                            },
                            {
                                "example_id": "d2f105a8-d4a6-4250-89a8-011346169ae5",
                                "sense_id": "9a74403f-4bea-338f-8a48-d98a5cb64db6",
                                "text": "„Die Schreibzeit beginnt jetzt – was nun?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
