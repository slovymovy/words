                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais au <w>magasin</w> pour acheter des fruits et des légumes frais."
                        },
                        {
                            "text": "Nous aimons faire les <w>magasins</w> le samedi après-midi dans le centre-ville."
                        }
                    ],
                    "synonyms": [
                        "boutique",
                        "échoppe"
                    ],
                    "common_phrases": [
