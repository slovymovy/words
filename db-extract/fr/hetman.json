        "fr-extract.jsonl": [
            {
                "entry_id": "07cd5da0-b8a7-3e61-9b30-34fc52318078",
                "word": "hetman",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c10aa2e2-228f-4542-9602-a8e8fe4a9d5d",
                        "entry_id": "07cd5da0-b8a7-3e61-9b30-34fc52318078",
                        "tags": [
