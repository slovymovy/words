                    {
                        "translation_id": "7caf77ee-8ab6-494e-a211-2e02a0f5a2df",
                        "source_entry_id": "4c2e58fa-ad08-377e-954d-077b1e9ae57a",
                        "source_sense_description": "quality or state of being still",
                        "target_lang_word": "calme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calme",
