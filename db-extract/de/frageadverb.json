                        "entry_id": "aad46280-c6a2-3767-a2e0-c29d3963b22e",
                        "glosses": [
                            "Adverb, das eine Ergänzungsfrage oder indirekte Frage einleitet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "800e6e3e-04a9-437f-92c9-7a107ab58528",
                                "sense_id": "85845197-e764-387d-995e-991f26544682",
                                "text": "In dem Satz: \"Wohin gehen wir?\" ist \"wohin\" ein Frageadverb."
                            },
                            {
                                "example_id": "c835b326-c3aa-431e-9fb2-dad4a7ee42f7",
                                "sense_id": "85845197-e764-387d-995e-991f26544682",
                                "text": "Frageadverbien können eine modale (\"wie\"), kausale (\"wieso\"), lokale (\"wo\") oder temporale (\"wann\") Bedeutung haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
