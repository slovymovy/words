{
    "word_family": [
        "entertain",
        "entertainer",
        "entertaining"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abb57c31-ed1a-3039-a3f2-b5486c9a5ec8",
                    "sense_definition": "An activity, such as a performance, movie, or game, designed to give pleasure, enjoyment, and amusement to an audience.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city offers a wide range of <w>entertainment</w> for tourists, including theaters and clubs.",
                            "target_lang_translations": {
                                "ru": "Город предлагает широкий выбор <w>развлечений</w> для туристов, включая театры и клубы.",
                                "zh": "这座城市为游客提供了丰富的<w>娱乐</w>活动，包括剧院和俱乐部。"
                            }
                        },
                        {
                            "text": "We hired a clown to provide live <w>entertainment</w> at the birthday party.",
                            "target_lang_translations": {
                                "ru": "Мы наняли клоуна, чтобы обеспечить живое <w>развлечение</w> на дне рождения.",
                                "zh": "我们雇了一名小丑在生日派对上进行现场<w>表演</w>。"
                            }
                        },
                        {
                            "text": "The <w>entertainment</w> industry has grown significantly with the rise of streaming services.",
                            "target_lang_translations": {
                                "ru": "Индустрия <w>развлечений</w> значительно выросла с появлением стриминговых сервисов.",
                                "zh": "随着流媒体服务的兴起，<w>娱乐</w>产业得到了显著发展。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amusement",
                        "recreation",
                        "diversion",
                        "pastime",
                        "fun",
                        "show",
                        "performance"
                    ],
                    "antonyms": [
                        "boredom",
                        "work"
                    ],
                    "common_phrases": [
                        "entertainment industry",
                        "live entertainment",
                        "family entertainment",
                        "in-flight entertainment",
                        "world of entertainment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность, такая как представление, фильм или игра, предназначенная для того, чтобы доставить удовольствие и развлечь аудиторию.",
                        "zh": "指电影、表演或游戏等旨在为观众提供愉悦、享受和消遣的活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлечение",
                                "target_lang_sense_clarification": "досуг, увеселение"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "шоу, спектакль"
                            },
                            {
                                "target_lang_word": "забава",
                                "target_lang_sense_clarification": "потеха, игра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "娱乐",
                                "target_lang_sense_clarification": "消遣、休闲活动"
                            },
                            {
                                "target_lang_word": "表演",
                                "target_lang_sense_clarification": "演出、节目"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6e94862-783e-3242-aa40-ae37ac59a68c",
                    "sense_definition": "The act of receiving guests and providing them with food, drink, and amusement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hospitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company allocates a large budget for the <w>entertainment</w> of potential clients.",
                            "target_lang_translations": {
                                "ru": "Компания выделяет большой бюджет на <w>приём</w> потенциальных клиентов.",
                                "zh": "公司拨出大笔预算用于<w>招待</w>潜在客户。"
                            }
                        },
                        {
                            "text": "She takes great pride in the <w>entertainment</w> of her guests during the holidays.",
                            "target_lang_translations": {
                                "ru": "Она очень гордится <w>приёмом</w> своих гостей во время праздников.",
                                "zh": "她对在假期里<w>款待</w>客人感到非常自豪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hospitality",
                        "reception"
                    ],
                    "common_phrases": [
                        "corporate entertainment",
                        "entertainment of guests"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приём гостей и предоставление им еды, напитков и развлечений.",
                        "zh": "指接待客人并提供餐饮和消遣的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "гостей"
                            },
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "едой и напитками"
                            },
                            {
                                "target_lang_word": "гостеприимство",
                                "target_lang_sense_clarification": "радушие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "招待",
                                "target_lang_sense_clarification": "接待客人"
                            },
                            {
                                "target_lang_word": "款待",
                                "target_lang_sense_clarification": "热情接待"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "108f38ec-008e-3073-8b62-0e00cd978927",
                    "sense_definition": "The provision of food, lodging, and maintenance, especially for travelers or animals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hospitality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weary travelers stopped at an inn to seek <w>entertainment</w> for the night.",
                            "target_lang_translations": {
                                "ru": "Усталые путники остановились на постоялом дворе в поисках <w>ночлега</w> на ночь.",
                                "zh": "疲惫的旅行者在一家旅店停下来，寻求过夜的<w>食宿</w>。"
                            }
                        },
                        {
                            "text": "The old tavern sign promised good <w>entertainment</w> for both man and horse.",
                            "target_lang_translations": {
                                "ru": "Старая вывеска таверны обещала хороший <w>постой</w> и для человека, и для лошади.",
                                "zh": "那块古老的酒馆招牌承诺能为人和马匹提供良好的<w>食宿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "board",
                        "lodging"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставление еды, ночлега и ухода, особенно для путешественников или животных.",
                        "zh": "指为旅行者或动物提供食物、住宿和照料（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ночлег",
                                "target_lang_sense_clarification": "предоставление жилья"
                            },
                            {
                                "target_lang_word": "постой",
                                "target_lang_sense_clarification": "устар. временное проживание"
                            },
                            {
                                "target_lang_word": "приют",
                                "target_lang_sense_clarification": "убежище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "食宿",
                                "target_lang_sense_clarification": "提供食物和住宿"
                            },
                            {
                                "target_lang_word": "寄宿",
                                "target_lang_sense_clarification": "临时居住"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}