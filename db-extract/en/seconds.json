                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edc50927-f269-496f-a0b5-f14f29375480",
                        "source_entry_id": "4c8cee35-366d-3f91-8738-134a12e4f389",
                        "source_sense_description": "second serving",
                        "target_lang_word": "Nachschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa3755e2-30a0-38f4-b5ee-f214100c3dff",
                                        "entry_id": "3ac04f1b-ac9e-370d-947f-522f45f8d7f9",
                                        "glosses": [
                                            "zusätzliche Portion der vorherigen Speise (in kleinerer Menge)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f53bd4c7-fee6-4aee-8106-e8b218dc79f5",
                                                "sense_id": "fa3755e2-30a0-38f4-b5ee-f214100c3dff",
                                                "text": "„»Es war einfach klasse. Kann ich da noch mal einen Nachschlag bekommen?« »Oh, gerne.« Die Augen der Wirtin strahlten.“"
                                            },
                                            {
                                                "example_id": "0230598e-8aae-45d9-a8ba-f5ca02c6d321",
                                                "sense_id": "fa3755e2-30a0-38f4-b5ee-f214100c3dff",
                                                "text": "„Sie brachten es fertig, gestandene Wüstenfüchse, die es wagten, um Nachschlag zu bitten, zu zitternden Nervenbündeln zu machen.“"
                                            },
                                            {
                                                "example_id": "9dff2e37-d13e-49d5-9622-07998386369a",
                                                "sense_id": "fa3755e2-30a0-38f4-b5ee-f214100c3dff",
                                                "text": "„Die Köchin zieht ihn vor und gibt ihm oft einen Nachschlag, ohne daß die anderen wirklich neidisch werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4edca5f7-fd89-3b70-85cf-ac98e55e7e94",
                                        "entry_id": "3ac04f1b-ac9e-370d-947f-522f45f8d7f9",
                                        "glosses": [
                                            "abschließender Ausgleich von gegenseitigen Schuldverhältnissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e2bb0be-93ac-4437-bad2-8a04881e2662",
                                                "sense_id": "4edca5f7-fd89-3b70-85cf-ac98e55e7e94",
                                                "text": "„Der Chefkameramann des Erfolgsfilms ‚Das Boot‘ bekommt nach einem Urteil des Oberlandesgerichts München einen finanziellen Nachschlag einschließlich Zinsen von knapp 600 000 Euro.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a21f161f-401a-3ebd-a742-a7828de712ab",
                                        "entry_id": "3ac04f1b-ac9e-370d-947f-522f45f8d7f9",
                                        "glosses": [
                                            "„Verzierung von zwei Tönen am Ende des Trillers“"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3120755-e25f-47b5-9496-187ae00f31df",
                                                "sense_id": "a21f161f-401a-3ebd-a742-a7828de712ab",
                                                "text": "„Dann darf der Triller den gesamten Notenwert ausfüllen und mit einem Nachschlag enden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
