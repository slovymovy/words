                "senses": [
                    {
                        "sense_id": "a8331d3b-03a2-3b1c-83ad-2b711e06191e",
                        "entry_id": "b72c5fe3-1f2b-3831-b6d7-c25e8995f662",
                        "glosses": [
                            "Lehrstelle"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "fe9f1c30-179a-45e8-bc8f-d95bd595b665",
                                "sense_id": "a8331d3b-03a2-3b1c-83ad-2b711e06191e",
                                "text": "Wer Koch oder Kellner werden will, kann sich den Lehrplatz aussuchen, denn in diesen Branchen gibt es rund doppelt so viele freie Stellen wie Interessierte."
                            },
                            {
                                "example_id": "fe8c1afb-c2a9-4dae-9ccb-f03403827552",
                                "sense_id": "a8331d3b-03a2-3b1c-83ad-2b711e06191e",
                                "text": "Lehrlinge wählten ihren Lehrplatz oft danach, ob bereits Geschwister in derselben Stadt, manchmal auch beim selben Meister lernten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d002063a-b2f2-42e5-9cd1-64517f7493e7",
                        "source_entry_id": "b72c5fe3-1f2b-3831-b6d7-c25e8995f662",
                        "source_sense_id": "a8331d3b-03a2-3b1c-83ad-2b711e06191e",
                        "source_sense_description": "bairisch: Lehrstelle",
                        "target_lang_word": "apprenticeship",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apprenticeship",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c89c522-6c85-37a8-b9b7-5323f3edb1c8",
                                        "entry_id": "73e07f03-c8ad-33e5-be4d-ec95242d385a",
                                        "glosses": [
                                            "The condition of, or the time served by, an apprentice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d35d91e-ac44-34dd-a3c7-8c82caa86c6d",
                                        "entry_id": "73e07f03-c8ad-33e5-be4d-ec95242d385a",
                                        "glosses": [
                                            "The system by which a person learning a craft or trade is instructed by a master for a set time under set conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9faf3f8e-9271-40e3-82b2-a76012663410",
                                                "sense_id": "2d35d91e-ac44-34dd-a3c7-8c82caa86c6d",
                                                "text": "There, however, he had disappointed expectation. In sooth, his genius was of too creative an order for the apprenticeship of learning; he needed life in its hopes, its fears, its endurance; all that the poet learns to reproduce."
                                            },
                                            {
                                                "example_id": "63d58180-75e0-4fc3-8d75-7314716f125d",
                                                "sense_id": "2d35d91e-ac44-34dd-a3c7-8c82caa86c6d",
                                                "text": "Entry to shop grades is by apprenticeship, boys bring taken as apprentices on leaving school."
                                            },
                                            {
                                                "example_id": "5a3b205d-b224-4b12-8cf2-e15aa11bc798",
                                                "sense_id": "2d35d91e-ac44-34dd-a3c7-8c82caa86c6d",
                                                "text": "Apprenticeship programmes supply the industry with an ongoing cohort of qualified talent. It is much cheaper to train new people than to pay inflated wages to attract existing talent. Apprenticeships are also a useful way of teaching the practical, hands-on skills that the modern railway needs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
