                    }
                ],
                "senses": [
                    {
                        "sense_id": "9274ebf5-f5a5-374d-ab8b-4e32146bf966",
                        "entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
                        "glosses": [
                            "To convert to a mineral; to petrify."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d8ed2c-12f2-4bf8-87f5-b4fe60127bc2",
                                "sense_id": "9274ebf5-f5a5-374d-ab8b-4e32146bf966",
                                "text": "in all these cases , the bones found in caverns are never mineralised, but simply in the state of grave bones more or less decayed or incrusted by stalagmite ; and have no farther connexion with the rocks themselves"
                            }
                        ]
                    },
                    {
                        "sense_id": "2089086e-4aac-384c-a1fe-8c87d1abfe67",
                        "entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
                        "glosses": [
                            "To impregnate with minerals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ae3c314-4d93-4968-8b9c-55024512dc72",
                                "sense_id": "2089086e-4aac-384c-a1fe-8c87d1abfe67",
                                "text": "mineralized water"
                            }
                        ]
                    },
                    {
                        "sense_id": "ea5d994e-ee85-3d53-8150-186bbd267cbc",
                        "entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
                        "glosses": [
                            "To mineralogize; to collect and study minerals."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "276d5fdb-e68c-4c3f-8372-0263b893040f",
                                "sense_id": "ea5d994e-ee85-3d53-8150-186bbd267cbc",
                                "text": "He was a senior when he asked Barnes if he ever went \"mineralizing,\" referred admiringly to Bowdoin's Professor Cleaveland, and expressed a wish to \"give a good knock about the rocks in Maine.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b791b44f-e9f4-491a-a1a5-16ab05625193",
                        "source_entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
                        "source_sense_description": "to convert to a mineral, petrify",
                        "target_lang_word": "minéraliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minéraliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "105bde74-68c6-3386-873c-9166e8ce5d61",
                                        "entry_id": "cdd2d6f1-707a-38f8-8c55-e0dc2b2375ae",
                                        "glosses": [
                                            "Transformer par la minéralisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ceebb1d-3d81-44ef-8dc1-f595af655292",
                                                "sense_id": "105bde74-68c6-3386-873c-9166e8ce5d61",
                                                "text": "Le char, avec ses éléments en fer, ses décorations en bronze et ses restes de bois minéralisés, a été retrouvé dans les ruines au nord de Pompéi, au-delà des murs de la ville antique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb827dcc-4a41-33e8-b6dd-9dbbe4a549c6",
                                        "entry_id": "cdd2d6f1-707a-38f8-8c55-e0dc2b2375ae",
                                        "glosses": [
                                            "Transformer la matière organique d'un sol en ses composants minéraux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "819dd21e-c4a5-3e39-9952-d675731e671e",
                                        "entry_id": "cdd2d6f1-707a-38f8-8c55-e0dc2b2375ae",
                                        "glosses": [
                                            "Prendre un caractère minéral."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c2800b5-2ae1-40c0-a17f-34cff0d754b5",
                                                "sense_id": "819dd21e-c4a5-3e39-9952-d675731e671e",
                                                "text": "Un sourire méchant flottait encore au coin de ses lèvres, qui s’effaça peu à peu en même temps que ses yeux bleu pâle durcissaient, se minéralisaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a214b0b-6186-45bb-8b47-fa659a2aba02",
                        "source_entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
                        "source_sense_description": "to convert to a mineral, petrify",
                        "target_lang_word": "mineralisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mineralisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f95d3f7-d7e0-3721-9921-f650e2c5777b",
                                        "entry_id": "3466ec3b-5b40-3504-ad5b-5a53d465ef2c",
                                        "glosses": [
                                            "zum Mineral werden"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d484ea46-0682-4e3a-8868-fb1322ca07f8",
                                                "sense_id": "2f95d3f7-d7e0-3721-9921-f650e2c5777b",
                                                "text": "Die transversalen Septen sind nicht mineralisiert."
                                            },
                                            {
                                                "example_id": "7305678e-85ab-4794-8c2b-35e681b38ca4",
                                                "sense_id": "2f95d3f7-d7e0-3721-9921-f650e2c5777b",
                                                "text": "Diese Bänder sind zunächst nicht mineralisiert und werden deshalb als osteoide Säume bezeichnet."
                                            },
                                            {
                                                "example_id": "87060fb4-8697-48b0-a567-83f66296d125",
                                                "sense_id": "2f95d3f7-d7e0-3721-9921-f650e2c5777b",
                                                "text": "Auch die primären und sekundären Spongiosabälkchen sind ungenügend mineralisiert und weisen breite und unregelmäßige Osteoidsäume auf („Osteoidose“)."
                                            },
                                            {
                                                "example_id": "755cd1ae-7530-4c8a-97b5-7123791e60c8",
                                                "sense_id": "2f95d3f7-d7e0-3721-9921-f650e2c5777b",
                                                "text": "Hingegen sind die Rotgneise selbst kaum hydrothermal mineralisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "636d0fbf-baef-3883-a3fb-f8c10b091f54",
                                        "entry_id": "3466ec3b-5b40-3504-ad5b-5a53d465ef2c",
                                        "glosses": [
                                            "die Mineralbildung herbeiführen; Minerale beigeben"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5671997-97c7-4f00-b092-454da844b10c",
                                                "sense_id": "636d0fbf-baef-3883-a3fb-f8c10b091f54",
                                                "text": "Das Osteoid wird schließlich durch Einlagerung von Kalziumionen und organischem Phosphat zu Matrix ossea mineralisiert."
                                            },
                                            {
                                                "example_id": "eb71c73f-46b4-4a3d-8a87-9059e2b8e80c",
                                                "sense_id": "636d0fbf-baef-3883-a3fb-f8c10b091f54",
                                                "text": "In der Kläranlage Linz-Unkel im Landkreis Neuwied wird der Klärschlamm künftig getrocknet und anschließend in Energie umgewandelt sowie mineralisiert."
                                            },
                                            {
                                                "example_id": "da2e4ba9-79e7-4994-b3d6-572856d2e29f",
                                                "sense_id": "636d0fbf-baef-3883-a3fb-f8c10b091f54",
                                                "text": "Der Kohlenstoff wird selbstverständlich von Anfang an zum größeren Teil mineralisiert, ist aber in solchem Überschuß vorhanden, daß er die Mineralisation des Stickstoffs nicht zuläßt."
                                            },
                                            {
                                                "example_id": "0af8464c-59d0-4f03-9f01-198f2ac88b07",
                                                "sense_id": "636d0fbf-baef-3883-a3fb-f8c10b091f54",
                                                "text": "Trinkwasser ist entweder Grund-, Leitungs- oder auch Seewasser, das industriell gereinigt und unter Umständen zusätzlich mineralisiert wird."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ceb1ae3-7d9f-4223-99e5-dd87eed7d78d",
                        "source_entry_id": "00292c3c-58c2-3f18-b350-255b34598ad8",
