                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3c423ee-17de-364f-a622-cb2da711ebce",
                        "entry_id": "f15a3bec-1c44-3940-b60b-a9b9cf33b23f",
                        "glosses": [
                            "smalltime"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6c5405-47ad-44a9-bb5d-984b553cfaf2",
                                "sense_id": "c3c423ee-17de-364f-a622-cb2da711ebce",
                                "text": "Весь этот сми́рный мелкотра́вчатый люд яви́лся, так сказа́ть, «по неизбе́жности», как вы́разился оди́н из э́тих госпо́д.",
                                "translation": "All these humble small potatoes came, so to speak, \"out of inevitability,\" as one of these gentlemen put it.",
                                "english": "All these humble small potatoes came, so to speak, \"out of inevitability,\" as one of these gentlemen put it."
                            },
                            {
                                "example_id": "7a05c69d-8422-4856-ad18-4310e5340ccf",
                                "sense_id": "c3c423ee-17de-364f-a622-cb2da711ebce",
                                "text": "Всё э́то на́до знать, что́бы соста́вить поня́тие о том, как мог жить и как действи́тельно жил мелкотра́вчатый геро́й на́шего расска́за Алекса́шка, и́ли, впосле́дствии, Алекса́ндр Афана́сьевич Рыжо́в, по у́личному прозва́нию «Одноду́м».",
                                "translation": "All this must be known in order to form an idea of how the smalltime hero of our story, Alexashka, or, later, Alexander Afanasyevich Ryzhov, known around town as “Singlemind,” could and actually did live.",
                                "english": "All this must be known in order to form an idea of how the smalltime hero of our story, Alexashka, or, later, Alexander Afanasyevich Ryzhov, known around town as “Singlemind,” could and actually did live."
                            }
                        ]
                    }
                ],
