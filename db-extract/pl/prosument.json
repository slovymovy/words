                                    {
                                        "sense_id": "d7eb908f-91b1-3ddb-bf4e-9148eb62b0cf",
                                        "entry_id": "59a9ee5d-a6b8-3a41-96cc-0b9f2f75d7b8",
                                        "glosses": [
                                            "A person in postindustrial society who combines the economic roles of producer and consumer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e362587-c645-4eed-99cc-08778d48efca",
                                                "sense_id": "d7eb908f-91b1-3ddb-bf4e-9148eb62b0cf",
                                                "text": "During the First Wave most people consumed what they themselves produced. They were neither producers nor consumers in the usual sense. They were instead what might be called \"prosumers.\""
                                            }
                                        ]
                                    }
                                ]
                            },
