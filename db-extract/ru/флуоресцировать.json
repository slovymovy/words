                        "cross_references": [
                            {
                                "target_word": "fluoreszieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                        "entry_id": "d6de8cc2-8aea-3677-a569-dcd4c97d8987",
                                        "glosses": [
                                            "bei Bestrahlung (mit Licht oder Röntgenstrahlen) mit- oder von selbst aufleuchten"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dd092ac-ed81-4f0c-b740-4936f8609e1d",
                                                "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                                "text": "Es fluoresziert im Dunkeln grünlich."
                                            },
                                            {
                                                "example_id": "732778c5-a260-4358-b693-4e9e6274fb5e",
                                                "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                                "text": "Energiesparlampen glühen nicht, sie fluoreszieren, daher werfen sie ein diffuses Licht, sagt er."
                                            },
                                            {
                                                "example_id": "68a26000-4097-4c96-bba3-d01c6e1e315b",
                                                "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                                "text": "Die Biologen züchteten die Fliegen so heran, dass die Spermienköpfe rot oder grün fluoreszieren."
                                            },
                                            {
                                                "example_id": "d38afad4-2ffb-4f94-8e80-baab1b83ff15",
                                                "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                                "text": "Jetzt bemerkte der Perser auch einzelne, zerfallende Knochen, die den Jahrhunderten getrotzt hatten, und grünlich fluoriszierten."
                                            },
                                            {
                                                "example_id": "23a69e2d-a9bd-436c-9bd0-6f50b4e92107",
                                                "sense_id": "eb1e808a-b56e-3311-9589-ed34b89030e6",
                                                "text": "Das Ethidiumbromid interkalierte zwischen der doppelsträngigen DNA und fluoriszierte bei UV-Licht (MultiImage Light Cabinet, Alpha Innotech Corporation)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
