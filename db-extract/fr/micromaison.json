                                "target_senses": [
                                    {
                                        "sense_id": "3b3af812-5ac9-341f-8810-c43f2e908fb7",
                                        "entry_id": "0d6abb0f-2add-3c22-a919-fbb3c1f3a15c",
                                        "glosses": [
                                            "Synonym of microhome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e02df8c-5d71-46ce-9ec1-4a5e02ff0d5b",
                                                "sense_id": "3b3af812-5ac9-341f-8810-c43f2e908fb7",
                                                "text": "The fundamental definition of a tiny house is that it is constructed from materials that aren't just considered to be renewable but also are eco-friendly also ^([sic])."
                                            },
                                            {
                                                "example_id": "945b95da-7289-4a1e-bd5b-80712c1c0cb8",
                                                "sense_id": "3b3af812-5ac9-341f-8810-c43f2e908fb7",
                                                "text": "Tiny houses come in all shapes and sizes, and the choices you will have to make in terms of utilities, design, mobility, will really affect the way you interact with that space."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
