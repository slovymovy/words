{
    "word_family": [
        "affirmation",
        "affirmative",
        "reaffirm"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78f5d870-a447-348e-af4f-764741524468",
                    "sense_definition": "To state as a fact strongly and publicly; to agree, verify, or answer positively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_as_true",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>affirmed</w> that she would attend the meeting when I asked her.",
                            "target_lang_translations": {
                                "ru": "Она <w>подтвердила</w>, что придет на встречу, когда я спросил ее."
                            }
                        },
                        {
                            "text": "The spokesperson was quick to <w>affirm</w> the commitment of the company to its environmental goals.",
                            "target_lang_translations": {
                                "ru": "Пресс-секретарь поспешил <w>подтвердить</w> приверженность компании ее экологическим целям."
                            }
                        }
                    ],
                    "antonyms": [
                        "deny"
                    ],
                    "common_phrases": [
                        "affirm the commitment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительно и публично заявлять о каком-либо факте; соглашаться, подтверждать или давать положительный ответ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "соглашаться с фактом или верифицировать его"
                            },
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "заявлять с уверенностью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d6ee45-ccdd-3e60-b8ee-8e91a0f3d710",
                    "sense_definition": "To assert positively; to maintain as true with confidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_as_true",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He continued to <w>affirm</w> his innocence despite the evidence presented against him.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>утверждать</w> свою невиновность, несмотря на представленные против него доказательства."
                            }
                        },
                        {
                            "text": "As anyone who worked with him would <w>affirm</w>, he was a man of great integrity.",
                            "target_lang_translations": {
                                "ru": "Как <w>подтвердил</w> бы любой, кто с ним работал, он был человеком огромной честности."
                            }
                        }
                    ],
                    "antonyms": [
                        "deny",
                        "repudiate"
                    ],
                    "common_phrases": [
                        "affirm his innocence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уверенно заявлять; отстаивать истинность чего-либо с полной убежденностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "настаивать на истинности"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "свидетельствовать в пользу чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deee0be0-3a7c-343c-b9dc-0a3077e9740d",
                    "sense_definition": "To support, encourage, or validate someone's identity, feelings, or self-worth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_and_validate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They did everything they could to <w>affirm</w> the children's self-confidence.",
                            "target_lang_translations": {
                                "ru": "Они делали все возможное, чтобы <w>укрепить</w> уверенность детей в себе."
                            }
                        },
                        {
                            "text": "It is important for parents to <w>affirm</w> their children's feelings during difficult times.",
                            "target_lang_translations": {
                                "ru": "Для родителей важно <w>поддерживать</w> чувства своих детей в трудные времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "validate"
                    ],
                    "common_phrases": [
                        "affirm self-confidence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать, поощрять или признавать значимость чьей-либо личности, чувств или чувства собственного достоинства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "поддерживать уверенность или самооценку"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "признавать ценность чувств или идентичности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d894c4fb-15bd-3681-a496-798e640b0439",
                    "sense_definition": "To confirm or ratify a judgment, decree, or order, especially by an appellate court.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appeals court decided to <w>affirm</w> the lower court's decision.",
                            "target_lang_translations": {
                                "ru": "Апелляционный суд решил <w>оставить в силе</w> решение суда первой инстанции."
                            }
                        },
                        {
                            "text": "The supreme court is expected to <w>affirm</w> the ruling next week.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что верховный суд <w>подтвердит</w> решение на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "validate"
                    ],
                    "antonyms": [
                        "disaffirm",
                        "invalidate"
                    ],
                    "common_phrases": [
                        "affirm the decision",
                        "affirm the ruling"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подтверждать или утверждать судебное решение, постановление или приказ (особенно судом высшей инстанции)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставлять в силе",
                                "target_lang_sense_clarification": "о решении суда"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "утверждать вердикт или постановление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e180c596-9b4f-3616-a98d-6b139759d7ed",
                    "sense_definition": "To make a solemn formal declaration in place of an oath, especially for legal purposes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Witnesses who object to swearing on the Bible may choose to <w>affirm</w> instead.",
                            "target_lang_translations": {
                                "ru": "Свидетели, которые возражают против присяги на Библии, могут вместо этого сделать <w>торжественное заявление</w>."
                            }
                        },
                        {
                            "text": "He stood before the court to solemnly <w>affirm</w> that his testimony was true.",
                            "target_lang_translations": {
                                "ru": "Он предстал перед судом, чтобы торжественно <w>подтвердить</w>, что его показания правдивы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solemnly affirm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать торжественное официальное заявление вместо присяги, особенно в юридических целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торжественно заявлять",
                                "target_lang_sense_clarification": "делать заявление вместо присяги"
                            },
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "официально заверять без клятвы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "c73a9a2b-8030-3761-ac6a-1cbdb492e780",
                    "sense_definition": "An expression used to indicate agreement, correctness, or a positive response; yes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When asked if the target was in sight, the pilot replied, '<w>Affirm</w>, we have visual contact.'",
                            "target_lang_translations": {
                                "ru": "На вопрос, видна ли цель, пилот ответил: «<w>Подтверждаю</w>, есть визуальный контакт»."
                            }
                        },
                        {
                            "text": "The radio operator confirmed the coordinates with a brief '<w>affirm</w>' before cutting the transmission.",
                            "target_lang_translations": {
                                "ru": "Радист подтвердил координаты кратким «<w>подтверждаю</w>» перед тем, как прервать передачу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in radio communications"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение, используемое для обозначения согласия, правильности или положительного ответа; да, подтверждаю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждаю",
                                "target_lang_sense_clarification": "в радиообмене"
                            },
                            {
                                "target_lang_word": "так точно",
                                "target_lang_sense_clarification": "военное или официальное согласие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}