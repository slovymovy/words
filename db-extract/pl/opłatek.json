                                                "example_id": "d37a946d-2683-414b-856c-12c6d87b6a22",
                                                "sense_id": "880004c5-2b46-37f2-bac1-76ce0b9175c3",
                                                "text": "Здесь толпятся солдатки, // И аптекарь, ворча, // Раздаёт им облатки // По рецептам врача."
                                            }
                                        ]
                                    },
