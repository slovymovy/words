                        "entry_id": "becc8692-3a7a-3a2b-86dc-9fc57a8f7e9b",
                        "glosses": [
                            "Verkettung von Stämmen und Flexionsaffixen, bei der Stamm und Affix danach ein phonologisches bzw. graphematisches Wort bilden"
                        ],
                        "tags": [],
                        "examples": [],
