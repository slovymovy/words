                                "target_lang_sense_clarification": "in slechte staat door gebrek aan onderhoud"
                            },
                            {
                                "target_lang_word": "onbeheerd",
                                "target_lang_sense_clarification": "zonder toezicht of zorg achtergelaten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f11d11db-56ba-344e-805f-cfee12a74f10",
                    "sense_definition": "simple past and past participle of <w>disregard</w>",
