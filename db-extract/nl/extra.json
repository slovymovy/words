                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d33c654d-a96c-4890-92a8-95a94f6364e2",
                                                "sense_id": "a9c82808-24c0-3609-b7f2-d02fdf3b0e01",
                                                "text": "Peter hatte noch einmal extra darauf hingewiesen, dass das Rauchen verboten war; nun sah er Maria dennoch mit einer Zigarette im Mund."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fbf08028-306f-309b-a15a-57387ab2dcc2",
                                        "entry_id": "9d036b47-09af-376f-b53e-c21aa69d96b7",
                                        "glosses": [
                                            "speziell für diese Gelegenheit, speziell zu diesem Zweck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a42aa859-1422-4e6b-aec0-03af39e54c92",
                                                "sense_id": "fbf08028-306f-309b-a15a-57387ab2dcc2",
                                                "text": "Ich habe das Essen heute extra für dich gekocht, weil ich wusste, dass du auf der Arbeit nichts bekommen würdest."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
