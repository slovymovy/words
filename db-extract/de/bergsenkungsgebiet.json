                                "example_id": "359b4365-44b5-49d8-80f8-470888c411c4",
                                "sense_id": "c230fa0a-088a-30f6-b4cf-294381387bc8",
                                "text": "„So wurde im nördlichen Innenstadtbereich ein Bergsenkungsgebiet überschwemmt, was aufgrund drohender Seuchengefahr die Evakuierung von 25 000 bis 30 000 Bewohnern erforderlich machte.“"
                            },
                            {
                                "example_id": "75fcdf97-831a-48e5-81b4-a615c7e1d61a",
                                "sense_id": "c230fa0a-088a-30f6-b4cf-294381387bc8",
                                "text": "„Es entstand über die Jahrzehnte ein Bergsenkungsgebiet von 200 Hektar Größe und teils mehr als 7 Metern Tiefe, das die Altstadt diagonal durchzieht.“"
                            }
                        ],
