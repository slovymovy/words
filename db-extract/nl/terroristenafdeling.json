                        "examples": [
                            {
                                "example_id": "9162b80c-0a8f-4c82-9b48-ff97e1d9ddb4",
                                "sense_id": "4c6b9fae-d84d-3e2d-8aeb-ef2c028ae2cc",
                                "text": "Gedetineerden op de terroristenafdeling van de gevangenis in Vught konden schietspellen spelen in hun cel. Het gaat onder meer om de games Grand Theft Auto, Call of Duty en Brothers in Arms: Earned in Blood, bevestigt justitie naar aanleiding van een bericht in De Telegraaf. De spellen zijn deze maand weggehaald van de afdeling."
                            },
                            {
                                "example_id": "a78487e5-075a-4252-b339-028ba81026ca",
                                "sense_id": "4c6b9fae-d84d-3e2d-8aeb-ef2c028ae2cc",
                                "text": "De dreigementen die hij uitte, hebben volgens Raterman alles te maken met zijn stoornis. Onderzoek of hij echt geradicaliseerd is, loopt nog. De man zit nu niet vast op een terroristenafdeling, maar op een psychiatrische afdeling van de gevangenis."
                            }
                        ]
                    }
