                        "glosses": [
                            "Person, die an einem Shitstorm aktiv beteiligt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d68f7da4-97df-48b8-b965-d19f319fccef",
                                "sense_id": "d0e4d52d-7f8e-3be1-95ea-a8c37997f5d7",
                                "text": "„Die Einhaltung von Normen basiert nicht auf unserer Vernunft. So kommen wir denn auch dem klassischen Shitstormer nicht bei.“"
                            },
                            {
                                "example_id": "23fa1771-a9c0-4d04-b12d-6201abbd77ea",
                                "sense_id": "d0e4d52d-7f8e-3be1-95ea-a8c37997f5d7",
                                "text": "„Stolz sind die Shitstormer auf die Chronik ihrer Erfolge […].“"
                            },
                            {
                                "example_id": "dfb8f93c-0597-4e6f-a1e5-1facdf8ac2c2",
                                "sense_id": "d0e4d52d-7f8e-3be1-95ea-a8c37997f5d7",
                                "text": "„In seinem neuen Programm ‚Keinangsthasen‘, das er jetzt im Theater am Park zeigte, begegnet er ‚interaktiv‘ seinem Publikum, bedient die Gelüste der Shitstormer und regt sich mächtig auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
