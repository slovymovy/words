{
    "word_family": [
        "clueless",
        "cluey"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7557613-fc7a-3940-bd6f-fc02db07ed88",
                    "sense_definition": "A piece of evidence or an object that helps to solve a mystery or a crime.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found a vital <w>clue</w> at the scene of the crime that led them to the suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла на месте преступления важную <w>улику</w>, которая вывела их на подозреваемого."
                            }
                        },
                        {
                            "text": "Every small <w>clue</w> helps the detectives piece together what happened that night.",
                            "target_lang_translations": {
                                "ru": "Каждая мелкая <w>зацепка</w> помогает детективам восстановить картину того, что произошло той ночью."
                            }
                        }
                    ],
                    "synonyms": [
                        "indication",
                        "lead",
                        "evidence"
                    ],
                    "common_phrases": [
                        "vital clue",
                        "crime scene clue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или обстоятельство, помогающее раскрыть тайну или преступление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улика",
                                "target_lang_sense_clarification": "доказательство вины"
                            },
                            {
                                "target_lang_word": "зацепка",
                                "target_lang_sense_clarification": "незначительный факт, помогающий следствию"
                            },
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "средство для разгадывания тайны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e54946d-eaed-301b-bfdc-2d431a187f1c",
                    "sense_definition": "A hint or piece of information that helps someone find an answer or solve a puzzle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you cannot solve the crossword, I can give you a <w>clue</w> for the first word.",
                            "target_lang_translations": {
                                "ru": "Если ты не можешь разгадать кроссворд, я могу дать тебе <w>подсказку</w> к первому слову."
                            }
                        },
                        {
                            "text": "The teacher decided to give a <w>clue</w> to the students who were struggling with the riddle.",
                            "target_lang_translations": {
                                "ru": "Учитель решил дать <w>подсказку</w> ученикам, которые не могли справиться с загадкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "hint",
                        "suggestion",
                        "tip"
                    ],
                    "common_phrases": [
                        "give a clue",
                        "crossword clue",
                        "useful clue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подсказка или информация, помогающая найти ответ или решить задачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсказка",
                                "target_lang_sense_clarification": "совет для решения задачи"
                            },
                            {
                                "target_lang_word": "наводка",
                                "target_lang_sense_clarification": "информация, указывающая направление поиска"
                            },
                            {
                                "target_lang_word": "ключ",
                                "target_lang_sense_clarification": "информация для решения кроссворда или шифра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1141647-20db-3463-853d-e43a9394f971",
                    "sense_definition": "A basic understanding or knowledge about a situation or how to do something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't have a <w>clue</w> how to fix this computer, so I should call a professional.",
                            "target_lang_translations": {
                                "ru": "Я <w>понятия</w> не имею, как починить этот компьютер, так что мне стоит вызвать специалиста."
                            }
                        },
                        {
                            "text": "She had no <w>clue</w> that her friends were planning a surprise party for her birthday.",
                            "target_lang_translations": {
                                "ru": "Она и <w>не догадывалась</w>, что друзья планируют вечеринку-сюрприз на её день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "idea"
                    ],
                    "common_phrases": [
                        "have a clue",
                        "no clue",
                        "not have a clue"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the negative 'not have a clue'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Базовое понимание ситуации или знание того, как что-то сделать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "понимание или идея о чем-либо"
                            },
                            {
                                "target_lang_word": "понятие",
                                "target_lang_sense_clarification": "знание о том, как что-то устроено"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60eef70b-8196-3985-a928-d4473976da50",
                    "sense_definition": "A guide or something that points the way through a complex situation or literal labyrinth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient myth, a ball of thread served as the <w>clue</w> to escape the dark labyrinth.",
                            "target_lang_translations": {
                                "ru": "В древнем мифе клубок ниток послужил <w>путеводной нитью</w>, чтобы выбраться из темного лабиринта."
                            }
                        },
                        {
                            "text": "She felt that she held the <w>clue</w> to navigating the complex social rules of the royal court.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что нашла <w>ключ</w> к пониманию сложных социальных правил королевского двора."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "referring to a ball of thread"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Путеводная нить или ориентир в сложной ситуации или лабиринте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нить",
                                "target_lang_sense_clarification": "путеводная нить (как нить Ариадны)"
                            },
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "то, что помогает не заблудиться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cbec7f4-9364-3b17-afca-8f5e3ce4f3ea",
                    "sense_definition": "To provide someone with necessary information or facts that they are currently unaware of.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>clue</w> me in on the details of the meeting I missed yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>введи меня в курс</w> дела относительно деталей встречи, которую я пропустил вчера утром."
                            }
                        },
                        {
                            "text": "The manager needs to <w>clue</w> in the new employees about the safety procedures in the office.",
                            "target_lang_translations": {
                                "ru": "Менеджеру нужно <w>проинформировать</w> новых сотрудников о правилах техники безопасности в офисе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clue in",
                        "clue someone in"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used with 'in' or 'up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ввести кого-либо в курс дела, предоставив необходимую информацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввести в курс дела",
                                "target_lang_sense_clarification": "сообщить подробности"
                            },
                            {
                                "target_lang_word": "просветить",
                                "target_lang_sense_clarification": "дать информацию неосведомленному человеку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b81e590f-6de8-3e93-ab70-beb13ef8384c",
                    "sense_definition": "To write or create a hint for a puzzle, such as a crossword.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "puzzle_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author struggled to <w>clue</w> the final word of the Sunday crossword puzzle.",
                            "target_lang_translations": {
                                "ru": "Автор с трудом смог <w>придумать определение</w> к последнему слову воскресного кроссворда."
                            }
                        },
                        {
                            "text": "It is difficult to <w>clue</w> common words in a way that is both challenging and fair.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>давать подсказки</w> к обычным словам так, чтобы это было одновременно сложно и честно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Составлять описание или подсказку для слова в кроссворде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать определение",
                                "target_lang_sense_clarification": "формулировать вопрос к слову в загадке"
                            },
                            {
                                "target_lang_word": "придумывать подсказку",
                                "target_lang_sense_clarification": "создавать описание для кроссворда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aadf7638-47a5-32fa-ac57-5339176c36aa",
                    "sense_definition": "An alternative spelling of <w>clew</w>, meaning to roll into a ball or to haul up a sail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors had to <w>clue</w> up the sails quickly as the storm began to approach.",
                            "target_lang_translations": {
                                "ru": "Матросам пришлось быстро <w>подтянуть</w> паруса, так как начал приближаться шторм."
                            }
                        },
                        {
                            "text": "He watched the crew <w>clue</w> the lines according to the captain's strict orders.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как команда <w>сматывает</w> тросы согласно строгим приказам капитана."
                            }
                        }
                    ],
                    "common_phrases": [
                        "clue up"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of clew"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сворачивать в клубок или подтягивать паруса (морской термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать",
                                "target_lang_sense_clarification": "подтягивать паруса к реям"
                            },
                            {
                                "target_lang_word": "сматывать",
                                "target_lang_sense_clarification": "сворачивать в клубок"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a728a97e-fb01-3333-ad73-d40d7b7b586e",
                    "sense_definition": "The name of a popular mystery board game where players must identify a murderer.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "We spent the entire rainy afternoon playing <w>Clue</w> and trying to find the killer.",
                            "target_lang_translations": {
                                "ru": "Весь дождливый день мы провели, играя в «<w>Улику</w>» и пытаясь найти убийцу."
                            }
                        },
                        {
                            "text": "In the game of <w>Clue</w>, you must determine the room and the weapon used.",
                            "target_lang_translations": {
                                "ru": "В игре «<w>Улика</w>» вы должны определить комнату и использованное оружие."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play Clue"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American name for Cluedo"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название популярной настольной игры-детектива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Улика",
                                "target_lang_sense_clarification": "название игры (Clue/Cluedo)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}