{
    "word_family": [
        "toadstool",
        "toady",
        "toadfish",
        "toad-like"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01c8bf68-3b7c-36d5-8978-c428471907fb",
                    "sense_definition": "An amphibian similar to a frog but with shorter legs and dry, bumpy skin.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "amphibian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children found a large <w>toad</w> hiding under a damp rock in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети нашли большую <w>жабу</w>, прятавшуюся под влажным камнем в саду."
                            }
                        },
                        {
                            "text": "Unlike frogs, a <w>common</w> <w>toad</w> usually crawls rather than hops long distances.",
                            "target_lang_translations": {
                                "ru": "В отличие от лягушек, <w>обыкновенная</w> <w>жаба</w> обычно ползает, а не прыгает на большие расстояния."
                            }
                        }
                    ],
                    "synonyms": [
                        "pad",
                        "paddock"
                    ],
                    "common_phrases": [
                        "common toad",
                        "warty toad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Земноводное, похожее на лягушку, но с более короткими лапами и сухой бородавчатой кожей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаба",
                                "target_lang_sense_clarification": "земноводное животное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23bbd251-2cc3-33b2-bb52-bb1fc760b18a",
                    "sense_definition": "A person who is considered very unpleasant, mean, or contemptible.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "unpleasant person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>vile</w> <w>toad</w> who treats his employees with absolutely no respect.",
                            "target_lang_translations": {
                                "ru": "Он мерзкая <w>жаба</w>, которая относится к своим сотрудникам без всякого уважения."
                            }
                        },
                        {
                            "text": "I cannot believe she is dating that <w>toad</w> after the way he lied to her.",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что она встречается с этим <w>гадом</w> после того, как он ей лгал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vile toad",
                        "little toad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as an insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который считается крайне неприятным, подлым или презренным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаба",
                                "target_lang_sense_clarification": "неприятный, подлый человек"
                            },
                            {
                                "target_lang_word": "пакостник",
                                "target_lang_sense_clarification": "тот, кто делает гадости"
                            },
                            {
                                "target_lang_word": "гад",
                                "target_lang_sense_clarification": "презренный человек"
                            },
                            {
                                "target_lang_word": "мерзавец",
                                "target_lang_sense_clarification": "подлый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebafaa50-97b3-3a04-adc5-064a62b52852",
                    "sense_definition": "A person who is perceived as physically unattractive or ugly.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unpleasant person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel bully called the boy an <w>ugly</w> <w>toad</w> in front of the whole class.",
                            "target_lang_translations": {
                                "ru": "Жестокий задира назвал мальчика уродливой <w>жабой</w> перед всем классом."
                            }
                        },
                        {
                            "text": "In the old fairy tale, the prince was cursed to look like a <w>toad</w> until he found love.",
                            "target_lang_translations": {
                                "ru": "В старой сказке принц был проклят выглядеть как <w>жаба</w>, пока не найдет любовь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ugly toad"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, воспринимаемый как физически непривлекательный или уродливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаба",
                                "target_lang_sense_clarification": "некрасивая женщина или человек"
                            },
                            {
                                "target_lang_word": "урод",
                                "target_lang_sense_clarification": "крайне некрасивый человек"
                            },
                            {
                                "target_lang_word": "страшилище",
                                "target_lang_sense_clarification": "очень непривлекательный внешне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a7b0e63-f183-3646-8776-0752ec9e4392",
                    "sense_definition": "To permanently ban or delete a user's account from an online virtual world or system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The administrator decided to <w>toad</w> the player after they repeatedly violated the community rules.",
                            "target_lang_translations": {
                                "ru": "Администратор решил <w>забанить</w> игрока после того, как тот неоднократно нарушал правила сообщества."
                            }
                        },
                        {
                            "text": "If you continue to harass others, the moderators will <w>toad</w> your account permanently.",
                            "target_lang_translations": {
                                "ru": "Если вы продолжите донимать других, модераторы навсегда <w>удалят</w> ваш аккаунт."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in MUD and early online gaming contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Навсегда заблокировать или удалить учетную запись пользователя в онлайн-мире или системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забанить",
                                "target_lang_sense_clarification": "заблокировать аккаунт"
                            },
                            {
                                "target_lang_word": "удалить",
                                "target_lang_sense_clarification": "стереть учетную запись"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}