            "senses": [
                {
                    "sense_id": "e66e961b-a49f-32a6-981a-8891fd9c944b",
                    "sense_definition": "Heurter un obstacle du pied en marchant, ou achopper contre une difficulté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En marchant dans l'obscurité, il a failli <w>buter</w> contre une racine d'arbre."
                        },
                        {
                            "text": "L'enfant commence à lire le texte à voix haute mais <w>bute</w> sur plusieurs mots."
                        }
                    ],
                    "synonyms": [
                        "achopper",
                        "trébucher"
                    ],
                    "common_phrases": [
