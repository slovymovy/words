                    {
                        "sense_id": "7f28c7cf-ba95-321b-b035-c9564ce83279",
                        "entry_id": "e165725d-e740-327f-b5cb-5fb0fc8e1f31",
                        "glosses": [
                            "eine getrocknete Blume für dekorative Zwecke"
                        ],
                        "tags": [
                            "Dekoration"
                        ],
                        "examples": [
                            {
                                "example_id": "4675ccf7-bcaa-4c5b-8ea8-ed546441afcc",
                                "sense_id": "7f28c7cf-ba95-321b-b035-c9564ce83279",
                                "text": "Pflanzen mit papierartigen Blütenblättern sind als Trockenblumen am besten geeignet."
                            },
                            {
                                "example_id": "fc24a433-b4a6-47bf-b33e-cad8d8a47f5f",
                                "sense_id": "7f28c7cf-ba95-321b-b035-c9564ce83279",
                                "text": "In der Floristik ist die Trockenblume ein wichtiger Bestandteil."
                            },
                            {
                                "example_id": "f543c8ba-602f-4ddf-9019-81fe61734a3a",
                                "sense_id": "7f28c7cf-ba95-321b-b035-c9564ce83279",
                                "text": "Trockenblumen werden immer häufiger in Gartenbeeten angepflanzt."
                            }
                        ],
