                ],
                "senses": [
                    {
                        "sense_id": "5a76296e-ab3d-3773-ba40-d755043396c2",
                        "entry_id": "8f6c1ed5-87d7-3cf9-b4b1-bf39ab0ba361",
                        "glosses": [
                            "Transformer (une image, etc.) en vue de la rendre imprimable sous forme de poster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70fa970f-105d-4ca9-bdfb-574669f35f78",
                                "sense_id": "5a76296e-ab3d-3773-ba40-d755043396c2",
                                "text": "Donc j’ai utilisée^([sic]) photophiltre comme je le fait^([sic]) souvent, soit pour bichromiser ou postériser, j’ai utilisé ce dernier outil d’où la sensation de saturation."
                            }
                        ]
                    },
                    {
                        "sense_id": "283144f8-6e2b-31e7-98f5-8133123908e1",
                        "entry_id": "8f6c1ed5-87d7-3cf9-b4b1-bf39ab0ba361",
                        "glosses": [
                            "Représenter un sujet sous forme de poster."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a679b30a-95b8-44de-b42d-9e0505358993",
                                "sense_id": "283144f8-6e2b-31e7-98f5-8133123908e1",
                                "text": "On a, depuis, postérisé de Gaulle, postérisé Nasser, postérisé Mao. En postérisant le « Che » et Marilyn Monroe, les hommes d’affaires n’ont pas inventé grand-chose."
                            },
                            {
                                "example_id": "78bd25ff-3f4f-4ef3-a198-1a5426bbe788",
                                "sense_id": "283144f8-6e2b-31e7-98f5-8133123908e1",
                                "text": "Staline bien avant Manoir, Staline et Mao, Peron et Evita s'étaient postérisés et avaient postérisé leurs peuples."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1097199-2d60-3cc9-a52d-ca07e1c78bb0",
                        "entry_id": "8f6c1ed5-87d7-3cf9-b4b1-bf39ab0ba361",
                        "glosses": [
                            "Accrocher des posters (à un mur, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee8212f-b00b-4654-87a3-909f0abcc4aa",
                                "sense_id": "f1097199-2d60-3cc9-a52d-ca07e1c78bb0",
                                "text": "Mais au fil des jours, la clientèle a rajeuni, rajeuni... au point que les aïeuls sont restés chez eux et que la Direction, avec à-propos, a redescendu sa piste, supprimé ses tables et « postérisé » ses murs."
                            }
                        ]
                    }
                ],
