        "fr-extract.jsonl": [
            {
                "entry_id": "084a2a1d-99f9-3367-8922-10574bfcabea",
                "word": "triglycéride",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1cc12923-6f41-42a2-8325-5d434dc5344c",
                        "entry_id": "084a2a1d-99f9-3367-8922-10574bfcabea",
                        "tags": [
                            "plural"
                        ],
                        "form": "triglycérides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "099f2bcd-ef99-3cd9-b72f-cdecc75090e1",
                        "entry_id": "084a2a1d-99f9-3367-8922-10574bfcabea",
                        "glosses": [
                            "Glycéride dans lequel les trois groupements hydroxyle du glycérol sont estérifiés par des acides gras."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "569a28bc-3102-45de-8a57-6acd7b2eddd4",
                                "sense_id": "099f2bcd-ef99-3cd9-b72f-cdecc75090e1",
                                "text": "Les triglycérides donnent des textures agréables aux aliments comme surtout l'onctuosité mais ne sont pas vraiment des stimulants gustatifs."
                            },
                            {
                                "example_id": "960b37eb-9661-4ff2-8714-c2b8f852a847",
                                "sense_id": "099f2bcd-ef99-3cd9-b72f-cdecc75090e1",
                                "text": "Les triglycérides du beurre se comptent par millions, puisque l’on a identifié 400 résidus d’acides gras différant par leur longueur ou par leurs insaturations (des doubles liaisons entre des atomes de carbone voisins), et chaque triglycéride a un point de fusion différent : c’est la raison pour laquelle ce mélange qu’est le beurre commence à fondre à – 10 °C, et que sa fusion s’achève à environ 55 °C."
                            },
                            {
                                "example_id": "df2c4e3b-4da7-484d-bd6a-c50175e869bc",
                                "sense_id": "099f2bcd-ef99-3cd9-b72f-cdecc75090e1",
                                "text": "Dans les repas d’affaires, le dessert est presque toujours sacrifié. Pas trop de sucre, il faut pouvoir aller au restaurant sans encourir la prise de poids ni l’assaut des triglycérides."
                            }
                        ]
                    }
                ],
