                                        "sense_id": "6d0c9fa0-7377-373a-8870-ef97f57ce68b",
                                        "entry_id": "b005b19d-9c53-32cf-b033-0ee0dbea7936",
                                        "glosses": [
                                            "A long, narrow container, open on top, for feeding or watering animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30719bac-eecf-4559-ad69-7cead3308ea5",
                                                "sense_id": "6d0c9fa0-7377-373a-8870-ef97f57ce68b",
                                                "text": "One of Harriet's chores was to slop the pigs' trough each morning and evening."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ba214a-cdd9-35f0-a9fe-f0e0834adc8d",
                                        "entry_id": "b005b19d-9c53-32cf-b033-0ee0dbea7936",
                                        "glosses": [
