                "senses": [
                    {
                        "sense_id": "18cf4673-6092-3723-9f4d-766601725ee3",
                        "entry_id": "9fd3f648-4e52-3242-b24b-6aafc6616849",
                        "glosses": [
                            "van iets dat het alleen maar de hoofdlijnen weergeeft zonder verdere detaillering of uitwerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "396eda92-dcf3-49d4-bfbc-8ddfa6e8242d",
                                "sense_id": "18cf4673-6092-3723-9f4d-766601725ee3",
                                "text": "Eerder gaf Jett Rebel al blijk van muzikale incontinentie door in één jaar drie albums uit te brengen vol onaffe liedjes. Nu volgt collega Johannes Sigmond van Blaudzun met het vlak en schetsmatig klinkende tweede deel van zijn Jupiter-trilogie."
                            },
                            {
                                "example_id": "bd773717-c132-4543-a7b2-6bee5529ed28",
                                "sense_id": "18cf4673-6092-3723-9f4d-766601725ee3",
                                "text": "Het vluchtplan van Assange is slechts schetsmatig, schrijft The Guardian. Twee bronnen stellen dat Fidel Narváez, een vertrouweling van Assange, het contactpunt met Moskou was."
                            },
                            {
                                "example_id": "19eda1ad-2a80-4a36-ae67-c6cfddb84ade",
                                "sense_id": "18cf4673-6092-3723-9f4d-766601725ee3",
                                "text": "Toch blijven zij nogal schetsmatige personages, net als de mannen trouwens. Zeker in vergelijking met de rol van Emily Blunt. Haar emotioneel geladen acteerwerk houdt The girl on the train stevig op de rails, ook in de scherpste bochten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9a55348-1067-4572-bae0-c6aefdbbfaee",
                        "source_entry_id": "9fd3f648-4e52-3242-b24b-6aafc6616849",
                        "source_sense_id": "18cf4673-6092-3723-9f4d-766601725ee3",
                        "target_lang_word": "vague",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e64d9272-acec-347d-801e-fa793802b7b3",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not clearly expressed; stated in indefinite terms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20770b8e-ac01-4245-bebc-5082d4b39da5",
                                                "sense_id": "e64d9272-acec-347d-801e-fa793802b7b3",
                                                "text": "It follows from what has been said that a vague thought has more likelihood of being true than a precise one. To try and hit an object with a vague thought is like trying to hit the bull's eye with a lump of putty: when the putty reaches the target, it flattens out all over it, and probably covers the bull's eye along with the rest. To try and hit an object with a precise thought is like trying to hit the bull's eye with a bullet. The advantage of the precise thought is that it distinguishes between the bull's eye and the rest of the target."
                                            },
                                            {
                                                "example_id": "3af473e5-6da8-4bc9-b399-a464a83b8016",
                                                "sense_id": "e64d9272-acec-347d-801e-fa793802b7b3",
                                                "text": "Throughout the first week of his presidency, Dulles and Bissell continued to brief Kennedy on their strategy for Cuba, but the men were vague and their meetings offered little in the way of hard facts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38398246-25bf-363b-96f5-87e9ccef139a",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not having a precise meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f81a05-1104-45ca-b01d-3a1b2db40ec7",
                                                "sense_id": "38398246-25bf-363b-96f5-87e9ccef139a",
                                                "text": "a vague term of abuse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e56f6036-8005-3173-b822-b23cc84d1250",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not clearly defined, grasped, or understood; indistinct; slight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b550f620-5e2f-4729-9983-25b87bf26ae9",
                                                "sense_id": "e56f6036-8005-3173-b822-b23cc84d1250",
                                                "text": "only a vague notion of what’s needed"
                                            },
                                            {
                                                "example_id": "04705dba-4b08-410b-83af-f7cf7880f30d",
                                                "sense_id": "e56f6036-8005-3173-b822-b23cc84d1250",
                                                "text": "a vague hint of a thickening waistline"
                                            },
                                            {
                                                "example_id": "1e92eb9d-28b9-447a-aa67-1705bc245df7",
                                                "sense_id": "e56f6036-8005-3173-b822-b23cc84d1250",
                                                "text": "I haven’t the vaguest idea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58ae1e7-6277-3c87-9e32-34fd13c1bc01",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not clearly felt or sensed; somewhat subconscious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df823e39-810d-43f6-bf16-063db0fd2a9b",
                                                "sense_id": "f58ae1e7-6277-3c87-9e32-34fd13c1bc01",
                                                "text": "a vague longing"
                                            },
                                            {
                                                "example_id": "db3a54f0-db48-4e1e-9601-d51d1d3e9db0",
                                                "sense_id": "f58ae1e7-6277-3c87-9e32-34fd13c1bc01",
                                                "text": "⁠For though my nature rarely yields\n⁠To that vague fear implied in death;\n⁠Nor shudders at the gulfs beneath,\nThe howlings from forgotten fields; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d70d19-f657-3799-bbae-e40213eef474",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not thinking or expressing one’s thoughts clearly or precisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac267624-7843-436d-93e9-14b06a0cad2f",
                                                "sense_id": "f6d70d19-f657-3799-bbae-e40213eef474",
                                                "text": "Waxed-fleshed out-patients / Still vague from accidents, / And characters in long coats / Deep in the litter-baskets […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487668eb-d189-303b-8c7b-6b9b8f4f4274",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Lacking expression; vacant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af9a9d46-81d4-361e-9c64-c114a8f63a7b",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Not sharply outlined; hazy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93f63fa-5297-464b-86c5-a2eeb63e113a",
                                                "sense_id": "af9a9d46-81d4-361e-9c64-c114a8f63a7b",
                                                "text": "He walked. To the corner of Hamilton Place and Picadilly, and there stayed for a while, for it is a romantic station by night. The vague and careless rain looked like threads of gossamer silver passing across the light of the arc-lamps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a349029a-38e1-3769-917b-765f0f32b124",
                                        "entry_id": "020c8109-bfc7-363e-b76b-d36b470cce27",
                                        "glosses": [
                                            "Wandering; vagrant; vagabond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5484ec-3520-436f-a6a6-7c20149b4d1a",
                                                "sense_id": "a349029a-38e1-3769-917b-765f0f32b124",
                                                "text": "The Lord Gray incourag'd his men to set sharply upon the vague villains"
                                            },
                                            {
                                                "example_id": "1140e7b9-ee71-4780-b7d1-a976002609ba",
                                                "sense_id": "a349029a-38e1-3769-917b-765f0f32b124",
                                                "text": "She danced along with vague, regardless eyes, / Anxious her lips, her breathing quick and short: [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64a8e198-d3fc-30fc-a20c-ab5bb4f9119d",
                                        "entry_id": "2c3545e3-4008-31df-88c3-5f998c760971",
                                        "glosses": [
                                            "A wandering; a vagary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac7dfa5-5e77-4a1e-b8eb-0f70b4d00a2d",
                                                "sense_id": "64a8e198-d3fc-30fc-a20c-ab5bb4f9119d",
                                                "text": "the Scots had some leasure to plaie their vagues"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf33c921-9ef6-39f1-b3f6-8ef68f0a87b6",
                                        "entry_id": "2c3545e3-4008-31df-88c3-5f998c760971",
                                        "glosses": [
                                            "An indefinite expanse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad7cefb-fe31-4ae4-919e-947ee4ab2018",
                                                "sense_id": "bf33c921-9ef6-39f1-b3f6-8ef68f0a87b6",
                                                "text": "The gray vague of unsympathizing sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16a32c6c-6fe3-3a19-a560-82a2775e57b9",
                                        "entry_id": "95b3eecc-b710-3f0a-924e-d361d6892f9c",
                                        "glosses": [
                                            "to wander; to roam; to stray."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18f646c-97e8-4166-920f-69f0e49b8f4c",
                                                "sense_id": "16a32c6c-6fe3-3a19-a560-82a2775e57b9",
                                                "text": "[The soul] doth vague and wander."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ead80c4-d43d-322f-81c3-26d85f231141",
                                        "entry_id": "95b3eecc-b710-3f0a-924e-d361d6892f9c",
                                        "glosses": [
                                            "To become vague or act in a vague manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70130ab8-e2d0-4d90-b22a-5eadac23f742",
                                                "sense_id": "5ead80c4-d43d-322f-81c3-26d85f231141",
                                                "text": "Vaguely, yes. I've vagued all my life; that's been my curse."
                                            },
                                            {
                                                "example_id": "f96dec92-b4b4-48e0-a6a9-f5be5568d2eb",
                                                "sense_id": "5ead80c4-d43d-322f-81c3-26d85f231141",
                                                "text": "A man's mind vagued up a little, for how can you remember the feel of pleasure or pain or choking emotion?"
                                            },
                                            {
                                                "example_id": "92a71024-4338-4060-adcb-93ec2817195a",
                                                "sense_id": "5ead80c4-d43d-322f-81c3-26d85f231141",
                                                "text": "What's with you? You're all vagued out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b48b52e-9040-3766-9cc3-ccbad7274d99",
                                        "entry_id": "95b3eecc-b710-3f0a-924e-d361d6892f9c",
                                        "glosses": [
                                            "To make vague negative comments publicly; to make highly veiled complaints or insults."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
