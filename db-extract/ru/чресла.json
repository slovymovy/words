                "senses": [
                    {
                        "sense_id": "6b4c4077-c560-38eb-b470-8cce66078d53",
                        "entry_id": "212e6b4c-6d0c-3b7c-a9f8-9c87ba7ca4d9",
                        "glosses": [
                            "мн. ч., устар., церк., книжн., высок. поясница, бёдра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6bdd33-3aea-4e5b-b2d0-26652664470d",
                                "sense_id": "6b4c4077-c560-38eb-b470-8cce66078d53",
                                "text": "Да будут чресла ваши препоясаны и светильники горящи."
                            },
                            {
                                "example_id": "06993996-8544-4bb9-b5f9-70abe0bc109f",
                                "sense_id": "6b4c4077-c560-38eb-b470-8cce66078d53",
                                "text": "Никто бы не мог сказать, что лучше у неё выходит — драйв справа или драйв слева: один был зеркальным отображением другого, — у меня в самых чреслах до сих пор покалывает от пистолетной пальбы этих ударов, которым вторили чёткое эхо и выкрики Электры."
                            }
                        ]
                    }
