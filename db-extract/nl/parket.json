                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686286ea-cdc7-4d55-b687-0f9c1c1db187",
                                "sense_id": "557262a7-f0f3-3794-bf27-20f1fda022fb",
                                "text": "In de meeste gevallen brengt het Openbaar Ministerie de zaak immers niet voor de strafrechter. Zo beslist het parket vaak niet te vervolgen of de zaak zelf af te handelen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a4d6018-b8a0-3169-b1f5-10800ced5863",
                        "entry_id": "f216705c-4441-3acd-9e35-989a8d37d8f8",
                        "glosses": [
                            "afzonderlijke ruimte in gerechtszalen, bijv. van de officier van justitie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abcc172b-560e-4046-9c42-2378637745f0",
                                "sense_id": "5a4d6018-b8a0-3169-b1f5-10800ced5863",
                                "text": "Fredrika parkeerde voor het parket van de officier van justitie, vlak bij het station."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf8933a4-5cb2-3fdd-b526-70b15a0d662d",
                        "entry_id": "f216705c-4441-3acd-9e35-989a8d37d8f8",
