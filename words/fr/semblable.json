            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "58809119-3a15-3e61-82bf-81e8085d1548",
                    "sense_definition": "Qui ressemble à une autre personne ou chose, qui présente des traits ou des caractères communs.",
