                    {
                        "translation_id": "ca4a0c34-9e30-4658-b102-315024731814",
                        "source_entry_id": "fe01285c-c33e-32d5-b31d-0027f9309b62",
                        "source_sense_id": "583afb58-9197-31e6-a007-aace1ba8f64a",
                        "source_sense_description": "plant",
                        "target_lang_word": "carthame des teinturiers",
                        "target_lang_code": "fr",
