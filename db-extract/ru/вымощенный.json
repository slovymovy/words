                        "examples": [
                            {
                                "example_id": "5bd2f256-3937-460b-87fd-5e752c1e0662",
                                "sense_id": "ac6b22dd-14a6-35c6-9513-5c68a3f6df15",
                                "text": "От дома к институту вела вымощенная жёлтым ракушечником дорожка, обсаженная слева и справа обкомовскими голубыми елями, свидетельствующими о том, что когда-то у института всё было хорошо.",
                                "translation": "The path that led from their home to the institute was paved with yellow coquina shell and lined on the left and the right with blue spruce trees planted by the Regional Committee, which indicated that at one time everything at the institute had been well and good.",
                                "english": "The path that led from their home to the institute was paved with yellow coquina shell and lined on the left and the right with blue spruce trees planted by the Regional Committee, which indicated that at one time everything at the institute had been well and good."
                            }
                        ]
