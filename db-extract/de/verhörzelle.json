                        "examples": [
                            {
                                "example_id": "a4e51024-3a90-486e-840b-899631e645d4",
                                "sense_id": "25936eb3-36af-312e-a61f-aaa8c81d0e4e",
                                "text": "„Die Verhörzelle war eng und feucht, an den schimmeligen Wänden lief in langen Tropfen Kondenswasser herab.“"
                            },
                            {
                                "example_id": "8feb7535-8cd0-4971-9b15-e189bd12c434",
                                "sense_id": "25936eb3-36af-312e-a61f-aaa8c81d0e4e",
                                "text": "„In den Verhörzellen der Spezialeinheit redete jeder, ohne es zu wollen, hätte sie mein Geheimnis verraten.“"
                            }
                        ],
