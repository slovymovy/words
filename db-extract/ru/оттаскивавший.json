                "senses": [
                    {
                        "sense_id": "d61c69be-e328-3f47-8d0d-3568421b0329",
                        "entry_id": "b447fe68-dc47-3bbd-8d30-552f0cab23fd",
                        "glosses": [
                            "действ. прич. прош. вр. от оттаскивать (волоком перемещать)"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "1d48bc5a-8172-4b6c-ba55-66c1a4ef5030",
                                "sense_id": "d61c69be-e328-3f47-8d0d-3568421b0329",
                                "text": "Оттаскивавший стопки книг в библиотеку Антон Петрович уже порядком утомился."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2f8a067-423c-3dd2-a2bd-a383f0ef14eb",
                        "entry_id": "b447fe68-dc47-3bbd-8d30-552f0cab23fd",
                        "glosses": [
                            "действ. прич. прош. вр. от оттаскивать (насильно удалять от кого-то или чего-то)"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "0756b570-7d15-4a60-ae23-7da14e7ae3c1",
                                "sense_id": "d2f8a067-423c-3dd2-a2bd-a383f0ef14eb",
                                "text": "Войдя в класс, я увидела Ваню, насильно оттаскивавшего бросающегося проклятиями Колю от учителя литературы."
                            }
                        ]
                    }
