                "senses": [
                    {
                        "sense_id": "ac4691f1-601b-3697-884a-8a7ec907fe0a",
                        "entry_id": "8621d7c7-716c-3bdf-8771-282682596b45",
                        "glosses": [
                            "Apparat zum Nachweis des statischen Auftriebs von Objekten in Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d16823ee-5650-4896-b5a5-e07df7043311",
                                "sense_id": "ac4691f1-601b-3697-884a-8a7ec907fe0a",
                                "text": "„Das Dasymeter beruht auf dem Grundsatze, dass der Auftrieb, welchen ein schwebender oder schwimmender Körper erleidet, proportional ist der Dichte des denselben umgebenden Mediums.“"
                            },
                            {
                                "example_id": "71fae13a-00a4-4678-ad21-2f6f2f02ae1c",
                                "sense_id": "ac4691f1-601b-3697-884a-8a7ec907fe0a",
                                "text": "„Da auch die richtige Zugregulirung ein wesentlicher Faktor bei jeder Feuerungsanlage ist, so wird mit dem Dasymeter ein Zugmesser in Verbindung gebracht, an dessen Zifferblatt die Zugstärke in Millimetern-Wassersäule abzulesen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f39d1065-99d9-40fe-8bf0-f3cd387d1bf4",
                        "source_entry_id": "8621d7c7-716c-3bdf-8771-282682596b45",
                        "source_sense_id": "ac4691f1-601b-3697-884a-8a7ec907fe0a",
                        "source_sense_description": "Apparat zum Nachweis des statischen Auftriebs von Objekten in Luft",
                        "target_lang_word": "dasymeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dasymeter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26101ce1-e747-3225-b103-c5d78b783a5b",
                                        "entry_id": "eb8e8605-b043-38da-b233-631ea30d4b9c",
                                        "glosses": [
                                            "An instrument for testing the density of gases, consisting of a thin glass globe, which is weighed in the gas or gases, and then in an atmosphere of known density."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "267cc5d0-e7d9-4d15-be7e-c84c7f224d4a",
                                                "sense_id": "26101ce1-e747-3225-b103-c5d78b783a5b",
                                                "text": "The dasymeter consists of a two-armed lever or balance beam, on one arm of which is a hermetically sealed glass sphere of 3 litres capacity, while the other arm carries a balancing weight. The higher the percentage of carbonic anhydride contained in the gas to be examined, the higher will be its specific gravity, and consequently the greater its weight."
                                            },
                                            {
                                                "example_id": "89eebfef-59d0-43b9-948e-b63020bdcdf7",
                                                "sense_id": "26101ce1-e747-3225-b103-c5d78b783a5b",
                                                "text": "With the idea that regulation of air supply would secure great economy of fuel, an instrument called a “dasymeter” has been invented to indicate the percentage of carbonic acid in the products of combustion; the weight of a vessel, through which gases are being continually drawn from the chimney of a boiler, is indicated on a scale which shows the percentage of carbonic acid compared with the weight of pure air."
                                            },
                                            {
                                                "example_id": "092a4e47-c6a2-4993-9e33-376c68f08bb8",
                                                "sense_id": "26101ce1-e747-3225-b103-c5d78b783a5b",
                                                "text": "Spring-balances are in use in numerous early forms of so-called dynamometers, dasymeters, etc., in machines used for testing paper, textile fabrics, wire, etc., as in the apparatus of Hartig-Reusch, Wendler, Martens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
