                        "entry_id": "68cd6300-301d-3e77-a6b2-db3cab62a041",
                        "glosses": [
                            "Procédé visant à augmenter la poussée d’un réacteur par injection de carburant en aval de la turbine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae777e47-4fad-4a5c-8e2c-4c69c82f3de5",
                                "sense_id": "3e1cdf07-4b32-3ab7-9655-908e9f602711",
                                "text": "Avec sa postcombustion, le Rafale peut décoller sur 400 m, monter rapidement à plus de 16 000 m, « tout en consommant moins que le Mirage 2000 »."
                            }
                        ]
                    }
                ],
