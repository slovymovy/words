{
    "word_family": [
        "lead",
        "leader",
        "leading",
        "mislead",
        "misleading",
        "leaderless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4fbc8828-9e30-30b9-b4f1-061afc474520",
                    "sense_definition": "The ability or quality of leading people or an organization.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needs strong <w>leadership</w> to succeed in this competitive market.",
                            "target_lang_translations": {
                                "ru": "Команде необходимо сильное <w>руководство</w>, чтобы преуспеть на этом конкурентном рынке.",
                                "zh": "团队需要强大的<w>领导力</w>才能在这个竞争激烈的市场中取得成功。"
                            }
                        },
                        {
                            "text": "She showed great <w>leadership</w> skills during the crisis.",
                            "target_lang_translations": {
                                "ru": "Она проявила отличные навыки <w>лидерства</w> во время кризиса.",
                                "zh": "她在危机期间展现出了卓越的<w>领导才能</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "guidance",
                        "direction"
                    ],
                    "common_phrases": [
                        "strong leadership",
                        "leadership skills",
                        "show leadership",
                        "lack leadership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность или качество, позволяющее вести за собой людей или управлять организацией.",
                        "zh": "领导他人或组织的能力或品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лидерство",
                                "target_lang_sense_clarification": "способность вести за собой"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "управление, наставничество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领导力",
                                "target_lang_sense_clarification": "指引导和影响他人的能力"
                            },
                            {
                                "target_lang_word": "领导才能",
                                "target_lang_sense_clarification": "指具备的领导方面的才干"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba71bb33-b696-306a-8c12-661218a37f05",
                    "sense_definition": "The group of people who are in charge of an organization, country, or party.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The party <w>leadership</w> decided to change the policy after the election results.",
                            "target_lang_translations": {
                                "ru": "Партийное <w>руководство</w> решило изменить политику после результатов выборов.",
                                "zh": "选举结果出炉后，党内<w>领导层</w>决定改变政策。"
                            }
                        },
                        {
                            "text": "Discussions are taking place between the union <w>leadership</w> and the company owners.",
                            "target_lang_translations": {
                                "ru": "Ведутся переговоры между <w>руководством</w> профсоюза и владельцами компании.",
                                "zh": "工会<w>领导层</w>与公司所有者之间正在进行讨论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "administration",
                        "management",
                        "executive"
                    ],
                    "common_phrases": [
                        "party leadership",
                        "senior leadership",
                        "military leadership",
                        "union leadership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, возглавляющих организацию, страну или партию.",
                        "zh": "负责管理组织、国家或政党的一群人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "руководящий состав, начальство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领导层",
                                "target_lang_sense_clarification": "指组织中的领导群体"
                            },
                            {
                                "target_lang_word": "领导班子",
                                "target_lang_sense_clarification": "指特定的管理团队"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d53f546b-d851-3bf0-9094-74a86c44e8a3",
                    "sense_definition": "The position or state of being a leader.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization grew rapidly under the <w>leadership</w> of its founder.",
                            "target_lang_translations": {
                                "ru": "Организация стремительно росла под <w>руководством</w> своего основателя.",
                                "zh": "在该组织创始人的<w>领导</w>下，组织发展迅速。"
                            }
                        },
                        {
                            "text": "He is challenging his rival for the <w>leadership</w> of the political party.",
                            "target_lang_translations": {
                                "ru": "Он бросает вызов своему сопернику в борьбе за <w>лидерство</w> в политической партии.",
                                "zh": "他正在向对手发起挑战，争夺该政党的<w>领导</w>权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "command",
                        "headship",
                        "control"
                    ],
                    "common_phrases": [
                        "under the leadership of",
                        "assume leadership",
                        "take over the leadership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Положение или состояние лидера; процесс управления.",
                        "zh": "作为领导者的职位或状态，或指代管理的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "процесс управления кем-либо"
                            },
                            {
                                "target_lang_word": "лидерство",
                                "target_lang_sense_clarification": "положение главы или лидера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领导",
                                "target_lang_sense_clarification": "指管理或统领的状态"
                            },
                            {
                                "target_lang_word": "首领地位",
                                "target_lang_sense_clarification": "指处于领导者的位置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}