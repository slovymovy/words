                    "sense_id": "854eab8b-a718-30bd-b1c2-33ae03ac8013",
                    "sense_definition": "werk of andere activiteit staken om het lichaam in staat te stellen weer op krachten te komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontspanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tante Nella is in haar slaapkamer aan het <w>rusten</w>.",
