                                        "entry_id": "33d0e58a-e287-34fd-bb6d-eae00747aaea",
                                        "glosses": [
                                            "een vrij zware fractie alkanen die met name als vliegtuigbrandstof gebruikt wordt"
                                        ],
                                        "tags": [],
