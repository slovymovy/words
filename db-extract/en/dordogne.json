                                        "entry_id": "8612963f-5705-32f3-9c14-25e972fef448",
                                        "glosses": [
                                            "Département français de la région administrative Nouvelle-Aquitaine, qui porte le numéro 24."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "875a9391-6df6-4806-915b-8e34de16836d",
                                                "sense_id": "f42df8b2-8e27-332e-a4ec-64aed6cbb420",
                                                "text": "Notre-Dame de Boschaud est l’une des quatre abbayes cisterciennes de Dordogne."
                                            },
                                            {
                                                "example_id": "4a323700-1acf-448a-8b57-ab10c6e7588d",
                                                "sense_id": "f42df8b2-8e27-332e-a4ec-64aed6cbb420",
                                                "text": "En Dordogne, près de 300 enfants étaient scolarisés en instruction en famille (IEF) en septembre 2021."
                                            },
                                            {
                                                "example_id": "dc17949f-5747-4622-9b8c-3535cb9b5cf6",
                                                "sense_id": "f42df8b2-8e27-332e-a4ec-64aed6cbb420",
                                                "text": "Un habitant de Saint-Germain-et-Mons (Dordogne) a récolté une patate douce de 12 kg, informe France Bleu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a16aba64-ef35-3b9b-8f58-02fec35b3d59",
                                        "entry_id": "8612963f-5705-32f3-9c14-25e972fef448",
                                        "glosses": [
                                            "Rivière ou fleuve ^([1]) prenant naissance au Puy de Sancy dans la chaîne des Monts Dore."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eea4214-cbf9-4b83-a941-58fdee09716b",
                                                "sense_id": "a16aba64-ef35-3b9b-8f58-02fec35b3d59",
                                                "text": "Il levait en outre, sur le port de Bordeaux, un impôt dont une ordonnance ancienne nous conservait les détails : un fagot, ou un faisonnat, ou une buche, sur chaque bateau de bois à brûler venant de Langon ou de la rivière de Dordogne; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea69134-d245-372f-ac48-4b90a0634566",
                                        "entry_id": "8612963f-5705-32f3-9c14-25e972fef448",
                                        "glosses": [
                                            "Petit cours d’eau, affluent de la Canche, dans le département du Pas-de-Calais."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
