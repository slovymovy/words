                "senses": [
                    {
                        "sense_id": "a7942b53-0088-3036-81d0-d2a6f3a1a8c1",
                        "entry_id": "57de3794-26bd-36c3-9a79-c888d8674516",
                        "glosses": [
                            "Remettre dans l’état initial, faire revenir à l’état naturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "696b4808-5dde-4a22-b573-e4b345f7ff7f",
                                "sense_id": "a7942b53-0088-3036-81d0-d2a6f3a1a8c1",
                                "text": "Le fait est qu’en matière de zones humides à « renaturer », les gravières sont diversement traitées."
                            },
                            {
                                "example_id": "db6fd895-fd35-45d8-989a-d94adf6d9cec",
                                "sense_id": "a7942b53-0088-3036-81d0-d2a6f3a1a8c1",
                                "text": "Enfin, pour éviter de nouvelles conséquences dramatiques, certaines communes ont racheté des terrains pour « déconstruire » et « renaturer »."
                            }
                        ]
                    }
