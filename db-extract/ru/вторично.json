                                            {
                                                "example_id": "42d6ba80-3730-4e58-8bdb-a60537eec3d1",
                                                "sense_id": "1ca7e4ff-c31f-3d43-ae98-89f3ae1a7a49",
                                                "text": "Sonra masaya oturarak mikroskopla bir müddet çalışır, tekrar notlara bakar."
