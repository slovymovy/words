                        "target_lang_word": "intériorisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intériorisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad13ec7-39c5-3109-ad0b-b1d79d26b4df",
                                        "entry_id": "ea908a61-4f00-38da-b4a7-090bdf6ebe86",
                                        "glosses": [
                                            "Action d’intérioriser."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d8a447-2b2e-4ab5-8d2e-d560832c7e8d",
                                                "sense_id": "3ad13ec7-39c5-3109-ad0b-b1d79d26b4df",
                                                "text": "Le mouvement de l’esprit […] s’oriente vers ce que j’appellerai l’élimination du causal pur, c’est-à-dire l’assimilation, l’intériorisation de ce qui en lui reste nature."
                                            },
                                            {
                                                "example_id": "54ffeeaa-5e0f-498b-897d-a71a502c24a7",
                                                "sense_id": "3ad13ec7-39c5-3109-ad0b-b1d79d26b4df",
                                                "text": "L’injustifiabilité n’est pas seulement la reconnaissance subjective de la contingence absolue de notre être, mais encore celle de l’intériorisation et de la reprise à notre compte de cette contingence."
                                            },
                                            {
                                                "example_id": "963f46b9-88a6-4e5a-b6b2-9f4d653600b2",
                                                "sense_id": "3ad13ec7-39c5-3109-ad0b-b1d79d26b4df",
                                                "text": "La nuit à Varennes-en-Argonne (Meuse) serait noire, sans étoile, le noir de Pierre Soulages, violent, autoritaire, couleur et non-couleur, propice à l’intériorisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1261fdb3-bef1-3a86-b177-7217e04175d9",
                                        "entry_id": "ea908a61-4f00-38da-b4a7-090bdf6ebe86",
                                        "glosses": [
                                            "Repli de l’individu sur lui-même, pouvant atteindre parfois un caractère pathologique, autisme, introjection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f97053-6dda-4665-b3f5-3b712f1e4130",
                                                "sense_id": "1261fdb3-bef1-3a86-b177-7217e04175d9",
                                                "text": "En toute rigueur, les processus de fuite du réel n’ont rien à voir avec les processus d’intériorisation. À tel point que souvent ils sont une fuite devant la réalité intérieure tout aussi bien que devant la réalité extérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
