                "senses": [
                    {
                        "sense_id": "46fb8a93-4069-3c4b-85ab-0d6cd4077dbd",
                        "entry_id": "57fa382f-bea2-3662-8966-44cfbe7e0bf4",
                        "glosses": [
                            "Polyeder, das durch Abstumpfung der Ecken eines Ikosaeders entsteht"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "a217b00b-18bc-4f0e-aa38-59c377ac19f1",
                                "sense_id": "46fb8a93-4069-3c4b-85ab-0d6cd4077dbd",
                                "text": "„Dabei gab es andere Ansätze als diesen so genannten Ikosaederstumpf: Unregelmäßige Formen, aber auch lang gestreckte Stücke wurden schon zusammengenäht, um einen Fußball zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdd310ff-98ae-460b-bf3c-29eea1f29dfc",
                        "source_entry_id": "57fa382f-bea2-3662-8966-44cfbe7e0bf4",
                        "source_sense_id": "46fb8a93-4069-3c4b-85ab-0d6cd4077dbd",
                        "source_sense_description": "Geometrie: Polyeder, das durch Abstumpfung der Ecken eines Ikosaeders entsteht",
                        "target_lang_word": "truncated icosahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "truncated icosahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                        "entry_id": "9f9a35fc-dbee-3ca6-b095-494eec957d71",
                                        "glosses": [
                                            "A polyhedron that has thirty-two faces (12 regular pentagons and 20 regular hexagons) and 60 vertices and 90 edges, and is one of the Archimedean solids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad6aee5-1d66-41a8-a700-73dcf1041174",
                                                "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                                "text": "A truncated icosahedron may be formed by truncating the vertices of an icosahedron. Each vertex of the icosahedron is replaced by a pentagonal face and each triangular face of the icosahedron is replaced by a hexagonal face, which is inscribed inside the triangular face of the original icosahedron. The entire resulting truncated icosahedron is thus fittingly inscribed inside the original icosahedron."
                                            },
                                            {
                                                "example_id": "dd030088-3a4d-4d35-ac8c-86723e7863b7",
                                                "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                                "text": "This is the truncated icosahedron. Where the five triangles meet to form a vertex is now a pentagon, and a hexagon now replaces each triangular face. Therefore, the truncated icosahedron is composed of twelve pentagons and twenty hexagons."
                                            },
                                            {
                                                "example_id": "e35e305e-5aeb-40d6-911f-41d5cd4ec237",
                                                "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                                "text": "In addition to the 20 lithium atoms in layer b, additional lithium atoms (layer e) are located above the twelve pentagonal faces of the peripheral truncated icosahedra which, because of the way that the truncated icosahedra are linked, simultaneously cap the pentagonal faces of two adjacent truncated icosahedra sharing an edge (sharing method 1 above)."
                                            },
                                            {
                                                "example_id": "383230c0-b2e9-4896-8d87-5dc22d7d08e2",
                                                "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                                "text": "Fullerenes are truncated icosahedrons with 90 edges of equal length, 60 vertices, 20 hexagonal faces, and 12 pentagonal faces that form a closed shell."
                                            },
                                            {
                                                "example_id": "85335bb7-e7b6-4331-9663-27773a9755f4",
                                                "sense_id": "f67261d3-ffcd-35a4-88da-e40057fc32b8",
                                                "text": "2008, Jill Vincent, Andy Edwards, David Tynan, Gloria Stillman (editors), MathsWorld Year Eight for Queensland, Teacher Edition, page 308,\nDo you know which sport is played with a truncated icosahedron?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
