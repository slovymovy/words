            "senses": [
                {
                    "sense_id": "1bfd6210-fb0f-3bb4-93e4-4334068e581b",
                    "sense_definition": "Causing fear or anxiety.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fear_causing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She covered her eyes during the <w>scary</w> movie because she was afraid.",
                            "target_lang_translations": {
                                "ru": "Она закрыла глаза во время <w>страшного</w> фильма, потому что испугалась.",
                                "de": "Sie hielt sich während des <w>unheimlichen</w> Films die Augen zu, weil sie Angst hatte.",
                                "fr": "Elle s'est caché les yeux pendant le film d'<w>horreur</w> parce qu'elle avait peur.",
                                "nl": "Ze bedekte haar ogen tijdens de <w>enge</w> film omdat ze bang was."
                            }
                        },
                        {
                            "text": "The tiger's jaws were <w>scary</w> when it opened its mouth to roar.",
                            "target_lang_translations": {
                                "ru": "Челюсти тигра были <w>жуткими</w>, когда он открыл пасть, чтобы зарычать.",
                                "de": "Das Gebiss des Tigers war <w>furchterregend</w>, als er sein Maul zum Brüllen öffnete.",
                                "fr": "Les mâchoires du tigre étaient <w>effrayantes</w> lorsqu'il ouvrait la gueule pour rugir.",
                                "nl": "De kaken van de tijger waren <w>angstaanjagend</w> toen hij zijn bek opende om te brullen."
                            }
                        }
                    ],
                    "synonyms": [
