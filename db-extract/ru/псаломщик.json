                                                "example_id": "8815c592-baec-483f-b9f6-9e2834f74709",
                                                "sense_id": "c124f243-8ae5-35dd-ac23-31d232d84a18",
                                                "text": "an early reader, a talented reader"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4038770-4f80-3575-b762-92da6bc69edd",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A person who reads a publication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf134c5-cfd3-483f-a7ab-47f24dff47b3",
                                                "sense_id": "f4038770-4f80-3575-b762-92da6bc69edd",
                                                "text": "10,000 weekly readers"
                                            },
                                            {
                                                "example_id": "4e1dff1e-7478-4f85-8af9-c82f44fdc95d",
                                                "sense_id": "f4038770-4f80-3575-b762-92da6bc69edd",
                                                "text": "In its May 1965 issue, Life magazine condemned skateboards as a “menace to limb and even to life,” and cautioned readers about riders who “take over the paths made for peaceful strollers.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bef6ced-49c8-3d0b-a109-d7d8f818d066",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A person who recites literary works, usually to an audience."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cb17098-53f1-3924-b1ab-a87c437560e3",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A proofreader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a504213d-e729-35d3-a6b1-3d7dbeb7623e",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A person employed by a publisher to read works submitted for publication and determine their merits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6132a608-40d5-452c-bc34-c343a1ddee9d",
                                                "sense_id": "a504213d-e729-35d3-a6b1-3d7dbeb7623e",
                                                "text": "They were dog-eared by the hands of many a publisher's-reader and postman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0a2613-176a-3e62-9851-ac1f44786a8a",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A position attached to aristocracy, or to the wealthy, with the task of reading aloud, often in a foreign language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab8f335-1a01-4923-ab6c-9b814c4de7c6",
                                                "sense_id": "ba0a2613-176a-3e62-9851-ac1f44786a8a",
                                                "text": "\"I am commissioned by the Queen to offer you the place of Italian reader; and I assure you the offer was made with many kind expressions of interest. You will enter upon the duties, which are almost nominal, immediately.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6917c91e-f0e5-375d-a8a5-b3a18b9aff24",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A university lecturer ranking below a professor."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "89d47619-3211-3fe2-a406-d52582dbf040",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "Any device that reads something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "268e38f9-6a1e-4e13-ac57-6f9e3ee8866b",
                                                "sense_id": "89d47619-3211-3fe2-a406-d52582dbf040",
                                                "text": "a card reader, a microfilm reader"
                                            },
                                            {
                                                "example_id": "f5a629ce-d73b-4647-bdc7-3d478367415a",
                                                "sense_id": "89d47619-3211-3fe2-a406-d52582dbf040",
                                                "text": "The reMarkable PDF reader is really targeted at the digital writing market, rather than the digital reading market, though most serious e-readers support pens for annotations and signatures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf7088a3-2825-3ae4-a939-537a41014522",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A book of exercises to accompany a textbook."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35049962-af7e-3378-a4c1-33013ac69bba",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "An elementary textbook for those learning to read, especially for foreign languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b935c78-4c60-4c07-b241-295624df8ef3",
                                                "sense_id": "35049962-af7e-3378-a4c1-33013ac69bba",
                                                "text": "Appletons’ School Readers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da138880-9f34-3603-83ec-39c210a1d6c3",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A literary anthology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a6f1880-a991-4e40-a967-47384e91943d",
                                                "sense_id": "da138880-9f34-3603-83ec-39c210a1d6c3",
                                                "text": "A good bedtime reader should entertain and delight, and that's what I find in Girard Kent's The Boy Harleqin ^([sic]) and Other Stories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c87a5a9c-e86a-35aa-8af4-a773f624277f",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A lay or minor cleric who reads lessons in a church service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf396ceb-ee15-33d0-b96c-d7140f2bf488",
                                        "entry_id": "8ffc8414-89b7-362b-beae-5495642c9365",
                                        "glosses": [
                                            "A newspaper advertisement designed to look like a news article rather than a commercial solicitation."
                                        ],
