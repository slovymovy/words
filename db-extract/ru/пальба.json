                "senses": [
                    {
                        "sense_id": "fae3be33-ce56-3da4-a231-eb7ea4072391",
                        "entry_id": "45b3a692-5a5d-3af2-acf1-2950105d4433",
                        "glosses": [
                            "стрельба из огнестрельного оружия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbd6227-a5df-486f-8032-4c3f535a842d",
                                "sense_id": "fae3be33-ce56-3da4-a231-eb7ea4072391",
                                "text": "И Нева пальбой тяжёлой далеко потрясена."
                            },
                            {
                                "example_id": "6c1eb5e1-87d2-4789-bf0f-a1466942e314",
                                "sense_id": "fae3be33-ce56-3da4-a231-eb7ea4072391",
                                "text": "Он отступил, отбитый сильной пальбою."
                            }
                        ]
                    },
                    {
                        "sense_id": "b51a2a2b-56f6-3de1-9aea-21d0d10a81d0",
                        "entry_id": "45b3a692-5a5d-3af2-acf1-2950105d4433",
                        "glosses": [
                            "громкий звук, издающийся при стрельбе из огнестрельного оружия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a737039-67d3-4d52-805f-ea000c67bc8c",
                                "sense_id": "b51a2a2b-56f6-3de1-9aea-21d0d10a81d0",
                                "text": "Когда подходили к острову Святой Мавры, услыхали непрерывную пушечную пальбу: Сенявин продолжал осаду крепости."
                            }
                        ]
                    }
