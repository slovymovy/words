                        "glosses": [
                            "Qui pratique la corruption à grande échelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c539f4e6-3156-4937-922c-c3379f011197",
                                "sense_id": "52940e04-f084-3616-bf6b-92882baf80a7",
                                "text": "La candidate d’extrême droite dit partager la vision du monde de Vladimir Poutine, la vision du monde de celui qui enferme ses opposants, quand il ne les fait pas assassiner, d’un président cleptocrate qui, comme on l’a vu ce week-end, réprime les manifestations de ceux qui dénoncent la corruption."
                            }
                        ]
                    }
