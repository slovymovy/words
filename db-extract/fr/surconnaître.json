                ],
                "senses": [
                    {
                        "sense_id": "02cdd338-ff83-368a-8dfa-527c6d03f6e8",
                        "entry_id": "787346bb-ae13-3f0d-85d3-d0399a35d702",
                        "glosses": [
                            "Connaître particulièrement bien, plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a608e4d6-6989-4467-8282-9119b1614006",
                                "sense_id": "02cdd338-ff83-368a-8dfa-527c6d03f6e8",
                                "text": "Bon, eh bien t’as beau me connaître, reconnaître, surconnaître, tu devineras jamais !"
                            },
                            {
                                "example_id": "0a1f8ea2-62ef-4c5f-819d-f66b0c2e7322",
                                "sense_id": "02cdd338-ff83-368a-8dfa-527c6d03f6e8",
                                "text": "L’acteur ne peut pas hésiter, il fallait trouver une manière de parler, il fallait surconnaître son texte pour pallier toute modification inattendue pendant le tournage."
                            },
                            {
                                "example_id": "d32da758-03c2-4385-be8d-dd9900999afc",
                                "sense_id": "02cdd338-ff83-368a-8dfa-527c6d03f6e8",
                                "text": "Quel est l’intérêt de cette recette ??? Tout le monde la connaît et la surconnaît, et aucune minuscule variante n’est présente dans la présente…"
                            }
                        ]
                    }
                ],
