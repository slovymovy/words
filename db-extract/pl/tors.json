                        ]
                    },
                    {
                        "translation_id": "64450143-a2ee-4899-ad32-6e657ecb8fe5",
                        "source_entry_id": "242cf3b1-815b-3555-90e5-2e5db52fa580",
                        "source_sense_id": "09a6427d-365b-36b0-8127-8c4c9908287f",
                        "target_lang_word": "торс",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "торс",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f4d9e43a-7d05-3b85-9a5c-0a58aadf1ae2",
                                        "entry_id": "7f12d82f-4a19-38ae-bce1-cda14e040fde",
                                        "glosses": [
                                            "туловище человека, а также скульптурное изображение туловища"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde231e6-c9a7-496a-b311-4385189b4b9c",
                                                "sense_id": "f4d9e43a-7d05-3b85-9a5c-0a58aadf1ae2",
                                                "text": "Барби видел ещё одну ногу (в штанине от зелёных слаксов) и женский торс, угодивший в куст можжевельника."
                                            },
                                            {
                                                "example_id": "765b38d3-148e-4e29-a30c-4dcafeffd1da",
                                                "sense_id": "f4d9e43a-7d05-3b85-9a5c-0a58aadf1ae2",
                                                "text": "Тут нет ничего обидного для художника: почти из одной и той же глины делается «печной горшок» и торс Бельведерского Аполлона."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "905b1951-91fa-4408-bd60-85c02d42ea57",
                        "source_entry_id": "242cf3b1-815b-3555-90e5-2e5db52fa580",
                        "target_lang_word": "torse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1150147b-025c-3cf8-b386-23085dd1e5a4",
                                        "entry_id": "9d24f836-ca66-3438-98cc-79d84aa6614f",
                                        "glosses": [
                                            "Partie du corps humain qui s’étend depuis le cou jusqu’à la base du ventre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c922dd16-17de-4973-afd8-f6f0470910a1",
                                                "sense_id": "1150147b-025c-3cf8-b386-23085dd1e5a4",
                                                "text": "Il avait une cravache à la main, des houseaux aux jambes ; une jaquette courte faisait saillir son torse vigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "723a31b3-9567-3c8d-adf0-18367dd14276",
                                        "entry_id": "9d24f836-ca66-3438-98cc-79d84aa6614f",
                                        "glosses": [
                                            "Tronc ou buste d’une personne vivante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b1d47a-ecc6-4cab-9b5e-beed8df61390",
                                                "sense_id": "723a31b3-9567-3c8d-adf0-18367dd14276",
                                                "text": "Les femmes, très coquettes, revêtent en général le costume traditionnel ; la petite veste très serrée moulant le torse et les bras, passe dans la ceinture d'une culotte flottante."
                                            },
                                            {
                                                "example_id": "d29eb374-a8cb-4c2a-b115-f9e3cff21436",
                                                "sense_id": "723a31b3-9567-3c8d-adf0-18367dd14276",
                                                "text": "Le torse moulé par un chandail et chaussées de sabots, elles attendaient, près de fritureries en plein vent, leurs clients attitrés."
                                            },
                                            {
                                                "example_id": "c88c495b-a5c4-4f53-9308-02c2cbe2657b",
                                                "sense_id": "723a31b3-9567-3c8d-adf0-18367dd14276",
                                                "text": "Au fur et à mesure que nous approchions de Narbonne ce vent du sud devint gras et mouillé. Les rênes collaient, les chausses péguaient, le visage et le torse étaient humides. C'était le vent de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dabf87e0-7836-3d6e-8d8c-8ce73b38efc5",
                                        "entry_id": "9d24f836-ca66-3438-98cc-79d84aa6614f",
                                        "glosses": [
                                            "Tronc, d’une statue ou corps sans tête et sans membres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86318cd3-fc11-4dbc-abf1-7969bb41aabc",
                                                "sense_id": "dabf87e0-7836-3d6e-8d8c-8ce73b38efc5",
                                                "text": "Le torse du Belvédère au Vatican."
                                            },
                                            {
                                                "example_id": "0737b44b-878e-41ce-9c00-19f4720d591f",
                                                "sense_id": "dabf87e0-7836-3d6e-8d8c-8ce73b38efc5",
                                                "text": "Le torse de la Vénus de Milo est admirable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72570845-d637-36a7-a7aa-19c9183e8c6d",
                                        "entry_id": "9d24f836-ca66-3438-98cc-79d84aa6614f",
                                        "glosses": [
                                            "Quelqu’un dont l’apparence physique prime les compétences."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab655ad8-87c9-4c24-b284-2f98cd4cdde0",
                                                "sense_id": "72570845-d637-36a7-a7aa-19c9183e8c6d",
                                                "text": "Ce ne sont pas des cliniciens, ce ne sont pas des thérapeutes, ce sont des torses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab3ac48-856c-33ad-bfb7-4d1e87be9797",
                                        "entry_id": "7a807cdf-566c-300f-8e23-af944ec93beb",
                                        "glosses": [
                                            "Outil servant à fabriquer des colonnes torses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82d85f35-9db4-3662-abe8-b99f9fa8e787",
                                        "entry_id": "7a807cdf-566c-300f-8e23-af944ec93beb",
                                        "glosses": [
                                            "Tarière de charpentier à double filet hélicoïdal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "torse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                        "entry_id": "b6590162-e588-3558-97b2-65621353d1ad",
                                        "glosses": [
                                            "Féminin singulier de tors."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eef66f30-783f-4095-8bc5-f25332ae32f5",
                                                "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                                "text": "Tout ce qu’ils aimaient de l’Italie, les grandes fenêtres ouvertes sur la lumière, les colonnades torses des balcons, l’ornementation à l’antique des façades, était acquis comme de grasses prébendes à cet ignoble de Griffes."
                                            },
                                            {
                                                "example_id": "43c1745e-47ec-49e6-ae1b-8fb422dac271",
                                                "sense_id": "da481aa0-0d24-3ed2-855f-0cf019f4af71",
                                                "text": "Louie avait une jambe torse, Perrine un œil aveugle, et Noé, à huit ans, faisait la taille d’un enfant de cinq ans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "578dae11-366b-39db-865a-19580709eaa3",
                                        "entry_id": "97fdd7d7-188c-3896-8daa-b7d6f959c4f2",
