                "senses": [
                    {
                        "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                        "entry_id": "28ce34ea-1194-37ea-bc1d-5c15fd62de17",
                        "glosses": [
                            "Kakaogetränk mit Schlagsahne und einem Schuss Rum, Weinbrand oder einem ähnlichen alkoholischen Getränk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c0bf32-9b56-4f7a-8346-3b05a38fc64a",
                                "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                                "text": "„Schokolade, Rum, Sahne: fertig ist der Lumumba, ein beliebtes Getränk auf dem Weihnachtsmarkt.“"
                            },
                            {
                                "example_id": "589f2164-be96-4c46-8038-5df8265cd56b",
                                "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                                "text": "„Nicht nur die verschiedensten Glühweinsorten, Punsche und Feuerzangenbohlen, sondern eben auch den \"Lumumba\", eine heiße Schokolade mit Rum, die im Moment Schlagzeilen schreibt.“"
                            },
                            {
                                "example_id": "a5e020fd-ad6c-442e-ab8f-eba67221ccce",
                                "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                                "text": "„Auch an „Rupperts Almhütte“ ist der Lumumba im Ausschank und findet dort laut Betreiber Konrad Ruppert stets regen Absatz.“"
                            },
                            {
                                "example_id": "ab0e2554-ae50-47b1-b87d-1a61ad4c8a73",
                                "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                                "text": "„Im nahegelegenen Adventsdorf im Domumfeld wurde der Lumumba dagegen zum Start noch verkauft, mittlerweile ist das Schild laut einem Bericht des \"Express\" überklebt.“"
                            },
                            {
                                "example_id": "6dd36576-30e6-4c93-94f9-c5d35e14563e",
                                "sense_id": "8c78e4da-9efb-3f72-8d25-95cc5c277893",
                                "text": "„Eine Namensänderung für alle Stände, die Lumumba ausschenken, hat es trotz der Debatte auf dem Düsseldorfer Weihnachtmarkt nicht gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
