                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai beau me <w>creuser</w> la tête depuis ce matin, je ne trouve pas la solution."
