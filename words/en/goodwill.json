{
    "word_family": [
        "good",
        "will"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf0ed43c-580c-3208-9c50-e8c589adc2f7",
                    "sense_definition": "A friendly, helpful, or kind attitude toward someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company aims to build <w>goodwill</w> within the local community through charity work.",
                            "target_lang_translations": {
                                "ru": "Компания стремится завоевать <w>доброжелательное отношение</w> местного сообщества посредством благотворительности."
                            }
                        },
                        {
                            "text": "He showed great <w>goodwill</w> by helping his neighbor fix the broken fence.",
                            "target_lang_translations": {
                                "ru": "Он проявил большую <w>добрую волю</w>, помог соседу починить сломанный забор."
                            }
                        }
                    ],
                    "synonyms": [
                        "kindness",
                        "benevolence"
                    ],
                    "antonyms": [
                        "ill will"
                    ],
                    "common_phrases": [
                        "gesture of goodwill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружелюбное, отзывчивое или доброе отношение к кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добрая воля",
                                "target_lang_sense_clarification": "искреннее желание помочь или пойти навстречу"
                            },
                            {
                                "target_lang_word": "доброжелательность",
                                "target_lang_sense_clarification": "доброе отношение к людям"
                            },
                            {
                                "target_lang_word": "благосклонность",
                                "target_lang_sense_clarification": "расположение, симпатия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222f3f8b-775a-382b-bbca-7b16f053b7be",
                    "sense_definition": "The intangible value of a business, such as its reputation and customer loyalty, beyond its physical assets.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The purchase price included a significant amount for the company's <w>goodwill</w>.",
                            "target_lang_translations": {
                                "ru": "Цена покупки включала значительную сумму за <w>деловую репутацию</w> компании."
                            }
                        },
                        {
                            "text": "Strong brand recognition is a key factor in calculating the <w>goodwill</w> of a successful firm.",
                            "target_lang_translations": {
                                "ru": "Высокая узнаваемость бренда является ключевым фактором при расчете <w>гудвилла</w> успешной фирмы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "business goodwill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нематериальная ценность бизнеса (репутация, клиентская база, бренд), превышающая стоимость его физических активов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деловая репутация",
                                "target_lang_sense_clarification": "в бухгалтерском учете и бизнесе"
                            },
                            {
                                "target_lang_word": "гудвилл",
                                "target_lang_sense_clarification": "экономический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91b7dd84-1c1e-3d13-8c47-173c5fef3834",
                    "sense_definition": "The extra effort or cooperation provided by an employee beyond what is strictly required by their contract.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was completed on time only because of the <w>goodwill</w> of the staff.",
                            "target_lang_translations": {
                                "ru": "Проект был завершен вовремя только благодаря <w>доброй воле</w> сотрудников."
                            }
                        },
                        {
                            "text": "Employees may choose to withdraw their <w>goodwill</w> during labor disputes.",
                            "target_lang_translations": {
                                "ru": "Сотрудники могут отказаться от <w>работы сверх обязанностей</w> во время трудовых споров."
                            }
                        }
                    ],
                    "common_phrases": [
                        "withdraw goodwill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовность сотрудника прикладывать дополнительные усилия или сотрудничать сверх требований трудового договора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добрая воля",
                                "target_lang_sense_clarification": "добровольное содействие сотрудников"
                            },
                            {
                                "target_lang_word": "энтузиазм",
                                "target_lang_sense_clarification": "инициативность сверх обязанностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4932f2fe-fdcc-30e8-8d6a-d59c00718320",
                    "sense_definition": "A charitable organization or thrift shop that sells donated goods.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found a vintage jacket while shopping at <w>Goodwill</w>.",
                            "target_lang_translations": {
                                "ru": "Она нашла винтажную куртку во время покупок в «<w>Гудвилле</w>»."
                            }
                        },
                        {
                            "text": "We donated our old clothes to <w>Goodwill</w> to help those in need.",
                            "target_lang_translations": {
                                "ru": "Мы пожертвовали свою старую одежду в «<w>Гудвилл</w>», чтобы помочь нуждающимся."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrift shop"
                    ],
                    "target_lang_definitions": {
                        "ru": "Благотворительная организация или секонд-хенд, продающий пожертвованные вещи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гудвилл",
                                "target_lang_sense_clarification": "название благотворительной сети"
                            },
                            {
                                "target_lang_word": "благотворительный магазин",
                                "target_lang_sense_clarification": "тип магазина секонд-хенд"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1e5c6739-4b7f-3122-be17-a1a9ae7344ed",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Goodwill</w> family has lived in this town for three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Гудвилл</w> живет в этом городе уже три поколения."
                            }
                        },
                        {
                            "text": "Mr. <w>Goodwill</w> is the new manager of the local library.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Гудвилл</w> — новый заведующий местной библиотекой."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Гудвилл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}