                "senses": [
                    {
                        "sense_id": "2fc88def-e355-3796-ae1e-561cb9a83ebb",
                        "entry_id": "b653c8d7-4f55-3f2f-b646-5839ab1059f0",
                        "glosses": [
                            "Rundschreiben eines Bischofs (oder des Papstes) an die Gläubigen (seines Bistums) zu Glaubensfragen oder gesellschaftlichen Entwicklungen"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "dcaa8786-0a5d-4000-ab75-50b80a083ac1",
                                "sense_id": "2fc88def-e355-3796-ae1e-561cb9a83ebb",
                                "text": "Am ersten Fastensonntag wird der Hirtenbrief des Bischofs in allen Gottesdiensten verlesen."
                            },
                            {
                                "example_id": "b64ec48b-06f6-4c45-a99d-92282c1ad62e",
                                "sense_id": "2fc88def-e355-3796-ae1e-561cb9a83ebb",
                                "text": "„Der Papst hatte in seinem Hirtenbrief vom vergangenen Wochenende den \"schnelllebigen Wandel\" beklagt, den Moderne und Säkularisierung mit sich bringen.“"
                            },
                            {
                                "example_id": "6617174f-761d-4015-aa51-9e427653088e",
                                "sense_id": "2fc88def-e355-3796-ae1e-561cb9a83ebb",
                                "text": "„Er ließ Hirtenbriefe in den Kirchen verlesen, in denen er verlangte, für den Sieg Hitlers zu beten, ihm zu gehorchen und Gottes Schutz für ihn zu erflehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
