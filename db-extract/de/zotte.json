                "senses": [
                    {
                        "sense_id": "64b7bcb9-e3cb-3d7c-9a7f-154dc37e35e0",
                        "entry_id": "df461f90-d079-341d-92a1-0e89e5e2c423",
                        "glosses": [
                            "verfilztes Haar, einer Strähne, einem schmalen Zopf ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91971f66-1e64-47de-bf0a-a09f9dceeaca",
                                "sense_id": "64b7bcb9-e3cb-3d7c-9a7f-154dc37e35e0",
                                "text": "„Diese Haare sind meist zu dicken Zotten oder Schuppen miteinander verwachsen, die unregelmäßig verbogen sind.“"
                            },
                            {
                                "example_id": "ba2a082a-c785-4e0e-b2b2-712e4db03030",
                                "sense_id": "64b7bcb9-e3cb-3d7c-9a7f-154dc37e35e0",
                                "text": "Die Mähne hängt in dicken Zotten herab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5fc7932c-1420-3658-b57e-7bcbfbcc4f34",
                        "entry_id": "df461f90-d079-341d-92a1-0e89e5e2c423",
                        "glosses": [
                            "Ausbuchtung der Schleimhäute"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8761816-4b86-436e-af19-65ea5120f199",
                                "sense_id": "5fc7932c-1420-3658-b57e-7bcbfbcc4f34",
                                "text": "Die Dünndarmschleimhaut ist mit Zotten besetzt."
                            },
                            {
                                "example_id": "14d0c292-6965-4240-b441-aa0aceaeaa35",
                                "sense_id": "5fc7932c-1420-3658-b57e-7bcbfbcc4f34",
                                "text": "„Bis zum Ende der Embryonalperiode ist die Chorionblase vollständig von Zotten bedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
