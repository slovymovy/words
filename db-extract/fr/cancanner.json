                "senses": [
                    {
                        "sense_id": "6353b369-0e22-36a0-8222-9e8244f972c8",
                        "entry_id": "9dfd1eb8-279f-310d-833a-70a4d2f4a59c",
                        "glosses": [
                            "Variante de cancaner."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d9c8ea32-232d-4129-af32-7a2397c724ea",
                                "sense_id": "6353b369-0e22-36a0-8222-9e8244f972c8",
                                "text": "Bref, de notre cher quartier, Cancanner est le métier : Chefs, commis, fabricans, Ne vivent que de cancans. On cancanne en déjeûnant On recancanne en dinant, C’est cancan sur cancan, Qui finiront, Dieu sait quand !"
                            },
                            {
                                "example_id": "850bd4c5-bdf3-4346-8f7c-849f052dbf67",
                                "sense_id": "6353b369-0e22-36a0-8222-9e8244f972c8",
                                "text": "Comment, il s’en va je ne sais quelle heure, et la mère Badureau n’a pas montré le bout de son nez… elle aura passé sa journée à jacasser, à cancanner…"
                            }
                        ]
                    }
                ],
