                "senses": [
                    {
                        "sense_id": "44b52c36-a457-34f6-a0b8-2935398843fc",
                        "entry_id": "7d94a323-0a27-3c5e-b153-fb708ac6f613",
                        "glosses": [
                            "Donner un caractère isotrope à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35a2df2-52cd-4c3f-9c0e-40ee0679f385",
                                "sense_id": "44b52c36-a457-34f6-a0b8-2935398843fc",
                                "text": "En effet, la colle non suffisamment sèche a tendance à « anisotropiser » le comportement d’un matériau isotrope (Figure 86), et « isotropiser » le comportement d’une roche anisotrope (Figure 83)."
                            },
                            {
                                "example_id": "cadbbcbf-a597-4231-8813-5bf90a051cde",
                                "sense_id": "44b52c36-a457-34f6-a0b8-2935398843fc",
                                "text": "En fait, il n’a tout simplement pas le temps de le faire, le nombre d’oscillations depuis la singularité jusqu’aujourd’hui étant bien trop faible pour réussir à isotropiser quoi que ce soit."
                            }
                        ]
                    }
