        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4d2494fb-6b82-37f4-8eca-f894abe52aa3",
                "word": "defended",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "af32d191-a421-4f71-8c18-802b4a89bf40",
                        "entry_id": "4d2494fb-6b82-37f4-8eca-f894abe52aa3",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more defended"
                    },
                    {
                        "form_id": "3a25fc71-86e6-48d9-aebf-f1972ddbae4a",
                        "entry_id": "4d2494fb-6b82-37f4-8eca-f894abe52aa3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most defended"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f0888f6-864e-36ed-b993-dda6bbbdfd65",
                        "entry_id": "4d2494fb-6b82-37f4-8eca-f894abe52aa3",
                        "glosses": [
                            "Having defenses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5a249f9-5255-43c7-a775-3aa4a3261f64",
                                "sense_id": "7f0888f6-864e-36ed-b993-dda6bbbdfd65",
                                "text": "For example, in the boreal forest where browsing by hares in winter is an important source of mortality, the juvenile-phase is more defended chemically against browsing by hares in winter than is the conspecific mature-phase (Table 2)."
                            },
                            {
                                "example_id": "6523e5b1-8a9d-4327-978a-2ba77c90bcfa",
                                "sense_id": "7f0888f6-864e-36ed-b993-dda6bbbdfd65",
                                "text": "This result corroborates the Hypothesis 2 that the less defended fast-growing species can be replaced over time by more defended slower-growing species."
                            },
                            {
                                "example_id": "e3d85019-4cc8-47b0-9a36-416d50ed20b9",
                                "sense_id": "7f0888f6-864e-36ed-b993-dda6bbbdfd65",
                                "text": "Understandably, the more extreme the condition, the more defended the family and professionals can be."
                            }
                        ]
                    },
                    {
                        "sense_id": "c59d37d7-9a46-3617-b138-f8df7f24330b",
                        "entry_id": "4d2494fb-6b82-37f4-8eca-f894abe52aa3",
                        "glosses": [
                            "In which the defendant responds to the allegations made against them, typically by filing a defense or counterclaim in court."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1b68cb46-d448-47db-be50-c4cf501d5c5a",
                                "sense_id": "c59d37d7-9a46-3617-b138-f8df7f24330b",
                                "text": "If this simpler procedure were adopted in a defended case the cost would be about 29l. if counsel were employed, and about 27l. if no counsel or solicitor were employed."
                            },
                            {
                                "example_id": "9652fb8c-a62b-4228-ad0a-0c57d956cc55",
                                "sense_id": "c59d37d7-9a46-3617-b138-f8df7f24330b",
                                "text": "But only in less than 5% there was a court order in a defended case (Müller-Alten, 1984)."
                            },
                            {
                                "example_id": "61ce3a25-1e8d-48d6-bc24-f50c5072cecb",
                                "sense_id": "c59d37d7-9a46-3617-b138-f8df7f24330b",
                                "text": "The Court of Appeal used the case to make a strong call for the removal of fault-based grounds, arguably at the expense of deciding in Mrs Owens' favour, and openly acknowledged that a lower threshold for behaviour is used in undefended cases scrutinised by a legal adviser at a divorce centre rather than a judge in a court in a defended case."
                            }
                        ]
                    }
                ],
