                ],
                "senses": [
                    {
                        "sense_id": "12fe1de8-57b9-3e95-ad95-b486da8f36fc",
                        "entry_id": "a6fee826-25e4-3b7f-89f5-65a7300459ce",
                        "glosses": [
                            "door voortdurende ervaring gewoon en vertrouwd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c6fcba-a732-4535-8029-e3637c8cfd10",
                                "sense_id": "12fe1de8-57b9-3e95-ad95-b486da8f36fc",
                                "text": "Hij was eraan gewend dat vrouwen zich zo gedroegen bij hem: katachtig, flirterig, lichtzinnig soms."
                            },
                            {
                                "example_id": "94b5a140-03d7-4baf-9c0a-bf70b284327f",
                                "sense_id": "12fe1de8-57b9-3e95-ad95-b486da8f36fc",
                                "text": "„Neem het jaar 1815”, zegt hij enthousiast. „Concertbezoekers hadden heel andere verwachtingen van een concert. Ze waren gewend tijdens de muziek door de zaal te lopen. Als iets in de smaak viel, klapten ze – ook als het orkest nog aan het spelen was. En als ze iets slecht vonden, werd er gejoeld.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "58d024e8-b968-3325-9540-68d738acb285",
                        "entry_id": "a6fee826-25e4-3b7f-89f5-65a7300459ce",
                        "glosses": [
                            "aan een veranderde omstandigheid aangepast zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f65d996-dadd-4152-bb3c-21bc3c08bae9",
                                "sense_id": "58d024e8-b968-3325-9540-68d738acb285",
                                "text": "De ramen waren bedekt met stof en het was donker in de garage, het duurde even voordat onze ogen eraan gewend waren."
                            }
                        ]
                    }
                ],
