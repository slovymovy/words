                                        "sense_id": "0c90f5ef-be73-392d-a373-3de991a9c929",
                                        "entry_id": "c37dd4d7-bbcf-39a7-bf63-892f249fd476",
                                        "glosses": [
                                            "İran'ın en büyük şehri ve başkenti ayrıca Tahran Eyaleti'nin merkezi olan şehir."
                                        ],
                                        "tags": [
