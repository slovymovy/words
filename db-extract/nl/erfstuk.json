                                        "sense_id": "48e4b3a8-069e-3467-be4f-560b1a644194",
                                        "entry_id": "bdb8dc9a-9ae3-3b03-92d8-3dbbe50513e7",
                                        "glosses": [
                                            "dobra zachowane dla następnych pokoleń"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88d7e6d7-85bb-4748-b87b-4cc55461e3a7",
                                                "sense_id": "48e4b3a8-069e-3467-be4f-560b1a644194",
                                                "text": "\"Antropolodzy mają prawo twierdzić, że przyczynili się do zachowania kulturowego dziedzictwa społeczeństw, które badali, […]. Lecz prawdą jest również, iż mieli oni swój udział, czasem tylko pośredni, w utrzymywaniu struktur władzy reprezentowanych przez system kolonialny\"."
                                            },
                                            {
                                                "example_id": "9c741b06-cf40-44e4-a283-5d5c88a0176c",
                                                "sense_id": "48e4b3a8-069e-3467-be4f-560b1a644194",
                                                "text": "Dziedzictwo to było już wielokrotnie opisywane w literaturze przedmiotu, nie ma więc potrzeby ponawiania szczegółowego opisu tego zjawiska."
                                            },
                                            {
                                                "example_id": "c6bdbbcd-8017-46a9-a2ac-2b2d50e9eacb",
                                                "sense_id": "48e4b3a8-069e-3467-be4f-560b1a644194",
                                                "text": "Nie powinniśmy zapominać o naszym dziedzictwie kulturowym."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
