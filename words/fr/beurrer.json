                    "frequency": "High",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>beurrer</w> le moule avant de verser la pâte à gâteau."
                        },
                        {
                            "text": "J'aime <w>beurrer</w> mes tartines de pain frais chaque matin au petit-déjeuner."
                        }
