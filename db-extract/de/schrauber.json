                                "target_senses": [
                                    {
                                        "sense_id": "81597450-f532-3fe8-b01d-2bc7ce506fd0",
                                        "entry_id": "dee7224c-ed2d-3d7c-890d-e9584ad77771",
                                        "glosses": [
                                            "устройство для закручивания винтов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff57ec7-5ce3-40ba-8908-8052085f911f",
                                                "sense_id": "81597450-f532-3fe8-b01d-2bc7ce506fd0",
                                                "text": "Конструкторы завода создали несколько типов винто-гайковертов: универсальный винто-гайковерт, двухшпиндельный гайковерт и винтоверт с фиксированным положением собираемого узла."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3b6a76e-9700-4304-96c8-f81881c5f1f8",
                        "source_entry_id": "484cd881-f9eb-3768-9ec8-bededd5e9b46",
                        "source_sense_id": "9bead4a2-25dc-33a8-8a6d-4b75bba65453",
