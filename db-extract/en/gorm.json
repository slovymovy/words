                    {
                        "form_id": "96a4f8e1-285f-423b-af76-64296d078ebb",
                        "entry_id": "8afaea75-0e8a-32b8-916b-dae9f46bbc51",
                        "tags": [
                            "past"
                        ],
                        "form": "gormed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "458059a8-fc33-30f2-a4f3-1fdeeaa9605c",
                        "entry_id": "8afaea75-0e8a-32b8-916b-dae9f46bbc51",
                        "glosses": [
                            "Alternative form of gaum (“to smear”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "c3a1f96b-61ea-4b00-975e-602de7e273f2",
                                "sense_id": "458059a8-fc33-30f2-a4f3-1fdeeaa9605c",
                                "text": "'It is quite ruined.'\n'How did she do it? What a pity!'\n'With paint—assisting in the painting of a garden-gate. She told me the pleasure of \"gorming\" it on was too irresistible to be resisted; and the poor little new gown in done for.'"
                            },
                            {
                                "example_id": "f3606a52-ed8e-4287-94aa-f4341dcb2c63",
                                "sense_id": "458059a8-fc33-30f2-a4f3-1fdeeaa9605c",
                                "text": "\"It was in a little sprinkler bottle, an' I gormed it onto my vittles good an' thick. Lordy, Lordy, an' now I got to die!\""
                            },
                            {
                                "example_id": "d6f43225-056f-4fb7-a7cc-e2df3b709686",
                                "sense_id": "458059a8-fc33-30f2-a4f3-1fdeeaa9605c",
                                "text": "For quotations using this term, see Citations:gorm."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
