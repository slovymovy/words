                    {
                        "sense_id": "442c970c-5d3d-3486-97c3-105a58d139ae",
                        "entry_id": "e7e8a02c-77a9-3913-934a-41eb6f1865da",
                        "glosses": [
                            "Plante qui produit des graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f3f072-81c3-4fd6-8379-e834e5090b3f",
                                "sense_id": "442c970c-5d3d-3486-97c3-105a58d139ae",
                                "text": "(...) la botanique contemporaine ne rend pas justice à l'étonnante diversité biologique des graines, alors qu'elles sont l'élément principal de la nourriture des êtres humains, et que l'apparition des premières «Plantes à graines», ou Spermaphytes, correspond à un clivage évolutif majeur dans l'arbre généalogique des végétaux."
                            }
                        ]
