                "senses": [
                    {
                        "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                        "entry_id": "0167b17e-3699-3c2d-b2fd-85f412ad4f2a",
                        "glosses": [
                            "Einwohner der altrömischen Provinz Rätien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2981bf4-6f9b-4c7d-be3a-4fa70f2532cb",
                                "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                                "text": "Die Räter waren ein Volk oder eine Gruppe von Völkern der Antike im Bereich der mittleren Alpen, nach älteren Vorstellungen ungefähr zwischen dem Lago Maggiore, Como, Verona, dem Unterinntal und dem Bodensee."
                            },
                            {
                                "example_id": "bde660b4-c3e3-4133-b3d0-68e7fdce72ab",
                                "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                                "text": "Auf diese Räter treffen 15 v. Chr. die römischen Eroberer, an der Spitze die Stiefsohne des Kaisers Augustus, Drusus und Tiberius."
                            },
                            {
                                "example_id": "948bee68-bf4c-4098-b5ea-d460140449b6",
                                "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                                "text": "Denn zumindest ein kleiner Bergstamm aus dem Volk der Räter leistete den Eindringlingen tapfer Widerstand."
                            },
                            {
                                "example_id": "a13f09b9-7e57-4087-a863-b7109e4d6091",
                                "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                                "text": "Es ist allerdings nicht viel, was uns die antiken Geschichtsquellen über diese Räter zu berichten wissen."
                            },
                            {
                                "example_id": "9c18c2fa-8fcd-4fb5-80fc-71407c549fc4",
                                "sense_id": "b14ed19a-0314-31ef-90e3-4a7a3560b86a",
                                "text": "Livius hat die Räter als kriegerisches und räuberisches Volk dargestellt, das immer wieder in Oberitalien einfiel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
