                ],
                "senses": [
                    {
                        "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                        "entry_id": "bdce856d-e456-3839-87b7-d41ff77c2188",
                        "glosses": [
                            "Veränderung eines Produktes zu einem neuen Design und/oder zu neuen Features"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21867332-71f2-4958-90bf-27131714ce64",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "„Der „Prius“ wurde […] mit jedem Modellwechsel besser, inzwischen haben wir das Modell 4.“"
                            },
                            {
                                "example_id": "1f6fc805-b1a5-4bc7-ba7c-612525c6a978",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "„Der Konzern nannte als Grund für den geringeren Gewinn Absatzrückgänge bei S- und E-Klasse. […] Auch der Modellwechsel bei der E-Klasse wird zur Begründung für die Zahlen angeführt.“"
                            },
                            {
                                "example_id": "f34caa38-93ac-458c-aa87-819b1a6cd26b",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "Die „neue C-Klasse konkurriert [in China] mit dem Audi A4, bei dem im Herbst der Modellwechsel ansteht.“"
                            },
                            {
                                "example_id": "db1b4a09-190a-4867-8544-121f0051605b",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "„Getrieben war der Zuwachs vor allem vom Modellwechsel beim Kleinwagen Mini, dessen Absatz im März um fast 39 Prozent im Vergleich zum Vorjahresmonat in die Höhe schnellte.“"
                            },
                            {
                                "example_id": "d5a64bee-7925-4c9e-a9c6-4a5750765202",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "„Mit einem breiteren Fahrzeug kann es im Baustellenbereich schon eng werden. Denn bei nahezu jedem Modellwechsel erhöht sich auch die Breite von Fahrzeugen.“"
                            },
                            {
                                "example_id": "421bc2fe-47b3-43ef-ba1f-409a0cfb2aa5",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "„Für Autos mit Hybrid- und Erdgas-Antrieb würden derzeit gar keine Bestellungen angenommen, sagte ein Sprecher am Sonntag. Der Bestellstopp bei diesen Antriebsarten hängt VW zufolge allerdings auch mit Modellwechseln und technischen Umstellungen zusammen.“"
                            },
                            {
                                "example_id": "ecdce110-34ce-48e2-b122-755213a79afc",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "[Die] „zusätzlich benötigten Mitarbeiter für den Modellwechsel hatten einen befristeten Vertrag bis zum 31. Dezember, […].“"
                            },
                            {
                                "example_id": "c0c2bed9-fc0d-470c-a2ac-0d6c54cdb706",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "[DDR:] „Die Produkte mussten langlebig und reparaturfreundlich sein, weil es eben nicht diesen Modellwechsel gab wie heute.“"
                            },
                            {
                                "example_id": "779cb3df-8380-4275-8b6c-3cb476328e46",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "[Fahrräder:] „So werden etwa Altbestände, die nach Modellwechsel oft nur schwer abzusetzen sind, inzwischen vermehrt über das Internet verhökert.“"
                            },
                            {
                                "example_id": "8758d053-f099-4914-a27b-97e1d5059b7c",
                                "sense_id": "02e18cac-f46e-3fae-b734-408ead676c2d",
                                "text": "[Tim Cook] „ließ die Lagerbestände von Monaten auf Tage schmelzen. Das half Apple, bei dem schnellen Modellwechsel in der Elektronik-Branche keine Auslaufgeräte als Altlasten herumliegen zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                        "entry_id": "bdce856d-e456-3839-87b7-d41ff77c2188",
                        "glosses": [
                            "grundlegende Veränderung in der Berechnung, Verteilung oder Organisation von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc3aaa56-bbdf-4874-ad05-b32d468bc93c",
                                "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                                "text": "[Schlagzeile:] „Widerspruchslösung - Mehr Organe dank Modellwechsel?“"
                            },
                            {
                                "example_id": "a474163b-9721-4545-a527-ea4b74b60ce3",
                                "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                                "text": "„In den meisten Aargauer Gemeinden sind die Altersheime als gemeinnützigen Aktiengesellschaften organisiert. In Aarau werden die Alters- und Pflegeheime jedoch noch als Eigenwirtschaftsbetriebe geführt. Der Stadtrat prüft nun einen Modellwechsel.“"
                            },
                            {
                                "example_id": "7172e071-cee8-4425-a808-e46ea0f87fc0",
                                "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                                "text": "„Im ersten Jahr nach dem Modellwechsel zum geräteunabhängigen Rundfunkbeitrag weist der BR in der Wirtschaftsrechnung 2013 einen Fehlbetrag von 19,6 Millionen Euro aus.“"
                            },
                            {
                                "example_id": "83dcd1d1-1a1d-4bb6-9611-04fbf7fcfa6d",
                                "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                                "text": "[Rundfunkbeitrag 2019:] „Ein Modellwechsel scheint der Politik nun ziemlich riskant.“"
                            },
                            {
                                "example_id": "a6889539-6e74-4055-b8e3-f458fcce2095",
                                "sense_id": "eb8b21bd-1d2c-31da-b7ed-6e31ccad6439",
                                "text": "„Die Regierung begründete die Übergabe der wichtigsten Ausbildungsstätte für Theater- und Filmleute in Ungarn an die noch zu gründende staatliche „Stiftung für Theater- und Filmkunst“ mit der Notwendigkeit eines „Modellwechsels“.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
