                "senses": [
                    {
                        "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                        "entry_id": "cdfeced0-bb17-37d6-9111-6578999ae47f",
                        "glosses": [
                            "Anordnung/Vorschrift, die jemanden oder eine gesamte Personengruppe verpflichtet, in bestimmten Situationen eine Schutzmaske zu tragen (beispielsweise Atemschutzmasken in der Öffentlichkeit bei Gefährdung durch Krankheitskeime oder Giftstoffe, Schutzmasken für Schweißer beim Schweißen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d6fc3b-c7b3-4430-b4ca-0b978d67e847",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "Er missachtete die Schutzmaskenpflicht und musste ein Bußgeld zahlen."
                            },
                            {
                                "example_id": "d1fa7c24-f465-4466-b2fb-cc65aa66cb5d",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "„Aktuell versucht die chinesische Führung mit lokal begrenzten Maßnahmen, die Ausbreitung der Atemwegserkrankung aufzuhalten: In Provinzen und Städten mit insgesamt mehr als 300 Millionen Einwohnern gilt jetzt eine Schutzmaskenpflicht.“"
                            },
                            {
                                "example_id": "98c38ab4-f3c2-43fa-a88d-ddfc48a3fb65",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "„Tschechien und die Slowakei haben Schutzmaskenpflicht.“"
                            },
                            {
                                "example_id": "f9d49876-4a7c-4ee7-b784-9da6bdd99946",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "[Schlagzeile:] „Coronakrise in Deutschland – Kommt jetzt auch noch die Schutzmaskenpflicht?“"
                            },
                            {
                                "example_id": "16318010-6db1-4413-8a44-cbc6c203effd",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "[Österreich:] „Ab spätestens 6. April gilt die Schutzmaskenpflicht in heimischen Lebensmittelketten.“"
                            },
                            {
                                "example_id": "6d5d1df2-f834-4eea-9db7-195e8475299d",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "„Nach der Einführung einer Schutzmaskenpflicht in Supermärkten in Österreich wird auch in Deutschland über einen solchen Schritt diskutiert.“"
                            },
                            {
                                "example_id": "f8f69fb2-9046-4321-a688-3015b7839c1e",
                                "sense_id": "c719f282-8b31-3be6-9ea3-5821e47517ac",
                                "text": "„Nach der Ankündigung Österreichs, eine Schutzmaskenpflicht für Supermarkteinkäufer einzuführen, befürwortet der SPD-Gesundheitspolitiker Karl Lauterbach eine solche Regelung auch in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
