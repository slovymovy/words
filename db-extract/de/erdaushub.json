                ],
                "senses": [
                    {
                        "sense_id": "569c60af-bcd5-3a40-9709-8918ea4ffca4",
                        "entry_id": "14054eb7-5e5c-3e3c-804c-31b8b315e0ba",
                        "glosses": [
                            "Erdmaterial, das dem Boden entnommen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66312477-9621-418a-95f7-6d3e1a97370f",
                                "sense_id": "569c60af-bcd5-3a40-9709-8918ea4ffca4",
                                "text": "„Hinsichtlich seines Schadstoffgehaltes kann unbelasteter Erdaushub uneingeschränkt wiedereingebaut und unbelasteter Bauschutt unbeschränkt weiterverwertet werden.“"
                            },
                            {
                                "example_id": "d850abeb-99b7-401d-ab94-6bdf8380a816",
                                "sense_id": "569c60af-bcd5-3a40-9709-8918ea4ffca4",
                                "text": "„Der Kamin mußte wieder eingerissen werden, und dann hatten die Halsabschneider uns noch vierzig Kubikmeter Erdaushub zuviel berechnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "797410f1-a0f9-355e-84f3-1511d3916de7",
                        "entry_id": "14054eb7-5e5c-3e3c-804c-31b8b315e0ba",
                        "glosses": [
                            "Vorgang, in dem Erdmaterial dem Boden entnommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e76512-e11c-4414-9845-3ec95c57573c",
                                "sense_id": "797410f1-a0f9-355e-84f3-1511d3916de7",
                                "text": "„Permafrost führt nicht nur zu Materialverlagerungen in der Landschaft, er ist auch ein sehr schwer zu beherrschender Untergrund für Bauwerke. Beim Erdaushub für Bauten kann das Schmelzwasser nicht im gefrorenen Untergrund versickern.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
