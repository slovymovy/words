        "fr-extract.jsonl": [
            {
                "entry_id": "a73866f4-213c-3dbd-88ed-0b051682a6a8",
                "word": "exosphère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f04297d-a62e-4019-bd6b-6742753af512",
                        "entry_id": "a73866f4-213c-3dbd-88ed-0b051682a6a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "exosphères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd7f344c-6c06-3a72-83f0-63f15adcca50",
                        "entry_id": "a73866f4-213c-3dbd-88ed-0b051682a6a8",
                        "glosses": [
                            "Dernière couche de l’atmosphère terrestre qui se situe au-dessus de la thermosphère."
                        ],
                        "tags": [
                            "Géophysique",
                            "Sciences de l’atmosphère"
                        ],
                        "examples": [
                            {
                                "example_id": "d4c1966a-196e-4642-bc42-474ecb3bae4c",
                                "sense_id": "fd7f344c-6c06-3a72-83f0-63f15adcca50",
                                "text": "Un des grands intérêts de l’exosphère réside dans l'exceptionnelle capacité de durée de vie des satellites placés dans ses couches les plus hautes."
                            },
                            {
                                "example_id": "31cfe375-6c76-4880-9236-91d60008c3c9",
                                "sense_id": "fd7f344c-6c06-3a72-83f0-63f15adcca50",
                                "text": "Observée de suffisamment haut dans l’exosphère, une explosion nucléaire ressemble à l’éclosion d’un bouton d’acné. — (Daniel Nayeri, Coco et Cloclo, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 293)"
                            }
                        ]
                    },
                    {
                        "sense_id": "de94e49e-d1e0-3eae-acc9-5ba709d45d75",
                        "entry_id": "a73866f4-213c-3dbd-88ed-0b051682a6a8",
                        "glosses": [
                            "Dernière couche de l’atmosphère d’une planète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94202f66-291b-400d-a368-723295296adf",
                                "sense_id": "de94e49e-d1e0-3eae-acc9-5ba709d45d75",
                                "text": "Des quatre planètes proches du Soleil – Mercure, Vénus, la Terre et Mars – trois sont dotées d’une atmosphère stable. Mercure, la plus proche et la plus petite des planètes telluriques, ne possède qu’une exosphère transitoire, produit de l’interaction des ions du vent solaire avec les atomes de la surface."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d696781-31db-4567-a923-0e95cebe2f89",
                        "source_entry_id": "a73866f4-213c-3dbd-88ed-0b051682a6a8",
