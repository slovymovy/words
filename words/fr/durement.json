            "senses": [
                {
                    "sense_id": "32466013-4376-3b7f-b902-b1c3c47c5a33",
                    "sense_definition": "D'une manière violente ou avec des conséquences pénibles et graves.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette région côtière a été particulièrement <w>durement</w> touchée par les récentes inondations.",
                            "target_lang_translations": {
                                "en": "This coastal region was particularly <w>badly</w> hit by the recent floods.",
                                "ru": "Этот прибрежный регион особенно <w>тяжело</w> пострадал от недавних наводнений.",
                                "de": "Diese Küstenregion wurde durch die jüngsten Überschwemmungen besonders <w>schwer</w> getroffen.",
                                "es": "Esta región costera fue especialmente <w>duramente</w> afectada por las recientes inundaciones.",
                                "zh": "这片沿海地区在近期的洪灾中尤其<w>严重</w>地受灾。"
                            }
                        },
                        {
                            "text": "La crise économique a frappé très <w>durement</w> les petites entreprises du secteur.",
                            "target_lang_translations": {
                                "en": "The economic crisis hit small businesses in the sector very <w>hard</w>.",
                                "ru": "Экономический кризис очень <w>тяжело</w> ударил по мелким предприятиям этой отрасли.",
                                "de": "Die Wirtschaftskrise traf die kleinen Unternehmen der Branche sehr <w>hart</w>.",
                                "es": "La crisis económica golpeó muy <w>duramente</w> a las pequeñas empresas del sector.",
                                "zh": "经济危机<w>重重地</w>打击了该行业的小企业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fortement",
                        "lourdement"
                    ],
                    "antonyms": [
                        "légèrement"
                    ],
                    "common_phrases": [
                        "durement touché",
                        "durement frappé",
                        "durement éprouvé"
                    ],
                    "target_lang_definitions": {
                        "en": "In a violent way, or with severe and painful consequences.",
                        "ru": "Очень сильно, с тяжёлыми и болезненными последствиями.",
                        "de": "Auf heftige Weise oder mit schweren, schmerzhaften Folgen.",
                        "es": "De manera violenta o con consecuencias graves y dolorosas.",
                        "zh": "以猛烈的方式，或造成严重而痛苦的后果。"
                    },
