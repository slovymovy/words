{
    "word_family": [
        "betrayal",
        "betrayer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fdf2b7bb-46af-3efc-84f1-64e5ba767d93",
                    "sense_definition": "Simple past and past participle of <w>betray</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>betrayed</w> his best friend by telling everyone the secret.",
                            "target_lang_translations": {
                                "ru": "Он <w>предал</w> своего лучшего друга, рассказав всем этот секрет.",
                                "zh": "他把秘密告诉了所有人，<w>背叛</w>了他最好的朋友。"
                            }
                        },
                        {
                            "text": "Her trembling hands <w>betrayed</w> her nervousness during the interview.",
                            "target_lang_translations": {
                                "ru": "Её дрожащие руки <w>выдали</w> её волнение во время интервью.",
                                "zh": "面试时她颤抖的双手<w>流露</w>出了她的紧张。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола betray.",
                        "zh": "动词 betray 的过去式和过去分词，意为背叛或流露。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предал",
                                "target_lang_sense_clarification": "совершил предательство"
                            },
                            {
                                "target_lang_word": "выдал",
                                "target_lang_sense_clarification": "раскрыл секрет или эмоции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "背叛",
                                "target_lang_sense_clarification": "指违背忠诚，做出对不起他人的行为"
                            },
                            {
                                "target_lang_word": "流露",
                                "target_lang_sense_clarification": "指无意中显露出某种情感或秘密"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fb9cff77-c761-3325-8787-bd6c770e6638",
                    "sense_definition": "Suffering from betrayal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt deeply <w>betrayed</w> when she discovered the lies.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя глубоко <w>преданной</w>, когда обнаружила ложь.",
                                "zh": "当发现那些谎言时，她感到深深地<w>被背叛</w>了。"
                            }
                        },
                        {
                            "text": "The <w>betrayed</w> look on his face made me regret my decision immediately.",
                            "target_lang_translations": {
                                "ru": "Выражение лица, говорившее о том, что его <w>предали</w>, заставило меня немедленно пожалеть о своем решении.",
                                "zh": "他脸上那种<w>被背叛</w>的神情让我立刻后悔了自己的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deceived",
                        "misled",
                        "cheated"
                    ],
                    "antonyms": [
                        "supported",
                        "cherished"
                    ],
                    "common_phrases": [
                        "feel-betrayed",
                        "look-betrayed",
                        "deeply-betrayed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страдающий от предательства; чувствующий, что его предали.",
                        "zh": "形容词，指遭受背叛的，或感到被欺骗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преданный",
                                "target_lang_sense_clarification": "ставший жертвой предательства"
                            },
                            {
                                "target_lang_word": "обманутый",
                                "target_lang_sense_clarification": "введенный в заблуждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "被背叛的",
                                "target_lang_sense_clarification": "指遭受了背叛这一行为"
                            },
                            {
                                "target_lang_word": "受骗的",
                                "target_lang_sense_clarification": "指被他人欺骗或误导"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}