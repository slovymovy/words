                "senses": [
                    {
                        "sense_id": "35641b95-9a05-36b0-88ca-49e1d527b053",
                        "entry_id": "45e5a7da-6c1d-3c02-96e8-cfd5bbe332ab",
                        "glosses": [
                            "Personne rendue misérable par un parcours de vie difficile."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f50b1f6a-0358-4872-8de8-f10a5a202919",
                                "sense_id": "35641b95-9a05-36b0-88ca-49e1d527b053",
                                "text": "Je vivais et vivotais entre le chômage occasionnel et les cours à temps partiel de technicien de brûleurs à l’huile que je suivais dans le parc industriel de la basse-ville en compagnie de pauvres poqués et d’épaves émouvantes sur la voie de garage du recyclage."
                            },
                            {
                                "example_id": "6dec7ac3-e223-4c7b-be2e-4b5fc886b4bd",
                                "sense_id": "35641b95-9a05-36b0-88ca-49e1d527b053",
                                "text": "Tout comme je ne me dis pas, en traversant le parc Émilie-Gamelin (rendez-vous de tous les poqués de Montréal), que tous les jeunes sont toxicomanes."
                            },
                            {
                                "example_id": "0b9164b4-d76a-4a87-86c2-b5263dea387e",
                                "sense_id": "35641b95-9a05-36b0-88ca-49e1d527b053",
                                "text": "Plusieurs jeunes « poqués » proviennent de familles d'accueil de la DPJ."
                            }
                        ]
                    }
