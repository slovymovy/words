                "senses": [
                    {
                        "sense_id": "738e947a-3457-309f-a81f-bdc2c63ce134",
                        "entry_id": "20a99edf-3dea-3607-99b5-897e43147d6f",
                        "glosses": [
                            "To advise against."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2ffc2e2a-16bd-49b4-a092-f21fd4351f49",
                                "sense_id": "738e947a-3457-309f-a81f-bdc2c63ce134",
                                "text": "I had a clear reason to disadvise the purchase of it."
                            },
                            {
                                "example_id": "14112904-8eca-4b3f-aa5b-0c5e6ead318f",
                                "sense_id": "738e947a-3457-309f-a81f-bdc2c63ce134",
                                "text": "In this case, therefore, I conceive the plaintiff must be nonsuited and I should disadvise the bringing any such action."
                            },
                            {
                                "example_id": "1efa1a7d-804b-4a08-a7fc-08ecaa8aec61",
                                "sense_id": "738e947a-3457-309f-a81f-bdc2c63ce134",
                                "text": "Dietary recommendations for patients with CF generally disadvise an excessive intake of complex carbohydrates"
                            }
                        ]
                    },
                    {
                        "sense_id": "10587a71-25f5-3213-a8aa-d72707dbb46b",
                        "entry_id": "20a99edf-3dea-3607-99b5-897e43147d6f",
                        "glosses": [
                            "To dissuade."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8e6526aa-74d2-4e97-bb42-a9b178e6449f",
                                "sense_id": "10587a71-25f5-3213-a8aa-d72707dbb46b",
                                "text": "I am sure he disadvised you from it"
                            },
                            {
                                "example_id": "44c1b674-5f30-47b8-a767-338d5d043b8f",
                                "sense_id": "10587a71-25f5-3213-a8aa-d72707dbb46b",
                                "text": "The Convention sanctioned the exercise in Bechuanaland of that Imperial influence and protection which Sir Hercules had opposed at Pretoria and disadvised Her Majesty's Government against, as quoted above."
                            },
                            {
                                "example_id": "7d532ffd-03ea-4e1b-980b-3e231892e213",
                                "sense_id": "10587a71-25f5-3213-a8aa-d72707dbb46b",
                                "text": "At the time I used to wonder whether he knew his subject or whether he did not wish to part with his knowledge. From his subsequent career I have come to the conclusion that the former was the case. He disadvised me from studying books"
                            }
                        ]
                    }
