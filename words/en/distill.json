            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fa0eb001-0620-3ad1-8081-eba4fbde324c",
                    "sense_definition": "To purify a liquid by heating it until it turns into vapor and then cooling the vapor to collect it as a liquid, or to extract the essential meaning or most important aspects of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "purification_and_extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist had to <w>distill</w> the mixture several times to ensure it was completely pure.",
                            "target_lang_translations": {
                                "ru": "Химику пришлось несколько раз <w>дистиллировать</w> смесь, чтобы убедиться в её полной чистоте."
                            }
                        },
                        {
                            "text": "The author managed to <w>distill</w> years of complex research into a single, easy-to-read summary.",
                            "target_lang_translations": {
                                "ru": "Автору удалось <w>извлечь суть</w> многолетних сложных исследований и свести их к одному простому для чтения резюме."
                            }
                        }
                    ],
                    "synonyms": [
                        "purify",
                        "refine",
                        "extract",
                        "condense"
                    ],
                    "common_phrases": [
                        "distill essence",
                        "distill information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очищать жидкость путем нагревания до испарения и последующего охлаждения пара, либо выделять самую суть или наиболее важные аспекты чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дистиллировать",
