                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "193fecee-e117-4bac-a158-705a58dcb036",
                                                "sense_id": "91a06e4f-2be8-39bb-8259-48d2b8b11a54",
                                                "text": "Even confessing to a crime, the man may be mad, or a knavish simulator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                        "entry_id": "5983c5bc-97eb-3934-b11e-3f3f976af729",
                                        "glosses": [
                                            "A machine or system that simulates an environment (such as an aircraft cockpit), often for training purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af725404-b168-41d9-a20d-c3d18730ec5d",
                                                "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                                "text": "The dummy rocket is being developed to permit the ground testing of missile controls. By the use of this “flight simulator” the control devices of missiles can be subjected to operational tests on the ground, thus reducing the need for expensive flight tests."
                                            },
                                            {
                                                "example_id": "aa5285f7-d58c-47af-a6c3-7c833a8deb4e",
                                                "sense_id": "112a661e-99d7-303c-9342-28fff5441934",
                                                "text": "Classroom sessions for drivers are under way, with each driver requiring a full day on the simulator before they then test a tram on the £350 million new line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                        "entry_id": "5983c5bc-97eb-3934-b11e-3f3f976af729",
                                        "glosses": [
                                            "A game that attempts to reproduce an experience realistically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc7c09a-6625-4545-ac5b-fc99f268379b",
                                                "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                                "text": "a pinball simulator"
                                            },
                                            {
                                                "example_id": "fcc21584-52ab-4a7d-a5b5-53f1b8d5f944",
                                                "sense_id": "6bbd4293-56b4-3f4a-a3aa-b3addef27a27",
                                                "text": "While writing for Mastertronic, David had seen that sales figures were much better for 'simulators' compared to less realistic games […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
