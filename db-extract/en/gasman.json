                                "sense_id": "49734908-5095-31c5-b8d0-85bd74472305",
                                "text": "I spent all morning waiting for the gasman to call."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec24ee01-fa87-361f-bf61-152d0713d610",
                        "entry_id": "b0015773-a6ff-3063-8645-070c79793baf",
