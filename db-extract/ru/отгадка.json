                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa11d358-c9c9-4381-8468-91b545a79bae",
                        "source_entry_id": "4987f716-ba50-317e-8026-e005dc36d64b",
                        "target_lang_word": "solution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30bea4e4-9713-3a62-b808-59c55d8a6223",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "(Couramment) Moyen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6dceea9-51a4-4960-8634-1b9b0b615fd6",
                                                "sense_id": "30bea4e4-9713-3a62-b808-59c55d8a6223",
                                                "text": "L'aspirine, solution dans la prévention du cancer ?"
                                            },
                                            {
                                                "example_id": "0308d077-1d14-4178-87e9-3b08003ecd2c",
                                                "sense_id": "30bea4e4-9713-3a62-b808-59c55d8a6223",
                                                "text": "Délégué régional Bourgogne-Franche-Comté Orange : \"Ce sera peut-être du satellite, ça sera peut-être de la 4G, peut-être de la 5G à terme, il y aura une solution. Ce qu'il faut savoir c'est qu'on ne pourra pas faire un arrêt du cuivre si les gens sont sans solution.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b1137d-2e66-3e24-aa39-ceed9b4cd38f",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Dénouement d’une difficulté, réponse à une question, à un problème."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d139913-83a5-4246-8465-6610709174a7",
                                                "sense_id": "35b1137d-2e66-3e24-aa39-ceed9b4cd38f",
                                                "text": "Une idée de solution"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Liquide formé par le mélange homogène d’un ou plusieurs corps purs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f11aad-2cb3-48d0-83c3-e8adc8418cfb",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "Le dextran est obtenu en faisant agir une bactérie Leuconostoc mesenteroides sur des solutions stériles de glucose."
                                            },
                                            {
                                                "example_id": "d0a49ddb-0b04-46c9-919f-a69bfeaa154e",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "La solution d’ammoniaque est utilisée dans l’industrie pour le dégraissage, la fabrication des sels ammoniacaux."
                                            },
                                            {
                                                "example_id": "54140cbd-0762-4a4f-bff0-2fc3853925fa",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "Si l’on plonge la soie dans une solution diluée d'acide nitreux, elle se colore en jaune paille après vingt-quatre heures et peut prendre ensuite des teintes variables."
                                            },
                                            {
                                                "example_id": "4617a76a-45b4-49c0-8fa1-b3c21ce10393",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "L'étude des solutions du sol a permis d'approcher la connaissance des mécanismes pédogénétiques affectant une rendzine brune encroûtée, développée sur la craie à poches de cryoturbation."
                                            },
                                            {
                                                "example_id": "73edcecb-8d07-45c7-8cac-2cae191bc5a9",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "Lors de la remontée des eaux du fond, le dioxyde de carbone n’est plus sous pression, de sorte qu’il ne reste pas en solution ; les bulles qui montent vers la surface entraînent davantage d'eau des couches profondes."
                                            },
                                            {
                                                "example_id": "0dc3f249-98a2-435f-9974-581c1bbd5fe4",
                                                "sense_id": "4b25657e-133f-3e29-8025-4b368e3d80ec",
                                                "text": "Une autre méthode consiste à tremper le plant préparé dans une solution d’hormone de bouturage, telle que l'Exubérone® qui contient 4 g/L d’acide β-indole acétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0328ad33-3271-3ab7-82b0-279f9b69c755",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Libération, paiement final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "379dcea9-5116-4d0a-8b5d-02e0ac7b96f6",
                                                "sense_id": "0328ad33-3271-3ab7-82b0-279f9b69c755",
                                                "text": "Jusqu’à parfaite solution et paiement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd79eb07-e573-33b3-971e-47ddda1cedff",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "En algèbre, se dit d’un élément appartenant à un ensemble déterminé qui satisfait une équation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fada17b-e756-45eb-bca8-d50cb870b1a8",
                                                "sense_id": "dd79eb07-e573-33b3-971e-47ddda1cedff",
                                                "text": "Les formules et les principes exposés dans ce paragraphe, donneront la solution complète du problème, dans tous les cas qu’il peut présenter ; et cette solution est aussi simple qu’il est possible, puisqu’elle se réduit, dans chaque cas, à résoudre un nombre d’équations du premier degré égal à celui des inconnues qu’on a à déterminer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5afbb812-9569-3edc-affd-d144c8e52ac5",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Raisonnement, déduction pour arriver à une réponse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c97a03-ac79-4b0a-ae80-5f3929294254",
                                                "sense_id": "5afbb812-9569-3edc-affd-d144c8e52ac5",
                                                "text": "Sur le plan de l’économie politique, les lettristes offrent des solutions, et je crois que les anarchistes devraient envisager ces solutions, et peut-être même agir avec nous si ces solutions semblent valables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc0d0b30-0125-30a1-ad2d-49c507fa255d",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Division, séparation des parties, interruption, coupure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e823093-ce9b-46b4-9f2c-066b40bbe0af",
                                                "sense_id": "dc0d0b30-0125-30a1-ad2d-49c507fa255d",
                                                "text": "Après avoir marché pendant deux milles environ, ils n’y avaient encore remarqué aucune solution de continuité. Les poteaux étaient en bon état, les isoloirs intacts, le fil régulièrement tendu."
                                            },
                                            {
                                                "example_id": "7dd7aa43-2f5e-43d6-920b-947eae475a8b",
                                                "sense_id": "dc0d0b30-0125-30a1-ad2d-49c507fa255d",
                                                "text": "Solution de mariage (c’est à dire divorce)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1818081e-3ca9-39b8-a8c4-82fcb8981c72",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Action de dissoudre, de se dissoudre dans un liquide ; on ne dit plus que dissolution en ce sens."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d15d8a51-5f40-4cc6-96d5-b399cfbd401f",
                                                "sense_id": "1818081e-3ca9-39b8-a8c4-82fcb8981c72",
                                                "text": "Obtenir la solution complète du sel dans l’eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e92cd6e4-d75a-3660-ac2e-4bb4c9530d79",
                                        "entry_id": "990cab80-9c96-3d45-8567-4c798e17e4f7",
                                        "glosses": [
                                            "Ensemble de produits ou de services à destination d'un client (dans le cadre du business to business)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9fc2d7c-3faf-41aa-99bb-ba6b79838f67",
                                                "sense_id": "e92cd6e4-d75a-3660-ac2e-4bb4c9530d79",
                                                "text": "Les solutions IBM."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a79f852-3294-44bb-9198-94871ea4ddb8",
                        "source_entry_id": "4987f716-ba50-317e-8026-e005dc36d64b",
                        "target_lang_word": "réponse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réponse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10f2f923-c7c1-33f2-8bf4-f4c37b79bdc9",
                                        "entry_id": "cf2c4128-2273-3f02-bdb7-fd8d3b14244d",
                                        "glosses": [
                                            "Parole dite, ou acte effectué, en réaction à une question posée, une demande, ou à une déclaration, ou encore à un évènement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5828f1-a89e-41ed-8c65-152a506cba7e",
                                                "sense_id": "10f2f923-c7c1-33f2-8bf4-f4c37b79bdc9",
                                                "text": "Pour unique réponse, Geisha s'étira paresseusement et demanda une cigarette."
                                            },
                                            {
                                                "example_id": "3f18c955-319c-4aa0-b91c-807971d8ed59",
                                                "sense_id": "10f2f923-c7c1-33f2-8bf4-f4c37b79bdc9",
                                                "text": "Les réponses étaient variées, parfois malaimables et parfois sympathiques, mais, en résumé, elle n'avait jamais obtenu le moindre renseignement exploitable."
                                            },
                                            {
                                                "example_id": "8823a273-a7b0-47cf-a184-d7ab9d1129eb",
                                                "sense_id": "10f2f923-c7c1-33f2-8bf4-f4c37b79bdc9",
                                                "text": "Coincée dans un wagon, les bras encombrés par l’immense présent d’Alicia, je réfléchissais à toute vitesse et les questions sans réponses se bousculaient au portillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                        "entry_id": "cf2c4128-2273-3f02-bdb7-fd8d3b14244d",
                                        "glosses": [
                                            "Écrit, d’une lettre en retour à un autre écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258e1e94-85b4-4c68-abe6-4bcd4a9b3cee",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "Il m’a écrit en réponse à ma lettre de tel jour."
                                            },
                                            {
                                                "example_id": "4038ba65-a028-4ffe-b1a7-e1f419d27fe7",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "Il m’a fait réponse très promptement."
                                            },
                                            {
                                                "example_id": "02af2d74-e325-4d79-abbb-fa23c7f3c7c2",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "J’ai reçu sa réponse."
                                            },
                                            {
                                                "example_id": "02f5f65c-46a8-481b-a2a3-83a5aa42d34f",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "Je n’ai pas encore reçu de réponse de lui."
                                            },
                                            {
                                                "example_id": "8ae131f1-4c98-44d7-8c27-7e676d9a32c4",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "Attendre réponse."
                                            },
                                            {
                                                "example_id": "85eef3fd-571d-4d94-80b4-2642c9177ec9",
                                                "sense_id": "e804526a-d429-3a33-987a-e441656979b9",
                                                "text": "Réponse payée : télégramme dont la taxe est acquittée d’avance par celui qui demande une réponse à son propre télégramme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                        "entry_id": "cf2c4128-2273-3f02-bdb7-fd8d3b14244d",
                                        "glosses": [
                                            "Réfutation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10aa015a-b851-482e-8022-2328316ff224",
                                                "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                                "text": "C'est dans le même esprit mélioriste que Condorcet prône un enseignement élémentaire, moral et civique qui constitue la meilleure réponse au fanatisme religieux."
                                            },
                                            {
                                                "example_id": "236e946e-5a13-48a9-9193-358f7668ade9",
                                                "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                                "text": "Nous verrons bientôt sa réponse au livre qui a paru contre sa théorie."
                                            },
                                            {
                                                "example_id": "dcd9ea20-90bd-4988-8fa5-64ca88a9169e",
                                                "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                                "text": "Il vient de m’attaquer, ma réponse ne se fera point attendre."
                                            },
                                            {
                                                "example_id": "85433130-a7e5-402e-8178-1e2f98409813",
                                                "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                                "text": "Sa réponse est victorieuse."
                                            },
                                            {
                                                "example_id": "38fc178c-4eea-4bd3-85c7-739edffd653e",
                                                "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                                                "text": "Le droit de réponse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1241fd9-f1bf-321b-9526-97ab991e678c",
                                        "entry_id": "cf2c4128-2273-3f02-bdb7-fd8d3b14244d",
                                        "glosses": [
                                            "Il se dit particulièrement, en termes de procédures des écritures qu’une partie fait signifier pour répondre aux moyens que l’autre a présentés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8d8b1bb-16b8-4197-80d3-b7059022f2b8",
                                                "sense_id": "e1241fd9-f1bf-321b-9526-97ab991e678c",
                                                "text": "Fournir sa réponse, ses réponses."
                                            },
                                            {
                                                "example_id": "08162647-5797-4320-b0d1-8038bfc0eec2",
                                                "sense_id": "e1241fd9-f1bf-321b-9526-97ab991e678c",
                                                "text": "La réponse aux défenses, aux griefs d’appel a été signifiée tel jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec622b38-044e-3329-9bd6-8f7435de706b",
                                        "entry_id": "cf2c4128-2273-3f02-bdb7-fd8d3b14244d",
                                        "glosses": [
                                            "Motif d’une fugue qui répond, qui correspond au sujet."
                                        ],
                                        "tags": [],
                                        "examples": []
