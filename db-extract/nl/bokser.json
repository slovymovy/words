                    {
                        "translation_id": "1560e88b-781e-4c7c-bd47-be37edcde89a",
                        "source_entry_id": "8f72615f-eb9c-35b2-9130-d4511eed0e7d",
                        "source_sense_id": "a778fc77-7e56-358d-b9e6-4eb18767b2d6",
                        "source_sense_description": "een persoon die het boksen beoefent",
                        "target_lang_word": "boxeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boxeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1cb8cae8-f2ad-3882-8005-acec93b18202",
                                        "entry_id": "9fea927c-f629-31a3-a059-6ba60574cd18",
                                        "glosses": [
                                            "Qui boxe ; qui s’adonne à la boxe."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b235aa-7f8c-4173-bb09-735497178208",
                                                "sense_id": "1cb8cae8-f2ad-3882-8005-acec93b18202",
                                                "text": "Il suffit de parcourir les sous-titres de ces différents volumes, les bêtes qui font de la gymnastique, les comédiens de la nature, les animaux boxeurs, les animaux qui ne payent pas leur terme, […]."
                                            },
                                            {
                                                "example_id": "933058d7-11db-45a3-94b1-9043b7443113",
                                                "sense_id": "1cb8cae8-f2ad-3882-8005-acec93b18202",
                                                "text": "Son numéro était suivi d’une exhibition de chiens boxeurs, huit bêtes superbes qu’elle avait offertes à son père deux années plus tôt, grâce à six années de cachets récoltés sur toutes les pistes du continent."
                                            },
                                            {
                                                "example_id": "df3eb0e6-4063-45e8-8079-71d7475bdd1f",
                                                "sense_id": "1cb8cae8-f2ad-3882-8005-acec93b18202",
                                                "text": "C’est en effet un numéro de cirque classique, mais ce geste n’est absolument pas naturel et les kangourous boxeurs ont été dressés patiemment."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boxeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                        "entry_id": "ff50ec94-61b2-3a18-b9af-ce5c880f5df6",
                                        "glosses": [
                                            "Celui qui pratique la boxe, par goût ou par profession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae1839d-2c30-49ec-96a5-9c867998ccab",
                                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                                "text": "— Comment ? De quel boxeur ?\n— De celui dont vous avez apporté la photographie.\n— Je n’ai apporté la photographie d’aucun boxeur.\n— Enfin… quoi ?… de votre joueur de tennis… C’est la même chose."
                                            },
                                            {
                                                "example_id": "76930c78-1ffa-45fe-880a-ad78a4184d64",
                                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                                "text": "La boxe est très en honneur à Panama. J’assistai à de bons matches et quelques boxeurs noirs étaient tout près de la meilleure classe mondiale."
                                            },
                                            {
                                                "example_id": "52d405df-48e3-4db8-85fc-ad70ec2c944d",
                                                "sense_id": "b8ac09ca-965c-3fdc-bc51-d180dc93eca5",
                                                "text": "L'autorisation définitive de boxer pourra être retirée à tout boxeur dont les examens médicaux donneraient des résultats satisfaisants, mais qui présenterait des signes caractéristiques de déficience physique, de réflexes diminués, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
