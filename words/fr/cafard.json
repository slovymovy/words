                },
                {
                    "sense_id": "1adf300e-c4fd-3629-af1f-7a84e431a9e4",
                    "sense_definition": "Personne qui dénonce ou rapporte les fautes des autres, en particulier dans le milieu scolaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "denonciateur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne dans la classe ne voulait parler à ce <w>cafard</w> qui répétait tout au professeur."
                        },
                        {
                            "text": "Il s'est comporté comme un vrai <w>cafard</w> en racontant nos secrets au directeur."
                        }
                    ],
                    "synonyms": [
                        "cafteur",
                        "mouchard",
                        "cafetière"
