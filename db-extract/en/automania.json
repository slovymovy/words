                "senses": [
                    {
                        "sense_id": "10c70451-1796-33b5-80e4-77336e26a74c",
                        "entry_id": "ad7f1034-35d2-3c51-9ea3-f8c43f7047a3",
                        "glosses": [
                            "An enthusiasm for motor vehicles and motoring."
                        ],
                        "tags": [
                            "US",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8a657bdb-4b06-4e85-900f-31885f73db9a",
                                "sense_id": "10c70451-1796-33b5-80e4-77336e26a74c",
                                "text": "There seems to be need of a term to designate these new terrors of our streets, those speed crazed paranoiacs who are now doing so much to bring the automobile into disrepute.[…] Why not adopt the name “automania” for the disease and the automaniac to designate the person afflicted by it?"
                            },
                            {
                                "example_id": "d7a3c6b1-792b-4b73-af9a-953bf8983402",
                                "sense_id": "10c70451-1796-33b5-80e4-77336e26a74c",
                                "text": "The fact is, some of these people are seized with automania, and if they could not go fast, they would not care to go at all. Automania is the feverish desire to move at the greatest rate of speed of which the motor is capable, with no regard for the life of bipeds or quadrupeds."
                            }
                        ]
                    }
