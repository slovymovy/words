                "senses": [
                    {
                        "sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                        "entry_id": "44ba7fa0-98a5-3da5-90d8-b193b31cc6ba",
                        "glosses": [
                            "Personne qui aime faire la fête."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5a23b8cc-2ce0-4bdf-8a27-aa942e03d9a5",
                                "sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                                "text": "La môme était une foirineuse, une bringueuse de première, entre nous ça pouvait que coller."
                            },
                            {
                                "example_id": "c18f8674-3c1e-41e2-a1ca-945f270a5422",
                                "sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                                "text": "Le père bossait dans un bagne genre Alliages du Rhône, Vitry, et le dimanche il actionnait le poumon à bretelles dans les guinguettes des bords de Marne. Anar pacifiste, tendance bringueur et alcolo…"
                            },
                            {
                                "example_id": "748cae68-979d-42d3-87c4-27c23592fad3",
                                "sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                                "text": "Il faudra quand même que je songe un jour a ma réputation de bringueur invétéré."
                            },
                            {
                                "example_id": "41e965dd-8a75-44b1-8810-89e335de10ef",
                                "sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                                "text": "Diouf l'une de mes idoles d'enfance, il avait les capacités pour être un très grand joueur. Mais c'était un sacré bringueur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c35c2fa-ed69-43ba-87d4-3a1bf3e20275",
                        "source_entry_id": "44ba7fa0-98a5-3da5-90d8-b193b31cc6ba",
                        "source_sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                        "target_lang_word": "Zechbruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zechbruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                        "entry_id": "690241fb-46fc-3841-8e0e-b0a8cf7b1106",
                                        "glosses": [
                                            "eine Person, mit der man öfter gemeinsam Alkohol trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097da122-859a-41a0-92b6-dc4005f9abf5",
                                                "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                                "text": "„Anatol versäumte kein Trinkgelage bei Danilow und anderen Moskauer Zechbrüdern, trank ganze Nächte durch, bis alle anderen unter dem Tisch lagen, und zeigte sich auf allen Soireen und Bällen der ganzen Gesellschaft.“"
                                            },
                                            {
                                                "example_id": "2f10c83c-9c63-4050-9a28-8c6703d83e59",
                                                "sense_id": "3bbc0882-deaa-3dba-9285-5fa3206a9114",
                                                "text": "„Die Zechbrüder waren verschwunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "01123371-f753-3618-82f2-1141ee2ba72a",
                                        "entry_id": "690241fb-46fc-3841-8e0e-b0a8cf7b1106",
                                        "glosses": [
                                            "jemand, der viel trinkt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ffaf8a-0cec-49c9-8598-31ef86e8fada",
                        "source_entry_id": "44ba7fa0-98a5-3da5-90d8-b193b31cc6ba",
                        "source_sense_id": "443c2eed-618f-3f00-a597-d412c9365df4",
                        "target_lang_word": "Zecher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zecher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0152fd9f-6971-3fc8-b09c-13d0a67567f6",
                                        "entry_id": "d7fdc6ea-0c0d-36e5-bb2e-c6c640c97190",
                                        "glosses": [
                                            "jemand, der reichlich alkoholische Getränke konsumiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b012fa-29bd-4c4e-9b7e-7780fcf22b7f",
                                                "sense_id": "0152fd9f-6971-3fc8-b09c-13d0a67567f6",
                                                "text": "„Obwohl die Zecher inzwischen tolle Dinge trieben, hatte ich aufmerksam zugehört und zuweilen auch eine Frage gestellt.“"
                                            },
                                            {
                                                "example_id": "e6c6e04f-b090-41e3-883a-d295e27f7a6e",
                                                "sense_id": "0152fd9f-6971-3fc8-b09c-13d0a67567f6",
                                                "text": "„Er sei eben »ein Franzos«, sagten einige in der Wirtschaft, wohlhabende Zecher und Weinbauern mit rot gedrechselten Nasen.“"
                                            },
                                            {
                                                "example_id": "eea0927d-5297-43e3-8635-fe71ff0416c3",
                                                "sense_id": "0152fd9f-6971-3fc8-b09c-13d0a67567f6",
                                                "text": "„Rätselraten begann sowie Trinken nach Anlässen, und bald war die Tempelhalle von dem Gelächter der Zecher erfüllt.“"
                                            },
                                            {
                                                "example_id": "2908709b-1fb1-4920-8233-007a930e86ce",
                                                "sense_id": "0152fd9f-6971-3fc8-b09c-13d0a67567f6",
                                                "text": "„Blackfoot hatte inzwischen die Tür des Junggesellenbaus geöffnet und die auf Fellen und Decken gelagerten Zecher geweckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
