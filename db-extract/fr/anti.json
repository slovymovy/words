                                        "sense_id": "32859136-5593-36d4-b392-a50e437c696a",
                                        "entry_id": "4573a489-4948-31e4-91a1-001964cc1d37",
                                        "glosses": [
                                            "(proti + dativ) vyjadřuje směr k něčemu, co je umístěno na opačné straně nebo z ní směřuje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b0f3959-f261-46c0-9ba0-2737505821e9",
                                                "sense_id": "32859136-5593-36d4-b392-a50e437c696a",
                                                "text": "Fara stojí proti kostelu."
                                            },
                                            {
                                                "example_id": "3d0efe52-dc22-4095-a9a0-c76e68c1baba",
                                                "sense_id": "32859136-5593-36d4-b392-a50e437c696a",
                                                "text": "Hráči nastoupili do dvou řad proti sobě."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e82119-ac68-3e7e-8643-97e677cf2cea",
                                        "entry_id": "4573a489-4948-31e4-91a1-001964cc1d37",
                                        "glosses": [
                                            "(proti + dativ) vyjadřuje pohyb po směru opačném normálnímu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17a5dd5-59b6-42f6-9396-015dc6e3f3f6",
                                                "sense_id": "84e82119-ac68-3e7e-8643-97e677cf2cea",
                                                "text": "Plaval jsem proti proudu řeky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c01db0fe-5a7c-352d-a842-faaeb9004f77",
                                        "entry_id": "4573a489-4948-31e4-91a1-001964cc1d37",
                                        "glosses": [
                                            "(proti + dativ) vyjadřuje protiklad vůči něčemu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0da3946-cf12-4b93-850b-14d585888ce2",
                                                "sense_id": "c01db0fe-5a7c-352d-a842-faaeb9004f77",
                                                "text": "Proti tobě je hodný."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bbf09a7-a5c4-3e3d-b248-b7edbd867ccc",
                                        "entry_id": "4573a489-4948-31e4-91a1-001964cc1d37",
                                        "glosses": [
                                            "(proti + dativ) vyjadřuje nesouhlas, neshodu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d4c6eb-6a1a-429d-9687-c6a2329ddc9e",
                                                "sense_id": "1bbf09a7-a5c4-3e3d-b248-b7edbd867ccc",
                                                "text": "Jsem proti tomu návrhu."
                                            },
                                            {
                                                "example_id": "da0b349d-24af-4041-8dcb-2834d4c7a4de",
                                                "sense_id": "1bbf09a7-a5c4-3e3d-b248-b7edbd867ccc",
                                                "text": "V takovém státě se prý nic nedá dělat proti džungli kasin a heren, proti nočním klubům, proti pochybným tržnicím, nebo proti bazarům a sběrnám kovového odpadu, kde se čile obchoduje s kradeným zbožím. A málo se prý dá dělat proti systémové manipulaci veřejných zakázek a korupci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
