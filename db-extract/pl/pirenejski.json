                            {
                                "example_id": "a38ca655-a93c-40c0-af85-78249ecab3a3",
                                "sense_id": "a2746616-983a-3d1d-ad9c-dcba8c3830e1",
                                "text": "Włosi tradycyjnie wyróżniają trzy klasyczne typy lodowców: pirenejski, alpejski i himalajski"
                            }
                        ],
