                    {
                        "form_id": "5a970bbf-9e31-48fd-8b1a-f9e6292fa894",
                        "entry_id": "b0afe792-540a-332b-b749-aec2fea6c44d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Staatskanzlei"
                    },
                    {
                        "form_id": "e1b70d41-5017-48b9-ac62-e245d46f840c",
                        "entry_id": "b0afe792-540a-332b-b749-aec2fea6c44d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Staatskanzleien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88733cf0-c8b8-3abd-8871-6fb1bb7c2efc",
                        "entry_id": "b0afe792-540a-332b-b749-aec2fea6c44d",
                        "glosses": [
                            "„Behörde, die administrative und Stabsfunktionen für den Regierungschef“ wahrnimmt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "6d6eb12d-298f-4d38-a346-ed89747cf2fa",
                                "sense_id": "88733cf0-c8b8-3abd-8871-6fb1bb7c2efc",
                                "text": "„Noch ist dem gemeinen Volk keine Gelegenheit geboten worden, Einblick zu nehmen in die neue Hessische Staatskanzlei im einstigen Nobelhotel ‚Rose‘.“"
                            },
                            {
                                "example_id": "be7e4311-5be5-4183-b853-3dbcb67cf84a",
                                "sense_id": "88733cf0-c8b8-3abd-8871-6fb1bb7c2efc",
                                "text": "„Die Staatskanzlei teilte am Mittwochnachmittag mit, dass nach der überraschenden Wahl Kemmerichs zunächst keine Minister ernannt würden.“"
                            },
                            {
                                "example_id": "6a857f83-87fc-4b7f-b86b-fe0646498372",
                                "sense_id": "88733cf0-c8b8-3abd-8871-6fb1bb7c2efc",
                                "text": "„In wenigen Monaten wird die hessische Staatskanzlei in das für ihre Belange umgebaute ehemalige Hotel ‚Rose‘ am Kranzplatz einziehen - und an der Bierstadter Straße eine kleinere, gleichwohl ebenfalls repräsentative historische Immobilie frei machen.“"
                            },
                            {
                                "example_id": "17cf68f3-35f4-4ad3-8e54-dd92a4c1aa1c",
                                "sense_id": "88733cf0-c8b8-3abd-8871-6fb1bb7c2efc",
                                "text": "„Öffentlich-rechtliche Sender: Medienminister Rainer Robra fordert radikale Reform von ARD und ZDF Rainer Robra ist Chef der Staatskanzlei in Sachsen-Anhalt – und stellte erst kürzlich die ‚Tagesschau‘ im Ersten in Frage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e5bfc414-bdc4-3a2f-b4ba-937edb9c7012",
                        "entry_id": "b0afe792-540a-332b-b749-aec2fea6c44d",
                        "glosses": [
                            "„zentrale Stabsstelle der Kantonsregierung und meist auch des Kantonsparlaments“"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "e2febc84-100d-41fc-872d-dc00e5ee44ba",
                                "sense_id": "e5bfc414-bdc4-3a2f-b4ba-937edb9c7012",
                                "text": "„Nun habe der Genfer Staatsrat in Absprache mit den Kantonen Aargau, Bern und Luzern entschieden, das System sofort einzustellen, heisst es in der Mitteilung der Luzerner Staatskanzlei.“"
                            },
                            {
                                "example_id": "2628ee2a-29f6-4522-8c56-b056ce4affe4",
                                "sense_id": "e5bfc414-bdc4-3a2f-b4ba-937edb9c7012",
                                "text": "„In den bisher sechs frei gelegten Gräbern kam als wichtigster Fund eine seltene, reich verzierte Gürtelschnalle aus Bronze zu Tage, wie die Staatskanzlei Solothurn mitteilte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "13279384-b41f-3e24-8b72-53bbf8214008",
                        "entry_id": "b0afe792-540a-332b-b749-aec2fea6c44d",
                        "glosses": [
                            "Kabinett des Kaisers"
                        ],
                        "tags": [
                            "Austrian German",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f494d279-2029-4df5-96a9-91bf36de507c",
                                "sense_id": "13279384-b41f-3e24-8b72-53bbf8214008",
                                "text": "„Die beiden Kataloge werden an die Privatbibliothek weitergereicht und bereits am 10. Oktober kann der Kanzleidirektor des Obersthofmeisteramtes, Franz Freiherr von Löhr, der Staatskanzlei zwei von Young erstellte Verzeichnisse mit dem Auftrag Franz’ I. überreichen, die darin aufgeführte Auswahl durch den kaiserlichen Gesandten in München, Joseph Graf Trauttmansdorff (ein Sohn des Obersthofmeisters), „für Rechnung Seiner Majestät des Kaisers“ zu erstehen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
