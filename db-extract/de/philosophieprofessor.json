                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1d9f91-8743-4189-afb2-7187ba29ad9e",
                                "sense_id": "58f0931e-17c5-31fe-b106-d832f73f0194",
                                "text": "„An der Universität von Hannover hindern Studenten den Philosophieprofessor Theodor Lessing daran, seine Vorlesung zu halten.“"
                            },
                            {
                                "example_id": "90582bb7-352b-4eb5-b3ab-fa0d93c73fa7",
                                "sense_id": "58f0931e-17c5-31fe-b106-d832f73f0194",
                                "text": "„Gewisse Stunden des Tages, über die er anderen wenig und noch weniger sich selbst Rechenschaft gab, waren der Raum, den der Philosophieprofessor als Werkstatt für den Denker ausgespart hat.“"
                            }
                        ],
