                    },
                    {
                        "translation_id": "7e085455-ee2d-45c8-a1f2-ad3381da258a",
                        "source_entry_id": "4dc06dd9-86dd-3234-a1a1-79c167334c65",
                        "source_sense_description": "forgiveness given by a priest after confession",
                        "target_lang_word": "Absolution",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolution",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "329f3c86-08ec-3d36-adfa-6a3a313aaf7d",
                                        "entry_id": "f9e9845e-de47-33d3-b164-ec693f209eef",
                                        "glosses": [
                                            "die Freisprechung von der Sünde in der Beichte durch einen Priester"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be87ae4f-c006-473f-bfa8-7b34a900bb63",
                                                "sense_id": "329f3c86-08ec-3d36-adfa-6a3a313aaf7d",
                                                "text": "Der Priester erteilte ihr Absolution. / Der Priester erteilte ihr die Absolution."
                                            },
                                            {
                                                "example_id": "e9974cfd-fa50-41fc-951f-a0c820f19a4c",
                                                "sense_id": "329f3c86-08ec-3d36-adfa-6a3a313aaf7d",
                                                "text": "Er erhielt die Absolution."
                                            },
                                            {
                                                "example_id": "b9b07ea1-4c82-44fa-a7cd-89b16f762fa8",
                                                "sense_id": "329f3c86-08ec-3d36-adfa-6a3a313aaf7d",
                                                "text": "„Dann führte man ihr einen Abbé à robe longue zu, der ihr die Beichte abnahm und ihr die Absolution erteilte.“"
                                            },
                                            {
                                                "example_id": "afb4e59a-cbc5-49ba-9041-50b7315c8fd0",
                                                "sense_id": "329f3c86-08ec-3d36-adfa-6a3a313aaf7d",
                                                "text": "„Am neunten Tag kam der Pfarrer und erteilte ihr die Absolution und die letzte Ölung, und sagte schließlich, er lasse sie in Gottes Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "edb9897f-ec9c-3d31-86da-b4a58350708a",
                                        "entry_id": "f9e9845e-de47-33d3-b164-ec693f209eef",
                                        "glosses": [
                                            "Verzeihung, Vergebung"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "humorous",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "103140d9-7de1-4509-8fe9-7ec0cee28c4b",
                                                "sense_id": "edb9897f-ec9c-3d31-86da-b4a58350708a",
                                                "text": "„Vielleicht hatte er zunächst nur für Fried daran geglaubt, aber dann war es wie eine Absolution gewesen, ein Ausweg.“"
                                            },
                                            {
                                                "example_id": "d32ff202-f9b0-478c-aaed-4ba8dc4e1360",
                                                "sense_id": "edb9897f-ec9c-3d31-86da-b4a58350708a",
                                                "text": "Wir haben dir Absolution erteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14f730c9-c0b9-3530-b0b9-176e391842da",
