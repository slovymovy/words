                        "een eenzame kluizenaar"
                    ]
                },
                {
                    "sense_id": "053335c1-567c-3155-878b-2a7c85757254",
                    "sense_definition": "Aanduiding voor de nonvlinder (Lymantria monacha), een bepaald soort nachtvlinder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vlinder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De biologen zochten in het dichte bos naar de zeldzame <w>kluizenaar</w>."
                        },
                        {
                            "text": "Men noemt deze nachtvlinder in de volksmond ook wel de <w>kluizenaar</w>."
                        }
                    ]
                }
            ]
        },
