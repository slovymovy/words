                    }
                ],
                "senses": [
                    {
                        "sense_id": "c552ce83-931f-327d-9bac-be37ec803fe8",
                        "entry_id": "23905829-c7fc-3790-ba7f-14a9f700d486",
                        "glosses": [
                            "wie een zittend leven leidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e484d15-a5f9-4148-9764-2ff0992f4852",
                                "sense_id": "c552ce83-931f-327d-9bac-be37ec803fe8",
                                "text": "De mate van beweging werd ingedeeld in de vier categorieën sedentair, licht, gemiddeld en hoog."
                            }
                        ]
                    },
                    {
                        "sense_id": "28e36b61-2902-3443-9399-6090f37bd61d",
                        "entry_id": "23905829-c7fc-3790-ba7f-14a9f700d486",
                        "glosses": [
                            "een vaste verblijf- of standplaats hebbend"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7150995c-6f5a-4a24-bb49-6f9abced82e6",
                        "source_entry_id": "23905829-c7fc-3790-ba7f-14a9f700d486",
                        "target_lang_word": "sedentary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sedentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "028bac9d-16e8-35fe-b558-aa5a52be7341",
                                        "entry_id": "7b01dcd8-72ad-3ac0-ba93-6630beb6a428",
                                        "glosses": [
                                            "Not moving; relatively still; staying in the vicinity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fcdf2ba-6361-4ae6-8d25-4ef48b42dbbb",
                                                "sense_id": "028bac9d-16e8-35fe-b558-aa5a52be7341",
                                                "text": "The oyster is a sedentary mollusk; the barnacles are sedentary crustaceans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46ccaf23-58f8-3f60-9f13-4c4ddba7b4bd",
                                        "entry_id": "7b01dcd8-72ad-3ac0-ba93-6630beb6a428",
                                        "glosses": [
                                            "Living in a fixed geographical location; the opposite of nomadic."
                                        ],
                                        "tags": [
                                            "of a human population"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8803845-f5d7-3b4e-8613-713d4ffcc7fb",
                                        "entry_id": "7b01dcd8-72ad-3ac0-ba93-6630beb6a428",
                                        "glosses": [
                                            "Not moving much; sitting around."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c719b649-bce5-47a1-9afe-cf16b6de8aaa",
                                                "sense_id": "c8803845-f5d7-3b4e-8613-713d4ffcc7fb",
                                                "text": "[…]that any education that confined itself to sedentary pursuits was essentially imperfect, that the body as well as the mind should be cultivated[…]"
                                            },
                                            {
                                                "example_id": "c15d34f5-f085-4cb3-834e-0b526bed4885",
                                                "sense_id": "c8803845-f5d7-3b4e-8613-713d4ffcc7fb",
                                                "text": "[…]the Egyptians; whose Sages were not sedentary, scholastic Sophists, like the Grecian[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fd39eac-14e2-3bd4-a56e-8ac9d5a3e8bb",
                                        "entry_id": "7b01dcd8-72ad-3ac0-ba93-6630beb6a428",
                                        "glosses": [
                                            "inactive; motionless; sluggish; tranquil"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25bf8edf-e7ce-42ef-8305-cba31e2c3a11",
                                                "sense_id": "0fd39eac-14e2-3bd4-a56e-8ac9d5a3e8bb",
                                                "text": "Such restless revolution day by day\n Repeated, while the sedentary earth\n That better might with far less compass move[…]"
                                            },
                                            {
                                                "example_id": "d43f6ab2-08a7-4db2-b85f-e9f9c4979867",
                                                "sense_id": "0fd39eac-14e2-3bd4-a56e-8ac9d5a3e8bb",
                                                "text": "The Soul, considered abstractedly from its Passions, is of a remiss and sedentary Nature, slow in its Resolves, and languishing in its Executions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e187ef5-b7c7-3efe-949e-4519c73ef7da",
                                        "entry_id": "7b01dcd8-72ad-3ac0-ba93-6630beb6a428",
                                        "glosses": [
                                            "Caused by long sitting."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6329dd-45e5-4723-9c87-2b195fb8ef09",
                                                "sense_id": "8e187ef5-b7c7-3efe-949e-4519c73ef7da",
                                                "text": "till length of years\n And sedentary numbness craze my limbs\n To a contemptible old age obscure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sedentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                        "entry_id": "bb54cd05-52a4-3cbf-93a2-966d2735c1bd",
                                        "glosses": [
                                            "a sedentary person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4c3eaa-8374-4b6e-9932-c5b16d48e41d",
                                                "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                                "text": "Endosomatic electrodermal activity (skin potential level and skin potential response) as an indirect indicator of sympathetic nervous system activity was measured in 35 sedentary male students and 22 trained athletes of two groups during resting and after an acute exercise. The aim of this study was to investigate the difference of skin potential parameters between sedentaries and trained athletes before and after the acute exercise in bicycle ergometer."
                                            },
                                            {
                                                "example_id": "f2515d6a-7b13-4650-89a2-e3b9452041f8",
                                                "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                                "text": "The non-sedentaries rather do not without grain or rice, but the sedentaries have, in Wirth's table, not much less sheep and goats than the non-sedentaries. That is a reason to suppose that the sedentaries can cope without the non-sedentaries"
                                            },
                                            {
                                                "example_id": "6247b32a-7792-412b-a9b6-f26d879297b2",
                                                "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                                "text": "With the decline and eventual downfall of the south, it was their relationship with the Arab sedentaries of the north which assumed greater importance;"
                                            },
                                            {
                                                "example_id": "48eb996d-aad7-408d-b34e-0d1a9f3d7002",
                                                "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                                "text": "Smiths are not nomadic among the nomads and sedentary among the sedentaries, nor half-nomadic among the nomads, half-sedentary among sedentaries."
                                            },
                                            {
                                                "example_id": "f5714e9b-e319-4d50-9d13-85d6824f55e9",
                                                "sense_id": "50174693-a7c2-3365-8085-ec0f35b90d74",
                                                "text": "\"These baths are great both for active people like sportsmen, as well as for sedentaries who spend too much time behind their desks,\" explains Dicioni Lino"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b66a102-6871-452d-b0ae-913017d7e071",
                        "source_entry_id": "23905829-c7fc-3790-ba7f-14a9f700d486",
                        "target_lang_word": "sédentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sédentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56a7b8b1-ed2a-33ec-b6f7-5805e69f3976",
                                        "entry_id": "00aec91e-b5c3-3113-b4d2-f43080f17465",
                                        "glosses": [
                                            "Qui demeure ordinairement assis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fa229f-4775-4221-85da-3050236a35a5",
                                                "sense_id": "56a7b8b1-ed2a-33ec-b6f7-5805e69f3976",
                                                "text": "Déjà tout blanc, alourdi par sa vie sédentaire, il avait une figure molle, effacée, comme usée au reflet de l’argent qu’il comptait sans relâche."
                                            },
                                            {
                                                "example_id": "64596812-fcd5-4b4c-9c22-14bca50fc0e8",
                                                "sense_id": "56a7b8b1-ed2a-33ec-b6f7-5805e69f3976",
                                                "text": "Cet homme ne prend pas assez d’exercice, il est trop sédentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1be48557-fc57-32cb-b4e1-e7d45e2eeeb3",
                                        "entry_id": "00aec91e-b5c3-3113-b4d2-f43080f17465",
                                        "glosses": [
                                            "Qui reste presque toujours dans son lieu d’habitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8964df9-08d9-4944-ac93-3422f946d8c9",
                                                "sense_id": "1be48557-fc57-32cb-b4e1-e7d45e2eeeb3",
                                                "text": "Il est devenu, depuis quelque temps, fort sédentaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3af018-6af1-3ec1-92dd-35f06660080c",
                                        "entry_id": "00aec91e-b5c3-3113-b4d2-f43080f17465",
                                        "glosses": [
                                            "Fixe, attaché à un lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18290d63-9750-4918-949a-477917b45f1f",
                                                "sense_id": "3d3af018-6af1-3ec1-92dd-35f06660080c",
                                                "text": "Philippe le Bel rendit le parlement sédentaire."
                                            },
                                            {
                                                "example_id": "58a9bfe9-51e6-4b09-a121-154084dffc8f",
                                                "sense_id": "3d3af018-6af1-3ec1-92dd-35f06660080c",
                                                "text": "Vie sédentaire, emploi, profession sédentaire, Vie qui se passe, emploi, profession qui s’exerce dans un même lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18f46c86-d90a-3805-b646-f0f0b45ee140",
                                        "entry_id": "00aec91e-b5c3-3113-b4d2-f43080f17465",
                                        "glosses": [
                                            "Se dit d’un peuple qui a un lieu d’habitation fixe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
