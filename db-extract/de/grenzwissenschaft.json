                "senses": [
                    {
                        "sense_id": "96800bb2-f823-37ee-9aaa-64372b1f5c8b",
                        "entry_id": "87347266-9af3-3077-ab00-7662d1d02ace",
                        "glosses": [
                            "Wissenschaft mit Erkenntnisansprüchen, die sich am Rande oder außerhalb der akademischen Wissenschaften befinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae99faf-ab69-4e95-acfd-8ed3428164a0",
                                "sense_id": "96800bb2-f823-37ee-9aaa-64372b1f5c8b",
                                "text": "„Seit den achtziger Jahren hat sich das Interesse an Grenzwissenschaften und New Age vom Rand in die Mitte der Gesellschaft vorgearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d58d583b-2c9d-3ea3-bb4d-ba601d64d578",
                        "entry_id": "87347266-9af3-3077-ab00-7662d1d02ace",
                        "glosses": [
                            "Wissenschaft, die sowohl zu dem einen als auch zu dem anderen von zwei benachbarten Wissenschaftsbereichen gehören kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9b156b-0867-49d6-ad1b-a9d13c30369c",
                                "sense_id": "d58d583b-2c9d-3ea3-bb4d-ba601d64d578",
                                "text": "Die Biophysik ist eine Grenzwissenschaft zwischen Biologie und Physik."
                            },
                            {
                                "example_id": "827ee702-fb94-4bc3-b1da-1ed4e74a6635",
                                "sense_id": "d58d583b-2c9d-3ea3-bb4d-ba601d64d578",
                                "text": "„Die Phänologie ist demnach eine Grenzwissenschaft zwischen Meteorologie bzw. Klimatologie einerseits und Biologie andererseits.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "988a01bb-4a9a-3d33-98ac-9f7134de9691",
                        "entry_id": "87347266-9af3-3077-ab00-7662d1d02ace",
                        "glosses": [
                            "Wissenschaft, die den Einfluss von Grenzen auf Wirtschaft und die Entwicklung von Räumen untersucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00bcd46f-4f7a-4865-afcc-63fcb5007337",
                                "sense_id": "988a01bb-4a9a-3d33-98ac-9f7134de9691",
                                "text": "„Das ‚Colegio de la Frontera Norte‘ widmet sich ausschließlich der ‚Grenzwissenschaft‘: dem Thema Grenze in Sprache, Film, Literatur und Wirtschaft.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
