        "fr-extract.jsonl": [
            {
                "entry_id": "0128d32c-7e96-3fad-99f9-d0a037159d09",
                "word": "noctambulisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e30d127a-e680-4366-9a06-b9da990de2eb",
                        "entry_id": "0128d32c-7e96-3fad-99f9-d0a037159d09",
                        "tags": [
                            "plural"
                        ],
                        "form": "noctambulismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0a3b2fe-e344-38fc-89e5-16e929bafa18",
                        "entry_id": "0128d32c-7e96-3fad-99f9-d0a037159d09",
                        "glosses": [
                            "Fait de marcher en dormant sans en garder le souvenir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "14915833-acde-3ff8-874a-7342d8d65fa8",
                        "entry_id": "0128d32c-7e96-3fad-99f9-d0a037159d09",
                        "glosses": [
                            "Manière d’être, habitude de celui qui est noctambule."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "af614a2e-59b8-4fe7-80c4-7c9a4f227c58",
                                "sense_id": "14915833-acde-3ff8-874a-7342d8d65fa8",
                                "text": "Un goût comique du noctambulisme anime toutes sorte de fêtards départementaux qui rêvent de Montmartre […]"
                            },
                            {
                                "example_id": "9c1f2497-1669-408c-ae11-1069ea86f0bb",
                                "sense_id": "14915833-acde-3ff8-874a-7342d8d65fa8",
                                "text": "Cela reste inséparable pour moi du temps où j’aimais avec passion la danse, commençais d’être anglomane, pratiquais furieusement le noctambulisme ; c’est-à-dire peu après la guerre, à cette mémorable époque des surprise-parties qui n’est pas près d’être oubliée par ceux qui l’ont vécue, je crois."
                            },
                            {
                                "example_id": "6f9c8e91-a859-45f4-9702-ca3370ce4739",
                                "sense_id": "14915833-acde-3ff8-874a-7342d8d65fa8",
                                "text": "De même que l’érotisme est absent des plages où tout le monde est nu, le noctambulisme avait les jambes coupées sur ces promenades où l’on pouvait croiser, au-delà de minuit, des nourrissons vêtus comme des infantes."
                            }
                        ]
                    }
                ],
