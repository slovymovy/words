        "nl-extract.jsonl": [
            {
                "entry_id": "30d7882c-2382-3744-b3ba-a5faeb154e2a",
                "word": "tromgeroffel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "af2106e6-06d4-3e9f-86ea-84a8988de55c",
                        "entry_id": "30d7882c-2382-3744-b3ba-a5faeb154e2a",
                        "glosses": [
                            "het lawaai dat ontstaat door hard en snel op een trommel te slaan, meestal met de bedoeling oom aandacht te trekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7166544-6afa-41d3-9bfa-101ff38ebdf2",
                                "sense_id": "af2106e6-06d4-3e9f-86ea-84a8988de55c",
                                "text": "Om klokslag 16.00 uur lokale tijd werd de minuut stilte ingeluid met tromgeroffel. Na de minuut stilte klonk het volkslied, zo meldden Britse media."
                            }
                        ]
                    },
                    {
                        "sense_id": "9b0ba2f3-52eb-3e7c-a3bb-eb46e79e7086",
                        "entry_id": "30d7882c-2382-3744-b3ba-a5faeb154e2a",
                        "glosses": [
                            "met (te) veel lawaai, bombarie en aandachttrekkerij iets bekend maken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7b02b84d-36b0-4e68-89f1-7e3738283a9b",
                                "sense_id": "9b0ba2f3-52eb-3e7c-a3bb-eb46e79e7086",
                                "text": "Nú al met tromgeroffel bekend maken dat aan ’het theezakje’ wordt gewerkt, wekt bij menige patiënt de indruk dat het er morgen is. Maar dat is niet zo. Op zijn vroegst beginnen pas over vijf, zes jaar studies met patiënten."
                            },
                            {
                                "example_id": "54667de7-d98d-4c59-a555-11f23c396662",
                                "sense_id": "9b0ba2f3-52eb-3e7c-a3bb-eb46e79e7086",
                                "text": "Een bittere pil voor Sneijder, die begin augustus nog met klaroengeschal en tromgeroffel werd binnengehaald door OGC Nice, dat ook flink in Sneijder investeerde."
                            }
                        ]
                    }
                ],
