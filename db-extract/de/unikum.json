                                "sense_id": "14ad05c0-a9d9-3c69-ac1a-41609d5960df",
                                "text": "Dieser Roman ist ein Unikum im Science-Fiction-Genre."
                            },
                            {
                                "example_id": "4c935feb-909a-4c29-887e-20f07117f2a0",
                                "sense_id": "14ad05c0-a9d9-3c69-ac1a-41609d5960df",
                                "text": "„Einem Zufall ist es zu verdanken, dass sich das Duderstädter Unikum erhalten konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "74a5b175-aa39-3d28-96ac-83496d8cecd6",
