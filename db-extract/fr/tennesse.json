                        "source_entry_id": "664fe0bf-ae7a-3a14-aff4-0bf306cd9444",
                        "source_sense_id": "09e0cbd5-7fcb-3a56-a519-0e7e5c8ab8c6",
                        "source_sense_description": "Élément 117",
