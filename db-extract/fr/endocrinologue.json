                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ab03d2d-6018-4aec-a577-092442ef3e7b",
                        "entry_id": "147a8a39-0c67-3d5d-a742-8c6f6707d78d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "endocrinologues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0919162-e197-3ac3-afeb-0df0d06acd9c",
                        "entry_id": "147a8a39-0c67-3d5d-a742-8c6f6707d78d",
                        "glosses": [
                            "Spécialiste de l'endocrinologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b995f1d2-3369-4ddc-b398-691343aec268",
                                "sense_id": "e0919162-e197-3ac3-afeb-0df0d06acd9c",
                                "text": "Je ne parlerai donc par conséquent qu’en tant qu’endocrinologue de cette question du transsexualisme."
                            },
                            {
                                "example_id": "3a84df5c-5051-4c35-9b8b-e2f67d6325ef",
                                "sense_id": "e0919162-e197-3ac3-afeb-0df0d06acd9c",
                                "text": "L’infertilité (et non la stérilité, l’impossibilité définitive de procréer) se définit par « l’absence de survenue d’une grossesse après plus de deux ans de rapports sexuels réguliers et non protégés », rappelle le Dʳ Charlotte Demerlé-Roux, endocrinologue, dans son guide La PMA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10e37626-fb19-4568-9b5a-4c6e66d666a9",
                        "source_entry_id": "147a8a39-0c67-3d5d-a742-8c6f6707d78d",
                        "source_sense_id": "e0919162-e197-3ac3-afeb-0df0d06acd9c",
                        "target_lang_word": "endocrinologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endocrinologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                        "entry_id": "ab5b4fd2-afea-3db5-a016-ab0df4d9a1fa",
                                        "glosses": [
                                            "A person who is skilled at, or practices, endocrinology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7522d6e-6222-4c23-8b3a-f9229be0a33a",
                                                "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                                "text": "Some endocrinologists argue that our core understanding of T, as a fundamentally male sex hormone, is inherently flawed."
                                            },
                                            {
                                                "example_id": "132e5498-f494-432e-9f41-fe0239cce136",
                                                "sense_id": "5995e2b0-ab65-30d9-8918-0d5ae47dba4f",
                                                "text": "They standardize the terminology that professionals should use with patients and reaffirms the role that an endocrinologist should play in the patient’s broader individualized care."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9fd5d0b-5a1d-43a9-8b58-d25610808755",
