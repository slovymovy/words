        "fr-extract.jsonl": [
            {
                "entry_id": "ab651557-2a78-3589-a4a8-f6ab881a5342",
                "word": "bas-relief",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b9cbd957-6e67-4438-9790-a76d8f136a58",
                        "entry_id": "ab651557-2a78-3589-a4a8-f6ab881a5342",
                        "tags": [
                            "plural"
                        ],
                        "form": "bas-reliefs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                        "entry_id": "ab651557-2a78-3589-a4a8-f6ab881a5342",
                        "glosses": [
                            "Œuvre sculptée sur un fond dont elle se détache créant une faible protubérance, un faible relief."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d492ef-127a-42eb-9f98-35898575db40",
                                "sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                                "text": "Ce tombeau est un monument fort intéressant, bien que la figure du personnage, traitée en bas-relief, soit médiocre ; […]."
                            },
                            {
                                "example_id": "ea9796ce-9777-4a6b-919c-c1ae26195160",
                                "sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                                "text": "Les figures debout en bas-reliefs, qui sont comme incrustées autour de la crypte, sont tout à fait primitives, dignes du Xᵉ siècle, apparence égyptienne, jambes raides, pas de poitrine, tête tournée de côté, maladroitement, avec une expression presque grotesque."
                            },
                            {
                                "example_id": "79e88924-fb80-4398-90c1-2cf7230a7fb9",
                                "sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                                "text": "Il existe en particulier au château de Bouesse (Indre) un bas-relief encastré dans une porte, qui reproduit trait pour trait celui de l’hôtel de ville de Bourges : […]."
                            },
                            {
                                "example_id": "4f40ddf5-8f85-45c4-b87e-c040c9ab6323",
                                "sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                                "text": "À l’intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c04de9b-c73a-426d-93ab-fd97a75f6438",
                        "source_entry_id": "ab651557-2a78-3589-a4a8-f6ab881a5342",
                        "source_sense_id": "6fab87c5-b289-345b-a415-344b8c83a92f",
                        "source_sense_description": "Œuvre sculptée",
                        "target_lang_word": "Basrelief",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basrelief",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13ceb4eb-784d-3505-9034-7662e482df5c",
                                        "entry_id": "8eb390e1-86b6-344a-939c-21a8c7b3bd09",
                                        "glosses": [
                                            "flaches Relief"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecefd5e-e9a6-4fe2-aa11-14251f1845e5",
                                                "sense_id": "13ceb4eb-784d-3505-9034-7662e482df5c",
                                                "text": "„Mein lieber Bruder Giovanni machte mir einen herrlichen Onyx zum Geschenk, eine Gemme mit dem Basrelief einer schwimmenden Venus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
