    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f271ee4e-84ee-3d04-8978-ce70af45702c",
                    "sense_definition": "het thema of de zaak waarover men spreekt, schrijft of denkt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inhoud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>onderwerp</w> van de vergadering was de nieuwe begroting voor volgend jaar.",
                            "target_lang_translations": {
                                "en": "The <w>subject</w> of the meeting was the new budget for next year.",
                                "ru": "<w>Темой</w> собрания был новый бюджет на следующий год."
                            }
                        },
                        {
                            "text": "Zij besloten om van <w>onderwerp</w> te veranderen toen de sfeer ongemakkelijk werd.",
                            "target_lang_translations": {
                                "en": "They decided to change the <w>topic</w> when the atmosphere became uncomfortable.",
                                "ru": "Они решили сменить <w>тему</w>, когда атмосфера стала неловкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "thema",
                        "punt",
                        "topic"
                    ],
                    "common_phrases": [
                        "van onderwerp veranderen",
                        "het onderwerp aansnijden",
                        "bij het onderwerp blijven"
                    ],
                    "target_lang_definitions": {
                        "en": "the theme or matter about which one speaks, writes, or thinks",
                        "ru": "тема или вопрос, о котором говорят, пишут или думают"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subject",
                                "target_lang_sense_clarification": "the main topic of a discussion or work"
                            },
                            {
                                "target_lang_word": "topic",
                                "target_lang_sense_clarification": "a specific matter being discussed"
                            },
                            {
                                "target_lang_word": "theme",
                                "target_lang_sense_clarification": "a recurring idea or subject in an artistic work"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "основной предмет обсуждения или произведения"
                            },
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "то, на что направлена мысль или разговор"
                            },
                            {
                                "target_lang_word": "вопрос",
                                "target_lang_sense_clarification": "дело или проблема для обсуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee66c55-1232-35ad-9da6-7357b35aa246",
                    "sense_definition": "het zinsdeel dat aangeeft wie of wat de handeling verricht of over wie of wat iets wordt gezegd",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zin 'De hond blaft' is 'de hond' het <w>onderwerp</w>.",
                            "target_lang_translations": {
                                "en": "In the sentence 'The dog barks', 'the dog' is the <w>subject</w>.",
                                "ru": "В предложении «Собака лает» «собака» является <w>подлежащим</w>."
                            }
                        },
                        {
                            "text": "<w>Onderwerp</w> en persoonsvorm moeten in een Nederlandse zin altijd met elkaar overeenstemmen.",
                            "target_lang_translations": {
                                "en": "The <w>subject</w> and the finite verb must always agree with each other in a Dutch sentence.",
                                "ru": "<w>Подлежащее</w> и личная форма глагола в нидерландском предложении всегда должны согласовываться друг с другом."
                            }
                        }
                    ],
                    "synonyms": [
                        "subject"
                    ],
                    "antonyms": [
                        "voorwerp"
                    ],
                    "common_phrases": [
                        "grammaticaal onderwerp",
                        "onderwerp van de zin"
                    ],
                    "target_lang_definitions": {
                        "en": "the part of a sentence that indicates who or what performs the action or about whom or what something is said",
                        "ru": "часть предложения, которая указывает, кто или что совершает действие или о ком или чем что-то говорится"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subject",
                                "target_lang_sense_clarification": "the grammatical part of a sentence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подлежащее",
                                "target_lang_sense_clarification": "главный член предложения в грамматике"
                            },
                            {
                                "target_lang_word": "субъект",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ]
                    }
                }
            ]
        },
