                        "sense_id": "60312b9a-9589-3756-82cc-abe368c73543",
                        "entry_id": "f4e6895a-f892-3897-8182-5697e822d497",
                        "glosses": [
                            "iets wat gemaakt is door breien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8556ed80-5fc9-47a6-afff-c74341358496",
                                "sense_id": "60312b9a-9589-3756-82cc-abe368c73543",
                                "text": "Goed gebreid breigoed heeft zijn (geiten)wollige status al lang afgezworen en komt nu ook in stijlvolle ontwerpen en kleuren die perfect bij het huidige modebeeld aansluiten. Het verwarmingselement is gelukkig wel gewoon gebleven."
                            },
                            {
                                "example_id": "1c4ef4fd-a321-40f4-b48c-682c0cb74273",
                                "sense_id": "60312b9a-9589-3756-82cc-abe368c73543",
                                "text": "Conny Groenewegen is gefascineerd door breigoed. Ingenieus breigoed. Perfect gebreide ronde gaten in een jurk van tricotstof die alle kanten oprekt."
                            },
                            {
                                "example_id": "d526876a-f3ad-48d8-ac21-6986dc276577",
                                "sense_id": "60312b9a-9589-3756-82cc-abe368c73543",
                                "text": "In 1972, op haar 24ste, werd ze in Parijs aangenomen door Yves Saint Laurent. Als stille kracht stelde ze kledingcombinaties voor en ontwierp breigoed en sieraden."
                            }
                        ]
                    }
