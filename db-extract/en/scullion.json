                                "example_id": "514d707e-8fcd-447a-9ef0-6cf5823ebe4a",
                                "sense_id": "c40c7d57-f3f9-342c-935f-661f8956578d",
                                "text": "\"How now, you scullions and cullions: bring hither a pair of cow's hooves to out face this contumelious caitiff.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "38fc7a11-51fa-3cb4-9de4-def3357c7419",
