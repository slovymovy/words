                                "target_senses": [
                                    {
                                        "sense_id": "3cea1dab-2c51-3c71-884e-cb7abe2ef160",
                                        "entry_id": "542f825d-0bfe-3b11-83ef-f6ebf348375f",
                                        "glosses": [
                                            "A plant referred to in the story of Moses as growing along the banks of the Nile, which is believed to be the papyrus (Cyperus papyrus)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67274717-9fbb-3d92-bdb1-c75131922e74",
                                        "entry_id": "542f825d-0bfe-3b11-83ef-f6ebf348375f",
                                        "glosses": [
                                            "Any of various tall, narrow-leaved plants growing near water, especially cattail or reedmace, in the genus Typha."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8961100f-1db9-3c9c-8666-b159675eb9f8",
                                        "entry_id": "542f825d-0bfe-3b11-83ef-f6ebf348375f",
                                        "glosses": [
                                            "Sedges in the genera Bolboschoenus or Schoenoplectus (formerly considered Scirpus), having clusters of spikelets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15cd8fbd-0e40-3596-95b1-472af7c10af3",
                                        "entry_id": "542f825d-0bfe-3b11-83ef-f6ebf348375f",
                                        "glosses": [
                                            "Any of various reed-like plants growing near water, especially Typha domingensis and Typha orientalis; cumbungi, wonga."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055e0865-82b2-4d5c-bb1b-b815d1f0b208",
                                                "sense_id": "15cd8fbd-0e40-3596-95b1-472af7c10af3",
                                                "text": "Explorers Eyre, Kreft, and George Moore all refer to the importance of bulrush starch in different parts of the continent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b3bde40-de93-4bc2-abd3-658150c7116f",
                        "source_entry_id": "94f84990-d639-33e3-99fd-287690c5d620",
                        "source_sense_id": "493475ee-0db7-3c6d-8a7e-063c7dd7954e",
                        "source_sense_description": "ein Riedgras, eine grasartige Pflanze der Gattung Scirpus",
                        "target_lang_word": "камыш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "камыш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41d7577f-8de3-3e0b-84ea-1b8cd4b83314",
                                        "entry_id": "8a3ed53c-1ee6-33e2-b703-7992749c87b0",
                                        "glosses": [
                                            "ботан. многолетнее, реже однолетнее прибрежно-водное растение семейства осоковых (Scirpus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8282e1ab-7300-4b01-b3cd-4b3b3d6b0080",
                                                "sense_id": "41d7577f-8de3-3e0b-84ea-1b8cd4b83314",
                                                "text": "Терек, отделяющий казаков от горцев, течёт мутно и быстро, но уже широко и спокойно, постоянно нанося сероватый песок на низкий, заросший камышом правый берег и подмывая обрывистый, хотя и не высокий левый берег с его корнями столетних дубов, гниющих чинар и молодого подроста."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5072e2d3-da17-3a0e-9809-c00d6c6e282d",
                                        "entry_id": "8a3ed53c-1ee6-33e2-b703-7992749c87b0",
                                        "glosses": [
                                            "разг. то же, что рогоз (обиходное название Typha)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef9f82c-b837-4f86-8c59-11b828a96546",
                                                "sense_id": "5072e2d3-da17-3a0e-9809-c00d6c6e282d",
                                                "text": "Пышно разрастаются болотные травы: высокие дудки, белые воздушные зонтики (их настоем отравили Сократа), широкие, разлапистые листья, то оранжерейно-нежные, то тропически зелёные, сердитая голубая осока, а дальше, там, где тростинки зелены уже просто до черноты, державным строем стоят вокруг какого-то окна или особо опасной топи камыши в коричневых меховых опушках."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "камыш",
                                "target_lang_code": "ru",
