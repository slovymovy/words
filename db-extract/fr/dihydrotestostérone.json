                        "glosses": [
                            "Métabolite actif de la testostérone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dcaf901-3fff-4ebb-b8c0-0fb1eb2257e0",
                                "sense_id": "6662581a-bb2f-3e90-a623-66edc83166ec",
                                "text": "Seules la testostérone et la dihydrotestostérone sont des androgènes actifs qui se lient spécifiquement aux récepteurs des androgènes."
                            },
                            {
                                "example_id": "57ab83d3-7c85-495e-b567-389882845dd3",
                                "sense_id": "6662581a-bb2f-3e90-a623-66edc83166ec",
                                "text": "De même, spontanément, les OGE vont évoluer dans le sens féminin : ils ne se masculiniseront qu'en présence de dihydrotestostérone, provenant de la transformation de la testostérone par la 5α-réductase."
                            }
                        ]
                    }
