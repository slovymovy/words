                "senses": [
                    {
                        "sense_id": "722da9f4-c5c3-3b1e-bbfe-5aa8beb75366",
                        "entry_id": "770fd662-cdd1-3524-8b7d-590af1f1733a",
                        "glosses": [
                            "Wissenschaftler, der sich mit Hieroglyphen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce618dd1-8e31-4d5c-b2a5-b225c2fe3476",
                                "sense_id": "722da9f4-c5c3-3b1e-bbfe-5aa8beb75366",
                                "text": "„Wir können nur hoffen, dass ein Hieroglyphenforscher eines Tages das Geheimnis dieses Zeichens klären kann.“"
                            },
                            {
                                "example_id": "3c4a02ff-54c4-4c02-90c3-632a1fc9bbe5",
                                "sense_id": "722da9f4-c5c3-3b1e-bbfe-5aa8beb75366",
                                "text": "„Der Hieroglyphenforscher ließ damals die Ausstellungssäle mit farbenfrohen Fantasieszenen, altägyptischen Gottheiten und vor allem seinen eigenen Vorstellungen vom Lauf der Geschichte am Nil ausmalen: Die Besucher sollten sich ins Pharaonenreich versetzt fühlen.“"
                            },
                            {
                                "example_id": "2e785110-d9b1-4675-bd5c-9cfdfcf4e59e",
                                "sense_id": "722da9f4-c5c3-3b1e-bbfe-5aa8beb75366",
                                "text": "„Gleich am ersten Tag ging es nach Figeac, wo die Mittelfranken mit einem kleinen Zug die Stadt kennenlernten, eine Kaffeepause einlegten und das Champollion-Museum besuchten, das an den Ägyptologen, Hieroglyphenforscher und Sohn der Stadt erinnert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
