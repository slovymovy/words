                                "target_lang_word": "а́втор",
                                "target_lang_sense_clarification": "создатель"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kurucu",
                                "target_lang_sense_clarification": "bir yapıyı veya ilkeyi oluşturan kişi"
                            },
                            {
                                "target_lang_word": "biçimlendiren",
                                "target_lang_sense_clarification": "şekil veya yön veren kişi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制定者",
                                "target_lang_sense_clarification": "指规则或政策的创建者"
