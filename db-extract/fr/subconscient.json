                                        "glosses": [
                                            "im Unterbewusstsein (vorhanden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d637b93-ba8c-4159-bd7d-f9ebafaee593",
                                                "sense_id": "9bdf4451-3d92-39ab-80dc-731c57caeb43",
                                                "text": "Ob bewusste Ernährung oder umweltbewusstes Verhalten, ob unterbewusste Wahrnehmung oder unbewusste Fehler: Jeder Mensch setzt sich ständig mit seinem Bewusstsein auseinander."
                                            },
                                            {
                                                "example_id": "64f09ddf-fb3b-42ed-9f80-60f6f30273a0",
                                                "sense_id": "9bdf4451-3d92-39ab-80dc-731c57caeb43",
                                                "text": "Unterbewusste Handlungen/Prägungen sorgen dafür, dass wir tagein tagaus unseren Alltag bewältigen können, weil unser Gehirn gewisse Abläufe so verinnerlicht hat, dass wir nicht mehr großartig darüber nachdenken müssen sondern es einfach tun, …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
