                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a5a5a4c-2f17-420d-aece-cb1d1dc4ea73",
                                                "sense_id": "c2792393-4321-3fde-943a-0741df4752f1",
                                                "text": "HGM’s writers have spent time in the grindiest of grindy Korean and Japanese free-to-plays, but Free Realms is something new and different and better."
                                            },
                                            {
                                                "example_id": "41ad7029-eb48-4dac-ab16-958e90fec4fc",
                                                "sense_id": "c2792393-4321-3fde-943a-0741df4752f1",
                                                "text": "Hit the Flash games, the demos, and the free-to-plays until you start to get your head wrapped around why people like them."
                                            },
                                            {
                                                "example_id": "11057411-b362-49f4-9ade-c685bbae708f",
                                                "sense_id": "c2792393-4321-3fde-943a-0741df4752f1",
                                                "text": "She was often up late, playing her futile Free-to-Plays."
