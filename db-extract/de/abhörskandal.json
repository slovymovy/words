                "senses": [
                    {
                        "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                        "entry_id": "3f49a2e1-6c77-33f7-af39-2e4964e96f1b",
                        "glosses": [
                            "durch Aufdeckung des illegalen Abhörens der Gespräche von (prominenten) Personen ausgelöstes Ärgernis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8644643c-eb37-41a1-8e51-3fc78fbe4a4f",
                                "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                                "text": "Die Demonstrationen sind die ersten flächendeckenden gegen den Abhörskandal in Deutschland."
                            },
                            {
                                "example_id": "074642b8-5ac7-476a-a7ec-d90b55336443",
                                "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                                "text": "Rot-Grün freut sich über den Abhörskandal, der lenkt von eigenen Schwächen ab."
                            },
                            {
                                "example_id": "1b4770c9-3c96-446a-9b80-04ab94bc4fd6",
                                "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                                "text": "Die frühere Chefredakteurin aus dem Murdoch-Imperium, Rebekah Brooks, hat nach ihrem Rücktritt infolge des Abhörskandals eine Abfindung in Millionenhöhe erhalten."
                            },
                            {
                                "example_id": "afe6a138-e352-4d1a-ac28-ce6683b8a20d",
                                "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                                "text": "Vor einem Londoner Kriminalgericht begann gestern, Montag, der erste Prozess im Abhörskandal um die inzwischen eingestellte Boulevardzeitung „News of the World“."
                            },
                            {
                                "example_id": "e1330dfa-8385-44a7-b59c-b20d7efe5b1a",
                                "sense_id": "8e8d51f1-777e-3f01-a00d-a38d79d5f358",
                                "text": "Der Abhörskandal war schon vor einigen Wochen aufgeflogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
