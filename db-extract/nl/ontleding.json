                        "source_sense_description": "(wetenschap) onderzoek door een groot probleem in kleinere delen de verdelen",
                        "target_lang_word": "analysis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analysis",
