                    "sense_id": "22ac9d95-296e-39d3-9393-1c2ec81bfc0e",
                    "sense_definition": "żyjący zgodnie z nakazami swojej religii, gorliwie praktykujący wiarę",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religijnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pani Janeczka jest bardzo <w>pobożna</w>, więc codziennie rano chodzi na mszę do kościoła.",
                            "target_lang_translations": {
                                "en": "Mrs. Janeczka is very <w>pious</w>, so she goes to church for morning Mass every day."
                            }
                        },
                        {
                            "text": "Mój dziadek był niezwykle <w>pobożnym</w> człowiekiem i zawsze pamiętał o wieczornej modlitwie.",
                            "target_lang_translations": {
                                "en": "My grandfather was an extremely <w>devout</w> man and always remembered his evening prayers."
                            }
                        }
                    ],
                    "synonyms": [
                        "bogobojny",
                        "nabożny",
                        "religijny",
                        "świątobliwy",
                        "wierzący"
                    ],
                    "antonyms": [
                        "bezbożny",
                        "niewierzący"
                    ],
                    "common_phrases": [
                        "pobożny człowiek",
                        "pobożna niewiasta",
                        "pobożny chrześcijanin"
                    ],
                    "target_lang_definitions": {
                        "en": "living according to religious precepts, devoutly practicing one's faith"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pious",
                                "target_lang_sense_clarification": "deeply religious and practicing faith"
                            },
                            {
                                "target_lang_word": "devout",
                                "target_lang_sense_clarification": "committed to a religious lifestyle"
                            },
                            {
                                "target_lang_word": "god-fearing",
                                "target_lang_sense_clarification": "earnestly religious and moral"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "825b9a88-38e5-37b3-ae1e-beeeafc1a8fe",
                    "sense_definition": "będący świadectwem lub wyrazem głębokiej wiary i religijności",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religijnosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zgromadzeni wierni zaczęli śpiewać <w>pobożną</w> pieśń ku czci świętego patrona.",
                            "target_lang_translations": {
                                "en": "The gathered faithful began to sing a <w>devotional</w> hymn in honor of the patron saint."
                            }
                        },
                        {
                            "text": "Jej cicha modlitwa była <w>pobożnym</w> westchnieniem o zdrowie dla całej rodziny.",
                            "target_lang_translations": {
                                "en": "Her quiet prayer was a <w>pious</w> sigh asking for health for the whole family."
                            }
                        }
                    ],
                    "synonyms": [
