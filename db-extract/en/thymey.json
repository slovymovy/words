                        "glosses": [
                            "Resembling or characteristic of the herb thyme; having the aroma or flavour of thyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84dfc1f0-0d3b-4636-8741-e753aacab6b3",
                                "sense_id": "43ac2c30-a1b5-3ee1-b029-f33947bb86aa",
                                "text": "All of us have read, no doubt, of the honey of Mount Hybla, of which the thymey flavour has been so much extolled by the ancient poets […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d81bf3f0-76c8-32db-82d1-67e240902313",
                        "entry_id": "4c24088f-4d5f-338c-90f1-cf6f094b6e81",
                        "glosses": [
                            "Covered with or abounding in thyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a34aa7-4e52-4ac7-82ce-2338638ae648",
                                "sense_id": "d81bf3f0-76c8-32db-82d1-67e240902313",
                                "text": "What time the mighty moon was gathering light\nLove paced the thymy plots of Paradise,\nAnd all about him roll'd his lustrous eyes;"
                            },
                            {
                                "example_id": "57f1542d-862e-45b3-bcc6-829206c92549",
                                "sense_id": "d81bf3f0-76c8-32db-82d1-67e240902313",
                                "text": "Once in the wind of morning\nI ranged the thymy wold;\nThe world-wide air was azure\nAnd all the brooks ran gold."
                            },
                            {
                                "example_id": "015253bb-a9e8-4f99-ab08-04f747a71c5b",
                                "sense_id": "d81bf3f0-76c8-32db-82d1-67e240902313",
                                "text": "The happy land of Narnia—Narnia of the heathery mountains and the thymy downs […]"
                            }
                        ]
                    }
                ],
