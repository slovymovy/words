                                        "sense_id": "d12997e2-8935-3a4c-8daf-9cd64be3555e",
                                        "entry_id": "94f86a4d-d5a9-374e-82d6-c00847033bdc",
                                        "glosses": [
                                            "Made of silver; resembling or characteristic of silver; silvery."
                                        ],
                                        "tags": [
                                            "literary",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99a9f94f-cb9b-441a-aacc-1a14ce003044",
                                                "sense_id": "d12997e2-8935-3a4c-8daf-9cd64be3555e",
                                                "text": "But, leaving novelists alone, on the whole we find in real life that if speech is silvern, silence is essentially golden, and that more harm is done by saying too much than by saying too little; above all, that infinite mischief arises by not letting sleeping dogs lie."
                                            },
                                            {
                                                "example_id": "0de2ddc8-a74d-4e8b-9765-39c26b5bf34a",
                                                "sense_id": "d12997e2-8935-3a4c-8daf-9cd64be3555e",
                                                "text": "I know a pool, where shadows fall\nFrom fir-trees, melancholy tall,\nThat dream and quiver round the rim,\nAnd in the molten centre swim,\nWhere taper tops do all unite\nBemirrored in its silvern light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
