                        "examples": [
                            {
                                "example_id": "4fe6450e-57c9-45aa-9334-4b64696c8b0e",
                                "sense_id": "a416bd91-136d-37b4-bd4a-23d770abf30a",
                                "text": "„Geen weer voor een christenmens,\" bromt de timmermansbaas die het toezicht heeft bij de bouw van het enige fregat dat op stapel staat."
                            },
                            {
                                "example_id": "6cb437a8-7946-4974-ad9d-70c4a7b48817",
                                "sense_id": "a416bd91-136d-37b4-bd4a-23d770abf30a",
                                "text": "In en om het fregat zijn de arbeiders met woedende ijver aan de arbeid, zij hameren, zagen, kloven en kloppen en zo nu en dan gluurt de timmermansbaas schichtig over het want en kijkt belangstellend naar zijn twee machtige gebieders, die door de kleine man in de grijze rok in een paar bange, gedweeë subalternen zijn veranderd."
                            }
                        ]
                    },
