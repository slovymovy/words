                    {
                        "sense_id": "302d340c-aed0-302e-8d4c-3c5fa1b37278",
                        "entry_id": "f3203bb5-4211-3f5a-b342-5e576aad0498",
                        "glosses": [
                            "een aantal reclamespotjes die achterelkaar worden uitgezonden voor, na of tijdens een televisieuitzending"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7684e15-4ba8-4c55-be83-978e31d59b17",
                                "sense_id": "302d340c-aed0-302e-8d4c-3c5fa1b37278",
                                "text": "Die sponsorvermelding aan het begin van een programma is volgens Europese richtlijnen verplicht. Na een reclameblok en aan het eind van het programma moet de vermelding worden herhaald. Bij Goede Tijden, Slechte Tijden krijgen kijkers bijvoorbeeld de melding \"Dit programma bevat product placement\" te zien."
                            },
                            {
                                "example_id": "89501930-8d49-411a-8170-f2fcefeab8d1",
                                "sense_id": "302d340c-aed0-302e-8d4c-3c5fa1b37278",
                                "text": "Ook veel wedstrijden werden met vertraging uitgezonden en met bijna elke tien minuten een reclameblok ertussen. De sluitingsceremonie zondagavond werd ruim een uur later uitgezonden dan in de rest van de wereld. In plaats daarvan kregen kijkers de eerste aflevering van een nieuwe serie voorgeschoteld."
                            }
                        ]
                    }
