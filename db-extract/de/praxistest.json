                "senses": [
                    {
                        "sense_id": "2436ca4a-277a-314d-bb82-256c587987ed",
                        "entry_id": "88f6bbe3-7671-31d7-8fd2-fa5be98838ab",
                        "glosses": [
                            "praktische Prüfung einer Eigenschaft oder Fähigkeit, in der Realität (unter Feldbedingungen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0dd147-e014-45aa-aa7f-2b068042861f",
                                "sense_id": "2436ca4a-277a-314d-bb82-256c587987ed",
                                "text": "„Die Servicezeit wollte es genau wissen und unterzog drei Eismaschinen einem Praxistest.“"
                            },
                            {
                                "example_id": "558f3ef6-6e97-4ed7-8fa7-62d407be5fb0",
                                "sense_id": "2436ca4a-277a-314d-bb82-256c587987ed",
                                "text": "„Während des Praxistests wurden die Teilnehmer regelmäßig zu ihren Erfahrungen befragt und ihre Verbrauchsdaten fortlaufend ausgewertet.“"
                            },
                            {
                                "example_id": "3be19279-3afa-4e28-b11a-005ba7469709",
                                "sense_id": "2436ca4a-277a-314d-bb82-256c587987ed",
                                "text": "„Der klassische Gittermast mit den ausgestellten Füßen und den markanten Auslegern dagegen hat den Praxistest längst bestanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
