                        "target_lang_word": "紫翅椋鸟",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e786ea87-2035-496c-bae3-fa1839683bae",
                        "source_entry_id": "d0e31f69-5235-3c8e-b74b-14a3d7569bea",
                        "source_sense_id": "010021cc-b0dd-3b77-b101-24775b02e671",
                        "source_sense_description": "Sturnus vulgaris, een middelgrote zangvogel",
                        "target_lang_word": "Star",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Star",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a9fc948-ffd0-38ac-80cc-07f9d6bc01a3",
                                        "entry_id": "4933978a-4692-323c-bd24-e367de535c34",
                                        "glosses": [
                                            "ein Singvogel der gleichnamigen Familie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7873770a-b7b0-485d-bda2-3da8f725faef",
                                                "sense_id": "2a9fc948-ffd0-38ac-80cc-07f9d6bc01a3",
                                                "text": "Stare fressen gerne Kirschen."
                                            },
                                            {
                                                "example_id": "2fd6829c-a4c2-4378-8312-3eca55da48c6",
                                                "sense_id": "2a9fc948-ffd0-38ac-80cc-07f9d6bc01a3",
                                                "text": "„Die Stare lärmten, die Schwalben zwitscherten, der Wendehals saß vor seinem Loch im Birnbaum und lachte.“"
                                            },
                                            {
                                                "example_id": "b0ee0b44-4e85-47c5-a869-569d000a972f",
                                                "sense_id": "2a9fc948-ffd0-38ac-80cc-07f9d6bc01a3",
                                                "text": "„Eine der wenigen Begebenheiten, die den beschaulichen Inselalltag aus dem Rhythmus brachten, war der Zug der Stare, Drosseln und Schnepfen, die im Frühjahr und Herbst auf der Insel zwischenlandeten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb15f35c-f2c1-3a0b-ba4d-ca71304d5ea8",
                                        "entry_id": "4933978a-4692-323c-bd24-e367de535c34",
                                        "glosses": [
                                            "die Vogelfamilie Sturnidae"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99f6c406-da1f-49a7-8fbf-1cabef3afdfc",
                                                "sense_id": "cb15f35c-f2c1-3a0b-ba4d-ca71304d5ea8",
                                                "text": "Die Stare gehören zu den Sperlingsvögeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Star",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e53af05b-79c5-394b-b2af-8693a45da9ca",
                                        "entry_id": "4256b87e-5cd6-3f71-8047-5bd5b4b79ea3",
                                        "glosses": [
                                            "Augenkrankheit, welche zu einer Sehbehinderung führen kann"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd0077f-b530-41a7-9af1-b8e9291db63c",
                                                "sense_id": "e53af05b-79c5-394b-b2af-8693a45da9ca",
                                                "text": "Er ist am grauen Star operiert worden."
                                            },
                                            {
                                                "example_id": "d947d450-9d74-4032-a3a0-0c4ef6380080",
                                                "sense_id": "e53af05b-79c5-394b-b2af-8693a45da9ca",
                                                "text": "„Er sprach zu jedermann von seinen Operationen und verurteilte den Augenarzt, der seit zwanzig Jahren in Warschau ansässig war, weil dieser nicht wisse, wie man einen Star steche; der andere verdammte ihn als Scharlatan, der vom Bau des Auges keine Ahnung habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Star",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9e2ee47-13b5-3110-ad2b-d93fa829a324",
                                        "entry_id": "b6835307-e11a-32a9-aab5-0fd29759c45d",
                                        "glosses": [
                                            "prominente, öffentlich bekannte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401bb589-6211-4f60-8cc9-a122060af2b3",
                                                "sense_id": "e9e2ee47-13b5-3110-ad2b-d93fa829a324",
                                                "text": "„Schmidts Krisenmanager Wischnewski, der am Donnerstagnachmittag 82-jährig in Köln gestorben ist, wurde damals zum Volkshelden und Star der Medien.“"
                                            },
                                            {
                                                "example_id": "57e8ffb1-0233-4313-9692-dd0ead74969f",
                                                "sense_id": "e9e2ee47-13b5-3110-ad2b-d93fa829a324",
                                                "text": "Keiner wird über Nacht zum großen Star."
                                            },
                                            {
                                                "example_id": "3f4e5a4d-7281-4802-9d3d-e693dc2aff2b",
                                                "sense_id": "e9e2ee47-13b5-3110-ad2b-d93fa829a324",
                                                "text": "„Manchmal wurde auch Sylvia um ein Autogramm gebeten, wohl in der Annahme, sie sei eine angehende Schauspielerin, die mit dem strahlenden Star befreundet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Star",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                        "entry_id": "9cc93379-f6fc-39fc-a581-9d3717f3694d",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b4ebc27-90d4-4ff4-a92f-5d249aac284d",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Frau Star ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2ec51ab3-abe4-4dad-9e99-3fe23334c9b3",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Herr Star wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "74b675cf-80a9-47f7-bc6a-caa3aa54643c",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Die Stars fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "ec6f5131-6e0f-47df-886f-77bc0f45a704",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Der Star trägt nie die Schals, die die Star ihm strickt."
                                            },
                                            {
                                                "example_id": "d5d9f257-f73b-4ca5-8a92-36c227cf9907",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Star kommt, geht der Herr Star.“"
                                            },
                                            {
                                                "example_id": "04eb50d3-fe8d-4c65-aba8-a86d9e5753ad",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Star kommt und geht."
                                            },
                                            {
                                                "example_id": "3d70ddd3-38cf-44a4-8eef-b8973c114beb",
                                                "sense_id": "87d8244c-4da2-31ba-bb69-d4e3af9483e6",
                                                "text": "Stars kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
