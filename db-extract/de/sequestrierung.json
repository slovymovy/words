                    {
                        "form_id": "b1dd143e-d18d-4f7a-a2c7-f59fd430a8dc",
                        "entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Sequestrierung"
                    },
                    {
                        "form_id": "0d378274-d6e7-42c6-8a36-19726a5dbe96",
                        "entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sequestrierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7631e721-6311-3641-abac-8a82487925c3",
                        "entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
                        "glosses": [
                            "Zwangsverwaltung/Enteignung eines Unternehmens, beispielsweise um Ansprüche von Gläubigern zu befriedigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8548d58c-a346-4e67-a3d7-cc03c3e94c17",
                                "sense_id": "7631e721-6311-3641-abac-8a82487925c3",
                                "text": "„Mit dem Befehl 64 vom 17. April 1948 ordnete die Sowjetische Militäradministration das Ende der Sequestrierungen an und befahl, nicht belasteten Personen das bereits beschlagnahmte Eigentum zurückzugeben.“"
                            },
                            {
                                "example_id": "a77a083b-e681-4cc4-97c0-25ef5e9f73d3",
                                "sense_id": "7631e721-6311-3641-abac-8a82487925c3",
                                "text": "„Nach der Sequestrierung des Klosters durch die Krone im Jahr 1537 wurde es 1545 an Richard Assheton und John Braddyll verkauft und das Abtshaus wurde in ein elisabethanisches Herrenhaus umgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "657b4a3b-26a4-3f11-bf75-5db5d4059371",
                        "entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
                        "glosses": [
                            "Aufnahme und Einlagerung von Giften (meist aus anderen Organismen) im eigenen Körper (meist zur Abwehr von Feinden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a727c44-88e2-40d6-8baa-59c4e06c89aa",
                                "sense_id": "657b4a3b-26a4-3f11-bf75-5db5d4059371",
                                "text": "[Pyrrolizidinalkaloide:] „Die Raupen nehmen es während des Fressens auf und lagern es ein (Sequestrierung), wobei sie selbst für andere Tiere giftig werden, ohne selbst Schaden zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                        "entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
                        "glosses": [
                            "Abscheidung und Speicherung von CO₂ (entweder direkt aus der Luft oder aus Abgasen)"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "da105b16-ab58-4184-8541-3cc91a4fb80f",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Die Kohlelobby sieht in dieser sogenannten Sequestrierung die letzte Chance, ihren klimaschädlichen Brennstoff reinzuwaschen, und hat dafür den Namen \"Clean Coal\" erfunden.“"
                            },
                            {
                                "example_id": "54cecccf-45dc-4610-8dcd-c07a6f6251b4",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Stoltenberg: »Neben Einsparungen setzen wir sehr stark auf die Sequestrierung von CO2.«“"
                            },
                            {
                                "example_id": "0bf1c731-bfc7-445a-bf06-379690dbd44e",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Die Sequestrierung ist also keine Option, damit fossile Kraftwerke weiterlaufen können.“"
                            },
                            {
                                "example_id": "eb08e808-de25-41dc-8e6d-7c066c10a1bb",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Selbst kleine Löcher könnten langfristig dafür sorgen, dass die Sequestrierung umsonst war.“"
                            },
                            {
                                "example_id": "dd143cf8-faf6-4091-ba12-1f2b4d9c5e20",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„»Bei der geologischen Sequestrierung brauche ich“ [eine] „Pipeline, um das Gas dorthin zu leiten, wo man es sequestrieren kann. Sie lohnt sich nur bei riesengroßen Projekten mit gewaltigen Investitionen.«“"
                            },
                            {
                                "example_id": "eccb5bcd-1ee3-4300-8be3-d720219f6a5e",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Selbst Schutzmaßnahmen wie die Kohlendioxidabscheidung und -speicherung (Sequestrierung) verbesserten die Bilanz der Kohle- und Erdgaskraftwerke kaum, da diese Verfahren ebenfalls Material und Energie verbrauchen.“"
                            },
                            {
                                "example_id": "67a966d6-9efd-4813-afbd-5f01bf9976fa",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„»Die Amerikaner machen sehr viel mehr Anstrengungen als wir im Bereich Wasserstoffe, im Bereich Sequestrierung und in der Konzeption einen technologischen Durchbruch mit Blick auf Klimapolitik zu schaffen.«“"
                            },
                            {
                                "example_id": "7e40be35-669d-426d-962c-9bcf07832925",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Selbst unter dem Blickwinkel, dass ungefähr die Hälfte des im Ausgangsmaterial eingelagerten Kohlenstoffs bei der Herstellung der Pflanzenkohle entweicht, wird die Sequestrierung von CO₂ in Form von Pflanzenkohle mittel- und langfristig als positiv im Vergleich zu anderen, nicht-pyrolisierten Formen von Biomasse angesehen.“"
                            },
                            {
                                "example_id": "10f8fdcb-f52e-45c4-8c63-5e647e297c10",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Der sinnvolle Einsatz der Biokohlen als Bodenverbesserungsmittel sollte neben der Sequestrierung von Kohlenstoff die Nährstoffspeicherung der Böden und die Nährstoffversorgung der Pflanzen positiv beeinflussen.“"
                            },
                            {
                                "example_id": "8ff33c61-163d-4b2b-b928-0173b8c43cb4",
                                "sense_id": "52bfbef6-fb2c-3b19-9b50-31aaa654c030",
                                "text": "„Die Sequestrierung soll zum Beispiel mit Biokohle erreicht werden. Doch auch die Herstellung dieser Pflanzenkohle erfordere erst einmal viel Energie und Rohstoffe, moniert die neue Studie.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44d2873f-c028-4a8e-9435-0e2621a2d6b5",
                        "source_entry_id": "b2c4450d-7f09-3f7e-8812-b6f9d4d56873",
