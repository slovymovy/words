                "senses": [
                    {
                        "sense_id": "48167b45-41b4-3c53-bd7e-5018dae63ae6",
                        "entry_id": "47e084f6-6d0f-3ff1-808a-26dbb29f1138",
                        "glosses": [
                            "Donner un caractère de femelle à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4bcae4c-f1fb-471b-a5d1-90301309a07d",
                                "sense_id": "48167b45-41b4-3c53-bd7e-5018dae63ae6",
                                "text": "La petite nuisette si jolie me confortait dans l'idée que Maîtresse Isabelle avait réussi ce qu'elle voulait obtenir : me femelliser."
                            },
                            {
                                "example_id": "b66e607e-8570-4099-a436-dbd2fc268d9e",
                                "sense_id": "48167b45-41b4-3c53-bd7e-5018dae63ae6",
                                "text": "En attendant on va commencer ton traitement pour te femelliser."
                            },
                            {
                                "example_id": "85653bdd-c1e2-40ec-86b4-088865d50b1d",
                                "sense_id": "48167b45-41b4-3c53-bd7e-5018dae63ae6",
                                "text": "Elle m'expliqua ses plans futurs pour m'humilier, me femelliser et me transformer en pute à Arabes."
                            }
                        ]
                    }
                ],
