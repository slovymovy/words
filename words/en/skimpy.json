                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nedostatečný",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek v množství nebo kvalitě"
                            },
                            {
                                "target_lang_word": "sporý",
                                "target_lang_sense_clarification": "literární výraz pro velmi slabý nebo nečetný"
                            },
                            {
                                "target_lang_word": "chabý",
                                "target_lang_sense_clarification": "vyjadřuje nedostatečnost nebo slabost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55d94887-da62-30cf-9909-62bc2fb79435",
                    "sense_definition": "Very small, light, or revealing in terms of clothing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>skimpy</w> bikini to the beach.",
                            "target_lang_translations": {
                                "cs": "Na pláž si vzala velmi <w>sporé</w> bikiny."
                            }
                        },
                        {
                            "text": "The outfit was far too <w>skimpy</w> for the formal event.",
                            "target_lang_translations": {
                                "cs": "Ten outfit byl na formální událost příliš <w>odhalující</w>."
                            }
