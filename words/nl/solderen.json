    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60407d82-9f42-3681-a744-1cb3339820ef",
                    "sense_definition": "metalen delen aan elkaar verbinden door middel van gesmolten metaal (soldeertin)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "metaalbewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur <w>soldeert</w> de afgebroken draad aan de luidspreker.",
                            "target_lang_translations": {
                                "en": "The technician is <w>soldering</w> the broken wire to the speaker."
                            }
                        },
                        {
                            "text": "Ik moet eerst de losse onderdelen op de printplaat <w>solderen</w> voordat het apparaat werkt.",
                            "target_lang_translations": {
                                "en": "I first need to <w>solder</w> the loose components onto the circuit board before the device works."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een draad solderen",
                        "met tin solderen"
                    ],
                    "target_lang_definitions": {
                        "en": "to join metal parts together using melted metal filler (solder)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solder",
                                "target_lang_sense_clarification": "to join metals with solder"
                            }
                        ]
                    }
                },
                {
