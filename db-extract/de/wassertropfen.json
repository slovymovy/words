                "senses": [
                    {
                        "sense_id": "50267ae3-7af9-3137-a870-b9a4aac2e39d",
                        "entry_id": "40f3143e-08c2-3ab9-a8d1-374d4fba623e",
                        "glosses": [
                            "kleine Menge flüssigen Wassers, die durch die Oberflächenspannung kompakt zusammengehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "740cf029-a30f-471e-bf17-d1ee1d7fab35",
                                "sense_id": "50267ae3-7af9-3137-a870-b9a4aac2e39d",
                                "text": "„Im Licht der hoch stehenden Mittagssonne funkeln die Wassertropfen wie ein endloser Sternenregen.“"
                            },
                            {
                                "example_id": "ad0d45e3-aeb5-415a-b4c0-23bb910871c5",
                                "sense_id": "50267ae3-7af9-3137-a870-b9a4aac2e39d",
                                "text": "„Vielleicht wäre der Tropfen geschmolzen oder wie ein Wassertropfen auf dem heißen Herd zerplatzt.“"
                            },
                            {
                                "example_id": "78f03a97-709c-481a-aee1-4e5e8f26544e",
                                "sense_id": "50267ae3-7af9-3137-a870-b9a4aac2e39d",
                                "text": "„Es musste aus Wassertropfen gewebt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
