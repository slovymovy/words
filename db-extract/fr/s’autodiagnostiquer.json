                        "glosses": [
                            "Se diagnostiquer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9600b4b9-ad82-4f6b-a2a4-13658d4d9135",
                                "sense_id": "a687aa0d-71d2-3a20-9951-e479f09c949f",
                                "text": "Des industriels européens ont développé une architecture de processeur multicœur qui s’autodiagnostique et peut même s’autoréparer quand un de ses cœurs ou un de ses bus internes connaît une défaillance."
                            },
                            {
                                "example_id": "1fe9fde4-da52-486f-86bb-8b865e9b2952",
                                "sense_id": "a687aa0d-71d2-3a20-9951-e479f09c949f",
                                "text": "Il incombe donc au malade, bien souvent, de se renseigner, et de s'autodiagnostiquer grâce aux tests sur le net."
                            },
                            {
                                "example_id": "d83c3adf-5456-4455-b800-4b9cdf48f322",
                                "sense_id": "a687aa0d-71d2-3a20-9951-e479f09c949f",
                                "text": "S'autodiagnostiquer sur internet"
                            }
                        ]
