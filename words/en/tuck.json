            "senses": [
                {
                    "sense_id": "033fa18a-570e-3537-ab03-520e5d7d9879",
                    "sense_definition": "To push into a snug position; to place somewhere safe, or handy, or somewhat hidden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>tuck</w> in your shirt before the meeting starts.",
                            "target_lang_translations": {
                                "zh": "开会前请把衬衫<w>掖</w>好。"
                            }
