                        "examples": [
                            {
                                "example_id": "12aa6a26-3b11-4142-982a-933d78596b97",
                                "sense_id": "3c8a02b3-1dc2-3ecc-9e13-370cc4c47f22",
                                "text": "Our spirits, biggened by their griefs and fears, Sadden and dwindle, with their backward view, All they behold."
                            },
                            {
                                "example_id": "514264b6-2025-4d25-bf48-a77693a76972",
                                "sense_id": "3c8a02b3-1dc2-3ecc-9e13-370cc4c47f22",
                                "text": "What has biggened it?"
                            },
                            {
                                "example_id": "e291e54a-1ee2-42c9-9706-a2a37b1be312",
                                "sense_id": "3c8a02b3-1dc2-3ecc-9e13-370cc4c47f22",
                                "text": "We both belong to a big State, and it's growing bigger every day. I like to think that in my small way I'm helping to biggen it."
                            }
                        ]
                    }
