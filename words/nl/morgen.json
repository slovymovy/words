            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b8569224-e955-3137-bdb1-f0081ffcf475",
                    "sense_definition": "De eerstvolgende dag na vandaag.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zie je <w>morgen</w> op school.",
                            "target_lang_translations": {
                                "en": "I'll see you <w>tomorrow</w> at school.",
                                "ru": "Увидимся <w>завтра</w> в школе.",
                                "pl": "Do zobaczenia <w>jutro</w> w szkole.",
                                "de": "Ich sehe dich <w>morgen</w> in der Schule.",
                                "fr": "Je te vois <w>demain</w> à l'école.",
                                "it": "Ti vedo <w>domani</w> a scuola.",
                                "cs": "Uvidíme se <w>zítra</w> ve škole.",
                                "tr": "Seninle <w>yarın</w> okulda görüşürüz.",
                                "es": "Te veo <w>mañana</w> en la escuela."
                            }
                        },
                        {
                            "text": "We gaan <w>morgen</w> samen naar de film.",
                            "target_lang_translations": {
                                "en": "We are going to the movies together <w>tomorrow</w>.",
                                "ru": "Мы идем <w>завтра</w> вместе в кино.",
                                "pl": "Idziemy <w>jutro</w> razem do kina.",
                                "de": "Wir gehen <w>morgen</w> zusammen ins Kino.",
                                "fr": "Nous allons au cinéma ensemble <w>demain</w>.",
                                "it": "Andiamo al cinema insieme <w>domani</w>.",
                                "cs": "Půjdeme <w>zítra</w> spolu do kina.",
                                "tr": "<w>Yarın</w> birlikte sinemaya gidiyoruz.",
                                "es": "Vamos <w>mañana</w> juntos al cine."
                            }
                        }
                    ],
                    "antonyms": [
                        "gisteren",
                        "vandaag"
                    ],
                    "common_phrases": [
                        "tot morgen",
                        "morgen vroeg",
                        "morgen avond"
                    ],
                    "target_lang_definitions": {
                        "en": "The day after today.",
                        "ru": "День, следующий за сегодняшним.",
                        "pl": "Dzień następujący po dniu dzisiejszym.",
                        "de": "Der Tag nach dem heutigen Tag.",
                        "fr": "Le jour suivant immédiatement aujourd'hui.",
                        "it": "Il giorno successivo a oggi.",
                        "cs": "První den po dnešku.",
                        "tr": "Bugünden sonraki ilk gün.",
                        "es": "El día siguiente al de hoy."
                    },
