                                    },
                                    {
                                        "sense_id": "4e4761da-a6ba-308e-a648-2751d5a50218",
                                        "entry_id": "70035202-f25f-38fb-a77a-8ce0018e510c",
                                        "glosses": [
                                            "Qui témoigne des origines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4521ba97-5644-4712-bbb8-ad8184f78ac3",
                                                "sense_id": "4e4761da-a6ba-308e-a648-2751d5a50218",
                                                "text": "Plus il y a de l'argent et des membres de l'élite dans un quartier, et moins vous y sentez le Mexique originaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ad5a85f-4233-3bf4-a2aa-f47221948b25",
                                        "entry_id": "70035202-f25f-38fb-a77a-8ce0018e510c",
                                        "glosses": [
