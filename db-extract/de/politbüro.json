                                        "glosses": [
                                            "A senior governing or policymaking body in a political or other organization, generally consisting of members who are either appointed by the party in control of the organization, or who attain membership through their personal political affiliations; an inner circle."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c58678-857b-4fa9-bcfc-e0f0085435df",
                                                "sense_id": "2bb34624-1a23-35a5-a820-42ae5d4bdd50",
                                                "text": "They were the people who surrounded Biden who were the true believers: Ricchetti, Donilon, etc. The Politburo would argue that the decisions were always fine and sound and never problematic."
                                            }
                                        ]
                                    }
