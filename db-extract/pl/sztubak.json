                "senses": [
                    {
                        "sense_id": "01ef92c6-be80-35f9-beab-27a3086d1a82",
                        "entry_id": "f0f67083-2fa0-3b1b-92ff-20c55e9d0e1b",
                        "glosses": [
                            "uczeń szkoły średniej"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "26214033-a962-48b6-90c5-bb7ac991320c",
                                "sense_id": "01ef92c6-be80-35f9-beab-27a3086d1a82",
                                "text": "Ty zaś masz maniery jak sztubak z młodszych klas!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "058a9a56-27f8-48d2-8869-13582a515200",
                        "source_entry_id": "f0f67083-2fa0-3b1b-92ff-20c55e9d0e1b",
                        "source_sense_id": "01ef92c6-be80-35f9-beab-27a3086d1a82",
                        "target_lang_word": "sophomore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sophomore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aeeb24c-3779-3a34-9d90-d22b2450b8cb",
                                        "entry_id": "3a643d5a-0012-30bb-8b4f-3fb5bf911cd3",
                                        "glosses": [
                                            "The second in a series, especially, the second of an artist’s albums or the second of four years in a high school (tenth grade) or university."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ada4f6c4-7c80-48bd-bcc8-28bd3d3169a7",
                                                "sense_id": "9aeeb24c-3779-3a34-9d90-d22b2450b8cb",
                                                "text": "The band’s sophomore album built upon the success of their debut release, catapulting them to megastardom."
                                            },
                                            {
                                                "example_id": "b3ccf271-6095-42e2-af22-df8e0a663e3b",
                                                "sense_id": "9aeeb24c-3779-3a34-9d90-d22b2450b8cb",
                                                "text": "“Blonde,” which is spelled “Blond” on the album cover and “Blonde” on Apple and elsewhere, hews more closely to what was expected from a sophomore release by one of the most lauded and enigmatic young singers in pop music."
                                            },
                                            {
                                                "example_id": "d06d7b75-ae88-4690-96c5-7739008fec6a",
                                                "sense_id": "9aeeb24c-3779-3a34-9d90-d22b2450b8cb",
                                                "text": "I pledged for DKA my sophomore year and went through a rigorous process of weekly meetings and projects, each designed to build fraternal bonds and to teach values such as honesty, reliability and generosity."
                                            },
                                            {
                                                "example_id": "926a0851-fb21-4c24-812d-52cbad1ada8c",
                                                "sense_id": "9aeeb24c-3779-3a34-9d90-d22b2450b8cb",
                                                "text": "Spike Lee’s sophomore film, after his micro-budgeted and critically acclaimed debut, “She’s Gotta Have It,” was this big, bold ensemble musical set on the campus of a Historically Black College over a busy homecoming weekend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "018043c1-e1f8-3d0d-896e-aad4289cf762",
                                        "entry_id": "3a643d5a-0012-30bb-8b4f-3fb5bf911cd3",
                                        "glosses": [
                                            "Sophomoric."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sophomore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec95c920-9865-3b2e-a49b-76beb89c62ba",
                                        "entry_id": "32889cd8-1f02-34de-a1c5-db9c836b3c0e",
                                        "glosses": [
                                            "A second-year undergraduate student in a college or university, or a second-year student in a four-year secondary school or high school."
                                        ],
                                        "tags": [
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b7b5ec7-f9fc-4105-9ab3-7d136e1c54ca",
                                                "sense_id": "ec95c920-9865-3b2e-a49b-76beb89c62ba",
                                                "text": "She was very mature for a sophomore and had several friends who were juniors or even seniors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb1aee39-5a9a-3556-aa0c-d1468a62844a",
                                        "entry_id": "32889cd8-1f02-34de-a1c5-db9c836b3c0e",
                                        "glosses": [
                                            "A three-year-old horse."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ad4ad8d-b400-4f87-bade-944cddd94242",
                                                "sense_id": "cb1aee39-5a9a-3556-aa0c-d1468a62844a",
                                                "text": "The filly had looked promising as a sophomore, but concerns over her health had prompted the owner to pull her from the season’s early races."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8a85c8c-675e-4626-b446-c8908b5340a7",
                        "source_entry_id": "f0f67083-2fa0-3b1b-92ff-20c55e9d0e1b",
                        "source_sense_id": "01ef92c6-be80-35f9-beab-27a3086d1a82",
                        "target_lang_word": "freshman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freshman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                        "entry_id": "a13bf94e-b773-3bec-9d26-821d49cca1a6",
                                        "glosses": [
                                            "a person (of either sex) entering the first year of an institution, especially a high school (ninth grade for US, grade 9 for Canada, grade 7 for Philippines), a university, or legislative body"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071cd3d6-9f10-40ca-9179-c12dfdc5304e",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "At the time I was a wide-eyed freshman, but I was soon to grow jaded and cynical."
                                            },
                                            {
                                                "example_id": "0a2e3ca4-6283-414e-aad6-44932bd992f3",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "When he was but yet a freshman in Cambridge."
                                            },
                                            {
                                                "example_id": "f2f6b424-7343-469e-b7c7-2b4b2323ac29",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "Sir Alexander: Then he's a graduate.\nSir Davy: Say they trust him not?\nSir Alexander: Then is he held a freshman and a sot,¶ And never shall commence, but being still barr'd¶ Be expuls'd from the master's side to th' twopenny ward,¶ Or else i' th' hole be plac'd."
                                            },
                                            {
                                                "example_id": "ee81bc4f-8b74-4639-a19e-c9fd6fa84f4a",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "As a country, we now enter what the seven freshmen called “unchartered waters”, with an unprecedented political and constitutional crisis looming on the horizon."
                                            },
                                            {
                                                "example_id": "d1126695-c14e-442a-897b-25fe89dafaf9",
                                                "sense_id": "b5e95e51-8b41-3a64-9ea2-e482cae934bd",
                                                "text": "Trump may have played a role in swaying some holdouts — calling into a meeting of Republican freshmen the night before, and calling other members ahead of voting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49701f9b-75e1-35ca-8a18-f996e8797fee",
                                        "entry_id": "a13bf94e-b773-3bec-9d26-821d49cca1a6",
                                        "glosses": [
                                            "a novice; one in the rudiments of knowledge"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3033a39-b67a-4756-98e3-2f7486eae58b",
                                                "sense_id": "49701f9b-75e1-35ca-8a18-f996e8797fee",
                                                "text": "I am but a Freshman yet in France, therefore I can send you no News but that all is here quiet, and 'tis no ordinary News that the French should be quiet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
