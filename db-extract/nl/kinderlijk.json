                    {
                        "sense_id": "e5ce37c1-d2d8-3ab6-9b50-866405684a7c",
                        "entry_id": "4d88ef8a-1518-3b37-aa9a-115e77827c4e",
                        "glosses": [
                            "overeenkomstig de aard van een kind (kindsheid), zoals een kind is of doet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99fb6e2-4bf2-42ad-916e-806583023f4c",
                                "sense_id": "e5ce37c1-d2d8-3ab6-9b50-866405684a7c",
                                "text": "Soms gedroeg hij zich ronduit kinderlijk."
                            },
                            {
                                "example_id": "9e77b946-67d3-4590-94af-cfff13c27ef1",
                                "sense_id": "e5ce37c1-d2d8-3ab6-9b50-866405684a7c",
                                "text": "Bennink weet van alles een muziekinstrument te maken, zegt de jury. \"81 is hij nu, maar hij benadert muziek nog altijd met kinderlijk enthousiasme.\""
                            }
                        ]
                    },
