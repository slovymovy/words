                    {
                        "translation_id": "baf0837d-7c06-41b9-9245-55c5cb9a450f",
                        "source_entry_id": "ddcbaf2a-9ba4-3178-b179-30234c1e8f23",
                        "target_lang_word": "Unmenge",
