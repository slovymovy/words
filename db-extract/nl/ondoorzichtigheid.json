                    {
                        "sense_id": "924423d6-4b39-334f-bfa6-e08eb45705bd",
                        "entry_id": "7ec3fc46-b65e-3056-ab6a-7c10b62376ec",
                        "glosses": [
                            "iets wat niet te begrijpen valt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "034ca1ca-6aa1-4a4b-9548-356458ea9b05",
                                "sense_id": "924423d6-4b39-334f-bfa6-e08eb45705bd",
                                "text": "Ondanks de ondoorzichtigheid van de woorden van de soldaat begreep Pierre precies wat hij bedoelde en hij knikte instemmend."
                            },
                            {
                                "example_id": "a919058e-15dd-4507-8951-9b61794be21d",
                                "sense_id": "924423d6-4b39-334f-bfa6-e08eb45705bd",
                                "text": "Ook actiegroepen maken zich zorgen over de ondoorzichtigheid waartoe de wet volgens hen leidt. Bedrijven zijn niet verplicht om hun beveiligingsproblemen te melden. Veel organisaties waren juist altijd terughoudend met het geven van informatie daarover aan de overheid, omdat dat kan leiden tot grote economische of reputatieschade."
                            }
                        ]
                    }
