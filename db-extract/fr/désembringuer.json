                "senses": [
                    {
                        "sense_id": "a8550989-6758-3eb9-a444-0014604817fd",
                        "entry_id": "283c6f4e-daa3-3528-af0c-282aa7f68a84",
                        "glosses": [
                            "Faire revenir à l’état où c’était avant que la situation soit devenue difficile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9add8233-90db-4b00-9a96-65387c7e01f6",
                                "sense_id": "a8550989-6758-3eb9-a444-0014604817fd",
                                "text": "Tant bien que mal, je reprends possession de ma Dugat, coincée entre une camionnette et une pile de diables. Je la désembringue comme je peux, sous l’œil d’un tapin et d’un porteur de cageots.' — (Léo Malet, Du rébecca rue des Rosiers)"
                            },
                            {
                                "example_id": "7d883096-4990-4d50-b283-43fae3b8a518",
                                "sense_id": "a8550989-6758-3eb9-a444-0014604817fd",
                                "text": "Il y a des trucs qui s’embringuent pour des tas de mauvaises raisons et que tu ne peux plus désembringuer, même pour des tas de bonnes raisons."
                            }
                        ]
                    }
                ],
