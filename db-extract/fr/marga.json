                "senses": [
                    {
                        "sense_id": "6629fd95-8ac3-39dc-9a3a-cde84271cd8c",
                        "entry_id": "ebbfc926-11f9-3be2-afbc-4a059c54ce67",
                        "glosses": [
                            "Plat d’origine maghrébine composé d’une viande entourée de légumes et disposé sur une sauce composée d’huile d’olive, d’eau et d’assaisonnements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65cdaba7-7027-4577-82d4-3aed1f4d267f",
                                "sense_id": "6629fd95-8ac3-39dc-9a3a-cde84271cd8c",
                                "text": "En fait, le couscous comprend le couscous proprement dit et la marga, sorte de pot-au-feu, qu’il accompagne. En Afrique, toute viande est bonne pour la marga, mais nous allons vous donner ici la recette la plus classique."
                            },
                            {
                                "example_id": "5cb0093d-ba48-4603-982f-673e16c04ff4",
                                "sense_id": "6629fd95-8ac3-39dc-9a3a-cde84271cd8c",
                                "text": "Aux sages recettes culinaires de nos mères : poivre rouge, ail, oignons, felfel, piment, cannelle, huile frite, safran, condiments retrouvés dans les loubias, les poissons, les couscous, les brochettes, les margas, les sauces, les bonbons, les pâtisseries que nous avalions en cachette entre les repas."
                            },
                            {
                                "example_id": "f5bafe79-a4e4-4e1d-aec7-10568564940a",
                                "sense_id": "6629fd95-8ac3-39dc-9a3a-cde84271cd8c",
                                "text": "Clarisse mange avec gourmandise, noie sa semoule de la sauce rouge et brûlante de la marga, embroche joyeusement les pois chiches sur sa fourchette."
                            }
                        ]
                    }
                ],
