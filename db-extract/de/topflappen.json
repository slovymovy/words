                    {
                        "sense_id": "2d0b6566-35e1-3c7e-84e8-6f7200890524",
                        "entry_id": "7c5b1684-6a48-31c4-b2dd-729debba3b2b",
                        "glosses": [
                            "kleiner Lappen, mit dem man heißes Kochgeschirr anfassen kann, ohne sich zu verbrennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33570aa8-febf-4dca-a0ad-5dca22d76258",
                                "sense_id": "2d0b6566-35e1-3c7e-84e8-6f7200890524",
                                "text": "Handarbeiten liegt mir nicht so besonders, aber Topflappen kann ich häkeln."
                            },
                            {
                                "example_id": "093a25ae-c99c-4712-9f2d-a122a33d3f69",
                                "sense_id": "2d0b6566-35e1-3c7e-84e8-6f7200890524",
                                "text": "„Ola drehte den Herd aus und nahm zwei Topflappen aus der Schublade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
