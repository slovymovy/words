                        "source_entry_id": "a108522b-cde8-36f4-b7e0-d5e528a5be20",
                        "source_sense_id": "684aed64-dc3f-371b-9f2a-be0bf97db9b0",
                        "source_sense_description": "größte Halbinsel der Welt, die geografisch asiatisch, geologisch jedoch afrikanisch ist",
