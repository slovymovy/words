        "fr-extract.jsonl": [
            {
                "entry_id": "838f64d8-fa3a-3574-a671-2da6cdf3cad3",
                "word": "irrespect",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d697d16-8cbd-4e70-86f0-ffbb5d306fb6",
                        "entry_id": "838f64d8-fa3a-3574-a671-2da6cdf3cad3",
                        "tags": [
                            "plural"
                        ],
                        "form": "irrespects"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                        "entry_id": "838f64d8-fa3a-3574-a671-2da6cdf3cad3",
                        "glosses": [
                            "Manque de respect."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b2ed23d-33c7-4298-b0ad-f316a05598fb",
                                "sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                                "text": "Monsieur Hector y découvre moins d'originalité réelle qu'un orgueil bien assis, une volonté de contemption toute proche de l'irrespect."
                            },
                            {
                                "example_id": "52f4c149-b60b-47fa-852c-6f9ef67c21a8",
                                "sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                                "text": "Arrive un jour où la répétition des situations d'irrespect à l'égard de sa mère ne permet plus à Nicolas de tromper son monde."
                            },
                            {
                                "example_id": "7dc92377-23a2-49ad-af09-08a74e3a78c4",
                                "sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                                "text": "Les fumeurs brillent par leur irrespect et j'avoue manquer de tolérance à leur égard, quand je vois le fric fou dépensé chaque année dans la lutte contre le cancer ainsi que l'état des rues tapissées de filtres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a5bd0ef-7128-4517-a77f-6547b69c7f96",
                        "source_entry_id": "838f64d8-fa3a-3574-a671-2da6cdf3cad3",
                        "source_sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                        "target_lang_word": "Respektlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Respektlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                        "entry_id": "ba7cd56c-60e6-3004-9b6c-84f5ecf01859",
                                        "glosses": [
                                            "Verhalten, das einen Mangel an Respekt vor dem Gegenüber zum Ausdruck bringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b43119-5f24-4aa7-a2cb-efb84aec16c2",
                                                "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                                "text": "Das Aufbehalten von Baseballmützen während des Unterrichts wird von vielen Lehrern als Respektlosigkeit betrachtet."
                                            },
                                            {
                                                "example_id": "81162ee6-2340-456b-9db2-dc9fea5de97b",
                                                "sense_id": "d5900f2c-7a4d-3b3d-b7d3-6c988c552021",
                                                "text": "„Respektlosigkeit und Aggressivität nehmen nicht einfach nur zu, ich behaupte sogar, das archaische Recht des Stärkeren wird immer mehr zur Realität auf unseren Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                        "entry_id": "ba7cd56c-60e6-3004-9b6c-84f5ecf01859",
                                        "glosses": [
                                            "despektierliche, würdelose Handlung oder Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2377260-55ed-40d5-8cf0-db57bd6a4d32",
                                                "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                                "text": "„Damit ist nun der Weg frei für eine Abstimmung über das sogenannte Nationalhymnen-Gesetz, das Respektlosigkeiten gegenüber der chinesischen Nationalhymne unter Strafe stellen soll.“"
                                            },
                                            {
                                                "example_id": "f0fbb8db-720b-438e-b6c3-784eac6c782d",
                                                "sense_id": "611e1dd6-33e8-3253-befe-c864dbf43991",
                                                "text": "„‚Die zahlreichen Gewalttaten, Respektlosigkeiten und Übergriffe gegen Schiedsrichter auf den Amateurplätzen schockieren auch uns, wir sind bestürzt, fassungslos und betroffen‘, heißt es in einem von DFB-Präsident Fritz Keller, den Vizepräsidenten Rainer Koch und Ronny Zimmermann sowie Generalsekretär Friedrich Curtius unterzeichneten Brief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43960010-12f0-4ac6-9da7-03f8a6aaf419",
                        "source_entry_id": "838f64d8-fa3a-3574-a671-2da6cdf3cad3",
                        "source_sense_id": "cdc45f89-2d6e-313f-811f-ed132d22fd3d",
                        "target_lang_word": "disrespect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disrespect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb83a5da-ccf1-309c-97e6-bc2cac1d2139",
                                        "entry_id": "15a69b54-fca6-3b77-b97c-3f18d381b064",
                                        "glosses": [
                                            "A lack of respect, esteem or courteous behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77511f52-ff8c-4178-abf9-14bd884ffaea",
                                                "sense_id": "bb83a5da-ccf1-309c-97e6-bc2cac1d2139",
                                                "text": "[S]he uſed many arguments both to excuſe her ſelf and divert their intentions, yet adding ſtill more fierceneſs to their former behaviour, as they would not ſeem at all to be ſatisfied either with her language or her tears (notwithſtanding they proceeded more from her apprehenſion of their diſreſpects to her perſon, than out of any ſenſe ſhe had of her own preſent danger) […]"
                                            },
                                            {
                                                "example_id": "da5ad42c-6543-4ac8-9988-7da78c7bfdba",
                                                "sense_id": "bb83a5da-ccf1-309c-97e6-bc2cac1d2139",
                                                "text": "This was a champion team out of kilter, stung by what was arguably an act of disrespect to their opponents, a failure to appreciate their threat and the fine planning of Carlos Osorio, and never really able to regain its balance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disrespect",
                                "target_lang_code": "en",
                                "target_senses": [
