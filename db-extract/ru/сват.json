                "senses": [
                    {
                        "sense_id": "f84a1adf-25c8-396b-a96c-01e05d6a6ac9",
                        "entry_id": "5a5eb7d7-1cf2-3c00-8f28-b8994c6fdfe4",
                        "glosses": [
                            "тот, кто по поручению жениха или его родителей сватает ему невесту, занимается сватовством"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48ab738-7361-440f-94cb-fb11a4485def",
                                "sense_id": "f84a1adf-25c8-396b-a96c-01e05d6a6ac9",
                                "text": "— Девушка на выданьи, а каков сват, таков и жених, — дай бог любовь да совет, а чести много."
                            }
                        ]
                    },
                    {
                        "sense_id": "13cd25bf-c2ce-3e16-8446-f1c4e8290cbb",
                        "entry_id": "5a5eb7d7-1cf2-3c00-8f28-b8994c6fdfe4",
                        "glosses": [
                            "разг. отец одного из супругов по отношению к родителям другого супруга; отец зятя или невестки"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a82a08d-2f88-40f7-bb8f-9bd6af1e07a3",
                        "source_entry_id": "5a5eb7d7-1cf2-3c00-8f28-b8994c6fdfe4",
                        "source_sense_description": "тот, кто сватает невесту",
                        "target_lang_word": "matchmaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matchmaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36223a7f-0ca1-301f-939b-1259c29d562e",
                                        "entry_id": "8ed17c6c-6dc8-3086-8bc8-5cf64c2760e4",
                                        "glosses": [
                                            "Someone who finds suitable dates or marriage partners for other people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9b4412-d457-4d4a-8f32-f1536e839fcb",
                                                "sense_id": "36223a7f-0ca1-301f-939b-1259c29d562e",
                                                "text": "As singles are stuck at home and social distancing makes traditional dating all but impossible, the coaching skills of matchmakers, now imparted online, are becoming more valuable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0406c7a8-c0cc-3d31-8c03-ae5df114c439",
                                        "entry_id": "8ed17c6c-6dc8-3086-8bc8-5cf64c2760e4",
                                        "glosses": [
                                            "Someone who arranges professional boxing matches."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c9425c5-74cb-35ee-9fed-afa2e9a4b943",
                                        "entry_id": "8ed17c6c-6dc8-3086-8bc8-5cf64c2760e4",
                                        "glosses": [
                                            "Someone who makes matchsticks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92439627-abcf-44c3-aef9-e2da945a0260",
                        "source_entry_id": "5a5eb7d7-1cf2-3c00-8f28-b8994c6fdfe4",
                        "source_sense_description": "отец зятя или невестки",
                        "target_lang_word": "co-father-in-law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "co-father-in-law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b26031af-e594-3cec-90cf-7256001c33b6",
                                        "entry_id": "19a60a70-002a-3e45-85de-ad1010907e2b",
                                        "glosses": [
                                            "The father of one's son- or daughter-in-law; that is, the father-in-law of one's child, or, the father of one spouse in relation to the father of the other spouse; either of two or more men whose children marry each other, such as the father of a bride vis-à-vis the father of the groom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d56dce-d877-43cd-93d2-91f87610e3bf",
                                                "sense_id": "b26031af-e594-3cec-90cf-7256001c33b6",
                                                "text": "‘Hear, O well-read Paṇḍit, my daughter is ready for marriage. Take with you a barber's lad, go forth into the country, and search for a bridegroom. […] Search for a house worthy of my house, and search for a boy worthy of my child. Search for a co-father-in-law worthy of a co-father-in-law.’ […] Up rose the well-read Paṇḍit and said ‘O king, hear my petition. There is a co-father-in-law worthy of you as co-father-in-law. There is a boy worthy of your child. There is a house worthy of your house […]’"
                                            },
                                            {
                                                "example_id": "6867b859-45d1-44b9-8348-e0c29824078a",
                                                "sense_id": "b26031af-e594-3cec-90cf-7256001c33b6",
                                                "text": "my old friend […] whom I trusted greatly, because I had taken care of his family in former times, and because he was, as it were, my co-father-in-law, for I had betrothed my daughter to his son."
                                            },
                                            {
                                                "example_id": "df1c8f89-cd6c-402d-83ff-ac111d579ded",
                                                "sense_id": "b26031af-e594-3cec-90cf-7256001c33b6",
                                                "text": "Diègue tries to treat Gormas amicably as his prospective co-father-in-law, but Gormas provokes him with rude remarks and slaps him"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
