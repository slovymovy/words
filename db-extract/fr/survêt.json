                    {
                        "sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                        "entry_id": "f407e1b9-ef81-3535-80f3-34126b11a231",
                        "glosses": [
                            "Survêtement, tenue sportive à la mode chez les jeunes."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "862c9250-114e-41c1-bd39-30b4f350ad57",
                                "sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                                "text": "Quand ils voient Canto tous ceux de la foule marseillaise enfouissent la clameur du stade sous leur casquette dans les poches de leur survêt."
                            },
                            {
                                "example_id": "56648891-2e4e-4a29-9ecb-5f81ead93b56",
                                "sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                                "text": "Après l’échauffement, quand je revenais dans les tribunes à ses côtés pour enfiler mes pointes, je savais qu’il allait me dire : « Enlève pas ton survêt trop tôt ! »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31cedeb7-0998-4d19-8c9f-f6319df9ea4f",
                        "source_entry_id": "f407e1b9-ef81-3535-80f3-34126b11a231",
                        "source_sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                        "target_lang_word": "jogging outfit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bf2bc7f5-0bac-42e5-923f-60651fc3b85c",
                        "source_entry_id": "f407e1b9-ef81-3535-80f3-34126b11a231",
                        "source_sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                        "target_lang_word": "tracksuit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tracksuit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c725778c-e320-3478-8610-eb7e56df8bb1",
                                        "entry_id": "3e01e248-dfe5-3859-b1d1-a2d629eb9119",
                                        "glosses": [
                                            "A garment, usually consisting of a top and trousers (commonly known as tracksuit bottoms) worn as an outer layer by participants in sporting events such as athletics. The tracksuit is usually designed to be easily removed or replaced, before or after competing. Tracksuits have also been adopted in some cultures as leisurewear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d10b6a-748f-4725-8777-25d4e89d96cf",
                                                "sense_id": "c725778c-e320-3478-8610-eb7e56df8bb1",
                                                "text": "With such focus from within the footballing community this week on Remembrance Sunday, there was something appropriate about Colchester being the venue for last night’s game. Troops from the garrison town formed a guard of honour for both sets of players, who emerged for the national anthem with poppies proudly stitched into their tracksuit jackets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41efd54a-25cb-415c-8da4-f9c6b45cd787",
                        "source_entry_id": "f407e1b9-ef81-3535-80f3-34126b11a231",
                        "source_sense_id": "61b87ca2-a464-3b1a-8251-108d56b19b4b",
                        "target_lang_word": "trackie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trackie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494f6475-6683-3871-bb23-e7800767af31",
                                        "entry_id": "f9657f52-e8da-35b5-a17d-3c11916fdae3",
                                        "glosses": [
                                            "A tracksuit."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c476d2-9ea1-42ba-a2b8-b4c161b7a114",
                                                "sense_id": "494f6475-6683-3871-bb23-e7800767af31",
                                                "text": "Dylan was wearing a light trackie top in the colours of the flag."
                                            },
                                            {
                                                "example_id": "663fdd80-7bb9-4f81-97a5-033b453376d8",
                                                "sense_id": "494f6475-6683-3871-bb23-e7800767af31",
                                                "text": "‘I′ve fucking had it with this town,’ she said. ‘I go into the super last night, they reckon they seen me taking frozen stuff out of me trackie at the car. So I′m gonna walk around with fucking frozen peas down me trackie, right? Right?’"
                                            },
                                            {
                                                "example_id": "c36ff499-d692-48a2-b0b9-7943a33a5b8e",
                                                "sense_id": "494f6475-6683-3871-bb23-e7800767af31",
                                                "text": "Carriages crammed with more sportswear than JD, including what looks like an orange and black trackie, similar to Casey′s; some dad out with his kid. You get a better class of person in Wembley."
                                            },
                                            {
                                                "example_id": "736ee8d3-ad38-44a1-b542-cbdaf7e2e8b4",
                                                "sense_id": "494f6475-6683-3871-bb23-e7800767af31",
                                                "text": "Pulling on a pair of trackie pants and a jumper, she quietly unclipped the flyscreen and pushed up the old window and climbed through, landing outside with a hollow thud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
