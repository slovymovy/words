                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворчать",
                                "target_lang_sense_clarification": "выражать недовольство"
                            },
                            {
                                "target_lang_word": "брюзжать",
                                "target_lang_sense_clarification": "надоедливое ворчание"
                            },
                            {
                                "target_lang_word": "жаловаться",
                                "target_lang_sense_clarification": "высказывать обиду"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "brontolare",
                                "target_lang_sense_clarification": "lamentarsi parlando in modo fastidioso"
                            },
                            {
                                "target_lang_word": "lamentarsi",
                                "target_lang_sense_clarification": "esprimere insoddisfazione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3079d77-0bae-3022-a5e5-183b4cb3e3f1",
                    "sense_definition": "To hunt grouse for sport.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went <w>grousing</w> in Scotland last autumn.",
                            "target_lang_translations": {
                                "ru": "Прошлой осенью они ездили в Шотландию <w>охотиться на куропаток</w>.",
                                "it": "L'autunno scorso sono andati a <w>cacciare</w> in Scozia."
                            }
                        },
                        {
                            "text": "He enjoys <w>grousing</w> on the moors during the season.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>охотиться на дичь</w> на пустошах в сезон.",
                                "it": "Gli piace <w>cacciare</w> nelle brughiere durante la stagione."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотиться на рябчиков или тетеревов.",
                        "it": "Praticare la caccia a questo uccello per sport."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охотиться на рябчиков",
                                "target_lang_sense_clarification": "заниматься охотой"
                            },
                            {
                                "target_lang_word": "охотиться на дичь",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "cacciare",
                                "target_lang_sense_clarification": "praticare l'attività venatoria"
                            }
                        ]
                    }
                }
            ]
        },
        {
