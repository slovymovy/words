                    },
                    {
                        "translation_id": "572a6f20-8350-4001-a2ee-27be7b4426fb",
                        "source_entry_id": "1ad6545d-8221-3f51-b994-1f30e57c4447",
                        "target_lang_word": "Koffer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koffer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                        "entry_id": "952f2047-290a-3d25-a820-f4a85e105b4e",
                                        "glosses": [
                                            "Transportbehältnis für Kleidung, Akten oder andere Gegenstände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4f2e13c-d472-4742-9d2b-63449c0244f5",
                                                "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                                "text": "„In meinem Hirne rumort es und knackt, ich glaube da wird ein Koffer gepackt, und mein Verstand reist ab - o wehe - noch früher als ich selber gehe.“"
                                            },
                                            {
                                                "example_id": "bd1db624-8053-4930-8ae0-ca8c42fb9446",
                                                "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                                "text": "Die Koffer sind bereits gepackt."
                                            },
                                            {
                                                "example_id": "60e3daad-725a-4a44-a209-c43bbb62b803",
                                                "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                                "text": "„Ihr Koffer war noch immer leicht.“"
                                            },
                                            {
                                                "example_id": "3e365171-7218-453f-8885-99859f8c7369",
                                                "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                                "text": "„Dann steckte sie das Foto ein, nahm den Koffer und lief den Weg zurück.“"
                                            },
                                            {
                                                "example_id": "60dcc700-6d88-426e-9c27-28c6f8a4aba6",
                                                "sense_id": "006bc524-fedc-3e89-889f-950a100b769b",
                                                "text": "„Die Koffer ließ ich im Kibbuz zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "48eb876c-dea6-3f08-be1d-6e7bed010ae6",
                                        "entry_id": "952f2047-290a-3d25-a820-f4a85e105b4e",
                                        "glosses": [
                                            "Dummerchen, Dummkopf"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43df8b2-083d-4aad-94d3-c80949ecf327",
                                                "sense_id": "48eb876c-dea6-3f08-be1d-6e7bed010ae6",
                                                "text": "„Er ist ein echter Koffer!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "640ecac2-8956-46ee-9488-26d35cba33c9",
                        "source_entry_id": "1ad6545d-8221-3f51-b994-1f30e57c4447",
                        "target_lang_word": "coffre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coffre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b49153f5-eeca-329d-b430-83344fdb736e",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Meuble en forme de caisse, en bois ou en métal, propre à enfermer diverses choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4892e8c9-09b7-4bb9-b4b1-019db2341725",
                                                "sense_id": "b49153f5-eeca-329d-b430-83344fdb736e",
                                                "text": "Envelopper d’étoupes et placer les étoupilles et la mèche, et dans le demi-coffre de gauche des coffres qui doivent les contenir, le crochet à désétouper, les dégorgeoirs, le doigtier et la spatule."
                                            },
                                            {
                                                "example_id": "05cc4eaa-c3ab-40dd-a13d-19009f44269f",
                                                "sense_id": "b49153f5-eeca-329d-b430-83344fdb736e",
                                                "text": "Là, cette madame de Leviston, aidée de deux ou trois femmes, a tiré de grands coffres une robe blanche de soie. Puis, malgré ma honte, elles m'ont déshabillée et rhabillée."
                                            },
                                            {
                                                "example_id": "f598aa8c-81e9-4233-b536-92629523253a",
                                                "sense_id": "b49153f5-eeca-329d-b430-83344fdb736e",
                                                "text": "Toutes les clés de la maison, des armoires et des coffres, cliquetaient autour de sa taille en un trousseau noué à sa ceinture."
                                            },
                                            {
                                                "example_id": "de91837b-321f-43a5-a2f0-072d1480c099",
                                                "sense_id": "b49153f5-eeca-329d-b430-83344fdb736e",
                                                "text": "Tous les millions que je possède je les ai mis dans un grand coffre, sous le tombeau de Charlemagne, à Aix-la-Chapelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95a26d4-a671-31e9-be0c-564e1d0765f5",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Trésor royal ou trésor public."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d766102e-bd63-44bc-9ac4-9ed9af0cb9c6",
                                                "sense_id": "d95a26d4-a671-31e9-be0c-564e1d0765f5",
                                                "text": "Les coffres de l’État, du roi, de la compagnie."
                                            },
                                            {
                                                "example_id": "e7471a31-d427-4e44-b4fa-3423002574f1",
                                                "sense_id": "d95a26d4-a671-31e9-be0c-564e1d0765f5",
                                                "text": "[Les Italiens] se disaient que si la France aux coffres inépuisables, aux armées alors invaincues, avait mis trente ans pour s’implanter en Algérie, eux ne parviendraient pas à soutenir une pareille lutte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4728e671-19eb-3fb9-929f-3ca2c3d5077e",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Partie avant ou arrière d’une voiture où l’on range les bagages et autres objets."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e0ecf69-330d-49f7-8a29-d1e3ae6db288",
                                                "sense_id": "4728e671-19eb-3fb9-929f-3ca2c3d5077e",
                                                "text": "Le coffre d’une voiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45be3fb8-a553-3018-b3e4-49a97dd7fcb3",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Table d’un autel, avec l’armoire qui est au-dessous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb248b83-f8a9-453a-b354-192e9925a720",
                                                "sense_id": "45be3fb8-a553-3018-b3e4-49a97dd7fcb3",
                                                "text": "Coffre d’autel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa3ae4c3-4bd3-3fa5-aefd-c92c1f86c9f2",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Poitrine, cage thoracique, souffle."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d508ce2-6445-4722-b19e-e06f833b263c",
                                                "sense_id": "fa3ae4c3-4bd3-3fa5-aefd-c92c1f86c9f2",
                                                "text": "La Girafe, excitée à fuir, se presse, s’emporte, et est bientôt hors de vue ; mais elle ne soutient point longtemps cet effort, qu’elle ressent comme une fatigue : c’est que ses poumons n’ont pas assez d’ampleur ; défaut que révèle la petitesse du coffre qui les contient."
                                            },
                                            {
                                                "example_id": "1decb1a8-53ab-4605-9cba-4ce92fe7e4ec",
                                                "sense_id": "fa3ae4c3-4bd3-3fa5-aefd-c92c1f86c9f2",
                                                "text": "Mendès, à voix très basse mais très appliquée, — il avait déjà quelques absinthes ou vermouths dans le coffre, — se mit à débiter des anecdotes de sorcellerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77bc252-968a-3976-a973-2296697ebc3c",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Appétit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ace1d1d5-7d0b-4496-b217-2b7cfb2f9528",
                                                "sense_id": "b77bc252-968a-3976-a973-2296697ebc3c",
                                                "text": "Avoir le coffre bon, avoir un bon coffre : Avoir un bon estomac, une bonne poitrine."
                                            },
                                            {
                                                "example_id": "d8b59a93-da21-49cc-94d3-c14d4f3e4b85",
                                                "sense_id": "b77bc252-968a-3976-a973-2296697ebc3c",
                                                "text": "Cet homme a les jambes en mauvais état, mais il a le coffre bon."
                                            },
                                            {
                                                "example_id": "181cdf61-0efb-4083-9fe4-3703ba7d7397",
                                                "sense_id": "b77bc252-968a-3976-a973-2296697ebc3c",
                                                "text": "– Tu n’as pas bonne mine… tu as beaucoup maigri.\nIl répondit :\n– Ne t’inquiète pas : le coffre est bon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d04d1ba-4533-3b52-bef4-4bf8e3054811",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Coffre-fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3dd919-bd8d-4d55-89a3-585abf087c1c",
                                                "sense_id": "0d04d1ba-4533-3b52-bef4-4bf8e3054811",
                                                "text": "N'oublions pas les \"safe-deposits\"\", où, moyennant une redevance mensuelle légère, variable suivant les cas, des compagnies autorisées, \"incorporées\", vous louent un coffre : une sorte de tiroir d'acier numéroté, noyé dans un mur de granit souterrain. Vous y déposez, vous y cachez vous-même les valeurs, les objets précieux que vous voulez assurer contre toute chance de perte, de vol, d'incendie : titres de bourse, argenterie, bijoux, diamants, papiers d'affaire ou de famille."
                                            },
                                            {
                                                "example_id": "4c73d701-bdbb-4db7-a6ae-c0de15a1814e",
                                                "sense_id": "0d04d1ba-4533-3b52-bef4-4bf8e3054811",
                                                "text": "[…] il n’y avait plus un sou dans le coffre, mais juste une lettre. Une jolie lettre qui disait, texto: « Wesh, fallait pas me virer. Tu vois à quoi ça sert de connaître des serruriers. […] »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e6addb-bb05-35a2-89dd-d843940c669a",
                                        "entry_id": "11a61c82-8cc0-34f9-a08d-12a40253320d",
                                        "glosses": [
                                            "Synonyme de poisson-coffre (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c7b0b9-3f34-4784-a53a-52866ffcbf17",
                                                "sense_id": "64e6addb-bb05-35a2-89dd-d843940c669a",
                                                "text": "Les ophiures balancent leurs bras dans le courant, les nuages de fretin remontent dans les cascades, et je vois passer un coffre, l’air pressé et stupide."
                                            }
                                        ]
                                    }
                                ]
                            },
