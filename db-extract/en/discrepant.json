                        "entry_id": "b6d5e24f-a1a7-3245-b6cb-0baeedda0792",
                        "glosses": [
                            "Showing difference; inconsistent, dissimilar."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "46072659-aeea-475f-9e79-64fe25814490",
                                "sense_id": "f151e560-9d5c-37e4-b1c9-7d0b6e18b7a3",
                                "text": "The Egyptians were doubtless the most singular of all the Pagans, and the most oddly discrepant from the rest in their manner of worship; yet nevertheless, that these also agreed with the rest in those fundamentals of worshipping one supreme and universal Numen […]"
                            },
                            {
                                "example_id": "4c5f17f4-4770-4c3b-a81e-955f4c5539b5",
                                "sense_id": "f151e560-9d5c-37e4-b1c9-7d0b6e18b7a3",
                                "text": "But the term 'godlike,' […] becomes exceedingly vague, for many gods have flourished in religious history, and their attributes have been discrepant enough."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b8e4bda-8c3e-482d-870c-794b471d0963",
                        "source_entry_id": "b6d5e24f-a1a7-3245-b6cb-0baeedda0792",
                        "source_sense_id": "f151e560-9d5c-37e4-b1c9-7d0b6e18b7a3",
                        "source_sense_description": "inconsistent, dissimilar",
                        "target_lang_word": "diskrepant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
