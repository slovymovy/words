                    ]
                },
                {
                    "sense_id": "58c2f387-76a8-3503-becd-4ab41717882c",
                    "sense_definition": "Qui obsède l'esprit, qui revient de manière insistante et pénible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une inquiétude <w>lancinante</w> ne cessait de le tourmenter depuis le départ de son ami."
                        },
                        {
                            "text": "Cette question <w>lancinante</w> restait sans réponse malgré toutes nos recherches."
                        }
                    ],
                    "synonyms": [
