                "translations": [
                    {
                        "translation_id": "f0651684-744c-4c2b-b227-aa76bcf5b136",
                        "source_entry_id": "9ae17680-42b0-3be7-9e88-992aabb93b12",
                        "source_sense_id": "0c5c518b-3447-39ab-bcbb-6230cfb45555",
