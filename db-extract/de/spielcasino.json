                "senses": [
                    {
                        "sense_id": "a25e9b72-91d0-3fa6-8c42-558ffa74e20a",
                        "entry_id": "38a28c30-6f28-3326-ae76-750d873030b1",
                        "glosses": [
                            "Gebäude, gewerbliches Unternehmen, in dem um Geld gespielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b55ba44-b410-480d-a74f-570817e2fe19",
                                "sense_id": "a25e9b72-91d0-3fa6-8c42-558ffa74e20a",
                                "text": "„Das Spielen mit seiner wirtschaftlichen Existenz im Spielcasino, im Lotteriespiel, bei Wettspielen, bei Spekulationsgeschäften, das Spielen mit der Gesundheit, das Spielen mit dem Leben bei Abenteuerunternehmungen oder beim sogenannten Risikosport ist verpönt.“"
                            },
                            {
                                "example_id": "db909ecf-37b7-4d97-ba05-8675ac082b19",
                                "sense_id": "a25e9b72-91d0-3fa6-8c42-558ffa74e20a",
                                "text": "„Die drei Nachwuchstalente, die einen Raubüberfall auf ein Spielcasino in Lauenau geplant hatten und deshalb bald vor Gericht erscheinen müssen, dürfen wieder mit der U19-Mannschaft des Fußball-Bundesligisten Hannover 96 mittrainieren.“"
                            },
                            {
                                "example_id": "30403a32-6be3-4052-ae32-a381e5de9c3d",
                                "sense_id": "a25e9b72-91d0-3fa6-8c42-558ffa74e20a",
                                "text": "„Einer der Angeklagten muss sich zudem wegen schwerer räuberischer Erpressung verantworten, weil er vor einem Jahr ein Spielcasino in Wismar überfallen haben soll.“"
                            },
                            {
                                "example_id": "fc207a26-4370-4165-93ca-2b862be5a751",
                                "sense_id": "a25e9b72-91d0-3fa6-8c42-558ffa74e20a",
                                "text": "„Ermittlungen ergaben, dass die aus Rendsburg und Kiel stammenden Verdächtigen überregional Automaten in Spielcasinos manipuliert haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
