                    },
                    {
                        "translation_id": "ab2b8e95-6e71-4682-9a17-5f55b2869637",
                        "source_entry_id": "9e143eef-a490-37b9-98fb-2f3e6e008d49",
                        "source_sense_id": "95f209f9-57ae-36e5-9c42-e26194324a28",
                        "target_lang_word": "итальянка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "итальянка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                        "entry_id": "88ee8d09-00f7-347b-9e29-32a3c8e0464a",
                                        "glosses": [
                                            "жительница или уроженка Италии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40f84a0-17b2-4105-911e-28abe51c93e9",
                                                "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                                "text": "— Синьора Карини! — продолжал он, обращаясь к итальянке. — Мой приятель не любит или, лучше сказать, не понимает итальянской музыки .."
                                            },
                                            {
                                                "example_id": "abf18387-5314-49c9-b558-4f70e3649cdd",
                                                "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                                "text": "Француженки и немки, не говоря уже об итальянках, всем существом своим празднуют чувство первой любви, вдохновляются им, как правом на наслаждение..."
                                            },
                                            {
                                                "example_id": "38fb5c23-d97f-4c9e-9c54-e08a51528cd4",
                                                "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                                "text": "Князь Михаил Алексеевич Голицын за границею женился на итальянке и принял римско-католическую веру .."
                                            },
                                            {
                                                "example_id": "fedcaf84-2a96-403a-a982-79d751220dd5",
                                                "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                                "text": "[Флор Федулыч Прибытков:] Тоже была вот как-то не надолго здесь одна итальянка в этом роде, немало удивления производила-с фигурой своей."
                                            },
                                            {
                                                "example_id": "fe0d0908-cb45-4092-933e-53ad6b92ec52",
                                                "sense_id": "caaf1fd4-eac9-3683-913a-b467bffc8b2f",
                                                "text": "Молодые итальянки очень красивы и главная их красота заключается в чудесных глазах, роскошных волосах и в тёмных изящных руках и ногах..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7866f771-9c80-3b40-aea9-81b6b7bef0fb",
                                        "entry_id": "88ee8d09-00f7-347b-9e29-32a3c8e0464a",
                                        "glosses": [
                                            "воен. жарг. противотанковая мина итальянского производства"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
