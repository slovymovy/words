                        "examples": [
                            {
                                "example_id": "afb2a227-e83b-4c3e-b117-40a6929f4d4f",
                                "sense_id": "79162750-cd25-3b58-84d9-107799361b17",
                                "text": "C'est ce qui se produit quand un quartier \"gentrifié\" se \"dégentrifie\" avant se de \"gentrifier\" une deuxième fois, donc de se \"regentrifier\"?"
                            },
                            {
                                "example_id": "f5520dcc-b8d5-4303-8336-1a37830e3ef1",
                                "sense_id": "79162750-cd25-3b58-84d9-107799361b17",
                                "text": "Bon, je vais pas me la jouer Bobo quartier Ménilmontant regentrifié et faire genre le bouquet, l'arrière goût cerise et toutes ces conneries."
                            }
                        ]
