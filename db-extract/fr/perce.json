        "fr-extract.jsonl": [
            {
                "entry_id": "a4d5b588-a2c9-3b3e-9d96-3094a7bf2762",
                "word": "perce",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d47ec9f2-9a9c-3381-b56e-c8209118801b",
                        "entry_id": "a4d5b588-a2c9-3b3e-9d96-3094a7bf2762",
                        "glosses": [
                            "Outil pour percer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0f1ad25e-3427-3528-adf4-ec2108a5b6a3",
                        "entry_id": "a4d5b588-a2c9-3b3e-9d96-3094a7bf2762",
                        "glosses": [
                            "Action de percer, souvent dans la locution adverbiale mettre en perce en parlant des pièces de vin, des tonneaux auxquels on fait une ouverture pour en tirer le liquide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a74e2a-4c41-40a7-ae01-cca94ee8b81c",
                                "sense_id": "0f1ad25e-3427-3528-adf4-ec2108a5b6a3",
                                "text": "Eh bien ! ce n’est que pour une nuit, il sera donc aussi le bienvenu. Oswald, mettez en perce le baril de notre vin le plus vieux."
                            },
                            {
                                "example_id": "4ebdd492-c9ef-4ad7-bf56-24917cf76dcb",
                                "sense_id": "0f1ad25e-3427-3528-adf4-ec2108a5b6a3",
                                "text": "Il se mit à boire plus que la normale, faisant livrer des cubis de bon pinard (en quantité ça coûte moins cher) toujours en perce à la souillarde, et je me revois échapper à la tablée bruyante et discordante où il s'échauffait en parlant politique […]."
                            },
                            {
                                "example_id": "83d86f8c-f46e-43c9-9745-9439cab8e93e",
                                "sense_id": "0f1ad25e-3427-3528-adf4-ec2108a5b6a3",
                                "text": "Lui-même descendit dans ses caves immenses et les parcourut d’un bout à l’autre, accompagné du tonnelier Schweyer et de ses garçons, indiquant les tonneaux qu’il faudrait mettre en perce pour le premier, le deuxième et le troisième service, et choisissant les vins en bouteille qui devaient paraître au dessert."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cbb7188-7246-3f2c-b250-6cc0f6a8a1f1",
                        "entry_id": "a4d5b588-a2c9-3b3e-9d96-3094a7bf2762",
                        "glosses": [
                            "Manière dont un instrument à vent est percé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2642a42f-70eb-41a0-8e57-092da3d6ed1d",
                                "sense_id": "9cbb7188-7246-3f2c-b250-6cc0f6a8a1f1",
                                "text": "La perce de la clarinette est cylindrique. (Littré)"
                            }
                        ]
                    }
                ],
