                        "entry_id": "088367bb-1b48-3d5a-b3e9-c50beef03341",
                        "glosses": [
                            "Werk oder Errungenschaft, das/die innerhalb einer Kultur einen Wert hat und deshalb bewahrt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a4baeb5-ac1a-4b2c-99f3-b2f18a227956",
                                "sense_id": "de7a4fc9-7e9e-3e8f-a724-9631e4d789a7",
                                "text": "Das Asylrecht ist ein hohes Kulturgut."
                            },
                            {
                                "example_id": "65d82442-2994-482f-b2c5-a0b17e3f106b",
                                "sense_id": "de7a4fc9-7e9e-3e8f-a724-9631e4d789a7",
                                "text": "„Und dann kam Minh eines Tages aus der Schule und fragte nach einem Kulturgut aus Vietnam.“"
                            },
                            {
                                "example_id": "b389622b-dc26-44ba-a906-c60ad0adbf2b",
                                "sense_id": "de7a4fc9-7e9e-3e8f-a724-9631e4d789a7",
                                "text": "„So ist wertvolles deutsches Kulturgut für immer vernichtet.“"
                            }
                        ],
