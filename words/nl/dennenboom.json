    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8746cf0c-0bfa-345c-8e7f-31b3cbc61e02",
                    "sense_definition": "een soort naaldboom met lange naalden die behoort tot het geslacht Pinus",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "boom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de wandeling door het bos zagen we een hoge <w>dennenboom</w> staan.",
                            "target_lang_translations": {
                                "pl": "Podczas spaceru po lesie zobaczyliśmy wysoką <w>sosnę</w>."
                            }
                        },
                        {
                            "text": "Onder de grote <w>dennenboom</w> lagen heel veel dennenappels op de grond.",
                            "target_lang_translations": {
                                "pl": "Pod wielką <w>sosną</w> leżało na ziemi mnóstwo szyszek."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hoge dennenboom"
                    ],
                    "target_lang_definitions": {
                        "pl": "gatunek drzewa iglastego o długich igłach, należący do rodzaju sosna (Pinus)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sosna",
                                "target_lang_sense_clarification": "drzewo iglaste z rodzaju Pinus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbd9eb6b-1f81-310e-8aca-83a4694273f6",
                    "sense_definition": "versierde naaldboom die tijdens het kerstfeest in huis wordt geplaatst",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "kerst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In december zetten we altijd een mooie <w>dennenboom</w> vol lichtjes in de woonkamer.",
                            "target_lang_translations": {
                                "pl": "W grudniu zawsze stawiamy w salonie piękną <w>choinkę</w> pełną światełek."
                            }
                        },
                        {
                            "text": "De kinderen zongen het bekende kerstliedje over de <w>dennenboom</w> bij de open haard.",
                            "target_lang_translations": {
                                "pl": "Dzieci śpiewały przy kominku znaną piosenkę świąteczną o <w>choince</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kerstboom"
                    ],
                    "common_phrases": [
                        "o dennenboom"
                    ],
                    "target_lang_definitions": {
                        "pl": "udekorowane drzewko iglaste stawiane w domu z okazji świąt Bożego Narodzenia"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "choinka",
                                "target_lang_sense_clarification": "udekorowane drzewko bożonarodzeniowe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}