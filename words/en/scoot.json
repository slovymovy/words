{
    "word_family": [
        "scooter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60d6bf15-3657-39db-950c-ad32c4172b6d",
                    "sense_definition": "To move or travel quickly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>scoot</w> to the store before it closes.",
                            "target_lang_translations": {
                                "cs": "Musím <w>letět</w> do obchodu, než zavře."
                            }
                        },
                        {
                            "text": "We had to <w>scoot</w> across town to make the meeting on time.",
                            "target_lang_translations": {
                                "cs": "Museli jsme <w>pádit</w> přes celé město, abychom přišli na schůzku včas."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pohybovat se nebo cestovat rychle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "letět",
                                "target_lang_sense_clarification": "rychle jít nebo jet; spěchat"
                            },
                            {
                                "target_lang_word": "pádit",
                                "target_lang_sense_clarification": "rychle běžet nebo pospíchat"
                            },
                            {
                                "target_lang_word": "mazat",
                                "target_lang_sense_clarification": "rychle zmizet nebo někam mazat; hovorově"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cfb085f-489f-3042-8858-9642ca5a4e55",
                    "sense_definition": "To shift one's position slightly, often to make space for someone else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you <w>scoot</w> over so I can sit down?",
                            "target_lang_translations": {
                                "cs": "Mohl by ses <w>posunout</w>, abych si mohl sednout?"
                            }
                        },
                        {
                            "text": "Please <w>scoot</w> to the left to make room for the others.",
                            "target_lang_translations": {
                                "cs": "Prosím, <w>posuň se</w> doleva, aby bylo místo pro ostatní."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scoot over"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mírně změnit svou polohu, často aby se udělalo místo pro někoho dalšího."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "posunout se",
                                "target_lang_sense_clarification": "posunout se trochu, aby vzniklo místo"
                            },
                            {
                                "target_lang_word": "šoupnout se",
                                "target_lang_sense_clarification": "uhnout nebo se posunout stranou; hovorově"
                            },
                            {
                                "target_lang_word": "uhnout",
                                "target_lang_sense_clarification": "pohnout se trochu na stranu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d68dee5-bbe2-3a6f-8fd2-218c7f72a8a7",
                    "sense_definition": "To leave a place quickly, often to avoid trouble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You had better <w>scoot</w> before the teacher sees you here.",
                            "target_lang_translations": {
                                "cs": "Radši <w>zmiz</w>, než tě tu učitel uvidí."
                            }
                        },
                        {
                            "text": "We decided to <w>scoot</w> as soon as the party started getting loud.",
                            "target_lang_translations": {
                                "cs": "Rozhodli jsme se <w>vypadnout</w>, jakmile na večírku začalo být hlučno."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychle odejít z nějakého místa, často aby se člověk vyhnul potížím."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmizet",
                                "target_lang_sense_clarification": "rychle odejít, často aby člověk neměl potíže"
                            },
                            {
                                "target_lang_word": "vypadnout",
                                "target_lang_sense_clarification": "rychle odejít; neformálně"
                            },
                            {
                                "target_lang_word": "mazat",
                                "target_lang_sense_clarification": "rychle utéct pryč; hovorově"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b32de814-e091-3193-9d0b-2e04fc472af3",
                    "sense_definition": "To drag one's rear end along the floor, typically done by animals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was <w>scooting</w> across the rug because of an itch.",
                            "target_lang_translations": {
                                "cs": "Pes <w>jel zadkem po koberci</w>, protože ho něco svědilo."
                            }
                        },
                        {
                            "text": "If you see your pet <w>scooting</w> on the floor, consult a veterinarian.",
                            "target_lang_translations": {
                                "cs": "Jestli uvidíš svého mazlíčka, jak <w>jezdí zadkem po podlaze</w>, poraď se s veterinářem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Táhnout zadní část těla po podlaze, typicky u zvířat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jezdit zadkem po zemi",
                                "target_lang_sense_clarification": "u zvířete: táhnout zadek po zemi nebo podlaze"
                            },
                            {
                                "target_lang_word": "šoupat zadkem",
                                "target_lang_sense_clarification": "u zvířete: šoupat zadkem po podlaze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a3f792c-e1dc-3bc7-8ce7-b3f9d4aefc69",
                    "sense_definition": "To ride on a scooter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Children love to <w>scoot</w> around the park on sunny days.",
                            "target_lang_translations": {
                                "cs": "Děti se za slunečných dnů rády <w>projíždějí na koloběžce</w> po parku."
                            }
                        },
                        {
                            "text": "He likes to <w>scoot</w> to work every morning.",
                            "target_lang_translations": {
                                "cs": "Každé ráno rád <w>jezdí do práce na koloběžce</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scooter#Verb"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jet na koloběžce nebo skútru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "jet na koloběžce",
                                "target_lang_sense_clarification": "pohybovat se na koloběžce"
                            },
                            {
                                "target_lang_word": "jezdit na koloběžce",
                                "target_lang_sense_clarification": "pravidelně nebo obecně se pohybovat na koloběžce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb70574-5c5e-3e04-a239-aab990dadbd1",
                    "sense_definition": "To force someone to leave a place quickly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>scooted</w> the visitors out of the office before the meeting.",
                            "target_lang_translations": {
                                "cs": "Vedoucí před schůzkou <w>vystrnadil</w> návštěvníky z kanceláře."
                            }
                        },
                        {
                            "text": "She <w>scooted</w> the children out of the room so she could clean.",
                            "target_lang_translations": {
                                "cs": "<w>Vyhnala</w> děti z pokoje, aby mohla uklidit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přinutit někoho, aby z nějakého místa rychle odešel."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vystrnadit",
                                "target_lang_sense_clarification": "donutit někoho rychle odejít"
                            },
                            {
                                "target_lang_word": "vyhnat",
                                "target_lang_sense_clarification": "vyhnat ven nebo pryč"
                            },
                            {
                                "target_lang_word": "vykázat",
                                "target_lang_sense_clarification": "vykázat z místa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a49cf0-010f-3fb8-aec9-68ebd55d9746",
                    "sense_definition": "To spray or squirt a liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The broken pipe began to <w>scoot</w> water all over the kitchen floor.",
                            "target_lang_translations": {
                                "cs": "Z prasklé trubky začala <w>stříkat</w> voda po celé kuchyňské podlaze."
                            }
                        },
                        {
                            "text": "He <w>scooted</w> a bit of water from the hose onto the plants.",
                            "target_lang_translations": {
                                "cs": "Hadicí <w>stříkl</w> trochu vody na rostliny."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stříkat nebo vystřikovat tekutinu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříkat",
                                "target_lang_sense_clarification": "vypouštět tekutinu proudem nebo kapkami"
                            },
                            {
                                "target_lang_word": "stříknout",
                                "target_lang_sense_clarification": "vystříknout trochu tekutiny"
                            },
                            {
                                "target_lang_word": "vycáknout",
                                "target_lang_sense_clarification": "prudce vypustit tekutinu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be2e4847-c6f6-3343-aa1a-77623db634ac",
                    "sense_definition": "A quick sliding or shuffling movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his chair a quick <w>scoot</w> to get closer to the table.",
                            "target_lang_translations": {
                                "cs": "Rychlým <w>šoupnutím</w> si přisunul židli blíž ke stolu."
                            }
                        },
                        {
                            "text": "With a sudden <w>scoot</w>, she moved out of the way of the door.",
                            "target_lang_translations": {
                                "cs": "Jedním rychlým <w>šoupnutím</w> uhnula ode dveří."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Rychlý klouzavý nebo šouravý pohyb."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šoupnutí",
                                "target_lang_sense_clarification": "krátký posun nebo pohyb po povrchu"
                            },
                            {
                                "target_lang_word": "rychlý posun",
                                "target_lang_sense_clarification": "rychlý malý posun"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcab7a8f-4930-3e02-ad68-13c6a1fb1373",
                    "sense_definition": "A scooter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He parked his <w>scoot</w> near the entrance of the building.",
                            "target_lang_translations": {
                                "cs": "Zaparkoval svůj <w>skútr</w> u vchodu do budovy."
                            }
                        },
                        {
                            "text": "Many people use a <w>scoot</w> to travel short distances in the city.",
                            "target_lang_translations": {
                                "cs": "Mnoho lidí používá ve městě na krátké vzdálenosti <w>skútr</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for a scooter"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Skútr."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skútr",
                                "target_lang_sense_clarification": "hovorový nebo slangový výraz pro malé motorové vozidlo tohoto typu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbdec2ab-aecc-3d4c-9b46-2ccf23c142f3",
                    "sense_definition": "A sudden spray or stream of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>scoot</w> of water hit him when the hose was turned on.",
                            "target_lang_translations": {
                                "cs": "Když se pustila hadice, zasáhlo ho <w>stříknutí</w> vody."
                            }
                        },
                        {
                            "text": "The fountain gave a small <w>scoot</w> of water before stopping completely.",
                            "target_lang_translations": {
                                "cs": "Fontána ještě vypustila malé <w>stříknutí</w> vody, než se úplně zastavila."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhlý proud nebo vystříknutí vody."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stříknutí",
                                "target_lang_sense_clarification": "náhlé malé vystříknutí vody nebo jiné tekutiny"
                            },
                            {
                                "target_lang_word": "proud vody",
                                "target_lang_sense_clarification": "krátký proud vody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "923b33db-d7b4-3649-97d5-55338f87c64e",
                    "sense_definition": "A dollar.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That old book only cost me a <w>scoot</w> at the garage sale.",
                            "target_lang_translations": {
                                "cs": "Ta stará kniha mě na garážovém výprodeji stála jen <w>dolar</w>."
                            }
                        },
                        {
                            "text": "He did not have a single <w>scoot</w> in his pocket.",
                            "target_lang_translations": {
                                "cs": "V kapse neměl ani jeden <w>dolar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Very informal term for money"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Jeden dolar."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dolar",
                                "target_lang_sense_clarification": "americká měnová jednotka; ve velmi neformálním užití"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7b36fdb2-9c7d-3128-92d4-f247a1b283ac",
                    "sense_definition": "A system for managing traffic signals in urban areas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city implemented <w>SCOOT</w> to reduce traffic congestion during rush hour.",
                            "target_lang_translations": {
                                "cs": "Město zavedlo systém <w>SCOOT</w>, aby snížilo dopravní zácpy během dopravní špičky."
                            }
                        },
                        {
                            "text": "Engineers use <w>SCOOT</w> to coordinate traffic lights across the network.",
                            "target_lang_translations": {
                                "cs": "Inženýři používají <w>SCOOT</w> ke koordinaci semaforů v celé síti."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Systém pro řízení dopravních signálů v městských oblastech."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "SCOOT",
                                "target_lang_sense_clarification": "název systému pro řízení a koordinaci semaforů"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}