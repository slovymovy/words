    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d1c8d90-ded2-3499-a4ae-efd2f4905733",
                    "sense_definition": "Сделанный из хрусталя или относящийся к хрусталю.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На праздничный стол бабушка всегда ставила красивые <w>хрустальные</w> бокалы.",
                            "target_lang_translations": {
                                "en": "For the holiday table, grandmother always set out beautiful <w>crystal</w> glasses."
                            }
                        },
                        {
                            "text": "В центре гостиной висела старинная <w>хрустальная</w> люстра, сверкавшая сотнями огоньков.",
                            "target_lang_translations": {
                                "en": "An antique <w>crystal</w> chandelier hung in the center of the living room, glittering with hundreds of lights."
                            }
                        }
                    ],
                    "common_phrases": [
                        "хрустальная ваза",
                        "хрустальная люстра",
                        "хрустальный бокал",
                        "хрустальная туфелька"
                    ],
                    "target_lang_definitions": {
                        "en": "Made of crystal or lead glass, or relating to crystal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crystal",
                                "target_lang_sense_clarification": "made of fine crystal glass"
                            },
                            {
                                "target_lang_word": "cut-glass",
                                "target_lang_sense_clarification": "made of glass or crystal with patterns cut into it"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "449e6ddb-37ae-37f6-81f9-009cf71194fd",
                    "sense_definition": "Чистый, прозрачный или звонкий, напоминающий хрусталь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ранним утром в горах стоял удивительно свежий и <w>хрустальный</w> воздух.",
                            "target_lang_translations": {
                                "en": "Early in the morning, the mountain air was remarkably fresh and <w>crystal clear</w>."
                            }
                        },
                        {
                            "text": "В тишине дома послышался тонкий <w>хрустальный</w> звон разбитой чашки.",
                            "target_lang_translations": {
                                "en": "In the silence of the house, the delicate <w>crystal</w> clatter of a breaking cup was heard."
                            }
                        }
                    ],
                    "synonyms": [
                        "кристальный",
                        "чистый",
                        "прозрачный"
                    ],
                    "antonyms": [
                        "мутный",
                        "глухой"
                    ],
                    "common_phrases": [
                        "хрустальная чистота",
                        "хрустальный звон",
                        "хрустальный воздух"
                    ],
                    "target_lang_definitions": {
                        "en": "Clear, pure, or ringing, resembling crystal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crystal",
                                "target_lang_sense_clarification": "exceptionally pure, clear, or ringing"
                            },
                            {
                                "target_lang_word": "crystal-clear",
                                "target_lang_sense_clarification": "perfectly transparent or pure"
                            }
                        ]
                    }
                }
            ]
        },
        {
