                ],
                "senses": [
                    {
                        "sense_id": "3ec8ff44-b6d7-3c40-8cdd-544784ba3639",
                        "entry_id": "03f5bca1-f38e-3847-968c-281236b2d445",
                        "glosses": [
                            "Theorie, die das Wesen des Krieges ergründet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf145c2-9054-4e70-935b-0cbde3d51517",
                                "sense_id": "3ec8ff44-b6d7-3c40-8cdd-544784ba3639",
                                "text": "„Auch in dieser Hinsicht bleibt die Kriegstheorie von Clausewitz aktuell und wichtig.“"
                            },
                            {
                                "example_id": "827d7344-9b9a-446a-bf9d-d9974d4fe472",
                                "sense_id": "3ec8ff44-b6d7-3c40-8cdd-544784ba3639",
                                "text": "„In Deutschland sind es bisher vor allem die Unternehmensberater, die den historischen Erfahrungsschatz der Militärs für sich erkannt haben und dafür sorgen, dass die bekanntesten Schriften der Kriegstheorie zwar nicht Bestseller-Rang erreichen, dafür aber seit Jahrzehnten immer wieder neu aufgelegt und interpretiert werden.“"
                            },
                            {
                                "example_id": "a79f6208-2804-4788-a6a1-cc008be61026",
                                "sense_id": "3ec8ff44-b6d7-3c40-8cdd-544784ba3639",
                                "text": "„K. hat sich mit der sorgfältigen Ausgabe ebenso ein Verdienst erworben wie mit der umfangreichen Einleitung, in der er die Stellung des jungen Clausewitz in der Kriegstheorie der Zeit, sein Verhältnis zu Scharnhorst und die Entwicklungslinien behandelt, die von diesem ersten Entwurf über die späteren Schriften Clausewitz’ zu dem Werke ‚Vom Kriege‘ führen.“"
                            },
                            {
                                "example_id": "1eb4f21e-13c2-44f0-8889-180953d88c9b",
                                "sense_id": "3ec8ff44-b6d7-3c40-8cdd-544784ba3639",
                                "text": "„Dennoch – oder vielleicht gerade deswegen – hielt Anton L. krampfhaft an der Kriegstheorie fest, freilich auch, weil sich ein aberwitziger Gedanke in ihm eingenistet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
