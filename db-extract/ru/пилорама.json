                    }
                ],
                "senses": [
                    {
                        "sense_id": "a38985ba-7e94-360a-bb3f-474944cc3be5",
                        "entry_id": "37751830-f2da-3b5a-be4f-dd322b687167",
                        "glosses": [
                            "техн. деревообрабатывающий станок, предназначенный для продольной распиловки брёвен и брусьев различных пород древесины на пиломатериалы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "884d2f36-ff46-46f6-8e92-9c50449827f0",
                                "sense_id": "a38985ba-7e94-360a-bb3f-474944cc3be5",
                                "text": "Подешевел распиленный на механических пилорамах тес, и они стали обшивать узкими реечками-дощечками все радульские дома подряд."
                            }
                        ]
                    },
                    {
                        "sense_id": "f42f622b-56e7-35da-a8a5-8a014da57269",
                        "entry_id": "37751830-f2da-3b5a-be4f-dd322b687167",
                        "glosses": [
                            "разг. помещение, в котором пилят брёвна таким станком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "590bd685-9b76-4bd8-9749-931030344106",
                                "sense_id": "f42f622b-56e7-35da-a8a5-8a014da57269",
                                "text": "В первую очередь во все жилые дома, общественные и производственные постройки мы проведем водопровод, электрифицируем мельницу, крупорушку, построим пилораму, введем электродойку коров и электрострижку овец, механизируем все работы на животноводческих фермах, токах, в мастерских."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79b4dbfb-8a37-464c-98aa-28bcfa9661cb",
                        "source_entry_id": "37751830-f2da-3b5a-be4f-dd322b687167",
                        "target_lang_word": "powersaw bench",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2cf5dab6-3b41-4193-95c3-28732cb6dabc",
                        "source_entry_id": "37751830-f2da-3b5a-be4f-dd322b687167",
                        "target_lang_word": "Gattersäge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gattersäge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                                        "entry_id": "1e08de8d-4b2e-3d0b-baf2-60bb0b354ec3",
                                        "glosses": [
                                            "motorbetriebene, als Gatter organisierte Sägevorrichtung in Sägewerken oder Sägemühlen zum Längsschneiden von Baumstämmen zu Brettern und Balken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3dd974-9f4e-42b2-9937-97930694cfb0",
                                                "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                                                "text": "„Im Winter aber liegt das Sägewerk mit seinen beschneiten Baumstämmen wie ausgestorben da, und das Rattern der Gattersäge verstärkt den Eindruck des Todes, der von der Anlage ausgeht. Ab und zu streift ein Gendarm zwischen den Gebäuden herum mit umgehängtem Gewehr, selten hört man den gedämpften Ruf eines Entmündigten.“"
                                            },
                                            {
                                                "example_id": "849d1921-ec9e-4fa6-92ea-e51f98ffb293",
                                                "sense_id": "b2c138b3-5d4b-3756-b407-55683e30a88f",
                                                "text": "„Für jedes Blockhaus verbaut er 60 bis 80 Baumstämme. Dabei benutzt er die alte Gattersäge nur selten, meistens genügt eine Motorsäge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
