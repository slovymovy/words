                    {
                        "translation_id": "46055898-8533-472b-b33b-cbe033719608",
                        "source_entry_id": "d85f2a1a-bd89-38ea-b3fd-afe6033da1af",
                        "source_sense_id": "33db72e7-8c5d-3317-8f93-a9fb12cd61e8",
                        "source_sense_description": "im Baikalsee endemische Robbenart",
                        "target_lang_word": "phoque de Sibérie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phoque de Sibérie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57c4f402-1af4-3b48-9b29-435f516206d0",
                                        "entry_id": "a37fad61-51cd-389f-bd29-9c7f40306bbb",
                                        "glosses": [
                                            "Espèce de petit phoque d’eau douce, endémique du lac Baïkal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ee1ddc-d759-4946-a49f-9534df8c8750",
                                                "sense_id": "57c4f402-1af4-3b48-9b29-435f516206d0",
                                                "text": "Appelé aussi phoque de Sibérie, il habite les îles situées sur ce lac et plonge dans les zones d’eau profonde. Ce n’est pas un grand phoque, puisqu’il ne pèse que 80 à 90 kilos pour une longueur avoisinant le mètre quarante."
                                            },
                                            {
                                                "example_id": "f931edee-23c7-4a37-a72e-1dabe4f5167b",
                                                "sense_id": "57c4f402-1af4-3b48-9b29-435f516206d0",
                                                "text": "Les épidémies sont souvent périodiques et spectaculaires : ainsi, le phoque de Sibérie est de nouveau frappé par une épidémie au printemps 2000 avec une mortalité estimée à plus de 10 000 phoques (Kennedy et al. 2000)."
                                            },
                                            {
                                                "example_id": "d61ef8e8-346a-4961-aa7c-67b6a72dff9a",
                                                "sense_id": "57c4f402-1af4-3b48-9b29-435f516206d0",
                                                "text": "Le phoque du lac Baïkal ou phoque de Sibérie (Pusa sibirica) vit en eau douce dans le lac Baïkal (qui est le plus vieux et le plus profond lac du monde). Il est l’un des plus petits phoques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
