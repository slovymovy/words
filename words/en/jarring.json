        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f293cc0a-91d5-30ba-b6e8-335451e2336b",
                    "sense_definition": "a physical sensation of a sudden jolt or vibration",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The perpetual <w>jarring</w> of the heavy machinery was very tiring for the workers' muscles.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>сотрясение</w> от тяжелой техники очень утомляло мышцы рабочих.",
                                "zh": "重型机械持续的<w>震动</w>让工人们的肌肉感到非常疲劳。",
                                "cs": "Neustálé <w>otřesy</w> těžkých strojů byly pro svaly dělníků velmi únavné."
                            }
                        },
                        {
                            "text": "After the car hit the pothole, the driver felt a sharp <w>jarring</w> through the steering wheel.",
                            "target_lang_translations": {
                                "ru": "После того как машина попала в выбоину, водитель почувствовал резкий <w>толчок</w> в руль.",
                                "zh": "汽车撞上坑洼后，司机感觉到方向盘传来一阵剧烈的<w>冲击</w>。",
                                "cs": "Poté, co auto vjelo do výmolu, ucítil řidič ve volantu ostrý <w>otřes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jolt",
                        "vibration",
                        "shaking"
                    ],
                    "common_phrases": [
                        "constant jarring"
                    ],
                    "target_lang_definitions": {
