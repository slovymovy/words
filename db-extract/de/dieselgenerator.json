                ],
                "senses": [
                    {
                        "sense_id": "df703109-25b5-3150-91ef-5a3aa41b326c",
                        "entry_id": "c8aded9c-c5fc-33eb-acc6-901ac3a5d501",
                        "glosses": [
                            "Generator, der von einem mit Diesel betriebenen Motor angetrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a6e446-038b-48dd-9844-55f4a325955b",
                                "sense_id": "df703109-25b5-3150-91ef-5a3aa41b326c",
                                "text": "„Generatoren, die Strahlungswärme von Verbrennungsprozessen mittels Halbleiterzellen in Strom wandeln, könnten effektiver arbeiten als Dieselgeneratoren und herkömmliche Solartechnik ergänzen.“"
                            },
                            {
                                "example_id": "c07c66ac-1874-4cd7-a8d0-abffcee4410a",
                                "sense_id": "df703109-25b5-3150-91ef-5a3aa41b326c",
                                "text": "„Kurz nachdem das Beben die sechs Reaktoren von Fukushima-Daiichi erschütterte, drückten die Tsunamis in die Anlage und zerstörten die für den Notbetrieb kritischen Dieselgeneratoren, die die Kühlung der Reaktoren im Katastrophenfall gewährleisten sollten.“"
                            },
                            {
                                "example_id": "5a5838b8-204c-4dec-91d9-f1ffb38e40b4",
                                "sense_id": "df703109-25b5-3150-91ef-5a3aa41b326c",
                                "text": "„Des Weiteren bietet der Hybridantrieb den Vorteil, dass Tauchzeiten sehr viel länger ausfallen können als bei Ubooten mit Dieselgenerator.“"
                            },
                            {
                                "example_id": "6fb80778-11ae-48b0-90c0-43e081a2c148",
                                "sense_id": "df703109-25b5-3150-91ef-5a3aa41b326c",
                                "text": "„Die Luft war stickig trotz der Dieselgeneratoren, die den Bunker mit Licht, Heizung und Frischluft versorgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
