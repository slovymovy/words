                    }
                ],
                "senses": [
                    {
                        "sense_id": "c017d453-d43b-3840-b2a1-913f286dea26",
                        "entry_id": "014c3dbb-37c3-35d3-9141-e48f67320a4a",
                        "glosses": [
                            "изменить своё мнение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fb3c7a6-79c1-42b1-8fe7-868dc1348d74",
                                "sense_id": "c017d453-d43b-3840-b2a1-913f286dea26",
                                "text": "Сначала я хотел устроить грандиозный праздник, но потом передумал."
                            }
                        ]
                    },
                    {
                        "sense_id": "322c4df6-b1d0-3fa4-b415-b6d234eac57c",
                        "entry_id": "014c3dbb-37c3-35d3-9141-e48f67320a4a",
                        "glosses": [
                            "неоднократно подумать; обдумать многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55519912-b878-4e4a-9237-04d6ff16cf29",
                                "sense_id": "322c4df6-b1d0-3fa4-b415-b6d234eac57c",
                                "text": "Я столько всего успела передумать и почувствовать за время, пока читала книгу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b0c043e-609f-4a73-b6a7-743c65394de7",
                        "source_entry_id": "014c3dbb-37c3-35d3-9141-e48f67320a4a",
                        "source_sense_description": "изменить своё мнение",
                        "target_lang_word": "change one's mind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "change one's mind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14e70987-509b-38b1-ba95-a312b6fc15dd",
                                        "entry_id": "e897c3a7-f18a-3698-8708-dcb844a79182",
                                        "glosses": [
                                            "To decide differently than one had decided before."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7368f60b-5ea0-4a40-b62f-4c71b7bcaa98",
                                                "sense_id": "14e70987-509b-38b1-ba95-a312b6fc15dd",
                                                "text": "She started up the stairs, changed her mind, and turned to go back down."
                                            },
                                            {
                                                "example_id": "d02f2ad5-a37a-4a57-b9ab-989392e22c39",
                                                "sense_id": "14e70987-509b-38b1-ba95-a312b6fc15dd",
                                                "text": "So don’t necessarily assume that something has changed if I appear to have changed my mind, sometimes my mind is all that’s changed."
                                            },
                                            {
                                                "example_id": "b5bf95f4-95f3-413e-bd4c-8592fe195b39",
                                                "sense_id": "14e70987-509b-38b1-ba95-a312b6fc15dd",
                                                "text": "Of course, I was not always right. I questioned the value of Crossrail (a scheme revived by Prescott after being scrapped by the Conservatives), suggesting wrongly that it may be \"doomed to hit the buffers\" […]. A dozen years later, I published my book on it, extolling the line's wonders. We are all allowed to change our minds."
                                            },
                                            {
                                                "example_id": "3aa436de-e1c5-47fa-965a-c24e2f1b597f",
                                                "sense_id": "14e70987-509b-38b1-ba95-a312b6fc15dd",
                                                "text": "I’m looking for the ladies in this frantic sea\nBut then I change my mind and I fall in love with me"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da338826-e580-48f1-a2ca-5b5de9952fcd",
                        "source_entry_id": "014c3dbb-37c3-35d3-9141-e48f67320a4a",
                        "source_sense_description": "изменить своё мнение",
                        "target_lang_word": "think better of it",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "012073f6-e75e-42fb-b15d-fb17acebac86",
                        "source_entry_id": "014c3dbb-37c3-35d3-9141-e48f67320a4a",
                        "source_sense_description": "изменить своё мнение",
                        "target_lang_word": "have second thoughts",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "have second thoughts",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "205df6bc-82a6-3ed7-81f9-e9576f5c085b",
                                        "entry_id": "e290ea1f-9980-3292-90bc-8ba62e395c0b",
                                        "glosses": [
                                            "To change one's opinion, or be uneasy about a previous decision."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76fcd729-6e0d-460b-a2dc-c2eff589f005",
                                                "sense_id": "205df6bc-82a6-3ed7-81f9-e9576f5c085b",
                                                "text": "At first it seemed a good idea, but now it's getting close I'm having second thoughts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
