                ],
                "senses": [
                    {
                        "sense_id": "f5628e72-6f98-3d21-8589-825b566a4705",
                        "entry_id": "b6dc58dc-057d-3b6e-b8f9-a583f4553946",
                        "glosses": [
                            "житель или уроженец Великобритании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f6f4bc8-cba8-4a00-a8f8-28dcecd1b538",
                                "sense_id": "f5628e72-6f98-3d21-8589-825b566a4705",
                                "text": "Андрей тут же вспомнил, что в аптечке солдата обычно присутствует кровоостанавливающий порошок – гемостатик и британцы обычно пользуются продукцией Celox."
                            }
                        ]
                    },
                    {
                        "sense_id": "df5726ca-35e4-3ef2-b893-88bb31257967",
                        "entry_id": "b6dc58dc-057d-3b6e-b8f9-a583f4553946",
                        "glosses": [
                            "кот британской породы"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd9d8aad-9eb8-4876-b1b0-015cbec2abcc",
                        "source_entry_id": "b6dc58dc-057d-3b6e-b8f9-a583f4553946",
                        "target_lang_word": "Briton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                        "entry_id": "1f568842-68a6-3f54-a5a3-27a4b9f595d1",
                                        "glosses": [
                                            "An inhabitant of Great Britain, particularly (historical) a Celt from the area of Roman Britain or (obsolete) a Welshman; a British person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8064c1c7-400b-4114-b907-556349c5a411",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "The ancient Britons were particularly fond of Anglesey, which the Romans knew as Mona."
                                            },
                                            {
                                                "example_id": "aa0725a7-abaf-4eb1-be8e-a377e73ec87f",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "At last the Saxons had killed nearly all the Britons, and the few who remained took refuge in the mountains, in that part of the country which we now call Wales, and in Cornwall."
                                            },
                                            {
                                                "example_id": "c394c89e-7df2-4cfe-a863-32ae44ad2a63",
                                                "sense_id": "c7cc460d-5b14-3608-9d83-82a82d2e923a",
                                                "text": "He writhed for twenty minutes under the flowery and eulogistic periods of the president, and rose himself in the state of confused indignation which the Briton feels when he is publicly approved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                        "entry_id": "1f568842-68a6-3f54-a5a3-27a4b9f595d1",
                                        "glosses": [
                                            "A citizen of the United Kingdom or (historical, obsolete) its overseas empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d74248-6fbf-443e-8ed9-9e6067e4dbd0",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "Rule, Britannia! Britannia rules the waves:\nBritons never, never, never will be slaves."
                                            },
                                            {
                                                "example_id": "758ba366-43a6-486e-b881-3aa15b31b183",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "...when these hateful termes of Scottes and Englishemen, shalbe abolisshed, and blotted oute for euer, and we shal al agre in the onely title and name of Britons..."
                                            },
                                            {
                                                "example_id": "f6de3890-18bb-497d-a047-1a28187ec306",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "I glory in the name of Briton."
                                            },
                                            {
                                                "example_id": "25eae12a-600c-45e4-9d68-ee54362ecd9d",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "Many of the rank and file had no better conception of the proud and sensitive Maori than was implied in the degrading 'nigger' theory, invariably applied by the unthinking Briton to all coloured races."
                                            },
                                            {
                                                "example_id": "5f0316eb-66db-4639-ba18-fc28487df9e2",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "The victims included 3 Canadians, 2 Irishmen, and 1 Briton."
                                            },
                                            {
                                                "example_id": "eeedfac7-0223-4160-84c9-c14efb9e3619",
                                                "sense_id": "cae9497f-42ce-3960-b540-cb2dbae4bb94",
                                                "text": "The hiker was a Briton from New Zealand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c3f0df7-eb12-4f5e-ab7a-e00000574b9f",
                        "source_entry_id": "b6dc58dc-057d-3b6e-b8f9-a583f4553946",
                        "target_lang_word": "Britisher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Britisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                        "entry_id": "99c7ce7d-eed6-392f-8db8-18885674b35b",
                                        "glosses": [
                                            "A Briton."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "India",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e78be42-ec41-4787-8e37-3042a06039b8",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "\"Why now, I expect,\" said the American, \"you would not shoot me in cold blood, although you are a Britisher, I guess.\""
                                            },
                                            {
                                                "example_id": "077a92e4-b644-471a-97c9-01d64a4b18c6",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "[…] and as he spoke, there was just a soupçon of foreign accent in the pronunciation of the French vowels, a certain drawl of o's and a's, that would have betrayed the Britisher to an observant ear."
                                            },
                                            {
                                                "example_id": "9a147cdb-f05b-4a5f-bb73-b7918bdf5b52",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "French newspapers carried today a notice that all Britishers between the ages of 15 and 65 have been interned in special camps. Women and sick men have not been interned."
                                            },
                                            {
                                                "example_id": "115aecc5-8d1e-444e-833e-ec065c050f73",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "Even in the heart of London, Britishers boast you're never far from the countryside—only a few stories up!"
                                            },
                                            {
                                                "example_id": "4c65acce-225c-448e-a87d-dc2f085f33d9",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "From what we've heard, some of the gayest, hottest and most unusual bedroom scenes have resulted from a stewardess accepting the stiff and proper advance of a Britisher."
                                            },
                                            {
                                                "example_id": "e7bab265-978a-461f-81fc-a287114bcb88",
                                                "sense_id": "5ea370c8-5645-318e-8a2a-e7fee9927801",
                                                "text": "A lot of people have made the very valid point that it is a bit rich for a Britisher to criticise Indian food as being bland!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eaaf5f7-0d46-338b-a501-792016f32740",
                                        "entry_id": "99c7ce7d-eed6-392f-8db8-18885674b35b",
                                        "glosses": [
                                            "The British colonial authorities; a European member of the British Raj, especially an officer from the colonial authorities."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Britisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6eea1b48-7815-3195-ae8c-70fa55c80c0f",
                                        "entry_id": "c2f8aaa8-0232-391e-aa9f-cca835708409",
                                        "glosses": [
                                            "British"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b39b049f-7a82-43bc-8798-9316e878b9d7",
                                                "sense_id": "6eea1b48-7815-3195-ae8c-70fa55c80c0f",
                                                "text": "'Thought you'd like to hear some Britisher music. What you'd like. Some Beatles or some Rolling Stones maybe? They're Britisher, OK?'"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Britisher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b73055e-31f7-3e4e-9ae9-04422cf7cd56",
                                        "entry_id": "874f1118-2c32-36ae-a7b1-3b6590b6ba1e",
                                        "glosses": [
                                            "comparative form of British: more British"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b397bc-5499-4945-83a7-88bf3f988f50",
                                                "sense_id": "6b73055e-31f7-3e4e-9ae9-04422cf7cd56",
                                                "text": "She took a deep breath and stuck out her chin and said in a voice that was even a little higher and Britisher than she usually uses, “We girls have often cried, ‘Shut the Door!’ But now the Door is jolly well shut for keeps.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
