            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6dabeabe-fc64-3538-b148-8d132a364e88",
                    "sense_definition": "Mercy or leniency shown by someone in authority when judging or punishing someone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convicted man appealed to the judge for <w>clemency</w> before the sentence was read."
                        },
                        {
                            "text": "Instead of executing the prisoners, the general decided to show <w>clemency</w>."
                        }
                    ],
                    "synonyms": [
                        "leniency",
                        "mercy",
                        "compassion"
                    ],
                    "antonyms": [
                        "cruelty"
                    ],
                    "common_phrases": [
                        "appeal for clemency",
                        "show clemency",
                        "beg for clemency"
                    ]
                },
                {
                    "sense_id": "a2add54d-9acb-3ad0-a5d5-2597c9b2cbe2",
                    "sense_definition": "An official act by an executive officer reducing or eliminating a legal punishment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mercy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The governor chose to grant <w>clemency</w> to the inmate just hours before the scheduled execution."
                        },
                        {
                            "text": "Lawyers petitioned the president for executive <w>clemency</w> on humanitarian grounds."
                        }
                    ],
                    "synonyms": [
                        "pardon",
                        "commutation"
                    ],
                    "common_phrases": [
