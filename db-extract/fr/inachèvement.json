                        "sense_id": "ad90b50a-701e-3152-a527-17ab7bd63d89",
                        "entry_id": "5197759f-143d-374e-97cd-62b9b90c96f3",
                        "glosses": [
                            "État de ce qui n’est pas achevé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd473ff1-c3c6-4643-8086-3d283e021d05",
                                "sense_id": "ad90b50a-701e-3152-a527-17ab7bd63d89",
                                "text": "L’inachèvement d’un ouvrage."
                            },
                            {
                                "example_id": "807673fc-5a7d-423f-b8a0-1a8d0f3e5b52",
                                "sense_id": "ad90b50a-701e-3152-a527-17ab7bd63d89",
                                "text": "On pouvait considérer assez rêveusement, à la lueur de ces vagues indices, que l’inachèvement même de cette guerre, signe en réalité d’une chute de tension sans remède, était l’essentielle singularité qui nourrissait encore quelques imaginations baroques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96f0ab2b-7394-45df-9b85-37307b17eaa5",
                        "source_entry_id": "5197759f-143d-374e-97cd-62b9b90c96f3",
                        "source_sense_id": "ad90b50a-701e-3152-a527-17ab7bd63d89",
                        "target_lang_word": "incompleteness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incompleteness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e7e523-280f-34f7-926a-9d48daf9dda6",
                                        "entry_id": "7ce9979b-b159-318f-a0d8-4cebeb593d2e",
                                        "glosses": [
                                            "The state or condition of being not complete."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408d6daf-77af-4e18-a1c8-3c0034c38e72",
                                                "sense_id": "78e7e523-280f-34f7-926a-9d48daf9dda6",
                                                "text": "Its incompleteness in this respect makes the timetable of less value than some of its Continental counterparts, such as the French Horaires Mayeux; nevertheless, it is fair value at 5s."
                                            },
                                            {
                                                "example_id": "b7169c09-5e58-4b89-8f56-9df351ecd219",
                                                "sense_id": "78e7e523-280f-34f7-926a-9d48daf9dda6",
                                                "text": "This low number points to the incompleteness and, with respect, haphazardness of the two selections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
