                                        "sense_id": "07f2641a-ae15-33f5-b10e-260180097b5a",
                                        "entry_id": "e262360e-a032-32c2-acf4-ca2d9ddccf96",
                                        "glosses": [
                                            "A hunt; the act of hunting; the pursuit of game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "039ae289-d8be-4d3e-be55-e2558df00b09",
                                                "sense_id": "07f2641a-ae15-33f5-b10e-260180097b5a",
                                                "text": "By-and-by, she wandered away to an unnecessary revelation of her master's whereabouts: gone to help in the search for his landlord, the Sieur de Poissy, who lived at the château just above, and who had not returned from his chase the day before; so the intendant imagined he might have met with some accident, and had summoned the neighbours to beat the forest and the hill-side."
                                            },
                                            {
                                                "example_id": "ca58c847-3a5d-48e2-ac51-19f2864670fe",
                                                "sense_id": "07f2641a-ae15-33f5-b10e-260180097b5a",
                                                "text": "Through male bonding, the subculture of the hunt caught up in the mystique of the chase, the hunting party became a military force, and men discovered that they need not stop at defense: they could go out to hunt for other people's wealth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8365849c-c72e-37dc-a6b9-7517e97f39f2",
                                        "entry_id": "e262360e-a032-32c2-acf4-ca2d9ddccf96",
                                        "glosses": [
                                            "A children's game where one player chases another."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0e6fd56-b776-482f-aee4-87a95bc7e297",
                                                "sense_id": "8365849c-c72e-37dc-a6b9-7517e97f39f2",
                                                "text": "Some children like to be caught when playing chase, and others do not."
                                            },
                                            {
                                                "example_id": "00af93c7-5173-4a4b-b46e-b58b404e3095",
                                                "sense_id": "8365849c-c72e-37dc-a6b9-7517e97f39f2",
                                                "text": "So we played chase up and down the concourses of the airport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5cfc9f-b901-396e-8561-fc6049f09925",
                                        "entry_id": "e262360e-a032-32c2-acf4-ca2d9ddccf96",
                                        "glosses": [
                                            "A large country estate where game may be shot or hunted."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b28c7db-a257-4d76-b40c-8d9a185d7b60",
                                                "sense_id": "6e5cfc9f-b901-396e-8561-fc6049f09925",
                                                "text": "Outside, the stately oaks, rooted for ages in the green ground which has never known ploughshare, but was still a chase when kings rode to battle with sword and shield and rode a-hunting with bow and arrow, bear witness to his greatness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa3281d9-a909-35e2-a19c-1b0351c12dee",
                                        "entry_id": "e262360e-a032-32c2-acf4-ca2d9ddccf96",
                                        "glosses": [
                                            "Anything being chased, especially a vessel in time of war."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ea4a8b7-c80e-3775-818e-5bb45dd47997",
                                        "entry_id": "e262360e-a032-32c2-acf4-ca2d9ddccf96",
                                        "glosses": [
                                            "A wild animal that is hunted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
