                "senses": [
                    {
                        "sense_id": "e922c2be-da3d-3b14-b86d-b5c63e61c09f",
                        "entry_id": "9e90d04a-b5a5-3b36-9fc4-36afa6301721",
                        "glosses": [
                            "Faire perdre son caractère charlatanesque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f07bfea-b5ab-4519-8f32-4a440d47f9a0",
                                "sense_id": "e922c2be-da3d-3b14-b86d-b5c63e61c09f",
                                "text": "« La chimie, dit-il, est la fausse monnaie de notre métier. » Il poursuit donc les faux monnayeurs; il veut décharlataniser la médecine."
                            },
                            {
                                "example_id": "cf9b62d9-732d-493e-b497-f54d89928d03",
                                "sense_id": "e922c2be-da3d-3b14-b86d-b5c63e61c09f",
                                "text": "Pour les religions africaines, il s’agit de dévaudouiser Dieu, de le décharlataniser et de le déséloigner."
                            }
                        ]
                    }
                ],
