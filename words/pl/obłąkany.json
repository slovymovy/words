                },
                {
                    "sense_id": "d6cecd39-2581-3703-887e-34dbcb42233c",
                    "sense_definition": "świadczący o utracie zmysłów, szaleństwie lub chorobie psychicznej",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choroba_psychiczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego oczach pojawił się nagle <w>obłąkany</w> wzrok, który przeraził wszystkich zebranych w sali.",
                            "target_lang_translations": {
                                "ru": "В его глазах внезапно появился <w>безумный</w> взгляд, напугавший всех собравшихся в зале."
                            }
                        },
                        {
                            "text": "Z piwnicy starego domu dobiegał przerażający, <w>obłąkany</w> śmiech nieznajomego mężczyzny.",
                            "target_lang_translations": {
                                "ru": "Из подвала старого дома доносился леденящий душу, <w>дикий</w> смех незнакомца."
                            }
                        }
                    ],
                    "synonyms": [
