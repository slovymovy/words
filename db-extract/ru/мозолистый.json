                                                "example_id": "a6d0e20f-54ba-4ed7-840d-bbcebd26cf96",
                                                "sense_id": "1dd55819-4e16-311e-851a-46d87d80ac91",
                                                "text": "Ain’t that the horny bitch that was grindin with the blind dude."
                                            },
