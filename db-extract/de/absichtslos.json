                ],
                "senses": [
                    {
                        "sense_id": "0c4fe3b2-8130-321a-b001-49f97bf4de95",
                        "entry_id": "62b1c4b7-27ff-3100-8acf-823b6ed37d45",
                        "glosses": [
                            "ohne es ausdrücklich zu wollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435952e5-b723-4a4d-af06-5061400bf7c8",
                                "sense_id": "0c4fe3b2-8130-321a-b001-49f97bf4de95",
                                "text": "„Das beiläufige und absichtslose Hinaussehen aus den Fenstern des eigenen Hauses, die Einblick in ein Nachbargrundstück gewähren, kann keinen Eingriff in die Privatsphäre darstellen.“"
                            },
                            {
                                "example_id": "007d0dc6-14f1-4704-8dfc-79dac6aeed7a",
                                "sense_id": "0c4fe3b2-8130-321a-b001-49f97bf4de95",
                                "text": "„Das Publikum kann beim Zuhören aus dem Fenster schauen, auf die eigene Stadt, die dort in abendlich absichtslosem Wohlgefallen vorbeizieht, und vielleicht gelingt es dem einen oder anderen mithilfe der Literatur, sich noch einmal ganz neu in Nordrhein-Westfalen zu verlieben.“"
                            },
                            {
                                "example_id": "620da7f0-f2bf-496d-84c9-2925cb6c7061",
                                "sense_id": "0c4fe3b2-8130-321a-b001-49f97bf4de95",
                                "text": "„Natürlich, nicht jedes der sieben Stücke ist Verheißung auf ein kommendes Meisterwerk, manches wirkt wie eine Schauspielszene, zu der sich absichtslos Musik gesellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
