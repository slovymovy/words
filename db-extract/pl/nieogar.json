                        "target_lang_word": "unco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b6d298f-e33d-368e-8276-4b640367ba58",
                                        "entry_id": "cf23db86-c538-3908-99ff-694666b973f1",
                                        "glosses": [
                                            "Strange, weird."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23311580-9bcc-4445-bc10-b2ca025a158b",
                                                "sense_id": "8b6d298f-e33d-368e-8276-4b640367ba58",
                                                "text": "It was noted by them that kenned best that her cantrips were at their worst when the tides in the Sker Bay ebbed between the hours of twelve and one. At this season of the night the tides of mortality run lowest, and when the outgoing of these unco waters fell in with the setting of the current of life, then indeed was the hour for unholy revels."
                                            },
                                            {
                                                "example_id": "d2747dec-ffa8-491d-a22d-db5e3c79dd18",
                                                "sense_id": "8b6d298f-e33d-368e-8276-4b640367ba58",
                                                "text": "And the second quean was Hope and she was near as unco as Faith, but had right bonny hair, red hair, though maybe you'd call it auburn […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b92b54-0b40-3584-a44d-96d3b0992c73",
                                        "entry_id": "c35af438-9fe1-369a-bffb-74b5e77e8eb2",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [
                                            "Northern",
                                            "Scotland",
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fb093b-c788-4a25-9d49-c70dabb80e0e",
                                                "sense_id": "49b92b54-0b40-3584-a44d-96d3b0992c73",
                                                "text": "‘Ye should tear up this carpet, Robbie,’ Uncle Peter called back over his shoulder. ‘It's most unco wearisome when a body′s leg-weary.’"
                                            },
                                            {
                                                "example_id": "b690ee5e-b536-4145-8607-9ac3bc31996e",
                                                "sense_id": "49b92b54-0b40-3584-a44d-96d3b0992c73",
                                                "text": "Jamie has met only two kids of women: the mainly elderly and unco good who belong to his father's congregation, and those who drink in pubs and shebeens used by nearly penniless medical students."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "056f6d30-99ca-326a-baee-e02ff0449a92",
                                        "entry_id": "d1849a59-0d24-3ad1-b794-f360b006d051",
                                        "glosses": [
                                            "Uncoordinated."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9506c761-2254-49ee-8bf0-bcb265a5a8d5",
                                                "sense_id": "056f6d30-99ca-326a-baee-e02ff0449a92",
                                                "text": "‘Aren′t he the most unco kid you ever come across?’ Norm refused to have Kevin on his boat even if he begged to be taken because he was too clumsy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
