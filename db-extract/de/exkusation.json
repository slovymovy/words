                                        "glosses": [
                                            "sakatlık, bozukluk, eksiklik veya elverişsizlik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "949d8885-6f26-4032-b76a-94f31f228f0d",
                                                "sense_id": "c4d477e6-21a7-30e4-8ea1-c62690b79b8c",
                                                "text": "Bu evin birtakım özürleri var."
                                            },
                                            {
                                                "example_id": "5120a7de-77d4-4788-aaba-147d75d951bc",
                                                "sense_id": "c4d477e6-21a7-30e4-8ea1-c62690b79b8c",
