                        "glosses": [
                            "Lit dont le sommier peut se relever au niveau de la tête pour y être en position assise, et que l'on utilise dans les hôpitaux."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c90f9e4f-fedb-45ac-99b4-96bfb75d337f",
                                "sense_id": "66436ad2-c9a5-3741-a262-d69a27e4d06c",
                                "text": "Le double support de Tanchou fait parti d'un lit-fauteuil où le malade est presque assis."
                            }
                        ]
                    },
                    {
                        "sense_id": "f285fffa-85fe-3e4d-ab2f-7dd888814dc0",
                        "entry_id": "2f52aaa1-6e5a-3d4f-94c9-d94d63941701",
                        "glosses": [
                            "Fauteuil pouvant s'incliner, voire se déplier jusqu'à faire un lit d'appoint pour une personne."
                        ],
                        "tags": [],
                        "note": "Dans ce sens on parle plutôt d'un fauteuil-lit ou fauteuil lit",
                        "examples": [
                            {
                                "example_id": "ad2431c1-f422-4f2f-82ea-092085ffd95f",
                                "sense_id": "f285fffa-85fe-3e4d-ab2f-7dd888814dc0",
                                "text": "Je fus pris en charge par un lit-fauteuil ou fauteuil-lit dont l'effondrement délicieux du dossier s'accompagnait d'une légère remontée du siège sous mes coudes ."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a8a1566-936e-340b-8066-254ad9a0e8f7",
                        "entry_id": "2f52aaa1-6e5a-3d4f-94c9-d94d63941701",
                        "glosses": [
                            "Déplacement que l'on fait effectuer à un malade alité pour le réhabituer à se lever."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6407637a-4d4d-4c20-ade4-cdba715d05a4",
                                "sense_id": "3a8a1566-936e-340b-8066-254ad9a0e8f7",
                                "text": "Le maniement de ce satané fauteuil, lit-fauteuil, toilettes-fauteuil, fauteuil-toilettes, bouger, toujours bouger, réapprendre à vivre, se mouvoir au ralenti au départ …"
                            },
                            {
                                "example_id": "a232a1ab-6205-493c-95a0-29e07afc2d66",
                                "sense_id": "3a8a1566-936e-340b-8066-254ad9a0e8f7",
                                "text": "Les exercices qui améliorent directement l'indépendance fonctionnelle des patients (périmètre de marche, transferts lit-fauteuil, escaliers, activités de vie quotidienne, etc.), …."
                            }
                        ]
                    }
