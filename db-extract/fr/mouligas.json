                        ],
                        "examples": [
                            {
                                "example_id": "a40af582-f703-46b9-a2ea-ed7f0341bb86",
                                "sense_id": "e9805690-582d-3d06-8b2d-d6da9e89d83d",
                                "text": "J'essaie de prendre un air convaincu mais le cou ballant de la pauvre bestiole avec sa crête toute « mouligasse » ne m'inspire que très moyennement."
                            }
                        ]
                    },
                    {
