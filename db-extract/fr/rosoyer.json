                "senses": [
                    {
                        "sense_id": "5e01da68-c821-3e43-8458-f9d4c72ac8cb",
                        "entry_id": "c6ec6fbb-6acb-3d48-9435-eac2cd9b94e0",
                        "glosses": [
                            "Tomber en forme de rosée."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d3f02168-09fb-4ff0-ae44-9abbdb456910",
                                "sense_id": "5e01da68-c821-3e43-8458-f9d4c72ac8cb",
                                "text": "De la douce liqueur rosoyante du ciel."
                            }
                        ]
                    },
                    {
                        "sense_id": "2227cd8e-06e4-3b86-9296-704ff55042b5",
                        "entry_id": "c6ec6fbb-6acb-3d48-9435-eac2cd9b94e0",
                        "glosses": [
                            "Avoir des reflets roses ; prendre une teinte rosâtre."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6fae9090-55e7-48ac-a887-0d3bd06e92a2",
                                "sense_id": "2227cd8e-06e4-3b86-9296-704ff55042b5",
                                "text": "Engourdi que je suis par le froid de l’absence,\nJ’ai, comme un sens vieilli, perdu cette puissance\nQui fait, sous les glaçons, rosoyer le printemps."
                            },
                            {
                                "example_id": "14f2ce44-5e9e-4266-b019-f989fe32fc0d",
                                "sense_id": "2227cd8e-06e4-3b86-9296-704ff55042b5",
                                "text": "Verse-nous largement le vin de l'idéal\nQui rosoie en ta coupe et comme un rubis luit."
                            }
                        ]
                    }
                ],
