                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f60b2c5-263d-47e4-9b2c-82165cf62627",
                        "source_entry_id": "545d5374-3877-3668-8e63-e5a3dc39a9c0",
                        "source_sense_description": "tool",
                        "target_lang_word": "chalumeau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chalumeau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "187294b6-7fe1-36da-ba01-95074b66ca71",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Tuyau de paille, de roseau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0f5b66-379b-4955-a881-95f95f395dec",
                                                "sense_id": "187294b6-7fe1-36da-ba01-95074b66ca71",
                                                "text": "Ils brisaient mon sein oppressé en le frappant d'un chalumeau de paille, rompu en forme de fléau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc25040b-9797-3a57-9533-311aa13462d0",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Paille utilisée pour aspirer un liquide."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abdcbc40-6184-423f-8760-9439bd9aeb9c",
                                                "sense_id": "cc25040b-9797-3a57-9533-311aa13462d0",
                                                "text": "[…] Letizia prit sur son guéridon un verre qu’elle remplit d’excellent vin et un chalumeau. Ayant introduit le chalumeau dans le cercueil par un des trous et trempé l’autre bout dans le verre, elle dit : — Buvez tant que vous voudrez […]"
                                            },
                                            {
                                                "example_id": "cb7da72e-8aba-4862-8c4a-0e5869d68839",
                                                "sense_id": "cc25040b-9797-3a57-9533-311aa13462d0",
                                                "text": "Armé d'un chalumeau, le gnome absorbait à même le ruisseau la boisson répandue. C'était grotesque, révoltant."
                                            },
                                            {
                                                "example_id": "ef5112c2-c732-4275-899d-1260d8196660",
                                                "sense_id": "cc25040b-9797-3a57-9533-311aa13462d0",
                                                "text": "Dans la lumière d’une des lampes, un verre se découpe, à l’écart, sur le tapis : à demi plein d’un liquide rouge, avec une tranche de ctron que traverse un chalumeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f422457-8965-36c8-93f7-26215d352170",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Tuyau utilisé pour souffler des bulles de savon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71b0b1a7-5345-4856-9e61-b19ec7b51709",
                                                "sense_id": "6f422457-8965-36c8-93f7-26215d352170",
                                                "text": "Celui dont la bulle crève en sortant du chalumeau donne un gage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060321f0-cc9e-3450-b6ce-15ff92bd05b1",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Sorte de flûte champêtre pour attirer les oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b805d76f-7ac0-46f7-9888-dcbaecc40cc5",
                                                "sense_id": "060321f0-cc9e-3450-b6ce-15ff92bd05b1",
                                                "text": "Petit chalumeau pour contrefaire les cris des oiseaux et les attirer sur des arbres chargés de gluaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606091ec-2513-39ea-b1b6-c98f1ef78eee",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Tuyau ou tube en métal ou en verre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31f5c3c-8a66-4951-b637-b77918ce537b",
                                                "sense_id": "606091ec-2513-39ea-b1b6-c98f1ef78eee",
                                                "text": "Le chalumeau de Tennant consiste en un tube droit, cylindrique […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a030966c-b91d-3605-a534-4dc39ff36e19",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Tube en or servant à aspirer le contenu d’un calice."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcb7670c-d9b2-45f6-8755-a77f603551a9",
                                                "sense_id": "a030966c-b91d-3605-a534-4dc39ff36e19",
                                                "text": "Pour éviter cette difficulté et l’inconvénient de communier avec un grand Calice, dont les parois sont toujours évasées, les Évêques établirent l’usage d’un chalumeau ou tube en or […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "638e7c71-8614-3f28-bcaf-8a584a397ae2",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Dispositif terminé par un tuyau dans lequel est soufflé un gaz combustible produisant de la chaleur. → voir chalumeau oxyacétylénique, découper au chalumeau et chalumeau à plasma"
                                        ],
                                        "tags": [
                                            "Soudage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4a6376b-b228-49b7-be2b-b25ee715f9be",
                                                "sense_id": "638e7c71-8614-3f28-bcaf-8a584a397ae2",
                                                "text": "Le coffre-fort ne veut pas être brutalisé, violenté ; il faut user de douceur avec lui, le caresser longuement. Une pince-monseigneur, un chalumeau ? Allons donc. Un petit air de flûte. Le charme opère."
                                            },
                                            {
                                                "example_id": "02860c91-8a84-4fa0-86e7-ccebfff17404",
                                                "sense_id": "638e7c71-8614-3f28-bcaf-8a584a397ae2",
                                                "text": "L’appareil que je vous décris est tout bonnement un chalumeau à gaz oxygène et hydrogène, dont la chaleur dépasse celle des feux de forge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9d4aae-e7a7-30a4-a15a-7211f8076dbb",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Tuyau mélodique de certains instruments à vent comme le biniou, la cornemuse, la musette … → voir jouer du chalumeau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15da6e9b-d0a2-4bd1-b359-3afd10ff5a5f",
                                                "sense_id": "bb9d4aae-e7a7-30a4-a15a-7211f8076dbb",
                                                "text": "Le vent sort par trois chalumeaux qu’on nomme : le grand bourdon, le petit bourdon, et la flûte, qui est à anche battante et qui , par conséquent , est un véritable hautbois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8b93b6a-ec1d-3e3b-990f-750faadced63",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Instrument de musique pastorale qui n’était originairement qu’un roseau percé de plusieurs trous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3978356f-48be-4ca2-bc1a-a4758a4da6d7",
                                                "sense_id": "c8b93b6a-ec1d-3e3b-990f-750faadced63",
                                                "text": "Dans le langage courant, le chalumeau est un pipeau pastoral fait d’un tuyau de paille ou de roseau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53cd5aab-fe2d-353c-b562-081a5bfd6671",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Registre grave de la clarinette."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2773647-732a-498a-8222-0bfaeae43325",
                                                "sense_id": "53cd5aab-fe2d-353c-b562-081a5bfd6671",
                                                "text": "[…] pendant que le caractère menaçant des sons graves du chalumeau se rapproche, mais seulement par la rudesse des vibrations, de celui de certaines notes du basson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79183a15-51a3-3963-9c58-8f9c658f5b9e",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Toute sorte de flûtes et d’instrument à vent qui composent une musique champêtre. → voir chalumeau champêtre et enfler ses chalumeaux"
                                        ],
                                        "tags": [
                                            "analogy",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca59b7c1-0b3e-4e1b-9ee8-43b7199407ae",
                                                "sense_id": "79183a15-51a3-3963-9c58-8f9c658f5b9e",
                                                "text": "Virgile pouvait dire comme nous : tu médites un air champêtre sur un faible chalumeau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b33881a2-0143-37a3-b70a-fde0bd9c6403",
                                        "entry_id": "24446392-79a9-33bf-a807-1416f7601b0d",
                                        "glosses": [
                                            "Trachée-artère."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e03f0030-ae54-43e6-9296-c4bb6917ef96",
                                                "sense_id": "b33881a2-0143-37a3-b70a-fde0bd9c6403",
                                                "text": "Il n'a pas crié, celui-là, il ne le pouvait pas ; je pense que je lui avais crevé le chalumeau…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
