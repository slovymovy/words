                                        "sense_id": "adfdddba-d49b-3edf-8c2d-648a87193147",
                                        "entry_id": "15e76a99-e90a-35be-ac7f-56da803f2373",
                                        "glosses": [
                                            "eine philosophische Schule, die Denken und Handeln nur vom Standpunkt des praktischen Nutzens aus betrachtet und für die Wahrheit das ist, was nützlich ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "951060ec-16a6-392a-bd3f-1f6ba1077bcf",
                                        "entry_id": "15e76a99-e90a-35be-ac7f-56da803f2373",
                                        "glosses": [
                                            "Einstellung, bei der das Handeln nicht an festen Prinzipien ausgerichtet ist, sondern sich an den Gegebenheiten orientiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f123e4-6058-4633-8600-208b46cd44b6",
                                                "sense_id": "951060ec-16a6-392a-bd3f-1f6ba1077bcf",
                                                "text": "„Die deutsche Außenpolitik war immer durch einen gewissen Pragmatismus gekennzeichnet”, sagt Lukjanow."
                                            },
                                            {
                                                "example_id": "ce57679d-e384-45ac-a320-fc955d29b03f",
                                                "sense_id": "951060ec-16a6-392a-bd3f-1f6ba1077bcf",
                                                "text": "Nun hat bekanntlich schon Helmut Schmidt den von Visionen Geplagten einen Gang zum Arzt angeraten, weshalb das Fehlen derselben als Zeichen von Pragmatismus interpretiert wird."
                                            },
                                            {
                                                "example_id": "16f48e4a-5156-4ca4-87c7-9aec24b55b88",
                                                "sense_id": "951060ec-16a6-392a-bd3f-1f6ba1077bcf",
                                                "text": "„Frauen neigen zu Pragmatismus. […] Sie sagen zum Beispiel: Es ist jetzt an der Zeit, ein Kind zu bekommen, ich habe nicht mehr so viel Zeit.“"
                                            },
                                            {
                                                "example_id": "af42d269-2db8-472f-ac91-8c06fc12bbf4",
                                                "sense_id": "951060ec-16a6-392a-bd3f-1f6ba1077bcf",
                                                "text": "„Er betonte die Liebe der Amerikaner zu Pragmatismus und Modernisierung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
