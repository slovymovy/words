{
    "word_family": [
        "klappen",
        "verklapping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a214f03-934f-3538-b393-2ff9c0620788",
                    "sense_definition": "Een geheim, verrassing of verborgen informatie onthullen aan iemand die het nog niet wist.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reveal_secret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag absoluut niet <w>verklappen</w> wat we voor haar verjaardag hebben gekocht.",
                            "target_lang_translations": {
                                "en": "You absolutely must not <w>give away</w> what we bought for her birthday.",
                                "ru": "Ты ни в коем случае не должен <w>выдавать</w>, что мы купили ей на день рождения.",
                                "fr": "Tu ne dois absolument pas <w>révéler</w> ce qu'on a acheté pour son anniversaire."
                            }
                        },
                        {
                            "text": "Hij heeft per ongeluk het einde van de spannende film <w>verklapt</w>.",
                            "target_lang_translations": {
                                "en": "He accidentally <w>spoiled</w> the ending of the exciting movie.",
                                "ru": "Он случайно <w>разболтал</w> концовку захватывающего фильма.",
                                "fr": "Il a accidentellement <w>spoilé</w> la fin de ce film captivant."
                            }
                        }
                    ],
                    "synonyms": [
                        "spoilen",
                        "verbabbelen",
                        "verraden"
                    ],
                    "antonyms": [
                        "geheimhouden",
                        "verzwijgen"
                    ],
                    "common_phrases": [
                        "een geheim verklappen",
                        "niets verklappen",
                        "per ongeluk verklappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To reveal a secret, surprise, or hidden information to someone who did not know it yet.",
                        "ru": "Раскрыть секрет, сюрприз или скрытую информацию тому, кто об этом ещё не знал.",
                        "fr": "Révéler un secret, une surprise ou une information cachée à quelqu'un qui ne le savait pas encore."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give away",
                                "target_lang_sense_clarification": "a secret or surprise"
                            },
                            {
                                "target_lang_word": "reveal",
                                "target_lang_sense_clarification": "hidden information"
                            },
                            {
                                "target_lang_word": "spill",
                                "target_lang_sense_clarification": "informal; to tell a secret"
                            },
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "general"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "выдать",
                                "target_lang_sense_clarification": "секрет или сюрприз"
                            },
                            {
                                "target_lang_word": "разболтать",
                                "target_lang_sense_clarification": "разговорное; рассказать секрет"
                            },
                            {
                                "target_lang_word": "раскрыть",
                                "target_lang_sense_clarification": "информацию"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "révéler",
                                "target_lang_sense_clarification": "un secret ou une information"
                            },
                            {
                                "target_lang_word": "vendre la mèche",
                                "target_lang_sense_clarification": "dévoiler un secret"
                            },
                            {
                                "target_lang_word": "divulguer",
                                "target_lang_sense_clarification": "rendre public un secret"
                            },
                            {
                                "target_lang_word": "spoiler",
                                "target_lang_sense_clarification": "familier, révéler la fin d'un film ou d'une histoire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1462356-0c74-3c8f-8edd-40112a7204a4",
                    "sense_definition": "De tijd nutteloos doorbrengen met praten.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "waste_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben de hele middag <w>verklapt</w> in plaats van te studeren.",
                            "target_lang_translations": {
                                "en": "We <w>chattered away</w> the whole afternoon instead of studying.",
                                "ru": "Мы <w>проболтали</w> весь день вместо того, чтобы учиться.",
                                "fr": "Nous avons <w>passé tout l'après-midi à bavarder</w> au lieu d'étudier."
                            }
                        },
                        {
                            "text": "Het is zonde om je kostbare tijd te <w>verklappen</w> aan onbelangrijke zaken.",
                            "target_lang_translations": {
                                "en": "It is a shame to <w>chatter away</w> your precious time on unimportant matters.",
                                "ru": "Жаль <w>проболтать</w> своё драгоценное время на неважные дела.",
                                "fr": "C'est dommage de <w>gaspiller</w> ton temps précieux <w>en bavardages</w> sur des futilités."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbeuzelen",
                        "verbabbelen"
                    ],
                    "common_phrases": [
                        "zijn tijd verklappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is less common in modern standard Dutch compared to the meaning of revealing secrets."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To spend time uselessly by talking.",
                        "ru": "Бесполезно проводить время за разговорами.",
                        "fr": "Passer son temps inutilement à bavarder."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "chatter away",
                                "target_lang_sense_clarification": "time spent talking"
                            },
                            {
                                "target_lang_word": "gossip away",
                                "target_lang_sense_clarification": "time spent gossiping"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проболтать",
                                "target_lang_sense_clarification": "провести время в разговорах"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "passer à bavarder",
                                "target_lang_sense_clarification": "perdre du temps en parlant"
                            },
                            {
                                "target_lang_word": "gaspiller en bavardages",
                                "target_lang_sense_clarification": "perdre son temps"
                            }
                        ]
                    }
                }
            ]
        }
    ]
