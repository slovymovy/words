                "senses": [
                    {
                        "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                        "entry_id": "cd9e0ebf-67c2-3f04-8c19-ab83b5993016",
                        "glosses": [
                            "durchschnittliches, konstantes Ausdauertempo (Lauftempo), das ein Läufer idealerweise über die gesamte Marathondistanz halten kann"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2167293b-c7af-4d2e-ae2a-5c8a8987a14e",
                                "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                                "text": "„Ich hatte im vergangenen Jahr einen ersten lockeren Halbmarathon im Marathontempo versucht – und bin dann zwei Monate später bei der 21,1-km-Zwischenzeit auf die Minute gleich schnell gewesen.“"
                            },
                            {
                                "example_id": "b8458b1c-3c5d-416f-88c8-69e50ec42210",
                                "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                                "text": "„In den nächsten Wochen werde ich an gleicher Stelle 3000er und sogar 5000er im Marathontempo abspulen.“"
                            },
                            {
                                "example_id": "506817b4-8f6e-44fa-81b9-bede8783173e",
                                "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                                "text": "„Die Streckenlängen zwischen 2.000 und 6.000 Metern werden zunächst im Marathontempo gelaufen und mit entsprechendem Trainingsfortschritt etwas schneller.“"
                            },
                            {
                                "example_id": "e5438eb6-5f73-4776-ab09-ec161a7aef23",
                                "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                                "text": "„Beim ersten Bewerb testeten alle Interessierten, ob sie auf einer kurzen Strecke das Marathontempo von Eliud Kipchoge schaffen.“"
                            },
                            {
                                "example_id": "a43e2ae2-16dd-4347-8b0c-02054aa71c1f",
                                "sense_id": "c9d2457d-9bd8-3ff5-a256-97b2e6f227e9",
                                "text": "„Die Endbeschleunigung lief super und ich konnte schon sehr nah ran gehen an mein geplantes Marathontempo, trotz vieler Steigungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
