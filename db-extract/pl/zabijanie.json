                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ea35e6-d153-4365-9ea9-ec8805306f40",
                                "sense_id": "9b58755c-3738-3152-92f0-511dc3eb912a",
                                "text": "Wielu ludzi godzi się milcząco i z niesmakiem na zabijanie zwierząt, ponieważ poddani myśliwskiej indoktrynacji sądzą, że „nie ma innego wyjścia”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aad2bd37-4e1c-4049-978c-921aa27853ff",
                        "source_entry_id": "3834e056-4f5a-3c08-bc7f-c0867c93481e",
                        "source_sense_id": "9b58755c-3738-3152-92f0-511dc3eb912a",
                        "target_lang_word": "killing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "killing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6453bf72-859d-3607-b38f-e469192324fd",
                                        "entry_id": "93e3fe0a-3ae3-3488-ad5d-b375aea581ae",
                                        "glosses": [
                                            "That literally deprives of life; lethal, deadly, fatal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad3ff4f1-169f-35a1-a7a4-466d22ee0019",
                                        "entry_id": "93e3fe0a-3ae3-3488-ad5d-b375aea581ae",
                                        "glosses": [
                                            "Devastatingly attractive."
                                        ],
                                        "tags": [
                                            "dated",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1808060e-8e01-435f-921e-b77cc9b1e15b",
                                                "sense_id": "ad3ff4f1-169f-35a1-a7a4-466d22ee0019",
                                                "text": "Should true Proportion ev'ry Mortal grace, / And Semetry be seen in ev'ry Face: / Beauty no longer would be thought divine, / Nor would its Charms with half the Lustre shine: / No courtly Dame a killing Look could boast, / If once the Foils of Homeliness were lost."
                                            },
                                            {
                                                "example_id": "6f808a74-5817-45a5-8edd-709759dd3744",
                                                "sense_id": "ad3ff4f1-169f-35a1-a7a4-466d22ee0019",
                                                "text": "He sprang to open the door for the ladies, when they retired, with the most killing grace […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9720ff-22e5-3c22-901e-280589baa1e3",
                                        "entry_id": "93e3fe0a-3ae3-3488-ad5d-b375aea581ae",
                                        "glosses": [
                                            "That makes one ‘die’ with laughter; very funny."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16203e9d-eac1-4845-b881-1586bdad05ff",
                                                "sense_id": "bf9720ff-22e5-3c22-901e-280589baa1e3",
                                                "text": "Livia found her ‘killing’, and derived such amusement from her Martinique French that he was forced to enjoy her as well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "killing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bee336d-2f0c-38c5-ab29-5a1ef9090d07",
                                        "entry_id": "b6b853a3-50d3-34a8-8d2a-9e817844c806",
                                        "glosses": [
                                            "The act of killing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94bd18ee-c866-4168-b5b8-c181bd737fae",
                                                "sense_id": "4bee336d-2f0c-38c5-ab29-5a1ef9090d07",
                                                "text": "In fact, Tarzan had never killed for “pleasure,” nor to him was there pleasure in killing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                        "entry_id": "b6b853a3-50d3-34a8-8d2a-9e817844c806",
                                        "glosses": [
                                            "An instance of someone being killed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "689b9296-71e7-4eb4-85be-a9cb27f1ae80",
                                                "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                                "text": "The outrage over the brutal killings of peaceful demonstrators in Lhasa in March 1989 quickly faded after the massacres in Beijing in June."
                                            },
                                            {
                                                "example_id": "e78d7ae0-4afa-4aaa-91b9-3705c9c16f61",
                                                "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                                "text": "A police officer in neighboring Mekit county told RFA he was informed that police were searching the houses for a suspect from Pichan (in Chinese, Shanshan) county in Xinjiang’s Turpan prefecture when the killings occurred."
                                            },
                                            {
                                                "example_id": "a3e421c9-cb8f-44aa-9994-35a5b6fc31d9",
                                                "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                                "text": "But the split-screen nature of this moment in his presidency was underscored when Mr. Trump devoted the first nine minutes of his speech to the killing of George Floyd in Minneapolis and the subsequent protests and riots unfolding in cities across the country."
                                            },
                                            {
                                                "example_id": "97b1b8b8-936c-4021-9c8c-85935ec7ed9e",
                                                "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                                "text": "A man shot dead 12 people in a rampage in a small town in Montenegro before dying from self-inflicted injuries early on Thursday, authorities said, in one of the tiny Balkan nation’s worst mass killings."
                                            },
                                            {
                                                "example_id": "700e60f2-41c5-4dca-9e5b-cf5b017e7f14",
                                                "sense_id": "7c86e283-9652-3de3-9d20-bf6f66ee4d49",
                                                "text": "In the first year of her administration, ACLED data shows, Sheinbaum’s efforts to contain violence have generally coincided with a drop in attacks against civilians; since January, civilian killings have declined in nearly every Mexican state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c362223d-e33e-3810-8e80-b0b5feb435b1",
                                        "entry_id": "b6b853a3-50d3-34a8-8d2a-9e817844c806",
                                        "glosses": [
                                            "A large amount of money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b111bba-637f-449c-8c6b-01d92118bb5c",
                                                "sense_id": "c362223d-e33e-3810-8e80-b0b5feb435b1",
                                                "text": "He made a killing on the stock market."
                                            },
                                            {
                                                "example_id": "f46ed42b-0d79-4875-be91-d9273b2c197d",
                                                "sense_id": "c362223d-e33e-3810-8e80-b0b5feb435b1",
                                                "text": "The result is, in the end, the superintendent agrees to hold up another race, and the victim arranges to obtain all the money he can get in order to bet it on a sure thing. When the great \"killing\" is made, and the stripped victim goes back to consult with the superintendent[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
