                "senses": [
                    {
                        "sense_id": "9bc7e3d9-d8d0-31da-94fb-3ed55550772e",
                        "entry_id": "f8bf3469-1a49-33e4-8749-b9bdbafd785f",
                        "glosses": [
                            "Griff, den man drehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04737658-7afc-4ff4-a459-8a702cde755f",
                                "sense_id": "9bc7e3d9-d8d0-31da-94fb-3ed55550772e",
                                "text": "„E-Bikes sind Elektrofahrräder, bei denen die Fahrgeschwindigkeit auch unabhängig vom Treten, per Drehgriff am Lenker, reguliert werden kann.“"
                            },
                            {
                                "example_id": "36050bd7-15a4-4e45-8eec-ab1c0595d5a4",
                                "sense_id": "9bc7e3d9-d8d0-31da-94fb-3ed55550772e",
                                "text": "„E-Bikes sind mit einem Elektromofa zu vergleichen und lassen sich mit Hilfe des Elektroantriebs durch einen Drehgriff oder Schaltknopf fahren, auch ohne dabei in die Pedale zu treten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
