                                "target_senses": [
                                    {
                                        "sense_id": "9f43238c-3e7c-3c78-a01e-69cca997d7bc",
                                        "entry_id": "47646f09-e117-3eff-9677-84437c934815",
                                        "glosses": [
                                            "A chronic condition characterized by redness of the face."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd5d506-82b8-4992-b5c8-4aeaa07c2edc",
                                                "sense_id": "9f43238c-3e7c-3c78-a01e-69cca997d7bc",
                                                "text": "It’s hardly surprising that rosacea tends to strike the fair-skinned, especially people of Celtic or Northern European extraction, according to the National Rosacea Society, an association that receives financing from pharmaceutical and cosmetic companies that market rosacea remedies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73151387-b4cb-49c2-b113-7a2d0bd4e2f9",
                        "source_entry_id": "5059f97c-6334-3970-b2f1-1f68a3a39ba2",
                        "source_sense_id": "2a5edc9d-28fd-3cad-9621-696a448dfe9c",
                        "source_sense_description": "entzündliche Hauterkrankung mit Rötungen im Gesicht",
                        "target_lang_word": "rosacée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rosacée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8686528f-f556-3b17-bbde-5efb51440e47",
                                        "entry_id": "0c6da590-9973-3367-9077-5c6050091b50",
                                        "glosses": [
                                            "Plante de la famille des Rosacées, dont les corolles se composent de pétales disposés comme ceux de la rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71d5f88-50db-4e56-a5bb-db1f2f6dd642",
                                                "sense_id": "8686528f-f556-3b17-bbde-5efb51440e47",
                                                "text": "Le pommier, le poirier, la ronce sont des rosacées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933a24f4-7fae-353d-88d0-3d5a01f087b4",
                                        "entry_id": "0c6da590-9973-3367-9077-5c6050091b50",
                                        "glosses": [
                                            "Autre nom de la couperose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eacaa31-e627-4022-b732-1748f38b1453",
                                                "sense_id": "933a24f4-7fae-353d-88d0-3d5a01f087b4",
                                                "text": "La couperose et la rosacée sont deux affections cutanées distinctes, mais elles présentent un point commun : elles résultent d’une déficience de la microcirculation sanguine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d233646-0f89-4a04-9a6b-eb3733189d66",
                        "source_entry_id": "5059f97c-6334-3970-b2f1-1f68a3a39ba2",
                        "source_sense_id": "2a5edc9d-28fd-3cad-9621-696a448dfe9c",
                        "source_sense_description": "entzündliche Hauterkrankung mit Rötungen im Gesicht",
                        "target_lang_word": "couperose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couperose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "529468e0-41cb-3b41-b1d3-e987ef342176",
                                        "entry_id": "dd42b670-b6d7-3762-ad42-25a3308786b0",
                                        "glosses": [
                                            "Nom donné autrefois à différents sulfates."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16a5cc70-4c9c-4a7d-8f87-ddd7ed385841",
                                                "sense_id": "529468e0-41cb-3b41-b1d3-e987ef342176",
                                                "text": "Couperose verte, sulfate de fer."
                                            },
                                            {
                                                "example_id": "dd67a5a9-0665-4647-8bd2-f3e9f06260be",
                                                "sense_id": "529468e0-41cb-3b41-b1d3-e987ef342176",
                                                "text": "Couperose blanche, sulfate de zinc ou parfois sulfate de cuivre anhydre."
                                            },
                                            {
                                                "example_id": "da684003-9858-42ad-b28d-9578e1829cfe",
                                                "sense_id": "529468e0-41cb-3b41-b1d3-e987ef342176",
                                                "text": "Couperose bleue, sulfate de cuivre hydraté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                        "entry_id": "dd42b670-b6d7-3762-ad42-25a3308786b0",
                                        "glosses": [
                                            "Maladie dont le siège principal est le visage, et qui est caractérisée par des pustules peu étendues, plus ou moins dures, et entourées d’une aréole rose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b910faa-4cab-479a-8592-cd6c27126943",
                                                "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                                "text": "Quand le cercueil roula doucement, des joues éraflées de couperose pâlirent."
                                            },
                                            {
                                                "example_id": "95125a58-4b6e-4e6c-99f9-ceee88a85b7f",
                                                "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                                "text": "Mme Berthier d’Eyzelles, raide sous ses bandeaux gris de fer chargés de diamants. La couperose de son visage rehaussait la dignité de son attitude. Elle était très regardée."
                                            },
                                            {
                                                "example_id": "5960c33f-0b37-4397-85ae-33303554e112",
                                                "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                                "text": "Elle avait réussi à le mettre hors de lui. Les couperoses de ses joues passèrent du rouge au violet."
                                            },
                                            {
                                                "example_id": "a24657ea-a2e0-4ff3-a6fc-b4c6cfaf7464",
                                                "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                                "text": "Le visage du professeur, d’ordinaire enflammé de couperose au premier verre d’alcool, avait viré au gris-mauve, mais, couronnés par la vaporeuse chevelure blanche et soulignés par l’épaisse barre des sourcils noirs en bataille, les traits semblaient singulièrement calmes encore qu’à chaque expiration, les lèvres craquelées se gonflassent pour à peine se décoller et laisser passer le souffle chuinté d’une machine à vapeur sur le point de s’arrêter après quelques derniers et pathétiques hoquets."
                                            },
                                            {
                                                "example_id": "2ad5f6a3-b0ff-41d2-8a0b-49e31e3495b4",
                                                "sense_id": "d296bf15-c856-3e60-94d6-978615f9c9be",
                                                "text": "Le reproche de couperose était peut-être plus fondé. La mal était fréquent, comme le prouvent les annonces de spécialités pharmaceutiques des journaux du temps. L’œil hostile du collégien a pu le déceler sous la poudre de riz."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couperose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df397497-8236-3218-86dd-a8e4bd93813f",
                                        "entry_id": "1325b3ee-e3f8-303a-8038-5c92059c9d18",
                                        "glosses": [
