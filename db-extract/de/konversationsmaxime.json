                ],
                "senses": [
                    {
                        "sense_id": "89e9324d-fc6a-3490-b65c-9df19e1b04c3",
                        "entry_id": "91066383-f561-3145-b365-2ab62f4bc464",
                        "glosses": [
                            "Anleitung, Prinzip für eine erfolgreiche Kommunikation"
                        ],
                        "tags": [
                            "Pragmatik"
                        ],
                        "examples": [
                            {
                                "example_id": "f2bfe0c9-1492-4237-9334-81844c4997a9",
                                "sense_id": "89e9324d-fc6a-3490-b65c-9df19e1b04c3",
                                "text": "Eine der Konversationsmaximen lautet: „Sage nichts, was du für falsch hältst“. (Teil der sogenannten Qualitätsmaxime)"
                            },
                            {
                                "example_id": "b264e4a3-d9fc-4b02-86a8-eb703adb097c",
                                "sense_id": "89e9324d-fc6a-3490-b65c-9df19e1b04c3",
                                "text": "„Grice identifiziert als derartige Richtlinien die folgenden vier grundlegenden Konversationsmaximen, allgemeine Prinzipien, die dem effizienten kooperativen Sprachgebrauch zugrundeliegen, und die zusammen ein allgemeines Kooperationsprinzip ausdrücken.“"
                            },
                            {
                                "example_id": "c0356730-2fa6-4299-a5a7-980b74675c90",
                                "sense_id": "89e9324d-fc6a-3490-b65c-9df19e1b04c3",
                                "text": "„Hier geht es nicht nur um die Beachtung von Konversationsmaximen, sondern in einem Fall (g) auch um die Unterdrückung einer internalisierten Sprachnorm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
