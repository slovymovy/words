                        ],
                        "form": "япо́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9ded9da7-9b2e-3b75-95c9-e7a6fa742b62",
                        "entry_id": "81b701cd-921c-38ca-90bd-4e7c271ab28a",
                        "glosses": [
                            "разг., презр. японец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e392604-e785-4b90-b1e2-ffc293f58b3f",
                                "sense_id": "9ded9da7-9b2e-3b75-95c9-e7a6fa742b62",
                                "text": "Каждый вечер приходил кто-нибудь прощаться, храбрился, ходил петухом, бросал шапку об землю, грозил один разбить всех япошек и кончал страдательной песней со слезами."
                            },
                            {
                                "example_id": "50924594-cff9-4216-afa7-69da894183d3",
                                "sense_id": "9ded9da7-9b2e-3b75-95c9-e7a6fa742b62",
                                "text": "Как было бы полезно своевременное знакомство русского народа с этими свойствами «вождей восточных островов», вместо близорукой похвальбы и пошлого издевательства над «япошками» и «макаками» и лубочных картин, изображавших русского силача, сталкивающего плечиком сидящего на лошади микадо в пропасть!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac2492f7-30a4-4606-a16b-e0f1b18e2a6c",
                        "source_entry_id": "81b701cd-921c-38ca-90bd-4e7c271ab28a",
                        "source_sense_id": "9ded9da7-9b2e-3b75-95c9-e7a6fa742b62",
                        "target_lang_word": "Jap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88474f32-3e2b-3f53-88d2-05e02f1b6458",
                                        "entry_id": "b5fddb5f-2823-3bbf-86ab-d010e9afe75c",
                                        "glosses": [
                                            "The Japanese language."
                                        ],
                                        "tags": [
                                            "ethnic",
                                            "offensive",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45bfbf88-3758-4fc6-bc9f-d184c48db6d6",
                                                "sense_id": "88474f32-3e2b-3f53-88d2-05e02f1b6458",
                                                "text": "He petered out under Pitty's savage look: Do you speak Jap? Do you understand the world from inside those bastards' slanty-eyed little head-lopping poem-writing minds?"
                                            },
                                            {
                                                "example_id": "c87ddbfd-4bcb-472d-9a9a-e0b1c72b0e0e",
                                                "sense_id": "88474f32-3e2b-3f53-88d2-05e02f1b6458",
                                                "text": "He said it in Japanese, which surprised the boy and stunned Cullen.\n“You speak Jap?” asked Cullen.\n“Looks like it, doesn't it?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d284f1-02ca-3fd4-b2b7-0451e515d32e",
                                        "entry_id": "b5fddb5f-2823-3bbf-86ab-d010e9afe75c",
                                        "glosses": [
                                            "Clipping of Japanese."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Hong-Kong",
                                            "Singapore",
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Jap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5104a69e-cf11-3390-90ba-3a1dd71da94e",
                                        "entry_id": "b74f180b-9fab-3dcc-86a1-c6f1df30ad3a",
                                        "glosses": [
                                            "A Japanese person."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d69295f-0577-432b-9b30-572aafb5cf77",
                                                "sense_id": "5104a69e-cf11-3390-90ba-3a1dd71da94e",
                                                "text": "Among our Japs on board are two returning from Italy, where they have been with silk-worms' eggs, on cards, to sell. This has become a great speculation, and the Japs are going into it with zeal. The Japs almost always—always when they can—take cabin passages ; the Chinese seldom, or never."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2392d36-06e9-3d5c-9092-7e992d50d984",
                                        "entry_id": "b74f180b-9fab-3dcc-86a1-c6f1df30ad3a",
                                        "glosses": [
                                            "An Imperial Japanese Army soldier."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b70bd101-bf18-4819-9feb-ca5d3b6c2af4",
                                                "sense_id": "d2392d36-06e9-3d5c-9092-7e992d50d984",
                                                "text": "The Japs had been confident that this first and sudden land grab could be accomplished without their becoming involved in a major war, and they were right."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1a9cc2-d459-312a-a42b-fceae4f5cf43",
                                        "entry_id": "e611b229-b219-3363-a491-8b4decb1defb",
                                        "glosses": [
                                            "Japanese; of or pertaining to Japan or its people."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "not-comparable",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7e1443-cfbf-4790-8db4-7bc811d71f1a",
                                                "sense_id": "4d1a9cc2-d459-312a-a42b-fceae4f5cf43",
                                                "text": "A soldier might grab his rifle and batter his way to the heart of some Jap position. Back home they gave him all sorts of medals but his companions dismissed him as the poor bastard who finally went Asiatic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Jap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0935170-458e-310b-9449-85f9888266fd",
                                        "entry_id": "e432c151-6098-3936-9937-1a28d05a14af",
                                        "glosses": [
                                            "Alternative letter-case form of jap."
                                        ],
