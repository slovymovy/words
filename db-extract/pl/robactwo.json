                "senses": [
                    {
                        "sense_id": "032459d6-2afc-3f2b-824a-08d8cd3fe073",
                        "entry_id": "ac8875e6-e2ad-3714-b530-33c367c32427",
                        "glosses": [
                            "ogół bezkręgowców budzących odrazę, zwłaszcza pasożytów i szkodników"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a68d4d5-c241-48c4-b1c2-8b9ecc165dc7",
                                "sense_id": "032459d6-2afc-3f2b-824a-08d8cd3fe073",
                                "text": "Właściciel zapewniał, że w domu nie ma żadnego robactwa."
                            },
                            {
                                "example_id": "7452b4e6-9c7e-4a90-814d-8be8f309051f",
                                "sense_id": "032459d6-2afc-3f2b-824a-08d8cd3fe073",
                                "text": "Smród, zalane ściany i sufity, robactwo – takie „atrakcje” zapewnia sąsiadom ta pani."
                            },
                            {
                                "example_id": "1b929aae-2ee4-4224-bdf9-fea318f05c52",
                                "sense_id": "032459d6-2afc-3f2b-824a-08d8cd3fe073",
                                "text": "Posmarowałem bydło octem, żeby chronić je przed robactwem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
