            "senses": [
                {
                    "sense_id": "7a3d1a7b-9cbf-3a3f-955f-48da44de8fbb",
                    "sense_definition": "Het verschil dat men maakt of ziet tussen personen of zaken.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is belangrijk om een duidelijk <w>onderscheid</w> te maken tussen feiten en meningen.",
                            "target_lang_translations": {
                                "en": "It is important to make a clear <w>distinction</w> between facts and opinions.",
                                "ru": "Важно проводить четкое <w>различие</w> между фактами и мнениями.",
                                "fr": "Il est important de faire une <w>distinction</w> claire entre les faits et les opinions."
                            }
                        },
                        {
                            "text": "De wet maakt geen <w>onderscheid</w> tussen arm en rijk bij het toepassen van de regels.",
                            "target_lang_translations": {
                                "en": "The law makes no <w>distinction</w> between rich and poor when applying the rules.",
                                "ru": "Закон не делает <w>различий</w> между богатыми и бедными при применении правил.",
                                "fr": "La loi ne fait aucune <w>distinction</w> entre les riches et les pauvres lors de l'application des règles."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschil"
                    ],
                    "common_phrases": [
                        "onderscheid maken",
                        "zonder onderscheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The difference that one makes or perceives between persons or things.",
                        "ru": "Различие, которое делается или усматривается между лицами или предметами.",
                        "fr": "La différence que l'on fait ou que l'on perçoit entre des personnes ou des choses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "distinction",
                                "target_lang_sense_clarification": "difference made or perceived"
                            },
                            {
                                "target_lang_word": "differentiation",
                                "target_lang_sense_clarification": "act of distinguishing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "различие",
                                "target_lang_sense_clarification": "то, что отделяет одно от другого"
                            },
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "несходство двух вещей"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "distinction",
                                "target_lang_sense_clarification": "différence établie ou perçue"
                            },
                            {
                                "target_lang_word": "différenciation",
                                "target_lang_sense_clarification": "action de distinguer"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cbc53e8-d2fa-3e66-a5c6-53db621d9c0a",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>onderscheiden</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>onderscheid</w> de verschillende kleuren moeiteloos in dit licht.",
                            "target_lang_translations": {
                                "en": "I <w>distinguish</w> the different colors effortlessly in this light.",
                                "ru": "Я без труда <w>различаю</w> разные цвета при этом освещении.",
                                "fr": "Je <w>distingue</w> les différentes couleurs sans effort sous cette lumière."
                            }
                        },
                        {
                            "text": "Als bioloog <w>onderscheid</w> ik diverse soorten planten in dit gebied.",
                            "target_lang_translations": {
                                "en": "As a biologist, I <w>distinguish</w> various types of plants in this area.",
                                "ru": "Как биолог, я <w>различаю</w> разные виды растений в этой местности.",
                                "fr": "En tant que biologiste, je <w>distingue</w> diverses espèces de plantes dans cette zone."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'onderscheiden' (to distinguish).",
