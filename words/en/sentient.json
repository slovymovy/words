{
    "word_family": [
        "sentience",
        "insentient"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "47425b18-8684-3705-a086-9b9d0a822fe6",
                    "sense_definition": "Experiencing sensation, thought, or feeling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most animals are <w>sentient</w> beings capable of feeling pain and joy.",
                            "target_lang_translations": {
                                "de": "Die meisten Tiere sind <w>empfindungsfähige</w> Wesen, die Schmerz und Freude empfinden können.",
                                "zh": "大多数动物都是<w>有感知能力的</w>生物，能够感受到痛苦和快乐。"
                            }
                        },
                        {
                            "text": "The debate continues on whether a <w>sentient</w> creature deserves specific legal rights.",
                            "target_lang_translations": {
                                "de": "Die Debatte darüber, ob ein <w>empfindungsfähiges</w> Geschöpf besondere gesetzliche Rechte verdient, dauert an.",
                                "zh": "关于<w>有感知能力的</w>生物是否应享有特定法律权利的争论仍在继续。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sensate",
                        "sentient"
                    ],
                    "antonyms": [
                        "insensate"
                    ],
                    "common_phrases": [
                        "sentient being"
                    ],
                    "target_lang_definitions": {
                        "de": "Fähig, Empfindungen, Gedanken oder Gefühle wahrzunehmen.",
                        "zh": "具有感知、思考或情感体验能力的。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "empfindungsfähig",
                                "target_lang_sense_clarification": "Bezieht sich auf die biologische Fähigkeit, Schmerz oder Freude zu spüren."
                            },
                            {
                                "target_lang_word": "fühlend",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für Lebewesen, die Gefühle besitzen."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有感知能力的",
                                "target_lang_sense_clarification": "指生物能够感受痛苦或快乐等生理和心理状态。"
                            },
                            {
                                "target_lang_word": "有知觉的",
                                "target_lang_sense_clarification": "指具备基本感官和情感反应的生命体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "389989f4-35d7-3a46-b790-2498e70ade8f",
                    "sense_definition": "Possessing human-like awareness and intelligence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "awareness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists wonder if advanced AI will ever become truly <w>sentient</w>.",
                            "target_lang_translations": {
                                "de": "Wissenschaftler fragen sich, ob fortgeschrittene KI jemals wirklich <w>bewusst</w> werden wird.",
                                "zh": "科学家们想知道先进的人工智能是否终有一天会真正变得<w>有意识</w>。"
                            }
                        },
                        {
                            "text": "The science fiction novel explores the rights of a <w>sentient</w> robot.",
                            "target_lang_translations": {
                                "de": "Der Science-Fiction-Roman erforscht die Rechte eines <w>bewussten</w> Roboters.",
                                "zh": "这部科幻小说探讨了<w>有意识的</w>机器人的权利问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sapient",
                        "intelligent",
                        "self-aware"
                    ],
                    "common_phrases": [
                        "sentient machine",
                        "sentient species"
                    ],
                    "target_lang_definitions": {
                        "de": "Über menschenähnliches Bewusstsein und Intelligenz verfügend.",
                        "zh": "拥有类似人类的自我意识和智慧。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bewusst",
                                "target_lang_sense_clarification": "Im Sinne von selbstbewusst oder mit einem Geist ausgestattet."
                            },
                            {
                                "target_lang_word": "intelligent",
                                "target_lang_sense_clarification": "Betont die kognitive Fähigkeit, oft im Kontext von KI oder außerirdischem Leben."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有意识的",
                                "target_lang_sense_clarification": "指具备自我认知和思维能力的个体，常用于人工智能或科幻语境。"
                            },
                            {
                                "target_lang_word": "有灵性的",
                                "target_lang_sense_clarification": "强调具备高级智慧和精神层面的觉知。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cfece8a-0f6a-37a6-87ea-b53e33ca9af8",
                    "sense_definition": "An intelligent, self-aware being.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The galaxy is home to many different types of <w>sentients</w>.",
                            "target_lang_translations": {
                                "de": "Die Galaxie ist die Heimat vieler verschiedener Arten von <w>bewussten Wesen</w>.",
                                "zh": "银河系中居住着许多不同类型的<w>智慧生命</w>。"
                            }
                        },
                        {
                            "text": "The treaty was signed by all <w>sentients</w> in the sector.",
                            "target_lang_translations": {
                                "de": "Der Vertrag wurde von allen <w>bewussten Wesen</w> im Sektor unterzeichnet.",
                                "zh": "该条约由该区域内所有的<w>智慧生命</w>共同签署。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sophont"
                    ],
                    "antonyms": [
                        "automaton"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein intelligentes, selbstbewusstes Wesen.",
                        "zh": "一种具有智慧和自我意识的生命体。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bewusstes Wesen",
                                "target_lang_sense_clarification": "Ein Lebewesen, das sich seiner selbst bewusst ist."
                            },
                            {
                                "target_lang_word": "intelligentes Wesen",
                                "target_lang_sense_clarification": "Ein Wesen mit höherer kognitiver Kapazität."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有意识的生命体",
                                "target_lang_sense_clarification": "指具备自我认知能力的生物或存在。"
                            },
                            {
                                "target_lang_word": "智慧生命",
                                "target_lang_sense_clarification": "指拥有高级认知能力的个体，常用于科幻描述。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}