                            },
                            {
                                "target_lang_word": "公然",
                                "target_lang_sense_clarification": "明目张胆的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5852c16-0dcf-3f1d-8bde-313cc9d61cff",
                    "sense_definition": "Large and heavy in a way that is unattractive; excessively fat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king became <w>gross</w> and immobile in his later years due to overindulgence.",
                            "target_lang_translations": {
                                "ru": "В последние годы король стал <w>тучным</w> и неподвижным из-за излишеств.",
                                "zh": "国王晚年因生活放纵变得<w>臃肿</w>且行动不便。"
                            }
                        },
                        {
                            "text": "He looked <w>gross</w> in the tight suit that no longer fit his large frame.",
                            "target_lang_translations": {
                                "ru": "Он выглядел <w>грузным</w> в тесном костюме, который больше не подходил его крупному телосложению.",
                                "zh": "他穿着那件不再合身的紧身西装，看起来很<w>臃肿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "obese",
                        "bulky",
                        "heavy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный и тяжелый в непривлекательном смысле; чрезмерно полный.",
                        "zh": "指体型肥大且不美观的；过度肥胖的。"
