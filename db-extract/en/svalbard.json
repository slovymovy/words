                                    {
                                        "sense_id": "2c9b641f-0813-3b59-8a13-fe75d5b8d45d",
                                        "entry_id": "2f52118a-cab9-3b12-a725-58cb35fc4c3a",
                                        "glosses": [
                                            "Archipel entre l’océan Arctique et l’océan Atlantique qui dépend du royaume de Norvège."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a968c53-3380-4d4e-9c87-30ffbf154c0c",
                                                "sense_id": "2c9b641f-0813-3b59-8a13-fe75d5b8d45d",
                                                "text": "« Le Svalbard se réchauffe sept fois plus vite que le reste de la planète », indique la glaciologue Heïdi Sevestre, dans Demain, c’est nous (éd. du Faubourg), livre qui retrace l’aventure de François Bernard, dont elle est partie prenante depuis le début."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff40b97-c752-4c6e-a5bf-5980d683a9a1",
                        "source_entry_id": "4596fd2f-0ab6-3ffb-aee2-631f88c94423",
                        "source_sense_id": "46202162-53d2-35e7-a9ed-863ddcb7df3a",
                        "source_sense_description": "islands north east of Greenland",
                        "target_lang_word": "Spitzbergen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spitzbergen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3452083-d035-38e5-b9fc-5d5125c88ddb",
                                        "entry_id": "614f5019-2b9c-33cf-8d88-ad5be5c788aa",
                                        "glosses": [
                                            "norwegische Inselgruppe im Nordpolarmeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daf40b47-e476-4b12-86b1-a4502ebe8278",
                                                "sense_id": "d3452083-d035-38e5-b9fc-5d5125c88ddb",
                                                "text": "Spitzbergen ist ein beliebtes Ziel für Abenteuerreisende."
                                            },
                                            {
                                                "example_id": "c7f7bbd7-51ca-4d77-9f5a-cc72281f6547",
                                                "sense_id": "d3452083-d035-38e5-b9fc-5d5125c88ddb",
                                                "text": "„Gequält von Liebeskummer, bucht die junge Bea kurzentschlossen eine Kreuzfahrt durch die kalte und unwirtliche Inselgruppe von Spitzbergen.“"
                                            },
                                            {
                                                "example_id": "09411c73-eecf-404b-b78d-0152166e46f0",
                                                "sense_id": "d3452083-d035-38e5-b9fc-5d5125c88ddb",
                                                "text": "„Die Flut ist bei Spitzbergen nicht sehr hoch, obgleich sie heftige Strömungen in den großen Baien und Straßen verursacht.“"
                                            },
                                            {
                                                "example_id": "6ba455a5-1b0a-44aa-b882-9abac2f34f2e",
                                                "sense_id": "d3452083-d035-38e5-b9fc-5d5125c88ddb",
                                                "text": "„Mit Spitzbergen wird eine Inselgruppe im Nordatlantik und Arktischen Ozean bezeichnet, die 1596 von dem niederländischen Seefahrer Willem Barents entdeckt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f429732-12e6-39d3-bf78-7e07a4fed9a0",
                                        "entry_id": "614f5019-2b9c-33cf-8d88-ad5be5c788aa",
                                        "glosses": [
                                            "Hauptinsel der gleichnamigen Inselgruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fbead33-a8d2-4cb8-94ba-6a1cbe015ba6",
                                                "sense_id": "0f429732-12e6-39d3-bf78-7e07a4fed9a0",
                                                "text": "Auf Spitzbergen liegt der Ort Longyearbyen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d879218e-0b63-4455-a472-806a70ad0ce2",
