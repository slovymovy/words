                    },
                    {
                        "sense_id": "caa7d9b6-6099-3ba6-9c44-01456e28eebb",
                        "entry_id": "29e77532-5c6d-3ba8-879b-859974804838",
                        "glosses": [
                            "обследовать что-либо с целью определить что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "25409a0a-ef61-312c-b512-c426ce26963f",
                        "entry_id": "29e77532-5c6d-3ba8-879b-859974804838",
                        "glosses": [
                            "определить чьё-либо состояние здоровья, состояние какого-либо органа путём внешнего осмотра, выслушивания и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "03d67b92-7e7f-4e81-a123-a56ee83cadb5",
                        "source_entry_id": "29e77532-5c6d-3ba8-879b-859974804838",
                        "target_lang_word": "inspecter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspecter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                        "entry_id": "727d12cd-9404-3f14-8e2a-b57b53c105b2",
                                        "glosses": [
                                            "Examiner avec attention."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4829f23-3ef7-4e2f-81c3-9f4bf84617bd",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "Puis, cela fait, il acheva de se déshabiller, non sans inspecter les poches de ses autres vêtements, à seule fin de s'assurer qu'on n'y avait rien fourré à son insu."
                                            },
                                            {
                                                "example_id": "65a730c8-9283-47a6-bee9-404fd6f6db41",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "Au jour, j’inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "b15d824a-f24b-4b02-9e3c-8e0644735e62",
                                                "sense_id": "96f5a678-8981-374e-81f9-32fde27685d2",
                                                "text": "C’était la première fois qu’il se risquait au Montparnasse. Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                        "entry_id": "727d12cd-9404-3f14-8e2a-b57b53c105b2",
                                        "glosses": [
                                            "Examiner avec autorité, ou avec une mission spéciale d’une autorité compétente."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2780b61-1673-4b33-91e6-0d0f6dec2e74",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Le Prince les inspecta, comme s’il eût passé une revue, à cheval sur un fringant coursier."
                                            },
                                            {
                                                "example_id": "9ef966f4-188d-4c48-8c2a-db01e456f04f",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Il fut chargé d’inspecter ces magasins."
                                            },
                                            {
                                                "example_id": "59c6d041-c523-48f9-ab50-a81732167d5b",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Ils ne se retirèrent qu’après avoir soigneusement inspecté toute la maison."
                                            },
                                            {
                                                "example_id": "ca75febf-80b9-4b8e-a3ca-571dbee330f9",
                                                "sense_id": "7e598088-f10b-33d5-a751-755c1e4291cc",
                                                "text": "Inspecter des travaux publics, un collège, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d54b9a0c-47cf-4567-b5f3-268f8dd755c7",
                        "source_entry_id": "29e77532-5c6d-3ba8-879b-859974804838",
                        "target_lang_word": "examiner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "examiner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                        "entry_id": "3b15fa5c-bcf0-33a2-88db-9cb94981769e",
                                        "glosses": [
                                            "Observer avec attention, avec réflexion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ccc4dd8-3251-44ce-8dbc-eeb9e1cff7ca",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "Si, avec un télescope d’une profonde puissance, nous examinons soigneusement le firmament, nous découvrirons une ceinture de groupes faite de ce que nous avons jusqu’à présent nommé des nébuleuses, […]."
                                            },
                                            {
                                                "example_id": "8f8d46c6-6633-4866-8d27-d0871b431318",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "J’examine à la dérobée son sein qui se soulève et qui s’abaisse, et sa figure immobile, et le livre vivant qui est uni à elle."
                                            },
                                            {
                                                "example_id": "719cbf74-1fcb-4b5d-8c99-56b8c54ebab1",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "Le secrétaire examinait le faux-col de Bert avec une attention soutenue."
                                            },
                                            {
                                                "example_id": "587e5bcc-4452-4e3f-980b-21a2a2b22066",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "Examinons maintenant le mécanisme (fig.97) qui fait mouvoir les parties travaillantes."
                                            },
                                            {
                                                "example_id": "3ef81d44-ed24-4666-a431-9f1723a8510b",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "Henri, d'une investigation prompte, examinait les tablées. Pas un visage connu."
                                            },
                                            {
                                                "example_id": "b4b26e56-acfa-455e-8c01-a8d1695f9be8",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "D’un coup d’œil scrutateur, le père l’examinait et le gars, craignant d’être fouillé, commençait à n’en pas mener large, une danse soignée ne manquant jamais de punir sans sursis tout vol domestique."
                                            },
                                            {
                                                "example_id": "ef4553e0-2f62-46b3-996f-0a9489c533bd",
                                                "sense_id": "57388bc6-20b2-3a0f-a0e0-6f9c0607d0f7",
                                                "text": "Pendant quelques secondes, ils restèrent debout à m’examiner : Stefania, sorte d'apparition en salopette violette, et Leonie dans un énorme manteau de fourrure, un improbable gin tonic à la main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2929e663-0ee2-3786-8df9-a03fba162ad4",
                                        "entry_id": "3b15fa5c-bcf0-33a2-88db-9cb94981769e",
                                        "glosses": [
                                            "Juger quelqu’un au point de vue de ses connaissances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec12ff3c-bc2d-4a6d-a76e-2fe45a5f48fe",
                                                "sense_id": "2929e663-0ee2-3786-8df9-a03fba162ad4",
                                                "text": "Plusieurs savants se sont occupés du rôle de l’huile dans la germination des graines oléagineuses. Ils ont examiné la question de deux manières différentes : […]."
                                            },
                                            {
                                                "example_id": "d820b694-0f83-4c44-b1d6-c1cdaab5116e",
                                                "sense_id": "2929e663-0ee2-3786-8df9-a03fba162ad4",
                                                "text": "Examiner les candidats au brevet élémentaire. — Il fut longtemps et sérieusement examiné."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "411039ed-d3b4-4bb8-92f1-38bc4c825317",
                        "source_entry_id": "29e77532-5c6d-3ba8-879b-859974804838",
                        "target_lang_word": "visiter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "visiter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Aller voir en détail une ville, un monument, un musée, par dévotion ou par curiosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70dbb91b-59d3-4b90-9da7-840e1c9ed960",
                                                "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                                                "text": "Elle avait tenu, par coquetterie d’intendante, à lui faire visiter toute l’installation vinicole, depuis le hangar où se réparaient les fûts jusqu’aux caves où les crus de réserve hérissaient leurs milliers de bouteilles."
                                            },
                                            {
                                                "example_id": "ef74e131-c2f3-40b0-85cc-d80a1711f6a4",
                                                "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                                                "text": "Tous récitèrent debout les grâces et Durtal prit rendez-vous avec l’abbé Plomb pour visiter la Cathédrale […]."
                                            },
                                            {
                                                "example_id": "19908781-bebc-4816-b0e1-bb088080e817",
                                                "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                                                "text": "Pour changer d’atmosphère, le bateau libère des poignées de croisiéristes dès son arrivée, pressés par le temps pour visiter La Rochelle."
                                            },
                                            {
                                                "example_id": "87a43737-9494-486f-9aee-9b28f0ece6fd",
                                                "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                                                "text": "J'aimerais vous faire visiter moi-même, mais vous serez entre de bonnes mains avec Ramsay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "S’assurer que les choses sont dans l’ordre où elles doivent être ; inspecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84208cc-e7f2-40f5-bd37-7544e575f99b",
                                                "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                                                "text": "En un instant tous cinq furent prêts. Chacun visita ses armes et les mit en état."
                                            },
                                            {
                                                "example_id": "84463eed-7c5c-4d47-afc0-343c9db67460",
                                                "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                                                "text": "Ensuite, il visita avec soin les armes de ses guerriers, et, satisfait du résultat de son inspection, il donna le signal du départ."
                                            },
                                            {
                                                "example_id": "506d10a1-e3d7-4e65-b9f3-4e86646752c8",
                                                "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                                                "text": "Sur la longue table du milieu, parmi l’ancien entassement des livres et des brochures, il n’y avait de nouveau que la note claire des petits linges d’enfant, qu’elle était en train de visiter."
                                            },
                                            {
                                                "example_id": "27c7cd8c-b798-4523-904d-666a60970a0e",
                                                "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                                                "text": "Le même soir, quelques officiers de la commune enfoncèrent sa porte, visitèrent ses papiers, ses effets, harpèrent ce qui pouvait leur convenir et apposèrent les scellés sur les portes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d939c21-3702-38f4-a0be-ff6896d2d811",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Aller voir quelqu’un chez lui sans séjourner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07172bc2-a534-40fe-a3fa-005b8d3a8d57",
                                                "sense_id": "2d939c21-3702-38f4-a0be-ff6896d2d811",
                                                "text": "Je sortis pendant la soirée. Je visitai deux ou trois amis, puis je revins à la maison…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24dbb66c-3a3a-3f3a-ae98-862ee0182459",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Observer ou inspecter un lieu pour se donner un avis."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d1356d0-cb99-4845-bdea-6be292ea7a94",
                                                "sense_id": "24dbb66c-3a3a-3f3a-ae98-862ee0182459",
                                                "text": "Finalement, hormis mon éternel couple d’indécis, venu visiter un appartement, tout en sachant qu’il ne l’achèterait pas, je suis assez satisfait de ma rencontre avec cette Latine, qui me fait littéralement fondre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09abc064-edd8-3467-86b7-67377c70dcc8",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Aller voir par civilité, par déférence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca3ee7f8-de29-42d9-9f8f-32d4c3ede689",
                                                "sense_id": "09abc064-edd8-3467-86b7-67377c70dcc8",
                                                "text": "Visiter ses chefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f518558d-ca09-3560-b403-5066cf47e922",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Aller voir par charité ou par dévotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecfaa0e0-57cc-4465-8ec0-4a5fa522c07d",
                                                "sense_id": "f518558d-ca09-3560-b403-5066cf47e922",
                                                "text": "Voilà qui va réconforter les mourants, car la délégation au grand complet visite maintenant les deux salles où sont entassés les cholériques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                                        "entry_id": "3953cbd7-7321-3c92-82ae-1e055984fdcf",
                                        "glosses": [
                                            "Cambrioler, voler, détrousser."
                                        ],
                                        "tags": [
                                            "euphemism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cebd8fd4-2e3a-4697-b888-2697ebc39022",
                                                "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                                                "text": "[…] c’est que ces messieurs de la cambriole veulent savoir si votre appartement est libre et s’ils peuvent venir le visiter sans danger."
                                            },
                                            {
                                                "example_id": "b791d99c-97f4-4927-86a6-257638f8ed28",
                                                "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                                                "text": "À environ une lieue d’ici, dix voleurs se sont précipités sur notre diligence en poussant des cris de démons ; […] les voleurs, après nous avoir fait descendre de voiture, car nous étions sans armes pour nous défendre, nous ont scrupuleusement visités et dévalisés ensuite avec un calme infini, et qui prouvait combien ils craignaient peu d’être dérangés dans l’exercice de leur industrie."
                                            },
                                            {
                                                "example_id": "12edc708-5e00-48d3-9592-5cf6b158c4b7",
                                                "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                                                "text": "Les locaux de l’association « Live in Color » qui œuvre à l’intégration et l’éducation des jeunes réfugiés ainsi que leur famille, ont été cambriolés dans la nuit de mercredi à jeudi. […] Durant la nuit, leurs locaux, installés sur le quai des Ardennes à Liège, ont été visités par un ou plusieurs cambrioleurs."
                                            },
                                            {
                                                "example_id": "dc68c796-d4c8-42c1-9dce-4d8cf858df61",
                                                "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                                                "text": "Les deux suspects ont été arrêtés alors qu’ils venaient de visiter un pavillon situé dans la rue Émile Charpentier. La police avait été prévenue par un voisin aux alentours de 2 h. Ce dernier aurait vu toute la scène, voyant les deux voleurs « en train de pénétrer dans le pavillon », rapporte une source policière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
