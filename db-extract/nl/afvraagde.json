        "nl-extract.jsonl": [
            {
                "entry_id": "a3f1dfd5-0afe-3762-86bd-b18b1891a28d",
                "word": "afvraagde",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9627e2b-afc1-3f75-8523-260fa564415e",
                        "entry_id": "a3f1dfd5-0afe-3762-86bd-b18b1891a28d",
                        "glosses": [
                            "enkelvoud verleden tijd van afvragen"
                        ],
                        "tags": [
                            "obsolete",
                            "with-subordinate-clause"
                        ],
                        "examples": [
                            {
                                "example_id": "e5b7f903-016c-4eab-94ef-a9a121d01c98",
                                "sense_id": "f9627e2b-afc1-3f75-8523-260fa564415e",
                                "text": "Na dese mijne gedagten ontmoete ik een seer Ouden en Vermaarde Vroet-Vrouw, die ik aan sprak en afvraagde, of sij wel in gedagten hadde genomen, waarom soo veel Menschen scheel sagen (...)"
                            },
                            {
                                "example_id": "795a0ee6-1296-42a1-ae94-8a5bcb42ca8d",
                                "sense_id": "f9627e2b-afc1-3f75-8523-260fa564415e",
                                "text": "Zelfs kwam de generaal-majoor Bulaw, die de ruiterij onder den generaal Churchill gebood, terug, terwijl men over dat voornemen raadpleegde en het gevoelen der generaals van 't leger hunner Hoog Mogenheden afvraagde."
                            },
                            {
                                "example_id": "df6018ab-a806-443f-90b3-9a275a0faf67",
                                "sense_id": "f9627e2b-afc1-3f75-8523-260fa564415e",
                                "text": "Ook toen, verleden jaar, een verre kozijn van ons, die te Brussel woont, ons hare hand afvraagde, gaven wij gereedelijk onze toestemming;"
                            },
                            {
                                "example_id": "41fd1be0-d89b-4d3f-94e0-c2a04a73c205",
                                "sense_id": "f9627e2b-afc1-3f75-8523-260fa564415e",
                                "text": "Hetgeen in sommige opzichten zoveel geleek op mijne omstandigheden: (...), dat ik mij afvraagde of hier eenig misverstand en persoonsverwarring in 't spel is!"
                            }
                        ]
                    }
                ],
