                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95e4902e-7183-4452-94c1-46e027a311a0",
                                "sense_id": "bbf04f6a-e2a2-3a73-ad08-8b52959d34a3",
                                "text": "Beim Bananensplit werden drei Eiskugeln auf eine längsgeteilte Banane gesetzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "47fa4f11-5ecc-3d5d-b96c-6023d061f1bd",
                        "entry_id": "c3c1150f-c349-3f61-93e1-b744badbc5c5",
                        "glosses": [
                            "Kugel aus Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b14928e-7841-4b4f-8388-fa5df0617164",
                                "sense_id": "47fa4f11-5ecc-3d5d-b96c-6023d061f1bd",
                                "text": "„Der Wechsel von Ausstrahlung und Gegenstrahlung hält die globalen Durchschnittstemperaturen bei etwa 15 °C. Ohne ihn wäre die Erde mit einer Durchschnittstemperatur von –18 °C eine Eiskugel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34c72c53-930d-417c-b2c7-85ead012323c",
                        "source_entry_id": "c3c1150f-c349-3f61-93e1-b744badbc5c5",
                        "source_sense_id": "bbf04f6a-e2a2-3a73-ad08-8b52959d34a3",
                        "source_sense_description": "kugelförmige Portion Speiseeis",
                        "target_lang_word": "scoop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "Any cup-shaped or bowl-shaped tool, usually with a handle, used to lift and move loose or soft solid material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36da75c5-ebb3-4fc5-8804-f0e6b2fea3de",
                                                "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                                "text": "She kept a scoop in the dog food."
                                            },
                                            {
                                                "example_id": "5240b7c8-2f9e-459b-a9bf-e6639996b2eb",
                                                "sense_id": "0f0040f3-a069-3ffe-97e2-bdd26bfd7a99",
                                                "text": "an ice-cream scoop"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The amount or volume of loose or solid material held by a particular scoop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377e5d4c-fd05-4619-942d-cbab2bed3caf",
                                                "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                                "text": "Use one scoop of coffee for each pot."
                                            },
                                            {
                                                "example_id": "181bcc33-497c-4e15-ab35-075e81d9ab62",
                                                "sense_id": "62a66aae-87fc-3a2d-a9c5-27848aa9dc58",
                                                "text": "I'll have one scoop of chocolate ice-cream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e1f0e1-9331-3ec3-a723-77acb66692ff",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The act of scooping, or taking with a scoop or ladle; a motion with a scoop, as in dipping or shovelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393ce3a0-9982-4201-a86f-a52cb85d755a",
                                                "sense_id": "b8e1f0e1-9331-3ec3-a723-77acb66692ff",
                                                "text": "with a quick scoop, she fished the frog out of the pond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A story or fact; especially, news learned and reported before anyone else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f4d73f-da75-4962-a663-f8fd7833ae5c",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "He listened carefully, in hopes of getting the scoop on the debate."
                                            },
                                            {
                                                "example_id": "cc220867-ce68-485a-a258-efb0b088e4e5",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "\"We may get a scoop, if we are lucky. You'll be there in any case, so you'll just give us a pretty full report.\""
                                            },
                                            {
                                                "example_id": "bb55e640-8097-453a-b279-888fa79cee15",
                                                "sense_id": "6188fd77-9517-3462-bcb4-de0a179ac270",
                                                "text": "The problem is that the public, disobediently giggling over their social media accounts, reckon they’ve already got the scoop without needing to see the film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a80a0cbc-4c41-3e46-812a-77e6d96a7cb0",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "An opening in a hood/bonnet or other body panel to admit air, usually for cooling the engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3389b83-b84d-3eb1-b73c-789bef1773c9",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The digging attachment on a front-end loader."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17e42998-8466-3a3b-aee4-44dd08bf1d41",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A place hollowed out; a basinlike cavity; a hollow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507c20a3-49e1-4238-a692-1521b2a9e08e",
                                                "sense_id": "17e42998-8466-3a3b-aee4-44dd08bf1d41",
                                                "text": "Some had lain in the scoop of the rock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b6a441f-5659-3fd5-92c4-94aff6c25418",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A spoon-shaped surgical instrument, used in extracting certain substances or foreign bodies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9af3a4ba-7622-35c7-babb-1a61456f0390",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A special spinal board used by emergency medical service staff that divides laterally to scoop up patients."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "febe7018-3f4d-3c55-b9d0-0f9bf6eb20ea",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A sweep; a stroke; a swoop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a535c5da-4f8a-31f3-9bfd-6359b04ea3d9",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The peak of a cap."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abb80537-bf68-3195-8b8f-5c4b185fe829",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A hole on the playfield that catches a ball, but eventually returns it to play in one way or another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78bdaacf-f05c-3b0e-af97-28be47067413",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "The raised end of a surfboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e96bd38-719d-458f-97d4-b7b91921e412",
                                                "sense_id": "78bdaacf-f05c-3b0e-af97-28be47067413",
                                                "text": "This brings the scoop into play as additional wetted surface and slows the board due to its fore-and-aft curvature"
                                            },
                                            {
                                                "example_id": "6c53556e-c469-4ac8-a85a-971f34d42020",
                                                "sense_id": "78bdaacf-f05c-3b0e-af97-28be47067413",
                                                "text": "[T]he scoop or upward curvature in the front or nose section of a board is designed to keep the board from diving under the surface of the water when the surfer is catching a wave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3bee60f-8426-3cdd-8dbd-299bd8ee0daf",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A kind of floodlight with a reflector."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23fbea80-5cc2-31d4-8f5b-b74e55fa2fb8",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A haul of money made through speculation."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88834492-c9f5-3c28-a619-b3de5c024e01",
                                        "entry_id": "13c07711-edc3-374e-ad0b-9ca7254e6e92",
                                        "glosses": [
                                            "A note that begins slightly below and slides up to the target pitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb7ff4b-74f8-4b4e-9cab-729b0958bd82",
                                                "sense_id": "88834492-c9f5-3c28-a619-b3de5c024e01",
                                                "text": "Jazz symbols include many contoured articulations and inflections, such as doits, fall-offs, and scoops."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scoop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ebac434a-3828-3b70-84f3-a7f3b9ee466c",
                                        "entry_id": "3f04adac-c3af-3cb7-b18c-3d9aee5f110f",
                                        "glosses": [
                                            "To lift, move, or collect with a scoop or as though with a scoop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8012b20e-cbf3-4f15-87e3-75854683a9c6",
                                                "sense_id": "ebac434a-3828-3b70-84f3-a7f3b9ee466c",
                                                "text": "He used both hands to scoop water and splash it on his face."
                                            },
                                            {
                                                "example_id": "c6012d6c-81bb-447d-bac6-18b90ace4a0f",
                                                "sense_id": "ebac434a-3828-3b70-84f3-a7f3b9ee466c",
                                                "text": "Their first clear opportunity duly came courtesy of a mistake from Russell Martin, who was hustled off the ball by Bale, but the midfielder scooped his finish well over the top as he bore down on the Norwich goal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981cda2d-c7a0-3f86-9198-94f1318aca14",
                                        "entry_id": "3f04adac-c3af-3cb7-b18c-3d9aee5f110f",
                                        "glosses": [
                                            "To make hollow; to dig out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa6c4288-ed6c-4950-a795-5e1b10622c80",
                                                "sense_id": "981cda2d-c7a0-3f86-9198-94f1318aca14",
                                                "text": "I tried scooping a hole in the sand with my fingers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53e981fd-5528-310a-95fa-1de3697a4898",
                                        "entry_id": "3f04adac-c3af-3cb7-b18c-3d9aee5f110f",
                                        "glosses": [
                                            "To report on something, especially something worthy of a news article, before (someone else)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "075c4abe-aea4-42e8-880e-c8428759b952",
                                                "sense_id": "53e981fd-5528-310a-95fa-1de3697a4898",
                                                "text": "The paper across town scooped them on the City Hall scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6bf0a5-6e5a-3e3d-9337-2ced2db54ba4",
                                        "entry_id": "3f04adac-c3af-3cb7-b18c-3d9aee5f110f",
                                        "glosses": [
                                            "To begin a vocal note slightly below the target pitch and then to slide up to the target pitch, especially in country music."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93459aa6-b4ff-38c5-a810-ea9c6953cd98",
                                        "entry_id": "3f04adac-c3af-3cb7-b18c-3d9aee5f110f",
                                        "glosses": [
                                            "To pick (someone) up"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "189ab6fa-ee54-4832-98a9-44d64342e6d0",
                                                "sense_id": "93459aa6-b4ff-38c5-a810-ea9c6953cd98",
                                                "text": "You have a car. Can you come and scoop me?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
