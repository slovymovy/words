                                                "sense_id": "da1fc026-ea41-3efb-a4d9-0e7dd24df639",
                                                "text": "„Shairp machte auf dem Absatz kehrt und stapfte zu der Drehbasse auf dem Achterdeck zurück.“"
                                            },
                                            {
                                                "example_id": "40b49485-517d-46e9-b28e-b92739143899",
                                                "sense_id": "da1fc026-ea41-3efb-a4d9-0e7dd24df639",
                                                "text": "„Auf dem Quarterdeck und der Back wurden die Drehbassen bemannt.“"
                                            },
                                            {
                                                "example_id": "68f64c4f-d65b-4ce5-9a44-9ec3d72906ee",
                                                "sense_id": "da1fc026-ea41-3efb-a4d9-0e7dd24df639",
                                                "text": "„Die SARACEN hatte hinten auf dem erhöhten Oberdeck eine Drehbasse aus Messing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
