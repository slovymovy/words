                "senses": [
                    {
                        "sense_id": "a89e1c17-53cc-3f06-8a21-2aa4bc4e0b37",
                        "entry_id": "7f3df261-c91e-3120-853a-ec3c15854310",
                        "glosses": [
                            "Bewegung beim Tanzen, Folge mehrerer Tanzschritte"
                        ],
                        "tags": [
                            "Tanzen",
                            "Ballett"
                        ],
                        "examples": [
                            {
                                "example_id": "663a117f-843c-4a66-9848-b11ce4c5493a",
                                "sense_id": "a89e1c17-53cc-3f06-8a21-2aa4bc4e0b37",
                                "text": "„Das sagten die Mütter, die ihren »adolescentes« zusahen, wenn sie die eben erst einstudierten Pas ausführten, das sagten die adolescentes und adolescents selbst, die bis zum Umfallen tanzten, und das sagten auch die erwachsenen jungen Mädchen und jungen Leute, die so taten, als bedürfe es für sie einiger Herablassung, um diese Bälle zu besuchen, und die sich dabei doch herrlich amüsierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
