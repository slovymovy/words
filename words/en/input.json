{
    "word_family": [
        "inputter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4558061a-e005-3b75-ba5b-3ba52c75a5c6",
                    "sense_definition": "Information or data that is entered into a computer or system for processing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "data_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer processes the <w>input</w> very quickly to produce results.",
                            "target_lang_translations": {
                                "ru": "Компьютер очень быстро обрабатывает <w>входные данные</w> для получения результатов.",
                                "zh": "计算机处理<w>输入</w>的速度非常快，能迅速得出结果。"
                            }
                        },
                        {
                            "text": "Please check the user <w>input</w> for any spelling errors.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте пользовательский <w>ввод</w> на наличие орфографических ошибок.",
                                "zh": "请检查用户<w>输入</w>的内容是否有拼写错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "data",
                        "info",
                        "details"
                    ],
                    "antonyms": [
                        "output"
                    ],
                    "common_phrases": [
                        "data input",
                        "user input",
                        "input device"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или данные, вводимые в компьютер или систему для обработки.",
                        "zh": "输入到计算机或系统中进行处理的信息或数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ввод",
                                "target_lang_sense_clarification": "процесс или действие"
                            },
                            {
                                "target_lang_word": "входные данные",
                                "target_lang_sense_clarification": "сама информация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "输入",
                                "target_lang_sense_clarification": "指代输入的数据或信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d3c3f7-2876-3cb9-b02d-3fdfc506aa11",
                    "sense_definition": "Ideas, advice, or opinions given to help make a decision or complete a task.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "contribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would appreciate your <w>input</w> on this new project.",
                            "target_lang_translations": {
                                "ru": "Я был бы признателен за твое <w>мнение</w> по этому новому проекту.",
                                "zh": "如果能得到你对这个新项目的<w>意见</w>，我将不胜感激。"
                            }
                        },
                        {
                            "text": "The committee made a decision after receiving <w>input</w> from all members.",
                            "target_lang_translations": {
                                "ru": "Комитет принял решение после получения <w>информации</w> от всех участников.",
                                "zh": "委员会在听取了所有成员的<w>建议</w>后做出了决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feedback",
                        "advice",
                        "contribution",
                        "opinion"
                    ],
                    "common_phrases": [
                        "provide input",
                        "ask for input",
                        "value your input"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идеи, советы или мнения, предоставляемые для помощи в принятии решения или выполнении задачи.",
                        "zh": "为帮助决策或完成任务而提供的想法、建议或意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вклад",
                                "target_lang_sense_clarification": "участие в общем деле"
                            },
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "совет или точка зрения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见",
                                "target_lang_sense_clarification": "指提供的建议或看法"
                            },
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "指为了帮助而提出的想法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0a30d6b-a98f-3958-b44a-0f148da63e54",
                    "sense_definition": "A connection point on a device where signals or power can be received.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electronics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plug the microphone cable into the audio <w>input</w> on the back.",
                            "target_lang_translations": {
                                "ru": "Вставьте кабель микрофона в аудио<w>вход</w> на задней панели.",
                                "zh": "把麦克风线插到背面的音频<w>输入端</w>。"
                            }
                        },
                        {
                            "text": "My television has three HDMI <w>inputs</w> for different devices.",
                            "target_lang_translations": {
                                "ru": "У моего телевизора есть три HDMI-<w>входа</w> для различных устройств.",
                                "zh": "我的电视机有三个用于连接不同设备的HDMI<w>接口</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jack",
                        "socket",
                        "terminal"
                    ],
                    "antonyms": [
                        "output"
                    ],
                    "common_phrases": [
                        "audio input",
                        "video input",
                        "input jack"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "electronics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Точка подключения на устройстве, принимающая сигналы или питание.",
                        "zh": "设备上用于接收信号或电源的连接点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "разъём для приема сигнала"
                            },
                            {
                                "target_lang_word": "разъём",
                                "target_lang_sense_clarification": "техническое устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "输入端",
                                "target_lang_sense_clarification": "指接收信号的接口"
                            },
                            {
                                "target_lang_word": "接口",
                                "target_lang_sense_clarification": "指连接设备的插口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0637eb9-8138-3634-9c13-74d6fa2c5d9c",
                    "sense_definition": "Something put into a system or process to achieve a result, such as energy or resources.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agricultural <w>input</w> has increased significantly this year.",
                            "target_lang_translations": {
                                "ru": "Объем сельскохозяйственных <w>вложений</w> в этом году значительно вырос.",
                                "zh": "今年的农业<w>投入</w>显著增加。"
                            }
                        },
                        {
                            "text": "With a large <w>input</w> of time and money, the business finally succeeded.",
                            "target_lang_translations": {
                                "ru": "Благодаря большому <w>вкладу</w> времени и денег бизнес наконец преуспел.",
                                "zh": "在<w>投入</w>了大量的时间和金钱后，这项业务终于成功了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "investment",
                        "resource"
                    ],
                    "antonyms": [
                        "output"
                    ],
                    "common_phrases": [
                        "energy input",
                        "labor input"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ресурсы, вкладываемые в систему или процесс для достижения результата (например, энергия или деньги).",
                        "zh": "投入到系统或过程中以实现结果的资源，如能量或资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложения",
                                "target_lang_sense_clarification": "инвестиции ресурсов"
                            },
                            {
                                "target_lang_word": "затраты",
                                "target_lang_sense_clarification": "расход ресурсов"
                            },
                            {
                                "target_lang_word": "вклад",
                                "target_lang_sense_clarification": "участие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投入",
                                "target_lang_sense_clarification": "指投入的资源或资金"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bd18299-570d-3eb7-98c4-38cb67782eea",
                    "sense_definition": "To enter data or information into a computer or electronic device.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "data_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>input</w> your password to access the account.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>ввести</w> пароль для доступа к учетной записи.",
                                "zh": "你需要<w>输入</w>密码才能访问该账户。"
                            }
                        },
                        {
                            "text": "The clerk <w>inputted</w> the sales figures into the spreadsheet manually.",
                            "target_lang_translations": {
                                "ru": "Клерк вручную <w>ввел</w> данные о продажах в таблицу.",
                                "zh": "职员手动将销售数据<w>输入</w>到电子表格中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enter",
                        "type in",
                        "key in"
                    ],
                    "common_phrases": [
                        "input data",
                        "input information",
                        "manually input"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить данные или информацию в компьютер или электронное устройство.",
                        "zh": "将数据或信息输入计算机或电子设备。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "ввести",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "输入",
                                "target_lang_sense_clarification": "指录入数据的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cb9376c-f190-327c-951b-d56ebd0935c6",
                    "sense_definition": "To contribute information or ideas to a discussion or process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contribution_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several experts will <w>input</w> to the final report before it is published.",
                            "target_lang_translations": {
                                "ru": "Несколько экспертов <w>внесут вклад</w> в итоговый отчет перед его публикацией.",
                                "zh": "在最终报告发布前，几位专家将<w>提供意见</w>。"
                            }
                        },
                        {
                            "text": "They were invited to <w>input</w> their suggestions during the planning phase.",
                            "target_lang_translations": {
                                "ru": "Их пригласили <w>внести</w> свои предложения на этапе планирования.",
                                "zh": "他们受邀在规划阶段<w>提供意见</w>和建议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "contribute"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить информацию или идеи в обсуждение или процесс.",
                        "zh": "为讨论或过程提供信息或想法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вносить вклад",
                                "target_lang_sense_clarification": "участвовать"
                            },
                            {
                                "target_lang_word": "дополнять",
                                "target_lang_sense_clarification": "добавлять информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提供意见",
                                "target_lang_sense_clarification": "指参与讨论并给出建议"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}