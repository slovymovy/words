                                "target_senses": [
                                    {
                                        "sense_id": "423a8deb-270a-311c-8ca6-d6d2f5b9b58d",
                                        "entry_id": "31344a27-4e4b-36c0-8031-e533a742abd6",
                                        "glosses": [
                                            "Grosse protéine végétale (plus de 50.000 daltons) que l'on trouve en particulier dans les légumineuses et dans les amandes. Nommé parfois improprement caséine végétale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9996195-ee2a-4f69-92f6-a9d5ed2e98ad",
                                                "sense_id": "423a8deb-270a-311c-8ca6-d6d2f5b9b58d",
                                                "text": "On prépare les solutions de légumine la veille, à froid, mais on les chauffe, avant lʼessai, pendant 1 heure au bain-marie en ébullition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
