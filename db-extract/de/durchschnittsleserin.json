                "senses": [
                    {
                        "sense_id": "ac5ca80b-f8dc-3bf5-9707-77a5f3087038",
                        "entry_id": "727fb1ea-2b2c-3bce-a473-ec03ffb6bf33",
                        "glosses": [
                            "Leserin mit durchschnittlichen („normalen“) (Lese-)Fähigkeiten und Interessen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d97aa7e4-465b-43f4-a737-90c18faee1ea",
                                "sense_id": "ac5ca80b-f8dc-3bf5-9707-77a5f3087038",
                                "text": "„Die Zeitschrift Brigitte hat einst ihre Kosmetik-Kompetenz dadurch aufgebaut, dass sie Durchschnittsleserinnen in sehr attraktive Frauen verwandelte.“"
                            },
                            {
                                "example_id": "9b415f19-82e8-4b34-a590-0526f2b0faac",
                                "sense_id": "ac5ca80b-f8dc-3bf5-9707-77a5f3087038",
                                "text": "„Ich nehme einfach ihr Rohmaterial, mit dem sie ja sowieso nichts Gescheites anfängt, und mache daraus zeitgemäße, heitere Romane auf einem Niveau, das die Durchschnittsleserin versteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
