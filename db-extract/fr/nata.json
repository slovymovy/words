                        "entry_id": "a2f3fefa-7deb-360e-ac15-335d54f88956",
                        "glosses": [
                            "Missionnaire protestant kanak, issus de l’église méthodiste britannique, pouvant être pasteur ou catéchiste."
                        ],
                        "tags": [
                            "Nouvelle-Calédonie"
                        ],
                        "examples": [
                            {
                                "example_id": "0c83bb6d-ad67-4ad4-aae4-3a835066e280",
                                "sense_id": "0f8e3f55-9da8-32f2-9e00-ff9233eef8a0",
                                "text": "Un nata lui expédie une boîte de médailles pieuses envoyée de Hienghène à deux petits chefs qu’on excitait en même temps contre les protestants de Voh."
                            },
                            {
                                "example_id": "a806c00e-4888-4e6d-ab77-bf6f7ea6a5a7",
                                "sense_id": "0f8e3f55-9da8-32f2-9e00-ff9233eef8a0",
                                "text": "Je fais observer au nata quelques plantations nouvelles d’un bon travail […]."
                            }
                        ]
                    }
