                        "examples": [
                            {
                                "example_id": "ad0adc15-4f8b-4f7b-89f7-7d75f93cf8a4",
                                "sense_id": "1dc4a438-a415-3005-baa1-9b2cbae95a52",
                                "text": "Our minds are, as it were, chequered with truth and falsehood."
                            },
                            {
                                "example_id": "449369e4-31cf-48d1-9b88-e4fe375617c4",
                                "sense_id": "1dc4a438-a415-3005-baa1-9b2cbae95a52",
                                "text": "A gleam of sun shining through the unsashed window, and chequering the dark workshop with a broad patch of light, fell full upon him, as though attracted by his sunny heart."
                            }
                        ]
                    }
