                "senses": [
                    {
                        "sense_id": "7592bb4a-7177-33f6-b156-a68053d58424",
                        "entry_id": "10d41975-35ac-3a07-9918-63f7ca6d2d97",
                        "glosses": [
                            "Donner un caractère girondin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86188850-1abc-49c9-a7ff-a3a3f6095785",
                                "sense_id": "7592bb4a-7177-33f6-b156-a68053d58424",
                                "text": "Sans, principal du collège de Fleurance, est dénoncé au conseil pour avoir cherché à « girondiser » la société populaire de cette ville (22 brumaire an II)."
                            },
                            {
                                "example_id": "21b1500e-b391-46d4-9601-e5eb82f26d54",
                                "sense_id": "7592bb4a-7177-33f6-b156-a68053d58424",
                                "text": "J'ai trouvé ce département fanatisé, royalisé, girondisé, l'esprit public tué, un petit noyau de patriotes molestés, n'osant qu'à peine s'avouer montagnards."
                            },
                            {
                                "example_id": "93650cf0-bd8a-4b57-82b4-a9a7be44f5ab",
                                "sense_id": "7592bb4a-7177-33f6-b156-a68053d58424",
                                "text": "Continue de publier que toute la nation, excepté une douzaine de tes bons amis, est feuillantisée, brissotisée, girondisée ;"
                            }
                        ]
                    }
                ],
