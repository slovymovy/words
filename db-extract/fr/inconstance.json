                "senses": [
                    {
                        "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                        "glosses": [
                            "Facilité à changer d’opinion, de résolution, de passion, de conduite, de sentiment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd613a2f-9d35-44cb-9e33-d5d8d74e22f7",
                                "sense_id": "3205956c-cafe-331f-8421-269f44d75f7f",
                                "text": "Les voilà qui m'entourent ; les voilà qui me contemplent ; les voilà qui me disent en leurs provocations : « Jeune dieu d'Amour, enseigne aux nymphes bocagères la mollesse et le désir, l’inconstance et la passion , le sourire et le sérieux. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                        "entry_id": "af4aa8fc-0c11-3c7b-ae17-1e7f2e654fbc",
                        "glosses": [
                            "Faculté, capacité à changer, en parlant des choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5b7961-12be-422f-92dc-af08e9e07fe4",
                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                "text": "L’inconstance du temps, des saisons."
                            },
                            {
                                "example_id": "44ca7ce4-bed4-4b60-a856-40a10de8cde2",
                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                "text": "L’inconstance des vents, de la mer."
                            },
                            {
                                "example_id": "516bc9a3-2e33-4182-9e00-01cd0dffee4a",
                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                "text": "L’inconstance de la fortune."
                            },
                            {
                                "example_id": "698b92af-883c-444b-bd48-474917ad074d",
                                "sense_id": "c4a1e970-ec7b-3fbd-bf55-8922eafb2551",
                                "text": "L’inconstance des choses humaines."
                            }
                        ]
                    }
