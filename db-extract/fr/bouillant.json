                        "form": "bouillantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d0fdb41-fa3d-3e93-9be7-4f899c89495d",
                        "entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "glosses": [
                            "Qui bout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd81c65-956a-4ab0-8ed4-47c105cdcd04",
                                "sense_id": "2d0fdb41-fa3d-3e93-9be7-4f899c89495d",
                                "text": "Or, le bruit se répandit bientôt que le juif avait jeté l’hostie dans une cuve d’eau bouillante, à la suite de quoi l’eau aurait rougi sans s’altérer."
                            },
                            {
                                "example_id": "9fd61f90-689e-4b72-846f-a378347a4f10",
                                "sense_id": "2d0fdb41-fa3d-3e93-9be7-4f899c89495d",
                                "text": "Je plongeai les crabes dans la casserole d’eau bouillante."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccd4d68a-aca7-3135-8407-51f9ef9873bc",
                        "entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "glosses": [
                            "Qui est extrêmement chaud."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "3d7adc16-86d6-41b9-96fa-f56cf29f251c",
                                "sense_id": "ccd4d68a-aca7-3135-8407-51f9ef9873bc",
                                "text": "Et l’estomac lesté, tonifiés par quelques verres de thé bouillant, nous nous sentons prêts pour une nouvelle étape, quelle qu'elle soit."
                            }
                        ]
                    },
                    {
                        "sense_id": "e656c290-eeea-3894-885c-8c0feeb82cb0",
                        "entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "glosses": [
                            "Qui est prompt, vif, ardent, en parlant d’une personne."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b60acc2f-8184-4533-ae36-dfccae102d68",
                                "sense_id": "e656c290-eeea-3894-885c-8c0feeb82cb0",
                                "text": "Il est bouillant d’impatience."
                            },
                            {
                                "example_id": "d99e1170-d8dd-45b5-b941-dc78b9082abd",
                                "sense_id": "e656c290-eeea-3894-885c-8c0feeb82cb0",
                                "text": "C’est un homme qui a le sang bouillant."
                            }
                        ]
                    },
                    {
                        "sense_id": "1edbfb16-c7a2-376d-841c-f892f38814fd",
                        "entry_id": "66e45812-ec0b-3470-aeca-cd2be9b93b3c",
                        "glosses": [
                            "Compliqué ; controversé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "deefa727-bcdb-4268-9fa5-9c93117d8911",
                                "sense_id": "1edbfb16-c7a2-376d-841c-f892f38814fd",
                                "text": "Ce n’est pas le seul sujet international bouillant dans lequel est empêtré le chef de l’Etat, à deux mois de l’élection présidentielle."
                            }
                        ]
                    }
                ],
