                "senses": [
                    {
                        "sense_id": "8413974f-f0fe-3f54-a6df-1c8314ca37b7",
                        "entry_id": "5757970e-91ea-37fc-b474-76d45cd33598",
                        "glosses": [
                            "roter Riesenstern und Hauptstern im Sternbild des Skorpions"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4dccd96-7177-4d9b-b5a6-4ffd9bb9fcb7",
                                "sense_id": "8413974f-f0fe-3f54-a6df-1c8314ca37b7",
                                "text": "„Antares bildet mit einem unauffälligen Begleiter ein Doppelsternsystem.“"
                            },
                            {
                                "example_id": "09650fca-8e26-442a-911c-458c7eb1966e",
                                "sense_id": "8413974f-f0fe-3f54-a6df-1c8314ca37b7",
                                "text": "Wegen seiner roten Farbe und der Nähe zur Ekliptik kann Antares leicht mit dem roten Planeten Mars (Ares) verwechselt werden."
                            },
                            {
                                "example_id": "03dfa670-34a2-47e8-8840-44801d49f08a",
                                "sense_id": "8413974f-f0fe-3f54-a6df-1c8314ca37b7",
                                "text": "„Am Zenit leuchtete Antares im Skorpion und nahe dabei Beta im Zentauren, der als erdnächster Fixstern gilt.“"
                            },
                            {
                                "example_id": "629707a7-2847-410b-838f-16fea3e385d4",
                                "sense_id": "8413974f-f0fe-3f54-a6df-1c8314ca37b7",
                                "text": "„Da leuchtet Antares - in diesem Augenblick zwinkert er über den Dächern der Tremont Street, und von deinem Fenster auf dem Beacon Hill aus könntest du ihn sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
