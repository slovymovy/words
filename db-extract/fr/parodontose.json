                        "entry_id": "20d300f1-f84d-3c24-886a-ab79125079c1",
                        "glosses": [
                            "Maladie chronique du parodonte, les tissus entourant la dent. La parodontite est l'inflammation de ces tissus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "317bc0b3-0332-43af-b549-2a391fa1d2a6",
                                "sense_id": "fa8d6a36-6cf1-3ff7-b460-1c224ad20cd5",
                                "text": "Cette dernière apparaît avant une parodontose et correspond à une inflammation des gencives sans atteinte osseuse et dentaire contrairement à la parodontose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "814b43ac-3828-4a24-b5cf-36f6137a3001",
                        "source_entry_id": "20d300f1-f84d-3c24-886a-ab79125079c1",
                        "source_sense_id": "fa8d6a36-6cf1-3ff7-b460-1c224ad20cd5",
