                "senses": [
                    {
                        "sense_id": "233db6c1-c8f5-3bd6-b1ee-286caf6aed61",
                        "entry_id": "6c4543df-de1d-352c-8a30-bc693fe941d8",
                        "glosses": [
                            "freiwilliger Austritt aus einer kirchlichen Religionsgemeinschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25f9204-8adf-4427-b190-07ac7fd2f909",
                                "sense_id": "233db6c1-c8f5-3bd6-b1ee-286caf6aed61",
                                "text": "Die steigende Zahl an Kirchenaustritten bereitet den Kirchenoberen Sorgen."
                            },
                            {
                                "example_id": "23a4016d-e1e0-4631-8a8b-7055c31e848b",
                                "sense_id": "233db6c1-c8f5-3bd6-b1ee-286caf6aed61",
                                "text": "„Anfang der 80er Jahre wurde dann bei Androhung des Arbeitsplatzverlustes massiv Druck auf die katholischen Genossen ausgeübt, um sie zum Kirchenaustritt zu bewegen.“"
                            },
                            {
                                "example_id": "5ad2c0f0-5b28-436d-8da3-0947f9c1b8ce",
                                "sense_id": "233db6c1-c8f5-3bd6-b1ee-286caf6aed61",
                                "text": "„Je nach Bundesland muß ein Kirchenaustritt entweder vor dem zuständigen Amtsgericht oder Standesamt erklärt und zu Protokoll genommen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
