                                        "sense_id": "10bb4469-d94f-3bbf-b9ad-044e2998f95d",
                                        "entry_id": "648d6b70-43ed-37fc-b434-f1a4a9b01e22",
                                        "glosses": [
                                            "feucht, oft in Verbindung mit dem Empfinden von Kälte"
