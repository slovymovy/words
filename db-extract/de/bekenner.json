                ],
                "senses": [
                    {
                        "sense_id": "c467c0ad-6ecd-32bd-8cca-9623f7a5bf7e",
                        "entry_id": "e2477dd9-e579-3669-9ae6-c3493cc2aa70",
                        "glosses": [
                            "Person, dies sich zu einer Tat oder Haltung bekennt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "1ec93448-1124-4903-95e0-16881a320cd0",
                                "sense_id": "c467c0ad-6ecd-32bd-8cca-9623f7a5bf7e",
                                "text": "„Ich bin ein entschiedener Bekenner der menschlichen Freiheit.“"
                            },
                            {
                                "example_id": "21c1a343-2a8e-4ace-8b76-a05e89a154db",
                                "sense_id": "c467c0ad-6ecd-32bd-8cca-9623f7a5bf7e",
                                "text": "„Der Drohung des anonymen Bekenners zu den Bombenanschlägen, im Namen einer \"Dagestanischen Befreiungsarmee\" künftig Tod mit Tod zu vergelten, hat Russland gegenwärtig nichts entgegenzustellen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "86808fb3-a1c7-3c2c-a4e1-710287ff51d9",
                        "entry_id": "e2477dd9-e579-3669-9ae6-c3493cc2aa70",
                        "glosses": [
                            "Person, die sich insbesondere in Zeiten der Verfolgung zu ihrem Glauben bekennt und dafür Verfolgung, Vertreibung, Folter, Verstümmelung und Haft in Kauf nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f2abf4-ab31-411f-bf61-14976fb99af6",
                                "sense_id": "86808fb3-a1c7-3c2c-a4e1-710287ff51d9",
                                "text": "„Diese Gestalten, die einen großen Reichtum für die Kirche bilden, sind Märtyrer, Bekenner des Glaubens, Mönche und Nonnen, Söhne und Töchter, die durch die Fruchtbarkeit des Wortes Gottes wiedergeboren wurden.“"
                            },
                            {
                                "example_id": "042359e5-29fc-4209-9598-1e2f3620205f",
                                "sense_id": "86808fb3-a1c7-3c2c-a4e1-710287ff51d9",
                                "text": "„Im ersten Jahrtausend der Kirche wurde die Verehrung der Märtyrer und dann der Bekenner von den verschiedenen Teilkirchen geregelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cef5c5f-cb8b-4ca2-a94a-2f4dd0d50041",
                        "source_entry_id": "e2477dd9-e579-3669-9ae6-c3493cc2aa70",
                        "source_sense_id": "c467c0ad-6ecd-32bd-8cca-9623f7a5bf7e",
                        "source_sense_description": "allgemein: Person, dies sich zu einer Tat oder Haltung bekennt",
                        "target_lang_word": "confessor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confessor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "One who confesses faith in Christianity in the face of persecution, but who is not martyred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04760061-451e-48c8-9dd1-2ff1058a999d",
                                                "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                                "text": "Long before Edward I, the English had a King Edward who they considered a martyr and a King Edward who they considered a confessor."
                                            },
                                            {
                                                "example_id": "fbb3db82-4e2e-4906-aa74-4b99423f92f7",
                                                "sense_id": "142b1c47-4089-384c-9f71-884390f9012b",
                                                "text": "Confessors provided the troubled Church with an alternative sort of authority based on their sufferings, particularly when arguments began about how and how much to forgive those Christians who had given way to imperial orders – the so-called ‘lapsed’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b7f1f44-5480-34cb-99c9-687a08de60a8",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "One who confesses to having done something wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a420d761-edc3-4206-b3eb-439df9f710d4",
                                                "sense_id": "0b7f1f44-5480-34cb-99c9-687a08de60a8",
                                                "text": "Near-synonym: confessant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51b932fd-043c-3f9c-b665-1cd5d9a00475",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "A priest who hears confession and then gives absolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f50f0c30-67e5-3f18-a2aa-4f99260be7e2",
                                        "entry_id": "94c21feb-f20e-305c-8359-4b51cca00d12",
                                        "glosses": [
                                            "Someone who acts as listener and helper."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a214c5c-6ec0-4bb0-98aa-353cd4546785",
                                                "sense_id": "f50f0c30-67e5-3f18-a2aa-4f99260be7e2",
                                                "text": "They do not feel connected to any gay/lesbian communities. Nor do they feel able to establish relationships with anyone who can support them. Thus an inexperienced but sincere young heterosexual actor can find himself playing not only role model but also confessor and phantom friend to people in great need."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
