                                "target_senses": [
                                    {
                                        "sense_id": "2056a98f-ed6e-33be-a0ff-c39220009cd4",
                                        "entry_id": "95d360a2-94aa-3b29-8624-51abb5124536",
                                        "glosses": [
                                            "eine gelbe Zitrusfrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05469736-b144-4ae0-85fd-e4d266f55005",
                                                "sense_id": "2056a98f-ed6e-33be-a0ff-c39220009cd4",
                                                "text": "Die Zitrone enthält Ascorbinsäure."
                                            },
                                            {
                                                "example_id": "e379795e-9bd6-4d11-a064-113d614026c5",
                                                "sense_id": "2056a98f-ed6e-33be-a0ff-c39220009cd4",
                                                "text": "„Grenfeld verzog sein Gesicht, als hätte er in eine Zitrone gebissen.“"
                                            },
                                            {
                                                "example_id": "68c5cf23-258a-4b7c-b15d-8c6615b22cd4",
                                                "sense_id": "2056a98f-ed6e-33be-a0ff-c39220009cd4",
                                                "text": "„Ich goß die Milch in den kalten Tee, preßte die Zitrone hinein und sah zu, wie die Milch dick wurde und in gelblichgrauen Flocken nach unten sank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a2100c6-12ef-3334-af43-569cd908acb7",
                                        "entry_id": "95d360a2-94aa-3b29-8624-51abb5124536",
                                        "glosses": [
                                            "ein halbtropischer immergrüner Baum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc09fad9-149c-470b-9e67-e969ac1275d7",
                                                "sense_id": "8a2100c6-12ef-3334-af43-569cd908acb7",
                                                "text": "Man nennt Sizilien auch: „Das Land, wo die Zitronen blühen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
