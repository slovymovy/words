                                        "entry_id": "c13ff98e-cc9c-3444-9fc2-d9f72e4536da",
                                        "glosses": [
                                            "een voortuig ingericht om een stoffelijk overschot te vervoeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddb6629-8a66-470a-99d1-ea3006d480b2",
                                                "sense_id": "120f0348-c513-3d8b-9a7a-902e0cb9cf43",
                                                "text": "De lijkwagen vervoerde het gekiste lijk naar de begraafplaats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75dd54c0-0331-4ac3-bd3d-08952ccd7461",
                        "source_entry_id": "3532d384-42c8-391d-b31e-71c42fdc276f",
                        "source_sense_id": "6cb5568e-6381-3719-ba25-338a83961e13",
                        "target_lang_word": "rouwkoets",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouwkoets",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "841c54ce-7a7e-3cc8-9457-d6141d8056c3",
                                        "entry_id": "1f8ef8e2-a360-3ddd-ba4a-5cd465ba7cf9",
                                        "glosses": [
                                            "koets waarin de stoffelijke overschotten van een overledene worden vervoerd naar een begraafplaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee0605fd-cc63-4631-b1e8-199dc05e7139",
                                                "sense_id": "841c54ce-7a7e-3cc8-9457-d6141d8056c3",
                                                "text": "Hooper zal in een witte rouwkoets met vier paarden over de Scheveningse Boulevard worden gereden. De tocht begint bij het Kurhaus om 13.15 uur. Onderweg zal twee keer worden stilgestaan bij favoriete horecagelegenheden van Hooper, café Big Bell en beachclub 't Peukie."
                                            },
                                            {
                                                "example_id": "26ca1494-13a4-4f19-8e3c-047953770876",
                                                "sense_id": "841c54ce-7a7e-3cc8-9457-d6141d8056c3",
                                                "text": "PARIJS (afp, belga, reuters) -- Een DNA-onderzoek in Parijs en in Münster op twee stukjes uit het binnenste van het hart van Lodewijk XVII moet de echte identiteit van het kind achterhalen dat in 1795 op tienjarige leeftijd overleed in een Parijse gevangenis. Vorige week werd het orgaan plechtig weggehaald uit de koninklijke crypte, in tegenwoordigheid van een handvol aristocraten, onder wie een afstammeling van Lodewijk XIV, Charles-Emmanuel van Bourbon Parma, en overgebracht naar een Parijse kliniek. Uiteraard in een zwarte rouwkoets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e3f0e4-d7b2-3ae4-8d06-325b23f6a838",
                                        "entry_id": "1f8ef8e2-a360-3ddd-ba4a-5cd465ba7cf9",
                                        "glosses": [
                                            "koets in een lijkstoet"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50b71589-c7fc-4928-9e58-4f7f17e8c4c4",
                        "source_entry_id": "3532d384-42c8-391d-b31e-71c42fdc276f",
                        "source_sense_id": "6cb5568e-6381-3719-ba25-338a83961e13",
                        "target_lang_word": "Leichenwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Leichenwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                        "entry_id": "df035d04-cfd1-3a0f-94d5-ac69f951efbb",
                                        "glosses": [
                                            "Fahrzeug, das dazu dient, Tote zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e017257a-0e12-4482-af8f-f4d4338c2021",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Und die Pferde, die den Leichenwagen ziehen, welcher plötzlich vor ihm ist, haben goldene Zügel und schwarzweiße Federbüsche.“"
                                            },
                                            {
                                                "example_id": "b5b02105-bb7c-4561-b9f6-a753445fcf79",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "Leichenwagen sind meist schwarz und länglich."
                                            },
                                            {
                                                "example_id": "0860ab94-36c7-474b-986c-0658ee5fccd0",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Jedes Mal säumen Hundertausende die Straßen, über die der Konvoi der Leichenwagen fährt.“"
                                            },
                                            {
                                                "example_id": "d97a33fd-3d91-4e28-88ec-077b5c7d0d87",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Sie leiht sich einen anderen, verliert den Anschluss an den Leichenwagen, verfährt sich in der Stadt und kommt erst nach dem Ende der Zeremonie an.“"
                                            },
                                            {
                                                "example_id": "639c887c-4986-4ca7-84e5-509fb526924a",
                                                "sense_id": "921fe8c2-4cb0-3656-89a5-1c6408708152",
                                                "text": "„Alle Leichenwagen sind im Einsatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a22f7a90-314a-4c69-b3c9-cdd08134598c",
                        "source_entry_id": "3532d384-42c8-391d-b31e-71c42fdc276f",
                        "source_sense_id": "6cb5568e-6381-3719-ba25-338a83961e13",
                        "target_lang_word": "катафалк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "катафалк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4d385642-09d1-34f5-8104-e55e3b964d75",
                                        "entry_id": "d02643b5-262b-3031-a49e-25890b1866c0",
                                        "glosses": [
                                            "возвышение с траурными украшениями, на которое ставится гроб в помещении (при гражданской панихиде или в церкви при отпевании)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14ae7ae8-18c4-48a1-b65b-ea42540a3bad",
                                                "sense_id": "4d385642-09d1-34f5-8104-e55e3b964d75",
                                                "text": "Гроб стоял на богатом катафалке под бархатным балдахином."
                                            },
                                            {
                                                "example_id": "eba30909-20e9-4b7d-a77a-2251d2ac6a0e",
                                                "sense_id": "4d385642-09d1-34f5-8104-e55e3b964d75",
                                                "text": "Он подошел к гробу, сел на ступеньки пышного катафалка, у самых ног покойницы, опустил голову на руку и призадумался."
                                            },
                                            {
                                                "example_id": "088429f7-d208-4af6-bcf2-02f7cc97b46e",
                                                "sense_id": "4d385642-09d1-34f5-8104-e55e3b964d75",
                                                "text": "Ещё мрачнее выглядела одна небольшая комната. В ней вместо кроватей стояли чёрные матовые столы и черные скамьи, походившие на половинки тех катафалков, которые приносятся гробовщиками в дом, где лежит покойник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a27634-32b1-3d72-99dc-4265aedd1640",
                                        "entry_id": "d02643b5-262b-3031-a49e-25890b1866c0",
                                        "glosses": [
                                            "транспортное средство, предназначенное для перевозки умерших"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76341be-2f48-41ae-8fce-94c600619f98",
                                                "sense_id": "37a27634-32b1-3d72-99dc-4265aedd1640",
                                                "text": "Один за другим несли и везли на катафалках девятнадцать гробов, украшенных цветами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5a9fd01-77e5-313a-9388-0becde73af1b",
                                        "entry_id": "d02643b5-262b-3031-a49e-25890b1866c0",
                                        "glosses": [
                                            "перен. неуклюжий, громоздкий автомобиль; автомобиль в плохом техническом состоянии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b328426-0760-4d97-8a1e-57e4487dd06c",
                                                "sense_id": "a5a9fd01-77e5-313a-9388-0becde73af1b",
                                                "text": "Убери свой катафалк от подъезда!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c6a171c-1968-40ef-ae5a-cd40aff79fa8",
                        "source_entry_id": "3532d384-42c8-391d-b31e-71c42fdc276f",
