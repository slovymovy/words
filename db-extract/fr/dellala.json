                        "sense_id": "45b9b362-e100-30c4-9309-c6426dafbaaf",
                        "entry_id": "e8c56955-5472-30ca-964c-3135d6007115",
                        "glosses": [
                            "Courtière ; entremetteuse."
                        ],
