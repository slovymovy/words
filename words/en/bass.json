                },
                {
                    "sense_id": "98ed3fd7-8c1e-3b91-80a1-2b20d9d13399",
                    "sense_definition": "The lower range of sound tones or frequencies.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "music_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love this song because the heavy <w>bass</w> makes the floor shake.",
                            "target_lang_translations": {
                                "ru": "Мне нравится эта песня, потому что от тяжелого <w>баса</w> дрожит пол.",
                                "zh": "我喜欢这首歌，因为沉重的<w>低音</w>震得地板都在晃。"
                            }
                        },
                        {
                            "text": "You should adjust the <w>bass</w> on the speakers to get a better sound.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит настроить <w>басы</w> на колонках, чтобы звук был лучше.",
                                "zh": "你应该调节一下音箱的<w>低音</w>，这样音质会更好。"
                            }
                        }
                    ],
                    "antonyms": [
                        "treble"
                    ],
                    "common_phrases": [
                        "turn up the bass",
                        "heavy bass",
                        "bass and treble",
                        "drum and bass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижний диапазон звуковых тонов или частот.",
                        "zh": "声音或频率的低音部分。"
                    },
