                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed several families with the name <w>Confer</w> living in the valley.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике было указано несколько семей с фамилией <w>Конфер</w>, живущих в долине."
                            }
                        },
                        {
                            "text": "Professor <w>Confer</w> published a groundbreaking study on historical linguistics last year.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Конфер</w> опубликовал в прошлом году новаторское исследование по исторической лингвистике."
                            }
                        }
                    ],
                    "traits": [
