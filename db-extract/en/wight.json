                                "target_senses": [
                                    {
                                        "sense_id": "1401eb29-83a6-32c5-910b-decda67ba082",
                                        "entry_id": "96723d36-c818-3f9a-b339-357491cce333",
                                        "glosses": [
                                            "живой объект: чаще всего — неопределённого вида (например, в фантастике); также — животное (с прилагательным — часто применительно к человеку), растение, гриб или одноклеточный организм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e8fe83-a9a8-41d7-8dfa-6650a15b8c1e",
                                                "sense_id": "1401eb29-83a6-32c5-910b-decda67ba082",
                                                "text": "Делиться мыслию своей с любимым существом."
                                            },
                                            {
                                                "example_id": "42eca2ab-328e-440c-ab9c-cb47ee57c003",
                                                "sense_id": "1401eb29-83a6-32c5-910b-decda67ba082",
                                                "text": "Ждет меня потеря любимого существа."
                                            },
                                            {
                                                "example_id": "057a9a6d-4795-457e-884f-07cf15e5544f",
                                                "sense_id": "1401eb29-83a6-32c5-910b-decda67ba082",
                                                "text": "Очень она нервическое существо."
                                            },
                                            {
                                                "example_id": "97eff6e3-30e1-423a-a1c0-5db437d61b05",
                                                "sense_id": "1401eb29-83a6-32c5-910b-decda67ba082",
                                                "text": "Это было длиннолицее, длиннозубое существо."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
