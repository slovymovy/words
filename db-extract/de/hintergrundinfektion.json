                "senses": [
                    {
                        "sense_id": "5c8ad2d1-0574-36f7-9db1-002e4453bc10",
                        "entry_id": "35739a49-6382-36fd-a842-331def632433",
                        "glosses": [
                            "Ansteckung mit einem Krankheitserreger, die ohne Test nicht bekannt wird, weil sie ohne Symptome verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "890460ba-33a0-4973-ad45-60377e927cf7",
                                "sense_id": "5c8ad2d1-0574-36f7-9db1-002e4453bc10",
                                "text": "„Meningitis bei einem Kind kann durch bakterielle, virale und Pilzinfektionen verursacht werden. Manifestiert in Form einer Primärinfektion, als unabhängige Krankheit oder als Folge infektiöser Hintergrundinfektionen.“"
                            },
                            {
                                "example_id": "453a01f5-df3c-4723-8e92-dfea6900354c",
                                "sense_id": "5c8ad2d1-0574-36f7-9db1-002e4453bc10",
                                "text": "„Ein bei Freilandversuchen durch natürlich vorkommende, pilzliche Pathogene verursachtes Auftreten von Hintergrundinfektionen zeigte sich sowohl zu 10dpi, als auch zu 24dpi in der Kontrollvariante.“"
                            },
                            {
                                "example_id": "8e04b8f5-0e73-44f3-b64c-a606a9852b3b",
                                "sense_id": "5c8ad2d1-0574-36f7-9db1-002e4453bc10",
                                "text": "„Als Faktoren, die eine stimulierende Wirkung auf die Entwicklung des septischen Schocks ausüben, sind die Pathogenität des Erregers, die Lokalisation des primären Entzündungsfokus, die Dauer der Sepsis, die Merkmale des klinischen Verlaufs der Hintergrundinfektion, der Erreger, Alter und Funktion des Immunapparates des Patienten sowie zusätzliche traumatische Effekte zu nennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
