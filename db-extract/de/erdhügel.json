                "senses": [
                    {
                        "sense_id": "6f346c79-96ad-3956-a0ae-6dea0e6362af",
                        "entry_id": "28d0f138-80b5-3a77-8e47-4e0ab10c29fa",
                        "glosses": [
                            "kleine bis mittelgroße Erhebung, bestehend aus Erdreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cfb694d-d539-4915-85f0-ca093ae31196",
                                "sense_id": "6f346c79-96ad-3956-a0ae-6dea0e6362af",
                                "text": "„Wir setzten uns eine Weile auf einen Erdhügel, dann gingen wir weiter über das Feld, und Staszek sagte, daß Frau Zdulko heut eine Hühnersuppe kochen würde und Zbigniew selbstverständlich mitessen müsse.“"
                            },
                            {
                                "example_id": "9d69d761-07e5-47e2-bbc5-b7985bf97487",
                                "sense_id": "6f346c79-96ad-3956-a0ae-6dea0e6362af",
                                "text": "„Der Mann stieg ab, gab dem Pferd einen Fußtritt, legte sich auf einen kleinen Erdhügel und sah in die Luft hinauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
