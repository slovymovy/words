                    },
                    {
                        "translation_id": "24b0617c-ecc1-4cbe-b49a-bbff87385c68",
                        "source_entry_id": "fbcbc38d-47d8-38c1-bb59-f644bf240d3a",
                        "source_sense_id": "f9f82393-d371-3db5-97c7-3ae93c7a6133",
                        "target_lang_word": "semi-liquid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semi-liquid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2e43fbe-20dc-3515-8e11-63b677535083",
                                        "entry_id": "18f21750-5c5b-3f55-b0b2-a17fdce9a76f",
                                        "glosses": [
                                            "Alternative form of semiliquid.",
                                            "Viscous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8348ce58-c0d5-4e5c-a3c2-16718f6ea772",
                                                "sense_id": "d2e43fbe-20dc-3515-8e11-63b677535083",
                                                "text": "Labor-economic considerations have often necessitated transition from solid/ liquid-manure management to semi-liquid-manure management."
                                            },
                                            {
                                                "example_id": "82526e58-9c9c-4505-90b7-bd2f69bc9e8d",
                                                "sense_id": "d2e43fbe-20dc-3515-8e11-63b677535083",
                                                "text": "More and more foods are being developed that would be classed by the consumer as being semi-solid or semi-liquid."
                                            },
                                            {
                                                "example_id": "2a36ca5b-9811-492f-8609-705ed0b9b3e5",
                                                "sense_id": "d2e43fbe-20dc-3515-8e11-63b677535083",
                                                "text": "These characteristic surfaces were in fact incidental to the solution of the basic problem, which was essentially: how to pour semi-liquid concrete into formwork as a continuous operation without sacrificing the compactness and consistency essential to structural stability."
                                            },
                                            {
                                                "example_id": "d621b490-6717-4593-80a8-cfc839d27e3b",
                                                "sense_id": "d2e43fbe-20dc-3515-8e11-63b677535083",
                                                "text": "The deeper layers of Antirumgon's interior are semi-liquid slush, due to the presence of methanol. It is thought that bacterium^([sic – meaning bacteria]) in the deep core create this natural anti-freeze. Some species of Terminus pirate drill through the ice crust to recover this natural alcohol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a4fd6d-6818-3404-a4d7-e351d4188063",
                                        "entry_id": "18f21750-5c5b-3f55-b0b2-a17fdce9a76f",
                                        "glosses": [
                                            "Alternative form of semiliquid.",
                                            "Able to flow but not completely freely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6961611e-04a2-4d34-9883-d401cedada13",
                                                "sense_id": "a7a4fd6d-6818-3404-a4d7-e351d4188063",
                                                "text": "According to Keynes, the classical approach to the transactions demand for money was incomplete because it ignored the possibility of the people choosing to hold money as an asset instead of holding other liquid or semi-liquid assets, particularly bonds, when their prices are expected to fall."
                                            },
                                            {
                                                "example_id": "9ef31f13-3b3d-46bd-82fe-43dd59e8e92d",
                                                "sense_id": "a7a4fd6d-6818-3404-a4d7-e351d4188063",
                                                "text": "We classify other types of loans as semi-liquid assets, including consumer loans, loans to the government, and interbank loans."
                                            },
                                            {
                                                "example_id": "fbab435e-c973-4817-9ccd-2b114723871f",
                                                "sense_id": "a7a4fd6d-6818-3404-a4d7-e351d4188063",
                                                "text": "A semi-liquid layout uses two special attributes, namely, min-width and max-width. We will now amend the style sheet so that our four HTML pages have a semi-liquid layout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "semi-liquid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44047b5b-dd23-3a21-97b9-3330f264d018",
                                        "entry_id": "4fcd3bac-c2d2-348e-ad7f-0d9b5ce816cd",
                                        "glosses": [
                                            "Alternative form of semiliquid."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c8d39a6-ee1f-4f10-9a91-d0302e8b2caa",
                                                "sense_id": "44047b5b-dd23-3a21-97b9-3330f264d018",
                                                "text": "The Lotus Roll has been specifically designed to eliminate this Semi-liquid zone because it is the inventor's contention that the presence of this semi-liquid is harmful to both extraction and capacity."
                                            },
                                            {
                                                "example_id": "0adbe02a-9b0c-41bd-bbff-2326c0cb74e6",
                                                "sense_id": "44047b5b-dd23-3a21-97b9-3330f264d018",
                                                "text": "However, before they are crosslinked they are thermoplastics, semi-liquids, or liquids and they do flow for a short time when heated the first time to achieve crosslinking between the polymer chains."
                                            },
                                            {
                                                "example_id": "862731fc-1c7f-4219-b8fa-48b7380a2b63",
                                                "sense_id": "44047b5b-dd23-3a21-97b9-3330f264d018",
                                                "text": "Through a rubber stopper, the semi-liquid was injected into the flask and the AAO template was immersed in the semi-liquid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
