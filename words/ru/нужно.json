                                "cs": "Musím si naléhavě <w>zavolat</w> domů.",
                                "tr": "Eve acilen telefon etmem <w>gerek</w>.",
                                "es": "Me <w>hace falta</w> llamar a casa urgentemente.",
                                "zh": "我急着<w>需要</w>给家里打个电话。"
                            }
                        },
                        {
                            "text": "Тебе <w>нужно</w> больше отдыхать и гулять.",
                            "target_lang_translations": {
                                "en": "You <w>need</w> to rest and walk more.",
                                "nl": "Jij <w>moet</w> meer rusten en wandelen.",
                                "pl": "Musisz więcej odpoczywać i spacerować (dosł. <w>trzeba</w> ci więcej odpoczywać).",
                                "de": "Du <w>musst</w> dich mehr ausruhen und mehr spazieren gehen.",
                                "fr": "Il <w>faut</w> que tu te reposes et que tu te promènes davantage.",
                                "it": "Ti <w>bisogna</w> riposare e camminare di più.",
                                "cs": "Potřebuješ více <w>odpočívat</w> a chodit na procházky.",
                                "tr": "Daha fazla dinlenmen ve yürümen <w>lazım</w>.",
                                "es": "Te <w>hace falta</w> descansar y pasear más.",
                                "zh": "你<w>得</w>多休息、多散步。"
                            }
                        }
