                        "form": "сы́рницах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a04b0bd2-6173-37d1-ae16-493df673f34f",
                        "entry_id": "ec1d9ae0-da58-35ba-8b8e-4d3170556f13",
                        "glosses": [
                            "посуда, коробка для хранения сыра"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d3d0a4-51f9-43a7-95ce-5986d12da95c",
                                "sense_id": "a04b0bd2-6173-37d1-ae16-493df673f34f",
                                "text": "На столе столе стояло кушанье: тарелки с картофельным пюре, хлеб, соления, солонка, маслёнка и даже сырница."
                            },
                            {
                                "example_id": "df99cc4d-0717-4b28-a2ac-beeba7d7cde1",
                                "sense_id": "a04b0bd2-6173-37d1-ae16-493df673f34f",
                                "text": "Дно чуть расширенной и углублённой горловины ключа выложено было камнями да кафельной плиткою, в уютной прохладной ямине с ледяной водою, в природном холодильнике, хранили продукты, бабушка Ванда ставила туда глечики с маслом, молоко, керамическую сырницу."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5be2368-b99d-3b7d-aca0-6bd28d8fc18a",
                        "entry_id": "ec1d9ae0-da58-35ba-8b8e-4d3170556f13",
                        "glosses": [
                            "блюдо из яиц, творога и молока"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d7372a-c005-4699-b54d-dbd1305cc15a",
                                "sense_id": "b5be2368-b99d-3b7d-aca0-6bd28d8fc18a",
                                "text": "Готовят сырницу так: яичную массу (молоко, яйца) смешивают с сахаром, творогом, солью, выливают в смазанную маслом форму и запекают."
                            }
                        ]
                    }
                ],
