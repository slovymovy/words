                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fad99c9-39df-4863-a2cb-7dbde1abcf4e",
                                "sense_id": "a33853e7-483f-3a97-86f6-1a9714259c36",
                                "text": "Beide Weinhäuser in der Altstadt waren brechend voll."
                            },
                            {
                                "example_id": "d772ab51-77d1-42b8-bbd5-56d4300527a2",
                                "sense_id": "a33853e7-483f-3a97-86f6-1a9714259c36",
                                "text": "„In Ediger sind wir dann am Abend, als wir von unserem Gang in die Weinberge zurück waren, in einem sehr schönen Weinhaus zu Abend essen gegangen.“"
