                    {
                        "translation_id": "39fa3bbe-923b-4231-bd06-2dc0b3f38cdb",
                        "source_entry_id": "b1869545-8770-302c-a0dd-1644d20f5bc3",
                        "source_sense_id": "6eee944c-8e15-3596-a9d6-1a3c4970b0f2",
