    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ea580b2-f414-3402-b988-4f384275cb29",
                    "sense_definition": "The formal rules governing the structure and sequence of statements in a computer programming language.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program failed to run because of a simple <w>syntax</w> error in the code.",
                            "target_lang_translations": {
                                "ru": "Программа не запустилась из-за простой <w>синтаксической</w> ошибки в коде."
                            }
                        },
                        {
                            "text": "Each programming language has its own unique <w>syntax</w> that developers must follow.",
                            "target_lang_translations": {
                                "ru": "Каждый язык программирования имеет свой уникальный <w>синтаксис</w>, которому должны следовать разработчики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "syntax error",
                        "command syntax",
                        "code syntax"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальные правила, определяющие структуру и последовательность операторов в языке программирования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синтаксис",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2edf39b-ed5e-3bfe-87ff-23a54036b3b3",
                    "sense_definition": "The set of rules that govern how words are combined to form phrases and sentences in a language.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>syntax</w> of English usually follows a subject-verb-object pattern.",
                            "target_lang_translations": {
                                "ru": "<w>Синтаксис</w> английского языка обычно следует схеме «подлежащее-сказуемое-дополнение»."
                            }
                        },
                        {
                            "text": "Poets often manipulate sentence <w>syntax</w> to create a specific rhythm or emphasis.",
                            "target_lang_translations": {
                                "ru": "Поэты часто меняют <w>синтаксис</w> предложения, чтобы создать определенный ритм или акцент."
                            }
                        }
                    ],
                    "synonyms": [
                        "syntaxis"
                    ],
                    "common_phrases": [
                        "sentence syntax",
                        "english syntax",
                        "rules of syntax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор правил, регулирующих способы сочетания слов для образования фраз и предложений в языке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синтаксис",
                                "target_lang_sense_clarification": "структура предложения"
                            },
                            {
                                "target_lang_word": "построение предложений",
                                "target_lang_sense_clarification": "способ сочетания слов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d4e3b84-35bd-374d-b93f-820fd6f5d644",
                    "sense_definition": "The branch of linguistics that deals with the study of the structure of phrases and sentences.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In our linguistics class, we spent the entire semester studying <w>syntax</w> and morphology.",
                            "target_lang_translations": {
                                "ru": "На занятиях по лингвистике мы весь семестр изучали <w>синтаксис</w> и морфологию."
                            }
                        },
                        {
                            "text": "Professor Jespersen is a world-renowned expert in the field of comparative <w>syntax</w>.",
                            "target_lang_translations": {
                                "ru": "Профессор Есперсен — всемирно известный эксперт в области сравнительного <w>синтаксиса</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "study of syntax",
                        "comparative syntax",
                        "generative syntax"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел лингвистики, изучающий структуру словосочетаний и предложений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "синтаксис",
                                "target_lang_sense_clarification": "раздел лингвистики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
