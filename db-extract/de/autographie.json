                    {
                        "sense_id": "bc679f98-043f-3823-9a3f-7a799b5289a2",
                        "entry_id": "77eb6a79-4a42-3636-be86-f3ead709365b",
                        "glosses": [
                            "lithographisches Verfahren zur günstigen Vervielfältigung von Drucken und Bildern, das auf Umdruck beruht"
                        ],
                        "tags": [
                            "Druckwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "47682f8f-ffe9-4886-9aca-91a5de54de3b",
                                "sense_id": "bc679f98-043f-3823-9a3f-7a799b5289a2",
                                "text": "„Ich vereinige in einem Kapitel Alles, was die Autographie und den Umdruck betrifft, weil diese beiden Methoden in der engsten Beziehung zu einander stehen, und im Grunde nur eins der zahlreichen Reproductionsmittel ausmachen, welche die Lithographie besitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
