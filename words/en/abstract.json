{
    "word_family": [
        "abstraction",
        "abstractly",
        "abstractness",
        "abstractor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8dd198fd-e451-35c3-a484-547b1f5bb8dd",
                    "sense_definition": "Relating to art that does not attempt to represent external reality, but seeks to achieve its effect using shapes, forms, colors, and textures.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "art_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She prefers <w>abstract</w> painting to realistic portraits.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает <w>абстрактную</w> живопись реалистичным портретам.",
                                "zh": "比起写实肖像画，她更喜欢<w>抽象</w>画。"
                            }
                        },
                        {
                            "text": "The museum features a large collection of modern <w>abstract</w> art.",
                            "target_lang_translations": {
                                "ru": "В музее представлена большая коллекция современного <w>абстрактного</w> искусства.",
                                "zh": "这家博物馆收藏了大量现代<w>抽象</w>艺术品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "non-representational",
                        "non-figurative"
                    ],
                    "common_phrases": [
                        "abstract art",
                        "abstract painting",
                        "abstract expressionism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к искусству, которое не пытается изобразить внешнюю реальность, а стремится достичь эффекта с помощью форм, цветов и текстур.",
                        "zh": "指不试图描绘外部现实，而是通过形状、形式、色彩和纹理来达到艺术效果的艺术风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абстрактный",
                                "target_lang_sense_clarification": "об искусстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽象的",
                                "target_lang_sense_clarification": "指艺术风格"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab87c4d5-83bb-3843-8115-617ef67ba15a",
                    "sense_definition": "Existing as an idea, feeling, or quality, not as a material object.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "conceptual_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Truth and beauty are <w>abstract</w> concepts that are defined differently by everyone.",
                            "target_lang_translations": {
                                "ru": "Истина и красота — это <w>абстрактные</w> понятия, которые каждый определяет по-разному.",
                                "zh": "真理和美是<w>抽象</w>概念，每个人对它们的定义都不同。"
                            }
                        },
                        {
                            "text": "It is difficult to visualize such an <w>abstract</w> idea without a diagram.",
                            "target_lang_translations": {
                                "ru": "Трудно визуализировать такую <w>абстрактную</w> идею без диаграммы.",
                                "zh": "没有图表的话，很难想象这种<w>抽象</w>的想法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conceptual",
                        "theoretical",
                        "intangible",
                        "ideal",
                        "incorporeal"
                    ],
                    "antonyms": [
                        "concrete",
                        "actual",
                        "corporeal",
                        "empirical"
                    ],
                    "common_phrases": [
                        "abstract concept",
                        "abstract idea",
                        "abstract thought",
                        "abstract noun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий как идея, чувство или качество, а не как материальный объект.",
                        "zh": "作为一种思想、感觉或品质存在，而非物质实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абстрактный",
                                "target_lang_sense_clarification": "об идеях и понятиях"
                            },
                            {
                                "target_lang_word": "отвлечённый",
                                "target_lang_sense_clarification": "нематериальный, теоретический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽象的",
                                "target_lang_sense_clarification": "指概念或思想"
                            },
                            {
                                "target_lang_word": "理论上的",
                                "target_lang_sense_clarification": "指非实际的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "187bc0c2-b9e4-3650-a3fc-6b51965f478d",
                    "sense_definition": "Difficult to understand because of being too theoretical or vague.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conceptual_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor's explanation was too <w>abstract</w> for the students to follow.",
                            "target_lang_translations": {
                                "ru": "Объяснение профессора было слишком <w>абстрактным</w>, чтобы студенты могли его понять.",
                                "zh": "教授的解释太<w>抽象</w>了，学生们跟不上。"
                            }
                        },
                        {
                            "text": "His writing style is often <w>abstract</w> and requires careful reading.",
                            "target_lang_translations": {
                                "ru": "Его стиль письма часто <w>абстрактен</w> и требует внимательного чтения.",
                                "zh": "他的写作风格通常很<w>抽象</w>，需要仔细研读。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abstruse",
                        "theoretical"
                    ],
                    "antonyms": [
                        "concrete",
                        "practical"
                    ],
                    "common_phrases": [
                        "abstract reasoning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания из-за чрезмерной теоретичности или неопределенности.",
                        "zh": "因过于理论化或模糊而难以理解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абстрактный",
                                "target_lang_sense_clarification": "сложный для понимания"
                            },
                            {
                                "target_lang_word": "отвлечённый",
                                "target_lang_sense_clarification": "оторванный от реальности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "深奥的",
                                "target_lang_sense_clarification": "指难以理解"
                            },
                            {
                                "target_lang_word": "空洞的",
                                "target_lang_sense_clarification": "指脱离实际"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4d2ee4fa-6d3e-3e44-a7ad-60306f80604b",
                    "sense_definition": "A summary of the contents of a book, article, or formal speech.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "summary_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must submit an <w>abstract</w> of your paper before the conference.",
                            "target_lang_translations": {
                                "ru": "Вы должны представить <w>аннотацию</w> своего доклада перед конференцией.",
                                "zh": "你必须在会议前提交论文<w>摘要</w>。"
                            }
                        },
                        {
                            "text": "The <w>abstract</w> at the beginning of the report summarizes the key findings.",
                            "target_lang_translations": {
                                "ru": "<w>Аннотация</w> в начале отчета суммирует основные выводы.",
                                "zh": "报告开头的<w>摘要</w>总结了主要发现。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summary",
                        "synopsis",
                        "abridgment"
                    ],
                    "common_phrases": [
                        "read the abstract",
                        "submit an abstract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое изложение содержания книги, статьи или официальной речи.",
                        "zh": "书籍、文章或正式演讲内容的摘要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннотация",
                                "target_lang_sense_clarification": "краткое содержание статьи или книги"
                            },
                            {
                                "target_lang_word": "реферат",
                                "target_lang_sense_clarification": "доклад по теме"
                            },
                            {
                                "target_lang_word": "конспект",
                                "target_lang_sense_clarification": "краткая запись содержания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "摘要",
                                "target_lang_sense_clarification": "指文章或报告的简述"
                            },
                            {
                                "target_lang_word": "提要",
                                "target_lang_sense_clarification": "指内容的概括"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e594db3-9e57-3d89-8e07-efa3cede5506",
                    "sense_definition": "An idea or quality considered separately from any concrete object or specific instance.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "conceptual_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I agree with your proposal in the <w>abstract</w>, but I doubt it will work in practice.",
                            "target_lang_translations": {
                                "ru": "Я согласен с вашим предложением в <w>теории</w>, но сомневаюсь, что оно сработает на практике.",
                                "zh": "我从<w>理论</w>上同意你的提议，但我怀疑它在实践中是否行得通。"
                            }
                        },
                        {
                            "text": "Justice is an <w>abstract</w> that societies strive to define and uphold.",
                            "target_lang_translations": {
                                "ru": "Справедливость — это <w>абстракция</w>, которую общества стремятся определить и поддерживать.",
                                "zh": "正义是一个社会努力定义和维护的<w>抽象</w>概念。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the abstract"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея или качество, рассматриваемые отдельно от какого-либо конкретного объекта или случая.",
                        "zh": "脱离具体对象或特定实例而考虑的思想或品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абстракция",
                                "target_lang_sense_clarification": "отвлеченное понятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽象概念",
                                "target_lang_sense_clarification": "指抽象的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "510cb623-7113-34d8-8160-d0921442f8b0",
                    "sense_definition": "An abstract work of art.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a colorful <w>abstract</w> to hang in her living room.",
                            "target_lang_translations": {
                                "ru": "Она купила красочную <w>абстракцию</w>, чтобы повесить её в гостиной.",
                                "zh": "她买了一幅色彩鲜艳的<w>抽象</w>画挂在客厅里。"
                            }
                        },
                        {
                            "text": "The gallery displays several large <w>abstracts</w> by local artists.",
                            "target_lang_translations": {
                                "ru": "В галерее выставлено несколько больших <w>абстракций</w> местных художников.",
                                "zh": "画廊展出了几幅当地艺术家的巨型<w>抽象</w>画。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Абстрактное произведение искусства.",
                        "zh": "抽象派艺术作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абстракция",
                                "target_lang_sense_clarification": "произведение искусства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽象画",
                                "target_lang_sense_clarification": "指艺术作品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "13ba4c71-be29-3ac2-a1dd-b7802800081b",
                    "sense_definition": "To remove or extract something, often used in technical or scientific contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "removal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Data was <w>abstracted</w> from the hospital records for the study.",
                            "target_lang_translations": {
                                "ru": "Данные были <w>извлечены</w> из больничных записей для исследования.",
                                "zh": "研究数据是从医院记录中<w>提取</w>出来的。"
                            }
                        },
                        {
                            "text": "The machine <w>abstracts</w> water from the air to provide drinking water.",
                            "target_lang_translations": {
                                "ru": "Машина <w>извлекает</w> воду из воздуха для обеспечения питьевой водой.",
                                "zh": "这台机器从空气中<w>提取</w>水分以提供饮用水。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extract",
                        "remove",
                        "separate",
                        "withdraw"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять или извлекать что-либо, часто используется в технических или научных контекстах.",
                        "zh": "移除或提取某物，常用于技术或科学语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлекать",
                                "target_lang_sense_clarification": "доставать, добывать"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "отделять часть от целого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "指从整体中取出"
                            },
                            {
                                "target_lang_word": "抽取",
                                "target_lang_sense_clarification": "指技术性获取"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc0ba737-d1c7-331b-af20-8e71c45220c4",
                    "sense_definition": "To make a written summary of an article or book.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "summary_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intern was asked to <w>abstract</w> the long report for the manager.",
                            "target_lang_translations": {
                                "ru": "Стажера попросили <w>реферировать</w> длинный отчет для менеджера.",
                                "zh": "实习生被要求为经理将长篇报告<w>写成摘要</w>。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>abstracting</w> articles for the database.",
                            "target_lang_translations": {
                                "ru": "Он провел день, <w>реферируя</w> статьи для базы данных.",
                                "zh": "他花了一下午时间为数据库<w>提炼</w>文章内容。"
                            }
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "abridge",
                        "epitomize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать письменное краткое изложение статьи или книги.",
                        "zh": "为文章或书籍撰写书面摘要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реферировать",
                                "target_lang_sense_clarification": "делать обзор"
                            },
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "подводить итог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "写摘要",
                                "target_lang_sense_clarification": "指撰写概括"
                            },
                            {
                                "target_lang_word": "提炼",
                                "target_lang_sense_clarification": "指总结要点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cefc008d-98f3-34ea-af12-b347837b183d",
                    "sense_definition": "To take something away secretly or without permission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "removal_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Someone had <w>abstracted</w> the documents from his desk while he was away.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>похитил</w> документы с его стола, пока его не было.",
                                "zh": "他不在的时候，有人<w>窃取</w>了他桌上的文件。"
                            }
                        },
                        {
                            "text": "The thief <w>abstracted</w> the jewels from the safe without leaving a trace.",
                            "target_lang_translations": {
                                "ru": "Вор <w>похитил</w> драгоценности из сейфа, не оставив следов.",
                                "zh": "小偷没留下任何痕迹就从保险箱里<w>窃取</w>了珠宝。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steal",
                        "purloin",
                        "filch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        },
                        {
                            "trait_type": "form",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Забирать что-либо тайно или без разрешения.",
                        "zh": "秘密地或未经许可地拿走某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похищать",
                                "target_lang_sense_clarification": "красть"
                            },
                            {
                                "target_lang_word": "тайно изымать",
                                "target_lang_sense_clarification": "формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窃取",
                                "target_lang_sense_clarification": "指偷窃"
                            },
                            {
                                "target_lang_word": "私自拿走",
                                "target_lang_sense_clarification": "指未经许可取走"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}