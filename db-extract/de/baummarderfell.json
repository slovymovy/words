                "senses": [
                    {
                        "sense_id": "8c2db9ba-d810-31e3-bf8e-7c48ed032fba",
                        "entry_id": "2666d03f-44b1-3b3e-b2f1-1243b6dad9a8",
                        "glosses": [
                            "(abgezogenes) Fell eines Baummarders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffbda73d-23a0-4e78-a5cd-6cdab412795e",
                                "sense_id": "8c2db9ba-d810-31e3-bf8e-7c48ed032fba",
                                "text": "„Der Förster traute seinen Ohren nicht. Dies war doch der Preis, den das wertvolle Baummarderfell gebracht hatte.“"
                            },
                            {
                                "example_id": "1354c682-adb2-4295-b58e-da904dffbd6d",
                                "sense_id": "8c2db9ba-d810-31e3-bf8e-7c48ed032fba",
                                "text": "„Früher wurden ungleich mehr inländische Baum- als Steinmarderfelle in den Handel gebracht, dann glichen sich die Zahlen vor einigen Decennien aus, bis nach Grünwaldts Angaben in den siebziger Jahren bereits dreimal so viele Steinmarder- als Baummarderfelle von ihm ans Kur- und Livland angekauft werden konnten.“"
                            },
                            {
                                "example_id": "5bc87962-86f3-4eee-9946-421e19daa0d3",
                                "sense_id": "8c2db9ba-d810-31e3-bf8e-7c48ed032fba",
                                "text": "„Wenn auch ein gutes Baummarderfell 2 Thlr. und etwas darüber kostet, so kostet ein solches Steinmarderfell immer auch 1 Thlr. l0— 15 Sgr. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
