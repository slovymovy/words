                {
                    "sense_id": "59705479-0cd2-3518-ae1d-85d501d51cea",
                    "sense_definition": "Выражает согласие или одобрение; соответствует словам «хорошо», «ладно», «договорились».",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Мы встретимся завтра в парке? — <Прекрасно>, я буду ждать.",
                            "target_lang_translations": {
                                "en": "— Will we meet tomorrow in the park? — <Great>, I'll be waiting.",
                                "nl": "— Zullen we morgen in het park afspreken? — <Prima>, ik zal wachten.",
                                "pl": "— Spotkamy się jutro w parku? — <Świetnie>, będę czekać.",
                                "de": "— Treffen wir uns morgen im Park? — <w>Großartig</w>, ich werde warten.",
                                "fr": "— On se retrouve demain au parc ? — <w>Parfait</w>, je t'attendrai.",
                                "it": "— Ci incontriamo domani al parco? — <Benissimo>, aspetterò.",
                                "cs": "— Sejdeme se zítra v parku? — <Skvělé>, budu čekat.",
                                "tr": "— Yarın parkta buluşalım mı? — <Harika>, bekliyor olacağım.",
                                "es": "— ¿Nos vemos mañana en el parque? — <Genial>, estaré esperando.",
                                "zh": "— 我们明天在公园见面好吗？— <w>太好了</w>，我会等着。"
                            }
                        },
                        {
                            "text": "— Я всё подготовил к презентации. — <Прекрасно>!",
                            "target_lang_translations": {
                                "en": "— I prepared everything for the presentation. — <Excellent>!",
                                "nl": "— Ik heb alles voorbereid voor de presentatie. — <Uitstekend>!",
                                "pl": "— Przygotowałem wszystko do prezentacji. — <Doskonale>!",
                                "de": "— Ich habe alles für die Präsentation vorbereitet. — <w>Ausgezeichnet</w>!",
                                "fr": "— J'ai tout préparé pour la présentation. — <w>Très bien</w> !",
                                "it": "— Ho preparato tutto per la presentazione. — <Ottimo>!",
                                "cs": "— Všechno jsem na prezentaci připravil. — <Výborně>!",
                                "tr": "— Sunum için her şeyi hazırladım. — <Harika>!",
                                "es": "— He preparado todo para la presentación. — ¡<Excelente>!",
                                "zh": "— 我已经为演示文稿做好了一切准备。— <w>好极了</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "отлично",
                        "замечательно",
                        "хорошо",
                        "ладно"
                    ],
                    "common_phrases": [
                        "звучит прекрасно"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses agreement or approval; corresponds to 'good', 'okay', 'agreed'.",
                        "nl": "Drukt instemming of goedkeuring uit; komt overeen met 'goed', 'oké', 'afgesproken'.",
                        "pl": "Wyraża zgodę lub aprobatę; odpowiednik słów 'dobrze', 'w porządku', 'zgoda'.",
                        "de": "Drückt Zustimmung oder Billigung aus; entspricht 'gut', 'in Ordnung', 'einverstanden'.",
                        "fr": "Exprime l'accord ou l'approbation; correspond à 'très bien', 'd'accord', 'parfait'.",
                        "it": "Esprime accordo, approvazione o soddisfazione; corrisponde a 'bene', 'd'accordo', 'ottimo'.",
                        "cs": "Vyjadřuje souhlas nebo schválení; odpovídá slovům 'dobře', 'fajn', 'domluveno'.",
                        "tr": "Onay veya kabul ifade eder; 'tamam', 'harika', 'olur' sözcüklerine karşılık gelir.",
                        "es": "Expresa acuerdo, aprobación o satisfacción; equivale a 'bien', 'de acuerdo' o 'genial'.",
                        "zh": "表示同意、赞同或满意，相当于“好”、“太好了”。"
                    },
