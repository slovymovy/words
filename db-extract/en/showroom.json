                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ea836d-6e25-46ca-96bd-065b845481e0",
                                                "sense_id": "21ae1c6d-3e3d-30a0-a5ba-503461ceff31",
                                                "text": "En plus de vous offrir l’une des plus grandes salles de montre sur la rive-sud de Québec, Centre de Cuisine Doyon vous fait profiter des judicieux conseils de ses designers-cuisinistes qui vous aideront dans la réalisation de votre projet."
                                            }
                                        ]
