                ],
                "senses": [
                    {
                        "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                        "entry_id": "5be2bd66-1b62-3b58-af31-662c5cf472e0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname; in Nordwestdeutschland fast flächendeckend mit Schwerpunkt zwischen Niederrhein und Weser vorkommend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a459fe-b146-416d-8c2c-912c5d51d1b2",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "„Ich muß mir entschieden verbitten, in diesem Tone mit Biermann zusammen genannt zu werden.“"
                            },
                            {
                                "example_id": "11c2f29b-06d5-4b52-bca1-4c9b2d479154",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Frau Biermann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e5c1d972-658f-4d76-b14a-c4a9aea01ee7",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Herr Biermann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8890b631-c21a-46c3-b612-ad63e9a3e84e",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Die Biermanns kommen heute aus dem Erzgebirge."
                            },
                            {
                                "example_id": "8e062dd4-cabe-4a74-979c-7e95fb1bbacf",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Der Biermann trägt nie die Schals, die die Biermann ihm strickt."
                            },
                            {
                                "example_id": "e064e3a9-452f-41ec-8313-ce3201cb7d9a",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Biermann kommt, geht der Herr Biermann.“"
                            },
                            {
                                "example_id": "97bac938-371b-49ee-abd9-e3024f5d9173",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Biermann kommt und geht."
                            },
                            {
                                "example_id": "a5da4dad-9278-4035-be2c-80a88177ce18",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "Biermanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a0d111fa-c6b1-46f7-8282-a03875aed760",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "An verregneten Herbsttagen ist Familie Biermanns liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "58d4ba41-b101-4cdf-8497-96e0858d21fe",
                                "sense_id": "de234da8-2be8-3571-a57e-8c866c9a649f",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Biermann das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
