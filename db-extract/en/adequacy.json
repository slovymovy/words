    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                "word": "adequacy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e8b752ec-5dcd-4ccd-b6a6-25f366c6f355",
                        "entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "tags": [
                            "plural"
                        ],
                        "form": "adequacies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                        "entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "glosses": [
                            "The quality of being sufficient, adequate or able to meet the needs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f299b25e-60f9-4a02-8b37-e654a992c1f9",
                                "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                                "text": "His zeal is, of course, unquestionable; his adequacy, however, I doubt."
                            },
                            {
                                "example_id": "aae3378b-ee65-4f0c-9eea-5e31e6b22382",
                                "sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                                "text": "GREETINGS, adventurer! In honor of your adequacy, I bring you a gift from the Dunmer people!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdc6853b-e650-4111-81b6-6ece9a1a02c4",
                        "source_entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "source_sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                        "source_sense_description": "sufficiency",
                        "target_lang_word": "deugdelijkheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deugdelijkheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f4d6c8f9-6860-3d82-bbd2-4b6f49ce95da",
                                        "entry_id": "83b40d3b-cf5f-3a44-9776-617554a92a6b",
                                        "glosses": [
                                            "het van goede kwaliteit zijn; betrouwbaar gebruikt kunnen worden; zonder gebreken of tekortkomingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ebde314-973a-4cac-8a93-ed7a6dc63425",
                                                "sense_id": "f4d6c8f9-6860-3d82-bbd2-4b6f49ce95da",
                                                "text": "Het Italiaanse bedrijf wilde niet alleen dat onafhankelijke deskundigen de deugdelijkheid van de omstreden hogesnelheidstreinen gaan onderzoeken, maar eiste tevergeefs ook inzage in drie technische rapporten. Op basis van die rapporten besloot de NS kort na de NMBS om met de Fyra te stoppen."
                                            },
                                            {
                                                "example_id": "b6e42d2f-2679-487e-a86d-85f6b704a970",
                                                "sense_id": "f4d6c8f9-6860-3d82-bbd2-4b6f49ce95da",
                                                "text": "Aan de finale van de Ronde van Vlaanderen wordt de komende jaren niet meer gesleuteld. Die uitdrukkelijke wens heeft koersdirecteur Wim Van Herreweghe geopperd in Het Nieuwsblad. 'Het parcours heeft haar deugdelijkheid bewezen. We willen op deze weg een traditie bouwen', luidt het."
                                            },
                                            {
                                                "example_id": "ac66fb8c-a7f5-4267-81af-a918f3ed9533",
                                                "sense_id": "f4d6c8f9-6860-3d82-bbd2-4b6f49ce95da",
                                                "text": "GroenLinks was altijd al tegen de ontsluiting via de Hegebeekweg. Robin Wessels twijfelde in 2014 openlijk aan de deugdelijkheid van de onderzoeken op basis waarvan de gemeente besluiten nam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b09fad4a-7f3e-4eaf-90ec-f61f99b25464",
                        "source_entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "source_sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                        "source_sense_description": "sufficiency",
                        "target_lang_word": "Brauchbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brauchbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c56213e4-6c18-3d6d-93ce-9f0794515024",
                                        "entry_id": "21501e7e-dfb0-3ea9-8e5b-b3a41f7b880a",
                                        "glosses": [
                                            "Eigenschaft, brauchbar, verwendbar zu sein, sich in brauchbarem Zustand zu befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dadd883e-c5f7-4398-b586-202ceac365ab",
                                                "sense_id": "c56213e4-6c18-3d6d-93ce-9f0794515024",
                                                "text": "„Sind solche Leitlinien nicht erarbeitet, kann die Brauchbarkeit durch eine europäische technische Zulassung nach § 6 Abs. 4 Satz 2 nachgewiesen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ca8160b-dfdf-4f12-8a32-2d3c4ea94987",
                        "source_entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "source_sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                        "source_sense_description": "sufficiency",
                        "target_lang_word": "Angemessenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angemessenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4da79e7a-c5ee-3bfa-9b75-0ea8fdf31041",
                                        "entry_id": "ca41b058-6ea4-34be-9069-60d338f9aca9",
                                        "glosses": [
                                            "Zustand und/oder Eigenschaft, in einem bestimmten Zusammenhang richtig zu sein, für einen bestimmten Fall genau passend zu sein, einer bestimmten Situation geeignet zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324fac6f-7588-4d33-b54a-cbee5bbe7791",
                                                "sense_id": "4da79e7a-c5ee-3bfa-9b75-0ea8fdf31041",
                                                "text": "„Die Mutter versucht ihre Tochter dafür zu sensibilisieren, dass Anlass und Umfeld einer Situation über die Angemessenheit von Kleidung entscheiden.“"
                                            },
                                            {
                                                "example_id": "70a0b5ce-fd74-45dd-8a66-939ac3b6557b",
                                                "sense_id": "4da79e7a-c5ee-3bfa-9b75-0ea8fdf31041",
                                                "text": "„Der Richtwert bestimmt die abstrakte Angemessenheit der Mietkosten in einem bestimmten räumlichen Bezugsbereich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06031c85-e549-4707-b8da-0bf35e2a9516",
                        "source_entry_id": "cf991ec8-d879-3ffb-9625-270412415acf",
                        "source_sense_id": "e6da645e-758a-3412-97e5-49125ba85ce4",
                        "source_sense_description": "sufficiency",
                        "target_lang_word": "Eignung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eignung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "152b0d18-6614-3b3a-8aae-3ca03d4a106b",
                                        "entry_id": "98ba16d8-982b-3d32-9747-7bd48b92f5a4",
                                        "glosses": [
                                            "Eigenschaft, passend, tauglich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d678c43-a93f-4355-9c68-c2fd47020597",
                                                "sense_id": "152b0d18-6614-3b3a-8aae-3ca03d4a106b",
                                                "text": "Sie muss ihre Eignung als Vorsitzende erst beweisen."
                                            },
                                            {
                                                "example_id": "c27172dd-a130-456f-ab8a-58658c2d18c5",
                                                "sense_id": "152b0d18-6614-3b3a-8aae-3ca03d4a106b",
                                                "text": "„Das bei Extremtouren immer wieder beschriebene Auftreten der Höhenkrankheit provoziert die Frage, inwieweit der Mensch überhaupt die Eignung und die Ausstattung mitbringt, sich als Erkunder solcher Höhenregionen zu betätigen.“"
                                            },
                                            {
                                                "example_id": "c802e984-7932-4207-a0fe-a839e2c14907",
                                                "sense_id": "152b0d18-6614-3b3a-8aae-3ca03d4a106b",
                                                "text": "„Es fehlt nicht an kritischen Stimmen, die ihr die Eignung für den Preis absprechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
