                        "examples": []
                    },
                    {
                        "sense_id": "03aae7c1-794f-303a-9053-9ecd8dbf3811",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Смол.), всякая праздничная обувь"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e83a1362-8742-38ea-be8f-d8dca6683b0a",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Барнаул., Буткин., Свердл., Дубен., Тул.), любая лёгкая обувь (тапочки, туфли и т. п.)"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "5e207034-0ba8-4545-8c3b-82bbbaa1b005",
                                "sense_id": "e83a1362-8742-38ea-be8f-d8dca6683b0a",
                                "text": "— В барéтках-то способно."
                            },
                            {
                                "example_id": "7357cb4b-c00e-4611-a5f1-1120f1a7fe96",
                                "sense_id": "e83a1362-8742-38ea-be8f-d8dca6683b0a",
                                "text": "— Наденешь баретки и идёшь на вечёрку."
                            },
                            {
                                "example_id": "4c5d51b3-0720-4665-a388-bf845fb2e9b3",
                                "sense_id": "e83a1362-8742-38ea-be8f-d8dca6683b0a",
                                "text": "Пойду плясать, — // Натяну баретки! // Стану ноги задирать // Выше табуретки!"
                            }
                        ]
                    },
                    {
                        "sense_id": "4d35c547-43fc-3374-b84b-b577f26a1990",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Кунгур. Перм., Талицк. Свердл.), женский кожаный башмак на низком каблуке со шнурком или пуговицами"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a1e82711-00ca-3fdb-b0a5-a632968ce46a",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Нижнелом. Пенз., Курган. Урал., Ростов., Углич. Яросл., Брон. Моск., Шадр. Перм.), грубая женская туфля"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eb841eeb-daf7-30c6-bb23-5d798c66d6c9",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Забайк.), кожаная (или матерчатая) туфелька для девочек"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6b4bf8ac-0a2b-374c-b7de-4f6ae84ea494",
                        "entry_id": "75d6fb1b-fffa-36f3-bdc3-545663357853",
                        "glosses": [
                            "рег. (Сав.), мужской ботинок"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "e08ae0aa-1fba-4da4-9926-eef4cc1871de",
                                "sense_id": "6b4bf8ac-0a2b-374c-b7de-4f6ae84ea494",
                                "text": "А у милого мово — // Чёрные баретки! // А как харя у него — // Шире табуретки!"
                            }
                        ]
                    }
