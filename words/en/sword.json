    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "604dae9f-8225-3fc4-af32-dab1b23db717",
                    "sense_definition": "A long bladed weapon with a grip and typically a pommel and crossguard, designed to cut, stab, slash, or hack.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight drew his <w>sword</w> to defend the castle.",
                            "target_lang_translations": {
                                "ru": "Рыцарь обнажил свой <w>меч</w>, чтобы защитить замок.",
                                "zh": "骑士拔出<w>剑</w>来保卫城堡。"
                            }
                        },
                        {
                            "text": "Be careful when handling the weapon, as the <w>sword</w> is very sharp.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен при обращении с оружием, так как <w>меч</w> очень острый.",
                                "zh": "使用这件武器时要小心，因为这把<w>剑</w>非常锋利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "draw a sword",
                        "put to the sword",
                        "cross swords",
                        "double-edged sword"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинное клинковое оружие с рукоятью и гардой, предназначенное для нанесения колющих и рубящих ударов.",
                        "zh": "一种长刃武器，有柄，通常带有柄头和护手，用于劈砍或刺击。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меч",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "шпага",
                                "target_lang_sense_clarification": "в контексте фехтования или более поздних эпох"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剑",
                                "target_lang_sense_clarification": "主要指双刃长剑"
                            },
                            {
                                "target_lang_word": "刀",
                                "target_lang_sense_clarification": "泛指单刃或长柄兵器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5630201-0065-3104-96a4-704ac073fb86",
                    "sense_definition": "A suit in certain playing card decks, particularly those used in Spain and Italy, or a card of this suit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Queen of <w>Swords</w> represents a sharp intellect in this tarot deck.",
                            "target_lang_translations": {
                                "ru": "Королева <w>Мечей</w> олицетворяет острый ум в этой колоде Таро.",
                                "zh": "在这副塔罗牌中，<w>宝剑</w>王后代表着敏锐的智慧。"
                            }
                        },
                        {
                            "text": "He needed a card from the suit of <w>swords</w> to complete his winning hand.",
                            "target_lang_translations": {
                                "ru": "Ему нужна была карта масти <w>мечей</w>, чтобы собрать выигрышную комбинацию.",
                                "zh": "他需要一张<w>宝剑</w>花色的牌来凑齐他的赢牌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "suit of swords",
                        "king of swords"
                    ],
                    "target_lang_definitions": {
                        "ru": "Масть в некоторых колодах игральных карт (особенно в Таро или итало-испанских колодах), изображаемая в виде мечей.",
                        "zh": "某些纸牌游戏（如塔罗牌或意大利/西班牙式扑克牌）中的一种花色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мечи",
                                "target_lang_sense_clarification": "карточная масть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝剑",
                                "target_lang_sense_clarification": "塔罗牌中的花色名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "480b6ab4-77b4-37c4-b610-bcf990f44df1",
                    "sense_definition": "One of the end bars by which the lay of a hand loom is suspended.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weaver carefully adjusted the <w>sword</w> to ensure the fabric was tight.",
                            "target_lang_translations": {
                                "ru": "Ткач осторожно отрегулировал <w>меч</w> станка, чтобы ткань была плотной.",
                                "zh": "织工小心地调整了<w>筘座脚</w>，以确保织物紧实。"
                            }
                        },
                        {
                            "text": "This antique loom cannot be used because it has a broken <w>sword</w>.",
                            "target_lang_translations": {
                                "ru": "Этот старинный ткацкий станок нельзя использовать, так как у него сломан <w>меч</w>.",
                                "zh": "这台古董织布机不能用了，因为它的<w>筘座脚</w>断了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "weaving term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из вертикальных стоек, на которых подвешен батан ручного ткацкого станка.",
                        "zh": "手工织布机上用于悬挂筘座的垂直支柱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меч",
                                "target_lang_sense_clarification": "деталь ткацкого станка"
                            },
                            {
                                "target_lang_word": "стойка батана",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "筘座脚",
                                "target_lang_sense_clarification": "织布机部件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e76e7ac6-93d7-3966-a6c3-c3196baf3755",
                    "sense_definition": "To stab or cut with a sword.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the ancient epic poem, the hero <w>sworded</w> the dragon in its heart.",
                            "target_lang_translations": {
                                "ru": "В древней эпической поэме герой <w>пронзил мечом</w> сердце дракона.",
                                "zh": "在古代史诗中，英雄用剑<w>刺穿</w>了龙的心脏。"
                            }
                        },
                        {
                            "text": "The soldier was <w>sworded</w> down in the midst of the chaotic fray.",
                            "target_lang_translations": {
                                "ru": "Солдат был <w>зарублен</w> посреди хаотичной битвы.",
                                "zh": "那名士兵在混乱的战斗中被<w>砍杀</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить удар, колоть или убивать мечом.",
                        "zh": "用剑刺或砍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разить мечом",
                                "target_lang_sense_clarification": "устаревшее/поэтическое"
                            },
                            {
                                "target_lang_word": "зарубить",
                                "target_lang_sense_clarification": "убить рубящим оружием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺杀",
                                "target_lang_sense_clarification": "用剑刺死"
                            },
                            {
                                "target_lang_word": "砍杀",
                                "target_lang_sense_clarification": "用剑砍杀"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c08aa6f4-cc6c-3554-a5a6-2301157da606",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Sword</w> to join us for the business meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили мистера <w>Сорда</w> присоединиться к нам на деловой встрече.",
                                "zh": "我们邀请了<w>斯沃德</w>先生参加我们的商务会议。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Sword</w> at the clinic this afternoon.",
                            "target_lang_translations": {
                                "ru": "У меня назначена встреча с доктором <w>Сордом</w> в клинике сегодня днем.",
                                "zh": "我今天下午在诊所和<w>斯沃德</w>医生有预约。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Сорд",
                                "target_lang_sense_clarification": "транслитерация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯沃德",
                                "target_lang_sense_clarification": "音译姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
