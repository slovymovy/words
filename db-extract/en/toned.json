                "translations": [
                    {
                        "translation_id": "ab236ff5-be98-45a8-80a8-0059e9bdc039",
                        "source_entry_id": "0d89baf5-5655-3068-8941-0b138d2b6197",
                        "source_sense_description": "Defined or firm",
                        "target_lang_word": "robuste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robuste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a594f607-c4d9-3d90-bafa-af2296fb98c1",
                                        "entry_id": "9d127157-9624-3d10-84bd-256f6374970b",
                                        "glosses": [
                                            "Qui est fort, vigoureux, résistant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ab16122-1d48-33a3-9d0f-d741c1cc8023",
                                        "entry_id": "9d127157-9624-3d10-84bd-256f6374970b",
                                        "glosses": [
                                            "Qui est fort, vigoureux, résistant.",
                                            "Se dit principalement des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "143e2e75-28cb-4fa1-8136-01bf8518e898",
                                                "sense_id": "9ab16122-1d48-33a3-9d0f-d741c1cc8023",
                                                "text": "Le complet de serge laissait voir maintes traces d’usure, et les entournures trop larges faisaient paraître l’homme plus robuste qu’il n’était en réalité."
                                            },
                                            {
                                                "example_id": "a1c81a63-9dab-40e5-9914-5db6c5831946",
                                                "sense_id": "9ab16122-1d48-33a3-9d0f-d741c1cc8023",
                                                "text": "Il connaissait Zaheira : elle était toute jeune et robuste, belle. Instruite aussi, ce dont il n'avait cure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9af9d87e-044b-3493-ac94-6bcb7f569bb5",
                                        "entry_id": "9d127157-9624-3d10-84bd-256f6374970b",
                                        "glosses": [
                                            "Qui est fort, vigoureux, résistant.",
                                            "Se dit aussi des animaux et même des végétaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98f0b96-4229-4584-a04f-dcb2a5b1493f",
                                                "sense_id": "9af9d87e-044b-3493-ac94-6bcb7f569bb5",
                                                "text": "Mais quand tes prêtres, loups aux mâchoires robustes,\nRepus de graisse humaine et de rage amaigris,\nDe l’holocauste offert demanderont le prix,\nSurgissant devant eux de la cendre des Justes,\nJe les flagellerai d’un immortel mépris."
                                            },
                                            {
                                                "example_id": "5a036e84-600e-4386-90f6-28b28f8b58cb",
                                                "sense_id": "9af9d87e-044b-3493-ac94-6bcb7f569bb5",
                                                "text": "Ce cheval est peu robuste. - Une plante, un arbre robuste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60935de1-c6a9-3adf-aeff-7704a7bb9b6c",
                                        "entry_id": "9d127157-9624-3d10-84bd-256f6374970b",
                                        "glosses": [
                                            "Se dit d’un programme informatique capable de fonctionner dans des conditions non nominales (erreur de saisie …)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4240ac4-9418-45e1-b8e8-84de5b1f0389",
                                                "sense_id": "60935de1-c6a9-3adf-aeff-7704a7bb9b6c",
                                                "text": "Le programme est robuste aux retours de ligne en trop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18eccdc9-6c2c-4238-92f2-4e6d94da8c57",
                        "source_entry_id": "0d89baf5-5655-3068-8941-0b138d2b6197",
                        "source_sense_description": "Defined or firm",
                        "target_lang_word": "vigoureux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigoureux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                        "entry_id": "85f50e12-b9b7-3878-8c5e-971c66e7db62",
                                        "glosses": [
                                            "Qui a de la vigueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dd8199c-9c03-4bfd-ae54-882296cbb7dc",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Cet homme est vigoureux, est d’une santé vigoureuse."
                                            },
                                            {
                                                "example_id": "ea5ba92f-a072-4a04-aaef-6f4dbaf4088a",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Une vigoureuse jeunesse."
                                            },
                                            {
                                                "example_id": "c99c46cd-6f9e-48d8-9e3a-1b3367593469",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Un cheval vigoureux."
                                            },
                                            {
                                                "example_id": "5e663e8d-a295-4809-8a35-897dc3d6658f",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Et l’aigle et le corbeau viendront, disant entre eux :\nOù donc se dressait-elle autrefois sous la nue,\nLa Ville aux murs de fer des géants vigoureux ?"
                                            },
                                            {
                                                "example_id": "3d3920c9-e9b4-473c-b8a7-01f82043c3a4",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Une colossale figure du « Temps », soulève Terre et cadran sur ses vigoureuses épaules."
                                            },
                                            {
                                                "example_id": "61191bfe-9d01-4e51-98cb-46685f60e180",
                                                "sense_id": "0ad52097-ff7d-3e48-a114-898101b1b1c7",
                                                "text": "Le Bacchus, qui provient d'un semis de Clinton, est un cépage d'avenir pour la culture en treillages dans les sols profonds. […]. Il est très vigoureux, très fertile, très résistant au phylloxéra, à l’oïdium et au mildew."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                        "entry_id": "85f50e12-b9b7-3878-8c5e-971c66e7db62",
                                        "glosses": [
                                            "Qui se fait avec vigueur, où il y a de la vigueur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a24b19a-68c9-41a5-bb22-62acd7ee1f22",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "En effet, à l’appel du gong, Habib se porta rapidement à la rencontre du Suédois et le bombarda sans arrêt de swings si vigoureux à la poitrine que l’autre s’écroula."
                                            },
                                            {
                                                "example_id": "7487fd5a-2985-43c2-8f9e-204b48475e2d",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Attaque, résistance vigoureuse."
                                            },
                                            {
                                                "example_id": "76388060-9b22-4646-981c-d14c9cbd9a07",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Discours vigoureux."
                                            },
                                            {
                                                "example_id": "9d5d2c8c-bb5b-4c7a-9d75-44b0b1bcf1bd",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Action vigoureuse."
                                            },
                                            {
                                                "example_id": "2dff8b9d-9834-402d-8288-eac8d715ceb5",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Une touche vigoureuse."
                                            },
                                            {
                                                "example_id": "563f5d76-bc7f-4023-b5f5-6783de28efbb",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Un pinceau vigoureux."
                                            },
                                            {
                                                "example_id": "9436bafd-52a7-48eb-a153-c9c3f0958518",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Un dessin, un style vigoureux."
                                            },
                                            {
                                                "example_id": "423d75fd-5d04-464a-892b-b8f07050c540",
                                                "sense_id": "7797d951-2bf9-304f-9250-77798f368783",
                                                "text": "Ce pianiste a un jeu vigoureux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd8949f-6df1-3dc6-8086-d37b4ef3d919",
                                        "entry_id": "85f50e12-b9b7-3878-8c5e-971c66e7db62",
                                        "glosses": [
                                            "Qui est en bonne santé."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b33ebb7-2b19-474f-aa99-db97de334621",
