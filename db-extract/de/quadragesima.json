                        "entry_id": "f72c7633-7f6e-3b3d-bff8-2480fdd00456",
                        "glosses": [
                            "Fastenzeit von vierzig Tagen vor Ostern"
                        ],
                        "tags": [
                            "speziell Christentum"
                        ],
                        "examples": [
                            {
                                "example_id": "8f96eeb4-4313-4d8e-9ab6-3becd4cd0b18",
                                "sense_id": "390fc866-9a6d-393d-8f7f-18f761bf2dcb",
                                "text": "„Der Name Quadragesima (für lateinisch vierzig) ist in Rom entstanden und bezeichnet die 40 Tage der Fastenzeit. Im griechischen Raum wird die Zeit auch als Tessarakoste bezeichnet.“"
                            }
                        ],
