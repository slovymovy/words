                                "target_senses": [
                                    {
                                        "sense_id": "7a70ed1e-b00b-3a12-a21f-11af494cdb81",
                                        "entry_id": "10b82842-a5b0-33e5-8dfa-e82d68dc8c01",
                                        "glosses": [
                                            "ato ou efeito de imigrar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "348b84fa-3815-4f7d-b6f2-e1e7d7a09181",
                                                "sense_id": "7a70ed1e-b00b-3a12-a21f-11af494cdb81",
                                                "text": "Essa integração, com a preservação dos valores próprios, é uma das marcas mais fortes da imigração japonesa, cujo centenário se celebra agora."
                                            }
                                        ]
                                    }
                                ]
