                            {
                                "example_id": "2a4f44cc-f167-4a27-8574-8feb30c6a45c",
                                "sense_id": "c9f1a84c-9d5c-39a3-bb77-e03ab36add6c",
                                "text": "The bathroom is smeared with fingerprints and painted dingy white, not the most flattering light. Jon wouldn’t feel like an artist without a certain amount of dinge around."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c772278-5694-3e9d-ac7d-9a45a4b3a1c9",
