                        "entry_id": "b594bd54-dab1-3447-967c-b6e89125653f",
                        "glosses": [
                            "drukwerk dat zoveel bladzijden heeft dat het in aparte band kan worden gebonden, maar waarvan de inhoud onderdeel is van een groter werk"
