                ],
                "senses": [
                    {
                        "sense_id": "aee05ea2-7a7a-3437-a65a-820325612fcc",
                        "entry_id": "908f22b6-f2e4-333c-9156-fed665bd51a7",
                        "glosses": [
                            "Stärke/Intensität des Lärms/Schalls"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a3967ae-5fdf-4b9c-a624-02e5ce052174",
                                "sense_id": "aee05ea2-7a7a-3437-a65a-820325612fcc",
                                "text": "„Der Lärmpegel in Grundschulklassenzimmern behindert konzentriertes Lernen.“"
                            },
                            {
                                "example_id": "9f79bcbf-8e06-4343-8b7b-2ff625215caa",
                                "sense_id": "aee05ea2-7a7a-3437-a65a-820325612fcc",
                                "text": "„Trotz zusätzlicher Lärmschutzmaßnahmen haben neue Messungen der Gemeinde Lärmpegel ergeben, dass der Lärmpegel zumindest an die maximal zulässigen Grenzwerte heranreicht oder sie vielleicht sogar überschreitet.“"
                            },
                            {
                                "example_id": "3941c4b3-a7b0-4a58-9c32-c6a2b9d218eb",
                                "sense_id": "aee05ea2-7a7a-3437-a65a-820325612fcc",
                                "text": "„Das Verbot gilt für die Zeitspanne von 22 bis 6 Uhr - und stellt eine deutliche Verbesserung hinsichtlich des nächtlichen Lärmpegels dar.“"
                            },
                            {
                                "example_id": "81ac6235-fe4f-4b75-b407-f0cbd0ecf323",
                                "sense_id": "aee05ea2-7a7a-3437-a65a-820325612fcc",
                                "text": "„In den betroffenen Straßen ist mehr Ruhe nicht nur angenehm, sondern dringend notwendig, weil die Lärmpegel weit über den Richtwerten liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
