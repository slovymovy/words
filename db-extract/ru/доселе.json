                "senses": [
                    {
                        "sense_id": "357f3b9a-883b-35ee-8fe1-879239c259c8",
                        "entry_id": "70039186-87f9-3061-958c-38e60075af7a",
                        "glosses": [
                            "hitherto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d24d5e-21af-4f41-a536-4557d45baca1",
                                "sense_id": "357f3b9a-883b-35ee-8fe1-879239c259c8",
                                "text": "Он чу́вствовал, что все его́ досе́ле распу́щенные, разбро́санные си́лы бы́ли со́браны в одно́ и с стра́шною эне́ргией бы́ли напра́влены к одно́й блаже́нной це́ли.",
                                "translation": "He felt that all his forces, hitherto dissipated, wasted, were centered on one thing, and bent with fearful energy on one blissful goal.",
                                "english": "He felt that all his forces, hitherto dissipated, wasted, were centered on one thing, and bent with fearful energy on one blissful goal."
                            }
                        ]
                    }
                ],
                "translations": [],
