                "senses": [
                    {
                        "sense_id": "618abeb8-1b69-3da6-ae8a-a81b511626f2",
                        "entry_id": "9aa80d44-c8ad-3b80-bcd1-c8e2e461f96d",
                        "glosses": [
                            "noumenon"
                        ],
                        "tags": [
