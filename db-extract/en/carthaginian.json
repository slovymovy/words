                    {
                        "translation_id": "c06aa450-5ef1-4788-82b6-2f181c5aebf4",
                        "source_entry_id": "7a8d94ae-ec39-36af-ba7d-b526198c2394",
                        "source_sense_id": "c519f36c-38ad-3634-bb99-7a424d4358df",
                        "source_sense_description": "of or pertaining to Carthage",
                        "target_lang_word": "carthaginois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carthaginois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52ea6e7f-f66a-3612-aaab-d719e0c7bc04",
                                        "entry_id": "f4b5c21d-4348-3202-bc98-362fe04217f6",
                                        "glosses": [
                                            "Qui est relatif à Carthage et à son peuple."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6938f74-a466-4aeb-888e-af0a82efa08c",
                                                "sense_id": "52ea6e7f-f66a-3612-aaab-d719e0c7bc04",
                                                "text": "Vous aurez de la peine à donner pour les couches de Mme la Dauphine un spectacle aussi noble et aussi galant que celui qu’on prépare à Berlin : un carrousel composé de quatre quadrilles nombreuses, carthaginoises, persanes, grecques et romaines, conduites par quatre princes."
                                            },
                                            {
                                                "example_id": "7b29c96e-164b-4dde-8d2d-dbef13aaad7f",
                                                "sense_id": "52ea6e7f-f66a-3612-aaab-d719e0c7bc04",
                                                "text": "Azemmour est une ville très ancienne. D’origine berbère ou carthaginoise, elle passa successivement sous la domination romaine, vandale, byzantine et arabe."
                                            },
                                            {
                                                "example_id": "14db0c02-fce6-42af-bf62-c9fd116cc0bc",
                                                "sense_id": "52ea6e7f-f66a-3612-aaab-d719e0c7bc04",
                                                "text": "L’Empire carthaginois, en Afrique du Nord, en Espagne du Sud, en Corse, en Sardaigne et en Sicile méridionale, était un État marchand qui tirait sa richesse des provinces sujettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27584b6d-859a-4d27-9de0-bcaeefc96e27",
                        "source_entry_id": "7a8d94ae-ec39-36af-ba7d-b526198c2394",
                        "source_sense_id": "c519f36c-38ad-3634-bb99-7a424d4358df",
                        "source_sense_description": "of or pertaining to Carthage",
                        "target_lang_word": "karthagisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karthagisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da6a1c96-f8c7-3e9d-98ef-d8c147359c22",
                                        "entry_id": "741ba28e-2187-37e4-9cac-3b73fff2335d",
                                        "glosses": [
                                            "die Karthager oder Karthago betreffend, zur Kultur Karthagos gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9127e1b7-6822-4849-b5cd-4786a9f82cea",
                                                "sense_id": "da6a1c96-f8c7-3e9d-98ef-d8c147359c22",
                                                "text": "In Spanien gab es mehrere karthagische Kolonien."
                                            },
                                            {
                                                "example_id": "9327f0c5-6b2f-49f6-b689-e0f6fad9e48e",
                                                "sense_id": "da6a1c96-f8c7-3e9d-98ef-d8c147359c22",
                                                "text": "„Roms Widerstandskraft war nach Cannae durchaus nicht gebrochen. Dem Adressaten dieser Botschaft soll der römische Großmut sowie die Solidarität der Römer in einer Notlage vorgeführt werden und im Gegensatz dazu die karthagische Kleinmütigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6568420-f4c5-4723-bdcd-312e8bc60fff",
                        "source_entry_id": "7a8d94ae-ec39-36af-ba7d-b526198c2394",
