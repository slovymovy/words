                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scouts worked to ensure a <w>rid</w> road for the approaching army.",
                            "target_lang_translations": {
                                "ru": "Разведчики работали над тем, чтобы обеспечить <w>расчищенную</w> дорогу для приближающейся армии.",
