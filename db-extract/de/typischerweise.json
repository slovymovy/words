                        "translation_id": "7252b149-dfbc-49a0-9b96-a64dcf50403c",
                        "source_entry_id": "19b155b2-0309-3746-8924-cb28f1eed54a",
                        "source_sense_id": "34ee6dea-1b8f-3547-9b30-4864263cd1f2",
