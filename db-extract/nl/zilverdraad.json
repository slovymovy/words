                            {
                                "example_id": "dfe6ace1-28ea-420c-8bfd-20e496aceca8",
                                "sense_id": "c1b163be-eac4-3b0d-bd65-2a4c3b3bf223",
                                "text": "Van de ceremonie herinnert de toen 25-jarige vorstin zich ook dat haar geborduurde jurk met parels en goud- en zilverdraad heel zwaar was. \"Hij zat vol stiksels die aan het tapijt bleven hangen. Ik kon me nauwelijks meer bewegen. Daar hadden ze geen rekening mee gehouden.\""
                            },
                            {
                                "example_id": "01455ea3-09a8-4405-a657-c7ef593b19e0",
                                "sense_id": "c1b163be-eac4-3b0d-bd65-2a4c3b3bf223",
                                "text": "Naast de rijk bewerkte japon, gaat het onder meer om een mantel, kousen en lijfjes van zijde met grote hoeveelheden goud- en zilverdraad."
                            }
                        ]
                    }
