                                                "text": "Er ligt een kleine steen op het garagepad."
                                            },
                                            {
                                                "example_id": "4ad24099-0307-4e66-9e9e-085218b420bc",
                                                "sense_id": "bef9d44e-9abc-3c83-ac15-c91e7312d9f0",
                                                "text": "Vanachter mijn struik gooide ik wat kleine steentjes naar hem toe."
                                            },
                                            {
                                                "example_id": "48d476eb-fd3c-45c8-a294-ec1933094ee4",
                                                "sense_id": "bef9d44e-9abc-3c83-ac15-c91e7312d9f0",
                                                "text": "Na uren lopen en een hele tijd zoeken vond ik een vlakke plek voor mijn tent en gooide ik eerst een aantal stenen de struiken in om eventuele slangen te verjagen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bbb67bd-6316-3287-a7f0-522f822c3bde",
                                        "entry_id": "06a5ddc9-8467-393d-bb19-120b41095d6d",
                                        "glosses": [
                                            "als linkerdeel van een samengesteld bijvoeglijk naamwoord om de betekenis van het rechterdeel te versterken\\nDe eerste betekenis \\\"harde stof\\\" is bij sommige van deze woorden ook mogelijk."
                                        ],
