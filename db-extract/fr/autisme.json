        "fr-extract.jsonl": [
            {
                "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                "word": "autisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7da27ffd-4581-4989-b555-3f97cd9d84c9",
                        "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                        "tags": [
                            "plural"
                        ],
                        "form": "autismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                        "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                        "glosses": [
                            "Trouble, particularité neurologique caractérisée par des difficultés de communication, ainsi que des comportements à caractère restreint et répétitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f9d1f3e-d728-45f4-9f30-886fe00ff015",
                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                "text": "D’où son ambition d’expliquer l’autisme, d’abord à son environnement proche, puis aux recruteurs et à la société tout entière."
                            },
                            {
                                "example_id": "f5741b9b-3172-49cb-9d38-5df8bd9f9fee",
                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                "text": "Le soutien et la compréhension de la famille ne sont pas toujours au rendez-vous, au risque de développer de la culpabilité chez les personnes atteintes des troubles du spectre de l’autisme."
                            },
                            {
                                "example_id": "d261d322-1e9b-4d6a-b647-5a3e8cb2639d",
                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                "text": "On sait que l’on entre dans le spectre de l’autisme dès lors que l’on repère des particularités communicationnelles et interactionnelles « déficitaires » ainsi que des comportements « à caractère restreint et répétitif »."
                            },
                            {
                                "example_id": "ef7cc608-5b88-44a1-8c98-2a2d8c15dc46",
                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                "text": "Hans Asperger est connu pour avoir donné son nom au syndrome de l’autisme dit de « haut niveau », sans déficit intellectuel."
                            }
                        ]
                    },
                    {
                        "sense_id": "56dff8b9-3d7f-3a85-b508-a27277a7191a",
                        "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                        "glosses": [
                            "Tout comportement de repli sur soi."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cefc939d-9b1c-4eab-a21a-5aa62e559419",
                                "sense_id": "56dff8b9-3d7f-3a85-b508-a27277a7191a",
                                "text": "On l’a enfermé de plus en plus radicalement dans son autisme, dans sa coupure d’avec la réalité, rien n’a été fait pour l’aider à rétablir un lien, un dialogue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b1e43079-05fa-4899-96f9-930eaa2cbd91",
                        "source_entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                        "target_lang_word": "Autismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca015491-6ff5-30a5-b831-6651b04a19f7",
                                        "entry_id": "2c34719b-e701-33f0-bb47-ad5968b0b753",
                                        "glosses": [
                                            "eine tiefgreifende Entwicklungsstörung, betroffen ist die Entwicklung von sozialen Kontakten, Empathie, Sprache, Interessen, oftmals begleitet von Intelligenzminderung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461de52a-4d40-44ff-9c19-156d09ed5117",
                                                "sense_id": "ca015491-6ff5-30a5-b831-6651b04a19f7",
                                                "text": "„Der häufigere Besuch von Kindergärten und die frühere Einschulung der Kinder erhöhen die Chance, dass Autismus entdeckt wird.“"
                                            },
                                            {
                                                "example_id": "dc4a3ed5-9b4c-465d-b08c-c13ec69708c8",
                                                "sense_id": "ca015491-6ff5-30a5-b831-6651b04a19f7",
                                                "text": "„Neue Kenntnisse über die vielfältigen Erscheinungsformen der Störung sowie verbesserte diagnostische Möglichkeiten erlauben es heute, Autismus auch in seinen subtilen Ausprägungen zu erkennen.“"
                                            },
                                            {
                                                "example_id": "439b72a7-e589-44cb-b5c5-8195b62a3b92",
                                                "sense_id": "ca015491-6ff5-30a5-b831-6651b04a19f7",
                                                "text": "„Er entzog sich den beiden durch pure Geschwindigkeit und einen entweder angeborenen oder angenommenen Autismus.“"
                                            },
                                            {
                                                "example_id": "403660c3-3af0-47f9-ae8c-c85ae13432eb",
                                                "sense_id": "ca015491-6ff5-30a5-b831-6651b04a19f7",
                                                "text": "„Was auch immer an Sarah besonders ist, ist also nicht der Versuch, realistisch über weiblichen Autismus zu sprechen, auch wenn sie vielleicht Züge davon trägt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12381e21-9f7c-456e-9047-44b03e508c2c",
