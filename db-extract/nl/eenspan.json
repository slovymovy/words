                        "glosses": [
                            "rijtuig getrokken door één paard of ander trekdier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2f0c38-325b-49f3-810e-6575c29affea",
                                "sense_id": "58f11f7d-1a4f-3ddd-8ab9-0c56242fae29",
                                "text": "Ter plekke bleek een tweespan om onduidelijke reden op hol te zijn geslagen toen drie koetsiers bij een huifkarbedrijf hun huifkarren (1 eenspan en 2 tweespannen) aan het keren waren om ze klaar te zetten voor een wachtende groep mensen."
                            },
                            {
                                "example_id": "54921412-d008-45e3-872b-83714ef714d6",
                                "sense_id": "58f11f7d-1a4f-3ddd-8ab9-0c56242fae29",
                                "text": "Een koets begon te slingeren, waarop het paard op hol sloeg op een licht dalende landweg. De koetsier kon nog van de bok springen maar de ruiters die voor de koets reden konden het op hol geslagen paard nog moeilijk ontwijken. In een zeer scherpe bocht ging het eenspan rechtdoor."
                            }
                        ]
                    }
