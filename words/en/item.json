                    "sense_id": "78cb1ade-13e8-3e63-9c87-b329dd5d281c",
                    "sense_definition": "A code word representing the letter I, used in older radio communication.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "radio_code",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot used <w>item</w> to spell out his call sign.",
                            "target_lang_translations": {
                                "ru": "Пилот использовал слово <w>Айтем</w>, чтобы продиктовать свой позывной.",
                                "tr": "Pilot, çağrı kodunu kodlamak için <w>item</w> kelimesini kullandı."
                            }
                        },
                        {
                            "text": "In that old manual, <w>item</w> stands for the letter I.",
