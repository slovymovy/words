                        "cross_references": [
                            {
                                "target_word": "символически",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7067b437-2e36-3f99-a8b6-190dbcd871c9",
                                        "entry_id": "b494042f-40cb-3c6e-a1f1-304343ecd98c",
                                        "glosses": [
                                            "свойство по значению прилагательного символический; формально, для вида"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a0f247-bfb0-47d5-9382-005bd61fc55e",
                                                "sense_id": "7067b437-2e36-3f99-a8b6-190dbcd871c9",
                                                "text": "Да, он тоже устал, и теперь ему казалось, что устал он как-то возвышенно, символически, что ли; что он несёт в себе долголетнюю усталость, не только свою, но вековую усталость всех жертв русской истории, всех, кто насильственно прикован к её «каторжной тачке»."
                                            },
                                            {
                                                "example_id": "74d69615-584a-47e1-a77b-eb0b04f0fdc5",
                                                "sense_id": "7067b437-2e36-3f99-a8b6-190dbcd871c9",
                                                "text": "― Спасибо, я не пью, ― и, сняв ладонь, добавил: ― Символически, капельку одну, чтобы чокнуться."
                                            },
                                            {
                                                "example_id": "04cb2502-ad10-48f9-94e0-2fefc4da5ded",
                                                "sense_id": "7067b437-2e36-3f99-a8b6-190dbcd871c9",
                                                "text": "Пришлось мне ещё раз оценить её фигуру, поскольку Каринина фигура была прикрыта символически."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
