                "entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                "word": "Calvin",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "569d5c1f-bbd1-3f5e-a088-c3f934ba505f",
                        "entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                        "glosses": [
                            "A surname from French or Spanish, notably borne by John Calvin, French Protestant theologian."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "debfada0-5c47-3267-b45e-f0b5b967fd90",
                        "entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                        "glosses": [
                            "A male given name transferred from the surname."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "df4d0777-6776-4700-9a36-86dab7091aed",
                                "sense_id": "debfada0-5c47-3267-b45e-f0b5b967fd90",
                                "text": "Marty McFly: Calvin? Wh… Why do you keep calling me Calvin?\nLorraine Baines: Well, that is your name, isn't it? Calvin Klein? It's written all over your underwear."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c0279cd-e6dd-45ef-8844-b7dc8d46af00",
                        "source_entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                        "source_sense_description": "surname",
                        "target_lang_word": "Kalvín",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "dac0ebd8-12c5-4e3e-a6a7-515cc165b349",
                        "source_entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                        "source_sense_description": "surname",
                        "target_lang_word": "Calvijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Calvijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "73a7b374-5378-39e8-bdea-bf7380c21b8e",
                                        "entry_id": "31706fcc-01cc-36aa-b560-d0b279ac1563",
                                        "glosses": [
                                            "Johannes Calvijn, protestants theoloog die in Nederland veel aanhang kreeg, vooral bij fanatieke christenen met een strenge en sombere moraal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6812863-e803-49b7-8740-bcb8db2fd550",
                                                "sense_id": "73a7b374-5378-39e8-bdea-bf7380c21b8e",
                                                "text": "Veel van wat negatief wordt geduid als ‘calvinisme’ – een troosteloos en vreugdeloos geloof waarin het leven slechts één tranendal is onder het wrede oog van een tirannieke God – heeft slechts zeer in de verte iets te maken met Calvijn."
                                            },
                                            {
                                                "example_id": "6f09c283-3e56-4292-a62e-7b0e3e429d71",
                                                "sense_id": "73a7b374-5378-39e8-bdea-bf7380c21b8e",
                                                "text": "De kantoorboterham is zo Nederlands als het regenpak, de vouwfiets en korte vrouwenkapsels. Hij is eenvoudig doch voedzaam en heel erg ‘doe maar gewoon, dan doe je al gek genoeg’ – voor mijn geestesoog zie ik Calvijn, vadertje Cats, Willem Drees en Wim Kok goedkeurend knikken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da973714-9227-478a-b859-64b1451f3211",
                        "source_entry_id": "2afed15d-46cb-37f6-91ac-66d1a283a40d",
                        "source_sense_description": "surname",
                        "target_lang_word": "Calvin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Calvin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42229543-c16d-3eb0-a13e-0bb9912320fe",
                                        "entry_id": "5fb8bf55-d8fd-3a60-8f20-8c9941ee2324",
                                        "glosses": [
                                            "Nom du théologien Jean Calvin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd17306d-e309-4830-91e9-57eb1b684177",
                                                "sense_id": "42229543-c16d-3eb0-a13e-0bb9912320fe",
                                                "text": "Calvin compte quatorze ou quinze saints clous, qu'il prétend que les catholiques reconnaissent pour véritables; mais il en nomme plusieurs dont on n'avait point entendu parler avant lui; […]."
                                            },
                                            {
                                                "example_id": "a8759e60-7b92-44b8-afdc-e9de63fd5608",
                                                "sense_id": "42229543-c16d-3eb0-a13e-0bb9912320fe",
                                                "text": "Néanmoins, Antoine de Crussol n’était pas tellement déhuguenotisé qu’il ne se crût obligé de soumettre à Calvin les scrupules qui l’assaillaient devant l’obligation que lui faisait sa charge de chevalier d’honneur de suivre les processions publiques."
                                            },
                                            {
                                                "example_id": "00f03ae9-3de0-4a6f-8558-9c8ff19531ba",
                                                "sense_id": "42229543-c16d-3eb0-a13e-0bb9912320fe",
                                                "text": "Or rien n’était clair sur ce point. Les catholiques parlaient de transsubstantiation : le pain et le vin devenaient la vraie chair et le vrai sang du Christ. Luther utilisait le mot de consubstantiation : le pain et le vin, sans cesser d’être ces matières profanes, devenaient aussi la chair et le sang du Christ. Mais que disait Calvin ? Il semblait rejeter les idées catholiques, comme luthériennes, sur ce point, nier la présence matérielle du Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fe06ead-46ca-33ac-8ac0-a59d7dc3458d",
                                        "entry_id": "5fb8bf55-d8fd-3a60-8f20-8c9941ee2324",
                                        "glosses": [
                                            "Nom du biochimiste américain Melvin Calvin"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Calvin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4314ca31-54f2-329b-8db3-40454d9393cf",
                                        "entry_id": "929d7d7e-d897-33b8-8260-d9494e0db8d8",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00d2a21e-9486-4e7e-bdec-e02b5be68376",
                                                "sense_id": "4314ca31-54f2-329b-8db3-40454d9393cf",
                                                "text": "Une de nos premières commandes était pour Calvin Klein, avec 15 000 biscuits."
                                            }
