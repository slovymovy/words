                    {
                        "translation_id": "c62019a9-381d-4a20-adb5-0ca40aa92c94",
                        "source_entry_id": "425a9227-0f4a-3862-9132-854f14527cd5",
                        "source_sense_id": "07bd5781-c39e-3271-bebd-6d473aa545d1",
                        "source_sense_description": "muziekinstrument met klokken",
                        "target_lang_word": "carillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Réunion de cloches accordées à différents tons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439fed28-7bb7-41ac-b27a-f8916f755275",
                                                "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                                "text": "Au bruit des fanfares et des carillons, ils s’élancèrent au plein galop les uns contre les autres."
                                            },
                                            {
                                                "example_id": "43ab2700-7497-4c7f-86dc-75ede6b01967",
                                                "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                                "text": "On entendait, de tous côtés, les carillons des vendeurs de sorbet, de pignolats et de lait caillé, les timbales des astrologues en plein vent, les chansons des guzlares aveugles."
                                            },
                                            {
                                                "example_id": "e16f14ef-e9fb-44a9-9f09-ba07b545f3bc",
                                                "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                                "text": "Les cloches grêles du haut carillon, frappées par les obus, ont rendu l’âme."
                                            },
                                            {
                                                "example_id": "0fc70f61-efeb-4d9c-944a-ca4fb3c937c3",
                                                "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                                "text": "Horloge, pendule, montre à carillon : Horloge, pendule, montre qui sonne des airs à certains intervalles."
                                            },
                                            {
                                                "example_id": "3e316ddb-24ae-48a1-b01d-221747992d4a",
                                                "sense_id": "78ce8856-359f-3fdf-81fc-e523730b72f6",
                                                "text": "« Sept heures et demie ! dit Joseph.\n– Elle a sonné au moins quatre fois !\n– Huit coups pour la demie ! reprit-il. C’est un carillon. Quatre coups pour le quart, huit pour la demie, douze pour moins le quart, seize pour l’heure, et naturellement, elle sonne aussi les heures, sur une autre cloche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "170d4ba6-d46a-3ac3-9d53-0bcb73dd7f6c",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Air qu’on exécute sur ces cloches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5be1077-5ed7-4178-82ed-3390b45fd94c",
                                                "sense_id": "170d4ba6-d46a-3ac3-9d53-0bcb73dd7f6c",
                                                "text": "Le carillon de Dunkerque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a94801b6-929d-3242-82a2-d4fe461795d5",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Battement de cloches à coups précipités, avec une sorte de mesure et d’accord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a332573-5fbe-4d32-99b9-f1eadcc10c0a",
                                                "sense_id": "a94801b6-929d-3242-82a2-d4fe461795d5",
                                                "text": "Sonner le carillon. Sonner à double carillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a67f9fd4-5a3f-3933-8d3e-72a7867e0c3f",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Bruit fait par les jets d'un liquide tombant dans un récipient métallique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29535880-5fa6-41e4-a553-ca28604de358",
                                                "sense_id": "a67f9fd4-5a3f-3933-8d3e-72a7867e0c3f",
                                                "text": "À la lueur d’une vieille ampoule électrique la maîtresse vint traire Flora, et le petit carillon du lait dans le seau ne fit pas même ouvrir un œil au dormeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa510b72-4897-33a6-bd49-cf6326f1a48d",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Crierie, grand bruit."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f0ce031-809d-4f8c-a73f-914f67baa13e",
                                                "sense_id": "fa510b72-4897-33a6-bd49-cf6326f1a48d",
                                                "text": "Quand la maîtresse du logis verra ce désordre, elle fera un beau carillon."
                                            },
                                            {
                                                "example_id": "47fcbdb5-d0a4-4249-b72c-63035beeca07",
                                                "sense_id": "fa510b72-4897-33a6-bd49-cf6326f1a48d",
                                                "text": "À Paris, sitôt que j’eus montré le petit carillon qui était en moi, le monde s’y plut, et, peut-être pour mon malheur, je fus engagé à continuer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d5e98e1-594c-3ec1-b938-26de81494eba",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
                                            "Autre nom de la mariette, sorte de campanule."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67feba3d-796d-396d-b825-6bfb1773cab7",
                                        "entry_id": "77a8fd73-60d8-398c-9004-d01ac4a60c50",
                                        "glosses": [
