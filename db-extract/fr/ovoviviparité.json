        "fr-extract.jsonl": [
            {
                "entry_id": "3f6f7e8e-5045-33eb-9ed2-ac0436e69860",
                "word": "ovoviviparité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d5ea1f7-a9e2-4672-a81a-35a7d8a34483",
                        "entry_id": "3f6f7e8e-5045-33eb-9ed2-ac0436e69860",
                        "tags": [
                            "plural"
                        ],
                        "form": "ovoviviparités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcc8c50c-9dbc-3c41-a9b5-c8bdc7c3cafd",
                        "entry_id": "3f6f7e8e-5045-33eb-9ed2-ac0436e69860",
                        "glosses": [
                            "Caractère de ce qui est ovovivipare, c’est-à-dire le fait d’avoir pour une espèce les œufs qui incubent et éclosent dans le ventre de la femelle, sans relation nutritive avec celle-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d7fe773-488d-48c7-b0e3-0ddc7fba8694",
                                "sense_id": "dcc8c50c-9dbc-3c41-a9b5-c8bdc7c3cafd",
                                "text": "L’ovoviviparité est utilisée par de nombreux poissons, des requins, des reptiles et des invertébrés."
                            },
                            {
                                "example_id": "0a9589ed-999d-4435-9177-b98b3ea6b1b3",
                                "sense_id": "dcc8c50c-9dbc-3c41-a9b5-c8bdc7c3cafd",
                                "text": "Dans le cas de l’ovoviviparité, les oeufs sont maintenus à l’intérieur du corps de la mère jusqu’à l’éclosion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e9ad20b-b69f-4b86-8cab-bc9ab3476ff8",
                        "source_entry_id": "3f6f7e8e-5045-33eb-9ed2-ac0436e69860",
                        "source_sense_id": "dcc8c50c-9dbc-3c41-a9b5-c8bdc7c3cafd",
                        "target_lang_word": "ovoviviparity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ovoviviparity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d694fe1-bf45-382d-bbf1-7fbf8fcfe988",
                                        "entry_id": "2e5c4fff-c303-336e-88d9-68e728f9f7c9",
                                        "glosses": [
                                            "The condition of being ovoviviparous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6bf21bf-cf84-4d1f-8bbe-dc3f0cb5493a",
                                                "sense_id": "9d694fe1-bf45-382d-bbf1-7fbf8fcfe988",
                                                "text": "I have not had opportunities of examining any of the animals of this group preserved in spirits, but have found no difficulty in making out the fact of ovoviviparity by macerating the dried animal in cabinet specimens of the shells, when the oviduct in the females, in several species, was found to be filled with young animals with four- to six-whorled shells about one-eighth of an inch in length."
                                            },
                                            {
                                                "example_id": "9f117577-76e4-4a64-b5c9-aa1fb136252f",
                                                "sense_id": "9d694fe1-bf45-382d-bbf1-7fbf8fcfe988",
                                                "text": "[…] the wide dispersal of certain household species, the development of ovoviviparity in several tropical forms and of myrmecophilous and sphegophilous habits in others […]"
                                            },
                                            {
                                                "example_id": "279714ba-d776-43a9-990f-cf9c1525cfbf",
                                                "sense_id": "9d694fe1-bf45-382d-bbf1-7fbf8fcfe988",
                                                "text": "The species with maternal care all fall in the monophyletic subgenus Gonioctena, but while ovoviviparity is also found in these species it also occurs in subgenera lacking maternal care."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
