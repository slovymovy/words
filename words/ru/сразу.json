                        {
                            "text": "Невозможно делать два дела <w>сразу</w>.",
                            "target_lang_translations": {
                                "en": "It is impossible to do two things <w>at once</w>.",
                                "zh": "不可能<w>同时</w>做两件事。",
                                "cs": "Není možné dělat dvě věci <w>najednou</w>.",
                                "nl": "Het is onmogelijk om twee dingen <w>tegelijk</w> te doen.",
                                "pl": "Nie da się robić dwóch rzeczy <w>naraz</w>.",
                                "de": "Es ist unmöglich, zwei Dinge <w>auf einmal</w> zu erledigen.",
                                "fr": "Il est impossible de faire deux choses <w>en même temps</w>.",
                                "it": "È impossibile fare due cose <w>in una volta</w>.",
                                "tr": "İki işi <w>aynı anda</w> yapmak imkansızdır.",
                                "es": "Es imposible hacer dos cosas <w>a la vez</w>."
                            }
                        },
                        {
                            "text": "Он хотел получить всё и <w>сразу</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to get everything <w>at once</w>.",
                                "zh": "他想<w>一次性</w>得到所有东西。",
                                "cs": "Chtěl dostat všechno a <w>najednou</w>.",
                                "nl": "Hij wilde alles <w>tegelijk</w> krijgen.",
                                "pl": "Chciał dostać wszystko i <w>naraz</w>.",
                                "de": "Er wollte alles und <w>auf einmal</w> haben.",
                                "fr": "Il voulait tout avoir <w>tout de suite</w>.",
                                "it": "Voleva ottenere tutto e <w>in un sol colpo</w>.",
                                "tr": "Her şeyi <w>tek seferde</w> elde etmek istedi.",
                                "es": "Él quería conseguirlo todo <w>de golpe</w>."
                            }
                        }
