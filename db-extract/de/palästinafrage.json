                "senses": [
                    {
                        "sense_id": "2edd2cc7-2629-3cbb-9823-bec7df306c9e",
                        "entry_id": "4820f6cc-aa21-3794-8b65-19521f58952b",
                        "glosses": [
                            "Frage um die Zugehörigkeit und den politischen Status von Palästina"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bede1c4-3a98-4322-a634-f8bb6706561d",
                                "sense_id": "2edd2cc7-2629-3cbb-9823-bec7df306c9e",
                                "text": "„Letzten Endes gab London jeglichen Versuch auf, eine Lösung für den drohenden Konflikt zu suchen, und überantwortete die Palästinafrage im Februar 1947 den Vereinten Nationen.“"
                            },
                            {
                                "example_id": "047d9507-6e18-4207-ae7b-bab6caeb8a6c",
                                "sense_id": "2edd2cc7-2629-3cbb-9823-bec7df306c9e",
                                "text": "„Die unverhältnismäßigen israelischen Vergeltungsangriffe auf die arabischen Nachbarstaaten hatten mit zum Ausbruch des Suezkriegs geführt. Seine Entstehung war also unmittelbar mit der Palästinafrage verbunden.“"
                            },
                            {
                                "example_id": "e5da1d71-7c50-4a16-80b6-2816b06e4537",
                                "sense_id": "2edd2cc7-2629-3cbb-9823-bec7df306c9e",
                                "text": "„Die meisten arabischen Staaten, wie auch die PLO, lehnten das Abkommen als ›Separatfrieden‹ ab, weil Ägypten sein Verhältnis zu Israel von der Palästinafrage abkoppelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
