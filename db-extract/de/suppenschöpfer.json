                "senses": [
                    {
                        "sense_id": "5262db2b-e8ae-3cb7-a210-e589dcf0e642",
                        "entry_id": "c636c78d-3c89-3d13-91b6-30ef72fb5c9e",
                        "glosses": [
                            "löffelartiges Küchenwerkzeug, mit dem Suppe (oder andere flüssige Speisen) aus einem großen Gefäß in Suppenteller oder -tassen umgefüllt/portioniert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8bf8ebe-690d-43b4-88c2-44f0ceccc719",
                                "sense_id": "5262db2b-e8ae-3cb7-a210-e589dcf0e642",
                                "text": "„Auf einem Herd stand ein großer Kochtopf, der hundert Suppenschöpfer voll Eintopf oder Suppefasste, in dem ein langstieliger Holzkochlöffel steckte, der aus dem schief aufgelegten Topfdeckelrand herauslugte.“"
                            },
                            {
                                "example_id": "c8ec6b68-99e0-419f-970a-257ad0d3e63a",
                                "sense_id": "5262db2b-e8ae-3cb7-a210-e589dcf0e642",
                                "text": "„Jeweils 2 Esslöffel der Zutaten in eine Pfanne geben und anbraten, einen Suppenschöpfer Pfannkuchenteig darüber gießen und den Deckel auf die Pfanne setzen, dann wenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
