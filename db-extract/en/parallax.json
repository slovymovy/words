                    {
                        "sense_id": "832526f4-0926-3cf8-9e9e-8f09f32c20f4",
                        "entry_id": "1ee18c86-003e-334d-913f-f8b2885ee1ea",
                        "glosses": [
                            "An apparent shift in the position of two stationary objects relative to each other as viewed by an observer, due to a change in observer position."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ef84901-55a9-4ae4-8c85-ba8cedd934e8",
                                "sense_id": "832526f4-0926-3cf8-9e9e-8f09f32c20f4",
                                "text": "[…] Heliocentrick places, to which the Parallaxes being applied, give the Geocentrick."
                            },
                            {
                                "example_id": "6c431558-e160-4313-a50b-aec3b2e22ca2",
                                "sense_id": "832526f4-0926-3cf8-9e9e-8f09f32c20f4",
                                "text": "Planes farther back on the z-axis scroll more slowly than those in front of them, producing a parallax effect. Early games with parallax scrolling tended to have their action taking place all in the forefront plane […]"
                            }
                        ]
                    },
                    {
