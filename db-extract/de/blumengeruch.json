                ],
                "senses": [
                    {
                        "sense_id": "165d20d8-e957-357b-af0e-7cf9e141bb9d",
                        "entry_id": "3f2fe3e2-1d4b-326b-a602-c7af9e126e84",
                        "glosses": [
                            "Geruch, der von Blumen und besonders deren Blüten stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a65ed7-c479-4a14-b651-a964edda0d20",
                                "sense_id": "165d20d8-e957-357b-af0e-7cf9e141bb9d",
                                "text": "„Mit Ausnahme des unnachahmlichen Jasmin, der keine Fälschung zuläßt, sind alle Blumengerüche genau durch Verbindungen mit aromatischem Weingeist und Spiritus darstellbar.“"
                            },
                            {
                                "example_id": "884c06ac-f83a-4a93-aa4e-310f021f411e",
                                "sense_id": "165d20d8-e957-357b-af0e-7cf9e141bb9d",
                                "text": "„Manche Blumengerüche sin freilich so geisterhaft, daß sie sich bis jetzt auf keine Weise einfangen lassen.“"
                            },
                            {
                                "example_id": "c70aa0f9-4885-475b-a970-b260a1fe1931",
                                "sense_id": "165d20d8-e957-357b-af0e-7cf9e141bb9d",
                                "text": "„So können wir Blumengeruch nicht mehr wahrnehmen, sobald das Gehirn den scharfen Geruch von Säure wahrnimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
