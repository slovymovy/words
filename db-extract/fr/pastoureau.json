                ],
                "senses": [
                    {
                        "sense_id": "cae0576d-85ea-34b5-8c7b-4a1ceec5bdb5",
                        "entry_id": "0cc4bfdb-7f41-3763-a087-763d22064dfa",
                        "glosses": [
                            "Jeune pasteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4aeb2769-62ab-4a43-8381-3bee1ec33eda",
                                "sense_id": "cae0576d-85ea-34b5-8c7b-4a1ceec5bdb5",
                                "text": "J'entends autrement mieux la vie que le sieur Pliouchkine, par exemple : voilà un bonhomme qui possède huit cents âmes et mange plus mal que mon pastoureau."
                            }
                        ]
                    },
                    {
                        "sense_id": "481b48d0-a7f9-3b46-bc05-e5f68037a6e6",
                        "entry_id": "0cc4bfdb-7f41-3763-a087-763d22064dfa",
                        "glosses": [
                            "Synonyme de géorgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed9c78ca-b881-42d7-ae52-fcc687a2a4d6",
                                "sense_id": "481b48d0-a7f9-3b46-bc05-e5f68037a6e6",
                                "text": "Les pastourelles d’Adam de la Halle."
                            }
                        ]
                    },
                    {
                        "sense_id": "fbe13344-cff7-3a1e-9abc-93608d673b8a",
                        "entry_id": "0cc4bfdb-7f41-3763-a087-763d22064dfa",
                        "glosses": [
                            "Membre d'une des troupes de serfs ou de vilains, révoltés, qui parcoururent la France du Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e820a26-a793-4668-b05e-1b906f0faf70",
                                "sense_id": "fbe13344-cff7-3a1e-9abc-93608d673b8a",
                                "text": "Lorsque la troupe des pastoureaux entra dans Orléans, le jour de saint Barnabas, l'évêque de cette ville interdit à tous ses clercs d'assister à ses prédications ; car, disait-il, ce sont les souricières du diable. Quant aux laïques, ils méprisaient déjà les ordres et les menaces du prélat, et c'étaient eux qui, en dépit de son autorité avaient ouvert la porte aux pastoureaux."
                            },
                            {
                                "example_id": "140b7720-b687-4439-a64a-b625bdce9df6",
                                "sense_id": "fbe13344-cff7-3a1e-9abc-93608d673b8a",
                                "text": "Les pastoureaux étaient encore assis, comme le matin, au bord de la fontaine."
                            }
                        ]
                    }
                ],
