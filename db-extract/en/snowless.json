                                            {
                                                "example_id": "22ca6c1e-c590-48d9-8486-b257107e2e8c",
                                                "sense_id": "c8cce5fc-b1c3-318e-bf78-d1ea4d5ea337",
                                                "text": "Durch den Sonnenbrand war die Südwand der Bergketten schon aper."
                                            },
                                            {
                                                "example_id": "3bed0ec0-b049-4dca-912c-ba98e3900086",
                                                "sense_id": "c8cce5fc-b1c3-318e-bf78-d1ea4d5ea337",
                                                "text": "Die Pisten lagen bloß, aper, wie es im Alpin-Jargon heißt."
                                            },
                                            {
                                                "example_id": "f28e3c72-2d38-4532-a1a7-c6e83329782a",
                                                "sense_id": "c8cce5fc-b1c3-318e-bf78-d1ea4d5ea337",
                                                "text": "Ringsum alles aper, kein Skimensch weit und breit „Sauber, sog i\", sagte der Bayer."
                                            },
                                            {
                                                "example_id": "319998ff-d94c-4fef-b9eb-355c3a7f436e",
                                                "sense_id": "c8cce5fc-b1c3-318e-bf78-d1ea4d5ea337",
                                                "text": "Denn sind Almen und Berge im späten Frühling endlich aper, bleibt die Luft hier auf 1500 Metern immer ein wenig kühler und reiner, die Natur ein wenig unberührter als unten im Tal."
                                            },
                                            {
                                                "example_id": "f4d1ea16-6d93-4493-bac7-95c5042ed8c0",
                                                "sense_id": "c8cce5fc-b1c3-318e-bf78-d1ea4d5ea337",
                                                "text": "Problematisch sei aber, dass etwa CNN anlässlich der abgesagten Weltcuprennen Bilder von den aperen Alpen in alle Welt sendet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
