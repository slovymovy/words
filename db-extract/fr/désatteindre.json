                ],
                "senses": [
                    {
                        "sense_id": "b83861ea-8df8-322e-a0d2-4c8e0eb96c48",
                        "entry_id": "b247fccc-288a-308a-b3d2-ce643bda4882",
                        "glosses": [
                            "Ne plus atteindre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91659c12-d327-4ca6-927f-b63fca1649f0",
                                "sense_id": "b83861ea-8df8-322e-a0d2-4c8e0eb96c48",
                                "text": "Rester soi-même tout en étant conscient, défabriquer, déconstruire, dissiper, dévoiler, découvrir, ôter, balayer, taiser, revenir, désobtenir, désatteindre, sans effort, dans le laisser être."
                            },
                            {
                                "example_id": "b6ad4940-e172-4ba7-9436-78486a379765",
                                "sense_id": "b83861ea-8df8-322e-a0d2-4c8e0eb96c48",
                                "text": "Après avoir atteint et désatteint les 1k plusieurs fois, je me lance enfin !"
                            },
                            {
                                "example_id": "62c32557-2756-449b-b27d-bf055f1e15f1",
                                "sense_id": "b83861ea-8df8-322e-a0d2-4c8e0eb96c48",
                                "text": "À moins que tu ne sois « désatteinte » depuis?"
                            },
                            {
                                "example_id": "dd4e73a2-18bd-43d8-9972-761818d010da",
                                "sense_id": "b83861ea-8df8-322e-a0d2-4c8e0eb96c48",
                                "text": "Mots soudain étrangers au métier de la langue, sans argument ni agrément, déchus de pratique ou prestige, que leur seule usure éclaire et garantit… pour la justesse d'un rapport, plutôt que vérité ? laquelle vaut souvent d'abord par qui elle perd… une phrase ayant semé sa direction, peu à peu désatteinte, et que sa cible n'obnubile plus, chômeuse, découvre la stupeur d'un mot vacant prenant visage provisoire à l'espace envoûtant : (…)"
                            }
                        ]
                    }
                ],
