                        "glosses": [
                            "Rendre mélenchonien ; convertir, rallier quelqu’un au programme, aux idées de Jean-Luc Mélenchon."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a76b812a-8689-392b-ba04-7839ca7f4b24",
                        "entry_id": "6c6c7c4e-4524-3231-9bb1-60fb3f55245e",
                        "glosses": [
                            "Devenir mélenchonien ou mélenchoniste ; se rallier au programme, aux idées de Jean-Luc Mélenchon."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "b064fe0b-2850-4571-9dd0-7ff2c89b9da9",
                                "sense_id": "a76b812a-8689-392b-ba04-7839ca7f4b24",
                                "text": "Je n’ai pas les moyens de me « ségonéliser » et je doute qu’elle se « mélenchonise » », rit-il."
                            },
                            {
                                "example_id": "c9d2b95b-d915-480f-bbac-75afcf17fb76",
                                "sense_id": "a76b812a-8689-392b-ba04-7839ca7f4b24",
                                "text": "Ne pas se « mélenchoniser »."
                            },
                            {
                                "example_id": "73f3f569-e625-4bd6-9f30-17d46fc190c3",
                                "sense_id": "a76b812a-8689-392b-ba04-7839ca7f4b24",
                                "text": "Dans 2 mandats, il finira de se « mélenchoniser » !"
                            }
                        ]
                    }
