{
    "word_family": [
        "reflet"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6de18bf-2311-3b95-a55b-975bfba325a9",
                    "sense_definition": "Renvoyer l'image, la lumière ou la couleur d'un corps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "optique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La surface calme du lac <w>reflète</w> la lumière éclatante du soleil levant."
                        },
                        {
                            "text": "Les grands arbres au bord de l'eau se <w>reflètent</w> avec une netteté impressionnante."
                        }
                    ],
                    "synonyms": [
                        "réfléchir"
                    ],
                    "common_phrases": [
                        "refléter la lumière",
                        "se refléter dans l'eau"
                    ]
                },
                {
                    "sense_id": "441c46fa-8866-37f3-a1a1-cc94a0bc3286",
                    "sense_definition": "Être l'expression fidèle ou la correspondance directe de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les statistiques publiées ce matin ne <w>reflètent</w> pas fidèlement la réalité économique actuelle."
                        },
                        {
                            "text": "Ce nouveau roman captivant <w>reflète</w> les changements profonds observés dans notre société moderne."
                        }
                    ],
                    "synonyms": [
                        "illustrer",
                        "indiquer"
                    ],
                    "common_phrases": [
                        "refléter la réalité",
                        "refléter l'opinion générale"
                    ]
                },
                {
                    "sense_id": "1aa8dfce-c9ea-3af9-8641-b16a139660eb",
                    "sense_definition": "Laisser paraître, rendre visible un sentiment ou un état intérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses yeux fatigués <w>reflètent</w> une tristesse immense qu'il tente de cacher à ses amis."
                        },
                        {
                            "text": "L'enthousiasme général de l'équipe se <w>reflétait</w> clairement sur les visages lors de la réunion."
                        }
                    ],
                    "synonyms": [
                        "exprimer",
                        "montrer",
                        "révéler"
                    ],
                    "common_phrases": [
                        "refléter une émotion",
                        "se refléter sur le visage"
                    ]
                }
            ]
        }
    ]
}