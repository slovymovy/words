                                        "glosses": [
                                            "der Lehre, den Grundsätzen des Marxismus entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbd501b8-15dc-4573-92dc-97fce350b5a1",
                                                "sense_id": "ac4cf978-ef13-3a6c-b20b-5d9fc16278bd",
                                                "text": "Die marxistische Theorie beinhaltet ein interessantes Menschenbild."
                                            },
                                            {
                                                "example_id": "ed1de8d0-fb9c-444d-88c4-dbe24fade6f8",
                                                "sense_id": "ac4cf978-ef13-3a6c-b20b-5d9fc16278bd",
                                                "text": "„Castro war zunächst eher national-kubanisch als marxistisch orientiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
