                        "glosses": [
                            "een mooi, luxe, feestelijk omhulsel waarin een product verpakt zit dat men als geschenk wil geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "507e91b7-a28c-4c33-b5e7-96c7e9c065bf",
                                "sense_id": "7dd71867-86cd-3725-aefd-584966715e41",
                                "text": "In de coulissen van het theater staat een levensgrote cadeauverpakking, waarvan de inhoud vanmiddag tijdens de show wordt bekendgemaakt. \"Daarin zit het extra baasje van Samson\", vertelt Verhulst."
                            },
                            {
                                "example_id": "052efc45-8a8e-4c29-8891-6b79af71dafe",
                                "sense_id": "7dd71867-86cd-3725-aefd-584966715e41",
                                "text": "Met de kerstdagen is een speciaal programma te zien onder de titel 'Kerst in cadeauverpakking.'"
                            },
                            {
                                "example_id": "045385c2-2d99-4f76-950f-02074a5a0027",
                                "sense_id": "7dd71867-86cd-3725-aefd-584966715e41",
                                "text": "De douane op het vliegveld van Manilla op de Filipijnen keek raar op toen een postzending uit Polen nader werd bekeken. In de doosjes met koekjes en havermout in cadeauverpakking zaten namelijk honderden levende tarantula's."
                            }
                        ]
                    }
