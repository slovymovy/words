                        "glosses": [
                            "группа овец с недавно рожденными ягнятами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bf1fb4-f9e2-46e1-8064-c4f635a48a68",
                                "sense_id": "8b354044-4228-39a2-8cf1-14ae8f1c8beb",
                                "text": "Сакман бросить нельзя, и ему пришло в голову пригласить к себе пасти сакман кого-либо из тех грушовских ребят."
                            }
                        ]
                    },
                    {
                        "sense_id": "84c279f6-b1da-39e6-90d5-3841264ab4c0",
                        "entry_id": "037c0a3d-6876-3f4f-95ae-496298d1df74",
                        "glosses": [
                            "окот у овец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5b99e73-1b88-4433-89f0-d6abca77ecbd",
                                "sense_id": "84c279f6-b1da-39e6-90d5-3841264ab4c0",
                                "text": "Подходит окот, или, по-нашему, сакман, стрижка ― людей только дай!"
                            }
                        ]
                    }
