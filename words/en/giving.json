    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "438dedc5-19be-3059-9a5b-4f0b2588f594",
                    "sense_definition": "present participle and gerund of <w>give</w>",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "give_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>giving</w> her friend a birthday present when I arrived.",
                            "target_lang_translations": {
                                "ru": "Она как раз <w>дарила</w> подруге подарок на день рождения, когда я пришел."
                            }
                        },
                        {
                            "text": "Thank you for <w>giving</w> us such a warm welcome to your home.",
                            "target_lang_translations": {
                                "ru": "Спасибо за то, что <w>оказали</w> нам такой теплый прием в вашем доме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "giving advice",
                        "giving directions"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола give (давать, дарить, предоставлять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать",
                                "target_lang_sense_clarification": "процесс передачи или предоставления"
                            },
                            {
                                "target_lang_word": "дарящий",
                                "target_lang_sense_clarification": "причастие: вручающий подарок"
                            },
                            {
                                "target_lang_word": "давая",
                                "target_lang_sense_clarification": "деепричастие: передавая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54868345-9e27-3d60-9cfa-52a797b6befb",
                    "sense_definition": "Evoking or giving off a certain vibe, look, or aesthetic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vibe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her bright outfit is definitely <w>giving</w> summer vacation vibes.",
                            "target_lang_translations": {
                                "ru": "Ее яркий наряд определенно <w>излучает</w> атмосферу летнего отпуска."
                            }
                        },
                        {
                            "text": "The vintage furniture in this room is <w>giving</w> old Hollywood glamour.",
                            "target_lang_translations": {
                                "ru": "Винтажная мебель в этой комнате прямо <w>отдает</w> гламуром старого Голливуда."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal Internet and youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать определенное впечатление, излучать вайб или напоминать определенный стиль (сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излучать вайб",
                                "target_lang_sense_clarification": "сленг: создавать определенную атмосферу"
                            },
                            {
                                "target_lang_word": "напоминать",
                                "target_lang_sense_clarification": "сленг: вызывать ассоциацию со стилем или образом"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "разг.: иметь оттенок или дух чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "265a109b-6be7-34f2-a07a-c94264dee4ad",
                    "sense_definition": "Looking exceptionally stylish, impressive, or stunning.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vibe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone looked at her new hairstyle and agreed it was really <w>giving</w>.",
                            "target_lang_translations": {
                                "ru": "Все посмотрели на ее новую прическу и согласились, что это просто <w>огонь</w>."
                            }
                        },
                        {
                            "text": "Your whole outfit is <w>giving</w> tonight and I love it.",
                            "target_lang_translations": {
                                "ru": "Весь твой наряд сегодня вечером просто <w>потрясающий</w>, мне очень нравится."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal Internet and youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выглядеть потрясающе, стильно, производить сильное впечатление (молодежный сленг)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть огонь",
                                "target_lang_sense_clarification": "сленг: выглядеть потрясающе"
                            },
                            {
                                "target_lang_word": "раздавать стиль",
                                "target_lang_sense_clarification": "сленг: смотреться эффектно"
                            },
                            {
                                "target_lang_word": "впечатлять",
                                "target_lang_sense_clarification": "производить сильный вау-эффект"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d3a0f6a-e37c-3c5a-9ff9-0082691ae700",
                    "sense_definition": "Inclined to give; generous, caring, and unselfish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "generous",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was a loving and <w>giving</w> person who always thought of others first.",
                            "target_lang_translations": {
                                "ru": "Она была любящим и <w>щедрым</w> человеком, который всегда думал о других в первую очередь."
                            }
                        },
                        {
                            "text": "His <w>giving</w> nature made him beloved throughout the entire community.",
                            "target_lang_translations": {
                                "ru": "Его <w>бескорыстная</w> натура снискала ему любовь всего сообщества."
                            }
                        }
                    ],
                    "synonyms": [
                        "generous",
                        "charitable",
                        "benevolent"
                    ],
                    "antonyms": [
                        "selfish",
                        "stingy"
                    ],
                    "common_phrases": [
                        "giving nature",
                        "giving person"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный отдавать; щедрый, отзывчивый, бескорыстный и заботливый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щедрый",
                                "target_lang_sense_clarification": "охотно делящийся с другими"
                            },
                            {
                                "target_lang_word": "отзывчивый",
                                "target_lang_sense_clarification": "готовый помочь и позаботиться"
                            },
                            {
                                "target_lang_word": "бескорыстный",
                                "target_lang_sense_clarification": "чуждый эгоизма, отдающий другим"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "caabba1a-4b15-321d-9305-ce2fee58b531",
