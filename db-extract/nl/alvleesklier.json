                "translations": [
                    {
                        "translation_id": "73dca854-20a9-42a3-b01f-91b379f9f8bc",
                        "source_entry_id": "27a7a803-f523-32df-99eb-aa3b01de322c",
                        "source_sense_id": "046d6563-f61c-3a4e-bf2d-0f1921769b1f",
                        "source_sense_description": "een klier die enzymen afscheidt in de twaalfvingerige darm om de afbraak van zetmeel, vet en eiwitten te bevorderen",
                        "target_lang_word": "Bauchspeicheldrüse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchspeicheldrüse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                        "entry_id": "7fb5ea63-2e93-3068-ab85-0fca14e35d21",
                                        "glosses": [
                                            "exokrine, Verdauungsenzyme produzierende, dem Stoffwechsel dienende und endokrine, zur Regulation des Glukosehaushaltes Hormone ausschüttende Drüse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c688483-db88-40b1-a9af-2596aff77752",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Die Bauchspeicheldrüse produziert während der Liebkosung verstärkt Insulin und die Nebenniere Adrenalin.“"
                                            },
                                            {
                                                "example_id": "6ed5bd7f-71f4-4eb0-9cb1-0cbb6f4b408d",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Die Nebennieren produzieren mehr Adrenalin und die Bauchspeicheldrüse mehr Insulin.“"
                                            },
                                            {
                                                "example_id": "c2a05661-9768-420a-bb12-17f40c7acd96",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Krebs der Bauchspeicheldrüse hat eine ungemein schlechte Prognose.“"
                                            },
                                            {
                                                "example_id": "ace995ce-f779-4b83-a2ee-ca8eb0835419",
                                                "sense_id": "f3e424b0-d037-361c-806e-ad251849820d",
                                                "text": "„Trotzdem hatte im 17. Jahrhundert Decker zwanzig Dekaliter pro Tag verordnet, um den Sumpf der Bauchspeicheldrüse zu reinigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a158ebfd-3225-418e-9605-a2569ce1c415",
                        "source_entry_id": "27a7a803-f523-32df-99eb-aa3b01de322c",
                        "source_sense_id": "046d6563-f61c-3a4e-bf2d-0f1921769b1f",
                        "source_sense_description": "een klier die enzymen afscheidt in de twaalfvingerige darm om de afbraak van zetmeel, vet en eiwitten te bevorderen",
                        "target_lang_word": "Pankreas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pankreas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                        "entry_id": "ea086a87-d1af-3db4-8712-9cedd33526b3",
                                        "glosses": [
                                            "exokrine, Verdauungsenzyme produzierende, dem Stoffwechsel dienende und endokrine, zur Regulation des Glukosehaushaltes Hormone ausschüttende Drüse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6d7c21c-5651-4b16-9f3c-74719ba81649",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Das Pankreas ist 80-120 g schwer und ca. 20 cm lang."
                                            },
                                            {
                                                "example_id": "94728e96-07a7-44b3-a21c-f512d6594603",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Merke: Das Pankreas gliedert sich in Kopf (mit Processus uncinatus), Körper und Schwanz. Der Schwanz \"leckt am Milz-Hilum\"."
                                            },
                                            {
                                                "example_id": "07dda4e7-b5ea-432a-9f48-2795159afdcf",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Eine häufige Erkrankung des Pankreas ist der Diabetes mellitus, gefolgt von Pankreatitis, Pankreaskarzinom und Mukoviszidose."
                                            },
                                            {
                                                "example_id": "447e78d6-f398-454b-9209-f9c1509a7e20",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Tatsächlich zeigten die Mäuse ohne funktionierendes p16 zwar im Alter vergleichsweise muntere Zellen in Pankreas, Knochenmark und Hirn, litten und starben aber viel häufiger an Krebs."
                                            },
                                            {
                                                "example_id": "8547e202-d8fb-4af6-8dc3-37e2111e685a",
                                                "sense_id": "7368e9a6-bee5-3278-9c5b-db057d54d07c",
                                                "text": "Von allen Krebserkrankungen an der Bauchspeicheldrüse (Pankreas) könnten nur 20 Prozent operiert werden, und von diesen Patienten wiederum lebten fünf Jahre später nur noch 20 Prozent, erklärte Issels."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bf80054-c3af-4d50-8170-858b0327ad9f",
                        "source_entry_id": "27a7a803-f523-32df-99eb-aa3b01de322c",
                        "source_sense_id": "046d6563-f61c-3a4e-bf2d-0f1921769b1f",
                        "source_sense_description": "een klier die enzymen afscheidt in de twaalfvingerige darm om de afbraak van zetmeel, vet en eiwitten te bevorderen",
                        "target_lang_word": "pancreas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pancreas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f20eee-c049-3390-b998-88e60279397d",
                                        "entry_id": "9d2a4d25-930d-3dda-be9b-b6f181c8ae04",
                                        "glosses": [
                                            "A gland near the stomach which secretes a fluid into the duodenum to assist with food digestion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf15642-df31-429e-aa05-8529822c26e6",
                                                "sense_id": "25f20eee-c049-3390-b998-88e60279397d",
                                                "text": "Chronic pancreatitis is a condition in which the pancreas is inflamed or swells for an extended period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f49c0a26-7f20-4bf2-885c-4214e2afeec9",
                        "source_entry_id": "27a7a803-f523-32df-99eb-aa3b01de322c",
                        "source_sense_id": "046d6563-f61c-3a4e-bf2d-0f1921769b1f",
                        "source_sense_description": "een klier die enzymen afscheidt in de twaalfvingerige darm om de afbraak van zetmeel, vet en eiwitten te bevorderen",
                        "target_lang_word": "pancréas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pancréas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24fa61d4-a6a3-31b7-a802-2c10805f5d23",
                                        "entry_id": "267212aa-3b8a-39a0-aa29-f6c45e4975af",
                                        "glosses": [
                                            "Glande abdominale mixte, à la fois exocrine (produisant un suc digestif riche en enzymes pour la digestion des lipides, glucides et protéines) et endocrine (sécrétant des hormones comme l’insuline), dont le suc s’écoule dans le duodénum."
                                        ],
                                        "tags": [
                                            "Gastro-entérologie",
                                            "Endocrinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa6637ca-3cb1-4579-b179-aec899e4b0fa",
                                                "sense_id": "24fa61d4-a6a3-31b7-a802-2c10805f5d23",
                                                "text": "Le pancréas a deux fonctions essentielles : le pancréas endocrine est le régulateur hormonal essentiel du taux de sucre dans le sang, le pancréas exocrine est un co-acteur puissant de la digestion, en particulier des graisses."
                                            },
                                            {
                                                "example_id": "35cdf8ac-36c7-45ef-a45c-507d8cd1fcb5",
                                                "sense_id": "24fa61d4-a6a3-31b7-a802-2c10805f5d23",
                                                "text": "Des expériences analogues ont démontré ultérieurement que les nerfs vagues renferment également des nerfs sécréteurs innervant le pancréas."
                                            },
                                            {
                                                "example_id": "61b0376e-906b-4f89-b498-14e19e8f5c94",
                                                "sense_id": "24fa61d4-a6a3-31b7-a802-2c10805f5d23",
                                                "text": "Je ne sais plus exactement à quel moment nous avons appris que Liane avait un cancer du pancréas et qu’il ne lui restait que quelques mois à vivre."
                                            },
                                            {
                                                "example_id": "0516be03-0360-44ea-8373-75aeca2cc885",
                                                "sense_id": "24fa61d4-a6a3-31b7-a802-2c10805f5d23",
                                                "text": "En 2017, la survie la plus élevée chez les personnes atteintes de cancer était constatée pour les cancers de la thyroïde et du testicule, alors que la plus faible était pour le cancer du pancréas et le mésothéliome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
