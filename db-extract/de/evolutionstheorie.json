                        "form": "die Evolutionstheorie"
                    },
                    {
                        "form_id": "4f5ddd4d-85a2-4eb7-b5da-204eeee6d609",
                        "entry_id": "7d843e14-6d6f-32b8-b0dc-ad79206d64b2",
                        "tags": [
