                ],
                "senses": [
                    {
                        "sense_id": "afabddd4-6eae-3dc8-832a-dce67d629cef",
                        "entry_id": "d7155870-2f17-38ae-89a7-336ffc931655",
                        "glosses": [
                            "Qui est étranger à la morale, qui ne l’attaque ni ne la défend, qui se place en dehors d’elle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223d5597-a5ff-4b9f-a16e-b22d7ade0c30",
                                "sense_id": "afabddd4-6eae-3dc8-832a-dce67d629cef",
                                "text": "L’alcoolique est toujours immoral ou amoral ; mais, en dehors des alcooliques, il y a beaucoup d’amoraux, beaucoup d’êtres qui naissent amputés du sens moral."
                            },
                            {
                                "example_id": "cc95a90c-667d-4c5b-872f-514684044ca7",
                                "sense_id": "afabddd4-6eae-3dc8-832a-dce67d629cef",
                                "text": "Ce roman est amoral plutôt qu’immoral."
                            },
                            {
                                "example_id": "76359e34-a8d4-48b4-93f2-d6618897ae14",
                                "sense_id": "afabddd4-6eae-3dc8-832a-dce67d629cef",
                                "text": "Donald Trump correspond exactement à cette définition. (...). C’est aussi un être non pas immoral, mais amoral, car sa seule référence en termes de bien ou de mal est sa propre personne."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff04ddeb-6b8d-308d-8bd8-90337bcd9c5e",
                        "entry_id": "d7155870-2f17-38ae-89a7-336ffc931655",
                        "glosses": [
                            "Qui est neutre par son refus de porter un jugement sur la nature morale ou immorale d’un fait."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4d8439a-5656-42f5-80dd-7942cd4e0ca9",
                        "source_entry_id": "d7155870-2f17-38ae-89a7-336ffc931655",
