                    {
                        "sense_id": "60c073ec-f6a0-3d59-876d-92b3773c2ccf",
                        "entry_id": "549d70f0-2e9c-3fc5-a58f-d4cc6088d85c",
                        "glosses": [
                            "etwas, das eine Trennung markiert oder bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad67c67a-7ba0-4195-9e3c-3e383d6fa969",
                                "sense_id": "60c073ec-f6a0-3d59-876d-92b3773c2ccf",
                                "text": "„Und wieder empfand sie erschrocken, dass es eigentlich gar keine Scheidewand mehr zwischen ihnen gab.“"
                            },
                            {
                                "example_id": "df6a4bae-1d4d-42d3-b124-307b3c9c3952",
                                "sense_id": "60c073ec-f6a0-3d59-876d-92b3773c2ccf",
                                "text": "„Die Mauern waren bis auf eine eingestürzt. Dies war eine nicht sehr starke Scheidewand, ungefähr aus der Mitte des Hauses, an der das Kopfende meines Bettes gestanden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
