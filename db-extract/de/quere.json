                        "form": "die Quere"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12439d05-1ea8-351d-ab75-783e1d30e9b4",
                        "entry_id": "a75a9628-3c3c-366e-9750-8c1c299f6e43",
                        "glosses": [
                            "Lage/Verlauf, wobei der Verlauf von etwas anderem geschnitten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c30bc9-f5d1-4c29-9f3d-3992b2db2100",
                                "sense_id": "12439d05-1ea8-351d-ab75-783e1d30e9b4",
                                "text": "„Der Gedanke, diese mächtigen Aufstellungen willkürlich der Quere nach durchschnitten zu haben, erhöhte das Gefühl der Einsamkeit auf eine nicht unangenehme Art.“"
                            },
                            {
                                "example_id": "e5c4354b-b4e7-43fe-ac30-f97e125ee727",
                                "sense_id": "12439d05-1ea8-351d-ab75-783e1d30e9b4",
                                "text": "„Auf der Fahrt zur Kneipe erzählte der Taxifahrer, dass sich die Kranführer morgens absprechen müssen, damit sich die Katzausleger nicht in die Quere kommen.“"
                            },
                            {
                                "example_id": "171d8e95-b12a-431d-9df8-e6749e1967c5",
                                "sense_id": "12439d05-1ea8-351d-ab75-783e1d30e9b4",
                                "text": "„Viele Männer hatten sich untergehakt, drängten breit gegen andere Ketten und rempelten jeden an, der ihnen in die Quere kam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
