                                        "glosses": [
                                            "A type of leather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b92166e-72b5-493d-9431-38e7832b0b60",
                                                "sense_id": "6c6e73cd-ea7f-35db-84d4-a492002552f9",
                                                "text": "[I]t was bound by G. Levitsky […] in turquoise Levant, stamped back and front with the Crosby crest in gold."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7e1793b-7f49-4c3f-bbdd-60e10bbec532",
