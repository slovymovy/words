                    {
                        "translation_id": "9530bdf6-35a4-4e2f-b9fc-d18ca095db7e",
                        "source_entry_id": "731d0664-d44a-3954-9846-68faa95e7330",
                        "source_sense_id": "b42293b4-6412-341b-a49b-d1ef63903ea5",
                        "source_sense_description": "gedeelte van het Afrikaanse continent ten noorden van de Sahara",
                        "target_lang_word": "Afrique du Nord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrique du Nord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a37680f5-bd9f-3c42-b605-8e7cd7d46709",
                                        "entry_id": "69682a87-ba64-33aa-bff5-cd19e53f26c3",
                                        "glosses": [
                                            "Partie nord du continent africain s’étendant du rivage de la Méditerranée jusqu’au sud du désert du Sahara."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0b0fefe-5887-4ce4-89f6-830380705b14",
                                                "sense_id": "a37680f5-bd9f-3c42-b605-8e7cd7d46709",
                                                "text": "Le Sahara constitue une barrière entre l’Afrique du Nord qui utilise la charrue et l’Afrique Noire, domaine de la houe."
                                            },
                                            {
                                                "example_id": "a1d33b14-9c41-49c3-821c-3e863ee65cbb",
                                                "sense_id": "a37680f5-bd9f-3c42-b605-8e7cd7d46709",
                                                "text": "Dans le midi français, le chêne kermès est connu comme un nanophanérophyte, mais en Afrique du Nord il est fréquemment macrophanérophyte, atteignant jusqu’à 10-12 mètres de haut."
                                            },
                                            {
                                                "example_id": "2c06dcc0-226f-4db7-9a88-930a322298f1",
                                                "sense_id": "a37680f5-bd9f-3c42-b605-8e7cd7d46709",
                                                "text": "Pour les autres Arabes du Croissant fertile et de l’Afrique du Nord, cependant, s’il devait être adopté, l’État-Nation devait être nationaliste, c’est-à-dire radical, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "505a0bbc-4bd0-3441-ad4a-bba3aca3d656",
                                        "entry_id": "69682a87-ba64-33aa-bff5-cd19e53f26c3",
                                        "glosses": [
                                            "Pays approximativement inclus dans cette zone, incluant la Mauritanie, le Maroc, l'Algérie, la Tunisie, la Libye, l’Égypte et le Soudan selon le classement en sous-régions de l’Organisation des Nations unies."
                                        ],
                                        "tags": [
                                            "Géographie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75da2eb4-9286-4e94-aae2-7a1d6517a11d",
                                                "sense_id": "505a0bbc-4bd0-3441-ad4a-bba3aca3d656",
                                                "text": "C’est là un trait qui distingue les pays d’Afrique du Nord des autres pays d’outre-mer et qui témoigne de leur maturité économique plus avancée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
