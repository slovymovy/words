                    "sense_id": "917e2445-987c-38ca-bf7a-6fe0235de2cf",
                    "sense_definition": "op een hogere plaats dan iets anders, zonder het aan te raken",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "locatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schilderij hangt precies <w>boven</w> de bank in de woonkamer.",
                            "target_lang_translations": {
                                "en": "The painting hangs exactly <w>above</w> the sofa in the living room.",
                                "ru": "Картина висит прямо <w>над</w> диваном в гостиной."
                            }
                        },
                        {
                            "text": "Het vliegtuig vloog hoog <w>boven</w> de wolken in de blauwe lucht.",
                            "target_lang_translations": {
                                "en": "The plane flew high <w>above</w> the clouds in the blue sky.",
                                "ru": "Самолет летел высоко <w>над</w> облаками в синем небе."
                            }
                        }
                    ],
                    "antonyms": [
                        "onder"
                    ],
                    "common_phrases": [
                        "vlak boven de grond",
                        "hoog boven de stad"
                    ],
                    "target_lang_definitions": {
                        "en": "at a higher place than something else, without touching it",
                        "ru": "на более высоком месте, чем что-либо другое, не касаясь этого"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "above",
                                "target_lang_sense_clarification": "physically higher than"
                            },
                            {
                                "target_lang_word": "over",
                                "target_lang_sense_clarification": "directly above"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "над",
                                "target_lang_sense_clarification": "предлог, указывающий на положение выше чего-либо"
                            },
                            {
                                "target_lang_word": "выше",
                                "target_lang_sense_clarification": "по сравнению с чем-либо"
                            }
                        ]
                    }
                }
            ]
