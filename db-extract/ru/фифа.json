                    {
                        "translation_id": "fd6ffbf2-b387-480c-bed4-dcd5a4bfbe21",
                        "source_entry_id": "ff83ef0d-d757-3cb0-a1f9-35f963e96635",
                        "source_sense_id": "deddbeff-f12f-340a-a18c-30927c22c8eb",
                        "target_lang_word": "élégante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élégante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                                        "entry_id": "4e2f7626-6790-3389-99f6-c0cf22699df5",
                                        "glosses": [
                                            "Celle qui affecte l’élégance dans sa toilette et dans ses manières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f9cfae-33a4-4ad1-a330-b44174b57db1",
                                                "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                                                "text": "À cette époque, le Jardin Turc fut le rendez-vous des élégants et élégantes du Marais, du faubourg Saint-Antoine et lieux circonvoisins."
                                            },
                                            {
                                                "example_id": "64e98f71-68fa-4e7d-a4a5-fb47ff24cb74",
                                                "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                                                "text": "Dans la Rome du Iᵉʳ siècle , les élégantes de la société aisée étaient très friandes des objets exotiques de luxe, et tout particulièrement des étoffes de soie, dont l’origine unique était le lieu appelé par les Romains pays de Sèvres, c’est-à-dire la Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7274732-64c8-351d-97d6-37c40dd65b80",
                                        "entry_id": "4e2f7626-6790-3389-99f6-c0cf22699df5",
                                        "glosses": [
                                            "Autre nom donné au cyclostome élégant (Pomatias elegans)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2847a027-7dfc-49f4-8fe9-c57304c9c938",
                                                "sense_id": "f7274732-64c8-351d-97d6-37c40dd65b80",
                                                "text": "Le cyclostome élégant est appelé également élégante striée (Pomatia elegans)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "élégante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33a97567-59d0-321a-8b38-bfc8c62ae881",
                                        "entry_id": "28c20e2d-f311-320c-9a15-279f51682076",
                                        "glosses": [
                                            "Féminin singulier de élégant."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f7a4f3-4537-4893-b58d-8692c16a7c9f",
                                                "sense_id": "33a97567-59d0-321a-8b38-bfc8c62ae881",
                                                "text": "Je fus bien imprévoyant en sollicitant cette lettre où vous commencez à dérouler l’élégante rubannerie de vos idées."
                                            },
                                            {
                                                "example_id": "7f50b3ff-74cd-4142-aa95-bdcd95f0c1e1",
                                                "sense_id": "33a97567-59d0-321a-8b38-bfc8c62ae881",
                                                "text": "Si la joie d’un bal eût reflété ses teintes rosées sur ce visage pâle ; si les douceurs d’une vie élégante eussent rempli, eussent vermillonné ces joues déjà légèrement creusées ; si l’amour eût ranimé ces yeux tristes, Victorine aurait pu lutter avec les plus belles jeunes filles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
