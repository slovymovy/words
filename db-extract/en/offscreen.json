                                "example_id": "160a8092-26d9-42e2-a523-8dc37dba0827",
                                "sense_id": "6441f466-2536-3662-ab32-ee9447d5a609",
                                "text": "In addition to racking up what looks like a substantial offscreen body count, the movie at one point offers an eight-second introduction for a sleazy used-car salesman character for the sole purpose of justifying Tripp and Creech laying waste to his inventory."
                            }
                        ]
                    }
