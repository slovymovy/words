                ],
                "senses": [
                    {
                        "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                        "entry_id": "d532f43f-6548-3fa4-afdf-70b64b740e96",
                        "glosses": [
                            "herkömmliche, überlieferte Art und Weise des Spielens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19874874-2712-4c23-b78a-5e49e0140ff6",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Alle Völker und Kulturen hatten und haben ihre eigene Spieltradition.“"
                            },
                            {
                                "example_id": "2dc596fc-49fd-4714-b6c7-685805b7a678",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Im Gesellschaftsspiel, im Mannschaftsspiel, in jedem Spiel, das künstlerischen Gesetzen gehorcht, aber auch schon in zahllosen Kinderspielen, besonders überall da, wo der Spielende einer Spieltradition begegnet, ist der Schöpfer der Regeln nur in Ausnahmefällen mit dem Spieler identisch.“"
                            },
                            {
                                "example_id": "7dbae291-a9bf-4b6f-9ac2-d45521a5a86f",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Spiele und Spieltraditionen zeigen eine gewisse Beständigkeit, sind aber auch einem dauernden Wandel unterworfen.“"
                            },
                            {
                                "example_id": "6bedc5e6-6b4e-4263-83a9-135945a53699",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Der Wirt pflegt die Spieltradition und hält Schach- und Backgammonbretter bereit.“"
                            },
                            {
                                "example_id": "966d9ae2-c069-4f5e-ad02-9468508231eb",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Obwohl Beckett, der von einer ähnlichen Spieltradition ausgegangen ist, sich einmal gegen den Tiefsinn deutscher Godot-Deutungen gewehrt hat, ist bei beiden, bei Ionesco und Beckett, ein Maß von Poesie mit im Spiel, durch die das Absurde der dargestellten Existenz fast unmerklich heraufbeschworen wird.“"
                            },
                            {
                                "example_id": "6105e2c1-732d-48b7-8a6b-bca3c9536be4",
                                "sense_id": "6a1d4c47-2e83-337b-b401-e3051c706af9",
                                "text": "„Für Frankreich, wo es, anders als bei uns, eine durch die Comédie Française seit Jahrhunderten gepflegte Spieltradition für Marivaux gibt, ist die durch die Literaturwissenschaft (Leo Spitzer, Georges Poulet, Raymond Picart, Jürgen von Stackelberg) vorbereitete, neue Spielweise ein überraschender, erkenntnisfördernder Schock.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
