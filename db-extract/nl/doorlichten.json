                    {
                        "translation_id": "c24a3b50-2a19-4083-990a-2d3a94a9d234",
                        "source_entry_id": "daaf23f5-2a24-3d57-be3d-959d44e66911",
                        "source_sense_id": "80b76a5c-6925-36a1-878d-c7ca2b7f4226",
                        "source_sense_description": "grondig onderzoeken",
                        "target_lang_word": "testen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "testen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                        "entry_id": "aca353e3-c485-324e-bf16-56f7a3d1c2a4",
                                        "glosses": [
                                            "durch einen oder mehrere Versuche überprüfen, ob etwas (beispielsweise eine Methode, ein Prozess, ein technisches Gerät) funktioniert/den Anforderungen entspricht oder nicht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d764a93-d887-42b3-8a9d-f92b2c271ab2",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "Ob das funktionieren kann, müssen wir noch testen."
                                            },
                                            {
                                                "example_id": "ccc7c086-114f-413b-bb68-1f6a3559cb1d",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Anders als in anderen Ländern werden in Südkorea massenhaft mögliche Kontaktpersonen auf das Coronavirus getestet.“"
                                            },
                                            {
                                                "example_id": "c0042df9-65b0-4a9a-befb-8ea000e67301",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Während der COVID-19-Pandemie war der Zoo wochenlang geschlossen und erlangte Aufmerksamkeit, weil ein Tiger des Zoos positiv auf das Coronavirus getestet wurde.“"
                                            },
                                            {
                                                "example_id": "e2c7f62d-095b-4c9e-bf98-9fb52a4a4f8f",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„1929: Der britische Mediziner und Bakteriologe Alexander Fleming testet erstmals den von ihm zufällig entdeckten Antibiotika-Wirkstoff Penicilline.“"
                                            },
                                            {
                                                "example_id": "dca30e32-545c-452c-94fa-09fb4d41d224",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Überprüf, wie gut dein Deutsch ist! Anhand von 30 Aufgaben für fortgeschrittene Deutschlerner kannst du deine Grammatikkenntnisse und dein Lese- und Hörverstehen testen. Am Ende erfährst du, auf welchem Niveau deine Deutschkenntnisse sind.“"
                                            },
                                            {
                                                "example_id": "e40bcafa-6bbd-4fd0-b2c5-b07ee3c829aa",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "[Vorschul-Sprachtests:] „42.300 dieser Kinder sind gut ein Jahr vor ihrer Einschulung getestet worden[.] Gut die Hälfte von ihnen ist durchgefallen. Genauer: 56 Prozent.“"
                                            },
                                            {
                                                "example_id": "8b49a3b6-83ce-4799-9786-6ecc791a6c93",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "[Wraps aud dem Kühlregal:] „Wir prüfen Inhaltsstoffe und geben fünf Stichproben ins Labor – testen dort auf Listerien, Salmonellen und Keime.“"
                                            },
                                            {
                                                "example_id": "ee2885fe-eb82-4de6-b564-86b40cb09b6b",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Stiftung Warentest hat verschiedene Balkonkraftwerke getestet. Das sind die Ergebnisse.“"
                                            },
                                            {
                                                "example_id": "ececbd23-bf54-4a60-8922-063e381ed116",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Von Juli bis Dezember 2007 testete die Polizei Brandenburg einen angemieteten Tragschrauber vom Typ HTC MT-03 auf dem Flugplatz Saarmund auf seine Tauglichkeit für Polizeieinsätze.“"
                                            },
                                            {
                                                "example_id": "ae571fd5-2c8a-41de-9bef-f36cf4f12a00",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "„Russland testet die Nato und Lettland als Mitgliedsland täglich mit seiner hybriden Kriegsführung – mit Cyberattacken, Angriffen auf kritische Infrastruktur, Desinformationskampagnen, Sabotage, gelenkten Flüchtlingsströmen.“"
                                            },
                                            {
                                                "example_id": "78d64205-4417-4a98-ac5b-f4bbacd1cc00",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "[…] „in den 1960er- bis 1980er-Jahren [wurden] immer wieder Rennfahrer bei Dopingkontrollen positiv getestet, darunter die Tour-Sieger Eddy Merckx, Felice Gimondi, Lucien Aimar, Luis Ocaña Pernía, Bernard Thévenet, Joop Zoetemelk, Laurent Fignon, Pedro Delgado sowie die deutschen Fahrer Rudi Altig und Dietrich Thurau.“"
                                            },
                                            {
                                                "example_id": "56387a22-4e74-4019-82df-6687f971e4a4",
                                                "sense_id": "489453f4-a00a-31d6-8660-a0315fd8ad64",
                                                "text": "[Fahrradrennen:] „Es gibt […] mehr zugelassene, teils noch in der Forschung befindliche Präparate, die die Leistung […] steigern können – und auf die auch nicht routinemäßig getestet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dbeaa87-cec7-46f7-ba9e-42d84c48ea47",
                        "source_entry_id": "daaf23f5-2a24-3d57-be3d-959d44e66911",
