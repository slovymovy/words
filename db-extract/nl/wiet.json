                        "cross_references": [
                            {
                                "target_word": "weed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3303ece1-4e95-3adb-8f01-a114bec812e8",
                                        "entry_id": "3cc6897f-12fc-3cf1-8928-6d6d7ed8f19d",
                                        "glosses": [
                                            "Any plant unwanted at the place where and at the time when it is growing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b2e2bb4-7b20-4128-9694-91d061b990ee",
                                                "sense_id": "3303ece1-4e95-3adb-8f01-a114bec812e8",
                                                "text": "If it isn't in a straight line or marked with a label, it's a weed."
                                            },
                                            {
                                                "example_id": "295fe497-78bd-484a-a738-6757a92da5ab",
                                                "sense_id": "3303ece1-4e95-3adb-8f01-a114bec812e8",
                                                "text": "The hovel stood in the centre of what had once been a vegetable garden, but was now a patch of rank weeds. Surrounding this, almost like a zareba, was an irregular ring of gorse and brambles, an unclaimed vestige of the original common."
                                            },
                                            {
                                                "example_id": "2c93e200-26ce-42b9-89f2-33869db2ed69",
                                                "sense_id": "3303ece1-4e95-3adb-8f01-a114bec812e8",
                                                "text": "Some of the weeds that cause an undesirable flavor in milk are: onion, tarweed, scaleweed, garlic, mustard, pepper grass."
                                            },
                                            {
                                                "example_id": "6d7844d7-8f7b-4706-b8e1-59dd85e8adfc",
                                                "sense_id": "3303ece1-4e95-3adb-8f01-a114bec812e8",
                                                "text": "I found down at the side of the house the remains of what must have once been a kitchen garden. Everything was choked with weeds and scutch grass, but the outlines of bed and drill were still there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53a30057-e9f1-33e8-9d57-439843076c4d",
                                        "entry_id": "3cc6897f-12fc-3cf1-8928-6d6d7ed8f19d",
                                        "glosses": [
                                            "Ellipsis of duckweed."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f71b5b1c-1277-31a3-a4fd-c95c13765db3",
                                        "entry_id": "3cc6897f-12fc-3cf1-8928-6d6d7ed8f19d",
                                        "glosses": [
                                            "Underbrush; low shrubs."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409e4c53-fc8c-4fea-9213-64c9053133fa",
                                                "sense_id": "f71b5b1c-1277-31a3-a4fd-c95c13765db3",
                                                "text": "one rushing forth out of the thickest weed"
                                            },
                                            {
                                                "example_id": "cb49ac0d-fc6b-4dd9-ab72-0f87860ebab5",
                                                "sense_id": "f71b5b1c-1277-31a3-a4fd-c95c13765db3",
                                                "text": "A wild and wanton pard[…]/ Crouched fawning in the weed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e38015e3-0256-36ff-b19f-e6921cfdeb9a",
                                        "entry_id": "3cc6897f-12fc-3cf1-8928-6d6d7ed8f19d",
                                        "glosses": [
                                            "A drug or the like made from the leaves of a plant.",
                                            "Cannabis."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d57396c5-40e9-4f08-869e-2da6e16de507",
                                                "sense_id": "e38015e3-0256-36ff-b19f-e6921cfdeb9a",
                                                "text": "And I predict you will laugh harder than ever. I’m not saying I’m any funnier. I’m saying weed is now legal in D.C."
                                            }
                                        ]
                                    },
