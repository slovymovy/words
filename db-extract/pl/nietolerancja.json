                    {
                        "translation_id": "5bda7328-87d0-40ce-a956-4aa23d91b6a7",
                        "source_entry_id": "f77b576c-5277-39cd-b1b3-75001e6316e1",
                        "source_sense_id": "50618fe1-1271-3f34-8bb2-08f90d084830",
