                                        "entry_id": "64f2b5a2-c262-3238-a71f-93f351e6d3cb",
                                        "glosses": [
                                            "Bezeichnung bei einer Mannschaftssportart, wenn ein Spieler den Ball ins eigene Tor schießt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c549b140-0c74-4ce8-abbc-25a446e587aa",
                                                "sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                                                "text": "Eigentore sind für den Schützen besonders ärgerliche Vorkommnisse in einem Spiel."
                                            },
                                            {
                                                "example_id": "96c2748d-d8b0-40e4-9147-c1388af50bdb",
                                                "sense_id": "3e146076-dc64-36d1-ba5f-3971c3e6259b",
                                                "text": "„Erwähnenswert in diesem Zusammenhang ist noch das Spiel gegen Mönchengladbach am 12. Dezember 2009, in dem Hannover drei Eigentore schoss.“"
                                            }
