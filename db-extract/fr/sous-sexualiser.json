                "senses": [
                    {
                        "sense_id": "a75a0317-c7ed-3d2c-bacc-01a9a8c47b61",
                        "entry_id": "8301851f-11a1-3008-affd-676dacb97227",
                        "glosses": [
                            "Sexualiser moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb4f42e8-04e2-473e-bb03-ef197aecb6dc",
                                "sense_id": "a75a0317-c7ed-3d2c-bacc-01a9a8c47b61",
                                "text": "Certains rapportent sexualiser les Latinos, tandis que d’autres mentionnent sous-sexualiser en quelque sorte les Asiatiques (qui sont comparés à des femmes) : « Moi, je « trippe » sur les Hispaniques, les Latinos, parce qu’ils ne se donnent pas à moitié. Les Latinos ne se donnent pas à moitié, ils jouissent de la tête aux pieds. » (1106-1112)"
                            },
                            {
                                "example_id": "87e8f46c-6891-4042-a553-35293930ce24",
                                "sense_id": "a75a0317-c7ed-3d2c-bacc-01a9a8c47b61",
                                "text": "L'hypersexualisation est un concept purement moral qui n'existe que dans la tête des personnes puritaines ou sous-sexualisées."
                            },
                            {
                                "example_id": "76e3869b-fa79-4e08-bda2-cfecf921a71d",
                                "sense_id": "a75a0317-c7ed-3d2c-bacc-01a9a8c47b61",
                                "text": "Par rapport à la société sous-sexualisée de nos grands-parents?"
                            }
                        ]
                    }
