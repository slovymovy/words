                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e2ae6b6-c419-3a88-a1ca-43cdb5459276",
                                        "entry_id": "6b11f29a-69e3-3f76-9070-a419de742723",
                                        "glosses": [
                                            "Money sent by a foreign worker back to their home country."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c05cf37-cb9d-4780-bdde-9ae0b43d91c8",
                                                "sense_id": "2e2ae6b6-c419-3a88-a1ca-43cdb5459276",
                                                "text": "It had been built on remittances, Lamin told me, sent back by a local young man who had been doing well, driving a cab in Amsterdam, until his luck changed and the money abruptly stopped."
                                            }
                                        ]
                                    }
                                ]
