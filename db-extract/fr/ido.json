                                "target_senses": [
                                    {
                                        "sense_id": "1a04ca43-3213-3eb0-9282-42ec6cd91bc5",
                                        "entry_id": "0e586fc3-89db-35de-a74b-816241416507",
                                        "glosses": [
                                            "An Internet-like structure connecting everyday physical objects equipped with RFID or similar tags."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c02fbe2-a09c-4cb5-8e38-69b77d470016",
                                                "sense_id": "1a04ca43-3213-3eb0-9282-42ec6cd91bc5",
                                                "text": "The Internet of Things as an emerging global Internet-based information architecture facilitating the exchange of goods and services is gradually developing. While the technology of the Internet of Things is still being discussed […]"
                                            },
                                            {
                                                "example_id": "27c122d7-fc0b-4017-88de-b6cca5568c90",
                                                "sense_id": "1a04ca43-3213-3eb0-9282-42ec6cd91bc5",
                                                "text": "Finally, I want to underscore that although it may be possible to image something like the “internet of things” without surveillance capitalism, it is impossible to image surveillance capitalism without something like the “internet of things.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
