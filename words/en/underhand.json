{
    "word_family": [
        "underhanded",
        "underhandedness",
        "underhandedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "50af9e93-8885-333a-9416-69d10a6eeab9",
                    "sense_definition": "Done in a secret, dishonest, or deceitful way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used <w>underhand</w> methods to win the election against his rival.",
                            "target_lang_translations": {
                                "es": "Utilizó métodos <w>solapados</w> para ganar las elecciones contra su rival."
                            }
                        },
                        {
                            "text": "Such <w>underhand</w> tactics will not be tolerated in our company.",
                            "target_lang_translations": {
                                "es": "Ese tipo de tácticas <w>rastreras</w> no se tolerarán en nuestra empresa."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhanded"
                    ],
                    "common_phrases": [
                        "underhand tactics",
                        "underhand methods",
                        "underhand dealings"
                    ],
                    "target_lang_definitions": {
                        "es": "Hecho de manera secreta, deshonesta o engañosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "solapado",
                                "target_lang_sense_clarification": "que oculta intenciones o malas artes"
                            },
                            {
                                "target_lang_word": "turbio",
                                "target_lang_sense_clarification": "poco claro o deshonesto"
                            },
                            {
                                "target_lang_word": "rastrero",
                                "target_lang_sense_clarification": "vil o desleal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3017c75e-e38d-3ce5-9a5b-ed534ab632a9",
                    "sense_definition": "Executed with the hand and arm moving forward and upward below the shoulder level.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a gentle <w>underhand</w> throw directly to the child.",
                            "target_lang_translations": {
                                "es": "Hizo un lanzamiento suave <w>por debajo del hombro</w> directo hacia el niño."
                            }
                        },
                        {
                            "text": "Softball pitchers usually throw the ball using an <w>underhand</w> motion.",
                            "target_lang_translations": {
                                "es": "Los lanzadores de sóftbol suelen arrojar la pelota con un movimiento <w>por debajo del hombro</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "underarm"
                    ],
                    "common_phrases": [
                        "underhand throw",
                        "underhand pitch",
                        "underhand serve"
                    ],
                    "target_lang_definitions": {
                        "es": "Ejecutado con el brazo y la mano moviéndose hacia adelante y hacia arriba por debajo del nivel del hombro."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "por debajo del hombro",
                                "target_lang_sense_clarification": "movimiento de lanzamiento bajo"
                            },
                            {
                                "target_lang_word": "de cuchara",
                                "target_lang_sense_clarification": "lanzamiento o saque desde abajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85ec0d10-3966-3f4a-8a52-c6011ca031af",
                    "sense_definition": "Kept hidden from public view; secret or clandestine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee made an <w>underhand</w> agreement that bypassed normal oversight.",
                            "target_lang_translations": {
                                "es": "El comité cerró un acuerdo <w>bajo cuerda</w> que eludió la supervisión habitual."
                            }
                        },
                        {
                            "text": "They engaged in <w>underhand</w> negotiations to divide the territory quietly.",
                            "target_lang_translations": {
                                "es": "Entablaron negociaciones <w>clandestinas</w> para repartirse el territorio en silencio."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhanded"
                    ],
                    "common_phrases": [
                        "underhand agreement"
                    ],
                    "target_lang_definitions": {
                        "es": "Mantenido oculto a la vista pública; secreto o clandestino."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "clandestino",
                                "target_lang_sense_clarification": "secreto u oculto"
                            },
                            {
                                "target_lang_word": "secreto",
                                "target_lang_sense_clarification": "no público"
                            },
                            {
                                "target_lang_word": "bajo cuerda",
                                "target_lang_sense_clarification": "hecho a espaldas de los demás"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f5956c54-e3b8-32ad-a58f-8411fbff4344",
                    "sense_definition": "With an arm motion that comes from below shoulder level.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tossed the keys <w>underhand</w> across the kitchen counter.",
                            "target_lang_translations": {
                                "es": "Tiró las llaves <w>por debajo del hombro</w> sobre la encimera de la cocina."
                            }
                        },
                        {
                            "text": "She decided to serve <w>underhand</w> during the final set of the match.",
                            "target_lang_translations": {
                                "es": "Decidió sacar <w>de cuchara</w> durante el set final del partido."
                            }
                        }
                    ],
                    "synonyms": [
                        "underarm"
                    ],
                    "common_phrases": [
                        "toss underhand",
                        "throw underhand",
                        "pitch underhand"
                    ],
                    "target_lang_definitions": {
                        "es": "Con un movimiento del brazo por debajo de la altura del hombro."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "por debajo del hombro",
                                "target_lang_sense_clarification": "lanzar desde abajo"
                            },
                            {
                                "target_lang_word": "de cuchara",
                                "target_lang_sense_clarification": "con movimiento de abajo hacia arriba"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96b17901-b368-3615-b1f5-0b356270198c",
                    "sense_definition": "In a sly, secretive, or deceitful manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They acted <w>underhand</w> to secure the contract before anyone else could bid.",
                            "target_lang_translations": {
                                "es": "Actuaron <w>por debajo de la mesa</w> para asegurarse el contrato antes de que nadie más pudiera pujar."
                            }
                        },
                        {
                            "text": "He managed to defeat his opponent by dealing <w>underhand</w> behind the scenes.",
                            "target_lang_translations": {
                                "es": "Consiguió vencer a su oponente negociando <w>solapadamente</w> entre bastidores."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhandedly"
                    ],
                    "common_phrases": [
                        "deal underhand"
                    ],
                    "target_lang_definitions": {
                        "es": "De manera astuta, secreta o engañosa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "por debajo de la mesa",
                                "target_lang_sense_clarification": "en secreto y de forma deshonesta"
                            },
                            {
                                "target_lang_word": "a traición",
                                "target_lang_sense_clarification": "de forma desleal"
                            },
                            {
                                "target_lang_word": "solapadamente",
                                "target_lang_sense_clarification": "con disimulo o engaño"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc1d694e-a270-3a39-bbb2-d19e11d944e9",
                    "sense_definition": "To throw, toss, or pitch something using an underhand motion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>underhand</w> the softball directly to the catcher.",
                            "target_lang_translations": {
                                "es": "Decidió <w>lanzar por debajo del hombro</w> la pelota de sóftbol directamente al receptor."
                            }
                        },
                        {
                            "text": "She <w>underhanded</w> her keys to her friend across the room.",
                            "target_lang_translations": {
                                "es": "Le <w>tiró por debajo del hombro</w> las llaves a su amiga al otro lado de la habitación."
                            }
                        }
                    ],
                    "common_phrases": [
                        "underhand the ball"
                    ],
                    "target_lang_definitions": {
                        "es": "Lanzar o tirar algo con un movimiento del brazo por debajo del hombro."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lanzar por debajo del hombro",
                                "target_lang_sense_clarification": "tiro bajo"
                            },
                            {
                                "target_lang_word": "tirar de abajo hacia arriba",
                                "target_lang_sense_clarification": "lanzamiento bajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "382a2788-2f0c-3808-9465-d6f49d0eaf26",
                    "sense_definition": "To deceive, trick, or take unfair advantage of someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The business rivals continuously attempted to <w>underhand</w> one another.",
                            "target_lang_translations": {
                                "es": "Los rivales comerciales intentaban continuamente <w>jugarse sucio</w> mutuamente."
                            }
                        },
                        {
                            "text": "He felt he had been completely <w>underhanded</w> by his former business partners.",
                            "target_lang_translations": {
                                "es": "Sintió que sus antiguos socios comerciales lo habían <w>engañado</w> por completo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Engañar, timar o aprovecharse de alguien de manera deshonesta."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "engañar",
                                "target_lang_sense_clarification": "hacer trampas"
                            },
                            {
                                "target_lang_word": "jugar sucio",
                                "target_lang_sense_clarification": "actuar deslealmente contra alguien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bea9af4-16e6-3499-b34a-9ef08f823d5f",
                    "sense_definition": "To excavate downward in successive steps or horizontal slices while standing on unbroken material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners were instructed to <w>underhand</w> the remaining ore safely.",
                            "target_lang_translations": {
                                "es": "Se instruyó a los mineros para que <w>explotasen en testeros descendentes</w> el mineral restante de forma segura."
                            }
                        },
                        {
                            "text": "They planned to <w>underhand</w> into the lower chute from the level above.",
                            "target_lang_translations": {
                                "es": "Planearon <w>excavar en descenso</w> hacia la chimenea inferior desde el nivel superior."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "En minería, excavar hacia abajo en gradas o rebanadas horizontales sucesivas sobre terreno firme."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "explotar en testeros descendentes",
                                "target_lang_sense_clarification": "minería descendente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2aaf84a7-0374-39f4-aea3-351627ac1488",
                    "sense_definition": "The hand placed underneath the work or fabric, as in quilting or needlework.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "craft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Keep your <w>underhand</w> flat against the fabric to guide each stitch.",
                            "target_lang_translations": {
                                "es": "Mantén la <w>mano inferior</w> plana contra la tela para guiar cada puntada."
                            }
                        },
                        {
                            "text": "Your <w>underhand</w> should remain completely under the quilt while sewing.",
                            "target_lang_translations": {
                                "es": "Tu <w>mano inferior</w> debe permanecer completamente debajo de la colcha mientras coses."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Mano colocada debajo de la labor o la tela en costura o acolchado."
                    },
                    "translations": {
                        "es": [
