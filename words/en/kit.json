        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "56d73b10-5c4f-3f2f-b326-deacd2d85e6f",
                    "sense_definition": "To supply or equip someone with a set of clothes, tools, or equipment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "equip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was <w>kitted</w> out in brand new uniforms for the season.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>экипирована</w> в совершенно новую форму на сезон.",
                                "zh": "球队为本赛季<w>配备</w>了全新的制服。",
                                "nl": "Het team werd voor het seizoen <w>uitgerust</w> met gloednieuwe uniformen."
                            }
                        },
                        {
                            "text": "They <w>kitted</w> themselves up with hiking gear before climbing the mountain.",
                            "target_lang_translations": {
                                "ru": "Они <w>снарядились</w> походным инвентарем перед восхождением на гору.",
                                "zh": "他们在登山前为自己<w>装备</w>了徒步用品。",
                                "nl": "Ze <w>rustten</w> zichzelf <w>uit</w> met wandelspullen voordat ze de berg beklommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "kit out"
                    ],
                    "common_phrases": [
                        "kit up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать или экипировать кого-либо набором одежды, инструментов или оборудования.",
                        "zh": "为某人配备一套衣服、工具或设备。",
                        "nl": "Iemand voorzien van een set kleding, gereedschap of uitrusting."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экипировать",
                                "target_lang_sense_clarification": "снаряжать"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "обеспечивать снаряжением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配备",
                                "target_lang_sense_clarification": "提供装备"
                            },
                            {
                                "target_lang_word": "装备",
                                "target_lang_sense_clarification": "使具备装备"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitrusten",
                                "target_lang_sense_clarification": "voorzien van de nodige middelen"
                            },
                            {
                                "target_lang_word": "uitrusten met",
                                "target_lang_sense_clarification": "iemand voorzien van uitrusting"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d9d3b657-f659-3ad9-8f21-de3ee593cc69",
                    "sense_definition": "A diminutive of the male given name Christopher or the female given name Katherine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My cousin <w>Kit</w> is coming to visit us next week.",
                            "target_lang_translations": {
                                "ru": "Мой кузен <w>Кит</w> приедет навестить нас на следующей неделе.",
                                "zh": "我的表弟<w>基特</w>下周要来看我们。",
                                "nl": "Mijn neef <w>Kit</w> komt ons volgende week bezoeken."
                            }
                        },
                        {
                            "text": "<w>Kit</w> Harrington is a famous actor.",
                            "target_lang_translations": {
                                "ru": "<w>Кит</w> Харингтон — известный актер.",
                                "zh": "<w>基特</w>·哈灵顿是一位著名的演员。",
                                "nl": "<w>Kit</w> Harrington is een beroemde acteur."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужского имени Кристофер или женского имени Кэтрин.",
                        "zh": "男性名字克里斯托弗或女性名字凯瑟琳的昵称。",
                        "nl": "Een verkleinvorm van de mannelijke voornaam Christopher of de vrouwelijke voornaam Katherine."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кит",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
