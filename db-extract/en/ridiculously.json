                        "source_entry_id": "47cb474b-d30e-3978-9faf-89e21ba52a62",
                        "source_sense_description": "in a ridiculous manner",
                        "target_lang_word": "belachelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belachelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8483a0b9-d44a-3ef4-8d6c-b93753dc0977",
                                        "entry_id": "6bf796c4-fcb5-37cb-9766-0a0a0025e427",
                                        "glosses": [
                                            "lachwekkend, om uit te lachen, idioot, bespottelijk, vreemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6409ff-e3cf-42ed-b640-a392a35f955a",
                                                "sense_id": "8483a0b9-d44a-3ef4-8d6c-b93753dc0977",
                                                "text": "De man had een belachelijke petje op zijn hoofd tijdens carnaval."
                                            },
                                            {
                                                "example_id": "29d0cea3-a436-4c30-95b3-76f5ee0c49e3",
                                                "sense_id": "8483a0b9-d44a-3ef4-8d6c-b93753dc0977",
                                                "text": "Het is dat die gasten dit jaar de prijs belachelijk hebben opgeschroefd, anders waren wij daar weer naartoe gegaan."
                                            },
                                            {
                                                "example_id": "c4ffa9cb-ab06-477d-9b22-40de9e9da61f",
                                                "sense_id": "8483a0b9-d44a-3ef4-8d6c-b93753dc0977",
                                                "text": "Misschien voelde Jeroen zich na zijn belachelijke gedrag van die morgen zo bezwaard dat hij nu fris en monter voor haar wilde verschijnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e96c1c3-e4a3-4cc9-8425-ace5746b9e12",
                        "source_entry_id": "47cb474b-d30e-3978-9faf-89e21ba52a62",
                        "source_sense_description": "in a ridiculous manner",
                        "target_lang_word": "bespottelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bespottelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                        "entry_id": "1a0fcc0f-bcfb-31f6-be86-a3c0f1b20076",
                                        "glosses": [
                                            "uitermate vreemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b45d9e2-c63c-41eb-908c-f6e1df8eac85",
                                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                                "text": "Het is een bespottelijk voorstel om hier alleen nog maar fietsers door te laten."
                                            },
                                            {
                                                "example_id": "3b687f64-3380-4a61-baa9-f91773b68e89",
                                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                                "text": "Het allerliefst zou ik voor vijftig man spelen en hooguit tien dollar voor een kaartje vragen; theater voor hoi polloi. Ik zou graag de vrekken zien komen, de mensen die niet geïnteresseerd zijn, de mensen die andere plannen hebben, die wel wat beters te doen hebben en die ergens anders moeten zijn, de mensen die uitsluitend komen omdat een kaartje zo bespottelijk goedkoop is dat je wel gek zou zijn als je die kans liet lopen."
                                            },
                                            {
                                                "example_id": "0ee2bbc0-01fe-421f-b5a3-f455dd2def9f",
                                                "sense_id": "ddefdebe-428c-32ec-9c6d-7c6afbefee6e",
                                                "text": "En dat alles voor de bespottelijke prijs van 1. 600 euro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "769002ff-2a8a-4b67-b353-9c1b0cae3a5e",
                        "source_entry_id": "47cb474b-d30e-3978-9faf-89e21ba52a62",
                        "source_sense_description": "in a ridiculous manner",
                        "target_lang_word": "ridiculement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
