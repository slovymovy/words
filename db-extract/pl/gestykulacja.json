                "senses": [
                    {
                        "sense_id": "d7afa90d-4339-37c4-a80b-226158470b8c",
                        "entry_id": "b485ec1e-c25a-3b94-979e-9f75ed048cef",
                        "glosses": [
                            "ruchy rąk, które uwypuklają treść wypowiedzi, wykonywanie gestów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fba8b934-1bd8-42a7-8576-9d3dd07b2213",
                        "source_entry_id": "b485ec1e-c25a-3b94-979e-9f75ed048cef",
                        "source_sense_id": "d7afa90d-4339-37c4-a80b-226158470b8c",
                        "target_lang_word": "gesticulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gesticulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a04c106c-8c8f-3a0e-aeb5-cf29601ef52f",
                                        "entry_id": "008ea3ac-67a5-335c-bbfa-040ec5ecc4fe",
                                        "glosses": [
                                            "The act of gesticulating, or making gestures to aid expression of thoughts, sentiments or passion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcb07f18-556f-315a-842a-b38bf4393bc5",
                                        "entry_id": "008ea3ac-67a5-335c-bbfa-040ec5ecc4fe",
                                        "glosses": [
                                            "A gesture; a motion of the body or limbs when speaking, or in representing action or passion, and enforcing arguments and sentiments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c02e7a2d-bc3d-4b33-ab48-56a27b866658",
                                                "sense_id": "dcb07f18-556f-315a-842a-b38bf4393bc5",
                                                "text": "In the eagerness of his gesticulations, first he knocked off my hat, then he knocked off Lessingham’s, then his own, then all three together […]"
                                            },
                                            {
                                                "example_id": "e2ffa030-0895-4234-9e66-cadcdce4484c",
                                                "sense_id": "dcb07f18-556f-315a-842a-b38bf4393bc5",
                                                "text": "It is commonly supposed that they communicated by sounds and tentacular gesticulations; this is asserted, for instance, in the able but hastily compiled pamphlet (written evidently by someone not an eye-witness of Martian actions) to which I have already alluded, and which, so far, has been the chief source of information concerning them."
                                            },
                                            {
                                                "example_id": "e196b8de-cd46-4e98-8630-afc62f0c8e0f",
                                                "sense_id": "dcb07f18-556f-315a-842a-b38bf4393bc5",
                                                "text": "The breeze had died away and the tree was now quite motionless save when William's statements required forcible gesticulations, which made it sway in a gentle nodding manner as though it were confirming every word the old sage uttered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d75b95-7c14-3fcd-b295-dcb202c4236d",
                                        "entry_id": "008ea3ac-67a5-335c-bbfa-040ec5ecc4fe",
                                        "glosses": [
                                            "An odd or fanciful motion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb325ccc-9c84-4585-96c7-35a2ac5b578a",
                                                "sense_id": "33d75b95-7c14-3fcd-b295-dcb202c4236d",
                                                "text": "I indulged in this meditation for a moment, and then again addressed the mourner, who stood leaning against the bed with that expression of resigned despair, of complete misery, and a patient sufferance of it, which is far more touching than any of the insane ravings or wild gesticulation of untamed sorrow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "451a0617-5ee1-4619-835b-530d6d70b2c7",
                        "source_entry_id": "b485ec1e-c25a-3b94-979e-9f75ed048cef",
                        "source_sense_id": "d7afa90d-4339-37c4-a80b-226158470b8c",
                        "target_lang_word": "жестикуляция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жестикуляция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "219ac651-cf28-3837-a9f0-5fcfdf06c2df",
                                        "entry_id": "4c83b65f-ea4f-3397-a63c-d5a9d337451c",
                                        "glosses": [
                                            "действие по значению гл. жестикулировать; делание жестов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0efaff5e-577d-4a2c-8bc2-3b524ab59132",
                                                "sense_id": "219ac651-cf28-3837-a9f0-5fcfdf06c2df",
                                                "text": "В жизни ей была присуща выразительная мимика, особенно гнева, скорби, сострадания; жестикуляция почти совсем отсутствовала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df3a6fa1-8000-349b-85cc-20e07e7afeed",
                                        "entry_id": "4c83b65f-ea4f-3397-a63c-d5a9d337451c",
                                        "glosses": [
                                            "манера жестикулировать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57d10dc3-9f81-4210-8beb-19d273d1665f",
                                                "sense_id": "df3a6fa1-8000-349b-85cc-20e07e7afeed",
                                                "text": "Он курил, как поэт, у него была осанка поэта, пластика поэта, мерная жестикуляция, пальцы, взгляд, кепка, куртка из оленьей кожи."
                                            },
                                            {
                                                "example_id": "b769a38c-1a77-48cc-ab82-8cf387408a27",
                                                "sense_id": "df3a6fa1-8000-349b-85cc-20e07e7afeed",
                                                "text": "Источником «вольных» разговоров о президенте часто становилась и эмоциональная мимика и жестикуляция самого Бориса Николаевича."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3faccff-2444-3503-8eb9-b3d2d10fdf36",
                                        "entry_id": "4c83b65f-ea4f-3397-a63c-d5a9d337451c",
                                        "glosses": [
                                            "система жестов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6427b04e-7b38-4eef-834b-f2290a322450",
                                                "sense_id": "a3faccff-2444-3503-8eb9-b3d2d10fdf36",
                                                "text": "Вернемся, впрочем, к жестам. Жестикуляция сильней артикуляции. Мысль изреченная есть ложь. Жест выразит ее неложно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
