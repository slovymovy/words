                        "examples": [
                            {
                                "example_id": "787820c3-0300-4d21-b591-2d408a54e3eb",
                                "sense_id": "6ec044d6-6aa2-3127-bcfb-3021b9cfd59c",
                                "text": "The Humbird is one of the vvonders of the Countrey, being no bigger than a Hornet, yet hath all the demenſions of a Bird, as bill, and vvings, vvith quills, ſpider-like legges, ſmall clavves: For colour, ſhe is as glorious as the Raine-bovv; as ſhe flies, ſhe makes a little humming noiſe like a Humble-bee: vvherefore ſhee is called the Humbird."
                            }
                        ]
                    }
