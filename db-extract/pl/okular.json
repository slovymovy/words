                                    {
                                        "sense_id": "85a967b7-83f3-368f-a40a-046d9d928ea3",
                                        "entry_id": "1ab17646-1940-3937-9939-c579b149904d",
                                        "glosses": [
                                            "met betrekking tot het oog"
                                        ],
