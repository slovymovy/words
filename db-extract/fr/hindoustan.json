                                "target_senses": [
                                    {
                                        "sense_id": "57befbb1-237a-349a-9f5e-283ea1caf960",
                                        "entry_id": "0104d02d-653c-3e99-a083-25fe0758e52d",
                                        "glosses": [
                                            "India (Republic of India)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21272101-f9a8-3d71-b53c-a0feb8c57440",
                                        "entry_id": "0104d02d-653c-3e99-a083-25fe0758e52d",
                                        "glosses": [
                                            "The entire region of the Indian subcontinent."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d5bf96-aaab-435e-9ad2-b5413fde0b9b",
                                                "sense_id": "21272101-f9a8-3d71-b53c-a0feb8c57440",
                                                "text": "He did not wish to steal anything. He only desired to know what to steal, and, incidentally, how to get away when he had stolen it. He thanked all the Gods of Hindustan, and Herbert Spencer, that there remained some valuables to steal."
                                            },
                                            {
                                                "example_id": "d0402a4a-bf29-445c-a352-56b03491d729",
                                                "sense_id": "21272101-f9a8-3d71-b53c-a0feb8c57440",
                                                "text": "“The Government of Her Majesty the Queen, Empress of India, […] says the movement is ‘for the remission of tax, the advancement of Hindustan, and the strengthening of the British Government.’"
                                            },
                                            {
                                                "example_id": "7c20e028-a730-42e2-a706-c8e413a2ba39",
                                                "sense_id": "21272101-f9a8-3d71-b53c-a0feb8c57440",
                                                "text": "There, floor piled upon floor above the chattering throngs, were these less gregarious units, each something of a mystery to his fellow-guests, each in his separate cell; and each as remote from real human companionship as if that cell were fashioned, not in the bricks of London, but in the rocks of Hindustan!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05030e60-e146-33ef-8562-da8578b18190",
                                        "entry_id": "0104d02d-653c-3e99-a083-25fe0758e52d",
                                        "glosses": [
                                            "The northern (properly north central) region of India."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
