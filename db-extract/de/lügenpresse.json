                    {
                        "sense_id": "ad446788-9fc6-3e74-b840-75baeb31a638",
                        "entry_id": "e993b80e-57e6-34db-b948-32b325b1edd2",
                        "glosses": [
                            "Presse mensongère, correspond grosso modo à merdias en français."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "4905999f-cee0-4610-8d1c-d85e9a94b6e8",
                                "sense_id": "ad446788-9fc6-3e74-b840-75baeb31a638",
                                "text": "In extremistischen Kreisen werden oft die Medien als Lügenpresse bezeichnet.",
                                "translation": "Dans les milieux extrémistes, les journaux sont souvent traités de merdias."
                            }
                        ]
                    }
