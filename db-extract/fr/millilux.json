                "senses": [
                    {
                        "sense_id": "cbe62e54-2cf9-3b48-a7fd-ee170ec58330",
                        "entry_id": "0f8099eb-86a1-353c-94f6-06cf36dfb054",
                        "glosses": [
                            "Unité de mesure d’éclairement lumineux du Système international (SI), valant 10⁻³ lux, et dont le symbole est mlx."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "f007020e-8404-4be7-8b50-7fd9bd759bbd",
                                "sense_id": "cbe62e54-2cf9-3b48-a7fd-ee170ec58330",
                                "text": "Le plein soleil donne jusqu’à 100 kilolux d’éclairement, la Lune environ 0.1 lux, et le ciel étoilé à peine 1 millilux."
                            },
                            {
                                "example_id": "ed9e6986-3711-40b9-b596-392933e55cab",
                                "sense_id": "cbe62e54-2cf9-3b48-a7fd-ee170ec58330",
                                "text": "Aussi, en nuit claire il peut y avoir avantage, grâce à une adaptation complète à l’obscurité, à se contenter des 20 millilux que fournit l’éclairement céleste."
                            }
                        ]
                    }
