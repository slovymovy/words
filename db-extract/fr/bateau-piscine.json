                                "example_id": "c2b4947d-b5bb-4633-a393-b2e1a745d7f5",
                                "sense_id": "b4008cc6-be83-391e-951a-65b6dd82c719",
                                "text": "De l’autre côté de la Seine, d’autres jeunes Adam et Ève plongent des bords du bateau-piscine."
                            },
                            {
                                "example_id": "6489a4dc-a12c-478c-b1a2-214f05c37a88",
                                "sense_id": "b4008cc6-be83-391e-951a-65b6dd82c719",
                                "text": "Les égouts s’y déversent et pourtant les bateaux-piscines y puisent l’eau qu’ils offrent à une clientèle pauvre et riche."
                            },
                            {
                                "example_id": "16b2f0ab-548c-4579-b4a8-57e1f3ab4ba7",
                                "sense_id": "b4008cc6-be83-391e-951a-65b6dd82c719",
                                "text": "Il se tendait au-dessus d’un Rhône d’huile où sommeillaient paisiblement les bateaux-piscines."
                            }
                        ]
