                ],
                "senses": [
                    {
                        "sense_id": "7a23a175-faa3-3812-9a5b-89d58a5064c6",
                        "entry_id": "47963ca8-8f0e-340d-bdaa-f797fce2c0bf",
                        "glosses": [
                            "перех. и неперех. зажигать сигарету, папиросу, трубку от чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410df586-4fa5-4781-a253-8352cc6dba66",
                                "sense_id": "7a23a175-faa3-3812-9a5b-89d58a5064c6",
                                "text": "Я вот сижу, курю, а мимо ходят разные и прикуривают, кому не лень."
                            },
                            {
                                "example_id": "a54820d3-8ee8-4c95-aff9-9d0f63c04ec4",
                                "sense_id": "7a23a175-faa3-3812-9a5b-89d58a5064c6",
                                "text": "Когда она прикуривала, у неё так дрожали губы и руки, что она долго не могла попасть концом сигареты в огонёк."
                            },
                            {
                                "example_id": "b1cd0012-0344-4371-9887-bcb5822a7427",
                                "sense_id": "7a23a175-faa3-3812-9a5b-89d58a5064c6",
                                "text": "Мао Цзэдун подражал Сталину в медлительности движений, в том, как долго прикуривал трубку, не спеша гасил спичку, пристально смотрел на собеседника."
                            }
                        ]
                    },
                    {
                        "sense_id": "9049cdb4-afd5-3b9c-a016-6b4fac2f7105",
                        "entry_id": "47963ca8-8f0e-340d-bdaa-f797fce2c0bf",
                        "glosses": [
                            "перен., автомоб. жарг. запускать двигатель от аккумулятора другого автомобиля"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0461c3eb-3274-4c9e-b4b5-09511d5ba2a6",
                        "source_entry_id": "47963ca8-8f0e-340d-bdaa-f797fce2c0bf",
                        "source_sense_description": "зажигать сигарету, папиросу от чего-либо",
                        "target_lang_word": "donner du feu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donner du feu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26f6989c-27e0-33ff-9378-f0af11e20a0d",
                                        "entry_id": "28389a18-a69a-31f0-abe0-c1f5aa80d4f3",
                                        "glosses": [
                                            "Allumer la cigarette de quelqu'un avec un briquet, des allumettes ou avec sa propre cigarette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f509cf67-93b4-4870-97f4-21f1130e2597",
                                                "sense_id": "26f6989c-27e0-33ff-9378-f0af11e20a0d",
                                                "text": "— Deux mots, monsieur, murmura l’attardé en lui touchant l’épaule. Pourriez-vous me donner du feu ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
