                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant a démontré que la fonction était <w>continue</w> sur tout l'intervalle donné."
                        },
                        {
                            "text": "Toute fonction dérivable est nécessairement une application <w>continue</w>."
