                "senses": [
                    {
                        "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                        "entry_id": "7be2f6ef-c7cb-3f31-b4bb-a094efd26e53",
                        "glosses": [
                            "in Notfällen eingeleitete sofortige Bremsung des Fahrzeuges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07989de-9326-4eba-8b00-3d4388dd7d12",
                                "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                                "text": "„Der Fahrdienstleiter im Stellwerk Hordorf habe daraufhin über Funk einen Nothalt angeordnet.“"
                            },
                            {
                                "example_id": "f79cbf36-61c3-490f-a405-04b32f86a7f8",
                                "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                                "text": "„Der Zug legte daraufhin in der Nähe von Rathenow (Brandenburg) einen Nothalt ein.“"
                            },
                            {
                                "example_id": "1af70a07-8bba-4d60-ad06-877f6a30c83c",
                                "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                                "text": "„Mehrere Fahrgäste flüchteten nach dem Nothalt aus den Waggons, offensichtlich auch die beiden Täter.“"
                            },
                            {
                                "example_id": "a8f24017-7bd1-4674-b149-bc7379a28882",
                                "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                                "text": "„Das Bremssteuergerät glaubte, es handele sich um einen auf die Fahrbahn rennenden Passanten und leitete den Nothalt ein.“"
                            },
                            {
                                "example_id": "e3a1c04b-4a69-4f4b-8302-96ff255ac831",
                                "sense_id": "68668a9e-86ef-33d3-89b0-27f7037d78b7",
                                "text": "„Sinnvolle Extras sind Details wie beheizte Windschutzscheibe (180 Euro), Navigationssystem (ab 400 Euro), Soundsystem (350 Euro) und Fahrerassistenzpaket V mit den Assistenten für Stau, Nothalt, Spurhalten, Verkehrszeichen sowie Abstandstempomat für faire 945 Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
