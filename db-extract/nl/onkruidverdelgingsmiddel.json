                        "entry_id": "e319546a-14fe-3122-a7b4-f9bba318030d",
                        "glosses": [
                            "gif of andere methode om planten die op de verkeerde plaats staan uit te roeien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e49ead53-9c2e-46c8-9605-13e5d83be6e9",
                                "sense_id": "02d0fc1e-2544-359e-b3f0-2442c084fd78",
                                "text": "Hij gebruikte een onkruidverdelgingsmiddel om het onkruid tussen zijn planten te doden."
                            },
                            {
                                "example_id": "87d188d6-3335-4ab3-9287-70a4f97196f0",
                                "sense_id": "02d0fc1e-2544-359e-b3f0-2442c084fd78",
                                "text": "Deze wilde bijen hebben het moeilijk: door onkruidverdelgingsmiddelen groeien er minder wilde planten, die juist veel nectar en stuifmeel bevatten."
                            }
                        ]
                    }
