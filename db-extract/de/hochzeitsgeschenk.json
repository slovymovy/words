                "senses": [
                    {
                        "sense_id": "a5e0750f-0353-3983-ac72-58d640c524bb",
                        "entry_id": "6103608b-1e49-3971-bc77-5588edd650ee",
                        "glosses": [
                            "Geschenk, das ein Brautpaar anlässlich seiner Hochzeit bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0eb28c2-8abb-4fb7-9991-7d9f00bd5293",
                                "sense_id": "a5e0750f-0353-3983-ac72-58d640c524bb",
                                "text": "„Für die Hochzeitsgeschenke kommen fast vierhundert Dollar zusammen.“"
                            },
                            {
                                "example_id": "9f235fc9-3704-4c31-b67f-9439dba01413",
                                "sense_id": "a5e0750f-0353-3983-ac72-58d640c524bb",
                                "text": "„Plötzlich hatte ich genug von Brautsträußen, Blumengebinden, Festspeisen und Hochzeitsgeschenken.“"
                            },
                            {
                                "example_id": "cbab8bcf-53f1-4b3b-bd44-1589435a1593",
                                "sense_id": "a5e0750f-0353-3983-ac72-58d640c524bb",
                                "text": "„Wenn Cranach Großaufträge von Albrecht annimmt, wird sie gedacht haben, werden wir doch das kleine Hochzeitsgeschenk behalten dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
