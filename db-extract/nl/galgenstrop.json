                                                "example_id": "154b8f05-d8a5-45a8-b918-4ac5849ac3cb",
                                                "sense_id": "b67dea89-5f90-3c4b-b18d-ce6e527b0e2f",
                                                "text": "Wenn du die Schlinge zu fest zusammenziehst, geht der Knoten nie mehr auf."
                                            },
                                            {
                                                "example_id": "8f6e1916-2926-498d-afe4-8ee4b007788d",
                                                "sense_id": "b67dea89-5f90-3c4b-b18d-ce6e527b0e2f",
                                                "text": "„Da der Kutscher mich mit dem Arm in der Schlinge erblickte, glaubte er, wie alle Leute in Radicófani, ich hätte mich duelliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1671a24c-bf66-383a-af61-15bad4635651",
                                        "entry_id": "3b1a5fb3-3dfb-3635-a72d-eb033ebd116e",
