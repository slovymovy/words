                        "glosses": [
                            "Rediffusion d’un tweet effectué par un autre compte Twitter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697dc912-2534-4f9f-b881-71e36a875a0d",
                                "sense_id": "4e45b34c-b7a1-396b-9c0b-6c2cc1c360cf",
                                "text": "Avec un RT de votre compte ou un tweet contenant votre hashtag, c’est l’ensemble des followers du participant qui pourront alors découvrir votre compte Twitter et votre marque."
                            },
                            {
                                "example_id": "c5f82598-ba68-4cec-8af2-47a05a94b4d1",
                                "sense_id": "4e45b34c-b7a1-396b-9c0b-6c2cc1c360cf",
                                "text": "Répondez à un RT avec une réponse conversationnelle sur le message pour lancer la discussion. En utilisant « répondre », vous permettez aux autres utilisateurs de suivre facilement le fil de la conversation."
                            }
                        ]
                    }
                ],
