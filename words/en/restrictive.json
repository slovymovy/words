{
    "word_family": [
        "restrict",
        "restriction",
        "restrictively",
        "unrestrictive"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05859ded-da9b-3bda-a09b-ef8d688d1ddf",
                    "sense_definition": "Confining, limiting, or containing within defined bounds.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new government policy introduced highly <w>restrictive</w> measures on international trade.",
                            "target_lang_translations": {
                                "ru": "Новая государственная политика ввела крайне <w>ограничительные</w> меры в отношении международной торговли."
                            }
                        },
                        {
                            "text": "Many employees found the company's <w>restrictive</w> rules to be unnecessary and demotivating.",
                            "target_lang_translations": {
                                "ru": "Многие сотрудники сочли <w>ограничительные</w> правила компании ненужными и демотивирующими."
                            }
                        }
                    ],
                    "synonyms": [
                        "limiting",
                        "confining",
                        "constraining"
                    ],
                    "antonyms": [
                        "permissive",
                        "liberal",
                        "unrestrictive"
                    ],
                    "common_phrases": [
                        "restrictive measures",
                        "restrictive rules",
                        "highly restrictive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничивающий, удерживающий в определенных рамках или пределах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничительный",
                                "target_lang_sense_clarification": "о правилах, мерах, законах"
                            },
                            {
                                "target_lang_word": "жесткий",
                                "target_lang_sense_clarification": "о рамках или правилах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddefef21-8c49-38fa-9dc1-aaef27eb2be9",
                    "sense_definition": "Limiting free and easy bodily movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "limiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided not to buy the dress because the fabric felt too stiff and <w>restrictive</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила не покупать платье, потому что ткань показалась слишком жесткой и <w>стесняющей движения</w>."
                            }
                        },
                        {
                            "text": "Athletes avoid wearing <w>restrictive</w> clothing during training to ensure maximum flexibility.",
                            "target_lang_translations": {
                                "ru": "Спортсмены избегают носить во время тренировок <w>сковывающую</w> одежду, чтобы обеспечить максимальную гибкость."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight",
                        "constricting"
                    ],
                    "antonyms": [
                        "loose",
                        "comfortable"
                    ],
                    "common_phrases": [
                        "restrictive clothing",
                        "restrictive outfits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свызывающий, стесняющий или ограничивающий свободу движений тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стесняющий движения",
                                "target_lang_sense_clarification": "об одежде или ткани"
                            },
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "об одежде"
                            },
                            {
                                "target_lang_word": "сковывающий",
                                "target_lang_sense_clarification": "о движениях или одежде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "404599cf-b475-39a8-85bf-337a26d52bec",
                    "sense_definition": "A clause that narrows the meaning of a noun or noun phrase.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In grammar class, we learned how to distinguish a <w>restrictive</w> from a non-restrictive relative clause.",
                            "target_lang_translations": {
                                "ru": "На уроке грамматики мы учились отличать <w>ограничительное</w> определительное придаточное предложение от неограничительного."
                            }
                        },
                        {
                            "text": "The presence of a comma usually indicates that the clause is not a <w>restrictive</w>.",
                            "target_lang_translations": {
                                "ru": "Наличие запятой обычно указывает на то, что придаточное предложение не является <w>ограничительным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "restrictive clause"
                    ],
                    "antonyms": [
                        "non-restrictive"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определительное придаточное предложение, сужающее значение существительного (ограничительное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничительное придаточное",
                                "target_lang_sense_clarification": "в грамматике"
                            },
                            {
                                "target_lang_word": "ограничительный член",
                                "target_lang_sense_clarification": "в лингвистике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}