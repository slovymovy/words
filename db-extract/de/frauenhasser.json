                    },
                    {
                        "translation_id": "c9051e60-bd1b-4daa-bf49-7d023991876b",
                        "source_entry_id": "8a274582-f62d-3b4d-afa0-0965da5bfc0b",
                        "source_sense_id": "126f5f52-0544-3b91-a3ed-018d3dff770f",
                        "source_sense_description": "Person, die eine sehr starke Abneigung gegen Frauen hat",
                        "target_lang_word": "мизогини́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мизогини́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ad400118-78fe-3093-92d5-7ec68a90d6c8",
                                        "entry_id": "19153fe6-9338-37e4-8587-91b5f62e3aeb",
                                        "glosses": [
                                            "тот, кто страдает мизогинизмом (ненавистью к женщинам)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1db366e3-a18a-4959-bb4b-c6152bd5b04b",
                                                "sense_id": "ad400118-78fe-3093-92d5-7ec68a90d6c8",
                                                "text": "Не будучи так эпистолярно словоохотлив, как Довлатов, ты, наоборот, оставил после себя сплошные дифирамбы и панегирики, хотя мизантроп был не меньше, чем тот. Скорее, правда, мизогинист. Несмотря на позднюю женитьбу. Женатый мизогин. Мизогиния как часть мизантропии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
