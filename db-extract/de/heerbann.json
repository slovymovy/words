                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "046b4bb6-bdd1-3747-88b9-aec81826402d",
                        "entry_id": "625183a3-bedb-3d44-ba9b-ce59fa5ac772",
                        "glosses": [
                            "aufgebotenes Kriegsheer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56b9a2a2-5b3e-49cc-ae7f-f55af53cdb4f",
                                "sense_id": "046b4bb6-bdd1-3747-88b9-aec81826402d",
                                "text": "„Ein Heerbann zurückflutender Truppen zieht durch die Hauptstraßen.“"
                            },
                            {
                                "example_id": "8b677a0e-6195-439a-83ee-11d6d9bd171f",
                                "sense_id": "046b4bb6-bdd1-3747-88b9-aec81826402d",
                                "text": "„Das Recht, den Heerbann aufzubieten, gebührte dem König, dem damit ein entscheidendes, wenn nicht sogar das entscheidende Machtmittel zur Verfügung stand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
