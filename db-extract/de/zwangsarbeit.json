                    {
                        "translation_id": "fd2047f3-0620-4207-80ae-1f921578b695",
                        "source_entry_id": "0451c78c-d906-389a-bfd4-0e24f8c3687d",
                        "source_sense_id": "6d750d44-9c83-3fe2-8849-1e18a89a1e17",
                        "source_sense_description": "Arbeit, zu der man von jemandem unter Strafandrohung gezwungen wird",
                        "target_lang_word": "travaux forcés",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "travaux forcés",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15a76710-d4d4-3035-a2d8-5bcd827b5e8a",
                                        "entry_id": "9a2bb0aa-edf7-3c1e-bdeb-911e169a96b1",
                                        "glosses": [
                                            "Peine, prononcée par la justice pénale, de privation de liberté dans un établissement où le travail est obligatoire et sans rémunération."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0fbdac9-9063-410d-a2d9-3e4f2e44c32d",
                                                "sense_id": "15a76710-d4d4-3035-a2d8-5bcd827b5e8a",
                                                "text": "Si le déporté rentre sur le territoire du Royaume, il sera, sur la seule preuve de son identité, condamné aux travaux forcés à perpétuité."
                                            },
                                            {
                                                "example_id": "3f5d1d9b-840b-4e6a-a676-688398e363fe",
                                                "sense_id": "15a76710-d4d4-3035-a2d8-5bcd827b5e8a",
                                                "text": "Certaines pièces ont pour but d'établir l’identité des fiancés et de prévenir par là les bigamies éventuelles, comme si la menace des travaux forcés qui punissent encore chez nous cette variété rare de l’adultère, ne suffisait pas à faire réfléchir les époux trop ambitieux."
                                            },
                                            {
                                                "example_id": "c1b2dab8-6fa8-4acb-adea-80c970ed29be",
                                                "sense_id": "15a76710-d4d4-3035-a2d8-5bcd827b5e8a",
                                                "text": "le 1ᵉʳ octobre 326, Constantin prescrivit de commuer en travaux forcés ad metalla les condamnations ad bestias et tarit de sa principale ressource le recrutement de la gladiature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
