                                "sense_id": "29251309-7f8c-36de-b498-727ee44a3216",
                                "text": "Het hemelbed in het hotel gaf een vleugje luxe.",
                                "translation": "The canopy bed in the hotel added a touch of luxury.",
                                "english": "The canopy bed in the hotel added a touch of luxury."
                            },
                            {
                                "example_id": "68b4a4a8-9a7f-44a3-946f-ac8e642b988c",
                                "sense_id": "29251309-7f8c-36de-b498-727ee44a3216",
                                "text": "Ze droomde altijd van een hemelbed als klein meisje.",
                                "translation": "She always dreamt of a canopy bed as a little girl.",
                                "english": "She always dreamt of a canopy bed as a little girl."
                            },
