    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eaaf476d-82eb-367f-b33e-e69627748752",
                    "sense_definition": "Happening at the beginning; first.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_first",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>initial</w> reaction to the news was one of complete surprise.",
                            "target_lang_translations": {
                                "ru": "Моя <w>первоначальная</w> реакция на новости была полным удивлением.",
                                "zh": "我对这条新闻的<w>最初</w>反应是完全的惊讶。"
                            }
                        },
                        {
                            "text": "The <w>initial</w> stage of the project involves gathering all necessary data.",
                            "target_lang_translations": {
                                "ru": "<w>Начальная</w> стадия проекта включает сбор всех необходимых данных.",
                                "zh": "该项目的<w>初始</w>阶段包括收集所有必要的数据。"
                            }
