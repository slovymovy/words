                ],
                "senses": [
                    {
                        "sense_id": "4fb6f35f-7707-378e-bd21-3a71c2f1eeb5",
                        "entry_id": "32f9ec7f-1920-3a4f-968f-96104c47c3cb",
                        "glosses": [
                            "winterlicher Baumschaden, verursacht durch das Gewicht von Nassschnee, Eis oder Raureif"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e33bc3-1776-494d-9db6-9ae6778c2466",
                                "sense_id": "4fb6f35f-7707-378e-bd21-3a71c2f1eeb5",
                                "text": "Aufgrund des nassen Schnees besteht in den Wäldern Südbayerns erhöhte Gefahr von Schneebruch."
                            },
                            {
                                "example_id": "16521238-27a4-4171-9332-fc9e790fc01d",
                                "sense_id": "4fb6f35f-7707-378e-bd21-3a71c2f1eeb5",
                                "text": "„Da zu frei stehende Bäume dem Duftbruche, zu geschlossene Hölzer aber dem Schneebruche vorzugsweise unterworfen sind, beide Uebel jedoch oft in einer und derselben Gegend beisammen vorkommen, so muß der Forstmann in den rauhen Gegenden einen richtigen Mittelweg zu treffen suchen.“ (1860)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
