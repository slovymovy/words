                "senses": [
                    {
                        "sense_id": "2b06be93-713e-3008-82a3-e8d835f0ea9b",
                        "entry_id": "23dc49c9-7c96-3537-a16e-e5e654202b08",
                        "glosses": [
                            "Qui peut être changé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da34625c-dac5-43de-afa2-62041478cdd1",
                                "sense_id": "2b06be93-713e-3008-82a3-e8d835f0ea9b",
                                "text": "Or, le caractère d’une nation, modifiable très-lentement à travers les siècles, toujours très-particulier, est moins changeable encore que celui d’un individu, lequel lui-même ne se change guère."
                            },
                            {
                                "example_id": "18129816-38bf-4f67-af23-bd73c5ddb1f5",
                                "sense_id": "2b06be93-713e-3008-82a3-e8d835f0ea9b",
                                "text": "Dans son ouvrage Hakadhā Takallama Ibn ʿArabī (Ainsi parlait Ibn ʿArabī), Abū Zayd souligne que la charīʿa a un aspect intérieur et un autre extérieur ; elle est une expression linguistique et historique changeable d’une vérité immuable."
                            },
                            {
                                "example_id": "b75fc96d-1e8d-490d-89a4-1f6ee7b378df",
                                "sense_id": "2b06be93-713e-3008-82a3-e8d835f0ea9b",
                                "text": "Tout ceci en envisageant avec le patient ce qui est changeable à court terme, changeable à long terme, et ce qui ne l’est pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a5afbc-b7da-4fed-bdcb-9eb8ac0271cd",
                        "source_entry_id": "23dc49c9-7c96-3537-a16e-e5e654202b08",
                        "source_sense_id": "2b06be93-713e-3008-82a3-e8d835f0ea9b",
