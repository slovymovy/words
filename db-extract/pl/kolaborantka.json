                        "source_sense_id": "486b8e49-7f4e-3fe7-8ebf-1f6e25cf7a57",
                        "target_lang_word": "collaboratrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collaboratrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65e4fac4-2607-3fe7-8dbf-f70ae589727b",
                                        "entry_id": "70b6e0a5-7cc3-372a-8936-eadaedf7da7c",
                                        "glosses": [
                                            "Celle qui travaille de concert avec un ou plusieurs autres à une œuvre commune."
                                        ],
                                        "tags": [
                                            "Travail"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed325b89-6d7d-4ece-8ce0-3c873c47f15e",
                                                "sense_id": "65e4fac4-2607-3fe7-8dbf-f70ae589727b",
                                                "text": "Une collaboratrice aussi à qui mère Saint Jean peut tout demander, serait-ce aux dépens de sa vie de prière, et d’une santé encore mal affermie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7ae9da7-c40d-3360-b10a-f2576c06c5c3",
                                        "entry_id": "70b6e0a5-7cc3-372a-8936-eadaedf7da7c",
                                        "glosses": [
                                            "Employée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4728cde-38ea-4cdd-a201-82afdea040d1",
                                                "sense_id": "e7ae9da7-c40d-3360-b10a-f2576c06c5c3",
                                                "text": "Il est suivi en direct par le préfet de police et sa nouvelle collaboratrice, une certaine Martine Ferret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd75c7cb-5fee-3418-8a5f-1098962ca890",
                                        "entry_id": "70b6e0a5-7cc3-372a-8936-eadaedf7da7c",
                                        "glosses": [
                                            "Nom donné, pendant la Seconde Guerre mondiale, aux citoyennes des pays occupés qui montraient de la complaisance envers l’occupant ou travaillaient en collaboration avec lui."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6ccff89-4705-3133-940c-7a9e54adeb9a",
                                        "entry_id": "70b6e0a5-7cc3-372a-8936-eadaedf7da7c",
                                        "glosses": [
                                            "Celle qui travaille avec un ennemi."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
