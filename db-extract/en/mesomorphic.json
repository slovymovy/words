                "senses": [
                    {
                        "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                        "entry_id": "eeb71c6f-3832-38e1-b567-ab937b096829",
                        "glosses": [
                            "Of or pertaining to phases of matter intermediate between solid and liquid; of or pertaining to liquid crystals."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac1490a4-4b57-4dc3-babd-d0316cd983bc",
                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                "text": "1958, Chemical Society (Great Britain), G. W. Gray, Steric Effects in Conjugated Systems, page 161,\nChanges in the chemical constitution of a mesomorphic compound may therefore radically alter the mesomorphic properties and thermal stabilities."
                            },
                            {
                                "example_id": "883a1c0d-fb28-44a2-9b7c-cdae20118daf",
                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                "text": "1993, Nikolaĭ Alʹfredovich Platė (editor, original Russian edition), S. L. Schnur (translator), Liquid-Crystal Polymers, page 132,\nThis x-ray is typical of mesomorphic structures which occupy an intermediate position between crystalline and amorphous with respect to the degree of order."
                            },
                            {
                                "example_id": "c29ac327-b3f2-448b-90e7-fba8dee1e73f",
                                "sense_id": "46808042-c1c9-3dcd-8de8-dc58be66d7d5",
                                "text": "The thermodynamic conditions under which such a mesomorphic phase can interfere and affect the crystallization process are described in Fig. 5.40."
                            }
                        ]
                    }
                ],
