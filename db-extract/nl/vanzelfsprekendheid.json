        "nl-extract.jsonl": [
            {
                "entry_id": "62601c70-e33a-3bcd-9436-9f9d94e88e6c",
                "word": "vanzelfsprekendheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "dc620d97-04aa-4aa8-866c-d406f888d238",
                        "entry_id": "62601c70-e33a-3bcd-9436-9f9d94e88e6c",
                        "tags": [
                            "plural"
                        ],
                        "form": "vanzelfsprekendheden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                        "entry_id": "62601c70-e33a-3bcd-9436-9f9d94e88e6c",
                        "glosses": [
                            "iets dat zo logisch te verwachten is dat men het niet expliciet hoeft te vertellen of te bewijzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4384330-cba7-4009-9246-25e78a934345",
                                "sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                                "text": ",,Komt helemaal goed.”: Nou is dat laatste geen vanzelfsprekendheid in het Enschedese voetbal, weten ook deze 22 brave borsten die door schade en schande wijs lijken geworden."
                            },
                            {
                                "example_id": "f3ebd58f-56ad-426b-a32e-651ca1462b95",
                                "sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                                "text": "Het enthousiasme van de ondernemers is begrijpelijk. Meer omzet is in de winkelstraat al lang geen vanzelfsprekendheid meer. Ook de Bruna winkels hebben wat dat betreft slechte tijden gekend. Steur vindt die verhalen veel te somber. ,,Er is helemaal geen crisis in de winkelstraat. Vorig jaar was de omzet 1,7 procent lager dan het jaar daarvoor.”"
                            },
                            {
                                "example_id": "6cd4fd25-2388-4cc3-8482-4f8382ebb0d7",
                                "sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                                "text": "Ik ga er geen gewoonte van maken om evidenties te notuleren, maar één vanzelfsprekendheid deed mij bij herhaling zoveel plezier dat ik haar niet onvermeld wil laten."
                            },
                            {
                                "example_id": "c5996182-3298-4199-a8f5-8602c9aff3aa",
                                "sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                                "text": "Weliswaar was het Afrikaanse geld de absolute voorwaarde voor baron Von Freital geweest, tot aan de bruiloftsdag van zijn dochter beschouwde hij zichzelf als haar eigenaar, met dezelfde vanzelfsprekendheid waarmee hij zeilboten en kastelen bezat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fe6354e-83b8-48c3-8791-87dfad577fdc",
                        "source_entry_id": "62601c70-e33a-3bcd-9436-9f9d94e88e6c",
                        "source_sense_id": "3462a9b7-799c-360f-9920-c026c8b6acdf",
                        "source_sense_description": "iets dat zo logisch te verwachten is dat men het niet expliciet hoeft te vertellen of te bewijzen",
                        "target_lang_word": "surety",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surety",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8efb9568-dd09-386c-97c6-ff4426e4241c",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "Certainty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e191833-a12e-4746-8679-f8db3c50da06",
                                                "sense_id": "8efb9568-dd09-386c-97c6-ff4426e4241c",
                                                "text": "Know of a surety, that thy seed shall be a stranger in a land that is not theirs."
                                            },
                                            {
                                                "example_id": "6ee96a2c-0929-45b3-8df3-96f4dd5cad4f",
                                                "sense_id": "8efb9568-dd09-386c-97c6-ff4426e4241c",
                                                "text": "For the more surety they looked round about.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1614d96f-9430-3607-af94-260717d886ba",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "That which makes sure; that which confirms; ground of confidence or security."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b916bdb3-4fe2-4460-8cad-9a54561f9481",
                                                "sense_id": "1614d96f-9430-3607-af94-260717d886ba",
                                                "text": "[We] our happy state\nHold, as you yours, while our obedience holds;\nOn other surety none."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de9bec0-db23-3dd7-9b02-5ff743709353",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "A promise to pay a sum of money in the event that another person fails to fulfill an obligation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90aa0dfa-44dc-4041-82a7-9a67f2db11be",
                                                "sense_id": "6de9bec0-db23-3dd7-9b02-5ff743709353",
                                                "text": "There remains unpaid\nA hundred thousand more; in surety of the which\nOne part of Aquitaine is bound to us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427ee92d-bc55-3402-b332-55b3b51fa82a",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "One who undertakes to pay money or perform other acts in the event that his principal fails therein."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c4b16a0-b3b0-4d30-84df-2e3a1376f05c",
                                                "sense_id": "427ee92d-bc55-3402-b332-55b3b51fa82a",
                                                "text": "He that is surety for a stranger shall smart for it."
                                            },
                                            {
                                                "example_id": "9a9061c3-468e-40cf-ae5c-03bb2ec7b48c",
                                                "sense_id": "427ee92d-bc55-3402-b332-55b3b51fa82a",
                                                "text": "Trump’s lawyers said two days ago that to post a bond covering the full amount of the $454m civil fraud judgment against him while he appeals was “a practical impossibility” after 30 surety companies turned him down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fce233-e277-3e23-aec8-abd4a14b7925",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "A substitute; a hostage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57f92f47-892b-458e-b766-9924c23e0cf5",
                                                "sense_id": "c3fce233-e277-3e23-aec8-abd4a14b7925",
                                                "text": "...It happen’d on a solemn eventide,\nSoon after He that was our surety died,\nTwo bosom friends, each pensively inclined,\nThe scene of all those sorrows left behind,\nSought their own village, busied as they went\nIn musings worthy of the great event:\nThey spake of Him they loved, of Him whose life,\nThough blameless, had incurr’d perpetual strife,\nWhose deeds had left, in spite of hostile arts,\nA deep memorial graven on their hearts..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aa4188a-54b6-3a5b-8dec-2be3bd96e13b",
                                        "entry_id": "aa7a320e-3a4c-3855-b911-c3bc8d8f5af3",
                                        "glosses": [
                                            "Evidence; confirmation; warrant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f381fbe8-99f4-491f-a752-543f6c279f59",
                                                "sense_id": "0aa4188a-54b6-3a5b-8dec-2be3bd96e13b",
                                                "text": "She called the saints to surety,\nThat she would never put it from her finger,\nUnless she gave it to yourself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
