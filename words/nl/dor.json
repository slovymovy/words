                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>dorren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dor</w> van de dorst na die lange wandeling in de brandende zon.",
                            "target_lang_translations": {
                                "en": "I am <w>parched</w> with thirst after that long walk in the burning sun."
                            }
