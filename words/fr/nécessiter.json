                    "sense_definition": "Avoir besoin de manière indispensable ; rendre nécessaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "exigence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rénovation de cette ancienne maison <w>nécessite</w> plusieurs mois de travaux intensifs."
                        },
