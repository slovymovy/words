                                        "entry_id": "6ad89398-2251-38d4-923f-cfce219457b5",
                                        "glosses": [
                                            "One who swots; a boffin, nerd, or smart aleck."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "152c32dd-de02-4105-9e73-1607d4bf6948",
                                                "sense_id": "cf2d47c7-4249-3a16-a3a6-cb427abe67a2",
                                                "text": "He liked Tom all right... Sampson and Bullock he could do without, however. Especially Sampson, who was too much of a grammar-school-type swot ever to be quite the thing."
                                            },
                                            {
                                                "example_id": "8cccaf58-99e9-4b9c-ad9a-31364517326d",
                                                "sense_id": "cf2d47c7-4249-3a16-a3a6-cb427abe67a2",
                                                "text": "On first listen, Americans of a certain vintage would call one a Poindexter, while older Brits would regard the other as a swot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cefcd5d-24b3-3a86-99e8-339d95da9343",
                                        "entry_id": "6ad89398-2251-38d4-923f-cfce219457b5",
                                        "glosses": [
                                            "Work."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4286be2-e5c9-4386-be23-2ab9808fccfc",
                                                "sense_id": "3cefcd5d-24b3-3a86-99e8-339d95da9343",
                                                "text": "All I want is — guerre fini, soldat fini; and to go home without burden of any thought save music, and hard swot for a time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9c4f05-1366-3787-b8e4-5b4a953f096c",
