                                                "example_id": "d269ae29-83fe-4c62-9640-aba00a4b0a3a",
                                                "sense_id": "a73718bf-617a-3779-bca9-d6f8a45b0085",
                                                "text": "Or bring my action of conversion / And trover for my goods."
