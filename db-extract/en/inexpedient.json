                        "glosses": [
                            "Not expedient; not tending to promote a purpose; not tending to the end desired; unsuitable to time and place"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0bef8ff-29d7-4fa3-a3e9-d835955cf6f1",
                                "sense_id": "8809f26a-71ad-3a18-aafe-913a06d9da1a",
                                "text": "But the reputation of the Order must not be permitted to be endangered, and a case might occur, in which it would be inexpedient to extend this courtesy, and where the lodge would feel compelled to proceed to the trial and punishment of the offender, without appealing to his lodge."
                            }
                        ]
