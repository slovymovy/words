                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24583ef-56c6-4af8-93aa-79dbcbe8b3a8",
                                "sense_id": "d67b044b-a47e-3181-a72e-344c2e92eca5",
                                "text": "La limoselle aquatique se rencontre généralement sur le sable, les limons humides ou la vase."
                            },
                            {
                                "example_id": "462892de-a3e9-4fd0-a20b-fa1c5942844b",
                                "sense_id": "d67b044b-a47e-3181-a72e-344c2e92eca5",
                                "text": "Malgré sa propension à occuper les milieux humides des régions boréales, on trouve la limoselle aquatique au-delà de la limite des arbres au Groenland (Böcher, Holmen et Jakobsen, 1968) et en Islande (Kristinsson, 1987)."
                            }
                        ]
                    }
