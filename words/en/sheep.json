{
    "word_family": [
        "shepherd",
        "sheepish",
        "sheepdog",
        "sheepskin"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5c06965-1959-3960-bc9b-7de24a699aa2",
                    "sense_definition": "A farm animal with a thick woolly coat, raised for its meat, wool, and milk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer keeps a large flock of <w>sheep</w> in the green pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер держит большое стадо <w>овец</w> на зеленом пастбище.",
                                "zh": "农夫在绿色的牧场里养了一大群<w>绵羊</w>。"
                            }
                        },
                        {
                            "text": "We saw a white <w>sheep</w> eating grass near the fence.",
                            "target_lang_translations": {
                                "ru": "Мы увидели белую <w>овцу</w>, щиплющую траву у забора.",
                                "zh": "我们看见一只白色的<w>绵羊</w>在栅栏边吃草。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flock of sheep",
                        "black sheep",
                        "count sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сельскохозяйственное животное с густой шерстью, которое разводят ради мяса, шерсти и молока.",
                        "zh": "一种有厚羊毛的农场动物，饲养它是为了获取肉、毛和奶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овца",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "овечка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绵羊",
                                "target_lang_sense_clarification": "指代该物种"
                            },
                            {
                                "target_lang_word": "羊",
                                "target_lang_sense_clarification": "泛指羊类动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26753e22-a158-3e47-9c39-e6689ede6306",
                    "sense_definition": "A person who is timid, shy, or easily led by others without independent thought.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acts like a <w>sheep</w>, simply following the crowd instead of thinking for himself.",
                            "target_lang_translations": {
                                "ru": "Он ведет себя как <w>овца</w>, просто следуя за толпой, вместо того чтобы думать своей головой.",
                                "zh": "他就像个<w>随大流的人</w>，只会盲从大众，而不是自己思考。"
                            }
                        },
                        {
                            "text": "Don't be such a <w>sheep</w>; stand up for what you believe in.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>овцой</w>, отстаивай свои убеждения.",
                                "zh": "别做个<w>唯唯诺诺的人</w>，要坚持你所相信的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mouse",
                        "shrinking violet"
                    ],
                    "common_phrases": [
                        "follow like sheep"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe people"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который робок, застенчив или легко поддается влиянию других, не имея собственного мнения.",
                        "zh": "指性格胆小、害羞，或容易盲从他人、缺乏独立思考能力的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овца",
                                "target_lang_sense_clarification": "о робком, безынициативном человеке"
                            },
                            {
                                "target_lang_word": "агнец",
                                "target_lang_sense_clarification": "кроткий, безобидный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随大流的人",
                                "target_lang_sense_clarification": "指盲从者"
                            },
                            {
                                "target_lang_word": "唯唯诺诺的人",
                                "target_lang_sense_clarification": "指性格软弱、顺从的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9269ab77-c23b-3a6b-9341-1e36e86e7c24",
                    "sense_definition": "A member of a religious congregation or community.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pastor cares deeply for every <w>sheep</w> in his flock.",
                            "target_lang_translations": {
                                "ru": "Пастор глубоко заботится о каждой <w>овце</w> в своей пастве.",
                                "zh": "牧师深切地关怀着他<w>羊群</w>里的每一位信徒。"
                            }
                        },
                        {
                            "text": "The sermon was intended to guide the <w>sheep</w> back to the path of righteousness.",
                            "target_lang_translations": {
                                "ru": "Проповедь была призвана наставить <w>овец</w> на путь истинный.",
                                "zh": "这场布道的目的是引导<w>信徒</w>们重回正道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lost sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Член религиозной общины или паствы.",
                        "zh": "宗教团体或教会中的成员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "овца",
                                "target_lang_sense_clarification": "член паствы, верующий"
                            },
                            {
                                "target_lang_word": "агнец",
                                "target_lang_sense_clarification": "в религиозном контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信徒",
                                "target_lang_sense_clarification": "指宗教追随者"
                            },
                            {
                                "target_lang_word": "羊群",
                                "target_lang_sense_clarification": "比喻信众"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}