                    {
                        "sense_id": "3fbf16e5-77fe-3191-ab3b-05566900a085",
                        "entry_id": "51ad953f-4b16-32ed-abab-ecc5dadd330c",
                        "glosses": [
                            "Lack of logic; unreasonableness; a fallacy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d0df95b7-0a02-427c-96bc-33721514c04e",
                                "sense_id": "3fbf16e5-77fe-3191-ab3b-05566900a085",
                                "text": "And right often have I, the modern, been perturbed and vexed by the foolishness, illogic, obtuseness, and general all-round stupendous stupidity of myself, the primitive."
                            },
                            {
                                "example_id": "ec318730-de9b-44f6-aaa6-d7b550ccd784",
                                "sense_id": "3fbf16e5-77fe-3191-ab3b-05566900a085",
                                "text": "Mr Qaddafi, with a characteristic mix of bluntness and illogic, declared that his ideology was ‘theoretically’ a genuine democracy, but in reality, ‘the strong always rule.’"
                            }
                        ]
                    }
                ],
