                ],
                "senses": [
                    {
                        "sense_id": "f783fe11-13ef-3833-8c98-19ed04b6db8b",
                        "entry_id": "c3e684bb-296e-3469-9dab-33c66bf0f3a5",
                        "glosses": [
                            "Dorf in den Bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33195745-f35f-4af5-9bfd-760def439a98",
                                "sense_id": "f783fe11-13ef-3833-8c98-19ed04b6db8b",
                                "text": "Das Bergdorf ist im Winter oft nur zu Fuß erreichbar."
                            },
                            {
                                "example_id": "74a7a575-7d05-4f33-a4ee-69d0db4fdba6",
                                "sense_id": "f783fe11-13ef-3833-8c98-19ed04b6db8b",
                                "text": "Das Leben im Bergdorf ist meistens beschwerlich und voller Entbehrungen."
                            },
                            {
                                "example_id": "838d7a03-4d14-40fb-b428-41d8b5f115a2",
                                "sense_id": "f783fe11-13ef-3833-8c98-19ed04b6db8b",
                                "text": "Die Rebellen zogen sich zum Schutz vor Verfolgung in die umliegenden Bergdörfer zurück."
                            },
                            {
                                "example_id": "8bde9154-c8b4-4c1e-9995-ab3da6d8e390",
                                "sense_id": "f783fe11-13ef-3833-8c98-19ed04b6db8b",
                                "text": "Viele Bergdörfer sind bereits verlassen und verfallen langsam."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
