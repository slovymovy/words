                    },
                    {
                        "translation_id": "ce9f2357-bea3-4b4e-a717-6255ce908ab7",
                        "source_entry_id": "27043839-5310-38c0-a87e-bc3da860ae1b",
                        "source_sense_id": "aff7b73e-d0fe-3a37-bcfc-8397685a3dbc",
                        "source_sense_description": "member",
                        "target_lang_word": "Neuplatoniker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuplatoniker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                        "entry_id": "dfb00a67-c90a-3eed-9c8a-f1c5178f7888",
                                        "glosses": [
                                            "Anhänger der philosophischen Strömung des Neuplatonismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242017a1-26bb-4c7e-9db0-c4d7f8895a5c",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Der wichtigste Neuplatoniker war Plotin (ca. 205–270), der in Alexandria Philosophie studierte, später jedoch nach Rom umzog.“"
                                            },
                                            {
                                                "example_id": "4a0a950d-84f6-47cf-b495-2d324b450253",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Bei Aristoteles war die aporetische Methode eine Methode wirklicher Forschung gewesen. Bei den Alexandrinern und im wesentlichen auch bei den Neuplatonikern wurde sie zu einer Methode der Exegese.“"
                                            },
                                            {
                                                "example_id": "eea4c70a-1ce1-475a-96ff-9fe610db090d",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Hier hingen am Munde eines Gemistho Plethon des Neuplatonikers, eines Marsiglio Ficino und Pico della Mirandola auch Deutsche, die dann als unschätzbares Gut Liebe und Kenntnis der griechischen Sprache mit nach Deutschland brachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d22e6bee-8cd8-4d69-bb31-2d085f78f770",
                        "source_entry_id": "27043839-5310-38c0-a87e-bc3da860ae1b",
                        "source_sense_id": "aff7b73e-d0fe-3a37-bcfc-8397685a3dbc",
                        "source_sense_description": "member",
                        "target_lang_word": "Neuplatonikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuplatonikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcc36ac0-899e-3e17-9c48-ef645bb56fa1",
                                        "entry_id": "a759233a-ccd9-3ca9-8044-b47259e8bfe5",
                                        "glosses": [
                                            "Anhängerin der philosophischen Strömung des Neuplatonismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7116f533-a9ce-43de-b78c-d32d177cb7d5",
                                                "sense_id": "fcc36ac0-899e-3e17-9c48-ef645bb56fa1",
                                                "text": "„Die Neuplatonikerin Hypatia, Tochter des gleichfalls prominenten Philosophen Theon von Alexandria und – wie nicht nur ihr Schüler Synesios zu bezeugen weiß – nach Gelehrsamkeit und Ausstrahlung die bedeutendste Persönlichkeit des alexandrinischen Kultur- und Hochschulbetriebes dieser Jahre, fiel im März 415 dem Wüten eines christlichen Mobs unter Führung eines städtischen Klerikers, des Anagnosten Peter, zum Opfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
