                    },
                    {
                        "sense_id": "0003ab73-2641-3107-919d-ec9f4766fe89",
                        "entry_id": "f489fe4c-c128-3f91-b78a-953d18650edd",
                        "glosses": [
                            "принадлежащий осине"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2be62a8c-88bc-387d-b38b-0361af08b89a",
                        "entry_id": "f489fe4c-c128-3f91-b78a-953d18650edd",
                        "glosses": [
                            "сделанный, изготовленный из осины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0efe994-0b7d-4771-9f5d-e05efdaab9bf",
                                "sense_id": "2be62a8c-88bc-387d-b38b-0361af08b89a",
                                "text": "Орловский мужик .. живёт в дрянных осиновых избёнках, ходит на барщину .."
                            },
                            {
                                "example_id": "a5bb4d9c-f7d6-47ef-bf94-8305b1b2f19f",
                                "sense_id": "2be62a8c-88bc-387d-b38b-0361af08b89a",
                                "text": "Посредине двора были сложены отсыревшие сажени осиновых дров .."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
