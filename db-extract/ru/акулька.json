                "senses": [
                    {
                        "sense_id": "b247ccd8-07c1-3449-a7dd-28db58184a50",
                        "entry_id": "4dfffa4b-1e47-343a-a57b-05e267817eda",
                        "glosses": [
                            "разг. детская карточная игра с очень простыми правилами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94530e5f-54ec-4f68-b71d-35340892c0c6",
                                "sense_id": "b247ccd8-07c1-3449-a7dd-28db58184a50",
                                "text": "Он опять играл и выиграл, конечно, в «акульку»: «Уж такой, значит, фарт»."
                            },
                            {
                                "example_id": "5889a50b-1ef5-4018-b477-29b8ec8530e3",
                                "sense_id": "b247ccd8-07c1-3449-a7dd-28db58184a50",
                                "text": "― Дозвольте взойти? В акульку перекинуться, либо орешков погрызть?"
                            },
                            {
                                "example_id": "fd355cb8-7f28-4596-aca7-824214e8c2fc",
                                "sense_id": "b247ccd8-07c1-3449-a7dd-28db58184a50",
                                "text": "В кухне Савельевна играла с дворником в подкидные дурачки и в акульку."
                            }
                        ]
                    }
                ],
