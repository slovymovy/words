                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Droom</w> niet je leven, maar leef je dromen.",
                            "target_lang_translations": {
                                "en": "Do not <w>dream</w> your life, but live your dreams.",
                                "ru": "Не <w>мечтай</w> о своей жизни, а живи своими мечтами.",
                                "pl": "Nie <w>przeżywaj</w> życia w marzeniach, lecz żyj swoimi marzeniami.",
                                "de": "<w>Träume</w> nicht dein Leben, sondern lebe deine Träume.",
                                "fr": "<w>Rêve</w> ta vie, mais vis tes rêves.",
                                "it": "Non <w>sognare</w> la tua vita, ma vivi i tuoi sogni.",
