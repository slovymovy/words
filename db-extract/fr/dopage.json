        "fr-extract.jsonl": [
            {
                "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                "word": "dopage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "23cdaba7-3edb-4e39-ac8d-9bb6f5e3ea07",
                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                        "tags": [
                            "plural"
                        ],
                        "form": "dopages"
                    },
                    {
                        "form_id": "95645dee-3873-4f5c-ada0-8cbdcb17ee45",
                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                        "tags": [],
                        "form": "doppage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                        "glosses": [
                            "Utilisation d’une drogue, d’un médicament ou d’une intervention biologique, que ce soit prohibé ou non, dans le but d’améliorer une performance physique, intellectuelle, psychique…"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2656c967-48ff-4a69-ae71-25b3215def31",
                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                "text": "Les cas de dopage se multiplient aux Jeux Olympiques."
                            },
                            {
                                "example_id": "13ff6c8e-bcaf-4f34-8389-8a47e0b4fa7e",
                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                "text": "Le dopage des cadres, des étudiants."
                            },
                            {
                                "example_id": "fb57f7f7-24bc-463d-8e48-df7210dd8aa4",
                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                "text": "La définition du dopage telle qu’on la connaît actuellement, nous renvoie à une liste de produits et de procédés qui est sans cesse en évolution."
                            },
                            {
                                "example_id": "181b091f-5764-4a4d-a3b8-6d99d20586d6",
                                "sense_id": "86d51fc5-d71a-3651-be20-14e388ae8999",
                                "text": "Géant du sport mondial accusé d’une cascade de tricheries et de dopage institutionnalisé, la Russie a été exclue pour deux ans des grandes compétitions internationales, dont deux éditions des Jeux olympiques, une sentence jeudi du Tribunal arbitral du sport."
                            }
                        ]
                    },
                    {
                        "sense_id": "a589718f-f161-3463-a622-0c463f9acd22",
                        "entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                        "glosses": [
                            "Ajout de petites quantités d’éléments, appelées impuretés, à un semi-conducteur pour en modifier les caractéristiques."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3cd9730d-418f-4c33-a32c-3f877665e076",
                        "source_entry_id": "52ca1044-2e53-35cd-87ef-0741c99d0267",
                        "source_sense_description": "Utilisation d’une drogue",
                        "target_lang_word": "Doping",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doping",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                        "entry_id": "391c1f94-d735-3d6d-9434-1ffb0168d10c",
                                        "glosses": [
                                            "Anwendung unerlaubter Substanzen zur Leistungssteigerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac5729b7-90b1-449c-99d8-b81f7dea8a6c",
                                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                                "text": "In der DDR war Doping anscheinend an der Tagesordnung."
                                            },
                                            {
                                                "example_id": "fccec226-6ace-44f2-b72a-6492a17b1a4c",
                                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                                "text": "„Es wäre natürlich der Idealfall, dass Doping gar nicht stattfindet, so wie es im Idealfall nur gute Menschen geben sollte.“"
                                            },
                                            {
                                                "example_id": "9462ff77-119e-4388-a717-95f70d6f8420",
                                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                                "text": "„Die so lange verbreitete Mär, dass Doping im Fußball ›nichts bringen‹ würde, scheint damit wieder einmal widerlegt worden zu sein.“"
                                            },
                                            {
                                                "example_id": "2aca824d-e4fa-46a4-a7ee-5e1e95d40b40",
                                                "sense_id": "631ead37-49d1-39a6-8259-58179eeb264b",
                                                "text": "„Das war noch vor der Einführung von Speicheltests und anderen Methoden, mit denen künstlich aufgeputschte Pferde entlarvt werden sollten, zu einer Zeit, als Doping noch eine weitverbreitete Praxis war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
