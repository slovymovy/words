                    {
                        "sense_id": "6a0a90ac-50fb-3454-ba44-1e62a4c15e55",
                        "entry_id": "67ca1457-709e-38cf-a08e-d2f895c04dae",
                        "glosses": [
                            "gatunek winorośli pochodzącej z rejonów śródziemnomorskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bea03d0-8e0c-43b1-84df-e75b90529f5e",
                                "sense_id": "6a0a90ac-50fb-3454-ba44-1e62a4c15e55",
                                "text": "Na próżno kapela wygrywała skoczne dryganty, sztajery i menuety, liberia, w białych kosmatych surdutach, niestrudzenie roznosiła słodkie muszkatele i alikanty, a czarujące gospodynie usiłowały ożywić gnuśną zabawę - nuda nie dała się rozproszyć."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
