                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant praise had <w>besotted</w> him, making him arrogant and foolish.",
                            "target_lang_translations": {
                                "ru": "Постоянная похвала <w>одурманила</w> его, сделав высокомерным и глупым.",
