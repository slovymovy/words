                "senses": [
                    {
                        "sense_id": "273c44bf-b53b-3530-ae73-588e52c2f7da",
                        "entry_id": "da97da60-4302-3ad7-8417-002c52901568",
                        "glosses": [
                            "Maßnahme, die dazu dient, dass eine Webseite in den Trefferlisten von Internetsuchmaschinen auf den vorderen Plätzen erscheint"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "e3547697-7a10-4bc7-b87d-cbd735d982a1",
                                "sense_id": "273c44bf-b53b-3530-ae73-588e52c2f7da",
                                "text": "„Jedes Unternehmen setzt darauf, zukünftige und bereits bestehende Kunden und Mitarbeitern den Zugang zu Unternehmnsinformationen mobil zu bieten. 79 Prozent setzen auf Suchmaschinenoptimierung.“"
                            },
                            {
                                "example_id": "dfbc1875-d95b-4e4c-b4c7-99b93dd83d0f",
                                "sense_id": "273c44bf-b53b-3530-ae73-588e52c2f7da",
                                "text": "„Deswegen leisten sich viele Unternehmen, die im Netz noch bessere Geschäfte machen wollen, Experten für die Suchmaschinenoptimierung (SEO).“"
                            },
                            {
                                "example_id": "cd8c5ea6-7bac-4a2a-9b67-ceea4dd216c1",
                                "sense_id": "273c44bf-b53b-3530-ae73-588e52c2f7da",
                                "text": "„Durch Suchmaschinenoptimierung wird eine Seite innerhalb der organischen Suche weiter oben gerankt und so schneller gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
