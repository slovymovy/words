                    },
                    {
                        "form_id": "078e7c18-5707-40c8-b26a-3eebf30780ea",
                        "entry_id": "fcb3e84a-b63a-36bb-9535-dfbda1a35c4c",
                        "tags": [],
                        "form": "In bijdrage op internetfora en in digitale persoonlijke berichten wordt soms opzettelijk de spelling \"weodend\" gebruikt als nabootsing van een uit opwinding gemaakte spelfout."
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                        "entry_id": "fcb3e84a-b63a-36bb-9535-dfbda1a35c4c",
                        "glosses": [
                            "bijzonder boos, heel erg kwaad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4d89bc-1384-44d7-8cbc-f222e0b2e06e",
                                "sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                                "text": "Het openbaarde een afhankelijkheid in haar die haar woedend maakte."
                            },
                            {
                                "example_id": "46bcafc9-638a-415b-962e-db760c5870a8",
                                "sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                                "text": "Maar tegelijk voelt de mens zich ook bezorgd, woedend en angstig."
                            },
                            {
                                "example_id": "2e0b9261-c0ff-4420-9efc-4467cbd16a4a",
                                "sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                                "text": "Zijn woedende vader gaf hem een week huisarrest."
                            },
                            {
                                "example_id": "2f35e0d2-70d9-40ac-acce-8268b1256760",
                                "sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                                "text": "Wanneer iemand woedend is wordt dat gezien als een graadje erger na kwaad zijn en twee graden erger dan boos zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad7b1dc6-3f42-45c6-a5ad-47272b4125e9",
                        "source_entry_id": "fcb3e84a-b63a-36bb-9535-dfbda1a35c4c",
                        "source_sense_id": "32d2b2c4-8f2e-3f1b-877e-db336373d7d5",
                        "source_sense_description": "bijzonder boos",
                        "target_lang_word": "wütend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wütend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b75cbfd-c9d0-3647-8b82-fc910e89003a",
                                        "entry_id": "3012e2a7-d83b-3bb2-b511-d5a274f86764",
                                        "glosses": [
                                            "sich in einem Zustand der Wut befindend, einen erregten Gemütszustand habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae86cb22-0bef-4ae4-b121-c5c15d418c4a",
                                                "sense_id": "2b75cbfd-c9d0-3647-8b82-fc910e89003a",
                                                "text": "Meine Mutter wurde wütend, als ich ihr erzählt habe, dass ich das Fenster kaputt gemacht habe."
                                            },
                                            {
                                                "example_id": "6b4d4569-e41b-47f3-93fd-3b0eecdee26e",
                                                "sense_id": "2b75cbfd-c9d0-3647-8b82-fc910e89003a",
                                                "text": "„In Hallstadt in Oberfranken ist eine Frau in einer Zahnarztpraxis derart wütend geworden, dass die Polizei kommen musste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
