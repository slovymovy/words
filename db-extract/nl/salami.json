                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a576f229-7773-4d76-adc3-1675ce37b620",
                                                "sense_id": "6e4588ad-325e-3208-b140-6b00f8d2c6c6",
                                                "text": "To this day Katie thought wistfully of the night in his apartment when his salami had split her loins sending her into a state of sexual ecstasy unmatched in human history."
                                            }
                                        ]
                                    }
                                ]
                            }
