                        ]
                    },
                    {
                        "translation_id": "c8d70700-60b8-4b8c-8f22-272f9c630ec3",
                        "source_entry_id": "769da1ed-b527-302b-9d66-01d4978d057f",
                        "source_sense_id": "46918de3-b51e-36ab-8e40-79544b422521",
                        "target_lang_word": "tombereau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tombereau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "161e53ff-f00f-3501-95a6-d62c0946b3cd",
                                        "entry_id": "d1d91a6e-6a31-3d6f-8848-bed5003b6cd8",
                                        "glosses": [
                                            "Véhicule hippomobile à deux roues destiné au transport de marchandises, et que l’on bascule pour vider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0e7fd8b-0157-4932-be76-8d9c44c4e282",
                                                "sense_id": "161e53ff-f00f-3501-95a6-d62c0946b3cd",
                                                "text": "Un tombereau de choux et un tombereau de pois, au pont de Neuilly, s’étaient joints aux huit voitures de navets et de carottes qui descendaient de Nanterre ; et les chevaux allaient tout seuls, la tête basse, de leur allure continue et paresseuse, que la montée ralentissait encore."
                                            },
                                            {
                                                "example_id": "742702bf-fe1e-4856-b099-9fc89137cce6",
                                                "sense_id": "161e53ff-f00f-3501-95a6-d62c0946b3cd",
                                                "text": "Ce n’est pas un cheval irritable, […] qu’il faut pour conduire la charrue ou traîner le tombereau dans les champs !"
                                            },
                                            {
                                                "example_id": "e05c5c7b-157f-4fb3-b32e-1d177f0fc07f",
                                                "sense_id": "161e53ff-f00f-3501-95a6-d62c0946b3cd",
                                                "text": "Il crut marcher une dernière fois dans la grande rue, criblée de soleil, parmi les tas de fumier, suant les flots noirs de purin, et les vieux tombereaux, dont les chaînes lui avaient servi de « chargantoir » , quand il était enfant."
                                            },
                                            {
                                                "example_id": "212ea0c5-9ccf-4faa-b496-364e5a9d201c",
                                                "sense_id": "161e53ff-f00f-3501-95a6-d62c0946b3cd",
                                                "text": "Lorsque, le lendemain, Denise se rendit avec Pépé chez l'oncle Baudu, la rue était justement barrée par une file de tombereaux, qui déchargeaient des briques devant l'ancien hôtel Duvillard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9150b848-50cf-32db-8f3e-7ea0dba355a3",
                                        "entry_id": "d1d91a6e-6a31-3d6f-8848-bed5003b6cd8",
                                        "glosses": [
                                            "Ce qui est contenu dans un tombereau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07fa1d11-bb94-4583-b033-8f11a61c8722",
                                                "sense_id": "9150b848-50cf-32db-8f3e-7ea0dba355a3",
                                                "text": "Un tombereau de sable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4d96f6-a6f9-35a1-9d3a-67b527df53ab",
                                        "entry_id": "d1d91a6e-6a31-3d6f-8848-bed5003b6cd8",
                                        "glosses": [
                                            "Grande quantité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2abce0f-afe4-4add-8fd0-e011208cdf25",
                                                "sense_id": "ba4d96f6-a6f9-35a1-9d3a-67b527df53ab",
                                                "text": "Attends, avant de me textoter des tombereaux d’injures, lis ceci jusqu’au bout. — (Daniel Nayeri, Notre-Dame des Traîtres, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 233)"
                                            },
                                            {
                                                "example_id": "4be54329-722e-4094-91ac-84d58ec51ab7",
                                                "sense_id": "ba4d96f6-a6f9-35a1-9d3a-67b527df53ab",
                                                "text": "C'est chic, les réseaux sociaux, surtout quand ils servent aux internautes à déverser des tombereaux d'ordures racistes en se croyant à l'abri avec un pseudo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edb09dab-d60f-380c-b1ce-8972aee3a496",
                                        "entry_id": "d1d91a6e-6a31-3d6f-8848-bed5003b6cd8",
                                        "glosses": [
                                            "Engin de terrassement servant à transporter les matériaux extraits d’un chantier. Plus rarement camion-tombereau et tombereau-automoteur."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30114fbf-18ec-3194-abd3-4ada8686dab9",
                                        "entry_id": "d1d91a6e-6a31-3d6f-8848-bed5003b6cd8",
                                        "glosses": [
                                            "Automobile."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d51de7d9-c993-43f9-b774-7d88e1ecce0c",
                                                "sense_id": "30114fbf-18ec-3194-abd3-4ada8686dab9",
                                                "text": "Je fourre mon tombereau dans une impasse et je me guide par la main jusqu’à l'entrée de l’hôtel."
                                            },
                                            {
                                                "example_id": "9ad54641-f956-4d86-9f2f-d261762c0bce",
                                                "sense_id": "30114fbf-18ec-3194-abd3-4ada8686dab9",
                                                "text": "Je range ma roturière Zastava entre deux Mercedes. En mettant pied à terre, j’ai l’impression que mon tombereau a rétréci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
