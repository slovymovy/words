{
    "word_family": [
        "crudely",
        "crudeness",
        "crudity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e0ee2b7f-0e5c-3fbc-abb4-d3d917427f4a",
                    "sense_definition": "Existing in a natural or raw state; not yet processed or refined.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "natural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country exports vast amounts of <w>crude</w> oil to international markets.",
                            "target_lang_translations": {
                                "ru": "Страна экспортирует огромные объемы <w>сырой</w> нефти на международные рынки.",
                                "zh": "这个国家向国际市场出口大量的<w>原油</w>。"
                            }
                        },
                        {
                            "text": "They discovered a deposit of <w>crude</w> ore in the mountains.",
                            "target_lang_translations": {
                                "ru": "Они обнаружили месторождение <w>необработанной</w> руды в горах.",
                                "zh": "他们在山里发现了一个<w>未经加工的</w>矿床。"
                            }
                        }
                    ],
                    "synonyms": [
                        "raw",
                        "unrefined",
                        "unprocessed"
                    ],
                    "antonyms": [
                        "refined",
                        "processed"
                    ],
                    "common_phrases": [
                        "crude oil",
                        "crude metal",
                        "crude material"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в естественном или сыром состоянии; еще не обработанный или не очищенный.",
                        "zh": "处于自然或原始状态；尚未经过加工或提炼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыро́й",
                                "target_lang_sense_clarification": "о материалах, нефти"
                            },
                            {
                                "target_lang_word": "необрабо́танный",
                                "target_lang_sense_clarification": "о руде, данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原油",
                                "target_lang_sense_clarification": "指未经提炼的石油"
                            },
                            {
                                "target_lang_word": "未经加工的",
                                "target_lang_sense_clarification": "指原材料或矿石"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db056d25-12d7-30e2-b3e7-9a4f73a28e80",
                    "sense_definition": "Lacking tact, manners, or taste; offensive or vulgar.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was fired for making a <w>crude</w> joke during the meeting.",
                            "target_lang_translations": {
                                "ru": "Его уволили за <w>грубую</w> шутку во время собрания.",
                                "zh": "他因为在会议期间开了个<w>粗俗的</w>玩笑而被解雇了。"
                            }
                        },
                        {
                            "text": "I was shocked by his <w>crude</w> behavior at the dinner party.",
                            "target_lang_translations": {
                                "ru": "Я был шокирован его <w>вульгарным</w> поведением на званом ужине.",
                                "zh": "他在晚宴上<w>粗鲁的</w>行为让我感到震惊。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vulgar",
                        "coarse",
                        "rude",
                        "gross"
                    ],
                    "antonyms": [
                        "refined",
                        "sophisticated"
                    ],
                    "common_phrases": [
                        "crude joke",
                        "crude language",
                        "crude remark",
                        "crude humor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный такта, манер или вкуса; оскорбительный или вульгарный.",
                        "zh": "缺乏礼貌、教养或品味；冒犯性的或粗俗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гру́бый",
                                "target_lang_sense_clarification": "о поведении, шутках"
                            },
                            {
                                "target_lang_word": "вульга́рный",
                                "target_lang_sense_clarification": "пошлый, безвкусный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "粗俗的",
                                "target_lang_sense_clarification": "指言行举止不雅"
                            },
                            {
                                "target_lang_word": "粗鲁的",
                                "target_lang_sense_clarification": "指缺乏礼貌"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f6bbf9f-1399-3b92-96ee-a1c844966489",
                    "sense_definition": "Made or done in a simple or rough way, without much skill or detail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "simplicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castaways built a <w>crude</w> shelter to protect themselves from the rain.",
                            "target_lang_translations": {
                                "ru": "Потерпевшие кораблекрушение построили <w>примитивное</w> убежище, чтобы укрыться от дождя.",
                                "zh": "遇难者们搭建了一个<w>简陋的</w>避难所来躲雨。"
                            }
                        },
                        {
                            "text": "These figures are just a <w>crude</w> estimate of the final cost.",
                            "target_lang_translations": {
                                "ru": "Эти цифры — лишь <w>грубая</w> оценка итоговой стоимости.",
                                "zh": "这些数字只是对最终成本的一个<w>粗略的</w>估算。"
                            }
                        }
                    ],
                    "synonyms": [
                        "primitive",
                        "rough",
                        "rudimentary",
                        "undeveloped"
                    ],
                    "antonyms": [
                        "sophisticated",
                        "advanced"
                    ],
                    "common_phrases": [
                        "crude shelter",
                        "crude drawing",
                        "crude estimate",
                        "crude weapon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный просто или грубо, без особого мастерства или деталей.",
                        "zh": "以简单或粗糙的方式制作或完成，缺乏技巧或细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примити́вный",
                                "target_lang_sense_clarification": "простой конструкции"
                            },
                            {
                                "target_lang_word": "гру́бый",
                                "target_lang_sense_clarification": "приблизительный, неточный"
                            },
                            {
                                "target_lang_word": "куста́рный",
                                "target_lang_sense_clarification": "самодельный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "简陋的",
                                "target_lang_sense_clarification": "指结构简单、质量不高"
                            },
                            {
                                "target_lang_word": "粗略的",
                                "target_lang_sense_clarification": "指估算或估计不精确"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9b23a26-f912-3c89-abb7-e1253d291f23",
                    "sense_definition": "Expressed simply and directly, without trying to be polite or hide the truth.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "simplicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He faced the <w>crude</w> reality of his situation without fear.",
                            "target_lang_translations": {
                                "ru": "Он без страха взглянул в лицо <w>суровой</w> реальности своей ситуации.",
                                "zh": "他无所畏惧地面对自己处境中<w>赤裸裸的</w>现实。"
                            }
                        },
                        {
                            "text": "The report presented the <w>crude</w> facts without any sugarcoating.",
                            "target_lang_translations": {
                                "ru": "В отчете были представлены <w>голые</w> факты без каких-либо прикрас.",
                                "zh": "这份报告呈现了<w>直白的</w>事实，没有任何粉饰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stark",
                        "blunt",
                        "undisguised",
                        "plain"
                    ],
                    "common_phrases": [
                        "crude truth",
                        "crude reality",
                        "crude fact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выраженный просто и прямо, без попыток быть вежливым или скрыть правду.",
                        "zh": "表达得简单直接，不加修饰或掩饰真相。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суро́вый",
                                "target_lang_sense_clarification": "о реальности"
                            },
                            {
                                "target_lang_word": "го́лый",
                                "target_lang_sense_clarification": "о фактах"
                            },
                            {
                                "target_lang_word": "неприкры́тый",
                                "target_lang_sense_clarification": "явный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赤裸裸的",
                                "target_lang_sense_clarification": "指事实或真相不加掩饰"
                            },
                            {
                                "target_lang_word": "直白的",
                                "target_lang_sense_clarification": "指表达方式直接"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4a6f27b9-c382-32cc-ac96-393db6525ac1",
                    "sense_definition": "Unrefined petroleum; oil in its natural state before processing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "natural_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economy depends heavily on the export of <w>crude</w>.",
                            "target_lang_translations": {
                                "ru": "Экономика сильно зависит от экспорта <w>сырой нефти</w>.",
                                "zh": "该国经济严重依赖<w>原油</w>出口。"
                            }
                        },
                        {
                            "text": "Investors are watching the fluctuating price of <w>crude</w> closely.",
                            "target_lang_translations": {
                                "ru": "Инвесторы внимательно следят за колебаниями цен на <w>нефть</w>.",
                                "zh": "投资者们正在密切关注<w>原油</w>价格的波动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "barrel of crude",
                        "price of crude",
                        "light crude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неочищенная нефть; нефть в естественном состоянии до переработки.",
                        "zh": "未经提炼的石油；处于自然状态、加工前的石油。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыра́я нефть",
                                "target_lang_sense_clarification": "нефтепродукт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "原油",
                                "target_lang_sense_clarification": "指未经加工的石油"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}