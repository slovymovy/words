                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c79c617e-f59d-4be9-9e5d-76024d841c19",
                        "source_entry_id": "1db77466-52a8-3265-a1ce-44c32347ecab",
                        "source_sense_id": "9a8db95e-a1ea-3fd2-99b7-d61c5b4316e9",
                        "target_lang_word": "баба с яйцами",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "баба с яйцами",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "09a5770c-8a0f-3573-aae1-d744ea1226fa",
                                        "entry_id": "86ee0192-3cc5-3939-9c57-851a89cd3ce8",
                                        "glosses": [
                                            "вульг.-прост., ирон. женщина, обладающая мужскими чертами характера и поведения, властная, своенравная или мужеподобная"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4879a4-e2d0-4b0d-a6a5-624219189f25",
                                                "sense_id": "09a5770c-8a0f-3573-aae1-d744ea1226fa",
                                                "text": "Вот поэтому Феофанов не стал за ней ухаживать. Милана относилась к категории женщин, про которых говорят: «баба с яйцами». Причём яйца её были стальными, если не чугунными. Сергея не обманывала её внешняя женственность. Он чувствовал силу Миланы, и она, пожалуй, превосходила его собственную."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7ef5f9-1150-3760-aa05-bb0d13558547",
                                        "entry_id": "86ee0192-3cc5-3939-9c57-851a89cd3ce8",
                                        "glosses": [
                                            "вульг.-прост., пренебр. мужчина, обладающий женскими чертами характера и поведения, слабохарактерный, трусливый или капризный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ebd6549-1dd7-4885-a9cf-5d7d9ffa6db6",
                                                "sense_id": "6e7ef5f9-1150-3760-aa05-bb0d13558547",
                                                "text": "Галина затряслась от злости: — Вы — подонок! Вы и ваши дружки — бабы с яйцами, которые трясутся только за свои портфели! Вы побоялись оказать сопротивление двум подросткам! Поэтому его убили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6786397-e438-3a8d-b7a2-c54b8e83c3cf",
                                        "entry_id": "86ee0192-3cc5-3939-9c57-851a89cd3ce8",
                                        "glosses": [
                                            "крим. жарг. мужеподобная лесбиянка, которая выполняет доминирующую роль в сексуальных отношениях"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
