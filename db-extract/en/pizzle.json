                                        "entry_id": "ccff8b07-c894-3110-b35a-ffba0f709a99",
                                        "glosses": [
                                            "Nerf pris sur un bœuf possédant des caractéristiques particulières de résistance, de flexibilité, d’élasticité."
                                        ],
