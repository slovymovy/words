                                        "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                        "entry_id": "e3a37690-2fa0-31fd-b6eb-149988284343",
                                        "glosses": [
                                            "Not willing; reluctant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ca90941-19ea-4286-89a1-ef8c8d0a1a61",
                                                "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                                "text": "an unwilling servant"
                                            },
                                            {
                                                "example_id": "0001c6e3-0401-4761-86cc-0c9a7d9a852c",
                                                "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                                "text": "We are unwilling to restore his previous privileges after his betrayal of our trust."
                                            },
                                            {
                                                "example_id": "ab82e27a-3adf-45a3-8bbb-d823be39c844",
                                                "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                                "text": "There was a prevailing fear of the effect of large undertakings becoming monopolistic, and Parliament showed itself unwilling to sanction any large groupings."
                                            },
                                            {
                                                "example_id": "06adafc5-cd60-480b-992e-a05d391ee8da",
                                                "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                                "text": "[...] but in the damp conditions prevailing the driver sensibly was unwilling to attempt the climb up through Combe Down tunnel without help, for fear of slipping to a standstill in the unventilated bore, [...]."
                                            },
                                            {
                                                "example_id": "45a993e0-7148-44a5-985d-d5ad7ed61ee9",
                                                "sense_id": "c08ed8e7-e2dc-3b3c-a12d-ecadad563a24",
                                                "text": "My son, a Canada-based IT professional who often travels to Ukraine, told me about the exhilarating atmosphere on those Ukraine-bound trains, bringing home hundreds of the unwilling refugees, mostly women and children (including the babies, born in exile on the way to meet their Ukrainian fighter fathers for the first time). The difference between Ukrainian refugees and other reluctant exiles is that Ukrainians are desperate to return."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34171b2a-8c32-42ec-acd1-de0c5c9c66b1",
                        "source_entry_id": "33f88046-933f-3c07-87af-5cb99d1fe010",
