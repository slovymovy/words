                "senses": [
                    {
                        "sense_id": "bd5f306f-cbac-354d-a2db-e33eea6e9a80",
                        "entry_id": "5f4cd643-f9ad-3f6c-822d-43ecf0dd4d79",
                        "glosses": [
                            "Lieu où se reproduisent les poissons et les batraciens (ou maintenant amphibiens) et par extension les mollusques et les crustacés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa129d90-2dd3-410d-8aa5-c352b67177b1",
                                "sense_id": "bd5f306f-cbac-354d-a2db-e33eea6e9a80",
                                "text": "Puis courbe ses reins vers la terre :\nce sont les rives, grèves lisses ;\nse retourne pieds contre terre :\nce sont frayères de saumon ;"
                            },
                            {
                                "example_id": "beeee735-ed49-401a-8b29-c100189cdc18",
                                "sense_id": "bd5f306f-cbac-354d-a2db-e33eea6e9a80",
                                "text": "Notre hypothèse est que le signal génétique associé à une mortalité plus élevée répond à un virus qui infecte les poissons avant qu'ils ne commencent à remonter les rivières et qui persiste jusqu'aux frayères."
                            },
                            {
                                "example_id": "934880cd-f12b-4867-b6ed-ab1ca3012252",
                                "sense_id": "bd5f306f-cbac-354d-a2db-e33eea6e9a80",
                                "text": "Le plus gros problème [hydrologique] en forêt est la pollution des ruisseaux par les fines qui colmatent les frayères."
                            }
                        ]
                    }
                ],
