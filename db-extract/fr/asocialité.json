                        "glosses": [
                            "Caractère d’une personne asociale, incapacité à vivre en société."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2b6784d-87b2-45f7-a16e-a7a706d0d139",
                                "sense_id": "6c79aec3-92ea-35c1-ae77-9a872c9678c8",
                                "text": "Affiner le tri de ces enfants contribue à pénaliser les situations sociales difficiles, et parmi celles-ci, à médicaliser celles où la violence et l’asocialité perturbent l’ordre moral."
                            }
                        ]
