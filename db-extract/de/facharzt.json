                "senses": [
                    {
                        "sense_id": "3be01bf7-282f-334a-a530-67e8561a43c2",
                        "entry_id": "159a4e46-5b25-32fa-80eb-0fdc3bdcf66c",
                        "glosses": [
                            "ein Arzt, der eine mehrjährige Weiterbildung absolviert und mit einer Facharztprüfung erfolgreich abgeschlossen hat"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "3ae5f8a2-5670-4f46-ab89-5946b76e7a6a",
                                "sense_id": "3be01bf7-282f-334a-a530-67e8561a43c2",
                                "text": "Ich rate Ihnen zu einem Besuch des Facharztes."
                            },
                            {
                                "example_id": "58784e84-0e1e-45bc-988a-d49cb2403550",
                                "sense_id": "3be01bf7-282f-334a-a530-67e8561a43c2",
                                "text": "„Ein anderer Facharzt stufte sie als geisteskranke, in ihrer Zurechnungsfähigkeit schwer beeinträchtigte Pyromanin ein.“"
                            },
                            {
                                "example_id": "8d46def4-424f-4619-acdd-4827c4a02cf7",
                                "sense_id": "3be01bf7-282f-334a-a530-67e8561a43c2",
                                "text": "„Heute sagte mir der Gehilfe Han, vor dem Tore gebe es einen Arzt Dschau mit vollem Namen Dschau Lung-gang, der Facharzt für Frauenleiden sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eec9d59-c33f-4068-b233-6c4e1e85d74a",
                        "source_entry_id": "159a4e46-5b25-32fa-80eb-0fdc3bdcf66c",
                        "source_sense_id": "3be01bf7-282f-334a-a530-67e8561a43c2",
