                "translations": [
                    {
                        "translation_id": "5665594f-38b7-4ee3-88ba-ac9b6c4dfeb0",
                        "source_entry_id": "88d99f9b-1ff8-312c-9d29-c28d7fc2c161",
                        "source_sense_id": "7fa38a5f-24e8-36a1-b94e-673ef20da666",
                        "source_sense_description": "Person, die jemandem gegen Gebühr oder Pfand zeitweise eine bestimmte Sache überlässt",
                        "target_lang_word": "lender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                        "entry_id": "70430b20-7c0d-3cb4-9d2f-b6ba6e52db77",
                                        "glosses": [
                                            "One who lends, especially money; specifically, a bank or other entity that specializes in granting loans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddfa1ae9-cc9b-437a-b09c-43a986ade09f",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "[Polonius]: Neither a borrower nor a lender be:\nFor loan oft loses both itself and friend;\nAnd borrowing dulls the edge of husbandry."
                                            },
                                            {
                                                "example_id": "c34b2921-734b-4fa8-94ce-d4dc7bf85555",
                                                "sense_id": "d5b49381-0f8f-3a95-8422-b416f26b968c",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms. Those that want to borrow are matched with those that want to lend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34fc4bb8-7d26-4285-8f08-1e20ef55059c",
                        "source_entry_id": "88d99f9b-1ff8-312c-9d29-c28d7fc2c161",
                        "source_sense_id": "7fa38a5f-24e8-36a1-b94e-673ef20da666",
                        "source_sense_description": "Person, die jemandem gegen Gebühr oder Pfand zeitweise eine bestimmte Sache überlässt",
                        "target_lang_word": "prêteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc72eab4-75a0-3756-9e99-4aa09a7468e3",
                                        "entry_id": "a04e73fb-87bc-3e7a-9426-23fd67ff6fe5",
                                        "glosses": [
                                            "Celui qui prête quelque chose à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b445ffc5-34ee-4cb0-b1bd-369f804c88c0",
                                                "sense_id": "cc72eab4-75a0-3756-9e99-4aa09a7468e3",
                                                "text": "Il n’est pas prêteur de son naturel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dafc34ff-c263-3ae7-ad63-422d615d8198",
                                        "entry_id": "a04e73fb-87bc-3e7a-9426-23fd67ff6fe5",
                                        "glosses": [
                                            "Personne qui fait le prêt d’argent moyennant des intérêts."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a681ecc3-c150-4359-ae63-7bac93256545",
                                                "sense_id": "dafc34ff-c263-3ae7-ad63-422d615d8198",
                                                "text": "Le départ des juifs n’avait pas supprimé les embarras financiers de leurs clients et ceux qui avaient besoin de capitaux n’eurent d’autre ressource que de s’adresser aux prêteurs chrétiens (lombards ou cahorsins)."
                                            },
                                            {
                                                "example_id": "540923f4-f33f-4e5b-bf8b-6a5349410a71",
                                                "sense_id": "dafc34ff-c263-3ae7-ad63-422d615d8198",
                                                "text": "L’appât du gain peut amener les clercs à des activités indignes de leur condition : à La Gahandière, en 1634, il s’agit de trafics de toutes sortes. Le curé présente son activité de prêteur comme une œuvre charitable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
