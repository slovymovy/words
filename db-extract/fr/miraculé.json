                        ],
                        "examples": [
                            {
                                "example_id": "5fc9aa7a-8c90-4713-b013-6052d0ac711c",
                                "sense_id": "d1f865c2-e765-3069-a5f9-6af4cb64f75a",
                                "text": "2025 (11 February), Ana Fernández, \"Un miraculé devenu symbole des peurs du métro new-yorkais\", La Presse",
                                "translation": "When Joseph Lynskey was pushed onto the tracks of the New York subway on New Year's Eve, he immediately understood that he was the victim of one of the acts of extraordinary violence that haunt the American megalopolis. The miraculously rescued man can now talk about his experience.",
                                "english": "When Joseph Lynskey was pushed onto the tracks of the New York subway on New Year's Eve, he immediately understood that he was the victim of one of the acts of extraordinary violence that haunt the American megalopolis. The miraculously rescued man can now talk about his experience."
                            }
                        ]
                    }
