                        "entry_id": "cc742bd2-c668-38af-9323-7cff67b4a47e",
                        "glosses": [
                            "erhebliche Beeinträchtigung des Befindens durch Schmerzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2098f3-706c-4c17-a26b-4c085a644a73",
                                "sense_id": "610cfb1b-1097-3dbc-8f35-f2ec7e768dcc",
                                "text": "„Zu den auf diese Weise behandelten Störungen gehören die Epilepsie, zentrale Schmerzzustände, Schlaflosigkeit, Angstzustände und Depressionen, unkontrollierbare Gewalttätigkeit und einige Abarten der Schizophrenie.“"
                            },
                            {
                                "example_id": "3df87744-6731-4140-a8b8-fb118929df51",
                                "sense_id": "610cfb1b-1097-3dbc-8f35-f2ec7e768dcc",
                                "text": "„Darüber hinaus können Muskelverspannungen aufgespürt und gelockert und damit Schmerzzustände verringert werden.“"
                            }
                        ],
