                "senses": [
                    {
                        "sense_id": "741a6c26-3746-3a36-b40e-b46bb1945a44",
                        "entry_id": "63f03a11-ddba-3540-834e-68ca732b4f12",
                        "glosses": [
                            "dehydrogenase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58726ae-a6fe-4dff-9b5a-0ca904833c0e",
                                "sense_id": "741a6c26-3746-3a36-b40e-b46bb1945a44",
                                "text": "It is shown by means of a typical dehydrase, Schardinger’s milk enzyme, that oxidase, reductase and mutase are 1 and the same enzyme."
                            },
                            {
                                "example_id": "a4fc6f4d-5342-4fca-b2c9-a5e33a00a1a0",
                                "sense_id": "741a6c26-3746-3a36-b40e-b46bb1945a44",
                                "text": "Citric acid dehydrase is present in the liver and in vegetable material acting on citric acid."
                            },
                            {
                                "example_id": "d4983da3-6ff9-484d-89a1-cea0e8f399cd",
                                "sense_id": "741a6c26-3746-3a36-b40e-b46bb1945a44",
                                "text": "Freudenberg also postulates a second process whereby catechins in the presence of dehydrases undergo condensation by dehydrogenation."
                            }
                        ]
                    },
                    {
                        "sense_id": "4280eeaf-25a4-39c1-9157-0229fb283465",
                        "entry_id": "63f03a11-ddba-3540-834e-68ca732b4f12",
                        "glosses": [
                            "dehydratase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b860c277-23d6-4b77-91a4-8a38a9fdfc70",
                                "sense_id": "4280eeaf-25a4-39c1-9157-0229fb283465",
                                "text": "The usual English term ‘dehydrase’ for an enzyme dehydrating a substrate was changed to dehydratase, because Dehydrase in German…means a dehydrogenating enzyme rather than an enzyme splitting off water."
                            },
                            {
                                "example_id": "cbb842f4-baa7-4067-b8bb-966f0509964a",
                                "sense_id": "4280eeaf-25a4-39c1-9157-0229fb283465",
                                "text": "The enzymic dehydration of tartaric acid to oxaloacetic acid, first established…for the d-isomer, occurs also with the meso- and l-isomers, and the attack on all three tartaric acids by bacteria of the genus Pseudomonas appears to occur principally by means of stereospecific dehydrases."
                            }
                        ]
                    }
