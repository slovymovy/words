                "forms": [
                    {
                        "form_id": "03e82af2-4076-48b5-a316-2c4aa9f0ad10",
                        "entry_id": "6f4738a8-8c49-366c-a298-13b6958eb5c1",
                        "tags": [
                            "plural"
                        ],
                        "form": "mènes"
