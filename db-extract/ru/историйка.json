                        "examples": [
                            {
                                "example_id": "92b90807-5d20-4147-95d2-f3676a017943",
                                "sense_id": "018b3f81-11b8-385d-bb4c-2248c14cd2c3",
                                "text": "Мне страх хоте́лось вы́тянуть из него́ каку́ю-нибудь исто́рийку — жела́ние, сво́йственное всем путеше́ствующим и запи́сывающим лю́дям.",
                                "translation": "I very badly wanted to get some sort of story out of him—a desire that is natural to anyone who travels about recording things.",
                                "english": "I very badly wanted to get some sort of story out of him—a desire that is natural to anyone who travels about recording things."
                            }
                        ]
                    }
