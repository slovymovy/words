                    {
                        "translation_id": "348a8c80-98a4-42a4-a43e-cba54292ef45",
                        "source_entry_id": "f40d625a-3cad-3d41-a88a-15d766b2a70f",
                        "source_sense_id": "219ffc1f-16f5-323f-9c41-02a3f87f1a27",
                        "source_sense_description": "Helianthus annuus, een tot 3 meter hoge plant met een grote gele bloem",
                        "target_lang_word": "Sonnenblume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenblume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                        "entry_id": "cf1cf8fd-9f10-37c1-bb97-37048ea16b14",
                                        "glosses": [
                                            "Pflanze mit hohem Stiel (bis über 2 m), rauen und großen Blättern und großer Blüte sowie mit gelben Blütenblättern (Helianthus annuus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ef07da-0f1a-4a93-8051-5ac102bf3665",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "Sonnenblumen sind sehr schöne Pflanzen, aus denen man Öl gewinnen kann."
                                            },
                                            {
                                                "example_id": "8644dbf3-acbf-4fe3-8cc8-b88db4d6ed28",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Meilenweit begleiten die Fahrstraße die breiten, goldgelb leuchtenden Bänder der blühenden wilden Sonnenblumen, der stattlichsten der hierzulande blühenden Pflanzen.“"
                                            },
                                            {
                                                "example_id": "9a6f7db2-a52f-423c-bc7f-161856ca947b",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Vor dem Fenster blühten hohe Sonnenblumen.“"
                                            },
                                            {
                                                "example_id": "e4ad4a35-810b-4e56-94f6-6408077bcbdc",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Der Anbau von Gerste, Zuckerrüben, Sonnenblumen, Faserflachs und Rotklee ist in den letzten Jahrzehnten auf Kosten von Hafer, Futterrüben und Kartoffeln erweitert worden.“"
                                            },
                                            {
                                                "example_id": "fc43a721-ccdf-4cbe-86ec-f2ad04a1b976",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Auf Fensterbrettern und Balkonen werden Tomaten gezüchtet in ausrangierten Kochtöpfen, Kürbisse und Sonnenblumen.“"
                                            },
                                            {
                                                "example_id": "72730c71-9da7-41b3-8bea-793382f77393",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Vor dem Haus auf dem Acker blühten noch die Sonnenblumen, deren Köpfe sich im Sommer immer mit der Sonne drehten, bis sie abends sehnsüchtig mit Blick südwest einschliefen.“"
                                            },
                                            {
                                                "example_id": "0bf13ed6-0d1e-45d1-9066-81f8e173ef31",
                                                "sense_id": "977e8bfc-c41d-340e-8a1d-478df4b762e0",
                                                "text": "„Nachts duftete der Wind nach tausend Kräutern und Büschen, und über den Feldern knackten die löwenmähnigen Sonnenblumen, wenn die kühle Feuchtigkeit der Nacht sie auf ihren armesdicken Stengeln zurückstauchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1feb7493-1400-302c-af25-7fa477d890cf",
                                        "entry_id": "cf1cf8fd-9f10-37c1-bb97-37048ea16b14",
                                        "glosses": [
                                            "in Nordamerika verbreitete Pflanzengattung (Helianthus) innerhalb der Familie der Korbblütler (Asteraceae), die rund 70 Arten umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
