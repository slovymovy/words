                        "examples": [
                            {
                                "example_id": "b0b43d13-4e4f-40d4-a4e4-9fc28e8e7274",
                                "sense_id": "b471b462-f4bb-3894-873b-605a0b8b28a8",
                                "text": "„Vielleicht hatte gerade dieser Film Alan so gut gefallen, daß er ihn noch einmal sehen wollte, oder ein Freund hatte ihn zu einem Stadtbummel überredet.“"
                            },
                            {
                                "example_id": "7271a1a5-d078-4872-a913-8878342e7cb2",
                                "sense_id": "b471b462-f4bb-3894-873b-605a0b8b28a8",
                                "text": "„Danach aber sollten wir uns trennen, Papa und ich sollten in ein Freibad gehen, und sie werde in die Stadt gehen und einen Stadtbummel machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
