                                                "example_id": "ffe0eb24-5baf-404e-82ca-c3e194fe2fc8",
                                                "sense_id": "2b64a88f-f889-3bfd-ad7c-0d5e80c6d7cc",
                                                "text": "La philosophie, d’abord servante, puis auxiliaire de la foi, devint ainsi sa rivale ; […]."
                                            }
                                        ]
                                    },
