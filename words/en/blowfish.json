{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17112eaa-26b9-3803-b726-63535e4d17df",
                    "sense_definition": "Any fish that can inflate its body like a balloon when threatened.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the predator approached, the <w>blowfish</w> quickly puffed up into a spiky ball.",
                            "target_lang_translations": {
                                "cs": "Když se přiblížil predátor, <w>čtverzubec</w> se rychle nafoukl do ostnaté koule."
                            }
                        },
                        {
                            "text": "The scuba divers were fascinated to see a tiny <w>blowfish</w> swimming near the coral reef.",
                            "target_lang_translations": {
                                "cs": "Potápěči byli fascinováni pohledem na malého <w>čtverzubce</w>, který plaval poblíž korálového útesu."
                            }
                        }
                    ],
                    "synonyms": [
                        "balloonfish",
                        "globefish",
                        "puffer",
                        "pufferfish",
                        "swellfish"
                    ],
                    "common_phrases": [
                        "poisonous blowfish"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ryba, která se při ohrožení dokáže nafouknout jako balónek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čtverzubec",
                                "target_lang_sense_clarification": "zoologický název ryby"
                            },
                            {
                                "target_lang_word": "nafukovací ryba",
                                "target_lang_sense_clarification": "popisné označení"
                            },
                            {
                                "target_lang_word": "ježík",
                                "target_lang_sense_clarification": "druh s ostny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a302c865-95d3-3b5b-a99b-95730084487e",
                    "sense_definition": "The flesh of this fish eaten as a delicacy, especially in Japanese cuisine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only specially licensed chefs are permitted to prepare <w>blowfish</w> in Japanese restaurants.",
                            "target_lang_translations": {
                                "cs": "V japonských restauracích smějí <w>fugu</w> připravovat pouze šéfkuchaři se speciální licencí."
                            }
                        },
                        {
                            "text": "He decided to be adventurous and tried a slice of raw <w>blowfish</w> during his trip to Tokyo.",
                            "target_lang_translations": {
                                "cs": "Rozhodl se zariskovat a během svého výletu do Tokia ochutnal plátek syrové <w>ryby fugu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fugu"
                    ],
                    "common_phrases": [
                        "eating blowfish"
                    ],
                    "target_lang_definitions": {
                        "cs": "Maso této ryby konzumované jako delikatesa, zejména v japonské kuchyni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "fugu",
                                "target_lang_sense_clarification": "japonská delikatesa z čtverzubce"
                            },
                            {
                                "target_lang_word": "maso ze čtverzubce",
                                "target_lang_sense_clarification": "popisné označení pokrmu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8bced6ff-6ff0-320f-a0fe-862d2ea9dc90",
                    "sense_definition": "A symmetric block cipher encryption algorithm designed by Bruce Schneier in 1993.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The security team configured the legacy system to encrypt files using <w>Blowfish</w>.",
                            "target_lang_translations": {
                                "cs": "Bezpečnostní tým nakonfiguroval starší systém tak, aby šifroval soubory pomocí algoritmu <w>Blowfish</w>."
                            }
                        },
                        {
                            "text": "Although <w>Blowfish</w> was widely trusted for years, modern developers generally recommend newer standards.",
                            "target_lang_translations": {
                                "cs": "Ačkoli byl <w>Blowfish</w> po celá léta považován za důvěryhodný, moderní vývojáři obecně doporučují novější standardy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Blowfish encryption algorithm"
                    ],
                    "target_lang_definitions": {
                        "cs": "Symetrická bloková šifra navržená Brucem Schneierem v roce 1993."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Blowfish",
                                "target_lang_sense_clarification": "název šifrovacího algoritmu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}