                                    },
                                    {
                                        "sense_id": "d3b72820-0875-31e7-9389-f217c4d3a58b",
                                        "entry_id": "c0319a59-6f7f-3cac-872d-e4c2cef1df30",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe afficher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3886edb-b37a-4f19-9068-f28a247ee8d8",
                                                "sense_id": "d3b72820-0875-31e7-9389-f217c4d3a58b",
                                                "text": "D’un côté, il affiche son désir d’accroître sa participation dans le capital des entreprises dites stratégiques, de « zimbabwéaniser » les compagnies étrangères, d’entreprendre une réforme agraire en réinstallant, sur des terres appartenant aux grands fermiers commerciaux, de petits paysans regroupés en coopératives, enfin de n’encourager l’investissement privé que s’il est « compatible avec la transformation socialiste de l’économie »."
                                            },
                                            {
                                                "example_id": "e169f83b-98fa-402d-b24c-b1a4ad081b1d",
                                                "sense_id": "d3b72820-0875-31e7-9389-f217c4d3a58b",
                                                "text": "Le nouveau modèle de ce constructeur s’affiche avec une dalle Amoled de 6,43 pouces (2 000 × 1 080 px)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ddd9ea-6cba-3e44-9b59-e5b797106ed6",
                                        "entry_id": "c0319a59-6f7f-3cac-872d-e4c2cef1df30",
                                        "glosses": [
