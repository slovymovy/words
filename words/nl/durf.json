                {
                    "sense_id": "d32242e8-2eb8-33df-a364-dc66d0afa5a2",
                    "sense_definition": "Gebiedende wijs van <w>durven</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Durf</w> te dromen over een mooie toekomst.",
                            "target_lang_translations": {
                                "ru": "<w>Смей</w> мечтать о прекрасном будущем.",
                                "en": "<w>Dare</w> to dream of a beautiful future.",
                                "de": "<w>Trau dich</w>, von einer schönen Zukunft zu träumen."
                            }
                        },
                        {
                            "text": "<w>Durf</w> nee te zeggen als je het er niet mee eens bent.",
                            "target_lang_translations": {
                                "ru": "<w>Имей смелость</w> сказать «нет», если ты не согласен.",
                                "en": "<w>Dare</w> to say no if you do not agree.",
                                "de": "<w>Wage es</w>, Nein zu sagen, wenn du nicht einverstanden bist."
                            }
                        }
                    ],
                    "common_phrases": [
