        "fr-extract.jsonl": [
            {
                "entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                "word": "duochrome",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e49fe691-7b9a-4710-ad3b-0ddc38efa18f",
                        "entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "duochromes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "61532604-3469-3137-8ad5-1f3fcee77072",
                        "entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                        "glosses": [
                            "Qui est composé de deux couleurs dominantes, souvent pour créer un effet esthétique ou contrasté."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05ab2462-8ce5-354c-b546-a478a10ff486",
                        "entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                        "glosses": [
                            "Relatif au test duochrome, utilisé pour affiner la correction visuelle en comparant la netteté entre le rouge et le vert."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "256a7070-a6c2-3a82-8d07-f713bc1f5db2",
                        "entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                        "glosses": [
                            "(Rare) Qui présente deux couleurs ; quasi-synonyme de bicolore."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63d82828-8b90-4d9b-9922-b6544f5cdc17",
                        "source_entry_id": "c72e0744-4900-3828-bd1b-0a4491d2d446",
                        "target_lang_word": "duochrome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duochrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1365b9e2-3a4a-3f19-9e62-4684d01ce0d7",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "The duochrome test, a test used by opticians to refine the correction of refractive error, in which the subject is asked to compare images presented with red and green backgrounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfb2665-c603-4b8f-ae9c-450f8191a957",
                                                "sense_id": "1365b9e2-3a4a-3f19-9e62-4684d01ce0d7",
                                                "text": "When using the duochrome, there may not be an exact endpoint because the chances of the spectacle refraction falling into a 0.25 DS endpoint are fairly remote."
                                            },
                                            {
                                                "example_id": "a59299dc-c7f0-46d1-bd3a-791baea09e16",
                                                "sense_id": "1365b9e2-3a4a-3f19-9e62-4684d01ce0d7",
                                                "text": "The duochrome should be used as the endpoint procedure for the initial MPMVA ."
                                            },
                                            {
                                                "example_id": "41fe988e-6251-4c23-bdb7-a736834afd24",
                                                "sense_id": "1365b9e2-3a4a-3f19-9e62-4684d01ce0d7",
                                                "text": "If the responses are not appropriate, then the duochrome is not reliable for this patient and should be ignored."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25cc3b63-df7b-3195-90b3-955e51586581",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "An image composed of varying shades (grayscale) of two colors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54548d8f-6236-47fd-a444-d757ae7df482",
                                                "sense_id": "25cc3b63-df7b-3195-90b3-955e51586581",
                                                "text": "Where a color original such as a transparency, color print, or color artwork is furnished, additional impact and interest can be obtained with the duochrome."
                                            },
                                            {
                                                "example_id": "bb8c5ec1-19fd-43a1-93d8-7228501d84e3",
                                                "sense_id": "25cc3b63-df7b-3195-90b3-955e51586581",
                                                "text": "[…] used two tints for his underpaintings, a duochrome in effect, probably a cool grey tint for the shadows and a golden buff one for everything in sunlight."
                                            },
                                            {
                                                "example_id": "bdf5c17a-388a-496e-a2c8-308c5a4cd53c",
                                                "sense_id": "25cc3b63-df7b-3195-90b3-955e51586581",
                                                "text": "The duochrome differs from the duotone in that a fullcolor original is required for its preparation."
                                            },
                                            {
                                                "example_id": "e9a38147-0389-4bd7-b8db-bfcea1ff59f3",
                                                "sense_id": "25cc3b63-df7b-3195-90b3-955e51586581",
                                                "text": "Films could also be tinted and toned, resulting in color duochromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c6c381e-7951-3af8-9edd-e8df59cb5249",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "A piece of pottery decorated in two colors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f46c37-f5f0-4c36-af5b-3f2a5502a48f",
                                                "sense_id": "2c6c381e-7951-3af8-9edd-e8df59cb5249",
                                                "text": "Jugs 9-10 and 15 are obviously the last vestiges of earlier duochrome ware."
                                            },
                                            {
                                                "example_id": "1d5cf780-8c1e-4fa9-b043-719333dc4417",
                                                "sense_id": "2c6c381e-7951-3af8-9edd-e8df59cb5249",
                                                "text": "Duochrome consists predominantly of red or brown on brown, buff, or cream."
                                            },
                                            {
                                                "example_id": "45ecd702-2b73-477f-9894-1620333a85d5",
                                                "sense_id": "2c6c381e-7951-3af8-9edd-e8df59cb5249",
                                                "text": "These bowls were usually red slipped from rim edge down to several inches below the widest diameter, making the bowl a duochrome with red upper-body and tan lower-body."
                                            },
                                            {
                                                "example_id": "a6cc8b66-616f-4ff6-9cb8-372052ce44d7",
                                                "sense_id": "2c6c381e-7951-3af8-9edd-e8df59cb5249",
                                                "text": "Unidentified black-on-gray (probably a duochrome related to the Chihuahua series), La Junta Focus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74bda816-8711-3065-942b-35efd7da80fd",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "A color scheme consisting of only two hues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9b3e92-0008-4791-a09b-c034a124d46f",
                                                "sense_id": "74bda816-8711-3065-942b-35efd7da80fd",
                                                "text": "All was immaculately in keeping, a duochrome of terracotta and brick, with niches for Elizabeth II matching those of her great-great grandparents, Victoria and Albert, on the North Porch."
                                            },
                                            {
                                                "example_id": "8e069fba-314a-4674-986c-ac2516dc7695",
                                                "sense_id": "74bda816-8711-3065-942b-35efd7da80fd",
                                                "text": "A dank duochrome prevailed, matte silver and green-black, curled fog strangling the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff3c80a-2d9a-3320-8074-4129a1e72163",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "Fabric that shifts between two colors, depending on the angle of light, also, by extension, something made with such fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e19dcc0-9746-4466-8483-bc7f318173b7",
                                                "sense_id": "bff3c80a-2d9a-3320-8074-4129a1e72163",
                                                "text": "So she'd worn one of her own creations, a duochrome that shifted from turquoise to a rich blue depending on how the light hit it."
                                            },
                                            {
                                                "example_id": "194151f3-91e8-4aa5-b6d2-a1f764da7262",
                                                "sense_id": "bff3c80a-2d9a-3320-8074-4129a1e72163",
                                                "text": "Duochrome flecks sparkled yellow on the plane's dark seats."
                                            },
                                            {
                                                "example_id": "71fb680d-1921-4891-b885-a9e13722ba71",
                                                "sense_id": "bff3c80a-2d9a-3320-8074-4129a1e72163",
                                                "text": "I'm like—like boring old burlap and you're a duochrome, ombre, brilliant rainbow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96b5acc-bbeb-3bf7-8bc2-0e853e02ef5f",
                                        "entry_id": "4eb3923d-edc9-3653-8a0b-6e30ce3d2fbf",
                                        "glosses": [
                                            "A fluorochrome that shows up in either of two colors, depending on the type of biological material it stains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b673828-f45d-4ab7-857e-352de9bb0d67",
                                                "sense_id": "c96b5acc-bbeb-3bf7-8bc2-0e853e02ef5f",
                                                "text": "[…] which seem to be positive for two fluorochromes, i.e., the intact duochrome and the first component of the disintegrated duochrome."
                                            },
                                            {
                                                "example_id": "13218607-78f5-4b6d-879c-32ea6c1b1fa7",
                                                "sense_id": "c96b5acc-bbeb-3bf7-8bc2-0e853e02ef5f",
                                                "text": "Commercially available Cy7 duochromes have highly variable fluorescence properties from batch to batch as there appears to be little regard to standardization with respect to conjugation ratios used."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duochrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c881448-e8f3-3d0a-bf18-588c08dfe79d",
                                        "entry_id": "a04f3233-f23a-3806-9f43-268732470df9",
                                        "glosses": [
                                            "Pertaining to the red and green colors of the duochrome test."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf9177bf-9e27-4d68-9874-18904dd37391",
                                                "sense_id": "1c881448-e8f3-3d0a-bf18-588c08dfe79d",
                                                "text": "Cockerham claims that there are a number of advantages with his duochrome fixation attachment over the ordinary illuminated target."
                                            },
                                            {
                                                "example_id": "483cbc8e-cf4f-4d32-a221-3789591b17dc",
                                                "sense_id": "1c881448-e8f3-3d0a-bf18-588c08dfe79d",
                                                "text": "the operator begins at the centre, chooses a colour, follows the colour out to duochrome balance, then proceeds to the periphery."
                                            },
                                            {
                                                "example_id": "aec77d3f-270d-41f5-b001-347f0ce371b3",
                                                "sense_id": "1c881448-e8f3-3d0a-bf18-588c08dfe79d",
                                                "text": "One standard on duochrome filters recommends a green filter having a peak luminosity of approximately 535 nm and a red filter of approximately 620 nm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                        "entry_id": "a04f3233-f23a-3806-9f43-268732470df9",
                                        "glosses": [
                                            "Composed of two colors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e95c2537-e1da-4d4e-841e-5ecddf3dd9bb",
                                                "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                                "text": "We were boldly duochrome in our bear-up black sweatpants and white sleeveless T-shirts with crosses and religious medals dangling from our necks, sort of a City Ballet meets St. Mark's Place kind of look."
                                            },
                                            {
                                                "example_id": "7f0c14af-53c0-45d1-a50f-65158641442f",
                                                "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                                "text": "Duochrome monotony of gray weather recalling Cage's Four Minutes Thirty-Three Seconds of silence, making Julian hungry to see something with a feeling attached."
                                            },
                                            {
                                                "example_id": "324c28aa-9cae-4399-8c9c-117391e4cb0e",
                                                "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                                "text": "A drab series of duochrome fashions reflected the comparatively flat progression of the country through the first half of this century."
                                            },
                                            {
                                                "example_id": "d366febd-70c6-4142-afae-c910f927369b",
                                                "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                                "text": "The initial effect is of some vast, elegant set of combination locks, or duochrome Rubik's cubes, poised at any moment to whirr and counterspin, floor by floor,"
                                            },
                                            {
                                                "example_id": "59e71f07-d664-4124-a927-7d7ae87548aa",
                                                "sense_id": "ac550b5f-879d-3413-95b5-9b2e9fd768ad",
                                                "text": "This required each duochrome page to go through the printing press twice, and it was soon discovered that it was more efficient to pay scribes to add the rubrication."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duochrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ed2e25-c55e-3a75-9cf1-2193841b11eb",
                                        "entry_id": "8ee0f58b-9b88-38a9-b012-92d72e83a381",
                                        "glosses": [
                                            "In two colors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "762e0b36-5bd6-4266-b000-57dce802b6fc",
                                                "sense_id": "32ed2e25-c55e-3a75-9cf1-2193841b11eb",
                                                "text": "Mark showed his father how you could push down two of the coloured ballpoints at once, and so write duochrome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
