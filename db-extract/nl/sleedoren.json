                        "sense_id": "9f37e39e-4dc1-309e-8b19-10823fd14d1e",
                        "entry_id": "3224ef2e-c3f8-389f-b549-bda4d0e9f48c",
                        "glosses": [
                            "bepaald soort plant met blauwe vruchten, Prunus spinosa uit de rozenfamilie Rosaceae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52442993-9177-4be9-b5b9-a4372a29690d",
                                "sense_id": "9f37e39e-4dc1-309e-8b19-10823fd14d1e",
                                "text": "Het akkerland ligt hoger dan de beemden, en tussen de twee staat de brede houtkant van braam- en sleedorens, van varens, brem, geitenblad en wilde hop, waarvan de vezelige ranken en warrige stengels als pezen door elkaar verstrengelen en er een ondoordringbare muur tussen veld en weide van maken."
                            },
                            {
                                "example_id": "b5464915-c075-41ae-abd7-6da8273c1e0a",
                                "sense_id": "9f37e39e-4dc1-309e-8b19-10823fd14d1e",
                                "text": "De sleedoren wordt in veel provincies van Nederland aan de kanten van de akkers en bij de wegen bij de hagedoren overvloedig genoeg gevonden."
                            }
                        ]
                    }
