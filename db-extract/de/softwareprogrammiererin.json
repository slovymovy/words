                "senses": [
                    {
                        "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                        "entry_id": "ad63f820-971a-3078-aab3-99af9b2755fd",
                        "glosses": [
                            "weibliche Person, die (vorwiegend) Programmcode für Software schreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5db4a98-c091-45ca-a7f0-d9f8ed62da50",
                                "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                                "text": "Eine Bekannte von ihr ist leidenschaftliche Softwareprogrammiererin."
                            },
                            {
                                "example_id": "9e1d9a4d-f5c6-4dd5-9935-4343c9525aa9",
                                "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                                "text": "„Eine 52 Jahre alte Frau hatte sich als Softwareprogrammiererin beworben und nach der Absage erfolglos wegen Altersdiskriminierung geklagt.“"
                            },
                            {
                                "example_id": "e43e8716-2fa5-4b0c-b2d4-621e2d09b785",
                                "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                                "text": "„Eine 1961 in Russland geborene und ausgebildete, seit 2003 arbeitslose Informatikerin bewarb sich 2011 über ‚stepstone‘ auf drei Ausschreibungen eines Betriebes als Softwareprogrammiererin.“"
                            },
                            {
                                "example_id": "052d733f-cd32-43ba-ae3e-05fc0c3b8a44",
                                "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                                "text": "„Mit 14 Jahren verließ sie die Schule und bildete sich zur Softwareprogrammiererin aus.“"
                            },
                            {
                                "example_id": "2598105c-2bfd-4dac-b64d-4a2a07334f8a",
                                "sense_id": "dcb534ee-584f-3b62-8847-0347587a858f",
                                "text": "„Sind Unternehmen in Branchen tätig, in der Englisch die herrschende Sprache ist, dürfen sie von Bewerbern beste Kenntnisse der Sprache verlangen. Eine Softwareprogrammiererin mit russischen Wurzeln sah sich diskriminiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
