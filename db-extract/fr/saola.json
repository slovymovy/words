                                "target_senses": [
                                    {
                                        "sense_id": "ca7fcf1a-3f05-334a-8340-58ab97462510",
                                        "entry_id": "dad4d35b-f317-301d-ba5c-2c0631077f2b",
                                        "glosses": [
                                            "A critically endangered ruminant of species Pseudoryx nghetinhensis, of Vietnam and Laos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86593ba1-2fad-451c-8fe0-92a5d188d6a1",
                                                "sense_id": "ca7fcf1a-3f05-334a-8340-58ab97462510",
                                                "text": "2013, C. Michele Thompson, 10: Would a saola by any other name still be a saola?, Hue-Tam Ho Tai, Mark Sidel (editors), State, Society and the Market in Contemporary Vietnam, Taylor & Francis (Routledge), page 185,\nThe current consensus is that the saola is so rare and so solitary in terms of genetic relatives that it should be placed not only in its own separate genus (Pseudoryx) but also in its own tribe (Pseudorygini) within the subfamily Bovinae."
                                            },
                                            {
                                                "example_id": "87c3fd69-911d-4ef2-9b37-095f6ce30a0b",
                                                "sense_id": "ca7fcf1a-3f05-334a-8340-58ab97462510",
                                                "text": "Killing or capture of saola is prohibited by law in both Vietnam and Lao PDR, and the sale of wildlife in both countries is generally illegal, but there is insufficient enforcement of these laws in both countries."
                                            },
                                            {
                                                "example_id": "5aca41fe-1083-42c6-a4c5-90614d2985e2",
                                                "sense_id": "ca7fcf1a-3f05-334a-8340-58ab97462510",
                                                "text": "2015, William deBuys, The Last Unicorn: A Search for One of Earth's Rarest Creatures, Hachette (Little, Brown and Company), unnumbered page,\nIt is surprising, twenty years after saola first attracted the world's attention, that so little about the species is known."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
