                                "target_senses": [
                                    {
                                        "sense_id": "7aa1bded-3513-3d11-9b67-72f9c0a8c533",
                                        "entry_id": "426a78d4-c5b0-3983-b5d3-c60086027e08",
                                        "glosses": [
                                            "Chine sous la domination mongole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8ae7090-0be0-4d73-a473-4b1f5536576e",
                                                "sense_id": "7aa1bded-3513-3d11-9b67-72f9c0a8c533",
                                                "text": "Cabot disait pouvoir atteindre, par une autre route que celle suivie par les Portugais, le Cathay, le Cipango et les îles du poivre et du cinnamome, les rivages de la soie et le pays de la muscade."
                                            },
                                            {
                                                "example_id": "e7c43f8b-b820-4609-80eb-8323fbddbde8",
                                                "sense_id": "7aa1bded-3513-3d11-9b67-72f9c0a8c533",
                                                "text": "Ils font dans la province de Cathay une fort bonne boisson composée de riz et de plusieurs parfums, laquelle par sa douceur surpasse la bonté du vin."
                                            },
                                            {
                                                "example_id": "bdf3f407-cee8-4d3d-b876-e6b40e7971b2",
                                                "sense_id": "7aa1bded-3513-3d11-9b67-72f9c0a8c533",
                                                "text": "Sachez que le Grand Khan demeure trois mois de l’an, assavoir : décembre, janvier et février, en la principale cité du Cathay (Chine septentrionale), laquelle a nom Cambaluc."
                                            }
                                        ]
                                    }
                                ]
                            }
