                "senses": [
                    {
                        "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                        "entry_id": "ff74937c-f44f-352a-8c98-069cfc99dcae",
                        "glosses": [
                            "A governor of a province or district in the Turkish (e.g. Ottoman) dominions."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "6ac58958-c0fe-43e5-a398-2703f954ede4",
                                "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                                "text": "She was chaperoned by the widow of a Bey whose son had been at Oxford with him, and this gave him the excuse to exchange a few words with her, and then to be presented to the Princess."
                            },
                            {
                                "example_id": "0d50b41f-04d1-4c72-bccf-ad1016fcb4ac",
                                "sense_id": "29e05fb0-ce97-319f-ae0a-580042dcf69b",
                                "text": "Whether his position with the Third Circle made the difference or the fact that he ranked as a bey, life in El Iskandryia was proving easier than he'd ever dreamed possible when he stepped off the plane."
                            }
                        ]
                    },
                    {
                        "sense_id": "2477f495-831e-3842-801d-e45353088185",
                        "entry_id": "ff74937c-f44f-352a-8c98-069cfc99dcae",
                        "glosses": [
                            "in various other places, a prince or nobleman"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57ebbf7c-f1eb-4a2f-aa0c-6337b0baa834",
                        "source_entry_id": "ff74937c-f44f-352a-8c98-069cfc99dcae",
