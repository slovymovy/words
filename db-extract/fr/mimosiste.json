                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3bd6d3d-f603-4ebb-ae20-65b2dcc6959e",
                                "sense_id": "659882bb-3df9-33b5-afed-da42bac9a9fa",
                                "text": "Quelques mimosistes ouvrent leurs exploitations aux visiteurs et font découvrir leurs forceries (chambres où l’on fait fleurir le mimosa encore vert)."
                            },
                            {
