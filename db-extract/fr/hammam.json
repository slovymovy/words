                "senses": [
                    {
                        "sense_id": "0aeb7ca1-8f65-3913-997f-80b9c6e522d8",
                        "entry_id": "93025be4-b77d-3ca6-8a82-21c03a134b05",
                        "glosses": [
                            "Établissement dans lequel on prend des bains de vapeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b72da49a-a56c-4e83-8dd4-a0642c9f65d3",
                                "sense_id": "0aeb7ca1-8f65-3913-997f-80b9c6e522d8",
                                "text": "J’sortirais du hammam je n’transpirerais pas plus. Il y a de quoi piger la crève."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27f5df2c-4d9a-47bc-a5c9-531aab962391",
                        "source_entry_id": "93025be4-b77d-3ca6-8a82-21c03a134b05",
                        "source_sense_id": "0aeb7ca1-8f65-3913-997f-80b9c6e522d8",
                        "target_lang_word": "Hamam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hamam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                        "entry_id": "5f6fb331-bb28-3397-b327-e6d7a818adc6",
                                        "glosses": [
                                            "türkisches Dampfbad, das der Körperpflege und der Entspannung dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f089d5e7-db19-481c-b622-5c12dbfda6d0",
                                                "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                                "text": "Nach einem langen Flug wird man im Hamam, dem traditionellen türkischen Bad, schnell wieder fit."
                                            },
                                            {
                                                "example_id": "2a9a21aa-ea24-4337-af8b-5c052a49ef63",
                                                "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                                "text": "Die öffentlichen Hamams sind für sie die einzige Möglichkeit, sich zu waschen."
                                            },
                                            {
                                                "example_id": "70243c4a-1ed4-4cb2-b407-2cac578309ee",
                                                "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                                "text": "Man schlug mir vor ins Hamam oder türkische Bad zu gehen."
                                            },
                                            {
                                                "example_id": "20a6671a-284a-49f6-9018-63b6a4c80ce6",
                                                "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                                "text": "Medical Wellness findet hier im stylischen Fünfsterne-Rahmen statt, in dem auch Exotisches viel Platz hat – ein Hamam, ayurvedische Anwendungen oder die Fünf-Elemente-Lehre."
                                            },
                                            {
                                                "example_id": "be05cfbf-578b-4041-af82-1d36bd590d8c",
                                                "sense_id": "21f4846b-3ecd-3aa1-88cc-5bcb9a768c2c",
                                                "text": "Ganz anders ist da die Erfahrung mit der Mutter, die im Zufluchtsort der Frauen, dem Hamam, die Füße der Tochter segnet: „Auf dass du beschützt wirst!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
