                "senses": [
                    {
                        "sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                        "entry_id": "d8fe1fc6-d148-3b7d-80c0-f6b4aef5d9ee",
                        "glosses": [
                            "von wenig Achtsamkeit geprägter Zustand oder Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b59b203-1917-496b-bd0f-c0823d1084f6",
                                "sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                                "text": "„Es war schon genug, daß er durch eine erste Unvorsichtigkeit die Geier angelockt hatte, die ihn seitdem unermüdlich beobachteten.“"
                            },
                            {
                                "example_id": "cfd74da5-2c5b-4c41-a6f9-4c97efea769c",
                                "sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                                "text": "„Vor Angst, daß sich meine Heldin durch irgendeine Unvorsichtigkeit verriet, saß ich wie auf Nadeln.“"
                            },
                            {
                                "example_id": "3510afca-5c7f-4b90-a806-4b64a2c173d0",
                                "sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                                "text": "„Trotzdem ist der Marquis unfähig, sich schuldig zu fühlen, höchstens Unvorsichtigkeit wirft er sich vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82dfc4a5-1994-42d0-9812-d04a438b9c87",
                        "source_entry_id": "d8fe1fc6-d148-3b7d-80c0-f6b4aef5d9ee",
                        "source_sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                        "source_sense_description": "von wenig Achtsamkeit geprägter Zustand oder Handlung",
                        "target_lang_word": "imprudence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                        "entry_id": "dab64d31-d1cd-31f8-aa5b-5b6a72068920",
                                        "glosses": [
                                            "Défaut de prudence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f702b13-405e-4403-9595-f4667a2d9b18",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Il s’est conduit en cela avec une grande imprudence, avec une extrême imprudence."
                                            },
                                            {
                                                "example_id": "5b316fc8-9620-4c45-a3d6-f8b9f4de05a7",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Il y a bien de l’imprudence à se conduire ainsi."
                                            },
                                            {
                                                "example_id": "75fdecf6-c14a-4469-8df7-4a6830fdc26a",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Un moment d’imprudence peut tout perdre."
                                            },
                                            {
                                                "example_id": "decca1c9-b56e-41bb-b79d-f949c88a2667",
                                                "sense_id": "8fd651dd-e371-3279-953b-f18c4c5deb83",
                                                "text": "Quelle imprudence !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                        "entry_id": "dab64d31-d1cd-31f8-aa5b-5b6a72068920",
                                        "glosses": [
                                            "Action ou parole imprudentes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b749f944-73dd-464e-8450-5e53760c12dd",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Il a commis une légère imprudence."
                                            },
                                            {
                                                "example_id": "eba40f5e-daa2-40bf-a76e-29d2ea17e0ba",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Il fait souvent des imprudences."
                                            },
                                            {
                                                "example_id": "070d7ee1-93ed-4eba-aeab-49dbe06b5633",
                                                "sense_id": "637d5895-3ddb-3031-a54c-d740a8d28947",
                                                "text": "Ne pas sourire avec respect au seul nom de M. le préfet passe, aux yeux des paysans de Franche-Comté, pour une imprudence : or, l'imprudence chez le pauvre est rapidement punie par le manque de pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "924e8977-5223-4ef8-abff-df2b972f02d2",
                        "source_entry_id": "d8fe1fc6-d148-3b7d-80c0-f6b4aef5d9ee",
                        "source_sense_id": "38cc0974-89dd-3c7c-a9f5-72674d156598",
                        "source_sense_description": "von wenig Achtsamkeit geprägter Zustand oder Handlung",
                        "target_lang_word": "imprudenza",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprudenza",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "6be48985-9753-3a10-9faf-9cd2e35304d1",
                                        "entry_id": "3a9158d6-5f74-3ee3-9c05-317ce354c93d",
                                        "glosses": [
                                            "mancanza di prudenza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4379b7fd-ac04-4f5d-b1ad-86d966cf829c",
                                                "sense_id": "6be48985-9753-3a10-9faf-9cd2e35304d1",
                                                "text": "L'imprudenza può essere molto pericolosa."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78760758-943c-3fe3-944d-5bbef3224288",
                                        "entry_id": "3a9158d6-5f74-3ee3-9c05-317ce354c93d",
                                        "glosses": [
                                            "atto imprudente; azione priva di prudenza"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf9a719-fb24-43d1-847c-744ecc8641b7",
                                                "sense_id": "78760758-943c-3fe3-944d-5bbef3224288",
                                                "text": "Non eliminando l'arma del delitto commise una grave imprudenza."
                                            }
                                        ]
