                        "glosses": [
                            "Caractéristique de certains organismes à être résistant à l’action de la pénicilline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e02af8-8a89-4ed2-8997-c3fe274c01b7",
                                "sense_id": "61df63a4-a79d-3a43-96ec-60ce2c4fc9da",
                                "text": "Encore faut-il tenir compte des cas de pénicillino-résistance liée à des traitements antérieurs."
                            },
