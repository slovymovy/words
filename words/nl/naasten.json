    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92a8852b-afe8-382e-8117-d42624dfe7e5",
                    "sense_definition": "meervoud van <w>naaste</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medemens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten altijd proberen om onze <w>naasten</w> te helpen in tijden van nood.",
                            "target_lang_translations": {
                                "en": "We must always try to help our <w>fellow men</w> in times of need."
                            }
                        },
                        {
                            "text": "Zijn liefde voor zijn <w>naasten</w> was groter dan zijn eigenbelang.",
                            "target_lang_translations": {
                                "en": "His love for his <w>neighbors</w> was greater than his self-interest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "liefde voor naasten"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'naaste', referring to one's fellow human beings or those close to oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fellow men",
                                "target_lang_sense_clarification": "other people in general"
                            },
                            {
                                "target_lang_word": "neighbors",
                                "target_lang_sense_clarification": "in a biblical or ethical sense of fellow human beings"
                            },
                            {
                                "target_lang_word": "loved ones",
                                "target_lang_sense_clarification": "those close to you"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c498110c-7936-3090-a566-97354c178250",
                    "sense_definition": "het in staatshanden overnemen van eigendommen, vaak zonder compensatie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onteigening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regering van het land had alle oliebronnen <w>genaast</w>.",
                            "target_lang_translations": {
                                "en": "The country's government had <w>nationalized</w> all oil wells."
                            }
                        },
                        {
                            "text": "De staat besloot de gronden te <w>naasten</w> voor de aanleg van een nieuwe snelweg.",
                            "target_lang_translations": {
                                "en": "The state decided to <w>expropriate</w> the lands for the construction of a new highway."
                            }
                        }
                    ],
                    "synonyms": [
                        "nationaliseren"
                    ],
                    "common_phrases": [
                        "bezittingen naasten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in juridische of politieke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the act of a state taking over private property, often without compensation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nationalize",
                                "target_lang_sense_clarification": "to bring under government control"
                            },
                            {
                                "target_lang_word": "expropriate",
                                "target_lang_sense_clarification": "to take property from its owner for public use"
                            },
                            {
                                "target_lang_word": "appropriate",
                                "target_lang_sense_clarification": "to take for one's own use, typically without permission"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}