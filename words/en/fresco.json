        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fd963a9-8eb2-329a-9cd6-24e86203db8b",
                    "sense_definition": "A painting executed on newly laid lime plaster with water-based pigments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "art_fresco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tourists stopped to admire the ancient <w>fresco</w> on the church wall.",
                            "target_lang_translations": {
                                "it": "I turisti si sono fermati ad ammirare l'antico <w>affresco</w> sulla parete della chiesa."
                            }
                        },
                        {
                            "text": "They spent years attempting to restore the famous <w>fresco</w> after it was damaged.",
                            "target_lang_translations": {
                                "it": "Hanno trascorso anni cercando di restaurare il famoso <w>affresco</w> dopo che era stato danneggiato."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient fresco",
                        "restore the fresco",
                        "wall fresco"
                    ],
                    "target_lang_definitions": {
                        "it": "Un dipinto realizzato su intonaco di calce fresco con pigmenti a base d'acqua."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affresco",
                                "target_lang_sense_clarification": "dipinto murale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d33e10d9-dad7-3892-a684-b9a9deee5f6b",
                    "sense_definition": "The technique of painting on wet plaster with watercolors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_fresco",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist learned the traditional method of painting in <w>fresco</w> during her time in Italy.",
                            "target_lang_translations": {
                                "it": "L'artista ha imparato il metodo tradizionale di dipingere ad <w>affresco</w> durante il suo soggiorno in Italia."
                            }
                        },
                        {
                            "text": "Working in <w>fresco</w> requires quick execution before the plaster dries.",
                            "target_lang_translations": {
                                "it": "Lavorare ad <w>affresco</w> richiede un'esecuzione rapida prima che l'intonaco si asciughi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paint in fresco",
                        "technique of fresco"
                    ],
                    "target_lang_definitions": {
