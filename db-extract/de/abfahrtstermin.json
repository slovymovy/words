                "senses": [
                    {
                        "sense_id": "af27433d-1edd-3673-859c-af38dbd7816a",
                        "entry_id": "f55d625d-409c-371a-81b5-7e8ce36089f1",
                        "glosses": [
                            "festgelegter Zeitpunkt, an dem eine Fahrt beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3128b0-e124-4a63-912e-33bc424d5026",
                                "sense_id": "af27433d-1edd-3673-859c-af38dbd7816a",
                                "text": "„Mitfahrer rufen frühestens drei Tage vor dem gewünschten Abfahrtstermin bei der MFZ an und fragen nach, ob zu dem Termin jemand zum gewünschten Zielort fährt.“"
                            },
                            {
                                "example_id": "520f7fa8-8edc-45ab-909a-dfe4d7e4f979",
                                "sense_id": "af27433d-1edd-3673-859c-af38dbd7816a",
                                "text": "„Die Schalterbeamten schaffen gelegentlich künstliche Knappheiten bei Zugtickets, um sie kurz vor dem Abfahrtstermin auf eigene Rechnung über Schwarzhändler zu verkaufen.“"
                            }
                        ],
