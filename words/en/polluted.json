{
    "word_family": [
        "pollute",
        "pollution",
        "pollutant",
        "polluter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f11d4927-298b-39cf-b6e3-ce284f42ebd1",
                    "sense_definition": "Made unclean, impure, or harmful to health, usually by chemicals or waste.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is too <w>polluted</w> for anyone to swim in safely.",
                            "target_lang_translations": {
                                "ru": "Река слишком <w>загрязнена</w>, чтобы в ней можно было безопасно купаться.",
                                "tr": "Nehir, kimsenin güvenle yüzemeyeceği kadar <w>kirli</w>."
                            }
                        },
                        {
                            "text": "Many people in the city suffer from health issues caused by <w>polluted</w> air.",
                            "target_lang_translations": {
                                "ru": "Многие жители города страдают от проблем со здоровьем, вызванных <w>загрязнённым</w> воздухом.",
                                "tr": "Şehirdeki birçok insan, <w>kirli</w> havanın neden olduğu sağlık sorunlarından muzdarip."
                            }
                        }
                    ],
                    "synonyms": [
                        "foul",
                        "contaminated",
                        "dirty"
                    ],
                    "antonyms": [
                        "uncontaminated",
                        "unpolluted"
                    ],
                    "common_phrases": [
                        "polluted air",
                        "polluted water",
                        "heavily polluted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный грязным, нечистым или вредным для здоровья, обычно из-за химикатов или отходов.",
                        "tr": "Genellikle kimyasallar veya atıklar nedeniyle kirlenmiş, saflığı bozulmuş veya sağlığa zararlı hale getirilmiş."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнённый",
                                "target_lang_sense_clarification": "содержащий вредные примеси"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kirli",
                                "target_lang_sense_clarification": "çevre, hava, su vb. için"
                            },
                            {
                                "target_lang_word": "kirlenmiş",
                                "target_lang_sense_clarification": "atıklarla kirlenmiş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb9d693c-59e5-3a8d-8366-c13bb3ba3697",
                    "sense_definition": "Extremely intoxicated with alcohol.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got absolutely <w>polluted</w> at the party and had to take a taxi home.",
                            "target_lang_translations": {
                                "ru": "Он <w>напился в хлам</w> на вечеринке, и ему пришлось ехать домой на такси.",
                                "tr": "Partide <w>zil zurna sarhoş</w> oldu ve eve taksiyle dönmek zorunda kaldı."
                            }
                        },
                        {
                            "text": "They were so <w>polluted</w> by midnight that they could barely stand up.",
                            "target_lang_translations": {
                                "ru": "К полуночи они были настолько <w>пьяны</w>, что едва могли стоять на ногах.",
                                "tr": "Gece yarısına doğru o kadar <w>sarhoştular</w> ki ayakta zor durabiliyorlardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolutely polluted"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии сильного алкогольного опьянения.",
                        "tr": "Alkolün etkisiyle aşırı derecede sarhoş olmuş."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный в стельку",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "набравшийся",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zil zurna sarhoş",
                                "target_lang_sense_clarification": "argo"
                            },
                            {
                                "target_lang_word": "kör kütük sarhoş",
                                "target_lang_sense_clarification": "argo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48a8bccf-1ea6-3974-b20c-937d10e9d1db",
                    "sense_definition": "Simple past tense and past participle of <w>pollute</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>polluted</w> the local stream with toxic chemicals last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году завод <w>загрязнил</w> местный ручей токсичными химикатами.",
                                "tr": "Fabrika geçen yıl yerel dereyi toksik kimyasallarla <w>kirletti</w>."
                            }
                        },
                        {
                            "text": "Smoke from the forest fires has <w>polluted</w> the atmosphere across the region.",
                            "target_lang_translations": {
                                "ru": "Дым от лесных пожаров <w>загрязнил</w> атмосферу во всём регионе.",
                                "tr": "Orman yangınlarından çıkan duman, bölge genelinde atmosferi <w>kirletti</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense / participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола pollute (загрязнять).",
                        "tr": "\"Pollute\" (kirletmek) fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загрязнил",
                                "target_lang_sense_clarification": "прошедшее время"
                            },
                            {
                                "target_lang_word": "загрязнённый",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kirletti",
                                "target_lang_sense_clarification": "geçmiş zaman"
                            },
                            {
                                "target_lang_word": "kirletilmiş",
                                "target_lang_sense_clarification": "sıfat-fiil"
                            }
                        ]
                    }
                }
            ]
        }
    ]
