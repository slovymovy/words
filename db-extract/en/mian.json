                "senses": [
                    {
                        "sense_id": "b8c51bc0-77fb-3ed0-9754-1b515e619de7",
                        "entry_id": "dab29bf1-ce18-3d1d-9aa9-b774d8a3e132",
                        "glosses": [
                            "A county of Hanzhong, Shaanxi, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0dc1df-b26c-4b14-a3b5-9e4579c49019",
                                "sense_id": "b8c51bc0-77fb-3ed0-9754-1b515e619de7",
                                "text": "In 1978 the Administrative Office for Cultural Relics of Mian County, Shaanxi, conducted excavations of four tombs found in the course of agricultural improvements."
                            },
                            {
                                "example_id": "5112ddb5-e19d-4866-af6d-16ae366939c4",
                                "sense_id": "b8c51bc0-77fb-3ed0-9754-1b515e619de7",
                                "text": "Large numbers of pottery dogs have been excavated from tombs all over China.² For example, a pottery dog was excavated from an Eastern Han tomb at Laodaosi, Mian county, Shaanxi.³"
                            },
                            {
                                "example_id": "f383defc-db92-4428-95f7-3b07dc7cb9d7",
                                "sense_id": "b8c51bc0-77fb-3ed0-9754-1b515e619de7",
                                "text": "The unearthed cultural relics of Mian County not only indicate that rice-fish culture in China dates further back in the historical record, but also fills an important gap in kind in the history of rice-fish culture in China. Mian County is located in the Hanzhong basin south of Qinlin mountain, near the border of Sichuan and Shanxi Provinces."
                            }
                        ]
                    }
