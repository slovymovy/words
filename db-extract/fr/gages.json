            {
                "entry_id": "63d346f9-3138-3d03-9336-8b7e6475624c",
                "word": "gages",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                        "entry_id": "63d346f9-3138-3d03-9336-8b7e6475624c",
                        "glosses": [
                            "Salaire, appointement que l’on verse à un domestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313924d6-563c-47a2-b897-04f90d98a71c",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "Mais Euphémie, levant de nouveau la sombre et lourde pelle, hurla :\n— Donnez-moi mon argent ! Mes gages ! Je veux mes gages !"
                            },
                            {
                                "example_id": "7380d351-369c-4882-99ea-c3fb6464737d",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "Laissez-moi mourir ici, dit le serviteur.\n ― Mais comment vivras-tu, qui payera tes gages ?\n ― Des gages ? fit l'homme étonné. Voilà seize ans que je n'en reçois plus."
                            },
                            {
                                "example_id": "545cdb47-26dd-43bd-a29c-1f8b436a63c8",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "— Le premier lundi de novembre, où serai-je ? pensait Madeleine ; nous sommes à quinze jours de la Toussaint où mon gage prend fin et il ne me parle pas d’un nouveau marché."
                            },
                            {
                                "example_id": "a1b1b8c3-b10c-4e5d-8cea-e3ebfabe4c65",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "Les gages d’un valet de chambre, d’une cuisinière."
                            },
                            {
                                "example_id": "5097c2f1-37df-47df-80bf-279093b3cad8",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "Retenue sur gages."
                            },
                            {
                                "example_id": "3c9253c8-0036-4956-b913-c130414043b6",
                                "sense_id": "f523993e-92b0-3170-8cb8-1170c259e954",
                                "text": "Se mettre aux gages de quelqu’un."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8c60474-398b-3de4-97fa-232803d0fa2d",
                        "entry_id": "63d346f9-3138-3d03-9336-8b7e6475624c",
                        "glosses": [
                            "Salaire, appointement que l’on verse à un domestique."
                        ],
                        "tags": [
                            "Au féminin",
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "0a63124c-d286-44ff-97c3-1278768d27d6",
                                "sense_id": "c8c60474-398b-3de4-97fa-232803d0fa2d",
                                "text": "Si nous n’avions pas Esdras et Da’Bé dans le bois, qui gagnent de « bonnes » gages, comment ferions-nous ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "861f61f3-519f-4f20-9b01-c3b56ef3893b",
                        "source_entry_id": "63d346f9-3138-3d03-9336-8b7e6475624c",
                        "source_sense_description": "Appointements que l’on verse à un domestique",
                        "target_lang_word": "Lohn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lohn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                        "entry_id": "1e52158a-140c-302f-99fe-107b56d9fe73",
                                        "glosses": [
                                            "Vergütung für eine geleistete Arbeit der Arbeiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a84c9a-ed82-48bb-9170-3d37e2cee37e",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "Die Gewerkschaften fordern höhere Löhne."
                                            },
                                            {
                                                "example_id": "13b9a944-b5fc-47d9-83e0-9232d444d123",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "„Die Löhne der Arbeiter sind kaum mehr als Almosen.“"
                                            },
                                            {
                                                "example_id": "e54d5089-6678-4983-b5b4-c6e5753c7c40",
                                                "sense_id": "d0adc50e-e349-38eb-b2a4-78a318d10851",
                                                "text": "„Natürlich hatte ich nichts dagegen, und so bezahlte ich Kaba, Sékou und Kourou die ausstehende Hälfte ihres Lohns aus und gab jedem einen zusätzlichen Betrag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c079f61d-478a-3ccc-a5bd-d273fd17e6f2",
                                        "entry_id": "1e52158a-140c-302f-99fe-107b56d9fe73",
                                        "glosses": [
                                            "Konsequenz oder Resultat einer Handlung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
