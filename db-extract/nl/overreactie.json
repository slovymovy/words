                            {
                                "example_id": "32a1a0e7-a313-4d3a-8fe9-f31ec032da31",
                                "sense_id": "2220feb5-c02b-3ae2-89ba-9fc8212c7f06",
                                "text": "De radicale ingreep om belangrijke delen van het luchtruim vorig jaar te sluiten was volgens velen een overreactie. Daarom werd er vorig jaar voor gepleit om de luchtvaartmaatschappijen hun eigen verantwoordelijkheid terug te geven. Zoals dat elders in de wereld ook geldt."
                            },
                            {
                                "example_id": "6d79d2d5-36be-4e78-bc8b-2af846a0d35a",
                                "sense_id": "2220feb5-c02b-3ae2-89ba-9fc8212c7f06",
                                "text": "De KLM is ontevreden over het sluiten van grote delen van het Nederlandse luchtruim vandaag. Topman Hartman noemt het een radicale ingreep die onterecht was. Hij spreekt van een overreactie."
                            }
