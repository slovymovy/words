                },
                {
                    "sense_id": "076b026b-fab0-3d76-96da-584cfe810cb9",
                    "sense_definition": "Lire avec passion et très rapidement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
