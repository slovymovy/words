                "forms": [
                    {
                        "form_id": "03adad2e-0022-4bb1-b1f5-24e9ff19b385",
                        "entry_id": "bbc73bff-98f7-3f5e-a50e-3831bd7a6388",
                        "tags": [
                            "plural"
                        ],
                        "form": "adventieven"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ec3a448-b023-3666-8e70-f7ff9b99f905",
                        "entry_id": "bbc73bff-98f7-3f5e-a50e-3831bd7a6388",
                        "glosses": [
                            "toevallig ergens gekomen zonder dat daar natuurlijke oorzaken voor zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de95084c-3e6d-4f61-9673-45909d5ca14e",
                                "sense_id": "4ec3a448-b023-3666-8e70-f7ff9b99f905",
                                "text": "Maar overal schiet toch van alles op wat je niet kent en waarvan je denkt: wat mag dat wezen? Dan laat ik het staan. Blijkt dan vervolgens dat een onbekend adventief Malvaceetje of verdwaald Campanulaceetje jouw klei heeft uitgekozen om daarop zijn bloemenpracht te ontplooien, dan ruk ik het ook in een later stadium niet uit. Al weet je dan welke plantenfamilie je onder handen hebt, je wilt toch ook weten welk genus het is, en liefst zelfs welke soort. Je moet op z'n minst wachten tot de plant bloeit om hem te kunnen determineren. Ik zal u niet vermoeien met de lijst van bijzondere soorten die ik in de loop der jaren op mijn klei heb aangetroffen. Van veel soorten wilt u waarschijnlijk niet eens geloven dat ze zomaar uit het niets opkwamen tussen de prei - die staan in de laatste door Rudi van der Meijden bewerkte druk van de Flora van Nederland allemaal geboekt als 'zeld. tot zeer zeld.' Of 'achteruitgaand', dan wel 'adv. op enkele plaatsen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "f319ae15-4f65-3bf1-988c-e3dd15135c55",
                        "entry_id": "bbc73bff-98f7-3f5e-a50e-3831bd7a6388",
                        "glosses": [
                            "uitheemse plant, dier of ander organisme die onopzettelijk van elders is aangevoerd"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "616dee36-d972-44c2-811b-e298e2aceb36",
                        "source_entry_id": "bbc73bff-98f7-3f5e-a50e-3831bd7a6388",
                        "source_sense_id": "4ec3a448-b023-3666-8e70-f7ff9b99f905",
                        "source_sense_description": "toevallig ergens gekomen zonder dat daar natuurlijke oorzaken voor zijn",
                        "target_lang_word": "alien",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alien",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39b75146-e039-3aed-9b9f-b44a05592ecb",
                                        "entry_id": "08c40a0e-9320-3aba-a9e8-0783fa77a0f1",
                                        "glosses": [
                                            "A person, animal, plant, or other thing which is from outside the family, group, organization, or territory under consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae0dcd9-0b21-4764-a77c-e6a4e845ae2d",
                                                "sense_id": "39b75146-e039-3aed-9b9f-b44a05592ecb",
                                                "text": "An animated film intended to inform travellers about the dangers that alien species present to Arctic ecosystems is being released today. The message is that it is important to ensure that nobody accidentally brings alien species with them as stowaways in their clothing, baggage or equipment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                                        "entry_id": "08c40a0e-9320-3aba-a9e8-0783fa77a0f1",
                                        "glosses": [
                                            "A citizen or national of another sovereign state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c283a2c-f218-4c1d-b601-a9d22bbaefdd",
                                                "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                                                "text": "An alien born may purchase lands, or other estates: but not for his own use; for the king is thereupon entitled to them."
                                            },
                                            {
                                                "example_id": "1b5c05d7-e63b-42db-b29f-e44324dc4ccd",
                                                "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                                                "text": "The counsel have shown conclusively that they are not a state of the union, and have insisted that individually they are aliens, not owing allegiance to the United States."
                                            },
                                            {
                                                "example_id": "3d470cc8-c756-4106-b1b6-947446680541",
                                                "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                                                "text": "I'm an alien, I'm a legal alien\n I'm an Englishman in New York"
                                            },
                                            {
                                                "example_id": "b1e15ae7-77c8-43da-a7ed-fbb03c9eda52",
                                                "sense_id": "8131e981-582b-304c-802f-53bf8c430d81",
                                                "text": "Aliens are aliens because of persecution or war or hardship or famine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ff32199-ae7f-3f11-8cd6-083070af9e04",
                                        "entry_id": "08c40a0e-9320-3aba-a9e8-0783fa77a0f1",
                                        "glosses": [
                                            "A mischievous or suspicious foreigner."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0332ed71-f83e-37c2-8821-e5be1ad12d14",
                                        "entry_id": "08c40a0e-9320-3aba-a9e8-0783fa77a0f1",
                                        "glosses": [
                                            "Any life form of extraterrestrial or extradimensional origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ffdb516-dab7-41b3-babf-218ae6c9f500",
                                                "sense_id": "0332ed71-f83e-37c2-8821-e5be1ad12d14",
                                                "text": "You might not have much use for me. You spend too much time with the damn aliens, pretending your time in the gangs back on Earth never happened. I know you weren't happy when I found you at the Citadel a couple years back.\nBut I'm glad you're on this. I hope you find whoever took my people on Freedom's Progress and kick their scaly asses. I'm glad it's a human finding these bastards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea0f628-0777-37d2-8f9a-b5f4de4a0ead",
                                        "entry_id": "08c40a0e-9320-3aba-a9e8-0783fa77a0f1",
                                        "glosses": [
                                            "One excluded from certain privileges; one alienated or estranged."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5385de-bf5e-4659-81d3-706c3c0e378f",
                                                "sense_id": "2ea0f628-0777-37d2-8f9a-b5f4de4a0ead",
                                                "text": "[…]aliens from the common wealth of Iſrael[…]"
                                            },
                                            {
                                                "example_id": "b53340d6-31f1-4bab-8dcf-3c914b66c7be",
                                                "sense_id": "2ea0f628-0777-37d2-8f9a-b5f4de4a0ead",
                                                "text": "The One Who, in this marvellous utterance, brings those who were by nature aliens and enemies of God into intimate and holy relations with God the Father, is the very One Who had to come to offer that Sacrifice without which such relationship would have been forever an impossibility; without which there would have been nothing for the best of men but death and judgment and the lake of fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alien",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b647ba80-f029-3f5d-883c-6d31f7f8c85b",
                                        "entry_id": "baea2aa5-95cf-3b29-9f59-697b03d69c97",
                                        "glosses": [
                                            "Not belonging to the same country, land, or government, or to the citizens or subjects thereof; foreign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35de33ec-d0f4-461b-a50e-b713cdbfce1b",
                                                "sense_id": "b647ba80-f029-3f5d-883c-6d31f7f8c85b",
                                                "text": "alien subjects, enemies, property, or shores"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b384ff-cf7f-3add-9a6f-8e1956a42d5b",
                                        "entry_id": "baea2aa5-95cf-3b29-9f59-697b03d69c97",
                                        "glosses": [
                                            "Very unfamiliar, strange, or removed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ede56f-7c41-4b65-bd90-611ee19471b0",
                                                "sense_id": "86b384ff-cf7f-3add-9a6f-8e1956a42d5b",
                                                "text": "principles alien to our religion"
                                            },
                                            {
                                                "example_id": "86d925d8-a836-4d9d-96dd-18ccc5fb9839",
                                                "sense_id": "86b384ff-cf7f-3add-9a6f-8e1956a42d5b",
                                                "text": "An alien sound of melancholy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea18e56-2d79-34b7-b21a-fb1bf539eab3",
                                        "entry_id": "baea2aa5-95cf-3b29-9f59-697b03d69c97",
                                        "glosses": [
                                            "Pertaining to extraterrestrial life; typical of an extraterrestrial creature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5daf6032-8ea1-418a-bfdb-64b66a048532",
                                                "sense_id": "7ea18e56-2d79-34b7-b21a-fb1bf539eab3",
                                                "text": "It had a peculiar alien tallness, a peculiar alien flattened head, peculiar slitty little alien eyes[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
