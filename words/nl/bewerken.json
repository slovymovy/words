                {
                    "sense_id": "3800965a-99e6-39a4-9c90-6d78ce8c40f6",
                    "sense_definition": "een tekst, bestand of map wijzigen om deze aan te passen of te verbeteren",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aanpassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt dit document eenvoudig <w>bewerken</w> door op de knop te klikken.",
