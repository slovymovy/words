                "senses": [
                    {
                        "sense_id": "c3483a53-2c14-3c79-a3d9-38fd017154b4",
                        "entry_id": "0d99617e-beb6-3dc7-8312-5b653f5d90c5",
                        "glosses": [
                            "Reifen eines Hinterrads"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3f883b-9fa7-4b3d-a1a0-e55244aa9947",
                                "sense_id": "c3483a53-2c14-3c79-a3d9-38fd017154b4",
                                "text": "„Ich legte den Gang ein, ließ die Kupplung kommen und wurde in meinem Sitz durchgerüttelt, als die massiven Hinterreifen sich in Bewegung setzten und sich aus den Trümmern lösten.“"
                            },
                            {
                                "example_id": "c3d55182-9a86-4635-a4a1-6369cf8cd131",
                                "sense_id": "c3483a53-2c14-3c79-a3d9-38fd017154b4",
                                "text": "„Er zielte auf die Hinterreifen des Trucks, betete kurz, dass sein Gewehr keins von den manipulierten war und schoss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
