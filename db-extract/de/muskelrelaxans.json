                        "entry_id": "0d190be9-e7d1-3d93-b7dd-954c4d34f156",
                        "glosses": [
                            "Substanz, die eine reversible (vorübergehende) Entspannung der Skelettmuskulatur bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "382df9f5-a417-4bdf-8fe8-cc84d940c0da",
                                "sense_id": "bc81467f-e960-38f9-8153-575307abf889",
                                "text": "„Den Gin Tonic versetzte er mit einem Muskelrelaxans, setzte sich aufs Bett und wartete.“"
                            },
                            {
                                "example_id": "628237b6-4d19-47ba-ba4c-f70c1b375065",
                                "sense_id": "bc81467f-e960-38f9-8153-575307abf889",
                                "text": "„Es war nur Versed, ein starkes Muskelrelaxans.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
