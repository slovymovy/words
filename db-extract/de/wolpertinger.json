                        "entry_id": "737cc9a2-7308-3b6b-acac-a4c6a5cdc220",
                        "glosses": [
                            "ein hasenartiges Fabelwesen mit Hörnern, gelegentlich auch zusätzlich noch mit Flügeln oder 6 Beinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c211d5f-41ed-4aed-b297-1054b7953ed0",
                                "sense_id": "5b3c3dcc-bf7c-366a-9c2b-be949bdb5ec3",
                                "text": "„In der Maxvorstadt sticht eine junge Tätowiererin besonders Mutigen Wolpertinger, die bayerischen Fabeltiere, in den Oberarm, auf dem Viktualienmarkt preisen die Blumenhändler Edelweiß als Balkonpflanze der Saison.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
