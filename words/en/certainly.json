                {
                    "sense_id": "d328d058-b3df-312d-94ff-f05892ddf3fc",
                    "sense_definition": "In a manner that is confident, steady, or inevitable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vehicle moved slowly but <w>certainly</w> over the difficult terrain.",
                            "target_lang_translations": {
                                "ru": "Машина двигалась медленно, но <w>уверенно</w> по сложной местности.",
                                "nl": "Het voertuig bewoog zich langzaam maar <w>zeker</w> over het moeilijke terrein.",
                                "pl": "Pojazd poruszał się powoli, lecz <w>pewnie</w> po trudnym terenie.",
                                "de": "Das Fahrzeug bewegte sich langsam, aber <w>sicher</w> über das schwierige Gelände.",
                                "fr": "Le véhicule se déplaçait lentement mais <w>sûrement</w> sur ce terrain difficile.",
                                "it": "Il veicolo si muoveva lentamente ma <w>sicuramente</w> sul terreno difficile.",
                                "cs": "Vozidlo se pohybovalo pomalu, ale <w>jistě</w> náročným terénem.",
                                "tr": "Araç zorlu arazide yavaş ama <w>emin adımlarla</w> ilerledi.",
                                "es": "El vehículo se movía lenta pero <w>con seguridad</w> sobre el difícil terreno.",
                                "zh": "车辆在艰难的地形上缓慢但<w>稳健地</w>行驶。"
                            }
                        },
                        {
                            "text": "He spoke <w>certainly</w> about his future plans, leaving no room for argument.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>уверенно</w> о своих планах на будущее, не оставляя места для споров.",
                                "nl": "Hij sprak <w>zelfverzekerd</w> over zijn toekomstplannen, waardoor er geen ruimte was voor discussie.",
                                "pl": "Mówił <w>pewnie</w> o swoich planach na przyszłość, nie pozostawiając miejsca na dyskusję.",
