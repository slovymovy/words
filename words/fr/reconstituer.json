{
    "word_family": [
        "reconstitution",
        "reconstituant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b10e446-56f5-355c-b2d3-3f842d7f756b",
                    "sense_definition": "Retracer les faits ou les circonstances d'un événement à partir d'indices ou de témoignages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "enquete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont interrogé plusieurs témoins pour tenter de <w>reconstituer</w> les faits avec précision."
                        },
                        {
                            "text": "Les enquêteurs ont réussi à <w>reconstituer</w> l'itinéraire suivi par le suspect durant cette nuit."
                        }
                    ],
                    "synonyms": [
                        "retracer"
                    ],
                    "common_phrases": [
                        "reconstituer les faits",
                        "reconstituer la scène"
                    ]
                },
                {
                    "sense_id": "b2deb194-74bd-3dff-a89a-5593a379496c",
                    "sense_definition": "Refaire ou renouveler une quantité consommée ou épuisée, en particulier des réserves ou de l'énergie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ressources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue course en montagne, le sportif doit bien manger pour <w>reconstituer</w> ses forces."
                        },
                        {
                            "text": "L'entreprise passe une commande urgente afin de <w>reconstituer</w> ses stocks avant les fêtes de fin d'année."
                        }
                    ],
                    "synonyms": [
                        "renouveler",
                        "refaire"
                    ],
                    "antonyms": [
                        "épuiser",
                        "consommer"
                    ],
                    "common_phrases": [
                        "reconstituer ses forces",
                        "reconstituer les stocks"
                    ]
                },
                {
                    "sense_id": "3de93187-7233-3c74-bc90-8e4225d3f1ef",
                    "sense_definition": "Remettre ensemble les parties dispersées ou brisées d'un tout pour lui rendre sa forme originale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'archéologue a mis plusieurs semaines à <w>reconstituer</w> le vase antique à partir de petits fragments."
                        },
                        {
                            "text": "L'enfant a passé tout son après-midi à <w>reconstituer</w> le puzzle sur la table du salon."
                        }
                    ],
                    "synonyms": [
                        "réassembler",
                        "restaurer"
                    ],
                    "antonyms": [
                        "démanteler",
                        "détruire"
                    ],
                    "common_phrases": [
                        "reconstituer un puzzle"
                    ]
                },
                {
                    "sense_id": "c9009ff3-d1d4-3471-8f23-711aa21b3a28",
                    "sense_definition": "Former de nouveau une collectivité, une organisation ou un groupe qui avait disparu ou qui s'était dissous.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les musiciens ont décidé de se réunir pour <w>reconstituer</w> leur groupe après dix ans de séparation."
                        },
                        {
                            "text": "Le directeur cherche à <w>reconstituer</w> une équipe solide pour mener à bien ce grand projet."
                        }
                    ],
                    "synonyms": [
                        "reformer"
                    ],
                    "antonyms": [
                        "dissoudre"
                    ],
                    "common_phrases": [
                        "reconstituer une équipe",
                        "reconstituer un groupe"
                    ]
                },
                {
                    "sense_id": "b93965ff-72f9-36a5-9baa-c8e43f80b0b6",
                    "sense_definition": "Recréer artificiellement une époque, un lieu ou un décor passé pour le spectacle ou l'histoire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le décorateur a utilisé des meubles d'époque pour <w>reconstituer</w> l'intérieur d'un château médiéval."
                        },
                        {
                            "text": "Ce film historique parvient à <w>reconstituer</w> fidèlement la vie quotidienne des habitants au dix-huitième siècle."
                        }
                    ],
                    "synonyms": [
                        "recréer",
                        "reproduire"
                    ],
                    "common_phrases": [
                        "reconstituer un décor",
                        "reconstituer une époque"
                    ]
                }
            ]
        }
    ]
}