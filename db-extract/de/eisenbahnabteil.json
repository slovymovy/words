                "senses": [
                    {
                        "sense_id": "7c24f9c5-dd10-34da-a947-fffd775ece69",
                        "entry_id": "015e7526-6b0f-37ae-9750-c51d660f6be3",
                        "glosses": [
                            "separater, durch eine Tür schließbarer Bereich in Personenwagen der Eisenbahn"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "5485cbfd-7d53-4903-8740-f69b93eeccc1",
                                "sense_id": "7c24f9c5-dd10-34da-a947-fffd775ece69",
                                "text": "„Er spielt, wo denn sonst, in einem Eisenbahnabteil, die es ja neben Großraumwagen immer noch gibt, schon damit derartige Witze noch passieren können.“"
                            },
                            {
                                "example_id": "fa1c2e44-0696-461b-8c92-6df4dfd44b55",
                                "sense_id": "7c24f9c5-dd10-34da-a947-fffd775ece69",
                                "text": "„Roda Roda stieg in ein Eisenbahnabteil, in dem eine Dame mit einem ebenso damenhaften Töchterchen von fünf Jahren saß.“"
                            },
                            {
                                "example_id": "80ca1bda-e7f3-46c1-80f0-4654a701f135",
                                "sense_id": "7c24f9c5-dd10-34da-a947-fffd775ece69",
                                "text": "„Stocksteif wie zwei Reisende in einem Eisenbahnabteil saßen sie da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
