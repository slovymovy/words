                        "glosses": [
                            "Instrument de musique grec, à cordes pincées, sorte de luth à long manche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bea7c6a-afc8-4425-b7f8-bcd98f392dee",
                                "sense_id": "ce4de042-da4f-385d-ba7f-90ba4ce3582b",
                                "text": "Elle s’adressa au joueur de laouto. Celui-ci paraissait fatigué et pinçait ses cordes de plus en plus paresseusement."
                            },
                            {
                                "example_id": "240bd9f5-cf4a-4fa7-84f8-24aad6265659",
                                "sense_id": "ce4de042-da4f-385d-ba7f-90ba4ce3582b",
                                "text": "Les instruments utilisés pour la musique crétoise sont le bouzouki, sorte de mandoline, mais surtout la lyre crétoise, violon vénitien à trois cordes, et le laouto, sorte de luth apparenté à l’oud turc."
                            },
                            {
                                "example_id": "50ee051d-36a2-46cc-8117-7017fc860a3d",
                                "sense_id": "ce4de042-da4f-385d-ba7f-90ba4ce3582b",
                                "text": "Ce dimanche, Petroloukas Halkias joue en quintet. Habituellement la clarinette dialogue avec un laouto, un luth grec, ici tenu par le jeune virtuose Vasilis Kostas."
                            }
                        ]
                    }
