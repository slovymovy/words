                        "glosses": [
                            "Any fish in the taxonomic family Priacanthidae, which have large eyes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fc8d5805-2656-36d7-80fe-cadf0323a2f0",
                        "entry_id": "a03b5e89-9d5b-3027-96f7-cda151d346ed",
                        "glosses": [
                            "Any of certain fish or shark species identified by their large eyes, in particular bigeye tuna, Thunnus obesus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e3f5965-be30-4ef9-b0a8-2c2a8e46975e",
                                "sense_id": "fc8d5805-2656-36d7-80fe-cadf0323a2f0",
                                "text": "There were Port Jackson sharks with a brown back, a whitish belly, and eleven rows of teeth, bigeye sharks with necks marked by a large black spot encircled in white and resembling an eye, and Isabella sharks whose rounded snouts were strewn with dark speckles."
                            },
                            {
                                "example_id": "c8e96fa5-9be1-4459-85d5-ce977bba313a",
                                "sense_id": "fc8d5805-2656-36d7-80fe-cadf0323a2f0",
                                "text": "The relatively large eyes may enable the bigeye to feed at lower light intensity than other tunas."
                            },
                            {
                                "example_id": "96252c69-a000-420b-9114-05abf8f78a72",
                                "sense_id": "fc8d5805-2656-36d7-80fe-cadf0323a2f0",
                                "text": "The percentages of bigeye in the catches were relatively high during the early to mid 1950s, but then levelled off at less than 5 percent of the total catches."
                            }
                        ]
                    }
