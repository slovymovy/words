{
    "word_family": [],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "5a97a000-7265-39df-9510-b40f4be7372f",
                    "sense_definition": "The objective case of <w>we</w>: the speaker and at least one other person.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "group_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She told <w>us</w> to wait here for the bus.",
                            "target_lang_translations": {
                                "ru": "Она сказала <w>нам</w> подождать автобус здесь.",
                                "es": "Ella <w>nos</w> dijo que esperáramos aquí el autobús."
                            }
                        },
                        {
                            "text": "Please come with <w>us</w> to the cinema tonight.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, пойдем с <w>нами</w> в кино сегодня вечером.",
                                "es": "Por favor, ven con <w>nosotros</w> al cine esta noche."
                            }
                        }
                    ],
                    "common_phrases": [
                        "join us",
                        "come with us",
                        "tell us",
                        "give us"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектный падеж местоимения <w>мы</w>: говорящий и по крайней мере еще один человек.",
                        "es": "Forma de objeto del pronombre «we» (nosotros/as): el hablante y al menos otra persona."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нас",
                                "target_lang_sense_clarification": "винительный/родительный падеж"
                            },
                            {
                                "target_lang_word": "нам",
                                "target_lang_sense_clarification": "дательный падеж"
                            },
                            {
                                "target_lang_word": "нами",
                                "target_lang_sense_clarification": "творительный падеж"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nos",
                                "target_lang_sense_clarification": "pronombre de objeto directo o indirecto"
                            },
                            {
                                "target_lang_word": "nosotros",
                                "target_lang_sense_clarification": "tras preposición, masculino o mixto"
                            },
                            {
                                "target_lang_word": "nosotras",
                                "target_lang_sense_clarification": "tras preposición, femenino"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83fde439-c0d4-3e9e-bee9-0b6154c05b43",
                    "sense_definition": "Used instead of \"we\" as a standalone answer or after the verb \"to be\".",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Who is knocking at the door? — It's <w>us</w>.",
                            "target_lang_translations": {
                                "ru": "Кто стучит в дверь? — Это <w>мы</w>.",
                                "es": "¿Quién está llamando a la puerta? — Somos <w>nosotros</w>."
                            }
                        },
                        {
                            "text": "They arrived at the station earlier than <w>us</w>.",
                            "target_lang_translations": {
                                "ru": "Они прибыли на станцию раньше <w>нас</w>.",
                                "es": "Llegaron a la estación antes que <w>nosotros</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "it is us",
                        "just us",
                        "that is us"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется вместо \"мы\" как самостоятельный ответ или после глагола \"быть\".",
                        "es": "Usado en lugar de «we» como respuesta aislada o después del verbo «to be»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мы",
                                "target_lang_sense_clarification": "в роли подлежащего или сказуемого"
                            },
                            {
                                "target_lang_word": "нас",
                                "target_lang_sense_clarification": "в сравнениях"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nosotros",
                                "target_lang_sense_clarification": "masculino o grupo mixto"
                            },
                            {
                                "target_lang_word": "nosotras",
                                "target_lang_sense_clarification": "grupo femenino"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e16446-5e9c-3b66-a8a0-9ec48eb71609",
                    "sense_definition": "People in general; humanity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "History teaches <w>us</w> many important lessons about conflict.",
                            "target_lang_translations": {
                                "ru": "История учит <w>нас</w> многим важным урокам о конфликтах.",
                                "es": "La historia <w>nos</w> enseña muchas lecciones importantes sobre el conflicto."
                            }
                        },
                        {
                            "text": "The sun gives <w>us</w> light and heat every day.",
                            "target_lang_translations": {
                                "ru": "Солнце дает <w>нам</w> свет и тепло каждый день.",
                                "es": "El sol <w>nos</w> da luz y calor todos los días."
                            }
                        }
                    ],
                    "synonyms": [
                        "people",
                        "humanity",
                        "everyone"
                    ],
                    "common_phrases": [
                        "all of us",
                        "each of us",
                        "rest of us"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди в целом; человечество.",
                        "es": "La gente en general; la humanidad."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нас",
                                "target_lang_sense_clarification": "людей"
                            },
                            {
                                "target_lang_word": "нам",
                                "target_lang_sense_clarification": "людям"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "nos",
                                "target_lang_sense_clarification": "a los humanos / a las personas en general"
                            },
                            {
                                "target_lang_word": "nosotros",
                                "target_lang_sense_clarification": "tras preposición"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0661aaa-23b8-38e5-80bc-9826cf4ab21f",
                    "sense_definition": "<w>Me</w>; used by a single person to refer to themselves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "singular_reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Give <w>us</w> a kiss before you go to work.",
                            "target_lang_translations": {
                                "ru": "Поцелуй <w>меня</w> перед уходом на работу.",
                                "es": "Dame <w>un</w> beso antes de irte a trabajar."
                            }
                        },
                        {
                            "text": "Could you lend <w>us</w> a hand with this heavy box?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты помочь <w>мне</w> с этой тяжелой коробкой?",
                                "es": "¿Podrías echar<w>me</w> una mano con esta caja tan pesada?"
                            }
                        }
                    ],
                    "synonyms": [
                        "me"
                    ],
                    "common_phrases": [
                        "give us a look",
                        "tell us about it"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British, regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "<w>Мне</w>; используется одним человеком для обозначения самого себя.",
                        "es": "Forma coloquial equivalente a «me» (a mí); utilizada por una sola persona para referirse a sí misma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мне",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "меня",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "me",
                                "target_lang_sense_clarification": "coloquial, uso individual"
                            },
                            {
                                "target_lang_word": "mí",
                                "target_lang_sense_clarification": "tras preposición"
                            }
                        ]
                    }
                }
            ]
        },
        {
