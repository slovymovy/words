                                                "text": "http://counties.cce.cornell.edu/suffolk/grownet/flowers/sprgbulb.htm\nThe Culture of Spring-Flowering Bulbs"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27bdcf44-2f7d-368d-9634-22ebaff830cc",
