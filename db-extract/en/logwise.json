                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8635edaa-f708-44f6-b020-f09642c1a54a",
                                "sense_id": "b6447dd2-9d9d-3a84-95f1-e10cc8dccb37",
                                "text": "Still the old man stood mute. So, logwise, — down to floor / Pulled from his fireside place, dragged on from hearth to door, — / Was he pushed, a very log, staircase along, until / A certain turn in the steps was reached, a yard from the house-door-sill."
                            },
                            {
                                "example_id": "d23f1b90-8986-4f0f-91d6-fe7088a766eb",
                                "sense_id": "b6447dd2-9d9d-3a84-95f1-e10cc8dccb37",
                                "text": "And he, the churl, / Shrank as the beetle shrinks beneath the pin / When village children stab him in their sport, / And, logwise, rolled before the charger's feet; And Stephen came to his own Court again."
                            }
                        ]
                    }
