    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
                "word": "repugnance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "953cd94d-77cb-4a01-86fa-a4ebf3b87450",
                        "entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
                        "tags": [
                            "plural"
                        ],
                        "form": "repugnances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                        "entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
                        "glosses": [
                            "Extreme aversion, repulsion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "86e92eed-9ffb-433a-b1a8-11a4b92b7c7c",
                                "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                                "text": "She felt a deep repugnance toward violence."
                            },
                            {
                                "example_id": "73142eff-975b-4664-977d-041af1268e76",
                                "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                                "text": "He showed open repugnance at the suggestion."
                            },
                            {
                                "example_id": "994b6ba8-e746-4b6a-9005-e6d562df6374",
                                "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                                "text": "moral repugnance"
                            },
                            {
                                "example_id": "fed9860b-9b6b-47b2-90b9-c7ea82d2980f",
                                "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                                "text": "sense of repugnance"
                            },
                            {
                                "example_id": "f4269f99-0f42-4ff5-8135-44ccb2a8925e",
                                "sense_id": "532c7837-3d71-37d0-a9ab-f79304be5ed5",
                                "text": "express repugnance"
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf9c52c-2d76-3b8e-90f7-571bf9e738ff",
                        "entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
                        "glosses": [
                            "Contradiction, inconsistency, incompatibility, incongruity; an instance of such."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "476cf25f-db7b-4805-83f0-5e2a89b33d4a",
                                "sense_id": "bbf9c52c-2d76-3b8e-90f7-571bf9e738ff",
                                "text": "Discourses vain, inconsistant, and full of repugnances and contradictions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e87cc202-ebc1-4592-ad32-0284864eb384",
                        "source_entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
                        "source_sense_description": "Translations",
                        "target_lang_word": "répugnance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répugnance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                        "entry_id": "f78927c8-aca3-3f12-85f1-320fcf12b9fc",
                                        "glosses": [
                                            "Opposition naturelle, éloignement ou répulsion pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743684c0-c589-4226-a0d4-5dd99093d3bd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Alors Athos tira de sa poche un petit papier sur lequel étaient écrites deux lignes accompagnées d’une signature et d’un sceau, et le présenta à celui qui donnait trop prématurément ces signes de répugnance."
                                            },
                                            {
                                                "example_id": "0000f741-1e5c-4492-b10a-20e8145feddd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Ce fut donc le clergé qui, à Plassans, mena la réaction. La noblesse devint son prête-nom, rien de plus ; il se cacha derrière elle, il la gourmanda, la dirigea, parvint même à lui rendre une vie factice. Quand il l’eut amenée à vaincre ses répugnances au point de faire cause commune avec la bourgeoisie, il se crut certain de la victoire."
                                            },
                                            {
                                                "example_id": "bcbfb70a-38fe-44b1-a0b0-b4a0742b2caa",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "L’iguane est un plat médiocre, disent les uns, cela sent le reptile. Mais si l'on peut vaincre sa répugnance, cela constitue un plat de résistance et qui vaut bien le singe rouge. Quant à moi, j'en suis très friand ; […]."
                                            },
                                            {
                                                "example_id": "a3dffe78-fedb-4abf-8145-0033419d4024",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Il est vrai, […], que le juifs, plus versés que les prêtres chrétiens dans la connaissance des Écritures, étaient de redoutables controversistes, à ce point que Saint Louis manifesta sa répugnance pour les discussions entre les juifs et les chrétiens insuffisamment instruits : […]."
                                            },
                                            {
                                                "example_id": "d45a7b05-e12a-41fd-a1a5-8660ca6455b0",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Sa nuit de noce n'avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "e7c6a1b3-82a1-4914-8204-6555e31967be",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Un problème d’incontinence peut ne pas être reconnu étant donné la répugnance de la personne à parler de quelque chose d’aussi privé et d’aussi intime que la fonction urinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceea4883-ab52-4c52-99f1-93bcf4736ea9",
                        "source_entry_id": "6ee47d7e-5237-34e3-a103-a38c4061b619",
