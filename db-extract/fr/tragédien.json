                "senses": [
                    {
                        "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                        "entry_id": "14e213d2-943a-3adc-9757-f42f814aebf4",
                        "glosses": [
                            "Acteur, actrice tragique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e909e3-15aa-4c7b-b4d8-dbdc44c91aca",
                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                "text": "C’est un grand tragédien, une grande tragédienne."
                            },
                            {
                                "example_id": "2bc22e51-4173-434e-bbf9-72435fa6f99c",
                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                "text": "aussi, jouerais-je là un rôle hors de mon emploi, comme disent les tragédiens, et je risquerais de me faire siffler, ce qui est inutile"
                            },
                            {
                                "example_id": "a16d2706-741f-458d-b028-fd9b79e91aca",
                                "sense_id": "22d82fe4-087b-3036-8c21-edac57f4d2f3",
                                "text": "Un premier accessit de tragédie et un tragédien, ce n’est malheureusement pas la même chose…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
