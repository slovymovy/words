                        "source_entry_id": "c3e62fcf-319d-3866-ba03-c47bf3acb7cc",
                        "source_sense_id": "5c10dfd8-032a-3f28-9fd5-70f4e908109f",
                        "source_sense_description": "de studie van alles wat de omvang, samenstelling en spreiding van een bepaalde bevolkingsgroep en de veranderingen hierin betreft",
