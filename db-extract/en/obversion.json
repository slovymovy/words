                        "examples": [
                            {
                                "example_id": "71ca8273-f7df-41e8-a309-9d0f9c7768c1",
                                "sense_id": "cde23b10-3c89-3b64-aa25-ae1e5b63eda9",
                                "text": "All men are mortal, so, by obversion, no men are immortal."
                            },
                            {
                                "example_id": "69e7d9f1-8772-4a85-82e3-f97a5610e51e",
                                "sense_id": "cde23b10-3c89-3b64-aa25-ae1e5b63eda9",
                                "text": "From 'warmth is agreeable' we can affirm, by formal obversion, 'warmth is not disagreeable, and not indifferent.' We cannot affirm, without an examination of the subject matter, 'cold is disagreeable.'"
                            }
                        ]
