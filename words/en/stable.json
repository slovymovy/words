{
    "word_family": [
        "stability",
        "stabilize",
        "stabilizer",
        "stabilization",
        "unstable",
        "instability"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bc9b1099-9d96-3a0a-8970-978550d17736",
                    "sense_definition": "Firmly fixed or established; not likely to change, move, deteriorate, or fail.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is looking for a <w>stable</w> job with a regular income.",
                            "target_lang_translations": {
                                "ru": "Он ищет <w>стабильную</w> работу с регулярным доходом.",
                                "zh": "他正在寻找一份收入规律的<w>稳定</w>工作。"
                            }
                        },
                        {
                            "text": "The patient is now in a <w>stable</w> condition after the surgery.",
                            "target_lang_translations": {
                                "ru": "Пациент сейчас находится в <w>стабильном</w> состоянии после операции.",
                                "zh": "手术后，病人的情况目前已经<w>稳定</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "steady",
                        "fixed",
                        "unvarying",
                        "secure",
                        "constant"
                    ],
                    "antonyms": [
                        "unstable",
                        "varying",
                        "mobile"
                    ],
                    "common_phrases": [
                        "stable relationship",
                        "stable condition",
                        "stable economy",
                        "stable government"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо установленный; не склонный к изменениям, перемещениям или ухудшению.",
                        "zh": "稳固的；不易改变、移动、恶化或失败的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стабильный",
                                "target_lang_sense_clarification": "постоянный, неизменный"
                            },
                            {
                                "target_lang_word": "устойчивый",
                                "target_lang_sense_clarification": "твердый, непоколебимый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稳定",
                                "target_lang_sense_clarification": "形容状态或局势不易变动"
                            },
                            {
                                "target_lang_word": "稳固",
                                "target_lang_sense_clarification": "形容结构或基础牢固"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7674dfc1-71d0-3140-ab25-59ddec9159d6",
                    "sense_definition": "Of software: reliable and free from serious errors, bugs, or crashes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adj_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should download the latest <w>stable</w> version of the application.",
                            "target_lang_translations": {
                                "ru": "Вам следует скачать последнюю <w>стабильную</w> версию приложения.",
                                "zh": "你应该下载该应用程序的最新<w>稳定</w>版本。"
                            }
                        },
                        {
                            "text": "The beta release is not yet <w>stable</w> enough for daily use.",
                            "target_lang_translations": {
                                "ru": "Бета-версия еще недостаточно <w>стабильна</w> для повседневного использования.",
                                "zh": "测试版目前还不够<w>稳定</w>，无法用于日常使用。"
                            }
                        }
                    ],
                    "antonyms": [
                        "unstable"
                    ],
                    "common_phrases": [
                        "stable version",
                        "stable release"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О программном обеспечении: надежный и без серьезных ошибок или сбоев.",
                        "zh": "指软件：可靠且没有严重错误、漏洞或崩溃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стабильный",
                                "target_lang_sense_clarification": "о работе программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "稳定",
                                "target_lang_sense_clarification": "指软件版本运行可靠"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ae4db583-f340-39fb-9f0a-4322590410df",
                    "sense_definition": "A building where horses are kept, fed, and cared for.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_building",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horses were led back to the <w>stable</w> for the night.",
                            "target_lang_translations": {
                                "ru": "Лошадей отвели обратно в <w>конюшню</w> на ночь.",
                                "zh": "马匹被带回<w>马厩</w>过夜。"
                            }
                        },
                        {
                            "text": "She spends every weekend cleaning the <w>stable</w> and grooming the ponies.",
                            "target_lang_translations": {
                                "ru": "Она проводит каждые выходные, убирая <w>конюшню</w> и ухаживая за пони.",
                                "zh": "她每个周末都花时间打扫<w>马厩</w>并梳理小马。"
                            }
                        }
                    ],
                    "synonyms": [
                        "horsebarn",
                        "barn"
                    ],
                    "common_phrases": [
                        "riding stable",
                        "livery stable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, где содержат, кормят и ухаживают за лошадьми.",
                        "zh": "饲养、喂养和照料马匹的建筑物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конюшня",
                                "target_lang_sense_clarification": "помещение для лошадей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马厩",
                                "target_lang_sense_clarification": "专门用于关马的建筑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9da487f9-b0bd-397f-a6c9-854c916ed54e",
                    "sense_definition": "A group of people, animals (especially racehorses), or products managed or trained by the same person or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trainer has a large <w>stable</w> of champion racehorses.",
                            "target_lang_translations": {
                                "ru": "У тренера большая <w>конюшня</w> чемпионских скаковых лошадей.",
                                "zh": "这位训练师拥有一大<w>群</w>冠军赛马。"
                            }
                        },
                        {
                            "text": "The modeling agency manages a <w>stable</w> of talented young faces.",
                            "target_lang_translations": {
                                "ru": "Модельное агентство управляет <w>группой</w> талантливых молодых лиц.",
                                "zh": "这家模特经纪公司管理着一<w>批</w>才华横溢的年轻面孔。"
                            }
                        }
                    ],
                    "synonyms": [
                        "string"
                    ],
                    "common_phrases": [
                        "racing stable",
                        "stable of artists"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей или животных (особенно скаковых лошадей), управляемых одной организацией.",
                        "zh": "由同一个人或组织管理或训练的一群人、动物（特别是赛马）或产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конюшня",
                                "target_lang_sense_clarification": "спортивная команда или группа лошадей"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "коллектив людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马群",
                                "target_lang_sense_clarification": "指同一训练师名下的马匹"
                            },
                            {
                                "target_lang_word": "旗下艺人",
                                "target_lang_sense_clarification": "指同一经纪公司管理的艺人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "016c2f4b-faf2-3c48-9e55-2807907f1037",
                    "sense_definition": "To put or keep a horse in a stable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_keep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>stabled</w> the horses before the heavy storm began.",
                            "target_lang_translations": {
                                "ru": "Они <w>поставили в конюшню</w> лошадей до того, как началась сильная буря.",
                                "zh": "暴风雨来临前，他们把马<w>关进了马厩</w>。"
                            }
                        },
                        {
                            "text": "The farmer <w>stables</w> his animals during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Фермер <w>содержит в конюшне</w> своих животных в холодные зимние месяцы.",
                                "zh": "寒冷的冬季，农夫会将动物<w>关在马厩</w>里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещать или содержать лошадь в конюшне.",
                        "zh": "把马关进马厩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в конюшню",
                                "target_lang_sense_clarification": "размещать животное"
                            },
                            {
                                "target_lang_word": "содержать в конюшне",
                                "target_lang_sense_clarification": "обеспечивать уход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关入马厩",
                                "target_lang_sense_clarification": "将马匹安置在马厩中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ad285b5-32ed-3279-8b15-42fa9003f3d8",
                    "sense_definition": "To park a train or rail vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_rail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train was <w>stabled</w> at the depot overnight for maintenance.",
                            "target_lang_translations": {
                                "ru": "Поезд был <w>поставлен в депо</w> на ночь для технического обслуживания.",
                                "zh": "列车被<w>停放</w>在车库过夜以进行维护。"
                            }
                        },
                        {
                            "text": "Drivers must ensure the locomotive is properly <w>stabled</w> before leaving.",
                            "target_lang_translations": {
                                "ru": "Машинисты должны убедиться, что локомотив правильно <w>поставлен в отстой</w> перед уходом.",
                                "zh": "司机在离开前必须确保机车已妥善<w>停放</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "rail transport"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Парковать поезд или железнодорожный состав.",
                        "zh": "停放火车或铁路车辆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставить в депо",
                                "target_lang_sense_clarification": "о поезде"
                            },
                            {
                                "target_lang_word": "ставить в отстой",
                                "target_lang_sense_clarification": "железнодорожный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停放",
                                "target_lang_sense_clarification": "指列车在车站或车库停靠"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}