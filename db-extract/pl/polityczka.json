                        "examples": [
                            {
                                "example_id": "a4cc5c73-b97a-4987-aa89-6af6c4a9741b",
                                "sense_id": "e29dce0b-e94e-3b2b-820f-26e7e33aaf8f",
                                "text": "Pani redaktor, jestem polityczką i w polityce trzeba się umieć wznosić ponad osobiste, że tak powiem, urazy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
