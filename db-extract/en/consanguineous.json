                        "source_entry_id": "0ce7fe27-38bd-3393-8ba0-e57c6efca811",
                        "source_sense_id": "d831c5f9-f37f-301a-8cbf-efe50a325660",
                        "source_sense_description": "related by birth",
                        "target_lang_word": "consanguin",
