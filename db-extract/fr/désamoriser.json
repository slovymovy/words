                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d2ebfe-7e23-4a07-9b79-ae11e24303f4",
                                "sense_id": "eb08104e-38ed-3aa1-99e2-4f2f213f038a",
                                "text": "Sur l’érotisme (voir Strip-Tease) n’avez-vous pas, une fois au moins, eu l’impression que l’on cherchait plutôt par des moyens spectaculaires à « désérotiser», à « désamoriser » la vie quotidienne de l’homme (et de la femme) ?"
                            },
                            {
                                "example_id": "1f5cd6f6-5f72-4abf-b047-b8329cf1d649",
                                "sense_id": "eb08104e-38ed-3aa1-99e2-4f2f213f038a",
                                "text": "S’humaniser ou se déshumaniser ce qui est s’amoriser ou se désamoriser."
                            }
                        ]
                    }
