                                        "sense_id": "03b064c4-9957-3ed8-b309-6931366ddccb",
                                        "entry_id": "728bd97e-d129-3a71-8e97-fda0afa2fc50",
                                        "glosses": [
                                            "literarisches Stilmittel: Gleichklang von Vokalen in Wörtern, die benachbart im Text vorkommen (Prosa) oder in Versenden (Dichtung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637d8cf1-7562-43ab-92b8-dd724546de5e",
                                                "sense_id": "03b064c4-9957-3ed8-b309-6931366ddccb",
                                                "text": "„Ein weiteres stilistisches Element, das den Zusammenhalt und die Einprägsamkeit einer Zwillingsformel fördert, ist Assonanz, d. h. ein sich auf die Vokale beschränkender Gleichklang zwischen zwei oder mehreren Wörtern, wie z. B. in ‚hit or miss‘ (‚aufs Geratewohl‘)…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c106306-5562-4a20-88cb-e7efbdff42d0",
                        "source_entry_id": "20a48bf5-24d1-3b1b-af97-41dad92078f2",
                        "source_sense_id": "57465ba1-091e-301f-aefa-2658b908fbfb",
