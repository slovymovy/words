                "senses": [
                    {
                        "sense_id": "d6b71c0d-cf49-369c-b03b-57d4d29d75cf",
                        "entry_id": "fe7cd5d1-5404-315c-8f02-c43fb1040861",
                        "glosses": [
                            "Morgengebet des Stundengebets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49633d9-5bc8-416e-ba34-b4e6413567f3",
                                "sense_id": "d6b71c0d-cf49-369c-b03b-57d4d29d75cf",
                                "text": "Die Laudes werden bei Tagesanbruch (nämlich etwa zwischen 6 Uhr und 8 Uhr morgens) gehalten, da die aufgehende Sonne ein Symbol für Christus ist, dem mit den Laudes Lob dargebracht wird."
                            },
                            {
                                "example_id": "6838abb1-576f-40f5-a0b8-77f4105ea325",
                                "sense_id": "d6b71c0d-cf49-369c-b03b-57d4d29d75cf",
                                "text": "Die Laudes bestehen aus Hymnus, Psalmen, Schriftlesung, Benedictus, Bitten, Vater unser, Tagesgebet und Segen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
