                "senses": [
                    {
                        "sense_id": "294f52f3-0675-3d6a-8ad3-d1a91fe08a6c",
                        "entry_id": "ea0c017b-856d-39bf-8c33-2f50f47032f0",
                        "glosses": [
                            "Person mit den durchschnittlichen/mittleren Ausprägungen der Eigenschaften eines Amerikaners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "148d05cb-3f14-4f4a-8de9-f3655e8ddeba",
                                "sense_id": "294f52f3-0675-3d6a-8ad3-d1a91fe08a6c",
                                "text": "„Er und Elsa hatten immer Witze darüber gemacht, was für unglaubliche Durchschnittsamerikaner ihre Eltern waren.“"
                            },
                            {
                                "example_id": "26f553ed-9186-468d-95b8-4862ed876d7a",
                                "sense_id": "294f52f3-0675-3d6a-8ad3-d1a91fe08a6c",
                                "text": "„Die Mitglieder, die Flüchtlinge waren, hatten im Rahmen des amerikanischen Traums die Rolle der Unglücklichen zugewiesen bekommen, damit der Durchschnittsamerikaner sich seines eigenen Glücks bewusst wurde.“"
                            },
                            {
                                "example_id": "f8cc3050-c0af-43df-a68d-95960fa5c474",
                                "sense_id": "294f52f3-0675-3d6a-8ad3-d1a91fe08a6c",
                                "text": "„Und so machte Taylor sich auf den Weg, brauste mit seinem weißen Lieferwagen durch den Vorort, plauderte auf dem Parkplatz vor dem Burger King mit der hübschen Bedienung und holte Bier bei 7-Eleven, wie ein ganz normaler Durchschnittsamerikaner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
