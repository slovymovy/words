                        "glosses": [
                            "soort ronde bacterie die in kettingen achter elkaar liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca15d6be-9dc6-4e9c-83ff-56ca1786ea57",
                                "sense_id": "f4cac787-52b1-3dbd-a056-dbbfd10bc413",
                                "text": "Kraamvrouwenkoorts wordt veroorzaakt door de zogeheten groep A streptokok. Bij besmetting met deze bacterie kan een kraamvrouw ernstig ziek worden in de eerste drie weken na de bevalling."
                            },
                            {
                                "example_id": "df6c25dd-b077-4ca0-a07e-15653bdc095f",
                                "sense_id": "f4cac787-52b1-3dbd-a056-dbbfd10bc413",
                                "text": "Mozart stierf door streptokok: Volgens de verslagen van de sterfgevallen bezweken veel mannen van rond de veertig jaar in december 1791 aan de streptokokkenbesmetting. Andere veelvoorkomende doodsoorzaken uit die tijd, zoals tuberculose en ondervoeding, lijken minder goed te passen bij het ziektebeeld van Mozart, stellen Zegers en zijn collega's."
                            }
                        ]
                    }
