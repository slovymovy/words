                        "glosses": [
                            "Resembling or characteristic of a prude; prudishly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc8e2564-a959-40d8-9487-9b9b1e78737e",
                                "sense_id": "3f0a9ff0-8513-3d28-a9f2-2d44bb206bd0",
                                "text": "Had late observed my silent tear,\nThat I was press'd, and press'd most rudely,\nNot to behave so very prudely ;"
                            },
                            {
                                "example_id": "d8dfa45e-d094-4959-87b2-dac2b3fbdb2f",
                                "sense_id": "3f0a9ff0-8513-3d28-a9f2-2d44bb206bd0",
                                "text": "When you family-prayed on Sunday nights—\nThe living room a crowd of things to do\nEach prudely solemn word defined your rights."
                            }
                        ]
                    }
