                "senses": [
                    {
                        "sense_id": "5902c5d4-cf5b-3a61-971b-414b9f13eae9",
                        "entry_id": "11c0a938-31c8-36bc-99c3-ae054c82a761",
                        "glosses": [
                            "Donner un caractère rhétorique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d71bb95-7180-4776-be6e-772fd6244d9e",
                                "sense_id": "5902c5d4-cf5b-3a61-971b-414b9f13eae9",
                                "text": "Elle est rhétoricisée par un souci d’égalité qui la relie aux autres genres discursifs ne relevant pas de l’empirisme propre."
                            },
                            {
                                "example_id": "ecf56881-81d8-46bf-9169-dffad04906ca",
                                "sense_id": "5902c5d4-cf5b-3a61-971b-414b9f13eae9",
                                "text": "Le pragmatisme, mais pas sous forme excessivement herméneutisée, rhétoricisée et linguistico-holiste défendue par R. Rorty, associée à certains aspects du rationalisme critique (K. Popper, H. Albert), constituerait une représentation philosophique plus réaliste conforme à l’être-au-monde technoscientifique."
                            }
                        ]
                    }
