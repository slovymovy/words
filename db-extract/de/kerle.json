                                "sense_id": "f331995a-68b5-332a-8c8e-b6cfefbd46d2",
                                "text": "Er ist ein Kerle wie ein Schrank."
                            },
                            {
                                "example_id": "0f84caf8-d542-4743-bb59-4f37646e7318",
                                "sense_id": "f331995a-68b5-332a-8c8e-b6cfefbd46d2",
                                "text": "Den Kerle kann man brauchen!"
                            },
                            {
                                "example_id": "0950f732-c99d-4829-9786-ef3217e910f7",
                                "sense_id": "f331995a-68b5-332a-8c8e-b6cfefbd46d2",
                                "text": "In unserer Klasse waren zwölf Mädchen und elf Kerle."
                            }
                        ],
