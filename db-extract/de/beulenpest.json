                ],
                "senses": [
                    {
                        "sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                        "entry_id": "40adcaeb-5996-3cd7-a41b-a2fcd0f552c5",
                        "glosses": [
                            "durch Rattenflöhe übertragene Infektionskrankheit, die stark angeschwollene und blau-schwarz verfärbte Lymphknoten verursacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a4b9903-3366-474b-a73b-d9b991327dd3",
                                "sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                                "text": "„Aus einer Beulenpest entwickelt sich ohne Behandlung oftmals eine Pestsepsis, die zu einer Lungenpest führt.“"
                            },
                            {
                                "example_id": "b53cd140-4614-4e15-a1cf-dde518cff299",
                                "sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                                "text": "Auf Madagaskar hat es einen Ausbruch zuerst der Beulenpest und jetzt auch der Lungenpest gegeben."
                            },
                            {
                                "example_id": "aa7cca52-6f2e-4004-bbce-bd4c5bb7f253",
                                "sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                                "text": "„Gelahrte Männer haben in ihren Büchern mancherlei über die vielen Vorboten aufgezeichnet, welche die Beulenpest auf Island ankündigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54c6783d-d7fd-4b89-8154-b2728a187b60",
                        "source_entry_id": "40adcaeb-5996-3cd7-a41b-a2fcd0f552c5",
                        "source_sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                        "source_sense_description": "durch Rattenflöhe übertragene Infektionskrankheit, die einen Befall der Lymphknoten verursacht",
                        "target_lang_word": "bubonic plague",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bubonic plague",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bc8163a-762a-3009-b80e-3cac1dcfb8fe",
                                        "entry_id": "ff95f21a-9080-3cb7-ad2f-c47316743d0f",
                                        "glosses": [
                                            "A contagious, often fatal, epidemic disease caused by the bacterium Yersinia pestis, transmitted by the bite of fleas from an infected person or rodent, especially a rat, and characterized by delirium, chills, fever, vomiting, diarrhea, and the formation of buboes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "530b422a-2364-4dba-b437-4322110029a5",
                        "source_entry_id": "40adcaeb-5996-3cd7-a41b-a2fcd0f552c5",
                        "source_sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                        "source_sense_description": "durch Rattenflöhe übertragene Infektionskrankheit, die einen Befall der Lymphknoten verursacht",
                        "target_lang_word": "peste bubonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peste bubonique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b2517c3-2eab-300b-a76b-1f38ad9aefe9",
                                        "entry_id": "b614ade1-b7aa-36ca-9cd3-f8a4ee7b8161",
                                        "glosses": [
                                            "Forme à bubons de la peste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b6ac47-1812-4c3e-87cf-93865fb17502",
                                                "sense_id": "9b2517c3-2eab-300b-a76b-1f38ad9aefe9",
                                                "text": "— On pourrait, dit Broudier, faire passer une note dans les journaux de Paris annonçant dix-sept cas de choléra asiatique à Ambert, et treize cas de peste bubonique à Issoire."
                                            },
                                            {
                                                "example_id": "2da05c1c-39b7-48b7-841b-3b4acc4c4190",
                                                "sense_id": "9b2517c3-2eab-300b-a76b-1f38ad9aefe9",
                                                "text": "On sait que le microbe de la peste est un cocco-bacille appartenant au genre Pasteurella, dont les différentes espèces produisent les septicémies hémorragiques des animaux. C'est en effet le cas de la peste, puisque, de ses deux formes, la pneumonie pesteuse est primitivement une septicémie des marmottes, tandis que la peste bubonique est primitivement une septicémie des rats."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc555eb4-9751-4222-a36c-974e1f66d1eb",
                        "source_entry_id": "40adcaeb-5996-3cd7-a41b-a2fcd0f552c5",
                        "source_sense_id": "451632f8-6b9a-3cad-a3b1-ca1e55c07036",
                        "source_sense_description": "durch Rattenflöhe übertragene Infektionskrankheit, die einen Befall der Lymphknoten verursacht",
                        "target_lang_word": "builenpest",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "builenpest",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1bef2f-d1fb-303a-91b6-15564580176a",
                                        "entry_id": "aa967245-2709-30c5-854b-90202c81e150",
                                        "glosses": [
                                            "de meest voorkomende vorm van pest en wordt veroorzaakt door de Yersinia pestis-bacterie en overgebracht door de rattenvlo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44326cfa-2b43-475b-929a-eff115382b59",
                                                "sense_id": "dd1bef2f-d1fb-303a-91b6-15564580176a",
                                                "text": "Totdat, binnen een jaar of twee, drie, als die nieuwe zwarte builenpest doorzet - en niet alleen binnen jullie gelederen - dat fraaie lijntje iets dubbelzinnige krijgt, iets verdachts."
                                            },
                                            {
                                                "example_id": "eaa7b61c-87e9-460d-933c-1f1c3f247b15",
                                                "sense_id": "dd1bef2f-d1fb-303a-91b6-15564580176a",
                                                "text": "Onderzoekers vingen 133 ratten en vonden op hun lichaam meer dan 6500 vlooien, luizen en mijten. Een van die vlooiensoorten staat erom bekend dat hij de builenpest, ook bekend als de zwarte dood, kan doorgeven aan mensen. De pest wordt veroorzaakt door een bacterie, Yersinia pestis, die verspreid wordt door vlooien die met name op de zwarte rat parasiteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
