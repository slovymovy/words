                        "entry_id": "f8ec07a4-2204-3f0a-b566-d2f9e6711295",
                        "glosses": [
                            "kobieta współpracująca z nieakceptowaną przez daną społeczność władzą, zwłaszcza okupacyjną"
                        ],
                        "tags": [
                            "literary",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "7adfb6e4-1dad-41d2-bc80-8fb7fc96593f",
                                "sense_id": "486b8e49-7f4e-3fe7-8ebf-1f6e25cf7a57",
                                "text": "Nieliczne Żydówki, które wbrew zarządzeniu i groźbie kary śmierci nosiły futrzane okrycia, były powszechnie postrzegane jako kolaborantki i konfidentki gestapo"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
