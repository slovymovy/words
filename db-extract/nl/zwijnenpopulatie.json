                        "glosses": [
                            "de groep zwijnen die in een bepaald gebied wonen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3378b8be-6d4a-4e4c-bacd-173f036dc765",
                                "sense_id": "736b845d-98b3-38d0-9331-ab6f937fa101",
                                "text": "De zwijnenpopulatie op de Veluwe groeit al jaren explosief. Er is voldoende voedsel voor de dieren, die daardoor ook steeds meer biggen krijgen. Groepen zwijnen zoeken het bewoonde gebied op, waar ze ongelukken en landbouwschade veroorzaken en particuliere tuinen omwoelen."
                            },
                            {
                                "example_id": "5a5051f9-47b6-4958-898e-e23dee1dbc1f",
                                "sense_id": "736b845d-98b3-38d0-9331-ab6f937fa101",
                                "text": "Volgens haar is de zwijnenpopulatie in en rond het Engbertsdijksvenen de laatste vier jaar fors toegenomen. Boeren worden in geval van schade met aanzienlijke kosten en een hoog eigen risico geconfronteerd."
                            }
                        ]
                    }
