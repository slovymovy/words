                "senses": [
                    {
                        "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                        "entry_id": "36b0ab23-ee3b-310c-93b1-77ec50c38f4c",
                        "glosses": [
                            "Reihe von Sachgebieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5202ff-0585-4c8c-8be6-f6f023d9dd4a",
                                "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                                "text": "„Die interdisziplinäre Kooperation ist sicherlich kein Wundermittel, das die Schulmüdigkeit und Anstrengungsträgheit allein beheben könnte. Aber sie ist ein Weg, übergreifende Zusammenhänge und das geistige Band des Fächerspektrums erkennbar werden zu lassen […].“"
                            },
                            {
                                "example_id": "0230fcea-6205-4c96-af24-7aad5c0a23d8",
                                "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                                "text": "„In den 1960er Jahren ergänzte auch Baden-Württemberg sein Fächerspektrum um Politische Bildung und Arbeitslehre.“"
                            },
                            {
                                "example_id": "67ad5cca-9385-46c7-9fe9-0b953701b789",
                                "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                                "text": "„Beim Fächerspektrum sind wir auf Kooperationen angewiesen, da ein Land allein bestimmte Fächer wie Medizin oder Luft- und Raumfahrttechnik nicht finanzieren kann.“"
                            },
                            {
                                "example_id": "101beffe-46a0-4382-b6a4-a333463af16e",
                                "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                                "text": "„Die TU muss also ein breites Fächerspektrum anbieten und zugleich mit den renommierten Technischen Universitäten von Aachen und München oder der ETH Zürich konkurrieren können.“"
                            },
                            {
                                "example_id": "896e237b-ff26-400c-9f34-9a6c98f4c813",
                                "sense_id": "0c51fd23-3055-33d3-8e9b-6980946da220",
                                "text": "„Mit ihrem breiten Fächerspektrum bietet sie zahlreiche Möglichkeiten zur interdisziplinären Zusammenarbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
