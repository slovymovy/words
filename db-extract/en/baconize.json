                        "examples": [
                            {
                                "example_id": "4a1959a7-1436-4a00-82e3-71b80e5f8542",
                                "sense_id": "c9e5dca9-4868-3e6e-80e4-e5bae5687561",
                                "text": "Can you not choose a process more pleasant to the world at large, if you must thus “baconize” your bodies?"
                            },
                            {
                                "example_id": "827cd592-7d71-450f-92c0-9b057a5abdfd",
                                "sense_id": "c9e5dca9-4868-3e6e-80e4-e5bae5687561",
                                "text": "A plant will be established in Everett by the Baconized Salmon Company of Juneau, Alaska, for the manufacture of baconized salmon."
                            }
