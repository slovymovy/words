                ],
                "senses": [
                    {
                        "sense_id": "3b6d7244-f8c7-3aed-8825-693364e52205",
                        "entry_id": "953a9ea6-b176-3dd7-a249-db61ac979931",
                        "glosses": [
                            "Tage, an denen sich Punks und krawallbereite Hooligans in einer Stadt treffen und sich oft heftige Auseinandersetzungen mit Polizeikräften liefern"
                        ],
                        "tags": [
                            "überwiegend im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "45f1522f-7c0b-4fd1-92a5-1400447bd0a1",
                                "sense_id": "3b6d7244-f8c7-3aed-8825-693364e52205",
                                "text": "„Natürlich hätte niemand ein zweites Mal zusehen mögen, wie bunthaarige Krawallbrüder die Innenstadt entglasen oder Polizisten verprügeln. Natürlich wollte niemand ein Jahr nach den Chaostagen 95 neuerlich rechtsfreie Räume dulden. Doch genau besehen ist in Hannover etwas Ähnliches geschehen. Nicht rechtsfreie Räume gab es, diesmal war die ganze Stadt eine Zone eingeschränkter Grundrechte.“"
                            },
                            {
                                "example_id": "fe4cfaf0-effc-4b5d-936b-dd24b8a2e6dd",
                                "sense_id": "3b6d7244-f8c7-3aed-8825-693364e52205",
                                "text": "„Denn die Kreuzberger Chaostage jähren sich 2007 zum 20. Mal, und ein paar Anstifter wollen diesen Umstand in bemerkenswert teutonischer Spießigkeit nutzen, um wieder richtig gegen den Schweinestaat in den Kampf zu ziehen.“"
                            },
                            {
                                "example_id": "74f07240-3691-41d5-873f-086ba6d64d5f",
                                "sense_id": "3b6d7244-f8c7-3aed-8825-693364e52205",
                                "text": "„So war es der Polizei vor den nächsten angekündigten Chaostagen 1996 etwa möglich, Aufenthaltsverbote in der hannoverschen Innenstadt für jeden zu verhängen, der irgendwie nach Punk aussah.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "98d7cc97-06a7-3f24-9bfb-2810a672f0eb",
                        "entry_id": "953a9ea6-b176-3dd7-a249-db61ac979931",
                        "glosses": [
                            "Tag, an dem alles drunter und drüber geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c095c46-082b-47db-afb6-d70609ac27a3",
                                "sense_id": "98d7cc97-06a7-3f24-9bfb-2810a672f0eb",
                                "text": "Bei dem Streik am Flughafen nächsten Samstag droht ein neuer Chaostag."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
