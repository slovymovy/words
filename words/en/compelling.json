{
    "word_family": [
        "compel",
        "compulsion",
        "compulsive",
        "compulsory",
        "compellable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3549bd10-77ea-344d-99d8-466cb9d8eb56",
                    "sense_definition": "Very interesting; able to capture and hold one's attention.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel was so <w>compelling</w> that I couldn't put it down.",
                            "target_lang_translations": {
                                "ru": "Роман был настолько <w>захватывающим</w>, что я не мог от него оторваться.",
                                "tr": "Roman o kadar <w>sürükleyiciydi</w> ki elimden bırakamadım."
                            }
                        },
                        {
                            "text": "The director created a <w>compelling</w> story about survival in the wilderness.",
                            "target_lang_translations": {
                                "ru": "Режиссер создал <w>увлекательную</w> историю о выживании в дикой природе.",
                                "tr": "Yönetmen vahşi doğada hayatta kalma üzerine <w>ilgi çekici</w> bir hikaye yarattı."
                            }
                        }
                    ],
                    "synonyms": [
                        "gripping"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "compelling story",
                        "compelling content",
                        "compelling character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень интересный; способный захватить и удерживать внимание.",
                        "tr": "Çok ilgi çekici; dikkatleri üzerine çekebilen ve sürdürebilen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "очень интересный, поглощающий внимание"
                            },
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "вызывающий большой интерес"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sürükleyici",
                                "target_lang_sense_clarification": "hikaye veya kitap için"
                            },
                            {
                                "target_lang_word": "ilgi çekici",
                                "target_lang_sense_clarification": "dikkati üzerine çeken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b039494e-eb19-3b22-aa4c-568a3f633d58",
                    "sense_definition": "Capable of causing someone to believe or agree.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a <w>compelling</w> argument for changing the company policy.",
                            "target_lang_translations": {
                                "ru": "Он привел <w>убедительный</w> довод в пользу изменения политики компании.",
                                "tr": "Şirket politikasını değiştirmek için <w>ikna edici</w> bir argüman sundu."
                            }
                        },
                        {
                            "text": "There is no <w>compelling</w> evidence to prove his theory is correct.",
                            "target_lang_translations": {
                                "ru": "Нет никаких <w>веских</w> доказательств, подтверждающих правильность его теории.",
                                "tr": "Teorisinin doğru olduğunu kanıtlayacak <w>güçlü</w> bir kanıt yok."
                            }
                        }
                    ],
                    "synonyms": [
                        "convincing"
                    ],
                    "antonyms": [
                        "unconvincing",
                        "weak"
                    ],
                    "common_phrases": [
                        "compelling argument",
                        "compelling evidence",
                        "compelling case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный убедить или заставить согласиться.",
                        "tr": "İkna edici, birinin inanmasını veya kabul etmesini sağlayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убедительный",
                                "target_lang_sense_clarification": "заставляющий поверить, доказательный"
                            },
                            {
                                "target_lang_word": "веский",
                                "target_lang_sense_clarification": "значимый, неопровержимый (о доводах)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ikna edici",
                                "target_lang_sense_clarification": "kanıt veya argüman için"
                            },
                            {
                                "target_lang_word": "güçlü",
                                "target_lang_sense_clarification": "vejetatif ve mantıklı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc962827-869d-3638-b87d-37a463c177b3",
                    "sense_definition": "Strong and forceful; causing one to feel like they must do something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would need a very <w>compelling</w> reason to leave my job right now.",
                            "target_lang_translations": {
                                "ru": "Мне нужна была бы очень <w>веская</w> причина, чтобы уйти с работы прямо сейчас.",
                                "tr": "Şu anda işimden ayrılmak için çok <w>geçerli</w> bir sebebe ihtiyacım olurdu."
                            }
                        },
                        {
                            "text": "She felt a <w>compelling</w> need to help the victims of the disaster.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>непреодолимую</w> потребность помочь жертвам катастрофы.",
                                "tr": "Afetzedelere yardım etmek için <w>karşı konulmaz</w> bir ihtiyaç hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "urgent",
                        "pressing"
                    ],
                    "common_phrases": [
                        "compelling reason",
                        "compelling need"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный и непреодолимый; вызывающий чувство необходимости действовать.",
                        "tr": "Güçlü ve zorlayıcı; insanı bir şey yapmak zorunda hissettiren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "о желании или потребности"
                            },
                            {
                                "target_lang_word": "веский",
                                "target_lang_sense_clarification": "о причине"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlayıcı",
                                "target_lang_sense_clarification": "güçlü bir his veya sebep için"
                            },
                            {
                                "target_lang_word": "kaçınılmaz",
                                "target_lang_sense_clarification": "karşı konulamaz gereksinim"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7411b072-ece5-32e4-a1b4-7132634b891f",
                    "sense_definition": "Present participle and gerund of <w>compel</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain is <w>compelling</w> us to stay indoors today.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>заставляет</w> нас сегодня оставаться дома.",
                                "tr": "Şiddetli yağmur bugün bizi evde kalmaya <w>zorluyor</w>."
                            }
                        },
                        {
                            "text": "They are <w>compelling</w> the witness to testify in court against his will.",
                            "target_lang_translations": {
                                "ru": "Они <w>принуждают</w> свидетеля давать показания в суде против его воли.",
                                "tr": "Tanığı kendi iradesi dışında mahkemede ifade vermeye <w>zorluyorlar</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>compel</w>.",
                        "tr": "Compel fiilinin şimdiki zaman ortacı ve ulaç biçimi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заставляющий",
                                "target_lang_sense_clarification": "вынуждающий силой или обстоятельствами"
                            },
                            {
                                "target_lang_word": "принуждающий",
                                "target_lang_sense_clarification": "навязывающий волю"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlayan",
                                "target_lang_sense_clarification": "zorunlu kılan"
                            },
                            {
                                "target_lang_word": "mecbur eden",
                                "target_lang_sense_clarification": "mecbur bırakan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3bf67c09-9038-37f8-9ffd-8eb8498b41ed",
                    "sense_definition": "An act of compulsion; an obliging somebody to do something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He resisted the <w>compellings</w> of his friends to join the party.",
                            "target_lang_translations": {
                                "ru": "Он сопротивлялся <w>принуждению</w> друзей присоединиться к вечеринке.",
                                "tr": "Partiye katılmak için arkadaşlarının <w>zorlamalarına</w> direndi."
                            }
                        },
                        {
                            "text": "The internal <w>compellings</w> of his conscience were too strong to ignore.",
                            "target_lang_translations": {
                                "ru": "Внутренние <w>требования</w> его совести были слишком сильны, чтобы их игнорировать.",
                                "tr": "Vicdanının içsel <w>baskıları</w> göz ardı edilemeyecek kadar güçlüydü."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт принуждения; обязательство кого-либо сделать что-либо.",
                        "tr": "Baskı yapma, birini bir şey yapmaya zorlama eylemi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждение",
                                "target_lang_sense_clarification": "насилие над волей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zorlama",
                                "target_lang_sense_clarification": "baskı yapma eylemi"
                            },
                            {
                                "target_lang_word": "baskı",
                                "target_lang_sense_clarification": "dıştan gelen zorunluluk"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}