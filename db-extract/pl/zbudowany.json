                                                "example_id": "9f470aa3-c324-47e1-9a60-1b3158c51191",
                                                "sense_id": "2c159b35-29d0-36d2-ad9b-44c6bb5c7f32",
                                                "text": "„Die robust gebauten Moas erreichten in den größten Arten 3,50 m.“"
                                            },
