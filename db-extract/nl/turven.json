                "translations": [
                    {
                        "translation_id": "58e5149d-3162-437d-b5a7-2df577c96fdb",
                        "source_entry_id": "4deada5e-c37a-3ee3-8aa1-0fa9716b69e9",
                        "source_sense_id": "4d3fea09-60dd-3c2c-8212-3c48d35c0d24",
