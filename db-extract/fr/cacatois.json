                                        "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                        "entry_id": "7f30d447-38b8-3831-82ff-05caab457c20",
                                        "glosses": [
                                            "Of or relating to a monarch or his (or her) family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60fcfc9d-5e22-4011-9595-17a42c4b12ec",
                                                "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance. […] But she said she must go back, and when they joined the crowd again her partner was haled off with a frightened look to the royal circle, […]"
                                            },
                                            {
                                                "example_id": "85a3a0ea-fd97-4903-9916-94d493a755dc",
                                                "sense_id": "65da7e00-7b2c-3ec3-ae6e-3a3c28a76c41",
                                                "text": "On the first Friday morning of his kingship he went into the kitchen and called for his royal chef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b4fc34-1a99-365b-9c99-c2b1860cfa13",
                                        "entry_id": "7f30d447-38b8-3831-82ff-05caab457c20",
                                        "glosses": [
                                            "Having the air or demeanour of a monarch; illustrious; magnanimous; of more than common size or excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2186f33-5aff-4311-bed3-2ab88f8c109f",
                                                "sense_id": "e7b4fc34-1a99-365b-9c99-c2b1860cfa13",
                                                "text": "How doth that royal Merchant good Anthonio;"
                                            }
                                        ]
                                    },
