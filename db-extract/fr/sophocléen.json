                    {
                        "sense_id": "dcb0ec05-5ea1-3dc6-8359-401508917729",
                        "entry_id": "4f3be277-4e9f-389b-b591-d26258fefc0f",
                        "glosses": [
                            "Qui appartient à Sophocle, poète tragique athénien, ou emprunte à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "096717b8-80f8-4818-8f63-bd08566ea007",
                                "sense_id": "dcb0ec05-5ea1-3dc6-8359-401508917729",
                                "text": "Notre ami Jules Lacroix, ce mouleur habile et consciencieux du groupe sophocléen, l’Œdipe roi."
                            },
                            {
                                "example_id": "252bc1c5-9dd2-48eb-b981-e2b0561ce950",
                                "sense_id": "dcb0ec05-5ea1-3dc6-8359-401508917729",
                                "text": "C’est en soi un symbole car avec cette pièce nous sommes au cœur de la poésie sophocléenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0a25d86-1424-4950-bea2-8ab756ab35c3",
                        "source_entry_id": "4f3be277-4e9f-389b-b591-d26258fefc0f",
                        "source_sense_id": "dcb0ec05-5ea1-3dc6-8359-401508917729",
                        "target_lang_word": "Sophoclean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sophoclean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6e22fc1-c475-39df-a18f-8dcac3e8f6ae",
                                        "entry_id": "21e4d077-37be-32c1-b06a-e0ed31cda505",
                                        "glosses": [
                                            "Of or pertaining to Sophocles or his works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea5e53b2-332d-4fa6-8bc0-8af594fcc0d7",
                                                "sense_id": "e6e22fc1-c475-39df-a18f-8dcac3e8f6ae",
                                                "text": "It was one of those sequestered spots outside the gates of the world where may usually be found more meditation than action, and more passivity than meditation; where reasoning proceeds on narrow premises, and results in inferences wildly imaginative; yet where, from time to time, no less than in other places, dramas of a grandeur and unity truly Sophoclean are enacted in the real, by virtue of the concentrated passions and closely knit interdependence of the lives therein."
                                            },
                                            {
                                                "example_id": "45edc84b-2764-4cab-81a3-9fa84b586b53",
                                                "sense_id": "e6e22fc1-c475-39df-a18f-8dcac3e8f6ae",
                                                "text": "Of course, we would have been insulted if someone had accused us of cheating on an exam or confounding lie and lay, but we smiled charmingly when charged with wanting to murder our father—smiled and shrugged our shoulders. The attribution of Sophoclean passions to ditherers could only be heartening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
