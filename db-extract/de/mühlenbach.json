                        ],
                        "form": "den Mühlenbach"
                    },
                    {
                        "form_id": "ee2cd256-1327-4cac-8448-973e217ceb27",
                        "entry_id": "3844af9b-29db-3b48-ad60-97968aa27fea",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mühlenbäche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                        "entry_id": "3844af9b-29db-3b48-ad60-97968aa27fea",
                        "glosses": [
                            "natürlicher oder künstlich angelegter Wasserlauf an einer Wassermühle mit Mühlrad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795c49fe-427d-4197-838c-7b620046eb80",
                                "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                                "text": "„Der Altbach vereinigt sich dann im Wiesengrund mit den vom Westhang kommenden Bächen zum Mühlenbach, dem von zwei Mühlen und ihrem Grabensystem gesäumten Teil des Oberemmeler Baches.“"
                            },
                            {
                                "example_id": "5bcda817-33e0-4319-9683-959b8bcd20af",
                                "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                                "text": "„Der Ostbach entspringt am Südhang des Wiehengebirges, fließt in einem großen Bogen durch Randringhausen und mündet als Spradower Mühlenbach unterhalb der Elsemühle in die Else.“"
                            },
                            {
                                "example_id": "ae083bee-63f4-4fd5-b97c-302f53cf5350",
                                "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                                "text": "„Jahrhundertelang drehte sich in Elte am Mühlenbach, östlich vom eigentlichen Dorfkern, eine Mühle.“"
                            },
                            {
                                "example_id": "76de577b-1a5e-4a63-8301-32850dbf125f",
                                "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                                "text": "„Sie war damit einst die erste von insgesamt fünf Wassermühlen, die am Mühlenbach betrieben wurden und erstmals schon 1468 erwähnt wurde.“"
                            },
                            {
                                "example_id": "87aa2ea3-f764-4884-8df5-ffd77a55f2b2",
                                "sense_id": "6059ef0c-db29-3bee-bfa5-fbe1b2ec7e47",
                                "text": "„Ab Mühlenbrok wird der Heubach als Mühlenbach bezeichnet. Beim Sythener Schloss teilt er sich in zwei Umfließgewässer, in eines davon mündet der von Osten zufließende Sandbach, das andere fließt an der Sythener Mühle vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
