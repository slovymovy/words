                        "examples": [
                            {
                                "example_id": "0b9d3420-c158-42b2-a891-eb41d1fe2da1",
                                "sense_id": "4fd7f655-039a-3cba-86d5-87a490afc0e6",
                                "text": "La force du Symphonique de Pittsburgh repose en grande partie sur la viscéralité de l'engagement — catalysée par le chef — et une opulente richesse dans le fondement sonore."
                            },
                            {
                                "example_id": "2ca88d52-3c33-45be-8bbc-6da96aa1c2ff",
                                "sense_id": "4fd7f655-039a-3cba-86d5-87a490afc0e6",
                                "text": "Le devenir philosophe (et non professeur de philosophie ou historien des idées...) de Pierre Hadot ne relève donc pas d'un apprentissage des techniques rhétoriques ou sophistiques à l'École normale supérieure mais d'une viscéralité existentielle."
                            }
