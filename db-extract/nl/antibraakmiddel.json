                        "examples": [
                            {
                                "example_id": "4f59923f-ce9a-4b7f-ad73-119153a9a498",
                                "sense_id": "19138680-9024-30cc-af2a-6616abba118d",
                                "text": "Alex S. werd in juli aangehouden. Volgens het Openbaar Ministerie verkocht hij het middel mogelijk aan bijna zevenhonderd mensen. S. wordt verdacht van overtreding van de Geneesmiddelenwet en van witwassen van de opbrengst hiervan. Hij verkocht behalve het zelfdodingspoeder, dat ook wel middel X wordt genoemd, het antibraakmiddel domperidon, dat alleen op doktersrecept verkrijgbaar is. Hij zou in totaal 55.000 euro verdiend hebben."
                            },
                            {
                                "example_id": "dcceb43e-e805-4f8c-b247-411c9609996e",
                                "sense_id": "19138680-9024-30cc-af2a-6616abba118d",
                                "text": "Heringa was in 2008 behulpzaam toen zijn stiefmoeder 'Moek' Heringa een einde aan haar leven wilde maken. Hij kocht voor haar malariapillen, slaappillen en een antibraakmiddel en filmde hoe hij te werk ging."
                            }
                        ]
                    }
