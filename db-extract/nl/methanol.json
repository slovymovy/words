                                            {
                                                "example_id": "20a322db-b919-4127-9607-40d5984243c9",
                                                "sense_id": "738b8a54-379e-3d46-a728-da7dbdea8b29",
                                                "text": "Methanol mit Methansäure ergibt Methansäuremethylester."
                                            },
                                            {
                                                "example_id": "d1679331-c567-483e-ba94-9a25c2bdb950",
                                                "sense_id": "738b8a54-379e-3d46-a728-da7dbdea8b29",
                                                "text": "„Und natürlich war das Spektrometer zuvor auseinandergenommen und in Methanol gebadet worden.“"
                                            }
