                    {
                        "translation_id": "ccbe86d9-10a6-4949-bee2-4f9e6d863730",
                        "source_entry_id": "d7f29090-117e-3919-b7af-6574080e5ddf",
                        "source_sense_id": "a6bbb545-c1ee-3256-9958-7d17a423d853",
