                    {
                        "translation_id": "a765b07a-5536-4918-bfed-667849a77ec6",
                        "source_entry_id": "e62a6e00-d735-313b-a9ba-529397ce55b7",
                        "source_sense_id": "eebec5d6-3ce0-3382-9b76-851e09a3da6e",
