                        "glosses": [
                            "Having the texture of a hard board; inflexible and stiff."
                        ],
                        "tags": [
                            "of a fabric"
                        ],
                        "examples": [
                            {
                                "example_id": "18c28073-687e-4d5f-a2fc-ee1074449eca",
                                "sense_id": "be428c13-d7d5-3d31-be91-70dee502fc15",
                                "text": "Produces a full, firm, and harsh feel often described as a boardy feel, in cloth filled with it."
                            },
                            {
                                "example_id": "bedf758c-e56a-4dc7-b5f2-52e4cf57fc2c",
                                "sense_id": "be428c13-d7d5-3d31-be91-70dee502fc15",
                                "text": "Gone, too, are the days of boardy, heavy clothes for hot-weather wear."
                            },
                            {
                                "example_id": "1ab948cd-07d5-4150-a856-615056f22694",
                                "sense_id": "be428c13-d7d5-3d31-be91-70dee502fc15",
                                "text": "Rice starch, on the other hand, penetrates better and gives a harder finish, with a fullness and firmness which is apt to be regarded as “boardy”; […]"
                            },
                            {
                                "example_id": "68345bbe-9320-4786-9aa4-77e746b06bd5",
                                "sense_id": "be428c13-d7d5-3d31-be91-70dee502fc15",
                                "text": "Rice starch gives clothes a boardy effect. It makes the fabric firm because it has good penetration into the cellulosic fibre."
                            }
                        ]
                    }
