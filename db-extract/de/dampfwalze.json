                                    {
                                        "sense_id": "f19927a4-851e-3629-9291-682730be9f45",
                                        "entry_id": "7b593666-c0c3-3ccf-9bd2-0e3895a379d6",
                                        "glosses": [
                                            "Engin servant à tasser une chaussée, un revêtement."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124bf658-09ed-4d86-aa5d-fb2db561806b",
                                                "sense_id": "f19927a4-851e-3629-9291-682730be9f45",
                                                "text": "Les rouleaux compresseurs sont nécessaires pour bâtir des routes goudronnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                        "entry_id": "7b593666-c0c3-3ccf-9bd2-0e3895a379d6",
                                        "glosses": [
                                            "Chose ou personne qui avance et écrase tout sur son passage, implacablement (parfois suivi de la préposition de)."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630b38b0-7621-4281-b9c9-a3467e9f81fc",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Le rouleau compresseur de l’armée d’invasion avançait inexorablement en direction de la capitale, et rien n’y résistait."
                                            },
                                            {
                                                "example_id": "9ce33ecd-c3a8-4fbb-b130-29bbff8e5150",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Nadal est un rouleau compresseur : le joueur de tennis enchaîne en effet les victoires, et semble invincible."
                                            },
                                            {
                                                "example_id": "6de92666-aa5b-4f85-90f5-b7de676dee97",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Cet album est un véritable rouleau compresseur, pour les oreilles – attention aux décibels – comme pour les ventes."
                                            },
                                            {
                                                "example_id": "fda8c85d-d7c9-4eb2-8c66-9404d815fac7",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Le rouleau compresseur du capitalisme industriel fait son lot de victimes."
                                            },
                                            {
                                                "example_id": "2448e2da-88d1-49ae-9504-d459a0c620aa",
                                                "sense_id": "cf44fc7e-6f27-35af-b21d-4d3f4f30e757",
                                                "text": "Son style rouleau compresseur est modérément goûté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
