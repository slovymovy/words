{
    "word_family": [
        "jumbled",
        "jumbling",
        "jumbly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "652648bd-91a5-3d81-ab4b-75c6f7e1fea3",
                    "sense_definition": "to mix things together in a messy or confused way",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>jumble</w> all the puzzle pieces together, it will be much harder to find the edges.",
                            "target_lang_translations": {
                                "ru": "Если ты <w>перемешаешь</w> все детали пазла, найти края будет гораздо сложнее."
                            }
                        },
                        {
                            "text": "The laundry was a mess because he would <w>jumble</w> up his clean and dirty clothes in one basket.",
                            "target_lang_translations": {
                                "ru": "Белье было в беспорядке, потому что он <w>сваливал в кучу</w> чистую и грязную одежду в одну корзину."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix",
                        "muddle",
                        "scramble",
                        "confuse",
                        "mess up",
                        "shuffle"
                    ],
                    "antonyms": [
                        "organize",
                        "sort",
                        "arrange"
                    ],
                    "common_phrases": [
                        "jumble up",
                        "jumble together"
                    ],
                    "target_lang_definitions": {
                        "ru": "смешивать вещи в беспорядке или путать их"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перемешивать",
                                "target_lang_sense_clarification": "нарушать порядок расположения"
                            },
                            {
                                "target_lang_word": "сваливать в кучу",
                                "target_lang_sense_clarification": "беспорядочно складывать"
                            },
                            {
                                "target_lang_word": "перепутывать",
                                "target_lang_sense_clarification": "вносить беспорядок в систему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69ac2908-a39e-31ca-b255-0b0ceaefcc84",
                    "sense_definition": "to meet or unite in a confused or disorganized manner",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mixing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In my tired state, all the dates and names began to <w>jumble</w> together in my head.",
                            "target_lang_translations": {
                                "ru": "От усталости все даты и имена начали <w>перепутываться</w> у меня в голове."
                            }
                        },
                        {
                            "text": "The different musical styles <w>jumble</w> together to create a very unique and chaotic sound.",
                            "target_lang_translations": {
                                "ru": "Различные музыкальные стили <w>смешиваются</w>, создавая уникальное и хаотичное звучание."
                            }
                        }
                    ],
                    "synonyms": [
                        "mingle",
                        "blend"
                    ],
                    "antonyms": [
                        "separate"
                    ],
                    "common_phrases": [
                        "jumble together"
                    ],
                    "target_lang_definitions": {
                        "ru": "соединяться или смешиваться хаотичным образом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешиваться",
                                "target_lang_sense_clarification": "соединяться беспорядочно"
                            },
                            {
                                "target_lang_word": "перепутываться",
                                "target_lang_sense_clarification": "становиться неясным, спутанным"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9767489-edff-34ed-bb12-6af357074ab8",
                    "sense_definition": "a confused mixture of different and often unrelated things",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drawer was a <w>jumble</w> of old keys, loose coins, and broken pens.",
                            "target_lang_translations": {
                                "ru": "В ящике была целая <w>мешанина</w> из старых ключей, мелочи и сломанных ручек."
                            }
                        },
                        {
                            "text": "Her speech was a <w>jumble</w> of words that made very little sense to the audience.",
                            "target_lang_translations": {
                                "ru": "Ее речь была <w>путаницей</w> слов, которая почти не имела смысла для слушателей."
                            }
                        }
                    ],
                    "synonyms": [
                        "muddle",
                        "clutter",
                        "mess",
                        "hodgepodge",
                        "tangle",
                        "mixture"
                    ],
                    "antonyms": [
                        "order",
                        "system"
                    ],
                    "common_phrases": [
                        "confused jumble",
                        "jumble of things"
                    ],
                    "target_lang_definitions": {
                        "ru": "беспорядочная смесь различных, часто не связанных между собой вещей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мешанина",
                                "target_lang_sense_clarification": "смесь разнородного"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "беспорядочное скопление предметов"
                            },
                            {
                                "target_lang_word": "путаница",
                                "target_lang_sense_clarification": "отсутствие порядка и ясности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f0c3369-01ee-374c-92df-6544f0794455",
                    "sense_definition": "a sale of various second-hand items, typically to raise money for charity",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I managed to find this vintage coat for only five pounds at the local <w>jumble</w>.",
                            "target_lang_translations": {
                                "ru": "Мне удалось найти это винтажное пальто всего за пять фунтов на местной <w>распродаже подержанных вещей</w>."
                            }
                        },
                        {
                            "text": "The school is organizing a <w>jumble</w> sale next Saturday to fund the new library books.",
                            "target_lang_translations": {
                                "ru": "В следующую субботу школа организует <w>благотворительный базар</w>, чтобы собрать деньги на новые книги для библиотеки."
                            }
                        }
                    ],
                    "synonyms": [
                        "rummage sale",
                        "bazaar"
                    ],
                    "common_phrases": [
                        "jumble sale"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "распродажа подержанных вещей, обычно в благотворительных целях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворительная распродажа",
                                "target_lang_sense_clarification": "подержанных вещей"
                            },
                            {
                                "target_lang_word": "барахолка",
                                "target_lang_sense_clarification": "рынок старых вещей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e16654a-0119-3c07-9447-a1020d22c44e",
                    "sense_definition": "items that are collected to be sold at a rummage sale",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon sorting through the <w>jumble</w> to see what was worth selling.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, разбирая <w>старьё</w>, чтобы понять, что стоит выставить на продажу."
                            }
                        },
                        {
                            "text": "Please bring any old toys or clothes you don't want to the <w>jumble</w> collection point.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, приносите любые ненужные старые игрушки или одежду в пункт сбора <w>вещей для распродажи</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bric-a-brac"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вещи, собранные для продажи на благотворительном базаре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старьё",
                                "target_lang_sense_clarification": "вещи для распродажи"
                            },
                            {
                                "target_lang_word": "подержанные вещи",
                                "target_lang_sense_clarification": "собранные для продажи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e97f445-0283-3ef6-8d41-e2337af396a1",
                    "sense_definition": "a small, thin, sugared cake or cookie, usually shaped like a ring",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker prepared a fresh batch of <w>jumbles</w> flavored with lemon and caraway seeds.",
                            "target_lang_translations": {
                                "ru": "Пекарь приготовил свежую партию <w>печенья</w> с лимоном и тмином."
                            }
                        },
                        {
                            "text": "In the eighteenth century, a <w>jumble</w> was a very popular treat to serve with tea.",
                            "target_lang_translations": {
                                "ru": "В восемнадцатом веке такое <w>печенье</w> было очень популярным угощением к чаю."
                            }
                        }
                    ],
                    "synonyms": [
                        "biscuit",
                        "cookie"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to a traditional type of biscuit"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшое тонкое печенье, обычно в форме кольца"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "печенье",
                                "target_lang_sense_clarification": "традиционное английское, в форме колечка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}