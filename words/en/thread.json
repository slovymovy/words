                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grooming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She goes to the salon every month to <w>thread</w> <w>her</w> <w>eyebrows</w>.",
                            "target_lang_translations": {
                                "ru": "Она каждый месяц ходит в салон, чтобы <w>сделать</w> <w>коррекцию</w> бровей нитью."
                            }
                        },
                        {
                            "text": "Many people prefer to <w>thread</w> facial hair because it is more precise than waxing.",
                            "target_lang_translations": {
                                "ru": "Многие предпочитают <w>удалять</w> волосы на лице нитью, потому что это точнее, чем воском."
                            }
