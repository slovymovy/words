                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0680d8b-d2d7-4dad-a876-56716c16f2ee",
                        "source_entry_id": "691a6d64-493c-3957-9c42-47a95075beb6",
                        "source_sense_id": "d729fe37-4265-3e01-a6d0-58f70c91d259",
                        "source_sense_description": "Küchengerät mit scharfer Klinge zum Entfernen der Schalen von Kartoffeln",
                        "target_lang_word": "économe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "330e22d7-5540-358e-9117-83a344e12acc",
                                        "entry_id": "3c49c390-53fe-314a-a5d0-84ec5f33dfaa",
                                        "glosses": [
                                            "Qualifie une personne qui évite de dépenser de l’argent inutilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d2298a-8fec-430f-84ca-e59092cdf5c4",
                                                "sense_id": "330e22d7-5540-358e-9117-83a344e12acc",
                                                "text": "Autrefois pourtant cet homme n’était qu’un père de famille économe, chez qui ses voisins venaient diner, apprendre l’épargne, la bonne administration."
                                            },
                                            {
                                                "example_id": "60c7ca5c-24f4-4f86-8aa7-e44a9983e794",
                                                "sense_id": "330e22d7-5540-358e-9117-83a344e12acc",
                                                "text": "Devenez radin ! Les petits ruisseaux font les grandes rivières « Être économe c’est très bien, surtout si vos parents l’ont été pour vous ! » disait Winston Churchill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7be1f223-bafc-39a3-ab88-3c8aa1ccfab7",
                                        "entry_id": "3c49c390-53fe-314a-a5d0-84ec5f33dfaa",
                                        "glosses": [
                                            "Avare, frugal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a1962c9-76e6-4e4a-b5ed-69f4fd1cd168",
                                                "sense_id": "7be1f223-bafc-39a3-ab88-3c8aa1ccfab7",
                                                "text": "Toute manipulation, sans gestes superflus, sans paroles inutiles, était faite par des hommes et des femmes peu nombreux, économes de leurs efforts."
                                            },
                                            {
                                                "example_id": "8d43febb-08f9-4f8f-8b6b-197c3ccb4955",
                                                "sense_id": "7be1f223-bafc-39a3-ab88-3c8aa1ccfab7",
                                                "text": "Il n’est pas économe de promesses, il les prodigue."
                                            },
                                            {
                                                "example_id": "2005fbd1-fe9e-459f-b1d7-d2b3ed73165e",
                                                "sense_id": "7be1f223-bafc-39a3-ab88-3c8aa1ccfab7",
                                                "text": "Être économe de son temps, ne pas perdre son temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "économe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c74496fe-9176-3b90-a0f3-a2910e72408c",
                                        "entry_id": "941b2ab5-04db-3d28-9cbc-7e45deba508a",
                                        "glosses": [
                                            "Personne qui tient un économat, qui gère les revenus et les achats matériels d’un établissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9667a2e-28ed-4af4-b6cd-aaeeeca5693f",
                                                "sense_id": "c74496fe-9176-3b90-a0f3-a2910e72408c",
                                                "text": "[…], Rinaldi expliquait si gaiement comme quoi, son père le destinant à la moinaille, on l'avait enfermé en un couvent d'où il s'était enfui, un beau jour, avec la caisse de l’économe, la nièce de l’abbé et une douzaine de mots latins dans la cervelle pour tout bagage, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26cbe756-65c7-3e09-a31e-fc817aaa2dcd",
                                        "entry_id": "941b2ab5-04db-3d28-9cbc-7e45deba508a",
                                        "glosses": [
                                            "Personne qui s’occupe de la comptabilité d’une famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ff4e65-a6dc-4f59-bbf8-145bf65d92d9",
                                                "sense_id": "26cbe756-65c7-3e09-a31e-fc817aaa2dcd",
                                                "text": "C’est une bonne économe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90e790a4-048c-3e6c-866c-102d78187e95",
                                        "entry_id": "941b2ab5-04db-3d28-9cbc-7e45deba508a",
                                        "glosses": [
                                            "Épluche-légume conçu pour éplucher finement certains légumes."
                                        ],
                                        "tags": [
                                            "Au masculin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e09aae-1f98-4385-b658-0e6176ed8f18",
                                                "sense_id": "90e790a4-048c-3e6c-866c-102d78187e95",
                                                "text": "Priscille s’interrompit dans son activité, une carotte dans une main et un économe dans l’autre, et regarda son fils d’un air étonné."
                                            },
                                            {
                                                "example_id": "9e6a1e86-3315-4439-b217-02b0f1e806f0",
                                                "sense_id": "90e790a4-048c-3e6c-866c-102d78187e95",
                                                "text": "Elle grattait la terre du poireau, coupait ses racines à petits gestes secs, découpait le blanc en fines rondelles. Moi je râpais les légumes avec un économe. Et lui nous observait.\n — C’est tout ce que tu lui apprends à ton fils ? La cuisine ?"
                                            },
                                            {
                                                "example_id": "7dd342a9-b20f-4ca6-abf3-344c05174124",
                                                "sense_id": "90e790a4-048c-3e6c-866c-102d78187e95",
                                                "text": "À l’aide d’un économe, récupérez deux belles tranches de zeste d’orange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01422063-dc21-4b25-8203-635055b09cb3",
                        "source_entry_id": "691a6d64-493c-3957-9c42-47a95075beb6",
