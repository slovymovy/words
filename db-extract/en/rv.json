                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "8173f0a4-b5ce-4b87-9b0b-ab9c9714b08f",
                                "sense_id": "04321142-6ab4-3c9b-bac9-0bd121812b88",
                                "text": "Mostly old and pensioned, theyʼd troll the streets in their out-of-state license-plated RVs looking for the last link to their youths."
                            },
                            {
                                "example_id": "2a39ed2a-b894-4bf1-a833-61796c83ab4c",
                                "sense_id": "04321142-6ab4-3c9b-bac9-0bd121812b88",
                                "text": "According to Outdoorsy, an R.V. share app, millennial R.V. rental bookings went up 70 percent from 2019 to 2020."
                            },
                            {
                                "example_id": "b44bc2d5-8a25-4713-9285-6b0d0d4f0dc3",
                                "sense_id": "04321142-6ab4-3c9b-bac9-0bd121812b88",
                                "text": "And whether you're pulling your RV right up to the water at Malibu Beach RV Park, Pacific Dunes Ranch, or Campland on the Bay, or simply into car camping, you’ll want to start thinking about your power setup."
                            }
                        ]
                    },
