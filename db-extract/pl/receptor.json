                                "target_senses": [
                                    {
                                        "sense_id": "7aeecbeb-b12e-36d8-8462-b2fe738ee9cd",
                                        "entry_id": "5b9c932e-1405-3b9c-adee-1655e8e7114b",
                                        "glosses": [
                                            "Biologie, Physiologie: Zelle; Struktur zur Wahrnehmung von Veränderungen, genauer"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f088471-c7f3-323e-aa86-d1de89f2bfe8",
                                        "entry_id": "5b9c932e-1405-3b9c-adee-1655e8e7114b",
                                        "glosses": [
                                            "Biologie, Physiologie: Zelle; Struktur zur Wahrnehmung von Veränderungen, genauer",
                                            "Protein, welches Veränderungen (beispielsweise die Veränderung der chemischen Konzentration eines bestimmten Stoffes) im Umfeld einer Zelle wahrnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27675b3d-c317-4660-976f-e9c651a1e6ce",
                                                "sense_id": "4f088471-c7f3-323e-aa86-d1de89f2bfe8",
                                                "text": "Vermindert sich die Anzahl der Insulinrezeptoren, beispielsweise aufgrund eines dauerhaft erhöhten Insulinspiegels im Blut, so kann sich beim Betroffenen eine Insulinresistenz und in deren Folge Diabetes mellitus herausbilden."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "a751fcc7-e51f-3e72-b0d5-d4501af8bc84",
                                        "entry_id": "5b9c932e-1405-3b9c-adee-1655e8e7114b",
                                        "glosses": [
                                            "Biologie, Physiologie: Zelle; Struktur zur Wahrnehmung von Veränderungen, genauer",
                                            "Sensor, Sinneszelle, welche exogene physikalische Reize in neuronale Information umwandelt"
                                        ],
                                        "tags": [
                                            "Neurobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108b2595-439e-48ef-b0ea-3f750d901268",
                                                "sense_id": "a751fcc7-e51f-3e72-b0d5-d4501af8bc84",
                                                "text": "Jeder Rezeptor reagiert sensibel auf Reize einer bestimmten Qualität."
                                            },
                                            {
                                                "example_id": "34b8e9f3-d89f-4043-8070-6cf64f5e04b4",
                                                "sense_id": "a751fcc7-e51f-3e72-b0d5-d4501af8bc84",
                                                "text": "„Meine Rezeptoren springen sofort auf die Botenstoffe an.“"
                                            },
                                            {
                                                "example_id": "d9220534-d0cd-44b0-8af3-af9c4e51fdaa",
                                                "sense_id": "a751fcc7-e51f-3e72-b0d5-d4501af8bc84",
                                                "text": "„Wenn Drogensüchtige Heroin nehmen, besetzt das Rauschgift die Rezeptoren, die eigentlich für die körpereigenen Substanzen vorgesehen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    }
                                ]
                            }
                        ]
