                                "example_id": "657e7585-7614-409c-8c6f-4118d6d2da4c",
                                "sense_id": "2976cb59-7309-3c8a-8270-f9e8b1636ab2",
                                "text": "A man got up in all the outward trappings of a gentleman: an extensive display of snowy linen, unimpeachable tailoring, ganté, botté, in perfection; nothing overdone."
                            }
                        ]
