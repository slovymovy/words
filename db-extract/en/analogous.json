                                "target_senses": [
                                    {
                                        "sense_id": "4bd9582b-b3df-30df-ac54-5c38c86a8154",
                                        "entry_id": "38cea4f4-8fc8-3723-94a2-a2863dfa7d17",
                                        "glosses": [
                                            "overeenkomend met"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cd15ef-d05b-438f-928d-75b6321fe2d4",
                                                "sense_id": "4bd9582b-b3df-30df-ac54-5c38c86a8154",
                                                "text": "De werking van dit medicijn is dus volledig analoog aan de werking van de duurdere variant."
                                            },
                                            {
                                                "example_id": "d5a6f791-a0c4-47cd-9644-2b665ebba542",
                                                "sense_id": "4bd9582b-b3df-30df-ac54-5c38c86a8154",
                                                "text": "Het probleem van de ouderenhuisvestiging wordt gekoppeld aan het analoge probleem van jongeren, starters op de woningmarkt."
                                            },
                                            {
                                                "example_id": "6647327c-7a37-4ef2-8ed3-1f905e63aff2",
                                                "sense_id": "4bd9582b-b3df-30df-ac54-5c38c86a8154",
                                                "text": "Een analoog verhaal komt naar voren uit studies van het Y-chromosoom."
                                            },
                                            {
                                                "example_id": "91ae5d43-9888-4507-aa77-445ace7cf7c6",
                                                "sense_id": "4bd9582b-b3df-30df-ac54-5c38c86a8154",
                                                "text": "De explosieve ontwikkeling van technologie was analoog aan de groei van kankercellen, en de resultaten zouden hetzelfde zijn: de uitputting van alle voedselbronnen, de verwoesting van organen en de uiteindelijke dood van het gastheerlichaam."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75e69e1-d33b-3fe5-b0c3-1b390f91407d",
                                        "entry_id": "38cea4f4-8fc8-3723-94a2-a2863dfa7d17",
                                        "glosses": [
                                            "tegenovergestelde van digitaal (geluidsopname, uurwerk), de representatie van een elektrisch signaal in een geluidsopname is dan continu en in overeenstemming met de fysieke grootheid (luchtdruk) die het geluid veroorzaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5c6291c-8c88-485a-b657-1cbc0f94557a",
                                                "sense_id": "a75e69e1-d33b-3fe5-b0c3-1b390f91407d",
                                                "text": "De analoge apparaten worden vervangen door digitale."
                                            },
                                            {
                                                "example_id": "f56e91ac-ed68-4b21-9522-aba5b354c247",
                                                "sense_id": "a75e69e1-d33b-3fe5-b0c3-1b390f91407d",
                                                "text": "Ze was er toen zwart-witfllm werd uitgevonden, en daarna kleur, was er toen stilstaande beelden video's werden, toen analoog digitaal werd, en hele verhalen konden worden opgeborgen in de palm van je hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e8bf9cc-6c70-45cc-99a9-14c771c1c01b",
                        "source_entry_id": "59a5246c-2d50-3215-b8dc-15b5c21517d9",
