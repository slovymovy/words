                "senses": [
                    {
                        "sense_id": "f929f7d7-2371-3ebb-a6ca-c53720db8204",
                        "entry_id": "2232396c-a1ad-35fa-83e4-0dbc2ce2ad1d",
                        "glosses": [
                            "jemand (oder etwas), der Abfälle verwertet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4854d8c-0ab1-4d4e-b31f-9f4e5805c3d7",
                                "sense_id": "f929f7d7-2371-3ebb-a6ca-c53720db8204",
                                "text": "„Ausgangsart für unser Hausschwein ( vgl. Abb. 3 ) war dieses europäisch-asiatische Wildschwein. Wahrscheinlich hatten sich Tiere aber auch schon vor ihrer Domestikation (Haustiere, Haustierwerdung) freiwillig, als Abfallverwerter, dem Menschen angeschlossen.“"
                            },
                            {
                                "example_id": "9567213a-68d1-4391-bb4c-d5f34c722994",
                                "sense_id": "f929f7d7-2371-3ebb-a6ca-c53720db8204",
                                "text": "„Prinzipiell gelten die Mikroorganismen als Abfallverwerter, die abgestorbenes organisches Material konsumieren, oder als Nutzer von Bakterienrasen, die sie abweiden.“"
                            },
                            {
                                "example_id": "b5d94a32-8610-4283-b0b1-3f035b766787",
                                "sense_id": "f929f7d7-2371-3ebb-a6ca-c53720db8204",
                                "text": "„Mülldeponien gehen in Flammen auf, Sortieranlagen fangen Feuer, im Container entzünden sich Elektrogeräte: Immer häufiger berichten Abfallverwerter von Bränden, die durch Akkus verursacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
