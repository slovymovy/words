                        "glosses": [
                            "krant of tijdschrift voor studenten en medewerkers van een universiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9623ae33-cf90-4bcf-b415-3c79b2267249",
                                "sense_id": "a8586b47-e470-3de4-be22-85d67c27294f",
                                "text": "De examencommissie kreeg vorige week argwaan omdat de studenten wel erg snel klaar met hun digitale toetsen die ze thuis mochten maken. Ze wisten de vragen binnen enkele minuten te beantwoorden, terwijl er toch vaak veel rekenwerk bij kwam kijken, schrijft het universiteitsblad Folia. Bovendien waren de resultaten beter dan die van vorig jaar."
                            },
                            {
                                "example_id": "a40937d8-cfa0-4f27-b970-b612b361e120",
                                "sense_id": "a8586b47-e470-3de4-be22-85d67c27294f",
                                "text": "Het college van bestuur in Nijmegen krijgt steeds meer kritiek. Vorig jaar werd het Universiteitsblad Vox onder de paraplu van de afdeling communicatie geplaatst. Tegenstanders dachten dat het hierdoor voor het college van bestuur makkelijker zou worden om stukken niet goed te keuren."
                            }
                        ]
