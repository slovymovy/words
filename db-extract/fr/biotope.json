                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1551a331-1f2f-43bc-9951-e157956c39a7",
                        "entry_id": "5e85446f-7749-3665-9a35-b9cabd75e584",
                        "tags": [
                            "plural"
                        ],
                        "form": "biotopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fa8eb60-b978-3b57-bea4-12678d8a3fe3",
                        "entry_id": "5e85446f-7749-3665-9a35-b9cabd75e584",
                        "glosses": [
                            "Aire géographique caractérisée par des conditions climatiques et physicochimiques homogènes permettant l’existence d’une faune et d’une flore spécifiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55566229-eef8-4853-8bf5-1acfdb01c2eb",
                                "sense_id": "7fa8eb60-b978-3b57-bea4-12678d8a3fe3",
                                "text": "Le conflit entre un groupe humain et un milieu défavorable peut se résoudre au bénéfice des membres de ce groupe par la construction d’un « biotope » artificiel en totale rupture avec le milieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "799dc208-b69f-4c96-b2f9-6c028f98908b",
                        "source_entry_id": "5e85446f-7749-3665-9a35-b9cabd75e584",
                        "source_sense_id": "7fa8eb60-b978-3b57-bea4-12678d8a3fe3",
                        "target_lang_word": "Biotop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biotop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "773b75a3-c605-39cd-9ace-f486044103db",
                                        "entry_id": "61687e0b-b6a1-3e5c-8fe9-e9bab12bdca7",
                                        "glosses": [
                                            "natürlicher Lebensraum für bestimmte Pflanzen und Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbe855b9-fbea-4028-8fa7-b16087396c5e",
                                                "sense_id": "773b75a3-c605-39cd-9ace-f486044103db",
                                                "text": "„Die Größe eines Biotops wird in der Ökologie durch den benötigten Lebensraum der darin lebenden Organismen vorgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27db07e4-8a9a-4d5b-9b30-04bdc61b2f9e",
                        "source_entry_id": "5e85446f-7749-3665-9a35-b9cabd75e584",
                        "source_sense_id": "7fa8eb60-b978-3b57-bea4-12678d8a3fe3",
                        "target_lang_word": "Lebensraum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensraum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15562c61-e1c8-3cfb-8cdc-9b0f974e21a0",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "ein Raum, in dem Leben und die Entfaltung desselben möglich ist und wirklich wird"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf722de-2856-4c52-99d6-b2a959f96fc2",
                                                "sense_id": "15562c61-e1c8-3cfb-8cdc-9b0f974e21a0",
                                                "text": "In der Stadt ist der Lebensraum beschränkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "der charakteristische Wohnort bzw. Standort einer Tier- oder Pflanzenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00e8f57f-e59e-4bfa-8ecb-ee9509e1b5c4",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "Der Lebensraum des Menschen ist die Kultur."
                                            },
                                            {
                                                "example_id": "eff6c5c7-c2bd-470d-9fec-ec7221cfb664",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Im Oberen Mittelrheintal wurden durch den wirtschaftenden Menschen neben den von Natur aus offenen Felsbiotopen neue, durch Rodung und Beweidung ebenfalls offene Lebensräume geschaffen, in denen sich eine Wärme liebende, europaweit außergewöhnliche Artenvielfalt entwickelt hat.“"
                                            },
                                            {
                                                "example_id": "6cdb5ddd-8649-4cc4-99d3-7f5a1437bbf4",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Leider beschränkt sich der Lebensraum des Nilkrokodils, wie sein Name vielleicht vermuten lässt, nicht auf den Nil.“"
                                            },
                                            {
                                                "example_id": "fe10d1b6-6d23-4017-aff4-31166a859cae",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Trotzdem wurde der Wald zum Lebensraum von Vögeln wie Amsel, Rotdrossel und Türkentaube, die auf den Färöern selten sind.“"
                                            },
                                            {
                                                "example_id": "ee277f89-ca94-42c8-bc29-6ba5aa598b2f",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„Moore sind wertvolle Lebensräume für seltene Tiere und Pflanzen und speichern viel ⁠CO2⁠.“"
                                            },
                                            {
                                                "example_id": "cfed552a-decc-4ab7-8bd1-081991cbc7c0",
                                                "sense_id": "a2656f58-dfc8-3fd1-9363-040014583263",
                                                "text": "„»Seegraswiesen dienen vielen Meeresbewohnern als Lebensraum. So können sich Muscheln, Seesterne und Krebse dort verstecken. Viele Fische ziehen dort ihren Nachwuchs auf.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                        "entry_id": "7bcbd7ca-c808-3258-abcd-a0e19922406f",
                                        "glosses": [
                                            "der Wohnort von Menschen bzw. Völkern; der geopolitisch umgedeutete Begriff Lebensraum diente vor allem in der ersten Hälfte des 20. Jahrhunderts in Anlehnung an Friedrich Ratzels Werk \\\"Der Lebensraum\\\" (1901) zur Begründung von Gebietsforderungen. Die Gedanken Ratzels wurden von dem Geografen Karl Haushofer, der persönliche, über Rudolf Heß vermittelte Kontakte zu Adolf Hitler besaß, weiterentwickelt und von Hitler rezipiert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e0607e2-892b-47d4-9cdb-7aa92ed52521",
                                                "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                                "text": "Friedrich Ratzel beschrieb die Geschichte der Menschheit als einen permanenten Kampf um Lebensraum."
                                            },
                                            {
                                                "example_id": "2f6449af-88ca-4c7a-95ea-716106847b57",
                                                "sense_id": "c6413a0d-fd3a-3da4-9696-bc1dbdc92305",
                                                "text": "„Ich sollte sie einfach abschießen – wie ihr Mann, der wahrscheinlich beim SD ist, russische Kulaken abschießt, um seinem Führer diesen berüchigten Lebensraum zu erobern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
