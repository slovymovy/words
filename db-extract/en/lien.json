                        "cross_references": [
                            {
                                "target_word": "зало́г",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5818fd03-faf0-37b1-88f9-e683b6be27da",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "отдача денег или других ценностей в обеспечение обязательств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "502eb7e6-f9ea-4d92-9fed-926226db88b9",
                                                "sense_id": "5818fd03-faf0-37b1-88f9-e683b6be27da",
                                                "text": "Залог имущества, переданного залогодателем на время во владение или пользование третьему лицу, считается залогом с оставлением его у залогодателя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20638d88-d24d-3157-a87f-92604f18de92",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "перен. деньги или другие ценности, отдаваемые таким образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8bc32c-0963-4a6d-a0a6-bf4fc2a113e3",
                                                "sense_id": "20638d88-d24d-3157-a87f-92604f18de92",
                                                "text": "Во время подписания предварительного соглашения покупатель оставляет залог, который, как правило, не превышает 10 %."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d416d714-eced-300b-a13a-b9d152f13d19",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "перен. гарантия, нечто, служащее подтверждением чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab457a05-c577-4b58-96dd-101a750a5c78",
                                                "sense_id": "d416d714-eced-300b-a13a-b9d152f13d19",
                                                "text": "Мисс Жаксон, удостоверясь, что Лиза не думала поднять её на смех, успокоилась, поцеловала Лизу и в залог примирения подарила ей баночку английских белил, которую Лиза приняла с изъявлением искренней благодарности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c564ea6-4af6-3f7a-b4c5-5aae0d0886a7",
                                        "entry_id": "65e70a81-1964-3212-9846-64cc31f0724d",
                                        "glosses": [
                                            "перен. причина, обязательное условие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b200e1f3-d710-4e57-8032-eb66d0387fa2",
                                                "sense_id": "1c564ea6-4af6-3f7a-b4c5-5aae0d0886a7",
                                                "text": "Налаженный постпродажный сервис — залог лояльности клиентов."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "зало́г",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8db3f982-8dfe-31de-98b8-ec1400042b2b",
                                        "entry_id": "54da14c4-79c7-3ff9-bdea-09d1e46de7af",
                                        "glosses": [
                                            "лингв. категория глагола, выражающая отношения между субъектом и объектом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f1c0ce-1d19-4833-9c92-04d5c7de4d56",
                                                "sense_id": "8db3f982-8dfe-31de-98b8-ec1400042b2b",
                                                "text": "— Не судимы будете, это страдательный залог, — прошептал про себя Успенский, точно проверяя свои знания."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "зало́г",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "439c63b1-ec19-3f57-80d7-f8a7f17d8629",
                                        "entry_id": "921d3527-eaf6-3b52-9533-2628bbb702a7",
                                        "glosses": [
                                            "диал. заброшенная, давно не паханная земля"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b259d011-b3b1-4a2a-a279-ac679a8a717d",
                                                "sense_id": "439c63b1-ec19-3f57-80d7-f8a7f17d8629",
                                                "text": "С наступлением сумерек воровато я вышел из сада на залог, воровато сбежал в овраг, по оврагу добрался до реки, а там холмы, мои укромные уголки, где и днем меня бы никто не нашел, не то что ночью, хотя бы и сияла луна."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d275a749-84b2-3360-bca5-d738d7b575f3",
                                        "entry_id": "921d3527-eaf6-3b52-9533-2628bbb702a7",
                                        "glosses": [
                                            "диал. никогда не паханная земля; целина"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
