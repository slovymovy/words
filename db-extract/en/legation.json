                        "cross_references": [
                            {
                                "target_word": "légation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4907f812-e4c0-3131-b60c-32b6c2bcdef8",
                                        "entry_id": "10dbd4b8-7f6d-3f2a-bb5e-a4b00c0d0431",
                                        "glosses": [
                                            "Charge, office de légat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d45c04-9ed5-47e4-b6bc-1f480c53a617",
                                                "sense_id": "4907f812-e4c0-3131-b60c-32b6c2bcdef8",
                                                "text": "Les légats a latere ne pouvaient exercer leur légation en France sans permission du roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b38c16-e0c6-398b-93d6-66eb0c7d5ea2",
                                        "entry_id": "10dbd4b8-7f6d-3f2a-bb5e-a4b00c0d0431",
                                        "glosses": [
                                            "Étendue du gouvernement d’un légat dans l’état ecclésiastique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f492090-4dba-4d99-96e6-5d0bcded58c8",
                                                "sense_id": "a9b38c16-e0c6-398b-93d6-66eb0c7d5ea2",
                                                "text": "Dans toute la légation de Bologne, de Ferrare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7273777-6fe0-3cad-bf67-bc755b9eb078",
                                        "entry_id": "10dbd4b8-7f6d-3f2a-bb5e-a4b00c0d0431",
                                        "glosses": [
                                            "Mission permanente, comprenant le ministre plénipotentiaire ou le ministre résident, ainsi que ses conseillers et ses secrétaires, entretenue dans un pays où il n’y a pas d’ambassade."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a8a2fff-04b8-4f2c-a078-8682e0fec00c",
                                                "sense_id": "d7273777-6fe0-3cad-bf67-bc755b9eb078",
                                                "text": "Je connais un ou deux secrétaires de légation qui, à leur retour, pourront me rendre ce service."
                                            },
                                            {
                                                "example_id": "e3d7389b-25d2-4c0c-bfcd-a23dd6629fc2",
                                                "sense_id": "d7273777-6fe0-3cad-bf67-bc755b9eb078",
                                                "text": "Un steamer en partance emporta la missive du caïd Maclean à Tanger, d'où la légation d'Angleterre la transmit par le télégraphe à Gibraltar et au Foreign Office."
                                            },
                                            {
                                                "example_id": "ae1ce270-d98b-4b51-b942-6b6cdbfe4522",
                                                "sense_id": "d7273777-6fe0-3cad-bf67-bc755b9eb078",
                                                "text": "Mais si l’on veut dépasser le cercle restreint des sérails et des légations, si l’on veut voyager hors des grandes villes, ou dans leurs bas-fonds, il faut se mettre au persan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6988afa8-5b57-3487-b83d-ec49cadcb4c0",
                                        "entry_id": "10dbd4b8-7f6d-3f2a-bb5e-a4b00c0d0431",
                                        "glosses": [
                                            "Hôtel qu’occupe cette mission."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb67f245-2d5a-4d25-81d8-f02719fe41c4",
                                                "sense_id": "6988afa8-5b57-3487-b83d-ec49cadcb4c0",
                                                "text": "Les légations de Russie et d’Angleterre ont reçu des obus autrichiens malgré le drapeau espagnol qui flottait sur leurs toit, et les artilleurs autrichiens trouèrent, à deux reprises, leur propre légation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
