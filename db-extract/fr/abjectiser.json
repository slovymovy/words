                "senses": [
                    {
                        "sense_id": "283b854c-384d-30a2-829e-f08e3fca4bb1",
                        "entry_id": "2f49b722-d36e-3eb3-8a3f-ddf6e8cf8783",
                        "glosses": [
                            "Donner un caractère abject à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd5ea75a-64fd-42fd-bf62-ac07605b8c78",
                                "sense_id": "283b854c-384d-30a2-829e-f08e3fca4bb1",
                                "text": "Malgré les complicités inconscientes, la proie du pervers narcissique, dévalorisée, « abjectisée », « dévitalisée », nous fait ressentir ce qu’elle ne peut plus exprimer : violence, révolte, effroi, nécessité vitale de se dégager pour retrouver une autonomie."
                            },
                            {
                                "example_id": "4fd93636-bc3f-4b5d-88cd-00f26e680108",
                                "sense_id": "283b854c-384d-30a2-829e-f08e3fca4bb1",
                                "text": "Il faut donc que tout y passe : pousser la surenchère, atteindre à une cruauté et un dégoût paroxystiques, abjectiser le récit…"
                            },
                            {
                                "example_id": "0b8e8855-7779-4cb1-95e8-14153de8b696",
                                "sense_id": "283b854c-384d-30a2-829e-f08e3fca4bb1",
                                "text": "C'est immonde. Abjectisant, merdicoidal et absconnement répugnatophile."
                            }
                        ]
                    }
                ],
