                    {
                        "translation_id": "9642b4a7-a5ea-42fa-8628-bee3aeebd582",
                        "source_entry_id": "82cd25e2-52a2-3f96-b2e7-ccf902772ab2",
                        "source_sense_id": "431fe144-8cc6-39d6-b80c-813a25a21e30",
                        "source_sense_description": "synthetisch hergestellter Wirkstoff mit schmerzlindernden, fiebersenkenden und entzündungshemmenden Eigenschaften",
                        "target_lang_word": "aspirine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspirine",
