                "senses": [
                    {
                        "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                        "entry_id": "6dce9057-f26d-3364-bfd0-347be829e2b2",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef59123a-c841-4f3c-a168-9459811fbe0f",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Frau Klopstock ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fa9bbdc4-1985-4129-91f0-5d9284486b6c",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Herr Klopstock wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7ae1839c-06fb-4e34-8735-fedd04eebf95",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Die Klopstocks fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "e3da12e3-5f23-4dc0-9cda-bd19885ac147",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Der Klopstock trägt nie die Pullover, die die Klopstock ihm strickt."
                            },
                            {
                                "example_id": "c17a383f-a5c4-4510-b717-3c3f880c453c",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Klopstock kommt, geht der Herr Klopstock.“"
                            },
                            {
                                "example_id": "4719a39d-027a-4de3-ba24-c81ed5034bca",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Klopstock kommt und geht."
                            },
                            {
                                "example_id": "91d0a598-cb4e-420f-8b95-5866c1e28756",
                                "sense_id": "2fee83f5-5927-39f1-ae70-61fcf613b5b5",
                                "text": "Klopstocks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
