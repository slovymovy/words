                        "examples": [
                            {
                                "example_id": "8760c7d9-2719-4d20-9edd-9da9c45ea091",
                                "sense_id": "41a950b0-32a2-3945-bc32-6194c9e222bd",
                                "text": "Den Tierquäler erwischten beherzte Anwohner auf frischer Tat."
                            },
                            {
                                "example_id": "d304a0b1-7600-4806-af5e-f5e6d4b5f14c",
                                "sense_id": "41a950b0-32a2-3945-bc32-6194c9e222bd",
                                "text": "Der Tierquäler betreibt doch tatsächlich eine Schweinezucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
