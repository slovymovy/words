                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "9678fd48-c762-4f04-a549-7eaf9847f162",
                                "sense_id": "67242789-1d27-306c-93e9-f6d1339604a2",
                                "text": "20 septembre 42 – Je dîne à Vanves demain soir, et je ferai la connaissance du père de Blaise et de sa « tantine »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a49f8f5c-c08c-39ae-b0f4-fe55bbd109be",
                        "entry_id": "4cf7f640-15e6-350d-a5a1-55a0e8dfdd6e",
                        "glosses": [
                            "Jeune fille, femme ou mère ; petite amie."
                        ],
                        "tags": [
                            "Créole",
                            "Régionalisme",
                            "région à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "5097ba19-5497-4220-8c64-765f53f655df",
                                "sense_id": "a49f8f5c-c08c-39ae-b0f4-fe55bbd109be",
                                "text": "Oh, oui, tu pourrais toujours aller voir la police, si tu le souhaites ? Mais pour leur dire quoi ? Que ce sale type a mal parlé à sa tantine ?"
                            }
                        ]
                    }
                ],
