                        "examples": [
                            {
                                "example_id": "c1ddaf26-41fa-45f5-b037-39a2a17fd977",
                                "sense_id": "8c6b2648-5f8d-3f40-bfd1-1d262fea7ff7",
                                "text": "В будни ходил он в плисовой куртке, по праздникам надевал сертук из сукна домашней работы."
                            },
                            {
                                "example_id": "76d8aff6-4537-448d-a036-3d3cab996062",
                                "sense_id": "8c6b2648-5f8d-3f40-bfd1-1d262fea7ff7",
                                "text": "Мушшина бородатый в сертуке туда полз с туесом, а обратно порозной."
                            }
                        ]
                    }
