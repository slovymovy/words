                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нуждающийся",
                                "target_lang_sense_clarification": "испытывающий материальную нужду"
                            },
                            {
                                "target_lang_word": "бедный",
                                "target_lang_sense_clarification": "не имеющий достаточных средств"
                            },
                            {
                                "target_lang_word": "малообеспеченный",
                                "target_lang_sense_clarification": "с низким уровнем дохода"
                            }
