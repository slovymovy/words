                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "utmost caution is required when travelling in this dangerous neighbourhood"
                                            },
                                            {
                                                "example_id": "305f9fe4-f3bf-486e-9671-31455a22a4de",
                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "In way of caution I must tell you."
                                            },
                                            {
                                                "example_id": "239882c0-959d-4116-ae1b-0e17158845ae",
                                                "sense_id": "d99644cd-47ae-3e23-adc3-a167a2444b2d",
                                                "text": "[...] and on the Saturday heavy seas pounded the W.R. on its exposed coastal stretch between Dawlish and Teignmouth, loosening the ballast and forcing trains to proceed with extreme caution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26989bac-1c8e-3c6f-ba81-835644cd5263",
                                        "entry_id": "36bac041-911d-3a41-9cf0-fbfcb55fa24c",
                                        "glosses": [
