                        "examples": [
                            {
                                "example_id": "a1cdb7e4-8c85-4f9f-8253-be4f3efa1c7a",
                                "sense_id": "aeb657fe-5deb-3fdd-a9fe-bd9d8920cbdc",
                                "text": "Aber ich finde es heikel, wenn die Mangellage der Wirtschaft Einfluss auf den Inhalt des Lehrplans hat."
                            },
                            {
                                "example_id": "d9c97a21-2acd-4e51-a461-a67ea7a5814d",
                                "sense_id": "aeb657fe-5deb-3fdd-a9fe-bd9d8920cbdc",
                                "text": "Weil der Speicherstand im Dezember zu schnell sinkt, ruft die Bundesnetzagentur zum Gassparen auf. Eine Mangellage sei indes nicht zu befürchten."
                            }
                        ]
                    }
