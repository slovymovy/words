                            {
                                "example_id": "378e5dc6-d3c9-4982-980e-439d707856a1",
                                "sense_id": "6828b03d-20e5-3d4f-8d8b-00c200f388d7",
                                "text": "„Zur Vorhut gehörte ein erfahrener Fährtenleser, aber der harte, kiesige Boden bot keinen Anhalt.“"
                            },
                            {
                                "example_id": "a2c04424-2b5d-4620-8ae6-72b44ac2c093",
                                "sense_id": "6828b03d-20e5-3d4f-8d8b-00c200f388d7",
                                "text": "„›Kommen Sie‹, sagt Colter. ›Ich helfe Ihnen. Ich bin ein ziemlich guter Fährtenleser.‹“"
                            }
                        ],
