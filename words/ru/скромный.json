                },
                {
                    "sense_id": "2bbdecbb-218a-3576-8970-ccace3fd209b",
                    "sense_definition": "Небольшой по размеру, количеству или значимости; едва достаточный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нашей семьи весьма <w>скромный</w> доход, поэтому мы стараемся экономить.",
                            "target_lang_translations": {
                                "en": "Our family has a very <w>modest</w> income, so we try to save money.",
                                "pl": "Nasza rodzina ma dość <w>skromny</w> dochód, dlatego staramy się oszczędzać."
                            }
                        },
                        {
                            "text": "Несмотря на <w>скромные</w> размеры комнаты, здесь было очень уютно.",
                            "target_lang_translations": {
                                "en": "Despite the <w>modest</w> size of the room, it was very cozy here.",
                                "pl": "Mimo <w>skromnych</w> rozmiarów pokoju było tu bardzo przytulnie."
                            }
                        }
                    ],
