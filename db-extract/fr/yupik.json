                "senses": [
                    {
                        "sense_id": "86dce176-5732-3bff-988c-7ef35d4860c8",
                        "entry_id": "e4b95abb-75f3-3c45-8b6b-48db865e0a49",
                        "glosses": [
                            "Relatif aux Yupiks, peuple d’Alaska et de Tchoukotka apparenté aux Inuits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b8e507-41c3-429d-a104-544cffc45f22",
                                "sense_id": "86dce176-5732-3bff-988c-7ef35d4860c8",
                                "text": "Les masques cérémoniels yupiks sont célèbres mais rares car ils étaient souvent brûlés après les cérémonies."
                            },
                            {
                                "example_id": "7a70c8dd-67a7-4e57-a5bd-b4cb384272de",
                                "sense_id": "86dce176-5732-3bff-988c-7ef35d4860c8",
                                "text": "J’allais hier encore écouter des Inuits sous leurs tentes, des percussions yupik et des tambours mohawk, les gens du festival, autant qu’ils le peuvent, veulent assimiler à la francophonie les minorités que le Canada a pu jadis coloniser."
                            },
                            {
                                "example_id": "001b7971-dd70-4b9b-95ba-236d320b9df5",
                                "sense_id": "86dce176-5732-3bff-988c-7ef35d4860c8",
                                "text": "D’après la datation des objets exhumés, les experts estiment que Nunalleq remonte à la période dite des Guerres de l’Arc et de la Flèche, qui ont opposé les communautés yupikes avant l’arrivée des explorateurs russes en Alaska au début du XIXe siècle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b6ec258a-f21b-399c-b29d-e19478344249",
                "word": "yupik",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d0f1d1e0-e8bd-4d65-825a-8cd3e0a5c749",
                        "entry_id": "b6ec258a-f21b-399c-b29d-e19478344249",
                        "tags": [],
                        "form": "youpik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0b36914-5e2a-3da2-9309-7b1e12cdac00",
                        "entry_id": "b6ec258a-f21b-399c-b29d-e19478344249",
                        "glosses": [
                            "Une des cinq langues esquimo-aléoutes parlées par les Yupiks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eca6ff5-0d53-4700-980d-1c22678c62c3",
                                "sense_id": "d0b36914-5e2a-3da2-9309-7b1e12cdac00",
                                "text": "Une conversation en yupik peut poser des problèmes de compréhension aux locuteurs qui ne parlent pas le même dialecte."
                            },
                            {
                                "example_id": "b6b28371-cb1c-4d1b-bb81-b4e59b8045b3",
                                "sense_id": "d0b36914-5e2a-3da2-9309-7b1e12cdac00",
                                "text": "J’ai alors beaucoup appris en accompagnant les Inuit à la chasse : près de 5 000 kilomètres à pied, en traîneau à chiens, en baïdare ou oumiak (inupiat) ou angyak (yupik) en peau de morse, au cours de mes trente et une missions."
                            },
                            {
                                "example_id": "8a54a3ab-6760-4311-9dcf-0295725c65ad",
                                "sense_id": "d0b36914-5e2a-3da2-9309-7b1e12cdac00",
                                "text": "Ils chantent en langue yupik des rengaines de leur pays qui parlent de phoques et d’épouses retenues dans les glaces, d’amour, de chasse au narval."
                            }
                        ]
                    }
                ],
