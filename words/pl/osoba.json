                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "osobistosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na przyjęciu pojawiły się najważniejsze <w>osoby</w> ze świata nauki i kultury.",
