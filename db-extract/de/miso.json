                    {
                        "sense_id": "9bc1a5dc-c790-352b-b06d-87fa300347ac",
                        "entry_id": "33571394-42dd-3ba2-b4db-ee20a6884a16",
                        "glosses": [
                            "aus Japan stammende Paste, die aus fermentierten Sojabohnen und Mehl aus Gerste oder Reis hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad5e48e-3f9e-4193-bd21-1d401960d40d",
                                "sense_id": "9bc1a5dc-c790-352b-b06d-87fa300347ac",
                                "text": "In vielen japanischen Gerichten ist Miso eine wichtige Zutat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60010c68-9e92-424a-98f9-604383e46ba7",
                        "source_entry_id": "33571394-42dd-3ba2-b4db-ee20a6884a16",
                        "source_sense_id": "9bc1a5dc-c790-352b-b06d-87fa300347ac",
                        "target_lang_word": "miso",
