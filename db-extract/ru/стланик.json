                "senses": [
                    {
                        "sense_id": "675a59b2-4342-3ac2-998d-55015d593f42",
                        "entry_id": "26395d66-2b93-3b42-9b57-06819f032e65",
                        "glosses": [
                            "ботан. кустарник или кустарниковое дерево с низкорослой, стелющейся по земле формой, формирующейся под действием неблагоприятных условий внешней среды"
                        ],
                        "tags": [
                            "в горных и приполярных местностях"
                        ],
                        "examples": [
                            {
                                "example_id": "10e1878b-6645-4734-a48d-e02ce0f47999",
                                "sense_id": "675a59b2-4342-3ac2-998d-55015d593f42",
                                "text": "Через два-три часа из-под снега протягивает ветви стланик и расправляется потихоньку, думая, что пришла весна."
                            },
                            {
                                "example_id": "f966353e-0fe2-40ec-9ffa-aa90bc4f1c40",
                                "sense_id": "675a59b2-4342-3ac2-998d-55015d593f42",
                                "text": "Однако со временем и эту каменную ленту на всём её протяжении от астраханских камышей до беломорской прибрежной тундры заглушили пески, степные травы, ольшаники, вересняки, душный багульный стланик да сырь болотных мхов."
                            }
                        ]
                    }
