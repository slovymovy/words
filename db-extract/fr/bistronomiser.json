                ],
                "senses": [
                    {
                        "sense_id": "69aca591-1056-3339-8515-278de14474a6",
                        "entry_id": "f02aefaf-6a56-350f-97f9-c81e8e94005f",
                        "glosses": [
                            "Donner un caractère bistronomique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9c4caa-4b0b-4fc0-912d-0e25c8b7ef82",
                                "sense_id": "69aca591-1056-3339-8515-278de14474a6",
                                "text": "Entre côte de boeuf, foie gras historique et riz au lait mythique, il a le don de bistronomiser les produits audacieux avec des assaisonnements à couper le souffle."
                            },
                            {
                                "example_id": "ae0d0cb3-6ba7-4493-9188-2ad8faf447a4",
                                "sense_id": "69aca591-1056-3339-8515-278de14474a6",
                                "text": "Mais les temps sont difficiles pour ces artistes de l'instant, car on préfère bistronomiser en rond que tenter l'aventure."
                            },
                            {
                                "example_id": "76565b54-2c42-4a71-a62d-3fb762a4d34a",
                                "sense_id": "69aca591-1056-3339-8515-278de14474a6",
                                "text": "De la bouche de Suzanne, alors que tous les restaurants cherchent à se « bistronomiser », le Laurie-Raphaël, lui, se gastronomise."
                            }
                        ]
                    }
                ],
