                    },
                    {
                        "translation_id": "f40882ef-a7b2-434a-bf44-e73f48ae640d",
                        "source_entry_id": "e2f4f019-8354-3f44-98a1-f9821aea9ed8",
                        "source_sense_description": "наводящий скуку, тоску; нудный",
                        "target_lang_word": "dreary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dreary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0e40cf-8e3d-35ae-93ac-b817ffd3964c",
                                        "entry_id": "5763fe1e-67a2-3295-8a69-4cb8ae89c308",
                                        "glosses": [
                                            "Drab; dark, colorless, or cheerless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189ed187-eeb7-4151-900f-3fb7e6d880f9",
                                                "sense_id": "7c0e40cf-8e3d-35ae-93ac-b817ffd3964c",
                                                "text": "It had rained for three days straight, and the dreary weather dragged the townspeople's spirits down."
                                            },
                                            {
                                                "example_id": "d43e4031-df69-4106-8933-3cf14e8d8891",
                                                "sense_id": "7c0e40cf-8e3d-35ae-93ac-b817ffd3964c",
                                                "text": "Once upon a midnight dreary, while I pondered, weak and weary..."
                                            },
                                            {
                                                "example_id": "3bf4b754-6a29-471c-9d21-b0738f11f722",
                                                "sense_id": "7c0e40cf-8e3d-35ae-93ac-b817ffd3964c",
                                                "text": "It was on a dreary night of November, that I beheld the accomplishment of my toils."
                                            },
                                            {
                                                "example_id": "e9e6bbab-4b62-48e3-b5df-d5dcc47fd7f3",
                                                "sense_id": "7c0e40cf-8e3d-35ae-93ac-b817ffd3964c",
                                                "text": "The train is booked to stop at Jiza for only three minutes, but more often than not twenty minutes or more are spent on shunting before it sets off again on what must be one of the most dreary journeys in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa54c26d-de41-32ef-99f9-1e84e2c1b35f",
                                        "entry_id": "5763fe1e-67a2-3295-8a69-4cb8ae89c308",
                                        "glosses": [
                                            "Grievous, dire; appalling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dreary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "600332de-69bf-344c-8433-c2bafa2d2f5e",
                                        "entry_id": "2b2f17a8-306d-3524-9385-cc562881be35",
                                        "glosses": [
                                            "A dreary person or thing."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28cc060f-393b-4782-ba8f-6614799f669a",
                                                "sense_id": "600332de-69bf-344c-8433-c2bafa2d2f5e",
                                                "text": "In the glow of this project Steele manages to forget altogether the parade of donnish and scholastic drearies, the barricades of schoolbooks, texts, examinations with which he has dealt so faithfully."
                                            },
                                            {
                                                "example_id": "2a003a57-83c3-4323-808b-d0148114f956",
                                                "sense_id": "600332de-69bf-344c-8433-c2bafa2d2f5e",
                                                "text": "2018, Tibor Fischer, The Thought Gang\nI'm taking it all down. The trivialities. The ramblings. The drearies. The trites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
