                                    },
                                    {
                                        "sense_id": "4e3d3547-c5f3-3854-9339-5ac5adba3196",
                                        "entry_id": "b0d7bdf1-9daf-3d52-bb4a-4aad2a23d7aa",
                                        "glosses": [
                                            "ein Amt/einen Dienst ausführen/ausfüllen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18941808-4e03-4f25-bae4-b93e24e33121",
                                                "sense_id": "4e3d3547-c5f3-3854-9339-5ac5adba3196",
                                                "text": "Er versah alle seine Ämter mit Hingabe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d5ce273-879e-3c8f-af64-0b41fe325fc6",
                                        "entry_id": "b0d7bdf1-9daf-3d52-bb4a-4aad2a23d7aa",
                                        "glosses": [
                                            "sich irren"
                                        ],
