                "translations": [
                    {
                        "translation_id": "b3210bce-0b33-4947-8573-07815142f33b",
                        "source_entry_id": "16ebaa2d-56a8-31b7-a031-24a3f3043c92",
                        "source_sense_id": "e86501fb-2dcb-34c3-88c1-dfc37b12d60b",
                        "target_lang_word": "griot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "griot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "044a54b2-8176-3ccf-8fdf-a7e29e8383d1",
                                        "entry_id": "da472ab1-6e69-33db-bdff-e91c7a3dbce9",
                                        "glosses": [
                                            "Poète et musicien ambulant, dépositaire de la tradition orale.→ voir guiriot"
                                        ],
                                        "tags": [
                                            "Afrique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84aacbde-9e6f-4d67-849c-c485b5e0df59",
                                                "sense_id": "044a54b2-8176-3ccf-8fdf-a7e29e8383d1",
                                                "text": "Les griots du Roi m’ont chanté la légende véridique de ma race aux sons des hautes kôras."
                                            },
                                            {
                                                "example_id": "5c950a17-39bc-48ee-9331-b2fd0f964586",
                                                "sense_id": "044a54b2-8176-3ccf-8fdf-a7e29e8383d1",
                                                "text": "— Anamalis fobil ! — hurlaient les Griots en frappant sur leur tam-tam, — l’œil enflammé, les muscles tendus, le torse ruisselant de sueur…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "123ecabf-aa3a-30c7-8476-303aea8dfaa8",
                                        "entry_id": "da472ab1-6e69-33db-bdff-e91c7a3dbce9",
                                        "glosses": [
                                            "Poète et musicien ambulant au service d’un groupe dominant ou d’une famille."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f41ba1d5-610b-4438-a0a0-d2a999656976",
                                                "sense_id": "123ecabf-aa3a-30c7-8476-303aea8dfaa8",
                                                "text": "Comme dans toutes les sociétés, l’histoire est en Mauritanie un discours construit, évolutif, qui légitime les positions respectives des uns et des autres et fait l’objet d’un monopole, le plus souvent de la classe dominante qui l’émet directement ou indirectement par l’intermédiaire de ses lettrés et de ses griots."
                                            },
                                            {
                                                "example_id": "7e0b8b8c-3cd8-4ac3-ae3f-fb5243119ff8",
                                                "sense_id": "123ecabf-aa3a-30c7-8476-303aea8dfaa8",
                                                "text": "L’un des baobabs signalés par Adanson à Ouakam est peut-être l’arbre à griots connu sous le nom de gouy guevel, abattu le 7 juillet 1959 et dont la circonférence, à 1 m du sol, était de 22,50 m en 1958, la différence en diminution étant expliquée par le fait qu’Adanson dut prendre sa mesure au sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6529f8-dd1d-3605-8a30-1d8159dfd86f",
                                        "entry_id": "da472ab1-6e69-33db-bdff-e91c7a3dbce9",
                                        "glosses": [
                                            "Celui qui conte des histoires pour gens crédules."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa146e3c-7f5f-44c6-8c8a-5643d9172136",
                                                "sense_id": "0a6529f8-dd1d-3605-8a30-1d8159dfd86f",
                                                "text": "Si vous saviez ce dont les horribles griots sont capables là-bas, monsieur Dickson, vous seriez moins incrédule."
                                            },
                                            {
                                                "example_id": "5c10ed08-e369-419e-b3d7-564a6e8e2f21",
                                                "sense_id": "0a6529f8-dd1d-3605-8a30-1d8159dfd86f",
                                                "text": "Les griots de la nouvelle économie ont déchanté. La hausse continue des marchés boursiers a laissé place à un effondrement spectaculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3918d5dc-cc53-3246-a59b-987a5d64d169",
                                        "entry_id": "da472ab1-6e69-33db-bdff-e91c7a3dbce9",
                                        "glosses": [
                                            "Enfant ; gosse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "griot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a153516-f24d-3b8e-8d75-710683c3cd56",
                                        "entry_id": "5be3453b-eb8a-349f-889e-6b251fe9a97e",
                                        "glosses": [
                                            "Type de farine, recoupe de blé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec1e435f-a6c2-4861-af89-9c0993c359df",
                                                "sense_id": "9a153516-f24d-3b8e-8d75-710683c3cd56",
                                                "text": "...Il faut savoir que le blé moulu se blute, et que le bluteau se distibue en six portions : savoir, la fleur de la farine, la grosse farine, les griots, les recoupettes, et le son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbffd0d7-6e68-30ae-8f48-6e7619d5ee34",
                                        "entry_id": "5be3453b-eb8a-349f-889e-6b251fe9a97e",
                                        "glosses": [
                                            "Mets haïtien."
                                        ],
                                        "tags": [
                                            "Haïti"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbecd8c-8599-4321-89e7-b5f3a137f236",
                                                "sense_id": "fbffd0d7-6e68-30ae-8f48-6e7619d5ee34",
                                                "text": "«C’est la première fois que l’on vient et que l’on mange haïtien! C’est différent», lance Dimitrios Mahou, qui a conduit de Cincinnati jusqu’à Springfield pour goûter au griot avec sa femme et une amie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
