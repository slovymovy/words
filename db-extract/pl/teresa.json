                "translations": [
                    {
                        "translation_id": "3c883486-076c-48e3-877b-589ac3cc820f",
                        "source_entry_id": "f55abce7-b247-379f-8d1e-cc211747ccb0",
                        "source_sense_id": "03e793f5-d629-3acd-80b8-2bc6663da096",
                        "target_lang_word": "Teresa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teresa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                                        "entry_id": "0d293d64-e970-3b44-80cf-8866e068ac6f",
                                        "glosses": [
                                            "A female given name from Ancient Greek, the Spanish and Italian form of Theresa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "407f8374-2814-448f-ae54-59c16264c36a",
                                                "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                                                "text": "My friends call me Terry. My husband always used my full name, Teresa. He said it made him feel like he was married to a foreign woman."
                                            },
                                            {
                                                "example_id": "c31fcc52-f9d8-4567-9f0c-7f3e751b065e",
                                                "sense_id": "69b7a996-c1a8-301a-b3f9-3557a2b7b85e",
                                                "text": "Cynthia and Melinda, reduced to Cindy and Mindy, as Carella had dreaded would happen from the moment she named them. Her older daughter had fared better. Tess, modern and sleek for Teresa, which conjured up cobblestoned streets in a mountain village in Potenza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5855d7ec-a867-3d59-854c-e87a91b79e82",
                                        "entry_id": "0d293d64-e970-3b44-80cf-8866e068ac6f",
                                        "glosses": [
                                            "A municipality of Rizal, Philippines."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6198103e-21c9-47e9-bc27-f382de70e788",
                        "source_entry_id": "f55abce7-b247-379f-8d1e-cc211747ccb0",
                        "source_sense_id": "03e793f5-d629-3acd-80b8-2bc6663da096",
                        "target_lang_word": "Theresa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theresa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2873775c-2d5a-3d77-bffd-a988cd1158ec",
                                        "entry_id": "33418d5b-f454-31ab-b840-0b15ae46937c",
                                        "glosses": [
                                            "A female given name from Ancient Greek, variant of Teresa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cbd28b0-5572-41e4-961b-9f55b91c60d0",
                                                "sense_id": "2873775c-2d5a-3d77-bffd-a988cd1158ec",
                                                "text": "\"Theresa!\" exclaimed the stranger, \"is your name Theresa?\" asked she, a death-like paleness at the same time overspreading her countenance.\n\"Is this name so frightful to you?\" enquired the recluse.\n\"Frightful!\" rejoined the stranger, \"O, no, I venerate it, like the name of a saint. I had once an unknown friend, whose name was Theresa."
                                            },
                                            {
                                                "example_id": "47fdad48-31cb-4710-b6d2-0a55c8725b27",
                                                "sense_id": "2873775c-2d5a-3d77-bffd-a988cd1158ec",
                                                "text": "\"Theresa,\", he said. \"I never cared for that name.\"\nJustine nodded, chewing.\n\"I don't like difficult names. I don't like foreignness.\"\n\"Perhaps they're Catholic,\" Justine said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
