                        "glosses": [
                            "Gemeinde im französischen Département Saône-et-Loire; Autun"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "029580a8-d9c7-4f6f-8981-6160258224ac",
                                "sense_id": "d7dd073a-1609-35c0-baf0-7c6c9a031b24",
                                "text": "„Als ich 1991 mit der Ergrabung von Apsis und Chor der Kathedrale Saint‐Lazare von Autun in Burgund betraut war, hatte ich Besuch von einem Seminar amerikanischer Architektur‐ und Kunstgeschichtsstudenten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
