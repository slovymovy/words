                "senses": [
                    {
                        "sense_id": "6996d31c-ebe9-3588-88fe-07736dee982c",
                        "entry_id": "948f5b70-b3cc-3ebb-b8a1-fe96ad8ef82f",
                        "glosses": [
                            "nicht mit sachlichen/fachlichen Erläuterungen versehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad884ded-f428-4a71-9d6d-dc471915c8c6",
                                "sense_id": "6996d31c-ebe9-3588-88fe-07736dee982c",
                                "text": "„Unkommentiert bleiben solche Stellen, deren literarische, historische oder zeitgeschichtliche Bedeutung vorausgesetzt werden kann […].“"
                            },
                            {
                                "example_id": "08f84116-d4db-43ca-92ce-84577fa0ca85",
                                "sense_id": "6996d31c-ebe9-3588-88fe-07736dee982c",
                                "text": "„Tobias findet es ‚langweilig‘, nichts zu Fotos zu schreiben und diese einfach unkommentiert stehen zu lassen: ‚Also wenn ich ’n Foto mache, dann muss auch irgendwie zumindest ersichtlich sein, wo das ist und mit wem. […]‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
