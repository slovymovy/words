                                        "sense_id": "9e283334-e4c9-3e66-b24a-6a7e99e3e13c",
                                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                                        "glosses": [
                                            "A certain degree of similarity between the meaning(s) of several (synonymous) words or phrases. (See Usage notes below.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ec68fe4-77e9-356b-9035-0509051f2be2",
                                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                                        "glosses": [
                                            "A list or collection of synonyms, often compared and contrasted."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bc8cd21-2f8f-34fc-ac31-c6e6316872c3",
                                        "entry_id": "556a224c-c629-32a5-ac79-cf99d45e691c",
                                        "glosses": [
                                            "The use of synonyms to clarify or explain one's meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
