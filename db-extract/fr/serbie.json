                            {
                                "target_word": "Serbien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                        "entry_id": "ec945141-22b6-3f97-9825-13c022806f1b",
                                        "glosses": [
                                            "Staat in Südosteuropa"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce9d3eb-9887-4c45-93a6-c3d411044e04",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Ich komme aus Serbien."
                                            },
                                            {
                                                "example_id": "eccfd2a3-34c6-4e9e-9798-54244f7bf8b3",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Belgrad ist die Hauptstadt der Republik Serbien."
                                            },
                                            {
                                                "example_id": "3bd1a4a5-ec86-4629-b158-524f5bb84c9e",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "Alle wichtigen Verkehrswege Südosteuropas kreuzen sich in Serbien."
                                            },
                                            {
                                                "example_id": "fe707f9c-ce5d-4471-80bb-6ffd66f9f087",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Ich hatte Sébastien und seine hübsche Freundin Anis vor einer knappen Woche beim Donaudurchbruch in Serbien getroffen.“"
                                            },
                                            {
                                                "example_id": "96b70474-6c97-4c53-a358-fc30ea2c6efd",
                                                "sense_id": "7697f3ee-c6c3-3f71-b593-40170240b566",
                                                "text": "„Doch sosehr sie die Arbeit, die sie in Serbien verrichtete, schätzte, es war nicht ihre Art von Arbeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
