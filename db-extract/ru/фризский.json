                ],
                "translations": [
                    {
                        "translation_id": "4c67f88b-71aa-411e-8dac-7f314f4cac71",
                        "source_entry_id": "5fc5b680-ad04-3eb9-b0d8-ea35d3c7c6ea",
                        "target_lang_word": "Frisian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "The West Frisian (or Western Frisian) lect, spoken in the northern Netherlands."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bab7d4af-0a63-4cc7-b911-e8f096a69b69",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "In the province of Friesland, in the north of the Netherlands, a high percentage of the population, about 350000, speak Frisian as their first language."
                                            },
                                            {
                                                "example_id": "56b305fd-5dfa-4fff-ad22-b122231c6db4",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "This means that full competence in both Frisian and Dutch (ie understanding, speaking, reading and writing ability) is aimed at all pupils in the province, whether they speak Frisian or Dutch at home."
                                            },
                                            {
                                                "example_id": "f7954aa7-8329-464e-96fd-6517d4fe4f9b",
                                                "sense_id": "4c5ae144-a8fb-3cdc-9a90-f270d61efa32",
                                                "text": "Many Frisians speak Frisian at home and Dutch at work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29f89a40-a0e2-3522-9fb3-26e1ed6121e0",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "Saterland Frisian, the last surviving dialect of the East Frisian lect, spoken in Northern Germany close to the Dutch border."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a8d48dc-25fd-33db-86d8-270bda75cc75",
                                        "entry_id": "c9d85325-c8f4-32cb-8474-58b4fa948d8e",
                                        "glosses": [
                                            "A Germanic language group or language (see Usage notes), or a lect thereof, which descended from Old Frisian, with speakers in the Netherlands, Germany and Denmark.",
                                            "The North Frisian lect, spoken in northwestern Schleswig-Holstein in Germany."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3695d12c-e3c3-34b6-9582-0db0a56db0c2",
                                        "entry_id": "9ef90c23-a71a-398d-a17c-e08cfea1a780",
                                        "glosses": [
                                            "A member of the Germanic ethnic group which is native to the region of Frisia (which is in the Netherlands, northern Germany, and southern Denmark)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f94ed21-be6c-4341-872b-ef521f660a90",
                                                "sense_id": "3695d12c-e3c3-34b6-9582-0db0a56db0c2",
                                                "text": "King Hygelac of the Geats had been struck down by one might swipe of the foemen, the Frisians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a28cb961-5ae7-3aec-89a7-2d1178ecae47",
                                        "entry_id": "9ef90c23-a71a-398d-a17c-e08cfea1a780",
                                        "glosses": [
                                            "A native or inhabitant of the Dutch province of Friesland."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Frisian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90373339-5f8f-3e7b-acca-8d2b4634b7d7",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of, in or relating to the Frisian language or a Frisian language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b067197-4a63-41f2-9e47-5c68fa033567",
                                                "sense_id": "90373339-5f8f-3e7b-acca-8d2b4634b7d7",
                                                "text": "Because the instruction manual was Frisian, Yves couldn't read it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a1a1ef-92a5-3efe-854e-51a8f2527936",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of, from or relating to the region of Frisia: Either West Frisia (the Dutch province of Friesland); North Frisia (in the German state of Schleswig-Holstein, near the Danish border); or East Frisia (in the German state of Lower Saxony, near the Dutch border)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1316393-150c-36fe-a115-8cbba160c150",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of or relating to people of Frisian descent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c36d2101-375b-34db-95bc-3f2a5f41af8f",
                                        "entry_id": "97f92cff-d831-31ae-902f-772655650f50",
                                        "glosses": [
                                            "Of, from or relating to West Frisia, i.e. the Dutch province of Friesland"
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fe5f1a6-1889-4af6-85d1-7ae2c0eef7a3",
                        "source_entry_id": "5fc5b680-ad04-3eb9-b0d8-ea35d3c7c6ea",
                        "target_lang_word": "friesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "friesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e492556-9965-3a50-9620-9cb28ba9b444",
                                        "entry_id": "30309526-c87a-3bd8-a990-c9be9ab6c8d4",
                                        "glosses": [
                                            "die Sprache der Friesen, Friesisch, betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652f086e-7353-45b4-bf35-d875b9ef1558",
                                                "sense_id": "5e492556-9965-3a50-9620-9cb28ba9b444",
                                                "text": "Einige friesische Wörter gibt es sonst in keiner Sprache."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                        "entry_id": "30309526-c87a-3bd8-a990-c9be9ab6c8d4",
                                        "glosses": [
                                            "die Friesen und ihre Kultur betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30eb0466-463e-4544-967e-4ced005b9926",
                                                "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                                "text": "„Einige friesische Filme, etliche friesischsprachige Theateraufführungen und Publikationen aus Belletristik und Wissenschaft, populäre Musik und sogar Opern sorgen für eine lebendige friesische Kulturszene.“"
                                            },
                                            {
                                                "example_id": "b60a8f83-8de2-4de3-8a80-b3f2da80eb40",
                                                "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                                "text": "„Er umgab sich mit Ratgebern, welche in fremden Verhältnissen aufgewachsen, friesischer Art und friesischer Sitte unkundig waren und die Verhältnisse der Grafschaft Ostfriesland unerträglich fanden.“"
                                            },
                                            {
                                                "example_id": "a477f7eb-f5eb-45dd-b7bd-d0e55a54bc4f",
                                                "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                                "text": "„›Ein friesischer Herr?‹ rief Maria lebendig. ›Kann das derselbe sein, dessen Ankunft seine Gnaden mein Cousin von Nassau mir gemeldet hat?‹“"
                                            },
                                            {
                                                "example_id": "b4a09983-1176-4f5f-808e-a08868cba693",
                                                "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                                "text": "„Als kulturelle Besonderheit der Friesen ist auf den typisch friesischen Baustil zu verweisen, ebenso auf friesische Trachten und das Biikebrennen, eine Art nordfriesisches Nationalfest, das am 21. Februar gefeiert wird.“"
                                            },
                                            {
                                                "example_id": "67545cc7-7ad1-4d48-bfac-c0d30187c5b2",
                                                "sense_id": "b0dc7547-59bc-378e-b594-73592bfde7f3",
                                                "text": "„[…] die Schlafstelle nach friesischer Sitte, wie bei Schiffen, gewöhnlich in der Wand angebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                        "entry_id": "30309526-c87a-3bd8-a990-c9be9ab6c8d4",
                                        "glosses": [
                                            "das Land der Friesen, Friesland, betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1394eb0-f5db-47e3-9898-234f1d0fdda7",
                                                "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                                "text": "Er stammt aus dem friesischen Leer."
                                            },
                                            {
                                                "example_id": "f11e8fa2-0ab2-412b-9075-0fb1dc43931b",
                                                "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                                "text": "„Im Jahre 1252 rückte Abel mit einem großen Heere über die Geesthöhen Schleswigs nach dem Eiderstrom, wo seine Schiffe bereit lagen, ihn und sein Heer nach den Gestaden des friesischen Landes zu führen.“"
                                            },
                                            {
                                                "example_id": "00f4d67b-cc69-4f5c-8a8b-47d6413ebd6d",
                                                "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                                "text": "„Man könnte jedoch auch an Ausländer denken, unter anderem an hohe Beamte, die sich nach 1515 in relativ großer Anzahl in den friesischen Städten vorübergehend oder endgültig niederließen.“"
                                            },
                                            {
                                                "example_id": "dc5115da-c493-46cb-aa22-f51f28fec833",
                                                "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                                "text": "„Im Falle des Bechers geht es um ein friesisches Dorf, in dem des Gemäldes um die Ursprungsgeschichte der Friesen.“"
                                            },
                                            {
                                                "example_id": "f5508d43-c68e-4082-87cf-8c4a5b49e72c",
                                                "sense_id": "e196f9cf-f8ef-3df2-b0b6-e299c99918d0",
                                                "text": "„Gesetze einzelner friesischer Gemeinden sind in noch grösserer Zahl überliefert;“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
