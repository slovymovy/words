                "senses": [
                    {
                        "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                        "entry_id": "4c4d16cb-5397-31f1-836a-d442ac69cac0",
                        "glosses": [
                            "jemand, der eine Rennstrecke bis eine Stunde vor dem offiziellen Start abfährt und dem eigenen Team den aktuellen Zustand sowie etwaige Veränderungen der Strecke meldet"
                        ],
                        "tags": [
                            "Rallye"
                        ],
                        "examples": [
                            {
                                "example_id": "e3e8f7d2-0f43-4898-a7ad-f1baa11f7087",
                                "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                                "text": "„‚Seine Unbekümmertheit müßte ihm auf den vielen schnellen Passagen entgegenkommen‘, hofft auch Vater Rudi, der bei der ‚Argentinia‘ neunmal am Start war, heuer für seinen Sohn als Schotterspion unterwegs sein wird.“"
                            },
                            {
                                "example_id": "6e5a6b2e-1c38-4a5b-8f2f-d46ec9f4c934",
                                "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                                "text": "„Kostenreduzierungen – wie bei neuen Vorgaben in der Formel 1 – haben den Motorsport-Weltverband Fia unter anderem veranlasst, lediglich noch zwei Werksfahrzeuge pro Marke zuzulassen, an den Servicestationen die Wagen nur noch nacheinander abfertigen zu lassen, um Personal zu sparen, und die Eis- und Schotterspione zu verbieten.“"
                            },
                            {
                                "example_id": "0480989a-720a-482c-9939-92e7ce0a6f35",
                                "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                                "text": "„Sobald Markko Märtin wieder sprechen konnte, lederte er los: ‚Ich verstehe die Verantwortlichen beim Automobilweltverband Fia nicht. Wollen sie einen Fahrer umbringen, oder dass wir erst zehn Zuschauer töten, bevor sie uns zuhören? Natürlich war der Unfall in erster Linie mein Fehler, aber mit den Schotterspionen wäre er wohl nicht passiert.‘“"
                            },
                            {
                                "example_id": "1cd3d901-842d-406f-aaa1-2ece1ad01707",
                                "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                                "text": "„Dagegen hörte sich das Klagen ob des fehlenden dritten Autos pro Team oder der aus Kostengründen gestrichenen Schotterspionen harmlos an.“"
                            },
                            {
                                "example_id": "2d4719fe-4ac6-4ba6-9904-a88046914f5a",
                                "sense_id": "60115bea-d5be-314e-a212-9482ee7c09b0",
                                "text": "„Im Gegensatz zu Schotterrallyes ist bei Asphaltrallyes wie in jener in Deutschland aus Sicherheitsgründen ein Schotterspion erlaubt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
