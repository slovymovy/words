            {
                "entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                "word": "prémonition",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "278978cb-a141-4475-9000-d6d2783c17e6",
                        "entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "prémonitions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                        "entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "glosses": [
                            "Forte intuition, pressentiment que quelque chose va se passer."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "d17d64e3-fb7f-400f-afa8-eeb412a69826",
                                "sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                                "text": "Cette prémonition que Marie semble avoir eue, et des scrupules du chrétien pratiquant que je suis et de ses exigences, j’en connais maintenant les raisons à travers ce que Balège a rapporté à Simon."
                            },
                            {
                                "example_id": "672c2270-c24e-4a24-b78c-7df674809d06",
                                "sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                                "text": "Son crédit est immense depuis qu’elle a sauvé la cathédrale de Lisieux des bombardements de 1944 – l’église seule debout parmi les ruines, comme une prémonition de la bombe à neutrons, laquelle eût également épargné les maisons aux alentours, mais, pour l’époque, ce n’est déjà pas si mal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42c56a0a-c7cd-4fc8-8274-7ac6c6a5381b",
                        "source_entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "source_sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                        "target_lang_word": "Vorahnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorahnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                        "entry_id": "ba5a4f98-0752-35c8-8ab3-c5c446c0b268",
                                        "glosses": [
                                            "undeutliches Gefühl, dass etwas geschehen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b62cdfcf-f613-4aa6-87a9-38960969f53a",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Spät abends trieb es ihn wie in einer Vorahnung auf den Hof.“"
                                            },
                                            {
                                                "example_id": "f2f40cdd-5964-4935-87a1-4fabadf228f8",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Daher brach ich mit einer düsteren Vorahnung zu dieser Reise auf.\""
                                            },
                                            {
                                                "example_id": "8625351e-5492-40aa-bc90-ffa663163432",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Aber schon in das Hochgefühl der Siegesfeiern mischten sich dunkle Vorahnungen.“"
                                            },
                                            {
                                                "example_id": "d8ff349c-8e88-4bdb-8dbf-a7b5a9a35a73",
                                                "sense_id": "4715d7d8-14c0-3f98-abc5-76f7ff70e545",
                                                "text": "„Hoffmann hat nicht nur ein sehr lebhaftes Traumleben, oft kommt es auch vor, daß ihm Wachträume erscheinen, er hat oft Vorahnungen und Gesichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae8dc78c-484f-45b9-bb46-5f8ceaa8916f",
                        "source_entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "source_sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
                        "target_lang_word": "Vorwarnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorwarnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                                        "entry_id": "9ebc601c-0d59-3838-8cfe-10da084570c6",
                                        "glosses": [
                                            "rechtzeitige Mitteilung oder Anzeige einer drohenden Gefahr, Hinweis auf eine solche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc647ae-37ed-4c4a-af9a-19a93c5d7665",
                                                "sense_id": "4c9ae128-6e68-35ac-abb0-a805e4b5fdda",
                                                "text": "„Die meisten Amok-Ereignisse treten nach Erkenntnissen der Weltgesundheitsorganisation WHO ohne Vorwarnung auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8564d9c-8e33-4f48-9921-7e5d7117fd47",
                        "source_entry_id": "5639b8a5-7881-395c-ba42-7eae236f57fe",
                        "source_sense_id": "894c24ae-0f05-3a49-9013-0ae525baddbb",
