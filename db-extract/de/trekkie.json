                                "target_senses": [
                                    {
                                        "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                        "entry_id": "fff4d542-c218-3586-9764-82e44cb85267",
                                        "glosses": [
                                            "A (usually major) fan of the TV science fiction series Star Trek."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "087ff1c8-415d-4a5b-9216-976c606d3753",
                                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                                "text": "Not all Trekkies go around speaking Klingon and making endless references to the original Star Trek series."
                                            },
                                            {
                                                "example_id": "9e7499b5-fbea-4c14-960b-5dd525fa0a99",
                                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                                "text": "1992 StarTrek VI is a fast-moving, vigorous book that will not disappoint the legions of Trekkies who avidly follow the adventure of their heroes. — Review of Star Trek - The Undiscovered Country in Amiga User International, author unknown, December 1992, HHL Publishing (UK), page 90."
                                            },
                                            {
                                                "example_id": "84254f21-55e2-4265-8f63-167608501c78",
                                                "sense_id": "e5ceddc3-19c6-3250-a8e1-198dde60327c",
                                                "text": "2002 I have a major confession to make which will probably incur the wrath of all Trekkies out there. — Trek & Treat, article in The Daily Mirror (UK), Jessica Mellor, Saturday, August 10, 2002, page 44."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "216912b2-7c44-40ad-bc0a-37b1f0d201cc",
                        "source_entry_id": "f83e4f08-b24f-3be2-bc73-17e21afe0654",
                        "source_sense_id": "5ab46278-85f2-3b3e-96fa-a9dd45ac22a4",
                        "source_sense_description": "Fan der Fernsehserie Star Trek",
                        "target_lang_word": "τρεκάς",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "τρεκάς",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "328ca98a-8f9b-37c8-84c8-6aafbd3b7679",
                                        "entry_id": "8b2255e7-7183-304e-8c52-415c8429f0d2",
                                        "glosses": [
                                            "τρέκι"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18183b09-54b9-43bf-9ecb-560747aead64",
                                                "sense_id": "328ca98a-8f9b-37c8-84c8-6aafbd3b7679",
                                                "text": "※ Αν και τυπικά \"παιχνίδι\" το λες, στην ουσία δεν είναι ακριβώς παιχνίδι, μιας και δεν έχει κάποιο συγκεκριμένο στόχο, κάτι που πρέπει να κάνεις. Το οποίο όμως το κάνει ακόμη πιο απολαυστικό! Ό,τι θα ήθελε ένας τρεκάς: να κάνει ανενόχλητος τη βόλτα του και να εξερευνήσει το Enterprise! (Star Trek Greece, A Greek Star Trek Forum Focused on the Original Timeline, ανακτήθηκε στις 26/7/2022 https://www.greektrek.com/viewtopic.php?t=244)"
                                            },
                                            {
                                                "example_id": "7132f716-14b3-4588-aaaa-f2a4a2804929",
                                                "sense_id": "328ca98a-8f9b-37c8-84c8-6aafbd3b7679",
                                                "text": "※ και όσοι αναγνωρίζουν τις λέξεις \"Τρέκερ\" ή \"Τρεκάς\" ξέρουν πως αναφέρονται στους φανατικούς θαυμαστές του Σταρ Τρεκ, στα Αγγλικά (Το Εγκυκλοπαιδικό Λεξικό του Star Trek - Ορολογία - SFF.gr https://community.sff.gr/topic/6242-%CF%84%CE%BF-%CE%B5%CE%B3%CE%BA%CF%85%CE%BA%CE%BB%CE%BF%CF%80%CE%B1%CE%B9%CE%B4%CE%B9%CE%BA%CF%8C-%CE%BB%CE%B5%CE%BE%CE%B9%CE%BA%CF%8C-%CF%84%CE%BF%CF%85-star-trek-%CE%BF%CF%81%CE%BF%CE%BB%CE%BF%CE%B3%CE%AF%CE%B1/)"
                                            },
                                            {
                                                "example_id": "e76f0e74-398a-4432-9cdf-5461ac1b7bed",
                                                "sense_id": "328ca98a-8f9b-37c8-84c8-6aafbd3b7679",
                                                "text": "※ ένας τρεκάς φίλος μου με κατάφερε να αρχίσω να βλέπω The Next Generation (από μπλογκ, ανακτήθηκε 26/7/2022)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
