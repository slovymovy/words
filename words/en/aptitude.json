{
    "word_family": [
        "apt",
        "aptly",
        "aptness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ae29170-49b7-3f8f-8a2a-b5b7545ce456",
                    "sense_definition": "A natural ability to learn or do something well.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed an early <w>aptitude</w> for mathematics.",
                            "target_lang_translations": {
                                "zh": "她很早就表现出了数学方面的<w>天赋</w>。"
                            }
                        },
                        {
                            "text": "The test measures a student’s <w>aptitude</w> for language learning.",
                            "target_lang_translations": {
                                "zh": "这项测试旨在评估学生在语言学习方面的<w>天赋</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "talent",
                        "knack",
                        "ability",
                        "skill"
                    ],
                    "antonyms": [
                        "ineptitude"
                    ],
                    "common_phrases": [
                        "natural aptitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "学习或做某事的天赋或才能。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天赋",
                                "target_lang_sense_clarification": "指天生的才能或资质。"
                            },
                            {
                                "target_lang_word": "才能",
                                "target_lang_sense_clarification": "指在某方面表现出的能力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9d82a42f-592b-3e9d-868f-d3e7024e5f77",
                    "sense_definition": "The quality of being appropriate or suitable for a specific purpose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee discussed the <w>aptitude</w> of the candidate for the new position.",
                            "target_lang_translations": {
                                "zh": "委员会讨论了候选人对于新职位的<w>适宜性</w>。"
                            }
                        },
                        {
                            "text": "We must consider the <w>aptitude</w> of these materials for outdoor use.",
                            "target_lang_translations": {
                                "zh": "我们必须考虑这些材料用于户外环境的<w>适宜性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriateness",
                        "fitness",
                        "suitability"
                    ],
                    "target_lang_definitions": {
                        "zh": "指某事物适合特定目的的性质或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "适宜性",
                                "target_lang_sense_clarification": "指事物是否适合某种用途或环境。"
                            },
                            {
                                "target_lang_word": "合适性",
                                "target_lang_sense_clarification": "指某人或某物是否胜任或匹配。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}