                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "88826222-53f7-378f-b1d1-43625857cf11",
                        "entry_id": "71c9f743-7509-3885-9a0f-ff950cdc55f1",
                        "glosses": [
                            "с длинными и густыми всклокоченными волосами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7dbe4a5-f10c-46cb-9dde-f1280e06ac6b",
                                "sense_id": "88826222-53f7-378f-b1d1-43625857cf11",
                                "text": "Она, взглянуть назад не смея, // Поспешный ускоряет шаг; // Но от косматого лакея // Не может убежать никак;"
                            }
                        ]
                    },
