                        "entry_id": "55188f4a-f57b-3de0-b24e-4358d43f7ff8",
                        "glosses": [
                            "The scientific study of the symptoms of diseases, as an aspect of clinical medicine, differential diagnosis, public health, and so on."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5a5b6ca-9b84-49ec-840a-f3a3e11bf8bf",
                                "sense_id": "9f6f44d4-d0c6-3b0f-83d2-fc22ad0c2306",
                                "text": "Big Pharma has redefined the symptomatology of medical conditions in such a way as to expand enormously the market for its drugs."
                            }
                        ]
                    },
                    {
                        "sense_id": "98710940-e29a-34fd-86d8-306da0c28d0c",
                        "entry_id": "55188f4a-f57b-3de0-b24e-4358d43f7ff8",
                        "glosses": [
                            "The aggregate of symptoms of a particular disease; the pattern of symptoms, and their timing, that is characteristic of it."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
