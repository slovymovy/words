                        "entry_id": "b1bdf5fd-1fe6-3a1e-8de4-0dc03c91f587",
                        "glosses": [
                            "Courant aérien descendant intense sous un orage, dont l’écrasement en surface produit des vents violents sur une étendue restreinte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d1a36d-a21d-4f26-90b9-8d308a3f5eaa",
                                "sense_id": "475a0dd5-c04e-33a9-9ab0-e79a3b343441",
                                "text": "Environnement Canada a par ailleurs confirmé qu’une microrafale a traversé la région de Saint-Colomban, avec des vents aux alentours de 100 km/h, déracinant notamment des arbres."
                            },
                            {
                                "example_id": "61b39bb9-d574-4ddb-8d82-625625eb51ac",
                                "sense_id": "475a0dd5-c04e-33a9-9ab0-e79a3b343441",
                                "text": "Si plusieurs citoyens de l’endroit croyaient dur comme fer que les dégâts avaient été causés par une microrafale, la Sûreté du Québec parlait plutôt de «fortes intempéries»."
                            }
                        ]
                    }
