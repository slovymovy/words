            {
                "entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                "word": "impedimenta",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ee17ce1-ac35-3f16-b67f-0a528cda6b23",
                        "entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "glosses": [
                            "(Plural): Gepäck, Tross (militärisch)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f4c4b765-504d-370b-83e5-fe9f139b28d1",
                        "entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "glosses": [
                            "Last, hinderliches Gepäck, \\\"Siebensachen\\"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f02f9e6-5519-42e6-8bec-6bb57dc04257",
                        "source_entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "source_sense_id": "6ee17ce1-ac35-3f16-b67f-0a528cda6b23",
                        "source_sense_description": "(Plural): Gepäck, Tross (militärisch)",
                        "target_lang_word": "Gepäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gepäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                        "entry_id": "a94d7ac9-5f9b-3017-8892-a74081cd4e0c",
                                        "glosses": [
                                            "gesamte Ausrüstung für eine Reise, eine Wanderung oder einen Marsch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a826b8b-c7d9-4943-aa31-3f590e681258",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "So viel Gepäck können wir kaum unterbringen."
                                            },
                                            {
                                                "example_id": "f230b8f4-2c78-45e3-afa8-189bcc6f0cc6",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Und dann hat er wieder in seinem Gepäck gekramt und eine Bulette hervorgeholt.“"
                                            },
                                            {
                                                "example_id": "1998aa5c-5a8b-49b3-af08-fe12347d6b40",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Ich sah ihn noch sein Gepäck in den Bahnhof tragen, und dann war er verschwunden.“"
                                            },
                                            {
                                                "example_id": "ae40d676-5b5d-4517-a9cf-8cb403658d31",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Samoura sprach ein paar kurze Abschiedsworte, dann nahmen wir unser Gepäck auf und durchquerten im Laufschritt das Dorf in der Richtung, aus der wir am Tag zuvor gekommen waren.“"
                                            },
                                            {
                                                "example_id": "06fbda1a-5d30-42fd-8780-57f2d58251dd",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Ich war allein, reiste mit leichtem Gepäck und brauchte nur eine billige Hinfahrkarte.\""
                                            },
                                            {
                                                "example_id": "2dcd8d92-f912-436e-8d13-596ec7c33c29",
                                                "sense_id": "f375bbb9-b0f1-3333-a207-c64104bc09d9",
                                                "text": "„Alle Passagiere sammt ihren Gepäcken wurden glücklich ans Ufer gebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87e051bd-a206-4a14-af2e-b58106880bbe",
                        "source_entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "source_sense_id": "6ee17ce1-ac35-3f16-b67f-0a528cda6b23",
                        "source_sense_description": "(Plural): Gepäck, Tross (militärisch)",
                        "target_lang_word": "Tross",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tross",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73f8706d-9ee0-3d18-9e96-668306c91bae",
                                        "entry_id": "02239b3c-b3b8-3d4b-a4c5-5f42e1100dfc",
                                        "glosses": [
                                            "unterstützende Versorgungs- und Transporteinheit für die militärische Truppe"
                                        ],
                                        "tags": [
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ccf637c-c458-4a80-b44c-f4e9e5fc224e",
                                                "sense_id": "73f8706d-9ee0-3d18-9e96-668306c91bae",
                                                "text": "Der Tross war manchmal fast so groß wie die Truppe selbst."
                                            },
                                            {
                                                "example_id": "22cb3b65-b085-45b3-93ec-739d90b07a45",
                                                "sense_id": "73f8706d-9ee0-3d18-9e96-668306c91bae",
                                                "text": "„Mit der Großen Armee zog auch ihr Tross in Wilna ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b37a4329-1244-3492-9e55-73965dab8f02",
                                        "entry_id": "02239b3c-b3b8-3d4b-a4c5-5f42e1100dfc",
                                        "glosses": [
                                            "großes Gefolge an Menschen oder Fahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42cad9e3-2445-4665-9b26-46ea5490e3e9",
                                                "sense_id": "b37a4329-1244-3492-9e55-73965dab8f02",
                                                "text": "Er brachte wieder mal seinen ganzen Tross mit."
                                            },
                                            {
                                                "example_id": "1bd0c916-989d-4433-89bf-a5b3c037e88a",
                                                "sense_id": "b37a4329-1244-3492-9e55-73965dab8f02",
                                                "text": "„Es war fast ein Wunder, dass der kleine Tross den Überfall überlebte.“"
                                            },
                                            {
                                                "example_id": "78bbba0c-b821-4521-b453-b683c0dc70dd",
                                                "sense_id": "b37a4329-1244-3492-9e55-73965dab8f02",
                                                "text": "„Nach dreieinhalb Stunden löst sich der Tross auf, einige gehen nach Hause, die meisten laufen zum Ratskeller, wo der späte Abend ausklingt in den frühen Freitagmorgen.“"
                                            },
                                            {
                                                "example_id": "2dcb3060-079d-48c2-a682-b65d67e00cad",
                                                "sense_id": "b37a4329-1244-3492-9e55-73965dab8f02",
                                                "text": "„Götz überfiel den Tross mit angeheuerten Reitern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7628df57-5a03-46d4-8bf9-11793e19de9b",
                        "source_entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "source_sense_id": "f4c4b765-504d-370b-83e5-fe9f139b28d1",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Last",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Last",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d5412e7-0900-3757-aa5e-7541bb6c7476",
                                        "entry_id": "207e9aae-40c8-330e-8029-f2d601b27ad7",
                                        "glosses": [
                                            "etwas, was sich durch sein Gewicht nach unten drückt oder zieht; auch Ladung, Fracht; was man trägt"
                                        ],
                                        "tags": [
                                            "Transportwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "286a2206-010a-4456-80d1-6b7c93eb9b4a",
                                                "sense_id": "1d5412e7-0900-3757-aa5e-7541bb6c7476",
                                                "text": "Das Paket war eine große Last für die Frau."
                                            },
                                            {
                                                "example_id": "e5115763-b7fe-450b-b176-663bc796dd36",
                                                "sense_id": "1d5412e7-0900-3757-aa5e-7541bb6c7476",
                                                "text": "Sie hatte an der Last schwer zu tragen."
                                            },
                                            {
                                                "example_id": "62e5db99-df66-4d72-b45e-b14f7bcf45f4",
                                                "sense_id": "1d5412e7-0900-3757-aa5e-7541bb6c7476",
                                                "text": "Plötzlich brach die Brücke unter der großen Last zusammen."
                                            },
                                            {
                                                "example_id": "d5262f4b-c6a2-4d40-9f8b-4418dae306b1",
                                                "sense_id": "1d5412e7-0900-3757-aa5e-7541bb6c7476",
                                                "text": "„Die Männer antworteten ihm nicht, luden ihre Last auf und stiegen damit die steile Uferbank empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a1b7717-9003-3afc-8370-f21558374167",
                                        "entry_id": "207e9aae-40c8-330e-8029-f2d601b27ad7",
                                        "glosses": [
                                            "psychischer Druck, beschwerlicher Umstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880f62e9-9fde-4408-9e12-1c9cfcad309a",
                                                "sense_id": "1a1b7717-9003-3afc-8370-f21558374167",
                                                "text": "Das Geständnis hatte Herrn Bleibein von einer großen Last befreit."
                                            },
                                            {
                                                "example_id": "91d63e10-7f9c-4a5a-9050-eb59db596bce",
                                                "sense_id": "1a1b7717-9003-3afc-8370-f21558374167",
                                                "text": "Auf meiner Seele liegt eine erdrückende Last."
                                            },
                                            {
                                                "example_id": "1ddaa34b-6d1f-4a85-a565-fb6c2daf8e9b",
                                                "sense_id": "1a1b7717-9003-3afc-8370-f21558374167",
                                                "text": "Mit der Bürgschaft bürdete sie sich eine schwere Last auf."
                                            },
                                            {
                                                "example_id": "758309ce-4ac9-4a8a-a5a3-ac83c8df9c73",
                                                "sense_id": "1a1b7717-9003-3afc-8370-f21558374167",
                                                "text": "Die Zahlung des Verfahrens geht zu Lasten des Angeklagten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b8112cf6-e7bd-334c-b77d-17f047a22d02",
                                        "entry_id": "207e9aae-40c8-330e-8029-f2d601b27ad7",
                                        "glosses": [
                                            "Kraft, die auf eine sich im Betrieb befindende Maschine wirkt"
                                        ],
                                        "tags": [
                                            "Mechanik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a29870-49f4-474a-9663-c0bf1f529bf6",
                                                "sense_id": "b8112cf6-e7bd-334c-b77d-17f047a22d02",
                                                "text": "Es ist ein Unterschied, ob der Motor unter Last läuft oder sich im Leerlauf dreht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "47a068e0-4946-3ce0-ae38-04c1ca3db9fb",
                                        "entry_id": "207e9aae-40c8-330e-8029-f2d601b27ad7",
                                        "glosses": [
                                            "elektrischer Widerstand, elektrischer Verbraucher"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c30e457-95e8-4663-ba71-71d43db005c0",
                                                "sense_id": "47a068e0-4946-3ce0-ae38-04c1ca3db9fb",
                                                "text": "Der Innenwiderstand des Generators macht sich nur unter Last bemerkbar."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c782c080-1bda-411d-9a17-9d02b3fc0e83",
                        "source_entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "source_sense_id": "f4c4b765-504d-370b-83e5-fe9f139b28d1",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "hinderliches Gepäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "97adc93f-e32b-4ebf-bd87-de416998a4b4",
                        "source_entry_id": "b58a7382-49f4-31bb-9f94-4af62467990e",
                        "source_sense_id": "f4c4b765-504d-370b-83e5-fe9f139b28d1",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Siebensachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Siebensachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "verschiedene Dinge, die man für ein bestimmtes Vorhaben benötigt oder die man gerade bei sich hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c9b0507-9cc0-4d78-ab3a-8e3495a5b75d",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "Wenn jetzt alle ihre Siebensachen zusammengesucht haben, können wir endlich los zum See."
                                            },
                                            {
                                                "example_id": "5f4cc625-babb-47d5-9bf2-bc976ca83e41",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Zu den Stoßzeiten morgens um neun bilden sich Schlangen vor den Einlaßschleusen, wenn Athleten und Journalisten mit ihren Siebensachen eintrudeln.“"
                                            },
                                            {
                                                "example_id": "589791b8-4955-49f4-9ee6-577ac105f5d5",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Danach zogen wir wieder zum Mono Lake, und als wir merkten, daß die Aufregung um den Zement für den Augenblick abgeklungen war, packten wir unsere Siebensachen und kehrten nach Esmeralda zurück.“"
                                            },
                                            {
                                                "example_id": "466beb43-431a-48f0-aab9-d7e3aabd1211",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Sie selbst aber, also die Mama, wolle in der Wohnung bleiben und unsere Siebensachen in Ruhe packen.“"
                                            },
                                            {
                                                "example_id": "c2c379e6-8908-4cb5-ba33-42028eaa4015",
                                                "sense_id": "e706e4a5-4d49-3c6e-9960-8110a6216438",
                                                "text": "„Darum packten sie 1970 ihre Siebensachen und reisten von Antakya/Arsch der Welt nach Frankfurt/Main.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "das Eigentum eines Menschen, dem nur wenige Sachen gehören"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a85ec25-fd07-41aa-a739-17244054d690",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "Wenn jemand wie dein Onkel umzieht, ist das kein großer Aufwand, da seine Siebensachen schnell zusammengepackt sind."
                                            },
                                            {
                                                "example_id": "2357df8b-eee3-46dc-bb3c-8f4bbca87913",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "Du brauchst doch nicht viel Platz. Deine Siebensachen passen ja in einen Schuhkarton."
                                            },
                                            {
                                                "example_id": "036bade9-66d5-42d0-ad78-7eb0387926ce",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "„Am Morgen kamen alle ihre Siebensachen.“"
                                            },
                                            {
                                                "example_id": "f100e64f-fdb8-499d-b7d5-e913f1288693",
                                                "sense_id": "02c32fa5-40c0-3cca-a414-5ae8790f1d2a",
                                                "text": "„Dann mußte sie ihre Siebensachen zusammenpacken und unter mein eigenes Dach ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "61ce2a2b-99f0-3bcf-8a6d-1dc97bbbb5d1",
                                        "entry_id": "d4f19971-ee88-3637-b2dc-488a5d9da9c1",
                                        "glosses": [
                                            "wertlose Dinge"
                                        ],
