        "fr-extract.jsonl": [
            {
                "entry_id": "3ef7a680-0ceb-318a-80fa-00bce4527119",
                "word": "indifféremment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                        "entry_id": "3ef7a680-0ceb-318a-80fa-00bce4527119",
                        "glosses": [
                            "Sans faire de différence, de distinction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4390524c-b40b-48ff-ada8-3c93731f1fcc",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Mais qu’indifféremment elle doit à ce rang Élever le mérite et les rares services."
                            },
                            {
                                "example_id": "8de61cb8-43fc-4cba-a937-7dbc931d7232",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Rendant justice indifféremment à tous ses sujets."
                            },
                            {
                                "example_id": "21618498-b0e9-45c9-9a78-d94176f7e929",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Confondre les personnes et les traiter indifféremment."
                            },
                            {
                                "example_id": "26f79922-afbe-43ea-81de-bb1cfb706844",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Philopémen écoutait volontiers les discours des philosophes, et lisait avec plaisir leurs traités ; non pas tous indifféremment, mais seulement ceux qui pouvaient l’aider à faire du progrès dans la vertu."
                            },
                            {
                                "example_id": "2986b123-11d2-4ffb-80cc-c3bfe7a53534",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Les Turcs appellent indifféremment les chrétiens infidèles et chiens."
                            },
                            {
                                "example_id": "24a8521c-7bf4-43ec-bc24-97a644b43dc9",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Exiler indifféremment, tantôt Arius, tantôt Athanase."
                            },
                            {
                                "example_id": "9926c483-eb83-4442-9c05-70c6fbf067be",
                                "sense_id": "b6b52d2b-6061-3387-bb2b-167c32c841fe",
                                "text": "Il [le phoque] ne craint ni le froid ni le chaud, il vit indifféremment d’herbe, de chair ou de poisson ; il habite également l’eau, la terre et la glace."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3696edb-86ea-3539-be6c-590031f619e5",
                        "entry_id": "3ef7a680-0ceb-318a-80fa-00bce4527119",
                        "glosses": [
                            "Avec indifférence, sans intérêt, avec froideur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600e4ff1-4439-45f7-bb49-447ab783b96a",
                                "sense_id": "e3696edb-86ea-3539-be6c-590031f619e5",
                                "text": "L'homme dissimulé ne parle point indifféremment."
                            },
                            {
                                "example_id": "da63efd0-829a-40b3-b4bd-38a2bdeb68da",
                                "sense_id": "e3696edb-86ea-3539-be6c-590031f619e5",
                                "text": "Ils viennent entendre indifféremment la parole de Dieu."
                            },
                            {
                                "example_id": "b250d2d5-5fa5-4541-8808-c58e1dcc915a",
                                "sense_id": "e3696edb-86ea-3539-be6c-590031f619e5",
                                "text": "Ne vous écrit-elle pas : chantez indifféremment ? c’est-à-dire chantez comme si vous chantiez […] seulement pour chanter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33177a60-461e-4556-b40c-d2679cbd97cc",
                        "source_entry_id": "3ef7a680-0ceb-318a-80fa-00bce4527119",
                        "target_lang_word": "indifferently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
