                ],
                "senses": [
                    {
                        "sense_id": "4c9e9ec9-b61b-300b-bfa3-a30cdf6e03d8",
                        "entry_id": "00ccb4a7-acac-36aa-9e6e-b456acbd9e7d",
                        "glosses": [
                            "het geheel aan wetten die in een land gelden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4c28631-d5a8-403e-81a6-138a524c5ef7",
                                "sense_id": "4c9e9ec9-b61b-300b-bfa3-a30cdf6e03d8",
                                "text": "Met het hennepverbod wil de rechts-conservatieve meerderheid onder leiding van Giorgia Meloni naar eigen zeggen een grijs gebied in de wetgeving wegwerken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52697784-c033-4347-bfea-3d90959e3f9d",
                        "source_entry_id": "00ccb4a7-acac-36aa-9e6e-b456acbd9e7d",
                        "source_sense_id": "4c9e9ec9-b61b-300b-bfa3-a30cdf6e03d8",
                        "source_sense_description": "het geheel aan wetten die in een land gelden",
                        "target_lang_word": "Gesetzgebung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesetzgebung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db5d5fd7-b32f-3289-b16b-44aa169e0353",
                                        "entry_id": "7f6cb75a-a0b1-30a5-a7ec-66a082eaab2d",
                                        "glosses": [
                                            "Erlass von Gesetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a1e009-6e84-475a-bd57-432adb885a1f",
                                                "sense_id": "db5d5fd7-b32f-3289-b16b-44aa169e0353",
                                                "text": "Die Gesetzgebung oblag dem König."
                                            },
                                            {
                                                "example_id": "ab0d688d-8bd1-4bdc-a9a0-5adea06317da",
                                                "sense_id": "db5d5fd7-b32f-3289-b16b-44aa169e0353",
                                                "text": "„Neben ausschließlicher Gesetzgebung durch den Bund oder die Länder, was in Art. 70 GG und in Art. 71 GG geregelt ist, gibt es auch die konkurrierende Gesetzgebung gemäß Art. 72 GG.“"
                                            },
                                            {
                                                "example_id": "3a45c063-dac9-4cfa-921e-7219e0319d15",
                                                "sense_id": "db5d5fd7-b32f-3289-b16b-44aa169e0353",
                                                "text": "„Die [Luxemburger] Gesetzgebung hat […] für große Privatvermögen interessante Steuerkonstruktionen angeboten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "986c95ae-c8bd-313a-bf1a-258fc8285677",
                                        "entry_id": "7f6cb75a-a0b1-30a5-a7ec-66a082eaab2d",
                                        "glosses": [
                                            "Gesamtheit der geltenden Gesetze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edee692e-7fe7-4f3e-8d24-efb772e5dea4",
                                                "sense_id": "986c95ae-c8bd-313a-bf1a-258fc8285677",
                                                "text": "„Danach folgte die Verstaatlichung des Bodens, der Banken, der Industrieunternehmen und der Versorgungsnetze, und die sowjetische Gesetzgebung wurde eingeführt.“"
                                            },
                                            {
                                                "example_id": "5be430ff-2f87-4079-a653-de93345700b9",
                                                "sense_id": "986c95ae-c8bd-313a-bf1a-258fc8285677",
                                                "text": "„Das gab Probleme, denn allein in der Rheinprovinz bestanden drei unterschiedliche Gesetzgebungen für das Postwesen, welche unter sich und mit den Regelungen im übrigen preußischen Staatsgebiet kollidierten.“"
                                            },
                                            {
                                                "example_id": "fe52efd0-b6a6-4d99-b8fa-c47541f4c0a6",
                                                "sense_id": "986c95ae-c8bd-313a-bf1a-258fc8285677",
                                                "text": "„Von der Öffentlichkeit unbemerkt, läuft gerade ein unglaubliches Bubenstück in der EU-Gesetzgebung betreffs europaweiter Dienstzeitregelungen für Piloten ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20d7c59e-ced2-44c1-a617-a31cd7d3b9f7",
                        "source_entry_id": "00ccb4a7-acac-36aa-9e6e-b456acbd9e7d",
                        "source_sense_id": "4c9e9ec9-b61b-300b-bfa3-a30cdf6e03d8",
                        "source_sense_description": "het geheel aan wetten die in een land gelden",
                        "target_lang_word": "legislation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legislation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b183c9-ac39-3201-9d18-ea829f34f720",
                                        "entry_id": "f448170d-97c5-3b60-bb5b-49e77e9b2233",
                                        "glosses": [
                                            "The act of legislating; preparation and enactment of laws."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3271ebf-0371-4405-8d32-02acb7e14bd2",
                                                "sense_id": "e6b183c9-ac39-3201-9d18-ea829f34f720",
                                                "text": "pass legislation"
                                            },
                                            {
                                                "example_id": "6ffc9f74-1000-4a9c-abea-231416db8725",
                                                "sense_id": "e6b183c9-ac39-3201-9d18-ea829f34f720",
                                                "text": "There is a lack of legislation about human cloning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7966f5fc-ca1d-304a-a561-ad834c2692ff",
                                        "entry_id": "f448170d-97c5-3b60-bb5b-49e77e9b2233",
                                        "glosses": [
                                            "A law which has been enacted by legislature or other governing body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80edb50-32c6-4ce6-af71-ac0698ae29aa",
                                                "sense_id": "7966f5fc-ca1d-304a-a561-ad834c2692ff",
                                                "text": "The general rule is that constitutional provisions are self-executing, except when the provisions themselves expressly require legislations to implement them […]"
                                            },
                                            {
                                                "example_id": "4bb8fadd-f755-40ad-a544-4553f4e63a49",
                                                "sense_id": "7966f5fc-ca1d-304a-a561-ad834c2692ff",
                                                "text": "Gov. Gavin Newsom signed legislation on Sunday banning the sale at grocery checkouts of all plastic bags, regardless of thickness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01ac0e12-4595-4fc4-ae06-db5d3c83260f",
                        "source_entry_id": "00ccb4a7-acac-36aa-9e6e-b456acbd9e7d",
                        "source_sense_id": "4c9e9ec9-b61b-300b-bfa3-a30cdf6e03d8",
                        "source_sense_description": "het geheel aan wetten die in een land gelden",
                        "target_lang_word": "législation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "législation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "635964bc-4ce7-3dec-b06a-2c9f427cc3cd",
                                        "entry_id": "8538bc90-51c0-39ae-920e-4b63f6a09d4b",
                                        "glosses": [
                                            "Droit de faire les lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60343b1-b99e-49d9-847a-085c4ecdbaf2",
                                                "sense_id": "635964bc-4ce7-3dec-b06a-2c9f427cc3cd",
                                                "text": "Dans les gouvernements constitutionnels, la législation n’appartient qu’au Parlement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                        "entry_id": "8538bc90-51c0-39ae-920e-4b63f6a09d4b",
                                        "glosses": [
                                            "Corps même de ces lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7522d68-9297-4cd1-bbd4-e0009ffa7d35",
                                                "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                                "text": "C'est à l'idéologie, à cette ténébreuse métaphysique qui, en recherchant avec subtilité les causes premières , veut sur ses bases fonder la législation des peuples, au lieu d'approprier les lois à la connaissance du cœur humain et aux leçons de l'histoire, qu'il faut attribuer tous les malheurs qu'a éprouvés notre belle France."
                                            },
                                            {
                                                "example_id": "7dbb484c-9da4-40fd-afb8-4f4ad8aaf5fc",
                                                "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                                "text": "[…], la charte de 1814 avait incorporé définitivement à la tradition nationale le système parlementaire, la législation napoléonienne et l’Église concordataire ; […]."
                                            },
                                            {
                                                "example_id": "9198f957-a6c2-4fdd-bc9c-abc01200a069",
                                                "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                                "text": "En Franche-Comté, les réfugiés trouvèrent une législation à peu près aussi tracassière que celle qu'ils avaient connu en France."
                                            },
                                            {
                                                "example_id": "fd893af4-3d93-42aa-9d03-a4e5f9a9c1d7",
                                                "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                                "text": "Mais cette Novelle marque une régression dans la voie de la répression de l’eunuchat. Estimant l'ancienne législation trop draconienne, Léon VI abolissait la peine du talion contre les opérateurs et adoucissait les autres pénalités."
                                            },
                                            {
                                                "example_id": "fee4f6ee-6456-4a7c-9e36-5b4c2e3f86d0",
                                                "sense_id": "92fd93c7-630d-3b9a-8549-3bf8db0430e6",
                                                "text": "En dépit du morcellement législatif des coutumes, nous avons une unité remarquable de législation en cette matière, car c'est l’Église qui seule légifère et juge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3395930-8623-3bf1-b32f-8478ce1144d1",
                                        "entry_id": "8538bc90-51c0-39ae-920e-4b63f6a09d4b",
                                        "glosses": [
                                            "Science, de la connaissance des lois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682529b6-11da-4ddf-9f9e-36db3bd1cd4b",
                                                "sense_id": "c3395930-8623-3bf1-b32f-8478ce1144d1",
                                                "text": "Un cours de législation."
                                            },
                                            {
                                                "example_id": "86e12db5-d822-4c5e-8c8d-5c74d7c093d4",
                                                "sense_id": "c3395930-8623-3bf1-b32f-8478ce1144d1",
                                                "text": "Législation comparée, étude des lois des différents pays comparées entre elles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
