{
    "word_family": [
        "couvée",
        "couveuse",
        "couvoir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43b561bc-83d2-38bb-ab30-e805cb2f52e5",
                    "sense_definition": "Couvrir des œufs de son corps pour entretenir la chaleur qui les fera éclore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La poule <w>couve</w> patiemment ses œufs au fond du poulailler."
                        },
                        {
                            "text": "Au printemps, plusieurs oiseaux <w>couvent</w> pour donner naissance à leurs petits."
                        }
                    ],
                    "common_phrases": [
                        "couver des œufs"
                    ]
                },
                {
                    "sense_id": "3739d2dc-07b6-3798-bd90-7d1068ba27db",
                    "sense_definition": "Entourer quelqu'un d'une attention affectueuse et constante, parfois excessive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soin_affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a tendance à trop <w>couver</w> ses enfants dès le moindre rhume."
                        },
                        {
                            "text": "Les parents attendris <w>couvaient</w> leur nouveau-né du regard pendant son sommeil."
                        }
                    ],
                    "synonyms": [
                        "cajoler",
                        "chouchouter",
                        "choyer",
                        "dorloter",
                        "gâter",
                        "pouponner"
                    ],
                    "common_phrases": [
                        "couver du regard",
                        "couver des yeux"
                    ]
                },
                {
                    "sense_id": "245be31f-1789-3fad-907e-930419171f26",
                    "sense_definition": "Porter en soi les premiers signes silencieux d'une maladie, ou préparer secrètement un projet nuisible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "latence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se sent très fatigué aujourd'hui et je crois qu'il <w>couve</w> une mauvaise grippe."
                        },
                        {
                            "text": "Le traître <w>couvait</w> un projet dangereux depuis plusieurs mois sans éveiller les soupçons."
                        }
                    ],
                    "common_phrases": [
                        "couver une maladie",
                        "couver une grippe"
                    ]
                },
                {
                    "sense_id": "a7427aa7-1fd8-3158-ac50-0c57cd71bb24",
                    "sense_definition": "En parlant d'un conflit, d'un feu ou d'un sentiment, se développer de façon cachée et menacer d'éclater.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "latence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une profonde rancœur <w>couvait</w> entre les deux familles depuis des décennies."
                        },
                        {
                            "text": "Malgré le calme apparent, une grave crise sociale <w>couve</w> dans tout le pays."
                        }
                    ],
                    "common_phrases": [
                        "feu qui couve",
                        "colère qui couve"
                    ]
                }
            ]
        }
    ]
}