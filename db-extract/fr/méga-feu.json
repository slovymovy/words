                        "entry_id": "56024cfd-80fb-3cfe-88fc-5523c4f1beb8",
                        "glosses": [
                            "Incendie qui ravage une très grande surface, typiquement plus de 1 000 ou 10 000 hectares."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d2a9c10-e12e-40fb-b91e-57d88e6c2444",
                                "sense_id": "a6645e52-0017-3a48-9f7a-79cda690f0a8",
                                "text": "Les arbres morts font du petit bois idéal pour un méga-feu."
                            },
                            {
                                "example_id": "fb6048c6-99c5-4c81-b48c-937a29580ccf",
                                "sense_id": "a6645e52-0017-3a48-9f7a-79cda690f0a8",
                                "text": "Les pompiers australiens sont parvenus à contrôler le plus important \"méga-feu\" du pays."
                            },
                            {
                                "example_id": "082c6b81-3797-4d7e-a7e8-193f770d0aa4",
                                "sense_id": "a6645e52-0017-3a48-9f7a-79cda690f0a8",
                                "text": "Ce méga-feu qui se trouvait au nord de Sydney a réussi à dévorer une superficie représentant plus de trois fois le Grand Londres."
                            }
                        ]
                    }
                ],
                "translations": [
