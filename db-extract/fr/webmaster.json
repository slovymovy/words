                        "glosses": [
                            "Créatrice, créateur ou responsable de site web."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "98307ecd-fff8-4c0f-b715-6b34c5aa6fc9",
                                "sense_id": "b348c502-eecf-35cd-8d26-b194d3815606",
                                "text": "La preuve avec ces trois webmasters. Pendant trois ans pour l’un, cinq ans pour l’autre et sept ans pour le dernier, ils se démènent pour animer un site Internet du groupe Dépêche dédié au rugby (rugby­rama.fr)."
                            }
                        ]
                    }
                ],
