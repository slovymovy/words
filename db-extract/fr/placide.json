                        "entry_id": "500e05db-a79e-309a-ac12-49c970de5d71",
                        "glosses": [
                            "Qui est doux, paisible, calme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b81411-1ead-419d-b0d0-58098db89148",
                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                "text": "Jamais la droite ne se mouvait sans que l’œil droit examinât les circonstances extérieures avec cette rapidité placide particulière au voleur et à l’espion."
                            },
                            {
                                "example_id": "8fc97b1d-d927-4d2d-a1ee-d1c86e03ac73",
                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                "text": "Tu vois comme c’est placide, une vache… Il n’y a pas de danger…"
                            },
                            {
                                "example_id": "7a0e8c42-dfc0-46d3-9a86-c426b66b093e",
                                "sense_id": "bf9fd883-b08d-3629-a29d-33c993584d7f",
                                "text": "Un caractère, une humeur placide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
