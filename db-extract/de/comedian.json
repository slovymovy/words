                "senses": [
                    {
                        "sense_id": "889363db-dbf5-3618-8162-0d9cd3888659",
                        "entry_id": "f183abc9-9682-3964-a40b-cab60b396b02",
                        "glosses": [
                            "Kleinkünstlerin, die humoristische Darbietungen präsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf93202-d817-44b2-ad2b-fbbffebc9a1c",
                                "sense_id": "889363db-dbf5-3618-8162-0d9cd3888659",
