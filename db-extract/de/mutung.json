                            "Bergmannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "9030ed49-8cd0-4987-a368-94464d5d0fb3",
                                "sense_id": "4e93bc65-29ce-3210-b7eb-426b94796535",
                                "text": "„Am Sonntag, dem 24. Mai 2009, haben Hans-Jörg Neidlinger-Czerwionke und Marc Rosenkranz versucht, die aufgeführten Mutungen aus dem „Lexikon über Mutungen und Verleihungen von Grubenfeldern im Kreis Altenkirchen/WW“1 anhand der Karte „Verlauf der geplanten Bahn Daaden-Fehl-Ritzhausen“2 zu bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
