                ],
                "senses": [
                    {
                        "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                        "entry_id": "3d69a244-de8b-34e8-bcac-ded6d207aedc",
                        "glosses": [
                            "Zustand, dass man in Trance versetzt ist, sich in Trance befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b6f1a6-2739-4aca-8959-2bd1a1dbb4b8",
                                "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                                "text": "„Dieser Trancezustand wurde schließlich von einem Aufruhr durchbrochen, der aus einem noch höheren Geschoss herunterdrang - aus der Krone des Turms und der Schädelkammer der vieläugigen Bestie dieses Hauses.“"
                            },
                            {
                                "example_id": "e5224340-ad81-4ac3-889b-d764fbb154f0",
                                "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                                "text": "„H’anna klammerte sich an John und fing nun doch an seiner Brust zu schluchzen an, als sei sie zu guter Letzt aus einem langwierigen Trancezustand von betäubender Unwirklichkeit wachgerüttelt worden.“"
                            },
                            {
                                "example_id": "3b6b5ecf-5e06-437a-9601-f8b981dc276f",
                                "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                                "text": "„Mein Beitrag zur Show ist es, die Menge in Ekstase zu bringen. »In einen naturalistischen Trancezustand«, sagt der Agent.“"
                            },
                            {
                                "example_id": "a53d40a6-25a5-4513-adcd-2037005021b9",
                                "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                                "text": "„Copelands Unterlagen weisen immer wieder darauf hin, dass der Kult überlebte, da die dämonische Dreieinigkeit und ihr Erzeuger beim Untergang von Mu nicht vernichtet worden waren, ja, auf Grund ihrer Natur überhaupt nicht getötet werden konnten, und statt dessen in jenem Trancezustand ewig weiterlebten, der ihnen von ihren Gegnern, den Älteren Göttern, auferlegt worden war.“"
                            },
                            {
                                "example_id": "94d6f92e-c42b-42dd-8bbf-fbf691f63e07",
                                "sense_id": "bf8475d7-ea3e-3a0f-b88c-08fdc4455c3a",
                                "text": "„Na klar werden immer noch Crash-Partys veranstaltet. Um in diesen Trancezustand zu geraten, bei dem man die besten Ideen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
