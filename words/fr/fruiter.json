            "senses": [
                {
                    "sense_id": "17fdc491-8d3b-3993-bba4-66a0b530011d",
                    "sense_definition": "Donner ou porter des fruits ; fructifier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs années de sécheresse, ces vieux poiriers ne <w>fruitent</w> presque plus."
                        },
                        {
                            "text": "Le jardinier espère que ses jeunes arbustes vont enfin <w>fruiter</w> cet automne."
                        }
                    ],
                    "synonyms": [
                        "fructifier"
                    ]
                },
                {
                    "sense_id": "775df1f3-c0da-3f41-994f-f123968e2d94",
                    "sense_definition": "Donner un goût ou une saveur de fruit à une préparation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce zeste de citron va subtilement <w>fruiter</w> votre sauce pour le poisson."
                        },
                        {
                            "text": "Quelques mûres sauvages ont suffi pour <w>fruiter</w> délicatement cette crème dessert."
                        }
                    ]
                },
                {
                    "sense_id": "9621ada2-6ff0-3f36-b353-be46fa5f1f9d",
                    "sense_definition": "Commettre une erreur ou une maladresse ; faire une bêtise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "erreur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je crois que j'ai bien <w>fruité</w> en révélant la surprise à mon frère."
                        },
                        {
                            "text": "Fais attention à tes réponses pendant l'entretien pour ne pas <w>fruiter</w> bêtement."
                        }
                    ],
                    "synonyms": [
                        "gaffer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre très familier ou argotique"
                        }
                    ]
                },
                {
                    "sense_id": "c5bd03f0-5376-3b56-a71e-bfab9db7903e",
                    "sense_definition": "Passer son temps à ne rien faire, glander ou paresser.",
