{
    "word_family": [
        "lekkerbekken",
        "lekker",
        "bek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a5488c2-1f37-3af1-b836-54f8a155e7e4",
                    "sense_definition": "Een gefrituurde visfilet, meestal van kabeljauw, wijting of heek, die vaak bij de visboer wordt gekocht.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visgerecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zullen we vanavond een lekkere <w>lekkerbek</w> halen bij de viskraam op de markt?",
                            "target_lang_translations": {
                                "en": "Shall we get a tasty <w>fried fish fillet</w> at the fish stall on the market tonight?"
                            }
                        },
                        {
                            "text": "Hij bestelde een <w>lekkerbekje</w> met friet en een flinke schep ravigotesaus.",
                            "target_lang_translations": {
                                "en": "He ordered a <w>battered fish</w> with fries and a generous dollop of ravigote sauce."
                            }
                        }
                    ],
                    "synonyms": [
                        "lekkerbekje"
                    ],
                    "common_phrases": [
                        "lekkerbekje met ravigotesaus",
                        "visboer een lekkerbek"
                    ],
                    "target_lang_definitions": {
                        "en": "A deep-fried fish fillet, usually cod, whiting, or hake, often bought at a fishmonger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fried fish fillet",
                                "target_lang_sense_clarification": "deep-fried battered fish"
                            },
                            {
                                "target_lang_word": "battered fish",
                                "target_lang_sense_clarification": "fish coated in batter and fried"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62f5e2a-7cfe-3ef6-9d3c-843be8b00619",
                    "sense_definition": "Iemand die erg houdt van lekker eten en drinken; een fijnproever.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als echte <w>lekkerbek</w> gaat zij elk weekend op zoek naar nieuwe restaurants in de stad.",
                            "target_lang_translations": {
                                "en": "As a true <w>foodie</w>, she goes looking for new restaurants in the city every weekend."
                            }
                        },
                        {
                            "text": "Mijn vader is een echte <w>lekkerbek</w> die uren in de keuken kan staan om iets bijzonders te maken.",
                            "target_lang_translations": {
                                "en": "My father is a real <w>gourmet</w> who can spend hours in the kitchen to make something special."
                            }
                        }
                    ],
                    "synonyms": [
                        "fijnproever",
                        "gourmand",
                        "smulpaap"
                    ],
                    "common_phrases": [
                        "een echte lekkerbek"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who loves good food and drink; a gourmet or foodie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gourmet",
                                "target_lang_sense_clarification": "connoisseur of good food"
                            },
                            {
                                "target_lang_word": "foodie",
                                "target_lang_sense_clarification": "informal term for a person loving food"
                            },
                            {
                                "target_lang_word": "epicure",
                                "target_lang_sense_clarification": "person who takes particular pleasure in fine food"
                            }
                        ]
                    }
                }
            ]
        },
        {
