                                "target_senses": [
                                    {
                                        "sense_id": "e5adc514-e265-3a12-88ca-b4f06b62eaee",
                                        "entry_id": "ce678d49-a89c-3493-95b9-94bc420b45eb",
                                        "glosses": [
                                            "Not singable; impossible to sing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15c3afa-e93c-4d70-a7cb-d123828bfff9",
                                                "sense_id": "e5adc514-e265-3a12-88ca-b4f06b62eaee",
                                                "text": "Whether it is that people don't know the tunes, or that these tunes are virtually unsingable, I don't know. The question is: did our fathers sing them with any enthusiasm?"
                                            }
                                        ]
                                    }
                                ]
                            }
