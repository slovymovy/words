                    {
                        "translation_id": "d1336a23-e4aa-4914-bcb9-4aa2e4b1b010",
                        "source_entry_id": "cc364a1f-454b-30a7-9e3e-75aa4237c0c7",
                        "source_sense_id": "ef425617-8205-3129-8a89-d97df032a274",
                        "target_lang_word": "mournfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mournfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                        "entry_id": "9778fa71-0e12-3cfe-9e26-be4f45121163",
                                        "glosses": [
                                            "In a mournful manner; as if in mourning for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187e7d9c-b6c5-4cad-bca2-bfdbbe1ff278",
                                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                                "text": "1836, Hans Christian Andersen (translated into English by Mrs. H. B. Paull in 1872), The Little Mermaid\n\"Why have not we an immortal soul?\" asked the little mermaid mournfully; \"I would give gladly all the hundreds of years that I have to live, to be a human being only for one day, and to have the hope of knowing the happiness of that glorious world above the stars.\""
                                            },
                                            {
                                                "example_id": "13303ef9-e055-41b9-988e-d339e6006f90",
                                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                                "text": "The steamer itself had vanished, but the great scroll of smoke still hung in the air and drooped like a flag mournfully in valediction."
                                            },
                                            {
                                                "example_id": "18bd6c3c-ed4f-4373-9a08-82ff0c52fc3e",
                                                "sense_id": "8d5eb7f3-c679-3816-a8d1-ac3c298b9821",
                                                "text": "So she dared not tell anyone how she felt, but went about mournfully, with a heavy heart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "495eaee2-f0d3-4494-b205-bc41ee7b8ae1",
                        "source_entry_id": "cc364a1f-454b-30a7-9e3e-75aa4237c0c7",
                        "source_sense_id": "ef425617-8205-3129-8a89-d97df032a274",
                        "target_lang_word": "miserably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                        "entry_id": "eee3e5b1-0d1f-3dd8-ad3e-5eab4ea76327",
                                        "glosses": [
                                            "In a miserable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c0a4d5-5731-4cd9-8027-52e2498a36b7",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "I just need you miserably\nBroken man come to me\nI just need you desperately\nJust want to change your mind"
                                            },
                                            {
                                                "example_id": "b49379d3-59a2-4fef-8a75-8aa08a6a245c",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "fail miserably"
                                            },
                                            {
                                                "example_id": "7f798d89-2367-4db0-8866-08eac1c92f85",
                                                "sense_id": "066aed88-4d31-39ac-9066-eeb1297ae54b",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e53d5f5b-da58-4b48-b683-c6fad344c34a",
                        "source_entry_id": "cc364a1f-454b-30a7-9e3e-75aa4237c0c7",
                        "source_sense_id": "ef425617-8205-3129-8a89-d97df032a274",
                        "target_lang_word": "piteously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piteously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                        "entry_id": "1e16bc43-0cd8-3a95-9ebc-645f85798cec",
                                        "glosses": [
                                            "In a piteous manner; pathetically; plaintively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57556413-9a8f-419a-b392-2638bdd96dfd",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "He had been quite familiar with one old ghost, in a white waistcoat, with a monstrous iron safe attached to its ankle, who cried piteously at being unable to assist a wretched woman with an infant, whom it saw below, upon a door-step."
                                            },
                                            {
                                                "example_id": "ff8c839f-05c6-4c5e-b80c-75a0bfe0608a",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Across her mind, and bowing over him,\nLow to her own heart piteously she said:"
                                            },
                                            {
                                                "example_id": "55859dc0-7584-41d8-a231-4f4f4f00793b",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Little Sea and Desire would wail piteously over my body for a day, and then I should be quickly forgotten."
                                            },
                                            {
                                                "example_id": "e581c89c-926e-4ccb-9d89-8ea56a8ac95e",
                                                "sense_id": "f44314e1-6c0f-3dcd-8a56-3d7a34d9158e",
                                                "text": "Adam himself bewildered and Eveless outside the garden; a Minotaur howling piteously in a labyrinth of money-worries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d07f0077-1d7d-4494-b6ce-87298e96a400",
                        "source_entry_id": "cc364a1f-454b-30a7-9e3e-75aa4237c0c7",
                        "source_sense_id": "ef425617-8205-3129-8a89-d97df032a274",
                        "target_lang_word": "misérablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misérablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                        "entry_id": "4cd6c281-1712-384a-8513-8c4173b733c2",
                                        "glosses": [
                                            "D’une manière misérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ac43aaa-1a80-49ee-9b3c-1efd340196a8",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Est-ce que vous me laisserez périr aussi misérablement ?"
                                            },
                                            {
                                                "example_id": "2c7712e5-c0e2-4179-aa8a-19a80696b8cd",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "C'est là aussi que végètent misérablement les bédouines qui ont voulu suivre leurs maris prisonniers."
                                            },
                                            {
                                                "example_id": "fb35b81f-f008-47e6-a298-72b8052290ec",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Pour cette cassolette [cadeau du cardinal de Retz], dispensez-moi, ma bonne, de retourner misérablement là-dessus."
                                            },
                                            {
                                                "example_id": "5a27ffc7-2d3c-4938-9f62-bbf9bf90095d",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "La vie de l’homme est misérablement courte."
                                            },
                                            {
                                                "example_id": "f6087394-5a7d-4972-987a-8735e35035d2",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Ils périrent tous deux misérablement."
                                            },
                                            {
                                                "example_id": "693931f7-6b12-4f32-bd39-874234bb8fb5",
                                                "sense_id": "fd3ac9ed-9c3d-35b0-9778-aa0140b5fc72",
                                                "text": "Beaucoup de juifs chassés d’Espagne par Ferdinand et Isabelle se sont réfugiés à Tétuan, à Méquinez, à Maroc, et y vivent misérablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "152055f3-ad55-4dac-86cb-2d34f732d0c7",
                        "source_entry_id": "cc364a1f-454b-30a7-9e3e-75aa4237c0c7",
                        "source_sense_id": "ef425617-8205-3129-8a89-d97df032a274",
                        "target_lang_word": "lamentablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamentablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d71a2447-0d7d-3eec-bb2b-cdde2435e6b1",
                                        "entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                                        "glosses": [
                                            "D’un ton lamentable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76e55c4-06a0-43d4-9c22-4f75323fba90",
                                                "sense_id": "d71a2447-0d7d-3eec-bb2b-cdde2435e6b1",
                                                "text": "Un petit terrier écossais soufflait lamentablement, la langue dehors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                                        "entry_id": "a5fbd116-543a-3d94-9d96-0a5895b6b037",
                                        "glosses": [
                                            "De façon à se lamenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01cb0e95-e1f5-4980-8a6c-40836f864f97",
                                                "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                                                "text": "Et il s'était trouvé seul, lamentablement, dans l'angoisse de ce pays qui, maintenant, l'effrayait."
                                            },
                                            {
                                                "example_id": "7fc032ef-ad16-4a38-946e-a99559d7129c",
                                                "sense_id": "2465b901-f9ee-33ea-b094-87a57bc789d9",
                                                "text": "Parfois y oscillait un squelette blanchi, et le vent, secouant lamentablement les os desséchés, chassait la sombre nuée de corbeaux venue pour les festins lugubres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
