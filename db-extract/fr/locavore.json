                "senses": [
                    {
                        "sense_id": "b5fdf2c2-1a81-3588-aeb4-18dac2dbcea4",
                        "entry_id": "f08b9bdf-2db2-3e97-b21f-6c1370678bcb",
                        "glosses": [
                            "Personne qui se nourrit d’aliments produits près de chez elle."
                        ],
                        "tags": [
                            "Nutrition"
                        ],
                        "examples": [
                            {
                                "example_id": "3a1d9bbd-1a35-43a6-aa59-a711c3eaf27a",
                                "sense_id": "b5fdf2c2-1a81-3588-aeb4-18dac2dbcea4",
                                "text": "Après l’herbivore, le carnivore et l’omnivore, voici le locavore. L’idée principale est de « manger local »."
                            },
                            {
                                "example_id": "b40969b8-dad7-45c0-adeb-602c9e0a6fc7",
                                "sense_id": "b5fdf2c2-1a81-3588-aeb4-18dac2dbcea4",
                                "text": "Ni rescapés du babacoolisme ni Mohicans du retour à la terre, ils ont réussi à écrire leur propre histoire, ancrée dans la biodiversité, le locavore et la mondialisation quand, par exemple, Anne Larive a soutenu la création d’un atelier de fabrication de glaces au Togo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1758e85-288b-4dd7-82bc-acada075e6c3",
                        "source_entry_id": "f08b9bdf-2db2-3e97-b21f-6c1370678bcb",
                        "source_sense_id": "b5fdf2c2-1a81-3588-aeb4-18dac2dbcea4",
                        "target_lang_word": "locavore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locavore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6debc567-98b9-3d8b-926c-eed09fb79c2a",
                                        "entry_id": "3fa15339-df27-36de-9421-c63ff80b2e78",
                                        "glosses": [
                                            "One who tries to eat only locally grown foods."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be11330-513c-49a8-b371-8d5414134454",
                                                "sense_id": "6debc567-98b9-3d8b-926c-eed09fb79c2a",
                                                "text": "So I do think that there is a wonderful opportunity for us to find a carbon-neutral energy source where it is not only a beneficial model environmentally but we are sort of becoming forest and energy locavores, if you will, and so that is what we are trying to establish through this idea of a community wood energy program where we would be using, you know, town forests to actually supply town energy needs so that people can actually see the costs and the impacts of where their energy is coming from."
                                            },
                                            {
                                                "example_id": "e65e95af-f602-4a06-baa4-a87e001baad6",
                                                "sense_id": "6debc567-98b9-3d8b-926c-eed09fb79c2a",
                                                "text": "They are a locavore’s (someone who eats food produced within 100 miles of he lives) paradise."
                                            },
                                            {
                                                "example_id": "8abbd8e8-13d9-4b3d-9176-b26d6326ffa2",
                                                "sense_id": "6debc567-98b9-3d8b-926c-eed09fb79c2a",
                                                "text": "Become a Locavore\nTry to eat foods grown close to your home, which helps to reduce greenhouse gas emissions from transport as well as supporting your neighbors. […]"
                                            },
                                            {
                                                "example_id": "352cb21b-545c-41cd-9399-1ce2731e16e3",
                                                "sense_id": "6debc567-98b9-3d8b-926c-eed09fb79c2a",
                                                "text": "Its mottled green skin conceals a creamy yellow pulp that tastes of banana and mango; locavore-minded chefs alchemize it into ice cream, beer, bread and tasting-menu fodder — that is, when it’s not simply eaten raw with a spoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
