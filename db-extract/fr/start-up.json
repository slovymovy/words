                                "target_word": "startup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "197f1e9c-b3d3-3560-a910-96c2ae088768",
                                        "entry_id": "72d3aabe-3c50-3da2-acb1-1a3bcff77ddb",
                                        "glosses": [
                                            "The act or process of starting a process or machine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cf647d3-fdf1-3f2c-990e-0a066f0006d3",
                                        "entry_id": "72d3aabe-3c50-3da2-acb1-1a3bcff77ddb",
                                        "glosses": [
                                            "A new company or organization or business venture designed for rapid growth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f7b8aef-2243-4a99-90fd-4560e7970a82",
                                                "sense_id": "8cf647d3-fdf1-3f2c-990e-0a066f0006d3",
                                                "text": "Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97eb0878-b818-3e66-9c7c-2a47affbb866",
                                        "entry_id": "72d3aabe-3c50-3da2-acb1-1a3bcff77ddb",
                                        "glosses": [
                                            "A folder (especially in Windows), containing shortcuts of applications or programs that start up automatically after a user signs in."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c0762e3-7b3a-4d4d-a771-496c4443a088",
                                                "sense_id": "97eb0878-b818-3e66-9c7c-2a47affbb866",
                                                "text": "Add an app to run automatically at startup in Windows 10, Microsoft Support\n3. With the file location open, press the Windows logo key + R, type shell:startup, then select OK. This opens the Startup folder. / 4. Copy and paste the shortcut to the app from the file location to the Startup folder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "startup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "411ba924-b080-3a69-a476-c40b6e78aaae",
                                        "entry_id": "38c6135b-b4b6-3984-813e-671319837ad8",
                                        "glosses": [
                                            "A kind of high-low or thigh-high boot worn by rustic people."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b74028-46cb-4500-8725-051589b99361",
                                                "sense_id": "411ba924-b080-3a69-a476-c40b6e78aaae",
                                                "text": "1579, Edmund Spenser, The Shepheardes Calender, London: Hugh Singleton, “Februarie,” Glosse,\nGalage) a startuppe or clownish shoe."
                                            },
                                            {
                                                "example_id": "b956ff0d-431f-4637-8bf6-57ed028da8c0",
                                                "sense_id": "411ba924-b080-3a69-a476-c40b6e78aaae",
                                                "text": "But Hob and Iohn of the countrey they stept in churlishly, in their high startvps […]"
                                            },
                                            {
                                                "example_id": "44518021-8798-4400-9284-9591162a4590",
                                                "sense_id": "411ba924-b080-3a69-a476-c40b6e78aaae",
                                                "text": "1619, Michael Drayton, “The Ninth Eglogue” in Pastorals. Contayning Eglogves, With the Man in the Moone, London: John Smethwicke, reproduced in J. William Hebel (ed.), The Works of Michael Drayton, Oxford: Basil Blackwell, 1932, p. 564,\nWhen not a Shepheard any thing that could,\nBut greaz’d his start-ups blacke as Autumns Sloe,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418fc7f2-93ab-389e-9daa-03c1d7fa1ec5",
                                        "entry_id": "38c6135b-b4b6-3984-813e-671319837ad8",
                                        "glosses": [
                                            "A kind of gaiter or legging."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52070a0c-f374-3f9c-9906-295ee264459d",
                                        "entry_id": "38c6135b-b4b6-3984-813e-671319837ad8",
                                        "glosses": [
                                            "One who comes suddenly into notice; an upstart."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab37d0f1-92de-46ae-bfdb-0dfe597389a2",
                                                "sense_id": "52070a0c-f374-3f9c-9906-295ee264459d",
                                                "text": "That young start-up hath all the glory of my overthrow: if I can cross him any way, I bless myself every way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
