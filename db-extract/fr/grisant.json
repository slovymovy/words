                        "entry_id": "7ac8015a-cc55-3379-84a0-2fa5b335f815",
                        "glosses": [
                            "Qui enivre, qui excite jusqu’à l’étourdissement"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0ef0b127-214c-3e73-8481-5e7ba6de1395",
                        "entry_id": "7ac8015a-cc55-3379-84a0-2fa5b335f815",
                        "glosses": [
                            "Qui provoque un plaisir intellectuel."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b6a8e3fd-e8c0-47a8-8eff-cb1b1afd57c9",
                                "sense_id": "0ef0b127-214c-3e73-8481-5e7ba6de1395",
                                "text": "La conscience de représenter le centre du monde pour un être jeune et ouvert était grisante."
                            },
                            {
                                "example_id": "79cc61b4-bdf9-43e0-9327-45441350ae89",
                                "sense_id": "0ef0b127-214c-3e73-8481-5e7ba6de1395",
                                "text": "Anthony pouvait sentir ce grisant vertige d'avant les conneries. C'était pareil quand il piquait au Prisu ou commettait des imprudences à moto."
                            }
                        ]
                    }
                ],
