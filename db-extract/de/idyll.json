                "senses": [
                    {
                        "sense_id": "5e6c64d2-6692-3ff2-98fb-408143132f9f",
                        "entry_id": "6a9ef4d6-f259-365a-845a-36a69737095a",
                        "glosses": [
                            "Zustand einfachen, friedlichen Lebens"
