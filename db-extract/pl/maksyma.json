                "translations": [
                    {
                        "translation_id": "45247822-ed77-4180-bb4f-f0c5d94a29b2",
                        "source_entry_id": "d59ed7c0-6913-3266-bd32-643bb143fb3a",
                        "source_sense_id": "77b65793-e2ef-3510-96ad-cebd0d7ba70c",
                        "target_lang_word": "maxim",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maxim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e373be2-8902-30a4-b6c6-a75fddb96caf",
                                        "entry_id": "47003177-f84c-3e2b-a6a5-96b9d7037665",
                                        "glosses": [
                                            "A self-evident axiom or premise; a pithy expression of a general principle or rule."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d81f9307-2644-3741-9f91-8986a811f2ba",
                                        "entry_id": "47003177-f84c-3e2b-a6a5-96b9d7037665",
                                        "glosses": [
                                            "A precept; a succinct statement or observation of a rule of conduct or moral teaching."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d66f0e9f-4198-4e02-a3bc-19803e87b261",
                                                "sense_id": "d81f9307-2644-3741-9f91-8986a811f2ba",
                                                "text": "In every age and country of the world men must have attended to the characters, designs, and actions of one another, and many reputable rules and maxims for the conduct of human life, must have been laid down and approved of by common consent."
                                            },
                                            {
                                                "example_id": "8f8412d5-8e1f-410b-a6fc-ec749b56ae70",
                                                "sense_id": "d81f9307-2644-3741-9f91-8986a811f2ba",
                                                "text": "It was impossible to imagine anything more cold or comfortless, while it was a task of no small dexterity to thread your way through the labyrinth of trunks, bandboxes, &c.; for it had of late years become a maxim with Lady Anne that nothing ought to be thrown or given away:..."
                                            },
                                            {
                                                "example_id": "01d81256-9e6e-4b16-b545-fdf33d287cf2",
                                                "sense_id": "d81f9307-2644-3741-9f91-8986a811f2ba",
                                                "text": "Those maxims lurch through my head like rivers of lava. Those smarmy, know-it-all maxims. Trivia disguised as deeply held wisdom."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maxim",
                                "target_lang_code": "en",
                                "target_senses": [
