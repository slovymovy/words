                                        "examples": [
                                            {
                                                "example_id": "cc0b195a-d0f8-4fa7-9167-821aa5e784fe",
                                                "sense_id": "127b449d-23c0-3637-81ff-9c9339e65068",
                                                "text": "Mi hermana recibía amenazas de parte de un usurero porque le debía"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3080808c-00a9-3a63-88c1-cc7a12c3e7fa",
                                        "entry_id": "19555969-bfb6-3d35-85fa-8a95fb2aa484",
                                        "glosses": [
                                            "Persona que en cualquier negocio obtiene ganancias o beneficios desproporcionados."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f95c0075-30ba-4bd6-8022-e5349dcbfc6f",
                                                "sense_id": "3080808c-00a9-3a63-88c1-cc7a12c3e7fa",
