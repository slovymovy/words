{
    "word_family": [
        "amuse",
        "amusement",
        "amusing",
        "amusingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3779282-f126-372d-bca6-8ca23b96994f",
                    "sense_definition": "Finding something funny or entertaining.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children chased one another in a circle in front of their <w>amused</w> parents.",
                            "target_lang_translations": {
                                "ru": "Дети бегали друг за другом по кругу на глазах у своих <w>довольных</w> родителей."
                            }
                        },
                        {
                            "text": "She gave an <w>amused</w> smile when she saw the puppy trying to catch its own tail.",
                            "target_lang_translations": {
                                "ru": "Она <w>снисходительно</w> улыбнулась, увидев, как щенок пытается поймать собственный хвост."
                            }
                        }
                    ],
                    "synonyms": [
                        "entertained",
                        "diverted"
                    ],
                    "antonyms": [
                        "bored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящий что-то смешным или занимательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забавленный",
                                "target_lang_sense_clarification": "которому весело"
                            },
                            {
                                "target_lang_word": "довольный",
                                "target_lang_sense_clarification": "испытывающий удовольствие от увиденного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca8d5549-22c2-3bef-9264-28d813fb0216",
                    "sense_definition": "Enjoying the humorous aspects of a specific situation or action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was very much <w>amused</w> by the lyrics of the funny song they played.",
                            "target_lang_translations": {
                                "ru": "Его очень <w>позабавил</w> текст смешной песни, которую они включили."
                            }
                        },
                        {
                            "text": "The queen was not <w>amused</w> by the rude joke the comedian told during the dinner.",
                            "target_lang_translations": {
                                "ru": "Королева <w>не была в восторге</w> от грубой шутки, которую комик рассказал во время ужина."
                            }
                        }
                    ],
                    "synonyms": [
                        "pleased",
                        "tickled",
                        "entertained"
                    ],
                    "antonyms": [
                        "displeased"
                    ],
                    "common_phrases": [
                        "not amused",
                        "amused by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получающий удовольствие от юмористических аспектов конкретной ситуации или действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлеченный",
                                "target_lang_sense_clarification": "которого что-то рассмешило"
                            },
                            {
                                "target_lang_word": "в восторге",
                                "target_lang_sense_clarification": "в контексте 'очень понравилось'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d09e2e22-cc40-366a-b534-5f0ca0eb4a45",
                    "sense_definition": "The simple past and past participle of <w>amuse</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "While waiting for the bus, I <w>amused</w> myself by reading a short story on my phone.",
                            "target_lang_translations": {
                                "ru": "В ожидании автобуса я <w>развлекал</w> себя чтением короткого рассказа на телефоне."
                            }
                        },
                        {
                            "text": "The magician <w>amused</w> the crowd with several clever card tricks and jokes.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>развлекал</w> толпу несколькими ловкими карточными фокусами и шутками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "amused himself",
                        "amused the crowd"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола 'amuse' (развлекать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлекал",
                                "target_lang_sense_clarification": "занимал чье-то внимание"
                            },
                            {
                                "target_lang_word": "рассмешил",
                                "target_lang_sense_clarification": "заставил улыбнуться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}