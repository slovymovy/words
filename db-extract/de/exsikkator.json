                                    {
                                        "sense_id": "25d6ca45-05c1-359b-8d51-db1011fb4935",
                                        "entry_id": "70f78f6f-3895-3b72-9183-fc9c2af64fea",
                                        "glosses": [
                                            "recipiente fechado de vidro que contém um agente de secagem chamado dessecante"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50e9266-1066-4ee5-a7bb-214a9e5f5866",
                                                "sense_id": "25d6ca45-05c1-359b-8d51-db1011fb4935",
                                                "text": "“Retire a amostra da estufa e deixe em dessecador por 1 hora.”"
                                            },
                                            {
                                                "example_id": "d21d85f7-f60d-4d0d-8633-51f33b903f48",
                                                "sense_id": "25d6ca45-05c1-359b-8d51-db1011fb4935",
                                                "text": "“Tanto ao fazer vácuo nos dessecadores como ao romper o vácuo deve-se tomar cuidado para não contaminar a solução ou conteúdo dos pesa-filtros.”"
                                            },
                                            {
                                                "example_id": "3626491e-e24b-4a84-8da0-c2cd7a11a838",
                                                "sense_id": "25d6ca45-05c1-359b-8d51-db1011fb4935",
                                                "text": "“Após evaporar completamente a água, coloque os frascos em um dessecador para o resfriamento.”"
                                            },
                                            {
                                                "example_id": "1420001c-9aab-4961-8902-eee73ebfdddd",
                                                "sense_id": "25d6ca45-05c1-359b-8d51-db1011fb4935",
                                                "text": "“Preparou-se uma emulsão contendo Quitosana e E.M., que foi gotejada em solução de NaOH a 5%. Após um pequeno intervalo de tempo, retirou-se o excesso de NaOH através de lavagem em água deionizada. As esferas foram postas para secar em dessecador e na ausência de luz….”"
                                            }
                                        ]
                                    }
                                ]
                            }
