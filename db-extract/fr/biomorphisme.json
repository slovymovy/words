                "senses": [
                    {
                        "sense_id": "5e47aadb-f341-3b04-87e7-8df6446d954f",
                        "entry_id": "13a816ef-567e-372f-91c0-541fa1c30604",
                        "glosses": [
                            "Abstractionnisme basé sur des formes végétales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66724cc-efe2-42a8-a107-2be2d3ec752f",
                                "sense_id": "5e47aadb-f341-3b04-87e7-8df6446d954f",
                                "text": "« Avec la bio-inspiration, on est parfois dans l’évocation ou la narration, l’esthétique ou la symbolique », reconnaît Jacques Rougerie. C’est typiquement du biomorphisme."
                            },
                            {
                                "example_id": "99df7171-65b4-4dee-99e6-057c6baefa4a",
                                "sense_id": "5e47aadb-f341-3b04-87e7-8df6446d954f",
                                "text": "Peut-être que l’échelle (la taille approximative d’un fœtus), le biomorphisme et la voix pleurante de ces objets ont déclenché des désirs primordiaux inconnus."
                            },
                            {
                                "example_id": "a3dfc1d3-8f2b-433e-ae3c-1f29e24e2be0",
                                "sense_id": "5e47aadb-f341-3b04-87e7-8df6446d954f",
                                "text": "Le biomorphisme a recours à des formes issues de la nature, mais simplifiées et choisies pour des raisons structurelles et plastiques fortes."
                            }
                        ]
                    }
                ],
                "translations": [
