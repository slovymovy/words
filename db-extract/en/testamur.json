                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29064ad9-051b-46fa-b9c6-e53c78dc0610",
                                "sense_id": "562b5e9f-a02d-353e-950c-c6aee8cb421e",
                                "text": "1868, Mark Pattison, Suggestions on Academical Organisation, Esmonston and Douglas, Edinburgh, page 249,\nAre the students, as part of the qualification for the degree, to be required to attend given courses of lectures, and to produce a testamur of attendance from the instructor, along with a testamur of proficiency from the examiner ?"
                            },
                            {
                                "example_id": "21aea367-da3a-459e-9f8d-673eb62a9800",
                                "sense_id": "562b5e9f-a02d-353e-950c-c6aee8cb421e",
                                "text": "It has already been mentioned that we are prepared to recommend the issue of a Secondary School Testamur to pupils who have to leave school before they are able to take the Secondary School Certificate[…]."
                            },
                            {
                                "example_id": "9c7206a2-bad4-44d5-ad0c-61f851d76f87",
                                "sense_id": "562b5e9f-a02d-353e-950c-c6aee8cb421e",
                                "text": "1961, US Department of Commerce, Report of the 46th National Conference on Weights and Measures, page 57,\nSince then, 116 holders of the Institute′s Testamur have availed themselves of the exemption and 90 have subsequently secured the Board of Trade Certificate."
                            },
                            {
                                "example_id": "9008d6d8-92e5-4493-8871-c9c07ac10dda",
                                "sense_id": "562b5e9f-a02d-353e-950c-c6aee8cb421e",
                                "text": "The names of successful candidates will be announced at the Annual General Meeting of the Society and published in Microbiology Australia. Each will be issued a testamur of fellowship bearing the Seal of the Society."
                            },
                            {
                                "example_id": "d657230b-1bd7-4f64-9375-a96481b46613",
                                "sense_id": "562b5e9f-a02d-353e-950c-c6aee8cb421e",
                                "text": "Andrea was a bit disappointed that she wasn′t the first graduand to go up and get here^([sic]) testamur."
                            }
