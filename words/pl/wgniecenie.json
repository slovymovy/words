                    "sense_id": "f0bfcbe7-76fc-3df4-a7bc-76a20cdc4108",
                    "sense_definition": "płytkie odkształcenie na powierzchni przedmiotu powstałe w wyniku uderzenia lub nacisku",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "odkształcenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na masce samochodu pojawiło się wyraźne <w>wgniecenie</w> po gradobiciu.",
                            "target_lang_translations": {
                                "ru": "На капоте автомобиля появилась заметная <w>вмятина</w> после града."
                            }
                        },
                        {
                            "text": "To <w>wgniecenie</w> na drzwiach powstało, gdy ktoś nieuważnie otworzył swoje auto.",
                            "target_lang_translations": {
                                "ru": "Эта <w>вмятина</w> на двери появилась, когда кто-то неосторожно открыл свою машину."
                            }
                        }
                    ],
                    "synonyms": [
