                    },
                    {
                        "translation_id": "e534f212-6969-47cb-a790-5cd70adc680c",
                        "source_entry_id": "0528ea07-6f54-31a1-8f8b-b6f85e39fe48",
                        "source_sense_id": "68424915-29b4-3877-bd4b-9e6d1a159e14",
                        "target_lang_word": "Paranoia",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paranoia",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                        "entry_id": "1baa8d79-27bc-3ed8-b460-456b1fcdaf82",
                                        "glosses": [
                                            "sich in Wahnvorstellungen und besonders solchen verfolgt zu werden zeigende psychische Störung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee29d7e4-fe45-4e96-a55e-33b56d63766d",
                                                "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                                "text": "„Bei der Paranoia wird von den Erkrankten im Anschluß an ein affektvolles Erlebnis ein System von Wahnvorstellungen entwickelt.“"
                                            },
                                            {
                                                "example_id": "a02a8142-3d66-4e45-8eb6-f7d33d29616a",
                                                "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                                "text": "„Aber er betonte, dass in einer labilen Phase schwer zu sagen sei, wo die Grenze zwischen dem altmodischen Besuch eines Geistes und einer ganz gewöhnlichen Paranoia verläuft.“"
                                            },
                                            {
                                                "example_id": "095c26b7-034f-4e02-a3c8-ccb08ab1b967",
                                                "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                                "text": "„Ich grinste innerlich über meine Paranoia des Vortags.“"
                                            },
                                            {
                                                "example_id": "ba88444d-e326-4b80-8bd2-6791d4ff1900",
                                                "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                                "text": "„Sie entwickelte keine Paranoia, fühlte sich nicht verfolgt oder beklaut.“"
                                            },
                                            {
                                                "example_id": "73ceaff6-cc10-44e9-a647-5b0a1e9b1594",
                                                "sense_id": "78d6d592-285d-3698-a0a3-6cbb25528e23",
                                                "text": "„Jean war einer der wenigen engen Freunde von Amalia gewesen, auch wenn seine Paranoia es manchmal schwierig machte, ihn zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6cfa70d-80de-45de-a5b5-0884a8fe815a",
                        "source_entry_id": "0528ea07-6f54-31a1-8f8b-b6f85e39fe48",
                        "source_sense_id": "68424915-29b4-3877-bd4b-9e6d1a159e14",
                        "target_lang_word": "паранойя",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "паранойя",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2cd6836c-c85e-35ad-b227-9b3d507d7248",
                                        "entry_id": "8c0a9319-4918-3d64-ba8a-cb823720a0ea",
                                        "glosses": [
                                            "психиатр. психическое расстройство, при котором постепенно развиваются логически построенные систематизированные бредовые идеи (например, бред преследования или бред величия), без сопутствующих галлюцинаций и без расстройств мышления по шизофреническому типу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242c53df-c6ff-49f7-b15f-fb46da4deb18",
                                                "sense_id": "2cd6836c-c85e-35ad-b227-9b3d507d7248",
                                                "text": "Паранойя, как известно, характеризуется тем, что человек умственно здоровый, считающийся и с логикой, и с действительностью, как и все здоровые люди, иногда даже одарённый, как только дело коснётся одной определённой темы, делается явно душевнобольным, не признающим никакой логики, никакой действительности."
                                            },
                                            {
                                                "example_id": "f8081b34-7d10-410d-a5a8-b73b551fdfea",
                                                "sense_id": "2cd6836c-c85e-35ad-b227-9b3d507d7248",
                                                "text": "В прежнее время, когда паранойя понималась очень широко, различали несколько отдельных форм её — типический бред преследования, религиозное помешательство, эротическое помешательство, бред изобретений и пр."
                                            },
                                            {
                                                "example_id": "82c69310-970f-4d3f-87db-c247affcb748",
                                                "sense_id": "2cd6836c-c85e-35ad-b227-9b3d507d7248",
                                                "text": "Зандер обратил внимание на то, что у некоторых больных паранойя развивается мало-по-малу, «совершенно так же, как у других людей складывается их нормальный характер»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
