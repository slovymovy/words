                                "target_senses": [
                                    {
                                        "sense_id": "29fb1283-3b11-3ebd-b16d-10e254a7cf31",
                                        "entry_id": "2a5cb44e-da28-37b3-89a2-f60e66bbdf7f",
                                        "glosses": [
                                            "Stück Stoff, mithilfe dessen der Käsebruch aus der Käsemasse gepresst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29adc93d-d02a-4b2d-bc7b-22ef2b82a5c6",
                                                "sense_id": "29fb1283-3b11-3ebd-b16d-10e254a7cf31",
                                                "text": "„Das Käsetuch ist nichts anderes als ein Baumwolltuch, vergleichbar mit Baumwollwindeln, die man für diesen Zweck ebenfalls verwenden kann.“"
                                            },
                                            {
                                                "example_id": "e072216c-a732-4118-a550-ac624b5996ad",
                                                "sense_id": "29fb1283-3b11-3ebd-b16d-10e254a7cf31",
                                                "text": "„Käsetücher sind in der traditionellen Käseherstellung nicht wegzudenken.“"
                                            },
                                            {
                                                "example_id": "ff522a73-6ae2-42c3-86f8-5177cbafe6e1",
                                                "sense_id": "29fb1283-3b11-3ebd-b16d-10e254a7cf31",
                                                "text": "„Käsetücher verhindern, dass der Käsebruch die Löcher der Käseform verstopft und somit wird ein Ablaufen der Molke möglich macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
