    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3db81d19-caa5-3ace-b67b-2f5b40b1d79c",
                    "sense_definition": "waarvoor geen vergoeding of salaris wordt ontvangen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vergoeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed een jaar <w>onbetaald</w> werk bij het dierenasiel om ervaring op te doen.",
                            "target_lang_translations": {
                                "en": "She did <w>unpaid</w> work at the animal shelter for a year to gain experience.",
                                "ru": "Она год выполняла <w>неоплачиваемую</w> работу в приюте для животных, чтобы набраться опыта."
                            }
                        },
                        {
                            "text": "Veel mensen doen <w>onbetaald</w> vrijwilligerswerk in hun vrije tijd.",
                            "target_lang_translations": {
                                "en": "Many people do <w>unpaid</w> volunteer work in their spare time.",
                                "ru": "Многие люди в свободное время занимаются <w>безвозмездной</w> волонтерской деятельностью."
                            }
                        }
                    ],
                    "synonyms": [
                        "gratis",
                        "kosteloos",
                        "vrijwillig"
                    ],
                    "antonyms": [
                        "betaald"
                    ],
                    "common_phrases": [
                        "onbetaald werk",
                        "onbetaald verlof"
                    ],
                    "target_lang_definitions": {
                        "en": "for which no compensation or salary is received",
                        "ru": "за который не выплачивается вознаграждение или заработная плата"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unpaid",
                                "target_lang_sense_clarification": "without receiving a salary or fee"
                            },
                            {
                                "target_lang_word": "voluntary",
                                "target_lang_sense_clarification": "done without payment, often for a cause"
                            },
                            {
                                "target_lang_word": "pro bono",
                                "target_lang_sense_clarification": "professional work done without charge"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неоплачиваемый",
                                "target_lang_sense_clarification": "о работе или отпуске без получения зарплаты"
                            },
                            {
                                "target_lang_word": "безвозмездный",
                                "target_lang_sense_clarification": "выполняемый без ожидания оплаты или компенсации"
                            },
                            {
                                "target_lang_word": "добровольный",
                                "target_lang_sense_clarification": "основанный на добровольных началах, часто без оплаты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75c727d0-9079-37ba-b530-cb3b2ebf0106",
                    "sense_definition": "nog niet voldaan of afgerekend terwijl er wel een schuld is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schuld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen de oude kranten vond hij de <w>onbetaalde</w> rekening voor zijn nieuwe studieboeken.",
                            "target_lang_translations": {
                                "en": "Among the old newspapers, he found the <w>unpaid</w> bill for his new textbooks.",
                                "ru": "Среди старых газет он нашел <w>неоплаченный</w> счет за свои новые учебники."
                            }
                        },
                        {
                            "text": "Er staan nog enkele <w>onbetaalde</w> facturen open bij dit bedrijf.",
                            "target_lang_translations": {
                                "en": "There are still several <w>unpaid</w> invoices outstanding at this company.",
                                "ru": "У этой компании все еще висит несколько <w>неоплаченных</w> счетов-фактур."
                            }
                        }
                    ],
                    "synonyms": [
                        "openstaand"
                    ],
                    "antonyms": [
                        "betaald",
                        "voldaan"
                    ],
                    "common_phrases": [
                        "onbetaalde rekening",
                        "onbetaalde factuur"
                    ],
                    "target_lang_definitions": {
                        "en": "not yet settled or paid despite a debt existing",
                        "ru": "еще не погашенный или не оплаченный, несмотря на наличие долга"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unpaid",
                                "target_lang_sense_clarification": "referring to a debt or bill not yet settled"
                            },
                            {
                                "target_lang_word": "outstanding",
                                "target_lang_sense_clarification": "referring to a balance or invoice that remains to be paid"
                            },
                            {
                                "target_lang_word": "overdue",
                                "target_lang_sense_clarification": "unpaid past the required date"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неоплаченный",
                                "target_lang_sense_clarification": "о счете или долге, который еще не был погашен"
                            },
                            {
                                "target_lang_word": "просроченный",
                                "target_lang_sense_clarification": "не оплаченный в установленный срок"
                            },
                            {
                                "target_lang_word": "непогашенный",
                                "target_lang_sense_clarification": "о задолженности или кредите"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}