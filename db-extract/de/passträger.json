                            {
                                "example_id": "74a70dde-505e-422e-8c97-f9a42616e28b",
                                "sense_id": "63e13a59-a2e1-3951-a78d-226833c0efb1",
                                "text": "„Vor allem aber hat jeder Passträger die Pflicht, den Bezirk zu wechseln, wenn er dort eine gewisse Zeit lang eine Anstellung gesucht, aber nicht gefunden hat.“"
                            },
                            {
                                "example_id": "9eb0ce26-53ca-4292-9bce-1208f4cb4d3f",
                                "sense_id": "63e13a59-a2e1-3951-a78d-226833c0efb1",
                                "text": "„Während sich 50 ausgewählte Passträger im Festsaal des Abgeordnetenhauses aufgeregt gegenseitig fotografierten, erinnerte ich mich an meine eigene Einbürgerung in Duisburg.“"
                            }
                        ],
