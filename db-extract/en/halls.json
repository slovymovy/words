            {
                "entry_id": "6b5c09ca-414b-35a6-9dab-39e25b3b9696",
                "word": "halls",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5cc7623c-d9e7-395d-adbd-d131e8a9562f",
                        "entry_id": "6b5c09ca-414b-35a6-9dab-39e25b3b9696",
                        "glosses": [
                            "Student accommodation"
                        ],
                        "tags": [
                            "UK",
                            "plural",
                            "plural-only",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "70b1d5fe-2a7c-4ccb-9727-02dd32807ba0",
                                "sense_id": "5cc7623c-d9e7-395d-adbd-d131e8a9562f",
                                "text": "'I had a massive argument with my parents about moving into halls and they even tried to bribe me a bit and said, \"You know, if you don't go into halls we'll give you the money that you would have paid in halls as a gift.\""
                            },
                            {
                                "example_id": "fa5e7168-5410-4731-ae32-2d4cb3bb3fe8",
                                "sense_id": "5cc7623c-d9e7-395d-adbd-d131e8a9562f",
                                "text": "He was chatting to a couple of girls so I went over and introduced myself, said, \"Hello, I er... I’m in the same halls as you.\" He just looked at me and said, \"And?\""
                            },
                            {
                                "example_id": "47ca258e-9b6c-410d-9c0d-001bef936a9b",
                                "sense_id": "5cc7623c-d9e7-395d-adbd-d131e8a9562f",
                                "text": "Once B started University he did really well; the structured environment provided by his university suited him well and he loved it so much that by the end of the first term he decided he did want to live in halls after all."
                            },
                            {
                                "example_id": "a35caf78-a76c-4bc0-94ef-799c5cda14f5",
                                "sense_id": "5cc7623c-d9e7-395d-adbd-d131e8a9562f",
                                "text": "'Yes. The first year he was in halls but was glad to leave for digs after that.'"
                            }
                        ]
                    }
