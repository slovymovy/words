                                "target_senses": [
                                    {
                                        "sense_id": "0f25c75f-d072-3c86-8e3b-728d450178b4",
                                        "entry_id": "aa628c7c-4be0-37d7-8ded-2acac10012f0",
                                        "glosses": [
                                            "совокупность наук о живой природе об огромном многообразии вымерших и ныне населяющих Землю живых существ, их строении и функциях, происхождении, распространении и развитии, связях друг с другом и с неживой природой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3dc87a9-bb7e-4a26-a922-a4e062371376",
                                                "sense_id": "0f25c75f-d072-3c86-8e3b-728d450178b4",
                                                "text": "Явление жизни изучает биология, бактериология исследует источники заразных болезней, медицина стремится уничтожить их, гигиена изучает и указывает те условия, при которых человек становится более стойким в сопротивлении болезням."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661611d0-d0e9-3c02-bf85-cb5b5a7ed9a8",
                                        "entry_id": "aa628c7c-4be0-37d7-8ded-2acac10012f0",
                                        "glosses": [
                                            "учебный предмет, излагающий эту науку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0ccd78-b9ed-41a9-9da9-f9d7633ae2f7",
                                                "sense_id": "661611d0-d0e9-3c02-bf85-cb5b5a7ed9a8",
                                                "text": "Она работала учителем биологии и всю свою жизнь отдала школе и станции юннатов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "826eb169-5291-37ea-a1ed-3e7a88678179",
                                        "entry_id": "aa628c7c-4be0-37d7-8ded-2acac10012f0",
                                        "glosses": [
                                            "разг. учебник по этому предмету"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3efa49c5-2cb3-420d-8d45-6eef64199e95",
                                                "sense_id": "826eb169-5291-37ea-a1ed-3e7a88678179",
                                                "text": "Он читает биологию, зоологию, минералогию — я не знаю, какую именно «логию»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4246157f-e93a-3fc1-a51a-3055d0ffb045",
                                        "entry_id": "aa628c7c-4be0-37d7-8ded-2acac10012f0",
                                        "glosses": [
                                            "совокупность признаков, характеризующих живые организмы и их жизнедеятельность во взаимодействии с непосредственной средой обитания и природой в целом"
                                        ],
                                        "tags": [
                                            "кого-чего."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac62903d-2757-4913-89a6-4e56bd57c91f",
                                                "sense_id": "4246157f-e93a-3fc1-a51a-3055d0ffb045",
                                                "text": "Биолюминесценция от полярных широт Северной Атлантики до тропиков Тихого и Индийского океанов позволяет рассматривать ее как постоянно присутствующий, но изменчивый в своих проявлениях специфический фактор биологии моря и гидрооптики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
