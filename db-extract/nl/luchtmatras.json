                "senses": [
                    {
                        "sense_id": "31559ef0-e649-358e-9ffc-2a172cf1315c",
                        "entry_id": "3fe58178-c5a0-3778-97d9-67418d220651",
                        "glosses": [
                            "een matras die gevuld is met lucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae41f2b3-40b7-4c88-946f-f8fc4e3d1079",
                                "sense_id": "31559ef0-e649-358e-9ffc-2a172cf1315c",
                                "text": "De FBI heeft geen motief gevonden. Het enige wat ze aantroffen in zijn kamer in een stadje in de buurt van Milwaukee was een bureau, een stoel en een luchtmatras. Page, een gescheiden vader, woonde er nog maar net. In zijn muziek en webreacties predikte Page haat tegen immigranten, joden, homoseksuelen en zwarte Amerikanen, aldus burgerorganisaties die hem volgden. Maar hij verafschuwde vooral de onverschilligheid waarmee blanke Amerikanen zich in zijn ogen hun land lieten afnemen. Ze moesten in opstand komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411bc2fa-4db6-4584-aa30-8aebbee6e0bb",
                        "source_entry_id": "3fe58178-c5a0-3778-97d9-67418d220651",
                        "source_sense_id": "31559ef0-e649-358e-9ffc-2a172cf1315c",
                        "source_sense_description": "een matras die gevuld is met lucht",
                        "target_lang_word": "Luftmatratze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftmatratze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                        "entry_id": "60e47a0c-cfde-31ab-a29a-f137bcb1f64c",
                                        "glosses": [
                                            "aufblasbares Objekt aus Kunststoff oder Gummi, das als Unterlage zum Liegen (etwa im Zelt oder im Wasser) dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c6e503-ff54-48ee-b08b-35ce8da3a318",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "Carlo lag auf der Luftmatratze im Pool und genoss das Sommerwetter."
                                            },
                                            {
                                                "example_id": "0ee32182-c547-4eb8-94b0-c4d2f77ea84c",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "Es dauerte Stunden, bis Liane im Zelt auf ihrer Luftmatratze einschlafen konnte."
                                            },
                                            {
                                                "example_id": "b847f32b-7e8b-4ff8-8e4a-e8ed5b16634c",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "Als die Luftmatratzen aufgeblasen im Zelt lagen, blieb kaum noch Platz für das Gepäck."
                                            },
                                            {
                                                "example_id": "f24e28ce-4b2c-4972-b9d6-f4cae32d83eb",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "Für ihre zwei Übernachtungsgäste hatte Gisela eine große Luftmatratze ins Wohnzimmer gelegt, auf der beide Platz fanden."
                                            },
                                            {
                                                "example_id": "b82614e2-f818-4a6f-adfc-9b0933b1870f",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "Das Kopfteil der Luftmatratze ist undicht."
                                            },
                                            {
                                                "example_id": "fec44ca8-550f-4283-bf31-5b13bb5a89f2",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "„Am allerbesten war es, auf dem Bauch auf der Luftmatratze liegend in den Wellen zu dümpeln, mit den Gesicht zum Strand.“"
                                            },
                                            {
                                                "example_id": "f111bc3f-06e0-4004-85fd-26a51a93f1c0",
                                                "sense_id": "2b12092d-f17c-3e94-85d0-afcd9399905f",
                                                "text": "„Die Luftmatratze, die Emrys gerade neben Bens Bett platziert habe, sei aber durchaus bequem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
