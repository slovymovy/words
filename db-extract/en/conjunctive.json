                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "21d908be-50d8-3ac3-b16e-c75b34765d35",
                        "entry_id": "0f605a32-0b12-3513-943e-b3052aa2bff2",
                        "glosses": [
                            "Subjunctive: inflected to indicate that an act or state of being is possible, contingent or hypothetical, and not a fact."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66320ff3-0846-3ace-9e9a-62c113480664",
