                ],
                "senses": [
                    {
                        "sense_id": "cc55106e-ed38-3e6e-897b-354f49730fc8",
                        "entry_id": "2b90ffd2-f1ec-3bbd-a9e7-b8890780424d",
                        "glosses": [
                            "Maßnahme, die Verschmutzung der Straße zu beseitigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "510fc984-e7a3-4b0f-aa62-b36f3a6d41a0",
                                "sense_id": "cc55106e-ed38-3e6e-897b-354f49730fc8",
                                "text": "„Die Straßenreinigung funktionierte nicht mehr, vielerorts sammelten sich Müllberge, in denen die noch nicht erlegten und ebenfalls hungrigen Ratten nach Fressbarem wühlten.“"
                            },
                            {
                                "example_id": "75d8edd5-e0cb-427b-bb17-ca1a92db11fc",
                                "sense_id": "cc55106e-ed38-3e6e-897b-354f49730fc8",
                                "text": "„Dass vor hohen Besuchen (etwa 1468) ausdrücklich vom Wegführen des Mists berichtet wird, lässt den Schluss zu, dass der laufenden Straßenreinigung keine große Beachtung geschenkt wurde; besonderes Gewicht legte man allerdings auf die Reinhaltung der Marktplätze.“"
                            },
                            {
                                "example_id": "d51b9bdd-6c44-4968-aaca-6ae4d93f2552",
                                "sense_id": "cc55106e-ed38-3e6e-897b-354f49730fc8",
                                "text": "„Die Männer von der städtischen Straßenreinigung weigerten sich, die Porzellankartons, die neben den Mülltonnen standen, mitzunehmen, sie drohten sogar mit Strafe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "48f45b09-07d3-3f2b-b728-a1b610ff1610",
                        "entry_id": "2b90ffd2-f1ec-3bbd-a9e7-b8890780424d",
                        "glosses": [
                            "Behörde, die für die Sauberkeit der Straßen zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1b3076-d794-429b-bcb9-99b5d9aa17dd",
                                "sense_id": "48f45b09-07d3-3f2b-b728-a1b610ff1610",
                                "text": "Die Straßenreinigung kommt jeden Mittwochvormittag."
                            },
                            {
                                "example_id": "9c9f848a-839d-40c8-82ba-7052ecb90425",
                                "sense_id": "48f45b09-07d3-3f2b-b728-a1b610ff1610",
                                "text": "Seit 20 Jahren arbeitet er bereits für die örtliche Straßenreinigung."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
