                {
                    "sense_id": "14bab3c6-a5e7-382a-a52b-c6d5658bcae5",
                    "sense_definition": "nicht wie geplant stattfinden; abgesagt werden",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "absage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen einer schweren Grippe des Lehrers <w>fällt</w> die erste Unterrichtsstunde heute leider <w>aus</w>."
                        },
                        {
                            "text": "Das geplante Konzert am Wochenende muss wegen des starken Unwetters komplett <w>ausfallen</w>."
                        }
                    ],
                    "antonyms": [
