                    {
                        "sense_id": "5835c825-a05a-353e-8db4-ff99c83191a2",
                        "entry_id": "3c4a7bfe-1116-325b-bb52-b3072788fdc5",
                        "glosses": [
                            "A bristle or hair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1206b3f-b192-4514-b8e4-0bcad38d8340",
                                "sense_id": "5835c825-a05a-353e-8db4-ff99c83191a2",
                                "text": "The setal arrangement in Puncia therefore could represent an evolutionary intermediate step appropriate to a wide-gaped ostracod, in which a domiciliar 'early warning' system is afforded by the frill and extremely long setae."
                            }
                        ]
                    },
                    {
                        "sense_id": "70a6a71f-58ab-366e-8fbf-fbc3c4440102",
                        "entry_id": "3c4a7bfe-1116-325b-bb52-b3072788fdc5",
                        "glosses": [
                            "The stalk of a moss sporangium, or occasionally in a liverwort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08d6c16-8360-4edd-b087-197bc63a0aa7",
                                "sense_id": "70a6a71f-58ab-366e-8fbf-fbc3c4440102",
                                "text": "The latter has the sporophyte seta 4 cells in diam. and has thecal Lejeunea-type androecial branches[…]"
                            }
                        ]
                    }
                ],
