                    {
                        "sense_id": "1b38cbb0-1a0b-34cf-a4ce-47c219b7fd66",
                        "entry_id": "b403118b-bd6f-37a2-89a5-1d818d5091b0",
                        "glosses": [
                            "recipe for success, secret sauce"
                        ],
