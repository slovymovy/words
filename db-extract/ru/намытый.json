                "senses": [
                    {
                        "sense_id": "52cc4218-2555-38b5-859d-c4de1fb8f701",
                        "entry_id": "5fe74df7-add7-3e9a-88ca-f8d148ab006b",
                        "glosses": [
                            "страд. прич. прош. вр. от намыть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "7c01917f-0b6e-467f-99e9-cbc7097a2fb5",
                                "sense_id": "52cc4218-2555-38b5-859d-c4de1fb8f701",
                                "text": "В результате правительству каждый золотник, намытый этим казённым способом, обходился средним числом в 3 1/2 — 4 1/2 рубля."
                            },
                            {
                                "example_id": "dc29f890-8781-4cbd-8dbf-e50aaea202eb",
                                "sense_id": "52cc4218-2555-38b5-859d-c4de1fb8f701",
                                "text": "Песчаный и пустынный берег дрогнул от его крика, и намытые волнами моря жёлтые волны песку точно всколыхнулись."
                            }
                        ]
                    }
