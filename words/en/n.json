                {
                    "sense_id": "096999bc-15a3-37a8-b3e5-be8ee3167e91",
                    "sense_definition": "Abbreviation of \"north\", indicating the compass direction or location.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind is blowing strongly from the <w>N</w>.",
                            "target_lang_translations": {
                                "ru": "Ветер сильно дует с <w>С</w> (севера).",
                                "pl": "Wiatr wieje mocno z <w>północy</w>."
                            }
                        },
                        {
                            "text": "Their new address is 45 <w>N</w>. Main Street.",
                            "target_lang_translations": {
                                "ru": "Их новый адрес: 45 <w>С</w>. Мейн-стрит.",
                                "pl": "Ich nowy adres to 45 <w>N</w>. Main Street."
                            }
                        }
                    ],
                    "synonyms": [
                        "north"
                    ],
                    "antonyms": [
                        "S",
                        "south"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"north\" (север), указывающее направление по компасу.",
                        "pl": "Skrót od słowa „north” (północ), wskazujący kierunek na kompasie lub lokalizację."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "С",
                                "target_lang_sense_clarification": "север (на компасе)"
                            },
                            {
                                "target_lang_word": "сев.",
                                "target_lang_sense_clarification": "сокращение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pn.",
                                "target_lang_sense_clarification": "skrót od północ"
                            },
                            {
                                "target_lang_word": "N",
                                "target_lang_sense_clarification": "oznaczenie na kompasie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f196261e-2141-3d9d-984e-b35ee712a934",
                    "sense_definition": "Abbreviation of \"no\", often used in forms or questionnaires as an option opposite to \"yes\" (Y).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please circle Y for yes or <w>N</w> for no next to each question.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обведите Y (да) или <w>N</w> (нет) рядом с каждым вопросом.",
                                "pl": "Proszę zakreślić Y dla tak lub <w>N</w> dla nie przy każdym pytaniu."
                            }
                        },
                        {
                            "text": "The survey results showed more <w>N</w> responses than expected.",
                            "target_lang_translations": {
                                "ru": "Результаты опроса показали больше ответов <w>N</w> (нет), чем ожидалось.",
                                "pl": "Wyniki ankiety pokazały więcej odpowiedzi na <w>nie</w> niż oczekiwano."
                            }
                        }
                    ],
                    "synonyms": [
                        "no"
                    ],
                    "antonyms": [
                        "Y",
                        "yes"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"no\" (нет), часто используемое в анкетах как вариант ответа, противоположный \"yes\" (да).",
                        "pl": "Skrót od słowa „no” (nie), często używany w formularzach lub ankietach jako opcja przeciwna do „yes” (Y)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нет",
                                "target_lang_sense_clarification": "отрицание"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "N",
                                "target_lang_sense_clarification": "nie (w formularzach)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f182127f-df46-36c5-9f55-f33220dbc4c1",
                    "sense_definition": "Abbreviation of \"neutral\", referring to the gear position in a vehicle where the engine is disconnected from the wheels.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Make sure the gear stick is in <w>N</w> before you start the car.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что рычаг переключения передач находится в положении <w>N</w> (нейтраль), прежде чем заводить машину.",
                                "pl": "Upewnij się, że drążek zmiany biegów jest w pozycji <w>N</w> przed uruchomieniem samochodu."
                            }
                        },
                        {
                            "text": "He shifted into <w>N</w> while waiting at the long traffic light.",
                            "target_lang_translations": {
                                "ru": "Он переключился на <w>N</w> (нейтралку), пока ждал на долгом светофоре.",
                                "pl": "Wrzucił na <w>luz</w>, czekając na długim czerwonym świetle."
                            }
                        }
                    ],
                    "synonyms": [
                        "neutral"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обозначение нейтральной передачи в автомобиле.",
                        "pl": "Skrót od słowa „neutral”, odnoszący się do pozycji biegu jałowego w pojeździe."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нейтраль",
                                "target_lang_sense_clarification": "передача"
                            },
                            {
                                "target_lang_word": "нейтральная передача",
                                "target_lang_sense_clarification": "автомобиль"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "N",
                                "target_lang_sense_clarification": "bieg jałowy / luz"
                            },
                            {
                                "target_lang_word": "luz",
                                "target_lang_sense_clarification": "potocznie o biegu jałowym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e72f714b-b523-3b9a-b1b3-bf2ba1811c33",
                    "sense_definition": "Abbreviation of \"noun\", used in dictionaries and grammar descriptions to indicate the part of speech.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter <w>n</w> next to the word indicates that it is a substantive.",
                            "target_lang_translations": {
                                "ru": "Буква <w>n</w> рядом со словом указывает, что это существительное.",
                                "pl": "Litera <w>n</w> obok słowa wskazuje, że jest to rzeczownik."
                            }
                        },
                        {
                            "text": "Look for the definition marked with <w>n</w> in the dictionary entry.",
                            "target_lang_translations": {
                                "ru": "Ищите определение, помеченное <w>n</w> (сущ.), в словарной статье.",
                                "pl": "Szukaj definicji oznaczonej jako <w>rzecz.</w> w haśle słownikowym."
                            }
                        }
                    ],
                    "synonyms": [
                        "noun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "abbreviation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от \"noun\" (существительное), используемое в словарях и грамматике.",
                        "pl": "Skrót od słowa „noun” (rzeczownik), używany w słownikach i opisach gramatycznych do wskazania części mowy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сущ.",
                                "target_lang_sense_clarification": "существительное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzecz.",
                                "target_lang_sense_clarification": "skrót od rzeczownik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a31d171-7326-3d58-9108-acd3f4766527",
                    "sense_definition": "The symbol used to represent a knight in algebraic chess notation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grandmaster played <w>N</w>f3 to control the center of the board.",
                            "target_lang_translations": {
                                "ru": "Гроссмейстер сыграл <w>N</w>f3 (Кf3), чтобы контролировать центр доски.",
                                "pl": "Arcymistrz zagrał <w>S</w>f3, aby kontrolować centrum szachownicy."
                            }
                        },
                        {
                            "text": "In the annotation, <w>N</w> stands for the piece that moves in an L-shape.",
                            "target_lang_translations": {
                                "ru": "В аннотации <w>N</w> обозначает фигуру, которая ходит буквой \"Г\" (конь).",
                                "pl": "W notacji <w>S</w> oznacza figurę, która porusza się w kształcie litery L."
                            }
                        }
                    ],
                    "synonyms": [
                        "knight"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "symbol"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Символ, используемый для обозначения коня в алгебраической шахматной нотации.",
                        "pl": "Symbol używany do oznaczenia skoczka (konia) w algebraicznej notacji szachowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "К",
                                "target_lang_sense_clarification": "шахматная нотация"
                            },
                            {
                                "target_lang_word": "конь",
                                "target_lang_sense_clarification": "шахматная фигура"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "S",
                                "target_lang_sense_clarification": "skoczek w polskiej notacji szachowej"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "14c2f980-1d8e-3736-a79c-0121bb755373",
                    "sense_definition": "A colloquial contraction of the word \"and\", typically used in established informal phrases.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We danced all night to classic rock <w>n</w> roll music.",
                            "target_lang_translations": {
                                "ru": "Мы всю ночь танцевали под классический рок-<w>н</w>-ролл.",
                                "pl": "Tańczyliśmy całą noc przy klasycznym rock <w>'n'</w> rollu."
                            }
                        },
                        {
                            "text": "They stopped at the shop to buy some fish <w>n</w> chips.",
                            "target_lang_translations": {
                                "ru": "Они остановились у магазина, чтобы купить фиш-<w>н</w>-чипс.",
                                "pl": "Zatrzymali się w sklepie, żeby kupić fish <w>'n'</w> chips."
                            }
                        }
                    ],
                    "synonyms": [
                        "and"
                    ],
                    "common_phrases": [
                        "rock n roll",
                        "fish n chips",
                        "pick n mix",
                        "mac n cheese"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "contraction"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение союза \"and\" (и), обычно используемое в устойчивых фразах.",
                        "pl": "Potoczne skrócenie słowa „and” (i), zazwyczaj używane w ustalonych nieformalnych zwrotach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "н",
                                "target_lang_sense_clarification": "в заимствованных фразах (рок-н-ролл)"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "союз"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "n",
                                "target_lang_sense_clarification": "w zapożyczeniach (np. rock 'n' roll)"
                            },
                            {
                                "target_lang_word": "i",
                                "target_lang_sense_clarification": "spójnik"
                            }
                        ]
                    }
                }
            ]
        },
