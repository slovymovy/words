                    },
                    {
                        "sense_id": "df3fe9fb-3bfc-3f32-b89a-87a58644e148",
                        "entry_id": "c6131581-9229-36c6-bf14-e589a3837294",
                        "glosses": [
                            "Indoor cycling on an exercise bicycle."
                        ],
