{
    "word_family": [
        "down",
        "side",
        "upside"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6fcb7f4-428d-3d17-ab3b-7cb6405c8ea4",
                    "sense_definition": "A disadvantageous aspect of something that is normally advantageous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disadvantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>downside</w> of obtaining a higher rank is that far more work is expected.",
                            "target_lang_translations": {
                                "ru": "<w>Недостатком</w> получения более высокого звания является то, что ожидается гораздо больший объем работы."
                            }
                        },
                        {
                            "text": "The only major <w>downside</w> to this new apartment is the lack of natural light.",
                            "target_lang_translations": {
                                "ru": "Единственный серьезный <w>минус</w> этой новой квартиры — нехватка естественного света."
                            }
                        }
                    ],
                    "antonyms": [
                        "upside"
                    ],
                    "common_phrases": [
                        "major downside",
                        "potential downside",
                        "only downside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отрицательная сторона или недостаток чего-либо, что в остальном является положительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "минус или изъян"
                            },
                            {
                                "target_lang_word": "отрицательная сторона",
                                "target_lang_sense_clarification": "обратная сторона медали"
                            },
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "разговорное обозначение недостатка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec1858ed-947b-3385-896e-512185fbc046",
                    "sense_definition": "A downward tendency, especially in the price of shares or economic value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strategy is used both to increase the return and to provide a limited amount of <w>downside</w> protection.",
                            "target_lang_translations": {
                                "ru": "Эта стратегия используется как для увеличения доходности, так и для обеспечения ограниченной защиты от <w>падения цен</w>."
                            }
                        },
                        {
                            "text": "Investors are worried about the <w>downside</w> risk if the market continues to fall.",
                            "target_lang_translations": {
                                "ru": "Инвесторы обеспокоены риском <w>снижения</w> стоимости, если рынок продолжит падать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "downside protection",
                        "downside risk",
                        "on the downside"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business and finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тенденция к снижению, особенно в отношении цен на акции или экономических показателей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понижение",
                                "target_lang_sense_clarification": "падение курса или цены"
                            },
                            {
                                "target_lang_word": "риск снижения",
                                "target_lang_sense_clarification": "вероятность падения стоимости"
                            },
                            {
                                "target_lang_word": "нисходящий тренд",
                                "target_lang_sense_clarification": "в финансовом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6b0e8d4-e5a1-370e-8c93-502ef4385a84",
                    "sense_definition": "The side of something that is at the bottom, or that is intended to face downward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The buildings on the <w>downside</w> of the station were demolished and new premises were constructed.",
                            "target_lang_translations": {
                                "ru": "Здания на <w>нижней стороне</w> станции были снесены, и были построены новые помещения."
                            }
                        },
                        {
                            "text": "The flow of liquid was observed primarily at the <w>downside</w> of the plate.",
                            "target_lang_translations": {
                                "ru": "Поток жидкости наблюдался преимущественно на <w>нижней стороне</w> пластины."
                            }
                        }
                    ],
                    "antonyms": [
                        "upside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нижняя сторона чего-либо или сторона, обращенная вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нижняя сторона",
                                "target_lang_sense_clarification": "физическое расположение снизу"
                            },
                            {
                                "target_lang_word": "низ",
                                "target_lang_sense_clarification": "нижняя часть объекта"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e4bf483a-8943-3926-bb4d-45d2dbd1aad1",
                    "sense_definition": "A name given to various places in England, including suburbs in Bedfordshire and East Sussex, and villages in Somerset and Surrey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in <w>Downside</w>, a small village located in the Elmbridge borough of Surrey.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>Даунсайде</w>, небольшой деревне, расположенной в районе Элмбридж графства Суррей."
                            }
                        },
                        {
                            "text": "The school is located near <w>Downside</w> Abbey in the county of Somerset.",
                            "target_lang_translations": {
                                "ru": "Школа расположена недалеко от аббатства <w>Даунсайд</w> в графстве Сомерсет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных населенных пунктов в Англии, включая пригороды и деревни."
                    },
                    "translations": {
