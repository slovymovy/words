                        "glosses": [
                            "Transfert secret d'une personne d'un pays à un autre, ou d'un endroit à un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231d9cbc-a9ce-40b8-9ec5-0aa16e91f335",
                                "sense_id": "7c26e7b4-3a56-351d-829a-351017e2cb63",
                                "text": "Des certificats médicaux pour justifier les désertions d'officiels, et les exfiltrations d'étudiants vers les rangs rebelles."
                            },
                            {
                                "example_id": "b5b42f48-58c1-4a49-8dff-af8e8a0d20fe",
                                "sense_id": "7c26e7b4-3a56-351d-829a-351017e2cb63",
                                "text": "Lors d’entretiens menés par Anthony Samrani, rédacteur en chef de L’Orient-Le Jour, l’ex-n° 1 de Renault-Nissan a dévoilé « [son] ressenti dans la boîte », des « incidents particuliers » lors du trajet, comme lorsque la mise à jour du téléphone d’un membre de son équipe d’exfiltration a fait craindre l’échec de la mission."
                            }
                        ]
                    }
