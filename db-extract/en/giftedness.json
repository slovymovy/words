                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00dfba2c-4efb-4fba-b279-726218db7d90",
                                                "sense_id": "2f774e64-bef5-351c-8c32-5a49034867c3",
                                                "text": "Il faut les comprendre en gardant en tête que la douance n’a que peu à voir avec un chiffre de quotient intellectuel : les tests permettent d’évaluer la douance, ils ne la définissent pas."
                                            },
                                            {
                                                "example_id": "41111688-db70-42c0-a52a-6627549c9898",
                                                "sense_id": "2f774e64-bef5-351c-8c32-5a49034867c3",
                                                "text": "Pour une grande majorité des scientifiques, la douance intellectuelle est représentée par un QI supérieur ou égal à 130."
                                            }
                                        ]
                                    }
                                ]
                            }
