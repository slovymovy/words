                        "glosses": [
                            "die Kardinalzahl, die sich aus Addition von tausend und zweihundert ergibt; zwölf mal hundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b09bd0cf-c406-4453-8edc-cbbd389ed9c0",
                                "sense_id": "962b3ce5-e34e-3f38-8af4-abdede5fb112",
                                "text": "„Tausendzweihundert Menschenleben hat ihr siebenjähriger Krieg gefordert.“"
                            },
                            {
                                "example_id": "de99cacf-8ec0-4c91-8c00-363efe3de25a",
                                "sense_id": "962b3ce5-e34e-3f38-8af4-abdede5fb112",
                                "text": "„An einem breiten Priel entlanggehend, ließ sich nach tausendzweihundert Metern das Watt erreichen.“"
                            },
                            {
                                "example_id": "1a6fca86-682c-4210-a2c6-d6d212b75c8c",
                                "sense_id": "962b3ce5-e34e-3f38-8af4-abdede5fb112",
                                "text": "„Das Werk erfreute sich zunehmender Beliebtheit. So sollten bis zum Jahr 1828 siebenhundert und bis 1862 tausendzweihundert Exemplare der Druckversion verkauft werden.“"
                            },
                            {
                                "example_id": "21c4ab70-5bb1-4a40-b66d-29c84a9a371d",
                                "sense_id": "962b3ce5-e34e-3f38-8af4-abdede5fb112",
                                "text": "„In Kleinstädten lag das Bargehalt bei dreihundert bis sechshundert Mark, das Nebeneinkommen bei vierhundert bis sechshundert, so daß siebenhundert bis tausendzweihundert Mark herauskommen konnten.“"
                            }
                        ],
