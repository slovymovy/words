                                        "entry_id": "af38f256-19af-3353-a8cc-f82fb91b5bea",
                                        "glosses": [
                                            "grupa późnych odmian uprawnych jabłoni domowej dających owoce o charakterystycznym winno-kwaskowatym smaku i soczystym miąższu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "313842ef-331f-4c52-ac06-d1cb9e1eecf7",
                                                "sense_id": "b8c89239-8ceb-3a0d-9028-ab87c457d9ec",
                                                "text": "W sadzie rośnie dorodna reneta. Dojrzewa bardzo późno, ale warto czekać na jej owoce."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "d7533af6-fd66-3923-9bc2-1e740dc90ae9",
                                        "entry_id": "af38f256-19af-3353-a8cc-f82fb91b5bea",
                                        "glosses": [
                                            "jabłko o charakterystycznym winno-kwaskowatym smaku i soczystym miąższu, owoc renety (1.1)"
                                        ],
                                        "tags": [
                                            "cuk."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c11ec84d-645b-4fa0-9777-8f38d32f9c20",
                                                "sense_id": "d7533af6-fd66-3923-9bc2-1e740dc90ae9",
                                                "text": "Renety nadają się doskonale na szarlotkę."
                                            },
                                            {
                                                "example_id": "8ba77b65-c104-4af0-98a6-55817944fb1a",
                                                "sense_id": "d7533af6-fd66-3923-9bc2-1e740dc90ae9",
                                                "text": "Księże, nie masz nadziei, że będziemy jedli czerwone renety z mojej szkółki — a spodziewasz się owoców na spróchniałym drzewie!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
