                    {
                        "translation_id": "dc719957-8277-4a62-bd73-bdf9fc40378a",
                        "source_entry_id": "19c4ecfd-57de-3032-b34a-28e72ba7f44e",
                        "source_sense_id": "50bd053d-179f-3b3a-a76c-807aa2bdfce3",
                        "source_sense_description": "Sonnencreme",
                        "target_lang_word": "suncream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suncream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d24c2251-83a0-3161-9439-0552dd331d7a",
                                        "entry_id": "af5208c0-b6d6-3493-b31e-a01ea79173f7",
                                        "glosses": [
                                            "A cream that contains sunscreen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829785c8-8c73-4293-af0c-e54788170a95",
                                                "sense_id": "d24c2251-83a0-3161-9439-0552dd331d7a",
                                                "text": "On sunny days like today we need to wear suncream to make sure we don't burn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d61fcf1e-09e6-4f15-bd62-5182d7ee309c",
                        "source_entry_id": "19c4ecfd-57de-3032-b34a-28e72ba7f44e",
                        "source_sense_id": "50bd053d-179f-3b3a-a76c-807aa2bdfce3",
                        "source_sense_description": "Sonnencreme",
                        "target_lang_word": "sunscreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sunscreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef4d23a3-e660-3b5f-b377-6b537b45a204",
                                        "entry_id": "78462dd4-1281-38a3-aa43-bca3082c4db7",
                                        "glosses": [
                                            "A topical substance formulated to protect the skin from the harmful effects of ultraviolet radiation by absorbing, reflecting or scattering ultraviolet rays."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a868e2c7-0563-40d2-8ec1-a5683ed84c2e",
                                                "sense_id": "ef4d23a3-e660-3b5f-b377-6b537b45a204",
                                                "text": "Jill had Mark apply sunscreen to her back.\n\"Bet these river guides get a lot of skin cancer\", he said. He had a slappy, unpleasant way of doing it, and she struggled to keep her balance."
                                            },
                                            {
                                                "example_id": "cbf24674-6d60-446e-9135-df2ae922c4e2",
                                                "sense_id": "ef4d23a3-e660-3b5f-b377-6b537b45a204",
                                                "text": "Chemical ingredients — such as avobenzone, oxybenzone and homosalate — absorb the UV rays. Both types of sunscreen can degrade or wash off over time, so it’s important to reapply every two hours, and more frequently if you’re swimming or sweating."
                                            },
                                            {
                                                "example_id": "c5fd9913-55da-462e-ac6b-c667bf8634d6",
                                                "sense_id": "ef4d23a3-e660-3b5f-b377-6b537b45a204",
                                                "text": "As for daytime sun protection, Dr. Bowe said mineral sunscreens made with zinc oxide may be gentler on sensitized skin than chemical formulas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sunscreen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcbc600d-9401-3f5e-9d5d-ee58c37cf80d",
                                        "entry_id": "f4ebf696-9b50-35fb-86e1-10e7309a7f72",
                                        "glosses": [
                                            "To apply sunscreen to (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74f1cc0-404f-489d-a534-61199e07b1a8",
                                                "sense_id": "dcbc600d-9401-3f5e-9d5d-ee58c37cf80d",
                                                "text": "He glanced over his shoulder as I sunscreened his back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
