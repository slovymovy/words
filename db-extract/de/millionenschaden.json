                "senses": [
                    {
                        "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                        "entry_id": "56c1f63b-ec1c-3fc7-91f5-5ae3b4acd7ed",
                        "glosses": [
                            "Schaden in Millionenhöhe (einer Währung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82f80b3f-b9ed-4bfb-a74e-93b4b5599c18",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "Die Deutsche Bahn befürchtet beim Lokführerstreik einen Millionenschaden."
                            },
                            {
                                "example_id": "dcb1fe75-1b8f-43e9-b471-f8b686fd93eb",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "[Schlagzeile:] „Ostsee-Sturmflut hinterlässt Millionenschäden“"
                            },
                            {
                                "example_id": "8013daf1-c2b2-46b5-98d7-983804ba552e",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "[Brandstiftung:] „Bei ähnlichen Bränden waren in den vergangenen Wochen Millionenschäden entstanden.“"
                            },
                            {
                                "example_id": "6afc3144-4f47-4ba7-8b9b-3ebd74de8e08",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "„Großbrand in einer Vöhringer Lagerhalle“ - […] „Es entstand Millionenschaden, verletzt wurde niemand.“"
                            },
                            {
                                "example_id": "f3ca50a4-5ed2-416b-848b-802483ba4cb6",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "„Altes und überschüssiges Öl sollte auf keinen Fall in den Ausguss oder in die Toilette gekippt werden, denn Fettablagerungen verstopfen die Kanalisationsrohre und verursachen so Millionenschäden.“"
                            },
                            {
                                "example_id": "57d57623-f9bb-4187-bd1e-26513d58f408",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "„In Leipzig-Connewitz haben Unbekannte an einem erst unlängst fertiggestellten Gebäude einen Millionenschaden verursacht. Wie die Polizei mitteilte, wurden in dem Gebäude in der Bornaischen Straße mehrere Wasserhähne aufgedreht und die Abflüsse verstopft. Dadurch wurden Teile des Gebäudes geflutet.“"
                            },
                            {
                                "example_id": "c8697928-f558-44fb-ad27-97e368965aee",
                                "sense_id": "b264c941-ccd8-3b83-a079-4709ad315498",
                                "text": "[Schlagzeile:] „Millionenschäden durch Telefonbetrug“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
