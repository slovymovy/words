                        "glosses": [
                            "przekład Starego Testamentu lub jego fragmentów na język aramejski"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "fc64c08f-9271-4ad7-92c0-449d8aa6b443",
                                "sense_id": "6a6aa672-3fd1-3a81-b4f2-ea58af333767",
                                "text": "Ponadto targumy powstające w Palestynie były o wiele mniej dosłownymi tłumaczeniami, często stawały się faktycznie parafrazami oryginalnego tekstu"
                            }
                        ],
