                                "target_senses": [
                                    {
                                        "sense_id": "d272fba4-4c75-3dd1-b867-a4a150dbb5b4",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "An abrupt, sharp sound, especially one made by two hard objects colliding repetitively; a sound midway between a click and a clunk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b63830ef-5009-3081-bc9b-b5a3be23c5c5",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "Anything that causes a clacking noise, such as the clapper of a mill, or a clack valve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74348e89-86bf-33fe-8394-21adfedd6674",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "Chatter; prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c481db19-e5aa-4950-bc12-af196bd8ba51",
                                                "sense_id": "74348e89-86bf-33fe-8394-21adfedd6674",
                                                "text": "whose chief intent is to vaunt his spiritual clack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb61267-c36b-3401-bfd9-b997fe128da1",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "The tongue."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To make a sudden, sharp noise, or succession of noises; to click."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d5d8fc-d3e6-4d4d-9c30-a0e45d50487c",
                                                "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                                "text": "We heard Mr. Hodson's whip clacking on the shoulders of the poor little wretches."
                                            },
                                            {
                                                "example_id": "dee69252-01d6-4e22-909f-3dbed187cb3c",
                                                "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                                "text": "[He] walked quite jauntily across the courtyard to the distant door, his sandals clacking against the marble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa03ea1-2e11-364f-912f-4fe43b0c2c30",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To cause to make a sudden, sharp noise, or succession of noises; to click."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To chatter or babble; to utter rapidly without consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e332e6e-2629-4a06-9790-fbe890964e34",
                                                "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                                "text": "There is a generation of men, whose unweighed custome makes them clack out any thing their heedleſs fancy ſprings"
                                            },
                                            {
                                                "example_id": "d1f90304-f3aa-4609-813e-cada8d07a094",
                                                "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                                "text": "The women bunched up in little droves and let their tongues clack, and the men herded together and passed a jug around and, to tell the truth, let their tongues clack too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea8478c-835f-3b88-844e-5f6e972f720e",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To cut the sheep's mark off (wool), to make the wool weigh less and thus yield less duty."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "Dated form of cluck."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8894293e-1f58-472d-8851-02bf5ba1defe",
                                                "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                                "text": "Only the chickens clacked at the Saturday quiet and fat mouse-minded cats licked whiskers on the empty steps."
                                            },
                                            {
                                                "example_id": "71deaf3b-46df-4a1c-820f-e1e9d5e64384",
                                                "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                                "text": "We drive on between meadows of mown grass, through a pergola of vines, and so to an orchard of peaches, apples, and pears and a hen colony housed in neat modern cottages, the chickens clacking and scratching away […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
