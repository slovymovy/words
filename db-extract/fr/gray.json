                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "593a9e96-cdd2-3d9a-9b14-c4331964f234",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Gray-haired."
