        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "299bd3f2-4f87-3eb8-be0d-92814b815daa",
                    "sense_definition": "The act of ejecting matter from the stomach through the mouth, or the matter that is ejected.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe cases of the stomach flu often involve persistent nausea and <w>vomiting</w>.",
                            "target_lang_translations": {
                                "de": "Schwere Fälle von Magen-Darm-Grippe gehen oft mit anhaltender Übelkeit und <w>Erbrechen</w> einher."
                            }
                        },
                        {
                            "text": "The doctor asked if the sudden bouts of <w>vomiting</w> were accompanied by a fever.",
                            "target_lang_translations": {
                                "de": "Der Arzt fragte, ob die plötzlichen Anfälle von <w>Erbrechen</w> von Fieber begleitet waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "emesis",
                        "throwing up",
                        "vomit"
                    ],
                    "common_phrases": [
                        "nausea and vomiting",
                        "persistent vomiting"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Ausstoßen von Mageninhalt durch den Mund (Erbrechen) oder das Erbrochene selbst."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Erbrechen",
                                "target_lang_sense_clarification": "Vorgang, medizinisch/standardsprachlich"
                            },
                            {
                                "target_lang_word": "das Übergeben",
                                "target_lang_sense_clarification": "Vorgang"
                            },
                            {
                                "target_lang_word": "das Erbrochene",
