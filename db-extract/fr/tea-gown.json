                                "target_senses": [
                                    {
                                        "sense_id": "5430b523-7481-30b1-a9d4-9e9e37959400",
                                        "entry_id": "ec9e4b5b-1bb3-3a15-a9b7-b27e428b70cb",
                                        "glosses": [
                                            "A loose-fitting semiformal gown, made of light fabrics, worn in the late 19th and early 20th century for entertaining, especially for afternoon tea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac1e6008-19f6-4a2d-8d8b-94216353a87c",
                                                "sense_id": "5430b523-7481-30b1-a9d4-9e9e37959400",
                                                "text": "Eve crushed in a corner, a sorrowful, dainty shape in the silk and lace of her pretty tea-gown, with the white drawn face of a scared child […]"
                                            },
                                            {
                                                "example_id": "bb27cfd8-2ac7-4d43-933e-79e01e117270",
                                                "sense_id": "5430b523-7481-30b1-a9d4-9e9e37959400",
                                                "text": "Across the white silken draperies of her tea-gown her two little hands are loosely locked together amongst the laces that adorn it, and from beneath its lowermost frill I can just see the point of a tiny satin slipper."
                                            },
                                            {
                                                "example_id": "a8e0c400-4ae1-436e-be26-f82675e1ce0e",
                                                "sense_id": "5430b523-7481-30b1-a9d4-9e9e37959400",
                                                "text": "There is probably no form of gown more replete with interest to the artistic designer, nor one that lends itself to greater individuality of expression, than the tea-gown."
                                            },
                                            {
                                                "example_id": "43f0b29f-7967-4c2c-89e5-f6fde812194f",
                                                "sense_id": "5430b523-7481-30b1-a9d4-9e9e37959400",
                                                "text": "'[H]er luggage contained only a chiffon negligée so elaborate as to be more a tea gown than a dressing-gown.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
