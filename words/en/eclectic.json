{
    "word_family": [
        "eclecticism",
        "eclectically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2cccdcb-1a44-3752-ba26-641c2eec370b",
                    "sense_definition": "Selecting the best elements from a variety of different sources, styles, or systems.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect is known for her <w>eclectic</w> style, blending modern glass with traditional stone.",
                            "target_lang_translations": {
                                "zh": "这位建筑师以其<w>博采众长</w>的风格而闻名，将现代玻璃与传统石材融为一体。"
                            }
                        },
                        {
                            "text": "He has an <w>eclectic</w> approach to cooking, combining techniques from many different cultures.",
                            "target_lang_translations": {
                                "zh": "他的烹饪方式<w>兼收并蓄</w>，融合了来自许多不同文化的技巧。"
                            }
                        }
                    ],
                    "antonyms": [
                        "orthodox",
                        "standard"
                    ],
                    "common_phrases": [
                        "eclectic style",
                        "eclectic approach"
                    ],
                    "target_lang_definitions": {
                        "zh": "兼收并蓄的；博采众长的；折衷的（从各种不同来源、风格或体系中挑选最好的元素）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兼收并蓄的",
                                "target_lang_sense_clarification": "博采多种不同风格或元素"
                            },
                            {
                                "target_lang_word": "博采众长的",
                                "target_lang_sense_clarification": "吸取各家之长"
                            },
                            {
                                "target_lang_word": "折衷的",
                                "target_lang_sense_clarification": "综合不同体系或派别的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7512c420-f9a1-3402-89cd-69861129fed0",
                    "sense_definition": "Composed of diverse, unrelated, or unspecialized parts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "diversity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The library contains an <w>eclectic</w> collection of books ranging from ancient history to modern science fiction.",
                            "target_lang_translations": {
                                "zh": "该图书馆藏书<w>五花八门</w>，涵盖了从古代历史到现代科幻的各类书籍。"
                            }
                        },
                        {
                            "text": "They have an <w>eclectic</w> group of friends who come from very different backgrounds.",
                            "target_lang_translations": {
                                "zh": "他们有一群背景各不相同、非常<w>多元</w>的朋友。"
                            }
                        }
                    ],
                    "synonyms": [
                        "heterogeneous"
                    ],
                    "antonyms": [
                        "homogeneous",
                        "uniform",
                        "exclusive"
                    ],
                    "common_phrases": [
                        "eclectic collection",
                        "eclectic group"
                    ],
                    "target_lang_definitions": {
                        "zh": "来源多样的；五花八门的；兼容并包的（由不同且不相关的部分组成的）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多元的",
                                "target_lang_sense_clarification": "包含广泛且多样的元素"
                            },
                            {
                                "target_lang_word": "五花八门的",
                                "target_lang_sense_clarification": "种类繁多各异的"
                            },
                            {
                                "target_lang_word": "广泛多样的",
                                "target_lang_sense_clarification": "来源或风格极具多样性的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "838209af-06a4-3a05-adeb-e8916e415654",
                    "sense_definition": "A person who chooses ideas or methods from various sources rather than following a single system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "selection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As an <w>eclectic</w>, she incorporates meditation, yoga, and prayer into her daily routine.",
                            "target_lang_translations": {
                                "zh": "作为一个<w>兼收并蓄者</w>，她将冥想、瑜伽和祈祷融入了自己的日常生活。"
                            }
                        },
                        {
                            "text": "Many modern philosophers are <w>eclectics</w> who draw wisdom from both Eastern and Western traditions.",
                            "target_lang_translations": {
                                "zh": "许多现代哲学家都是<w>折衷主义者</w>，他们同时从东西方传统中汲取智慧。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "兼收并蓄者；折衷主义者（不拘泥于单一学派，从各种来源汲取思想或方法的人）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "折衷主义者",
                                "target_lang_sense_clarification": "哲学或思想上博采众长的人"
                            },
                            {
                                "target_lang_word": "兼收并蓄者",
                                "target_lang_sense_clarification": "广泛采纳不同方法或理念的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}