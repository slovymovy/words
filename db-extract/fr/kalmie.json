                                "example_id": "8da1a6c9-3e6b-489d-9412-5dfd3c71fd85",
                                "sense_id": "13a0a35a-8b27-31ba-88cd-04593172dae2",
                                "text": "Une espèce de kalmie est aussi nommée laurier des montagnes."
