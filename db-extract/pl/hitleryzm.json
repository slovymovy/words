                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5b66b527-83a2-4e3c-a688-26eb9ca790eb",
                        "source_entry_id": "1a402117-3085-3a66-a699-63396e949e9f",
                        "source_sense_id": "f092f710-dbaa-3ad2-a54f-856e5a270a4e",
                        "target_lang_word": "Hitlerismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitlerismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "078a003a-db28-31dc-88e9-b103451a3a2e",
                                        "entry_id": "332f261e-8c78-3c0b-b4b2-92cd7906af44",
                                        "glosses": [
                                            "Gesamtheit der Vorstellungen und Folgen der Regierung Adolf Hitlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273f671f-fd54-452c-9285-5869e348109a",
                                                "sense_id": "078a003a-db28-31dc-88e9-b103451a3a2e",
                                                "text": "„Heinrich Mann, Feuchtwanger, Brecht und Ludwig Marcuse neigten dazu, den Hitlerismus als vorübergehende Erscheinung zu betrachten und standen Deutschland im Prinzip positiv gegenüber, während Thomas Mann zu einer Versöhnung anscheinend noch nicht bereit war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22ad066c-210b-41ef-a38a-5f4f0ced6b24",
                        "source_entry_id": "1a402117-3085-3a66-a699-63396e949e9f",
                        "source_sense_id": "f092f710-dbaa-3ad2-a54f-856e5a270a4e",
                        "target_lang_word": "гитлеризм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гитлеризм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "080a3947-86e1-35f1-9d42-0de84faa6544",
                                        "entry_id": "bdf3cf51-a869-3404-a7f2-ad31e5959eac",
                                        "glosses": [
                                            "полит. национал-социалистическая диктатура в Германии, возглавлявшаяся Гитлером в 1933—1945 годах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b3a390-9f5a-42f6-bd36-a300aa1f99b2",
                                                "sense_id": "080a3947-86e1-35f1-9d42-0de84faa6544",
                                                "text": "Для Штирлица было едино горе Минска, Бабьего Яра или Ковентри: те, кто сражался против гитлеризма, были для него братьями по оружию."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                        "entry_id": "bdf3cf51-a869-3404-a7f2-ad31e5959eac",
                                        "glosses": [
                                            "идеология такой диктатуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598fc1cb-25a6-4ae0-99af-5aebc68ac511",
                                                "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                                "text": "В полном созвучии с политическими чаяниями гитлеризма, он принялся энергично чистить государственный аппарат от веймарских демократических элементов."
                                            },
                                            {
                                                "example_id": "6fcb9449-9d88-4698-a66a-ef20939e01ac",
                                                "sense_id": "3568936b-d27f-3eb7-8e96-d59ca382d150",
                                                "text": "Гитлеризм не совместим с христианством; более того, он прямо противоположен ему."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
