                        ],
                        "form": "den Exhibitionismus"
                    },
                    {
                        "form_id": "b921a4d9-cc3d-43e4-93a9-2b5ebd1df8ca",
                        "entry_id": "28b763b6-3cdc-34e0-9d4c-898a6af85735",
                        "tags": [
                            "accusative",
