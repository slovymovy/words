                ],
                "senses": [
                    {
                        "sense_id": "b5615dc3-b7c3-30f8-b2ef-4e265ee08f47",
                        "entry_id": "e9ee4096-70c9-3bbd-8a04-b39dd3ab540f",
                        "glosses": [
                            "Faire heurter le quai (à cause du ressac)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2b44808c-3b34-38e2-9ebe-b38c2308d318",
                        "entry_id": "e9ee4096-70c9-3bbd-8a04-b39dd3ab540f",
                        "glosses": [
                            "Heurter ; tamponner."
                        ],
                        "tags": [
                            "Bretonnisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f1f4c3f8-68e3-4c8d-b1b3-72812e6d7881",
                                "sense_id": "2b44808c-3b34-38e2-9ebe-b38c2308d318",
                                "text": "Nous prendrons course vers l'est, dit-il enfin, restez de faction sur le gaillard d'avant, Tom, et faites bien attention pour que l'on ne tosse pas un haut-fond."
                            },
                            {
                                "example_id": "fd7e186c-fc07-4b43-bef2-a8eade5448ad",
                                "sense_id": "2b44808c-3b34-38e2-9ebe-b38c2308d318",
                                "text": "— Mais t’es blessé, non ? T’as morflé un éclat ?\n— Des clous ! dit Tigeaine. C’t’un mec qui m’a tossé."
                            },
                            {
                                "example_id": "87accb57-6683-43b6-801c-7d5edc03d91f",
                                "sense_id": "2b44808c-3b34-38e2-9ebe-b38c2308d318",
                                "text": "Les marins, dont les chalutiers tossaient contre les quais les rares voiliers qui osaient s'aventurer dans le port, explosèrent de rire ; ils s'étaient tous retenus jusqu'à la dernière ânerie du voileux."
                            }
                        ]
                    },
                    {
                        "sense_id": "48f41bfd-fcf8-3ba7-8edf-5c68a20ef27b",
                        "entry_id": "e9ee4096-70c9-3bbd-8a04-b39dd3ab540f",
                        "glosses": [
                            "Assommer (à propos d’un vin, d’un alcool)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "01ca92ad-50c6-31f8-a9b9-9a0745acf7f1",
                        "entry_id": "e9ee4096-70c9-3bbd-8a04-b39dd3ab540f",
                        "glosses": [
                            "Téter, sucer."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "a962f14c-1c31-4a4d-a9d3-3facf8c4fbb3",
                                "sense_id": "01ca92ad-50c6-31f8-a9b9-9a0745acf7f1",
                                "text": "On dit d'une voiture qui consomme qu'elle tosse."
                            },
                            {
                                "example_id": "f2c07540-f321-4bc7-86cf-551957a67a59",
                                "sense_id": "01ca92ad-50c6-31f8-a9b9-9a0745acf7f1",
                                "text": "On dit aussi d’un ivrogne qui boit à la bouteille qu’il tosse."
                            },
                            {
                                "example_id": "c76d1890-a4b7-430a-8620-973f0a690547",
                                "sense_id": "01ca92ad-50c6-31f8-a9b9-9a0745acf7f1",
                                "text": "Pareillement on dit d’un bébé qui tête son biberon qu’il tosse."
                            }
                        ]
                    }
                ],
