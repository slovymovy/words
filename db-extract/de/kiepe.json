                                        "entry_id": "766f2973-950f-35a3-91cc-4fc759756176",
                                        "glosses": [
                                            "A breadbasket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "279756cd-7dcd-3389-9b7d-9e0006430210",
                                        "entry_id": "766f2973-950f-35a3-91cc-4fc759756176",
                                        "glosses": [
