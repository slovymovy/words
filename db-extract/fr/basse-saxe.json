                                "target_senses": [
                                    {
                                        "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                        "entry_id": "225d856a-588b-32d4-aa4d-828cc2871de4",
                                        "glosses": [
                                            "ein Bundesland in der Bundesrepublik Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f04f20-1b1b-48a4-9367-def06c5567b8",
                                                "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                                "text": "Niedersachsen liegt zwischen Ems und Elbe."
                                            },
                                            {
                                                "example_id": "90ac3436-2234-4580-ab69-e2be3a9bbe66",
                                                "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                                "text": "Das Sagen haben künftig allein die Großaktionäre: fünf Vertreter der Familien Piëch und Porsche, zwei Vertreter Niedersachsens und zwei Katarer, die mit ihrer Staatsholding dem Clan beisprangen, als es galt, die über Porsche erworbenen VW-Anteile zu finanzieren."
                                            },
                                            {
                                                "example_id": "3c115cd9-d4ce-4ee0-97bf-7ebc0287f352",
                                                "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                                "text": "Niedersachsens Innenminister Uwe Schünemann nannte den Kampf gegen den Salafismus eine „Nagelprobe“ für die Kooperation mit den muslimischen Verbänden."
                                            },
                                            {
                                                "example_id": "a29b69ad-985d-4e7e-9194-531b0544c3da",
                                                "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                                "text": "Hannover 96 bleibt die Nummer Eins in Niedersachsen und rückt der zweiten Europa-League-Teilnahme einen Schritt näher."
                                            },
                                            {
                                                "example_id": "5ce49b7d-d6c9-4c44-8eb5-edd11be169cb",
                                                "sense_id": "55386677-f6a1-3194-8913-855051f60d33",
                                                "text": "Allein um die Lufthansa-Flotte mit Sprit aus Leindotter oder Jatropha zu versorgen, wäre eine Anbaufläche von etwa der Größe Niedersachsens nötig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
