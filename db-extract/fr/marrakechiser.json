                "senses": [
                    {
                        "sense_id": "f30eca2f-f3bb-3e9c-a813-d00548241a20",
                        "entry_id": "c603e2b2-6bb2-37c3-a6bd-ace082a9caa9",
                        "glosses": [
                            "Donner un caractère rappelant Marrakech à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5351341d-e2fd-4c52-a9c1-c1896f95b462",
                                "sense_id": "f30eca2f-f3bb-3e9c-a813-d00548241a20",
                                "text": "Je compte donc sur vous pour nous tangériser ou nous marrakechiser, dans les mêmes proportions et à grande vitesse."
                            },
                            {
                                "example_id": "f31106d5-322b-4cca-a38e-8b810c946c01",
                                "sense_id": "f30eca2f-f3bb-3e9c-a813-d00548241a20",
                                "text": "Quant au Maroc en 2020 je ne le vois pas se marrakechiser, je pense que les autorités vont utiliser Marrakech et Agadir un peu comme des zones franches et réserver le reste du Maroc pour un tourisme de qualité...en tout cas je vous le souhaite..."
                            },
                            {
                                "example_id": "40dd0ad9-87a1-4e26-965f-5d3a33f20407",
                                "sense_id": "f30eca2f-f3bb-3e9c-a813-d00548241a20",
                                "text": "ville accueillante à la culture très personnalisée ; ne risque pas de se \"marrakechiser\", grâce au vent !"
                            }
                        ]
                    }
