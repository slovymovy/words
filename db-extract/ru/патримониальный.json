                    },
                    {
                        "translation_id": "e081a742-47d6-4be2-a267-f1e81ebde070",
                        "source_entry_id": "d658154d-7205-3a6f-a7ae-f8e06bdbf115",
                        "source_sense_id": "59473d16-bdaa-34be-beff-caee861e0a8b",
                        "target_lang_word": "patrimonial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrimonial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e3507da-e92a-303d-bcbb-962286017260",
                                        "entry_id": "f96b43e0-56e9-38c3-b19b-ef11907c6cfd",
                                        "glosses": [
                                            "von der väterlichen Seite geerbt, sich auf das Patrimonium (Erbgut, Vermögen) beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72eabf88-0f20-4c47-be32-afedc80ed4d9",
                                                "sense_id": "0e3507da-e92a-303d-bcbb-962286017260",
                                                "text": "„Nach dessen Definition des Patrimonialismus ist die patrimoniale Herrschaft aus der patriarchalen Hausgemeinschaft, dem oikos, erwachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e31871a9-43cf-3b56-9f06-b560b70713d7",
                                        "entry_id": "f96b43e0-56e9-38c3-b19b-ef11907c6cfd",
                                        "glosses": [
                                            "auf den machterhaltenden Strukturen eines Alleinherrschers beruhend"
                                        ],
                                        "tags": [
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c817b838-1851-42cb-8b1a-a4bf17aaa727",
                                                "sense_id": "e31871a9-43cf-3b56-9f06-b560b70713d7",
                                                "text": "„Nach dessen Definition des Patrimonialismus ist die patrimoniale Herrschaft aus der patriarchalen Hausgemeinschaft, dem oikos, erwachsen.“"
                                            },
                                            {
                                                "example_id": "2fefb901-6fe6-4d44-a000-85d836214a31",
                                                "sense_id": "e31871a9-43cf-3b56-9f06-b560b70713d7",
                                                "text": "„Parallel zu dem formalen Herrschaftssystem begründete er jedoch ein patrimoniales System von Abhängigkeiten und Loyalitäten.“"
                                            },
                                            {
                                                "example_id": "131ed089-10f4-46b1-970e-e970527205f9",
                                                "sense_id": "e31871a9-43cf-3b56-9f06-b560b70713d7",
                                                "text": "„Allerdings, in Ländern mit patrimonialem Hintergrund und/oder patrimonialen Grundzügen, wie in Lateinamerika oder Südostasien, verstärkte diese Art der Inkorporation in die internationalen Systeme inhärente segregative Tendenzen.“"
                                            },
                                            {
                                                "example_id": "7545077f-8c50-4764-a2b1-027cbc8faedb",
                                                "sense_id": "e31871a9-43cf-3b56-9f06-b560b70713d7",
                                                "text": "„Sie regierten - Nawaz als PML-N-Oppositionsführer und Shahbaz als Chief Minister des Punjab - von 2008 bis 2013 genauso dynastisch und patrimonial wie die Bhuttos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
