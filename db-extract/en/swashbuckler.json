                                            {
                                                "example_id": "e0c8d447-f9f1-4156-9e5a-50711b495536",
                                                "sense_id": "753c86ff-c67d-3c4f-b7c7-c09a14044842",
                                                "text": "Szermierzy francuscy ulegli Włochom."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "80b3794c-3776-3b4f-89c1-e12817b672da",
                                        "entry_id": "46473284-9ffa-3d30-a634-15151b2d403c",
                                        "glosses": [
                                            "bojownik za jakąś sprawę czy ideę"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a1b59a-f411-49df-bf28-327e9496a163",
                                                "sense_id": "80b3794c-3776-3b4f-89c1-e12817b672da",
                                                "text": "Paweł był w liceum takim szermierzem równego traktowania uczniów."
