                    {
                        "translation_id": "2eae1565-ab40-47ae-b939-78e7c6732f6a",
                        "source_entry_id": "690efa56-b52e-3efd-a44f-6b85c6d838f6",
                        "source_sense_id": "6e869e61-a1e4-34ec-9f99-c5111de250a9",
                        "target_lang_word": "fall on",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fall on",
