                "senses": [
                    {
                        "sense_id": "602975d3-1167-3bdb-8451-a0c39309f253",
                        "entry_id": "e2e8355c-3823-36e4-85c6-ed07cde4932f",
                        "glosses": [
                            "Genre de champignons à lames, souvent petits, au chapeau conique ou en cloche, et au pied sans anneau, grêle, à spores blanches, grégaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6bd118-9659-492d-a3cb-bb9213da482e",
                                "sense_id": "602975d3-1167-3bdb-8451-a0c39309f253",
                                "text": "Du point de vue culinaire, les mycènes sont à rejeter car trop petits ou parfois même toxiques."
                            },
                            {
                                "example_id": "05aab307-1156-43d8-a7ce-e8ba1bdeef56",
                                "sense_id": "602975d3-1167-3bdb-8451-a0c39309f253",
                                "text": "Un mycène possède souvent un chapeau conique, mamelonné et fortement strié, et un pied long, fin et fragile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f3d30e2-6432-451c-8441-dbce2de5cdf6",
                        "source_entry_id": "e2e8355c-3823-36e4-85c6-ed07cde4932f",
                        "source_sense_id": "602975d3-1167-3bdb-8451-a0c39309f253",
                        "target_lang_word": "Helmlinge",
