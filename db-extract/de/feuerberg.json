                    {
                        "sense_id": "2534cdbd-9fc3-3234-829e-ab2adadb4414",
                        "entry_id": "a31fc24a-1c0c-3f72-9e49-6a2398d0718c",
                        "glosses": [
                            "Vulkan"
                        ],
