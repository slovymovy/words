                                    {
                                        "sense_id": "9698b577-e84a-3279-8c5a-6dfd407a99a4",
                                        "entry_id": "4ad7ffa6-1f59-3827-ae59-95727e1b8c2e",
                                        "glosses": [
                                            "světlomet vybavený zrcadlovou plochou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d515a19-d620-4cfc-a61c-9542cd48a94d",
                                                "sense_id": "9698b577-e84a-3279-8c5a-6dfd407a99a4",
                                                "text": "Lázně, které se brzy změní v sídlo galerie, osvětluje několik speciálních bodových reflektorů, umístěných na stožárech."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21d3b5e-126a-307b-a838-2d2fee84ac3d",
                                        "entry_id": "4ad7ffa6-1f59-3827-ae59-95727e1b8c2e",
                                        "glosses": [
                                            "zařízení určené ke směrování světla na fotografovaný předmět či scénu"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db5db280-698c-3801-b161-2250b7d07df9",
                                        "entry_id": "4ad7ffa6-1f59-3827-ae59-95727e1b8c2e",
                                        "glosses": [
                                            "zrcadlový dalekohled"
                                        ],
                                        "tags": [
                                            "v astronomii"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5322a6-b714-4659-ba7e-b17882f239a9",
                                                "sense_id": "db5db280-698c-3801-b161-2250b7d07df9",
                                                "text": "Reflektory využívají nikoliv zákonu lomu (jak je tomu u refraktorů), ale zákonu odrazu. Optické členy jsou totiž zrcadla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
