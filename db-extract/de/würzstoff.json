                                        "sense_id": "3215c1f6-d8a5-3bbd-8f20-1b8dc09cacb7",
                                        "entry_id": "836a682d-90a3-3831-a598-daa9321225b8",
                                        "glosses": [
                                            "Something used to add taste or flavour to food, such as salt and pepper or other condiment, herb or spice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
