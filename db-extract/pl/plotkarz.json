                    },
                    {
                        "translation_id": "5dd4b32d-eb57-4024-b9a7-1fb735f9e983",
                        "source_entry_id": "7530218f-064b-36f8-9bf3-435c0242c997",
                        "source_sense_id": "0105e329-11b6-39d3-938d-cc1a94cfe25f",
                        "target_lang_word": "flibbertigibbet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flibbertigibbet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19bcfc6c-6be4-3996-abc6-bf37b9de86d4",
                                        "entry_id": "a69578c5-5a5f-35c6-b7cd-54492affff72",
                                        "glosses": [
                                            "An offbeat, skittish person; especially said of a young woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d313e25-f423-4464-ac0a-7970386b5add",
                                                "sense_id": "19bcfc6c-6be4-3996-abc6-bf37b9de86d4",
                                                "text": "All this responsibility at such an early age made her a bitchy flibbertigibbet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f66a5d-986d-35b9-8c4b-309730df3a17",
                                        "entry_id": "a69578c5-5a5f-35c6-b7cd-54492affff72",
                                        "glosses": [
                                            "A flighty person; someone regarded as silly, irresponsible, or scatterbrained, especially someone who chatters or gossips."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f53b02-4241-47be-8e84-f4696197021d",
                                                "sense_id": "73f66a5d-986d-35b9-8c4b-309730df3a17",
                                                "text": "‘Ignorant girls. Dizzy young things. It seems to be my fate always to be landed with these flibbertigibbets.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb68da33-a14e-394f-99bf-54bf4c9d6ba6",
                                        "entry_id": "a69578c5-5a5f-35c6-b7cd-54492affff72",
                                        "glosses": [
                                            "An imp, a fiend."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10a8f3a7-8733-434c-beb6-361bc2b616af",
                        "source_entry_id": "7530218f-064b-36f8-9bf3-435c0242c997",
                        "source_sense_id": "0105e329-11b6-39d3-938d-cc1a94cfe25f",
                        "target_lang_word": "cancanier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cancanier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d220d61-3c98-37e6-a5f0-a23e6775fb6e",
                                        "entry_id": "c2b15551-5e4e-3329-ac9f-6ec62bedc2c0",
                                        "glosses": [
                                            "Qui aime à faire des cancans."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f5c2032-f87e-4957-b7fa-81862b3897a0",
                                                "sense_id": "9d220d61-3c98-37e6-a5f0-a23e6775fb6e",
                                                "text": "Claudie n’ayant plus guère d’autres rapports avec son ancien amant que le plaisir de babiller avec lui de temps en temps, et voyant qu’il s’amusait toujours de son caquet déluré, lui racontait avec complaisance tous les petits événements de la maison ; et Marsillat, qui aimait à tout savoir, la faisait servir à sa police particulière, sans qu’elle y entendît malice. Cette familiarité cancanière est tout à fait dans les mœurs bourgeoises du pays."
                                            },
                                            {
                                                "example_id": "9613f5bb-52aa-4603-8cfb-6bd68b4457fe",
                                                "sense_id": "9d220d61-3c98-37e6-a5f0-a23e6775fb6e",
                                                "text": "Elle n'est même pas méchante. Seulement, comme tant d'autres petites marchandes en boutique, elle est cancanière et curieuse. Elle voit des mystères partout."
                                            },
                                            {
                                                "example_id": "436f971a-ad12-467d-aef2-433df47c4cd5",
                                                "sense_id": "9d220d61-3c98-37e6-a5f0-a23e6775fb6e",
                                                "text": "Plus que l’opinion cancanière, l’instituteur redoute l’intime réaction d’Héloïse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cancanier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd8289ba-c751-3177-b001-f3670b5de4cc",
                                        "entry_id": "5a4ebe69-70d6-3019-beaa-c46dd26d25d6",
                                        "glosses": [
                                            "Celui qui aime à faire des cancans."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe30ff79-dc0d-4b65-ae89-3859bf5ff01d",
                                                "sense_id": "fd8289ba-c751-3177-b001-f3670b5de4cc",
                                                "text": "Quel cancanier !"
                                            },
                                            {
                                                "example_id": "9aa5265e-9ead-43ba-9d7a-afade9d05712",
                                                "sense_id": "fd8289ba-c751-3177-b001-f3670b5de4cc",
                                                "text": "C’est une cancanière."
                                            },
                                            {
                                                "example_id": "30b94854-ab09-4230-8793-b83e29707066",
                                                "sense_id": "fd8289ba-c751-3177-b001-f3670b5de4cc",
                                                "text": "C’est un cancanier malfaisant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
