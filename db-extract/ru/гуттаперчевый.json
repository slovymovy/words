                    },
                    {
                        "form_id": "6da6b447-4c66-4d47-ad63-ea4de7558cb9",
                        "entry_id": "dad3091f-a9aa-37eb-823e-2049e6ba1b88",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "гуттапе́рчевы"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a603b8d-3a5c-3e03-903b-fdaea52c5d8f",
                        "entry_id": "dad3091f-a9aa-37eb-823e-2049e6ba1b88",
                        "glosses": [
                            "относящийся к гуттаперче, сделанный из гуттаперчи; резиновый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "205a0b38-ec0d-4ca7-ae3d-091ce7fbfb96",
                                "sense_id": "3a603b8d-3a5c-3e03-903b-fdaea52c5d8f",
                                "text": "Вездесущий Альфонс Богданыч, как гуттаперчевый мяч, катался по всем комнатам…"
                            },
                            {
                                "example_id": "f4c48f9f-8dca-417a-ad0c-e86391cb70fc",
                                "sense_id": "3a603b8d-3a5c-3e03-903b-fdaea52c5d8f",
                                "text": "Жили они дружно; капитан приголубил прапорщика, поил и кормил его, а во время дождей даже прикрывал под своим единственным гуттаперчевым плащом."
                            }
                        ]
                    },
                    {
                        "sense_id": "99962efd-e5f1-372a-bcb6-bf7628d4d724",
                        "entry_id": "dad3091f-a9aa-37eb-823e-2049e6ba1b88",
                        "glosses": [
                            "перен. напоминающий свойствами гуттаперчу; гибкий, эластичный, растяжимый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7038956-b9c6-4395-9d53-59d49bbee0cb",
                                "sense_id": "99962efd-e5f1-372a-bcb6-bf7628d4d724",
                                "text": "Кныш выгнул в дугу гуттаперчевую спину и позволил себе улыбку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9fb1dbb-8c07-4f37-a095-42f8cd184729",
                        "source_entry_id": "dad3091f-a9aa-37eb-823e-2049e6ba1b88",
                        "target_lang_word": "gutta-percha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gutta-percha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00f86e02-4b03-3236-b3b9-68ef7f234ee8",
                                        "entry_id": "1b098fc1-e8ab-3e00-8acf-b34df700cff4",
                                        "glosses": [
                                            "An inelastic natural latex, produced from the sap of several tropical trees of the genera Palaquium and Payena."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8139531a-3894-4b31-9a0e-1bd90329c7ef",
                                                "sense_id": "00f86e02-4b03-3236-b3b9-68ef7f234ee8",
                                                "text": "No player shall be allowed to wear projecting nails, iron plates, or gutta percha on the soles or heels of his boots."
                                            },
                                            {
                                                "example_id": "2c95e957-c38a-4758-b8c3-a9e0a9ec372d",
                                                "sense_id": "00f86e02-4b03-3236-b3b9-68ef7f234ee8",
                                                "text": "Resin, pitch, sealing-wax, caoutchouc, sulphur, gutta-percha, and generally all bodies commonly termed resinous, besides a great variety of others, will be found to acquire, after friction, the power of attracting light bodies, and hence will be said, according to a limitation of terms already accepted, to be in an electrized or electrified state ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
