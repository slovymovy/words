                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e124950a-0ed6-4824-b63a-8d51b1995837",
                                                "sense_id": "b72ba1fb-3272-34bb-b452-736fd3d1a435",
                                                "text": "Der Ausweis wurde vorläufig eingezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c2a5f921-153b-3fe8-9858-91b4e3d50b1f",
                                        "entry_id": "827a9cb2-4d46-3f37-9339-18ed24073314",
                                        "glosses": [
                                            "etwas zurücknehmen, verbergen, schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531c2b2c-5a57-438e-b8c6-bc21ae819b62",
                                                "sense_id": "c2a5f921-153b-3fe8-9858-91b4e3d50b1f",
                                                "text": "Der Pilot muss nach dem Start das Fahrwerk einziehen."
                                            },
                                            {
                                                "example_id": "656102ec-30e9-420e-8a51-c91267a8c0e8",
                                                "sense_id": "c2a5f921-153b-3fe8-9858-91b4e3d50b1f",
                                                "text": "Wenn man eine Weinbergschnecke vorne berührt, zieht sie erst einmal ihre Fühler ein."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "46ba9024-d33b-383f-b79d-a84da85a48d0",
                                        "entry_id": "827a9cb2-4d46-3f37-9339-18ed24073314",
                                        "glosses": [
                                            "jemanden zum Militärdienst einberufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3766cd77-c9e0-47a5-a69c-8c0a8359cb45",
                                                "sense_id": "46ba9024-d33b-383f-b79d-a84da85a48d0",
                                                "text": "Zum Stichtag wurden wieder viele Rekruten eingezogen."
                                            },
                                            {
                                                "example_id": "86372f56-ccc3-4e81-a804-ba7aa4f55b88",
                                                "sense_id": "46ba9024-d33b-383f-b79d-a84da85a48d0",
                                                "text": "[Russlands Krieg gegen die Ukraine 2022:] „Offiziellen Angaben zufolge sollen 300.000 Bürger in die russische Armee eingezogen werden.“"
                                            },
                                            {
                                                "example_id": "c0de1bd6-748d-4d6f-ba79-523e3a78cda4",
                                                "sense_id": "46ba9024-d33b-383f-b79d-a84da85a48d0",
                                                "text": "„Heinz Erhardt wird zur Marine eingezogen; er muss zur Truppenbetreuung und dort seine Chansons und Gedichte vortragen. Auf diese Weise kommt er relativ gut durch die Kriegsjahre.“"
                                            }
                                        ],
