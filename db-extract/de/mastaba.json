                ],
                "senses": [
                    {
                        "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                        "entry_id": "a3063af4-bed4-360f-820b-560d95f9e2f8",
                        "glosses": [
                            "Grabbau von flacher, blockartiger Form aus Lehmziegeln oder Steinen mit rechteckigen Kammern"
                        ],
                        "tags": [
                            "altes",
                            "Ägypten"
                        ],
                        "examples": [
                            {
                                "example_id": "019101f1-b085-4440-8ed5-ed74db0ee76d",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Denen, die nicht in steinernen Festungen, sondern in Mastabas unter der Erde oder in einfachen Sandgräbern dörrten, wurde mehr Gerechtigkeit als den Herrschern."
                            },
                            {
                                "example_id": "a6469eda-9a95-41c7-a255-c8be2a0a60ec",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Ursprünglich war sie als klassische Mastaba geplant, dann aber, Stufe um Stufe nach oben und außen erweitert, bis die Form der Stufenpyramide geboren war."
                            },
                            {
                                "example_id": "c39d1a5d-bb15-4fa0-b5f5-bc7dce02e2b4",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Durch den Eingang und das schmale Vestibül gelangt man ins Zentrum der Mastaba: eine große Kammer mit vier Säulenpfeilern."
                            },
                            {
                                "example_id": "9e752dbd-a385-4bac-b2ba-961e78ef9f36",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Neben den berühmten Mastabas von Mereruka und Kagemni steht die Pyramide des Königs Teti."
                            },
                            {
                                "example_id": "16dc89a6-ceb8-42aa-83a6-47aa0086b395",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Unter dem zudeckenden Sand des Schweigens erblickte sie nach und nach in den palastartigen Mastaben der Beamten Reliefs von erhaltener roter Farbigkeit, bei Mereruka, Ti und anderen."
                            },
                            {
                                "example_id": "d6234ba3-9f36-40c0-ad54-eb24f50e3384",
                                "sense_id": "21f1ff50-7c05-3edd-9683-0f8f66d10ae4",
                                "text": "Neben seinem Amt als Hohepriester von Heliopolis unter Djoser und Sechemhet wirkte Imhotep als Architekt und als genialer Erfinder der Stufenpyramide. Sie besteht aus übereinander geschichteten Mastaben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
