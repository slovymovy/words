                "senses": [
                    {
                        "sense_id": "1c6f81e4-6966-3408-989b-82d383161431",
                        "entry_id": "115534b1-d994-3f76-83e4-a83f5843bd55",
                        "glosses": [
                            "Appareil médical, portable, destiné à mesurer la tension artérielle, inventé par le professeur V. Pachon vers 1909."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eff15e6-45be-40f8-b8b1-13fa5b871b95",
                                "sense_id": "1c6f81e4-6966-3408-989b-82d383161431",
                                "text": "De Martel endort toujours ses malades à l'éther ; et pendant toute l'intervention un Pachon est placé sur un des membres inférieurs, ce qui permet de prendre la tension avant l'opération, puis toutes les quelques minutes, une fois l'anesthésie obtenue."
                            },
                            {
                                "example_id": "ec0e47dd-2b81-494e-af1d-3662f0512ba9",
                                "sense_id": "1c6f81e4-6966-3408-989b-82d383161431",
                                "text": "Je me suis fait prêter un Pachon pour liquider les ennuyeux, pas mieux!… Vous les faites asseoir, vous leur prenez leur « tension »…"
                            }
                        ]
                    },
                    {
                        "sense_id": "04998890-f42a-32d3-9c8b-eec3584f4ce4",
                        "entry_id": "115534b1-d994-3f76-83e4-a83f5843bd55",
                        "glosses": [
                            "Nom donné souvent à tout type de sphygmomanomètre, même s'il ne s'agit pas du modèle du professeur Pachon, qui n'est plus actuellement utilisé."
                        ],
                        "tags": [],
                        "examples": []
                    }
