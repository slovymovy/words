                    },
                    {
                        "translation_id": "619bf0c5-5f10-4096-8e08-f17f596fa889",
                        "source_entry_id": "dec86bd8-1860-3af5-8b2d-9bdb942d28ee",
                        "source_sense_description": "грабитель",
                        "target_lang_word": "pillager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pillager",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f9bb6a7-acc8-3fc7-95c8-246d35a87678",
                                        "entry_id": "60bfc54e-8864-301e-a376-88fd9568add7",
                                        "glosses": [
                                            "A person who pillages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d31f83b-e364-4ee1-8fba-8e957d5ed761",
                                                "sense_id": "1f9bb6a7-acc8-3fc7-95c8-246d35a87678",
                                                "text": "...the hills of the robbers, predatorious oppreſſors of true Religion, pillagers and ſpoilers of the Church of Chriſt, of which too many ſad inſtances have been in ancient and later daies both at home and abroad."
                                            },
                                            {
                                                "example_id": "7820ba99-b23c-4aba-a8c0-b5961de43cd8",
                                                "sense_id": "1f9bb6a7-acc8-3fc7-95c8-246d35a87678",
                                                "text": "Wall labels, if you read them, will prepare you for the shift from the conventional picture of the terrible Turk, the ravisher, the torturer, the pillager (see T. E. Lawrence) and the Turk of the massacres (see Delacroix and others)."
                                            },
                                            {
                                                "example_id": "09289025-cb14-4466-a10a-522b82e3f397",
                                                "sense_id": "1f9bb6a7-acc8-3fc7-95c8-246d35a87678",
                                                "text": "And then there were those who died and were martyred in the struggle to maintain a Jewish lifestyle, murdered at the hands of deathmongers, pillagers […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57c3fd78-e2a9-49cf-be47-a1be89448e42",
                        "source_entry_id": "dec86bd8-1860-3af5-8b2d-9bdb942d28ee",
                        "source_sense_description": "грабитель",
                        "target_lang_word": "looter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "looter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f322cd56-8d51-3ba0-9a44-c4cdaa421b51",
                                        "entry_id": "04938bf7-80d4-3833-bfb2-745af2ab0071",
                                        "glosses": [
                                            "One who loots, who steals during a general disturbance such as a riot or natural disaster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "042e0c3f-2f99-4bcd-971d-db1ed278f2d2",
                                                "sense_id": "f322cd56-8d51-3ba0-9a44-c4cdaa421b51",
                                                "text": "After the hurricane, before law was restored, looters stole everything that wasn't nailed down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
