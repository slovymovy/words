{
    "word_family": [
        "spout"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5abafa0-2536-3ce4-964a-eeddf32673c0",
                    "sense_definition": "A gutter or channel installed under the eaves of a building to collect and direct rainwater.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "building_components",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spouting</w> was filled with dead leaves and needed to be cleaned out.",
                            "target_lang_translations": {
                                "cs": "<w>Okap</w> byl plný listí a bylo potřeba ho vyčistit."
                            }
                        },
                        {
                            "text": "Water trickles away from the roof into the <w>spouting</w> and down into the tank.",
                            "target_lang_translations": {
                                "cs": "Voda stéká ze střechy do <w>okapu</w> a dále do nádrže."
                            }
                        }
                    ],
                    "synonyms": [
                        "gutter",
                        "guttering"
                    ],
                    "common_phrases": [
                        "clean the spouting",
                        "leaking spouting"
                    ],
                    "target_lang_definitions": {
                        "cs": "Žlab nebo kanál instalovaný pod okapem budovy pro sběr a odvádění dešťové vody."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "okap",
                                "target_lang_sense_clarification": "běžné označení pro střešní žlab"
                            },
                            {
                                "target_lang_word": "střešní žlab",
                                "target_lang_sense_clarification": "technické označení pro odvodňovací prvek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42094026-6b06-3c93-b4bb-d088f7e74853",
                    "sense_definition": "The act or result of liquid or gas being ejected in a forceful stream or jet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spouting</w> of lava from the volcano was a truly terrifying sight to behold.",
                            "target_lang_translations": {
                                "cs": "<w>Tryskání</w> lávy ze sopky byl skutečně děsivý pohled."
                            }
                        },
                        {
                            "text": "We watched the whale's <w>spouting</w> from the deck of the boat as it swam past.",
                            "target_lang_translations": {
                                "cs": "Z paluby lodi jsme pozorovali, jak velryba <w>vystřikuje</w> vodu, když plavala kolem."
                            }
                        }
                    ],
                    "synonyms": [
                        "gush",
                        "spray",
                        "jet"
                    ],
                    "common_phrases": [
                        "whale spouting"
                    ],
                    "target_lang_definitions": {
                        "cs": "Proces nebo výsledek vytékání kapaliny či plynu silným proudem nebo tryskou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tryskání",
                                "target_lang_sense_clarification": "obecný výraz pro prudký výtok"
                            },
                            {
                                "target_lang_word": "vystřikování",
                                "target_lang_sense_clarification": "akce vyvržení kapaliny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5114c0d-4cff-37e5-afd6-536e08aea97a",
                    "sense_definition": "Propelled or ejected in a narrow, forceful stream or jet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ejection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spouting</w> water from the broken pipe flooded the entire basement floor.",
                            "target_lang_translations": {
                                "cs": "<w>Tryskající</w> voda z prasklého potrubí zaplavila celé podlaží suterénu."
                            }
                        },
                        {
                            "text": "He watched the <w>spouting</w> geyser erupt with incredible force against the clear blue sky.",
                            "target_lang_translations": {
                                "cs": "Sledoval <w>tryskající</w> gejzír, jak s neuvěřitelnou silou vybuchuje proti jasně modré obloze."
                            }
                        }
                    ],
                    "synonyms": [
                        "gushing",
                        "spraying"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vymrštěný nebo vyvržený úzkým, silným proudem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tryskající",
                                "target_lang_sense_clarification": "aktivní proudící kapalina"
                            },
                            {
                                "target_lang_word": "stříkající",
                                "target_lang_sense_clarification": "vytékající pod tlakem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}