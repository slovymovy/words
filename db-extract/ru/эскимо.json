                    },
                    {
                        "translation_id": "174cbd20-9c01-4c25-9174-70538ec80c24",
                        "source_entry_id": "53430e7b-4c46-39de-9d30-71bf06e144c2",
                        "source_sense_id": "3afd3950-212f-3544-a4f0-8180743e2cb3",
                        "target_lang_word": "Eis am Stiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eis am Stiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                        "entry_id": "e2c32f35-0c3f-32df-8fc1-2d175d1bda3e",
                                        "glosses": [
                                            "Speiseeisportion an einem (meist hölzernen) Stiel zum Verzehr direkt aus der Hand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1032945-4942-4320-8f2f-0f6a13764333",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„Es war einmal, lange vor ihrer Zeit, als ein großes Bier noch vierzig Pfennig kostete, ein Eis am Stiel dagegen zehn, weshalb man nie vier Eis am Stiel bestellte, ein guter praktischer Arzt namens Prof. Dr. Kurt Gröbe.“"
                                            },
                                            {
                                                "example_id": "f1e6ba41-c479-4c0c-ada5-4a4656fce46d",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„Sie verließen den Stall, bummelten durch die Sonne zum Abreiteplatz und kauften bei einem Eisverkäufer zwei Eis am Stiel.“"
                                            },
                                            {
                                                "example_id": "ff8427f6-1ef0-4e42-a0d7-16337c029545",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„Denn ein junger Mann mit zwei Eis am Stiel stürzte noch nach mir herein.“"
                                            },
                                            {
                                                "example_id": "e1e3576c-0eec-43a3-840d-10aa604ae656",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„Der Kerl im Eiswagen reichte den Jungen vor dem Fenster ihre Bestellungen hinaus: zwei Eis am Stiel und eine riesige Waffeltüte mit einem gedrehten Schokolade-und-Vanille-Softeiskegel für den großzügigen Spender in der Mitte, der anscheinend für alle zahlte.“"
                                            },
                                            {
                                                "example_id": "7b294cb9-519b-49f9-bddb-88bac6e3a006",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„Ich fragte mich, was wir dafür kaufen könnten, denn im Iran kosteten schon drei Eis am Stiel und eine Packung Kaugummis hundert Toman.“"
                                            },
                                            {
                                                "example_id": "1fefceb7-7fa3-4fd5-9126-a6d0fd5c0901",
                                                "sense_id": "55693077-dbcf-3dc1-b7dc-02f4f766fb0a",
                                                "text": "„400 kcal stecken etwa in einem Stück Cremtorte, einer großen Portion Schlagsahne, vier bis fünf Eis am Stiel oder in vier Glas Bier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "604a7fc8-16d2-4db0-b20e-7740f5db0659",
                        "source_entry_id": "53430e7b-4c46-39de-9d30-71bf06e144c2",
                        "source_sense_id": "3afd3950-212f-3544-a4f0-8180743e2cb3",
                        "target_lang_word": "esquimau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esquimau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                        "entry_id": "ca65a123-204a-3b77-b105-4cb2ed33ec6d",
                                        "glosses": [
                                            "Relatif au peuple habitant les terres arctiques du Groënland, du Canada, de l’Alaska et de la Sibérie ; à sa langue et sa culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52a8abaf-3df8-4efc-93f0-76b9b16e8fc9",
                                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                                "text": "C’est l’histoire d’un bébé esquimau qui deviendra grand et chasseur comme ses ancêtres […]"
                                            },
                                            {
                                                "example_id": "8f288ebb-1539-48f4-9f94-d8d82b265a31",
                                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                                "text": "Le petit village esquimau de Shishmaref posé sur un îlot aux confins de l’Alaska s’enfonce dans la mer un peu plus chaque année, victime du réchauffement climatique, et doit déménager sur le continent, au risque de perdre son identité."
                                            },
                                            {
                                                "example_id": "986b6d66-9497-40ce-9ee1-8b5624da666e",
                                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                                "text": "Mrs. Paulina Barnett et Madge les suivaient, Madge maniant avec adresse le long fouet esquimau terminé par une lanière de nerf durci."
                                            },
                                            {
                                                "example_id": "359bffd8-aa02-43f4-b241-62c725a3b8c6",
                                                "sense_id": "d1f9e451-42ad-3f3b-bb2c-e4026a3b2a00",
                                                "text": "Aussi le facteur de saisonnalité qui semble être le moteur de ces déplacements supposés est, en particulier depuis les travaux de M. Mauss sur les sociétés esquimaudes au début du siècle (Mauss, 1906), un axe de recherche important de l’archéologie paléolithicienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esquimau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9c280cb-dfa0-3b9a-bfc6-da79b6466d8f",
                                        "entry_id": "e4dc62c7-6744-368b-b19c-825c9bf95246",
                                        "glosses": [
                                            "N’importe quelle langue parlée par les Esquimaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e46f92-c0cd-4f4e-94e1-f494fc019fae",
                                                "sense_id": "e9c280cb-dfa0-3b9a-bfc6-da79b6466d8f",
                                                "text": "Or, dans ce film, les acteurs parlent esquimau. Admettons quelque truquage, que nous sommes incapables de déceler. Les acteurs, le fait est là, parlent une langue incompréhensible, qui ne nous gène à aucun moment."
                                            },
                                            {
                                                "example_id": "c07743b9-2fc9-407a-b60f-2fc1bc821204",
                                                "sense_id": "e9c280cb-dfa0-3b9a-bfc6-da79b6466d8f",
                                                "text": "Personne de nous ne comprend un mot d’esquimau. Inutile d’ajouter que pour leur part nos deux naturels n’ont aucune idée d’un idiome européen."
                                            },
                                            {
                                                "example_id": "827f2f0c-38b5-46eb-9764-293a8e522057",
                                                "sense_id": "e9c280cb-dfa0-3b9a-bfc6-da79b6466d8f",
                                                "text": "De plus, l’apprentissage de la langue m’était facilité par la bienveillante coopération du gérant de la Compagnie de la Baie d’Hudson, qui parlait l’esquimau et l’anglais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esquimau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d51c406d-6c20-37b1-b50f-2a6c3beac65c",
                                        "entry_id": "44b88b94-4ddc-3205-a91f-fa224abd96f3",
                                        "glosses": [
                                            "Bâtonnet de glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954855bf-7072-4532-ab25-9c4421c03d36",
                                                "sense_id": "d51c406d-6c20-37b1-b50f-2a6c3beac65c",
                                                "text": "À quatre heures, entracte. « Esquimaux ! Bonbons acidulés ! Pastilles de menthe ! » Les ouvreuses en mettent un coup, les rapaces, pour nous pomper les derniers sous au fond de la poche avec leurs friandises, […]"
                                            },
                                            {
                                                "example_id": "2d8070a4-111e-4fdd-87f6-d43294d89e16",
                                                "sense_id": "d51c406d-6c20-37b1-b50f-2a6c3beac65c",
                                                "text": "Un esquimau au chocolat."
                                            },
                                            {
                                                "example_id": "5f68dbe8-da0f-472d-a238-a8c5131538db",
                                                "sense_id": "d51c406d-6c20-37b1-b50f-2a6c3beac65c",
                                                "text": "Un petit garçon de trois ou quatre ans vint se planter devant elle, pendant qu’Aimery parlait. Il suçait un esquimau Gervais, et il bavait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "400a922b-c6a4-3bf8-9c33-3ee1302170a2",
                                        "entry_id": "44b88b94-4ddc-3205-a91f-fa224abd96f3",
                                        "glosses": [
                                            "Chose gelée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b075b58c-155d-4b27-97ee-1284407789f7",
                                                "sense_id": "400a922b-c6a4-3bf8-9c33-3ee1302170a2",
                                                "text": "17 janvier 1941 – Elle a accepté de chauffer mon lit, jambes allongées jusque dans les recoins. Elle a même accepté d’y rester une heure avec moi, à condition de ne pas rencontrer les esquimaux Gervais que j’ai au bout des jambes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eaffed05-8b94-3789-88a0-949d53895b92",
                                        "entry_id": "44b88b94-4ddc-3205-a91f-fa224abd96f3",
                                        "glosses": [
                                            "Vêtement chaud pour enfant d’une pièce rassemblant le pantalon, le chandail et le bonnet rappelant dans une certaine mesure le costume des Esquimaux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
