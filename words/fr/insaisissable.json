    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3102fb19-1389-3d35-acf9-b3adaa3e2b12",
                    "sense_definition": "Qu'on ne peut pas attraper ou saisir physiquement, qui échappe à toute capture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voleur reste <w>insaisissable</w> malgré les efforts constants de la police pour le capturer."
                        },
                        {
                            "text": "Ce papillon vole si vite d'une fleur à l'autre qu'il semble totalement <w>insaisissable</w>."
                        }
                    ],
                    "synonyms": [
                        "inatteignable",
                        "introuvable",
                        "fugitif"
                    ],
                    "antonyms": [
                        "saisissable"
                    ]
                },
                {
                    "sense_id": "1ca48c84-bf87-3936-9279-2666efde9bff",
                    "sense_definition": "Difficile ou impossible à percevoir nettement, à définir ou à comprendre par l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sens profond de ce poème demeure mystérieux et <w>insaisissable</w> pour la plupart des lecteurs."
                        },
                        {
                            "text": "Elle avait une nuance <w>insaisissable</w> d'ironie dans son regard pendant toute la discussion."
                        }
                    ],
                    "synonyms": [
                        "impalpable",
                        "imperceptible",
                        "indéfinissable"
                    ],
                    "antonyms": [
                        "évident",
                        "compréhensible",
                        "saisissable"
                    ],
                    "common_phrases": [
                        "une nuance insaisissable",
                        "un charme insaisissable",
                        "une vérité insaisissable"
                    ]
                },
                {
                    "sense_id": "c692c337-e480-35a7-bfdc-b4ba51151750",
                    "sense_definition": "Se dit d'une personne perpétuellement occupée ou fuyante qu'il est impossible de joindre ou de rencontrer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai essayé de l'appeler toute la semaine mais elle est devenue totalement <w>insaisissable</w>."
                        },
                        {
                            "text": "Notre directeur est un homme <w>insaisissable</w> qui voyage sans cesse d'un bureau à l'autre."
                        }
                    ],
                    "synonyms": [
                        "injoignable",
                        "fuyant"
                    ],
                    "antonyms": [
                        "joignable",
                        "accessible"
                    ]
                },
                {
                    "sense_id": "88f384d1-da2b-35a2-bd8c-21f119dd5a50",
                    "sense_definition": "Qui ne peut légalement faire l'objet d'une saisie judiciaire.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La loi prévoit qu'une partie du salaire reste <w>insaisissable</w> pour couvrir les dépenses vitales."
                        },
                        {
                            "text": "Le tribunal a confirmé que les biens de première nécessité étaient absolument <w>insaisissables</w>."
                        }
                    ],
                    "antonyms": [
                        "saisissable"
                    ],
                    "common_phrases": [
                        "un bien insaisissable",
                        "une pension insaisissable"
                    ]
                }
            ]
        }
    ]
}