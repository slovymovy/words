                            {
                                "example_id": "0e4be60d-60d5-41ad-b535-9aa9c61e5c04",
                                "sense_id": "160670fc-d9f2-382f-8e3b-82d18ccaa87c",
                                "text": "А речи, крики так громки, так волнующе свежи, так увлекательны неподдельной искренностью!"
                            }
                        ]
