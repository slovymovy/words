                "senses": [
                    {
                        "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                        "entry_id": "416e4b00-0508-39d8-a1f3-60feb2d6a0a8",
                        "glosses": [
                            "mit einem Telefon ausgestattete Kabine im öffentlichen Raum"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "e0c29c0c-46d1-4fd6-976b-08cbc5f6f142",
                                "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                                "text": "„Telefone für den Hausgebrauch setzten sich erst im späten 20. Jahrhundert durch, bis dahin wurden in den \"Fernsprechhäuschen\" Liebesdramen durchlebt oder Kriminalfälle gelöst.“"
                            },
                            {
                                "example_id": "9c3224a6-9d88-47d3-bb41-0410242c8393",
                                "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                                "text": "„Die einst so beliebten öffentlichen Fernsprechhäuschen, das erste wurde 1881 in Berlin aufgestellt, werden nach und nach abgebaut.“"
                            },
                            {
                                "example_id": "2834f30c-d4b2-407c-9080-1d07b798413d",
                                "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                                "text": "„Auf dem Dorfanger, zwischen der alten Dorfkirche, dem Gasthof Alter Dorfkrug und dem Veranstaltungs- und Kulturhaus Labsaal, entstand dann dieser Schnappschuss vom Fernsprechhäuschen.“"
                            },
                            {
                                "example_id": "ca7a1904-a5eb-407c-a66d-8e2f76330bb4",
                                "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                                "text": "„Derzeit gebe es öffentliche Telefone noch an 60.000 Standorten, die Hälfte davon in Fernsprechhäuschen, sagte ein Sprecher der Deutschen Telekom der Mitteldeutschen Zeitung.“"
                            },
                            {
                                "example_id": "a1ab1d5e-2b86-427e-a09f-74c342d9cdc8",
                                "sense_id": "12c80e2b-b305-31b3-96fa-fcc58c7e0446",
                                "text": "„Die Fernsprechhäuschen - so die 1927 amtlich festgelegte Bezeichnung - sind dem Siegeszug der Handys zum Opfer gefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
