                        "sense_id": "ad72e1d0-2c3a-313d-9e21-48fa0878c363",
                        "entry_id": "478c9b98-c1cf-3578-af6b-15358b097cef",
                        "glosses": [
                            "Luft-Kraftstoffverhältnis bei Verbrennungsprozessen"
