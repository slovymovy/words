                ],
                "senses": [
                    {
                        "sense_id": "c9c26db5-b745-3236-8e61-a51bd638d318",
                        "entry_id": "c05d9739-f7e7-307c-a806-880a27524d5d",
                        "glosses": [
                            "Dont on a enlevé la tête, la partie haute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bc537d-1fd1-479f-9a10-d3385a74991b",
                                "sense_id": "c9c26db5-b745-3236-8e61-a51bd638d318",
                                "text": "Le collège dont je briguerai les suffrages se trouve dans une terre ondulée et boisée, où des saules étêtés bordent les champs. Et il n’est pas rare de trouver au creux d’un de ces vieux saules le squelette d’un chouan, pressant encore son fusil et son chapelet entre ses doigts décharnés."
                            },
                            {
                                "example_id": "ad014318-0d3c-4142-a07f-5e80c3787b7a",
                                "sense_id": "c9c26db5-b745-3236-8e61-a51bd638d318",
                                "text": "Ces chênes sont de tout âge et de toute forme, amples et élancés, parfois étêtés et trapus, mais d’une verdeur incomparable."
                            },
                            {
                                "example_id": "d1dab46b-0d7f-4597-b2ed-8aee67cf6c4f",
                                "sense_id": "c9c26db5-b745-3236-8e61-a51bd638d318",
                                "text": "Les berges fuyaient de chaque côté d’un mouvement monotone, laissant apercevoir dans la profondeur des prairies inondées des saules étêtés qui levaient leurs têtes difformes."
                            }
                        ]
                    }
                ],
