{
    "word_family": [
        "bal",
        "gebal",
        "balspel",
        "voetballen",
        "handballen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf30878c-2f5d-300b-8a4b-b5045c2f731b",
                    "sense_definition": "Meervoud van <w>bal</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "objecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen spelen buiten met verschillende <w>ballen</w> in de tuin.",
                            "target_lang_translations": {
                                "ru": "Дети играют в саду с разными <w>мячами</w>."
                            }
                        },
                        {
                            "text": "In de mand liggen drie rode <w>ballen</w> voor de hond.",
                            "target_lang_translations": {
                                "ru": "В корзине лежат три красных <w>мячика</w> для собаки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова bal (мяч, шар)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мячи",
                                "target_lang_sense_clarification": "спортивный инвентарь"
                            },
                            {
                                "target_lang_word": "шары",
                                "target_lang_sense_clarification": "круглые предметы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0398723f-c6b3-3c1b-8d89-af6dc563459f",
                    "sense_definition": "Grote mate van durf, moed of brutaliteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet echt <w>ballen</w> hebben om dat tegen de directeur te zeggen.",
                            "target_lang_translations": {
                                "ru": "Нужно иметь настоящие <w>яйца</w>, чтобы сказать такое директору."
                            }
                        },
                        {
                            "text": "Hij toonde veel <w>ballen</w> door alleen die gevaarlijke reis te maken.",
                            "target_lang_translations": {
                                "ru": "Он проявил большую <w>смелость</w>, отправившись в это опасное путешествие в одиночку."
                            }
                        }
                    ],
                    "synonyms": [
                        "lef",
                        "moed",
                        "branie",
                        "durf"
                    ],
                    "antonyms": [
                        "lafheid"
                    ],
                    "common_phrases": [
                        "ballen tonen",
                        "ballen hebben"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая степень смелости, мужества или дерзости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яйца",
                                "target_lang_sense_clarification": "в значении мужества, сленг"
                            },
                            {
                                "target_lang_word": "смелость",
                                "target_lang_sense_clarification": "отсутствие страха"
                            },
                            {
                                "target_lang_word": "дух",
                                "target_lang_sense_clarification": "сила воли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd1deefd-7b8f-3a17-92e0-4d2b358e1475",
                    "sense_definition": "Iets tot een ronde vorm samenpersen of knijpen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>balde</w> zijn vuist van woede toen hij het nieuws hoorde.",
                            "target_lang_translations": {
                                "ru": "Он <w>сжал</w> кулак от ярости, когда услышал новости."
                            }
                        },
                        {
                            "text": "De jongen <w>balde</w> de sneeuw tot een stevige sneeuwbal.",
                            "target_lang_translations": {
                                "ru": "Мальчик <w>скатал</w> снег в плотный снежок."
                            }
                        }
                    ],
                    "synonyms": [
                        "samenballen"
                    ],
                    "common_phrases": [
                        "vuist ballen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжимать что-либо, придавая круглую форму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "например, кулак"
                            },
                            {
                                "target_lang_word": "скатывать",
                                "target_lang_sense_clarification": "например, снежок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "018482a6-8214-3cee-bd02-863ce09691e7",
                    "sense_definition": "Een spel spelen waarbij een bal wordt gebruikt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na schooltijd gingen de jongens nog even lekker <w>ballen</w> op het pleintje.",
                            "target_lang_translations": {
                                "ru": "После школы ребята пошли немного <w>погонять мяч</w> на площадке."
                            }
                        },
                        {
                            "text": "We hebben de hele middag staan <w>ballen</w> bij het basketbalveldje.",
                            "target_lang_translations": {
                                "ru": "Мы весь день <w>играли в мяч</w> на баскетбольной площадке."
                            }
                        }
                    ],
                    "synonyms": [
                        "voetballen",
                        "basketballen"
                    ],
                    "common_phrases": [
                        "lekker ballen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor informeel sporten"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Играть в игру с использованием мяча."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонять мяч",
                                "target_lang_sense_clarification": "неформально играть в футбол или баскетбол"
                            },
                            {
                                "target_lang_word": "играть в мяч",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2104e25-fdd7-387d-a6b7-b2d2c1fcef51",
                    "sense_definition": "Het hebben van geslachtsgemeenschap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seksualiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze lagen de hele nacht te <w>ballen</w> in de hotelkamer.",
                            "target_lang_translations": {
                                "ru": "Они всю ночь <w>трахались</w> в гостиничном номере."
                            }
                        },
                        {
                            "text": "Hij vertelde zijn vrienden dat hij die avond wilde gaan <w>ballen</w>.",
                            "target_lang_translations": {
                                "ru": "Он сказал друзьям, что хочет <w>переспать</w> с кем-нибудь в тот вечер."
                            }
                        }
                    ],
                    "synonyms": [
                        "neuken",
                        "vozen",
                        "wippen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "plat of informeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вступать в половую связь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трахаться",
                                "target_lang_sense_clarification": "грубый сленг"
                            },
                            {
                                "target_lang_word": "переспать",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}