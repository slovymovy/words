            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b29b60e-27cf-341a-b16e-1960cec476fa",
                    "sense_definition": "vervelend gedrag, ruzie of gedoe dat als ongewenst en ergerlijk wordt ervaren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is dat <w>gedonder</w> nou nog niet afgelopen tussen jullie twee?",
                            "target_lang_translations": {
                                "en": "Is that <w>trouble</w> between the two of you still not over?"
                            }
                        },
                        {
                            "text": "Ik heb geen zin in al dat <w>gedonder</w> op mijn werk vandaag.",
                            "target_lang_translations": {
                                "en": "I don't feel like dealing with all that <w>hassle</w> at work today."
                            }
                        }
                    ],
                    "synonyms": [
                        "gezeur",
                        "gedoe",
                        "geharrewar",
                        "ruzie",
                        "heibel",
                        "problemen"
                    ],
                    "antonyms": [
                        "rust",
                        "vrede"
                    ],
                    "common_phrases": [
                        "altijd hetzelfde gedonder",
                        "ophouden met dat gedonder"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "annoying behavior, conflict, or hassle that is perceived as unwanted and irritating"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "general conflict or problems"
                            },
                            {
                                "target_lang_word": "hassle",
                                "target_lang_sense_clarification": "annoying inconvenience"
                            },
                            {
                                "target_lang_word": "fuss",
                                "target_lang_sense_clarification": "unnecessary excitement or activity"
                            },
                            {
                                "target_lang_word": "bickering",
                                "target_lang_sense_clarification": "petty arguing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "644310ab-74c2-33c0-91be-69efc08c49eb",
                    "sense_definition": "het aanhoudende geluid van donderslagen tijdens een onweersbui",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik hoorde <w>gedonder</w> in de verte; ik hoop niet dat we een bui gaan krijgen.",
                            "target_lang_translations": {
                                "en": "I heard <w>rumbling</w> in the distance; I hope we're not going to get a shower."
                            }
                        },
                        {
                            "text": "Het zachte <w>gedonder</w> in de lucht kondigde de naderende storm aan.",
                            "target_lang_translations": {
                                "en": "The soft <w>thundering</w> in the sky announced the approaching storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "gedreun",
                        "gerommel"
                    ],
                    "antonyms": [
                        "stilte"
                    ],
                    "common_phrases": [
                        "gedonder in de verte"
                    ],
                    "target_lang_definitions": {
                        "en": "the continuous sound of thunderclaps during a thunderstorm"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rumbling",
                                "target_lang_sense_clarification": "continuous low sound of thunder"
                            },
                            {
                                "target_lang_word": "thundering",
                                "target_lang_sense_clarification": "the sound of thunder"
                            }
                        ]
                    }
                }
            ]
        }
    ]
