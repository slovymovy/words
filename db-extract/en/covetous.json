                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
                                                "text": "Der Pirat starrte gierig auf die Schätze."
                                            },
                                            {
                                                "example_id": "ca0167e2-23bb-4c68-bb3f-2db963b21e8a",
                                                "sense_id": "c8b1f37f-8152-3507-b273-dd50c1a6997e",
