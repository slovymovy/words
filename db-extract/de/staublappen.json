                "senses": [
                    {
                        "sense_id": "d3ebbf3a-5c3f-3a51-8fae-a3a82069b270",
                        "entry_id": "c58a5dd0-02bf-3350-9958-92d979111b2d",
                        "glosses": [
                            "kleineres, weiches Stück Stoff zum Entfernen von Staub"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f997390f-d874-49a6-a2c2-0fda20a2ac64",
                                "sense_id": "d3ebbf3a-5c3f-3a51-8fae-a3a82069b270",
                                "text": "Bevor seine Mutter zu Besuch kam, ging er noch schnell mit dem Staublappen über alle sichtbaren Flächen in seiner Wohnung."
                            },
                            {
                                "example_id": "a17afa24-f9bd-4c57-8147-3dae0c31037f",
                                "sense_id": "d3ebbf3a-5c3f-3a51-8fae-a3a82069b270",
                                "text": "„Beinah trotzig stand sie vor mir in Faltenrock und Bluse, Hände in die Hüften gestützt, unterm Arm die Einkaufstasche, darin verborgen frischgewaschene Aufnehmer, Staublappen und der Putzkittel.“"
                            },
                            {
                                "example_id": "a7c04124-e052-45b7-ae14-5c6ec3cf6369",
                                "sense_id": "d3ebbf3a-5c3f-3a51-8fae-a3a82069b270",
                                "text": "„Der aufgeräumte, saubere Schrank (irgend jemand war sogar mit dem Staublappen drübergegangen) war das Schlimmste, was sie mir hinterlassen konnte, ordentlich, getrennt, ihre Sachen von meinen geschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
