                    }
                ],
                "senses": [
                    {
                        "sense_id": "40e20b20-2c5e-39a5-8316-7bbf7623b6c5",
                        "entry_id": "55579414-b5f1-3a00-a90a-b3686d0c3087",
                        "glosses": [
                            "kleines, bärtiges, barfüßiges, helfendes Wesen, das in einem Schrazloch haust und den Menschen nicht mehr geschaffte Arbeiten über Nacht erledigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fc3c8d1-ed20-427c-81cc-152b17edc498",
                                "sense_id": "40e20b20-2c5e-39a5-8316-7bbf7623b6c5",
                                "text": "Die Stube sah aus, als hätte ein Waldschrat darin gehaust."
                            },
                            {
                                "example_id": "d9d4972d-030f-4944-bf04-e65e8acc9e96",
                                "sense_id": "40e20b20-2c5e-39a5-8316-7bbf7623b6c5",
                                "text": "„Der Mann hat aber auch gar nichts Militärisches: O-beinig, kleinwüchsig, stoppelbärtig, schiefe Schultern und ein leichter Buckel – so gleicht er eher einem Waldschrat als einem Soldten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6c6cb57e-2e21-331a-8ccd-01a22109ac4f",
                        "entry_id": "55579414-b5f1-3a00-a90a-b3686d0c3087",
                        "glosses": [
                            "hässlicher oder unordentlich aussehender Mann"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "edea3a3d-9718-4ee1-ad98-816b24bcf6cc",
                                "sense_id": "6c6cb57e-2e21-331a-8ccd-01a22109ac4f",
                                "text": "„Der Mann hat aber auch gar nichts Militärisches: O-beinig, kleinwüchsig, stoppelbärtig, schiefe Schultern und ein leichter Buckel – so gleicht er eher einem Waldschrat als einem Soldten.“"
                            },
                            {
                                "example_id": "b52c0a0b-8def-41c8-8011-46e67d49adec",
                                "sense_id": "6c6cb57e-2e21-331a-8ccd-01a22109ac4f",
                                "text": "Was ist denn das für ein Waldschrat!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
