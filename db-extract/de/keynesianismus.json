                    {
                        "sense_id": "6d499bbb-d01a-3af0-8141-682b6cc12e36",
                        "entry_id": "952de415-cc44-3a7b-869f-3b602921af9a",
                        "glosses": [
                            "nachfrageorientierte Wirtschaftstheorie, die in den 1930er Jahren von John Maynard Keynes aufgestellt und später weiterentwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3144c3-23fa-4020-bfed-1cac64e3bbea",
                                "sense_id": "6d499bbb-d01a-3af0-8141-682b6cc12e36",
                                "text": "Anhänger des Keynesianismus stärken in Zeiten wirtschaftlicher Flaute die Nachfrage."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "112c5081-5bed-47cc-9efb-6336d0b7882a",
                        "source_entry_id": "952de415-cc44-3a7b-869f-3b602921af9a",
                        "source_sense_id": "6d499bbb-d01a-3af0-8141-682b6cc12e36",
