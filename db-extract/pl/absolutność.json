                "translations": [
                    {
                        "translation_id": "7e7438e7-0e6b-4e77-bc2c-d0a7184c13a7",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "ed6ee95e-3b41-3f6a-9804-a9c96a31b412",
                        "source_sense_description": "Philosophie: Absolutheit",
                        "target_lang_word": "Absolutheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolutheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                                        "entry_id": "9f07bb41-8dca-3f94-8da6-5bb490731529",
                                        "glosses": [
                                            "die absolute Beschaffenheit einer Sache, das Absolutsein einer Sache"
                                        ],
                                        "tags": [
                                            "Plural selten",
                                            "meist Philosophie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91ac225e-1376-46f2-bd32-a5cb41deff3f",
                                                "sense_id": "40889b90-83d9-3451-8a60-55e3fd469dba",
                                                "text": "„Der Wertrelativismus erkennt eine Absolutheit der Werte nicht an, sondern knüpft deren Gültigkeit an bestimmte Menschen, Gemeinschaften, Kulturen (Kulturrelativismus) oder Epochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84e9ac10-900c-4e30-bdbc-7677b73b0d83",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "ed6ee95e-3b41-3f6a-9804-a9c96a31b412",
                        "source_sense_description": "Philosophie: Absolutheit",
                        "target_lang_word": "absoluteness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absoluteness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bce03098-16b2-3b30-8438-d4b726f8f4ab",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The fact of being finished or perfected; completeness."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The characteristic of being absolute in nature or scope."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87f69207-a042-447c-b9d6-bcd5c7d2c88f",
                                                "sense_id": "6536ff1a-dabf-3db8-ad47-dfcf1d4087c0",
                                                "text": "the absoluteness of his sovereignty, the absoluteness of his convictions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "Absolute authority, unlimited power; absolutism, despotism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a7d1f66-e821-4544-b55c-9aaf8f485c0d",
                                                "sense_id": "d48d33c1-0c28-3e45-ae47-e71d4e822f15",
                                                "text": "I know no man that could produce more parts, both naturall and artificiall, fit to preserve his masterie, and to maintaine his absolutenesse, than he doth; yet is hee cleane falne from them like a childe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21a76717-ff90-39e1-9382-2da24bd37376",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "The fact of being without qualifications or conditions; certainty, unconditionality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "516859fd-3799-3b72-95ae-b73ea14f3282",
                                        "entry_id": "ff2f7ff0-1f1f-35ac-ae9a-4e3b848949c6",
                                        "glosses": [
                                            "Independent autonomy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22b50750-0ff2-4851-8bee-1bc96bc5031f",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "45ea8a2a-9389-3caf-9fd6-fc9c545078db",
                        "source_sense_description": "veraltet, Politik: Unabhängigkeit, Selbstbestimmung",
                        "target_lang_word": "Unabhängigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unabhängigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                        "entry_id": "b785c96c-8842-362b-92dc-d63206665e73",
                                        "glosses": [
                                            "Zustand, auf niemanden (keine Person, keine Institution) angewiesen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d0c6ff2-121c-4529-9062-f313e02c0e85",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "Ich tue viel für die Unabhängigkeit von meinen Eltern."
                                            },
                                            {
                                                "example_id": "10da4b30-caae-4334-9b22-f82e0dce52b2",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "Auch in der parteipolitischen Arbeit ist es angebracht, seine Unabhängigkeit zu bewahren."
                                            },
                                            {
                                                "example_id": "550ee359-934f-4c7f-afe4-19d991e75175",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "„Damit hatte Woolf sich eine schriftstellerische Unabhängigkeit erobert, die für die wachsende Selbstbestimmung der Frau exemplarisch sein sollte.“"
                                            },
                                            {
                                                "example_id": "542789a5-a780-4fa3-abe7-1879c44a8c45",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "„Mit meiner Veranlagung habe ich aber vielleicht gut daran getan, mich nicht unwiderruflich zu binden, obwohl die Unabhängigkeit in meinem Alter eine Art von Sklaverei ist.“"
                                            },
                                            {
                                                "example_id": "9f21a8d9-48e4-41a7-bacc-64732200c8b5",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "„Unabhängigkeit von jedermann war das Fundament, auf dem sein inneres Glücksgefühl erwuchs, ein Gefühl der Freiheit und Rechtschaffenheit, das allein möglich wurde durch Sparsamkeit und Regelmäßigkeit, mit denen er seine ökonomischen Verhältnisse in Ordnung hielt.“"
                                            },
                                            {
                                                "example_id": "820e4528-bbc4-4e06-8a9b-08d778c3b3a1",
                                                "sense_id": "e958ab48-50c6-33dc-add9-0f6eb96fddba",
                                                "text": "„Auch die relative wirtschaftliche Unabhängigkeit kann darunter leiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                        "entry_id": "b785c96c-8842-362b-92dc-d63206665e73",
                                        "glosses": [
                                            "politische Souveränität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f4d2e3-8187-4b3f-b7a7-8e10fa9b3a8c",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "Manche Staaten entstehen neu, indem sie ihre Unabhängigkeit erklären."
                                            },
                                            {
                                                "example_id": "9f204d83-e46d-486a-9a77-b919696bc500",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "„Portugal erkannte drei Jahre später die Unabhängigkeit an, nachdem die Exkolonie eingewilligt hatte, die Schulden des verarmten Mutterlandes zu begleichen: zwei Millionen Pfund Sterling.“"
                                            },
                                            {
                                                "example_id": "ed003c7c-b3eb-4ca7-8c9b-48d2fa27c827",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "Die Unabhängigkeit Jamaikas wurde 1738 anerkannt."
                                            },
                                            {
                                                "example_id": "d906eec5-fbd6-4b2a-85a6-bcb2c16f681a",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "„Erst 1830 hat sich Belgien mit einem Aufstand gegen die nördlichen Niederlande die Unabhängigkeit erkämpft.“"
                                            },
                                            {
                                                "example_id": "8efb3577-3480-49b4-8e4e-64741ed74f98",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "Das schottische Parlament in Edinburgh hat für eine erneute Volksabstimmung über die Unabhängigkeit von Großbritannien gestimmt."
                                            },
                                            {
                                                "example_id": "5a007b1c-eeca-4ec6-9b1f-99015d53c62f",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "„Die Unabhängigkeit wurde nicht gewonnen, die wurde geschenkt und war historisch lange überfällig und unausweichlich.“"
                                            },
                                            {
                                                "example_id": "4bf77bb5-5215-4e02-9791-76d49ae5c75e",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "„Finnland bekam seine Fahne mit Erlangen der Unabhängigkeit von Russland 1917.“"
                                            },
                                            {
                                                "example_id": "537007a4-177c-4a09-a17f-ee68ecd1f389",
                                                "sense_id": "35a08e42-7d50-3e6a-92dc-35b79fcd5077",
                                                "text": "„Russland attackiert die Ukraine - dabei geht es im Kern darum, dass Moskau die Unabhängigkeit Kiews nicht akzeptiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b8f4d10-7309-32d0-aa91-2f5325f54627",
                                        "entry_id": "b785c96c-8842-362b-92dc-d63206665e73",
                                        "glosses": [
                                            "Zustand, bei dem etwas oder jemand von etwas anderem oder jemand anderem nicht beeinflusst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edc3ce8c-9d99-441e-bfe3-3bef173f9992",
                                                "sense_id": "4b8f4d10-7309-32d0-aa91-2f5325f54627",
                                                "text": "Die Auswahl der Teilnehmer erfolgt in Unabhängigkeit von Alter und formaler Ausbildung, einziges Kriterium ist die eingereichte Arbeitsprobe."
                                            },
                                            {
                                                "example_id": "6d60e67a-ceea-4c56-9138-d11d040c89c4",
                                                "sense_id": "4b8f4d10-7309-32d0-aa91-2f5325f54627",
                                                "text": "Die Unabhängigkeit unserer Wunschvorstellungen von der Realität ist manchmal schon erstaunlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54f53bb8-de85-44b9-9c0b-a50f4be6a400",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "45ea8a2a-9389-3caf-9fd6-fc9c545078db",
                        "source_sense_description": "veraltet, Politik: Unabhängigkeit, Selbstbestimmung",
                        "target_lang_word": "Selbstbestimmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstbestimmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "Verfügung einer Person oder eines Landes über die eigene Existenz; Freiheit in der persönlichen Willensbildung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0fa38d1-97df-4696-90e3-ce594c0688bf",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Es waren deutsche Schulen und Universitäten, die mir ein Leben in Selbstbestimmung ermöglicht haben.“"
                                            },
                                            {
                                                "example_id": "2b598680-64d2-4f09-a13b-e21f92024364",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Präsident Charles de Gaulle lässt schließlich ein Referendum zu – mit eindeutigem Ergebnis: Mehr als 95 Prozent der wahlbeteiligten Algerier votieren für die Selbstbestimmung des Landes.“"
                                            },
                                            {
                                                "example_id": "eaf3cc34-b8e2-44c0-9335-dff31b65716b",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Nach 1945 fordern sie als Belohnung für ihren Einsatz die politische Selbstbestimmung.“"
                                            },
                                            {
                                                "example_id": "e6380834-5a86-4296-8aee-5b1547fdb96d",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Individuelle Freiheit als Selbstbestimmung und Entgrenzung ist dabei das Leitmotiv.“"
                                            },
                                            {
                                                "example_id": "925b7caa-9568-436d-8e5c-ca68eac91bb3",
                                                "sense_id": "afdc316f-962f-3569-86aa-1cbf95ff7432",
                                                "text": "„Die Freiheit des Einzelnen bedeutete für den britischen Philosophen John Stuart Mill auch ein Recht auf Selbstbestimmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                        "entry_id": "7c93e449-bc8f-326e-9e02-3632df4be873",
                                        "glosses": [
                                            "eine Definition des eigenen Selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf10d79d-a5a8-42f6-b0d1-d59dca9ed7e4",
                                                "sense_id": "4137e98d-cb5b-3024-8699-ecb22ce3f348",
                                                "text": "Entgegen gängiger Selbstbestimmungen von moderner Zeit als unendlichem Fortschreiten oder technischer Beschleunigung fragt das von Barbara Gronau (Professorin für Theorie und Geschichte des Theaters an der Universität der Künste Berlin) geleitete Symposium nach einem anderen Zeitdiskurs der Künste, welcher Unterbrechung, Stillstellung und Verlangsamung als kritisch-utopische Suchmomente beschreibt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "331e64a4-9d93-4fd2-809f-d672439341b5",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "de819677-e977-3892-9cfb-a27b5e102ab2",
                        "source_sense_description": "veraltet, übertragen: Eigenwille, Eigensinn",
                        "target_lang_word": "Eigenwille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72968d01-11dd-413d-b44e-50efc3377fa6",
                        "source_entry_id": "57b24937-53e3-355b-af23-0577f228e2f4",
                        "source_sense_id": "de819677-e977-3892-9cfb-a27b5e102ab2",
                        "source_sense_description": "veraltet, übertragen: Eigenwille, Eigensinn",
                        "target_lang_word": "Eigensinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eigensinn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                        "entry_id": "ba59cf12-a310-3c67-a72f-a5867bc6f273",
                                        "glosses": [
                                            "hartnäckiges Beharren auf einer Meinung oder Absicht (ohne den Rat anderer anzunehmen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a4fe487-6c5b-4445-8cdd-7db9e6cff776",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "Er sperrte sich aus Eigensinn dagegen."
                                            },
                                            {
                                                "example_id": "ca706464-034c-4734-9c53-2b42bfe955e8",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Offensichtlich schadete diese Niederlage, die mehr römischem Eigensinn als seiner Unfähigkeit zu verdanken ist, seiner Karriere nicht.“"
                                            },
                                            {
                                                "example_id": "fd05efd4-e327-4992-8490-8b175d12b58d",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Die Renaissance des Begriffs [‚Heimat‘] begann demnach in den 70er-Jahren, als der lokale Eigensinn eine neue Protestkultur gegen die zentrale Planung von oben wachsen ließ.“"
                                            },
                                            {
                                                "example_id": "42921c68-20b9-4570-82e2-0b1587ac278f",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„Die Pedanterie zählt neben Rigidität, Perfektionismus und Eigensinn aus heutiger psychologischer Sicht zu den Kernsymptomen der zwanghaften Persönlichkeitsstörung (ICD-10: F60.5).“"
                                            },
                                            {
                                                "example_id": "6bdee229-c84c-4d51-9594-d6c9e73529ed",
                                                "sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                                                "text": "„So viel Eigensinn musste bestraft werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
