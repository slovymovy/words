                                    {
                                        "sense_id": "3d64e20e-0dd3-3c41-871b-60ae6d3509a4",
                                        "entry_id": "ddce3a66-af49-32c4-97bd-189221d759c1",
                                        "glosses": [
                                            "Déclarer une chose identique à une autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "127597f3-73bc-44c6-9dce-9be0f08af2bd",
                                                "sense_id": "3d64e20e-0dd3-3c41-871b-60ae6d3509a4",
                                                "text": "La législation avait fini par s’identifier avec les mœurs."
                                            },
                                            {
                                                "example_id": "cf8f0a45-e453-4fd8-826f-5d50bd8ba385",
                                                "sense_id": "3d64e20e-0dd3-3c41-871b-60ae6d3509a4",
                                                "text": "Un auteur dramatique doit s’identifier avec les personnages qu’il fait agir et parler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01f9bcc0-600b-32b1-9352-ebe8abc7e651",
                                        "entry_id": "ddce3a66-af49-32c4-97bd-189221d759c1",
                                        "glosses": [
                                            "Constater l’identité, en parlant des personnes et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9aaaa4f-67ef-47d1-806e-6ded6418fe6c",
                                                "sense_id": "01f9bcc0-600b-32b1-9352-ebe8abc7e651",
                                                "text": "Vous devez aussi identifier une femme, probablement une michetonneuse, qui vient de temps en temps désengorger notre client. Tâchez d'obtenir un signalement précis."
                                            },
                                            {
                                                "example_id": "ae2081ba-3952-426c-ae65-1535f2fcd971",
                                                "sense_id": "01f9bcc0-600b-32b1-9352-ebe8abc7e651",
                                                "text": "L'autopsie. Pourquoi faire ? Tous les poulets et pandores du Calvados ont déjà identifié le Vieux Marlou à son étalage de ratiches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0997f9db-34bc-38bf-a6f2-65a0d4fe2549",
                                        "entry_id": "ddce3a66-af49-32c4-97bd-189221d759c1",
                                        "glosses": [
                                            "Reconnaître."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a52f3a-fdaa-41e1-9cf1-fd3eca32b10e",
                                                "sense_id": "0997f9db-34bc-38bf-a6f2-65a0d4fe2549",
                                                "text": "Elle s'identifie toujours aux chansons et aux artistes qu'elle écoute."
                                            },
                                            {
                                                "example_id": "34b1452a-acd1-43cc-bfbb-bb5a6192eff8",
                                                "sense_id": "0997f9db-34bc-38bf-a6f2-65a0d4fe2549",
                                                "text": "[…] ; je pouvais, malgré la distance, grâce à l'un de ces effets de la réfraction si fréquents dans ces régions, identifier les points remarquables avec lesquels je m'étais déjà familiarisé lors de notre précédente croisière ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e6e0934-7244-39d1-a47c-804c86647336",
                                        "entry_id": "ddce3a66-af49-32c4-97bd-189221d759c1",
                                        "glosses": [
                                            "Déterminer la nature, l'origine, l'espèce d'un être, d'une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17bb4d84-5916-4b7c-bef5-d4b0fb0c8d3a",
                                                "sense_id": "0e6e0934-7244-39d1-a47c-804c86647336",
                                                "text": "Les savants n’ont pas eu de peine à identifier ces échantillons de pierres, ces plantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
