        "fr-extract.jsonl": [
            {
                "entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                "word": "éthanol",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "72fcea75-067c-4ec3-8e20-e876a6fe3c78",
                        "entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                        "tags": [
                            "plural"
                        ],
                        "form": "éthanols"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                        "entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                        "glosses": [
                            "Alcool possédant la formule semi-développée suivante : CH₃-CH₂-OH et qui est l’alcool principal se trouvant dans les boissons alcoolisées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a3a64e-55f8-4af3-b848-024cd3a2bb4f",
                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                "text": "Un second procédé consiste à traiter le p-fluorophényl sulfinate de sodium par l’iodure d’éthyle dans l’éthanol."
                            },
                            {
                                "example_id": "fab060da-2a24-40c1-932b-e9b4932dd9ed",
                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                "text": "La température de la réaction, variable le long du lit catalytique, dépend d’une part des proportions d’air, d’éthanol et de vapeur d’eau et, d’autre part, de la vitesse de passage des gaz sur le catalyseur."
                            },
                            {
                                "example_id": "ffd5c6db-78b8-4ac0-a8ac-aaabcaa00f6f",
                                "sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                                "text": "Les Japonais, et même plus généralement les Asiatiques, tiennent très mal l’alcool, par suite du mauvais fonctionnement chez eux de l’aldéhyde déshydrogénase 2, qui assure la transformation de l’éthanol en acide acétique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55a6fe43-5919-4792-8f5b-b4fc80759da9",
                        "source_entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                        "source_sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                        "target_lang_word": "Äthanol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Äthanol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05af122f-571a-3eeb-9b86-2d7a78011bb9",
                                        "entry_id": "35c71344-dd5c-3968-957f-4c1201fef48f",
                                        "glosses": [
                                            "legale Droge in vielen Getränken und Arzneien; Alkohol mit der Summenformel C₂H₅OH"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebb25be-8f79-4c7c-8b62-ea54e8c4c601",
                                                "sense_id": "05af122f-571a-3eeb-9b86-2d7a78011bb9",
                                                "text": "Äthanol wird durch Gärung gewonnen."
                                            },
                                            {
                                                "example_id": "24b0388d-6238-4a9b-bdad-bb41256ca80d",
                                                "sense_id": "05af122f-571a-3eeb-9b86-2d7a78011bb9",
                                                "text": "„1832 synthetisierte Justus von Liebig aus Äthanol und Chlor das Chloralhydrat, das aber erst wesentlich später als Schlafmittel erkannt und von O. Liebreich 1869 in der Berliner Charité als Beruhigungsmittel bei erregten Psychosekranken eingesetzt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f658351d-b768-4b44-a141-99087310fa88",
                        "source_entry_id": "ff077cde-3b8e-385d-9754-7e787c9283a1",
                        "source_sense_id": "a1e82eb5-3e95-33b5-ad0d-69416456bde1",
                        "target_lang_word": "ethanol",
                        "target_lang_code": "en",
