                "senses": [
                    {
                        "sense_id": "0bc358bd-fece-3fc2-bdae-00c2720c6d79",
                        "entry_id": "27079856-89ae-3b1e-896c-1e0801996838",
                        "glosses": [
                            "finanzielle Schädigung von Gläubigern im Zuge eines Konkursverfahrens"
                        ],
                        "tags": [
                            "österreichisches Strafrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "28c6500b-6e93-484f-b4ee-e1665f3b7951",
                                "sense_id": "0bc358bd-fece-3fc2-bdae-00c2720c6d79",
                                "text": "In Österreich wird wegen des Verdachts auf fahrlässige Krida und Verstößen gegen das Aktiengesetz ermittelt."
                            },
                            {
                                "example_id": "77acc413-a3a6-403c-8bfa-d38946706635",
                                "sense_id": "0bc358bd-fece-3fc2-bdae-00c2720c6d79",
                                "text": "Seine Drohung hält der Vereinschef dennoch aufrecht: Sollten keine zusätzlichen Gelder bewilligt werden, werde er einen Insolvenzantrag stellen, um sich nicht der fahrlässigen Krida schuldig zu machen."
                            },
                            {
                                "example_id": "a9ee587a-c20d-491d-ae6c-2410cf47da2f",
                                "sense_id": "0bc358bd-fece-3fc2-bdae-00c2720c6d79",
                                "text": "Weitere Vorwürfe: schwere (Schutzgeld-)Erpressung, schwere Nötigung, Freiheitsentziehung, schwerer Betrug, betrügerische Krida, schwere Sachbeschädigung und Geldwäscherei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
