                            {
                                "target_lang_word": "sad",
                                "target_lang_sense_clarification": "evoking pity or disappointment"
                            },
                            {
                                "target_lang_word": "pathetic",
                                "target_lang_sense_clarification": "miserable or pitiful"
                            },
                            {
                                "target_lang_word": "pitiful",
                                "target_lang_sense_clarification": "deserving or exciting pity"
                            },
                            {
                                "target_lang_word": "shame",
                                "target_lang_sense_clarification": "unfortunate situation (e.g., 'it is a shame')"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58881dc4-121f-351d-8ea9-039e254da333",
                    "sense_definition": "teleurgesteld of sip kijkend",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "teleurgesteld",
                    "name_type": "no",
                    "examples": [
