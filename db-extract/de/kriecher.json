                "senses": [
                    {
                        "sense_id": "2a904cba-3ed6-3e69-975e-dcad72d3bd79",
                        "entry_id": "fc2db0a0-badd-3c8c-ab44-fb7875a168d4",
                        "glosses": [
                            "gegenüber Vorgesetzten, Höhergestellten übertrieben unterwürfige, demütige (männliche^☆) Person"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "b8bf66a5-9ff4-4b03-b9ff-3aebbc692cdd",
                                "sense_id": "2a904cba-3ed6-3e69-975e-dcad72d3bd79",
                                "text": "„Doch wie viele werden für eine gute Note zu Kriechern, die dem Lehrer hinterhersabbern wie Pawlowsche Hunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b80ca4fa-ac99-446f-a163-6fdf26b04046",
                        "source_entry_id": "fc2db0a0-badd-3c8c-ab44-fb7875a168d4",
                        "source_sense_id": "2a904cba-3ed6-3e69-975e-dcad72d3bd79",
                        "source_sense_description": "gegenüber Vorgesetzten, Höhergestellten übertrieben unterwürfige, demütige (männliche) Person",
                        "target_lang_word": "toady",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                        "entry_id": "9ea4c4bc-4a75-384b-b910-737f1d542a2c",
                                        "glosses": [
                                            "A sycophant who flatters others to gain personal advantage, or an obsequious, servile lackey or minion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a0d50b-763e-4d4a-affa-62becba9a532",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "\"Go on, Hiram, show 'em what you can do,\" urged Luke Fodick, who was a sort of toady to Hiram Shell, the school bully, if ever there was one."
                                            },
                                            {
                                                "example_id": "e1713c21-8ed4-4630-8b8e-7f52fcaa23fe",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "\"But who is she, can you tell me?\" / \"Some fair-skinned speculation of old Montreville's, I suppose, that she has got either to toady herself, or take in some of her black friends with.—Is it possible you have never heard of old Mother Montreville?\""
                                            },
                                            {
                                                "example_id": "40e82f43-428b-4171-a58f-9e6112567cdc",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "Before I had been standing at the window five minutes, they somehow conveyed to me that they were all toadies and humbugs, but that each of them pretended not to know that the others were toadies and humbugs: because the admission that he or she did know it, would have made him or her out to be a toady and a humbug."
                                            },
                                            {
                                                "example_id": "2ec58c94-8acc-4179-8de5-15d1a4d2b7f7",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "[T]he appearance of only three coaches, each drawn by four horses, was rather trying for poor Lady Scott. They contained Mrs Coutts – her future lord the Duke of St Albans – one of his Grace's sisters – a dame de compagnie (vulgarly styled a Toady)"
                                            },
                                            {
                                                "example_id": "b7818964-c7b3-445b-9017-1d09d298f924",
                                                "sense_id": "decbe928-3b8b-3dd8-84e9-2884e329e9a6",
                                                "text": "But how could she have helped herself? I asked, imagining the sneers and the laughter, the adulation of the toadies, the scepticism of the professional poet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1986ef80-456e-3cc3-8d6e-d712d4882cde",
                                        "entry_id": "9ea4c4bc-4a75-384b-b910-737f1d542a2c",
                                        "glosses": [
                                            "A coarse, rustic woman."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24fcba3a-9bf7-369a-8891-5b9ae8d53fbf",
                                        "entry_id": "e2cadf46-22eb-30e5-a937-21b7c2f7743e",
                                        "glosses": [
                                            "To behave like a toady (toward someone)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ce32d9-1175-40f8-b20a-5f28f36d2d68",
                                                "sense_id": "24fcba3a-9bf7-369a-8891-5b9ae8d53fbf",
                                                "text": "He had toadied to the late Mr William Morris: he had toadied to various members of the Fabian Society, he had toadied at first to the great Bransdon himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "094f770a-07dc-36ca-b521-ba9410385208",
                                        "entry_id": "e2cadf46-22eb-30e5-a937-21b7c2f7743e",
                                        "glosses": [
                                            "To behave like a toady toward (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9fe82fa-dd7b-418f-b0f5-44707749037d",
                                                "sense_id": "094f770a-07dc-36ca-b521-ba9410385208",
                                                "text": "But bless your hearts, we \"ain't so green,\" though lots of us of all sorts toady you enough certainly, and try to make you think so."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8f8e63-1c2e-3c4c-a62f-51511b79bf75",
                                        "entry_id": "686d47d3-59a2-328f-a91f-38e401764db4",
                                        "glosses": [
                                            "toadlike"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1993f7d-bf6a-48d4-9a95-11172a5cdb72",
                                                "sense_id": "7c8f8e63-1c2e-3c4c-a62f-51511b79bf75",
                                                "text": "The bath is of greatest advantage in these chronic cases, with an earthy complexion and toady skin, if I am allowed thus to express its appearance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "toady",
                                "target_lang_code": "en",
                                "target_senses": [
