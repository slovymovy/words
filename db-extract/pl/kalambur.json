                                "target_senses": [
                                    {
                                        "sense_id": "570b21b3-2966-3264-8acc-b24c7f4b0c17",
                                        "entry_id": "e230c713-14c4-3131-b738-a6ea1d0dca3c",
                                        "glosses": [
                                            "A homonym."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0bf6cab9-4eb6-3dfd-81cf-a511a2b8d085",
                                        "entry_id": "e230c713-14c4-3131-b738-a6ea1d0dca3c",
                                        "glosses": [
                                            "A play on words, a pun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a77c28e-5030-4c70-92ad-11fd9ca3ae34",
                                                "sense_id": "0bf6cab9-4eb6-3dfd-81cf-a511a2b8d085",
                                                "text": "[H]e sported in many other æquivoques of the same nature; and at dinner told the physician, that he was like the root of the tongue, as being cursedly down in the mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "913c0f5f-d925-390a-a635-ffa66a0923c1",
                                        "entry_id": "e230c713-14c4-3131-b738-a6ea1d0dca3c",
                                        "glosses": [
                                            "Ambiguity or double meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388239f3-afd5-4325-a731-f06c3a1015f4",
                                                "sense_id": "913c0f5f-d925-390a-a635-ffa66a0923c1",
                                                "text": "[T]he black wisps of women bargaining behind those veils might turn out to be the ballet and coalesce in some dance gaily admitting their equivoque of concealing and proclaiming their sex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c598c72a-3e23-4b3d-b48d-a6180b268dfa",
                        "source_entry_id": "25397b87-3603-3b18-8705-ebf80a490fbe",
                        "source_sense_id": "dd8b5c32-1269-36b9-9437-e4a2b349173c",
                        "target_lang_word": "pun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To beat; strike with force; to ram; to pound, as in a mortar; reduce to powder, to pulverize."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17af3a82-d102-4b03-b1da-50cd4586409f",
                                                "sense_id": "2197e458-fec7-3b30-b2fe-625bf1e1bc2a",
                                                "text": "He would pun thee into shivers with his fist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                        "entry_id": "4abe2dc9-3e73-382a-b22c-50fd74fe0ca8",
                                        "glosses": [
                                            "To make or tell a pun; to make a play on words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2ebd875-aa0a-4014-aa5d-5aac48e9f2cf",
                                                "sense_id": "c1071de2-4209-301d-a45e-f1511d2da281",
                                                "text": "We punned about the topic until all around us groaned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                        "entry_id": "9fe95fa7-1c2e-3664-98e7-403031a36c4c",
                                        "glosses": [
                                            "A joke or type of wordplay in which similar definitions or sounds of two words or phrases, or different definitions of the same word, are deliberately confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7735152a-2137-48bf-8667-4228b6c3c451",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "The pun is the lowest form of wit."
                                            },
                                            {
                                                "example_id": "555ce09b-890d-46f1-9172-42d131d3abdd",
                                                "sense_id": "bc4f8c7f-bd3c-3e86-9742-7c998bd074bb",
                                                "text": "\"Certainly, my home at my uncle's brought me acquainted with a circle of admirals. Of Rears, and Vices, I saw enough. Now do not be suspecting me of a pun, I entreat.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b4cfdbb-0f5a-3414-9025-3f7503ecd2cb",
                                        "entry_id": "cc8d4ecb-09de-36ea-b907-792c732a86c5",
                                        "glosses": [
                                            "Alternative form of bun (“Korean unit of measure”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                        "entry_id": "39b41c9b-e2bd-3385-9874-b7ba85ffa2e6",
                                        "glosses": [
                                            "A certain number of cowries, generally 80."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f1559e-a152-48fe-a0c4-58d950b24b7e",
                                                "sense_id": "5a477e5b-e92d-3d14-a15c-df33a7c4521d",
                                                "text": "Hackeries and carriages, loaded and empty, 8 annas. Sheep, goats, &c., 1 pun of cowries each."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17a6f46e-c647-4ee7-8c64-b1de0caae993",
                        "source_entry_id": "25397b87-3603-3b18-8705-ebf80a490fbe",
                        "source_sense_id": "dd8b5c32-1269-36b9-9437-e4a2b349173c",
                        "target_lang_word": "calembour",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calembour",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                        "entry_id": "5a6491e5-2103-3c62-9750-3b8ae522b9a3",
                                        "glosses": [
                                            "Jeu de mots fondé sur l’homophonie et la polysémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65cabfe3-dbbe-47a9-ab5a-a44799ea3fff",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Et tous les jours, à la Bourse, on saluait d’un nouveau calembour le spéculateur jalousé."
                                            },
                                            {
                                                "example_id": "5d37ab3e-0aa0-4192-ab76-0bc88bfe2c16",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Le calembour est la fiente de l’esprit qui vole. Le lazzi tombe n’importe où ; et l’esprit, après la ponte d’une bêtise, s’enfonce dans l’azur. Une tache blanchâtre qui s’aplatit sur le rocher n’empêche pas le condor de planer. Loin de moi l’insulte au calembour !"
                                            },
                                            {
                                                "example_id": "e656b0b9-ed96-4322-ab80-bb60b12874bf",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Té ! Boudiou ! s’écrie notre insupportable voisin qui n’a cessé de dire des insanités et de faire des calembours (et quels calembours, grands dieux !)."
                                            },
                                            {
                                                "example_id": "c9f61c0c-6e01-439f-bb69-b88510e8d49c",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "De la même façon, l’écriture rushdienne transcrit la langue de S.S. Sisodia et la « brissétise », en recourant en permanence sur la décomposition des syntagmes pour en exploiter les ambiguïtés et les calembours jaillissant de l’homophonie."
                                            },
                                            {
                                                "example_id": "ba89840a-6907-470c-baee-1768a8a04bdf",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "Il demandait pour Locke une formule qui fût pour cette philosophie ce qu'est le « Je pense, donc je suis » de Des­cartes. Je répondis par un horrible calembour. « Je penche, donc je suis »."
                                            },
                                            {
                                                "example_id": "206806af-7cf7-4e6b-ba0c-b9dbcf580415",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "À-peu-près et calembour appartiennent tous les deux à la tribu Jeudemots, mais ils ne sont pas les seuls !"
                                            },
                                            {
                                                "example_id": "d792eaac-902f-47a4-837b-f6c238731e3c",
                                                "sense_id": "72f69d09-ddd5-380a-bfa2-e6a5b1f6c8f1",
                                                "text": "La phrase En voyant le lit vide, il le devint. est un calembour souvent attribué à Ponson du Terrail et basé sur l’homonymie de livide et lit vide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
