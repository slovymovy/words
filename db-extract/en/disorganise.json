                    {
                        "sense_id": "ce1e13a1-88f4-34ac-9597-16750bd064d2",
                        "entry_id": "a7a44260-400d-3297-b933-8571fceeac21",
                        "glosses": [
                            "To make less organised; to reduce to chaos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e74e20-9cc6-46af-8ab7-23916b105972",
                                "sense_id": "ce1e13a1-88f4-34ac-9597-16750bd064d2",
                                "text": "The arrival of her new baby would inevitably disorganise her life."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccea104e-2830-4493-9d63-903536078638",
                        "source_entry_id": "a7a44260-400d-3297-b933-8571fceeac21",
                        "source_sense_id": "ce1e13a1-88f4-34ac-9597-16750bd064d2",
                        "source_sense_description": "make less organised",
                        "target_lang_word": "désorganiser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désorganiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6293a1fb-30fd-3eb0-8485-3bed895d0880",
                                        "entry_id": "70220793-93b1-3ecf-bf4f-17ce52fb675b",
                                        "glosses": [
                                            "Altérer profondément dans sa texture un organe ou une portion de cet organe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6132421d-178b-439c-b2a9-a174e9e33db3",
                                                "sense_id": "6293a1fb-30fd-3eb0-8485-3bed895d0880",
                                                "text": "La même cause qui organise les corps peut les désorganiser."
                                            },
                                            {
                                                "example_id": "0dfbd64d-2dd7-4dee-bdde-5ad26df8563d",
                                                "sense_id": "6293a1fb-30fd-3eb0-8485-3bed895d0880",
                                                "text": "Les corps animés se désorganisent avec le temps."
                                            },
                                            {
                                                "example_id": "8af2c551-e758-4f69-97f3-ef37e42d3be5",
                                                "sense_id": "6293a1fb-30fd-3eb0-8485-3bed895d0880",
                                                "text": "Le cancer désorganise les tissus qu’il envahit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3b140e2-971a-3746-9e8c-55a083d1d699",
                                        "entry_id": "70220793-93b1-3ecf-bf4f-17ce52fb675b",
                                        "glosses": [
                                            "Détruire l’organisation d’une entreprise, d’une société, d’une administration, d’un État."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "698f7a7f-b6d0-4a47-85d5-051f240e4aa5",
                                                "sense_id": "c3b140e2-971a-3746-9e8c-55a083d1d699",
                                                "text": "Au contraire, chez des primates “plus évolués”, tout semble se désorganiser, se défonctionnaliser, devenir relatif à des apprentissages complexes, à des rituels plus ouverts au risque de quiproquo ou de mésentente."
                                            },
                                            {
                                                "example_id": "a3a9b2f2-747b-433f-a978-425680c0f015",
                                                "sense_id": "c3b140e2-971a-3746-9e8c-55a083d1d699",
                                                "text": "Une partie de plaisir, une fête, une réception toute désorganisée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
