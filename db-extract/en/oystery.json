                        "glosses": [
                            "Resembling or characteristic of an oyster, especially in color or scent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e58e5b8-cbd5-4b77-8652-4890f0d5172d",
                                "sense_id": "4138f68f-8ecb-303f-b9de-0e890182ee95",
                                "text": "It strolls along her oystery lips, dipping in and pulling out. Now it moves to the back, and just rests its weight against her, like she's the inkpad for his fingerprint. it turns a little to nestle in, sealing against her."
                            },
                            {
                                "example_id": "2f4585a6-440f-4386-b1d3-70c4b533579f",
                                "sense_id": "4138f68f-8ecb-303f-b9de-0e890182ee95",
                                "text": "[…] chairs—their horsehair cushions holding that musty, oystery scent country parlors have—there was fat modern furniture in pastel shades surrounding a glass table supported on wrought-iron scrolls."
                            },
                            {
                                "example_id": "6917cbc1-195a-4211-839a-075129a704df",
                                "sense_id": "4138f68f-8ecb-303f-b9de-0e890182ee95",
                                "text": "A faint oystery light smudged the November sky outside the window."
                            }
                        ]
                    }
