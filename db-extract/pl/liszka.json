                                "target_senses": [
                                    {
                                        "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                        "entry_id": "3c820197-2bac-3fef-bc6e-c8a764ecb499",
                                        "glosses": [
                                            "wurmförmige Larve des Schmetterlings oder der Blattwespe mit beißenden Mundteilen, kurzen bekrallten Brustfüßen und stummelförmigen Afterfüßen"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94b429ca-03ed-498d-a502-7ed050534a7b",
                                                "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                                "text": "Durch Metamorphose entwickelt sich z.B. der Schmetterling über Ei, Larve, Raupe und Puppe zum fertigen Insekt."
                                            },
                                            {
                                                "example_id": "cfd079f0-d585-4b41-8765-3f8f3b70df64",
                                                "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                                "text": "„Die schwarzgelbe Raupe drehte sich mühsam zu ihnen.“"
                                            },
                                            {
                                                "example_id": "9e4c991f-ce96-4373-b765-5f31a91e4d53",
                                                "sense_id": "58f3887f-8216-3bdf-9122-c13a2bf54168",
                                                "text": "„Um die Raupen zu vertilgen, schlugen sie die Bäume mit wuchtigen Stockhieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "184732e3-d3b3-32af-aa1f-f963e038de79",
                                        "entry_id": "3c820197-2bac-3fef-bc6e-c8a764ecb499",
                                        "glosses": [
                                            "Kurzform von Raupenfahrzeug (Kraftfahrzeug mit breitgliedrigen, über Antriebsrollen laufenden Gleisketten als Fahrwerk)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db25a327-c5dc-4c9c-bc55-33712edc412f",
                                                "sense_id": "184732e3-d3b3-32af-aa1f-f963e038de79",
                                                "text": "Mit der Raupe wurde der Schutt zusammengeschoben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
