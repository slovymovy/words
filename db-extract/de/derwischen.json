                "senses": [
                    {
                        "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                        "entry_id": "0d504d57-36da-3feb-8b65-91ed004d4fc9",
                        "glosses": [
                            "erwischen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "894603e7-fdeb-4d06-8781-e79a51275b57",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„Wo habt’s denn die derwuschen?“"
                            },
                            {
                                "example_id": "3d89544c-85eb-4b5e-92b9-592cd2089526",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„»Aha?« fragte Oswald dagegen: »und wer ist’s gewesen, der sich aus all meinen Höllenflammen nichts gemacht und dennoch die Martina derwuschen hat?«“"
                            },
                            {
                                "example_id": "8e1ca17a-123c-4b66-b0d9-3994e3a984ec",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„Von die Schaf und von die Rehböck red i gar net, die wo der scho gwildert hat! Ja — und moanst, daß ma den Kerl dawischn kunnt?“"
                            },
                            {
                                "example_id": "0a1c6d1d-f305-422b-b333-39862563aad0",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„»Derwischen wenn s'n, an König vo Preiße und sein plärrmäulerten Bismarck, na werdn s' oi zwoa aufg'hängt!« erzählte der Schmied Banzer.“"
                            },
                            {
                                "example_id": "1ce09b2d-0212-4261-99d1-a43301394f76",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„‚Besser wia nix!‘ hat der Fuchs g’sagt, wia er vom Gickerl grad a Federn derwischt hat.“"
                            },
                            {
                                "example_id": "ec25ccb7-759d-475e-b7aa-8a528fa3f0af",
                                "sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                                "text": "„Vielleicht derwisch i do an Haflinger Hengst«, schloß der Muggenthaler alsdann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c313d01-b685-4830-a436-7fba17293020",
                        "source_entry_id": "0d504d57-36da-3feb-8b65-91ed004d4fc9",
                        "source_sense_id": "bb40b06d-2a19-38bd-9334-01bb7df92bd6",
                        "source_sense_description": "bairisch: erwischen",
                        "target_lang_word": "grab",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44954a8a-5f5a-399c-a3b6-ef79530b14a5",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To grip suddenly; to seize; to clutch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2cc089a-5a45-4ce7-ac52-2c8ce844f93f",
                                                "sense_id": "44954a8a-5f5a-399c-a3b6-ef79530b14a5",
                                                "text": "I grabbed her hand to pull her back from the cliff edge."
                                            },
                                            {
                                                "example_id": "dd038d05-3c25-4444-bd74-e692a6f8f3fe",
                                                "sense_id": "44954a8a-5f5a-399c-a3b6-ef79530b14a5",
                                                "text": "Old Applegate, in the stern, just set and looked at me, and Lord James, amidship, waved both arms and kept hollering for help. I took a couple of everlasting big strokes and managed to grab hold of the skiff's rail, close to the stern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "217256d4-1f89-336c-be1b-1aebfc67c6e1",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To make a sudden grasping or clutching motion (at something)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1caaec8c-91d5-4474-b9c2-cddd984367c4",
                                                "sense_id": "217256d4-1f89-336c-be1b-1aebfc67c6e1",
                                                "text": "The suspect suddenly broke free and grabbed at the policeman's gun."
                                            },
                                            {
                                                "example_id": "087916d5-6f78-44fd-95cc-1e1916245093",
                                                "sense_id": "217256d4-1f89-336c-be1b-1aebfc67c6e1",
                                                "text": "Stop grabbing or I won't give you any cookies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db2c7453-27c3-3be8-89b0-29b4dbdaf6b9",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To restrain someone; to arrest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1d07588-95c1-3a9d-afb9-a185d8ba88b1",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To grip the attention of; to enthrall or interest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "738ba3b1-806d-4f4c-a2a1-a159b64961d7",
                                                "sense_id": "e1d07588-95c1-3a9d-afb9-a185d8ba88b1",
                                                "text": "How does that idea grab you?"
                                            },
                                            {
                                                "example_id": "a6b58965-0cdc-4bb8-8fde-09a2260d96ad",
                                                "sense_id": "e1d07588-95c1-3a9d-afb9-a185d8ba88b1",
                                                "text": "Baby, instant soup doesn't really grab me\nToday I need something more substantial"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To quickly collect, retrieve, or take."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea14c96a-adba-43fd-85e0-a88f270430c4",
                                                "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                                                "text": "Come in and grab a seat [i.e. sit down]."
                                            },
                                            {
                                                "example_id": "a6b75fb9-f750-46c0-80e1-07f0557c7843",
                                                "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                                                "text": "\"I'll just grab my jacket,\" said Manh-Hung."
                                            },
                                            {
                                                "example_id": "81c83535-204b-4208-9348-425a8ea19078",
                                                "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                                                "text": "Hardly believing that Rafe actually planned to relax for a while, Kate nodded. \"All right. Fine. I'll just go grab my purse.\""
                                            },
                                            {
                                                "example_id": "59b7ec20-a224-474f-b08f-ee7cd799359c",
                                                "sense_id": "863240d2-6c2f-3b41-82be-c5a055eebb81",
                                                "text": "He looked at Albert and Ben, and then back to Nurse Allen. \"I'll just grab my gear and be right back.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "964f5cd1-a900-375e-b0d8-73043ad90a31",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To consume something quickly."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959d63a1-88d8-4afd-9f68-624bdb8291c6",
                                                "sense_id": "964f5cd1-a900-375e-b0d8-73043ad90a31",
                                                "text": "We'll just grab a sandwich and then we'll be on our way."
                                            },
                                            {
                                                "example_id": "497b3b95-200f-4447-be73-4adb294329df",
                                                "sense_id": "964f5cd1-a900-375e-b0d8-73043ad90a31",
                                                "text": "Is there time to grab a coffee?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "376497b0-b39c-3896-9641-4d8b35538693",
                                        "entry_id": "f8f0da0d-7686-31a3-a72d-1db398e8684c",
                                        "glosses": [
                                            "To take the opportunity of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "136de910-74c7-4ef9-b692-62e800e26db6",
                                                "sense_id": "376497b0-b39c-3896-9641-4d8b35538693",
                                                "text": "Both teams wasted good opportunities to score but it was the London side who did grab what proved to be the decisive third when the unmarked Vaz Te, a January signing from Barnsley, drilled the ball into the net from 12 yards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grab",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b379b3-c710-3446-a8b3-9e806338dcf2",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "A sudden snatch at something."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a18ebc1-f627-4e0c-bc69-0c4a3724bf0e",
                                                "sense_id": "c8b379b3-c710-3446-a8b3-9e806338dcf2",
                                                "text": "The ball popped in and popped out, and when he made a grab for it on the ground he kicked it with his foot."
                                            },
                                            {
                                                "example_id": "fb6d9e2b-0fd9-45d3-bea9-21c047b56963",
                                                "sense_id": "c8b379b3-c710-3446-a8b3-9e806338dcf2",
                                                "text": "He made a grab for me and I swung my handbag at him as hard as I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bb2c03-1965-3e7a-b14f-3856d0574761",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "An acquisition by violent or unjust means."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4c7cd12-ab24-3ce4-bf67-1978665cd2c2",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "A mechanical device that grabs or clutches."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "491baafc-e8c0-427c-8c47-9950e38b3d91",
                                                "sense_id": "b4c7cd12-ab24-3ce4-bf67-1978665cd2c2",
                                                "text": "Almost all modern cranes are electrically operated and a quick-acting type of 30 cwt. capacity is suitable for general cargo, but not powerful enough to operate grabs for discharge of bulk cargoes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49d5b841-0b74-3dda-bf48-a4899e7b832d",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "A mechanical device that grabs or clutches.",
                                            "A device for withdrawing drills, etc., from artesian and other wells that are drilled, bored, or driven."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eefbd020-ebea-38a4-a36e-2c0a22cc4e44",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "A sound bite."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0b95f5a-5543-4a9d-be80-bbee9feb68ed",
                                                "sense_id": "eefbd020-ebea-38a4-a36e-2c0a22cc4e44",
                                                "text": "For example, one radio bulletin may feature one central issue, like a state election, and will focus on that issue. The bulletin might contain only a few voice wraps but many grabs, leaving the focus firmly on the newsreader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c004963-8bb7-3e83-8916-7f36929e9cd7",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "That which is seized."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d31400fb-6a1f-387d-acca-0f3b9ca58c8a",
                                        "entry_id": "8d61c98c-fc73-36d7-bcdd-4d1ff8536dfd",
                                        "glosses": [
                                            "The rescue of a person from a burning structure."
                                        ],
                                        "tags": [
