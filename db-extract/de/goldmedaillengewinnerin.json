                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b532a012-e64c-4d1b-8623-5cdcbe0089cc",
                                "sense_id": "834ff382-4944-3f09-82cc-294635d95cc2",
                                "text": "„Der Bürgermeister begrüßte die zweifache Goldmedaillengewinnerin.“"
                            },
                            {
                                "example_id": "c1512d64-5c1d-4f63-bb07-e922ee20f698",
                                "sense_id": "834ff382-4944-3f09-82cc-294635d95cc2",
                                "text": "„In ihrer Freizeit hält sich die Goldmedaillengewinnerin der Spiele 1972 in Sapporo mit Joggen und Turnen sowie bei Spaziergängen mit ihrer Hündin fit.“"
                            }
                        ],
