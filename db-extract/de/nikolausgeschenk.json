                        "entry_id": "4f2260ea-c5f4-333f-a4e6-383af5de9d96",
                        "glosses": [
                            "Geschenk für Kinder, das der Heilige Nikolaus den Kindern bringt"
                        ],
                        "tags": [
                            "Volksbrauch"
                        ],
                        "examples": [
                            {
                                "example_id": "4f37bd27-296a-4ce1-ab05-32a58bd4bb3d",
                                "sense_id": "56e696d2-c3aa-3563-8c66-f0c7e7ba8b9e",
                                "text": "„Beim Vorstand der Deutschen Post stoßen die Protestaktionen auf Unverständnis. Es sei bedauerlich, dass Kinder dadurch eventuell ihr Nikolausgeschenk nicht erhielten, sagte am Freitag der für das Paket und E-Commerce-Geschäft zuständige Vorstand Jürgen Gerdes in Bonn. „Für unsere Kunden geben wir immer alles.““"
                            }
                        ],
