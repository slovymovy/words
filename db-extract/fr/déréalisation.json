        "fr-extract.jsonl": [
            {
                "entry_id": "bb518b5b-60a2-373d-b3ae-19ba08f2c488",
                "word": "déréalisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b3ee5d46-36d5-47a4-ba41-dfa54d89ee4e",
                        "entry_id": "bb518b5b-60a2-373d-b3ae-19ba08f2c488",
                        "tags": [
                            "plural"
                        ],
                        "form": "déréalisations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4cc2e125-a91b-3dbe-b93e-b27c21419159",
                        "entry_id": "bb518b5b-60a2-373d-b3ae-19ba08f2c488",
                        "glosses": [
                            "Altération de la perception ou de l’expérience du monde extérieur qui apparaît étrange ou irréel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10c8ce89-8c81-4561-be02-704b5120daa1",
                                "sense_id": "4cc2e125-a91b-3dbe-b93e-b27c21419159",
                                "text": "La fracture de la cohérence entrapparaît lors de déréalisations provoquées par la fascination, par l’arrêt médusé de l’attention sur un élément ténu, — l’autobus, la pince à linge, le tube de vaseline du Journal du voleur."
                            },
                            {
                                "example_id": "0781a3d8-18d0-4052-b003-b3de18f3b917",
                                "sense_id": "4cc2e125-a91b-3dbe-b93e-b27c21419159",
                                "text": "Les benzodiazépines [provoquent] un état de somnolence, de déréalisation, voire d’euphorie."
                            }
                        ]
                    },
                    {
                        "sense_id": "99276e4a-cc35-3152-93c6-923e04c32406",
                        "entry_id": "bb518b5b-60a2-373d-b3ae-19ba08f2c488",
                        "glosses": [
                            "Impression de changements dans la perception de la réalité."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6426707d-5f60-44e5-9219-080d41c43d86",
                                "sense_id": "99276e4a-cc35-3152-93c6-923e04c32406",
                                "text": "Le confinement peut aussi être un miroir déformant, faussant nos représentations, en créant un effet de déréalisation."
                            },
                            {
                                "example_id": "0cf2ccc8-5842-4aba-910f-44156077283d",
                                "sense_id": "99276e4a-cc35-3152-93c6-923e04c32406",
                                "text": "L’anomie gagnait. La déréalisation du langage grandissait, comme un signe de distinction intellectuelle. Compétitivité, précarité, employabilité, flexibilité faisaient rage. On vivait des discours nettoyés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c770400-9236-4a5d-8a2b-3ae6f50ae334",
                        "source_entry_id": "bb518b5b-60a2-373d-b3ae-19ba08f2c488",
                        "target_lang_word": "derealization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derealization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "459bf96e-b024-3e48-963b-28cf9bb5011a",
                                        "entry_id": "c0f6ac80-faaa-3d48-a64d-d3ff2abdb709",
                                        "glosses": [
                                            "The psychological symptom in which the world appears to be unreal, and the patient has a sense of detachment from it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a6af63-7df2-41e0-a50a-525e4acfa495",
                                                "sense_id": "459bf96e-b024-3e48-963b-28cf9bb5011a",
                                                "text": "Derealization frequently co-occurs with depersonalization disorder, in which affected individuals notice an altered perception of their surroundings, resulting in the world seeming unreal or dreamlike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8177166a-875b-35d2-8edf-5bddf7732acb",
                                        "entry_id": "c0f6ac80-faaa-3d48-a64d-d3ff2abdb709",
                                        "glosses": [
                                            "making unreal, in general; detachment from reality or realness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a2d7e9-6966-4178-a6ec-deed01eb5650",
                                                "sense_id": "8177166a-875b-35d2-8edf-5bddf7732acb",
                                                "text": "The derealization of Arab Americans created the conditions whereby, after the attacks of 9/11, the American public was willing to allow, and sometimes become complicit in, their government's detention, extradition, and torture of Arabs and Muslims […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2d4f6c-6684-3ef1-b0c9-1cffc6576598",
                                        "entry_id": "c0f6ac80-faaa-3d48-a64d-d3ff2abdb709",
                                        "glosses": [
                                            "The loosening of the bonds of (an electron) so that it can move freely among a group of atoms; delocalization."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff9b254-2f81-469e-b36e-3dd400dfa117",
                                                "sense_id": "aa2d4f6c-6684-3ef1-b0c9-1cffc6576598",
                                                "text": "This section develops a theme mentioned […] in the previous section, namely the derealization of the unpaired electron away from the formal radical centre […]"
                                            },
                                            {
                                                "example_id": "e83e2ed7-391d-40d7-8f7d-2d3274363bd4",
                                                "sense_id": "aa2d4f6c-6684-3ef1-b0c9-1cffc6576598",
                                                "text": "Indeed, cyclic derealization of π-electrons is at the heart of aromaticity. For benzene, it is found that the derealization of the density is greater between para-related carbons, […] than between meta-related atoms, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
