                        "glosses": [
                            "сорт яблок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6d696c-d1c4-4b82-8918-5309d7589fad",
                                "sense_id": "4677cecd-0f6b-3c6a-b6b6-67c46c802538",
                                "text": "Очень ценны и другие старые сорта: антоновка, апорт, налив, ренет Семиренко и др."
