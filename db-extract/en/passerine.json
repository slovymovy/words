                                        "entry_id": "64c12391-4f90-3b5a-80f4-e08814a913d9",
                                        "glosses": [
                                            "muž, který umí dobře zpívat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f2b25c-c05c-49c2-8d54-f86bee7d74c0",
                                                "sense_id": "efea2b7b-1f15-3e75-999e-0512d2d24af0",
                                                "text": "Řadí se k našim prvotřídním pěvcům - tenorový part z La Bohème vystřihne jako by se nechumelilo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e2289b-3770-3547-aeaa-7ae1c800eac2",
                                        "entry_id": "64c12391-4f90-3b5a-80f4-e08814a913d9",
                                        "glosses": [
                                            "pták vybavený zpěvným ústrojím"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a49bd11-9750-490f-a942-46d2bdb66d00",
                                                "sense_id": "30e2289b-3770-3547-aeaa-7ae1c800eac2",
                                                "text": "Mezi pěvce rozšířené na našem území patří například kos, špaček, slavík nebo drozd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375511fd-f08c-31be-9360-0f875219d32e",
                                        "entry_id": "64c12391-4f90-3b5a-80f4-e08814a913d9",
                                        "glosses": [
                                            "rod ptáků z čeledi lejskovitých"
