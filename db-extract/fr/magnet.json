                "translations": [
                    {
                        "translation_id": "7e89e140-5dfb-4c79-a0d2-2bb3f300dfa7",
                        "source_entry_id": "42cc9425-7592-329f-b620-9282a346f201",
                        "source_sense_id": "6363d286-3203-36ad-a0fb-a8dfa42801a2",
                        "source_sense_description": "kleines dekoratives, magnetisches Objekt, das häufig als Werbeträger dient; Magnet",
                        "target_lang_word": "Magnet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Magnet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                        "entry_id": "3089017f-840b-31b1-9d8d-28d7069c94e5",
                                        "glosses": [
                                            "ferromagnetischer Stoff oder Gegenstand, der die Eigenschaft hat, andere ferromagnetische Stoffe anzuziehen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3367e271-4198-4449-9048-5eb2d6562d77",
                                                "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                                "text": "Der Magnet zieht Eisen an."
                                            },
                                            {
                                                "example_id": "289d069b-a7c2-4735-b766-f81f79acf622",
                                                "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                                "text": "Besonders starke Magnete werden im Sinterverfahren aus seltenen Erden hergestellt, wie zum Beispiel Samarium-Cobalt oder Neodym-Eisen-Bor."
                                            },
                                            {
                                                "example_id": "3dbca801-3a6c-4d03-9ffe-488ed0c213bd",
                                                "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                                "text": "„Frau von Urfé trug an ihrem Halse als Schmuckstück einen großen Magneten. Sie behauptete, dieser Magnet würde eines Tages den Blitz anziehen, und sie würde auf diese Weise zur Sonne aufsteigen.“"
                                            },
                                            {
                                                "example_id": "7aed2aec-65b6-492f-b39a-5b13e1586281",
                                                "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                                "text": "„Wie von einem Magneten angezogen, ging Gertrude zu den Büchern vom Ende des Alphabets.“"
                                            },
                                            {
                                                "example_id": "d1de699d-8283-4d96-baa6-b84fe2ff3cdc",
                                                "sense_id": "05f8b592-1256-344a-8ea9-55c5f12c5997",
                                                "text": "„Hier draußen in Berg hatte er sich ein Zuhause geschaffen, mit Zetteln und Magneten, die an der Kühlschranktür hingen, Kräutern auf dem Fensterbrett und haufenweise Schuhen im Flur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a08aa2b-a19a-3ba7-8db5-5209f15bf81a",
                                        "entry_id": "3089017f-840b-31b1-9d8d-28d7069c94e5",
                                        "glosses": [
                                            "etwas oder jemand, der eine Anziehungskraft besitzt"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80694541-a597-4bdd-86dc-f6f1bcc63f2c",
                                                "sense_id": "7a08aa2b-a19a-3ba7-8db5-5209f15bf81a",
                                                "text": "Das neue Einkaufszentrum der Stadt wirkt als Magnet auf das gesamte Umland."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
