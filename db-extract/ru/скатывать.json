                "senses": [
                    {
                        "sense_id": "d10dbd3c-9227-343d-9a79-6bf2179dfcaa",
                        "entry_id": "cd2b50b5-4ebd-3f91-8359-d5edb1b03908",
                        "glosses": [
                            "катя или заставляя катиться, спускать вниз либо перемещать откуда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9cdba6d-7f26-469d-ab09-bb810e49f9b9",
                                "sense_id": "d10dbd3c-9227-343d-9a79-6bf2179dfcaa",
                                "text": "Морские мины-шары скатывали с крутогорья на укрепления неприятеля."
                            }
                        ]
                    },
                    {
                        "sense_id": "18b437b6-1c41-3d6d-ae92-48761e74f114",
                        "entry_id": "cd2b50b5-4ebd-3f91-8359-d5edb1b03908",
                        "glosses": [
                            "катя, перемещать в одно место, собирать, располагать в одном месте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bc0e065-9349-4663-8016-1d152f1c155b",
                                "sense_id": "18b437b6-1c41-3d6d-ae92-48761e74f114",
                                "text": "Осенью к дамбе скатывали бочки, торцами прислоняли их к стене, туманы в эту пору, да и весь городишко пахли рыбой, плесенью мхов, вянущей огородиной."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b5380f2-6e88-3adc-bd74-5b8f5c998bbd",
                        "entry_id": "cd2b50b5-4ebd-3f91-8359-d5edb1b03908",
                        "glosses": [
                            "неперех., разг. катясь, перемещаясь на транспорте, съезжать вниз"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f1729969-4fe9-3a90-b028-d022890672fc",
                        "entry_id": "cd2b50b5-4ebd-3f91-8359-d5edb1b03908",
                        "glosses": [
                            "разг. мыть, окатывая водой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef3f7547-d99b-4780-b375-5a7d5975ef53",
                                "sense_id": "f1729969-4fe9-3a90-b028-d022890672fc",
                                "text": "На заре матросы из ведер скатывали окровавленную палубу."
                            }
                        ]
                    }
                ],
