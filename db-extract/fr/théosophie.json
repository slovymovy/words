        "fr-extract.jsonl": [
            {
                "entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
                "word": "théosophie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84ee1587-e4fc-4c06-8030-649911d35cd5",
                        "entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
                        "tags": [
                            "plural"
                        ],
                        "form": "théosophies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6f1413c-7521-3856-9bed-0faa1018c2e2",
                        "entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
                        "glosses": [
                            "Nom générique s'appliquant aux doctrines des gnostiques qui assuraient entrer en communication avec le divin, et gagner à ce contact privilégié, des lumières particulières."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8e793917-62d7-3d85-b05f-87e6e352ec5e",
                        "entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
                        "glosses": [
                            "Doctrine ésotérique et philosophique fondée sur les écrits de Helena Blavatsky."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aff20f1c-c909-40f1-9125-823e354924b5",
                                "sense_id": "8e793917-62d7-3d85-b05f-87e6e352ec5e",
                                "text": "Une aberration du même genre inspire les écrits et les discours d'une prophétesse récente, une certaine Annie Besant, femme d'un pasteur anglican qui lâcha sa famille pour propager la théosophie. Je trouve dans un journal de la secte ( Le Théosophe, nᵒ du 16 août 1911) la sténographie d'une de ses conférences. Voici quelques-uns de ses dires: «Notre société théosophique doit aller au-devant du christianisme pour l'aider à instituer de nouveau les mystères qui conduisent à l'initiation...»\nAux premiers siècles de l'Église, Simon, Manès, Valentin, émettaient également cette prétention de diriger les chrétiens vers une compréhension supérieure des mystères."
                            },
                            {
                                "example_id": "befe0990-a575-4733-9dbc-eca9eab5f6a9",
                                "sense_id": "8e793917-62d7-3d85-b05f-87e6e352ec5e",
                                "text": "Paroles d’un steward : « Pour combattre efficacement le mal de mer, il faut lire des livres de théosophie. » C’est un théosophe enragé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd194e34-dba7-4342-a9ea-164ba03de56f",
                        "source_entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
                        "target_lang_word": "theosophy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theosophy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fb91db7-62b0-3a14-a70e-21a4bd4f4595",
                                        "entry_id": "3925d557-85f8-3200-9e72-9c4e081885ca",
                                        "glosses": [
                                            "Any doctrine of religious philosophy and mysticism claiming that knowledge of God can be attained through mystical insight and spiritual ecstasy, and that direct communication with the transcendent world is possible."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d52e7978-5f58-4fcc-96c8-e8c6898fa808",
                                                "sense_id": "1fb91db7-62b0-3a14-a70e-21a4bd4f4595",
                                                "text": "They have their own traditions of art and science. They do not […] discuss God or metaphysics or men. […] All their wisdom and theosophy, and all their grasp of beauty, truth or love, is in the singing. […] They look unloving enough, and so they are. Pitiless fallen angels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b24264-89d5-35d6-a458-ab6cacfb00f1",
                                        "entry_id": "3925d557-85f8-3200-9e72-9c4e081885ca",
                                        "glosses": [
                                            "Any system which claims to attain communication with God and superior spirits by physical processes."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b021e7-528d-4d3e-bd4b-f0f9cfc4d08f",
                                                "sense_id": "13b24264-89d5-35d6-a458-ab6cacfb00f1",
                                                "text": "In Paracelsian theosophy, empathetic imagination was […] a powerful astral force which provided the basis for theurgy and prognostication, as well as for prophecy and mystical inspiration."
                                            },
                                            {
                                                "example_id": "0ac0c431-a414-45d0-b6cc-bae0552224e6",
                                                "sense_id": "13b24264-89d5-35d6-a458-ab6cacfb00f1",
                                                "text": "[…] was founded by the theosophist and kabbalist Martines de Pasqually […] included a peculiar form of theurgy mixed with the philosophy and theosophy of its founder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e8ec13-8b09-3f7e-83aa-221cc3c4429d",
                                        "entry_id": "3925d557-85f8-3200-9e72-9c4e081885ca",
                                        "glosses": [
                                            "The system of beliefs and doctrines of the Theosophical Society."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03a26065-2c96-4ab9-97d7-e6e86239f9bf",
                        "source_entry_id": "a0b66b8c-55b4-31b8-8288-c9a55a508c16",
