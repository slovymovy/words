                "senses": [
                    {
                        "sense_id": "619cd8eb-00b7-30f3-823a-01a4702ca7a7",
                        "entry_id": "e8e903bb-96df-3a3c-86ed-3a11448f8861",
                        "glosses": [
                            "Faden, kleines Teilchen aus dem Rohstoff Zellulose, der aus Holz gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf53d75-35b2-4937-9cbd-eb8752e37928",
                                "sense_id": "619cd8eb-00b7-30f3-823a-01a4702ca7a7",
                                "text": "„Man erhält eine ähnliche Kurve, wenn man feuchte Zellulosefasern in Atmosphären von niedrigeren relativen Feuchtigkeiten bringt und die erhaltenen Werte graphisch aufträgt.“"
                            },
                            {
                                "example_id": "6dc19ee5-b4cd-4bc3-88ab-44ee431507d8",
                                "sense_id": "619cd8eb-00b7-30f3-823a-01a4702ca7a7",
                                "text": "„Zusammenfassend kann gesagt werden, daß beim Färben tierischer Fasern chemische Vorgänge überwiegen, während es sich beim Färben pflanzlicher und künstlicher Zellulosefasern mehr um physikalische Erscheinungen handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
