                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e091528-cdb7-42ca-b38a-cdce0925e409",
                                "sense_id": "dfd4e3e3-5f0f-32be-ad5a-3fe8cfba0f35",
                                "text": "„Wenn aber eine Farbsehschwäche allgemein vorhanden ist, kann auch der Physiker niemandem beweisen, ob eine Fläche grün oder blau ist.“"
                            },
                            {
                                "example_id": "67c1f33b-0a77-495f-87c1-3e6066b8bda5",
                                "sense_id": "dfd4e3e3-5f0f-32be-ad5a-3fe8cfba0f35",
                                "text": "„Nehmen wir zum Beispiel Menschen mit Farbsehschwäche, die bestimmte Farbtöne nicht auseinanderhalten (oder manchmal gar keine Farben erkennen) können.“"
                            }
                        ],
