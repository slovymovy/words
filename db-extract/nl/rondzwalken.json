        "nl-extract.jsonl": [
            {
                "entry_id": "46c1bfb5-3197-3ba7-ba94-656d50017d54",
                "word": "rondzwalken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9fa4f065-7d7f-31aa-9111-6f55c87eb614",
                        "entry_id": "46c1bfb5-3197-3ba7-ba94-656d50017d54",
                        "glosses": [
                            "zonder duidelijke richting en doel bewegen in een bepaalde ruimte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "285f0b12-01a5-4231-a45c-2cef19e2304a",
                                "sense_id": "9fa4f065-7d7f-31aa-9111-6f55c87eb614",
                                "text": "‘Ik zag ook mensen verdoofd rondzwalken op straat, soms bloedend.'"
                            },
                            {
                                "example_id": "039de1db-42b5-4ab3-b341-9533ed7d7494",
                                "sense_id": "9fa4f065-7d7f-31aa-9111-6f55c87eb614",
                                "text": "De excentrieke voormalig profbasketballer Dennis Rodman is gearresteerd omdat hij stomdronken een aantal mensen zou hebben lastiggevallen bij een autowasstraat in Amerika. Het personeel van de wasstraat vertrouwde de boel niet toen ze een lamme Rodman zagen rondzwalken en schakelde de politie in, meldt TMZ."
                            },
                            {
                                "example_id": "59dc11a6-dd00-42ae-bf7c-68f8c86ce8e7",
                                "sense_id": "9fa4f065-7d7f-31aa-9111-6f55c87eb614",
                                "text": "Maar de Baltic Sky bleef twee weken lang in het oosten van de Middellandse Zee rondzwalken, totdat het schip zondag door de Griekse kustwacht werd geënterd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1be4e8bc-0cd8-4c4d-b168-f0c1c1dbc0c0",
                        "source_entry_id": "46c1bfb5-3197-3ba7-ba94-656d50017d54",
                        "source_sense_id": "9fa4f065-7d7f-31aa-9111-6f55c87eb614",
