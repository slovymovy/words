                "senses": [
                    {
                        "sense_id": "30bd93d7-f77c-39cd-911f-3a597756b9e3",
                        "entry_id": "f11e1f61-3d6d-3ffc-9c77-639c68b93e84",
                        "glosses": [
                            "Backwaren mit mindestens 10 % Fett- und/oder Zuckeranteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a3409a4-c384-40d6-a3cb-e209deb95d88",
                                "sense_id": "30bd93d7-f77c-39cd-911f-3a597756b9e3",
                                "text": "„Unter feinen Backwaren (auch: Feingebäck, Feinbackwaren, international: Viennoiseries) versteht der Bäcker alle Backwaren, die, bezogen auf 90 Teile Getreidemahlerzeugnisse, mindestens 10 Teile Fett und/oder Zucker enthalten müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4f02ad4-277a-40c6-8233-5d68b120a368",
                        "source_entry_id": "f11e1f61-3d6d-3ffc-9c77-639c68b93e84",
                        "source_sense_id": "30bd93d7-f77c-39cd-911f-3a597756b9e3",
                        "target_lang_word": "viennoiserie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viennoiserie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca22bb44-8579-3f60-b0ec-66e87ec7f34f",
                                        "entry_id": "22b4eb0e-0122-3266-ad82-2b98d069c92a",
                                        "glosses": [
                                            "A baked product made in a similar manner to bread, but with ingredients giving it a sweeter, heavier quality closer to a pastry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca2fb4b8-62b2-4edc-ab6b-193650da565c",
                                                "sense_id": "ca22bb44-8579-3f60-b0ec-66e87ec7f34f",
                                                "text": "I didn't fully appreciate the amazingness of French viennoiserie (croissants, etc.) until I found myself in Switzerland ordering a pain au chocolat."
                                            },
                                            {
                                                "example_id": "77af04eb-b75c-4c6b-b35b-277cb38c75fa",
                                                "sense_id": "ca22bb44-8579-3f60-b0ec-66e87ec7f34f",
                                                "text": "The term viennoiserie appeared at the beginning of the twentieth century, initially referring to Viennese breads and croissants introduced by the Austrian August Zang."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d07fb9f5-8ccf-4a4c-a834-89faa1fd6987",
                        "source_entry_id": "f11e1f61-3d6d-3ffc-9c77-639c68b93e84",
                        "source_sense_id": "30bd93d7-f77c-39cd-911f-3a597756b9e3",
                        "target_lang_word": "pâtisserie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâtisserie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ceccb59-3a79-32e7-b8a3-40275fb4ea69",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Préparation sucrée ou salée de pâte préparée et cuite au four."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af8d0759-d78b-4900-b340-328138b53784",
                                                "sense_id": "2ceccb59-3a79-32e7-b8a3-40275fb4ea69",
                                                "text": "Mais ça peut donner de belles choses, comme les pâtisseries de Jeffrey Cagnes à déguster en exclusivité dans le City garage de la marque espagnole de voitures Cupra, ouvert à la Madeleine, à Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Art de faire la pâtisserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a46d706-185d-42b8-b609-4c8aefe7bc98",
                                                "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                                "text": "Cette ville est réputée pour sa pâtisserie."
                                            },
                                            {
                                                "example_id": "5fbcfec3-ae82-4611-9198-4909767bdc4a",
                                                "sense_id": "1b0c90d4-d113-37a1-be8e-1412f7fff5d3",
                                                "text": "— La pâtisserie, merde alors, si c’est ça que tu appelles un métier !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3dbe3d3-516a-30f9-a5ac-6d1d068cd056",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Magasin où l’on vend des gâteaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486f8a6c-6151-4787-b22c-692b14fb91b3",
                                                "sense_id": "f3dbe3d3-516a-30f9-a5ac-6d1d068cd056",
                                                "text": "Goûter dans une pâtisserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dee78015-5643-3d82-b455-d4d500481af8",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Gâteaux et sucreries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02598c2-15e8-4536-b196-aafdf4a82012",
                                                "sense_id": "dee78015-5643-3d82-b455-d4d500481af8",
                                                "text": "On est vraiment de l’autre côté des Pyrénées. Un petit café noir. Café negro. Il y a tout un assortiment de biscuits collants, de pâtisseries compactes, d’étouffe-chrétiens emballés sous cellophane, conditionnés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c69e65-3ad1-3371-8f73-7851df6e3974",
                                        "entry_id": "45dedba0-cb5a-3a15-a3ab-cc9f101a5eb0",
                                        "glosses": [
                                            "Ornement fait de pâte, que l’on applique aux murailles, aux corniches, aux plafonds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
