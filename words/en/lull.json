{
    "word_family": [
        "lullaby"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                    "sense_definition": "To cause to rest by soothing influences; to compose; to calm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother sang a soft song to <w>lull</w> the baby to sleep.",
                            "target_lang_translations": {
                                "ru": "Мать пела тихую песню, чтобы <w>убаюкать</w> ребенка."
                            }
                        },
                        {
                            "text": "Gentle music can <w>lull</w> an anxious mind into a state of relaxation.",
                            "target_lang_translations": {
                                "ru": "Нежная музыка может <w>успокоить</w> тревожный ум и привести его в состояние расслабления."
                            }
                        }
                    ],
                    "synonyms": [
                        "soothe",
                        "quiet",
                        "appease"
                    ],
                    "common_phrases": [
                        "lull to sleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убаюкивать, успокаивать кого-либо, помогая заснуть или расслабиться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убаю́кивать",
                                "target_lang_sense_clarification": "укачивая и напевая, заставлять уснуть"
                            },
                            {
                                "target_lang_word": "усыпля́ть",
                                "target_lang_sense_clarification": "навеивать сон"
                            },
                            {
                                "target_lang_word": "успока́ивать",
                                "target_lang_sense_clarification": "приводить в состояние спокойствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                    "sense_definition": "To become gradually calm; to subside; to cease or abate",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain finally <w>lulled</w> after several hours of storming.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь наконец <w>затих</w> после нескольких часов бури."
                            }
                        },
                        {
                            "text": "We waited for the wind to <w>lull</w> before we tried to sail the boat.",
                            "target_lang_translations": {
                                "ru": "Мы ждали, пока ветер <w>затихнет</w>, прежде чем пытаться управлять лодкой."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становиться тише, утихать, прекращаться (о ветре, буре или шуме)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затиха́ть",
                                "target_lang_sense_clarification": "ослабевать, прекращаться (о ветре, буре)"
                            },
                            {
                                "target_lang_word": "зати́хнуть",
                                "target_lang_sense_clarification": "перестать звучать или ослабеть в силе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41eca79e-7034-3e1b-b89f-06ae765c7e82",
                    "sense_definition": "A period of reduced activity; a respite",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a brief <w>lull</w> in the conversation before someone started talking again.",
                            "target_lang_translations": {
                                "ru": "В разговоре возникла короткая <w>пауза</w>, прежде чем кто-то снова начал говорить."
                            }
                        },
                        {
                            "text": "The business experienced a <w>lull</w> in sales during the middle of the summer.",
                            "target_lang_translations": {
                                "ru": "В середине лета в бизнесе наблюдалось <w>затишье</w> в продажах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lull in activity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период временного затишья, перерыв в деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зати́шье",
                                "target_lang_sense_clarification": "временное прекращение шума или движения"
                            },
                            {
                                "target_lang_word": "переры́в",
                                "target_lang_sense_clarification": "приостановка какой-либо деятельности"
                            },
                            {
                                "target_lang_word": "па́уза",
                                "target_lang_sense_clarification": "перерыв в действии или процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                    "sense_definition": "A period without waves or wind",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors waited for a <w>lull</w> in the wind to adjust the sails.",
                            "target_lang_translations": {
                                "ru": "Моряки ждали <w>затишья</w> ветра, чтобы поправить паруса."
                            }
                        },
                        {
                            "text": "During the <w>lull</w>, the surface of the ocean became perfectly still.",
                            "target_lang_translations": {
                                "ru": "Во время <w>штиля</w> поверхность океана стала совершенно неподвижной."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Период полного безветрия или отсутствия волн на море."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штиль",
                                "target_lang_sense_clarification": "полное безветрие над водным пространством"
                            },
                            {
                                "target_lang_word": "зати́шье",
                                "target_lang_sense_clarification": "временное прекращение ветра"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                    "sense_definition": "An extended pause between sets of waves",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pause",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Surfers often wait for a <w>lull</w> to paddle out past the breaking waves.",
                            "target_lang_translations": {
                                "ru": "Серферы часто ждут <w>затишья</w>, чтобы проплыть за разбивающиеся волны."
                            }
                        },
                        {
                            "text": "He timed his entry into the water to coincide with a <w>lull</w> between sets.",
                            "target_lang_translations": {
                                "ru": "Он рассчитал свой вход в воду так, чтобы он совпал с <w>паузой</w> между сериями волн."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительная пауза между сериями волн."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зати́шье",
                                "target_lang_sense_clarification": "временное прекращение движения"
                            },
                            {
                                "target_lang_word": "па́уза",
                                "target_lang_sense_clarification": "перерыв в процессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "965ffa1a-3e35-3fe1-b7e6-8ff709c233cf",
                    "sense_definition": "A period of rest or soothing",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet afternoon provided a much-needed <w>lull</w> from the busy week.",
                            "target_lang_translations": {
                                "ru": "Тихий день подарил столь необходимое <w>затишье</w> после напряженной недели."
                            }
                        },
                        {
                            "text": "She enjoyed the <w>lull</w> of the evening after the children had finally fallen asleep.",
                            "target_lang_translations": {
                                "ru": "Она наслаждалась вечерним <w>покоем</w> после того, как дети наконец уснули."
                            }
                        }
                    ],
                    "synonyms": [
                        "quiet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период покоя, отдыха или тишины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зати́шье",
                                "target_lang_sense_clarification": "временное успокоение"
                            },
                            {
                                "target_lang_word": "о́тдых",
                                "target_lang_sense_clarification": "пребывание в состоянии покоя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "53d38bd5-c140-3466-a5c7-61ece2524ae6",
                    "sense_definition": "A surname",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The research paper was written by a scientist named <w>Lull</w>.",
                            "target_lang_translations": {
                                "ru": "Научная статья была написана ученым по фамилии <w>Лалл</w>."
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Lull</w> have roots in European history.",
                            "target_lang_translations": {
                                "ru": "Многие люди с фамилией <w>Лалл</w> имеют корни в европейской истории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}