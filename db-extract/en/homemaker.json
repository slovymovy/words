                    {
                        "translation_id": "a9358705-4809-4d91-9af4-4b2cdeb8ed1b",
                        "source_entry_id": "c3daabb6-de8c-3109-b323-cf89404de0f4",
                        "source_sense_id": "b49dc693-3323-3fa8-a478-739ffefdd3bf",
