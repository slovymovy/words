                "senses": [
                    {
                        "sense_id": "86d65e53-f50f-32ef-bf27-b052d6ec15de",
                        "entry_id": "09a8f030-263e-3624-83ea-decc14b2048f",
                        "glosses": [
                            "комп. устройство (электронный блок либо интегральная схема), предназначенное для выполнения машинных инструкций (кода программ) данных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d120f91-52d0-48a7-a752-dd8c729cd715",
                                "sense_id": "86d65e53-f50f-32ef-bf27-b052d6ec15de",
                                "text": "Центральный процессор выполняет арифметические и логические операции, заданные программой, управляет вычислительным процессом и координирует работу всех устройств компьютера."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a0b9963-bfcf-38b8-98cc-b79e9917e59b",
                        "entry_id": "09a8f030-263e-3624-83ea-decc14b2048f",
                        "glosses": [
                            "комп. программа, предназначенная для обработки специфических данных"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "94da2446-6c87-32c2-baa7-8385ef2bcd39",
                        "entry_id": "09a8f030-263e-3624-83ea-decc14b2048f",
                        "glosses": [
                            "устройство, предназначенное для выполнения операций по обработке каких-либо материальных объектов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb5dabf1-e8ce-4456-8334-8b8733b22896",
                                "sense_id": "94da2446-6c87-32c2-baa7-8385ef2bcd39",
                                "text": "Кухонный процессор можно также использовать в качестве терки-измельчителя."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b8531dc-d3c9-4a6f-9136-5533101fb6ae",
                        "source_entry_id": "09a8f030-263e-3624-83ea-decc14b2048f",
                        "source_sense_description": "устройство для выполнение машинных инструкций",
                        "target_lang_word": "processor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
