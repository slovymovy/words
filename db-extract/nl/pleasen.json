                "senses": [
                    {
                        "sense_id": "b4d5f929-cbbf-3d1b-9c2f-aebba33822a3",
                        "entry_id": "d0ae7c43-90cb-3f10-ba9a-7a3e16e6c3ef",
                        "glosses": [
                            "to please someone (in a psychologically unhealthy way); to pander, especially self-effacingly"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "652a34a2-c721-4f02-8b6d-3d1b370b6bd8",
                                "sense_id": "b4d5f929-cbbf-3d1b-9c2f-aebba33822a3",
                                "text": "Ze pleaset de hele tijd haar ouders en denkt nooit aan haar eigen welzijn.",
                                "translation": "She keeps pleasing her parents and never thinks of her own well-being.",
                                "english": "She keeps pleasing her parents and never thinks of her own well-being."
                            }
                        ]
                    }
