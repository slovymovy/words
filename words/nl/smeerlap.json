                },
                {
                    "sense_id": "8a3a1a4a-9ade-3f93-bd80-b0e6f8c6ac0a",
                    "sense_definition": "Een vette lap of doek die gebruikt wordt om onderdelen in te smeren om wrijving te verminderen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koetsier pakte de <w>smeerlap</w> om de assen van de wagen snel in te vetten.",
                            "target_lang_translations": {
                                "en": "The coachman grabbed the <w>grease rag</w> to quickly lubricate the wagon's axles."
                            }
                        },
                        {
                            "text": "Met een vette <w>smeerlap</w> maakte hij de glij-ijzers van de slee weer glad.",
                            "target_lang_translations": {
                                "en": "With a greasy <w>lubricating cloth</w>, he made the sled's runners smooth again."
                            }
                        }
                    ],
                    "traits": [
