                        "entry_id": "3d55e4d7-93a6-3897-9ddc-a1db7b836fd8",
                        "glosses": [
                            "Avant le moment prévu ; par anticipation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "413dcc5b-2f60-4f49-9940-a0412a6fbd55",
                                "sense_id": "7dd93403-3598-386e-aa3b-eefe8ba2d7bf",
                                "text": "Nous payâmes d’avance."
                            },
                            {
                                "example_id": "e96bdf3b-f4fd-4734-8931-d4fa0533895f",
                                "sense_id": "7dd93403-3598-386e-aa3b-eefe8ba2d7bf",
                                "text": "Toutefois, si un juge-arbitre a été désigné d’avance, les joueurs peuvent en appeler à lui des décisions de l’arbitre sur tout point concernant l’interprétation de la règle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cebbacdb-86ed-4796-a45c-82ec4c397607",
