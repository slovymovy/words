                                            {
                                                "example_id": "b89dfc5f-f90f-4b1f-9fa7-d1912709dfb1",
                                                "sense_id": "f12bdc97-ef3e-3141-a005-cbc2ce570472",
                                                "text": "Hogg devint le Méphisto de ce jeune Faust [Shelley] et le confident de ses publications subversives."
                                            },
                                            {
                                                "example_id": "ae2f1a05-2f0f-49ec-9edd-f1a0fb838290",
                                                "sense_id": "f12bdc97-ef3e-3141-a005-cbc2ce570472",
                                                "text": "Disciples du vieux Faust, écoliers, bacheliers,\nQui penchez sur maint tome une face abattue\nDans les doctes bazars où la lettre vous tue,\nEntendez Méphisto rire au creux des piliers."
                                            }
                                        ]
