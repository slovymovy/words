                "senses": [
                    {
                        "sense_id": "483b5d4a-ae5b-3e02-b84d-35e12c3cabf3",
                        "entry_id": "20402277-8be7-3c82-b0ab-02534fb72e1e",
                        "glosses": [
                            "Aménagement de la ville permettant l’absorption locale des eaux de pluie — par la récupération des eaux de ruissellement et leur stockage dans des bassins, des mares, ou bien en les laissant imprégner le sol par des revêtements poreux — plutôt que leur évacuation par les réseaux d’égouts."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "f194dd96-a478-4d48-a767-54a0d032fcc9",
                                "sense_id": "483b5d4a-ae5b-3e02-b84d-35e12c3cabf3",
                                "text": "En arrivant, on distingue d’abord des berges, plantées de roseaux. Et puis 3 bassins, reliés les uns aux autres. […] Ces bassins ne représentent qu’une pièce du puzzle qui en compte des centaines d’autres, destiné à faire de Berlin une ville-éponge. Partout, des chantiers ou des projets sont en cours : citernes souterraines, toits végétalisés, dalles de gazon…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fed4cc4-b41e-4271-a3de-3a6de1b50631",
                        "source_entry_id": "20402277-8be7-3c82-b0ab-02534fb72e1e",
                        "source_sense_id": "483b5d4a-ae5b-3e02-b84d-35e12c3cabf3",
                        "target_lang_word": "Schwammstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwammstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                        "entry_id": "3d329825-98fb-3cb2-9c61-044415f387ef",
                                        "glosses": [
                                            "Stadt, die das Konzept verwirklicht, örtlich anfallendes Regenwasser unterirdisch zu speichern"
                                        ],
                                        "tags": [
                                            "Stadtplanung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28e5010f-eb49-41d0-83ba-46f835cfac92",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Das Ziel der Schwammstadt ist, das Niederschlagswasser dort zwischenzuspeichern, wo es fällt.“"
                                            },
                                            {
                                                "example_id": "61cc9f0b-4100-48b8-b7b7-9b20fe44c7a7",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Schwammstädte nehmen das Regenwasser wie Schwämme auf und geben es peu à peu zeitverzögert wieder ab, das Regenwasser bleibt in der Stadt“."
                                            },
                                            {
                                                "example_id": "717175f1-c1c9-441e-834e-0e3bbdbea879",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Damit leisten die natürliche Überflutungs- und Sickerflächen in der Schwammstadt einen vielfältigen Beitrag für ein gesünderes Stadtklima und steigern die Aufenthalts- und Lebensqualität in den Stadtquartieren.“"
                                            },
                                            {
                                                "example_id": "0a78c103-0f5e-4cc4-b825-9c846c3b2069",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Beim „Schwammstadt“-Prinzip versickert Wasser nicht nur über die Grünflächen, sondern auch Fuß- und Radwege, Parkplätze oder Straßen werden möglichst durchlässig gestaltet. So kann mehr Regenwasser zwischengespeichert werden.“"
                                            },
                                            {
                                                "example_id": "e2e2faa8-85f6-446b-8ecf-69018c267885",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Das Prinzip der „Schwammstadt“ gibt den Wurzeln auch unter Straßen, Parkplätzen und Gehwegen mehr Raum.“"
                                            },
                                            {
                                                "example_id": "433bdc81-f99f-4379-a46c-b65afeca138a",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Mit dem Konzept Schwammstadt soll Regenwasser dort zwischengespeichert werden, wo es fällt.“"
                                            },
                                            {
                                                "example_id": "e53b2c4b-82ad-40b4-83b8-cf55a4286e63",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Schwammstädte sind urbane Ökosysteme, die darauf ausgelegt sind, Überschwemmungen zu nutzen, anstatt sie deren Lebensgrundlagen zerstören zu lassen.“"
                                            },
                                            {
                                                "example_id": "c62d0013-97c4-4f70-a861-657222a89cc6",
                                                "sense_id": "48d19792-3ead-383d-85aa-ef8670c801fd",
                                                "text": "„Mit Hilfe von Schwammstädten, so Prof. Kongjian Yu, haben Stadtplaner die Möglichkeit, miit der Natur zu arbeiten, statt gegen sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
