                                "example_id": "ab08639a-56ee-4db2-9245-fa175a61f832",
                                "sense_id": "8457ae59-e77e-35e1-8fca-6cd6177e39f4",
                                "text": "The writer is not responsible for the antiphonetic spelling of this and many other colonial names of places."
                            },
