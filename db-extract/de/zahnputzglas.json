                        "glosses": [
                            "gläsernes Gefäß, das beim Zähneputzen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccd79084-a5fa-4f71-ba46-ca5194d86012",
                                "sense_id": "4a884a21-d65f-36fe-8231-16f9f469f915",
                                "text": "„Die Uhr jedoch ist nicht an ihrem Platz, liegt irgendwo herum, auf dem Nachttisch, auf der Fensterbank, zwischen den Zahnputzgläsern vor dem Spiegel.“"
                            },
                            {
                                "example_id": "3c362102-79ca-4eed-9942-7a327f0d66ad",
                                "sense_id": "4a884a21-d65f-36fe-8231-16f9f469f915",
                                "text": "„Er füllte die beiden Zahnputzgläser des Waschbeckens und reichte dem andern ein Glas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
