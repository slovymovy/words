                    },
                    {
                        "translation_id": "22e5c640-7e30-4e60-aeaf-a600d679ad21",
                        "source_entry_id": "f1d3ada6-7587-3361-b679-ab647d010128",
                        "source_sense_id": "20c29f75-9cc6-397a-977c-510381cd761c",
                        "target_lang_word": "Fischer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                        "entry_id": "e2cc6310-736f-3356-9140-1dc48c6ceafb",
                                        "glosses": [
                                            "Arbeiter, Selbstständiger, der erwerbsmäßig Fang von Fisch betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef0cff9-ebb2-4442-8c80-6aa704656f0d",
                                                "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                                "text": "Die Fischer holten einen guten Fang ein."
                                            },
                                            {
                                                "example_id": "a7ff04f8-3ce0-4d10-996d-c4019b11f128",
                                                "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                                "text": "„Eine besondere Klasse bildeten die Wenden, soweit sie für sich in geschlossenen Siedlungen an den alten Lebensbedingungen und z.T. auch ihrer Religion festhielten. Hierzu gehörten besonders die Kietze, Fischer und Zeidler.“"
                                            },
                                            {
                                                "example_id": "536b751c-18b8-470c-bfe7-3951d82e0101",
                                                "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                                "text": "„Der Fischer war ein etwa fünfundzwanzigjähriger Kerl mit Muskeln wie Schiffsmasten.“"
                                            },
                                            {
                                                "example_id": "d86b6c35-b748-4f81-8989-4e1b1d8be378",
                                                "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                                "text": "„Die Fischer gingen in Richtung Stadt und verschwanden.“"
                                            },
                                            {
                                                "example_id": "7a76dbe5-d3b8-499e-af5b-d2783d419b27",
                                                "sense_id": "5c6a9adb-0a9f-329e-b26c-db5cd0768f9f",
                                                "text": "„Fünf Minuten später kamen Fischer und Fischerinnen herbeigeeilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fba8afb-8600-3eb0-a1a8-d70066735d16",
                                        "entry_id": "e2cc6310-736f-3356-9140-1dc48c6ceafb",
                                        "glosses": [
                                            "Person, die fischt, Fisch fängt; Angler"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ebdfa2-6137-452d-be76-e0f2d5db0e8b",
                                                "sense_id": "8fba8afb-8600-3eb0-a1a8-d70066735d16",
                                                "text": "Am Wochenende liebt er es, als Fischer am kleinen See zu angeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fischer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                        "entry_id": "4c61ad16-5733-3e72-be52-1c2f31ff619c",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname mit dem vierthäufigsten Vorkommen in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3dd527e-9f29-4e80-a8ba-6c9b48a8aece",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Fischers sind schon seit 20 Jahren im Kegelclub."
                                            },
                                            {
                                                "example_id": "6b458b96-0e61-4062-8885-f37f22a4679a",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Ulrike Fischer macht ein Auslandssemester in Norwegen."
                                            },
                                            {
                                                "example_id": "e694cdca-0938-40ff-b7f4-eb119d5bf288",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Der Fischer spült und die Fischer trocknet ab."
                                            },
                                            {
                                                "example_id": "b147e04a-a437-49fd-b54b-90923ea9d935",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Frau Fischer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "d00cb080-f303-46e7-886c-730f9385a897",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Herr Fischer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "54cb955a-cf21-438d-94f3-9b815fbd43d3",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Die Fischers fliegen heute nach Sri Lanka."
                                            },
                                            {
                                                "example_id": "bc8dc0c2-dd9b-4d8c-845d-3580da151bee",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Der Fischer trägt nie die Pullover, die die Fischer ihm strickt."
                                            },
                                            {
                                                "example_id": "8bad7087-c5b6-458f-814a-e41137ca7636",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fischer kommt, geht der Herr Fischer.“"
                                            },
                                            {
                                                "example_id": "b8f915b9-5d2e-4af9-b824-1112009e6b2e",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Fischer kommt und geht."
                                            },
                                            {
                                                "example_id": "5b1a74e9-de32-4509-9456-b70636e0308b",
                                                "sense_id": "9415a5bc-0f6a-393d-aa06-be45ffb0fbe8",
                                                "text": "Fischers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
