                    {
                        "sense_id": "a6209b42-c5c6-3c50-a536-3f531d45c185",
                        "entry_id": "7f5e78f5-1a36-3800-80b8-045a994b0980",
                        "glosses": [
                            "bepaald soort plant met blauwe vruchten, Prunus spinosa uit de rozenfamilie Rosaceae"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c10211-51bc-43bf-81d2-d9f29fa9fbd9",
                                "sense_id": "a6209b42-c5c6-3c50-a536-3f531d45c185",
                                "text": "De vruchten van de sleedoorn worden wel tot jam of sterke drank verwerkt, maar ze zijn erg sleeuw."
                            },
                            {
                                "example_id": "9b877334-720f-4c0e-9bc2-b9da03db1401",
                                "sense_id": "a6209b42-c5c6-3c50-a536-3f531d45c185",
                                "text": "Sleedoorn, een heester, wordt veel langs wegen en bosranden geplant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf2d515-03ff-423c-bfc8-1ca620905140",
                        "source_entry_id": "7f5e78f5-1a36-3800-80b8-045a994b0980",
                        "source_sense_id": "a6209b42-c5c6-3c50-a536-3f531d45c185",
                        "source_sense_description": "bepaald soort plant met blauwe vruchten, Prunus spinosa",
                        "target_lang_word": "sloe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sloe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b2735b-9129-36e3-a21e-afb99ce1cf7f",
                                        "entry_id": "270478dd-3efd-32ce-9a34-692d95e9768c",
                                        "glosses": [
                                            "The small, astringent, wild fruit of the blackthorn (Prunus spinosa)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a93fa9-e0cc-42b2-93e1-bd2eecd8c356",
                                                "sense_id": "d0b2735b-9129-36e3-a21e-afb99ce1cf7f",
                                                "text": "There is also a dryness in the mouth from the increased action of the absorbent vessels, when a sloe or a crab-apple are masticated..."
                                            },
                                            {
                                                "example_id": "99147db5-64b5-4e56-8bf5-ed244fd914ea",
                                                "sense_id": "d0b2735b-9129-36e3-a21e-afb99ce1cf7f",
                                                "text": "The dew-drops fell like water, leaf after leaf dropped from the trees, the sloe-thorn alone still bore fruit, but the sloes were sour, and set the teeth on edge. Oh, how dark and weary the whole world appeared!"
                                            },
                                            {
                                                "example_id": "9c720a50-8d0f-4273-96c6-3cf95d42598b",
                                                "sense_id": "d0b2735b-9129-36e3-a21e-afb99ce1cf7f",
                                                "text": "Katúsha, with her eyes black as sloes, her face radiant with joy, was flying towards him, and they caught hold of each other's hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fed13116-de58-3f7e-b1bc-cdd155998e39",
                                        "entry_id": "270478dd-3efd-32ce-9a34-692d95e9768c",
                                        "glosses": [
                                            "The tree Prunus spinosa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e81d862-31d7-3ebd-86af-ab0214b432a0",
                                        "entry_id": "270478dd-3efd-32ce-9a34-692d95e9768c",
                                        "glosses": [
                                            "Any of various other plants of the genus Prunus, as a shrub or small tree, Prunus alleghaniensis, bearing dark-purple fruit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
