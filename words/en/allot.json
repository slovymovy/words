                    "sense_definition": "Common misspelling of <w>a lot</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misspelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She writes <w>allot</w> of letters to her friends, though it is grammatically incorrect.",
                            "target_lang_translations": {
                                "ru": "Она пишет <w>много</w> писем своим друзьям, хотя это грамматически неверно."
                            }
                        },
                        {
                            "text": "It is common to see people write <w>allot</w> instead of the correct two-word form.",
                            "target_lang_translations": {
                                "ru": "Часто можно увидеть, как люди пишут <w>allot</w> вместо правильной формы из двух слов."
                            }
                        }
                    ],
                    "traits": [
                        {
