                                    {
                                        "sense_id": "1279ccc6-3b2c-3c69-975d-f715392f4519",
                                        "entry_id": "873e5c3f-321d-3ee3-b384-03c69a6ea678",
                                        "glosses": [
                                            "dotto che, nell'antica Grecia, insegnava a parlare in pubblico a pagamento"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1c5045-01e2-494b-9cb7-156eb3dd83c3",
                                                "sense_id": "1279ccc6-3b2c-3c69-975d-f715392f4519",
                                                "text": "Gorgia, Protagora e Trasimaco furono famosi sofisti"
                                            },
                                            {
                                                "example_id": "3b8faaee-53d7-47d7-9a9b-c21a0b1f09d8",
                                                "sense_id": "1279ccc6-3b2c-3c69-975d-f715392f4519",
                                                "text": "il sofista era un intellettuale di professione che insegnava ai giovani l'arte di persuadere per farsi largo nella vita pubblica"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a29e351-21bf-3af2-ba0b-86f73bbdaaae",
                                        "entry_id": "873e5c3f-321d-3ee3-b384-03c69a6ea678",
                                        "glosses": [
                                            "chi esprime un'argomentazione apparentemente vera ma fondata su premesse false"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f22a7e9f-d3d5-4e85-8c2c-1ad4e53e721c",
                        "source_entry_id": "6e3aac80-448c-3d25-9b33-aed8e587dea0",
                        "target_lang_word": "Sophist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sophist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                        "entry_id": "fe9b37e9-c088-38c2-bee2-7f61bb082d22",
                                        "glosses": [
                                            "ein Vertreter der Sophistik, einer Gruppe von griechischen Philosophen des 5. und 4. Jahrhunderts vor Christus, die als Wanderlehrer gegen Entgelt vor allem in Athen auftraten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c8d318-d60a-43aa-86fb-47231b7b9a71",
                                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                                "text": "„Da die Sophisten als einzelne Lehrer verschiedener Wissenschaften aufgetreten sind, kann man auch nicht von einer Schule im Sinne einer einheitlichen Lehrmeinung sprechen.“"
                                            },
                                            {
                                                "example_id": "10c76859-40a9-4e93-9581-8e984b06b3e9",
                                                "sense_id": "2e8f65ee-9191-3ab3-8972-b27f47abbd46",
                                                "text": "„In Athen verdienten die Sophisten ihren Lebensunterhalt damit, die Bürger der Stadt zu unterrichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d1c73d1-aa55-33d4-af9a-27533652ce58",
                                        "entry_id": "fe9b37e9-c088-38c2-bee2-7f61bb082d22",
                                        "glosses": [
                                            "eine Person, die sophistisch argumentiert"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
