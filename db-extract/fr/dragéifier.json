                "senses": [
                    {
                        "sense_id": "be1f5d8c-50e4-3867-b608-40efa714c5e9",
                        "entry_id": "d3d3e87d-30a3-3bd0-b12a-3a6542153e7f",
                        "glosses": [
                            "Préparer sous la forme d'une dragée (ne s'emploie guère qu'au participe passé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa8eb87-c3dc-49a6-b26e-3b0764c86310",
                                "sense_id": "be1f5d8c-50e4-3867-b608-40efa714c5e9",
                                "text": "Comprimé dragéifié."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2eabc033-363b-4d10-9041-bec5ed94dbb5",
                        "source_entry_id": "d3d3e87d-30a3-3bd0-b12a-3a6542153e7f",
                        "source_sense_id": "be1f5d8c-50e4-3867-b608-40efa714c5e9",
                        "target_lang_word": "sugarcoat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sugarcoat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57bdcdb2-782e-30fe-961f-15a1766a6d84",
                                        "entry_id": "eb25c7ca-6706-3216-903c-7b3a21bde043",
                                        "glosses": [
                                            "To coat with sugar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                        "entry_id": "eb25c7ca-6706-3216-903c-7b3a21bde043",
                                        "glosses": [
                                            "To make superficially more attractive; to give a falsely pleasant appearance to."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c87e32f9-3fc4-4305-ae03-fa9d72c91e0f",
                                                "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                                "text": "There's no way to sugarcoat the loss of the space shuttle; it was an unmitigated disaster."
                                            },
                                            {
                                                "example_id": "8ac29b67-6d37-4017-b6df-7c18d1ad55a9",
                                                "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                                "text": "I went to the unheard-of trouble of re-writing the letter and saying the same harsh things softly, so as to sugarcoat the anguish and make it a little more endurable […]"
                                            },
                                            {
                                                "example_id": "b2253d98-231e-43c4-9af4-ed37e5bbef2a",
                                                "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                                "text": "The only difference is I got the balls to say it in front of y'all / And I don't gotta be false or sugarcoat it at all"
                                            },
                                            {
                                                "example_id": "61e60c7d-0bcb-4c29-ab7e-a0cfe6c18563",
                                                "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                                "text": "[…] And I don't think we can sugarcoat both the human toll that is unfolding in Ukraine, but also how it is reordering the international architecture in ways that we haven't seen in decades."
                                            },
                                            {
                                                "example_id": "006e2023-21c6-4d71-988d-05a263b330c8",
                                                "sense_id": "293a9aed-2733-3132-bd02-bf97508bedad",
                                                "text": "\"The insurgents killed them all?\"\n\"Very likely.\" Scout's expression was kindly, but he was apparently not the sort to sugarcoat things. Then again, maybe he had simply read her receptivity well."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fabc9c9-35f8-41b2-a3e8-ea4da9a2f0dc",
                        "source_entry_id": "d3d3e87d-30a3-3bd0-b12a-3a6542153e7f",
                        "source_sense_id": "be1f5d8c-50e4-3867-b608-40efa714c5e9",
