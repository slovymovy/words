                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05e86789-cb8e-4942-ae1f-a6971bdfc13c",
                                "sense_id": "eb7983f6-4bd6-363c-8059-dd31a960b499",
                                "text": "„Ferris holte sein Satellitentelefon hervor und überprüfte die GPS-Koordinaten, um sicherzugehen, dass er den Leuten in Balad auch den richtigen Ort nennen konnte, wenn er eine Drohne bestellte.“"
                            },
                            {
                                "example_id": "03647fe8-a7d2-4fbd-886f-14059cfb5cc2",
                                "sense_id": "eb7983f6-4bd6-363c-8059-dd31a960b499",
                                "text": "„Auf der beweglichen Kartenanzeige über dem Echtzeitmonitor zeigten die GPS-Koordinaten die Grenzüberschreitungen an.“"
                            },
                            {
                                "example_id": "1c471e39-b2e8-49da-a9ea-932c21572adb",
                                "sense_id": "eb7983f6-4bd6-363c-8059-dd31a960b499",
                                "text": "„Shaw behielt den Pfad im Auge und verglich auf seinem Smartphone die GPS-Koordinaten.“"
                            },
                            {
                                "example_id": "6759b296-e645-40a6-b3b5-99e8710c66dd",
                                "sense_id": "eb7983f6-4bd6-363c-8059-dd31a960b499",
                                "text": "„Nur die GPS-Koordinaten, die sie vom Techniker erhalten hatten, bewahrten sie vor stundenlangem Umherirren durch den Wald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
