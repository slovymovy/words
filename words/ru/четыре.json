                {
                    "sense_id": "7a911821-e5ed-38f9-8705-cee0309aad95",
                    "sense_definition": "Число и цифра 4; количество, равное четырём.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "numbers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него были лекции по английскому языку <w>четыре</w> раза в неделю.",
                            "target_lang_translations": {
                                "en": "He had English lectures <w>four</w> times a week.",
                                "zh": "他每周有<w>四</w>次英语课。"
                            }
                        },
                        {
                            "text": "В нашей семье <w>четыре</w> человека.",
                            "target_lang_translations": {
                                "en": "There are <w>four</w> people in our family.",
                                "zh": "我们家有<w>四</w>口人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "четыре года",
                        "четыре раза",
                        "на все четыре стороны",
                        "дважды два — четыре"
                    ],
                    "target_lang_definitions": {
                        "en": "The number and digit 4; a quantity equal to four.",
                        "zh": "数字4；数量为四。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "four",
                                "target_lang_sense_clarification": "number"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "四",
                                "target_lang_sense_clarification": "数字4"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2708e4e5-e6c1-3623-bc37-6139089e094c",
                    "sense_definition": "Школьная оценка, означающая «хорошо» (обычно по пятибалльной системе).",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "grades",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "За контрольную работу учитель поставил мне <w>четыре</w>.",
                            "target_lang_translations": {
                                "en": "The teacher gave me a <w>B</w> for the test.",
                                "zh": "老师给我的测验打了<w>良</w>。"
                            }
                        },
                        {
                            "text": "Он учится без троек, только на <w>четыре</w> и пять.",
                            "target_lang_translations": {
                                "en": "He studies without Cs, getting only <w>Bs</w> and As.",
                                "zh": "他学习成绩不错，只拿<w>良</w>和优。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "получить четыре",
                        "твёрдое четыре"
                    ],
                    "target_lang_definitions": {
                        "en": "A school grade meaning \"good\" (usually on a five-point scale).",
                        "zh": "学校评分等级，意为“良好”（通常在五分制中）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "B",
                                "target_lang_sense_clarification": "academic grade"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "良",
                                "target_lang_sense_clarification": "学校评分等级"
                            }
                        ]
                    }
                }
            ]
