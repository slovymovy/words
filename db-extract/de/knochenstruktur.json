                "senses": [
                    {
                        "sense_id": "867c0e0e-0ced-3591-8bef-ad7e0c806f25",
                        "entry_id": "43413b63-56c5-342a-8da9-df2f706af04c",
                        "glosses": [
                            "Struktur/Aufbau von Knochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "832ab504-4e3c-423a-8ca9-9274ee9d3f8f",
                                "sense_id": "867c0e0e-0ced-3591-8bef-ad7e0c806f25",
                                "text": "„Der Richter hielt den Knochen in die Höhe und zeigte die Analogien zwischen früheren und heutigen Knochenstrukturen auf; dann ließ er ihn in den Sand fallen und klappte sein Buch zu.“"
                            },
                            {
                                "example_id": "7e5920cf-97d5-4193-a72e-5f8c352ef894",
                                "sense_id": "867c0e0e-0ced-3591-8bef-ad7e0c806f25",
                                "text": "„›Die Zersetzung verfälscht das Bild, aber eine Aufnahme mit unserem brandneuen Röntgengerät aus zweiter Hand, ein Geschenk der dänischen Regierung, zeigt uns die Knochenstruktur eines jungen Menschen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
