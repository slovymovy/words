                    }
                ],
                "senses": [
                    {
                        "sense_id": "8902d708-3507-3a1b-8f2d-15e846868054",
                        "entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
                        "glosses": [
                            "A geological event in which viscous mud flows down an incline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71908906-0449-4d44-87c6-c55f8c9188c4",
                                "sense_id": "8902d708-3507-3a1b-8f2d-15e846868054",
                                "text": "A mudslide in the south-western province of Guizhou has resulted in 15 deaths. Thirty people are still missing as the search continues."
                            },
                            {
                                "example_id": "b19c65fe-bf27-4a90-b183-6a95900ec5d1",
                                "sense_id": "8902d708-3507-3a1b-8f2d-15e846868054",
                                "text": "Flooding occurs in areas where the ground is unable to absorb all of the water, according to forecasters, who explained that flash flooding can also be caused by mudslides or breaks in dams or levees."
                            }
                        ]
                    },
                    {
                        "sense_id": "262c953c-7c85-3e0b-8d3d-7091184c5296",
                        "entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
                        "glosses": [
                            "A mixed drink consisting of vodka, Kahlúa and Baileys."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d9154f-f816-4480-b2fa-012eea32ddfd",
                                "sense_id": "262c953c-7c85-3e0b-8d3d-7091184c5296",
                                "text": "[…] and seem able to function during A.M. drills even after several parasolled Mudslides or the House-Specialty Blue Flame cognac-based things you have to blow out before sipping from their huge blue-rimmed snifters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85106a9a-ac97-4afa-83d9-bddb309ff2fd",
                        "source_entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
                        "source_sense_description": "geological disaster in which a large amount of mud gathers and moves rapidly down a hill or slope",
                        "target_lang_word": "aardverschuiving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aardverschuiving",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0e21c2ab-c661-3ca1-b8cc-b01eab750db6",
                                        "entry_id": "f278b743-6975-36aa-9c77-357aadde53d6",
                                        "glosses": [
                                            "het naar beneden schuiven van een grote massa grond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "098e4392-e3ac-4b20-99fe-303fde84730b",
                                                "sense_id": "0e21c2ab-c661-3ca1-b8cc-b01eab750db6",
                                                "text": "Na de zware regenval ontstonden er grote modderstromen en aardverschuivingen."
                                            },
                                            {
                                                "example_id": "62ad5eb3-d68a-438a-a9d9-f8bfa05e2a1d",
                                                "sense_id": "0e21c2ab-c661-3ca1-b8cc-b01eab750db6",
                                                "text": "Maar de hevige regens hadden een aardverschuiving veroorzaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71db7598-a925-32f6-a849-249e25f21263",
                                        "entry_id": "f278b743-6975-36aa-9c77-357aadde53d6",
                                        "glosses": [
                                            "een plotselinge maatschappelijke verandering met verstrekkende gevolgen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3bdb92-33a2-4992-b026-7a05cfc67adf",
                                                "sense_id": "71db7598-a925-32f6-a849-249e25f21263",
                                                "text": "Een politieke aardverschuiving."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7dee5f4-afbf-4851-a587-c557e42ee22f",
                        "source_entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
                        "source_sense_description": "geological disaster in which a large amount of mud gathers and moves rapidly down a hill or slope",
                        "target_lang_word": "grondverschuiving",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grondverschuiving",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fc52e79d-4960-3c51-801a-4514949ecda3",
                                        "entry_id": "c60ce963-6de0-3b8c-ae4e-6a43f58404ac",
                                        "glosses": [
                                            "schuivende verzakking van een stuk grond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55afc87f-eb4d-4d4d-92f4-599f61b01f00",
                                                "sense_id": "fc52e79d-4960-3c51-801a-4514949ecda3",
                                                "text": "En dat kost ook weer geld. De villa van 700.000 dollar is één groot drama voor de Webbs. Ze bouwden het zeven jaar geleden van hun pensioen. Ze hadden het verzekerd, maar zijn er net achter gekomen dat grondverschuiving niet wordt gedekt. \"We zijn er kapot van\", meldt Webb. Enig lichtpuntje: het is hun tweede huis, dus dakloos zijn ze niet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6feb9bb7-85ea-48cf-bf9c-d6b7bbc3ba31",
                        "source_entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
                        "source_sense_description": "geological disaster in which a large amount of mud gathers and moves rapidly down a hill or slope",
                        "target_lang_word": "modderstroom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "modderstroom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dd89e875-2e91-3fc0-b620-8b5251d990be",
                                        "entry_id": "aab1fc24-9fac-3f26-8d42-30aae1ccc136",
                                        "glosses": [
                                            "het snelste type van een stromende vloeibare massa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557d745e-7893-457f-ba35-1265981fa328",
                                                "sense_id": "dd89e875-2e91-3fc0-b620-8b5251d990be",
                                                "text": "De door de vele troepenverplaatsingen volkomen stuk gereden weg bood de aanblik van een zwarte modderstroom, die niet overal doorwaadbaar was."
                                            },
                                            {
                                                "example_id": "a36dce93-2d3e-4879-9023-faaa881ae5eb",
                                                "sense_id": "dd89e875-2e91-3fc0-b620-8b5251d990be",
                                                "text": "In de modderstroom werden auto's meegesleurd, vuilnisbakken en elektriciteitspalen. Ook een sportveld met volleyballers en toeschouwers werd getroffen; het is onduidelijk of daar veel slachtoffers zijn gevallen. De autoriteiten sluiten meer aardverschuivingen niet uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3d337b-6c86-4b37-9bfc-7bd72f23a6d2",
                        "source_entry_id": "982aca47-ac88-3170-a00a-6b6f013926b7",
