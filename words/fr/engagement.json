                    ],
                    "synonyms": [
                        "enrôlement"
                    ],
                    "common_phrases": [
                        "engagement volontaire"
                    ]
                },
                {
                    "sense_id": "20299316-4805-3c95-8e11-5c773634438b",
                    "sense_definition": "Action de donner un bien en gage pour garantir le remboursement d'une dette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En proie à des soucis financiers, il a consenti à l'<w>engagement</w> de plusieurs montres précieuses."
                        },
                        {
                            "text": "L'<w>engagement</w> d'objets de valeur au crédit municipal lui a permis d'obtenir un prêt immédiat."
                        }
                    ],
                    "synonyms": [
                        "mise en gage"
                    ]
                }
            ]
        }
    ]
