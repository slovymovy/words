                        "source_entry_id": "4ffabb77-151c-3e04-80e6-8da4db5c2407",
                        "source_sense_id": "18d609f1-aa6f-3a34-bf43-e058758c2c94",
                        "source_sense_description": "Action de rétrograder, déclin vers une forme plus simple, moins complexe, moins évoluée.",
                        "target_lang_word": "retrogression",
