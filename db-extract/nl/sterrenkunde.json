                ],
                "senses": [
                    {
                        "sense_id": "f830de31-4a56-3db0-850f-4610fccbc21b",
                        "entry_id": "320cb3e7-7f5a-3662-b882-c972f16a0c72",
                        "glosses": [
                            "wetenschap die de objecten in de ruimte bestudeert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7913742c-0544-427c-99d3-a0c4cf0366d7",
                                "sense_id": "f830de31-4a56-3db0-850f-4610fccbc21b",
                                "text": "'Het is de eerste keer in de geschiedenis van de sterrenkunde dat we over waarnemingen beschikken van een ster vlak voordat hij als supernova afgaat,' vertelt Savonije."
                            },
                            {
                                "example_id": "a9548601-bd2a-48ca-ad46-1b996bb0d7d3",
                                "sense_id": "f830de31-4a56-3db0-850f-4610fccbc21b",
                                "text": "2020 Snelle radioflitsen zijn afkomstig van kosmische supermagneten Een van de grootste raadsels in de moderne sterrenkunde nadert zijn ontknoping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e6fd1c-c44f-4be8-b426-526dce57b625",
                        "source_entry_id": "320cb3e7-7f5a-3662-b882-c972f16a0c72",
                        "source_sense_id": "f830de31-4a56-3db0-850f-4610fccbc21b",
                        "source_sense_description": "wetenschap die de objecten in de ruimte bestudeert",
                        "target_lang_word": "Astronomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Astronomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "Sternkunde, Himmelskunde als exakte Naturwissenschaft"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5706cb-c14c-49c7-bed2-0a758ce1d593",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "Mit der Astronomie sehr eng verbunden ist die Physik."
                                            },
                                            {
                                                "example_id": "3b440b53-ebc0-45f9-8efc-c2abbcce4dba",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Mystische Anschauung der Astrologie und exakte Wissenschaft der Astronomie lassen sich zwar formell trennen, sie bilden jedoch in der Geistesgeschichte der Menschheit seit jeher eine eigentümliche Verquickung, die auch heutzutage noch zu den seltsamsten Ergebnissen führt.“"
                                            },
                                            {
                                                "example_id": "2ae5f1fe-7610-4dec-9208-1a7e49e34ca3",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Monsieur sagte recht verständig, die Astrologie sei als Wissenschaft auf jeden Fall sehr anrüchig, wenn nicht falsch; er habe sich einige Zeit damit beschäftigt, habe es aber schließlich aufgegeben und sich mit den unbezweifelbaren Wahrheiten begnügt, die die Astronomie ihn lehre.“"
                                            },
                                            {
                                                "example_id": "7cd86d60-cfd0-4d67-ba2e-f24aa8a3a35b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Im frühen 16. Jahrhundert gehörten Mineralogie, Alchemie, Astrologie und Astronomie zusammen.“"
                                            },
                                            {
                                                "example_id": "94f005d8-8c67-4362-b073-f38c078ce81b",
                                                "sense_id": "a6a2eca8-f200-3169-96c6-178944c2f636",
                                                "text": "„Autor und Autorinnen, zwei Frauen und ein Mann, alle mit Professuren in Astronomie ausgestattet, behaupten mit unangenehm überzeugenden Argumenten, dass die Menschheit von Beginn an in falschen Vorstellungen von der Welt befangen sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                        "entry_id": "8e7c5364-a331-33b3-b3d8-f07fe89473ff",
                                        "glosses": [
                                            "ein Unterrichtsfach"
                                        ],
                                        "tags": [
                                            "Schulwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81df49a4-9e35-4604-8a0f-1cdec2f9fe4b",
                                                "sense_id": "b1ffe98a-20d8-39cb-b412-e21d4ed1f771",
                                                "text": "Leider wird nur an sehr wenigen Schulen Astronomie unterrichtet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa0c7fe4-d60d-4676-adc1-1f5be8e77520",
                        "source_entry_id": "320cb3e7-7f5a-3662-b882-c972f16a0c72",
