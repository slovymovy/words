                "senses": [
                    {
                        "sense_id": "09e9e9c9-d3ae-307f-a419-46ce33faed0e",
                        "entry_id": "7d3c34af-6e2f-3993-b5fc-5d1aab4b3e51",
                        "glosses": [
                            "рег. и спец. ловить рыбу неводом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b1511ab-ec75-43af-8b34-32bc123e513a",
                                "sense_id": "09e9e9c9-d3ae-307f-a419-46ce33faed0e",
                                "text": "На фронт ты не пошел, в войну картошку от пуза трескал, опять же зверя бил и рыбу неводил."
                            },
                            {
                                "example_id": "e7369bed-dc95-4ee4-85f9-360d2131224f",
                                "sense_id": "09e9e9c9-d3ae-307f-a419-46ce33faed0e",
                                "text": "Весной, несмотря ни на какую погоду, еще в холодном апреле выходят бригады на весенние становища и неводят у голубых прорубей на снегу."
                            }
                        ]
                    }
