                        "glosses": [
                            "Relatif aux ivrognes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5e0da5d2-fe54-4c38-8ad9-8779970e05d1",
                                "sense_id": "a81ebbe3-9a45-3880-854d-3599f75374de",
                                "text": "Jugeant par intuition ivrognale que ce pourrait bien être un plein flacon, il y porta la main."
                            },
                            {
                                "example_id": "cfed9705-9951-4bdf-bad4-68717f83a6c1",
                                "sense_id": "a81ebbe3-9a45-3880-854d-3599f75374de",
                                "text": "Il y a six… du temps de la comète bleue… le meilleur des vins pourpres… qui rend ivrognal…"
                            },
                            {
                                "example_id": "23f640ff-1ef5-41c9-b158-80e4739a40fd",
                                "sense_id": "a81ebbe3-9a45-3880-854d-3599f75374de",
                                "text": "Ben oui, le patron est natif des Flandres, un Belge, comme le roi Léopold. Bibulus, c’est le nom d’un chien dans un bouquin, et ce cabot-là il aime la bière d’un amour ivrognal. Faut vous dire que celui qui a pondu l’hisoitre, il est belge lui aussi."
                            }
                        ]
                    }
