                    {
                        "sense_id": "a675192a-1434-3046-8e8a-ceaaddf99e5f",
                        "entry_id": "5abcb576-11c6-35d5-9a5d-d2b9634e9ac1",
                        "glosses": [
                            "Markt, auf dem (meist) frischer Fisch verkauft oder versteigert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eed78a11-dddc-4754-842f-d5ba3bf53ad2",
                                "sense_id": "a675192a-1434-3046-8e8a-ceaaddf99e5f",
                                "text": "Heute haben wir auf dem Fischmarkt eine frische Scholle gekauft."
                            },
                            {
                                "example_id": "84c42e95-86eb-4036-a1e3-ecfc451811f4",
                                "sense_id": "a675192a-1434-3046-8e8a-ceaaddf99e5f",
                                "text": "„Die eine ist Fischfrau und verkauft täglich den frischen Fang auf dem Königsberger Fischmarkt.“"
                            },
                            {
                                "example_id": "6f61c468-e4b5-43dd-8f81-a7939933113d",
                                "sense_id": "a675192a-1434-3046-8e8a-ceaaddf99e5f",
                                "text": "„Ferris beobachtete, wie sich Omar Sadiki in der flimmernden Mittagshitze dem Restaurant in der Bainunastraße gleich beim Fischmarkt näherte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
