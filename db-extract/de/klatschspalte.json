                "senses": [
                    {
                        "sense_id": "fba2e173-64eb-3002-b4c2-7e4780e3fb65",
                        "entry_id": "ad9d79d4-edce-3e12-9f56-47eb68814c47",
                        "glosses": [
                            "derjenige Teil einer Zeitung, der dem Klatsch gewidmet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52573b59-b942-4a64-999b-5e51b1507568",
                                "sense_id": "fba2e173-64eb-3002-b4c2-7e4780e3fb65",
                                "text": "„Sein Name erschien und erscheint ohnedies oft in den Zeitungen, vor allem den Klatschspalten, die es damals schon gibt, und die oft den Hauptteil der Gazetten ausmachen.“"
                            },
                            {
                                "example_id": "01164e46-5572-41d3-b57e-7bf55732c535",
                                "sense_id": "fba2e173-64eb-3002-b4c2-7e4780e3fb65",
                                "text": "„Sein Name taucht nun nicht mehr nur in den Klatschspalten der Yellow-Press auf.“"
                            },
                            {
                                "example_id": "f43734b4-5059-492c-a496-e024771af353",
                                "sense_id": "fba2e173-64eb-3002-b4c2-7e4780e3fb65",
                                "text": "„Ich hatte so etwas öfter in den Klatschspalten der Zeitungen gelesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
