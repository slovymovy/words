                ],
                "senses": [
                    {
                        "sense_id": "b7659e38-9e4d-342d-b0d0-63dbd8c5c428",
                        "entry_id": "0c4d70b6-377e-3a02-8e13-58ee0a3e045f",
                        "glosses": [
                            "karykaturalny fakt, informacja traktowana jako prawdziwa tylko przez to, że ukazała się w mediach"
                        ],
                        "tags": [
                            "publ."
                        ],
                        "examples": [
                            {
                                "example_id": "38844804-bf66-4859-8d25-1a3c5a891622",
                                "sense_id": "b7659e38-9e4d-342d-b0d0-63dbd8c5c428",
                                "text": "Do najpopularniejszych faktoidów zaliczają się stwierdzenia, jakoby Wielki Mur Chiński widoczny był gołym okiem z kosmosu, lemingi miały w zwyczaju rzucać się masowo do morza, a ludzie wykorzystywali tylko 10% mocy mózgu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b75b327f-2374-4790-87a5-62ec66a21aee",
                        "source_entry_id": "0c4d70b6-377e-3a02-8e13-58ee0a3e045f",
                        "source_sense_id": "b7659e38-9e4d-342d-b0d0-63dbd8c5c428",
                        "target_lang_word": "factoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "factoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5acd7eb-16fe-33db-8409-4a6357088580",
                                        "entry_id": "cf21b8bf-23b0-36ae-b2e1-283898ce1ee9",
                                        "glosses": [
                                            "An inaccurate statement or statistic believed to be true because of broad repetition, especially if cited in the media."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0aeaa17-bfb4-4139-a872-22feca681726",
                                                "sense_id": "d5acd7eb-16fe-33db-8409-4a6357088580",
                                                "text": "Such hedging is necessitated by the lack of in-depth knowledge of the contents, which also gives free rein to the scripting of unsubstantiated factoids concerning the book."
                                            },
                                            {
                                                "example_id": "d5ec1b18-f9a4-4c0d-a460-8e5e8cffd393",
                                                "sense_id": "d5acd7eb-16fe-33db-8409-4a6357088580",
                                                "text": "Wikipedia-derived factoids can be so important that there is a well-known feedback loop, called citogenesis, in which the mainstream news finds some claim made in a Wikipedia article, and publishes it (without citing Wikipedia). Then Wikipedia itself makes use of the news article. By means of this loop, an ultimately “sourceless” factoid gains a spurious authority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06849df-0b77-3346-83cb-49d6dc638809",
                                        "entry_id": "cf21b8bf-23b0-36ae-b2e1-283898ce1ee9",
                                        "glosses": [
                                            "An interesting item of trivia; a minor fact."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "becea6ab-b65f-4bff-be5d-0eb8839a79dd",
                                                "sense_id": "c06849df-0b77-3346-83cb-49d6dc638809",
                                                "text": "Given a large enough storehouse of words and a fine filter, would it be possible to see cultural change at the micro level, to follow minute fluctuations in human thought processes and activities? Tiny factoids, multiplied endlessly, might assume imposing dimensions."
                                            },
                                            {
                                                "example_id": "03c00ba7-ca3a-49c7-9d26-bf14fd1517bd",
                                                "sense_id": "c06849df-0b77-3346-83cb-49d6dc638809",
                                                "text": "Don't parade in front of the audience spewing every factoid you know on your topic. Only share the right information for that exact moment with that specific audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
