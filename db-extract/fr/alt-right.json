                                        "glosses": [
                                            "Of or pertaining to the alt-right."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "084be70b-db00-44f0-99f2-9d0c4b77cd45",
