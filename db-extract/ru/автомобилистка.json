                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17b39437-8236-3ccf-97d2-ff7bd8d28fe3",
                                        "entry_id": "d05846bc-a41d-376e-977d-62395a01fa14",
                                        "glosses": [
