                                    {
                                        "sense_id": "d684b590-1bf1-3706-8fd4-e7831057711b",
                                        "entry_id": "f58fbb6e-e068-3513-821e-9abec5b62605",
                                        "glosses": [
                                            "doen weggaan door angst aan te jagen, door angst aan te jagen bepaald gedrag voorkomen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475c8705-003b-4265-b9e5-bd3636c848ad",
                                                "sense_id": "d684b590-1bf1-3706-8fd4-e7831057711b",
                                                "text": "De oorlog schrikte haar niet af."
                                            },
                                            {
                                                "example_id": "ae5ecb7b-eb7c-4ca3-8e6d-65cd8af42120",
                                                "sense_id": "d684b590-1bf1-3706-8fd4-e7831057711b",
                                                "text": "De puber werd afgeschrikt door het vooruitzicht nog een jaar bij zijn ouders te moeten wonen en ging dus maar hard blokken voor zijn eindexamen want dan kon hij volgend jaar op kamers om te studeren."
                                            },
                                            {
                                                "example_id": "73275c40-b6fc-4569-b9ce-de71258acb75",
                                                "sense_id": "d684b590-1bf1-3706-8fd4-e7831057711b",
                                                "text": "'Als zakenman,' vervolgde Reede, die begon te ijsberen, 'wilde Schloss het schilderij waarschijnlijk aantrekkelijker maken voor Guggenheim. Ze had op dat moment nog niet veel aangekocht; hij wilde haar niet afschrikken."
                                            },
                                            {
                                                "example_id": "2ccb39bc-7b24-428f-b005-9ab36a1830dd",
                                                "sense_id": "d684b590-1bf1-3706-8fd4-e7831057711b",
                                                "text": "Gespannen zette ik mijn tent op: om mezelf af te leiden en dieren af te schrikken begon ik hard te fluiten en ik wierp af en toe een blik op de brede vallei onder me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb48381-2084-310d-bd7e-195d0c273d36",
                                        "entry_id": "f58fbb6e-e068-3513-821e-9abec5b62605",
                                        "glosses": [
                                            "het bijzonder snel afkoelen van een heet voorwerp door het in een koelvloeistof te dompelen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c861690-1a64-4700-a70a-edc94c79ab6c",
                                                "sense_id": "0eb48381-2084-310d-bd7e-195d0c273d36",
                                                "text": "De ampul met het gevormde sulfide werd uit de oven genomen en afgeschrikt in ijswater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "065970e7-b35e-4b23-b01c-61470cd99aba",
                        "source_entry_id": "a0269fc1-c349-3801-92f1-a1cd132af98f",
                        "source_sense_id": "851cbd0a-1542-325e-98ac-443eecad363d",
