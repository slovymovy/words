                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6770d5d2-1d9d-4d97-9540-a9b6974d8206",
                                "sense_id": "671cd1e6-a651-31fa-aa53-f7435c9c4462",
                                "text": "Then back to the slender bough, which drooped under the weight of four swallowlings in a row, and now swayed with the agitations of their welcome to hovered wings and a full beak."
                            },
                            {
                                "example_id": "15010a7d-02da-4488-9958-d00a36a1d9ae",
                                "sense_id": "671cd1e6-a651-31fa-aa53-f7435c9c4462",
                                "text": "And swallows are the spring's agents, nesting in the rafters, eating, defecating, procreating, producing prodigious flocks of swallowlings."
                            }
                        ]
                    }
