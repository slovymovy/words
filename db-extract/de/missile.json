                "senses": [
                    {
                        "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                        "entry_id": "428688b1-4453-3ecf-9fb6-aa1ffa30bec6",
                        "glosses": [
                            "unbemannter ferngesteuerter Lenkflugkörper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ba05f0-e209-43d2-b733-1fd09b42ad37",
                                "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                                "text": "„Dank modernen Missilen sind Depots und Kommandoposten im Hinterland verwundbar.“"
                            },
                            {
                                "example_id": "956ae9cc-d574-40b6-895f-8d8164a22258",
                                "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                                "text": "„Dies umso mehr, als die Sowjetunion ihr SS-20-Rakentenarsenal in Ostsibirien weiter aufstocken könnte: und zwar mit solchen SS-20-Missilen, die sie im Falle einer Einigung bei den INF-Verhandlungen in Genf aus dem europäischen Bereich abziehen müßte […]“"
                            },
                            {
                                "example_id": "bdf142d3-be19-47d7-9533-15768a3dfa62",
                                "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                                "text": "„Die Luftwaffe hatte die Aufgabe mit Missilen, die eine Reichweite von 300 Kilometern hatten, Westdeutschland gegen einen eventuellen Angriff aus dem Osten zu verteidigen.“"
                            },
                            {
                                "example_id": "bbc685e0-9526-41a7-a048-31e3e8940449",
                                "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                                "text": "„Die PLA (chinesische Volksbefreiungsarmee) hat drei Waffengattungen mit atomarer Bewaffnung: Raktetentruppen der Landstreitkräfte mit landgestützten Raketen, Seestreitkräfte mit U-Boot-gestützten Missilen und Luftstreitkräfte mit schweren Bombern und Jagdbombern, die Atombomben abwerfen können.“"
                            },
                            {
                                "example_id": "caf49fbf-d54a-46ab-a8b9-3be489c9ba28",
                                "sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                                "text": "„Am Ende der Manöver rollen in Emmen ein Dutzend Ladefahrzeuge mit den imposanten Missilen an einem staunenden Publikum vorbei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "896441cb-3772-4ee3-b0fe-b0252b45442e",
                        "source_entry_id": "428688b1-4453-3ecf-9fb6-aa1ffa30bec6",
                        "source_sense_id": "227cf511-1d92-3caf-a551-51628cc4474d",
                        "source_sense_description": "unbemannter ferngesteuerter Lenkflugkörper",
                        "target_lang_word": "missile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "missile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                        "entry_id": "2a8818ec-d3ba-3442-949f-429c82cbf3c9",
                                        "glosses": [
                                            "Any object used as a weapon by being thrown or fired through the air, such as stone, arrow or bullet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a696134a-edf7-42b1-9abf-0f288856e067",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "The Rhodians, who used leaden bullets, were able to project their missiles twice as far as the Persian slingers, who used large stones."
                                            },
                                            {
                                                "example_id": "90d8aa43-59fa-4f5e-a298-3ad16b374a72",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "And I saw askant the armies, / I saw as in noiseless dreams hundreds of battle-flags, / Borne through the smoke of the battles and pierc’d with missiles I saw them, / And carried hither and yon through the smoke, and torn and bloody, / And at last but a few shreds left on the staffs, (and all in silence,) / And the staffs all splinter’d and broken."
                                            },
                                            {
                                                "example_id": "66d4b16d-63f8-46b3-8d09-1f9b0b426e93",
                                                "sense_id": "203f960d-9f10-3b2d-b701-ad3210c3aaaa",
                                                "text": "Riot officers and police on horseback were deployed to disperse the crowns, but they came under attack from bottles, fireworks and other missiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea59a07-3feb-3478-b466-f4bedd3c42bf",
                                        "entry_id": "2a8818ec-d3ba-3442-949f-429c82cbf3c9",
                                        "glosses": [
                                            "A self-propelled projectile whose trajectory can be adjusted after it is launched."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debab24c-7fc4-46ae-8cd6-20ecbb51c057",
                                                "sense_id": "0ea59a07-3feb-3478-b466-f4bedd3c42bf",
                                                "text": "That missile is explosive enough to kill hundreds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
