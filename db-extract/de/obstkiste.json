                        "glosses": [
                            "größerer Behälter (Kiste) zur Aufbewahrung oder zum Transport von Obst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e663501d-92b4-4e65-9186-c8dab081191a",
                                "sense_id": "9683d033-88fe-3fb1-8700-0e91d8470d96",
                                "text": "„Wenn Hideo von seinen Foto-Streifzügen durchs Viertel zurückkam, betrieb er Mundraub im Laden, sortierte dafür jedoch hingebungsvoll die Obstkisten, sodass auch Sung bisweilen eine freie Minute hatte – manchmal sogar synchronisiert mit Mâys Pausen.“"
                            },
                            {
                                "example_id": "af6c778c-22cc-4b47-b002-29e83ac9513b",
                                "sense_id": "9683d033-88fe-3fb1-8700-0e91d8470d96",
                                "text": "„Sie sitzen in ihren Unterhemden zwischen den Obstkisten und lassen eine Flasche Wein herumgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
