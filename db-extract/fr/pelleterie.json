        "fr-extract.jsonl": [
            {
                "entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                "word": "pelleterie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33daf0b0-d19b-4d3f-973d-d8bde7a3825c",
                        "entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                        "tags": [
                            "plural"
                        ],
                        "form": "pelleteries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c4de8f6-596b-38b2-84b5-c9eeaebcf1ab",
                        "entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                        "glosses": [
                            "Art d’accommoder les peaux garnies de leur poil, pour en faire des fourrures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77efb9cc-f066-4009-b6cf-04a530ca5fc1",
                                "sense_id": "5c4de8f6-596b-38b2-84b5-c9eeaebcf1ab",
                                "text": "… les murs étaient cachés sous des panneaux de pelleteries disposés en échiquiers d'un riche travail où les peaux de l'once et de l'ours blanc alternaient avec régularité."
                            }
                        ]
                    },
                    {
                        "sense_id": "30c884eb-7371-3773-a5d2-b1cd182e1886",
                        "entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                        "glosses": [
                            "Commerce de fourrures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb57997-ca97-4e4b-8644-e845ea9371fe",
                                "sense_id": "30c884eb-7371-3773-a5d2-b1cd182e1886",
                                "text": "Le commerce de pelleterie était lucratif et attirait toutes sortes d’individus aimant la solitude et les grands espaces."
                            }
                        ]
                    },
                    {
                        "sense_id": "5916028d-f2a4-3581-a9ed-4d8e475bfc68",
                        "entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                        "glosses": [
                            "Peaux dont on fait les fourrures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0efdeff9-e223-4e9f-ae78-8959796328c5",
                                "sense_id": "5916028d-f2a4-3581-a9ed-4d8e475bfc68",
                                "text": "Or, si l'entreprise réussit, ce point deviendra une factorerie importante dans laquelle se concentrera tout le commerce de pelleteries du Nord."
                            },
                            {
                                "example_id": "4926e946-a83f-4f14-9cad-df319e38b645",
                                "sense_id": "5916028d-f2a4-3581-a9ed-4d8e475bfc68",
                                "text": "— Il y a « icitte » deux hommes qui ont de l’argent pour acheter les pelleteries. Si vous avez des peaux d’ours, ou de vison, ou de rat musqué, ou de renard, allez voir ces hommes-là au magasin avant mercredi."
                            },
                            {
                                "example_id": "79353bbe-79e0-4a5d-ad34-3809e7bc9fe9",
                                "sense_id": "5916028d-f2a4-3581-a9ed-4d8e475bfc68",
                                "text": "Songez qu’il nous était interdit de fabriquer quoi que ce soit afin de ne pas faire concurrence aux intérêts de la mère patrie, une paralysie liée aux monopoles constamment consentis aux Dix ou Cent Associés dont les intérêts se limitaient à l’importation de lucratives pelleteries ! Dynamisme nul."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46d38f76-a7bb-42a0-b83c-fa5baffb7fe2",
                        "source_entry_id": "ed656408-0ccf-3961-9060-4db1c5df7482",
                        "target_lang_word": "peltry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peltry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                        "entry_id": "36478b23-a627-3aa9-8e3c-750818114e40",
                                        "glosses": [
                                            "Pelts or skins, collectively; skins with the fur on them; furs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f074b834-97f8-4181-bcc2-e6695110905a",
                                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                                "text": "...those Indians informed him, that the war was not yet at an end, and that he would live better and with more safety among the French; who, in truth, do much indulge the Indians, and furnish them whatever they desire, because they employ those Indians to kill them beaver, and moose, and other peltry, whereby they gain much."
                                            },
                                            {
                                                "example_id": "7e8883fb-2a35-4fa9-bbf7-c8447296162c",
                                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                                "text": "It has gray hair, and the fleece is sometimes sold with other peltries, but it is not worth much, although it has some odor."
                                            },
                                            {
                                                "example_id": "205914b3-ef7d-4436-bf62-03dd43d668fd",
                                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                                "text": "We met with a party of three hunters from the Sioux river; they had been out for twelve months, and collected about nine hundred dollars worth of peltries and furs."
                                            },
                                            {
                                                "example_id": "b749f8c8-4124-4f28-a2ab-371c4c9a98cb",
                                                "sense_id": "1bcce20f-f026-3556-aa42-67ff7d28178b",
                                                "text": "Selling his glittering goods at a great advance, he received in exchange valuable peltries and furs at a corresponding reduction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c08a1166-dce6-4f79-b602-602e6ad551da",
