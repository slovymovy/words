                        "cross_references": [
                            {
                                "target_word": "носовой платок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ed28dd66-5264-395c-b3a5-fdbd929fbb77",
                                        "entry_id": "7ed5969f-7a56-3c27-b594-b19b1b7e3cd5",
                                        "glosses": [
                                            "кусок ткани или бумаги для чистки носа; вытирания выделений из носа и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a2a3e15-5d03-4d01-be92-f4496bb9a3d0",
                                                "sense_id": "ed28dd66-5264-395c-b3a5-fdbd929fbb77",
                                                "text": "В кружках рукоделия девочки научились шить для себя юбки, блузки, платья, вышивать рубашки, кофточки, носовые платки."
                                            },
                                            {
                                                "example_id": "5ec0b3c6-ea9c-4ef9-997f-e1e9854182d0",
                                                "sense_id": "ed28dd66-5264-395c-b3a5-fdbd929fbb77",
                                                "text": "Она нагнулась к нему, сняла с него шляпу и вытерла его мокрый лоб носовым платком."
                                            },
                                            {
                                                "example_id": "c3f8713f-9159-492f-b527-3d0ccb6c4bd8",
                                                "sense_id": "ed28dd66-5264-395c-b3a5-fdbd929fbb77",
                                                "text": "Тут отец Алексей достал из кармана клетчатый носовой платок и стал сморкаться ― да, кстати, утёр украдкой глаза."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
