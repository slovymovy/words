            {
                "entry_id": "f159123d-970a-3ea5-9865-93137f4ad899",
                "word": "fynbos",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b74f42a0-2985-4f42-bdee-49a8cc6513fe",
                        "entry_id": "f159123d-970a-3ea5-9865-93137f4ad899",
