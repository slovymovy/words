                        "entry_id": "15377d99-7869-335a-8bfb-017d44545462",
                        "glosses": [
                            "Relatif à un enfant à l’égard de ses parents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a83cab7-0471-4f8a-9ae2-8e3e084c8038",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Obéissance filiale."
                            },
                            {
                                "example_id": "bf471d54-3150-4f1d-94a9-9224905f0ce0",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Crainte filiale."
                            },
                            {
                                "example_id": "ebb90a60-3f7b-428b-b2db-b921e0aee369",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Respect filial."
                            },
                            {
                                "example_id": "55215d5e-8c41-4eab-aa70-cf54aecd0d51",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Amour filial."
                            },
                            {
                                "example_id": "00abf39a-54d4-4ce7-804f-f11684dcad47",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Tendresse filiale."
                            },
                            {
                                "example_id": "dd3985bf-c121-4776-9689-ddd6b970aa16",
                                "sense_id": "4ad38ea7-c0e2-3f8f-95b4-b1f1a1fc7486",
                                "text": "Elle fut un modèle de piété filiale."
                            }
                        ]
