                "senses": [
                    {
                        "sense_id": "e7dd0f21-c68c-3f16-8c54-6b79a14e6a24",
                        "entry_id": "73fc8244-8ba6-3ee6-af70-b5822387e52b",
                        "glosses": [
                            "Élévation de terrain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f26029a-d0e7-4b04-9064-47d7b4ab3892",
                                "sense_id": "e7dd0f21-c68c-3f16-8c54-6b79a14e6a24",
                                "text": "Un rehaut de terrain."
                            }
                        ]
                    },
                    {
                        "sense_id": "0847d218-1eef-38ec-aeff-abc668c13c82",
                        "entry_id": "73fc8244-8ba6-3ee6-af70-b5822387e52b",
                        "glosses": [
                            "Touche de couleur claire, d’or ou d’argent qui fait contraste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca7f59e-13ab-4e39-8ffc-e26568edfb5c",
                                "sense_id": "0847d218-1eef-38ec-aeff-abc668c13c82",
                                "text": "Un fusain avec des rehauts de craie blanche et de sanguine."
                            },
                            {
                                "example_id": "5db8e2d3-7e39-4a60-8f86-2a157608fd6a",
                                "sense_id": "0847d218-1eef-38ec-aeff-abc668c13c82",
                                "text": "Des rehauts d’or sur les bords d’un vase en porcelaine."
                            },
                            {
                                "example_id": "179b94b6-aa2e-4953-8e57-4eccbbb6df3c",
                                "sense_id": "0847d218-1eef-38ec-aeff-abc668c13c82",
                                "text": "Il était presque fini, il n’y avait plus que deux ou trois dernières touches à poser, et la signature à mettre, quand une petite peluche, qui dansait avec ses frères les atomes dans un beau rayon jaune, par une fantaisie inexplicable, quitta tout à coup sa lumineuse salle de bal, se dirigea en se dandinant vers la toile d’Onuphrius, et vint s’abattre sur un rehaut, qu’il venait de poser."
                            },
                            {
                                "example_id": "f26cedb6-7f46-40c0-b2c6-df4c1612ea1d",
                                "sense_id": "0847d218-1eef-38ec-aeff-abc668c13c82",
                                "text": "… Mˡˡᵉ Francou, qui avait une tête de vieil ange avec des rehauts de poudre aux pommettes …."
                            }
                        ]
                    },
                    {
                        "sense_id": "651e58df-fd6a-36e4-8cbc-750eac82ab9e",
                        "entry_id": "73fc8244-8ba6-3ee6-af70-b5822387e52b",
                        "glosses": [
                            "Élément qui relève, pimente, enrichit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e52608f2-ee74-4bdc-ae92-845468b0b166",
                                "sense_id": "651e58df-fd6a-36e4-8cbc-750eac82ab9e",
                                "text": "Tous ces parfums qui servent à modifier sa nature [d’un thé], à y ajouter un rehaut inattendu, à introduire dans son fumet un peu sec un relent de fleurs lointaines et fraîches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "045e3ec6-d030-49b4-bcf3-f33ae3155290",
                        "source_entry_id": "73fc8244-8ba6-3ee6-af70-b5822387e52b",
                        "source_sense_description": "Touche de couleur claire, d’or ou d’argent qui fait contraste.",
                        "target_lang_word": "highlight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9faff3ee-34f0-3eb5-a463-d774a8ddb21a",
                                        "entry_id": "ca59aa66-2217-3608-8f00-38beda1abd8f",
                                        "glosses": [
                                            "An area or a spot in a drawing, painting, or photograph that is strongly illuminated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae38b503-4a28-4231-b720-c2c66e0e2ef5",
                                                "sense_id": "9faff3ee-34f0-3eb5-a463-d774a8ddb21a",
                                                "text": "The image blurred into the highlight, like something familiar seen beneath disturbed though clear water; he looked at the familiar image with a kind of quiet horror and despair, at a face suddenly older in sin than he would ever be, a face more blurred than sweet, at eyes more secret than soft."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47a16182-b752-3639-815a-36cb41b3e8dc",
                                        "entry_id": "ca59aa66-2217-3608-8f00-38beda1abd8f",
                                        "glosses": [
                                            "An especially significant or interesting detail or event or period of time."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e72328-5e7e-4129-be7e-27129eb9777d",
                                                "sense_id": "47a16182-b752-3639-815a-36cb41b3e8dc",
                                                "text": "Meeting my future wife was the highlight of my trip to Spain."
                                            },
                                            {
                                                "example_id": "00a554a1-0cbc-4d97-b8be-62056a916f26",
                                                "sense_id": "47a16182-b752-3639-815a-36cb41b3e8dc",
                                                "text": "We'll be broadcasting the news highlights every half an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcaed208-4fee-3d39-87d2-62c5056de2ea",
                                        "entry_id": "ca59aa66-2217-3608-8f00-38beda1abd8f",
                                        "glosses": [
                                            "A strand or spot of hair dyed a different color than the rest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "highlight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                        "entry_id": "886cd50d-88b9-365a-a9d2-9cb3d9aecb08",
                                        "glosses": [
                                            "To make prominent; emphasize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e173b20c-0c1e-4659-99f6-c11c36143669",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "The Guardian has spoken to dozens of Europeans who have left, or are planning to leave. Their stories highlight surprising new migration routes – from Lisbon to Luanda, Dublin to Perth, Barcelona to Buenos Aires – as well as more traditional migration patterns."
                                            },
                                            {
                                                "example_id": "de4a65a1-650e-493a-822f-439967a7c388",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "Farmer highlights the fact that the reasons why causing offence is (or is not) deemed criminalizable are often historically specific, and follows Duff in counselling against attempts to ground criminalization in some 'master principle'[…]"
                                            },
                                            {
                                                "example_id": "db7eb330-bbc5-473a-a487-d7e45bbb5bee",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "The proposal in connection with taxonymy is that a taxonym must (a) further specify a highlighted feature of the hypernym and (b) must similarly highlight it. From this it will follow that the reason stallion and foal are not good taxonyms of horse, is that they highlight features not highlighted in horse; a similar explanation holds for blonde and woman; likewise, prostitute is not a good taxonym of woman because it highlights profession, but is a good taxonym of sex-worker, because it specifies further and highlights what is highlighted in sex-worker, namely, type of work."
                                            },
                                            {
                                                "example_id": "687b31ff-7628-4ceb-9994-9323dde8a224",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "Severe disruptions in the visual cortex was^([sic]) also observed when disrupting cholinergic retinal waves in ephrin double knockout (ephrin-A2/A5) mice, thus highlighting the importance of neural activity and ephrin-As acting together to control retinogeniculate and retinocortical patterning in normal development."
                                            },
                                            {
                                                "example_id": "cd33be30-6a86-4bbe-8f55-b9625ea631e6",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "In a Commons Written Reply to Shadow Rail Minister Tan Dhesi, regarding any assessment of the impact on open access operators by the decision to move away from franchising […], Heaton-Harris highlighted that non-franchised operators run trains without a contractual relationship with Government."
                                            },
                                            {
                                                "example_id": "17fd3522-38f4-4bce-be37-b99ca8ec18f6",
                                                "sense_id": "4d9a78c2-aae7-3eba-a5cf-7a498effb4c9",
                                                "text": "Former United Nations ambassador and current GOP presidential hopeful Nikki Haley slammed fellow Republicans former President Donald Trump and Florida Gov. Ron DeSantis Monday in a campaign letter highlighting Haley’s first quarter accomplishments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cb042f-6c10-3f8e-8e88-a3a337f1aa9a",
                                        "entry_id": "886cd50d-88b9-365a-a9d2-9cb3d9aecb08",
                                        "glosses": [
                                            "To be a highlight of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48907ff1-4009-391b-bb61-ebd5777f77dd",
                                        "entry_id": "886cd50d-88b9-365a-a9d2-9cb3d9aecb08",
                                        "glosses": [
                                            "To mark (important passages of text), e.g. with a fluorescent marker pen or in a wordprocessor, as a means of memory retention or for later reference."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d928fd8a-d72c-3006-b1b9-2551bf7c0829",
                                        "entry_id": "886cd50d-88b9-365a-a9d2-9cb3d9aecb08",
                                        "glosses": [
                                            "To dye (part of the hair) a different color than the rest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7b35f56-b612-30e9-ad84-0218e085c1c7",
                                        "entry_id": "886cd50d-88b9-365a-a9d2-9cb3d9aecb08",
                                        "glosses": [
                                            "To seek the attention of (a user) on IRC by mentioning their name in a message, causing that message to appear highlighted on their screen."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369431bc-373d-4e86-9edd-b7a25c033c48",
                                                "sense_id": "b7b35f56-b612-30e9-ad84-0218e085c1c7",
                                                "text": "You could have asked: is there a reason this easy patch was not applied, either on IRC or private mail by me. You did write a comment on IRC and I did see it. Problem is that you did not highlight me _and_ you did not wait for an answer."
                                            },
                                            {
                                                "example_id": "9c7b4908-bf45-4b41-9e75-a800cf654bb3",
                                                "sense_id": "b7b35f56-b612-30e9-ad84-0218e085c1c7",
                                                "text": "You must be somewhere completely different. I’ve looked for several days and don’t see you. But: I’m kind of blind from time to time - please feel free to highlight me ([Sno]) or probably (H. Merijn Brand) Tux or vanHoesel (Theo van Hoesel)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
