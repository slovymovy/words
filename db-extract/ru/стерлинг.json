                "senses": [
                    {
                        "sense_id": "89cff2de-7aef-30ad-b953-7d30eba00eb5",
                        "entry_id": "743ecc75-9d25-355d-ad3c-018868853aa7",
                        "glosses": [
                            "разг. и проф. то же, что фунт стерлингов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0698c4-d028-44c3-ae98-c8b4fc93ed9e",
                                "sense_id": "89cff2de-7aef-30ad-b953-7d30eba00eb5",
                                "text": "Он мог в одно мгновение помножить в уме 213 на 373 или перевести стерлинги на марки без помощи карандаша и табличек."
                            },
                            {
                                "example_id": "f3143ed4-438d-429c-a8bf-985843df038a",
                                "sense_id": "89cff2de-7aef-30ad-b953-7d30eba00eb5",
                                "text": "Повышение ставок Банка Англии, если оно и произойдет, скорее всего окажет краткосрочное позитивное влияние на динамику курса стерлинга."
                            }
                        ]
                    }
