{
    "word_family": [
        "stubby",
        "stubbed",
        "stubbing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fe6db93-d505-3c64-b1c8-348eef6bd5ed",
                    "sense_definition": "A piece of certain paper items, designed to be torn off and kept for record or identification purposes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "paper_records",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept the ticket <w>stub</w> as a souvenir of his first concert.",
                            "target_lang_translations": {
                                "ru": "Он сохранил билетный <w>корешок</w> как сувенир со своего первого концерта.",
                                "zh": "他留下了那张音乐会的<w>票根</w>作为纪念。"
                            }
                        },
                        {
                            "text": "Please check your pay <w>stub</w> to verify the hours you worked last week.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте свой расчетный <w>листок</w>, чтобы подтвердить количество отработанных часов на прошлой неделе.",
                                "zh": "请核对你的工资<w>存根</w>，以确认上周的工作时长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ticket stub",
                        "pay stub",
                        "check stub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть бумажного документа (билета, квитанции), предназначенная для отрыва и сохранения для учета или идентификации.",
                        "zh": "纸质票据上可撕下并留作记录或凭证的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корешок",
                                "target_lang_sense_clarification": "билета или квитанции"
                            },
                            {
                                "target_lang_word": "талон",
                                "target_lang_sense_clarification": "отрывной купон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "存根",
                                "target_lang_sense_clarification": "票据或支票的留存部分"
                            },
                            {
                                "target_lang_word": "票根",
                                "target_lang_sense_clarification": "门票或入场券的留存部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af1a87a7-796b-39aa-84c3-71ba3f742382",
                    "sense_definition": "The smallest remainder of a smoked cigarette; a butt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remnants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She crushed the cigarette <w>stub</w> in the glass ashtray on the table.",
                            "target_lang_translations": {
                                "ru": "Она потушила <w>окурок</w> в стеклянной пепельнице на столе.",
                                "zh": "她把<w>烟头</w>按灭在桌上的玻璃烟灰缸里。"
                            }
                        },
                        {
                            "text": "The floor was littered with ash and old cigarette <w>stubs</w>.",
                            "target_lang_translations": {
                                "ru": "Пол был засыпан пеплом и старыми <w>окурками</w>.",
                                "zh": "地板上到处都是烟灰和旧<w>烟头</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cigarette stub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остаток выкуренной сигареты; окурок.",
                        "zh": "吸剩的烟头。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окурок",
                                "target_lang_sense_clarification": "сигареты"
                            },
                            {
                                "target_lang_word": "бычок",
                                "target_lang_sense_clarification": "разговорное, окурок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烟头",
                                "target_lang_sense_clarification": "吸剩的香烟残余"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d27dfc3-fa76-3512-ad66-0bb4ecbabb9d",
                    "sense_definition": "Something blunted, stunted, or cut short, such as stubble or a stump.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remnants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only a short <w>stub</w> of the pencil remained after weeks of writing.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель письма от карандаша остался лишь маленький <w>огрызок</w>.",
                                "zh": "写了几个星期后，铅笔只剩下短短的一截<w>残段</w>了。"
                            }
                        },
                        {
                            "text": "He tripped over a wooden <w>stub</w> sticking out of the forest floor.",
                            "target_lang_translations": {
                                "ru": "Он споткнулся о деревянный <w>обрубок</w>, торчащий из земли в лесу.",
                                "zh": "他被林地上突出的一个木<w>树桩</w>绊倒了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pencil stub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то затупленное, укороченное или срезанное, например, обрубок или остаток карандаша.",
                        "zh": "被截短、磨损或剩下的残余部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огрызок",
                                "target_lang_sense_clarification": "карандаша или свечи"
                            },
                            {
                                "target_lang_word": "обрубок",
                                "target_lang_sense_clarification": "дерева или ветки"
                            },
                            {
                                "target_lang_word": "обломок",
                                "target_lang_sense_clarification": "сломанная часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "残段",
                                "target_lang_sense_clarification": "物体被截断后的剩余部分"
                            },
                            {
                                "target_lang_word": "树桩",
                                "target_lang_sense_clarification": "树木砍伐后留下的根部"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "725a1fbc-6203-366c-a6bf-a5d0f104ac5e",
                    "sense_definition": "An article providing only minimal information and intended for later development.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_and_writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This Wikipedia article is currently just a <w>stub</w> and needs more details.",
                            "target_lang_translations": {
                                "ru": "Эта статья в Википедии сейчас всего лишь <w>заготовка</w> и требует доработки.",
                                "zh": "这篇维基百科文章目前只是一个<w>小作品</w>，需要补充更多细节。"
                            }
                        },
                        {
                            "text": "He created a quick <w>stub</w> for the new topic so others could expand it.",
                            "target_lang_translations": {
                                "ru": "Он быстро создал <w>набросок</w> для новой темы, чтобы другие могли её дополнить.",
                                "zh": "他为新话题快速创建了一个<w>草稿</w>，以便他人进行扩充。"
                            }
