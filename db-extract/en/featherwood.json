                        "examples": [
                            {
                                "example_id": "bca53c01-6c77-4749-8f71-0f01b830c9b4",
                                "sense_id": "70b0d83a-c6cd-386c-a4c3-d85ce5aa2d0a",
                                "text": "I have another roommate who is a white girl, she is a featherwood. So she got this thing in the mail from her pen pal that had peckerwood written in it. And this black girl wanted to look at her mail, which she had no business doing […]"
                            },
