                "senses": [
                    {
                        "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                        "entry_id": "e91344dc-3300-30f0-876a-4105f47f4dcc",
                        "glosses": [
                            "Zustand, in dem etwas vorhanden, existent ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0cf91b-c89a-45c2-9d39-4900cff93c3b",
                                "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                                "text": "Der Vermieter bestreitet das Vorhandensein von Schimmel in der Wohnung."
                            },
                            {
                                "example_id": "a2886bdc-3f05-48ca-b050-ac2d6c4bf14c",
                                "sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                                "text": "Das Vorhandensein von Katzen lässt sich schwer leugnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52397d0c-62f7-4ac1-a9d2-8bd8f61d41bc",
                        "source_entry_id": "e91344dc-3300-30f0-876a-4105f47f4dcc",
                        "source_sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                        "source_sense_description": "Zustand, in dem etwas vorhanden, existent ist",
                        "target_lang_word": "existence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "existence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                        "entry_id": "391e32fb-8eec-34f4-a18f-fe446557f358",
                                        "glosses": [
                                            "Fait d’être, état de ce qui existe ; par exemple le fait d’être d’une manière absolue, ou pour la perception, ou encore pour la conscience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f159762-b42c-483d-9a5c-16d0acf003f4",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "Je crois confusément à beaucoup de choses ; par dessus tout, à l’existence de Dieu, sinon aux dogmes de la religion ; […]."
                                            },
                                            {
                                                "example_id": "f72777a5-bcf4-4f79-ae8d-d8c087baecbe",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "Il semble donc qu'on est en droit de conclure à l’existence d'un large mouvement humain se dirigeant, vers l'époque quaternaire, de l'Est du vieux monde à l'Ouest du nouveau."
                                            },
                                            {
                                                "example_id": "10ff19b3-3813-4f61-9227-24792ff8e3a7",
                                                "sense_id": "5e158eb0-7eb1-3b4c-9f94-6473c17d2ddf",
                                                "text": "La plus récente causerie de Wambery portait sur l’existence d'un tyran walachien, le Voïvode Drakula (ou Vlad Drakul), réputé buveur de sang humain. Le tout-Londres ne parle bientôt plus que de vampires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                        "entry_id": "391e32fb-8eec-34f4-a18f-fe446557f358",
                                        "glosses": [
                                            "Vie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c699296-34cd-458b-a2ae-e87c10c17f3a",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Les Lettres à l'Étrangère, […], ces lettres contiennent des aveux, voilés, il est vrai, des histoires obscures, sans doute, mais reconnaissables pour qui connaît un peu l’existence secrète de Balzac."
                                            },
                                            {
                                                "example_id": "de0ea9da-7fb1-41d1-889c-376e1969cca4",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Lentement, irrésistiblement, avec ampleur, Bert se rendit compte de l’immense tragédie qui ébranlait l’humanité, et au milieu de laquelle s’écoulait sa petite existence ; […]"
                                            },
                                            {
                                                "example_id": "230dbefc-f75a-45c9-bbfd-ada2f075b535",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "[…] Henri Fagerolle, jeté brusquement dans une sorte de tourbillon irrésistible, avait entièrement perdu pied. Il se laissait glisser, ballotter, secouer dans les remous d'une existence qui ne lui accordait aucun répit."
                                            },
                                            {
                                                "example_id": "11596653-f29d-4c34-b244-7d971285fc40",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "La jeune femme était inquiète de ce bouleversement qu'elle sentait envahir son existence. Elle était heureuse cependant, car elle avait une raison de vivre et d'espérer."
                                            },
                                            {
                                                "example_id": "7f4d9a42-b716-4c96-b8bc-a6bc83f6bdb9",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Tout métier qui ne fait pas oublier le travail est un esclavage. La vie alors n'est plus une existence."
                                            },
                                            {
                                                "example_id": "17d11125-157e-4316-8308-b15b68e77746",
                                                "sense_id": "337cf17a-4233-34b2-8404-936c9714fe11",
                                                "text": "Voilà une existence qui n'a rien à voir avec celle que j'ai connue dans un bourg morvandiau, au milieu des toucheurs de bœufs et des mineurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5db9d8c4-21be-4327-8d41-e8b489d74de1",
                        "source_entry_id": "e91344dc-3300-30f0-876a-4105f47f4dcc",
                        "source_sense_id": "fe62fcdc-6743-3411-8dfe-14e9c4ad6f1c",
                        "source_sense_description": "Zustand, in dem etwas vorhanden, existent ist",
                        "target_lang_word": "présence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Existence d’une personne dans un lieu donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "295b7b17-c6c2-4c71-996f-134b97906a2d",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "Nous nous étions abstenus de faire du feu dans la crainte que la fumée ne révélât notre présence, mais voyant que nous étions découverts, nous fîmes la cuisine."
                                            },
                                            {
                                                "example_id": "d1591a3c-a6c6-4bb9-a5e0-f43bbb5178fc",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "Grande donc fut sa surprise lorsque, […], il se vit appréhender vigoureusement par deux douaniers qui s’étaient dissimulés dans l’intérieur du taillis et dont il n’avait naturellement pu soupçonner la présence."
                                            },
                                            {
                                                "example_id": "09af550b-6ed6-42b9-916e-e0b42f6eb43b",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "Si l'on signale, en 350, la présence à Metz d'un évêque du nom de Siméon, qui aurait été un juif converti, cela ne signifie pas qu'il y ait déjà eu des juifs dans cette ville."
                                            },
                                            {
                                                "example_id": "dcc41e8d-a7fe-47ff-a9d7-4058d4576f05",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "J'avais pu constater, parmi cette cinquantaine de squales presque noirs, la présence d'un énorme requin blanc sale."
                                            },
                                            {
                                                "example_id": "065775a9-c2b5-49e0-9a28-58b373d77e37",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "— Elle était désormais indispensable. Elle seule emplissait la maison de sa discrète présence."
                                            },
                                            {
                                                "example_id": "e05cd4ba-9e55-4594-8a95-96a161a77e08",
                                                "sense_id": "fdf6a483-8c0d-35de-b935-4b691a2a68b9",
                                                "text": "Qu’ai-je besoin de demander aux choses d’autres jouissances que celle de leur présence, c’est-à-dire leur beauté et leur parfum ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c83cd76c-4981-3f80-a71a-1d6c06f4db5a",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Existence d’une personne au lieu de son domicile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad40cede-09d3-3c0b-8dfd-dc2e89f83b08",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Résidence habituelle d’une personne dans le ressort d’une cour d’appel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26ef011f-a9d7-3427-a206-9c4f642a859c",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Manifestation ou sentiment de la présence de quelqu'un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "983fb5cf-b079-4245-8913-5e50d1e04c2e",
                                                "sense_id": "26ef011f-a9d7-3427-a206-9c4f642a859c",
                                                "text": "Un léger souffle l'avertissait de ces présences. Geisha le comparait à ces vagues vents coulis traversant certaines pièces bien closes sans qu'on puisse découvrir d'où ils viennent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9557d12-ffc4-3bad-a01d-6ba0dd8d6cd4",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Ubiquité de Dieu."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b517aaf3-9d6b-4d36-8d0e-c2314e6b3028",
                                                "sense_id": "b9557d12-ffc4-3bad-a01d-6ba0dd8d6cd4",
                                                "text": "Dieu remplit l’univers de sa présence. — Se mettre, se tenir en la présence de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e670f6b-defe-35b8-a055-9981fcf35112",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Ce qui semble nous accompagner, en parlant des choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "679770bf-b75d-49ac-97ea-21b846625938",
                                                "sense_id": "8e670f6b-defe-35b8-a055-9981fcf35112",
                                                "text": "La présence de la mort. - Montrer du sang-froid en présence du danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ac6f4b-bfe4-3246-8047-de5b3dc98536",
                                        "entry_id": "872aa52f-355c-3971-84e4-5effa09b8a83",
                                        "glosses": [
                                            "Existence dans un corps d’une substance que l’on découvre par l’examen ou l’analyse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46599dd-fb07-4b58-8f67-a5b168984b50",
                                                "sense_id": "48ac6f4b-bfe4-3246-8047-de5b3dc98536",
                                                "text": "Les arômes contribuent à rendre le produit agréable au palais, ce qui dépend essentiellement de la présence de produits laitiers ou de la matière édulcorante dans la formule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
