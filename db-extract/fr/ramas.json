        "fr-extract.jsonl": [
            {
                "entry_id": "1f9522c0-f2f1-38a8-9ce5-a9388fe9f8be",
                "word": "ramas",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                        "entry_id": "1f9522c0-f2f1-38a8-9ce5-a9388fe9f8be",
                        "glosses": [
                            "Ramassis, assemblage de diverses choses."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d20c26a2-1bc1-48e9-89da-adeec08530cf",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "Ce discours n’est qu’un ramas de lieux communs. Cette histoire n’est qu’un ramas d’impostures."
                            },
                            {
                                "example_id": "91580b40-d9e8-441a-986c-ccc9b80f96b3",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "Un ramas de bandits, de vagabonds."
                            },
                            {
                                "example_id": "05e73eaf-012d-49d2-ba43-736a3d83825e",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "Mais écrasons d’abord ce ramas qui conspire,\nEt nous verrons après à qui sera l’empire."
                            },
                            {
                                "example_id": "54a50b2d-ca4f-457e-89f9-8c0ca8f82ae7",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "— Un ramas de faussetés, de commérages, tous les mensonges que nos ennemis ont lancés autrefois contre nous, enragés par notre triomphe !…"
                            },
                            {
                                "example_id": "53c7bd2f-e6b6-4c8e-8d51-f6d72332fcde",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "On sait ce qu’étaient ces armées, ramas de racoleurs et de racolés, chiourme de terre, divisée en lots qu’achetaient de jeunes nobles, parfois des enfants."
                            },
                            {
                                "example_id": "0309b2a0-7e50-49c2-9849-1a529786fe83",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "Que ce fût une bâtisse officielle en pierre, […], dominant solitaire le ramas des humbles logis en bois ; […] - rien n'échappait à la subtilité de mon attention juvénile."
                            },
                            {
                                "example_id": "62062ef3-0d2b-4485-938f-6c3057d0b23e",
                                "sense_id": "66ce421e-0c15-3cde-8be1-4325b583e6b7",
                                "text": "La Révolution n’a cessé de manifester sa répugnance à concevoir qu’il puisse y avoir des mondes différents, et différemment régis. Elle fustige continûment le multiple : l’« hydre », le « polype », le « ramas » sont des injures jacobines, symboles d’une prolifération inquiétante, malsaine et incontrôlable."
                            }
                        ]
                    }
                ],
