{
    "word_family": [
        "concept",
        "conception",
        "conceptual",
        "conceptualize",
        "conceivable",
        "inconceivable",
        "misconceive",
        "preconceive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c3e899b-ec73-31b3-99d4-035cbc059f4c",
                    "sense_definition": "To form or develop a plan, idea, or feeling in the mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect helped <w>conceive</w> the <w>idea</w> for the new city park.",
                            "target_lang_translations": {
                                "ru": "Архитектор помог <w>задумать</w> идею нового городского парка."
                            }
                        },
                        {
                            "text": "It is difficult to <w>conceive</w> a <w>plan</w> that satisfies every member of the committee.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>разработать</w> план, который удовлетворил бы каждого члена комитета."
                            }
                        }
                    ],
                    "synonyms": [
                        "devise",
                        "formulate",
                        "think up"
                    ],
                    "common_phrases": [
                        "conceive an idea",
                        "conceive a plan",
                        "conceive a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформулировать или разработать план, идею или чувство в уме."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задумать",
                                "target_lang_sense_clarification": "мысленно составить план или идею"
                            },
                            {
                                "target_lang_word": "разработать",
                                "target_lang_sense_clarification": "детально продумать проект или план"
                            },
                            {
                                "target_lang_word": "замыслить",
                                "target_lang_sense_clarification": "спланировать что-либо, часто масштабное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9992fe5-4979-3fd1-b69d-2657301979b3",
                    "sense_definition": "To become pregnant with a child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple had been <w>trying</w> to <w>conceive</w> for several years before they were successful.",
                            "target_lang_translations": {
                                "ru": "Пара пыталась <w>зачать</w> ребенка в течение нескольких лет, прежде чем им это удалось."
                            }
                        },
                        {
                            "text": "Medical treatments can sometimes help women who find it difficult to <w>conceive</w> naturally.",
                            "target_lang_translations": {
                                "ru": "Медицинское лечение иногда может помочь женщинам, которым трудно <w>забеременеть</w> естественным путем."
                            }
                        }
                    ],
                    "synonyms": [
                        "get pregnant"
                    ],
                    "common_phrases": [
                        "trying to conceive",
                        "unable to conceive",
                        "conceive a child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забеременеть ребенком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачать",
                                "target_lang_sense_clarification": "биологический процесс начала беременности"
                            },
                            {
                                "target_lang_word": "забеременеть",
                                "target_lang_sense_clarification": "стать беременной"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "564abb79-c585-3112-b89b-8c05ff787a16",
                    "sense_definition": "To imagine or visualize something as being a certain way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is hard to <w>conceive</w> <w>of</w> a world without modern technology.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>представить</w> себе мир без современных технологий."
                            }
                        },
                        {
                            "text": "I cannot <w>conceive</w> <w>of</w> him acting so rudely to his guests.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>вообразить</w>, чтобы он вел себя так грубо со своими гостями."
                            }
                        }
                    ],
                    "synonyms": [
                        "envision",
                        "visualize",
                        "imagine"
                    ],
                    "common_phrases": [
                        "conceive of",
                        "hard to conceive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представить или визуализировать что-либо определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "вообразить что-либо в уме"
                            },
                            {
                                "target_lang_word": "вообразить",
                                "target_lang_sense_clarification": "создать мысленный образ"
                            },
                            {
                                "target_lang_word": "помыслить",
                                "target_lang_sense_clarification": "допустить мысль о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8af337f-852e-3be7-877a-0149656bcf90",
                    "sense_definition": "To understand or grasp the meaning of what someone is saying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>conceive</w> your meaning perfectly, though your explanation was brief.",
                            "target_lang_translations": {
                                "ru": "Я прекрасно <w>понимаю</w> вашу мысль, хотя ваше объяснение было кратким."
                            }
                        },
                        {
                            "text": "Do you <w>conceive</w> the gravity of the situation we are currently facing?",
                            "target_lang_translations": {
                                "ru": "Вы <w>постигаете</w> всю серьезность ситуации, с которой мы сейчас столкнулись?"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehend",
                        "grasp",
                        "apprehend"
                    ],
                    "antonyms": [
                        "misunderstand"
                    ],
                    "common_phrases": [
                        "conceive the meaning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Понять или уловить смысл того, что кто-то говорит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "постигать смысл высказывания"
                            },
                            {
                                "target_lang_word": "постигать",
                                "target_lang_sense_clarification": "глубоко осознавать или понимать"
                            },
                            {
                                "target_lang_word": "уяснить",
                                "target_lang_sense_clarification": "сделать ясным для себя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}