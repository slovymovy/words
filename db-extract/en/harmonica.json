                        "source_entry_id": "646b819d-329e-3c14-a981-824aa4d957d9",
                        "source_sense_description": "musical instrument, consisting of a series of glasses",
                        "target_lang_word": "Glasharmonika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
