                        "examples": [
                            {
                                "example_id": "1d302dc4-9d0e-4816-b550-5f9d87172620",
                                "sense_id": "01b4b762-427c-30a0-91ce-b8ade7fa988a",
                                "text": "Eine gefährliche Folge eines Wespenstichs kann außerdem eine Blutvergiftung sein. Ist die Einstichstelle eitrig oder entzündet, sollte ebenfalls ein Facharzt konsultiert werden.",
                                "translation": "Une septicémie peut également être une conséquence dangereuse d’une piqûre de guêpe. Si la piqûre est purulente ou enflammée, il faut également consulter un médecin spécialiste."
                            }
                        ]
                    }
