                        "entry_id": "c59e9860-351c-3307-8d64-cf1b1258ed4f",
                        "glosses": [
                            "A windlass, a device for drawing ore up from a mine, also formerly used (when made entirely of wood) to indicate possession of mining land."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1481c8-d61c-4b47-8609-12355d6f205e",
                                "sense_id": "cb6f3d1d-b70a-3817-ac68-016abd69b971",
                                "text": "When a person discovers a vein, and has no means to possess it for want of stowces, he marks the ground with crosses and holes, by which means he possesses it until he can procure stowces."
                            },
                            {
                                "example_id": "5ea0ca7f-dfb3-483d-907b-1fb43e2b1b9b",
                                "sense_id": "cb6f3d1d-b70a-3817-ac68-016abd69b971",
                                "text": "Legal possession of a mine was kept only by erecting stows or stowces, which must be \"set in all men's sight.\" The stow is a machine for drawing up the ore in tubs from the mine. It is constructed of seven pieces of timber fastened together by wooden pins. If nails or any metal is used in[…]"
                            },
                            {
                                "example_id": "360b5f56-3283-45c3-a945-f137d28a360a",
                                "sense_id": "cb6f3d1d-b70a-3817-ac68-016abd69b971",
                                "text": "A miner established his claim to a vein which he had discovered by placing a stowce on the spot."
                            }
                        ]
                    }
