                        "entry_id": "0dd474cc-e34e-3377-8b0c-4d1eb6324965",
                        "glosses": [
                            "encumbered by a literal or figurative burden; having too much to deal with."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11a2ab97-6c70-4078-9f75-63e639d2211f",
                                "sense_id": "d565a526-1ee0-33e0-8ea5-3a84f819d555",
                                "text": "When my clients describe themselves as the black sheep in their families, they often feel very burdened."
                            },
                            {
                                "example_id": "eb7932de-d0b0-4686-80e2-94327ca989ef",
                                "sense_id": "d565a526-1ee0-33e0-8ea5-3a84f819d555",
                                "text": "Not any more burdened by modesty than you used to be, I perceive, young lady."
                            },
                            {
                                "example_id": "6dec8227-8f6e-4865-9268-145d5f4bc722",
                                "sense_id": "d565a526-1ee0-33e0-8ea5-3a84f819d555",
                                "text": "Caregivers who do not feel burdened are unlikely to perceive a need for services."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
