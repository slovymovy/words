                                                "example_id": "d13232bd-8821-4a7d-b8d6-63060218a396",
                                                "sense_id": "b59d81de-2eaa-3f4c-9ba1-8feba6730dba",
                                                "text": "At the time, international deep-sea shipping remained a loose cargo operation, although BR did seek to influence conversion to unit loads by providing a containerised short sea shipping service between Harwich and Rotterdam in 1968."
                                            }
                                        ]
                                    },
                                    {
