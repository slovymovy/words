                "senses": [
                    {
                        "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                        "entry_id": "f8943f78-82ac-3192-a967-6c4b4b896a07",
                        "glosses": [
                            "unverhältnismäßig großes, unnötiges Aufsehen, das jemand oder etwas erfährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8ea43d-8bfc-4f41-b3c0-50b7dfa0a683",
                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                "text": "„Das Bohei um den McLaren-Piloten droht an diesem Wochenende auszuufern, wenn Hamilton beim Grand Prix von England in Silverstone aufs Gaspedal tritt, nur eine Autostunde entfernt von seinem Geburtsort Hertfordshire.“"
                            },
                            {
                                "example_id": "44f564e1-764f-4f5b-a7fe-0e80068cea25",
                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                "text": "„Insgesamt ist aber der Bohei um den weißen Trüffel ein ziemlicher Lifestyle-Wahnsinn.“"
                            },
                            {
                                "example_id": "98a589b8-89dc-4ded-aa5c-0bd3cb27f428",
                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                "text": "„Erinnern Sie sich noch an den Bohei um die Akten des Staatssicherheitsdienstes? Öffnen oder nicht? Dabei waren das meist noch handschriftliche Unterlagen.“"
                            },
                            {
                                "example_id": "35ef2a88-f00d-4f23-abd6-628871c81b3f",
                                "sense_id": "57c08386-cab3-3d3e-89a3-65899e13ed05",
                                "text": "„Es wurde viel Bohei um die Einführung des erzählenden Ichs im Journalismus gemacht, denn dieses Ich steht bei uns für Subjektivismus, also für den Todfeind der objektiven Berichterstattung schlechthin, aber ich glaube, darum ging es Hunter S. Thompson überhaupt nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
