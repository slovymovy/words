                        "translation_id": "d7f9f65c-2c4c-45b3-84b9-7473501bdfed",
                        "source_entry_id": "e6d30650-8e06-3fc8-8111-a5c8102c5257",
                        "source_sense_id": "f463eb3a-a8e0-35f7-88e3-857e48214214",
