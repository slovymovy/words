{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "66ba4bb9-4854-3046-b3ea-c496782fa1f3",
                    "sense_definition": "Away from the correct path, direction, or proper course of action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The letter was sent to the wrong address and went <w>astray</w> in the post.",
                            "target_lang_translations": {
                                "pl": "List został wysłany pod zły adres i <w>zagubił się</w> na poczcie.",
                                "ru": "Письмо отправили не по тому адресу, и оно <w>затерялось</w> на почте."
                            }
                        },
                        {
                            "text": "The corrupt politician's speech led many young voters <w>astray</w> with false promises.",
                            "target_lang_translations": {
                                "pl": "Przemówienie zkorumpowanego polityka sprowadziło wielu młodych wyborców <w>na manowce</w> fałszywymi obietnicami.",
                                "ru": "Речь коррумпированного политика сбила многих молодых избирателей <w>с пути истинного</w> ложными обещаниями."
                            }
                        }
                    ],
                    "synonyms": [
                        "amiss",
                        "off-track",
                        "afield"
                    ],
                    "antonyms": [
                        "on-track"
                    ],
                    "common_phrases": [
                        "go astray",
                        "lead astray"
                    ],
                    "target_lang_definitions": {
                        "pl": "Z dala od właściwej ścieżki, kierunku lub właściwego postępowania.",
                        "ru": "В сторону от правильного пути, направления или верного образа действий; сбившись с пути или потерявшись."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "na manowce",
                                "target_lang_sense_clarification": "o zejściu na złą drogę lub sprowadzeniu kogoś na nią"
                            },
                            {
                                "target_lang_word": "błędnie",
                                "target_lang_sense_clarification": "w niewłaściwym kierunku lub miejscu"
                            },
                            {
                                "target_lang_word": "poza szlak",
                                "target_lang_sense_clarification": "zbaczając z drogi"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сбившись с пути",
                                "target_lang_sense_clarification": "в прямом или переносном смысле"
                            },
                            {
                                "target_lang_word": "заблудившись",
                                "target_lang_sense_clarification": "потеряв верное направление"
                            },
                            {
                                "target_lang_word": "на ложный путь",
                                "target_lang_sense_clarification": "о моральном падении или ошибке (обычно с глаголом lead)"
                            },
                            {
                                "target_lang_word": "не туда",
                                "target_lang_sense_clarification": "в неверном направлении, мимо цели"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}