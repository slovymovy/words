                ],
                "senses": [
                    {
                        "sense_id": "ca37503d-5006-3131-9982-f3321fd25cd3",
                        "entry_id": "0e37b1a3-e44e-3e68-94fe-ee08bd858e46",
                        "glosses": [
                            "устар., разг. трёхкопеечная монета, три копейки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edff78b9-06c4-4397-b7b4-92033bcdf83f",
                                "sense_id": "ca37503d-5006-3131-9982-f3321fd25cd3",
                                "text": "И пятаки, и трешники, и копейки сыпались в горсть монаху, зорко заглядывавшему в мошны мужикам и бабам."
                            }
                        ]
                    },
                    {
                        "sense_id": "7340667e-fa93-3a3d-97b2-bc9e78542931",
                        "entry_id": "0e37b1a3-e44e-3e68-94fe-ee08bd858e46",
                        "glosses": [
                            "устар., разг. трёхрублевая купюра, три рубля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad899e9-6b2c-42b0-b928-145b70712fdd",
                                "sense_id": "7340667e-fa93-3a3d-97b2-bc9e78542931",
                                "text": "Вот что могут сделать три рубля, какой-то задрипанный трешник."
                            }
                        ]
                    },
                    {
                        "sense_id": "76a247cd-4af5-3859-a4cc-5c9204c23607",
                        "entry_id": "0e37b1a3-e44e-3e68-94fe-ee08bd858e46",
                        "glosses": [
                            "устар. одна копейка серебром (в переводе на бумажные ассигнации составлявшая три с половиной копейки)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5b4c9f-3a24-421c-93f6-3eb17807442f",
                                "sense_id": "76a247cd-4af5-3859-a4cc-5c9204c23607",
                                "text": "Нынешнюю копейку серебром народ зовет трешником; две копейки, семичником; три копейки десятичником."
                            },
                            {
                                "example_id": "b64bd4e7-80ab-445c-8c30-f2eb0c6b7ee3",
                                "sense_id": "76a247cd-4af5-3859-a4cc-5c9204c23607",
                                "text": "Тот ни строки без трешника, ни слова без семишника…"
                            }
                        ]
                    }
                ],
