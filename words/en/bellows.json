{
    "word_family": [
        "bellow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30607556-19d8-3c07-9cec-8586604f9fde",
                    "sense_definition": "A device for delivering pressurized air in a controlled quantity to a controlled location, typically consisting of a deformable container with an outlet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "air_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith used a large leather <w>bellows</w> to blow air into the fire and make it hotter.",
                            "target_lang_translations": {
                                "de": "Der Schmied benutzte einen großen ledernen <w>Blasebalg</w>, um Luft in das Feuer zu blasen und es heißer zu machen."
                            }
                        },
                        {
                            "text": "When wood fires were common, so were hand <w>bellows</w> for helping start them.",
                            "target_lang_translations": {
                                "de": "Als Holzfeuer noch üblich waren, waren auch Hand-<w>Blasebälge</w> weit verbreitet, um sie zu entfachen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand bellows",
                        "leather bellows"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Gerät zur Erzeugung eines kontrollierten Luftstroms, meist bestehend aus einem verformbaren Behälter mit einer Austrittsöffnung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blasebalg",
                                "target_lang_sense_clarification": "Gerät zur Erzeugung eines Luftstroms, z. B. für ein Feuer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650caed0-4d2e-3b42-88ce-665d72e0f36c",
                    "sense_definition": "Flexible, light-tight enclosures connecting the lensboard and the camera back in vintage or large-format cameras.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flexible_enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carefully extended the camera <w>bellows</w> to focus on the distant mountain.",
                            "target_lang_translations": {
                                "de": "Er zog den <w>Faltenbalg</w> der Kamera vorsichtig heraus, um auf den fernen Berg zu fokussieren."
                            }
                        },
                        {
                            "text": "If the leather <w>bellows</w> has a tiny hole, light will leak in and ruin the film.",
                            "target_lang_translations": {
                                "de": "Wenn der lederne <w>Balg</w> ein winziges Loch hat, dringt Licht ein und ruiniert den Film."
                            }
                        }
                    ],
                    "common_phrases": [
                        "camera bellows"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Flexible, lichtdichte Verbindung zwischen dem Objektiv und der Kamerarückseite bei historischen oder Großformatkameras."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Faltenbalg",
                                "target_lang_sense_clarification": "Kamerabalg bei historischen Kameras"
                            },
                            {
                                "target_lang_word": "Balg",
                                "target_lang_sense_clarification": "Kurzform für den Kamerabalg"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfb09a3e-411c-3407-bdbf-4032b0bb17ee",
                    "sense_definition": "Any flexible container or protective enclosure, such as one used to cover a moving joint.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "flexible_enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rubber <w>bellows</w> protects the steering joint from dust and moisture.",
                            "target_lang_translations": {
                                "de": "Der <w>Faltenbalg</w> aus Gummi schützt das Lenkgelenk vor Staub und Feuchtigkeit."
                            }
                        },
                        {
                            "text": "Engineers designed a protective <w>bellows</w> to cover the moving parts of the machine.",
                            "target_lang_translations": {
                                "de": "Ingenieure entwarfen einen schützenden <w>Faltenbalg</w>, um die beweglichen Teile der Maschine abzudecken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "protective bellows"
                    ],
                    "target_lang_definitions": {
                        "de": "Jede flexible Schutzhülle oder verformbare Abdeckung, beispielsweise zum Schutz eines beweglichen Gelenks."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Faltenbalg",
                                "target_lang_sense_clarification": "Schutzabdeckung für Gelenke im Maschinenbau"
                            },
                            {
                                "target_lang_word": "Schutzbalg",
                                "target_lang_sense_clarification": "schützende Hülle für bewegliche Teile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2a1a9c4-6944-34df-8236-25c54b8bfb52",
                    "sense_definition": "The lungs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer took a deep breath, filling his powerful <w>bellows</w> before hitting the high note.",
                            "target_lang_translations": {
                                "de": "Der Sänger holte tief Luft und füllte seine mächtigen <w>Blasebälge</w>, bevor er den hohen Ton traf."
                            }
                        },
                        {
                            "text": "He struck himself a sounding blow on the chest, boasting about his strong <w>bellows</w>.",
                            "target_lang_translations": {
                                "de": "Er versetzte sich selbst einen kräftigen Schlag auf die Brust und prahlte mit seiner starken <w>Lunge</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lungs"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "humorous or dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Die Lunge (scherzhaft oder veraltet)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Blasebalg",
                                "target_lang_sense_clarification": "humorvoll für die Lunge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09c5f272-12ca-3807-b23f-1ee766d4d4f5",
                    "sense_definition": "That which fans the fire of hatred, jealousy, or other strong emotions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His harsh words acted as a <w>bellows</w> to her growing anger.",
                            "target_lang_translations": {
                                "de": "Seine harten Worte wirkten wie ein <w>Blasebalg</w> für ihren wachsenden Zorn."
                            }
                        },
                        {
                            "text": "Rumors served as the <w>bellows</w> of jealousy among the rivals.",
                            "target_lang_translations": {
                                "de": "Gerüchte dienten als <w>Anpitscher</w> der Eifersucht unter den Rivalen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas, das starke Gefühle wie Hass oder Eifersucht weiter anfacht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Anpitscher",
                                "target_lang_sense_clarification": "metaphorisch für etwas, das Gefühle anfacht"
                            },
                            {
                                "target_lang_word": "Schürer",
                                "target_lang_sense_clarification": "etwas, das Emotionen anheizt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "699cb1c5-946c-3807-a6e4-6231be472ccb",
                    "sense_definition": "Plural form of <w>bellow</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plural_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>bellows</w> of the bulls could be heard across the entire valley.",
                            "target_lang_translations": {
                                "de": "Das laute <w>Brüllen</w> der Stiere war im ganzen Tal zu hören."
                            }
                        },
                        {
                            "text": "We were startled by the sudden <w>bellows</w> of laughter coming from the next room.",
                            "target_lang_translations": {
                                "de": "Wir erschraken über das plötzliche <w>Gelächter</w>, das aus dem Nebenzimmer drang."
                            }
                        }
                    ],
                    "synonyms": [
                        "roars",
                        "shouts"
                    ],
                    "common_phrases": [
                        "loud bellows"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Pluralform von Brüllen, Aufschreien oder lautem Rufen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gebrüll",
                                "target_lang_sense_clarification": "laute, tiefe Schreie"
                            },
                            {
                                "target_lang_word": "Schreie",
                                "target_lang_sense_clarification": "laute Rufe"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04be219e-46c9-3d4a-a61c-1d6449db5530",
                    "sense_definition": "Third-person singular simple present indicative form of <w>bellow</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_inflections",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach <w>bellows</w> instructions to the players from the sidelines.",
                            "target_lang_translations": {
                                "de": "Der Trainer <w>brüllt</w> den Spielern von der Seitenlinie aus Anweisungen zu."
                            }
                        },
                        {
                            "text": "Whenever he gets frustrated, he <w>bellows</w> at the computer screen.",
                            "target_lang_translations": {
                                "de": "Wann immer er frustriert ist, <w>schreit</w> er den Computerbildschirm an."
                            }
                        }
                    ],
                    "synonyms": [
                        "shouts",
                        "yells",
                        "roars"
                    ],
                    "antonyms": [
                        "whispers"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Dritte Person Singular Präsens des Verbs „bellow“ (brüllen, schreien)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "brüllt",
                                "target_lang_sense_clarification": "schreit mit lauter, tiefer Stimme"
                            },
                            {
                                "target_lang_word": "schreit",
                                "target_lang_sense_clarification": "ruft sehr laut"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                    "sense_definition": "To operate a bellows; to direct air at something using a bellows.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bellows_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apprentice spent the afternoon <w>bellowsing</w> the forge to keep the coals hot.",
                            "target_lang_translations": {
                                "de": "Der Lehrling verbrachte den Nachmittag damit, <w>den Blasebalg der Schmiede zu betätigen</w>, um die Kohlen heiß zu halten."
                            }
                        },
                        {
                            "text": "He <w>bellowsed</w> the dying embers until a bright flame finally caught the wood.",
                            "target_lang_translations": {
                                "de": "Er <w>fachte</w> die sterbende Glut mit dem Blasebalg <w>an</w>, bis das Holz schließlich eine helle Flamme fing."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bellows the forge"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Blasebalg bedienen; Luft mithilfe eines Blasebalgs auf etwas richten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "den Blasebalg betätigen",
                                "target_lang_sense_clarification": "Luft mit dem Blasebalg zuführen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                    "sense_definition": "To expand and contract rhythmically like a bellows.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bellows_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long race, the dog lay on the grass with its sides <w>bellowsing</w> rapidly.",
                            "target_lang_translations": {
                                "de": "Nach dem langen Rennen lag der Hund im Gras, während sich seine Flanken schnell <w>wie ein Blasebalg hoben und senkten</w>."
                            }
                        },
                        {
                            "text": "His chest <w>bellowsed</w> deeply as he tried to catch his breath after the climb.",
                            "target_lang_translations": {
                                "de": "Seine Brust <w>hob und senkte sich</w> tief, als er nach dem Aufstieg versuchte, Atem zu holen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sides bellowsing"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich rhythmisch wie ein Blasebalg ausdehnen und zusammenziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich wie ein Blasebalg bewegen",
                                "target_lang_sense_clarification": "rhythmisch weiten und verengen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b79e037a-ac7d-35dd-b575-d04f65290f38",
                    "sense_definition": "To fold up or collapse in pleats like a bellows; to accordion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bellows_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train cars <w>bellowsed</w> together during the sudden collision.",
                            "target_lang_translations": {
                                "de": "Die Waggons des Zuges <w>schoben sich</w> bei dem plötzlichen Zusammenstoß wie eine Ziehharmonika <w>zusammen</w>."
                            }
                        },
                        {
                            "text": "The leather boots were designed to be supple and <w>bellowsed</w> at the ankle for comfort.",
                            "target_lang_translations": {
                                "de": "Die Lederstiefel waren so konzipiert, dass sie geschmeidig waren und sich für mehr Komfort am Knöchel <w>falten</w> ließen."
                            }
                        }
                    ],
                    "synonyms": [
                        "accordion"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich in Falten zusammenlegen oder wie eine Ziehharmonika zusammenschieben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "sich falten",
                                "target_lang_sense_clarification": "wie ein Faltenbalg zusammenschieben"
                            },
                            {
                                "target_lang_word": "zusammenschieben",
                                "target_lang_sense_clarification": "harmonikaartig kollabieren"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d1049800-60a3-3fd2-9b5b-7271db2bb913",
                    "sense_definition": "Plural of the surname <w>Bellow</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plural_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We are going to visit the <w>Bellows</w> this weekend for dinner.",
                            "target_lang_translations": {
                                "de": "Wir werden dieses Wochenende die <w>Bellows</w> zum Abendessen besuchen."
                            }
                        },
                        {
                            "text": "The <w>Bellows</w> family has lived in this historic neighborhood for generations.",
                            "target_lang_translations": {
                                "de": "Die Familie <w>Bellows</w> lebt seit Generationen in diesem historischen Viertel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Plural des Nachnamens Bellow."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bellows",
                                "target_lang_sense_clarification": "Familie Bellow"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}