        "fr-extract.jsonl": [
            {
                "entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                "word": "rousseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ec46d3c-28b2-4057-9909-fa4c755967d3",
                        "entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "rousseurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffa87b34-427c-37d1-b6b2-786a6b299705",
                        "entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                        "glosses": [
                            "Caractère de ce qui est roux."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "d1c016c4-b033-40fa-862f-e09bfc880103",
                                "sense_id": "ffa87b34-427c-37d1-b6b2-786a6b299705",
                                "text": "La rousseur de son poil."
                            },
                            {
                                "example_id": "4b5b9d67-4553-4813-b3de-6c1dd6715de2",
                                "sense_id": "ffa87b34-427c-37d1-b6b2-786a6b299705",
                                "text": "Il y a tant de rousseurs, chevelures ophéliennes, désir de goûter comme avant, pain-beurre-pain d’épice, forêts surtout, rousseur du sol, rousseur du ciel, insaisissables odeurs de foires et bois, de cèpes et d’eau."
                            },
                            {
                                "example_id": "5fd34f17-245f-4e31-862c-3615eb92092f",
                                "sense_id": "ffa87b34-427c-37d1-b6b2-786a6b299705",
                                "text": "L'automne commençait doucement : sa rousseur humide, son jaune fatigué enrobaient les végétaux, les bâtiments et les hommes; la texture de la réalité était triste."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eb605eb-7c75-3fe7-a2c6-de0335895f2a",
                        "entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                        "glosses": [
                            "Tache de rousseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d717563-9e84-477a-919a-df5a60708039",
                                "sense_id": "0eb605eb-7c75-3fe7-a2c6-de0335895f2a",
                                "text": "Elle était blonde, avec de grands yeux bleus toujours humides, un peu froids, qui avaient l’air de baigner dans l’eau. — Ses cheveux étaient presque couleur de chanvre, et ses joues étaient saupoudrées de rousseurs ; mais la peau du cou était blanche, tendre et fine comme du lait caillé."
                            },
                            {
                                "example_id": "03de6dcf-e0e6-40f3-b926-5f1884673151",
                                "sense_id": "0eb605eb-7c75-3fe7-a2c6-de0335895f2a",
                                "text": "Il a des rousseurs au visage."
                            }
                        ]
                    },
                    {
                        "sense_id": "4952b899-f02c-33e9-87d2-b03fade5ff3f",
                        "entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                        "glosses": [
                            "Tache due à l'humidité et au confinement (livres etc.)"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0e6832bf-32db-44e5-9532-906667cbcf9d",
                                "sense_id": "4952b899-f02c-33e9-87d2-b03fade5ff3f",
                                "text": "Le papier peint est à changer à moins que vous ne trouviez du charme aux rousseurs !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f54ad31-5c71-44d0-a303-3924c094f2ea",
                        "source_entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
                        "source_sense_description": "(Au singulier) Caractère de ce qui est roux",
                        "target_lang_word": "Röte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Röte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                        "entry_id": "cc3ee2ac-9758-39a5-b007-55ab65d3b183",
                                        "glosses": [
                                            "rote Färbung, die rote Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88369fc5-941c-4284-8adc-6d4418b6e872",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "Die Röte ist aber ein recht stabiles Merkmal dieser Pflanzen, deren Sämlinge ebenfalls oft Rot sind (Johnson 1973)."
                                            },
                                            {
                                                "example_id": "e6f14530-93db-40f2-8655-33461dd84d10",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "Bei manchen Personen tritt nach dem Essen, vor allem nach dem reichlichen Genuss von Speisen, eine starke Röte im Gesicht auf."
                                            },
                                            {
                                                "example_id": "766c1911-09dc-4e37-b383-39d3caf76972",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "„Die Nacht war hell vom ersten Schneefall des Winters, und die fleckige Röte, die an den Wangen der Mama hochstieg, war gut zu erkennen.“"
                                            },
                                            {
                                                "example_id": "900b3085-4f2a-4fd6-a23e-da3630ffde8d",
                                                "sense_id": "93fc005d-7d5c-38d2-a58f-f9b9a5580a73",
                                                "text": "„Als aber am Sonntag nach dem Hochamt der Diener im Salon meldete, Graf Rostow sei da, liess die Prinzessin sich doch keine Verwirrung oder Verlegenheit anmerken; nur eine leichte Röte trat ihr auf die Wangen, und ihre Augen gewannen einen neuen, leuchtenden Glanz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e2b7b7d0-adb5-3a0f-8373-770f754de82d",
                                        "entry_id": "cc3ee2ac-9758-39a5-b007-55ab65d3b183",
                                        "glosses": [
                                            "als Kraut wachsendes Rötegewächs mit grünlich gelben Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9df05741-4626-4abf-9d64-1301375cbe09",
                                                "sense_id": "e2b7b7d0-adb5-3a0f-8373-770f754de82d",
                                                "text": "Zu den Rötegewächsen gehören Nutz- und Kulturpflanzen, u. a. Kaffeestrauch, Brechwurzel, Chinarindenbaum, Yohimbinbaum sowie Gambir und Röte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93a26426-82a8-4581-869a-9bdba31972fc",
                        "source_entry_id": "49ad76af-3a13-3a0f-89ff-0442db6dd5f8",
