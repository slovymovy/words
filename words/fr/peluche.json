                    "frequency": "Low",
                    "semantic_group_id": "affectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viens ici, ma petite <w>peluche</w>, il est l'heure de rentrer à la maison."
                        },
                        {
                            "text": "Il appelle tendrement son chat adoré sa douce <w>peluche</w> quand il le caresse."
                        }
