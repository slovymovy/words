                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a7de6de8-12ba-35b1-9356-25797155abe3",
                        "entry_id": "0f605a32-0b12-3513-943e-b3052aa2bff2",
                        "glosses": [
                            "Closely united."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7aed644b-1fec-4464-9ec0-f6184d280921",
                                "sense_id": "a7de6de8-12ba-35b1-9356-25797155abe3",
                                "text": "She is so conjunctive to my life and soul / That, as the star moves not but in his sphere, / I could not but by her."
                            }
                        ]
                    }
                ],
