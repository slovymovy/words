                    "frequency": "Middle",
                    "semantic_group_id": "locomotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little dog <w>trotted</w> happily alongside its owner on the path."
                        },
                        {
                            "text": "She had to <w>trot</w> across the terminal to reach her boarding gate on time."
                        }
