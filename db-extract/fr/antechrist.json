                        ]
                    },
                    {
                        "translation_id": "dafd4bae-e0da-4c9b-b821-a9f2d5791f46",
                        "source_entry_id": "245ab50e-470b-33f1-ab83-dac72e7a4111",
                        "source_sense_id": "bf0a39ce-2738-34a9-adbd-f01261e46ca2",
                        "target_lang_word": "антихрист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антихрист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "87475261-545c-3666-8de6-db8a926b8d62",
                                        "entry_id": "f59a5c12-bfcb-3719-807f-f581f4940760",
                                        "glosses": [
                                            "перен., прост. мужской половой член"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b564f29d-d0cc-4b87-be74-d97c902e40e0",
                                                "sense_id": "87475261-545c-3666-8de6-db8a926b8d62",
                                                "text": "Девушки-голубушки, // Не дайте помереть! // Дайте на́ брюхо вскарабкаться, — // Антихриста втереть!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "антихрист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1e8fb2-ba6d-34eb-846d-f02c775c66c0",
                                        "entry_id": "ab707bc4-8194-356a-a61d-6660c15e5937",
                                        "glosses": [
                                            "библейск., религ. человек, противник Иисуса Христа, выдающий себя за Мессию, но имеющий злую сущность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a12e154-1355-40dd-b286-03911573a734",
                                                "sense_id": "0a1e8fb2-ba6d-34eb-846d-f02c775c66c0",
                                                "text": "Более радикальная беспоповщина пошла по направлению, намеченному ещё при жизни протопопа Аввакума; основную мысль, лёгшую в основу её, можно формулировать так: раз антихрист народился и уже царствует на земле (как учил Аввакум), то значит православие утрачено, и на земле нет более ни истинной церкви, ни таинств, нет и не может быть священства, и для общения с Богом не требуется посредничества церкви, а достаточно молитвы и религиозных упражнений."
                                            },
                                            {
                                                "example_id": "772fbc71-39a8-4ab8-9ab3-6e03e0bcf9a3",
                                                "sense_id": "0a1e8fb2-ba6d-34eb-846d-f02c775c66c0",
                                                "text": "И всё это сводится к тому, что антихрист напоследок будет брать мир лестью, а не гонением, «и будет последняя горше первых…»"
                                            },
                                            {
                                                "example_id": "572aeb30-a2a9-4331-a75e-bd04b3327cb1",
                                                "sense_id": "0a1e8fb2-ba6d-34eb-846d-f02c775c66c0",
                                                "text": "Раскол был уходом из истории, потому что историей овладел князь этого мира, антихрист, проникший на вершины церкви и государства. 〈…〉 Уход из государства оправдывался тем, что в нём не было правды, торжествовал не Христос, а антихрист."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49c46336-9158-38c0-9268-6806e43c6d78",
                                        "entry_id": "ab707bc4-8194-356a-a61d-6660c15e5937",
                                        "glosses": [
                                            "перен., бран. человек, совершающий злые и разрушительные поступки, деяния"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0271cce4-25fb-4f5e-a359-ee54613fd526",
                                                "sense_id": "49c46336-9158-38c0-9268-6806e43c6d78",
                                                "text": "— Антихрист ты, дьявол ты этакой; ты меня извести хочешь; ты думаешь, я не вижу, чего ты хочешь, ворище ты треанафемский!"
                                            },
                                            {
                                                "example_id": "a8422fab-0c48-4a00-9fbc-a989aa18a11e",
                                                "sense_id": "49c46336-9158-38c0-9268-6806e43c6d78",
                                                "text": "— Мотри, Мыльников к нему подходит! Ах, пёс, ах, антихрист!.."
                                            },
                                            {
                                                "example_id": "9f76745f-128a-4572-be6e-75c120be6cd2",
                                                "sense_id": "49c46336-9158-38c0-9268-6806e43c6d78",
                                                "text": "Стрелец вскочил, рыча; зашатался и рухнулся с хриплым воем: — Сволочь, антихрист, Иродов сын треклятый! Чего мучишь, анафема?"
                                            },
                                            {
                                                "example_id": "f3dc6175-e03f-4337-9a4d-12f8cd172e59",
                                                "sense_id": "49c46336-9158-38c0-9268-6806e43c6d78",
                                                "text": "«Захарову кровь подсчитываешь, антихрист!» — подумал дед Фишка, дрожа от негодования."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
