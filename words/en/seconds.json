                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was marked as <w>seconds</w>, but I can't find anything wrong with it.",
                            "target_lang_translations": {
                                "ru": "Это было помечено как <w>второй сорт</w>, но я не могу найти в этом никаких изъянов.",
                                "zh": "它被标记为<w>次品</w>，但我没找出任何毛病。"
                            }
                        },
                        {
                            "text": "These towels are sold as <w>seconds</w> because of small stitching errors.",
                            "target_lang_translations": {
                                "ru": "Эти полотенца продаются как <w>второй сорт</w> из-за небольших ошибок в строчке.",
                                "zh": "这些毛巾因为缝线有微小瑕疵而作为<w>二等品</w>出售。"
                            }
                        }
