{
    "word_family": [
        "summon",
        "summons",
        "summoner"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2f882b8-0fc1-3f76-b6f8-bf1aabcd554d",
                    "sense_definition": "The present participle and gerund of <w>summon</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king is <w>summoning</w> his advisors to the castle for an urgent meeting.",
                            "target_lang_translations": {
                                "pl": "Król <w>wzywa</w> swoich doradców do zamku na pilne spotkanie."
                            }
                        },
                        {
                            "text": "She spent the entire afternoon <w>summoning</w> the courage to speak to her boss.",
                            "target_lang_translations": {
                                "pl": "Spędziła całe popołudnie, <w>zbierając</w> odwagę, by porozmawiać ze swoim szefem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "summoning courage",
                        "summoning help"
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma imiesłowu czasu teraźniejszego lub rzeczownik odczasownikowy od czasownika 'wzywać'."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wzywanie",
                                "target_lang_sense_clarification": "ogólne określenie aktu wzywania kogoś"
                            },
                            {
                                "target_lang_word": "przywoływanie",
                                "target_lang_sense_clarification": "w kontekście zbierania sił lub przywoływania kogoś/czegoś"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71b602e9-4aad-3798-980a-62f619f96a81",
                    "sense_definition": "The act of ordering someone to appear or be present.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal <w>summoning</w> required him to testify in court the following week.",
                            "target_lang_translations": {
                                "pl": "Prawne <w>wezwanie</w> wymagało od niego złożenia zeznań w sądzie w następnym tygodniu."
                            }
                        },
                        {
                            "text": "The ritual involved the <w>summoning</w> of ancient spirits from the deep forest.",
                            "target_lang_translations": {
                                "pl": "Rytuał obejmował <w>przywołanie</w> starożytnych duchów z głębi lasu."
                            }
                        }
                    ],
                    "synonyms": [
                        "call",
                        "citation"
                    ],
                    "common_phrases": [
                        "formal summoning"
                    ],
                    "target_lang_definitions": {
                        "pl": "Akt nakazania komuś stawienia się w określonym miejscu lub wezwanie do obecności."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wezwanie",
                                "target_lang_sense_clarification": "oficjalne lub prawne nakazanie stawiennictwa"
                            },
                            {
                                "target_lang_word": "przywołanie",
                                "target_lang_sense_clarification": "w kontekście rytualnym lub magicznym"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}