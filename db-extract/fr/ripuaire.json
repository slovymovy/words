                    {
                        "sense_id": "d53fa411-24fc-3ba7-91c6-82ffe4afe06a",
                        "entry_id": "acf59ae8-88dd-3c79-9040-2ccfe1ba17c4",
                        "glosses": [
                            "Relatif aux peuplades franques établies sur les rives du Rhin avant d’envahir la Gaule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93ab7c2-1910-4907-b9e1-8d4e35e29cac",
                                "sense_id": "d53fa411-24fc-3ba7-91c6-82ffe4afe06a",
                                "text": "Cependant, s’il y a procès, il faut attendre la majorité, d’après cette même loi ripuaire: on sait que c’est la solution du Moyen Age."
                            }
                        ]
                    },
                    {
                        "sense_id": "c25a3042-7f4b-38e6-9c0b-82617872df76",
                        "entry_id": "acf59ae8-88dd-3c79-9040-2ccfe1ba17c4",
                        "glosses": [
                            "Qualifie un ensemble des dialectes franciques encore parlés dans certaines régions rhénanes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a349480-d5a7-44e7-9f0f-a77c623d8e3d",
                                "sense_id": "c25a3042-7f4b-38e6-9c0b-82617872df76",
                                "text": "La limite entre le francique ripuaire et le roman (futur wallon, dialecte français) s'est établie sur le barrage naturel de la grande forêt d'Ardenne, qui isolait les deux groupes."
                            },
                            {
                                "example_id": "61aee0fc-8a4f-40e8-afea-ce4cfad6eb6c",
                                "sense_id": "c25a3042-7f4b-38e6-9c0b-82617872df76",
                                "text": "La langue ripuaire appartient aux langues qui subirent la deuxième mutation consonantique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac9451c4-4213-4d0b-bef5-33dceab68c75",
