                "senses": [
                    {
                        "sense_id": "67537f29-d724-3a4a-a168-80c1d39a69fd",
                        "entry_id": "d739706f-3c0f-386e-8e88-35adac443990",
                        "glosses": [
                            "сделав ошибку в счёте, передать лишние деньги"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "37dd3dad-7655-3ecc-b3a7-6c5720cbc52d",
                        "entry_id": "d739706f-3c0f-386e-8e88-35adac443990",
                        "glosses": [
                            "ошибиться в расчётах, в предположениях"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83e6103c-1b7e-4f15-a251-14337aa4e75d",
                        "source_entry_id": "d739706f-3c0f-386e-8e88-35adac443990",
                        "target_lang_word": "tromper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tromper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70cf6bc3-f98f-3621-b214-ee15eb1bb46c",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "Induire en erreur, par artifice."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2b0ecfc-e651-478b-a321-2135f41c71f7",
                                                "sense_id": "70cf6bc3-f98f-3621-b214-ee15eb1bb46c",
                                                "text": "Delcassé ne mentait pas, mais il lui arrivait de tromper sur ses intentions, sur ses projets. Il trompait par ses silences, il trompait par des flux de paroles derrière lesquels il abritait des desseins patiemment médités."
                                            },
                                            {
                                                "example_id": "2c013180-58a7-4470-bc1f-3d77607e3c71",
                                                "sense_id": "70cf6bc3-f98f-3621-b214-ee15eb1bb46c",
                                                "text": "Les partis les plus austrophiles comprennent qu'ils ont été trompés et protestent vigoureusement. C'est le cas par exemple du Bloc des Gauches du Royaume de Pologne qui est indigné et indique que le pays de Chelm comporte 66 % de Polonais contre 33,8% d'Ukrainiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8449ad-6f9e-3de9-985e-43bd125fac7c",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqn trompe qqn). Abuser de la confiance de quelqu’un."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0614a93a-b405-4743-a994-c8d93bcb5e2b",
                                                "sense_id": "1b8449ad-6f9e-3de9-985e-43bd125fac7c",
                                                "text": "La première, selon le même père, est d’éviter la démangeaison de disputer, et une certaine ostentation puérile de tromper son adversaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed59a90f-77a1-3e39-8451-d6539e650038",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqn trompe qqn). Abuser de la confiance de quelqu’un.",
                                            "Trahir, être infidèle à son partenaire."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79666193-630d-41e9-87f5-f11ed2903263",
                                                "sense_id": "ed59a90f-77a1-3e39-8451-d6539e650038",
                                                "text": "Je ne vous saurois dire lequel étoit le plus aise des deux, ou lui de tromper sa femme ou elle de tromper son mari."
                                            },
                                            {
                                                "example_id": "ef756949-f08a-4f9b-8ad1-176d0e30eef7",
                                                "sense_id": "ed59a90f-77a1-3e39-8451-d6539e650038",
                                                "text": "Malheureusement pour elle, mettant toute son étude à tromper son mari, elle n’était pas assez attentive à tromper ses amants, je veux dire à leur cacher qu’elle les trompait les uns avec les autres."
                                            },
                                            {
                                                "example_id": "04aeb7c0-2bc5-4c9a-ba3f-f51c1ca80997",
                                                "sense_id": "ed59a90f-77a1-3e39-8451-d6539e650038",
                                                "text": "— Tu la trompes, ta femme ?\n— Ça arrive.\n— Et alors ?\n— Ça ne compte pas. C’est le rayon d’à côté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2bb89f-91b1-3c86-ad47-c42fc94302c4",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqn trompe qqc). Utiliser un artifice pour sortir d’une situation. → voir tromper sa faim, tromper l’ennui et tromper le temps"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12a99e66-12f3-4ca1-8c0a-cdf5e80334bd",
                                                "sense_id": "1b2bb89f-91b1-3c86-ad47-c42fc94302c4",
                                                "text": "Peu à peu, avec de l’eau qui désaltère, de la kacha qui trompe sa faim, l’enfant se calme dans les bras de sa nouvelle mère […] sa"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a822166-66dd-39b8-8fc9-e913d2d7a439",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqn trompe qqc). Utiliser un artifice pour sortir d’une situation. → voir tromper sa faim, tromper l’ennui et tromper le temps",
                                            "Décevoir l’attente d’un groupe par un comportement contraire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19b03075-22de-4fb2-972d-bb79e1c8e6a6",
                                                "sense_id": "5a822166-66dd-39b8-8fc9-e913d2d7a439",
                                                "text": "Ce jeune homme n’a point trompé l’attente qu’on avoit de lui : il a surpassé l'attente du public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d2c38e7-54bd-37c9-bfec-070be0da3758",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqc trompe qqn) abuser, provoquer une erreur de jugement, d'appréciation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": ": forme passive de la précédente (qqn est trompé par qqc",
                                        "examples": [
                                            {
                                                "example_id": "4aa6d286-3a19-48bb-8702-dbd14e731342",
                                                "sense_id": "3d2c38e7-54bd-37c9-bfec-070be0da3758",
                                                "text": "Sa tenue trompe, soit-il de peu, alors que sa compétence ne trompe pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e4680b-9474-3284-a24b-d1ae67a627c0",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqc trompe qqc) Déjouer une situation par un artifice, un événement, une action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1f4ce7-d791-4545-8123-801e65a05d14",
                                                "sense_id": "10e4680b-9474-3284-a24b-d1ae67a627c0",
                                                "text": "[…] le Journal des Débats affirme que « la continuation des hostilités a trompé toutes les prévisions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fed528-8700-3eec-8d8f-7e9f41808e1c",
                                        "entry_id": "7a4bd536-340a-3b87-aeb4-80917a8443e1",
                                        "glosses": [
                                            "(forme qqc trompe qqc) Déjouer une situation par un artifice, un événement, une action.",
                                            "Soustraire sa lame à la parade adverse."
                                        ],
