                    "frequency": "Low",
                    "semantic_group_id": "weiterleiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Hausarzt hat den Patienten zur weiteren Diagnostik an das Krankenhaus <w>zugewiesen</w>."
                        },
                        {
                            "text": "Die Behörde <w>weist</w> Geflüchtete nach ihrer Ankunft den verschiedenen Gemeinden <w>zu</w>."
