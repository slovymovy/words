                ],
                "senses": [
                    {
                        "sense_id": "99a1e554-2894-3b47-9e80-61997568d5ed",
                        "entry_id": "886c5861-261b-3fe2-9b3c-ef82aa96cef1",
                        "glosses": [
                            "A point of reference based on the participant's focus, used in generating visual imagery in virtual reality systems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "739e127c-4692-43e6-b836-c4d2f66ffdac",
                                "sense_id": "99a1e554-2894-3b47-9e80-61997568d5ed",
                                "text": "When using specular reflection with smooth shading, HP-PHIGS needs to determine the position of the viewer, or eyepoint."
                            },
                            {
                                "example_id": "8d9cf8f7-81f4-4936-818f-9e046522f5c1",
                                "sense_id": "99a1e554-2894-3b47-9e80-61997568d5ed",
                                "text": "Another source of registration error is viewing error, which is the error in the modeled eyepoint locations."
                            },
                            {
                                "example_id": "6f5e9d4a-3dd6-43d8-9332-5733f7675e62",
                                "sense_id": "99a1e554-2894-3b47-9e80-61997568d5ed",
                                "text": "A single eyepoint for each display system is typical since binocular or stereoscopic display systems are very rarely used in flight simulators."
                            },
                            {
                                "example_id": "c73ba9c0-52ec-482c-a126-5ac6bf724dcd",
                                "sense_id": "99a1e554-2894-3b47-9e80-61997568d5ed",
                                "text": "In order to determine visibility of an object, its location relative to the pilot's eyepoint must be specified."
                            }
                        ]
                    },
                    {
                        "sense_id": "a603d0c9-ce78-37f0-b18a-33c989dd8781",
                        "entry_id": "886c5861-261b-3fe2-9b3c-ef82aa96cef1",
                        "glosses": [
                            "The focal point of an optical lens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "563dadef-716a-47c1-be23-d77754f68ec3",
                                "sense_id": "a603d0c9-ce78-37f0-b18a-33c989dd8781",
                                "text": "The height of the eyepoint depends on the focal length of the eyepiece and the position of its upper equivalent plane."
                            },
                            {
                                "example_id": "58155bc5-ffa0-4876-a315-a7c77ce5e2e2",
                                "sense_id": "a603d0c9-ce78-37f0-b18a-33c989dd8781",
                                "text": "You can locate the eyepoint by directing a pair of binoculars at a bright object while you hold a piece of waxed paper just back of the eyepiece. Move the paper in or out until the images are brightest and sharpest. This is the eyepoint, usually about half an inch (13 millimters) back of the surface of the ocular lens."
                            },
                            {
                                "example_id": "4b64df1f-c97e-4a80-aadf-3e73e18d731e",
                                "sense_id": "a603d0c9-ce78-37f0-b18a-33c989dd8781",
                                "text": "All the rays leaving the eyepiece intersect at the eyepoint or exit pupil (also called Ramsden circle), and it is to this point that the observer's pupil should be brought in order to oversee the entire field of view. The height of the eyepoint diminishes with increasing eyepiece magnification, while its diameter remains fairly constant at 1-1.5 mm."
                            }
                        ]
                    }
                ],
