                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ca2511-ad89-454a-95c4-679b6b50d428",
                                "sense_id": "eae54474-da60-3532-94b8-00a34e068b97",
                                "text": "Autor chrześcijańskiej „Bogurodzicy” jest nieznany."
