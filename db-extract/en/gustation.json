                                                "sense_id": "411177e8-4381-39b1-9b36-81de78936834",
                                                "text": "Ben sadece ballar balından birkaç çeşni sunmaya çalıştım."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e4fd61f-883c-3235-99d5-af3aa4ccae23",
                                        "entry_id": "3a88a806-c7e8-35fa-9dc1-83acc8fa00a2",
