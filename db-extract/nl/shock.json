                                                "example_id": "0090afef-b48e-471d-ac6c-046030f32dd3",
                                                "sense_id": "910b69cc-7573-39fe-b188-bcf4e289975a",
                                                "text": "It takes more than two gigapascals (two billion pascals) of pressure to shock quartz in this manner (for comparison, the atmosphere at sea level exerts a little over 100,000 pascals of pressure)."
                                            }
