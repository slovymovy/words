                        "examples": [
                            {
                                "example_id": "7b734170-08dc-4f0e-847f-7ed1d360de34",
                                "sense_id": "0f8e7ed7-db1b-3140-9357-14466d1f8603",
                                "text": "De sikhtempel in de Amerikaanse staat Wisconsin waar zondag zes mensen werden doodgeschoten is weer open. Inderjeet Singh Dhillon, een van de leiders van de tempel, zei dat de FBI de sleutels van het gebouw donderdagochtend heeft teruggegeven."
                            },
                            {
                                "example_id": "1bd1a939-906a-4261-9d5a-99c4dca6232c",
                                "sense_id": "0f8e7ed7-db1b-3140-9357-14466d1f8603",
                                "text": "Drie 17-jarige jongens zijn vandaag door een rechtbank in het Duitse Essen veroordeeld tot gevangenisstraffen van zes tot zeven jaar vanwege de bomaanslag op een sikhtempel in april vorig jaar. Door de aanslag raakten drie mensen gewond en werd voor 135.000 euro schade aangericht."
                            }
                        ]
