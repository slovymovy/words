                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fdf755a-ff02-3d11-8759-85e1cc30cddc",
                                        "entry_id": "359255f2-b067-38ce-b2ce-52058f3eebe1",
                                        "glosses": [
                                            "Alternative form of corpulence."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d4656db-c9ff-4b4f-a6ab-049ba45da0b3",
                                                "sense_id": "2fdf755a-ff02-3d11-8759-85e1cc30cddc",
                                                "text": "the heaviness and corpulency of the water requiring a great force to divide it"
                                            },
                                            {
                                                "example_id": "6ec6018a-9e17-471b-932d-07b7c24a523b",
                                                "sense_id": "2fdf755a-ff02-3d11-8759-85e1cc30cddc",
                                                "text": "His person was large, robust, I may say approaching to the gigantic, and grown unwieldy from corpulency."
                                            },
                                            {
                                                "example_id": "53dd43b5-f09b-4e3c-afc0-5094af058e78",
                                                "sense_id": "2fdf755a-ff02-3d11-8759-85e1cc30cddc",
                                                "text": "No man, however indulgent (as I am) to corpulency, ever worshipped a man as round as the sun or a woman as round as the moon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
