                    {
                        "sense_id": "7c184cb9-887c-388a-a44d-1953fad84e18",
                        "entry_id": "8bb53405-1461-3a22-b876-c978f0da5855",
                        "glosses": [
                            "meervoud van het zelfstandig naamwoord rok"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c5124931-663c-4200-83e9-d3f5d51996e0",
                                "sense_id": "7c184cb9-887c-388a-a44d-1953fad84e18",
                                "text": "Voor zover haar rokken het toelaten, haast ze zich door de gang, maar ondertussen begint ze weer te denken als een klein kind."
                            },
                            {
                                "example_id": "50267f8e-fcdd-410d-b5b0-22ebbadca060",
                                "sense_id": "7c184cb9-887c-388a-a44d-1953fad84e18",
                                "text": "In een wolk van zware bloemengeuren zweeft Agnes in haar volumineuze, zwarte rokken over de ijskoude grafstenen."
                            },
                            {
                                "example_id": "a4aaf4d8-6428-432a-b1f0-f0b9f956fc9c",
                                "sense_id": "7c184cb9-887c-388a-a44d-1953fad84e18",
                                "text": "Dhana jankt en probeert onder Nella's rokken te kruipen."
                            }
                        ]
                    }
                ],
