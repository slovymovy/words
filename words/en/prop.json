                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stuck a block of wood under it as a <w>prop</w>.",
                            "target_lang_translations": {
                                "ru": "Они подсунули под него деревянный брусок в качестве <w>подпорки</w>."
                            }
