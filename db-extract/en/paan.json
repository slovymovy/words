                "entry_id": "7c83048e-19ca-3496-a054-b7edae8ed025",
                "word": "paan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "53e42eee-3721-45a1-9362-6d295ac9439e",
