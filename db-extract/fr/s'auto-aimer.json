                ],
                "senses": [
                    {
                        "sense_id": "d042e945-596b-353f-9a1c-412087ed135e",
                        "entry_id": "febb66e5-02c7-3a86-bbce-c79b45c9c893",
                        "glosses": [
                            "S’aimer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f6b215-ff6c-4b83-b62e-c6cf26ca6978",
                                "sense_id": "d042e945-596b-353f-9a1c-412087ed135e",
                                "text": "Être un adulte se caractérise par une autonomie émotive, ce qui signifie que nous devenons notre propre parent pour s’auto-encourager, s’auto-rassurer, s’auto-aimer et s’auto-consoler."
                            },
                            {
                                "example_id": "199d0f47-c42e-4a69-9f22-33ba200efbaa",
                                "sense_id": "d042e945-596b-353f-9a1c-412087ed135e",
                                "text": "S’agit de \"s’auto-aimer\" quand on est en bonne santé, et de se détester quand on souffre?"
                            },
                            {
                                "example_id": "4e914fa3-8665-408d-a184-b298dd38e061",
                                "sense_id": "d042e945-596b-353f-9a1c-412087ed135e",
                                "text": "Elle va donc apprendre à s’auto-aimer, s’auto-reconnaître, étape incontournable pour construire une bonne estime de soi, pour se construire."
                            }
                        ]
                    }
