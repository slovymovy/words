                        "glosses": [
                            "техн. самозакрывающаяся заслонка в трубопроводах, позволяющая пропускать газообразные или жидкие вещества только в одном направлении"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39122397-4c70-3261-9d5f-d71a5f3b0c23",
