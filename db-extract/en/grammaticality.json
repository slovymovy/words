                        "source_entry_id": "52581740-1e85-3c9f-9304-6b0d7a3d22b3",
                        "source_sense_id": "25a98627-61ce-3ec0-bed3-b5eb89c58378",
                        "source_sense_description": "state of obeying the rules of grammar",
                        "target_lang_word": "Grammatikalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grammatikalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                        "entry_id": "8117f343-3045-387e-b755-ab90c4729010",
                                        "glosses": [
                                            "die grammatische Korrektheit/Wohlgeformtheit eines sprachlichen Ausdrucks; die Eigenschaft, den grammatischen Regeln zu entsprechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e1f45f-477d-4a35-add2-0f9767b70a18",
                                                "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                                "text": "Ich bezweifle die Grammatikalität dieses Satzes."
                                            },
                                            {
                                                "example_id": "48dfb288-5ab4-4f69-9828-af0b680ad338",
                                                "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                                "text": "„Grammatikalität und Akzeptabilität: Die Grammatikalität von Sätzen ergibt sich aus den durch die Regeln der Grammatik definierten Wohlgeformheitsbedingungen der Sätze einer Sprache.“"
                                            },
                                            {
                                                "example_id": "a4de1e7f-c467-473f-93cb-f6672124a46c",
                                                "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                                "text": "„Betrachtet man nun die Fälle näher, bei denen durch Streichen einer Konstituente die Grammatikalität des Ausdrucks nicht gefährdet wird, so erweisen sich diese als uneinheitlich.“"
                                            },
                                            {
                                                "example_id": "626b442f-ba27-4791-910b-9180d309c32d",
                                                "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                                "text": "„Es zeigt sich unter anderem weiterhin (…), daß Kinder die phonologische Grammatikalität unterschiedlicher Mischformen selbst dann beurteilen können, wenn sie selbst gar nicht oder nur in sehr geringem Maße zwischen diesen Mischformen variieren.“"
                                            },
                                            {
                                                "example_id": "764ecf87-0928-4614-85fb-e95341dde549",
                                                "sense_id": "ee916ed5-913b-397d-a85a-7c7f9d3e8c49",
                                                "text": "„Das notwendige Auftreten der Ergänzungen im Satzbauplan bezieht sich auf die Grammatikalität, nicht auf die Aussageabsicht oder die subjektive Wichtigkeit der Mitteilung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
