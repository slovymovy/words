                                    {
                                        "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                        "entry_id": "0e7426de-d4bd-3af5-961c-820bf01577ed",
                                        "glosses": [
                                            "überschwängliches Lob in unangemessener oder übertriebener Weise (meist um sich einzuschmeicheln)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c302084b-1310-4332-84b0-f6a1e273a505",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Ich wunderte mich über die ganze Lobhudelei in Zeitung und Fernsehen."
                                            },
                                            {
                                                "example_id": "055937f4-f249-4c69-94a8-413fc9c152b1",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Bei seiner Verabschiedung vom öffentlichen Amt gab es die übliche Lobhudelei."
                                            },
                                            {
                                                "example_id": "91386eb1-6d63-4e7f-b6e6-23ec192f6f38",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Eine Lobhudelei kann ganz schön schmeicheln."
                                            },
                                            {
                                                "example_id": "aa27878b-a545-4cd9-b9b2-9f46ddac2210",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "[Dem Kosmonauten Siegmund Jähn] selbst war die Lobhudelei eher zuwider, er blieb bescheiden und bodenständig."
                                            },
                                            {
                                                "example_id": "de24a89a-f01e-46f5-ba88-ea5c67545cf8",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "„[Die Medien ud der Hof] haben ihm wirklich immer nur Lobhudeleien ins Ohr geflüstert, so dass der Schah irgendwann von seiner eigenen Größe derart überzeugt war, dass er die tatsächlichen Verhältnisse vollkommen verkannt hat.“"
                                            },
                                            {
                                                "example_id": "0593819d-85d2-4c50-be0d-dbb16642003c",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "„Überschwänglich - und vielleicht ein wenig zu heftig - klopft der gemütliche Inder dabei seinem ivorischen Kollegen auf Schulter. Dem ist die ganze Lobhudelei offensichtlich ein wenig unangenehm.“"
                                            },
                                            {
                                                "example_id": "51b23d06-2e53-40cc-9c3c-3cbe1f2d944c",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "[Im US-Fernsehen] hält Demi Moore eine Rede über ihren Ex-Mann [Bruce Willis]. Von Laudatio oder Lobhudelei keine Spur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "267ce780-8c42-4474-b2d7-7d82dc98a415",
                        "source_entry_id": "0bdbb772-197a-32b0-9eda-0f236326bff2",
                        "source_sense_description": "fulsome public praise",
                        "target_lang_word": "überschwängliches Lob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "187624aa-9221-49d0-92d2-624858a4f6fd",
                        "source_entry_id": "0bdbb772-197a-32b0-9eda-0f236326bff2",
                        "source_sense_description": "fulsome public praise",
                        "target_lang_word": "Lobeshymne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lobeshymne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                        "entry_id": "5146a2d2-99ed-34fb-a979-d2ee51c7d345",
                                        "glosses": [
                                            "extremes Lob, in der Öffentlichkeit geäußert, manchmal auch ironisch gemeint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc61bfa9-4b42-4aba-a581-8d264533f633",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Mit 24 Jahren wird der russische Pianist [Igor Levit] bereits als Weltstar von morgen gefeiert, die Kritiker ergehen sich in Lobeshymnen."
                                            },
                                            {
                                                "example_id": "3c0f417b-3cff-46c9-9ac1-e80912b91d6e",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "[…] eine schlichte Rezension [genügt] natürlich nicht. Es muss eine Lobeshymne werden. Sonst wird der Verfasser böse. Wehe gar, man verreißt sein Werk."
                                            },
                                            {
                                                "example_id": "b44be7b3-d3cb-4228-94e7-72177bc29ba3",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Nicht nur der Literaturkritiker James Wood veröffentlichte im New Yorker eine Lobeshymne, auch die Pulitzerpreisträgerin Elizabeth Strout begeisterte sich für [den Autor/die Autorin Elena] Ferrante, ebenso wie Oprah Winfrey."
                                            },
                                            {
                                                "example_id": "b8ad3470-b6ff-4d5c-90ad-60d8a4aff16c",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Es steckte ein wenig Koketterie, aber auch viel Wahrheit in der Lobeshymne, die Ronaldo später auf seine Kollegen anstimmte. „Die Mannschaft hat überragend gespielt“, sprach der Mann des Abends. „Ich musste dann nur noch die drei Tore machen.“"
                                            },
                                            {
                                                "example_id": "95084942-63df-41fb-9780-ccc1f6a6a16c",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Der 1943 in New York geborene Darsteller [Robert De Niro] hat in seiner Karriere so viele meisterliche Auftritte vor den Kameras abgeliefert, so viele Lobeshymnen eingeheimst und so viele Preise gewonnen, dass man um De Niro bei einer Auflistung der besten Kinodarsteller aus Amerika keinesfalls herumkommen würde."
                                            },
                                            {
                                                "example_id": "31f5f986-a85c-42dc-bf54-3c41f9c789e7",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Die überschwänglichsten, unwirklichsten Lobeshymnen habe ich im Ausland bekommen […] für unser ganzes Land. Ja, für unsere ach so deutschen Tugenden. […] Ihr Deutschen seid ja so pünktlich. Ihr seid zuverlässig. Ihr vertragt euch mit der Umwelt, seid weltoffen, fleißig, sparsam, seid zuverlässig und könnt gut wirtschaften. Außerdem sei die deutsche Verwaltung ein Ausbund an Effizienz und Bürgerfreundlichkeit."
                                            },
                                            {
                                                "example_id": "d8d734e7-5388-4afc-9e13-9ad5a12254c9",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Auf [den Trainer von Schalke 04] Domenico Tedesco werden seit dem historischen 4:4 im Derby bei Borussia Dortmund Lobeshymnen gesungen. Zurecht, denn der zweitjüngste Trainer der Bundesliga reagierte auf die \"Hölle\" mit strategischer Intelligenz. Nachdem die Schalker zur Halbzeit scheinbar aussichtslos mit 0:4 zurücklagen, stellte er sein Team zunächst um und zeigte ihm dann trotz der katastrophalen Lage einen Weg des \"Gewinnens\" auf."
                                            },
                                            {
                                                "example_id": "416724e3-aac0-48ff-86be-93a278c4b6ef",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Ich glaube, wir können keine Lobeshymne auf das deutsche Schulwesen anstimmen, die Ergebnisse sind zu dürftig. Aber sollte das nicht eine reiche Gesellschaft, die sich selbst als \"Volk der Dichter und Denker\" bezeichnet?"
                                            },
                                            {
                                                "example_id": "57ef1910-cba2-4147-baee-31402b1d8fb8",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Sehr komisch, tolle Essays zuhauf, kein Stilgefühl: Die Feuilletons begehen den 90. Geburtstag Martin Walsers. Zu uneingeschränkten Lobeshymnen auf den Schriftsteller können sich jedoch die wenigsten durchringen."
                                            },
                                            {
                                                "example_id": "190acfc7-040b-413c-891a-2eb1b263e94d",
                                                "sense_id": "417f8578-bf98-3565-9ef6-0dee06672a74",
                                                "text": "Nach der vorgeschriebenen Bracha (Segensspruch) wird noch der aus dem Morgengebet des Schabbattages bekannte Pijut K’el Adon gesprochen. Diese Lobeshymne ist in alphabetischen Sätzen verfasst, „in denen das Schöpfungswerk der einzelnen Tage verherrlicht wird“, wie es Rabbiner Ismar Ellbogen formulierte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
