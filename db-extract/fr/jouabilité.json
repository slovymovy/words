                                            {
                                                "example_id": "f2f44ab5-c4f8-4adb-8920-aa2984facb92",
                                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                                "text": "„Game-Designer entwerfen das Gameplay, die Spielmechanik, indem sie Regelsysteme erdenken und gestalten, die für die Spieler zu sinnträchtigen Erfahrungen werden.“"
                                            },
                                            {
                                                "example_id": "e5349830-108d-48e4-8a16-50bfa5569bbe",
                                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                                "text": "„Smartphones sind ideale Gaming-Maschinen – vor allem, da Sie [sic] eine Vielzahl an Zusatzfunktionen mitbringen, die sich in das Gameplay integrieren lassen.“"
                                            },
                                            {
                                                "example_id": "1f769472-689e-4eaf-9715-e04a6c3e8ac7",
                                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                                "text": "„Sobald vermehrt oder sogar übermäßig Werbung in Computerspielen platziert wird und das Spielgeschehen dadurch unterbrochen, gestört oder das Gameplay offensichtlich verlangsamt wird, sind Gerichtsurteile und gesetzliche Regelungen zum In-Game Advertising zu erwarten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "040282c4-339e-4717-8498-315d21776ee2",
                        "source_entry_id": "91068f8e-0014-3a04-a23f-3b5e242fcb1a",
                        "source_sense_id": "c6515762-6066-31d9-bec5-5ffb6b88cafb",
                        "source_sense_description": "Spiel, speziell Videospiel: Spielspaß",
                        "target_lang_word": "Spielspaß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spielspaß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00f18346-f53f-3142-a4ad-f108bf074b52",
                                        "entry_id": "b30465ce-e6d0-3aac-9c90-6574ba70befe",
                                        "glosses": [
                                            "Freude an Simulationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64de46c1-17c0-416f-b38e-f037fd4bc9d9",
                                                "sense_id": "00f18346-f53f-3142-a4ad-f108bf074b52",
                                                "text": "„Computerspielen mangelt es an Esprit: Grafik und Sound stehen im Vordergrund statt Story und Spielspaß.“"
                                            },
                                            {
                                                "example_id": "adda9187-406d-40d7-a170-a4e6c81f8785",
                                                "sense_id": "00f18346-f53f-3142-a4ad-f108bf074b52",
                                                "text": "„Minimalistische Games sprechen eine ohnehin gestresste Zielgruppe an – und versprechen Spielspaß ohne Kopfschmerzen.“"
                                            },
                                            {
                                                "example_id": "29290cb4-da85-4286-9761-fbab4e261091",
                                                "sense_id": "00f18346-f53f-3142-a4ad-f108bf074b52",
                                                "text": "„Die Erwartungsnutzentheorie kann beliebig auf nichtmonetäre Dimensionen erweitert werden wie Überraschung, Neugier, Spannung oder den Spielspaß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
