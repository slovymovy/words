                "senses": [
                    {
                        "sense_id": "57de4071-dfe0-3524-8d67-4e8d4fffe8d9",
                        "entry_id": "9dfa0e41-f920-3f5e-b624-8bf0fc8a4063",
                        "glosses": [
                            "Analyse des Kapitalismus, besonders im Rahmen der marxistischen Analyse der bürgerlichen Produktionsweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30b5e5a9-12b5-48b2-a2fe-05d33cc0b8fc",
                                "sense_id": "57de4071-dfe0-3524-8d67-4e8d4fffe8d9",
                                "text": "In Max Webers Kapitalismusanalyse ist das Konzept der protestantischen Ethik zentral."
                            },
                            {
                                "example_id": "ee6f026d-04e1-4070-a231-d7a6817d576e",
                                "sense_id": "57de4071-dfe0-3524-8d67-4e8d4fffe8d9",
                                "text": "Marx' Kapitalismusanalyse betrachtet die bürgerliche Gesellschaft als eine in zwei große Klassen gespaltene."
                            },
                            {
                                "example_id": "353cacf7-0f64-4c33-b2aa-f67e8ed74d5f",
                                "sense_id": "57de4071-dfe0-3524-8d67-4e8d4fffe8d9",
                                "text": "Die Kapitalismusanalyse des Minenbesitzers beschränkte sich ausschließlich auf seine eigenen wirtschaftlichen Interessen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
