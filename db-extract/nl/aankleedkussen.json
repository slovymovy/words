                        "examples": [
                            {
                                "example_id": "be3039b3-047f-4d4b-81d4-27000ef7a712",
                                "sense_id": "7eb3ab57-b4d6-3a74-8365-809e9daf1524",
                                "text": "Virussen worden volgens Bont het vaakst overgedragen tussen broertjes en zusjes. De professor adviseert daarom om oppervlaktes van bijvoorbeeld de box en het aankleedkussen regelmatig te reinigen. \"Het virus kan nadat het het lichaam heeft verlaten op gladde oppervlaktes tot zes uur overleven.\""
                            },
                            {
                                "example_id": "102a7322-3dc6-4e32-8a8e-51acbfe7e526",
                                "sense_id": "7eb3ab57-b4d6-3a74-8365-809e9daf1524",
                                "text": "Je ziet het steeds vaker: ondernemers die na een diefstal een oproep op Facebook doen. Dat zo'n oproep zin heeft, bewijst kinderwinkel MOOS Kids in Deventer. Nadat daar een hoes van een aankleedkussen van het populaire merk Koeka gestolen werd, plaatste de eigenaresse een bericht op Facebook met de vraag of de baby van de dievegge graag verschoond zou worden óp een hoes die haar moeder gestolen heeft'."
                            }
