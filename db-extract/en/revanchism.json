                                        "entry_id": "f7a17a08-6a0c-36e2-8626-6094e4b1a379",
                                        "glosses": [
                                            "stroming die revanche nastreeft na een verloren oorlog"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3c0a0a-0be0-4e2c-8294-66f30d41b17c",
                                                "sense_id": "99931b18-b605-302b-b5ea-02b34412d4e8",
                                                "text": "In Duitsland was sprake van revanchisme na het Duitse verlies in de Eerste Wereldoorlog (1914-1918). De roep om wraak ging hier uit van verschillende partijen, met name van de NSDAP. Als voornaamste figuur van het Duitse revanchisme geldt Adolf Hitler, rijkskanselier en leider (\"Führer\") van Duitsland van 1933 tot 1945"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
