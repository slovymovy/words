                        "source_sense_id": "aa002085-6bc2-3aa5-a324-e2c57033763b",
                        "source_sense_description": "Haus, in dem Geburten von Hebammen betreut werden",
                        "target_lang_word": "maison de naissance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maison de naissance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3eadf2d-f9e8-3653-a75d-e8a6c5882165",
                                        "entry_id": "e7de9eaf-e9e7-3d4f-9f5b-f6600ac2f4d8",
                                        "glosses": [
                                            "Lieu de suivi de grossesse et d’accouchement placé sous la responsabilité exclusive de sages-femmes, à la différence des maternités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294c4815-c585-4904-9587-c1e3f0564e96",
                                                "sense_id": "b3eadf2d-f9e8-3653-a75d-e8a6c5882165",
                                                "text": "Ni perfusion, ni péridurale, ni médecins. En France, huit maisons de naissance expérimentent le retour à l’accouchement naturel."
                                            },
                                            {
                                                "example_id": "e4502fed-a509-45bd-959a-cde04a3bd811",
                                                "sense_id": "b3eadf2d-f9e8-3653-a75d-e8a6c5882165",
                                                "text": "Si elles existent depuis longtemps chez nos voisins d'Europe, les maisons de naissance sont toujours au cœur d'un débat politique et médical en France."
                                            },
                                            {
                                                "example_id": "fa8d89e2-1a11-424c-83e8-ed810eeba50c",
                                                "sense_id": "b3eadf2d-f9e8-3653-a75d-e8a6c5882165",
                                                "text": "Les maisons de naissance proposent aux parents de mettre au monde leur bébé autrement. Des lieux chaleureux avec parfois des ateliers d’écriture, où chacun peut se raconter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
