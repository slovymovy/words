                ],
                "senses": [
                    {
                        "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                        "entry_id": "5a87ae8c-cb86-3d5f-a7b6-328324195ab4",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "871ab773-47b4-45a2-a342-b9363c1303f3",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Frau Schaul ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "972d57fe-11f9-490e-82c2-984b031028f0",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Herr Schaul wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0581c86c-1705-4db1-b08f-bbf81859d56e",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Die Schauls fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "e8ea1074-e5d5-4a8e-86c4-1a6214bb830f",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Der Schaul trägt nie die Pullover, die die Schaul ihm strickt."
                            },
                            {
                                "example_id": "b1114533-cb26-4158-afd8-d8df93a3991c",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schaul kommt, geht der Herr Schaul.“"
                            },
                            {
                                "example_id": "3390d14f-9bc1-40c4-b40a-72860d9eecf3",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Schaul kommt und geht."
                            },
                            {
                                "example_id": "b44a30db-2b37-4cf8-949d-26bf420736fb",
                                "sense_id": "fda70b2c-4ecf-3054-a417-8d7d88a6aca0",
                                "text": "Schauls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
