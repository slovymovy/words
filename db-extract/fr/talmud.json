                        ],
                        "form": "talmuds"
                    },
                    {
                        "form_id": "1d182614-fc46-40d3-93cf-60c9fd7e79e0",
                        "entry_id": "d8815964-c7dc-3185-9262-0ca192fcff2a",
                        "tags": [],
                        "form": "Talmud"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37ab933e-8c37-335d-8043-01f669449ae9",
                        "entry_id": "d8815964-c7dc-3185-9262-0ca192fcff2a",
                        "glosses": [
                            "Livre qui contient la loi orale, la doctrine, la morale et les traditions des juifs."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "0613cb68-d86f-43cd-93dd-5a38a557364f",
                                "sense_id": "37ab933e-8c37-335d-8043-01f669449ae9",
                                "text": "Or, c'était fête à la synagogue, ténébreusement étoilée de lampes d'argent, et les rabbins, en robes et en lunettes, baisaient leurs talmuds, marmottant, nasillonnant, crachant ou se mouchant, les uns assis, les autres non."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a31defb-d45b-4d68-99de-0f7520b9c0bd",
                        "source_entry_id": "d8815964-c7dc-3185-9262-0ca192fcff2a",
                        "source_sense_id": "37ab933e-8c37-335d-8043-01f669449ae9",
                        "target_lang_word": "Talmud",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Talmud",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b1db0b2-d116-37d1-801b-07839c02191b",
                                        "entry_id": "01ff85d2-7797-39a3-a757-75c39c616640",
                                        "glosses": [
                                            "nachbiblisches Hauptwerk des Judentums in Form einer Schriftensammlung, entstanden in mehrhundertjähriger mündlicher und schriftlicher Überlieferung, bestehend aus der »Mischna« (Rechtssammlung in Hebräisch) und der auf ihr aufbauenden »Gemara« (Diskussion und Kommentar in Aramäisch) – das Werk liegt in zwei Fassungen vor, der des älteren Jerusalemer beziehungsweise palästinischen Talmuds und der des umfangreicheren und verbindlicheren babylonischen Talmuds"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30f3ae66-83fd-4544-b310-e2c6dbcb0cfa",
                                                "sense_id": "0b1db0b2-d116-37d1-801b-07839c02191b",
                                                "text": "„Dem Mitherausgeber der kritischen Kafka- Ausgabe Jost Schillemeit war vor allem im Prozess- Roman «diese ständige Wiederholung des Gleichen ohne jeden sichtbaren Fortschritt, dieses Auf-der-Stelle-Treten» aufgefallen; hier im Talmud finden wir – fand Kafka – genau dasselbe: ständige Wiederholungen gleicher oder ähnlicher Sätze oder Satzteile, unterschiedliche Lösungen der Fragen, die in ihrer Widersprüchlichkeit vorgetragen werden ohne dass ein Ende gefunden wurde. Ob Kafka in seiner Schreibweise durch den Talmud bestärkt wurde, bleibt allerdings eine Entscheidung jedes Interpreten.“"
                                            },
                                            {
                                                "example_id": "52d8b12a-43b0-407e-8792-c72a5c9aa126",
                                                "sense_id": "0b1db0b2-d116-37d1-801b-07839c02191b",
                                                "text": "„Der Exodus der Juden aus Mesopotamien, deren Präsenz dort bis zur Zerstörung des ersten Tempels im Jahre 587 v. Chr. zurückreicht, wäre noch zu Beginn des 20. Jahrhunderts undenkbar gewesen. Hier ist der Talmud entstanden, wurden jüdische Gesetze abgefasst.“"
                                            },
                                            {
                                                "example_id": "83237619-4aa3-41b0-8ced-8e9845f8ec5d",
                                                "sense_id": "0b1db0b2-d116-37d1-801b-07839c02191b",
                                                "text": "„Er glaubte nicht an den Pentateuch, war aber der Meinung, daß Gott im Talmud gegenwärtig sei.“"
                                            },
                                            {
                                                "example_id": "13d26277-660b-4574-955f-ec8f846a72bf",
                                                "sense_id": "0b1db0b2-d116-37d1-801b-07839c02191b",
                                                "text": "„Das strenge Studium des Talmuds führt dazu, dass immer wieder die Grenzen der Gebote und Verbote ausprobiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "630e4144-6beb-3b96-9bd8-56c82cb73624",
                                        "entry_id": "01ff85d2-7797-39a3-a757-75c39c616640",
                                        "glosses": [
                                            "Exemplar des unter [1] beschriebenen Werks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec25836-43fd-40af-b4d8-be90071cc6d9",
                                                "sense_id": "630e4144-6beb-3b96-9bd8-56c82cb73624",
                                                "text": "„In diesen beiden hebräisch durchmischten aramäischen Dialekten sind auch die beiden Talmude, der Jerusalemer und der babylonische, niedergelegt.“"
                                            },
                                            {
                                                "example_id": "be41916c-07fb-421e-a03c-c3364d5a4ed7",
                                                "sense_id": "630e4144-6beb-3b96-9bd8-56c82cb73624",
                                                "text": "„Unter der geistigen Führerschaft der ‚Rabbinen‘, der selbst ernannten Elite des Judentums, entstanden Werke, die bis in die Gegenwart das Selbstverständnis des Judentums prägen sollten – als das bekannteste und einflussreichste der Talmud oder genauer die beiden Talmudim: der palästinensische und der babylonische Talmud.“"
                                            },
                                            {
                                                "example_id": "7fa2648c-24bd-40de-82af-88ba8b2c3720",
                                                "sense_id": "630e4144-6beb-3b96-9bd8-56c82cb73624",
                                                "text": "„Der (auch fiskalisch motivierte) zunehmende Antijudaismus gipfelt 1242 im Autodafé von 24 Wagenladungen Talmuden und 1290 in der Verbrennung des der Hostienschändung bezichtigten «Juif Jonathas».“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f22215e1-b039-4afd-a56d-3c236ae18e71",
                        "source_entry_id": "d8815964-c7dc-3185-9262-0ca192fcff2a",
                        "source_sense_id": "37ab933e-8c37-335d-8043-01f669449ae9",
