                                        "sense_id": "850928f5-68e2-38ac-9041-ed975476b711",
                                        "entry_id": "d209eb10-03b5-3fdf-8bf6-d8b01d17268e",
                                        "glosses": [
                                            "Remplacer une surface préalablement évidée par une autre composée de petits matériaux taillés."
