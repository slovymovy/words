                                "sense_id": "f1afaed4-fac2-3c5a-aac8-7270aa716020",
                                "text": "отде́латься о́бщими фра́зами (от)",
                                "translation": "to talk one's way out (of)",
                                "english": "to talk one's way out (of)"
                            },
                            {
                                "example_id": "704e108f-455a-45ad-8a6e-8002f936e755",
                                "sense_id": "f1afaed4-fac2-3c5a-aac8-7270aa716020",
                                "text": "отде́латься отгово́рками",
                                "translation": "to get away with excuses; get away with irrelevant comments; dodge the question; give the runaround",
                                "english": "to get away with excuses; get away with irrelevant comments; dodge the question; give the runaround"
                            }
                        ]
                    },
                    {
