                        "entry_id": "57365ecc-ee58-3c2c-b5ae-778032bb2d95",
                        "glosses": [
                            "The quality of having great value or price."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b1c706f4-c41d-4274-b11e-2e071a1c6c5c",
                                "sense_id": "614855ed-80c1-3fbe-b161-9ed4356721b7",
                                "text": "But brothers pass not into noble friendships upon the stock of that relation: they have fair dispositions and advantages, and are more easy and ready to ferment into the greatest dearnesses, if all things else be answerable."
                            }
                        ]
                    }
                ],
                "translations": [
