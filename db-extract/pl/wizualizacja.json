                    {
                        "translation_id": "f5840a7f-0a1f-430c-ac81-ff37a29daacc",
                        "source_entry_id": "19af77b6-af62-3187-a9fc-2ef3f99967ef",
                        "source_sense_id": "d1209150-83c1-355d-937c-e1ead2ca0a6d",
                        "target_lang_word": "визуализа́ция",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "визуализа́ция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "021b5f9b-60cb-336c-b3af-15d19cbbcb87",
                                        "entry_id": "f434e667-89c8-3167-8ce4-7b1a6dc46f11",
                                        "glosses": [
                                            "книжн. действие по значению гл. визуализовать; представление чего-либо (физического процесса, явления, базы данных и т. п.) в форме, удобной для наблюдения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f38407-e1be-4a12-95f5-14432eb204d3",
                                                "sense_id": "021b5f9b-60cb-336c-b3af-15d19cbbcb87",
                                                "text": "Визуализация результатов мониторинга и анализа происходит на территориальных картах, календарных планшетах, событийных «деревьях», матрицах ссылок, финансовых схемах, что дает возможность пользователям принимать превентивные меры."
                                            },
                                            {
                                                "example_id": "8b6566e0-8d8c-41ed-a141-6699e4ba6dd5",
                                                "sense_id": "021b5f9b-60cb-336c-b3af-15d19cbbcb87",
                                                "text": "В этой лаборатории множество пакетов и мощный вычислитель с очень большим хранилищем данных и схемой визуализации, которая превращает вычисления либо в трехмерные цветные картинки, либо в мультики, т.е. графики, развернутые во времени."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e94d757-0c36-3381-9a3e-5ba7b279dcab",
                                        "entry_id": "f434e667-89c8-3167-8ce4-7b1a6dc46f11",
                                        "glosses": [
                                            "результат такого действия (схема, диаграмма, график, план и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76085639-45a2-4de3-8014-cfac27d98538",
                                                "sense_id": "4e94d757-0c36-3381-9a3e-5ba7b279dcab",
                                                "text": "По словам Стефена Хьюджеса, руководителя исследовательской группы, компьютерная визуализация доказала, что тело Джени пребывает «в изумительной сохранности»; большую часть существенных деталей вообще невозможно было бы установить без современной техники."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
