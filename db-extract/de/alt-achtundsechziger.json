                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe229e8-b08f-45fa-9ec1-f2fb7a57456e",
                        "source_entry_id": "8ffb2164-04c3-38ff-aa5c-8fd7ad708f94",
                        "source_sense_id": "c21f2928-a769-3209-8c4a-58c8cd264e39",
                        "source_sense_description": "ehemaliger Teilnehmer oder geistiger Sympathisant der Achtundsechziger-Bewegung",
                        "target_lang_word": "soixante-huitard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soixante-huitard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e543d37f-d142-34ec-9625-c2131912afb0",
                                        "entry_id": "855cba79-9a55-3830-8ac3-8bafed3cfee8",
                                        "glosses": [
                                            "Relatif aux événements de mai 1968 ou aux idées exprimées à cette occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e4dc65-d42b-41d1-90b6-6dfbac787385",
                                                "sense_id": "e543d37f-d142-34ec-9625-c2131912afb0",
                                                "text": "Le troisième homme a le visage plus flou, porte un pantalon de velours, un pull rouge, vaguement soixante-huitard."
                                            },
                                            {
                                                "example_id": "cfab108c-5bba-424f-8fb2-efaaf7cca067",
                                                "sense_id": "e543d37f-d142-34ec-9625-c2131912afb0",
                                                "text": "Les amis ex-soixante-huitards de maman me font bien rigoler avec leurs souvenirs émoustillés de pétards et de pipes tchétchènes."
                                            },
                                            {
                                                "example_id": "33a2c7ca-de2c-44c4-9352-010441603ca1",
                                                "sense_id": "e543d37f-d142-34ec-9625-c2131912afb0",
                                                "text": "Une autre phase de l’histoire du mouvement soixante-huitard s’engage, qui va aboutir à sa pacification et à sa transformation, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soixante-huitard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "610d35b3-5954-3333-b5d0-f4e22ed3d564",
                                        "entry_id": "30294653-9a65-3227-8cb8-1be488947034",
                                        "glosses": [
                                            "Homme qui a vécu les événements de mai 1968."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3330d8fa-f661-4b73-9547-51a2d7093c98",
                                                "sense_id": "610d35b3-5954-3333-b5d0-f4e22ed3d564",
                                                "text": "Comme pour la définition de Mai 68, encore faudrait-il s'entendre sur ce qu'on entend par soixante-huitards. S'agit-il de la liste des vingt personnes que dressent les journaux à chaque commémoration ou des dizaines de milliers de jeunes qui ont participé aux évènements de Mai 68 ? Cela change la perspective."
                                            },
                                            {
                                                "example_id": "4c8fc200-051f-4a74-9eb8-029edad808dc",
                                                "sense_id": "610d35b3-5954-3333-b5d0-f4e22ed3d564",
                                                "text": "Cette interprétation s'appuie sur des éléments de réalité : des soixante-huitards ont adhéré au parti socialiste et ce dernier a repris à son compte des thèmes de la « révolution culturelle » de Mai."
                                            },
                                            {
                                                "example_id": "a4e56831-62d9-4be8-a57a-09c292b2e81a",
                                                "sense_id": "610d35b3-5954-3333-b5d0-f4e22ed3d564",
                                                "text": "Après tout, les soixante-huitards ont commencé par faire la révolution, puis ils sont entrés dans la pub – moi, je voulais faire l’inverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df53d8df-f678-30b9-b819-01fc1ada6411",
                                        "entry_id": "30294653-9a65-3227-8cb8-1be488947034",
                                        "glosses": [
                                            "Homme qui a conservé les idées du mouvement de mai 68."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7421b032-0a51-42c2-bdf2-6cb5ff0e7b86",
                                                "sense_id": "df53d8df-f678-30b9-b819-01fc1ada6411",
                                                "text": "Un leitmotiv principal à travers son œuvre est sans aucun doute la grande aversion qu'il porte contre cette génération fondamentalement dégénérée de soixante-huitards. À eux, il « reproche d'avoir brisé la solidarité familiale, les traditions et le vœu inconditionnel […] »."
                                            },
                                            {
                                                "example_id": "2a13c509-edd1-480a-a842-45cfadf98215",
                                                "sense_id": "df53d8df-f678-30b9-b819-01fc1ada6411",
                                                "text": "Son allure et ses manières n'étaient pourtant pas celles d'une paysanne et encore moins d'une ancienne vannière du village ; pour qui ne la connaissait pas, elle avait tout d'une soixante-huitarde ayant opéré un retour à la campagne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
