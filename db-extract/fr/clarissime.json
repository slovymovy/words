                "senses": [
                    {
                        "sense_id": "048a7a00-9e07-30da-a529-81ba8c2f0518",
                        "entry_id": "08aa24cf-127d-31df-8cdd-6d692a900312",
                        "glosses": [
                            "Titre d’honneur très fréquent dans le Bas-Empire romain."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "fbcba834-c4b0-4189-863c-95ac5566e6e7",
                                "sense_id": "048a7a00-9e07-30da-a529-81ba8c2f0518",
                                "text": "— Clarissime Euphrosine, l’amour est plus fort que la volonté ; c’est pourquoi il convient de lui obéir comme à un maître jaloux. Je ferai à votre égard ce qu’il m’ordonne, qui est de vous prendre pour ma femme."
                            }
                        ]
                    },
                    {
                        "sense_id": "361ab1b1-aa3c-3836-afb0-2652f99baf3b",
                        "entry_id": "08aa24cf-127d-31df-8cdd-6d692a900312",
                        "glosses": [
                            "Appellation plaisante utilisant ce titre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25126d4f-3876-4fbf-8edc-10dbfe60d611",
                                "sense_id": "361ab1b1-aa3c-3836-afb0-2652f99baf3b",
                                "text": "J’ai écrit au clarissime, dont j’ai lu la dissertation avec grand plaisir."
                            }
                        ]
                    }
