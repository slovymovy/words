{
    "word_family": [
        "danger",
        "dangerous",
        "dangerously",
        "endanger",
        "endangerment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e484f486-10b8-3e54-85f7-39d4c0c89445",
                    "sense_definition": "present participle and gerund of <w>endanger</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "putting_in_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Driving at such high speeds is <w>endangering</w> the lives of everyone on the road.",
                            "target_lang_translations": {
                                "es": "Conducir a velocidades tan altas está <w>poniendo en peligro</w> la vida de todos en la carretera."
                            }
                        },
                        {
                            "text": "Pollution from local factories is seriously <w>endangering</w> the river ecosystem.",
                            "target_lang_translations": {
                                "es": "La contaminación de las fábricas locales está <w>poniendo en grave peligro</w> el ecosistema del río."
                            }
                        }
                    ],
                    "synonyms": [
                        "jeopardizing",
                        "imperiling",
                        "threatening"
                    ],
                    "antonyms": [
                        "protecting",
                        "safeguarding"
                    ],
                    "common_phrases": [
                        "endangering public safety",
                        "endangering lives"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio de presente y gerundio de «endanger»: poner a alguien o algo en una situación de peligro o riesgo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "poniendo en peligro",
                                "target_lang_sense_clarification": "acción en curso de arriesgar o comprometer algo o a alguien"
                            },
                            {
                                "target_lang_word": "poniendo en riesgo",
                                "target_lang_sense_clarification": "acción continua de exponer a un riesgo"
                            },
                            {
                                "target_lang_word": "amenazando",
                                "target_lang_sense_clarification": "constituir una amenaza para la integridad de algo o alguien"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afe031d1-a0e8-3342-9308-423d93039a20",
                    "sense_definition": "The act of putting someone or something in danger.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "putting_in_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legal report documented repeated <w>endangerings</w> of vulnerable patients under their care.",
                            "target_lang_translations": {
                                "es": "El informe legal documentó repetidas <w>puestas en peligro</w> de pacientes vulnerables bajo su cuidado."
                            }
                        },
                        {
                            "text": "The prosecutor handled several serious child <w>endangerings</w> during her tenure.",
                            "target_lang_translations": {
                                "es": "La fiscal manejó varios casos graves de <w>puesta en peligro</w> de menores durante su mandato."
                            }
                        }
                    ],
                    "synonyms": [
                        "endangerment"
                    ],
                    "antonyms": [
                        "protection"
                    ],
                    "common_phrases": [
                        "child endangerings"
                    ],
                    "target_lang_definitions": {
                        "es": "El acto o delito de poner a alguien o algo en peligro."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "puesta en peligro",
                                "target_lang_sense_clarification": "acto de exponer a una situación peligrosa, a menudo en contexto legal"
                            },
                            {
                                "target_lang_word": "puesta en riesgo",
                                "target_lang_sense_clarification": "acción o caso de comprometer la seguridad de alguien"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}