                "senses": [
                    {
                        "sense_id": "50b4736a-a435-35fa-b04b-08a2a4f82099",
                        "entry_id": "caf345cd-e2f2-32cd-a2f0-68fdb573d9da",
                        "glosses": [
                            "Dispositif, rigide ou non, n'ayant pas à satisfaire aux prescriptions concernant un conteneur de transport, permettant l'expédition, en une seule unité de manutention, de deux colis ou plus afin de faciliter la manutention, l'arrimage et l'acheminement."
                        ],
                        "tags": [
                            "Cycle du combustible nucléaire"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a135544e-2b9e-3ed0-8695-9ac4c064731b",
                        "entry_id": "caf345cd-e2f2-32cd-a2f0-68fdb573d9da",
                        "glosses": [
                            "Excès d’emballage d'un produit."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cc3f372-1323-4f1f-b603-23d657638372",
                        "source_entry_id": "caf345cd-e2f2-32cd-a2f0-68fdb573d9da",
                        "target_lang_word": "overpack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overpack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                        "entry_id": "be0689cc-9f21-3688-8583-3eff9a55b483",
                                        "glosses": [
                                            "To pack too much."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f887304e-9d17-4bfa-89f9-f8bb72485fe4",
                                                "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                                "text": "The opportunity to start over reawakens the belief that I can become someone else -- an organized, thrifty, wise, elegant, worldly traveler, rather than the disorganized, frumpy, overpacked and harried traveler that I am."
                                            },
                                            {
                                                "example_id": "fe795bdf-2413-4ebc-a04e-654a942c6a2a",
                                                "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                                "text": "The mix of ballet vocabulary, modern techniques and African steps is familiar, but the extent to which Mr. Rhoden packs — and overpacks — phrases, cultivates warp-speed delivery and hyperextends every possible hip jut and arabesque is, thank goodness, something special to Complexions."
                                            },
                                            {
                                                "example_id": "5bddb389-362d-41c9-a8bf-c974a01132ad",
                                                "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                                "text": "The truth is, I tend to overpack like everyone else, and this summer is no different."
                                            },
                                            {
                                                "example_id": "c6ca6692-a0f3-48fb-b1f1-f6036e9aeeb1",
                                                "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                                "text": "Infrequent travelers tend to overpack, stuffing suitcases full of a different outfit for every day of the week, plus a few extras — just in case."
                                            },
                                            {
                                                "example_id": "49443bff-2831-4404-a7ae-8ea858c36923",
                                                "sense_id": "efc6d3aa-4058-3106-800c-945db4edd052",
                                                "text": "If you’re prone to overpacking and could use external structure, limit yourself intentionally: Pick a small carry-on bag or travel backpack and stick with it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overpack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f24be55-5b9d-3f48-9ff9-276e35dfe357",
                                        "entry_id": "d5efd5cf-a7e7-352b-b8a4-9490537c4010",
                                        "glosses": [
                                            "A container intended to hold smaller containers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ec48c40-2dc7-4a5d-999d-9b30a9fbf115",
                                                "sense_id": "2f24be55-5b9d-3f48-9ff9-276e35dfe357",
                                                "text": "Each container in an overpack must be a package authorized for that hazardous material in the HMR."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45c8ead7-f240-4c99-96f6-3fbb00cb9f12",
                        "source_entry_id": "caf345cd-e2f2-32cd-a2f0-68fdb573d9da",
                        "target_lang_word": "overwrap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overwrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4025b1d-be2b-3b25-9e60-696bdee10df0",
                                        "entry_id": "2e3efb65-072d-3b9c-9f14-7db9bd26a8ef",
                                        "glosses": [
                                            "A secondary wrapper covering an item."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03f95734-16ed-454c-aac4-5c1db36af1d0",
                                                "sense_id": "c4025b1d-be2b-3b25-9e60-696bdee10df0",
                                                "text": "In recent years, PSI has become a major supplier in the pallet overwrap market."
                                            },
                                            {
                                                "example_id": "25ab9669-bdb7-4e11-b01f-a547912bfdb2",
                                                "sense_id": "c4025b1d-be2b-3b25-9e60-696bdee10df0",
                                                "text": "In another embodiment of the present invention, a pipe assembly for containing and transporting cryogenic temperature fluids includes: (a) at least one inner pipe wherein the at least one inner pipe is made of material resistant to cryogenic temperatures; (b) a composite overwrap capable of enduring exposure and stress at cryogenic temperatures having a near zero or negative coefficient of thermal expansion, wherein the composite overwrap is bonded to the inner pipe in an axial direction forming a combined composite overwrap and inner pipe, wherein laminate plate theory and optimization software are utilized to reach an overall coefficient of thermal expansion near zero for a combined inner pipe and the composite overwrap; and © an other pipe that is positioned around the combined composite overwrap and inner pipe so as to create an annular space between the exterior surface of the combined composite overwrap and inner pipe and the interior surface of the outer pipe, wherein the annular space between the outer pipe and the combined composite overwrap and the inner pipe is provided with thermal insulation."
                                            },
                                            {
                                                "example_id": "8b3260a4-57c6-463a-83d5-e976f8ff667c",
                                                "sense_id": "c4025b1d-be2b-3b25-9e60-696bdee10df0",
                                                "text": "Users may grip the packaged solution bag in a manner that physically captures the solution bag between the two sides of the overwrap's tear strip. Consequently, when the participant tore open the overwrap, she also tore open the dialysis solution bag."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overwrap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ed42371-c252-386a-97f5-3eed1c3a74fc",
                                        "entry_id": "2f9febee-2c9c-31bb-90be-70568b8839ef",
                                        "glosses": [
                                            "To wrap in a secondary wrapper."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcee6a4b-289f-44e3-8ade-7ad3a11b9994",
                                                "sense_id": "3ed42371-c252-386a-97f5-3eed1c3a74fc",
                                                "text": "Each unit load can also be overwrapped completely in multibags, without any of the usual back-breaking work of manually transferring and restacking, and fitting slings or nets when the load is inverted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e22a1ec5-e572-3f07-a4e3-8bc5a4a4c0c5",
                                        "entry_id": "2f9febee-2c9c-31bb-90be-70568b8839ef",
                                        "glosses": [
                                            "To wrap such that the wrapping goes beyond the edge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0f5460-7e48-4848-907e-603ba2870c9e",
                                                "sense_id": "e22a1ec5-e572-3f07-a4e3-8bc5a4a4c0c5",
                                                "text": "These flaws can include a reed being overwrapped (wrapped past the end of the staple), underwrapped (not wrapped the full length of the staple), or slipped incorrectly (the blades of cane not meeting properly especially if one blade is completely inside the other blade); the cane being crooked on the staple; the cane leaning to the side; or the blank being the wrong length. Cane is expensive and your time is valuable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2be6e59-abb0-3633-9620-d53093bf58c0",
                                        "entry_id": "2f9febee-2c9c-31bb-90be-70568b8839ef",
                                        "glosses": [
                                            "To provide with too many wrappings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee76386-96eb-4faa-94e9-b63df8d43cce",
                                                "sense_id": "f2be6e59-abb0-3633-9620-d53093bf58c0",
                                                "text": "Personally, we feel that overwrapping is more harmful than underwrapping in measles as well as in many other conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
