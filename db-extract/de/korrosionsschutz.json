                        ],
                        "form": "den Korrosionsschutz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                        "entry_id": "3a150617-b17d-3faa-9fbd-a09d232cbf71",
                        "glosses": [
                            "Maßnahmen gegen Oxidation (= Korrosion) zur Erhaltung von Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "788b9844-3af2-4777-a83c-97dd393a13e9",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Zink ist ein gängiges Element für den Korrosionsschutz,“ […]."
                            },
                            {
                                "example_id": "b5a502d9-2796-4d7d-be02-c569a303d031",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Erkläre, weshalb sich Zinn für den Korrosionsschutz von Eisen eignet.“"
                            },
                            {
                                "example_id": "cfff32cf-2f95-453b-b82f-65a8d69103d0",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Nickel dient als Überzugsmetall zum Korrosionsschutz („Vernickeln“) von Metallgegenständen:“ […]."
                            },
                            {
                                "example_id": "a823e9f9-4c5c-41c2-85b7-9b75f4fa5fd9",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Als Korrosionsschutz diente Eisenmennige, ein spezieller Anstrich auf Ölbasis.“"
                            },
                            {
                                "example_id": "546468fa-278e-44bf-8fbe-9e87066dad84",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Unter anderem wird der Korrosionsschutz erneuert,“ […]."
                            },
                            {
                                "example_id": "0b90e242-b44d-45c2-b512-14aea650ac07",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Die Marine stellte fest, dass fehlender Korrosionsschutz der häufigste Grund für die Korrosion war: Kontaktkorrosion trat auf.“"
                            },
                            {
                                "example_id": "00d55858-f998-41e8-aff5-56a7afdb873a",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "[Die Feuerverzinkung und die galvanische Verzinkung bieten beide] „einen wirksamen Korrosionsschutz und sind in verschiedenen Industriezweigen, von der Fertigung bis zum Bauwesen, weit verbreitet.“"
                            },
                            {
                                "example_id": "2bab8513-3ae7-4a4a-8bc1-9ea162474f30",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Prüf-Ingenieur Henning Manche sagt, dass unter anderem die Schweißnähte, die Schrauben und der Korrosionsschutz kontrolliert werden müssten.“"
                            },
                            {
                                "example_id": "c94f5edf-95a1-427f-8bcb-d896a3699d07",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Grund für die Einschränkungen sind Instandhaltungsarbeiten. Den Angaben der Bahn zufolge wird am Korrosionsschutz an der Brücke über die Autobahn A10 gearbeitet,“ […]."
                            },
                            {
                                "example_id": "542f1685-7cbe-4800-bbea-cacb4d7033f6",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Nach Angaben des LBV.SH ist mit einer Fertigstellung der Reparaturarbeiten samt Korrosionsschutz jedoch erst Ende August zu rechnen.“"
                            },
                            {
                                "example_id": "de2b799d-d199-4e33-bdf9-45b330515a9f",
                                "sense_id": "0533604a-2619-3039-bd7c-e2c09f24dbfd",
                                "text": "„Die Stahlbrücke selbst ist inzwischen repariert, sandgestahlt und mit blauem Korrosionsschutz gestrichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
