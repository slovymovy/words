                "senses": [
                    {
                        "sense_id": "19290aac-128e-3b04-8819-1a19e26abfe4",
                        "entry_id": "4339e31a-56dc-3505-8beb-9937d5f5c1ea",
                        "glosses": [
                            "touw waar men aan kan rukken om iets te sluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e243e295-7da6-4f0e-b91c-f8d98562d09c",
                                "sense_id": "19290aac-128e-3b04-8819-1a19e26abfe4",
                                "text": "Mevrouw Taylor en ik knikten elkaar toe, en hoewel haar gezicht haar prettige uitdrukking niet verloor, leken haar trekken op hun plaats te vallen en zag ik dat haar dunne lippen door lijnen werden omringd, als een tas met trekkoorden."
                            }
                        ]
                    },
                    {
                        "sense_id": "25816706-1ab8-31f4-a5c5-cffb55261e23",
                        "entry_id": "4339e31a-56dc-3505-8beb-9937d5f5c1ea",
                        "glosses": [
                            "een touw waar men aan kan rukken om iets in werking te zetten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "711a49ef-5c68-46b1-ab8d-835003a821bd",
                                "sense_id": "25816706-1ab8-31f4-a5c5-cffb55261e23",
                                "text": "De parachute, die er als een rugzak uitziet en in de Verenigde Staten en Japan op de markt wordt gebracht, kost 795 dollar (bijna 2000 gulden) en weegt 2 kilo. Het trekkoord kan worden vastgemaakt aan een zwaar meubel of een speciale haak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65b85db9-3402-48cc-9cc3-f95049fd50e8",
                        "source_entry_id": "4339e31a-56dc-3505-8beb-9937d5f5c1ea",
