                        "glosses": [
                            "To muffle or wrap someone's head or face (normally with up)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2f9bd13d-aaab-4900-a257-ea81d9f171f6",
                                "sense_id": "45315b78-bedc-3b88-b5e5-d0f2543e2e88",
                                "text": "She was all mobled up at the window, her tawniness flat and dull in this snowlight, and I felt pity."
                            },
                            {
