                "entry_id": "112b76eb-6eae-3172-9968-89b271db3432",
                "word": "morgen",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "35202a6a-0676-477a-9bf7-f339087e109b",
