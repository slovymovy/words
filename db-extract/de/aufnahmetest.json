                        "glosses": [
                            "Prüfung einer Eigenschaft oder Fähigkeit, welche den Zugang zu einer Organisation erlauben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28e44fb-e20c-412a-b1ef-4388dfd91686",
                                "sense_id": "a8c8aa0b-f499-3c5d-8a3d-9ea4def6555a",
                                "text": "Den Aufnahmetest werde ich bestehen."
                            },
                            {
                                "example_id": "bda4c2c1-f7cc-4752-a5d0-b0d3cb433360",
                                "sense_id": "a8c8aa0b-f499-3c5d-8a3d-9ea4def6555a",
                                "text": "„Nur in Potsdam und Halle hatte ich Erfolg bei diesem Aufnahmetest und entschied mich dann für Potsdam, weil diese Stadt in der Nähe von Berlin liegt.“"
                            }
