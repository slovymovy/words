                        "glosses": [
                            "Satisfaction par soi-même de ses pulsions sexuelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725675d4-1bc9-4dd2-9a9f-dd73e86b65cd",
                                "sense_id": "e39bd568-dbbe-3a86-8b76-c61e0664cedb",
                                "text": "Or l’antinarcissisme, qui est l’antithèse mais aussi le complément du narcissisme, est comme celui-ci exclusif de l’auto-érotisme."
                            },
                            {
                                "example_id": "a18aad7e-9945-469d-bf75-7a592f70ce1a",
                                "sense_id": "e39bd568-dbbe-3a86-8b76-c61e0664cedb",
                                "text": "L'auto-érotisme sans but psychosexuel n’est pas sans rappeler le point de vue de H. H. Ellis qui estimait que l’auto-érotisme dans son aspect le plus pur était révélé par l’orgasme féminin survenant pendant le sommeil sans rêve."
                            },
                            {
                                "example_id": "ef94b254-2235-4787-af17-9979c1e4f6b9",
                                "sense_id": "e39bd568-dbbe-3a86-8b76-c61e0664cedb",
                                "text": "La génitalité dans le développement sexuel de l’individu vient remplacer les auto-érotismes précédents."
                            }
                        ]
                    }
