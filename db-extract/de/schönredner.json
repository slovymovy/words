                        "examples": [
                            {
                                "example_id": "4b3626aa-0f43-4a05-b731-141e39460e10",
                                "sense_id": "6f41de10-ff6d-3b9f-8853-118bd8e62c60",
                                "text": "Ich hungerte und hatte Schulden – welch ein wunderliches Geschick! Endlich fand ich eine offene Tür und griff nun alle Berufsarten auf, nur um leben zu können, war Journalist, Kellner, Politiker, Spieler, Vertreter, Barbier, bald Herr und bald Diener, wie es dem Zufall beliebte, ehrgeizig aus Eitelkeit, fleißig aus Not, aber träge von Natur und Wonne! Schönredner bei Gelegenheit, Dichter zur Erholung, Musiker nach Bedarf, Liebhaber aus Laune!"
                            }
                        ]
                    }
