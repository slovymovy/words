                                                "sense_id": "a0bc6cd5-4b90-3253-9ae0-990119288cd9",
                                                "text": "medical marijuana; medical cannabis; medical treatment"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e1ba4a-71fa-325d-96cd-a5ac9d35a731",
                                        "entry_id": "25e2fc61-8567-3742-90d5-36c0f1180026",
                                        "glosses": [
                                            "Requiring medical treatment."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df5cd2b-c10e-49a3-8125-09e1363e5a00",
                                                "sense_id": "32e1ba4a-71fa-325d-96cd-a5ac9d35a731",
                                                "text": "A costly medical condition can bankrupt you if it doesn't kill you first."
                                            }
                                        ]
                                    },
                                    {
