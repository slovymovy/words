                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "90e9e15f-5006-3e42-bba2-b3630a2eb9a9",
                        "entry_id": "c1d7b3a2-1ca1-30e9-8930-cdca94c74db6",
                        "glosses": [
                            "w przemyśle, pokrojony surowiec przeznaczony do dalszego przetwarzania"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d10bef-0302-4784-8ddb-3920c2ecfd0d",
                                "sense_id": "90e9e15f-5006-3e42-bba2-b3630a2eb9a9",
                                "text": "Posortowane, umyte i obrane ziemniaki kroi się mechanicznie w paski lub talarki (plastry) na krajalnicy z poziomo wirującymi nożami. Krajanka może być wstępnie blanszowana (w temp. 95÷100 ℃) lub kierowana do suszenia bezpośrednio po krojeniu"
                            },
                            {
                                "example_id": "6a056218-b272-4542-a476-3892635fb8ed",
                                "sense_id": "90e9e15f-5006-3e42-bba2-b3630a2eb9a9",
                                "text": "Ponad 900 kilogramów krajanki tytoniowej o szacunkowej wartości blisko 600 tysięcy złotych przechwycili funkcjonariusze z placówki Straży Granicznej w Augustowie"
                            },
