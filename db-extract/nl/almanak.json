                    },
                    {
                        "translation_id": "14961ec0-c972-480e-9486-204ac5ec86c5",
                        "source_entry_id": "5f427e8c-a275-351d-a01d-5e800363292e",
                        "source_sense_id": "bd515b0c-0bf5-321d-a304-f8c110ebd0b2",
