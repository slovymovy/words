                "senses": [
                    {
                        "sense_id": "7b68c517-711b-36dc-9b3c-b7907e41f60f",
                        "entry_id": "c6a88978-d667-3744-a393-b30fd355e7e4",
                        "glosses": [
                            "dat wat iemand in eigendom heeft, dat wat van iemand is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0649c0-f6f9-46e4-af58-ab3dfc6c7fb9",
                                "sense_id": "7b68c517-711b-36dc-9b3c-b7907e41f60f",
                                "text": "Hij heeft niet veel bezittingen."
                            },
                            {
                                "example_id": "75fbd956-f487-4283-aa3b-9d0f35dac867",
                                "sense_id": "7b68c517-711b-36dc-9b3c-b7907e41f60f",
                                "text": "Ze droeg een oud douchegordijn over haar schouder met al haar bezittingen erin."
                            },
                            {
                                "example_id": "c341b39f-a47b-4ecb-aa2b-33e6daff7160",
                                "sense_id": "7b68c517-711b-36dc-9b3c-b7907e41f60f",
                                "text": "Westerse landen hebben de afgelopen maanden meer dan 330 miljard dollar aan bezittingen van rijke Russen en de Russische centrale bank bevroren. Dat is omgerekend zo'n 314 miljard euro. Reden hiervan is de de Russische inval in Oekraïne."
                            }
                        ]
                    }
                ],
