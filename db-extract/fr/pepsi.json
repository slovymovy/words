                        "entry_id": "3e3711a9-d405-31c7-944c-f749e511fa38",
                        "glosses": [
                            "Boisson gazeuse, née en 1903 aux États-Unis et commercialisée par la société PepsiCo."
                        ],
                        "tags": [
                            "Marque commerciale"
                        ],
                        "examples": [
                            {
                                "example_id": "12b01051-0033-4070-b997-3fd340bd8e2c",
                                "sense_id": "451bb495-8bc3-3d99-9ba5-5c26c2a1b610",
                                "text": "Trouver du Pepsi, de l’Ice Tea ou des chips Lay’s dans les Super U va ressembler à une chasse au trésor."
                            },
                            {
                                "example_id": "504a0314-eea1-43ca-a141-dd640fdfa95a",
                                "sense_id": "451bb495-8bc3-3d99-9ba5-5c26c2a1b610",
                                "text": "Marie-Claude commande deux steamés et deux Pepsi. Moins de cinq minutes plus tard, la serveuse dépose devant elles deux assiettes dont émane un arôme divin."
                            }
                        ]
                    }
                ],
