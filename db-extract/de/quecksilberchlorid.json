                "senses": [
                    {
                        "sense_id": "2b55ef9b-7347-3157-a641-6119216fd581",
                        "entry_id": "3f23e1a4-1320-3b00-95a1-a38e5f0fa440",
                        "glosses": [
                            "Ionenverbindung aus einem Quecksilber-Kation und zwei Chlor-Anionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9901cf3-e8bf-4222-963a-ec73fa0dfebd",
                                "sense_id": "2b55ef9b-7347-3157-a641-6119216fd581",
                                "text": "„Quecksilberchlorid (Ätzsublimat) besitzt im hohen Grade pilztötende Eigenschaften, ist aber auch für Menschen und Tiere sehr giftig und muß deshalb mit der nötigen Vorsicht verwendet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fa79cf88-2fe9-3ce1-9752-6fafdad79988",
                        "entry_id": "3f23e1a4-1320-3b00-95a1-a38e5f0fa440",
                        "glosses": [
                            "Ionenverbindung aus zwei Quecksilber-Kationen und zwei Chlor-Anionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdd5af21-3c9a-4362-9ecc-b7a995c8caaa",
                                "sense_id": "fa79cf88-2fe9-3ce1-9752-6fafdad79988",
                                "text": "„Als Quecksilberpräparate, die zu den Versuchen herangezogen wurden, sind das Quecksilberbichlorid (Sublimat), das Quecksilberchlorid (Kalomel) und das Novasurol zu erwähnen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
