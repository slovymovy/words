                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d52c62e-d453-385b-86ae-3c7c546625dc",
                                        "entry_id": "b0f97203-dfc4-3f3f-9a65-534499e21e75",
                                        "glosses": [
                                            "Bright, luminous, translucent, or transparent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b96c6e6-83ff-4a90-9f19-43c678f0588d",
                                                "sense_id": "1d52c62e-d453-385b-86ae-3c7c546625dc",
                                                "text": "The atmosphere was unusually clear, as if loath to part with the daylight; but the moon, like a round of lucid snow, had risen on the sky; and a pale, soft gleam, came from the lamps amid the foliage."
                                            },
                                            {
                                                "example_id": "7f073867-942b-4557-a61e-210244b98c4f",
                                                "sense_id": "1d52c62e-d453-385b-86ae-3c7c546625dc",
                                                "text": "Pictures of growing spring and farms and homes, / With the Fourth-month eve at sundown, and the gray smoke lucid and bright, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lucid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ac78d7-d5c8-3e52-bab9-8ceee86ce20d",
                                        "entry_id": "3f2ac058-2ae4-3c60-b210-3bb0fa131854",
                                        "glosses": [
                                            "A lucid dream."
                                        ],
                                        "tags": [],
