                "senses": [
                    {
                        "sense_id": "0254199b-f42c-37fb-8e32-6a863f875ec6",
                        "entry_id": "867de5a3-e8d8-3cdf-a047-16d31b379619",
                        "glosses": [
                            "Person, die Messerklingen schärft"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "5421ae8d-eef6-439d-8a04-7be5c7fbbe0c",
                                "sense_id": "0254199b-f42c-37fb-8e32-6a863f875ec6",
                                "text": "„Der Scherenschleifer – regional auch Messerschleifer genannt – repariert, wartet und schärft defekte und/oder stumpfgewordene Scheren, Messer, Sicheln, Sensen und sonstige Klingen an einer Schleifsteinvorrichtung.“"
                            },
                            {
                                "example_id": "1d693ed7-f51d-47f5-bd75-314072af7ecc",
                                "sense_id": "0254199b-f42c-37fb-8e32-6a863f875ec6",
                                "text": "„Messerschleifer waren einst fahrende Handwerker.“"
                            },
                            {
                                "example_id": "b0620cc2-d962-407b-ac99-dc17925817e9",
                                "sense_id": "0254199b-f42c-37fb-8e32-6a863f875ec6",
                                "text": "„Messerschleifer, besonders Gewerbetreibende auf Reisen, verdienen ihr Geld in einem aussterbendes Handwerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
