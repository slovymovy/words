        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a33bf7ef-7b06-3337-9d81-ed563094f996",
                    "sense_definition": "A motion or action that curves or angles something physically.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bending</w> of the metal caused it to snap eventually.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>сгибание</w> металла привело к тому, что он в конце концов сломался.",
                                "nl": "Het constante <w>buigen</w> van het metaal zorgde ervoor dat het uiteindelijk knapte."
                            }
                        },
                        {
                            "text": "Proper <w>bending</w> of the knees is essential when lifting weights.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>сгибание</w> коленей необходимо при поднятии тяжестей.",
                                "nl": "Het correct <w>buigen</w> van de knieën is essentieel bij het tillen van gewichten."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bending moment",
                        "bending stress"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение или действие, физически искривляющее или сгибающее что-либо.",
                        "nl": "Een beweging of handeling die iets fysiek kromt of buigt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгибание",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "изгиб",
                                "target_lang_sense_clarification": "результат действия"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "buiging",
                                "target_lang_sense_clarification": "de handeling of het resultaat"
                            },
                            {
                                "target_lang_word": "het buigen",
                                "target_lang_sense_clarification": "het proces"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2318c3c2-05e5-382f-8af6-b5eb7e0786af",
                    "sense_definition": "An instance of adapting, distorting, or interpreting rules or facts loosely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such <w>bendings</w> of the truth are unfortunately common in political debates.",
                            "target_lang_translations": {
                                "ru": "Подобные <w>искажения</w> истины, к сожалению, часто встречаются в политических дебатах.",
                                "nl": "Dergelijke <w>verdraaiingen</w> van de waarheid komen helaas vaak voor in politieke debatten."
                            }
                        },
                        {
                            "text": "The lawyer argued that this was a <w>bending</w> of the law rather than a breach.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что это был <w>обход</w> закона, а не его нарушение.",
                                "nl": "De advocaat betoogde dat dit een <w>omzeiling</w> van de wet was in plaats van een overtreding."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bending of rules",
                        "bending of the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай адаптации, искажения или вольной интерпретации правил или фактов.",
                        "nl": "Een geval van het aanpassen, verdraaien of ruim interpreteren van regels of feiten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искажение",
                                "target_lang_sense_clarification": "фактов или истины"
                            },
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "правил или закона"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verdraaiing",
                                "target_lang_sense_clarification": "van de waarheid"
                            },
                            {
                                "target_lang_word": "omzeiling",
                                "target_lang_sense_clarification": "van regels of wetten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "31fdf3b7-7981-3cab-bca9-3fba268b54ef",
                    "sense_definition": "Capable of being curved or twisted without breaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bending</w> branches survived the strong winds of the storm.",
                            "target_lang_translations": {
                                "ru": "<w>Гнущиеся</w> ветви пережили сильные ветры шторма.",
                                "nl": "De <w>buigzame</w> takken overleefden de harde wind van de storm."
                            }
                        },
                        {
                            "text": "We need a <w>bending</w> material that can fit around this corner.",
                            "target_lang_translations": {
                                "ru": "Нам нужен <w>гнущийся</w> материал, который можно уложить вокруг этого угла.",
                                "nl": "We hebben een <w>buigzaam</w> materiaal nodig dat om deze hoek past."
                            }
                        }
                    ],
                    "synonyms": [
                        "flexible"
                    ],
                    "antonyms": [
                        "inflexible",
                        "unbending"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный изгибаться или скручиваться, не ломаясь.",
                        "nl": "In staat om gebogen of gedraaid te worden zonder te breken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнущийся",
                                "target_lang_sense_clarification": "свойство материала"
                            },
