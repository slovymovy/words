                "senses": [
                    {
                        "sense_id": "febd89f0-b874-3893-9fbb-6db3f0622cdd",
                        "entry_id": "f5ddca0f-19eb-37e3-8aa7-d7a26e97aafb",
                        "glosses": [
                            "rodzaj zamkniętego wiązanego buta turystycznego lub zimowego na gumowej, rowkowanej podeszwie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3ec0a9c-d73f-4924-b60a-16aa3c5dcc48",
                                "sense_id": "febd89f0-b874-3893-9fbb-6db3f0622cdd",
                                "text": "Będziesz ubierać w góry te wiązane traperki?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0db929f1-4f04-303f-b79e-0826a02b3c4e",
                        "entry_id": "f5ddca0f-19eb-37e3-8aa7-d7a26e97aafb",
                        "glosses": [
                            "podróżniczka stroniąca od cywilizacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997800f7-4c3b-436a-b71c-3b24796b0771",
                                "sense_id": "0db929f1-4f04-303f-b79e-0826a02b3c4e",
                                "text": "Ukrainka wspinała się jak doświadczona traperka, a obie Rosjanki przypominały niedźwiadki pełzające po oblodzonej skale, poruszały się niemal na czworakach"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "45ee5cef-84c8-3ff2-9657-ea6971d479b3",
                        "entry_id": "f5ddca0f-19eb-37e3-8aa7-d7a26e97aafb",
                        "glosses": [
                            "traperstwo"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "728e5f97-7639-4f6c-8fed-878f76367d6c",
                                "sense_id": "45ee5cef-84c8-3ff2-9657-ea6971d479b3",
                                "text": "W miesiącach letnich parał się traperką, zimę spędzał we wsi nad rzeką."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
