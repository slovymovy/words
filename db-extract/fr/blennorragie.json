        "fr-extract.jsonl": [
            {
                "entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                "word": "blennorragie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "43fffac2-f834-416d-bbd6-80e178503aeb",
                        "entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                        "tags": [
                            "plural"
                        ],
                        "form": "blennorragies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                        "entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                        "glosses": [
                            "Maladie inflammatoire et infectieuse de la muqueuse de l’urètre."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "89d844ad-9c00-4468-8c7f-66d2e089393d",
                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                "text": "En juin 1880, deux militaires tombent malades (chancres et blennorragie)."
                            },
                            {
                                "example_id": "379b0b51-deca-4382-863d-c9925d8955ff",
                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                "text": "En particulier, les chercheurs ont analysé la sensibilité des cas de blennorragie à une augmentation du prix de la bière due à une taxe."
                            },
                            {
                                "example_id": "5d8184e0-af9e-42de-a270-06f6d5623d9a",
                                "sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                                "text": "On avait inventé un nouveau médicament qui guérissait la blennorragie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0297f468-d6e4-46ba-b269-c73b863fc8c5",
                        "source_entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                        "source_sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                        "target_lang_word": "Tripper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tripper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                        "entry_id": "75acfd48-18d4-358b-90e2-d4a606cd799d",
                                        "glosses": [
                                            "Gonorrhö, eine bakterielle Geschlechtskrankheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ee87cd0-ae96-48f7-8a8b-0d5106d81f46",
                                                "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                                "text": "In seinem Urlaub hat er sich den Tripper eingefangen."
                                            },
                                            {
                                                "example_id": "3db2cf42-aecd-4cb7-9c02-7e182c3d72f1",
                                                "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                                "text": "„Ich sagte ihm, daß ich zweimal einen Tripper gehabt hätte.“"
                                            },
                                            {
                                                "example_id": "27addeac-c09f-479d-a938-3d1862d5be1d",
                                                "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                                "text": "„Ich hatte in Tanger meinen Liebeskummer verloren und mir dafür in Marrakesch einen Tripper eingefangen.“"
                                            },
                                            {
                                                "example_id": "69c166fd-02d8-4000-a8e1-83e20382d51b",
                                                "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                                "text": "„Denn die Kolonialherren sorgten auch für die Verbreitung von Trunksucht und Tripper.“"
                                            },
                                            {
                                                "example_id": "442e45b0-4aab-4867-86e1-081cc616ce59",
                                                "sense_id": "68ca348f-2390-34ef-9e45-f00cc318a9a8",
                                                "text": "„Die Klobrille sieht mindestens nach Tripper aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43b93b63-8479-41f3-b5ec-067e75720dfa",
                        "source_entry_id": "7c4519c7-70a5-38d1-b40e-125fd3b1416f",
                        "source_sense_id": "e0a38d26-731b-3427-834a-33d946780f7e",
                        "target_lang_word": "Gonorrhoe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gonorrhoe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b33e7057-2c18-3984-a49d-419bde0753c8",
                                        "entry_id": "2977a9e5-0d9c-3a18-b3c8-8ba1774d67de",
                                        "glosses": [
                                            "ansteckende Geschlechtskrankheit mit eitrigem Ausfluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92b3d1e0-ab48-414a-b021-2606b628de34",
                                                "sense_id": "b33e7057-2c18-3984-a49d-419bde0753c8",
                                                "text": "„Als er mit neunzehn Jahren zu den Lübbener Jägern einrückt, hat er schon zahlreiche Weibergeschichten, eine Gonorrhoe und eine Anzeige wegen Verbreitung von Geschlechtskrankheiten hinter sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
