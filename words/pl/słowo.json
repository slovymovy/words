                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnym języku polskim termin <w>słowo</w> często oznaczał po prostu czasownik.",
                            "target_lang_translations": {
                                "ru": "В древнепольском языке термин <w>слово</w> часто означал просто глагол."
                            }
                        },
                        {
                            "text": "Analiza gramatyczna tego zdania wymaga wskazania głównego <w>słowa</w>.",
                            "target_lang_translations": {
                                "ru": "Грамматический анализ этого предложения требует указания главного <w>слова</w>."
                            }
