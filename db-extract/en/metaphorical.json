                    {
                        "translation_id": "8414507d-3d1e-4b57-ba7e-f364881069cc",
                        "source_entry_id": "528208d4-4e2c-3b1c-bb0b-cbe8e5c2a849",
                        "source_sense_id": "6f50b2de-c8c0-3e80-9ed4-64a3ac3a3618",
                        "source_sense_description": "pertaining to a metaphor",
                        "target_lang_word": "metaphorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "metaphorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                        "entry_id": "5b00ac24-858a-3ff2-a091-d9c33a5b2ad0",
                                        "glosses": [
                                            "bildlich, übertragen verwendet"
                                        ],
                                        "tags": [
                                            "bei Ausdrücken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcbe8dac-ecf4-4d0b-a7c6-e13e17d7ed14",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Nicht wenige der zumeist sehr mittelmäßigen Autoren liefen in die Falle der metaphorischen Instrumentierung, der ästhetischen Aufladung und Bebilderung, als wäre das entscheidende Merkmal von Literatur eine \"gehobene Rede\", die unsere Alltagssprache um jeden Preis poetisierend überbieten müsste.“"
                                            },
                                            {
                                                "example_id": "d749f4ba-3edc-4794-aff4-e3c7b61008a7",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Strauße sind nicht so dumm wie die Menschen, auf die jene Redensart metaphorisch angewandt wird.“"
                                            },
                                            {
                                                "example_id": "32652111-0402-4a85-9a13-3e56a1082078",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Daher könnte man das Wohlwollen metaphorisch eine untätige Freundschaft nennen, die aber, wenn sie länger dauert und zur Vertrautheit wird, in wirkliche Freundschaft übergeht, eine Freundschaft nicht wegen des Vorteils oder der Lust, da wegen solcher Dinge kein Wohlwollen entsteht.“"
                                            },
                                            {
                                                "example_id": "4f2236cd-7941-4908-8708-b3ce7df683a8",
                                                "sense_id": "38b39719-0d59-3eb5-b554-34b47e6a4726",
                                                "text": "„Formen metaphorischen Ausdrucks können statistisch so häufig werden, daß sie eine neue Norm etablieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd39b7ae-43bc-3a9d-8529-bff8d0f71376",
                                        "entry_id": "5b00ac24-858a-3ff2-a091-d9c33a5b2ad0",
                                        "glosses": [
                                            "auf die Metapher bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
