{
    "word_family": [
        "barricade",
        "débarricader"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18696f64-e082-35cb-8474-cc5c93a8fffe",
                    "sense_definition": "Fermer, bloquer ou obstruer un passage, une rue ou une ouverture au moyen d'obstacles ou de barricades.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants ont décidé de <w>barricader</w> les rues avec des conteneurs pour bloquer la circulation."
                        },
                        {
                            "text": "Avant l'arrivée de la violente tempête, les habitants ont préféré <w>barricader</w> les portes et fenêtres."
                        }
                    ],
                    "synonyms": [
                        "bloquer",
                        "obstruer",
                        "verrouiller"
                    ],
                    "antonyms": [
                        "débloquer",
                        "dégager",
                        "ouvrir"
                    ],
                    "common_phrases": [
                        "barricader les portes",
                        "barricader les rues"
                    ]
                },
                {
                    "sense_id": "a4971ea8-df76-3536-b69b-1b5b8ed22e12",
                    "sense_definition": "S'enfermer dans un endroit en en bloquant tous les accès afin de se défendre ou de se mettre à l'abri d'un danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les villageois ont couru pour se <w>barricader</w> dans la mairie dès que les troupes ont approché."
                        },
                        {
                            "text": "Effrayée par des bruits menaçants, toute la famille s'est empressée de se <w>barricader</w> dans la cave."
                        }
                    ],
                    "synonyms": [
                        "se retrancher",
                        "s'enfermer"
                    ],
                    "antonyms": [
                        "s'exposer",
                        "sortir"
                    ],
                    "common_phrases": [
                        "se barricader dans la maison",
                        "se barricader dans un abri"
                    ]
                },
                {
                    "sense_id": "29f860e5-01d1-3e7d-999e-cd8ca9354472",
                    "sense_definition": "S'isoler complètement du monde extérieur, refuser toute visite ou tout contact avec autrui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis cette douloureuse rupture, il préfère se <w>barricader</w> chez soi plutôt que d'affronter le regard des autres."
                        },
                        {
                            "text": "Pour terminer la rédaction de sa thèse sans distraction, elle a choisi de se <w>barricader</w> dans son bureau."
                        }
                    ],
                    "synonyms": [
                        "se cloîtrer",
                        "s'isoler",
                        "se renfermer"
                    ],
                    "antonyms": [
                        "s'ouvrir"
                    ],
                    "common_phrases": [
                        "se barricader chez soi",
                        "se barricader dans son bureau"
                    ]
                }
            ]
        }
    ]
}