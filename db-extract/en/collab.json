                    {
                        "sense_id": "63218cd5-7f9a-3b7e-b6fe-24b385f6450e",
                        "entry_id": "66b1ab54-9aed-345d-839e-6e4079da1224",
                        "glosses": [
                            "A collaboration, especially a work produced by several musicians who do not usually work together."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b6178ec0-7168-492a-8f87-c3d279f14beb",
                                "sense_id": "63218cd5-7f9a-3b7e-b6fe-24b385f6450e",
                                "text": "In one small way, Madonna's current single, Give Me All Your Luvin', marks the end of an era. It's the last time for the foreseeable future that Nicki Minaj, who guest-raps on it, intends to collaborate with another artist. \"I'm done with the collabs,\" she said last year. \"No more collabs for the next two years.\""
                            },
                            {
                                "example_id": "e71cca48-bc79-420d-ad8f-25e0a984d63c",
                                "sense_id": "63218cd5-7f9a-3b7e-b6fe-24b385f6450e",
                                "text": "UMISEA is a subunit in Hololive featuring idols with nautical themes. The group debuted in 2021 as the first JP+EN collab subunit. Chloe was added to the roster after holox debuted."
                            }
                        ]
                    }
                ],
