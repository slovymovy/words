    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "277498f9-3c3a-3e9f-953a-a6c7176aadba",
                    "sense_definition": "Een bepaalde houding, gevoel of eigenschap duidelijk laten merken of tonen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>straalt</w> altijd veel rust <w>uit</w> als hij voor een grote groep spreekt.",
                            "target_lang_translations": {
                                "en": "He always <w>radiates</w> a lot of calmness when speaking in front of a large group."
                            }
                        },
                        {
                            "text": "Ze <w>straalde</w> zelfvertrouwen <w>uit</w> tijdens het sollicitatiegesprek.",
                            "target_lang_translations": {
                                "en": "She <w>exuded</w> confidence during the job interview."
                            }
                        }
                    ],
                    "synonyms": [
                        "tonen",
                        "uitzenden"
                    ],
                    "common_phrases": [
                        "zelfvertrouwen uitstralen",
                        "rust uitstralen"
                    ],
                    "target_lang_definitions": {
                        "en": "To clearly show or display a certain attitude, feeling, or quality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "radiate",
                                "target_lang_sense_clarification": "manifest a quality or feeling strongly"
                            },
                            {
                                "target_lang_word": "exude",
                                "target_lang_sense_clarification": "display an emotion or quality abundantly"
                            },
                            {
                                "target_lang_word": "project",
                                "target_lang_sense_clarification": "present a certain impression or image"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7e5230b-bb45-39bf-913c-d5093185a007",
                    "sense_definition": "Energie, licht of warmte straalsgewijs naar de omgeving verspreiden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kachel <w>straalt</w> een heerlijke warmte <w>uit</w> in de winter.",
                            "target_lang_translations": {
                                "en": "The stove <w>radiates</w> a wonderful warmth in winter."
                            }
                        },
                        {
                            "text": "De zon <w>straalt</w> licht en warmte <w>uit</w> over de aarde.",
                            "target_lang_translations": {
                                "en": "The sun <w>emits</w> light and heat over the earth."
                            }
                        }
                    ],
                    "synonyms": [
                        "emitteren",
                        "verspreiden"
                    ],
                    "antonyms": [
                        "absorberen"
                    ],
                    "common_phrases": [
                        "warmte uitstralen",
                        "licht uitstralen"
                    ],
                    "target_lang_definitions": {
                        "en": "To disperse energy, light, or heat outwards into the surroundings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "radiate",
                                "target_lang_sense_clarification": "emit rays, waves, heat, or light"
                            },
                            {
                                "target_lang_word": "emit",
                                "target_lang_sense_clarification": "send out heat, light, or energy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
