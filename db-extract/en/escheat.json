                "senses": [
                    {
                        "sense_id": "a2d75744-b21d-3ce7-a90b-ecc7f83f1a1f",
                        "entry_id": "8798e897-f225-33e1-bfda-d11d896a5f8e",
                        "glosses": [
                            "etwas (üblicherweise Land) fällt an den Eigentümer wegen Heimfalls zurück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fb9122-3f78-4b89-b359-6cbc1e06cbed",
                                "sense_id": "a2d75744-b21d-3ce7-a90b-ecc7f83f1a1f",
                                "text": "„Certain estates escheated to the commonwealth vested in certain individuals.“",
                                "translation": "Bestimmte Ländereien fielen an das Gemeinwesen zurück, wozu einige Personen berechtigt waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9f259e6-20b3-4d0a-9eea-6895e8c0ca7e",
                        "source_entry_id": "8798e897-f225-33e1-bfda-d11d896a5f8e",
                        "source_sense_id": "a2d75744-b21d-3ce7-a90b-ecc7f83f1a1f",
                        "source_sense_description": "Recht: etwas (üblicherweise Land) fällt an den Eigentümer wegen Heimfalls zurück",
                        "target_lang_word": "zurückfallen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zurückfallen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "49178ebc-6a76-3dd6-b805-8b1a39c55167",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "in einem Rennen nicht mehr mithalten / hinter den Gegnern zurückbleiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f21bd4a-feae-4b1a-b3fa-e8b38cb09d53",
                                                "sense_id": "49178ebc-6a76-3dd6-b805-8b1a39c55167",
                                                "text": "Beim letzten Marathon konnte ich ab Kilometer 30 nicht mehr mit der Spitze mithalten und fiel zurück."
                                            },
                                            {
                                                "example_id": "7d5c6728-008a-4c8f-a618-bb6ec9c17a19",
                                                "sense_id": "49178ebc-6a76-3dd6-b805-8b1a39c55167",
                                                "text": "[Ironman / Hawaii:] „Die Ex-Schwimmerin Lucy Charles-Barclay aus Großbritannien steigt als Erste aus dem Pazifik und bestreitet auch die 180 Radkilometer an der Spitze. Hinter ihr fällt die große Favoritin Daniela Ryf immer weiter zurück.“"
                                            },
                                            {
                                                "example_id": "372e1d1b-82cc-4a30-be83-e057ab64aa34",
                                                "sense_id": "49178ebc-6a76-3dd6-b805-8b1a39c55167",
                                                "text": "[Skilanglauf:] „Der Norweger [Anmerkung: Johannes Kläbo] feierte nach rund 29 Minuten einen abgezockten Sieg. Zuerst liess er sich zurückfallen, um dann im Schlusssprint zuzuschlagen.“"
                                            },
                                            {
                                                "example_id": "4c54375c-f81f-4170-bdff-4950ebed40ad",
                                                "sense_id": "49178ebc-6a76-3dd6-b805-8b1a39c55167",
                                                "text": "Der Bundesligist 1. FC Köln fiel nach der Niederlage in der letzten Woche in der Tabelle auf den letzten Platz zurück."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "in den Leistungen schlechter werden; sich verschlechtern; sinken"
                                        ],
                                        "tags": [
                                            "in Anlehnung an Bedeutung [1]"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c544e0cc-36a7-4fc4-9ac4-6c13ade07d14",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Die europakritische AfD konnte in Ludwigshafen aus dem Stand 8,0 Prozent erreichen, die FDP fiel zurück auf 3,7 Prozent (-2,8), noch hinter FWG und Linke.“"
                                            },
                                            {
                                                "example_id": "40eec1db-56f5-4dd3-a7b1-0ea6771c3e45",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Audi ist seit der Aufdeckung des Dieselskandals 2015 auf Talfahrt und deutlich hinter die Konkurrenten Daimler und BMW zurückgefallen.“"
                                            },
                                            {
                                                "example_id": "18c18d20-2b9b-4c80-ad12-02c698a31b54",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Die Zahlen zeigen eben auch, wie weit die Deutsche Bank hinter die Konkurrenz – vor allem aus den USA – zurückgefallen ist.“"
                                            },
                                            {
                                                "example_id": "76b11453-875a-4005-b9b0-6483570680a7",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Schleswig-Holstein ist im Ländervergleich bei der Bildung um einen Platz zurückgefallen. In dem Bildungsmonitor 2019 des unternehmernahen Kölner Instituts der deutschen Wirtschaft (IW) landete das Bundesland auf Rang 11.“"
                                            },
                                            {
                                                "example_id": "85d445ed-3329-40c0-a7d6-a6a8f0dd8d40",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "Nach der langen Krankheit merkte er, dass er in der Schule zurückgefallen war."
                                            },
                                            {
                                                "example_id": "2ac3841a-e0e5-47a8-b384-a6656b673196",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Bei einem Urnengang würden die Sterne auf den dritten Platz in der Wählergunst zurückfallen.“"
                                            },
                                            {
                                                "example_id": "ae4394a5-6bf8-413b-8350-3883d74a39c6",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Die Auftragseingänge sind auf den niedrigsten Stand seit 2012 zurückgefallen.“"
                                            },
                                            {
                                                "example_id": "30628ec8-476a-4ffb-8db6-bd6d436c1d6a",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Leider ist aktuell zu beobachten, dass Deutschland beim Thema Open Source hinter die Nachbarländer - wie eben Frankreich - zurückfällt.“"
                                            },
                                            {
                                                "example_id": "8825f4f9-addd-421a-84c1-7599f0511701",
                                                "sense_id": "cd4f4578-cfae-3e8a-aa25-2ad14f93dde0",
                                                "text": "„Vor französischen Bürgern in Osaka kündigte Macron an, er werde keine G20-Erklärung mittragen, die hinter den Text der letzten Gipfel zurückfalle und das Pariser UN-Abkommen zum Klimaschutz nicht bestätige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "da3c1b59-941e-3b2c-aaaf-907c0100e355",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "nach hinten fallen; auf den Rücken fallen; wieder in die Ausgangsstellung fallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "802213af-fac9-452c-aa5b-3f2dfcf100d9",
                                                "sense_id": "da3c1b59-941e-3b2c-aaaf-907c0100e355",
                                                "text": "Der Kopf des Verletzen fiel auf den Boden zurück."
                                            },
                                            {
                                                "example_id": "fce94397-65bb-4be6-a845-cce6d2117818",
                                                "sense_id": "da3c1b59-941e-3b2c-aaaf-907c0100e355",
                                                "text": "Ein Windstoß bauschte die Gardine hinter dem offenen Fenster, dann war die Bö weg und sie fiel wieder zurück bis sie glatt herunterhing."
                                            },
                                            {
                                                "example_id": "9fbc6ea6-db6d-402b-a38a-80a0dcdde151",
                                                "sense_id": "da3c1b59-941e-3b2c-aaaf-907c0100e355",
                                                "text": "„Laut Notizen einer Mitarbeiterin von Sessions sei Trump daraufhin in seinen Stuhl zurückgefallen und habe gesagt: »Oh mein Gott. Das ist furchtbar. Das ist das Ende meiner Präsidentschaft. Ich bin erledigt.« Im Original: »I'm fucked.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bcbde0db-ed51-3167-b574-2e610c057ad5",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "Eigentum zurück zum Vorbesitzer wechseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab9b9716-de4a-4325-94f9-481101df3cbc",
                                                "sense_id": "bcbde0db-ed51-3167-b574-2e610c057ad5",
                                                "text": "Nach dem Ablauf der Pachtzeit von 99 Jahren fallen Grundstück samt Gebäude an die Kirche zurück."
                                            },
                                            {
                                                "example_id": "8b227424-764a-4042-8e7d-c4170007008d",
                                                "sense_id": "bcbde0db-ed51-3167-b574-2e610c057ad5",
                                                "text": "„Hongkong war damals [Anmerkung: 1977] eine britische Kolonie. […] beide Länder hatten vereinbart, dass die Stadt 1997 an China zurückfallen sollte.“"
                                            },
                                            {
                                                "example_id": "ec2034c2-6d54-45a8-931f-6049f45b0adb",
                                                "sense_id": "bcbde0db-ed51-3167-b574-2e610c057ad5",
                                                "text": "„Wenn ein Landbesitzer nicht innerhalb der festgesetzten Frist baut, soll das eingezonte Land entschädigungslos in die Landwirtschaftszone zurückfallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "eine schlechte Angewohnheit wieder aufnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7221334d-0262-48f1-bb56-a93595d6cd55",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "Mit der Arbeitslosigkeit fing er wieder an zu trinken und fiel noch in andere schlechte Gewohnheiten zurück."
                                            },
                                            {
                                                "example_id": "ab1ce571-f5f0-41ba-8b2c-12a8e9236085",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„Ein Rückfall tritt nicht auf, wenn Sie nach einer Zigarette sofort entscheiden: STOPP, keine weitere Zigarette! Wer jedoch nach einer Zigarette aufgibt und denkt »Jetzt ist doch alles egal, da kann ich gleich weiterrauchen«, wird rasch wieder in das alte Rauchverhalten zurückfallen.“"
                                            },
                                            {
                                                "example_id": "13dd7f71-3496-4e58-9d66-a76782f17f01",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„Laura hat eine lange Leidensgeschichte: Schon mit 13 Jahren musste sie ein Dreivierteljahr auf Abspeckkur, fiel aber wieder in alte Muster zurück.“"
                                            },
                                            {
                                                "example_id": "65d11020-b260-444d-b5ee-584ac2f87d67",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„In den vergangenen zwei Jahren hatten China und die USA gemeinsam eine Führungsrolle beim Klimaschutz beansprucht. Aber jetzt sehen viele Fachleute die Gefahr, dass die Amerikaner in alte Muster zurückfallen, dass US-Delegationen bei Klimagipfeln bremsen und blockieren.“"
                                            },
                                            {
                                                "example_id": "e45cd93d-81cc-43eb-8641-7573772bfc7b",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„[…] nach einem ersten Erfolg war ich in alte Verhaltensmuster zurückgefallen. Der Versuch, mittels App meinen Konsum zu begrenzen, scheiterte grandios.“"
                                            },
                                            {
                                                "example_id": "068950a1-3b48-4ba9-84ac-b4f1f6eef7fa",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„[…] Ohne die kleinen technischen Helfer lässt sich kaum objektiv abschätzen, ob der Neujahrsvorsatz, sich wieder mehr zu bewegen, geklappt hat oder ob man schon wieder in den Couch-Potato-Modus zurückgefallen ist.“"
                                            },
                                            {
                                                "example_id": "97b3caa9-4661-4cba-8e26-730d9adb7fc2",
                                                "sense_id": "ee1ce7ee-18a2-3e18-9eeb-95dd92c66a41",
                                                "text": "„Später, zu Zeiten der Völkerwanderung, als Europa in die Barbarei zurückfiel, ging nicht nur das römische Straßennetz unter, sondern auch die gemeinsame Sprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "74636ed1-b013-34ff-a7f3-bf983d10a3bb",
                                        "entry_id": "f7361b1e-29e8-31c1-abd9-cc6ce8c7c8df",
                                        "glosses": [
                                            "jemandes Ruf aufgrund dessen schlechten Verhaltens schädigen"
                                        ],
                                        "tags": [
                                            "auf jemanden (Akkusativ) zurückfallen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e12cbef-03f8-42ba-90e3-b6a8ff7887d8",
                                                "sense_id": "74636ed1-b013-34ff-a7f3-bf983d10a3bb",
                                                "text": "Sein schlechtes Benehmen fällt auf die ganze Familie zurück."
                                            },
                                            {
                                                "example_id": "daa5bbe1-ac21-464b-814b-00ff3a99a392",
                                                "sense_id": "74636ed1-b013-34ff-a7f3-bf983d10a3bb",
                                                "text": "„[…] das Material, das eine Bodycam aufgezeichnet hat, [kann] ja auch auf die Beamten selbst zurückfallen. »Wenn was vorfällt, wird das natürlich herangezogen werden können, um das Verhalten der Polizeibeamten zu kontrollieren.«“"
                                            },
                                            {
                                                "example_id": "66f3f547-c843-4b5e-89a9-94386addda48",
                                                "sense_id": "74636ed1-b013-34ff-a7f3-bf983d10a3bb",
                                                "text": "„[…] der Vorstand [fürchtete], dass die mögliche illegale Verwendung des Programms auf Fedora-Distributoren zurückfallen könnte, und ließ die Aufnahme in die Repositorien nicht zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
