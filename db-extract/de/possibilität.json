                "senses": [
                    {
                        "sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                        "entry_id": "009090db-0649-30c5-9796-1bfdb03f64c4",
                        "glosses": [
                            "Möglichkeit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5d9f21ea-3ac9-4194-9e96-2762d97f2afd",
                                "sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                                "text": "Es können sich viele Possibilitäten ergeben, die einem helfen weiter zu kommen."
                            },
                            {
                                "example_id": "5066e8e5-727f-4122-bfde-5f403d003d86",
                                "sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                                "text": "„Kurzum: die Macht erscheint neben der den endlichen Dingen zukommenden metaphysischen Potentialität und der dem göttlichen oder menschlichen Denken entsprechenden Possibilität als die Möglichkeit des Willens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6daa1ea-4309-4907-b015-762723521f64",
                        "source_entry_id": "009090db-0649-30c5-9796-1bfdb03f64c4",
                        "source_sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                        "source_sense_description": "veraltet: Möglichkeit",
                        "target_lang_word": "可能性",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "可能性",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "858878ae-6ff1-3e75-acbf-c471bbbdd3d5",
                                        "entry_id": "8165b208-cc60-3060-b432-f9912f10e3f4",
                                        "glosses": [
                                            "能成為事實的屬性"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d6a36a2-588f-4e3c-9e47-bae5ac1f6b73",
                                                "sense_id": "858878ae-6ff1-3e75-acbf-c471bbbdd3d5",
                                                "text": "這件工程，提早完工的可能性很大。"
                                            },
                                            {
                                                "example_id": "0649c8ac-d0d1-4733-b836-5aaae9e56a6b",
                                                "sense_id": "858878ae-6ff1-3e75-acbf-c471bbbdd3d5",
                                                "text": "这件工程，提早完工的可能性很大。"
                                            },
                                            {
                                                "example_id": "b7e6d2a6-ed0a-4b53-9e1b-bea3380d7646",
                                                "sense_id": "858878ae-6ff1-3e75-acbf-c471bbbdd3d5",
                                                "text": "如果生存就是自由的去選擇我的可能性，為什麼在最天生的可能性中，我就無法做出選擇？"
                                            },
                                            {
                                                "example_id": "f7182d33-6eb2-4cd5-8c34-40cf04d0fb24",
                                                "sense_id": "858878ae-6ff1-3e75-acbf-c471bbbdd3d5",
                                                "text": "如果生存就是自由的去选择我的可能性，为什么在最天生的可能性中，我就无法做出选择？"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8fc55d9-0d38-46e8-b09f-5fe3a915b7d3",
                        "source_entry_id": "009090db-0649-30c5-9796-1bfdb03f64c4",
                        "source_sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                        "source_sense_description": "veraltet: Möglichkeit",
                        "target_lang_word": "possibility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e34b2b30-a98b-3ed9-9ec4-12b1e4303612",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "The quality of being possible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2360fe4-de9a-4571-8f92-60e0dec0fa82",
                                                "sense_id": "e34b2b30-a98b-3ed9-9ec4-12b1e4303612",
                                                "text": "'There is little possibility of that happening' 'I'd say there's rather a strongish possibility that it won't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313a99ab-5283-3b93-b451-43ec3673f201",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "A thing possible; that which may take place or come into being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e26774-fa97-483e-9fe6-6fe7e96bfba7",
                                                "sense_id": "313a99ab-5283-3b93-b451-43ec3673f201",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cde4a0e-0f5d-3189-963e-843dfa2e7ee2",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "An option or choice, usually used in context with future events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab4e261-36d4-4cb3-bb31-1b207f4f38af",
                                                "sense_id": "5cde4a0e-0f5d-3189-963e-843dfa2e7ee2",
                                                "text": "Mycelial lives are so other, their possibilities so strange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a06583-097d-314f-9d73-3cc797c69f6b",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "Capability, power or capacity to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a67f68b-b3c2-4ca2-acb3-6070e30c800d",
                                                "sense_id": "d4a06583-097d-314f-9d73-3cc797c69f6b",
                                                "text": "VVere Iacke Strawe a liue againe,\nAnd I in as good poſſibility as euer I was,\nI would lay a ſurer trumpe,\nEre I would loſe ſo faire a tricke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "874d68dc-b860-42bc-9987-a1bd8acc9555",
                        "source_entry_id": "009090db-0649-30c5-9796-1bfdb03f64c4",
                        "source_sense_id": "cbcbbc18-2518-39fd-9e58-d57a1c2d2951",
                        "source_sense_description": "veraltet: Möglichkeit",
                        "target_lang_word": "possibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibilité",
