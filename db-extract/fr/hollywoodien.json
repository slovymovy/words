                "senses": [
                    {
                        "sense_id": "bc6bf16f-3c33-395a-9394-ebe1a59b8feb",
                        "entry_id": "c56faeb7-b738-39d6-bb3d-92072d8de0b3",
                        "glosses": [
                            "Relatif à Hollywood, à ses occupants, au cinéma qui s’y pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1f5f80-163b-465b-84f2-fbbc43a82ce1",
                                "sense_id": "bc6bf16f-3c33-395a-9394-ebe1a59b8feb",
                                "text": "Version ultraséduisante chez Fuller (Le Port de la drogue) qui utilisa sa nervosité au service d’une sorte de pédagogie amoureuse aussi violente qu’efficace, lorsqu’un homme et une femme construisent une histoire d’amour à coups de gifles (reçues par Jean Peters, la meilleure des teigneuses hollywoodiennes)."
                            },
                            {
                                "example_id": "267a8e3b-7339-4c55-b49e-8902df10b8bc",
                                "sense_id": "bc6bf16f-3c33-395a-9394-ebe1a59b8feb",
                                "text": "Preuve, s'il en faut, qu'on ne naît pas compositeur hollywoodien : on le devient."
                            },
                            {
                                "example_id": "7f9009cf-5905-4cfd-b6ed-29e98163cade",
                                "sense_id": "bc6bf16f-3c33-395a-9394-ebe1a59b8feb",
                                "text": "En privant le privé de son happy end habituel, en blessant sa virilité donjuanesque qui lui tient lieu de bonne éducation, elle envoie dire à tous les surmâles hollywoodiens de son espèce que les temps sont en train de changer."
                            }
                        ]
                    }
                ],
