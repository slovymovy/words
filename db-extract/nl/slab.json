                ],
                "senses": [
                    {
                        "sense_id": "be394130-5eef-3671-bdc7-cc91bb35521c",
                        "entry_id": "fd7fae22-4f8f-3082-8719-cf2ed3b689ef",
                        "glosses": [
                            "doekje waarop met name een kind kan morsen tijdens het eten of drinken zodat de kleren schoon blijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83969a8-351b-42a8-b487-62c275e90a19",
                                "sense_id": "be394130-5eef-3671-bdc7-cc91bb35521c",
                                "text": "Ze hadden een handdoek als slab omgehangen. Het waren geen beelden die je van je moeder rondgestuurd wilt zien.’"
                            },
                            {
                                "example_id": "5255d44b-4bb3-44b2-af23-bd098afda159",
                                "sense_id": "be394130-5eef-3671-bdc7-cc91bb35521c",
                                "text": "De schoondochter: 'Soms is het gehoorapparaat van mijn moeder niet opgeladen. Of zijn de veters van haar schoenen niet gestrikt. Of ze vergeten haar tijdens het eten een slab om te doen. Ik kom elke dag, maar de communicatie kan beter. Sommigen hier vinden mij lastig.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d106db2-47ce-44ab-b310-cf3640150659",
                        "source_entry_id": "fd7fae22-4f8f-3082-8719-cf2ed3b689ef",
                        "source_sense_id": "be394130-5eef-3671-bdc7-cc91bb35521c",
                        "source_sense_description": "doekje om op te morsen",
                        "target_lang_word": "Latz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Latz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                        "entry_id": "43c7237c-b21a-31a4-87d0-06dfa23a7c31",
                                        "glosses": [
                                            "Brustteil eines Bekleidungsstückes, oft zwei Träger und ein verbindendes Mittelstück als oberes Teil einer Hose oder eines Rocks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd85d099-549d-4810-96e8-10ff6be5cb5e",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Soll ich Dir einen Latz annähen?"
                                            },
                                            {
                                                "example_id": "1add4504-cd8a-46f2-a74d-3c7ad7b7c85b",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Auf dem Latz prangte ein kleines Amulett aus Hirschgeweih."
                                            },
                                            {
                                                "example_id": "1362ff80-11f9-4199-8b9a-910965d5109d",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "Und dann hat er Schluss gemacht und mir das einfach so vor den Latz geknallt, ohne jede Vorwarnung, verstehst du das?"
                                            },
                                            {
                                                "example_id": "d6856959-b95c-4f49-ae0b-7894f2bf571e",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "„Er zog am Latz seines Overalls, bog den Kopf zurück und spähte auf die Innenseite.“"
                                            },
                                            {
                                                "example_id": "4bad9405-6fa3-4c28-b509-599fb7072fde",
                                                "sense_id": "0b07d4de-5e11-3529-837b-e8a3b58c7c7c",
                                                "text": "„Außerdem ist nicht sicher, ob du die Antwort wirklich vor den Latz geknallt bekommen möchtest, das ist nicht immer wünschenswert; manche Antworten führen zu nichts als weiteren Fragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                        "entry_id": "43c7237c-b21a-31a4-87d0-06dfa23a7c31",
                                        "glosses": [
                                            "Teil einer Hose, der sich öffnen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "808e4831-4f37-4ce0-9580-0aed39421c86",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "Nu mach mal den Latz zu, so kannst du doch nicht herumlaufen."
                                            },
                                            {
                                                "example_id": "039a09c8-d809-464a-b944-5af5e20b8b14",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "„Adrienne zog mich aufs Parkett, mein Latz stand weit offen.“"
                                            },
                                            {
                                                "example_id": "f4f9dd28-0f9f-4491-afd0-41f37ff3f355",
                                                "sense_id": "e59ff0f0-b67b-3742-8153-8cbbb5a481e4",
                                                "text": "„Eine Hose mit großem Latz, die unten auf den Kastorschuhen Falten warf, schmiegte sich prall an seinen Bauch und bauschte sein Hemd am Gürtel; und sein blondes Haar, das sich von selbst in leichten Wellen kräuselte, verlieh ihm etwas Kindliches.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61ed2f4b-e81e-4537-9748-f651b7da2bd1",
                        "source_entry_id": "fd7fae22-4f8f-3082-8719-cf2ed3b689ef",
                        "source_sense_id": "be394130-5eef-3671-bdc7-cc91bb35521c",
                        "source_sense_description": "doekje om op te morsen",
                        "target_lang_word": "Lätzchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lätzchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88b097bb-305f-32d9-a9a6-ba1b888a1636",
                                        "entry_id": "ee328eae-fbde-335c-bc12-0dd4d7954309",
                                        "glosses": [
                                            "kleines Tuch als Schutz vor Verschmutzung beim Essen, das um den Hals herum gebunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7641b9ba-5015-4e90-9e08-a739bae24bf5",
                                                "sense_id": "88b097bb-305f-32d9-a9a6-ba1b888a1636",
                                                "text": "Den Kleinkindern bindet man vor dem Essen ein Lätzchen um den Hals."
                                            },
                                            {
                                                "example_id": "087d1e46-a4ba-4a6d-bdef-20541a587a60",
                                                "sense_id": "88b097bb-305f-32d9-a9a6-ba1b888a1636",
                                                "text": "Gustav empfand es als sehr erniedrigend, dass man ihm ein Lätzchen umband, was dachten sie bloß von ihm."
                                            },
                                            {
                                                "example_id": "6277d7fd-67df-493d-a3b5-fdc573d62040",
                                                "sense_id": "88b097bb-305f-32d9-a9a6-ba1b888a1636",
                                                "text": "„Wiebke hatte noch ihr Lätzchen.“"
                                            },
                                            {
                                                "example_id": "23da934c-88cc-408c-a9ac-73d4aeaf6513",
                                                "sense_id": "88b097bb-305f-32d9-a9a6-ba1b888a1636",
                                                "text": "„Außerdem erwartete er von einem Geistlichen immer, er habe ein Lätzchen unter dem Kinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
