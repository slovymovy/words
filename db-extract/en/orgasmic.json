                    {
                        "sense_id": "08a8b202-de97-34c7-a612-96dba8f7e429",
                        "entry_id": "de3f7d9b-0f9a-391c-a44c-facc450445e3",
                        "glosses": [
                            "Prone to or capable of having orgasms."
                        ],
                        "tags": [
                            "comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b110522-1273-4638-bf8d-be34806f5b78",
                                "sense_id": "08a8b202-de97-34c7-a612-96dba8f7e429",
                                "text": "Seemingly every year, another study announces that married women are more orgasmic than single women."
                            },
                            {
                                "example_id": "1e8ab102-be05-456d-82cf-0a95e20e4c16",
                                "sense_id": "08a8b202-de97-34c7-a612-96dba8f7e429",
                                "text": "They've helped non-orgasmic women become orgasmic, they've helped orgasmic women become more orgasmic, and they've helped many women experience their first multiple orgasms (we'll talk about that later!)."
                            },
                            {
                                "example_id": "7ce16c2b-ec75-4934-b6da-fdff2f02cebb",
                                "sense_id": "08a8b202-de97-34c7-a612-96dba8f7e429",
                                "text": "The gentler the sensation or touch the more orgasmic I am."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e6eca3e-8460-3712-9f48-1bc7c742e516",
                        "entry_id": "de3f7d9b-0f9a-391c-a44c-facc450445e3",
                        "glosses": [
                            "Very exciting or stimulating."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb252248-d326-4d88-b199-9abc6e338abb",
                                "sense_id": "1e6eca3e-8460-3712-9f48-1bc7c742e516",
                                "text": "It must be an orgasmic experience to be an astronaut and see the Earth as a little, colourful marble surrounded by blackness."
                            }
                        ]
