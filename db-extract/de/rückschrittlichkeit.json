                "senses": [
                    {
                        "sense_id": "8b8e182e-cf46-3c86-903f-3afa6662fb9d",
                        "entry_id": "17d7e4a4-c722-3fb1-ab03-34f31a26488c",
                        "glosses": [
                            "feindliche Einstellung gegenüber dem Fortschritt; Haltung, die dem Erreichen eines Zieles entgegenläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f62747-17b8-4099-ac4b-1d7993923127",
                                "sense_id": "8b8e182e-cf46-3c86-903f-3afa6662fb9d",
                                "text": "„Die Reichspublizistik war zu den allergrößten Teilen fest in evangelischer Hand, einer Rückschrittlichkeit war sich die katholische Seite in diesen Belangen sehr bewusst.“"
                            },
                            {
                                "example_id": "95349b8e-864c-4209-86cb-f36ea52bef13",
                                "sense_id": "8b8e182e-cf46-3c86-903f-3afa6662fb9d",
                                "text": "„Analphabetismus gehört nach Taqizādeh zu den offensichtlichen Ursachen der Rückschrittlichkeit Irans.“"
                            },
                            {
                                "example_id": "11a4d31f-0b7a-488a-8df0-358efffa3fef",
                                "sense_id": "8b8e182e-cf46-3c86-903f-3afa6662fb9d",
                                "text": "„Eine kunst- und kulturwissenschaftliche Analyse visueller Politiken ebenfalls auf diese gängige Erzählung der Dichotomie von Stadt und Land mit ihrer Verbindung von Fort- und Rückschrittlichkeit aufmerksam.“"
                            },
                            {
                                "example_id": "ed6d2b34-aa5b-4913-b114-d9c2e17ac5d4",
                                "sense_id": "8b8e182e-cf46-3c86-903f-3afa6662fb9d",
                                "text": "„Statt Armut, Rückschrittlichkeit, Korruption und Klimadesaster gebe es dort draußen eine unbekannte Welt des unvorstellbaren Reichtums und der Wunder.“"
                            }
                        ],
