                        "examples": [
                            {
                                "example_id": "a01dd860-e35b-47d9-aaea-750437b114ee",
                                "sense_id": "99c21099-a3b8-34d1-ab66-4d46fd61fb27",
                                "text": "„In die Gebäude hatte sich stacheliges Unkraut eingenistet, und Berge aus Traktorreifen wurden von krümeligen Blumen mit rosa-violettem Anstrich verhüllt.“"
                            },
                            {
                                "example_id": "0591a3e2-5a2a-4a6a-8c80-094217203ce5",
                                "sense_id": "99c21099-a3b8-34d1-ab66-4d46fd61fb27",
                                "text": "„Eine Monsterzunge walzt heran, übersät mit Geschmacksknospen groß wie Fliegenpilze. Und rundherum Lippen so fett wie ölige Traktorreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
