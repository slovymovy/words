                },
                {
                    "sense_id": "46a48cd3-6e0f-3f47-9c36-8331275596fd",
                    "sense_definition": "Побег растения, который резко отличается внешним видом от остальных частей вследствие мутации.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Садовник обнаружил на кусте розы необычный <w>спорт</w> с другим цветом лепестков.",
                            "target_lang_translations": {
                                "en": "The gardener discovered an unusual <w>sport</w> on the rose bush with a different petal color.",
                                "zh": "园丁在玫瑰丛上发现了一个花瓣颜色不同的奇异<w>芽变</w>。"
                            }
                        },
                        {
                            "text": "Дарвин подробно описывал, как появляется <w>спорт</w> у различных видов растений.",
                            "target_lang_translations": {
                                "en": "Darwin described in detail how a <w>sport</w> appears in various plant species.",
                                "zh": "达尔文详细描述了不同植物物种中如何出现<w>芽变</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "почковая мутация",
                        "вегетативная мутация",
                        "игра почек"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant shoot that differs sharply in appearance from the rest due to mutation.",
                        "zh": "植物因突变而产生的与其余部分外观迥异的枝条。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sport",
                                "target_lang_sense_clarification": "biological mutation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芽变",
                                "target_lang_sense_clarification": "植物学中的突变现象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e7e67d6-3151-3fa7-bcf1-73c00036c88b",
                    "sense_definition": "Парень или мужчина спортивного телосложения (в сленге ЛГБТ).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На вечеринке он сразу заметил высокого <w>спорта</w> у барной стойки.",
                            "target_lang_translations": {
                                "en": "At the party, he immediately noticed a tall <w>jock</w> at the bar.",
                                "zh": "在派对上，他一眼就注意到了吧台边那个高大的<w>健壮男子</w>。"
                            }
                        },
                        {
                            "text": "В этом клубе часто собираются <w>спорты</w> после тренировок.",
                            "target_lang_translations": {
