                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4596e545-8696-41f9-920e-7b9f48f7d65f",
                                "sense_id": "fd58411e-c1dd-389d-a6fb-69dcafdb8963",
                                "text": "... je mis la chaîne autour de mon cou et demandai à ma bien-aimée de m'épouser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b109779-48f5-4f7a-ab77-6a2481560470",
                        "source_entry_id": "07d72cfc-7d08-31e3-bd68-421b7295bf5b",
                        "source_sense_id": "fd58411e-c1dd-389d-a6fb-69dcafdb8963",
                        "source_sense_description": "Féminin singulier de bien-aimé",
                        "target_lang_word": "Weib",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weib",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                        "entry_id": "540cf1ac-046a-367d-80dd-cbadfde18781",
                                        "glosses": [
                                            "verächtliche Bezeichnung für eine Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4f75061-7a85-4423-8cd7-bb6af62d44e1",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "Dieses Weib geht mir auf die Nerven, schaff sie raus."
                                            },
                                            {
                                                "example_id": "075e58d2-6637-4426-8339-18e64ca5211a",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "„Seine Erfolge bei den Weibern hatten ihn belehrt, daß es auf Schönheit nicht ankam.“"
                                            },
                                            {
                                                "example_id": "ee1c296f-bab5-49f2-a7e6-9e6d2e99590c",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "„Mehrere Male in der Woche schleppte er Weiber mit nach Hause, warf Emma kurzerhand aus dem Bett und packte sich mit ihnen grunzend da hinein.“"
                                            },
                                            {
                                                "example_id": "705bfe20-2aaf-4767-b157-3dcf601bb6e0",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "„Mit ihr ist das fahrlässige Weib in das fahrende Patriarchat der Herren eingebrochen und kreuzt mit seiner angestammten Rechthaberei und Hysterie die männliche Fahrbahn.“"
                                            },
                                            {
                                                "example_id": "ddaf9b4a-570f-4347-bba0-85c184f1c71b",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "Er ist hinter den Weibern her."
                                            },
                                            {
                                                "example_id": "241cc668-6f9d-4768-9a2f-a8ea2e8be077",
                                                "sense_id": "c9ae7e47-4958-348f-aa0c-498eb05e5afc",
                                                "text": "Hab mein' Wagen vollgeladen, voll mit alten Weibsen - (Volkslied)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                        "entry_id": "540cf1ac-046a-367d-80dd-cbadfde18781",
                                        "glosses": [
                                            "bewundernd für eine besonders weibliche Frau"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c16749a9-5ddc-45d4-b2a1-27ce3111701d",
                                                "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                                "text": "Er ist hinter den Weibern her."
                                            },
                                            {
                                                "example_id": "67734fbf-0df3-474e-9938-1ae047c925ec",
                                                "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                                "text": "Die Rita, das ist vielleicht ein Weib!"
                                            },
                                            {
                                                "example_id": "6706cca4-da2f-482e-a710-041cee175c40",
                                                "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                                "text": "Beim Himmel, was für ein Weib! stieß Jan voller Bewunderung hervor."
                                            },
                                            {
                                                "example_id": "003deefc-a097-4560-bc15-b4a2ccae4fbb",
                                                "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                                "text": "„Die Tür flog auf. Und rein kam ... dieses Weib.“"
                                            },
                                            {
                                                "example_id": "58e16692-045a-4254-ad50-74468ae29bae",
                                                "sense_id": "bdebcade-df1a-3974-9d72-97cefa731f49",
                                                "text": "„Da braucht es die Überwindung des Weibes durch eine anzügliche Zote nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                        "entry_id": "540cf1ac-046a-367d-80dd-cbadfde18781",
                                        "glosses": [
                                            "Synonym für „Frau“"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed251e9-0aee-4ec5-a94f-5517a56db10e",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "Hab mein' Wagen vollgeladen, voll mit alten Weibsen - (Volkslied)"
                                            },
                                            {
                                                "example_id": "fe5a31d9-3929-4a86-80e6-5df78cbd86c9",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "Weib, was sagst du dazu?"
                                            },
                                            {
                                                "example_id": "eb1a710a-6cd5-4f2d-ac8e-fd320367c813",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "Die Arbeiter bestehen aus Männern und Weibern, Erwachsenen und Kindern beiderlei Geschlechts. - (Karl Marx)"
                                            },
                                            {
                                                "example_id": "03338973-4f6c-4788-9476-b7d1fb350fb0",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "Das Ausbleiben des Orgasmus des Weibes kann bedingt sein durch Störungen von seiten des Mannes und von seiten der Frau."
                                            },
                                            {
                                                "example_id": "6095a064-7c2f-46f7-b38e-f8fede2bf455",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "„Die Weiber haben dünne Strümpfe und müssen frieren, aber es sieht hübsch aus.“"
                                            },
                                            {
                                                "example_id": "367c904e-e7ee-4566-8e61-0c9644b298c6",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "„Alle Weibsen des Kirchspiels umlagern das Grab der Schmiedowa.“"
                                            },
                                            {
                                                "example_id": "7040bd83-58c7-4cec-8427-e84858bcf646",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "„Soviel stand jedenfalls fest: Sein Refugium war gestürmt worden, und er hatte es jetzt mit zwei Weibern zu tun.“"
                                            },
                                            {
                                                "example_id": "52c96874-40bd-4053-92fe-96946e43c8e5",
                                                "sense_id": "b7bf2697-2e80-3352-9f56-f80095aeaaff",
                                                "text": "„Ich heiratete früh und war herzlich froh, in meinem Weib ein mir verwandtes Gemüt zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "835d6b31-fb46-3795-8b7e-0b0b2ad2d965",
                                        "entry_id": "540cf1ac-046a-367d-80dd-cbadfde18781",
                                        "glosses": [
                                            "insbesondere eine verheiratete Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ef5c9a7-564c-4921-9151-a0884f127be8",
                                                "sense_id": "835d6b31-fb46-3795-8b7e-0b0b2ad2d965",
                                                "text": "„Nur das starke, schöne, fruchtbare Weib war sichtbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
