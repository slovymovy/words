                "senses": [
                    {
                        "sense_id": "20b37ce4-947f-3048-bb9f-8e4d1a222767",
                        "entry_id": "225d35a8-f96d-3a60-954f-0a1173bbedad",
                        "glosses": [
                            "Schule mit einem Schwerpunkt in Fächern, die für kaufmännische Berufe besonders wichtig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43a9a7c-01eb-4288-b10c-ecaa8f441fc8",
                                "sense_id": "20b37ce4-947f-3048-bb9f-8e4d1a222767",
                                "text": "„Ungeachtet aller Belastungen, schloß Roman das Jahr auf der Handelsschule mit glänzenden Zeugnissen ab.“"
                            },
                            {
                                "example_id": "51169422-485d-4b22-b34b-0543e8107c64",
                                "sense_id": "20b37ce4-947f-3048-bb9f-8e4d1a222767",
                                "text": "„Allein die Gründung von Goromonzi kostete Huggins Wählerstimmen, denn die Siedler waren nicht bereit, Zugeständnisse an die Afrikaner zu machen; später wurde die einzige afrikanische Handelsschule auf Druck weißer Gewerkschaften geschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
