    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3bc573c9-bd1a-35f3-bff1-2309ae09884e",
                    "sense_definition": "Qui manque d'adresse, d'habileté manuelle ou de tact.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a renversé son café sur la table après un geste <w>maladroit</w>.",
                            "target_lang_translations": {
                                "en": "He knocked his coffee over onto the table after a <w>clumsy</w> gesture.",
                                "ru": "Он опрокинул кофе на стол после <w>неловкого</w> жеста.",
                                "de": "Er hat seinen Kaffee nach einer <w>ungeschickten</w> Bewegung auf dem Tisch verschüttet.",
                                "es": "Derramó el café sobre la mesa tras un gesto <w>torpe</w>.",
                                "zh": "他做了个<w>笨拙</w>的动作，结果把咖啡洒在了桌子上。"
                            }
                        },
                        {
                            "text": "Sa tentative <w>maladroite</w> d'explication n'a fait qu'aggraver la situation déjà tendue.",
                            "target_lang_translations": {
                                "en": "His <w>clumsy</w> attempt at explaining only made the already tense situation worse.",
                                "ru": "Его <w>неловкая</w> попытка объяснения только ухудшила и без того напряжённую ситуацию.",
                                "de": "Sein <w>ungeschickter</w> Erklärungsversuch hat die ohnehin angespannte Lage nur verschlimmert.",
                                "es": "Su <w>torpe</w> intento de explicación no hizo más que agravar la situación, ya de por sí tensa.",
                                "zh": "他<w>笨拙</w>的解释只会让本已紧张的局面更糟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gauche"
                    ],
                    "antonyms": [
                        "adroit",
                        "habile"
                    ],
                    "common_phrases": [
                        "geste maladroit",
                        "tentative maladroite"
                    ],
                    "target_lang_definitions": {
                        "en": "Lacking skill, manual dexterity or tact.",
                        "ru": "Не обладающий ловкостью, сноровкой или тактом.",
                        "de": "Ohne Geschick, Fingerfertigkeit oder Taktgefühl.",
                        "es": "Que carece de destreza manual, habilidad o tacto.",
                        "zh": "缺乏手上的灵巧、技能或待人处事的分寸感。"
                    },
