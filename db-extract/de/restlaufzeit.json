                "senses": [
                    {
                        "sense_id": "4e8820db-b4b5-351a-869f-d90d1cfe43a4",
                        "entry_id": "768d24fc-4be5-3756-83e8-47c04eb1f105",
                        "glosses": [
                            "der noch zur Verfügung stehende Teil einer vorgegebenen Laufzeit; die noch ausnutzbare Restdauer eines bestimmten Zeitabschnitts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d72e1c-5188-4114-aa59-899d3906f0ee",
                                "sense_id": "4e8820db-b4b5-351a-869f-d90d1cfe43a4",
                                "text": "„Eine Alternative bieten dem Anleger so genannte Rolling-Discountzertifikate. Bei diesen endlos laufenden Zertifikaten wird aller vier Wochen das angelegte Geld in einen neuen Discounter mit einer verbleibenden Restlaufzeit von jeweils einem Monat investiert.“"
                            },
                            {
                                "example_id": "fbbb2a93-fc9f-4107-ae60-a7874607d53d",
                                "sense_id": "4e8820db-b4b5-351a-869f-d90d1cfe43a4",
                                "text": "„Wer dann auf Nummer Sicher gehen will, der sucht sich einen Anleihenfonds mit kürzeren Restlaufzeiten der darin enthaltenen Papiere aus.“"
                            },
                            {
                                "example_id": "9deb4fae-c71c-4859-aca1-3d01b024f9f7",
                                "sense_id": "4e8820db-b4b5-351a-869f-d90d1cfe43a4",
                                "text": "„In den nächsten Jahren werde das Kraftwerk noch zur Abstützung des Umbaus in Richtung erneuerbare Energie benötigt, die technische Restlaufzeit betrage noch 10 bis 15 Jahre, so die EVN.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
