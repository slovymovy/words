                                                "sense_id": "c7bd439e-1c49-3c5d-8f19-79b5e29077e4",
                                                "text": "Linie ziemskiego pola magnetycznego są deformowane przez wiatr słoneczny."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "82448920-7a38-30a8-9219-be8852e35db0",
                                        "entry_id": "08a691d5-8b9a-3454-b47f-4c7ce633754c",
                                        "glosses": [
                                            "dotyczący ziemi ornej, majątku ziemskiego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb96c690-15c8-4392-bc84-347bd2a513fa",
                                                "sense_id": "82448920-7a38-30a8-9219-be8852e35db0",
                                                "text": "W niektórych wsiach było kilku właścicieli ziemskich, którzy dzielili się chłopem pańszczyźnianym po połowie"
                                            },
                                            {
                                                "example_id": "af376685-5f48-4977-8a1a-8fadbe0baf18",
                                                "sense_id": "82448920-7a38-30a8-9219-be8852e35db0",
                                                "text": "Jestem Walenty… obywatel ziemski"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "f1a2db08-cd8f-3bce-baec-086c730e4632",
                                        "entry_id": "08a691d5-8b9a-3454-b47f-4c7ce633754c",
                                        "glosses": [
                                            "zwykły, codzienny"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e4f51c-e2fe-4f53-9ecc-41a44de2f533",
                                                "sense_id": "f1a2db08-cd8f-3bce-baec-086c730e4632",
                                                "text": "Ziemskie troski, codzienne znoje, interesy i małostki ustąpiły na chwilę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "d23b38e9-6958-3bc7-a229-e7d89d8d9d45",
                                        "entry_id": "08a691d5-8b9a-3454-b47f-4c7ce633754c",
                                        "glosses": [
                                            "doczesny (zwłaszcza w opozycji do życia pozagrobowego)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4de02836-738d-452e-bc9c-88c02f75c51d",
                                                "sense_id": "d23b38e9-6958-3bc7-a229-e7d89d8d9d45",
                                                "text": "Zaledwiem bowiem żywot ziemski przeżył // Diabeł pochwycił mnie w szpony"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "ea12bc11-496b-3c71-88cb-663bd37a4bc9",
                                        "entry_id": "08a691d5-8b9a-3454-b47f-4c7ce633754c",
                                        "glosses": [
                                            "dotyczący ziemi, jako jednostki administracyjnej początkowo obejmującej kilka powiatów sądowych."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efee468b-d81b-4e3f-aba3-71a42e30f082",
                                                "sense_id": "ea12bc11-496b-3c71-88cb-663bd37a4bc9",
                                                "text": "W podobny sposób wybierano podkomorzych i sąd ziemski, złożony z trzech urzędników: sędziego, podsędka i pisarza"
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
