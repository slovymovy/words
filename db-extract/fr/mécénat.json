        "fr-extract.jsonl": [
            {
                "entry_id": "d0533c4e-82b8-3969-aa38-3c5335bc187a",
                "word": "mécénat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45758b89-b816-4c0a-b90b-2a769301b5b0",
                        "entry_id": "d0533c4e-82b8-3969-aa38-3c5335bc187a",
                        "tags": [
                            "plural"
                        ],
                        "form": "mécénats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "01c70048-958f-3394-9910-965f1c1c1587",
                        "entry_id": "d0533c4e-82b8-3969-aa38-3c5335bc187a",
                        "glosses": [
                            "Soutien matériel apporté, sans contrepartie directe de la part du bénéficiaire, à une œuvre ou à une personne pour l’exercice d’activités présentant un intérêt général."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "f310cd1c-9185-4828-99bf-e6c9d15eb09c",
                                "sense_id": "01c70048-958f-3394-9910-965f1c1c1587",
                                "text": "Transaction discrète avec la justice belge contre l’abandon des poursuite pour fraude à la domiciliation, immatriculation de son bateau à Malte avec pavillon des îles Caïmans, lobbying auprès des députés pour qu’ils votent un amendement sur mesure permettant la construction de la Fondation Vuitton au cœur du bois de Boulogne, multiplication gourmande de sociétés offshore, de libertés avec l’impôt, de gestes philanthropiques liés à la défiscalisation plus qu’au mécénat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d373dee-9756-4a44-a2dd-eed10cd5c8a8",
                        "source_entry_id": "d0533c4e-82b8-3969-aa38-3c5335bc187a",
                        "source_sense_id": "01c70048-958f-3394-9910-965f1c1c1587",
                        "target_lang_word": "Mäzenatentum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mäzenatentum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98a51197-c597-3ef7-aced-f8f61ac66a68",
                                        "entry_id": "3de13c84-db15-355d-b197-be4e5c8f4064",
                                        "glosses": [
                                            "Förderung von Kunst, Kultur oder anderen Bereichen durch eine Privatperson (Mäzen)"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54cc7c78-ac74-4193-aaca-cc660c5d4c2c",
                                                "sense_id": "98a51197-c597-3ef7-aced-f8f61ac66a68",
                                                "text": "„Bei einer Betrachtung der historischen Entwicklung der verschiedenen Formen der Unternehmensförderung kann generell zwischen Mäzenatentum, Spendenwesen und Sponsoring unterschieden werden.“"
                                            },
                                            {
                                                "example_id": "73b6a483-bc4e-4c85-88bc-1cb16ca0821b",
                                                "sense_id": "98a51197-c597-3ef7-aced-f8f61ac66a68",
                                                "text": "„Hier habe ich zehn Tage lang den Pioniergeist eines jungen Filmfestivals und den gediegenen Luxus Schweizer Mäzenatentums erlebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb2d25f9-5a8d-4a22-89c2-539c9cda8ff4",
                        "source_entry_id": "d0533c4e-82b8-3969-aa38-3c5335bc187a",
                        "source_sense_id": "01c70048-958f-3394-9910-965f1c1c1587",
                        "target_lang_word": "patronage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patronage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8493eb05-bd11-37f6-9375-bf2748ddf678",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "The act of providing approval and support; backing; championship."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7323525d-ff7c-4d1a-9742-5f1cb00b3110",
                                                "sense_id": "8493eb05-bd11-37f6-9375-bf2748ddf678",
                                                "text": "His vigorous patronage of the conservatives got him in trouble with progressives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a91a2e-e206-3316-9204-95cac60a3e0d",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "Customers collectively; clientele; business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648be1c4-5d64-4b1c-a49e-f456c113d8cc",
                                                "sense_id": "44a91a2e-e206-3316-9204-95cac60a3e0d",
                                                "text": "The restaurant had an upper-class patronage."
                                            },
                                            {
                                                "example_id": "2ddb4fec-cf0a-4969-b113-7180fbb8fed4",
                                                "sense_id": "44a91a2e-e206-3316-9204-95cac60a3e0d",
                                                "text": "The improved service to and from Taunton is fully justified by the passenger patronage to and from this town, which is a railhead for a large surrounding area."
                                            },
                                            {
                                                "example_id": "4e2e2e49-b33d-4922-be05-35a388e3db46",
                                                "sense_id": "44a91a2e-e206-3316-9204-95cac60a3e0d",
                                                "text": "In addition to employment in the area, once you factor in the patronage of people visiting the various sites, it's not difficult to see why it's being redeveloped. The current station building is tiny in comparison to other stations with a similar patronage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1effbd96-ad5b-3ed6-9677-c8252859550d",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "The act or state of being a customer of some business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed076af8-c2bc-46fe-99d6-4d75da9dcbc0",
                                                "sense_id": "1effbd96-ad5b-3ed6-9677-c8252859550d",
                                                "text": "The restaurant had \"Thank you for your patronage!\" printed on its take-out bags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ebcb8f-a24b-381c-9f4d-021c5ab4e8e3",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "A communication that indicates lack of respect by patronizing the recipient; condescension; disdain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3553c3e4-09c9-33f7-9204-56e534a7a7b1",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "Granting favours or giving contracts or making appointments to office in return for political support."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b73be9-2c2e-4681-85e1-3e7275c689c5",
                                                "sense_id": "3553c3e4-09c9-33f7-9204-56e534a7a7b1",
                                                "text": "Patronage, nepotism, cronyism, abuse of power, and criminal activity flourish, sometimes for decades, in numerous town halls, police stations, and special-purpose government agencies in the suburbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ff77f9-11e9-38a6-8ca8-bd36b4bcd426",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "Guardianship, as of a saint; tutelary care."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c2e5fda-a287-4716-bed1-4d7ad6c355fa",
                                                "sense_id": "23ff77f9-11e9-38a6-8ca8-bd36b4bcd426",
                                                "text": "Each of the Arts whose office is to refine, purify, adorn, embellish and grace life is under the patronage of a Muse, no god being found worthy to preside over them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5334941c-2ec3-3012-b127-4a53a822daf7",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "The right of nomination to political office."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2c5b72c-98f2-3454-8332-a9dff62ba3b1",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "The right of presentation to church or ecclesiastical benefice; advowson."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6d72376-c755-4e2d-91a5-5d99a3080b43",
                                                "sense_id": "e2c5b72c-98f2-3454-8332-a9dff62ba3b1",
                                                "text": "Advowson is the right of presentation to a church, or ecclesiastical benefice. Advowson, advocatio, signifies the taking into protection; and therefore is synonymous with patronage"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c0f184-5051-3002-882d-74a1000c7d62",
                                        "entry_id": "210491d1-07eb-393f-b589-d71011118846",
                                        "glosses": [
                                            "Patronising speech or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c59147c8-a5ae-43a6-adcf-60e4aa56a270",
                                                "sense_id": "47c0f184-5051-3002-882d-74a1000c7d62",
                                                "text": "The housekeeper, a very decorative brunette of thirty-five with a pseudo-English accent, greeted him with a mixture of grateful effusion and condescending patronage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patronage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20990d31-95be-37e2-9e7b-14ad2f19eb3a",
                                        "entry_id": "19b01f28-363d-37cb-a68e-8f32e39c1947",
                                        "glosses": [
                                            "To support by being a patron of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db96e3cf-95b2-45a3-a720-a8a17257d9a2",
                                                "sense_id": "20990d31-95be-37e2-9e7b-14ad2f19eb3a",
                                                "text": "Mingdi continued the policy of his father who had patronaged Confucian learning."
                                            },
                                            {
                                                "example_id": "58d9f6d8-232e-4a4b-8cf8-252575aa87da",
                                                "sense_id": "20990d31-95be-37e2-9e7b-14ad2f19eb3a",
                                                "text": "Table 5.4 reveals the role of criminal gangs’ patron under each crime category. From this, we can understand that 74 percent of the mercenaries are patronaged and supported by the politicians either of the ruling or opposition party."
                                            },
                                            {
                                                "example_id": "cebf71b4-693f-4a85-9d92-4261570a55c2",
                                                "sense_id": "20990d31-95be-37e2-9e7b-14ad2f19eb3a",
                                                "text": "To summarize: a person with a party political background is thus defined as ‘a person that has served in (a) […] and/or (b) a non-elective position inside the party administration of patronaged position in another organisation, i.e. the political functionary’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e557b92-dedd-3b95-922a-ff94235097dc",
                                        "entry_id": "19b01f28-363d-37cb-a68e-8f32e39c1947",
                                        "glosses": [
                                            "To be a regular customer or client of; to patronize"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b22c0a36-e821-444a-8935-02df25c08edf",
                                                "sense_id": "7e557b92-dedd-3b95-922a-ff94235097dc",
                                                "text": "This house is largely patronaged by the professors and students of many of the Educational Institutions of New England and the Middle States; and all perons visiting New York, either for business or pleasure, will find this an excellent place at which to stop."
                                            },
                                            {
                                                "example_id": "da7832b6-9210-4d54-9cf9-acfd3a37da0f",
                                                "sense_id": "7e557b92-dedd-3b95-922a-ff94235097dc",
                                                "text": "Mr. F. A. Welch, of the Oak View Poultry Farm, Salem, starts an add with us this issue. […] Our readers will be treated well, if they patronage Mr. Welch."
                                            },
                                            {
                                                "example_id": "1bcc1703-fcbc-4bb0-9e18-60339a0a7ac5",
                                                "sense_id": "7e557b92-dedd-3b95-922a-ff94235097dc",
                                                "text": "Most public establishments catered to Blacks, and Whites actively patronaged some black-owned businesses (Martin 1982, 6, 9–11; Slingsby 1980, 31–32)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
