                "senses": [
                    {
                        "sense_id": "fce62424-c637-3aa5-bfb6-e7128487996a",
                        "entry_id": "a73f7c11-5a26-3813-b02e-8d7ac1a585f4",
                        "glosses": [
                            "Provoquer un cancer sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19388fa5-6c0e-4c53-93ca-b00f14b7fab6",
                                "sense_id": "fce62424-c637-3aa5-bfb6-e7128487996a",
                                "text": "C'est une question de choix, vaut-il mieux être cancérigénisé par la rouille ou par le tabac; à chacun de voir."
                            },
                            {
                                "example_id": "a5f6aa60-3bae-4082-abcb-73b6e10105aa",
                                "sense_id": "fce62424-c637-3aa5-bfb6-e7128487996a",
                                "text": "Mais merci le lobbying, hein, non seulement je pollue, mais en plus je paye pour polluer (et pour me cancérigéniser)."
                            },
                            {
                                "example_id": "19ccfc71-7a01-4e78-98e3-8d4eee209456",
                                "sense_id": "fce62424-c637-3aa5-bfb6-e7128487996a",
                                "text": "Alors qu'il faisait une chaleur écrasante, j'avais décidé de ne pas sortir me cancérigéniser la peau, mais de bronzer grâce à l'écran de mon pc..."
                            },
                            {
                                "example_id": "8b28e803-5076-4622-8af3-eae603c705df",
                                "sense_id": "fce62424-c637-3aa5-bfb6-e7128487996a",
                                "text": "de toute façon dans ce qu'on mange tous les jours y'a bien plus de risque d'être cancérigénisé qu'avec les produits phyto utilisé 4 fois/an."
                            }
                        ]
                    }
