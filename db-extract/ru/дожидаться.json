                ],
                "senses": [
                    {
                        "sense_id": "95ee0a28-c89c-3651-8582-3ce817523eeb",
                        "entry_id": "0b139c28-630d-3ccf-8571-96ad78c5189d",
                        "glosses": [
                            "терпеливо ждать наступления события, обычно желательного, рассчитывая при этом на достижение определённого результата"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d492a159-e415-4ae3-8d42-cbaba672ed95",
                                "sense_id": "95ee0a28-c89c-3651-8582-3ce817523eeb",
                                "text": "Съев и выпив всё предложенное, Иван решил дожидаться кого-то главного в этом учреждении и уж у этого главного добиться и внимания к себе, и справедливости."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cbb93b2c-b065-4618-8c4f-099f110dbe4a",
                        "source_entry_id": "0b139c28-630d-3ccf-8571-96ad78c5189d",
                        "source_sense_id": "95ee0a28-c89c-3651-8582-3ce817523eeb",
                        "target_lang_word": "wait",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To delay movement or action until some event or time; to remain neglected or in readiness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28163248-11ce-4f7a-90bd-e21d4d61deca",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "Wait here until your car arrives."
                                            },
                                            {
                                                "example_id": "42709722-063d-4a9a-9012-ec4e50f1fd4b",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "I’m still waiting for you to pay me back the money I lent you.."
                                            },
                                            {
                                                "example_id": "d0682c85-e4b8-4699-88e3-a8fcf3797e1f",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "They also serve who only stand and wait."
                                            },
                                            {
                                                "example_id": "e2dbd90a-f770-4e25-8a36-110dc5355577",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "Haste, my dear father; 'tis no time to wait."
                                            },
                                            {
                                                "example_id": "bccb76b0-4254-478e-9ef7-74c3e40b0d22",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "7006dee7-3538-4356-908f-0197ff596961",
                                                "sense_id": "b04ac4b0-2476-3984-a4b9-c7e69afac0cc",
                                                "text": "The South London tramway replacement will have to wait, possibly five years, because of the slowing down of bus manufacture due to national requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca2122d-fafd-3f50-be4e-711c25caa0cc",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To wait tables; to serve customers in a restaurant or other eating establishment."
                                        ],
                                        "tags": [
                                            "US",
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3b6b105-391b-4dd7-8392-73dbf3e1b39b",
                                                "sense_id": "aca2122d-fafd-3f50-be4e-711c25caa0cc",
                                                "text": "She used to wait in this joint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cee0a37-5db2-3dcc-adfc-82479c524632",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To delay movement or action until the arrival or occurrence of; to await. (Now generally superseded by “wait for”.)"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "907426f6-f40e-41bc-8f25-d7b0e4f4bad9",
                                                "sense_id": "8cee0a37-5db2-3dcc-adfc-82479c524632",
                                                "text": "to wait one’s turn"
                                            },
                                            {
                                                "example_id": "7ec3e451-6641-4044-8f2d-0df2638d2dc0",
                                                "sense_id": "8cee0a37-5db2-3dcc-adfc-82479c524632",
                                                "text": "Awed with these words, in camps they still abide, / And wait with longing looks their promised guide."
                                            },
                                            {
                                                "example_id": "1ef10563-f327-4c8c-a597-db6a4ef01341",
                                                "sense_id": "8cee0a37-5db2-3dcc-adfc-82479c524632",
                                                "text": "The Court had assembled, to wait events, in the huge antechamber known as the Œil de Boeuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768260fb-65d8-3986-bd56-502884ffa4fc",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To attend on; to accompany; especially, to attend with ceremony or respect."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20469912-5b95-4837-bf61-f810164d2b95",
                                                "sense_id": "768260fb-65d8-3986-bd56-502884ffa4fc",
                                                "text": "He chose a thousand horse, the flower of all / His warlike troops, to wait the funeral."
                                            },
                                            {
                                                "example_id": "5f5a0a45-e978-4536-9b06-d49525bd775d",
                                                "sense_id": "768260fb-65d8-3986-bd56-502884ffa4fc",
                                                "text": "Remorse and heaviness of heart shall wait thee, / And everlasting anguish be thy portion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c97f77dc-103f-350a-940b-f8d5274a12a7",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To attend as a consequence; to follow upon; to accompany."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3596262a-9ee9-3cf1-9522-9d3c1189791a",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To defer or postpone (especially a meal)."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9080abec-d9ed-4d93-a11c-20f87ba7b2e6",
                                                "sense_id": "3596262a-9ee9-3cf1-9522-9d3c1189791a",
                                                "text": "Montague Thorold, who impatiently watched her wherever she went, came to tell her that his mother waited breakfast for her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bef4069-902e-34b3-b571-58d1d40e74aa",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To watch with malicious intent; to lie in wait"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c81cd3c-22f6-3af4-b463-63eb3637b1d3",
                                        "entry_id": "74cc2c86-43b7-31a2-8daa-3bd7f7fb7751",
                                        "glosses": [
                                            "To remain faithful to one’s partner or betrothed during a prolonged period of absence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a279367d-43fb-42bd-b242-a39513295836",
                                                "sense_id": "0c81cd3c-22f6-3af4-b463-63eb3637b1d3",
                                                "text": "She did not question him. Before leaving, she asked only, \"When will I see you again?\" He answered, \"I don't know. Don't wait for me, Dagny. Next time we meet, you will not want to see me.\""
                                            },
                                            {
                                                "example_id": "40b41b9d-7e64-4fc1-baca-2c8e34a705ac",
                                                "sense_id": "0c81cd3c-22f6-3af4-b463-63eb3637b1d3",
                                                "text": "I will wait / Even if it takes forever / I will wait / Even if it takes a lifetime"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11a35a80-ce2d-3139-993e-1ee013212b65",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "A delay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b5a7a51-cae9-4f7b-bf92-51db56b051ef",
                                                "sense_id": "11a35a80-ce2d-3139-993e-1ee013212b65",
                                                "text": "I had a very long wait at the airport security check."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "295be77e-0bd7-35aa-a131-ded7b87f4adb",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "An ambush."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40eb6c53-3f94-46f2-a260-5a1ca24d186f",
                                                "sense_id": "295be77e-0bd7-35aa-a131-ded7b87f4adb",
                                                "text": "They lay in wait for the patrol."
                                            },
                                            {
                                                "example_id": "4bd7ffec-3246-41ed-94ff-07f505752b56",
                                                "sense_id": "295be77e-0bd7-35aa-a131-ded7b87f4adb",
                                                "text": "an enemy in wait"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d473d77e-d468-3b0f-bb41-981326f32ed8",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "Ellipsis of wait state."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab4088bb-9dca-3e75-bcb0-af02c5c3236a",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "One who watches; a watchman."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e792b6d-399a-35d6-8018-48c0b50ffb0a",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "Hautboys, or oboes, played by town musicians."
                                        ],
                                        "tags": [
                                            "UK",
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c60a3dc8-3200-4f76-95a3-1a40615fff26",
                                                "sense_id": "2e792b6d-399a-35d6-8018-48c0b50ffb0a",
                                                "text": "[…]as he returned home to his owne house, the waits should sound the hautboies all the way"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f8766a-cb28-34c3-9188-3b3c68f347ff",
                                        "entry_id": "3277078a-9f4f-3040-8740-4b611319a8fa",
                                        "glosses": [
                                            "Musicians who sing or play at night or in the early morning, especially at Christmas time; serenaders; musical watchmen."
                                        ],
                                        "tags": [
                                            "UK",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02524f2e-19bb-461e-aa4e-4873b544ffdd",
                                                "sense_id": "c4f8766a-cb28-34c3-9188-3b3c68f347ff",
                                                "text": "Hark! are the waits abroad?"
                                            },
                                            {
                                                "example_id": "1a179176-609b-4d5e-9fb8-06c041429e6a",
                                                "sense_id": "c4f8766a-cb28-34c3-9188-3b3c68f347ff",
                                                "text": "1819-1820, Washington Irving, The Sketchbook of Geoffrey Crayon\nThe sound of the waits, rude as may be their minstrelsy, breaks upon the mild watches of a winter night with the effect of perfect harmony."
                                            },
                                            {
                                                "example_id": "18050368-c42a-47e8-820d-61906d202e45",
                                                "sense_id": "c4f8766a-cb28-34c3-9188-3b3c68f347ff",
                                                "text": "[…] the waits begin their rounds, and going from house to house, […] they sing carols and Christmas hymns until […] another Christmas-day has dawned.[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
