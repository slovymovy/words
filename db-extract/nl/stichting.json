                                "example_id": "6d666bdd-1ffc-4e75-af7f-bd8468da8bfe",
                                "sense_id": "21e42496-370a-3f34-bcba-fcd2018fa039",
                                "text": "De Amsterdamse Stichting Rookpreventie Jeugd heeft de Nederlandse staat aanklaagd vanwege haar relaties met de tabaksindustrie."
                            },
                            {
                                "example_id": "a5a18e6f-92b9-4f4a-8157-c09316751b4c",
                                "sense_id": "21e42496-370a-3f34-bcba-fcd2018fa039",
                                "text": "Dat was eenvoudiger dan verwacht, aangezien het Malala Fund al een officiële geregistreerde stichting in Amerika is."
                            },
                            {
                                "example_id": "0ba16c85-3d7c-4470-b97d-406d87e7c1a1",
                                "sense_id": "21e42496-370a-3f34-bcba-fcd2018fa039",
                                "text": "Vrouw vast in Rusland omdat ze 46 euro gaf aan Oekraïense stichting"
                            }
                        ]
