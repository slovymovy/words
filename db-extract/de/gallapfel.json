                                        "entry_id": "f9faf881-8772-3960-9ff2-1392929e9a02",
                                        "glosses": [
                                            "A kind of gall on a tree formed in response to damage or parasite, with a nut-like shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ebea3c8-41ca-47c3-aa3c-2e6084e8255f",
                                                "sense_id": "9c8968dd-df7c-3f42-842e-9f9559c60a08",
                                                "text": "In two pints of water boil one ounce of tan, and a like portion of nutgall till reduced to a pint."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7ac8e9e-4bb5-42f9-b63f-ae9da746ec18",
