                                        "sense_id": "3a5958ea-a106-333f-9fd0-c9b11dc51ec2",
                                        "entry_id": "0f5c94be-c08f-3900-a5d2-f870b35b2ece",
                                        "glosses": [
                                            "Dark-skinned; Black."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfccd75-579e-4932-a16d-3ce72c85a652",
                                                "sense_id": "3a5958ea-a106-333f-9fd0-c9b11dc51ec2",
                                                "text": "Some of the sable females, who formerly stood aloof, now began to relax and appear less coy; but my heart was still fixed on London, where I hoped to be ere long."
                                            },
                                            {
                                                "example_id": "95d0b7de-5a91-4159-a853-78aa9e8bb23d",
                                                "sense_id": "3a5958ea-a106-333f-9fd0-c9b11dc51ec2",
                                                "text": "Ethnologists are in the wrong / About our sable brothers[.]"
                                            },
                                            {
                                                "example_id": "aba0ca35-9e73-4a03-b4b7-b762aa1e3bc1",
                                                "sense_id": "3a5958ea-a106-333f-9fd0-c9b11dc51ec2",
                                                "text": "Of this one of the drovers writes thus: - \"Very soon there will be homesteads and stations dotted all over the Territory within easy distances of one another, driving our sable brethren from their ancient hunting grounds.\""
                                            },
                                            {
                                                "example_id": "dfa63366-5274-4fd9-9344-8027ac8d9434",
                                                "sense_id": "3a5958ea-a106-333f-9fd0-c9b11dc51ec2",
                                                "text": "For twelve long months I had to pace, / Humping my swag with a cadging face, / Sleeping in the bush, like the sable race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
