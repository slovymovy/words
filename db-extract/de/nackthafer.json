                "senses": [
                    {
                        "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                        "entry_id": "1b7cd715-1bb1-34d6-807e-2a1acf18f9f5",
                        "glosses": [
                            "bestimmte Hafersorte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad5a80d-0129-48e2-a53d-06b9ba0a783d",
                                "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                                "text": "„Diese Sorte ist die gewöhnlichste Form der Nackthafer, welche zuweilen in England, Schottland, Spanien, Oesterreich, Rumänien, Russland, in der Schweiz, weniger dagegen in Deutschland gebaut, und deren Früchte als Graupen verwandt werden.“"
                            },
                            {
                                "example_id": "2eeb5615-5df8-4adb-820c-cde613c77ab5",
                                "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                                "text": "„Außerdem werden die Ökoprogramme von konventionellen Züchtern unterstützt und von verschiedenen Landwirten werden ‚interne Clubsorten‘ angebaut und vermehrt, hier sind die Ackerbohne und der Nackthafer als Beispiele zu nennen.“"
                            },
                            {
                                "example_id": "e1cca675-ea40-43b5-86bf-85c4322b6436",
                                "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                                "text": "„Eingesetzt wird der Nackthafer vor allem in der Ferkelfütterung, in der Lämmermast und in kleineren Mengen in der Kälber - und Muttersauenfütterung.“"
                            },
                            {
                                "example_id": "64da8030-cb13-4bf2-80f0-6e07bd5e539e",
                                "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                                "text": "„Der Nackthafer soll in Deutschland angebaut und verwildert vorkommen. Seine Ährchen erreichen eine Größe von 2 cm und darüber.“"
                            },
                            {
                                "example_id": "888d52e9-2c34-4026-a5d7-f2e46a13fb9c",
                                "sense_id": "4f517476-2ea8-3c02-abb3-f47f45215bfa",
                                "text": "„Das Gewicht der Körner ist sehr verschieden, 38 bis 45 bis 60 kg, des Nackthafers 67 bis 77 kg je Hektoliter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
