                "senses": [
                    {
                        "sense_id": "cc41d50e-bd54-3a25-9e29-5e0dfa3bcd84",
                        "entry_id": "d81deb81-3b2c-328d-98df-dc41ac681e33",
                        "glosses": [
                            "Stadt im US-Bundesstaat Virginia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b7e25e-1283-4223-ab27-686daa8a2305",
                                "sense_id": "cc41d50e-bd54-3a25-9e29-5e0dfa3bcd84",
                                "text": "„Roger Depue holte uns am Dulles Airport ab und fuhr uns zu unserem Haus in Fredericksburg, wo eine amerikanische Flagge und ein riesiges Schild mit der Aufschrift ›Willkommen daheim, John‹ auf mich warteten.“"
                            },
                            {
                                "example_id": "24cba816-eced-4336-a019-541867db4e64",
                                "sense_id": "cc41d50e-bd54-3a25-9e29-5e0dfa3bcd84",
                                "text": "„Aber wenn er einfach immer nur weiterfuhr, würde er in Fredericksburg landen, und er wollte sich gewiss nicht in einem städtischen Ballungsraum seinen nächsten Unterschlupf suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e944d56-7efc-3ae5-b214-53594a023323",
                        "entry_id": "d81deb81-3b2c-328d-98df-dc41ac681e33",
                        "glosses": [
                            "Stadt im US-Bundesstaat Texas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147b5bda-4665-4df2-90c9-70d01739662d",
                                "sense_id": "9e944d56-7efc-3ae5-b214-53594a023323",
                                "text": "„Ich weiß von so'm ollen Klaben oben auf'm Llano, in der Nähe von'n deutschen Siedlungen, den ha'm sie erwischt und ihm'n Gaul abgenommen und so. Hat dann ohne Pferd weitermüssen. Sechs Tage drauf iss er auf Händen und Knien splitternackt in Fredericksburg eingetrudelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
