                "senses": [
                    {
                        "sense_id": "26331779-b603-3cff-8d0f-7724c2ecb161",
                        "entry_id": "602130dc-1b03-3876-9644-973fa818d33e",
                        "glosses": [
                            "een bassin om in te zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22563fd-490e-4d55-99ee-30c50241484e",
                                "sense_id": "26331779-b603-3cff-8d0f-7724c2ecb161",
                                "text": "Ze maakten 's winters het zwembad leeg."
                            },
                            {
                                "example_id": "c1ffe572-1767-45fe-8d2c-5299fa076d01",
                                "sense_id": "26331779-b603-3cff-8d0f-7724c2ecb161",
                                "text": "Een reeds lang geleden gesloten hotel met een verschoten lichtbak die de reiziger een zwembad en kamer met tv belooft."
                            },
                            {
                                "example_id": "420973ad-9b3f-47b1-b881-c0a222399cbf",
                                "sense_id": "26331779-b603-3cff-8d0f-7724c2ecb161",
                                "text": "We kampeerden in het wild langs beken en zagen zelden andere mensen. Een warme douche of zwembad zat er niet in."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aac9e87-56e3-3619-81ff-aee77179ce83",
                        "entry_id": "602130dc-1b03-3876-9644-973fa818d33e",
                        "glosses": [
                            "een inrichting om te zwemmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fb0586-b30c-4ce3-a200-94e85f8d503f",
                                "sense_id": "6aac9e87-56e3-3619-81ff-aee77179ce83",
                                "text": "De jeugd gaat tegenwoordig graag naar het zwembad op een warme zomerse dag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dcfa823-ecf0-4b63-8862-a22e174e1a7a",
