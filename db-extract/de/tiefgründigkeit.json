                "senses": [
                    {
                        "sense_id": "e1e552b8-921f-3e7d-ae89-c4fe7742bd42",
                        "entry_id": "581a6eb1-4e3b-3eee-bb97-542294aaf8ed",
                        "glosses": [
                            "anspruchsvoller Gehalt eines Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d9060d8-2838-489b-82ed-2f144740a7e6",
                                "sense_id": "e1e552b8-921f-3e7d-ae89-c4fe7742bd42",
                                "text": "„Da Gauß nur einen Bruchteil seiner Entdeckungen veröffentlichte, erschloss sich der Nachwelt die Tiefgründigkeit und Reichweite seines Werks erst, als 1898 sein Tagebuch […] entdeckt und ausgewertet wurde.“"
                            },
                            {
                                "example_id": "c9940272-4126-43d7-b71c-567e57116048",
                                "sense_id": "e1e552b8-921f-3e7d-ae89-c4fe7742bd42",
                                "text": "„Schwatzen heißt im Deutschen allgemein, sich in entspanntem Umfeld zu unterhalten, oder ein Gespräch ohne besondere Tiefgründigkeit zu führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f825a750-98b8-4093-9cdc-9bbfbae8ab29",
                        "source_entry_id": "581a6eb1-4e3b-3eee-bb97-542294aaf8ed",
                        "source_sense_id": "e1e552b8-921f-3e7d-ae89-c4fe7742bd42",
