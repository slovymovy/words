                                "target_senses": [
                                    {
                                        "sense_id": "7be9bbc6-af96-3e92-80f0-84262c579ad4",
                                        "entry_id": "65e79c1a-859b-3ffc-adf5-4cd686a5834c",
                                        "glosses": [
