                            {
                                "example_id": "70db4a93-7199-4d56-8880-637773dba8dd",
                                "sense_id": "85e350a7-875a-3526-927f-ed236f53d4a2",
                                "text": "When officers arrived, the man, whose name was not released, confronted them with a metal candleholder, officials said."
                            }
                        ]
                    },
                    {
                        "sense_id": "65ad687d-86ba-3cb7-b088-a2ec8576aac6",
                        "entry_id": "cdebafa9-d872-39ab-9e29-bf0552b7343b",
