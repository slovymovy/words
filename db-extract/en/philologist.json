                        "translation_id": "55869044-68d6-455b-9b58-abd682c9df83",
                        "source_entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
                        "source_sense_description": "person who engages in philology",
                        "target_lang_word": "фило́лог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фило́лог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a3fc858d-8d71-33a5-8e65-93ec2d21c9f4",
                                        "entry_id": "b38e39d5-2f77-3949-bfda-d209bdf2795c",
                                        "glosses": [
                                            "специалист в области филологии; тот, кто изучает духовную культуру народа, выраженную в языке и закреплённую в литературном творчестве, в письменных текстах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e210fefd-6947-431d-be39-3e38772f7dc8",
                                                "sense_id": "a3fc858d-8d71-33a5-8e65-93ec2d21c9f4",
                                                "text": "Прежде всего, филолог должен непременно иметь перед собой текст этого сообщения в подлиннике: любой перевод — не только литературный, но даже буквальный — в силу разницы в структуре языков неизбежно вносит в смысл текста некоторые малозаметные модификации, какая-нибудь из которых может впоследствии оказаться причиной ложного истолкования."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06206720-3249-4da9-9a24-2fdb86fb179e",
                        "source_entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
                        "source_sense_description": "person who engages in philology",
                        "target_lang_word": "языкове́д",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "языкове́д",
