                                        "sense_id": "7b1abc32-cdaf-3ee3-b3ca-ed7e68801434",
                                        "entry_id": "653ef0ea-6ff1-3b16-b436-2c236dd5e8e2",
                                        "glosses": [
                                            "weibliche Person, die unbefristet als Soldat in einer Armee dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba0e92c-451a-4c97-b399-be1367495621",
                                                "sense_id": "7b1abc32-cdaf-3ee3-b3ca-ed7e68801434",
                                                "text": "Seit 2001 dürfen Frauen in der Bundeswehr als Berufssoldatin dienen."
