                    {
                        "sense_id": "143fe7fb-a9db-3eeb-a1d7-e031158eef04",
                        "entry_id": "d6da8645-d408-3d17-9213-7684ab97ed48",
                        "glosses": [
                            "A manufactured vinyl doll that has been transformed to resemble a human baby with as much realism as possible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779df055-c74d-46c8-a3f1-d154f58bf581",
                                "sense_id": "143fe7fb-a9db-3eeb-a1d7-e031158eef04",
                                "text": "People's passionate reactions to reborns include moments of discomfort that happen across the skin and through the body."
                            },
                            {
                                "example_id": "209c62b2-9e08-4b79-a2e8-978d15bc2fe2",
                                "sense_id": "143fe7fb-a9db-3eeb-a1d7-e031158eef04",
                                "text": "Some treat reborns as dolls, but others treat reborns as children. Adults who treat dolls as children or adults who play with dolls may face ridicule […]"
                            }
                        ]
                    }
