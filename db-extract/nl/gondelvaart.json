                            {
                                "example_id": "e0dffec9-2b8a-4bb3-9d7c-bf995c6055d1",
                                "sense_id": "371d6e14-cf96-3476-9487-8647a74cd2cb",
                                "text": "Deze maand worden dertien nieuwe tradities bijgeschreven in de Inventaris Immaterieel Erfgoed Nederland. Naast de eerder genoemde evenementen, komen ook de volgende gewoontes op de lijst: 1-Aprilviering Brielle, Gondelvaart Giethoorn, Houtdorp Rijssen, Midwinterhoornbouwen, Oprechte Dalfser Moptraditie, Pinksterrijden, Schuttersbogenroute Didam, Shanties zingen, Snertkoken en de Weervisserij."
                            },
                            {
                                "example_id": "d0f372be-c520-4465-a5dd-d05956fb4df7",
                                "sense_id": "371d6e14-cf96-3476-9487-8647a74cd2cb",
                                "text": "Elk jaar is in Nieuwkoop het Torenschuddersfeest. Het ongeluk gebeurde tijdens de gondelvaart die onderdeel van het feest is. Waardoor de boot is gezonken, is niet duidelijk."
                            }
                        ]
