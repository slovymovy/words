                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1597c9f-8117-3b50-a5d0-02a5546603fd",
                        "entry_id": "ccd8c97e-e142-3286-8d0a-6c607be582a7",
                        "glosses": [
                            "Gesamtheit der räumlichen, sozialen und sonstigen Bedingungen des Lebens von jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4dac978-11a6-4d88-a425-a2fcda699975",
                                "sense_id": "a1597c9f-8117-3b50-a5d0-02a5546603fd",
                                "text": "„Auch wenn die Juden die mittelhochdeutschen Dialekte ihrer christlichen Nachbarn spätestens im 11. Jahrhundert als Umgangssprache untereinander übernahmen, fanden sie im Deutschen für ihre von der jüdischen Religion geprägten Lebensbereiche keine entsprechenden Ausdrücke vor, sondern mussten sie erst bilden.“"
                            },
                            {
                                "example_id": "31e833c7-a590-45b8-bbfc-6eebb790815d",
                                "sense_id": "a1597c9f-8117-3b50-a5d0-02a5546603fd",
                                "text": "„Ich fand die Anwendbarkeit der Kontrastbetonung auf alle möglichen Lebensbereiche äußerst amüsant und erhellend.“"
                            },
                            {
                                "example_id": "eac9d391-059d-47b2-b676-7e031b79617a",
                                "sense_id": "a1597c9f-8117-3b50-a5d0-02a5546603fd",
                                "text": "„In allen Lebensbereichen brauchen wir derartige Orientierungspunkte, die wir »Normen« nennen, als die konventionellen Leitlinien menschlichen Handlens und Verhaltens.“"
                            },
                            {
                                "example_id": "429c26cb-8c42-4cf2-8a84-910a4d22ba77",
                                "sense_id": "a1597c9f-8117-3b50-a5d0-02a5546603fd",
                                "text": "„Vom 8. Jahrhundert an drang das Christentum immer weiter in den Lebensbereich der Franken, Alemannen und Bayern vor.“"
                            }
                        ],
