                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                        "entry_id": "f4e6c63e-50f4-36c0-9fd4-79a958301cab",
                                        "glosses": [
                                            "Traditionally the fourth of the four seasons, typically regarded as spanning the months of December, January, and February in temperate and polar regions of the Northern Hemisphere or the months of June, July, and August in the Southern Hemisphere. It is the time when the sun is lowest in the sky, resulting in short days, and the time of year with the lowest atmospheric temperatures for the region."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "775f1073-2137-4f5f-b6bf-9985e7d0a074",
                                                "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                                "text": "Ne take noon hede to brynge togidere þe parties of þe boon þat is to-broken or dislocate, til viij. daies ben goon in þe wyntir, & v. in þe somer; for þanne it schal make quytture, and be sikir from swellynge; & þanne brynge togidere þe brynkis eiþer þe disiuncture after þe techynge þat schal be seid in þe chapitle of algebra."
                                            },
                                            {
                                                "example_id": "4b8a4c60-e457-455b-8025-55c1eee5bc62",
                                                "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                                "text": "And after summer evermore succeeds\n Barren winter, with his wrathful nipping cold."
                                            },
                                            {
                                                "example_id": "cdabdada-6bd4-4a7a-8372-54c4cdfb30f5",
                                                "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                                "text": "It cannot be denied it [the chameleon] is (if not the moſt of any) a very abſtemious animall, and ſuch as by reaſon of its frigidity, paucity of bloud, and latitancy in the winter (about which time the obſervations are often made) will long ſubſist without a viſible ſuſtentation."
                                            },
                                            {
                                                "example_id": "2e5e7aeb-0d28-4613-9343-e99a1e0376db",
                                                "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                                "text": "There shall he learn, ere sixteen winters old,\nThat …"
                                            },
                                            {
                                                "example_id": "b9859f2d-c71b-498b-b653-ba87b99411c9",
                                                "sense_id": "60807739-72b7-37ea-be37-71701d9753f8",
                                                "text": "[…] a woman, tall, and strong of aspect, of some thirty winters by seeming, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc72b6a9-03a6-3bd7-9f82-268c4a1d6b25",
                                        "entry_id": "f4e6c63e-50f4-36c0-9fd4-79a958301cab",
                                        "glosses": [
                                            "The period of decay, old age, death, or the like."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b5222ad-a42c-4ea8-b175-1c5895f989c9",
                                                "sense_id": "dc72b6a9-03a6-3bd7-9f82-268c4a1d6b25",
                                                "text": "Life's autumn past, I stand on winter's verge."
                                            },
                                            {
                                                "example_id": "e8bbe35a-19e8-439e-9307-35ecf5749327",
                                                "sense_id": "dc72b6a9-03a6-3bd7-9f82-268c4a1d6b25",
                                                "text": "Buterin seemed to sense that the market was out of balance, and he made a smart decision that helped Ethereum weather the crypto winter and continue to build while the market was down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0faafd94-e551-3ebd-886d-7e23116ea994",
                                        "entry_id": "f4e6c63e-50f4-36c0-9fd4-79a958301cab",
                                        "glosses": [
                                            "Someone with dark skin, eyes and hair, seen as best suited to certain colors of clothing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1924ecd-185f-3acc-ac92-77aee7f091cc",
                                        "entry_id": "f4e6c63e-50f4-36c0-9fd4-79a958301cab",
                                        "glosses": [
                                            "An appliance to be fixed on the front of a grate, to keep a kettle warm, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                                        "entry_id": "f4e6c63e-50f4-36c0-9fd4-79a958301cab",
                                        "glosses": [
                                            "The rainy season."
                                        ],
                                        "tags": [
                                            "India",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "222c6d0b-7609-409a-b560-7aea21c812a6",
                                                "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                                                "text": "Note that the Citie of Goa is the principall place of all the Oriental India, and the winter thus beginneth the 15 of May, with very great raine."
                                            },
                                            {
                                                "example_id": "9a5be8ee-0628-4a08-bd13-c6c8caad9576",
                                                "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                                                "text": "The Winter heere beginneth about the first of Iune and dureth till the twentieth of September, but not with continuall raines as at Goa, but for some sixe or seuen dayes every change and full, with much wind, thunder and raine."
                                            },
                                            {
                                                "example_id": "75a723aa-2048-4f8e-be37-dfe912c3ab6c",
                                                "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                                                "text": "In Winter (when they rarely stir) they have a Mumjama, or Wax Cloth to throw over it […]"
                                            },
                                            {
                                                "example_id": "5f6b08e5-f251-43e3-bb38-fb64dc2a11b9",
                                                "sense_id": "42045cae-47b9-3f6a-b126-e25b85c57602",
                                                "text": "The mere breadth of these mountains divides summer from winter, that is to say, the season of fine weather from the rainy […] all that is meant by winter in India is the time of the year when the clouds […] are driven violently by the winds against the mountains, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "winter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7751acb3-e410-3057-b6e4-7345d45fc2bd",
                                        "entry_id": "74f714a1-54ad-3552-a3f6-3d503be4271e",
                                        "glosses": [
                                            "To spend the winter (in a particular place)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86d6ce0f-e93b-4cc0-952c-246bb8ceaae2",
                                                "sense_id": "7751acb3-e410-3057-b6e4-7345d45fc2bd",
                                                "text": "When they retired, they hoped to winter in Florida."
                                            },
                                            {
                                                "example_id": "70d58267-edb9-441b-a438-64b88c16f0a0",
                                                "sense_id": "7751acb3-e410-3057-b6e4-7345d45fc2bd",
                                                "text": "Those who seek to invade another country anywhere across the great Eurasian steppes are condemned eventually to winter in it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d617fd-336a-39b1-8e63-2d0bd4faa40a",
                                        "entry_id": "74f714a1-54ad-3552-a3f6-3d503be4271e",
                                        "glosses": [
                                            "To store something (for instance animals) somewhere over winter to protect it from cold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
