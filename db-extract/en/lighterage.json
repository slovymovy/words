                        "sense_id": "1e998280-2ccc-3c03-b28d-30840e3fd802",
                        "entry_id": "4a4c09ee-aab7-3df6-9875-a2c856d27594",
                        "glosses": [
                            "The fee paid for conveyance of goods on a lighter (flat-bottomed boat for carrying heavy loads across short distances)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8a42e8b5-2ae1-381f-a1ca-9a433a75bf0a",
                        "entry_id": "4a4c09ee-aab7-3df6-9875-a2c856d27594",
                        "glosses": [
                            "The act of unloading into a lighter, or of conveying by a lighter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f2bb9aa4-e5b9-4780-82c7-31289eb8f2af",
                                "sense_id": "8a42e8b5-2ae1-381f-a1ca-9a433a75bf0a",
                                "text": "1904, Joseph Conrad, Nostromo, New York and London: Harper & Brothers, Part 3, Chapter 1, p. 355,\nHe has certainly organized the lighterage service of the harbor for the O.S.N. Company with great ability."
                            },
                            {
                                "example_id": "59777ebf-db92-4f04-af05-46d7e5ec9688",
                                "sense_id": "8a42e8b5-2ae1-381f-a1ca-9a433a75bf0a",
                                "text": "If Goods are to be brought Home to your own House, there are Charges for Weighage, Cranage, Porterage, Wharfage, Cartage, Lighterage, &c."
                            },
                            {
                                "example_id": "6bc1389f-0ee2-4cff-ada6-e76a440919c9",
                                "sense_id": "8a42e8b5-2ae1-381f-a1ca-9a433a75bf0a",
                                "text": "Moreover, as the traffic would be mainly morning and evening rush-hour services, at other times of the day much lighterage across the river could be saved by using part of the new terminus for freight trafic."
                            }
                        ]
                    }
                ],
