                ],
                "translations": [
                    {
                        "translation_id": "f20e5b4a-3a2a-40a6-9a90-772f52d7d66b",
                        "source_entry_id": "abe595e2-beb9-3a74-9941-456f2519b5ca",
                        "source_sense_id": "af43828b-a341-363f-aab7-f6ff5b1d5e87",
                        "source_sense_description": "abwertend: wahnhafte Überbewertung des Jungseins",
                        "target_lang_word": "jeunisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jeunisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "453c83d7-b397-3af0-819f-ad9466e7f0da",
                                        "entry_id": "fd8bca92-6b07-336a-bd44-ae63066ba5ba",
                                        "glosses": [
                                            "Excès d’amour pour la jeunesse."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2da2f8e-099e-49df-bc2a-702be2749b9f",
                                                "sense_id": "453c83d7-b397-3af0-819f-ad9466e7f0da",
                                                "text": "Ce jeunisme ordonné te rappelle Le Triomphe de la volonté de Leni Riefenstahl ou les sculptures d’Arno Breker."
                                            },
                                            {
                                                "example_id": "9b4abfea-82af-4e15-a3fd-11d1bd3cd224",
                                                "sense_id": "453c83d7-b397-3af0-819f-ad9466e7f0da",
                                                "text": "Cette tendance porte un nom, le jeunisme, un néologisme français qui désigne le réflexe sociétal de ne prendre au sérieux que ceux qui sont « jeunes et dynamiques »."
                                            },
                                            {
                                                "example_id": "ae0ba8b9-3b7e-4e38-8a03-3589b161c6f9",
                                                "sense_id": "453c83d7-b397-3af0-819f-ad9466e7f0da",
                                                "text": "Derrière Siko, deux joueurs de la même époque. Pas du jeunisme ni de la nostalgie, simplement une juste récompense pour ces mecs qui acceptent de jouer au poste le plus ingrat du foot, arrière gauche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
