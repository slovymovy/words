                                                "sense_id": "31308473-471c-3c7d-8535-77962940ad69",
                                                "text": "Despite hardly having any energy to lift a pen, she left a legible note on the paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfe9cf2e-f405-3bd1-a324-25bafff663f2",
                                        "entry_id": "1f21f0a6-4501-3e65-a79d-a1e09d61f34a",
                                        "glosses": [
                                            "Written or phrased so as to be easy to understand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61cb32d7-ff89-47fd-93fb-aebb8a80501b",
                                                "sense_id": "dfe9cf2e-f405-3bd1-a324-25bafff663f2",
                                                "text": "You can make this program code more legible by using meaningful variable names."
