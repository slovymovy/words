                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "126e8b6a-7ed0-3aba-8273-694236360509",
                                        "entry_id": "ff039c72-7969-37b6-80cf-771f56b17d0c",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de redingoter."
                                        ],
                                        "tags": [
