                        "source_sense_id": "bf1b06e6-490e-39e3-9cbf-a3c427cdc36a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Rückstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be3f134b-da94-3591-aee6-b433214810bf",
                                        "entry_id": "04a7afc9-3567-3454-a289-eb0312a82827",
                                        "glosses": [
                                            "etwas, das bei einem chemischen Prozess zurückbleibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05c3d6f7-0ddf-4980-8eef-fd3940085a35",
                                                "sense_id": "be3f134b-da94-3591-aee6-b433214810bf",
                                                "text": "Trotz mehrfachem Spülen ist ein Rückstand im Reagenzglas verblieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c24dd59-2627-3075-86bd-7338abfd0ab7",
                                        "entry_id": "04a7afc9-3567-3454-a289-eb0312a82827",
                                        "glosses": [
                                            "Reste eines Stoffes, der, obwohl unerwünscht, in Nahrungsmitteln zu finden ist"
                                        ],
                                        "tags": [
                                            "Nahrungsmittelindustrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b447ca0-ca10-4505-86c1-a453c7f418c3",
                                                "sense_id": "0c24dd59-2627-3075-86bd-7338abfd0ab7",
                                                "text": "In den Tomaten wurden Rückstände verschiedener Pestizide nachgewiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c565b04-a0bf-303f-a7f2-3e0604298df8",
                                        "entry_id": "04a7afc9-3567-3454-a289-eb0312a82827",
                                        "glosses": [
                                            "der Abstand zu einem Anderen, der einen Vorsprung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f239a07-4669-4f34-9934-cf6602c9c504",
                                                "sense_id": "9c565b04-a0bf-303f-a7f2-3e0604298df8",
                                                "text": "Die Mannschaft hat binnen 20 Minuten einen Rückstand von 1:4 Toren aufgeholt."
                                            },
                                            {
                                                "example_id": "f9522f53-efd0-4bc5-a063-5270d8179704",
                                                "sense_id": "9c565b04-a0bf-303f-a7f2-3e0604298df8",
                                                "text": "„Der Rückstand auf die enteilte Union ist fast halbiert – nach nicht einmal einer Woche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8d514af7-1b52-3af0-b7b4-398567e0c0b5",
                                        "entry_id": "04a7afc9-3567-3454-a289-eb0312a82827",
                                        "glosses": [
                                            "das Zurückbleiben hinter einer Verpflichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53ccf1c4-2abb-4247-bab8-9593e1caabdb",
                                                "sense_id": "8d514af7-1b52-3af0-b7b4-398567e0c0b5",
                                                "text": "Er ist mit der Miete im Rückstand."
                                            },
                                            {
                                                "example_id": "73038d0f-958f-4c4e-8c7e-d11304f5f5dc",
                                                "sense_id": "8d514af7-1b52-3af0-b7b4-398567e0c0b5",
                                                "text": "„In einem Handschreiben mahnte daraufhin Maximilian seine Tochter, sie möge dafür Sorge tragen, dass diese Rückstände ausgeglichen würden.“"
                                            },
                                            {
                                                "example_id": "7374b21a-6138-43de-94c4-01cec31ca26b",
                                                "sense_id": "8d514af7-1b52-3af0-b7b4-398567e0c0b5",
                                                "text": "„Sonja war mit ihrer Toilette fast fertig, die Gräfin desgleichen; aber Natascha, die sich mit der Herrichtung der beiden anderen viele Mühe gemacht hatte, war noch im Rückstande.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
