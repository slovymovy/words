                ],
                "senses": [
                    {
                        "sense_id": "29753877-239c-36ff-875f-52bd0c3224ee",
                        "entry_id": "6c46417c-0e73-30e5-a687-13a42c2a7a34",
                        "glosses": [
                            "Streichinstrument des 18. Jahrhunderts"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "f3e8928e-abdb-4c89-8275-251a49abd96b",
                                "sense_id": "29753877-239c-36ff-875f-52bd0c3224ee",
                                "text": "„Das Baryton ist ein Streichinstrument des späten 17. und 18. Jahrhunderts, das vor allem in Süddeutschland und Österreich-Ungarn Verwendung fand.“"
                            },
                            {
                                "example_id": "4b7e01d0-18cc-49d0-91f8-345ee44a42db",
                                "sense_id": "29753877-239c-36ff-875f-52bd0c3224ee",
                                "text": "„Das Baryton hat die Größe und Stimmung einer Tenor-Baß-Gambe.“"
                            },
                            {
                                "example_id": "24b602e8-a745-427f-88ae-2047eef3c8a2",
                                "sense_id": "29753877-239c-36ff-875f-52bd0c3224ee",
                                "text": "„Einzigartig am Baryton ist, daß es zusätzlich zu den Darmsaiten auf der Vorderseite, die mit einem Bogen gestrichen werden, hinten Resonanzsaiten besitzt, die ihm einen deutlichen Nachhall verleihen.“"
                            },
                            {
                                "example_id": "a087d407-54e9-45aa-9739-ba30c133810a",
                                "sense_id": "29753877-239c-36ff-875f-52bd0c3224ee",
                                "text": "„Das Baryton war immer ein seltenes Instrument, erlebte aber eine kurze Blütezeit, weil es das Lieblingsinstrument des Fürsten Nikolaus I. von Esterhazy (1714–1790) war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
