                    {
                        "sense_id": "d37af5e5-2ba6-3410-927a-2e313294d064",
                        "entry_id": "a6d78f53-03a4-3e4a-9208-4c7bedaff8e0",
                        "glosses": [
                            "schoonmaakmiddel voor de vaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0db2a1-5f3c-4133-ae85-ff0d66063e27",
                                "sense_id": "d37af5e5-2ba6-3410-927a-2e313294d064",
                                "text": "Je gebruikt snel te veel afwasmiddel voor de vaat."
                            },
                            {
                                "example_id": "1a824616-5d80-4dd8-a060-2b6dd687d52f",
                                "sense_id": "d37af5e5-2ba6-3410-927a-2e313294d064",
                                "text": "Het afwasmiddel voor de vaatwasmachine heet een vaatwasmiddel."
                            },
                            {
                                "example_id": "5cb0b24b-601f-4027-9566-63e70ecdf15b",
                                "sense_id": "d37af5e5-2ba6-3410-927a-2e313294d064",
                                "text": "Ik was blij met de fles afwasmiddel en het schuursponsje en begon verwoed te boenen."
                            },
                            {
                                "example_id": "56b22247-8b26-4846-84db-3c41890a6e81",
                                "sense_id": "d37af5e5-2ba6-3410-927a-2e313294d064",
                                "text": "Toen hij wat afwasmiddel op de stapel druppelde, deed de kleur daarvan haar denken aan de glanzende lap stof in de oude kerk."
                            }
                        ]
                    }
