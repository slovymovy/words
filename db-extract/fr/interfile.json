                "senses": [
                    {
                        "sense_id": "7096040f-da0e-331b-b217-b28c0335b116",
                        "entry_id": "21225a4b-60bb-3e10-a09d-5c1220c456a1",
                        "glosses": [
                            "Entre les files de voitures (sur autoroutes jusqu'à 50 km/h)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb69a13-9a3d-495b-a49a-3068e4cd5d4d",
                                "sense_id": "7096040f-da0e-331b-b217-b28c0335b116",
                                "text": "Actuellement, la pratique de la circulation interfile reste interdite pour les motards au Luxembourg."
                            },
                            {
                                "example_id": "032a6ed9-dc82-4ddd-9a97-dfcf8901a990",
                                "sense_id": "7096040f-da0e-331b-b217-b28c0335b116",
                                "text": "Officiellement durant Paris 2024, la circulation interfiles, expérimentée depuis trois ans en Île-de-France, est supprimée sur tous les axes comprenant des portions de voies olympiques."
                            },
                            {
                                "example_id": "608166de-e362-43f0-a7ba-74d0d4890b13",
                                "sense_id": "7096040f-da0e-331b-b217-b28c0335b116",
                                "text": "En cas d’accident de moto en interfile, la situation se complique. Si le motard respectait les conditions de circulation en interfile, il peut être indemnisé comme pour tout autre accident. Cependant, s’il ne respectait pas les règles (vitesse excessive, dépassement par la droite, etc.), sa responsabilité peut être partiellement ou totalement engagée. Ce qui pourrait s’apparenter à du remonte files sauvage qui fait fi des règles de la sécurité routière."
                            },
                            {
                                "example_id": "94862c35-30f9-4674-943d-ad8f02e350ea",
                                "sense_id": "7096040f-da0e-331b-b217-b28c0335b116",
                                "text": "La vitesse maximale autorisée en interfile pour les deux-roues est de 50 km/h, mais réduite à 30 km/h si l'une des files est à l'arrêt. Il est par ailleurs interdit de forcer le passage ou de dépasser un autre deux-roues circulant déjà en interfile."
                            }
                        ]
                    }
