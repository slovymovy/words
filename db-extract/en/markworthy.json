                        "form_id": "cb99561c-68b5-4ea9-9ad9-7460600c8d0d",
                        "entry_id": "aebe9e9c-aca2-39b6-be49-d6e571d40c79",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more markworthy"
                    },
                    {
                        "form_id": "a8d0e02e-4e2e-4a66-8c51-ab4eb097cbbe",
                        "entry_id": "aebe9e9c-aca2-39b6-be49-d6e571d40c79",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most markworthy"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                        "entry_id": "aebe9e9c-aca2-39b6-be49-d6e571d40c79",
                        "glosses": [
                            "Worthy of note or remark."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2aaa00d5-cd64-4815-97d8-997393e5d5f3",
                                "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                                "text": "The scholar found something markworthy while reading the Bible for the eighth time."
                            },
                            {
                                "example_id": "d8f3e67c-0e18-46db-a8de-878a5333fe63",
                                "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                                "text": "That the ancient Britons eat of the nuts and berries and other fruits which were borne by the more wooded land of their time, we may well believe, and a markworthy proof of it was many years ago afforded in the neighbourhood of Dorchester."
                            },
                            {
                                "example_id": "ddc15889-2d0d-42b5-b3e9-8b066954e72d",
                                "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                                "text": "In character-drawing, Mr. Cable does not surpass his Bonaventure, but the cunning of his art when applied to incident and description is quite as markworthy in the latter as in the earlier part of the book."
                            },
                            {
                                "example_id": "c6d33208-1c52-4eaa-a4f4-92085bd4b1e0",
                                "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                                "text": "Another complained that his mother-in-law had put him in jail for bigamy. In the case of another the incident was more markworthy. I will call him Gritto."
                            },
                            {
                                "example_id": "e39a332a-873a-44ab-b4b3-c4c35683da17",
                                "sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                                "text": "Indeed, in communicating with the Chiefs-of-Police in the United States concerning the ravages of drug-intoxication, it was markworthy that those bearing German names were especially prompt and thorough in reply to my enquiries, and in making suggestions as to the applications of practical remedies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86338734-dba4-4d8e-9cc7-92c02831c7b9",
                        "source_entry_id": "aebe9e9c-aca2-39b6-be49-d6e571d40c79",
                        "source_sense_id": "3085600e-2d45-36eb-9157-28c3e86572fb",
                        "source_sense_description": "worthy of note",
                        "target_lang_word": "bemerkenswert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bemerkenswert",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                        "entry_id": "0d36f4ef-8248-3c68-b6be-20b181ba95c0",
                                        "glosses": [
                                            "Aufmerksamkeit verdienend; so beschaffen, dass es bemerkt werden sollte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae41f0ca-9191-4435-ad3e-ef351447a668",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Auf der Tagung wurde ein bemerkenswerter Vortrag gehalten."
                                            },
                                            {
                                                "example_id": "9018703d-8a7e-4d28-ab5a-fffc7c683747",
                                                "sense_id": "94ffa72b-78cb-3cef-b299-2b0cc7252b97",
                                                "text": "Ein bemerkenswerte Änderung in ihrer Strategie zur Versorgung der Internationalen Raumstation ISS deutete der neue Chef Michael Griffin am 21. Juni 2005 bei einem Sponsor-Frühstück bei der „Space Transportation Association“ mit Sitz in Maryland an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
