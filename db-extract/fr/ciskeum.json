                            {
                                "target_word": "cisguy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f683969-9cf4-3d9b-a71f-aa9f9989d93f",
                                        "entry_id": "8b81f41c-a032-3960-be83-b9cbbb026dde",
                                        "glosses": [
                                            "A cisgender man."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "738dfa1f-a13d-4e5f-b91f-dd37faec5b80",
                                                "sense_id": "5f683969-9cf4-3d9b-a71f-aa9f9989d93f",
                                                "text": "\"This is not about sex!\" I snapped. \"I mean, yes, I was interested in being with a cisguy after my surgery, but–\""
                                            },
                                            {
                                                "example_id": "52582b48-73c2-4561-a578-73beab230abe",
                                                "sense_id": "5f683969-9cf4-3d9b-a71f-aa9f9989d93f",
                                                "text": "The humorous guide, which is full of illustrations (cartoons, photos, diagrams), is written for a young, fashion-conscious FTM audience that seeks to pass among cisguys."
                                            },
                                            {
                                                "example_id": "2e9b79cd-c071-4918-b414-15169355ad97",
                                                "sense_id": "5f683969-9cf4-3d9b-a71f-aa9f9989d93f",
                                                "text": "[…] the most known or visible representation is typically a White cisguy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11c82a87-0a7a-4258-adb9-91136c35bcc4",
                        "source_entry_id": "e0667f94-6f62-31f9-a6df-33d9e9dd43f5",
                        "source_sense_id": "034d87f4-dcca-3289-b0e6-9c8b7066af76",
