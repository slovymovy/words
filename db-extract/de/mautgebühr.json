                                "target_senses": [
                                    {
                                        "sense_id": "938fa58b-09b2-3231-9497-a8eed4150124",
                                        "entry_id": "76e4b5dc-cdf9-361e-bed6-9e3444b3bb22",
                                        "glosses": [
                                            "To ring (a bell) slowly and repeatedly."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5efc85b1-116e-4281-9789-7ac1c3fb9154",
                                                "sense_id": "938fa58b-09b2-3231-9497-a8eed4150124",
                                                "text": "Martin tolled the great bell every day."
                                            },
                                            {
                                                "example_id": "5fa92d87-be58-4cdd-afe0-c0b1fa7e47ce",
                                                "sense_id": "938fa58b-09b2-3231-9497-a8eed4150124",
                                                "text": "Ask not for whom the bell tolls."
                                            },
                                            {
                                                "example_id": "0f29eab3-6d96-407b-b5d8-87d87945b4e1",
                                                "sense_id": "938fa58b-09b2-3231-9497-a8eed4150124",
                                                "text": "From the belfries far and near the funereal deathbell tolled unceasingly while all around the gloomy precincts rolled the ominous warning of a hundred muffled drums punctuated by the hollow booming of pieces of ordnance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109b89c7-5241-3b26-9d4c-52dd6e64985e",
                                        "entry_id": "76e4b5dc-cdf9-361e-bed6-9e3444b3bb22",
                                        "glosses": [
                                            "To summon by ringing a bell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731fd9bb-2e15-46a9-8f1d-7693b9c636e8",
                                                "sense_id": "109b89c7-5241-3b26-9d4c-52dd6e64985e",
                                                "text": "The ringer tolled the workers back from the fields for vespers."
                                            },
                                            {
                                                "example_id": "6630e88c-125c-4dd6-ae30-4ac9514a23c8",
                                                "sense_id": "109b89c7-5241-3b26-9d4c-52dd6e64985e",
                                                "text": "When hollow murmurs of their evening bells\nDismiss the sleepy swains, and toll them to their cells."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582b0267-870e-306e-9abd-efc5301abeef",
                                        "entry_id": "76e4b5dc-cdf9-361e-bed6-9e3444b3bb22",
                                        "glosses": [
                                            "To announce by ringing a bell."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081dd305-e729-4565-89e9-ea5f70eff179",
                                                "sense_id": "582b0267-870e-306e-9abd-efc5301abeef",
                                                "text": "The bells tolled the King’s death."
                                            },
                                            {
                                                "example_id": "b05cce2e-a297-42fe-892d-9a31d3c870c1",
                                                "sense_id": "582b0267-870e-306e-9abd-efc5301abeef",
                                                "text": "Slow tolls the village-clock the drowſy hour;\nThe partridge burſts away on whirring wings;\nDeep mourns the turtle in ſequeſter'd bower,\nAnd ſhrill lark carols clear from her aereal tour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d8afc59-2536-37d5-bee6-436059f89a09",
                                        "entry_id": "76e4b5dc-cdf9-361e-bed6-9e3444b3bb22",
                                        "glosses": [
                                            "To make a sound as if made by a bell."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa367fe2-9cb2-4a0c-b5b5-6ce2a2afacc7",
                                                "sense_id": "6d8afc59-2536-37d5-bee6-436059f89a09",
                                                "text": "The chaplain's first mention of the name Yossarian! had tolled deep in his memory like a portentous gong."
                                            }
                                        ]
                                    }
                                ]
                            },
