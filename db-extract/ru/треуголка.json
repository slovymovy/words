                "senses": [
                    {
                        "sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "glosses": [
                            "истор. форменная шляпа военнослужащих и гражданских чиновников, поля которой загнуты в виде треугольника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e95ea29-f816-4993-942a-7695f615dfba",
                                "sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                                "text": "Начали съезжаться гости, сверкая орденами и лентами, военное начальство, штатские генералы в белых штанах и плюмажных треуголках, духовенство в дорогих лиловых рясах."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f86d2371-4c77-4f09-b609-a3f792966383",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "cocked hat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocked hat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76d2c438-c088-329c-a3a8-d030cc1ea12b",
                                        "entry_id": "e1922cfa-b90d-3367-9671-965d0e133f3f",
                                        "glosses": [
                                            "A hat with the brim turned up to form two or three points; a bicorn or tricorn"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0669ed7-7738-3a1e-98f6-1e9a17d36304",
                                        "entry_id": "e1922cfa-b90d-3367-9671-965d0e133f3f",
                                        "glosses": [
                                            "The triangular space formed by the intersection of the position lines on a chart determined by plotting three bearings; the approximate position of the ship"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfafc03f-c477-3022-8a60-23e7cf81c110",
                                        "entry_id": "e1922cfa-b90d-3367-9671-965d0e133f3f",
                                        "glosses": [
                                            "A game similar to ninepins, except that only three pins, arranged in a triangle, are used."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9593f17c-328f-4830-ba07-31135a44be35",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "three-cornered hat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d144cfdc-6728-4614-a28c-9b9d724a5654",
                        "source_entry_id": "d115ad36-0693-3cd2-b52c-3233dea21fa2",
                        "source_sense_id": "061611b3-126f-3dd4-b576-36109d14110e",
                        "target_lang_word": "tricornio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tricornio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "4a9200cf-c174-3068-9525-a3b99bce298a",
                                        "entry_id": "2c7fdb46-3241-3089-8a59-0c9f622ef7d7",
                                        "glosses": [
                                            "Que tiene tres cuernos o picos que recuerdan a aquellos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d51b68-fd42-4ddd-814a-e4c8170cde63",
                                                "sense_id": "4a9200cf-c174-3068-9525-a3b99bce298a",
                                                "text": "Y si se considera la disposicion del sombrero tricornio que usa los dias de incienso, representa un verdadero Don Quixote armado de caballero andante."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tricornio",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bf720229-89e0-397c-bbbf-24648cac96ab",
                                        "entry_id": "d17277de-fc55-38b8-838b-f94af2a9d6b0",
                                        "glosses": [
                                            "En particular, sombrero de ala ancha y recogida formando tres picos para resguardar la cara de la lluvia, típico de la moda del temprano siglo XIX."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3705e058-05ea-4055-b015-49cf35395717",
                                                "sense_id": "bf720229-89e0-397c-bbbf-24648cac96ab",
                                                "text": "Córdova se apeó de su corcel de batalla, desnudó la espada, atravesó con ella el pecho del caballo, y a guisa de bandera enarboló el tricornio en la punta de su acero, pronunciando a la vez sus inmortales palabras de mando."
                                            },
                                            {
                                                "example_id": "ffb1df22-8d81-4e68-a2a3-69718a344dc8",
                                                "sense_id": "bf720229-89e0-397c-bbbf-24648cac96ab",
                                                "text": "El resto del equipo militar, es decir, las charreteras, el tricornio, banda y condecoraciones, era de papel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7a1a466c-14ac-33f1-87aa-0ef7ec2e180e",
                                        "entry_id": "d17277de-fc55-38b8-838b-f94af2a9d6b0",
                                        "glosses": [
                                            "Agente de la Guardia Civil española, que viste tricornio₂ en su uniforme tradicional."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4684032-467f-4c09-9398-ae928592bbf9",
                                                "sense_id": "7a1a466c-14ac-33f1-87aa-0ef7ec2e180e",
                                                "text": "Hasta la Guardia civil, tan odiada por los braceros, merecía su simpatía momentáneamente. Los tricornios también se pondrían de parte del pueblo."
                                            },
                                            {
                                                "example_id": "e6eb0cbc-e891-4d02-a894-3654d6b00a93",
                                                "sense_id": "7a1a466c-14ac-33f1-87aa-0ef7ec2e180e",
                                                "text": "Caminan esposados, taciturnos: Cargan escuetos hatillos sobre los hombros, y con miradas de través acechan las dañinas intenciones de los tricornios. Nunca se les autoriza para descansar en poblado."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
