                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technische beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de sterke stroming begon het schip gevaarlijk te <w>gieren</w>.",
                            "target_lang_translations": {
                                "en": "Due to the strong current, the ship began to <w>yaw</w> dangerously."
                            }
                        },
                        {
                            "text": "Het vliegtuig <w>gierde</w> lichtjes tijdens de landing door de zijwind.",
                            "target_lang_translations": {
                                "en": "The plane <w>yawed</w> slightly during landing due to the crosswind."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwenken",
                        "afwijken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautische of luchtvaartterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a rotating movement around the vertical axis, especially in ships or aircraft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yaw",
                                "target_lang_sense_clarification": "nautical or aviation term"
                            },
                            {
                                "target_lang_word": "swerve",
                                "target_lang_sense_clarification": "to deviate from course"
                            },
                            {
                                "target_lang_word": "sheer",
                                "target_lang_sense_clarification": "of a ship, to deviate"
                            }
                        ]
                    }
                },
                {
