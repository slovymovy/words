                                "sense_id": "45674e1e-a586-3197-98c7-6f984bd47add",
                                "text": "Mon père m’envoya à l’école franco-musulmane en 1945. Ce fut le cousin kiffeur qui s’en chargea."
                            },
                            {
                                "example_id": "768e31f7-8b6c-41f1-92c3-9087c2d302d5",
                                "sense_id": "45674e1e-a586-3197-98c7-6f984bd47add",
                                "text": "Je suis également une sympathique trentenaire, anticonformiste assumée, kiffeuse de vie et mordue de spiritualité !"
                            }
                        ]
                    }
