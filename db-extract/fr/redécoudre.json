                ],
                "senses": [
                    {
                        "sense_id": "f1e5b8b0-41ef-3351-9130-6a87b6d83125",
                        "entry_id": "c0d74307-e1f9-3c3b-9477-69acb29a91ef",
                        "glosses": [
                            "Redéfaire la couture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e65def4-7aa2-4631-add4-57d32a6009c9",
                                "sense_id": "f1e5b8b0-41ef-3351-9130-6a87b6d83125",
                                "text": "II alla jusqu'à redécoudre la doublure de sa veste et retirer de l'enveloppe le papier écrit par Reveillard mais le crayon, cette fois, était plus qu'aux trois quarts effacé : il ne put même pas lire trois mots et finalement il brûla le papier à la flamme de son briquet."
                            }
                        ]
                    },
                    {
                        "sense_id": "b39b87dc-de7e-3d7c-8a86-bd7c8fdfeba0",
                        "entry_id": "c0d74307-e1f9-3c3b-9477-69acb29a91ef",
                        "glosses": [
                            "Se redéfaire, en parlant d’une couture."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0731bc05-4c20-4630-99cb-9f30f4234e92",
                                "sense_id": "b39b87dc-de7e-3d7c-8a86-bd7c8fdfeba0",
                                "text": "À chaque fois qu’il allait dans la forêt, l’ourlet de son pantalon se redécousait à cause des ronces."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d94d4be-aea7-3e17-a78d-2a72ab2db342",
                        "entry_id": "c0d74307-e1f9-3c3b-9477-69acb29a91ef",
                        "glosses": [
                            "(précédé de en) Se battre une nouvelle fois."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a774ddc1-9ede-4481-b8a1-a6092245bde0",
                                "sense_id": "7d94d4be-aea7-3e17-a78d-2a72ab2db342",
                                "text": "Il s'endort, harassé, sur de la paille, prêt à en redécoudre au lever du soleil."
                            }
                        ]
                    }
                ],
