                                        "glosses": [
                                            "Resembling a dream: fantastic and incongruous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6abedfc-3103-405c-8631-c900b91b7635",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "surreal art"
                                            },
                                            {
                                                "example_id": "a86046ed-8ece-41f8-a0ee-a686d4876bec",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "a surreal experience"
                                            },
                                            {
                                                "example_id": "ecdfe2a2-654f-4753-97b8-77aab2a01483",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "surreal picture"
                                            },
                                            {
                                                "example_id": "fffebe5a-da03-46d3-8a71-feddb7dbd8c9",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "surreal sound"
                                            },
                                            {
                                                "example_id": "2beb329a-3532-4172-8d03-12acac73530b",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "Walking through the empty city at night was a surreal experience."
                                            },
                                            {
                                                "example_id": "2463665c-4e16-4d6d-9783-3345a02f1e8b",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "The movie had a dreamlike, surreal atmosphere."
                                            },
                                            {
                                                "example_id": "dd5ec3cc-46e1-4310-ac61-06971805e43e",
                                                "sense_id": "093e1c42-df2b-3b98-b0d6-800beb09c7a1",
                                                "text": "It felt surreal to meet her favorite author in person."
                                            }
                                        ]
