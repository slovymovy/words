                                "target_senses": [
                                    {
                                        "sense_id": "03093eac-45e0-38eb-8106-406a8e1ec084",
                                        "entry_id": "03d3bdda-ed68-32a0-819b-14d32db77bda",
                                        "glosses": [
                                            "To ascend, rise up, climb."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a45c34e2-03d5-46c0-af1e-96c21e355a06",
                                                "sense_id": "03093eac-45e0-38eb-8106-406a8e1ec084",
                                                "text": "The beast impatient of his smarting wound, / And of so fierce and forcible despight, / Thought with his wings to stye aboue the ground [...]."
                                            },
                                            {
                                                "example_id": "86a0cb68-ebe3-4ec4-b8a6-e1ca18e41092",
                                                "sense_id": "03093eac-45e0-38eb-8106-406a8e1ec084",
                                                "text": "From this lower tract he dared to stie up to the clowdes."
                                            },
                                            {
                                                "example_id": "56e685d7-f5e2-46a8-866e-4e049203c874",
                                                "sense_id": "03093eac-45e0-38eb-8106-406a8e1ec084",
                                                "text": "Led along, as some Creatures are, by the Noses, and voluntarily hood-winked; or like seeled Doves, sty up, you know not whither, nor how far."
                                            },
                                            {
                                                "example_id": "2066235c-12a9-4a35-93a0-f9b7d5119545",
                                                "sense_id": "03093eac-45e0-38eb-8106-406a8e1ec084",
                                                "text": "That she might sty to the seat of Beatifick Mirth."
                                            }
                                        ]
                                    }
                                ]
                            },
