                "senses": [
                    {
                        "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                        "entry_id": "45a4595e-c002-3f7b-9827-32b4b11b346f",
                        "glosses": [
                            "Protokoll, um von einem Mailclient aus auf E-Mails zugreifen zu können, die auf einem Mailserver liegen"
                        ],
                        "tags": [
                            "meist ohne Artikel"
                        ],
                        "examples": [
                            {
                                "example_id": "63b4ae1c-4c2b-49eb-9df6-63173cfcfe5f",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Um den Speicherplatz des Netbooks nicht unnötig zu strapazieren und bei UMTS-Nutzung die Kosten für die Datenübertragung nicht in die Höhe zu treiben, ist der Zugriff auf E-Mail-Konten per IMAP sinnvoll.“"
                            },
                            {
                                "example_id": "d62b17eb-75e8-440e-915d-6d0a6e3a3088",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Der wesentliche Vorteil an IMAP ist, dass der E-Mail-Client aufgeteilt wird in einen Client-Teil, der für die Kommunikation mit dem Benutzer zuständig ist, und einen Server-Teil, der sich um die Verwaltung von Ordnern und Anhängen kümmert.“"
                            },
                            {
                                "example_id": "ff8429bb-2cd8-421d-94ed-bc947cb75957",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Wichtig ist nur, dass er den Zugriff auf meine E-Mails in Thunderbird über IMAP oder POP3 ermöglicht.“"
                            },
                            {
                                "example_id": "7cdfd6e1-e3c0-4d4b-b9d6-0851dbc28a22",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Dieses komplexe Design macht IMAP zukunftsfähig und flexibel, da sich neue Optionen und Flags einführen lassen, ohne das Protokoll zu ändern.“"
                            },
                            {
                                "example_id": "e44eba7a-15be-4982-bc3f-fa7067933e45",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Die Syntax von SMAP ist der von POP und SMTP ähnlicher als der von IMAP.“"
                            },
                            {
                                "example_id": "9defde8d-2a22-456e-853a-b6aed303f4a9",
                                "sense_id": "9db62d74-e959-3070-91f2-51241caf5654",
                                "text": "„Außerdem unterstützen viele der kostenlosen E-Mail-Anbieter wie GMX das IMAP erst in den kostenpflichtigen Tarifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
