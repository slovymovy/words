                "senses": [
                    {
                        "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                        "entry_id": "7ed269e8-4df2-3d9d-beb5-f195d1008f67",
                        "glosses": [
                            "abgezogenes Fell eines Seeotters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff236fa-0dab-405e-9966-0f683c9dbf1e",
                                "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                                "text": "„Dann winkte er Quentin, ihm den Becher zu reichen, und als er den Wein, mit Wasser vermischt, ausgetrunken hatte, zog er einen großen, aus Seeotterfell verfertigten Beutel hervor und schüttete eine Menge kleiner Silbermünzen in den Becher, bis er über die Hälfte voll sein mochte.“"
                            },
                            {
                                "example_id": "32c56322-d859-4025-953e-763343d010e9",
                                "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                                "text": "„Joseph Ingraham,der von 1791 bis 1792 durch die Charlotte Islands kreuzte, hat damals ein provisorisches Verzeichnis der wichtigsten Haida-Wörter erstellt. Die erste und für ihn wohl wichtigste Vokabel auf der Liste war die Bezeichnung des Seeotterfells: ‹nuk-ky›.“"
                            },
                            {
                                "example_id": "45320f04-1d04-4cd6-a285-528d72fbc88c",
                                "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                                "text": "„Den Unterlegenen wird vorgehalten, daß sie sich nie für die empfangenen Gaben, wie z. B. Seeotterfelle und Boote, revanchierten und sich so selbst entehrten.“"
                            },
                            {
                                "example_id": "25773da6-4f99-4193-a8a2-3e6530cb5eda",
                                "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                                "text": "„Männer, Frauen und Kinder trugen ihrer Körperkraft entsprechende Bündel von Biber-, Seeotter-, Marder-, Bären- und Luchsfellen und schon bearbeitete Elchhäute.“"
                            },
                            {
                                "example_id": "ed88d1e5-9622-4469-a892-74a3a48aa874",
                                "sense_id": "891827a6-0dc8-3b1a-96f0-351052354a3a",
                                "text": "„Die Kamtschadalen trugen sackförmige, mit Seeotterfell gesäumte Kleider, die bei ihnen Parka hießen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
