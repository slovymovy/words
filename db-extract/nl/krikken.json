            {
                "entry_id": "c19b0b10-4da2-3c6e-b703-60737af248ba",
                "word": "krikken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "884b0a17-94bf-3765-824c-cfeb8eac599d",
                        "entry_id": "c19b0b10-4da2-3c6e-b703-60737af248ba",
                        "glosses": [
                            "geslachtsgemeenschap hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249e13a6-86a5-4995-8f1d-5c180f4667ae",
                                "sense_id": "884b0a17-94bf-3765-824c-cfeb8eac599d",
                                "text": "Ook werden er wel eens 'stelletjes' van het toilet gesleurd. Daar werd wel iedereen opgefokt van. Moeten we daarop wachten dat ze liggen te krikken op het toilet."
                            },
                            {
                                "example_id": "c4c6e4d1-e044-438e-9639-ba20700dc911",
                                "sense_id": "884b0a17-94bf-3765-824c-cfeb8eac599d",
                                "text": "Nu had dat meisje nog geen flauw idee dat haar verloofde over een paar uur op de achterbank van hun auto met zijn tennispartner zou liggen te krikken, maar dat zou niet lang meer duren."
                            },
                            {
                                "example_id": "59faf8d2-2de4-4688-a3d5-69eec777c0cf",
                                "sense_id": "884b0a17-94bf-3765-824c-cfeb8eac599d",
                                "text": "Zijn lichaam glansde van het zweet, waarschijnlijk zowel door de drank als het feit dat hij Sophie achterlangs aan het krikken was as if there was no tomorrow."
                            },
                            {
                                "example_id": "b1357894-1cb7-4b63-953b-567f970e32a9",
                                "sense_id": "884b0a17-94bf-3765-824c-cfeb8eac599d",
                                "text": "En die, sorry dat ik het zeg, maar dat is net een stel dat aan het krikken is.' 'Jullie denken ook maar aan één ding,' sneerde Milva."
                            }
                        ]
                    }
