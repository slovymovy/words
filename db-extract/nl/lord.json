                        "sense_id": "a805992b-9410-37b5-9757-ed0b2912e174",
                        "entry_id": "286bebc1-60ca-3fac-9fe3-a811b4fb533a",
                        "glosses": [
                            "aanspreektitel voor een hoge Britse edelman, hoogwaardigheidsbekleder of hogere ambtenaar"
                        ],
                        "tags": [],
