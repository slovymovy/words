                                    {
                                        "sense_id": "27322312-a247-3c5b-88c8-1c441434105d",
                                        "entry_id": "21961d50-34aa-39c9-a6d2-fdfcb52377be",
                                        "glosses": [
                                            "The dead protective tissue between the bark and cambium in woody plants, with suberin deposits making it impervious to gasses and water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d806023-aab5-394d-8306-432c11504ca1",
                                        "entry_id": "21961d50-34aa-39c9-a6d2-fdfcb52377be",
                                        "glosses": [
                                            "The dead protective tissue between the bark and cambium in woody plants, with suberin deposits making it impervious to gasses and water.",
                                            "The phellem of the cork oak, used for making bottle stoppers, flotation devices, and insulation material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88217155-46fc-4150-9436-98e4fa4f7ee7",
                                                "sense_id": "3d806023-aab5-394d-8306-432c11504ca1",
                                                "text": "I confess my confidence was shaken by these actions, though I knew well enough that his leg was no more cork than my own"
                                            },
                                            {
                                                "example_id": "adba6f10-fa4a-4c0b-8734-a42c96eb881d",
                                                "sense_id": "3d806023-aab5-394d-8306-432c11504ca1",
                                                "text": "Because cork is porous, it expands and contracts with changes in humidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aff7f704-6f38-3439-9687-9385f542da41",
                                        "entry_id": "21961d50-34aa-39c9-a6d2-fdfcb52377be",
                                        "glosses": [
                                            "A bottle stopper made from this or any other material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf729e3a-c26f-4ef3-b471-5e4c695f08d8",
                                                "sense_id": "aff7f704-6f38-3439-9687-9385f542da41",
                                                "text": "Snobs feel it's hard to call it wine with a straight face when the cork is made of plastic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d02cbd4-8896-3744-b5ee-ea245c857588",
                                        "entry_id": "21961d50-34aa-39c9-a6d2-fdfcb52377be",
                                        "glosses": [
                                            "An angling float, also traditionally made of oak cork."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c144b40-4008-330f-a72b-7dee2962ffe1",
                                        "entry_id": "21961d50-34aa-39c9-a6d2-fdfcb52377be",
