                    },
                    {
                        "form_id": "800e0a81-6726-4318-8731-73c2f92aa1e0",
                        "entry_id": "0052d521-6b49-3207-98c3-182641cc4b69",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Parteitag"
                    },
                    {
                        "form_id": "6d53b237-7b8d-4800-8c38-2a7806dfdb7e",
                        "entry_id": "0052d521-6b49-3207-98c3-182641cc4b69",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Parteitage"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0a55b57-a64a-3b4a-9ac8-ca303b37a5b3",
                        "entry_id": "0052d521-6b49-3207-98c3-182641cc4b69",
                        "glosses": [
                            "statutarisch geregeltes Treffen von Funktionären und Mitgliedern einer politischen Partei, auf der die sachliche, finanzielle und personelle Politik der Partei diskutiert und festgelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cde163e-ed0c-4fde-86a1-480dd6ea270c",
                                "sense_id": "f0a55b57-a64a-3b4a-9ac8-ca303b37a5b3",
                                "text": "Auf den meisten Parteitagen sind nicht alle Parteimitglieder, sondern aus organisatorischen Gründen nur eine festgelegte Anzahl von Delegierten anwesend."
                            },
                            {
                                "example_id": "4c456207-a6cd-49f5-bf6d-93d448821bd2",
                                "sense_id": "f0a55b57-a64a-3b4a-9ac8-ca303b37a5b3",
                                "text": "„Bereits wenige Tage nach dem Parteitag musste Gabriel eine weitere Schlappe hinnehmen.“"
                            },
                            {
                                "example_id": "debfed3e-a589-4c40-8341-061e3226c14c",
                                "sense_id": "f0a55b57-a64a-3b4a-9ac8-ca303b37a5b3",
                                "text": "„Wahlkämpfe werden mit den Images von Spitzenpolitikern statt mit Parteiprogrammen geführt, Parteitage sollen Fernsehbilder liefern statt programmatische Diskussionen ermöglichen.“"
                            },
                            {
                                "example_id": "0016f1c3-23d4-4914-877d-34bb930768de",
                                "sense_id": "f0a55b57-a64a-3b4a-9ac8-ca303b37a5b3",
                                "text": "„An allen Parteitagen war sie mit Tannengrün und Eichenlaub bekränzt gewesen, und Schimmel, der Direktor, hatte glühende Reden vor ihr gehalten über Rache, Großdeutschland und die kommende Vergeltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
