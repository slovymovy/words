            "pos": "noun",
            "senses": [
                {
                    "sense_id": "589c2b8f-15c1-3f23-ac84-aa52e7b22c46",
                    "sense_definition": "Физическая активность, упражнения и игры, направленные на укрепление здоровья и развитие организма.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я решил заниматься <w>спортом</w>, чтобы улучшить своё здоровье.",
                            "target_lang_translations": {
                                "en": "I decided to take up <w>sports</w> to improve my health.",
                                "zh": "我决定开始<w>运动</w>，以改善我的健康。"
                            }
                        },
                        {
                            "text": "Мой любимый вид <w>спорта</w> — это плавание в бассейне.",
                            "target_lang_translations": {
                                "en": "My favorite <w>sport</w> is swimming in the pool.",
                                "zh": "我最喜欢的<w>运动</w>是游泳。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "заниматься спортом",
                        "вид спорта",
                        "любить спорт"
                    ],
                    "target_lang_definitions": {
                        "en": "Physical activity, exercises, and games aimed at strengthening health and developing the body.",
                        "zh": "旨在增强体质和发展身体的体育活动、练习和比赛。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sport",
                                "target_lang_sense_clarification": "general physical activity"
                            },
                            {
                                "target_lang_word": "sports",
                                "target_lang_sense_clarification": "specific athletic activities"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "运动",
                                "target_lang_sense_clarification": "一般的体育活动"
                            },
                            {
                                "target_lang_word": "体育",
                                "target_lang_sense_clarification": "作为学科或活动的体育"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30681117-699b-39eb-98ac-5bcc18316803",
                    "sense_definition": "Система организации соревнований, профессиональная деятельность атлетов и участие в турнирах.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Профессиональный <w>спорт</w> требует от человека полной самоотдачи и дисциплины.",
                            "target_lang_translations": {
                                "en": "Professional <w>sport</w> requires complete dedication and discipline from a person.",
                                "zh": "职业<w>竞技体育</w>要求人有完全的投入和纪律。"
                            }
                        },
                        {
                            "text": "Он добился больших успехов в <w>спорте</w> и получил золотую медаль.",
                            "target_lang_translations": {
                                "en": "He achieved great success in <w>sports</w> and received a gold medal.",
                                "zh": "他在<w>竞技体育</w>方面取得了巨大成就，并获得了金牌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "профессиональный спорт",
                        "большой спорт",
                        "достижения в спорте",
                        "мастер спорта"
                    ],
                    "target_lang_definitions": {
                        "en": "A system of organizing competitions, professional activity of athletes, and participation in tournaments.",
                        "zh": "组织比赛的系统，运动员的职业活动及参加锦标赛。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sport",
                                "target_lang_sense_clarification": "competitive industry or institution"
                            },
                            {
                                "target_lang_word": "athletics",
                                "target_lang_sense_clarification": "physical sports and games"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竞技体育",
                                "target_lang_sense_clarification": "作为职业或竞争性行业的体育"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fd00270-d933-37b0-86c7-cd08476bbb10",
                    "sense_definition": "Азартное увлечение чем-либо, страсть к какому-либо занятию (часто об охоте, собирательстве или споре).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для него поиск редких книг превратился в настоящий <w>спорт</w>.",
                            "target_lang_translations": {
                                "en": "For him, the search for rare books turned into a real <w>sport</w>.",
                                "zh": "对他来说，搜寻珍本书籍已经变成了一种真正的<w>爱好</w>。"
                            }
                        },
                        {
                            "text": "Мы поспорили с ним просто так, ради <w>спорта</w>.",
                            "target_lang_translations": {
                                "en": "We bet with him just for fun, for the <w>sport</w> of it.",
                                "zh": "我们和他打赌只是闹着玩，纯粹是为了<w>消遣</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ради спорта",
                        "спортивный интерес"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A gambling-like hobby or passionate interest in an activity (often regarding hunting, collecting, or arguing).",
                        "zh": "对某项活动（如狩猎、收藏或争论）的狂热爱好或兴趣。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sport",
                                "target_lang_sense_clarification": "pastime or amusement"
                            },
                            {
                                "target_lang_word": "fun",
                                "target_lang_sense_clarification": "activity done for enjoyment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱好",
                                "target_lang_sense_clarification": "出于兴趣而进行的活动"
                            },
                            {
                                "target_lang_word": "消遣",
                                "target_lang_sense_clarification": "为了娱乐而进行的活动"
                            }
                        ]
