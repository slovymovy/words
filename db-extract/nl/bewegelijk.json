                "senses": [
                    {
                        "sense_id": "32f75ecb-644d-3396-9c34-7c32fcadc306",
                        "entry_id": "6f210b28-db77-35eb-8259-81d789e8d13b",
                        "glosses": [
                            "veel bewegend; snel veranderend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffd6190-a95c-4a18-aa5a-2ef4ff3de8fa",
                                "sense_id": "32f75ecb-644d-3396-9c34-7c32fcadc306",
                                "text": "De meeste beurzen in Azië leden vandaag weer fors verlies. De handel verliep nerveus en bewegelijk en zwalkte op sommige beurzen van zwaar verlies naar lichte winst om weer met verlies te eindigen."
                            },
                            {
                                "example_id": "66882c29-204d-4c3c-a322-7f8e01375d44",
                                "sense_id": "32f75ecb-644d-3396-9c34-7c32fcadc306",
                                "text": "Ook de andere Europese beurzen zijn bewegelijk. In Frankfurt staat de belangrijkste graadmeter 0,5 procent hoger, Londen en Parijs winnen 1,5 tot 2 procent."
                            }
                        ]
                    }
                ],
