                                "target_senses": [
                                    {
                                        "sense_id": "0cba3eca-0c18-3ba1-b547-0bb1cd3ce412",
                                        "entry_id": "c61e92b3-61b5-30fd-970c-aa2f795eff2d",
                                        "glosses": [
                                            "zu Thüringen gehörend, auf Thüringen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5cc12a-f4cc-4d44-a85b-42fc36bd66b6",
                                                "sense_id": "0cba3eca-0c18-3ba1-b547-0bb1cd3ce412",
                                                "text": "Ich werde im Urlaub die thüringischen Städte besuchen."
                                            },
                                            {
                                                "example_id": "d4852adb-84cd-4fc2-ac21-a9783222fc7b",
                                                "sense_id": "0cba3eca-0c18-3ba1-b547-0bb1cd3ce412",
                                                "text": "„Der Bundeswehrübungsplatz im Zeitzer Forst wird unter anderem vom Panzerpionierbataillon 701 aus dem thüringischen Gera genutzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4de0c5f8-c4c2-3d26-b867-af909e0cc251",
                                        "entry_id": "c61e92b3-61b5-30fd-970c-aa2f795eff2d",
                                        "glosses": [
                                            "auf die dort gesprochenen ostmitteldeutschen Dialekte, das Thüringische bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb98c153-b9d7-4f89-bbdd-65cfcaabc5cb",
                                                "sense_id": "4de0c5f8-c4c2-3d26-b867-af909e0cc251",
                                                "text": "„Der größte Teil des thüringischen Wortschatzes wurde durch indirekte schriftliche und direkte mündliche Befragung gewonnen.“"
                                            },
                                            {
                                                "example_id": "bb434794-fb01-45c1-a060-fde923f89b3a",
                                                "sense_id": "4de0c5f8-c4c2-3d26-b867-af909e0cc251",
                                                "text": "„Doch weist Lachmann einen thüringischen Endreim nach und nennt die Mundart der Handschrift, wenn auch nicht des Dichters, auch wahrscheinlich thüringisch;“"
                                            },
                                            {
                                                "example_id": "4b64561f-a246-4334-bfc1-d053e2cac7c5",
                                                "sense_id": "4de0c5f8-c4c2-3d26-b867-af909e0cc251",
                                                "text": "„danach halte ich vorläufig folgendes für sicher: C ist rheinfränkisch, D alemannisch, F thüringisch;“"
                                            },
                                            {
                                                "example_id": "eebfa5c7-3153-465f-91db-65919b0d7d5c",
                                                "sense_id": "4de0c5f8-c4c2-3d26-b867-af909e0cc251",
                                                "text": "„Trommel-Meier und Knecht Stolten traten näher und grinsten Kurt Marenke an, der ostpreußisch, berlinerisch, sächsisch und thüringisch durcheinandersprach, wie es die Zeiten so mit sich gebracht hatten.“"
