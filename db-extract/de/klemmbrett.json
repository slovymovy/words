                                "sense_id": "d2a74fad-cc70-38e7-8512-ca227f55e58b",
                                "text": "Der Mann hat sein Klemmbrett auf die Baustelle mitgenommen."
                            },
                            {
                                "example_id": "3906535a-71ca-4fc3-b14b-b16dddeac03c",
                                "sense_id": "d2a74fad-cc70-38e7-8512-ca227f55e58b",
                                "text": "„Während der Hagere den Raum verließ, schnappte sich Grenfeld dessen Klemmbrett.“"
                            }
                        ],
