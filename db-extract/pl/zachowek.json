                "senses": [
                    {
                        "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                        "entry_id": "fc1bf213-c5c1-39cd-b04a-e4fca3b56157",
                        "glosses": [
                            "legitim (common in Continental Law jurisdictions, a portion of property fixed by law, which a testator with issue is bound to bequeath to his children)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine",
                            "singular",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "19bf32e2-2bf5-4cea-b747-02cf17d7cbd9",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "obliczanie/pokrycie/uzupełnienie zachowku",
                                "translation": "calculation/covering/ of a legitim",
                                "english": "calculation/covering/ of a legitim"
                            },
                            {
                                "example_id": "684e89b7-7570-4e7a-b079-bd5ff1d9c0aa",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "wielkość zachowku",
                                "translation": "size of a legitim",
                                "english": "size of a legitim"
                            },
                            {
                                "example_id": "74954f3d-7aeb-498f-bdad-f3fedbf67284",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "prawo do zachowku",
                                "translation": "right to a legitim",
                                "english": "right to a legitim"
                            },
                            {
                                "example_id": "0d54048f-cde1-47a0-9110-1a550f35382e",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "z tytułu zachowku ― by way of legitim"
                            },
                            {
                                "example_id": "a7855244-2335-4a10-b5f1-7b7e16ff30e6",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "W przedmiocie oszacowania darowizn w celu utworzenia masy zachowku oraz części rozrządzalnej nastąpiła (w tekście art. 922 k. c. Nap.) zmiana[…]",
                                "translation": "With regard to the valuation of donations for the purpose of establishing the legitim and the disposable portion, a change has been made (in Article 922 of the Napoleonic Civil Code) […]",
                                "english": "With regard to the valuation of donations for the purpose of establishing the legitim and the disposable portion, a change has been made (in Article 922 of the Napoleonic Civil Code) […]"
                            },
                            {
                                "example_id": "0c0e4198-af8b-4599-9ae0-c93a88139eb3",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "Z akcją o zmniejszenie na zasadzie art. 1079 KC. darowizny. uczynionej prze jednego małżonka na rzecz drugiego, może wystąpić tylko spadkobierca konieczny, i przepis art. 921 KC., zezwalający żądać zmniejszenia rozporządzeń między żyjącymi zarówno osobom, na których korzyść prawo zastrzega zachowek, jak i ich spadkobiercom lub następcom, nie ma zastosowania do przypadku przewidzianego w art. 1099 KC.",
                                "translation": "Only a necessary heir may bring an action to reduce, pursuant to Article 1079 of the Civil Code, a donation made by one spouse to the other, and the provision of Article 921 of the Civil Code, which allows for a reduction in dispositions between living persons to be requested both by persons in whose favour the law reserves legitim and by their heirs or successors, does not apply to the case provided for in Article 1099 of the Civil Code.",
                                "english": "Only a necessary heir may bring an action to reduce, pursuant to Article 1079 of the Civil Code, a donation made by one spouse to the other, and the provision of Article 921 of the Civil Code, which allows for a reduction in dispositions between living persons to be requested both by persons in whose favour the law reserves legitim and by their heirs or successors, does not apply to the case provided for in Article 1099 of the Civil Code."
                            },
                            {
                                "example_id": "c9b2b10e-d0f9-4366-b200-9c3240d23f66",
                                "sense_id": "b832bc6d-e94b-384b-ab4d-4f511dc0a646",
                                "text": "Zachowek jest to część spadku należna osobom najbliższym zmarłego, niezależnie od tego, kto został przez niego powołany do spadku w testamencie. Ustanowienie prawa do zachowku opiera się na założeniu, że każdy człowiek, w razie śmierci, ma moralny obowiązek pozostawienia choćby części majątku swoim najbliższym.",
                                "translation": "A legitim is a portion of the estate due to the deceased's closest relatives, regardless of who was named as beneficiaries in the will. The establishment of the right to a legitim is based on the premise that every person, in the event of death, has a moral obligation to leave at least a portion of their estate to their closest relatives.",
                                "english": "A legitim is a portion of the estate due to the deceased's closest relatives, regardless of who was named as beneficiaries in the will. The establishment of the right to a legitim is based on the premise that every person, in the event of death, has a moral obligation to leave at least a portion of their estate to their closest relatives."
                            }
                        ]
                    }
