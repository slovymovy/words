                        "examples": [
                            {
                                "example_id": "69fe6290-d924-4295-befb-c49bdfbfc102",
                                "sense_id": "91130294-746c-3d4d-a238-5e4996f37dd9",
                                "text": "Seine Anwesenheit auf der Burg oder dem befestigten Hof nutzte der Ritter während Friedenszeiten zur Vorbereitung auf künftige kriegerische Handlungen und zur Sicherstellung der täglichen Ernährung.",
                                "translation": "En temps de paix, le chevalier profitait de sa présence au château ou à la ferme fortifiée pour se préparer à de futures actions militaires et assurer son alimentation quotidienne."
                            }
                        ]
