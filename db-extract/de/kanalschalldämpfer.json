                ],
                "senses": [
                    {
                        "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                        "entry_id": "c65f8f90-bad4-3daa-91ed-a85b8565d72d",
                        "glosses": [
                            "Einbauteil zu einem Lüftungskanal, zur Schalldämpfung oder gezielten Verminderung der Schallübertragung einer Maschine oder Anlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac6f36e9-f957-416c-a510-daf8bce00d36",
                                "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                                "text": "„Kanalschalldämpfer bestehen aus Kulissen, die in rechteckiges Luftleitungen eingebaut werden.“"
                            },
                            {
                                "example_id": "74f0fac0-185b-4998-95e9-a69101a69fad",
                                "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                                "text": "„Das Material der Maico Kanalschalldämpfer ist gemäß der DIN Norm 4102 nicht brennbar.“"
                            },
                            {
                                "example_id": "75cbeb16-6e95-4da0-b54a-96e4dcb1372b",
                                "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                                "text": "„Aufgrund des Platzmangels in der Anlage wurde dieser Kanalschalldämpfer in Verbindung mit einer von uns gelieferten Schallschutzkapsel kombiniert.“"
                            },
                            {
                                "example_id": "93253bc8-208b-41c3-9df2-8883cd803422",
                                "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                                "text": "„Kanalschalldämpfer werden auftragsbezogen gefertigt und sind von Umtausch bzw. Rückgabe ausgeschlossen!“"
                            },
                            {
                                "example_id": "433e4836-5671-4056-8a41-053816ff5f93",
                                "sense_id": "fe800778-ac48-3b23-a86c-f8b79c037632",
                                "text": "„Aufgabe des erfindungsgemäßen aktiven Kanalschalldämpfers ist es, die genannten Probleme bei hohen Strömungsgeschwindigkeiten, Stehwellen im Kanal und Partialresonanzen der Lautsprechermembran erheblich zu minimieren sowie zugleich die Anpassung des Dämpfungsspektrums an ein gegebenes Lärmspektrum deutlich zu vereinfachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
