                                "target_senses": [
                                    {
                                        "sense_id": "2b05e3c3-c3db-3453-a85c-bad17e5ab101",
                                        "entry_id": "38c46c6f-a735-3ac0-8ceb-d221d5e92f9f",
                                        "glosses": [
                                            "een ruimte waar men voorraden opslaat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33472c5-7a9d-47d2-be55-34cb1846e09f",
                                                "sense_id": "2b05e3c3-c3db-3453-a85c-bad17e5ab101",
                                                "text": "In de provisiekamer hebben we nog wel wat blikken bonen staan."
                                            },
                                            {
                                                "example_id": "fbc950f9-e824-4089-88a2-3355c6a948e5",
                                                "sense_id": "2b05e3c3-c3db-3453-a85c-bad17e5ab101",
                                                "text": "Toen ik die eerste keer voor hem stond, in de gang voor de provisiekamer, had ik net zo goed een teleurstellend kleine houtduif kunnen zijn die hij wel of niet zou laten plukken voor het eten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7368e04f-38c8-416e-bd58-2c35ba159dfc",
                        "source_entry_id": "d84ebe2b-7f9b-3edf-ab3b-9177f763edb7",
