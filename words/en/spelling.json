                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to go to the <w>spelling</w> at the schoolhouse.",
