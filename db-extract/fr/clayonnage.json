                ],
                "senses": [
                    {
                        "sense_id": "4fe90d5b-2b13-3b57-8bba-f1de3c8f8067",
                        "entry_id": "f1547f88-1534-3a1e-8f1b-750a69ba4d51",
                        "glosses": [
                            "Assemblage fait avec des pieux et des branches d’arbres en forme de claies, pour empêcher la terre de s’ébouler, ou pour protéger les berges d'une rivière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76880d46-2da6-4bdb-8b68-c047f69df2aa",
                                "sense_id": "4fe90d5b-2b13-3b57-8bba-f1de3c8f8067",
                                "text": "À quelques centaines de toises en amont, se trouvait un pont de clayonnage soutenu par des lanières de cuir et suspendu à la mode indienne."
                            },
                            {
                                "example_id": "e5690993-2c98-41cf-b667-ee8e0d13d3e2",
                                "sense_id": "4fe90d5b-2b13-3b57-8bba-f1de3c8f8067",
                                "text": "À peine séparés de ce groupe d’insomnies par un clayonnage décrépit, trois ou quatre sous-officiers ronflaient dans le pauvre grand lit de leurs noces."
                            },
                            {
                                "example_id": "9a31a247-a016-45b2-ad58-6592f6d2a22c",
                                "sense_id": "4fe90d5b-2b13-3b57-8bba-f1de3c8f8067",
                                "text": "— Dans les petites éducations, on se contente de couveuses en osier, sortes de paniers à couvercles qui portent aux 2/3 de leur hauteur un clayonnage destiné à recevoir les boîtes …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef3f0f9c-9b16-4ba9-ad49-77512b78185f",
                        "source_entry_id": "f1547f88-1534-3a1e-8f1b-750a69ba4d51",
                        "source_sense_id": "4fe90d5b-2b13-3b57-8bba-f1de3c8f8067",
