                "senses": [
                    {
                        "sense_id": "2e6b0ac6-d155-3551-bd76-3697cd63d885",
                        "entry_id": "94dbc551-a29c-32ab-b679-0558d4cdcfc4",
                        "glosses": [
                            "Einrichtung für den Dampfdruckausgleich bei Fenstern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c3bfafc-dd05-44f5-8930-201869d66623",
                                "sense_id": "2e6b0ac6-d155-3551-bd76-3697cd63d885",
                                "text": "„Die Glasfalzentlüftung sorgt für Luftzirkulation hinter dem Isolierglas und läßt eventuell entstandenes Kondenswasser in die Regenschiene ablaufen.“"
                            },
                            {
                                "example_id": "1d811043-5028-49e5-97b7-c4f490cdce8e",
                                "sense_id": "2e6b0ac6-d155-3551-bd76-3697cd63d885",
                                "text": "„Die Erstbeklagte erteilte der Klägerin keinen Auftrag, eine Glasfalzentlüftung einzubauen.“"
                            },
                            {
                                "example_id": "20264242-7b45-4b76-b145-9316edb99e45",
                                "sense_id": "2e6b0ac6-d155-3551-bd76-3697cd63d885",
                                "text": "„Für den Dampfdruckausgleich erfolgt die Glasfalzentlüftung bei Holzfensterflügeln i. d. R. über eine Nut im Eckstoß, welche im Bereich der Wetterschutzschiene endet.“"
                            },
                            {
                                "example_id": "b71104a0-5329-42b6-8f24-917fe17feeb3",
                                "sense_id": "2e6b0ac6-d155-3551-bd76-3697cd63d885",
                                "text": "„Hingewiesen wird bei Huber in diesem Zusammenhang zum Beispiel auf schräge gebohrte Glasfalzentlüftungen, eine Vier-Millimeter-Falzluft-Fräsung sowie alle Bohrungen im Durchlauf ohne Mehraufwand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
