                "senses": [
                    {
                        "sense_id": "1bfd9bd6-8383-3143-980b-1f6abc062323",
                        "entry_id": "8fda0274-acda-3c6e-b2c1-a5d2f5f3ad04",
                        "glosses": [
                            "Rendre net (au figuré)."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "74372d05-d037-4a45-a08c-39ce470a5865",
                                "sense_id": "1bfd9bd6-8383-3143-980b-1f6abc062323",
                                "text": "Ce fut un feu roulant de bons mots, un assaut général d'esprit que le Champagne sembla avoir, sinon épuré, du moins nettifié, qui vint les distraire encore plus doucement."
                            },
                            {
                                "example_id": "5ce0b4b5-4185-46c3-be9d-5233cba9550d",
                                "sense_id": "1bfd9bd6-8383-3143-980b-1f6abc062323",
                                "text": "Il serait trop facile de pousser encore plus avant la démonstration de cette vérité banale si méconnue, et de la nettifier le plus expérimentalement du monde en la personne de Flaubert."
                            }
                        ]
                    }
                ],
