                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b6437d-1c3d-4bea-9279-fac8bfaece84",
                                "sense_id": "7f1bf21f-4510-347d-98a9-f9984a4103fa",
                                "text": "„Denn die Kenntnis richtiger Schreibung beschleunige enorm das Lesetempo, sagt die Pädagoginprofessorin Valtin.“"
                            },
                            {
                                "example_id": "bd519cf3-b4e5-4e58-821f-73929236825c",
                                "sense_id": "7f1bf21f-4510-347d-98a9-f9984a4103fa",
                                "text": "„Alle Kinder müssen die Möglichkeit haben entsprechend ihren Lesevoraussetzungen, Lesetempi und Lesebedürfnissen lesen zu können.“"
                            }
                        ],
