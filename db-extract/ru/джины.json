                "senses": [
                    {
                        "sense_id": "d8dbae9d-4dfc-3e61-a53a-2b67033f2a2a",
                        "entry_id": "25deb7c3-fb06-39fe-b340-54f0a0bb60a2",
                        "glosses": [
                            "сленг джинсы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a51b183-e920-4c40-a06b-42a6b7ad3334",
                                "sense_id": "d8dbae9d-4dfc-3e61-a53a-2b67033f2a2a",
                                "text": "— Тридцать шесть. — Джины носить уже не стоит… — Извините, Верочка, а джины — это что такое? — Людмила Прокофьевна, вы меня удивляете. Джины — это по-нашему джинсы…"
                            },
                            {
                                "example_id": "56ba3faa-50fc-4793-b056-267db19bb076",
                                "sense_id": "d8dbae9d-4dfc-3e61-a53a-2b67033f2a2a",
                                "text": "На широких плечах голубела джинсовая жилетка на многих заклёпках, вместо нормальных штанов он носил потёртые джины."
                            }
                        ]
                    }
