                    {
                        "translation_id": "6d8b9e29-67d1-47ea-8b74-8de26869c37b",
                        "source_entry_id": "0ee3ddca-f18f-35ba-904b-0c882bb376b6",
                        "source_sense_id": "07cc8a40-91ca-3ced-9264-1c31ce7a69b0",
                        "target_lang_word": "инвектива",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инвектива",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "68116dd6-ffef-34ab-8bc3-b68c0b3e8c61",
                                        "entry_id": "b5999afa-de92-3cd1-94aa-66812ae8a8af",
                                        "glosses": [
                                            "книжн. резкое выступление против кого-либо, чего-либо; оскорбительная речь, брань, выпад"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "677bd2f3-7790-49a7-ac39-576327f2eefd",
                                                "sense_id": "68116dd6-ffef-34ab-8bc3-b68c0b3e8c61",
                                                "text": "Требования навести порядок жесткой рукой будут чередоваться с инвективами части либералов в адрес власти, виновной в гибели оппозиционного политика."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60326cdb-93d0-3010-b8d3-771b63384a21",
                                        "entry_id": "b5999afa-de92-3cd1-94aa-66812ae8a8af",
                                        "glosses": [
                                            "форма литературного произведения, одна из форм памфлета, осмеивающего или обличающего реальное лицо или группу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d81d5076-ba2e-455f-9d73-7fea78353d1c",
                                                "sense_id": "60326cdb-93d0-3010-b8d3-771b63384a21",
                                                "text": "Не случайно эта инвектива родилась при чтении статьи Ф. Зелинского."
                                            },
                                            {
                                                "example_id": "b0c97ac0-fa34-4fa0-8375-6b13c7a0c54b",
                                                "sense_id": "60326cdb-93d0-3010-b8d3-771b63384a21",
                                                "text": "Комедия Аристофана ― уже вполне созревшая могучая социально-политическая сатира. 〈…〉 В традиционную структуру её входит комический народно-праздничный агон, сатирико-полемическая инвектива (парабаза)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
