                "senses": [
                    {
                        "sense_id": "869d82cf-989a-384a-8115-0ec04094f9ed",
                        "entry_id": "1436fe2e-11d4-3555-8dea-f2e9ff548ba1",
                        "glosses": [
                            "to roll up, to tuck up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71915702-67fe-48eb-af86-49b8625c7b0c",
                                "sense_id": "869d82cf-989a-384a-8115-0ec04094f9ed",
                                "text": "приня́ться за де́ло, засучи́в рукава́",
                                "translation": "to roll up one's sleeves and set to work",
                                "english": "to roll up one's sleeves and set to work"
                            },
                            {
                                "example_id": "342bb59a-8fb5-4ce0-8bc9-de77f823cb76",
                                "sense_id": "869d82cf-989a-384a-8115-0ec04094f9ed",
                                "text": "Бормента́ль повы́ше засучи́л рукава́ руба́шки и дви́нулся к Ша́рикову. Фили́пп Фили́ппович загляну́л ему́ в глаза́ и ужасну́лся.",
                                "translation": "Bormental rolled up his shirt-sleeves and advanced on Sharikov. Philip Philipovich took one look at his eyes and was horrified by what he saw there.",
                                "english": "Bormental rolled up his shirt-sleeves and advanced on Sharikov. Philip Philipovich took one look at his eyes and was horrified by what he saw there."
                            }
                        ]
                    }
                ],
