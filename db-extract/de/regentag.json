                ],
                "senses": [
                    {
                        "sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                        "entry_id": "1ea1def8-e58c-3c6b-9fa1-7e76236c42a5",
                        "glosses": [
                            "Tag, an dem es nahezu ohne Unterbrechung regnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a43a95-5155-46a4-84ce-dbccc352dd2b",
                                "sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                                "text": "An Regentagen spielen die Kinder meistens im Haus."
                            },
                            {
                                "example_id": "2733de2d-ba85-43cb-8fff-c69420b7478c",
                                "sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                                "text": "„So könnte sich die Regenmenge im Sommer nicht wesentlich ändern, aber auf weniger Regentage verteilt werden, an denen mehr Niederschlag fällt.“"
                            },
                            {
                                "example_id": "9d43dd47-a3ae-4f54-9601-42a8e1b09873",
                                "sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                                "text": "„Amalia hatte diese Theorie, dass Teenager an Regentagen besonders unausstehlich sind.“"
                            },
                            {
                                "example_id": "f1b958a4-fd5e-4878-a135-5938f4616811",
                                "sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                                "text": "„Es war an einem Regentag im Juli.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df6cf5c3-4d18-4892-95c7-d2bdcd371582",
                        "source_entry_id": "1ea1def8-e58c-3c6b-9fa1-7e76236c42a5",
                        "source_sense_id": "3ab1762a-1135-3ec5-b454-b22a6db7fbc5",
                        "source_sense_description": "Tag, an dem es nahezu ohne Unterbrechung regnet",
                        "target_lang_word": "rainy day",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainy day",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcbac31f-3c6a-3c97-9021-3a3bcfa577b1",
                                        "entry_id": "a5b02490-6eec-3119-91df-feba2c0409f5",
                                        "glosses": [
                                            "A difficult period of need, in reference to a time when money will be needed."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "111af343-19f3-4757-936e-c98892d9b49a",
                                                "sense_id": "bcbac31f-3c6a-3c97-9021-3a3bcfa577b1",
                                                "text": "I've kept some money in the bank for a rainy day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e05334-bcf9-3566-8716-67bce88936a8",
                                        "entry_id": "a5b02490-6eec-3119-91df-feba2c0409f5",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see rainy, day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d2b0859-4cf6-4c9e-84fe-24dea20e456b",
                                                "sense_id": "43e05334-bcf9-3566-8716-67bce88936a8",
                                                "text": "Rainy days and Mondays always get me down."
                                            },
                                            {
                                                "example_id": "9cf21e6b-4d2c-4790-87a1-57118cc19b76",
                                                "sense_id": "43e05334-bcf9-3566-8716-67bce88936a8",
                                                "text": "Sometimes on a rainy day I sit around and weed the losers out of my address book."
                                            },
                                            {
                                                "example_id": "1510cb72-2486-49fd-995d-0e1b65745be2",
                                                "sense_id": "43e05334-bcf9-3566-8716-67bce88936a8",
                                                "text": "My rainy-day tour in April during the first lockdown was, in fact, a homage to Sir John Betjeman - the poet and railway campaigner whose statue can be found on the upper concourse of St Pancras station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
