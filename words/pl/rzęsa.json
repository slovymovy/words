                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Rzęsa</w> podpisała wczoraj wszystkie przygotowane dokumenty.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Женса</w> подписала вчера все подготовленные документы."
                            }
                        },
                        {
                            "text": "Spotkałem wczoraj Annę <w>Rzęsę</w> w drodze do pracy.",
                            "target_lang_translations": {
                                "ru": "Вчера по дороге на работу я встретил Анну <w>Женсу</w>."
                            }
                        }
