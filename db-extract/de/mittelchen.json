                "senses": [
                    {
                        "sense_id": "6252c9c8-8f5c-3731-8b1f-7b408b61ed54",
                        "entry_id": "78a940cc-9a53-3bf9-a404-b76fd6be8e8d",
                        "glosses": [
                            "Arzneimittel, dem eine gewisse Wirksamkeit zugetraut wird und das als relativ unbedenklich gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "596130f3-c7b7-4538-8846-d018ea6bb688",
                                "sense_id": "6252c9c8-8f5c-3731-8b1f-7b408b61ed54",
                                "text": "„Die hatte garantiert das passende Mittelchen für jedes Wehwehchen.“"
                            },
                            {
                                "example_id": "431b252b-1c1a-4e53-bdb5-a0f1120ab8a5",
                                "sense_id": "6252c9c8-8f5c-3731-8b1f-7b408b61ed54",
                                "text": "„Und dann gibt es noch diejenigen, die auf ganz andere Mittelchen setzen, um Wunder zu bewirken.“"
                            },
                            {
                                "example_id": "064bf1f5-a748-4191-868e-e62782f92f73",
                                "sense_id": "6252c9c8-8f5c-3731-8b1f-7b408b61ed54",
                                "text": "„Natürlich sollte jeder die Freiheit haben, Mittelchen einzunehmen und Behandlungsmethoden auszuprobieren, von denen er glaubt, sie helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
