                    {
                        "translation_id": "b5740e5c-9b02-497f-94cf-7bfe3c764627",
                        "source_entry_id": "e394f70d-9bc8-3c6f-bd0e-c35749ad3358",
                        "source_sense_id": "20fdb704-449e-3bb9-b524-10c1096af96a",
