                ],
                "translations": [
                    {
                        "translation_id": "c20c408a-90ff-4643-a870-e21c2c6eafc6",
                        "source_entry_id": "2550db70-53ed-30c0-899a-4cfc65b5477a",
                        "source_sense_id": "380c6c27-0973-3d04-9019-467d93377037",
                        "target_lang_word": "emperor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emperor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "The male monarch or ruler of an empire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352f4d10-f3b1-4bcf-aafb-157998498422",
                                                "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                                "text": "In imperial China, it was often a responsibility of the emperor to evaluate his predecessor after the latter's death."
                                            },
                                            {
                                                "example_id": "cfa7f825-7745-4122-8432-d54c0c2ca6eb",
                                                "sense_id": "d41e0a4e-2f17-3b19-b18b-1929d92bdfb6",
                                                "text": "They asked Julius Caesar, the valiant Roman emperor, what was the best death. He answered, that which is unexpected, which comes suddenly and unforeseen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any monarch ruling an empire, irrespective of gender, with \\\"empress\\\" contrasting to mean the consort of an emperor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6adb38b5-6a3e-4f8e-8449-a8f8167817d5",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Where is Sindbad? I have a summons for him direct from the galactic emperor herself. He is to be brought here immediately to give an explanation for his recent actions."
                                            },
                                            {
                                                "example_id": "0ceaf72c-cd35-4ca1-83eb-857b8ef8f51f",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "In 690 Wu usurped the throne and became Emperor herself, which proved a unique event in the history of China."
                                            },
                                            {
                                                "example_id": "26ad612b-edd3-4ac2-a143-3720d0610a1f",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "After his death in 683 she ruled for seven years as regent and then, deposing her son, became emperor herself, the only woman in Chinese history to hold the title."
                                            },
                                            {
                                                "example_id": "4483b860-bb80-4c1c-acb0-b4ecb3a68172",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Empress, imperial regent, and even emperor herself (r. 797–802), Irene was an important and powerful figure at the Byzantine court in the late eighth and early ninth century."
                                            },
                                            {
                                                "example_id": "dea9ddad-c31d-412b-b1d0-58a7e17f810b",
                                                "sense_id": "36a4632c-5db1-3d9a-b483-ce53b74befd0",
                                                "text": "Originally the wife of the emperor, she engineered the imperial succession so that she could serve first as regent to a boy emperor and then as emperor herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040639e4-84f1-37d3-a5dc-16b3d8b15d0b",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Specifically, the ruler of the Holy Roman Empire; the world-monarch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3876069f-454f-4b6c-aee9-20b7c2f11ab9",
                                                "sense_id": "040639e4-84f1-37d3-a5dc-16b3d8b15d0b",
                                                "text": "The Investiture Controversy was a conflict between the Emperor and the Pope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b9f05c8-6ccf-3000-9bf0-4948c05d311b",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "The fourth trump or major arcana card of the tarot deck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bacb5470-3a03-3277-9535-fb957293c037",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "A large, relatively valuable marble in children's games."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f9f86d-145d-4866-81e3-12bafbe60005",
                                                "sense_id": "bacb5470-3a03-3277-9535-fb957293c037",
                                                "text": "But marbles are not only used to play games: they are also traded. In this market, the value of the different kinds of marbles (oilies, emperors, etc.) is determined by local supply and demand and not by the price of the marbles […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d29f97ff-dab0-3d54-9e3f-3eba900c461f",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any fish of the family Lethrinidae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1545d345-e31b-3483-93f8-39188f1c0212",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any of various butterflies of the subfamily Charaxinae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81a35fc4-c83d-3a6e-8557-ec485c96f79e",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "Any of various large dragonflies of the cosmopolitan genus Anax."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                        "entry_id": "b6ef1cfe-90ad-3276-99ec-24829ef8b406",
                                        "glosses": [
                                            "An emperor penguin (Aptenodytes forsteri)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317dff1d-3444-4244-ad6d-9861e0ecc910",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "During pairing, mates walk an average of only 90 m per day, and, while incubating, male emperors move an average of 30 m per day."
                                            },
                                            {
                                                "example_id": "c30d1006-a5b2-45fd-8a24-885a581ab4ec",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "We do not know if the emperors are monogamous. I know some of the penguins species mate for life."
                                            },
                                            {
                                                "example_id": "19a0a0d6-6a5a-494b-8bbd-915c855187a8",
                                                "sense_id": "5a6f90c1-bb48-394c-b96b-e2514045265e",
                                                "text": "If they were emperors, I wanted a better view. Being told they were emperors was no good; I needed to see them. But as quickly as we had spotted them, they spotted us. Sliding on their bellies, two emperors began to rush over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abe05e9c-f700-4774-bdae-e16c3b2258db",
                        "source_entry_id": "2550db70-53ed-30c0-899a-4cfc65b5477a",
                        "source_sense_id": "380c6c27-0973-3d04-9019-467d93377037",
                        "target_lang_word": "dictator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dictator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A totalitarian leader of a country, nation, or government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ce7ddd-d6f6-4bc2-a950-95ae924056ab",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "The Dominicans had lived for thirty years under the iron-fisted rule of dictator Leonidas Trujillo. During those years, which ended with Trujillo's assassination in 1961, those who opposed Trujillo had three choices: to go into exile, to go underground, or to remain quiet. Most Dominicans had chosen the third course."
                                            },
                                            {
                                                "example_id": "10c2eeaf-88db-4f27-a3c0-90385fedc556",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "Dictator, noun : someone who doesn't let American CEOs dictate how their country is run"
                                            },
                                            {
                                                "example_id": "cc49cdae-b511-408a-8c18-d2ff483cfd4d",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "\"The reason why Xi Jinping got very upset in terms of when I shot that balloon down with two box cars full of spy equipment in it was he didn't know it was there,\" Biden said.\n\"That's a great embarrassment for dictators. When they didn't know what happened. That wasn't supposed to be going where it was. It was blown off course,\" Biden said."
                                            },
                                            {
                                                "example_id": "fac3a33a-6b94-44c9-9d90-6283ac7ff85a",
                                                "sense_id": "a111264b-8924-3503-a434-fc045e135185",
                                                "text": "A monument to Soviet dictator Josef Stalin erected in Moscow's metro is stirring debate, with some Russians welcoming it as a historical tribute, but others saying it's a mistake to commemorate someone who presided over so much suffering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf05568b-2935-3adb-ba89-3810c4046464",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A magistrate without colleague in republican Ancient Rome, who held full executive authority for a term granted by the Senate, typically to conduct a war."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "768355f0-9d06-34a1-9d83-d1971e739f24",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "A tyrannical boss or authority figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74766711-4123-31c4-9b3b-0e96345cb938",
                                        "entry_id": "2c23cae3-1e76-3750-9a76-46b79f213c46",
                                        "glosses": [
                                            "Misspelling of dictater."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "misspelling"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbc1632f-6b9f-48cc-810d-f75b98fad566",
                        "source_entry_id": "2550db70-53ed-30c0-899a-4cfc65b5477a",
                        "source_sense_id": "380c6c27-0973-3d04-9019-467d93377037",
