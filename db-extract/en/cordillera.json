                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27c5b7fd-6fec-4097-baa5-2e508b4103fe",
                        "source_entry_id": "a2d34317-52a7-3b0b-92c7-3a4f4270be7a",
                        "source_sense_id": "52684a73-e507-3904-9ccb-d97307489d1a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "cordillère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordillère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd6a194-e6cc-324f-b12b-97bafc0616eb",
                                        "entry_id": "0d7fd2f0-9266-3efe-b015-647b9d4a8947",
                                        "glosses": [
                                            "Chaine de montagnes allongée et étroite résultant généralement de la rencontre de deux plaques tectoniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1741cd-db2d-46ec-9096-1cc061e512d0",
                                                "sense_id": "7fd6a194-e6cc-324f-b12b-97bafc0616eb",
                                                "text": "Puis commence la descente, vers l'ouest, le long du flanc septentrional de la cordillère qui forme l’épine dorsale de l'île."
                                            },
                                            {
                                                "example_id": "18ce0f64-3e60-4d04-bb19-c14f696dd021",
                                                "sense_id": "7fd6a194-e6cc-324f-b12b-97bafc0616eb",
                                                "text": "S’étendant sur 7000 km, la cordillère des Andes possède les plus hauts points de la surface terrestre après l’Himalaya."
                                            },
                                            {
                                                "example_id": "f1fbc24a-24dd-44e6-8051-b0d9f09aebd8",
                                                "sense_id": "7fd6a194-e6cc-324f-b12b-97bafc0616eb",
                                                "text": "Les régions orientales de la Colombie, situées au-delà de la cordillère, ainsi que le Trapèze amazonien, ont été pendant des siècles considérées comme des « territoires sauvages », des espaces vides ou des « enfers verts ». Même aujourd'hui, quand on pense aux Indiens de l’Amazonie colombienne, on les imagine souvent comme des groupes d'individus isolés […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aee3887-ac8c-3907-a2ef-10aebb9f8ee4",
                                        "entry_id": "0d7fd2f0-9266-3efe-b015-647b9d4a8947",
                                        "glosses": [
                                            "Alignement (ressemblant à une chaîne de montagnes allongée et étroite)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ed1c6af-a177-4073-a01a-2f716dfda059",
                                                "sense_id": "6aee3887-ac8c-3907-a2ef-10aebb9f8ee4",
                                                "text": "Lagos comptait alors environ 5 millions d’habitants. J’aimais cette métropole lagunaire avec ses pieds dans l’eau, notamment dans les bidonvilles sous les ponts autoroutiers reliant ses îles et péninsules à la terre ferme, et sa tête dans les nuages le long de la marina – une cordillère de gratte-ciel qui étaient à cette époque encore rares au sud du Sahara."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
