                "translations": [
                    {
                        "translation_id": "5655b68c-6139-4a2f-9ef0-50a64c5a3596",
                        "source_entry_id": "ea200025-906b-3383-be73-d81b3bdb1e74",
                        "source_sense_id": "16c50e4b-c860-3745-a5a0-6954e9dc5513",
                        "source_sense_description": "the property of being rabid",
                        "target_lang_word": "férocité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "férocité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                        "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                                        "glosses": [
                                            "Naturel féroce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032eed56-6a1d-44c6-b5a5-bd959818b04b",
                                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                                "text": "La férocité des conventionnels s’explique facilement par l’influence des conceptions que le Tiers État avait puisées dans les pratiques détestables de l’Ancien Régime."
                                            },
                                            {
                                                "example_id": "8996c772-1b34-4cf9-a178-935ed871b86d",
                                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                                "text": "Comme Tonsard, que son renom dispensait de toute preuve de férocité, comme tous ceux qui sont gardés par une opinion publique quelconque, Socquard ne déployait jamais sa triomphante force musculaire, à moins que des amis ne l’en priassent."
                                            },
                                            {
                                                "example_id": "69b00d6e-2784-42d8-8444-cecccff97b75",
                                                "sense_id": "839fb82b-da26-36d0-9e64-188f14c4a0bc",
                                                "text": "La férocité est naturelle au lion, au tigre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c0965f4-b23a-35cc-8f7f-80b257e15f5f",
                                        "entry_id": "a3c441a4-b8e1-3d06-b6f0-2309c73d7946",
                                        "glosses": [
                                            "Aspect féroce."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327c936f-472c-4fdb-ac64-09ed8a80d81c",
                                                "sense_id": "1c0965f4-b23a-35cc-8f7f-80b257e15f5f",
                                                "text": "Les cicatrices […] ne faisaient qu’ajouter à la férocité de son visage et à la terreur que sa présence inspirait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "378d67c1-185f-4fee-99f5-d385bf2f354e",
                        "source_entry_id": "ea200025-906b-3383-be73-d81b3bdb1e74",
                        "source_sense_id": "16c50e4b-c860-3745-a5a0-6954e9dc5513",
                        "source_sense_description": "the property of being rabid",
                        "target_lang_word": "Fanatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fanatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                        "entry_id": "8dd0bdc7-e74a-366b-9999-a6d796b02cb4",
                                        "glosses": [
                                            "kompromissloser, rücksichtsloser Einsatz dafür, etwas, das man für allein richtig hält, allgemein durchzusetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e3f1ae-af47-49e7-85d9-2d6dadffae4d",
                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Ihren Hauptgegner sah die osteuropäische Haskala im Chassidismus, der für die Maskilim den Inbegriff von Aberglauben, Irrationalität, Unbildung und religiösem Fanatismus darstellte.“"
                                            },
                                            {
                                                "example_id": "ff03c30a-962b-4a29-945a-9dc96c282c7b",
                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Ich kannte seinen Fanatismus in dieser Hinsicht und wollte nicht darauf beharren.“"
                                            },
                                            {
                                                "example_id": "b50b5115-3f72-4068-b650-d7c1ab88ad8b",
                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Merkwürdigerweise hatte ich den alten Derkum nie fanatisch gefunden, aber vielleicht hatte mein Vater Fanatismus und Konsequenz miteinander verwechselt.“"
                                            },
                                            {
                                                "example_id": "9eae5ca2-6488-481c-b44f-b948a0ea289c",
                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Ich bin mit Necla Kelek verabredet und möchte mit ihr über Fanatismus und Fundamentalismus reden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d72f29a-6814-45ef-b9a5-8e128782c708",
                        "source_entry_id": "ea200025-906b-3383-be73-d81b3bdb1e74",
                        "source_sense_id": "16c50e4b-c860-3745-a5a0-6954e9dc5513",
                        "source_sense_description": "the property of being rabid",
                        "target_lang_word": "Wildheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wildheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "der Zustand, in dem sich die Tier- und Pflanzenwelt befinden, die vom Menschen weitgehend unberührt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4149a8d-5f01-43f8-80f7-505cb87cf120",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "»Ein Blick reiner, ungezähmter Wildheit, das unerbittliche Wissen des nackten Seins«."
                                            },
                                            {
                                                "example_id": "9c16a8f0-c8c1-4bed-9383-3c54cad2d8f3",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "Die sanften Täler zwischen den Bergen sind kultiviert, die Vulkanberge allerdings haben ihre Wildheit bewahren können."
                                            },
                                            {
                                                "example_id": "1e0fd5b9-7bae-40c5-9363-0ffa24aa29cf",
                                                "sense_id": "a4d101be-29ae-3744-a4a8-a7f8781bc11b",
                                                "text": "Das Hochgebirge ist das Thema, das Friedrich anschlägt – übrigens, ohne jemals selbst in den Alpen und speziell im Berchtesgadener Land gewesen zu sein, das sich zu seiner Zeit bereits eines besonderen Rufes wegen seiner Ursprünglichkeit und Wildheit erfreute."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "ein Wesenszug überschäumender Lebensfreude und körperlicher Aktivität, der auch gesellschaftliche Regeln oder moralische Grenzen überschreiten lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8529d9c6-c9a8-4a76-b191-ac3c0e85542f",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Das Subversive wird im Allgemeinen mit Lautstärke und Wildheit assoziiert."
                                            },
                                            {
                                                "example_id": "5259fa97-574f-493f-9124-b2db328dcada",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Etwas mehr Bewegung wäre schon angebracht gewesen, als der kolumbianische Superstar bei diesem kleinen Spaziergang seine Fans zur rhythmischen Wildheit animieren wollte."
                                            },
                                            {
                                                "example_id": "d67ca71b-b743-49b3-9e1c-c24e9e4c8f33",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "Bei vielen Bands führt Erfolg ja bekanntlich dazu, dass ihre Wildheit gezähmt wird."
                                            },
                                            {
                                                "example_id": "e68fc064-7c5a-4593-81a5-bf2f6aa1f1d7",
                                                "sense_id": "752dc5d5-a586-385c-8b80-e3b29caa44c8",
                                                "text": "„Der dritte war den beiden Beschriebenen total unähnlich, und was jene an Wildheit und Lebensmut zuviel besaßen, schien dieser durch Sanftmut und Leutseligkeit wieder ausgleichen zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                        "entry_id": "db1bdcdb-60d7-34c7-8d2b-8179619f8efa",
                                        "glosses": [
                                            "ein Verhalten, das andere Lebewesen (Menschen) tötet oder verletzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27f9cd49-8171-45ba-ab18-7693b6a380a7",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Es soll schon vorgekommen sein, dass ein Raufer bei den Handgreiflichkeiten mit einem der höllischen Gegner Blessuren davongetragen hat. Das aber kann niemanden davon abhalten, den Brauch in seiner archaischen Wildheit zu erhalten."
                                            },
                                            {
                                                "example_id": "70b14bab-ce71-4c4f-8c24-c7d6adb2f72e",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Der Anführer des Schiiten-Aufstands kündigt an, dass beim Angriff auf seine Hochburg die Iraker \"mit unglaublicher Wildheit\" zurückschlagen werden."
                                            },
                                            {
                                                "example_id": "0c87e5df-69ae-44c8-9cac-28219c9c8394",
                                                "sense_id": "d5d165c4-8a44-3190-b924-427f4a2447d8",
                                                "text": "Wenn endlich der günstige Augenblick gekommen ist und sie meinen, daß die Zeit da sei, um den Plan auszuführen, dessen Aussicht auf Gelingen sie auf das genaueste berechnet haben, treten sie mit einer Gewalt und Wildheit auf, die häufig ihre Feinde aus der Fassung bringt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
