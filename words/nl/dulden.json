            "senses": [
                {
                    "sense_id": "961bb039-7c91-371a-ae6d-3285e75cebbd",
                    "sense_definition": "bereid zijn iets ongestraft te laten of te accepteren zonder verzet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tolereren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar wilde geen brutaal gedrag <w>dulden</w> in de klas.",
                            "target_lang_translations": {
                                "en": "The teacher did not want to <w>tolerate</w> any rude behavior in the classroom."
                            }
                        },
                        {
                            "text": "Hij <w>duldde</w> geen tegenspraak van zijn medewerkers tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "He <w>brook</w> no contradiction from his employees during the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolereren",
                        "gedogen",
                        "pikken",
                        "toestaan"
                    ],
                    "antonyms": [
                        "verbieden",
                        "weigeren"
                    ],
                    "common_phrases": [
                        "geen tegenspraak dulden",
                        "geen uitstel dulden"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to be willing to let something go unpunished or to accept it without resistance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tolerate",
                                "target_lang_sense_clarification": "to allow something unpleasant to exist or happen"
                            },
                            {
                                "target_lang_word": "brook",
                                "target_lang_sense_clarification": "to tolerate or allow, often used in the negative like 'brook no opposition'"
                            },
                            {
                                "target_lang_word": "permit",
                                "target_lang_sense_clarification": "to allow or give permission for"
                            },
                            {
                                "target_lang_word": "condone",
                                "target_lang_sense_clarification": "to accept or allow behavior that is considered wrong"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f2f176-4cd7-34e8-bd7b-667680cba358",
                    "sense_definition": "moeilijke omstandigheden of pijn verdragen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verdragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moest de vreselijke pijn in stilte <w>dulden</w>.",
                            "target_lang_translations": {
                                "en": "She had to <w>endure</w> the terrible pain in silence."
                            }
                        },
                        {
                            "text": "Het volk moest jarenlang de onderdrukking door de dictator <w>dulden</w>.",
                            "target_lang_translations": {
                                "en": "The people had to <w>bear</w> the oppression of the dictator for years."
                            }
                        }
                    ],
                    "synonyms": [
                        "velen",
                        "pikken",
                        "tolereren"
                    ],
                    "antonyms": [
                        "bestrijden"
                    ],
                    "common_phrases": [
