                        "tags": [],
                        "examples": [
                            {
                                "example_id": "932cdfd8-3cc8-4433-9512-2841de791d7d",
                                "sense_id": "f1423b77-3f12-3265-98b4-fca945209179",
                                "text": "The numerous fluorescent dots visible in this photograph represent nuclei of diverse embryonic cells, but the nuclei belonging to the n bandlet can be distinguished because they lie within fluorescent (i.e., RDP-labeled) N teloblast progeny."
                            },
                            {
                                "example_id": "52c9fba7-85fa-4463-9fc2-e49c350b00e1",
                                "sense_id": "f1423b77-3f12-3265-98b4-fca945209179",
                                "text": "Closer inspection of bandlet nuclei reveals them to be of two types: interphase nuclei with diffuse fluorescence, and mitotic nuclei showing brightly fluorescent, condensed chromosomes” (Fig. 5b)."
