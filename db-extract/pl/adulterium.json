                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bd54262-be58-47fc-83fb-32d063893315",
                        "source_entry_id": "8acbcaf7-917d-3054-8f71-18711a00f06d",
                        "source_sense_id": "25da0e20-375c-3714-9072-a2641664f81e",
                        "source_sense_description": "archaisch, Recht: Ehebruch",
                        "target_lang_word": "Ehebruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehebruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                        "entry_id": "874a6a77-015f-377d-be18-6aa664f4db91",
                                        "glosses": [
                                            "das Eingehen gesellschaftlich nicht geduldeter außerehelicher Beziehungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaba30ca-54c6-4d18-8567-4776f930aab9",
                                                "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                                "text": "Ein Ehebruch kann eine große Belastung für eine Beziehung sein."
                                            },
                                            {
                                                "example_id": "36e32130-8c30-4bb8-b46e-03949fd5ce5f",
                                                "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                                "text": "„Die gesellschaftlichen Probleme entstehen nicht durch den Ehebruch selbst, sondern durch seine Begleitumstände.“"
                                            },
                                            {
                                                "example_id": "73ea40bd-661d-4f07-bb74-30e3093677d2",
                                                "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                                "text": "„Nachdem es dann zum Ehebruch gekommen sei, habe er jetzt diesen frevelhaften Auftritt ins Werk gesetzt, um seine Frau ganz in Besitz nehmen zu können.“"
                                            },
                                            {
                                                "example_id": "bb974dc3-4ba5-4393-a07b-590feee1e7b6",
                                                "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                                "text": "„Bei Marie fing ich schon an zu zweifeln: Ihr ›metaphysischer Schrecken‹ leuchtete mir nicht ein, und wenn sie nun hinging und mit Züpfner all das tat, was ich mit ihr getan hatte, so beging sie Dinge, die in ihren Büchern eindeutig als Ehebruch und Unzucht bezeichnet wurden.“"
                                            },
                                            {
                                                "example_id": "58ac4c55-f4e0-4ff1-8be4-e1fec35cb047",
                                                "sense_id": "ed7ea09a-341e-38cd-8015-01a01d10fc94",
                                                "text": "„Carlota war sexuell nicht anspruchsvoll, wohl aber verlangte sie Zuwendung und bemühte sich, unsere Beziehung mit sämtlichem Beiwerk, das einen handfesten Ehebruch kennzeichnet, auszustatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
