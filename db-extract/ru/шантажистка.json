                "senses": [
                    {
                        "sense_id": "e65ddf4d-f786-34fa-aaf6-94a71dd2ea2e",
                        "entry_id": "f3401445-8d94-3139-9a06-281972af22ae",
                        "glosses": [
                            "female equivalent of шантажи́ст (šantažíst): female blackmailer"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "2bbe8557-d724-421d-90fc-34e99559fbdb",
                                "sense_id": "e65ddf4d-f786-34fa-aaf6-94a71dd2ea2e",
                                "text": "— Сиди́те! Я ва́ши глу́пые ламента́ции слу́шал, изво́льте и вы меня́ послу́шать! Пото́м мо́жете убира́ться ко всем чертя́м. Ко́ли пра́вда, что Ле́лька Ден хоте́л на вас жени́ться, а не навообрази́ли вы всё э́то себе́, — молоде́ц он, что во́время отъе́хал! Потому́ что вы шантажи́стка, да! Я зна́ю, что говорю́!",
                                "translation": "Zinaida Gippius",
                                "english": "Zinaida Gippius"
                            }
                        ]
                    }
                ],
