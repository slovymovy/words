                    },
                    {
                        "form_id": "9ba7451c-6f75-4542-b5f6-8a5facd0569a",
                        "entry_id": "8d1bf416-fd09-300f-bebb-aa9fe6a4cc68",
                        "tags": [],
                        "form": "oulamâ"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                        "entry_id": "8d1bf416-fd09-300f-bebb-aa9fe6a4cc68",
                        "glosses": [
                            "Nom donné, chez les Turcs et chez les Arabes, aux docteurs de la loi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8430924e-c646-4a3b-bfe2-03efebc83386",
                                "sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                                "text": "Les étudiants en théologie, auxquels s’était jointe une populace interlope, et menés par un de leurs professeurs, l’ouléma Abbas, avaient envahi la faculté d’en face et malmené quelques enseignants jugés hérétiques."
                            },
                            {
                                "example_id": "a6578c03-ebbd-49a4-86dc-23e1f9cec9c7",
                                "sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                                "text": "Le corps des oulémas."
                            },
                            {
                                "example_id": "cdc285f0-a03b-4eb7-9c05-c609d7dbe229",
                                "sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                                "text": "L’autorité religieuse et judiciaire est exercée par les oulémas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad85c17a-218b-4004-8b26-cdd3d026c3bb",
                        "source_entry_id": "8d1bf416-fd09-300f-bebb-aa9fe6a4cc68",
                        "source_sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                        "target_lang_word": "ulama",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ulama",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "112d4ec1-79fa-3821-9cca-0451ae252e4b",
                                        "entry_id": "3eac3d73-ae95-3454-a3fe-bb564bfd5b31",
                                        "glosses": [
                                            "A (modern) ball game, descended from tlachtli."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ulama",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8bf4b9b-c5e6-3fea-988f-217971ac3e8f",
                                        "entry_id": "9d688a5f-c147-3a25-b545-79422c0b6c93",
                                        "glosses": [
                                            "Alternative form of ulema."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7d3e119-f3b5-4355-9361-54e3f4d9b40f",
                                                "sense_id": "a8bf4b9b-c5e6-3fea-988f-217971ac3e8f",
                                                "text": "There he […] became disillusioned with much of the Islamic clerical establishment, and first expressed his contempt for what he called ‘religious secularists’, those foolish ulama who attempt to separate politics from religion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ulama",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94f43646-1dcf-3af6-a58b-e0f9cb0eb2fc",
                                        "entry_id": "9ec702e3-0caf-32ad-a100-ab5d72e3e88e",
                                        "glosses": [
                                            "The devil bird (an avian cryptid of Sri Lanka)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8832ecb9-416d-4998-a179-f950b64bd5d9",
                                                "sense_id": "94f43646-1dcf-3af6-a58b-e0f9cb0eb2fc",
                                                "text": "There is a bird in Ceylon, which the natives call ulama, or the demon bird, which utters most loud and ear-piercing screams, strongly resembling the shrieks of a human being in severe bodily agony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1207917-7248-4cb3-8fa5-2bc543ee7db5",
                        "source_entry_id": "8d1bf416-fd09-300f-bebb-aa9fe6a4cc68",
                        "source_sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
                        "target_lang_word": "ulema",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ulema",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                        "entry_id": "76d492a3-f35c-3377-8170-6a3baf484d02",
                                        "glosses": [
                                            "plural of alim; the guardians of legal and religious tradition in Islam; clerics."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed98190-6018-4d70-8935-0e2a84d3332d",
                                                "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                                "text": "In process of time, the whole monopoly of the ulema centred in a certain number of families; and their constant residence at the capital, to which they return at the expiration of their term of office, has maintained their power to the present day."
                                            },
                                            {
                                                "example_id": "df86d399-6ec5-4a4c-89ac-3f8f8f5d0ab6",
                                                "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                                "text": "Perhaps surprisingly, ulema families were less likely to intermarry with other ulema families than merchant families were to intermarry with other merchant families."
                                            },
                                            {
                                                "example_id": "8a4a0cc2-6c50-4898-af6c-a0c9a37ca0dc",
                                                "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                                "text": "For the time being, the faithful must follow their own consciences and learn to distinguish good from evil by themselves, instead of relying on the ulema."
                                            },
                                            {
                                                "example_id": "9321d830-ff3d-40d4-bdd0-3c19e46ba1c3",
                                                "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                                "text": "The problem of sources can be offset by limiting the scope of generalisation - not all ulema, for example, but those who are retrievable or in some way representative of the sources if not of society."
                                            },
                                            {
                                                "example_id": "37fdd091-158a-4ade-b00e-a7223de7e92d",
                                                "sense_id": "7950c0f9-045f-34f0-bf34-6ccd5215fdb1",
                                                "text": "By virtue of their influence and their historical allegiance to the royal household, the ulema form one of three power centers of the kingdom, alongside the members of the royal court and the heads of the major tribes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4044c96-8018-419b-a131-96aa99c61929",
                        "source_entry_id": "8d1bf416-fd09-300f-bebb-aa9fe6a4cc68",
                        "source_sense_id": "27e05a2d-092f-3ce7-8df0-a08b383d321b",
