                        "examples": [
                            {
                                "example_id": "638e8c13-b6f2-44e4-a231-45af572d2dc1",
                                "sense_id": "ffc4c9be-d0ef-33d4-b3f8-5aa6d3179e3e",
                                "text": "Ah ! les oarystis ! les premières maîtresses !"
                            },
                            {
                                "example_id": "b061b87f-41ad-4e58-8c0a-473b2012d022",
                                "sense_id": "ffc4c9be-d0ef-33d4-b3f8-5aa6d3179e3e",
                                "text": "Ici je m’arrête pour saluer en ces livres, le Reliquaire, force et grâce, mais grâce forte, un peu spadassine, très haute ; les Intimités, libres idylles, chaudes, et, si mièvres, pas si mièvres que cela ; le Passant, ardent oarystis dont le dénouement chaste est plus brûlant que tout autre imaginable ; des œuvres de premier ordre, passionnées, sans contorsions et d’une forme merveilleuse."
                            },
                            {
                                "example_id": "de2d75c7-e9ea-4f65-a693-a8b8a93389eb",
                                "sense_id": "ffc4c9be-d0ef-33d4-b3f8-5aa6d3179e3e",
                                "text": "Le sujet semble des plus périlleux; c’est une oarystis criminelle, le rapt d’une jeune fille par un pâtre sauvage, enfiévré de désirs."
                            }
                        ]
                    }
