    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                "word": "buggered",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6cd4b8c7-ba63-4b45-9418-968db564ceb8",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more buggered"
                    },
                    {
                        "form_id": "3f239ab2-a632-4945-869b-728b972a5962",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most buggered"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "glosses": [
                            "Broken; not properly functioning."
                        ],
                        "tags": [
                            "Commonwealth",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f2db034e-3904-4c41-a32c-b5880e701d57",
                                "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                                "text": "Your telly is buggered, best get it fixed."
                            },
                            {
                                "example_id": "acd74f48-53af-4e6a-a185-b325a138a025",
                                "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                                "text": "It's well and truly buggered now; you may as well throw it out."
                            },
                            {
                                "example_id": "217d16bd-2cb6-4fdc-a8b0-e1a209bf1cb4",
                                "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                                "text": "One of the bands that caused my knee to get even more buggered at the last Epitapth (from too much dancing)."
                            },
                            {
                                "example_id": "fdd4494a-5c8b-40f2-8adc-63fe1a1d60be",
                                "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                                "text": "I'm sorry, but the tax system is more buggered than that..."
                            },
                            {
                                "example_id": "e43d0aa9-a873-4cad-8a68-4252cc6811e9",
                                "sense_id": "237fcb77-134f-3a94-b09c-f80f8c7ded95",
                                "text": "I used to have the unit istalled in a renault 5 in a vertical postion, from which the unit was great - never skipped once even on the most buggered cd's i had and the worst roads i could find."
                            }
                        ]
                    },
                    {
                        "sense_id": "8655190a-113e-3f33-846d-39a559851aa8",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "glosses": [
                            "In trouble; in a bad situation."
                        ],
                        "tags": [
                            "Commonwealth",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "10a6d151-aa9f-4116-87a2-e44cf67d156e",
                                "sense_id": "8655190a-113e-3f33-846d-39a559851aa8",
                                "text": "The police caught you on CCTV, now you're really buggered."
                            },
                            {
                                "example_id": "afaaa57a-defa-498f-96ca-9a122f24ce9b",
                                "sense_id": "8655190a-113e-3f33-846d-39a559851aa8",
                                "text": "If the banks go abroad we're even more buggered (in the short term, at least, and politicians work pretty much by gradient descent) than if they don't."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2750ac2-0792-3ab2-97b2-3ae0bd7aab1c",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "glosses": [
                            "Tired, worn-out, exhausted."
                        ],
                        "tags": [
                            "Commonwealth",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "092bd11c-0e54-48c7-beb5-68099d312363",
                                "sense_id": "c2750ac2-0792-3ab2-97b2-3ae0bd7aab1c",
                                "text": "You'll have to take over from here, mate, I'm completely buggered."
                            },
                            {
                                "example_id": "f2a6dcc9-f0cd-46ed-b150-b836d426a6ad",
                                "sense_id": "c2750ac2-0792-3ab2-97b2-3ae0bd7aab1c",
                                "text": "I am not sure why, but I'm more buggered after I get to the US than I am when I return home. I think it has a lot to do with it being easier to align my sleeping patterns with flying in to Oz during the night (arriving early morning), than it is flying into the US and landing at 10 pm at night."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4104585-f780-3324-97b4-5ff1213092cf",
                        "entry_id": "ae5370f2-c63e-3afd-969e-30c9f397fdaa",
                        "glosses": [
                            "damned (as an intensifier or vehement denial)"
                        ],
                        "tags": [
                            "Commonwealth",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1e12a239-6eac-4238-a8f8-777c9fa4fd5a",
                                "sense_id": "c4104585-f780-3324-97b4-5ff1213092cf",
                                "text": "I'm buggered if I'm going to drive all that way at this time of night."
                            }
                        ]
                    }
                ],
