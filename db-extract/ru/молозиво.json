                    {
                        "translation_id": "39c5d754-db64-4c85-a82b-4d3db4dfaf9d",
                        "source_entry_id": "72f809ab-8690-39a2-9a01-968ae5caf831",
                        "source_sense_id": "efa53b01-7ebe-3092-a5a2-45f8efb91063",
                        "target_lang_word": "colostrum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colostrum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f25452e-9ed3-3d56-bfc0-70d0e2395d48",
                                        "entry_id": "21644350-1ca5-3f80-b871-5a496b109fa0",
                                        "glosses": [
                                            "A form of milk produced by the mammary glands in late pregnancy and the few days after giving birth."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750a10a2-36b5-4825-a812-94674a823739",
                                                "sense_id": "4f25452e-9ed3-3d56-bfc0-70d0e2395d48",
                                                "text": "The researchers isolated the antibodies from the cow's colostrum, the first milk produced after birth, which has very high antibody concentrations. They gave these antibodies, extracted from the colostrum, to 10 volunteers and gave another 10 volunteers extracts from colostrum of cows that were not immunized against the traveler's diarrhea bacteria."
                                            },
                                            {
                                                "example_id": "0b2aa909-8b54-4e37-b79e-37cab57072bd",
                                                "sense_id": "4f25452e-9ed3-3d56-bfc0-70d0e2395d48",
                                                "text": "This valuable fluid—colostrum—plays a number of important biological roles, including helping improve an infant's immune system. Nevertheless, many humans intuitively perceive colostrum as “sour milk,” which should not be given to infants. Other species do not make this serious mistake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c55d36be-19ca-39bf-8237-9902b86b666c",
                                        "entry_id": "21644350-1ca5-3f80-b871-5a496b109fa0",
                                        "glosses": [
                                            "A mixture of turpentine and egg yolk, formerly used as an emulsion."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
