{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "70ecc786-6890-3adf-b414-d574fe18db64",
                    "sense_definition": "Food remaining uneaten at the end of a meal, often saved for later consumption.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We put the dinner <w>leftovers</w> into the fridge for lunch tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мы убрали <w>остатки</w> ужина в холодильник на завтрашний обед."
                            }
                        },
                        {
                            "text": "I really do not feel like eating <w>leftovers</w> three days in a row.",
                            "target_lang_translations": {
                                "ru": "Мне совсем не хочется есть <w>разогретую вчерашнюю еду</w> три дня подряд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eating leftovers",
                        "heat up leftovers",
                        "fridge leftovers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остатки еды после трапезы, которые часто сохраняют, чтобы съесть позже."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остатки",
                                "target_lang_sense_clarification": "еды, трапезы"
                            },
                            {
                                "target_lang_word": "объедки",
                                "target_lang_sense_clarification": "недоеденные куски, часто пренебрежительно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e7c94fc-944f-3edc-a3e7-f965a1224ca2",
                    "sense_definition": "A person, object, or custom that survives from an earlier period or context; a remainder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That old factory building is an industrial <w>leftover</w> from the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "То старое здание фабрики — промышленный <w>пережиток</w> девятнадцатого века."
                            }
                        },
                        {
                            "text": "The strict dress code is an annoying <w>leftover</w> from the previous management.",
                            "target_lang_translations": {
                                "ru": "Строгий дресс-код — это раздражающий <w>пережиток</w> прошлого руководства."
                            }
                        }
                    ],
                    "synonyms": [
                        "remnant",
                        "relic",
                        "survival",
                        "remainder"
                    ],
                    "common_phrases": [
                        "leftover from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предмет, традиция или обычай, сохранившиеся из прошлого; пережиток."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережиток",
                                "target_lang_sense_clarification": "устаревший обычай, наследие прошлого"
                            },
                            {
                                "target_lang_word": "рудимент",
                                "target_lang_sense_clarification": "сохранившийся след чего-либо устаревшего"
                            },
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "сохранившаяся часть прошлого"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1161bad2-b1d9-31c9-bd94-fbf0929319e0",
                    "sense_definition": "Remaining unused, uneaten, or unspent after the rest has been used.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used the <w>leftover</w> fabric to make a colorful quilt.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>оставшуюся</w> ткань, чтобы сшить яркое лоскутное одеяло."
                            }
                        },
                        {
                            "text": "There is some <w>leftover</w> pizza on the kitchen counter if you are hungry.",
                            "target_lang_translations": {
                                "ru": "На кухонном столе есть <w>оставшаяся</w> пицца, если ты голоден."
                            }
                        }
                    ],
                    "synonyms": [
                        "remaining",
                        "extra",
                        "surplus"
                    ],
                    "common_phrases": [
                        "leftover food",
                        "leftover materials"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оставшийся неиспользованным, несъеденным или неизрасходованным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставшийся",
                                "target_lang_sense_clarification": "неиспользованный или несъеденный"
                            },
                            {
                                "target_lang_word": "лишний",
                                "target_lang_sense_clarification": "избыточный, свободный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}