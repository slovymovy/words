{
    "word_family": [
        "horen",
        "verhoren",
        "aanhoren",
        "toehoorder",
        "gehoor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1170cb88-bddf-30b0-90d6-55ada30ea6b3",
                    "sense_definition": "door ondervragen trachten alles van iemand te weten te komen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ondervragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie probeerde de verdachte urenlang <w>uit</w> te <w>horen</w> over zijn verblijfplaats.",
                            "target_lang_translations": {
                                "en": "The police tried to <w>interrogate</w> the suspect for hours about his whereabouts."
                            }
                        },
                        {
                            "text": "Zij wilde haar broer <w>uithoren</w> over zijn nieuwe vriendin.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>pump</w> her brother for information about his new girlfriend."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondervragen",
                        "uitvragen",
                        "interrogren"
                    ],
                    "common_phrases": [
                        "iemand uithoren"
                    ],
                    "target_lang_definitions": {
                        "en": "to try to find out everything from someone by questioning them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "interrogate",
                                "target_lang_sense_clarification": "to question thoroughly or aggressively"
                            },
                            {
                                "target_lang_word": "pump",
                                "target_lang_sense_clarification": "to question someone persistently to get information"
                            },
                            {
                                "target_lang_word": "question",
                                "target_lang_sense_clarification": "to ask someone for information"
                            },
                            {
                                "target_lang_word": "sound out",
                                "target_lang_sense_clarification": "to try to find out someone's opinions or intentions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8a5142d-4e31-3572-b575-d3bb943d1d04",
                    "sense_definition": "iets volledig tot het einde toe beluisteren",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "luisteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet eerst het hele verhaal <w>uithoren</w> voordat je een oordeel velt.",
                            "target_lang_translations": {
                                "en": "You must <w>hear out</w> the whole story first before you pass judgment."
                            }
                        },
                        {
                            "text": "Hij liet de spreker rustig zijn pleidooi <w>uithoren</w> zonder hem te onderbreken.",
                            "target_lang_translations": {
                                "en": "He quietly let the speaker <w>finish</w> his plea without interrupting him."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitluisteren"
                    ],
                    "antonyms": [
                        "onderbreken"
                    ],
                    "common_phrases": [
                        "een verhaal uithoren"
                    ],
                    "target_lang_definitions": {
                        "en": "to listen to something completely until the end"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hear out",
                                "target_lang_sense_clarification": "to listen to someone until they have finished speaking"
                            },
                            {
                                "target_lang_word": "listen to the end",
                                "target_lang_sense_clarification": "to hear the entirety of a story or speech"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}