{
    "word_family": [
        "plague",
        "plaguer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e2ed33ad-0b76-3df4-a284-a9636489c428",
                    "sense_definition": "Constantly troubled, afflicted, or harassed by something unpleasant or harmful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afflicted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was <w>plagued</w> by high unemployment for many years.",
                            "target_lang_translations": {
                                "nl": "De stad werd jarenlang <w>geteisterd</w> door een hoge werkloosheid."
                            }
                        },
                        {
                            "text": "He was <w>plagued</w> by doubts about his decision to move abroad.",
                            "target_lang_translations": {
                                "nl": "Hij werd <w>gekweld</w> door twijfels over zijn besluit om naar het buitenland te verhuizen."
                            }
                        }
                    ],
                    "synonyms": [
                        "afflicted",
                        "troubled",
                        "harassed",
                        "tormented"
                    ],
                    "common_phrases": [
                        "plagued by doubts",
                        "plagued by problems"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voortdurend gekweld, geteisterd of lastiggevallen door iets vervelends of schadelijks."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geteisterd",
                                "target_lang_sense_clarification": "Vaak gebruikt bij rampen, problemen of negatieve omstandigheden."
                            },
                            {
                                "target_lang_word": "gekweld",
                                "target_lang_sense_clarification": "Wordt gebruikt voor mentale of fysieke pijn en twijfels."
                            },
                            {
                                "target_lang_word": "geplaagd",
                                "target_lang_sense_clarification": "De meest directe vertaling, vaak gebruikt in de context van aanhoudende problemen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef8d51e2-2b12-3cb5-ba30-765893f20dd0",
                    "sense_definition": "Simple past and past participle of <w>plague</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afflicted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A mysterious illness <w>plagued</w> the village throughout the winter.",
                            "target_lang_translations": {
                                "nl": "Een mysterieuze ziekte <w>teisterde</w> het dorp gedurende de hele winter."
                            }
                        },
                        {
                            "text": "The project has been <w>plagued</w> by delays since it started.",
                            "target_lang_translations": {
                                "nl": "Het project wordt sinds het begin <w>geplaagd</w> door vertragingen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb plague."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van het werkwoord 'plague' (teisteren, kwellen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geteisterd",
                                "target_lang_sense_clarification": "Verleden deelwoord van teisteren."
                            },
                            {
                                "target_lang_word": "gekweld",
                                "target_lang_sense_clarification": "Verleden deelwoord van kwellen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}