                "senses": [
                    {
                        "sense_id": "cd1c2bce-7f7f-3965-930b-8563c98b9b21",
                        "entry_id": "23bb83c1-a2bc-36cc-855f-56630f43a5a7",
                        "glosses": [
                            "lage kast of tafel zonder laden die bij het hoofdeinde van het bed staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c28d955-263b-468e-ad47-d94668115c4e",
                                "sense_id": "cd1c2bce-7f7f-3965-930b-8563c98b9b21",
                                "text": "Hij had de foto van zijn overleden vrouw op het nachtkastje staan"
                            },
                            {
                                "example_id": "e3eac016-600d-4d71-a2a3-f480c393e7a4",
                                "sense_id": "cd1c2bce-7f7f-3965-930b-8563c98b9b21",
                                "text": "Op dit moment liggen op mijn nachtkast vooral actiethrillers van Stephen King of Wilbur Smith."
                            },
                            {
                                "example_id": "2c5129c3-4284-4da6-b0eb-4067ef93ab59",
                                "sense_id": "cd1c2bce-7f7f-3965-930b-8563c98b9b21",
                                "text": "Pas in het pikkedonker toont hij zijn ware gezicht. Vervolgens wordt dat verlicht door de blauwe cijfers van de digitale wekker op het nachtkastje: 04.44."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b3c6bae-a4e5-4452-8952-3107ffd27e60",
                        "source_entry_id": "23bb83c1-a2bc-36cc-855f-56630f43a5a7",
                        "source_sense_id": "cd1c2bce-7f7f-3965-930b-8563c98b9b21",
