{
    "word_family": [
        "victor",
        "victorious",
        "victoriously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "293f6536-e5fd-3b57-8ccb-cf85ec79658b",
                    "sense_definition": "The state of having won a battle, game, or competition, or having succeeded in a difficult effort.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "winning_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general led his troops to a decisive <w>victory</w> on the battlefield.",
                            "target_lang_translations": {
                                "ru": "Генерал привел свои войска к решительной <w>победе</w> на поле битвы.",
                                "zh": "将军带领部队在战场上取得了决定性的<w>胜利</w>。"
                            }
                        },
                        {
                            "text": "After months of training, the athlete finally achieved <w>victory</w> in the championship.",
                            "target_lang_translations": {
                                "ru": "После месяцев тренировок спортсмен наконец добился <w>победы</w> в чемпионате.",
                                "zh": "经过数月的训练，这位运动员终于在锦标赛中获得了<w>胜利</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "triumph",
                        "win"
                    ],
                    "antonyms": [
                        "defeat",
                        "loss"
                    ],
                    "common_phrases": [
                        "claim victory",
                        "decisive victory",
                        "victory over",
                        "moral victory",
                        "landslide victory"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, когда одержана победа в битве, игре или соревновании, или достигнут успех в трудном деле.",
                        "zh": "在战斗、比赛或竞争中获胜，或在困难的努力中取得成功。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "победа",
                                "target_lang_sense_clarification": "успех в битве или соревновании"
                            },
                            {
                                "target_lang_word": "виктория",
                                "target_lang_sense_clarification": "устар. победа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胜利",
                                "target_lang_sense_clarification": "在竞争或战斗中获胜"
                            },
                            {
                                "target_lang_word": "成功",
                                "target_lang_sense_clarification": "达成目标或克服困难"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33e64a4c-1621-3db0-80f5-98144d765a3e",
                    "sense_definition": "An artistic depiction of the Roman goddess of victory, typically represented as a winged woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mythology_depiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays several marble <w>victories</w> recovered from the ancient ruins.",
                            "target_lang_translations": {
                                "ru": "Музей выставляет несколько мраморных <w>Викторий</w>, найденных в древних руинах.",
                                "zh": "博物馆展出了几尊从古代遗址中发掘出来的大理石<w>胜利女神像</w>。"
                            }
                        },
                        {
                            "text": "A golden <w>victory</w> stood atop the monument, shining in the sunlight.",
                            "target_lang_translations": {
                                "ru": "Золотая <w>Виктория</w> стояла на вершине памятника, сияя на солнце.",
                                "zh": "一座金色的<w>胜利女神像</w>矗立在纪念碑顶端，在阳光下闪闪发光。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "artistic representation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Художественное изображение римской богини победы, обычно представляемое в виде крылатой женщины.",
                        "zh": "对罗马胜利女神的艺术描绘，通常表现为一位长着翅膀的女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виктория",
                                "target_lang_sense_clarification": "статуя или изображение"
                            },
                            {
                                "target_lang_word": "Ника",
                                "target_lang_sense_clarification": "греческий аналог, часто используется в искусстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胜利女神像",
                                "target_lang_sense_clarification": "艺术作品中的雕像或形象"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1f22756b-cb0a-3c26-b2c2-f66fd340d2b1",
                    "sense_definition": "The Roman goddess of victory, equivalent to the Greek goddess Nike.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mythology_entity",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "The soldiers built an altar to <w>Victory</w> before the campaign began.",
                            "target_lang_translations": {
                                "ru": "Солдаты построили алтарь <w>Виктории</w> перед началом похода.",
                                "zh": "士兵们在战役开始前为<w>维多利亚</w>女神建造了一座祭坛。"
                            }
                        },
                        {
                            "text": "In classical art, <w>Victory</w> is often shown holding a palm branch or wreath.",
                            "target_lang_translations": {
                                "ru": "В классическом искусстве <w>Виктория</w> часто изображается с пальмовой ветвью или венком.",
                                "zh": "在古典艺术中，<w>维多利亚</w>女神常被描绘成手持棕榈枝或花环的样子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Victoria"
                    ],
                    "target_lang_definitions": {
                        "ru": "Римская богиня победы, эквивалент греческой богини Ники.",
                        "zh": "罗马胜利女神，相当于希腊神话中的尼刻女神。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виктория",
                                "target_lang_sense_clarification": "мифологический персонаж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维多利亚",
                                "target_lang_sense_clarification": "罗马神话中的胜利女神"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40080979-b412-3a3b-9de2-33a779ab8658",
                    "sense_definition": "A name used for various towns, villages, and communities, particularly in the United States.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped for lunch in the small town of <w>Victory</w>.",
                            "target_lang_translations": {
                                "ru": "Они остановились пообедать в маленьком городке <w>Виктори</w>.",
                                "zh": "他们在<w>维多利亚</w>小镇停下来吃了午饭。"
                            }
                        },
                        {
                            "text": "The map shows that <w>Victory</w> is located near the county border.",
                            "target_lang_translations": {
                                "ru": "Карта показывает, что <w>Виктори</w> находится недалеко от границы округа.",
                                "zh": "地图显示<w>维多利亚</w>位于县界附近。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных городов, деревень и населенных пунктов, особенно в Соединенных Штатах.",
                        "zh": "用于各种城镇、村庄和社区的名称，特别是在美国。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виктори",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维多利亚",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a06ffbba-a6c6-3da3-8b33-fba5225ba48a",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Victory</w> has been teaching history at the school for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Виктори</w> преподает историю в школе уже двадцать лет.",
                                "zh": "<w>维多利亚</w>先生在这所学校教历史已经二十年了。"
                            }
                        },
                        {
                            "text": "We are looking for the contact information of a Sarah <w>Victory</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ищем контактную информацию Сары <w>Виктори</w>.",
                                "zh": "我们正在寻找莎拉·<w>维多利亚</w>的联系方式。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Виктори",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "维多利亚",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "92215dcb-df23-3901-8c68-3ed5343f11f1",
                    "sense_definition": "An exclamation used to celebrate a success or to encourage someone to achieve success.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "winning_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"<w>Victory</w>!\" shouted the captain as the team lifted the trophy.",
                            "target_lang_translations": {
                                "ru": "\"<w>Победа</w>!\" — закричал капитан, когда команда подняла кубок.",
                                "zh": "当队员们举起奖杯时，队长高喊：“<w>胜利</w>！”"
                            }
                        },
                        {
                            "text": "The crowd chanted \"<w>Victory</w>!\" throughout the final minutes of the match.",
                            "target_lang_translations": {
                                "ru": "Толпа скандировала: \"<w>Победа</w>!\" в течение последних минут матча.",
                                "zh": "在比赛的最后几分钟里，人群一直在高呼：“<w>胜利</w>！”"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, используемое для празднования успеха или для поощрения кого-либо к достижению успеха.",
                        "zh": "用于庆祝成功或鼓励他人取得成功的感叹词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "победа",
                                "target_lang_sense_clarification": "возглас радости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胜利",
                                "target_lang_sense_clarification": "欢呼时的感叹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00eeb60f-66a7-3e6c-9595-15b1d4178832",
                    "sense_definition": "To defeat or triumph over someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "winning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old legend, the hero <w>victoried</w> over the dragon to save the kingdom.",
                            "target_lang_translations": {
                                "ru": "В старой легенде герой <w>восторжествовал</w> над драконом, чтобы спасти королевство.",
                                "zh": "在古老的传说中，英雄<w>战胜</w>了恶龙，拯救了王国。"
                            }
                        },
                        {
                            "text": "They believed that faith had <w>victoried</w> over their despair.",
                            "target_lang_translations": {
                                "ru": "Они верили, что вера <w>одержала победу</w> над их отчаянием.",
                                "zh": "他们相信信念已经<w>战胜</w>了绝望。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Победить или восторжествовать над кем-то или чем-то.",
                        "zh": "击败或战胜某人或某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "побеждать",
                                "target_lang_sense_clarification": "одерживать верх"
                            },
                            {
                                "target_lang_word": "восторжествовать",
                                "target_lang_sense_clarification": "книжн. добиться победы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战胜",
                                "target_lang_sense_clarification": "在竞争或困难中取得优势"
                            },
                            {
                                "target_lang_word": "获胜",
                                "target_lang_sense_clarification": "取得胜利"
                            }
                        ]
                    }
                }
            ]
        }
    ]
