                "senses": [
                    {
                        "sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
                        "entry_id": "2f9c1df7-13ba-3d85-81f0-38f30f839a1b",
                        "glosses": [
                            "brak dobrej opinii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac2454e5-b2b4-425a-a714-1e0c5c2b10c9",
                                "sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
                                "text": "Śpiewak umarł w niesławie, nigdy nie spłacając swoich długów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd8c7ebb-d3cc-491f-9007-ecb8414ac121",
                        "source_entry_id": "2f9c1df7-13ba-3d85-81f0-38f30f839a1b",
                        "source_sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
                        "target_lang_word": "infamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "The state of being infamous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cddc789d-fb3e-475f-8d7d-b2422235a8a2",
                                                "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                                "text": "... but the cars of chaste women have either coverings thrown over them, or white sheets hung over; for instance, on the cars of the female part of the family of the deceased Nawabs Khanduran and Muzaffar Khan, there used generally to be fastened thick dirty white cloths, and in like manner also on their palanquins—although one brother was the chief treasurer, and the other a commander of seven thousand men. And most assuredly this is a requirement of modesty; for one whose palanquin or cart is turned out with much splendour, verily the idea comes to the minds of the sight-seers and common people, that in it there must be some lovely one, bright as the morning, the envy of the fairies. Hence, for the cars or palanquins for women to ride in to be greatly embroidered is, in the opinion of certain men of standing, who are worthy to be trusted, of great infamy."
                                            },
                                            {
                                                "example_id": "195ffa58-ac09-4b12-a1f4-b934ff675b1f",
                                                "sense_id": "07072305-e6cf-3d55-a0d4-31d005bffa28",
                                                "text": "Yesterday, December seventh, 1941, a date which will live in infamy, the United States of America was suddenly and deliberately attacked by naval and air forces of the Empire of Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2906d73a-967b-3a3e-97c7-714efe95cf4c",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "A reprehensible occurrence or situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6426483-ca12-43a8-afe1-a2e42300fe08",
                                                "sense_id": "2906d73a-967b-3a3e-97c7-714efe95cf4c",
                                                "text": "All for a pig of a man who should have gone to the chair. It is an infamy that he did not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed627f0-a262-372b-bcaf-e9a842e0a42d",
                                        "entry_id": "aae81add-5522-388b-a28d-16c541b26209",
                                        "glosses": [
                                            "A stigma attaching to a person's character that disqualifies them from being a witness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8b52ac5-3587-4e29-9ddf-ddec863ca960",
                        "source_entry_id": "2f9c1df7-13ba-3d85-81f0-38f30f839a1b",
                        "source_sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
                        "target_lang_word": "infamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Flétrissure imprimée à l’honneur, à la réputation, soit par la loi, soit par l’opinion publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c0a694-4a6b-4e1f-ada4-3dd345c4076d",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Je ne souffrirai jamais, dit le baron, une telle bassesse de sa part, et une telle insolence de la vôtre ; cette infamie ne me sera jamais reprochée : les enfants de ma sœur ne pourraient entrer dans les chapitres d’Allemagne. Non, jamais ma sœur n’épousera qu’un baron de l’empire."
                                            },
                                            {
                                                "example_id": "8e0f508c-9c79-43f0-8b22-2320a3a77f1a",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Comment concilier la passion immodérée des Romains pour les combats du cirque, et l’infamie dont ils couvraient les instrumens de ces cruels spectacles, les arénaires, bestiaires, gladiateurs ?"
                                            },
                                            {
                                                "example_id": "4ba97f1b-3916-4bc9-8a57-d5c36891c88d",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Je sais tout ce que le cœur humain peut contenir de lâchetés, d’infamies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Caractère déshonorant, honteux, vil, d’une chose, d’un acte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b86036-17eb-42db-a8d0-610d7eb380f6",
                                                "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                                "text": "Si tu ne cesses tes remontrances, répondirent les habitants de Sodome, nous te bannirons de notre ville. — J’ai votre crime en horreur, reprit Loth. Seigneur, préserve-moi, préserve ma famille de leur infamie."
                                            },
                                            {
                                                "example_id": "6cb476e5-e538-4484-99c5-7eacc2b5cdb3",
                                                "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                                "text": "Je dévoilerai l’infamie de sa conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Action déshonorante ou honteuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb052e5-8d22-4349-b14e-29ccc659aeea",
                                                "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                                "text": "La Louve, cette péripatéticienne de la rue Pierre-Lescot, épousera son Martial et en aura beaucoup d'enfants. Il suffit d'avoir fait quelque infamie pendable et d'avoir rencontré M. Rodolphe de Gérolslein pour se remettre à flot."
                                            },
                                            {
                                                "example_id": "19b92b52-6d54-42d7-b645-f4557c9cb799",
                                                "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                                "text": "Je n’étais pas loin de verser des pleurs sur ma propre infamie, en songeant que j’étais là à m’amuser et à boire avec des singes, quand mon compagnon se morfondait sur la paille, dans une cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Parole injurieuse à l’honneur, à la réputation."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11086bd8-ef13-420d-9e5a-2563c2251ddb",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Il faudra donc que nous passions pour honnêtes les impiétés et les infamies dont sont pleines les comédies de Molière."
                                            },
                                            {
                                                "example_id": "a6fe6f15-05e7-4ee1-bd75-a83505056852",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Il lui a dit mille infamies, toutes les infamies imaginables."
                                            },
                                            {
                                                "example_id": "06c3199c-0b2a-40ea-a1cc-eb103bbdadb9",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Après l’attaque japonaise du 6 décembre 1941 sur Pearl Harbor prononcé par Roosevelt : « ce jour est un jour d’infamie »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "accde391-55ea-422b-95c9-fd52113b2c8f",
                        "source_entry_id": "2f9c1df7-13ba-3d85-81f0-38f30f839a1b",
                        "source_sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
                        "target_lang_word": "infâmie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infâmie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f86bc5f-8b3a-38e0-8a32-748406a91411",
                                        "entry_id": "6d1dd99e-03bc-3d87-a108-a403dfbbfceb",
                                        "glosses": [
                                            "Variante de infamie. [Alt: attention] Il s’agit d’un terme utilisé qui n’est pas d’un usage standard."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655a658b-40e7-4102-bdd8-3c8459042bcd",
                                                "sense_id": "6f86bc5f-8b3a-38e0-8a32-748406a91411",
                                                "text": "Vous voulez aller perdre votre santé dans les infâmies de Paris, comme tant d’ouvriers qui finissent par aller mourir à l’hôpital !"
                                            },
                                            {
                                                "example_id": "571a90c5-22cd-4920-b1e5-a7c08916fc10",
                                                "sense_id": "6f86bc5f-8b3a-38e0-8a32-748406a91411",
                                                "text": "Mais il ne jouira pas longtemps du fruit de sa lâcheté, et il mourra dans l’infâmie, puisqu’il n’a pas su mourir « avec honneur. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4612150d-b917-42b5-bbcd-c40d19a361ac",
                        "source_entry_id": "2f9c1df7-13ba-3d85-81f0-38f30f839a1b",
                        "source_sense_id": "43e555f0-691d-3dc9-84c4-265958b71e09",
