        "fr-extract.jsonl": [
            {
                "entry_id": "73a4a6c6-c17c-357e-b150-dbee90292eff",
                "word": "confiscation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c295f680-df06-4faf-bdda-42613d53f757",
                        "entry_id": "73a4a6c6-c17c-357e-b150-dbee90292eff",
                        "tags": [
                            "plural"
                        ],
                        "form": "confiscations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab28c7d3-8516-3f89-88e9-f7fadf475444",
                        "entry_id": "73a4a6c6-c17c-357e-b150-dbee90292eff",
                        "glosses": [
                            "Action de confisquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "192c9b03-1a75-47d8-a6ca-c72d5979eb5e",
                                "sense_id": "ab28c7d3-8516-3f89-88e9-f7fadf475444",
                                "text": "La peine de la confiscation des biens a été abolie en France par la Charte constitutionnelle."
                            },
                            {
                                "example_id": "6f468157-cd13-4b1f-942a-82392d8c40db",
                                "sense_id": "ab28c7d3-8516-3f89-88e9-f7fadf475444",
                                "text": "Le bannissement perpétuel et la condamnation à mort emportaient autrefois confiscation des biens."
                            }
                        ]
                    },
                    {
                        "sense_id": "912384d4-3f06-3a34-807c-5f9d701de07b",
                        "entry_id": "73a4a6c6-c17c-357e-b150-dbee90292eff",
                        "glosses": [
                            "Décision accessoire à une condamnation judiciaire, ou d'une décision de sanction financière, où l'État peut confisquer des biens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef30d1d-5f7d-44cb-9251-5f29b3eaf7be",
                                "sense_id": "912384d4-3f06-3a34-807c-5f9d701de07b",
                                "text": "On parle aussi de confiscation lors des périodes de nationalisation."
                            },
                            {
                                "example_id": "bb307bd7-a86b-45a2-8c45-bbe7a1c19817",
                                "sense_id": "912384d4-3f06-3a34-807c-5f9d701de07b",
                                "text": "Si le condamné est marié, la confiscation ne porte que sur la part du condamné dans le partage de la communauté ou des biens indivis entre son conjoint et lui."
                            },
                            {
                                "example_id": "c8f43a3d-d5df-4f2a-9a0f-38dd4287decc",
                                "sense_id": "912384d4-3f06-3a34-807c-5f9d701de07b",
                                "text": "Confiscation fiscale, terme utilisé en économie pour définir le niveau trop élevé des prélèvements obligatoires opérés par les administrations publiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "149a239d-454f-4415-843f-f93d7f2bfece",
                        "source_entry_id": "73a4a6c6-c17c-357e-b150-dbee90292eff",
                        "target_lang_word": "Konfiskation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfiskation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                        "entry_id": "e9e6dd43-4b65-3c1d-8c3c-692c3675addb",
                                        "glosses": [
                                            "amtliche Beschlagnahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dfb69a3-472c-4a60-b55e-ffe69e2649a8",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Es handelte sich um Darstellungen höchst unanständiger Szenen von Leda mit dem Schwan, von Pan und den Nymphen, von Susanna im Bade und ähnlichen Sachen, die schon längst zur Konfiskation der Bibel, der Mythologie und der gesamten Kunstgeschichte hätte führen müssen, wenn sich alles nach der Berliner Polizei richten würde.“"
                                            },
                                            {
                                                "example_id": "385a98ef-b82e-4739-830a-028595a3028a",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Prügel, Konfiskationen und Gefangennahmen waren bald an der Tagesordnung.“"
                                            },
                                            {
                                                "example_id": "95bb0e5e-3ecf-4c2e-a9c8-b6589fc86ebc",
                                                "sense_id": "a45588ab-aa4d-3ce2-b2af-085d1f796726",
                                                "text": "„Gegen solche Konfiskationen ist de Sade so machtlos wie Direktor Coulmier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
