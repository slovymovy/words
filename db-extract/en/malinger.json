                "senses": [
                    {
                        "sense_id": "6b578ad6-4892-3fad-ab3b-19ab7cb693d4",
                        "entry_id": "1dde598b-6275-3030-85b3-636a6ae16375",
                        "glosses": [
                            "To feign illness, injury, or incapacitation in order to avoid work, obligation, or perilous risk."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebb8e22-0aa6-4f05-8eb1-5684e367ca6a",
                                "sense_id": "6b578ad6-4892-3fad-ab3b-19ab7cb693d4",
                                "text": "It is not uncommon on exam days for several students to malinger rather than prepare themselves."
                            },
                            {
                                "example_id": "c3941e37-32c7-4bac-a0e6-520e7a93160e",
                                "sense_id": "6b578ad6-4892-3fad-ab3b-19ab7cb693d4",
                                "text": "And the afternoon, the evening, sleeps so peacefully! / Smoothed by long fingers, / Asleep … tired … or it malingers, / Stretched on the floor, here beside you and me."
                            },
                            {
                                "example_id": "0446dfc0-3aaa-4645-a3a0-c37d554bd51c",
                                "sense_id": "6b578ad6-4892-3fad-ab3b-19ab7cb693d4",
                                "text": "It has been the impression of past investigators that persons who malinger psychosis have latent tendencies for the condition."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf0e4758-32c4-33ce-8275-f42607fab9da",
                        "entry_id": "1dde598b-6275-3030-85b3-636a6ae16375",
                        "glosses": [
                            "To self-inflict real injury or infection (to inflict self-harm) in order to avoid work, obligation, or perilous risk."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": []
                    }
                ],
