                        "sense_id": "f971b847-278b-3e0b-8880-1d7199c5e34b",
                        "entry_id": "e9abdfd7-ee44-3936-a836-07d3fc19f2de",
                        "glosses": [
                            "Something that deceives."
                        ],
                        "tags": [
