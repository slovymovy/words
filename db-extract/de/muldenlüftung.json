                "senses": [
                    {
                        "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                        "entry_id": "95e52aad-0487-356b-93dc-52c9a99b405d",
                        "glosses": [
                            "gezielte Absaugung einer ebenen Fläche über eine seitlich integrierte Mulde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96dd5c97-7fde-46e6-8a09-9600d78c9e90",
                                "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                                "text": "„Bei der Muldenlüftung mit Rundumabsaugung sehen Sie die Technik noch nicht einmal, da sie in die Kochfläche integriert ist. So schlagen Sie gleich zwei Fliegen mit einer Klappe.“"
                            },
                            {
                                "example_id": "d624c690-e91d-4de7-a96f-da408221a13d",
                                "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                                "text": "„Die Muldenlüftung arbeitet fast unsichtbar, aber höchst effektiv Sie wird zur Absaugung nach unten direkt neben oder zwischen einzelne Kochfelder in die Arbeitsplatte integriert.“"
                            },
                            {
                                "example_id": "da2fd473-9487-4d8a-8384-d8d2a67e4d16",
                                "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                                "text": "„Die Muldenlüftung ist 8,5 cm breit und in das Kochfeld integriert.“"
                            },
                            {
                                "example_id": "355cbd87-374e-450e-9f94-6a507659e1b4",
                                "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                                "text": "„Aber nicht zwangs läufig kommt alles Gute von oben, wie die Entwicklung der Muldenlüftung zeigt, die unauffällig direkt neben dem Kochfeld aktiv wird.“"
                            },
                            {
                                "example_id": "ce49ed85-5444-4cc7-b496-d376d0438568",
                                "sense_id": "d4219f64-342d-38a0-8941-c33ada6e4e47",
                                "text": "„Die innovative Muldenlüftung Mesa offeriert durch die effektive Rundumabsaugung eine perfekte Absaugung an drei Seiten der eingesetzten Kochstelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
