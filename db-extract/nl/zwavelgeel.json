                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwefelgelb",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02adae73-2c07-30e4-922f-088340571cd8",
                                        "entry_id": "2c2a2f70-3f05-3127-a0ca-c59b5c0cdf39",
                                        "glosses": [
                                            "in einem an Schwefel erinnernden, grünlichen Gelbton"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae20d651-14b2-4323-8ee5-57da5e422c28",
                                                "sense_id": "02adae73-2c07-30e4-922f-088340571cd8",
                                                "text": "„Weit jenseits der Grenzen von allem Bekannten hockte der Teufel, schleuderte schwefelgelbe Blitze und löste hinter den Wolken hallenden Donner aus.“"
                                            },
                                            {
                                                "example_id": "3552ad4a-781d-49d9-97b8-0f33f5eb98bf",
                                                "sense_id": "02adae73-2c07-30e4-922f-088340571cd8",
                                                "text": "„Als ich aus dem Fenster sah, war ich von dem Anblick überwältigt. Ein dunkler schwefelgelber Himmel, eine Reihe kahler Bäume, ein Garten ohne Rasen, ohne Büsche und ohne Blumen.“"
                                            },
                                            {
                                                "example_id": "2885dcde-2427-41cf-995d-8d486ad8d52a",
                                                "sense_id": "02adae73-2c07-30e4-922f-088340571cd8",
                                                "text": "„In der verrotteten Gaze ein Loch, entstanden vielleicht über die Jahre hinweg durch seinen Atem. Durch einen langen Flur, erleuchtet von einer schwefelgelben, an einem Kabel von der Decke hängenden Glühbirne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
