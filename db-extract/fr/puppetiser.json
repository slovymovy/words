                "senses": [
                    {
                        "sense_id": "618ccb22-bb11-3df6-9c8c-705a999b8915",
                        "entry_id": "2cc8d153-55f1-3347-be5a-2b08ad4433f4",
                        "glosses": [
                            "Pantiniser, donner un caractère de pantin à."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "08db3d83-91a0-4ef2-9b8c-137540263dbc",
                                "sense_id": "618ccb22-bb11-3df6-9c8c-705a999b8915",
                                "text": "En théorie pour puppetiser il faut 2/3 des PV soit 13 PV controlés. Pourquoi ne peut-on pas puppetiser les Pays-Bas ??"
                            }
                        ]
                    },
                    {
                        "sense_id": "b4ee2546-c874-35e0-a8da-7fa3994082a4",
                        "entry_id": "2cc8d153-55f1-3347-be5a-2b08ad4433f4",
                        "glosses": [
                            "Adapter pour utiliser le logiciel Puppet."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "25994967-d93e-4884-a412-4b086670674a",
                                "sense_id": "b4ee2546-c874-35e0-a8da-7fa3994082a4",
                                "text": "Puppetiser nos scripts veut dire que nous allons détruire de nos mains l’œuvre de notre vie (de plus d’un an que nous sommes sur le projet), et nous mettre à rebâtir (pour paraphraser Kypling)."
                            },
                            {
                                "example_id": "69e29e2d-55f6-4138-8478-c0563afac50c",
                                "sense_id": "b4ee2546-c874-35e0-a8da-7fa3994082a4",
                                "text": "Puppet est donc composé d'un puppetmaster sur le serveur qui va centraliser les configurations, et d'un client sur chaques machine à \"puppetiser\" (encore un mot en vrai français)"
                            }
                        ]
                    }
                ],
