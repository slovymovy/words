                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e4b6e0f-3876-4cc8-8902-ba9aa001e1bb",
                                                "sense_id": "e5d27231-037e-3409-ae2b-49e514a9167d",
                                                "text": "For us it is, of course, a symbol of the caduceus of Aesculapius, of the spinal column, of the kundalini-serpent of the Indians – you will be able to trace the ancestry of the idea through many continents and many religions."
                                            },
                                            {
                                                "example_id": "c091df57-bd30-403a-a81b-8a843e2ae1a5",
                                                "sense_id": "e5d27231-037e-3409-ae2b-49e514a9167d",
                                                "text": "The physiology of Tantra yoga focuses on the magical numinosity of the male semen, but the experience of the awakening of kundalini is not an exclusively male phenomenon."
                                            }
                                        ]
