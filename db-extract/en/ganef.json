                        "translation_id": "772a67f2-905f-41c2-96e9-88d9ecf34ef6",
                        "source_entry_id": "65c1e910-9190-3f17-b7fe-5dc9247789a3",
                        "source_sense_id": "71d21f1d-1831-3738-8f2c-643667629a62",
