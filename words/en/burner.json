                },
                {
                    "sense_id": "6b84bf6a-1d4e-3a79-bb47-4cd7d20625de",
                    "sense_definition": "A large, complex, and highly detailed piece of graffiti art.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wall was covered in tags, but the center featured an incredible <w>burner</w> with vibrant colors.",
                            "target_lang_translations": {
                                "ru": "Стена была покрыта тегами, но в центре красовался невероятный <w>бернер</w> ярких цветов."
                            }
