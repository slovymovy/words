                                "target_senses": [
                                    {
                                        "sense_id": "44d3f7a8-476c-3aa8-bde0-23d8953b434a",
                                        "entry_id": "d9c27d22-aa35-3189-baa9-2204e5e794c4",
                                        "glosses": [
                                            "Persona que canta formando parte de un coro."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "corista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7f667046-3e31-3404-9000-4c06b0d591db",
                                        "entry_id": "5413c902-3b16-3c33-9f1b-bb4d89d8690b",
                                        "glosses": [
                                            "En revistas musicales y espectáculos afines, mujer que canta y baila durante el coro."
                                        ],
                                        "tags": [
                                            "entretenimiento"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69569a9c-d18f-4321-8ea1-8bb724beccbc",
                                                "sense_id": "7f667046-3e31-3404-9000-4c06b0d591db",
                                                "text": "Las coristas y las farras\nSe esfumaron con la guita\nLos muchachos de la barra\nNo me echaron ni un piolín"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "corista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a4739f06-9c40-3d3b-a931-55f088d10188",
                                        "entry_id": "2a6a0028-b669-3d31-bb87-e8d960950b2e",
                                        "glosses": [
                                            "Religioso que asiste con frecuencia al coro, y más propiamente, el destinado al coro desde que profesa hasta que se ordena de sacerdote."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4a5f40f-5a25-48fe-91d8-b347e7b0ac94",
                        "source_entry_id": "c7fc3182-1acc-3ece-81b0-ca61893c58c1",
                        "source_sense_id": "a01155de-95aa-3594-aca8-328b6fd09167",
                        "target_lang_word": "Chorist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chorist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae518c85-d3eb-3424-a612-efd9c2f49a63",
                                        "entry_id": "8892c11a-975a-364e-8e10-50b1182d90c0",
                                        "glosses": [
                                            "Person, die in einem Chor (meist einem Opernchor) singt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c66e34db-dbfd-4574-b35d-af8721828cf6",
                                                "sense_id": "ae518c85-d3eb-3424-a612-efd9c2f49a63",
                                                "text": "„Einmal wöchentlich kommen Musiker oder Choristen für eine halbe Stunde zu Besuch, um den Kindern durch Vorspielen und Erklären ihre Instrumente und ihre Begeisterung für die Musik nahezubringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b929a4-7635-4a15-bb1b-7c17a7ec09b3",
                        "source_entry_id": "c7fc3182-1acc-3ece-81b0-ca61893c58c1",
                        "source_sense_id": "a01155de-95aa-3594-aca8-328b6fd09167",
                        "target_lang_word": "хорист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хорист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "67ab3c09-eb83-386c-ad91-56a3beaa071e",
                                        "entry_id": "1f17bfe9-f97f-36a1-8e35-70294ea9bcba",
                                        "glosses": [
                                            "певец, артист хора, а также вообще тот, кто поёт в хоре"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d099fb-dd67-41de-997a-76d82340e695",
                                                "sense_id": "67ab3c09-eb83-386c-ad91-56a3beaa071e",
                                                "text": "Если меня спросит музыкант, артист, хорист, рабочий, почему я делаю то или это, я немедленно дам ему объяснение, простое и понятное."
                                            },
                                            {
                                                "example_id": "987efd6a-3508-41e0-838e-e0b4406de9db",
                                                "sense_id": "67ab3c09-eb83-386c-ad91-56a3beaa071e",
                                                "text": "По блестящему паркету разгуливали в вычурных костюмах и первые «персонажи», и очень бедно одетые маленькие актёры, хористы и хористки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "954fdbf9-252f-38a7-8fed-85573b9b988a",
                                        "entry_id": "1f17bfe9-f97f-36a1-8e35-70294ea9bcba",
                                        "glosses": [
                                            "перен. рядовой, незначительный или малозначительный участник чего-либо, каких-либо событий или общественных явлений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67ba506c-222b-4732-ab87-460347d13eda",
                                                "sense_id": "954fdbf9-252f-38a7-8fed-85573b9b988a",
                                                "text": "Глубоко и заслуженно презирая этих людей, они всё-таки рвались в салон, порог к которому заграждался им именно этими ничтожными людьми, бывшими лишь хористами на подмостках сцены аристократизма."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
