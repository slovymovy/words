                                        "examples": [
                                            {
                                                "example_id": "eba4b5f6-d065-4702-b04d-92a46acffa70",
                                                "sense_id": "3eb8c0c4-0c12-3859-bd8c-5cb7de1389c6",
                                                "text": "Sąd Najwyższy różne dziwne rzeczy już ogłaszał."
