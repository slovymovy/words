                    },
                    {
                        "translation_id": "2c25b74c-1d15-4b22-81b0-12d747cb6286",
                        "source_entry_id": "a4bbae1e-2a83-39fe-b165-12b0459a6065",
                        "source_sense_id": "430cd13a-ea8e-3deb-b684-89120bb502c7",
                        "target_lang_word": "slip up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slip up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9687c39-2b2d-3329-b4b2-0ec7331e98d1",
                                        "entry_id": "2b9e6349-c345-34a5-8192-710c7c849eb1",
                                        "glosses": [
                                            "To err, falter; to make a mistake, especially a seemingly small error."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb54ca07-e0aa-4a51-8139-2058e68b7b1e",
                                                "sense_id": "e9687c39-2b2d-3329-b4b2-0ec7331e98d1",
                                                "text": "I hope I don't slip up during my presentation."
                                            },
                                            {
                                                "example_id": "0e744b5e-d4a5-43a6-b61d-da54cf71054d",
                                                "sense_id": "e9687c39-2b2d-3329-b4b2-0ec7331e98d1",
                                                "text": "The good fortune of DPRK premier Kim Tok Hun provided the latest evidence that Kim Jong Un, a ruler who presides over a sprawling network of political prison camps, can be magnanimous toward officials who slip up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1abe90-97a8-329b-af66-e63aa1c9c17a",
                                        "entry_id": "2b9e6349-c345-34a5-8192-710c7c849eb1",
                                        "glosses": [
                                            "To lose ones footing; to slip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e47f651-c7cf-48f7-b337-7d0b750bac23",
                                                "sense_id": "2a1abe90-97a8-329b-af66-e63aa1c9c17a",
                                                "text": "[…]when we witness someone caught up in their own self-importance slip up on a banana peel, we come to a more humble idea of who we are; comedy, in such a formulation, is on the side of human finitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
