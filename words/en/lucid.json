    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0875b4aa-1d3d-3331-91be-4de3cbf7a953",
                    "sense_definition": "Expressed in a way that is clear and easy to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor gave a <w>lucid</w> explanation of the complex theory that everyone could follow.",
                            "target_lang_translations": {
                                "ru": "Профессор дал <w>ясное</w> объяснение сложной теории, которое каждый смог понять.",
                                "de": "Der Professor gab eine <w>klare</w> Erklärung der komplexen Theorie ab, der jeder folgen konnte.",
                                "zh": "教授对这一复杂理论作出了<w>清晰的</w>解释，每个人都能听懂。"
                            }
                        },
                        {
                            "text": "She is known for her <w>lucid</w> writing style which makes difficult topics accessible.",
                            "target_lang_translations": {
                                "ru": "Она известна своим <w>понятным</w> стилем письма, который делает сложные темы доступными.",
                                "de": "Sie ist für ihren <w>verständlichen</w> Schreibstil bekannt, der schwierige Themen zugänglich macht.",
                                "zh": "她以<w>明晰的</w>写作风格著称，能让晦涩的主题变得通俗易懂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "perspicuous",
                        "straightforward"
                    ],
                    "antonyms": [
                        "confusing",
                        "vague",
                        "obscure"
                    ],
                    "common_phrases": [
                        "lucid explanation",
                        "lucid writing style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выраженный ясно и понятно.",
                        "de": "So ausgedrückt, dass es klar, einleuchtend und leicht verständlich ist.",
                        "zh": "表达清晰、易于理解的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о стиле или объяснении"
                            },
                            {
                                "target_lang_word": "понятный",
                                "target_lang_sense_clarification": "легкий для восприятия"
                            },
                            {
                                "target_lang_word": "вразумительный",
                                "target_lang_sense_clarification": "четкий и логичный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "klar",
                                "target_lang_sense_clarification": "deutlich und leicht verständlich"
                            },
                            {
                                "target_lang_word": "verständlich",
                                "target_lang_sense_clarification": "gut nachvollziehbar formuliert"
                            },
                            {
                                "target_lang_word": "luzid",
                                "target_lang_sense_clarification": "bildungssprachlich für geistvoll und klar dargestellt"
                            },
                            {
                                "target_lang_word": "einleuchtend",
                                "target_lang_sense_clarification": "überzeugend und schlüssig dargelegt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清晰的",
                                "target_lang_sense_clarification": "指表述或论点清楚明了"
                            },
                            {
                                "target_lang_word": "明晰的",
                                "target_lang_sense_clarification": "指逻辑、思想清楚透彻"
                            },
                            {
                                "target_lang_word": "通俗易懂的",
                                "target_lang_sense_clarification": "指语言平实好懂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "991ffd6d-5a17-397e-8646-f5936e1bdb58",
                    "sense_definition": "Able to think clearly, especially during or after a period of illness or confusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a <w>lucid</w> moment, the patient was able to recognize his family members.",
                            "target_lang_translations": {
                                "ru": "В момент <w>просветления</w> сознания пациент смог узнать членов своей семьи.",
                                "de": "In einem <w>klaren</w> Moment konnte der Patient seine Familienmitglieder erkennen.",
                                "zh": "在神志<w>清醒的</w>片刻，病人认出了自己的家人。"
                            }
                        },
                        {
                            "text": "Despite his advanced age, he remained <w>lucid</w> and sharp until his final days.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст, он сохранял <w>здравый</w> ум и остроту восприятия до последних дней.",
                                "de": "Trotz seines hohen Alters blieb er bis zu seinen letzten Tagen <w>geistig klar</w> und scharfsinnig.",
                                "zh": "尽管年事已高，他直到生命的最后几天依然头脑<w>清醒</w>、思维敏锐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sane",
                        "coherent"
                    ],
                    "antonyms": [
                        "delirious",
                        "confused",
                        "irrational"
                    ],
                    "common_phrases": [
                        "lucid moment",
                        "remain lucid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный мыслить ясно, особенно во время или после болезни или замешательства.",
                        "de": "In der Lage, klar und rational zu denken, besonders während oder nach einer Phase von Krankheit oder Verwirrung.",
                        "zh": "（尤指生病或神志混乱后）头脑清醒的，神志正常的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здравый",
                                "target_lang_sense_clarification": "о рассудке"
                            },
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о сознании или уме"
                            },
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "находящийся в сознании"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "klar",
                                "target_lang_sense_clarification": "geistig voll da und orientiert"
                            },
                            {
                                "target_lang_word": "bei Verstand",
                                "target_lang_sense_clarification": "geistig zurechnungsfähig"
                            },
                            {
                                "target_lang_word": "luzide",
                                "target_lang_sense_clarification": "medizinisch für geistig wach und klar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清醒的",
                                "target_lang_sense_clarification": "指头脑或神志清楚"
                            },
                            {
                                "target_lang_word": "神志清醒的",
                                "target_lang_sense_clarification": "指意识恢复正常"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d52c62e-d453-385b-86ae-3c7c546625dc",
                    "sense_definition": "Bright, luminous, or transparent in appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lucid</w> waters of the mountain lake allowed us to see the pebbles on the bottom.",
                            "target_lang_translations": {
                                "ru": "<w>Прозрачные</w> воды горного озера позволяли нам видеть гальку на дне.",
                                "de": "Das <w>klare</w> Wasser des Bergsees ermöglichte es uns, die Kieselsteine auf dem Grund zu sehen.",
                                "zh": "高山湖泊<w>清澈的</w>湖水让我们能够看清湖底的鹅卵石。"
                            }
                        },
                        {
                            "text": "A <w>lucid</w> stream of light filtered through the stained glass window.",
                            "target_lang_translations": {
                                "ru": "<w>Ясный</w> луч света пробивался сквозь витражное окно.",
                                "de": "Ein <w>heller</w> Lichtstrahl drang durch das Buntglasfenster.",
                                "zh": "一束<w>明亮的</w>光线穿透了彩绘玻璃窗。"
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliant",
                        "radiant",
                        "transparent",
                        "translucent",
                        "pellucid"
                    ],
                    "antonyms": [
                        "opaque",
                        "murky",
                        "dark"
                    ],
                    "common_phrases": [
                        "lucid water",
                        "lucid stream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, светящийся или прозрачный на вид.",
                        "de": "Hell, leuchtend oder durchsichtig im Erscheinungsbild.",
                        "zh": "明亮的；清澈透明的。"
                    },
                    "translations": {
