        "fr-extract.jsonl": [
            {
                "entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                "word": "absurdement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                        "entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                        "glosses": [
                            "D’une manière absurde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e89a759c-c61f-45a0-a750-5d41e6067221",
                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                "text": "Il était ridicule d’augmenter le conseil, déjà absurdement nombreux"
                            },
                            {
                                "example_id": "43732b8d-d030-4c30-899e-7c65b970ede9",
                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                "text": "Ni les râleurs du collectif « Non aux JO 2024 à Paris », qui assurent que les dépenses de sécurité ont été absurdement sous-évalués et jurent qu’elles s’élèveront, au minimum, à six fois plus que les 182 millions prévus."
                            },
                            {
                                "example_id": "11654563-188d-4c0f-954f-90ccdf20d35e",
                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                "text": "Je ne pense pas aux milliers de déportés absurdement transbahutés là dans un autre siècle, mais au corps vieilli de ma soeur."
                            },
                            {
                                "example_id": "4b3f8aee-97bd-471d-b20e-85d1b06017c5",
                                "sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                                "text": "Il a raisonné absurdement. Il a absurdement raisonné."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7917a807-7552-42bf-ace4-700f28d27d2f",
                        "source_entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                        "source_sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                        "target_lang_word": "absurdly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absurdly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                        "entry_id": "7ec1197c-9f6b-307d-a2b4-15879040ab49",
                                        "glosses": [
                                            "In an absurd fashion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b488a7-cf12-4329-a501-05dcd9b65de8",
                                                "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                                "text": "He orated absurdly."
                                            },
                                            {
                                                "example_id": "8a55540f-ee7d-4fe2-9d84-f621c3dc4581",
                                                "sense_id": "eb3ec769-afc3-32bd-819a-59e7d612a6c7",
                                                "text": "Absurdly, he concluded his oration with a song."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                        "entry_id": "7ec1197c-9f6b-307d-a2b4-15879040ab49",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f5d9e1-7a83-4d2a-b3ec-28c31f69b48f",
                                                "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                                "text": "The critics were absurdly extravagant with their praise."
                                            },
                                            {
                                                "example_id": "c343006f-ba50-4032-a8a0-cc538aa97a47",
                                                "sense_id": "a1c59dd4-d412-3b72-9f17-6e432052745c",
                                                "text": "By the year 1765, Richard `Dickie' Tattersall, the absurdly romantic self-styled soldier of fortune and indulged son of an obscenely well-off Yorkshire squire, was brimming with gratitude[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "556c43d4-2b15-41dc-a001-0f089633c2b9",
                        "source_entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                        "source_sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                        "target_lang_word": "ludicrously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ludicrously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2e05cbd-f740-3af1-90ca-17b3654dff2f",
                                        "entry_id": "b0e28c57-609e-3fe1-9059-255e59b070d7",
                                        "glosses": [
                                            "In a ludicrous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfcc5e36-a36a-466b-ab4d-ae0d0a168610",
                                                "sense_id": "a2e05cbd-f740-3af1-90ca-17b3654dff2f",
                                                "text": "That authority has been sharpened by the cavalcade of ludicrously rich tech dorks, like Mark Zuckerberg and Jeff Bezos, who have each paid fealty to the man—forming the framework for a deregulatory free-for-all looting reminiscent of mid-’90s Russia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70ce808b-ef44-486d-858d-24b3efbabd07",
                        "source_entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
                        "source_sense_id": "b91149f2-7796-3531-a42e-180882d131af",
                        "target_lang_word": "preposterously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preposterously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58d603bb-803b-34b1-b472-3f18787174bc",
                                        "entry_id": "597b13ae-d925-39f6-b295-a8fdba5c2ce4",
                                        "glosses": [
                                            "In a preposterous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21655fb5-5156-4e81-8dad-83a9db221c8d",
                                                "sense_id": "58d603bb-803b-34b1-b472-3f18787174bc",
                                                "text": "Some, however, have preposterously sisted nature as the first or generative principle."
                                            },
                                            {
                                                "example_id": "dfb81188-f72d-46d6-b15d-18258bdc6718",
                                                "sense_id": "58d603bb-803b-34b1-b472-3f18787174bc",
                                                "text": "The opening sections of Martin’s biography are clogged with genealogical chronicles of the Garcías (the father’s family) and the Márquezes (the mother’s), snaking into the 19th century — a preposterously tangled story of cousins and noncousins united in wedlock, nonwedlock, near-incest, vendetta-mania and frontier trailblazing in the Colombian wilds[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0acb092-668f-4709-a74b-81e3d36000a0",
                        "source_entry_id": "033c1fad-6964-3830-bcb4-b8aade5713d2",
