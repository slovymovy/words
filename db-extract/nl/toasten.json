                        "target_lang_word": "toast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abcafa06-1e59-395d-9c8b-dc13be853a9d",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "Bread that has been cooked lightly and browned."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7a25c7-432b-415d-a005-bab31c6dcf97",
                                                "sense_id": "abcafa06-1e59-395d-9c8b-dc13be853a9d",
                                                "text": "I ate a piece of toast for breakfast."
                                            },
                                            {
                                                "example_id": "38478989-44e6-4038-a2be-0db43eabb35e",
                                                "sense_id": "abcafa06-1e59-395d-9c8b-dc13be853a9d",
                                                "text": "This toast and marmalade tastes heavenly."
                                            },
                                            {
                                                "example_id": "0305fd83-b58f-468b-978f-319a6595c253",
                                                "sense_id": "abcafa06-1e59-395d-9c8b-dc13be853a9d",
                                                "text": "Tea was a very special institution, revolving as it did around the ceremony and worship of Toast. In [public schools] where alcohol, tobacco and drugs were forbidden, it was essential that something should take their place as a powerful and public totem of virility and cool. Toast, for reasons lost in time, was the substance chosen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e8b331-cf1f-3bad-b019-c1696c27043f",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "A proposed salutation (e.g. saying \\\"cheers\\\") while drinking alcohol."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c04b2828-475f-46c6-bf89-2a7d9bd6c272",
                                                "sense_id": "68e8b331-cf1f-3bad-b019-c1696c27043f",
                                                "text": "At the reception, there were many toasts from the well-wishers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c6fccb6-7374-32c5-bf38-5d2b67f8d402",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "A person, group, or notable object to which a salutation with alcohol is made; a person or group held in similar esteem."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6397dea-05d1-45fd-a544-b69da142cf6c",
                                                "sense_id": "6c6fccb6-7374-32c5-bf38-5d2b67f8d402",
                                                "text": "He was the toast of high society."
                                            },
                                            {
                                                "example_id": "406a0c8b-7138-47f0-b533-ba1e76cf5818",
                                                "sense_id": "6c6fccb6-7374-32c5-bf38-5d2b67f8d402",
                                                "text": "Josephine Baker did not become the toast of Paris by just shaking her booty for some theater gypsies as a party wound down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db94043-67a4-3617-b439-ca72560869d2",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "Something that is irreparably damaged or used up, especially when destroyed by heat or fire; something which has been burnt to a crisp or incinerated."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8a67588-00f8-4922-b5e0-a0ca607182f9",
                                                "sense_id": "5db94043-67a4-3617-b439-ca72560869d2",
                                                "text": "The metal frame survived the fire, but the plastic and rubber bits are toast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78886a9a-38b0-3eac-b029-55144c929b7d",
                                        "entry_id": "d8e022ff-5342-3ca7-801c-6005cfcd2f1a",
                                        "glosses": [
                                            "Something that will be no more; something subject to impending destruction, harm or injury."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85a25a2-d903-4a87-8a44-46063ae93d86",
                                                "sense_id": "78886a9a-38b0-3eac-b029-55144c929b7d",
                                                "text": "to become/be toast"
                                            },
                                            {
                                                "example_id": "80aa7f6e-d423-4082-9bac-3c51e5f7df5a",
                                                "sense_id": "78886a9a-38b0-3eac-b029-55144c929b7d",
                                                "text": "If I ever get my hands on the guy that stole my wallet, he’s toast!"
                                            },
                                            {
                                                "example_id": "ca419ed5-75ad-474c-8268-b17922040d85",
                                                "sense_id": "78886a9a-38b0-3eac-b029-55144c929b7d",
                                                "text": "You are going to be toast if you don't submit your school project on time."
                                            },
                                            {
                                                "example_id": "3c66f449-8f4c-4a03-8ab8-16123991d520",
                                                "sense_id": "78886a9a-38b0-3eac-b029-55144c929b7d",
                                                "text": "This chick is toast!"
                                            }
                                        ]
                                    },
                                    {
