        "fr-extract.jsonl": [
            {
                "entry_id": "ccb27694-a0ec-362c-a7b9-2b77d7f737af",
                "word": "acrotère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "749153a5-e770-4171-8844-a76352393198",
                        "entry_id": "ccb27694-a0ec-362c-a7b9-2b77d7f737af",
                        "tags": [
                            "plural"
                        ],
                        "form": "acrotères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
                        "entry_id": "ccb27694-a0ec-362c-a7b9-2b77d7f737af",
                        "glosses": [
                            "Ornementation placée aux extrémités supérieures des édifices, principalement sur les frontons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fbe9b90-58c8-4aa6-9cec-f67e9f1aa612",
                                "sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
                                "text": "Tandis que la voiture tourne lentement sur la gauche dans la rue Ollivier, M. Jouet lève un regard inquiet sur la haute façade, et ne peut s’empêcher de frissonner : cette église lui paraît, à travers la vitre, étrangement lugubre. C’est peut-être la nuit, cette lune blafarde, ou bien ces trois statues qu’il devine là-haut, perchées sur le fronton – la Foi, l’Espérance et la Charité, pieux acrotères et sombres sentinelles dont M. Jouet sent peser le regard, tandis que le clocher sonne ses derniers coups."
                            },
                            {
                                "example_id": "7b60090b-830d-4997-b029-32ca67e895e2",
                                "sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
                                "text": "Ces deux fragments pourraient appartenir au même acrotère."
                            },
                            {
                                "example_id": "acb0696c-0989-42c6-94fc-8d57c88e4731",
                                "sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
                                "text": "Les acrotères et les corniches du palais servent de perchoir à des familles de goélands, de plongeons et de cigognes."
                            },
                            {
                                "example_id": "71f1438f-2d0b-45d5-ad3c-826300b0c625",
                                "sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
                                "text": "Le toit du porche, à forme aiguë, comme toute vieille charpente, se distinguait par deux girouettes perchées aux deux bouts d’une cime ornée de ces serrureries bizarres que les savants nomment un acrotère."
                            }
                        ]
                    },
                    {
                        "sense_id": "7aafb1b5-fdd7-345a-81df-0ee4f12e5890",
                        "entry_id": "ccb27694-a0ec-362c-a7b9-2b77d7f737af",
                        "glosses": [
                            "Portion supérieure de mur ceinturant une toiture-terrasse."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19601226-d62e-4ca4-b684-c9cf68aefbd0",
                        "source_entry_id": "ccb27694-a0ec-362c-a7b9-2b77d7f737af",
                        "source_sense_id": "c76d4446-6e3f-348b-9d05-8f5ac5d3a076",
