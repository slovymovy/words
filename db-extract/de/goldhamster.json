                        "entry_id": "c898ac9c-4765-3637-b034-755c0cece231",
                        "glosses": [
                            "aus Syrien stammendes und häufig als Haus- und Labortier gehaltenes Nagetier der Art Mesocricetus auratus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f6e0850-0b43-4e68-871c-93de5d0ce4f3",
                                "sense_id": "2c84e24f-ad88-3402-b53d-3584073547b9",
                                "text": "Als Kind hatte ich einen Goldhamster und einen Wellensittich."
                            },
                            {
                                "example_id": "1e729ac7-13c5-446a-a698-232054f35633",
                                "sense_id": "2c84e24f-ad88-3402-b53d-3584073547b9",
                                "text": "Aufgrund seines enormen Übergewichts benötigt der Goldhamster dringend eine Futterumstellung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
