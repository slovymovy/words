                ],
                "translations": [
                    {
                        "translation_id": "8367013b-abe5-46b5-b915-c5bba8bf6ae8",
                        "source_entry_id": "a3cf02a5-cfd2-3201-af25-bc77e1ae3a1f",
                        "target_lang_word": "credit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "credit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b07105fe-04ff-3dc9-abf2-2d8673532d5a",
                                        "entry_id": "876b9241-5bf5-3b12-819c-fd9e8db9894a",
                                        "glosses": [
                                            "To believe; to put credence in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed88429-b593-4786-9449-2ed4edb93b20",
                                                "sense_id": "b07105fe-04ff-3dc9-abf2-2d8673532d5a",
                                                "text": "Someone said there were over 100,000 people there, but I can't credit that."
                                            },
                                            {
                                                "example_id": "762d401a-85ff-4d5f-bfd2-e167fe40be2d",
                                                "sense_id": "b07105fe-04ff-3dc9-abf2-2d8673532d5a",
                                                "text": "How shall they credit\n A poor unlearned virgin?"
                                            },
                                            {
                                                "example_id": "f4f17793-2934-4eb1-89fc-d98319fa6e69",
                                                "sense_id": "b07105fe-04ff-3dc9-abf2-2d8673532d5a",
                                                "text": "[T]he Heart that is conscious of its own integrity is ever slowest to credit another's Treachery."
                                            },
                                            {
                                                "example_id": "4951447a-37a4-43e9-980f-585b996c3a0e",
                                                "sense_id": "b07105fe-04ff-3dc9-abf2-2d8673532d5a",
                                                "text": "She said quite naturally, as if nothing had happened, “I want you to go back home, Victor darling. You mustn’t worry about me any more.”’ Victor told me he could hardly credit it, at first, that she could stand there and say this to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1113921-958b-3854-8453-f871aec307fd",
                                        "entry_id": "876b9241-5bf5-3b12-819c-fd9e8db9894a",
                                        "glosses": [
                                            "To add to an account."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca3904f9-423b-4a76-87f8-86251da65802",
                                                "sense_id": "a1113921-958b-3854-8453-f871aec307fd",
                                                "text": "Credit accounts receivable with the amount of the invoice."
                                            },
                                            {
                                                "example_id": "832e0ad0-2577-41cd-817a-68b719bde538",
                                                "sense_id": "a1113921-958b-3854-8453-f871aec307fd",
                                                "text": "For the payroll period credit employees' tips to their wages paid account and debit their minimum wage payable account."
                                            },
                                            {
                                                "example_id": "8c0d6b52-1a9b-4a6f-9f89-8ac036eebde8",
                                                "sense_id": "a1113921-958b-3854-8453-f871aec307fd",
                                                "text": "The full amount of the purchase has been credited to your account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d84dccb-ae36-3816-b2d1-096828f46189",
                                        "entry_id": "876b9241-5bf5-3b12-819c-fd9e8db9894a",
                                        "glosses": [
                                            "To acknowledge the contribution of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54eff69-1272-44c1-824f-e0498a72750b",
                                                "sense_id": "2d84dccb-ae36-3816-b2d1-096828f46189",
                                                "text": "I credit the town council with restoring the shopping district."
                                            },
                                            {
                                                "example_id": "0e111181-0281-45f1-a74d-dd3de239cbd3",
                                                "sense_id": "2d84dccb-ae36-3816-b2d1-096828f46189",
                                                "text": "Credit the point guard with another assist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c4e9691-4379-30c7-b6b4-850f0303e7c6",
                                        "entry_id": "876b9241-5bf5-3b12-819c-fd9e8db9894a",
                                        "glosses": [
                                            "To bring honour or repute upon; to do credit to; to raise the estimation of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfcbfbbc-8d5c-453a-988d-f8be1fd991dc",
                                                "sense_id": "0c4e9691-4379-30c7-b6b4-850f0303e7c6",
                                                "text": "You credit the church as much by your government as you did the school formerly by your wit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "credit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b1fcc430-23d6-385f-bc1e-b98e58d86bbb",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "Reliance on the truth of something said or done; faith; trust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c319c1d-3178-41e3-9ae8-8746a1a8a614",
                                                "sense_id": "b1fcc430-23d6-385f-bc1e-b98e58d86bbb",
                                                "text": "When Jonathan and the people heard these words they gave no credit into them, nor received them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "Recognition, respect and admiration."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02ac66c-e834-44d3-8e23-ae94988d7895",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "I give you credit for owning up to your mistake."
                                            },
                                            {
                                                "example_id": "c3055a90-866c-4879-aacd-74085aa05dcb",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "He arrived five minutes late, but to his credit he did work an extra ten minutes at the end of his shift."
                                            },
                                            {
                                                "example_id": "85aa0838-e978-4048-a35f-6d72d234937d",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "John Gilpin was a citizen\n Of credit and renown,\n A train-band Captain eke was he\n Of famous London town."
                                            },
                                            {
                                                "example_id": "b73d266d-e652-462c-af86-5abaee35fb91",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "The admirable smoothness of the riding also reflected the greatest credit on those who, despite the difficulties caused by the shortage of men and materials, have succeeded in maintaining the track in such first-class order."
                                            },
                                            {
                                                "example_id": "f3ff51fb-68c6-4e9e-aead-b5d7e2c3c2de",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "\"I've got to give credit to Van Persie, it was a great goal. We didn't mean to give them chances but they're a good team.\""
                                            },
                                            {
                                                "example_id": "12575341-7b08-4249-86a4-7f7e72a32723",
                                                "sense_id": "82c25647-c64b-3154-83b3-ead39f30803a",
                                                "text": "You have to give director Colm McCarthy, a Scottish TV veteran making his feature film debut, and writer Mike Carey, adapting his own novel, credit for attempting the seemingly impossible task of doing something new with the zombie subgenre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "774277c6-8c8b-33d2-b2d1-6ea39dc69dfa",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "Acknowledgement of a contribution, especially in the performing arts."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "109cb24d-5dc2-4b57-89cd-41d8b9b9dcf9",
                                                "sense_id": "774277c6-8c8b-33d2-b2d1-6ea39dc69dfa",
                                                "text": "She received a singing credit in last year's operetta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1641bd2-deb5-30d7-936c-3ba57cf87302",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "Written titles and other information about the TV program or movie shown at the beginning and/or end of the TV program or movie."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a02e0d-d0b6-4903-9114-8c62a4be36c4",
                                                "sense_id": "b1641bd2-deb5-30d7-936c-3ba57cf87302",
                                                "text": "They kissed, and then the credits rolled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c25ce4d-2d37-3a26-95af-67252c100885",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A privilege of delayed payment extended to a buyer or borrower on the seller's or lender's belief that what is given will be repaid."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab7b494e-6d8e-4cab-b495-b1c0c0fd344c",
                                                "sense_id": "1c25ce4d-2d37-3a26-95af-67252c100885",
                                                "text": "In view of your payment record, we are happy to extend further credit to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6e79b24-b72e-3c2b-b738-dd388e8f48f9",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "The time given for payment for something sold on trust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61f21368-f92f-4100-9258-ba1709035ad5",
                                                "sense_id": "e6e79b24-b72e-3c2b-b738-dd388e8f48f9",
                                                "text": "a long credit or a short credit"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "323d7949-ed4f-326b-948b-6f9fe64e94b0",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A person's credit rating or creditworthiness, as represented by their history of borrowing and repayment (or non payment)."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1453814b-84e4-44d6-9e72-a0dea61b3030",
                                                "sense_id": "323d7949-ed4f-326b-948b-6f9fe64e94b0",
                                                "text": "What do you mean my credit is no good?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9be3af0-82fe-3527-b180-2afdd5822c60",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "An addition to certain accounts; the side of an account on which payments received are entered."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c6df301-636c-33ff-957b-985da0f7547e",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A reduction in taxes owed, or a refund for excess taxes paid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839f10c0-dd2e-41e4-814a-ffedc553e061",
                                                "sense_id": "9c6df301-636c-33ff-957b-985da0f7547e",
                                                "text": "Didn't you know that the IRS will refund any excess payroll taxes that you paid if you use the 45(B) general business credit?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71701553-f455-3876-8ae0-88595aad9c9d",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A source of value, distinction or honour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b460308f-ec3d-4861-a089-a0768364817a",
                                                "sense_id": "71701553-f455-3876-8ae0-88595aad9c9d",
                                                "text": "That engineer is a credit to the team."
                                            },
                                            {
                                                "example_id": "424e6463-47eb-4972-9cfd-c0c1111950ea",
                                                "sense_id": "71701553-f455-3876-8ae0-88595aad9c9d",
                                                "text": "I published, because I was told I might please such as it was a credit to please."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be94040f-ffb2-3348-a50c-a2394880325d",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A unit of currency used in a fictional universe or timeframe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe8df89-0320-46be-8fb8-7205a4fa0329",
                                                "sense_id": "be94040f-ffb2-3348-a50c-a2394880325d",
                                                "text": "To repair your star cruiser will cost 100,000 credits."
                                            },
                                            {
                                                "example_id": "b0bab28b-2223-4738-91a4-1bb07ba60885",
                                                "sense_id": "be94040f-ffb2-3348-a50c-a2394880325d",
                                                "text": "Aside from the fact that she means nearly ten million credits investment, which no one will insure on this trip, there will necessarily be seventy-three men aboard."
                                            },
                                            {
                                                "example_id": "1506192a-b562-4afa-87ca-4640d92f612c",
                                                "sense_id": "be94040f-ffb2-3348-a50c-a2394880325d",
                                                "text": "The standard credit was established by the Citadel's Unified Banking Act as the currency of interstellar trade. The credit has a managed floating exchange rate, calculated in real time by the central bank to maintain the average value of all participating currencies. Some regional currencies are worth more than a credit and some less."
                                            },
                                            {
                                                "example_id": "9e399b63-f174-42b2-a62d-071437f0f80b",
                                                "sense_id": "be94040f-ffb2-3348-a50c-a2394880325d",
                                                "text": "\"First the Patrons wipe-out our home world, now you blow any chance of us making any credits,\" Kane said in his gruff sinking voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d31474b-612c-33a5-8a07-d8585792187b",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A nominal unit of value assigned outside of a currency system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f020ceef-7839-40f8-8826-7e4eaf9fca8e",
                                                "sense_id": "4d31474b-612c-33a5-8a07-d8585792187b",
                                                "text": "Would you like to play? I put in a dollar and I've got two credits left."
                                            },
                                            {
                                                "example_id": "e578b71c-8a13-40b1-b0a5-40544423e87c",
                                                "sense_id": "4d31474b-612c-33a5-8a07-d8585792187b",
                                                "text": "Facebook Credits are a virtual currency used only on Facebook that debuted in May 2009. Ten credits are equal to one dollar. Facebook keeps 30% of all Facebook Credit transactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23130314-8434-3ced-a4ea-44fb28eb431a",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "Recognition for having taken a course (class)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07fc9ad1-2336-4d1a-9ee4-b962c6207acd",
                                                "sense_id": "23130314-8434-3ced-a4ea-44fb28eb431a",
                                                "text": "If you do not come to class, you will not get credit for the class, regardless of how well you do on the final."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85cd8128-6c75-323a-9d8e-b072a9ebbf96",
                                        "entry_id": "60644f78-9141-381b-a6ea-1508377cb7f6",
                                        "glosses": [
                                            "A course credit, a credit hour – used as measure if enough courses have been taken for graduation."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11800c69-c89f-4d99-9717-58b57089646c",
                                                "sense_id": "85cd8128-6c75-323a-9d8e-b072a9ebbf96",
                                                "text": "Dude, I just need 3 more credits to graduate – I can take socio-linguistics of Swahili if I want."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
