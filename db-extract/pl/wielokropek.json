                        ]
                    },
                    {
                        "translation_id": "60dbe8ac-b05f-4ad6-8b0f-8099676d6dc7",
                        "source_entry_id": "c4793e83-db6c-3cc9-8559-8ab421a068de",
                        "source_sense_id": "7314d0dc-bb19-3b78-b7e0-dc183d23242d",
                        "target_lang_word": "троеточие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "троеточие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "70f071a9-026d-3c14-b7fa-6c9d86e3877c",
                                        "entry_id": "7c6fe935-907c-3f62-af2a-96cd5ba60010",
                                        "glosses": [
                                            "разг. то же, что многоточие; знак препинания в виде трёх точек, ставящийся в конце предложения или в середине и означающий паузу, незавершённость, задумчивость и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2bf0b1-648e-4718-84f2-0ec36174eb79",
                                                "sense_id": "70f071a9-026d-3c14-b7fa-6c9d86e3877c",
                                                "text": "Если название команды меню заканчивается троеточием (…), выбор этой команды приведёт к открытию диалогового окна〈…〉"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "974b6ae6-7858-3dfc-a4d5-6475a5620742",
                                        "entry_id": "7c6fe935-907c-3f62-af2a-96cd5ba60010",
                                        "glosses": [
                                            "прогр. три точки подряд — указание на переменное число аргументов функции (в некоторых языках программирования)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7595995-1cdf-4852-a726-9d38a94e41db",
                                                "sense_id": "974b6ae6-7858-3dfc-a4d5-6475a5620742",
                                                "text": "Наличие троеточий в C++ — опасное наследие C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e27841-150e-3135-9748-3d430a58988c",
                                        "entry_id": "7c6fe935-907c-3f62-af2a-96cd5ba60010",
                                        "glosses": [
                                            "лингв. то же, что треугольное троеточие; разделительный знак между словами или предложениями, использовавшийся в древних славянских и грузинских рукописях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e694dd9d-dab0-4b13-9901-ab0f227e83f8",
                                                "sense_id": "99e27841-150e-3135-9748-3d430a58988c",
                                                "text": "Так, например, характерное для многих берестяных грамот старшего периода использование вертикального двоеточия или троеточия в качестве разделительного знака между словами и даже просто между слогами не находит надёжной аналогии в древнерусской книжной письменности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
