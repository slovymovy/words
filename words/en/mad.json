            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb02575a-8e7d-3c24-97b7-6f99b985b658",
                    "sense_definition": "To make someone angry or frustrated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion_anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant delay <w>mads</w> him.",
                            "target_lang_translations": {
                                "ru": "Постоянная задержка <w>бесит</w> его.",
                                "zh": "不断的拖延总是<w>惹恼</w>他。"
                            }
                        },
                        {
                            "text": "It <w>madded</w> her to see such a mess in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Ее <w>злило</w> видеть такой беспорядок на кухне.",
                                "zh": "看到厨房这么乱，真会<w>惹恼</w>她。"
                            }
                        }
                    ],
                    "traits": [
