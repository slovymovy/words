                                    },
                                    {
                                        "sense_id": "a91684f5-7f17-31ee-ad1d-d52cfa96dddf",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "An area in a video game from which individual levels are accessed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32d58c3-4fe9-467e-af87-5f2d467fd333",
                                                "sense_id": "a91684f5-7f17-31ee-ad1d-d52cfa96dddf",
                                                "text": "In a break with tradition, these levels are tackled in any order, with the next act chosen from a semi-random selection machine located in the game's hub area."
