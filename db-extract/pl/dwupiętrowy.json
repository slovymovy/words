                "senses": [
                    {
                        "sense_id": "e6aa2b6a-cace-33e6-8e4d-bb9bbbc7995b",
                        "entry_id": "6774cd30-aa7e-3aff-8ca0-5f01b1e6e4e7",
                        "glosses": [
                            "złożony z dwóch pięter, mający dwa piętra"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea3fbc1-40f5-42c2-8834-ab225dfb989a",
                                "sense_id": "e6aa2b6a-cace-33e6-8e4d-bb9bbbc7995b",
                                "text": "Ten dwupiętrowy obiekt wewnątrz wyłożony został ściankami gipsowymi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9a2db7bf-733e-334f-a988-7d3f148525d2",
                        "entry_id": "6774cd30-aa7e-3aff-8ca0-5f01b1e6e4e7",
                        "glosses": [
                            "złożony z parteru i dwóch pięter, mający trzy kondygnacje ponad poziom gruntu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5d575fc-e38c-42e7-b078-ef8b4de737c0",
                        "source_entry_id": "6774cd30-aa7e-3aff-8ca0-5f01b1e6e4e7",
                        "source_sense_id": "9a2db7bf-733e-334f-a988-7d3f148525d2",
                        "target_lang_word": "three",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "three",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                        "entry_id": "431fcc9c-bb46-31c3-9f86-7c9dd65bcabb",
                                        "glosses": [
                                            "A numerical value after two and before four. Represented in Arabic digits as 3; this many dots (•••)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cecbae-5974-41cd-960a-74be5c6ac304",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Venters began to count them—one—two—three—four—on up to sixteen."
                                            },
                                            {
                                                "example_id": "8350e9f2-1b56-4567-a5b6-5bddf658d17f",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "There is a soft-mat seat (which originally had a palm fiber underwebbing) supported by three curved transverse braces."
                                            },
                                            {
                                                "example_id": "58ada4f9-7235-46b6-878e-6a66cae03354",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Okay, on three, we open the door and jump on the rope. One, two…\nWait, wait! Do we go on three? Or do we go on “go”?\nThree! Who said anything about “go”?"
                                            },
                                            {
                                                "example_id": "5c881285-4b7d-46ef-95ac-da249c9e4bd0",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Now we continue zooming-in in three different directions depending on the number of ones."
                                            },
                                            {
                                                "example_id": "767dbead-7ace-4c42-9b70-021e3d0a5cd4",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Why should she care? One…two…\nDo we shoot on three?\nYes on three. Like one, two, three, shoot."
                                            },
                                            {
                                                "example_id": "e4392da4-06f1-49d7-bdae-38225b199e43",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "The beetles are named Binburrum articuno, Binburrum moltres and Binburrum zapdos after three rare Pokémon: Articuno, Moltres and Zapdos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d89fe1-894c-3344-9e9f-420440d5c0a1",
                                        "entry_id": "431fcc9c-bb46-31c3-9f86-7c9dd65bcabb",
                                        "glosses": [
                                            "Describing a set or group with three elements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "three",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0521b870-5e50-33f3-bc9d-acad887eddd9",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "The digit/figure 3."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d35875c-1335-46a2-ae96-ec8e8354c0d3",
                                                "sense_id": "0521b870-5e50-33f3-bc9d-acad887eddd9",
                                                "text": "In our example, 1210 has 1 zero, 2 ones, 1 two and 0 threes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "189fe251-01b5-3bae-aef6-3c70b60b4126",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "Anything measuring three units, as length."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3a0ccc-6e8c-41a9-95c1-a6778094ed9c",
                                                "sense_id": "189fe251-01b5-3bae-aef6-3c70b60b4126",
                                                "text": "Put all the threes in a separate container."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8345755c-708c-3c5f-b02b-87bacba5169f",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "A person who is three years old."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9a70441-689e-4ab3-ac38-688178a8701a",
                                                "sense_id": "8345755c-708c-3c5f-b02b-87bacba5169f",
                                                "text": "All the threes will go in Mrs. Smith's class, while I'll take the fours and fives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9420302e-8693-30fc-a307-8459e02f8627",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "The playing card featuring three pips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42608df9-1d37-3a0f-bf9b-b15fc480ad18",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "Three o'clock, either a.m. or p.m."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b21cb5-bd0b-4909-b14d-158412e1a2a0",
                                                "sense_id": "42608df9-1d37-3a0f-bf9b-b15fc480ad18",
                                                "text": "It was a weary time. A carriage clock had been placed on the discoloured wooden mantelpiece, and slowly its hands crept on from one to two and from two to three."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac5269b4-af84-3d40-b2db-2188cd629949",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "Abbreviation of three-pointer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13e5a387-892e-4529-93d0-c88ffbb90b16",
                        "source_entry_id": "6774cd30-aa7e-3aff-8ca0-5f01b1e6e4e7",
                        "source_sense_id": "9a2db7bf-733e-334f-a988-7d3f148525d2",
                        "target_lang_word": "storey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "storey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                        "entry_id": "9f76008c-1433-3dba-88cf-aab60302bd4d",
                                        "glosses": [
                                            "A floor or level of a building or ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a92bc4-f62e-4d74-baf0-25160bf25724",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "For superstitious reasons, many buildings number their 13th storey as 14, bypassing 13 entirely."
                                            },
                                            {
                                                "example_id": "2ac411f2-a1bf-40fc-8bda-2baa38091b16",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "a multi-storey car park"
                                            },
                                            {
                                                "example_id": "0b5b0d90-5cba-40ef-9361-54121a588c16",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "It was re-built in the year 1659, and conſiſts of two ſtories of aſhler work.—The loweſt, or ground flat, on each ſide of the main gate, is occupied by ſhops, and in the ſecond ſtorey, a range of large windows, with triangular pediments, give light to the Hall."
                                            },
                                            {
                                                "example_id": "13e34285-0305-4830-aaa2-0db878f506be",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "Let the ſtreet be 100 feet in breadth, from front to front; ſunk ſtorey, from front to paliſade, 10 feet; breadth of pavement, 8 feet; the height of the houſe 2 ſtories, 15 feet each, from floor to floor; […]"
                                            },
                                            {
                                                "example_id": "b8119d40-d14b-45fd-bfc7-433a27d9b127",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "Each of the succeeding stories should be furnished in the same manner, with the platforms directly above one another, to afford protection against loose materials falling upon the man at the pump. If the water is wanted in the second storey, open the ejection pipe and cock below, shut the cock above, and direct the ejection pipe to where it is wanted."
                                            },
                                            {
                                                "example_id": "974bf255-1c78-4e9b-b7a5-1da6562f6553",
                                                "sense_id": "b56a857d-be11-30b1-8a97-e63896becfa7",
                                                "text": "This was the era of the polykatoikia, the apartment block built of unadorned concrete and typically five or six storeys high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6000e753-bea6-3108-85fb-ec9463360012",
