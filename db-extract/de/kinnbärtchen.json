                        "examples": [
                            {
                                "example_id": "8ea63bfa-980c-4945-a20b-04960fa03172",
                                "sense_id": "fd52fb73-25e2-3a4e-9166-91fb39957f22",
                                "text": "„Drei Dunkelhaarige in Kampfmontur zielten mit Gewehren auf sie; einer der anderen beiden war beeindruckend groß und breit, hatte blondes Haar und trug eine Lederjacke und anscheinend keine Waffe; der Fünfte war jünger, hatte ein Kinnbärtchen und steckte in einem edlen Anzug.“"
                            },
                            {
                                "example_id": "de6bf805-1db0-4b09-8e1c-ed8fdcdaab3e",
                                "sense_id": "fd52fb73-25e2-3a4e-9166-91fb39957f22",
                                "text": "„›Anfang 30. Rasiert sich den Schädel, trägt aber einen von diesen fusseligen Kinnbärtchen.‹“"
                            }
                        ],
