                "senses": [
                    {
                        "sense_id": "b09bf32b-d7dd-396f-8c66-f524f6394a16",
                        "entry_id": "1e5a346a-51b9-30b0-9e68-aba40708b6b8",
                        "glosses": [
                            "fachwissenschaftlicher Terminus für das zoologische, hierarchisch hoch angesiedelte Taxon des Stammes, das zwischen dem Regnum (deutsch: Reich) und der Classis (deutsch: Klasse) steht. Im Pflanzenreich entspricht formal dem Phylum die Divisio (deutsch: die Abteilung)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e635d8f-6c44-4b06-86df-d39ab481a62e",
                                "sense_id": "b09bf32b-d7dd-396f-8c66-f524f6394a16",
                                "text": "Dem zoologischen Phylum (Stamm) entspricht in der Botanik formal die Diviso (Abteilung)."
                            },
                            {
                                "example_id": "b0223f9a-638a-4890-b91e-8edce97202ac",
                                "sense_id": "b09bf32b-d7dd-396f-8c66-f524f6394a16",
                                "text": "Das Phylum der Chordata (Chordatiere) umfasst die beiden Subphyla der Acrania (Lanzettfischchen) und der Vertebrata (Wirbeltiere)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
