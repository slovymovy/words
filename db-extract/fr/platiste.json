                ],
                "senses": [
                    {
                        "sense_id": "bfe5edb7-2e8a-3a72-81a7-401f88e6bf48",
                        "entry_id": "6e1f795f-9524-31df-9c54-530a96136396",
                        "glosses": [
                            "Qui concerne le platisme."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb0be0f-19f3-4cca-b19c-e7497f93effa",
                                "sense_id": "bfe5edb7-2e8a-3a72-81a7-401f88e6bf48",
                                "text": "Plusieurs gourous youtubeurs l’alimentent depuis, comme Eric Dubay, qui a publié un livre sur la Terre plate en 2014. Sur sa chaîne YouTube, on trouve des « docus », du rap platiste mais aussi un film négationniste à la gloire d’Hitler, retiré depuis par YouTube."
                            },
                            {
                                "example_id": "0ebf20a7-d001-4884-919e-b210f36372b7",
                                "sense_id": "bfe5edb7-2e8a-3a72-81a7-401f88e6bf48",
                                "text": "Il déroule ensuite la panoplie des arguments platistes que l’on retrouve dans des centaines de vidéos sur Internet cumulant plusieurs millions de vues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0e315f6-41e0-49f8-a464-c9f686cb8db2",
                        "source_entry_id": "6e1f795f-9524-31df-9c54-530a96136396",
                        "source_sense_id": "bfe5edb7-2e8a-3a72-81a7-401f88e6bf48",
