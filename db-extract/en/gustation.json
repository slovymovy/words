                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8a4412-fd5a-4413-9ef3-36c012cc3779",
                                                "sense_id": "3e4fd61f-883c-3235-99d5-af3aa4ccae23",
                                                "text": "Bu taşçılar topluluğunun tadını, çeşnisini başka hiçbir yerde bulamazlardı."
                                            }
