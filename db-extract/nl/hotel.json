                                        "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                        "entry_id": "b82502cc-3f5f-3a69-b297-6250ed3e5edd",
                                        "glosses": [
                                            "Beherbergungsbetrieb, der neben Räumen zur Unterbringung, Verpflegung und Aufenthalt von Gästen auch über eine Rezeption verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "686c8823-6549-4aa4-836e-0633d5119485",
                                                "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                                "text": "In der Ferienzeit sind die meisten Hotels ausgebucht."
                                            },
                                            {
                                                "example_id": "c48bde84-72ca-4ead-b06b-cc3064ec4542",
                                                "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                                "text": "„Der Chasseur von unserem Hotel ging in Ferien, und wir konnten von unserem Hotel-Restaurant aus umsonst aufs Klosett gehen, denn die Klosettfrau war auch fort.“"
                                            },
                                            {
                                                "example_id": "0fd24ad8-3929-4e2d-b41d-f966dcb2010b",
                                                "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                                "text": "„Wir stellten den Parnassus am Hotel ab, und ich ging zum Telefon.“"
                                            },
                                            {
                                                "example_id": "deba01ed-337d-4261-a5c5-1615998a1b63",
                                                "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                                "text": "„Es dämmerte, als ich vom Abendessen aus der Altstadt zurück in mein Hotel schlenderte.“"
                                            },
                                            {
                                                "example_id": "80e5ffc6-4b75-4f66-90ca-dd51dc4494e9",
                                                "sense_id": "43a9aef8-e4c2-32e2-a481-cdc1fd87232d",
                                                "text": "„Vor dem Hotel Abdulla – auf dem Trottoir – saßen Männer im Halbkreis, rauchten Wasserpfeifen und tranken Türkischen aus kleinen, runden Tassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88f6aed9-73c2-4c43-b47d-f007fe591f91",
                        "source_entry_id": "b0042122-28ad-337e-8910-a3f266a25fc8",
                        "source_sense_id": "f75e43b6-a6c0-3441-aab8-ad4cb2b408f2",
