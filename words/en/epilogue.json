                    "frequency": "Middle",
                    "semantic_group_id": "literary_ending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author added a brief <w>epilogue</w> explaining what happened to the characters years later."
                        },
                        {
                            "text": "I was eager to read the <w>epilogue</w> to find out if the mystery was truly resolved."
                        }
                    ],
                    "synonyms": [
                        "afterword"
                    ],
                    "antonyms": [
                        "foreword",
                        "prologue"
                    ],
                    "common_phrases": [
