                    {
                        "form_id": "4d4752c9-9e85-4174-bd0d-f97af70564bc",
                        "entry_id": "fcde041b-8e54-3d58-8c40-a545494ffe1a",
                        "tags": [],
                        "form": "auto-destruction"
