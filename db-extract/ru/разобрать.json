                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e6e3e34-b02c-3491-8b3e-58f5d4991089",
                        "entry_id": "e3d4b3f3-311c-3b0e-8bd3-84b67fd70226",
                        "glosses": [
                            "to take, buy up, snap up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094b3104-dd9b-4e99-a35a-b3704e0edb06",
                                "sense_id": "0e6e3e34-b02c-3491-8b3e-58f5d4991089",
                                "text": "Все кни́ги разобра́ли.",
                                "translation": "All the books have been taken.",
                                "english": "All the books have been taken."
                            }
                        ]
                    },
                    {
                        "sense_id": "bedadf36-f730-3d56-8e2f-16bdf174cb51",
                        "entry_id": "e3d4b3f3-311c-3b0e-8bd3-84b67fd70226",
                        "glosses": [
                            "to make out, read"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3454c94-5d0b-40cb-b37e-9ed57769c03f",
                                "sense_id": "bedadf36-f730-3d56-8e2f-16bdf174cb51",
                                "text": "Он не мо́жет разобра́ть её по́черк.",
                                "translation": "He can't make out her handwriting.",
                                "english": "He can't make out her handwriting."
                            },
                            {
                                "example_id": "5236a182-4756-488a-8d4c-2bdb75e0e083",
                                "sense_id": "bedadf36-f730-3d56-8e2f-16bdf174cb51",
                                "text": "Повтори́те, а то я не разобра́л вопро́са.",
                                "translation": "Repeat the question, because I couldn't make it out.",
                                "english": "Repeat the question, because I couldn't make it out."
                            }
                        ]
                    }
                ],
