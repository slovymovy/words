        "fr-extract.jsonl": [
            {
                "entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                "word": "footeux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf386c73-eb87-459b-87a2-b10c8864bae1",
                        "entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "tags": [
                            "feminine"
                        ],
                        "form": "footeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e245483d-0803-3432-bace-776fbbd5e34b",
                        "entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "glosses": [
                            "Passionné de football."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fb576bd2-7c69-4915-89b8-3be3d5116e84",
                                "sense_id": "e245483d-0803-3432-bace-776fbbd5e34b",
                                "text": "Mieux, pour venger illico ce dernier, une colombe de la paix peut lâcher une rafale de généreux guanos bien calibrés (et qui sentent bon leur terroir campagnard) sur un entier Stade de France overbooké de footeux braillards !\nC'est que les zozios – comme l'écrit l'ami poète, Jacques Demarcq ! –, les zozios, rien ne peut les arrêter !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce2cbac9-3ca0-38b1-8d68-1d38d95089c5",
                        "entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "glosses": [
                            "Joueur de football."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c0b91533-a23d-4a62-ace4-34d44c8e25c3",
                                "sense_id": "ce2cbac9-3ca0-38b1-8d68-1d38d95089c5",
                                "text": "Mais à la différence des footeux, les geocacheurs s'amusent entre eux et dans l'anonymat le plus complet."
                            },
                            {
                                "example_id": "efd86609-204c-4047-9171-f32b05fa6cc8",
                                "sense_id": "ce2cbac9-3ca0-38b1-8d68-1d38d95089c5",
                                "text": "On reste saisi devant la simplicité du milieu dans lequel évoluent ces championnes, à mille lieues de l’univers bling-bling du foot professionnel masculin. A se demander si footeuses et footeux exercent vraiment le même métier..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "292ad32b-b5c1-4e4e-8647-3fe1fd42ae68",
                        "source_entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "target_lang_word": "Fußballnarr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c2fa317e-c811-4b1f-ac32-f73c1b991ef0",
                        "source_entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "target_lang_word": "Fußballer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußballer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                        "entry_id": "ea1d2ae9-9ca1-3488-ae7f-da7cb3489abd",
                                        "glosses": [
                                            "ein Spieler des Sportes Fußball"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9df20-b588-480b-a26c-b2c467f90d73",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "Mein Nachbar ist ein begeisterter Fußballer."
                                            },
                                            {
                                                "example_id": "358ab6ae-94a5-4e98-aa0a-95c251366d1a",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Der ehemalige österreichische Fußballer Ernst Ogris ist im Alter von 49 Jahren in Wien nach kurzer Krankheit gestorben.“"
                                            },
                                            {
                                                "example_id": "a2f36b88-d6c9-438a-8f46-cde4312215d1",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Der Fall Maradona ist den Italienern noch bekannt, weil dem Fußballer einst ein Diamantohrring und zwei goldene Rolex-Uhren beschlagnahmt wurden, um einen Teil seiner Steuerschuld zu tilgen.“"
                                            },
                                            {
                                                "example_id": "3eb9e2f3-264a-4323-b793-d2e7d320bf4b",
                                                "sense_id": "e5812fca-fd29-3515-b8fb-7f2659a9194d",
                                                "text": "„Viele Fußballer versuchen sich dann entsprechend der in ihnen vermuteten Einsicht möglichst geschwollen auszudrücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0fc0837-7741-4c00-be62-da250ee4bbec",
                        "source_entry_id": "9c4727cb-0c11-3f0d-a9e3-a7778c588a6f",
                        "target_lang_word": "Fußballfan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußballfan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                        "entry_id": "d66882c0-5641-37a6-a07b-79197643b725",
                                        "glosses": [
                                            "Person, die sich für Fußball begeistert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddeb276b-37a7-44ed-9e0f-f988e761f6e3",
                                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                                "text": "Auf dem Marktplatz versammelten sich tausende Fußballfans zum Public Viewing."
                                            },
                                            {
                                                "example_id": "3944f784-c8be-40f0-9e31-689a7db44ee2",
                                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                                "text": "„Die Mehrheit der Fußballfans sorgt sich um den Knöchel von Schweinsteiger, die Genialität von Özil und die latente Abwehrschwäche von Boateng.“"
                                            },
                                            {
                                                "example_id": "9dacc355-eedf-4562-85b1-8150c9920953",
                                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                                "text": "„Parteigänger Kasavubus und Fußballfans verbrüdern sich.“"
                                            },
                                            {
                                                "example_id": "f1679a9b-200e-4c7e-a105-597cba6ef0c8",
                                                "sense_id": "80007c36-6a27-355f-b45b-7589b05f889d",
                                                "text": "„Den Text dieses Rembetiko sangen alle mit wie Fußballfans ihr Vereinslied in der Kurve.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
