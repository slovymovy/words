                                            {
                                                "example_id": "9c74f729-07b7-4abb-9076-3bdfc3b5fe29",
                                                "sense_id": "ac5860a4-db95-3c38-b4cf-e9ebaa621d7b",
                                                "text": "„Sein Kopf wippt dabei auf und ab wie diese Wackelkopffigur von Iron Man, die vorn in meinem Truck klebt.“"
