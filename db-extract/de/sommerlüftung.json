                "senses": [
                    {
                        "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                        "entry_id": "260745f8-ea06-3696-a6c2-b5b361848b27",
                        "glosses": [
                            "bedarfsabhängig gesteuerte, und an sommerlichem Wetter orientierte, Lüftungstechnik für einen Raum oder ein Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6469715-644a-426f-9865-f4f07c940dff",
                                "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                                "text": "„Mit der Abluftklappe steuern Sie die Sommerlüftung.“"
                            },
                            {
                                "example_id": "c2abdc72-2fff-4539-b415-f4cced2b87b4",
                                "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                                "text": "„Wer damit im Winter seinen Keller belüftet, der leitet zwar kurzfristig viel Feuchte aus, durch die Auskühlung wird sich aber das Problem mit der Sommerlüftung noch weiter verschärfen (Kondensation der Frischluft an den ausgekühlten Oberflächen).“"
                            },
                            {
                                "example_id": "3e2f2759-559b-47a9-862b-5a1c18a0b243",
                                "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                                "text": "„\"Dauerlüften\" durch ein gekipptes Fenster ist in der kalten Jahreszeit nicht zu empfehlen, da die Kippstellung eine Sommerlüftung darstellt und ständig unnötig hohe Frischluftmengen nachströmen, die erwärmt werden müssen.“"
                            },
                            {
                                "example_id": "211ecf37-a066-4dbd-b943-4624363113d3",
                                "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                                "text": "„Hinweise für Planung und Betrieb der Sommerlüftung runden den Protokollband ab.“"
                            },
                            {
                                "example_id": "e79f5821-bd32-49c7-ba31-69c985680db5",
                                "sense_id": "88baaada-6a0c-3fe7-a555-fc400016cbd5",
                                "text": "„Um all dies zu vermeiden bzw. so gering wie möglich zu halten, ist es notwendig die Stalllüftung auf die Sommerlüftung vorzubereiten, damit diese an heißen Tagen 100 % Leistung bringen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
