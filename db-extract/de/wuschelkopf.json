                        "target_lang_word": "fuzz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fuzz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2719a474-bb1f-330e-9996-a4a54413368f",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "A frizzy mass of hair or fibre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "442f01ff-c762-4766-b9cb-39456ac47304",
                                                "sense_id": "2719a474-bb1f-330e-9996-a4a54413368f",
                                                "text": "His cheeks were like peaches, with much the same sort of fuzz over them."
                                            },
                                            {
                                                "example_id": "cb41a350-6398-40f6-a53f-24bb53b62802",
                                                "sense_id": "2719a474-bb1f-330e-9996-a4a54413368f",
                                                "text": "Once the eaglets are born—tiny balls of white fuzz—the adult eagles prove that birds can be as protective and solicitous of their young as humans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f13d95-232e-35b0-964e-7e6005a88094",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "Quality of an image that is unclear; a blurred image."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa9e859-244a-46fc-916c-25d8a5989f48",
                                                "sense_id": "c5f13d95-232e-35b0-964e-7e6005a88094",
                                                "text": "...scientific advances happen more often at the frontier of representation, at the edge of resolution where an image dissolves into fuzz and blur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb99ecc-89fb-3bda-a9f6-3f7997ee2f3c",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "The random data used in fuzz testing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85f522d0-6c2d-4f72-96c5-fa140c7debd0",
                                                "sense_id": "7fb99ecc-89fb-3bda-a9f6-3f7997ee2f3c",
                                                "text": "\"Fuzz testing\" or \"fuzzing\" is a technique for software testing that provides random data (\"fuzz\") to the inputs of a program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56dc667e-2e45-3c31-96e4-341faa5fc258",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "A distorted sound, especially from an electric guitar or other amplified instrument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b58244-7453-48b7-b3b8-2ebc4c0fe7de",
                                                "sense_id": "56dc667e-2e45-3c31-96e4-341faa5fc258",
                                                "text": "This gives a good soft clipping effect and a good fuzz sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8ac325-e8bc-3431-a5cf-ae65bad479e2",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "A state of befuddlement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ea91fdd-81fe-4096-a010-a5b1318b22ab",
                                                "sense_id": "7f8ac325-e8bc-3431-a5cf-ae65bad479e2",
                                                "text": "I think I'm in a fuzz, and don't know what I ſay, I never ſaw the like."
                                            },
                                            {
                                                "example_id": "21ac9ee4-ab2b-402d-9a11-833d85080fc3",
                                                "sense_id": "7f8ac325-e8bc-3431-a5cf-ae65bad479e2",
                                                "text": "So I'm in a fuzz of not knowing what to do"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13078081-efaf-3164-8e88-0289669aec45",
                                        "entry_id": "bdfadcdf-257b-38a7-9749-d126b33fc5a2",
                                        "glosses": [
                                            "Fuzziness, vagueness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
