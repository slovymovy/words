                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b14a266c-fb66-423a-ba4b-3fb44d3efafa",
                                                "sense_id": "976c64cc-9c71-37cb-9c24-5d20614478f6",
                                                "text": "It's made from pure gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "478e64c0-43aa-3a4a-a936-82db334d3965",
                                        "entry_id": "d5bb97b2-117b-3005-8b4d-d92644ca665b",
