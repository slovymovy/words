            "senses": [
                {
                    "sense_id": "fd2da6d8-0bc0-38c8-b0a7-5856547a93c2",
                    "sense_definition": "heel vervelend, onuitstaanbaar",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervelend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind die nieuwe collega echt een <w>kwallige</w> vent.",
                            "target_lang_translations": {
                                "en": "I really think that new colleague is an <w>obnoxious</w> guy."
                            }
                        },
                        {
                            "text": "Zijn <w>kwallige</w> gedrag zorgde ervoor dat niemand met hem wilde samenwerken.",
                            "target_lang_translations": {
                                "en": "His <w>insufferable</w> behavior made sure that nobody wanted to work with him."
                            }
                        }
                    ],
                    "synonyms": [
                        "onuitstaanbaar",
                        "vervelend",
                        "irritant"
                    ],
                    "antonyms": [
                        "sympathiek",
                        "aardig"
                    ],
                    "common_phrases": [
                        "kwallig gedrag",
                        "kwallige vent"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe an annoying person"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "very annoying, obnoxious, or insufferable"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obnoxious",
                                "target_lang_sense_clarification": "extremely unpleasant or offensive"
                            },
                            {
                                "target_lang_word": "insufferable",
                                "target_lang_sense_clarification": "too extreme to bear; intolerable"
                            },
                            {
                                "target_lang_word": "slimy",
                                "target_lang_sense_clarification": "unpleasant in a smug or sycophantic way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f35aa6-b788-3334-99fd-b53a7abe98be",
                    "sense_definition": "lijkend op een <w>kwal</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De substantie voelde nogal <w>kwallig</w> en glibberig aan.",
                            "target_lang_translations": {
                                "en": "The substance felt rather <w>gelatinous</w> and slippery."
                            }
                        },
                        {
                            "text": "Het zeewezen had een <w>kwallige</w> structuur die bijna doorzichtig was.",
                            "target_lang_translations": {
