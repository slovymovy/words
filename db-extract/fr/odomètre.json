                        "form": "odomètres"
                    },
                    {
                        "form_id": "38723617-053d-48e6-bb99-a731b92d8d6b",
                        "entry_id": "f479faf9-d505-3a39-9b71-10d215459ec7",
                        "tags": [],
                        "form": "hodomètre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                        "entry_id": "f479faf9-d505-3a39-9b71-10d215459ec7",
                        "glosses": [
                            "Appareil mécanique ou électronique mesurant les distances parcourues. On dit plus fréquemment podomètre quand il s’agit de marche à pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c43c36e9-3cfa-4fdb-a91b-38206ae71d92",
                                "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                                "text": "Ératosthène se tourne vers les bématistes, ces inlassables arpenteurs réputés mesurer les distances en comptant leurs pas — ou ceux de leurs chameaux, allez savoir. A moins qu’ils ne disposent déjà d’un odomètre, ce qui reste à démontrer pour un appareil supposément inventé à Rome vers l’an 15 av. J.-C."
                            },
                            {
                                "example_id": "70b25c9c-835e-4678-a66b-7f2104520d75",
                                "sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                                "text": "La position connue des eurobalises permet d’étalonner l’odomètre et de connaître son inexactitude."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3de429c0-e7de-4550-8f01-6973e6c44ded",
                        "source_entry_id": "f479faf9-d505-3a39-9b71-10d215459ec7",
                        "source_sense_id": "33938314-59ba-378d-8f2e-a56e20d13dd0",
                        "source_sense_description": "Appareil mesurant les distances parcourues",
