                ],
                "senses": [
                    {
                        "sense_id": "0632aff5-aff7-3d7e-9bbb-057e7839250f",
                        "entry_id": "91249d75-1e96-3906-bd00-a49aa4162d07",
                        "glosses": [
                            "błędne odczucie, będące skutkiem zniekształcenia wrażeń zmysłowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "915a39cd-b5f7-4a9e-a624-a35f828bbe08",
                                "sense_id": "0632aff5-aff7-3d7e-9bbb-057e7839250f",
                                "text": "Pierwszy raz w życiu jechała wspaniałym automobilem, toteż, mimo wstrząśnień nieuniknionych na obmurowaniach ścieków bocznej ulicy, miała złudzenie, iż uległa porwaniu do nieba."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "dad96cbb-14fd-356a-8dc3-f76a3a23b982",
                        "entry_id": "91249d75-1e96-3906-bd00-a49aa4162d07",
                        "glosses": [
                            "nierealne marzenie lub błędna i naiwna wiara w coś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dab57d6-4e9e-4dac-aa5a-66631a663d38",
                                "sense_id": "dad96cbb-14fd-356a-8dc3-f76a3a23b982",
                                "text": "Lekkie studia okazały się tylko złudzeniem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83c299f9-10b7-4307-a511-fff02a047693",
                        "source_entry_id": "91249d75-1e96-3906-bd00-a49aa4162d07",
                        "source_sense_id": "0632aff5-aff7-3d7e-9bbb-057e7839250f",
                        "target_lang_word": "illusion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illusion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "Anything that seems to be something that it is not."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3a5635-8004-4b5a-b502-78f5e9c4b120",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "We saw what looked like a tiger among the trees, but it was an illusion caused by the shadows of the branches."
                                            },
                                            {
                                                "example_id": "eb910563-fcd8-4937-b977-c8a6ea0fe405",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "Using artificial additives, scientists can create the illusion of fruit flavours in food."
                                            },
                                            {
                                                "example_id": "26133d74-a744-4879-bfbd-642f05e55509",
                                                "sense_id": "448bc3a2-85a6-3c8d-8039-bd750c23fafc",
                                                "text": "You realize the sun don't go down it's just an illusion caused by the world spinning round."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A misapprehension; a belief in something that is in fact not true."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a97ead-2363-4097-a53a-659db02e1dc2",
                                                "sense_id": "5153a0d3-f76d-3082-a3e2-0c8ece5c221a",
                                                "text": "Jane has this illusion that John is in love with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4d66cfc-17aa-3876-976f-e9d1100c9e72",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "A magician’s trick."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9fd934d-9a22-3943-81fb-5938b9275e4f",
                                        "entry_id": "5114866d-48f4-31e0-9109-200d2a4c3ed2",
                                        "glosses": [
                                            "The state of being deceived or misled."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d182a7b8-52f2-4f2c-b12a-ce555b603a04",
                        "source_entry_id": "91249d75-1e96-3906-bd00-a49aa4162d07",
                        "source_sense_id": "0632aff5-aff7-3d7e-9bbb-057e7839250f",
                        "target_lang_word": "illusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Fausse apparence matérielle ou morale qui, en nous faisant voir les choses autrement qu’elles ne sont, semble se jouer de nos sens ou de notre esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c4642b-2f81-4bd8-8cc4-a41df3a9a218",
                                                "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                                "text": "Ses deux douzaines de cheveux demeurés fidèles se tournaient, se contournaient et se recontournaient sur son crâne pour donner, à une portée de fusil, l’illusion d'un système pileux follement développé."
                                            },
                                            {
                                                "example_id": "1df15ee5-b30e-4f16-9c00-34c4a149c19a",
                                                "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                                "text": "[…], seuls quelques milliers d'oiseaux y ont établi leur domicile […]. Le guano, largement fabriqué par ces nombreux habitants, donne l'illusion de la neige."
                                            },
                                            {
                                                "example_id": "cc65d4c6-7936-4ef7-b6ee-4274095aac03",
                                                "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                                "text": "En aval de la mosquée, un troupeau de prostituées, commandées de service par le pacha, nous salua de grêles you-yous destinés à nous donner l’illusion d'une manifestation spontanée des femmes de Fez."
                                            },
                                            {
                                                "example_id": "eea1ba9e-7bac-4e8f-9b21-f328aaed8df4",
                                                "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                                "text": "Nous savons, nous, ce que vaut l’illusion de la souveraineté populaire, et ce que pèse un bulletin de vote, mais les indigènes, plus neufs, plus confiants que nous dans la parole écrite de nos livres, se consolent mal de la trahison de nos clercs."
                                            },
                                            {
                                                "example_id": "e8d9c92d-923f-4d73-9dc5-e4a33346b3a6",
                                                "sense_id": "26a4d95e-75a8-3e60-b1af-79fd6c403c51",
                                                "text": "D’ailleurs, les années d’effectif squelettique, où mes solistes faisaient office de chœur, je recherchais la présence des gros enfants : ils prenaient chacun la place de deux maigrelets et donnaient de loin l’illusion d'un régiment d'infanterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04498ad-8870-3ddb-8c73-cf291708354b",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Fausses apparences que l’on attribuait au démon ou à la magie."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9dba1b9-86b5-43ad-8aa3-8acfb122d788",
                                                "sense_id": "d04498ad-8870-3ddb-8c73-cf291708354b",
                                                "text": "Une illusion diabolique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4da04a-f10d-3b03-b566-c93e84ac8615",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Erreur des sens ou de l’esprit produite par ces fausses apparences."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4e7322-5fc0-46fe-a7f0-70533ca163e8",
                                                "sense_id": "8f4da04a-f10d-3b03-b566-c93e84ac8615",
                                                "text": "Quand on est dans un bateau en marche et que le rivage semble fuir, cette sensation est une illusion des sens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb362b1-1fbe-3e40-b29a-c4822882142f",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Erreur qui abuse l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c810df-c038-4489-947f-d5fce5f72ea8",
                                                "sense_id": "cfb362b1-1fbe-3e40-b29a-c4822882142f",
                                                "text": "La Foi qui sert de fondement à toutes les Religions n'est qu'un principe d’erreurs, d’illusions et d’impostures."
                                            },
                                            {
                                                "example_id": "fd1a6a0c-4866-4b3a-8cba-5a5d728c7874",
                                                "sense_id": "cfb362b1-1fbe-3e40-b29a-c4822882142f",
                                                "text": "En effet, une jeune fille a trop d'illusions, trop d'inexpérience, et le sexe est trop complice de son amour, pour qu'un jeune homme puisse en être flatté."
                                            },
                                            {
                                                "example_id": "408543de-f3ae-44a6-8e6f-4ab0457e27e8",
                                                "sense_id": "cfb362b1-1fbe-3e40-b29a-c4822882142f",
                                                "text": "Les illusions perdues sont des vérités trouvées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e753d0-d9ea-3427-bd6c-71dbf2154587",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Chimère, pensée ou imagination chimérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65162fcd-1418-4a8e-9bf0-9986877107bd",
                                                "sense_id": "f0e753d0-d9ea-3427-bd6c-71dbf2154587",
                                                "text": "Mon Dieu ! je quitterais la France avec moins de regrets si j’y laissais un homme aux yeux de qui je ne serais ni un demi-fripon, ni un dissipateur, ni un homme à illusions."
                                            },
                                            {
                                                "example_id": "4249a088-5440-4674-bf43-f5cbf83de990",
                                                "sense_id": "f0e753d0-d9ea-3427-bd6c-71dbf2154587",
                                                "text": "Les illusions de l’amour-propre, mégalomanie."
                                            },
                                            {
                                                "example_id": "2b2369de-1937-4f5d-a521-7fa68da8b3f3",
                                                "sense_id": "f0e753d0-d9ea-3427-bd6c-71dbf2154587",
                                                "text": "Il n’est aucun prix que nos congénères ne paieraient pour perpétuer l’illusion qu’ils ne sont pas seuls au monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51eed2f0-617f-3d02-b37c-f7eda22409d5",
                                        "entry_id": "9fba9f1f-c036-3196-b15c-99750c610b05",
                                        "glosses": [
                                            "Songe, fantôme qui flatte ou qui trouble l’imagination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016eb925-a64d-40c6-8329-daab4a56dacb",
                                                "sense_id": "51eed2f0-617f-3d02-b37c-f7eda22409d5",
                                                "text": "Le jour vint dissiper les illusions qui avaient enchanté mon sommeil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
