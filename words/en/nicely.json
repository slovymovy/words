{
    "word_family": [
        "nice",
        "niceness",
        "nicety"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4dc27262-758c-3286-8b32-c49bf7960468",
                    "sense_definition": "In a pleasant, agreeable, or satisfactory manner.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasant_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new sofa fits <w>nicely</w> in the living room.",
                            "target_lang_translations": {
                                "ru": "Новый диван <w>отлично</w> вписывается в гостиную.",
                                "zh": "新沙发放在客厅里<w>很合适</w>。"
                            }
                        },
                        {
                            "text": "The children played <w>nicely</w> together in the garden.",
                            "target_lang_translations": {
                                "ru": "Дети <w>хорошо</w> играли вместе в саду.",
                                "zh": "孩子们在花园里<w>友好地</w>一起玩耍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pleasantly",
                        "agreeably",
                        "satisfactorily",
                        "well"
                    ],
                    "antonyms": [
                        "badly",
                        "unpleasantly",
                        "poorly"
                    ],
                    "common_phrases": [
                        "play nicely",
                        "ask nicely",
                        "fit nicely",
                        "do nicely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приятным, приемлемым или удовлетворительным образом.",
                        "zh": "以令人愉悦、合意或令人满意的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хорошо",
                                "target_lang_sense_clarification": "удовлетворительно, как следует"
                            },
                            {
                                "target_lang_word": "мило",
                                "target_lang_sense_clarification": "приятно, симпатично"
                            },
                            {
                                "target_lang_word": "вежливо",
                                "target_lang_sense_clarification": "учтиво, любезно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很好",
                                "target_lang_sense_clarification": "令人满意地"
                            },
                            {
                                "target_lang_word": "友好地",
                                "target_lang_sense_clarification": "以友善的方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f77559a-f86c-3821-b2c7-ac9a0d17302c",
                    "sense_definition": "With precision, fine detail, or careful judgement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "precise_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flavors in this sauce are <w>nicely</w> balanced.",
                            "target_lang_translations": {
                                "ru": "Вкусы в этом соусе <w>тонко</w> сбалансированы.",
                                "zh": "这款酱汁的味道<w>巧妙地</w>平衡在一起。"
                            }
                        },
                        {
                            "text": "It was a <w>nicely</w> crafted argument that convinced the committee.",
                            "target_lang_translations": {
                                "ru": "Это был <w>искусно</w> выстроенный аргумент, который убедил комитет.",
                                "zh": "这是一个<w>精细</w>构思的论点，说服了委员会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "precisely",
                        "finely",
                        "accurately",
                        "delicately"
                    ],
                    "antonyms": [
                        "roughly",
                        "clumsily"
                    ],
                    "common_phrases": [
                        "nicely balanced",
                        "nicely adjusted",
                        "nicely calculated"
                    ],
                    "target_lang_definitions": {
                        "ru": "С точностью, тонкими деталями или тщательным суждением.",
                        "zh": "以精确、细腻或审慎的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонко",
                                "target_lang_sense_clarification": "изящно, с нюансами"
                            },
                            {
                                "target_lang_word": "искусно",
                                "target_lang_sense_clarification": "мастерски"
                            },
                            {
                                "target_lang_word": "прекрасно",
                                "target_lang_sense_clarification": "отлично, превосходно (о качестве)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巧妙地",
                                "target_lang_sense_clarification": "精巧地，有技巧地"
                            },
                            {
                                "target_lang_word": "精细地",
                                "target_lang_sense_clarification": "细致地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c725bb73-a647-31c6-a632-3b8c7f8e80b5",
                    "sense_definition": "In a fastidious, fussy, or extremely careful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fastidious_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>nicely</w> picked his way through the muddy street to avoid soiling his boots.",
                            "target_lang_translations": {
                                "ru": "Он <w>аккуратно</w> пробирался по грязной улице, чтобы не испачкать ботинки.",
                                "zh": "他<w>小心翼翼地</w>走过泥泞的街道，以免弄脏靴子。"
                            }
                        },
                        {
                            "text": "The old manuscript was <w>nicely</w> preserved in the archives.",
                            "target_lang_translations": {
                                "ru": "Старая рукопись <w>хорошо</w> сохранилась в архивах.",
                                "zh": "这份旧手稿在档案馆里被<w>妥善地</w>保存着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fastidiously",
                        "carefully"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage implying fastidiousness or excessive care is largely archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привередливо, суетливо или чрезвычайно осторожно.",
                        "zh": "以挑剔、拘泥细节或极其谨慎的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщательно",
                                "target_lang_sense_clarification": "с большим вниманием к деталям"
                            },
                            {
                                "target_lang_word": "аккуратно",
                                "target_lang_sense_clarification": "осторожно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小心翼翼地",
                                "target_lang_sense_clarification": "极其谨慎地"
                            },
                            {
                                "target_lang_word": "仔细地",
                                "target_lang_sense_clarification": "非常认真地"
                            }
                        ]
                    }
                }
            ]
        },
        {
