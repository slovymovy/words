            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "357524b7-5358-3e47-884e-4c06b10de13a",
                    "sense_definition": "Carrying a heavy load or filled to capacity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_load",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The truck was heavily <w>loaded</w> with supplies for the long journey.",
                            "target_lang_translations": {
                                "ru": "Грузовик был тяжело <w>нагружен</w> припасами для долгого путешествия.",
                                "zh": "卡车<w>满载</w>着长途旅行所需的沉重补给品。"
                            }
                        },
                        {
                            "text": "Her schedule is fully <w>loaded</w> with meetings and appointments today.",
                            "target_lang_translations": {
                                "ru": "Её расписание на сегодня полностью <w>загружено</w> встречами и делами.",
                                "zh": "她今天的日程表被会议和预约<w>排满</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "packed",
                        "laden",
                        "stuffed",
                        "crammed",
                        "full"
                    ],
                    "antonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "fully loaded",
                        "loaded with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несущий тяжелый груз или заполненный до отказа.",
                        "zh": "承载重物或装满东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагруженный",
                                "target_lang_sense_clarification": "несущий груз"
                            },
                            {
                                "target_lang_word": "загруженный",
                                "target_lang_sense_clarification": "заполненный (о транспорте или расписании)"
                            },
                            {
                                "target_lang_word": "гружёный",
                                "target_lang_sense_clarification": "содержащий груз (обычно о транспорте)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装满的",
                                "target_lang_sense_clarification": "指容器或空间已满"
                            },
                            {
                                "target_lang_word": "负重的",
                                "target_lang_sense_clarification": "指承载着重物"
                            }
