        "nl-extract.jsonl": [
            {
                "entry_id": "320e62a9-e57f-3d46-890e-6cb8a0929cb6",
                "word": "zelfvertrouwen",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f62da29-f0fb-364b-a9dc-e3423e047266",
                        "entry_id": "320e62a9-e57f-3d46-890e-6cb8a0929cb6",
                        "glosses": [
                            "geloof in eigen vermogen, kunde of kracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6d6fd7-de70-489a-b52b-3f63e9ad6531",
                                "sense_id": "5f62da29-f0fb-364b-a9dc-e3423e047266",
                                "text": "Zijn zelfvertrouwen kreeg daardoor een flinke deuk."
                            },
                            {
                                "example_id": "4c5278bc-f3f5-4e62-a0be-7baafc6b59df",
                                "sense_id": "5f62da29-f0fb-364b-a9dc-e3423e047266",
                                "text": "De dagen daarna sliep ik steeds alleen, en langzaam maar zeker groeide mijn zelfvertrouwen."
                            },
                            {
                                "example_id": "ea0cd394-32a2-4939-aec7-e7cd66befb33",
                                "sense_id": "5f62da29-f0fb-364b-a9dc-e3423e047266",
                                "text": "Jezus! Waren ze plotseling allemaal miljonair? Wat verder de behoefte aan cashflow betrof, vervolgde directeur Solveig de presentatie met onverstoorbaar zelfvertrouwen, werden natuurlijk alle huurinkomsten overgeheveld naar rentekosten en herstelwerkzaamheden om het bedrijf niet te belasten met onnodige belastinguitgaven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bcf4d2d-31fa-4aec-8d88-7b67dfc74304",
                        "source_entry_id": "320e62a9-e57f-3d46-890e-6cb8a0929cb6",
                        "source_sense_id": "5f62da29-f0fb-364b-a9dc-e3423e047266",
                        "source_sense_description": "geloof in eigen vermogen, kunde of kracht",
                        "target_lang_word": "Selbstvertrauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstvertrauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                        "entry_id": "90e21709-50fb-3c3d-8275-0de3ffa357ff",
                                        "glosses": [
                                            "Charaktereigenschaft, sich seiner Kräfte und Fähigkeiten sicher sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7db4695-44a1-4874-a941-7e43d7508337",
                                                "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                                "text": "Du kannst ruhig mit mehr Selbstvertrauen an die Sache 'rangehen."
                                            },
                                            {
                                                "example_id": "7c6dfdec-9369-423a-83b7-8c2502dafdba",
                                                "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                                "text": "„Das stärkt Pücklers Selbstvertrauen, obwohl oder weil es die vorhandenen Fehler einbezieht.“"
                                            },
                                            {
                                                "example_id": "82168847-f1d0-42fb-9ba5-d789f0bfb3b8",
                                                "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                                "text": "„Aber mit jeder Trainingsfahrt kam ein wenig Selbstvertrauen zurück, das Gefühl für den Ski und auch die Kampfeslust.“"
                                            },
                                            {
                                                "example_id": "e2e6178b-4b56-4d36-ac44-af8d7932c3ed",
                                                "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                                "text": "„Es war ihnen gelungen, das Selbstvertrauen der Bevölkerung zu erschüttern, aber sie hatten es nicht gebrochen.“"
                                            },
                                            {
                                                "example_id": "ea79527b-5910-4ec9-a54a-ed89e2fca50c",
                                                "sense_id": "018ebbe6-a73b-300b-b4f6-0b60a0a2f251",
                                                "text": "„In ihren Dessous und den hohen Stiefeln strahlten sie ein Selbstvertrauen und eine Arroganz aus, über die auch Sisi eines Tages verfügen würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a85687a3-2e9b-4328-8310-392de6630799",
