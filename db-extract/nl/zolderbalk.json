                ],
                "senses": [
                    {
                        "sense_id": "5fc45431-fcc8-38ce-9fec-bf35a816977c",
                        "entry_id": "17713e05-f5df-39a3-bf08-97fba77887c4",
                        "glosses": [
                            "balk die zichtbaar is op zolder en waarop de dakbedekking rust"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b8296a3-ab2e-4f7e-bd0f-3f1824fb08a0",
                                "sense_id": "5fc45431-fcc8-38ce-9fec-bf35a816977c",
                                "text": "Dorien ontdekt een aantal ingekraste tekens in een van de zolderbalken. Met Roel en Taco probeert zij de rebus op te lossen. Dat lukt heel snel. En dat is jammer. De schrijver had hier de spanning wat meer moeten laten oplopen, zodat de lezers de uitdaging krijgen om mee te zoeken naar de oplossing. Nu wordt het al vrij snel voorgeschoteld."
                            },
                            {
                                "example_id": "4688ec7a-f208-4e88-af4e-224565bc03cb",
                                "sense_id": "5fc45431-fcc8-38ce-9fec-bf35a816977c",
                                "text": "Een Duits kruis in een zolderbalk is een van de eerste vondsten tijdens het archeologisch onderzoek dat deze week in het vroegere Kamp Westerbork van start ging."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac3ce442-7886-467c-b1b3-78c0f9c46fe4",
                        "source_entry_id": "17713e05-f5df-39a3-bf08-97fba77887c4",
                        "source_sense_id": "5fc45431-fcc8-38ce-9fec-bf35a816977c",
                        "source_sense_description": "balk die zichtbaar is op zolder en waarop de dakbedekking rust",
                        "target_lang_word": "bearer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bearer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e820cd15-c558-3658-b8a0-162ff8f7dbde",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "One who, or that which, bears, sustains, or carries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea209110-b726-42d7-89a9-3926e7c54770",
                                                "sense_id": "e820cd15-c558-3658-b8a0-162ff8f7dbde",
                                                "text": "And he [Solomon] set threescore and ten thousand of them [the foreigners living in Israel] to be bearers of burdens,"
                                            },
                                            {
                                                "example_id": "1f884e7a-cfdc-47c9-ad5a-6eb651f9ed2b",
                                                "sense_id": "e820cd15-c558-3658-b8a0-162ff8f7dbde",
                                                "text": "Forgive the Bearer of unhappy news:\nYour alter’d Father openly pursues\nYour ruine;"
                                            },
                                            {
                                                "example_id": "30a4250c-ffdd-468e-988f-a02d0c0162e5",
                                                "sense_id": "e820cd15-c558-3658-b8a0-162ff8f7dbde",
                                                "text": "The slightest manifestation of sympathy or justice toward a person of color, was denounced as abolitionism; and the name of abolitionist, subjected its bearer to frightful liabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f5df4a8-5179-3185-a8fb-fd2e991a2a53",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "Someone who helps carry the coffin or a dead body during a funeral procession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e2481f-09c8-4fc8-859b-7795a6382e0c",
                                                "sense_id": "2f5df4a8-5179-3185-a8fb-fd2e991a2a53",
                                                "text": "Nay, quoth he, on his swooning bed outstretch’d,\nIf I may not carry, sure Ile ne’re be fetch’d,\nBut vow though the cross Doctors all stood hearers,\nFor one Carrier put down to make six bearers."
                                            },
                                            {
                                                "example_id": "21a94ff8-ad15-41a9-b016-ffc59f680c0c",
                                                "sense_id": "2f5df4a8-5179-3185-a8fb-fd2e991a2a53",
                                                "text": "[…] the bare coffin having been screwed down, was hoisted on the shoulders of the bearers, and carried into the street."
                                            },
                                            {
                                                "example_id": "7e3d6193-b937-4060-8c38-23e553599c23",
                                                "sense_id": "2f5df4a8-5179-3185-a8fb-fd2e991a2a53",
                                                "text": "The deep shadows of the porch swallowed up priest, corpse and bearers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43e77fa2-f20a-38c6-86e9-907ed025223d",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "One who possesses a cheque, bond, or other notes promising payment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f4dc401-056c-4f88-92a0-b02cb24dc467",
                                                "sense_id": "43e77fa2-f20a-38c6-86e9-907ed025223d",
                                                "text": "I promise to pay the bearer on demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "966e9a2c-f438-3e7f-a202-996d21b206d2",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A person employed or engaged to carry equipment on a safari, expedition, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "054ab532-e517-3ff5-9e6b-cd4147d246ac",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A person employed to carry a palanquin or litter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18914503-1463-4426-bf7b-b77fad197c6c",
                                                "sense_id": "054ab532-e517-3ff5-9e6b-cd4147d246ac",
                                                "text": "Within an hour of our finally deciding to start five litters were brought up to the door of the cave, each accompanied by four regular bearers and two spare hands, also a band of about fifty armed Amahagger, who were to form the escort and carry the baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f0ca66e-d140-3f7d-92d4-b4935ee6ee01",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A domestic servant in charge of household goods and clothing; a valet."
                                        ],
                                        "tags": [
                                            "India",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc614e2d-870b-4c96-b137-c9bb71706a69",
                                                "sense_id": "4f0ca66e-d140-3f7d-92d4-b4935ee6ee01",
                                                "text": "The bar of the watch-guard worked through the buttonhole, and the watch—Platte's watch—slid quietly on to the carpet; where the bearer found it next morning and kept it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64f67f9a-91c5-3925-9a00-5ade4ab749a9",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A waiter in a hotel or restaurant."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d479380-47a2-36a2-9e48-f3f465b28242",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A tree or plant yielding fruit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de37148-1eac-423e-a0b8-e6eb41cca6c5",
                                                "sense_id": "9d479380-47a2-36a2-9e48-f3f465b28242",
                                                "text": "a good bearer"
                                            },
                                            {
                                                "example_id": "526cf49f-df6c-46ab-91f7-c6e356daa908",
                                                "sense_id": "9d479380-47a2-36a2-9e48-f3f465b28242",
                                                "text": "In the common mode of pruning, this species of vine is no great bearer; but managed as it is here, it produces wonderfully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "Someone who delivers a letter or message on behalf of another (especially as referred to in the letter or message)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dd3e670-dd2c-419e-b181-afd6eec182c3",
                                                "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                                "text": "[…] Wilt thou know\nTh’ effect of what I wrote? […]\nAn earnest conjuration from the King,\nAs England was his faithful tributary, […]\nThat, on the view and knowing of these contents,\nWithout debatement further, more or less,\nHe should the bearers put to sudden death,"
                                            },
                                            {
                                                "example_id": "8700fd50-e7e4-43c1-98ea-0ab042376738",
                                                "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                                "text": "P. S. If you’d send your pipes by the Bearer[…], I would put them in order, and play some Melancholy tunes, […]"
                                            },
                                            {
                                                "example_id": "0d455ee3-1a1d-41c8-8607-575a666596d2",
                                                "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                                "text": "1784, Samuel Johnson, letter cited in James Boswell, The Life of Samuel Johnson, London: Charles Dilly, Volume 2, p. 487,\nSir, The bearer is my godson, whom I take the liberty of recommending to your kindness […]"
                                            },
                                            {
                                                "example_id": "f8769a03-baa0-4f0f-b08c-0a3519c5ecfa",
                                                "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                                "text": "The message was brought, and Winterborne sent the bearer back to say that he begged the lady’s pardon, but that he could not do as she requested;"
                                            },
                                            {
                                                "example_id": "9b306106-9bd2-48c0-b676-de1dd1c1368b",
                                                "sense_id": "5bbc514b-cd12-34bf-b346-1bc38c0fd4a4",
                                                "text": "[…] he gave him a note to Mr. Harmon, one of the head managers of Durham’s—\n“The bearer, Jurgis Rudkus, is a particular friend of mine, and I would like you to find him a good place […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ef47423-33c1-32aa-a4e1-12c8cade1a19",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A strip of reglet or other furniture to bear off the impression from a blank page."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9155009-e1f9-3e56-9745-d972872502ac",
                                        "entry_id": "07144298-1d41-386e-b5e6-6697e55ee5b6",
                                        "glosses": [
                                            "A type or type-high piece of metal interspersed in blank parts to support the plate when it is shaved."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
