                ],
                "senses": [
                    {
                        "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                        "entry_id": "aca7a961-3616-396f-9944-46b4c8cd32e8",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "697c0216-fa2b-4e1d-96ea-505fdd897074",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Frau Feiwel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "35f34725-bc77-483a-8279-8f45141ea468",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Herr Feiwel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4163a3ac-3261-4818-a696-19eecede5cc9",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Die Feiwels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "59bcd847-8c10-4728-bbfc-702fa7a84909",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Der Feiwel trägt nie die Schals, die die Feiwel ihm strickt."
                            },
                            {
                                "example_id": "2b3e3935-35e1-43a3-86c8-af69d75ecf4b",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Feiwel kommt, geht der Herr Feiwel.“"
                            },
                            {
                                "example_id": "aa05afb6-41a0-4166-ac2a-5a71b2dac9d3",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Feiwel kommt und geht."
                            },
                            {
                                "example_id": "27f79b9c-a9bc-48eb-9bdb-e875fe29b1f5",
                                "sense_id": "b06ac633-b5ce-35f1-bcae-4ff7e7a345bb",
                                "text": "Feiwels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
