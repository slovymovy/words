                ],
                "senses": [
                    {
                        "sense_id": "1e0642ba-698e-39bb-91a4-546fee1e3f5c",
                        "entry_id": "bc46be3f-efe3-31f0-9bd6-ff16e28f2ba9",
                        "glosses": [
                            "Personne en pleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f6c5fb-d6cc-4921-9520-21cff2236517",
                                "sense_id": "1e0642ba-698e-39bb-91a4-546fee1e3f5c",
                                "text": "Mon cher lecteur, pleurez avec ces éplorés, si cela peut vous faire plaisir, mais soyez bien persuadé que ces pleureurs ne sont pas les représentants de l'esprit ni du caractère liégeois."
                            },
                            {
                                "example_id": "6014826c-0e8c-4910-8fc7-764db20bfb74",
                                "sense_id": "1e0642ba-698e-39bb-91a4-546fee1e3f5c",
                                "text": "Quand on dit à un éploré d’allumer le feu, si sa salive ne l’éteint pas, ses larmes l’éteindront."
                            }
                        ]
                    }
                ],
