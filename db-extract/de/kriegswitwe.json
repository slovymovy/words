                "senses": [
                    {
                        "sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                        "entry_id": "6c7d69dc-95b8-3318-b1b4-781ee51b35fa",
                        "glosses": [
                            "Frau, deren Ehemann im Krieg gestorben ist, die durch einen Krieg zur Witwe wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10cc57d6-a948-46c1-822c-35e9fedc5e4f",
                                "sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                                "text": "„Es stand zu befürchten, dass die 25 000 Familien der Kriegswitwen, die auf ihre Arbeit und die Gaben der UNO angewiesen waren, verhungern würden.“"
                            },
                            {
                                "example_id": "8a1d558e-7081-4a8c-a0af-f504bfd296ac",
                                "sense_id": "edb85925-68f0-37cc-bf9f-c65872c635b1",
                                "text": "„Meine ehemaligen Schulfreundinnen sind alle verheiratet und haben Kinder. Zwei von ihnen sind Kriegswitwen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
