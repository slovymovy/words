                "senses": [
                    {
                        "sense_id": "d05320a0-d425-335e-9632-56640a9a4b13",
                        "entry_id": "763b0269-c934-3ec6-8e07-3f8790c0743c",
                        "glosses": [
                            "To make or become small; diminish"
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1781cfc7-07c2-44af-a337-c4f95f8b24c8",
                                "sense_id": "d05320a0-d425-335e-9632-56640a9a4b13",
                                "text": "And Ywain looked down in his wheeling, and there was the city of Dœdala very far beneath him, and it smallened and darkened continually, so that save for the moonlight upon the towers he had soon seen it no more."
                            },
                            {
                                "example_id": "57b0a495-2001-4f38-8ff6-67df5ddd0ff9",
                                "sense_id": "d05320a0-d425-335e-9632-56640a9a4b13",
                                "text": "Do you feel you will be smallening yourself, Norman, if you examine your childhood?"
                            },
                            {
                                "example_id": "b0718cf9-36ab-4767-b945-101720d07f99",
                                "sense_id": "d05320a0-d425-335e-9632-56640a9a4b13",
                                "text": "In fact, I did—when I wrote Roget's story. Which begs the question, was the tale really diminished—lessened, minimized, or smallened in some way—when I started to lean on that linguistic crutch?"
                            }
                        ]
                    }
                ],
