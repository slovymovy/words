                "senses": [
                    {
                        "sense_id": "67904b8b-5196-31ea-b990-d45687aa5bea",
                        "entry_id": "89db053a-bd0d-3e9d-936a-8a9e95f4465a",
                        "glosses": [
                            "Rendre muet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1598e035-f5b3-4fb8-a7c9-44809119db1a",
                                "sense_id": "67904b8b-5196-31ea-b990-d45687aa5bea",
                                "text": "Les grammairiens se sont passé le mot pendant des siècles pour « muettiser » les femmes, estime Céline Labrosse, auteur de Pour une grammaire non sexiste. Il faut donc « dégenriser », dit-elle, abolir la prépondérance du masculin."
                            },
                            {
                                "example_id": "bf8495f9-67bf-40f3-a83a-82346efdc11a",
                                "sense_id": "67904b8b-5196-31ea-b990-d45687aa5bea",
                                "text": "Un inclus que l’on tente par ailleurs souvent de « muettiser » en lui contestant le droit de parole sur ce qu’il n’est pas."
                            }
                        ]
                    }
