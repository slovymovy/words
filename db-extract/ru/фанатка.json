                                    {
                                        "sense_id": "4cceeb72-b062-3c1d-bc5a-c1ee9fd2057e",
                                        "entry_id": "5d49ca61-1500-315e-b058-d0c0f545cf69",
                                        "glosses": [
                                            "A person who is fond of something or someone, especially an admirer of a performer or aficionado of a sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d531ad7-493e-4331-acc0-76f6f4d3cf6b",
                                                "sense_id": "4cceeb72-b062-3c1d-bc5a-c1ee9fd2057e",
                                                "text": "I am a big fan of libraries."
                                            },
                                            {
                                                "example_id": "e7baf167-d1fb-45c8-9c73-fa97f04f648f",
                                                "sense_id": "4cceeb72-b062-3c1d-bc5a-c1ee9fd2057e",
                                                "text": "I am a big fan of cricket."
                                            }
                                        ]
