{
    "word_family": [
        "curious",
        "curiosity"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c03dff05-c72e-347f-a64e-ae699f2636a0",
                    "sense_definition": "In a way that shows a desire to learn or know more about something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children peeped <w>curiously</w> into the attic room.",
                            "target_lang_translations": {
                                "ru": "Дети <w>с любопытством</w> заглянули в комнату на чердаке."
                            }
                        },
                        {
                            "text": "She looked <w>curiously</w> at the strange object on the table.",
                            "target_lang_translations": {
                                "ru": "Она <w>с любопытством</w> посмотрела на странный предмет на столе."
                            }
                        }
                    ],
                    "synonyms": [
                        "inquisitively"
                    ],
                    "target_lang_definitions": {
                        "ru": "С интересом, проявляя желание узнать или выяснить что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любопытно",
                                "target_lang_sense_clarification": "с любопытством"
                            },
                            {
                                "target_lang_word": "с любопытством",
                                "target_lang_sense_clarification": "проявляя живой интерес"
                            },
                            {
                                "target_lang_word": "с интересом",
                                "target_lang_sense_clarification": "внимательно, заинтересованно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa203a28-a304-33d0-bef7-152db58a3a8a",
                    "sense_definition": "In a strange, unusual, or unexpected way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Curiously</w>, when I arrived home, the front door was standing ajar.",
                            "target_lang_translations": {
                                "ru": "<w>Как ни странно</w>, когда я пришел домой, входная дверь была приоткрыта."
                            }
                        },
                        {
                            "text": "The old house felt <w>curiously</w> empty after they moved out.",
                            "target_lang_translations": {
                                "ru": "После их переезда старый дом казался <w>странно</w> пустым."
                            }
                        }
                    ],
                    "synonyms": [
                        "strangely",
                        "oddly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Странно, необычно или неожиданно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "странно",
                                "target_lang_sense_clarification": "необычным образом"
                            },
                            {
                                "target_lang_word": "как ни странно",
                                "target_lang_sense_clarification": "вводное слово в значении удивительно"
                            },
                            {
                                "target_lang_word": "необычно",
                                "target_lang_sense_clarification": "непривычно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
