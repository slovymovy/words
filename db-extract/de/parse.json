                ],
                "senses": [
                    {
                        "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                        "entry_id": "40434b6f-bf56-339b-adfc-28f15412d5b3",
                        "glosses": [
                            "Anhänger des Parsismus, einer auf dem Zoroastrismus basierenden monotheistischen Religion, die vornehmlich von einer ethnischen und religiösen Gemeinschaft in Indien ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "404fc070-bb15-42f8-8509-129e29cb4a0b",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "Die Unabhängigkeitsbewegung wurde zu Anfang getragen von einer Oberschicht aus Hindus und Parsen, die in Bombay 1885 den Indian National Congress gründeten, den Vorläufer der bis heute das politische Leben beherrschenden Kongresspartei."
                            },
                            {
                                "example_id": "fbeeab02-5eb4-4a93-a460-4b067fa06ece",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "Das englisch wirkendste Hotel, die Luxusadresse \"Taj Mahal Palace\" gleich hinter dem Gateway, hat ein Bombayer Parse bauen lassen, nachdem ihm in einer britischen Herberge der Zugang verweigert wurde."
                            },
                            {
                                "example_id": "cf6960f6-fb36-486f-bc08-d0372a8714cc",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "So wurden viele Parsen zu Pionieren der Industrialisierung: im Schiffsbau, in der Stahlindustrie, im Bankenwesen und im Filmbusiness, das mit dem Markenzeichen Bollywood heute von Cineasten auch hierzulande als schrille Alternative zu Hollywood entdeckt wird."
                            },
                            {
                                "example_id": "b62c04c3-14de-44a6-b0ba-b668317ad5eb",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "Inzwischen lief der Elephant, von dem Parsen mit größter Sicherheit geleitet, rasch durch den noch dunkeln Wald."
                            },
                            {
                                "example_id": "cd8ad0f3-c22f-46ac-b00b-2c0525ac7f41",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "Wenn Sie morgen Parse werden wollen und sich im Panchayat in Bombay melden, dann dankt man Ihnen für Ihr freundliches Interesse, bedauert aber."
                            },
                            {
                                "example_id": "1a4547cc-1464-44a4-8368-a3c464fd7e2f",
                                "sense_id": "12b0ad43-4a79-3ed9-a5a8-ce79a1dcb232",
                                "text": "„Weitere religiöse Minderheiten bilden die Ahmadi, Sikhs, Hindus, Christen sowie vereinzelt Buddhisten und Parsen, die nach der Teilung Britisch-Indiens in Pakistan geblieben sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
