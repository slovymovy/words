                            {
                                "example_id": "0d348773-6416-4214-ab05-e1df4dc61934",
                                "sense_id": "49ba9d0a-ead6-326f-bffc-dd4d5484aaf9",
                                "text": "„Die Deutsche Bank muss einen Milliardenverlust verbuchen: Im dritten Quartal summierte sich das Minus auf 6,013 Mrd. Euro, wie das größte deutsche Kreditinstitut am Donnerstag in Frankfurt am Main bekanntgab.“"
                            },
                            {
                                "example_id": "913bc2a9-009c-4fb1-adff-e7457321c9d3",
                                "sense_id": "49ba9d0a-ead6-326f-bffc-dd4d5484aaf9",
                                "text": "„Die BayernLB will nach einem Milliardenverlust im vergangenen Jahr mit allen Mitteln um die Rückzahlung ihrer Geldforderungen aus Österreich kämpfen.“"
                            }
                        ],
