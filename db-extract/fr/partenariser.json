                "senses": [
                    {
                        "sense_id": "5fb644b0-21de-3bd4-8ad3-ea74c7309bb2",
                        "entry_id": "e6aa9c4c-c484-39e6-bbaa-144a3f30496e",
                        "glosses": [
                            "Donner un caractère de partenaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "377aca6b-842e-4881-a5bc-f49136541c96",
                                "sense_id": "5fb644b0-21de-3bd4-8ad3-ea74c7309bb2",
                                "text": "Organiser, Planifier, Confirmer, Partenariser…"
                            },
                            {
                                "example_id": "161fd009-8571-4cb7-b034-33e33897f8e3",
                                "sense_id": "5fb644b0-21de-3bd4-8ad3-ea74c7309bb2",
                                "text": "Contribuer à partenariser les trois familles de l'ES : mutuelles, coopératives et associations."
                            },
                            {
                                "example_id": "a0e49330-5284-452c-95ca-069bf1c25e8b",
                                "sense_id": "5fb644b0-21de-3bd4-8ad3-ea74c7309bb2",
                                "text": "En réalité, cette volonté de « partenariser » le malade n’est pas nouvelle."
                            },
                            {
                                "example_id": "35c3e59e-7434-4871-b454-8f64ea86a1f1",
                                "sense_id": "5fb644b0-21de-3bd4-8ad3-ea74c7309bb2",
                                "text": "A quoi sert de se « partenariser » ou de se « conjointiser » lorsque la durée de vie d'un couple dure moins qu'un smartphone made in China et que le taux des séparations et des divorces dépasse largement celui des batteries à changer ?"
                            }
                        ]
                    }
