                    "sense_id": "44cf7d42-f107-3593-8f26-4065b42a4856",
                    "sense_definition": "Форма родительного или винительного падежа отрицательного местоимения <w>никто</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pronoun_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я сегодня в парке не встретил <w>никого</w>.",
                            "target_lang_translations": {
                                "en": "I didn't meet <w>anyone</w> in the park today."
                            }
                        },
                        {
                            "text": "В этой комнате сейчас <w>никого</w> нет.",
                            "target_lang_translations": {
                                "en": "There is <w>nobody</w> in this room right now."
                            }
