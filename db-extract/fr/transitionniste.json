                        "glosses": [
                            "Personne qui veut agir pour la transition écologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72838b10-6950-42b7-97bd-e8c49a53af38",
                                "sense_id": "4bbe0ba5-e709-3878-ab73-b5e9847687a6",
                                "text": "Nous sommes des transitionnistes hyperactifs. Le « Virtuosa » fonctionne au fuel mais ce n’est pas le même qu’avant. Il est équipé de pots catalytiques qui transforment 97 % des oxydes d’azote."
                            },
                            {
                                "example_id": "71ca1a00-5e18-4c57-8dc2-164d5bc14797",
                                "sense_id": "4bbe0ba5-e709-3878-ab73-b5e9847687a6",
                                "text": "Ici encore, règne un fanatisme d’autant plus dangereux qu’il est armé. Il est aux antipodes de la mentalité des transitionnistes."
                            }
                        ]
                    }
