                "senses": [
                    {
                        "sense_id": "9045d451-2c15-37c5-a972-3627fb1d9884",
                        "entry_id": "4d2d242b-eb90-34ee-b1cd-1a70f79a54e1",
                        "glosses": [
                            "Bezeichnung für den französischen Adel"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6f04e94f-973b-35bc-a925-04a7122795bd",
                        "entry_id": "4d2d242b-eb90-34ee-b1cd-1a70f79a54e1",
                        "glosses": [
                            "vornehme Art, sich zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4cd15c-8bd3-46fe-a39f-083852e06660",
                                "sense_id": "6f04e94f-973b-35bc-a925-04a7122795bd",
                                "text": "„Mit stoischer Noblesse stemmt sich Woolfs Romanfigur gegen die Wirren ihrer Zeit.“"
                            },
                            {
                                "example_id": "5baade9b-fffd-497e-9f15-fdb65110655a",
                                "sense_id": "6f04e94f-973b-35bc-a925-04a7122795bd",
                                "text": "„Ich verließ meinen flinken Neapolitaner dennoch im Hochgefühl des verwöhnten Gastes, denn er verrichtete seine Arbeit mit jener heiteren romanischen Noblesse, die in seiner Heimat selbst Putzfrauen den Hauch des Königlichen verleiht.“"
                            },
                            {
                                "example_id": "b58cf3c1-2448-486b-8a4d-0ceb89555bc9",
                                "sense_id": "6f04e94f-973b-35bc-a925-04a7122795bd",
                                "text": "„So verteilte sie ihre Gunst an die verschiedenen Verehrer je nach deren Noblesse und Großzügigkeit.“"
                            },
                            {
                                "example_id": "7e6caed5-fa4c-4016-a719-12024f3124df",
                                "sense_id": "6f04e94f-973b-35bc-a925-04a7122795bd",
                                "text": "„Haxthausen erhoffte sich von dem Besuch seiner Nichte, deren dezente Noblesse auf seine junge Frau abfärben zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fe669512-3e4c-3c84-bd41-b808e16f785a",
                        "entry_id": "4d2d242b-eb90-34ee-b1cd-1a70f79a54e1",
                        "glosses": [
                            "vornehme Erscheinung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87d5bcf4-56d4-4b66-a60b-86f60a4a96bf",
                                "sense_id": "fe669512-3e4c-3c84-bd41-b808e16f785a",
                                "text": "„Haxthausen erhoffte sich von dem Besuch seiner Nichte, deren dezente Noblesse auf seine junge Frau abfärben zu sehen.“"
                            },
                            {
                                "example_id": "496dce1c-490c-417e-9b24-13a49693da7f",
                                "sense_id": "fe669512-3e4c-3c84-bd41-b808e16f785a",
                                "text": "„Ezras Noblesse zu Ehren aßen und tranken wir schweigend weiter.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
