{
    "word_family": [
        "elliptic",
        "elliptical",
        "elliptically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                    "sense_definition": "A punctuation mark consisting of three dots (...), used to indicate omitted words or a trailing off of thought.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "punctuation_and_grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author used an <w>ellipsis</w> to show that parts of the quote had been removed.",
                            "target_lang_translations": {
                                "zh": "作者使用了<w>省略号</w>来表示引文中有部分内容被删除了。"
                            }
                        },
                        {
                            "text": "Her text message ended with an <w>ellipsis</w>, leaving me wondering what she meant.",
                            "target_lang_translations": {
                                "zh": "她的短信以<w>省略号</w>结尾，让我捉摸不透她到底是什么意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dot dot dot",
                        "suspension dots",
                        "suspension points"
                    ],
                    "common_phrases": [
                        "trailing ellipsis",
                        "insert an ellipsis"
                    ],
                    "target_lang_definitions": {
                        "zh": "省略号，指由几个点（通常为三个或六个点）组成的标点符号，用来表示文字的省略或语意的未尽。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "省略号",
                                "target_lang_sense_clarification": "标点符号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d55e460-36e9-3e95-b838-e68742767733",
                    "sense_definition": "The omission of one or more words from a sentence that are understood from the context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punctuation_and_grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grammatical <w>ellipsis</w> is common in casual speech when speakers want to avoid repeating words.",
                            "target_lang_translations": {
                                "zh": "语法上的<w>省略</w>在日常口语中很常见，说话者借此来避免词语重复。"
                            }
                        },
                        {
                            "text": "In the sentence 'John bought apples and Mary oranges', the verb is left out by <w>ellipsis</w>.",
                            "target_lang_translations": {
                                "zh": "在句子“约翰买了苹果，玛丽买了橙子”中，动词通过<w>省略</w>省去了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grammatical ellipsis"
                    ],
                    "target_lang_definitions": {
                        "zh": "（语法中的）省略，指在句子中略去可以根据语境推知的词语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "省略",
                                "target_lang_sense_clarification": "语法上的词语省略"
                            },
                            {
                                "target_lang_word": "省略法",
                                "target_lang_sense_clarification": "修辞或语法手法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                    "sense_definition": "The intentional omission of scenes or periods of time in a film or narrative that the audience can easily infer.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "narrative_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director made clever use of narrative <w>ellipsis</w> to jump twenty years ahead in the story.",
                            "target_lang_translations": {
                                "zh": "导演巧妙运用叙事中的<w>跳跃</w>手法，让故事直接跨越了二十年。"
                            }
                        },
                        {
                            "text": "Through dramatic <w>ellipsis</w>, the film skips unnecessary details and focuses purely on key events.",
                            "target_lang_translations": {
                                "zh": "通过戏剧性的<w>省略</w>，影片跳过了不必要的细节，完全专注于关键事件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narrative ellipsis"
                    ],
                    "target_lang_definitions": {
                        "zh": "（电影或叙事中的）时空跳跃、内容省略，指有意略去观众易于推断的场景或时间段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跳跃",
                                "target_lang_sense_clarification": "叙事或时间上的跳跃"
                            },
                            {
                                "target_lang_word": "省略",
                                "target_lang_sense_clarification": "叙事细节的省略"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2ab923c-841e-3ec5-83f9-fa8f981c656f",
                    "sense_definition": "An <w>ellipse</w>; a regular oval shape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early geometric texts often used the term <w>ellipsis</w> where modern writers use ellipse.",
                            "target_lang_translations": {
                                "zh": "早期的几何著作常在现代作者使用 ellipse 的地方使用 <w>ellipsis</w> 一词来表示椭圆。"
                            }
                        },
                        {
                            "text": "The planet follows an orbit shaped like an elongated <w>ellipsis</w> around the distant star.",
                            "target_lang_translations": {
                                "zh": "这颗行星沿着环绕遥远恒星的扁长<w>椭圆</w>轨道运行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic variant of ellipse"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "椭圆（ellipse 的古旧用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "椭圆",
                                "target_lang_sense_clarification": "几何图形，同 ellipse（旧）"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}