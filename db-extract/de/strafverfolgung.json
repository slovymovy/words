                    {
                        "sense_id": "a7a199a3-c6ca-3296-8c2d-d9161881d052",
                        "entry_id": "da87ec62-46e6-32d8-8712-c7d0286a77a5",
                        "glosses": [
                            "durch die Staatsanwaltschaft veranlasste Ermittlungen, wenn der Verdacht auf eine Straftat besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6303e06-a4c7-4ae2-9aa8-978c5085399c",
                                "sense_id": "a7a199a3-c6ca-3296-8c2d-d9161881d052",
                                "text": "„Die Erfüllung des Rituals dispensierte von der Strafverfolgung, denn durch den Vollzug wurden die Bande mit der Götterwelt geknüpft und erneuert.“"
                            },
                            {
                                "example_id": "2ed9954d-7dc8-42a2-9dcd-2fa6854d926e",
                                "sense_id": "a7a199a3-c6ca-3296-8c2d-d9161881d052",
                                "text": "„Die Strafverfolgung wird oft allein schon dadurch ad absurdum geführt, dass Zeugen in der Verhandlung unter plötzlichen Erinnerungslücken leiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
