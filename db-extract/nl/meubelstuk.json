                        "glosses": [
                            "voorwerp dat behoort tot de inrichting van een kamer, zoals een bank, stoel, tafel, kast, bed etc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6cfbe54-2a8d-486a-9e08-7970d43e4b36",
