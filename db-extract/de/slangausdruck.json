                        "sense_id": "35f2260a-db21-3cbc-8dd4-649328962ab2",
                        "entry_id": "268738bb-4de2-3b5e-8ccb-1a1d48ffa263",
                        "glosses": [
                            "sprachlicher Ausdruck, der zu einem Slang gehört, aus einem Slang stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c1a6fa0-7f64-4105-8205-a463ad6a422f",
                                "sense_id": "35f2260a-db21-3cbc-8dd4-649328962ab2",
                                "text": "„Sehr wahrscheinlich sind das Slangausdrücke, Kurzformen längerer, traditioneller Namen, aber damit kenne ich mich nicht aus.“"
                            },
                            {
                                "example_id": "94da6478-3544-493e-9787-c83067a003de",
                                "sense_id": "35f2260a-db21-3cbc-8dd4-649328962ab2",
                                "text": "„Du kannst es Farlopa nennen, mit dem gängigsten Slangausdruck, Calcetin, Socke, oder Cama, das Bett, in dem du träumst, oder Tierra, der Boden unter deinen Füßen.“"
                            }
                        ],
