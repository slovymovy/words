                            {
                                "example_id": "c87494f1-e580-4165-bc09-574bcc74111e",
                                "sense_id": "00273ebe-b0ab-3924-afe1-252bbb86b131",
                                "text": "Hou je?"
                            },
                            {
                                "example_id": "0351a234-c946-41f9-8d84-6e888b9a721c",
                                "sense_id": "00273ebe-b0ab-3924-afe1-252bbb86b131",
                                "text": "Ik hou nu eenmaal van rituelen en heb door de jaren heen het een en ander overgenomen van de kerken die ik heb bezocht."
                            },
                            {
                                "example_id": "f1b1d03b-f5ea-4bbd-8d6a-0c42418e1397",
                                "sense_id": "00273ebe-b0ab-3924-afe1-252bbb86b131",
                                "text": "Ik hou van je, Lot. Geweldig. De angst houdt van mij. Ik hou ook van jou, Lobbes. Ik wil het schrijven. Ik wil het hem écht schrijven. Want de waarheid schrijven is altijd fijn."
                            }
                        ]
                    }
