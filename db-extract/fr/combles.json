            {
                "entry_id": "1bb2c91f-c94d-3c43-95a3-c82012820b29",
                "word": "combles",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                        "entry_id": "1bb2c91f-c94d-3c43-95a3-c82012820b29",
                        "glosses": [
                            "Logements situés immédiatement sous le toit d’un édifice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c3e9d49-3bbb-4b0e-8784-e03089972d03",
                                "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                                "text": "Je suis logé sous les combles de cet immeuble depuis bientôt trois mois."
                            },
                            {
                                "example_id": "a5164773-d063-4258-83b3-e6630ee95a81",
                                "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                                "text": "Recueilli par un de ses parents, le comte de Valqueyras, il vivait en parasite, mangeant à la table du comte, habitant un étroit logement situé sous les combles de son hôtel."
                            },
                            {
                                "example_id": "ef10e7e8-f1e3-4d77-a353-f0a451964b71",
                                "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                                "text": "Ce coup de vent qui balayait sans cesse le couloir, la fatigue des treize heures de travail qui les jetait au lit sans un souffle, achevaient de changer les combles en une auberge traversée par la maussaderie éreintée d’une débandade de voyageurs."
                            },
                            {
                                "example_id": "d914b74e-6d7f-4da8-882e-9c292af557c7",
                                "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                                "text": "Elle aperçut sur la pente opposée les maisons d’un gros village que dominaient les combles élevés d’un grand château émergeant d’un bois."
                            },
                            {
                                "example_id": "33042b3f-df3b-4cd2-a2cf-e99f0f0068f3",
                                "sense_id": "bc7db6bb-f77c-318d-b2ad-7e044c99d341",
                                "text": "Cora devra passer plusieurs mois dissimulée dans les combles de leur maison, à retenir son souffle pour que Fiona, la bonne, ne découvre pas sa présence."
                            }
                        ]
                    },
                    {
                        "sense_id": "644ed7b6-1912-3cd7-957c-b241bc4c3292",
                        "entry_id": "1bb2c91f-c94d-3c43-95a3-c82012820b29",
                        "glosses": [
                            "Pluriel de comble."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2d5403d-3e2a-495d-ad59-e42418e1d085",
