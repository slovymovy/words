                            {
                                "target_word": "hazel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                        "entry_id": "40272fa8-f3c0-327e-8dfd-4e0a7f5a7a00",
                                        "glosses": [
                                            "Of a greenish-brown colour. (often used to refer to eye colour)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57b2f16-9233-47bc-af04-309577696f7d",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "As she grew up and her hazel eyes became hazeler and her dark hair darker and her white skin whiter, and her form a sigh on every boy’s lips, she concentrated on one dream."
                                            },
                                            {
                                                "example_id": "b1b86268-d735-4206-92f8-d113daaa3319",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "The shrewd eyes, more hazel than her son’s but with the same straight brows, were fixed on Clary’s face."
                                            },
                                            {
                                                "example_id": "36a65b2a-8266-4b12-933e-26a8900f5867",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "SAGE: Don’t my eyes look hazeler? (or: periwinkler) / CHLO: (as GARTH) Yes. / SAGE: You said you loved my hazel eyes. (or: periwinkle) Don’t you love them more hazely? (or: periwinkly)"
                                            },
                                            {
                                                "example_id": "3adc1d92-165f-49db-a567-9f237ca71810",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "The drummer’s eyes took the small woman in slowly, starting with her face, down to her feet and then back up into the hazelest eyes she’d ever seen."
                                            },
                                            {
                                                "example_id": "ba1a95b4-bbd9-40d1-ad52-51b8cfe60e35",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "What’s that line on “Hazel Eyes”: “I’ve never seen a set of eyes more hazeler”? [Justin Hawkins:] “I’ve never seen a set of eyes more hazelerer.”"
                                            },
                                            {
                                                "example_id": "91f2d3f1-f673-4074-a841-5fe9e6b739dc",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "Doolittle had the hazelest eyeballs, the winsomest spinal pelt."
                                            },
                                            {
                                                "example_id": "daef960c-667d-497b-b7d1-0332bb618610",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "His eyes were somewhere indefinite between green and hazel. Sometimes appearing hazeler or greener depending on how the light flickered on them."
                                            },
                                            {
                                                "example_id": "87093ba2-85f4-47dd-abfb-e86db979ecac",
                                                "sense_id": "49c2f8da-0273-3fc2-a1fa-f0d2dcaba2dc",
                                                "text": "And now I should probably say something, but that would involve words, and WHAT EVEN ARE WORDS, and he’s looking at me with the hazelest eyes and the softest, most upturned mouth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
