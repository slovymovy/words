                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66fc00a6-a55a-4622-8981-de67da49db1e",
                        "source_entry_id": "1a1cfe54-2887-3fa7-b3cd-6f6422678aeb",
                        "source_sense_id": "2d552452-da7a-31e8-a08b-9175911bfa35",
                        "target_lang_word": "Genetiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genetiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                        "entry_id": "f8ef3de7-be2b-3dc6-b4aa-20dbb0543221",
                                        "glosses": [
                                            "jemand, der sich wissenschaftlich mit der Genetik beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edb042b4-4629-437b-8d83-e1935aef7094",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Ein linker Genetiker explodierte daraufhin: Es sei unerhört und obszön, dass im Jahre 2000 so viele Menschen auf unserem Planeten hungers sterben müssen.“"
                                            },
                                            {
                                                "example_id": "c188df13-3d14-4e7b-9cd7-daa0eca8fabe",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Als Vortragende haben sich unter anderem Wikipedia-Mitgründer Larry Sanger, die NASA-Weltraumforscherin Kerry McGuire und der österreichische Genetiker Markus Hengstschläger sowie die ehemalige nigerianische Bildungsministerin und Gründerin von Transparency International, Obiageli Ezekwesili, angekündigt.“"
                                            },
                                            {
                                                "example_id": "684fd466-54b6-45e1-8eaa-65bccd291f92",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Davis, ein Genetiker, der früher biochemische Forschungen betrieb, wirft die Bettdecke beiseite und eilt über eine gewundene Holztreppe hinunter ins Erdgeschoss.“"
                                            },
                                            {
                                                "example_id": "058a1099-f85b-4480-a654-7210242f906e",
                                                "sense_id": "b15d1602-a4ff-3bc7-996d-6a3716fbe9b1",
                                                "text": "„Außerdem befassen sich noch die Althistoriker mit den Kelten, die die Berichte antiker Autoren auswerten, sowie Genetiker und Anthropologen, die versuchen, aus Knochen und anderen biologischen Materialien Befunde abzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdfb538c-529e-4941-9915-a9e6706035e9",
                        "source_entry_id": "1a1cfe54-2887-3fa7-b3cd-6f6422678aeb",
