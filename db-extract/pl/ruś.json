                                        "glosses": [
                                            "The territory between Central and Eastern Europe inhabited by Rusyns, on the slopes of the Carpathian Mountains in parts of Ukraine, Poland and Slovakia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d48d90b0-19c7-346b-8957-5e52e221aed0",
                                        "entry_id": "2b937197-5899-32cf-a7d5-3be3b7c080a6",
                                        "glosses": [
                                            "Lands inhabited by Ukrainians (Ruthenians) of the former Austrian Empire kingdom of Galicia (1772–1918), corresponding to parts of Western Ukraine."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe6d488f-f72d-348f-be1b-d11f86577202",
                                        "entry_id": "2b937197-5899-32cf-a7d5-3be3b7c080a6",
                                        "glosses": [
                                            "Western portions of East Slavic lands, including the principalities of Galicia-Volhynia and Kyiv, which united with Lithuania and Poland (14th c–1772), corresponding to what is now Ukraine and Belarus."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
