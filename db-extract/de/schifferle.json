                "senses": [
                    {
                        "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                        "entry_id": "4cdd733a-1f2e-3957-a611-db298b900a62",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f663c8e-6056-451a-abd7-fb849f440503",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Frau Schifferle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4cac6ea-ece7-4144-a8e9-75f3c16e1d57",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Herr Schifferle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8bd8b4e6-45c5-41fd-9e2c-adaac38530e8",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Die Schifferles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cbaf043b-9110-4acb-8f97-2401be67ca7b",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Der Schifferle trägt nie die Schals, die die Schifferle ihm strickt."
                            },
                            {
                                "example_id": "5a7e9a9b-2757-40e3-a1e5-3379f39131e9",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schifferle kommt, geht der Herr Schifferle.“"
                            },
                            {
                                "example_id": "55a38a28-4577-4e0e-a9f2-4564d2a5377f",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Schifferle kommt und geht."
                            },
                            {
                                "example_id": "398e5b44-020e-44e5-9dc2-8f305a9246d7",
                                "sense_id": "84cb43f9-d03b-386d-b013-93d221a7e3d1",
                                "text": "Schifferles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
