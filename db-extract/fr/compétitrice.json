                "senses": [
                    {
                        "sense_id": "b08322c4-5903-3115-ab89-e59c384ac85a",
                        "entry_id": "3d4674b3-5de6-3f0d-a003-2ed83824654f",
                        "glosses": [
                            "Celle qui a des objectifs ou des besoins identiques à d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bc8734-9dc2-44e7-98d9-fe31903296ba",
                                "sense_id": "b08322c4-5903-3115-ab89-e59c384ac85a",
                                "text": "Nous avons eu des guerres civiles; mais mon avènement et la mort de ma compétitrice ayant amené la fusion des partis, j’ai la satisfaction de vous annoncer qu’elles ne se renouvelleront plus."
                            },
                            {
                                "example_id": "d8f8a858-219e-4232-a9c3-b7048e494a9b",
                                "sense_id": "b08322c4-5903-3115-ab89-e59c384ac85a",
                                "text": "À moins que ce rôle soit dévolu à cette compétitrice massive, main à la hanche, robe retroussée sur un jupon écarlate, seule tache vive sous le ciel pastel."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a201c9c-cb27-310a-9033-877560328331",
                        "entry_id": "3d4674b3-5de6-3f0d-a003-2ed83824654f",
                        "glosses": [
                            "Celle qui participe à une compétition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43602aa2-7bd3-41fc-94fe-16f45e8f6209",
                                "sense_id": "0a201c9c-cb27-310a-9033-877560328331",
                                "text": "Gaby Irvoas confiait il y a quelques jours : « Cette saison s’est fort bien terminée pour nos jeunes savateuses et savateurs. Depuis plusieurs années, l’école de savate de la MJC présente des compétiteurs et compétitrices jusqu'en finale du championnat de France."
                            },
                            {
                                "example_id": "ef9b9407-98ca-4f7a-82fe-901767993275",
                                "sense_id": "0a201c9c-cb27-310a-9033-877560328331",
                                "text": "Passionnée d’athlétisme, Maëlle est une grande compétitrice."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e31f47d-d7f4-3745-9f65-b1eb334b197f",
                        "entry_id": "3d4674b3-5de6-3f0d-a003-2ed83824654f",
                        "glosses": [
                            "Concurrente dans le domaine végétal, animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b665e248-517b-4817-8722-b2c304057f42",
                                "sense_id": "6e31f47d-d7f4-3745-9f65-b1eb334b197f",
                                "text": "[La renouée possède] des composés chimiques particulièrement intéressants synthétisés par cet alien végétal : de quoi la défendre contre les pathogènes et devenir une compétitrice redoutable pour les plantes qui l’entourent."
                            }
                        ]
                    }
                ],
                "translations": [
