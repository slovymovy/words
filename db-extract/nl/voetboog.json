                    {
                        "sense_id": "7946bab9-3855-3ca1-adf0-2208188b0bf0",
                        "entry_id": "c5ba08c3-a61a-36bf-8466-e6105bb472a1",
                        "glosses": [
                            "de boog van de middenvoet die loopt van de hiel tot aan de bal van de voet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "676ceb7e-7188-4f8e-bacc-bf8f27412ee7",
                                "sense_id": "7946bab9-3855-3ca1-adf0-2208188b0bf0",
                                "text": "De wondere wereld van de voetfetisj blijft haar verbazen. ,,Soms willen ze enkel maar een specifiek detail zien, zoals de voetboog of de hielen. En dan heb je nog de slaven of slavinnen die virtueel aan mijn voeten willen liggen.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "6c0d5189-9f65-31b1-abd7-447ac4a3f5e4",
                        "entry_id": "c5ba08c3-a61a-36bf-8466-e6105bb472a1",
                        "glosses": [
                            "soort kruisboog die bij het spannen met de voet wordt vastgezet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4eb221d-4393-4b15-95e1-07c41abb203f",
                                "sense_id": "6c0d5189-9f65-31b1-abd7-447ac4a3f5e4",
                                "text": "Vlak na de inpoldering is de grond vermoedelijk in bezit van kloosterorden. Daarna oefent het Sebastiaansgilde er met zijn hand- en voetbogen. Later doet het perceel dienst als boomgaard, weide, akkerland en lusthof."
                            }
                        ]
                    }
