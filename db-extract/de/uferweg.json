                        "glosses": [
                            "Weg am Ufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6935a107-bba6-4f73-b1a3-a74b8a1de5a1",
                                "sense_id": "100bf40d-5310-3fb7-a37a-91b06e159c71",
                                "text": "„Thomas verließ den Uferweg und balancierte über eine fußschmale Natursteinbuhne hinweg, die weiter ins Meer auf eine kleine Felseninsel hinauslief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
