                    },
                    {
                        "translation_id": "4d1ae8cb-5333-48e5-971d-d46e1f7dd0c1",
                        "source_entry_id": "63cca2aa-5ede-3f27-abc0-490a5905cc40",
                        "target_lang_word": "kumulativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kumulativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1264347-c158-3ab7-a845-af730464f55f",
                                        "entry_id": "e9be6712-5f94-3a57-bf3b-6f6079dd9c91",
                                        "glosses": [
                                            "in Form einer Kumulation, auf eine Kumulation bezogen (= sich anhäufend, aufsummierend, steigernd)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55bf1895-fc7e-43e5-b673-9bd1099ee16b",
                                                "sense_id": "c1264347-c158-3ab7-a845-af730464f55f",
                                                "text": "„Bei kumulativen Anknüpfungen finden auf dieselbe Rechtsfrage mehrere Rechtsordnungen gleichzeitig Anwendung.“"
                                            },
                                            {
                                                "example_id": "120ef4d8-95d1-4e4a-809f-9505e4889e43",
                                                "sense_id": "c1264347-c158-3ab7-a845-af730464f55f",
                                                "text": "„In einem Zeitraum von 30 Jahren entspricht ein Wachstum von 1 % pro Jahr einem kumulativen Wachstum von mehr als 35 %.“"
                                            },
                                            {
                                                "example_id": "767bfdc1-8eac-4170-a30c-6573bef4b187",
                                                "sense_id": "c1264347-c158-3ab7-a845-af730464f55f",
                                                "text": "„Legt man dem potenziellen Anleger jedoch eine kumulative Wahrscheinlichkeitsverteilung vor, wird seine Präferenz für Investments mit rechtsschiefer Verteilung (Lotto, Not leidende Wertpapiere etc.) intensiviert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
