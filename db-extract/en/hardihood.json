                                        "glosses": [
                                            "zdolność do przeciwstawienia się; brak wrażliwości"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "120a4ba6-f655-4819-bf7d-d194a688b99c",
                                                "sense_id": "34177b97-e398-32cf-a92f-ac291e474245",
                                                "text": "Nadaje to włóknom keratynowym odporność na zerwanie i czynniki środowiskowe, zapewniając ich giętkość i elastyczność, zaś stwardnienie – przy bardzo dużej ilości mostków dwusiarczkowych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "63d8e1d6-4455-38f7-a5f8-26af8cff3313",
                                        "entry_id": "eb559b13-2941-3483-843e-40bb69fd0d0b",
                                        "glosses": [
                                            "zdolność do czynnej i biernej obrony organizmu przed patogenami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4863b5f-04d9-46ed-8f62-2cfef0eb93c9",
                                                "sense_id": "63d8e1d6-4455-38f7-a5f8-26af8cff3313",
                                                "text": "Jedną z najważniejszych witamin wspomagających odporność jest wit. A występująca m.in. w marchewce i jabłkach."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
