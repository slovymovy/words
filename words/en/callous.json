{
    "word_family": [
        "callus"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c85ed0c-ee4a-30f9-81e8-a92734e90d3e",
                    "sense_definition": "Emotionally hardened and indifferent to the suffering or feelings of others.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so <w>callous</w> that she could criticize a patient for being sick.",
                            "target_lang_translations": {
                                "nl": "Ze was zo <w>ongevoelig</w> dat ze een patiënt kon bekritiseren omdat hij ziek was."
                            }
                        },
                        {
                            "text": "The judge made a <w>callous</w> remark about the contestant's failed performance.",
                            "target_lang_translations": {
                                "nl": "De rechter maakte een <w>harteloze</w> opmerking over het mislukte optreden van de deelnemer."
                            }
                        }
                    ],
                    "synonyms": [
                        "heartless",
                        "insensitive",
                        "hardhearted"
                    ],
                    "common_phrases": [
                        "callous disregard",
                        "callous indifference"
                    ],
                    "target_lang_definitions": {
                        "nl": "Emotioneel verhard en onverschillig tegenover het lijden of de gevoelens van anderen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ongevoelig",
                                "target_lang_sense_clarification": "onaangedaan of onbewogen door andermans leed"
                            },
                            {
                                "target_lang_word": "harteloos",
                                "target_lang_sense_clarification": "zonder enig medeleven of empathie"
                            },
                            {
                                "target_lang_word": "afgestompt",
                                "target_lang_sense_clarification": "niet langer ontvankelijk voor emoties of andermans pijn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c868ff7-7f06-38dc-adbd-dda8557c5027",
                    "sense_definition": "Having or relating to hardened skin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist developed <w>callous</w> skin on his fingertips from years of practice.",
                            "target_lang_translations": {
                                "nl": "De gitarist kreeg door jarenlang oefenen een <w>eeltige</w> huid op zijn vingertoppen."
                            }
                        },
                        {
                            "text": "Manual labor often results in <w>callous</w> patches on the palms of the hands.",
                            "target_lang_translations": {
                                "nl": "Handarbeid resulteert vaak in <w>eeltige</w> plekken op de handpalmen."
                            }
                        }
                    ],
                    "synonyms": [
                        "calloused",
                        "hardened"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op of voorzien van verharde huid (eelt)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "eeltig",
                                "target_lang_sense_clarification": "bedekt met of bestaand uit eelt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0643622e-f2a8-36eb-8897-3e12709604b6",
                    "sense_definition": "An alternative form of <w>callus</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He developed thick <w>callouses</w> on his feet from walking barefoot.",
                            "target_lang_translations": {
                                "nl": "Hij ontwikkelde dik <w>eelt</w> op zijn voeten door op blote voeten te lopen."
                            }
                        },
                        {
                            "text": "The constant friction caused painful <w>callouses</w> to form on her heels.",
                            "target_lang_translations": {
                                "nl": "Door de constante wrijving vormde zich pijnlijk <w>eelt</w> op haar hielen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een verharde plek op de huid door wrijving of druk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "eelt",
                                "target_lang_sense_clarification": "de verharde huid zelf"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5aae06ee-097b-3d50-a6e1-db362aabadf0",
                    "sense_definition": "An alternative form of <w>callus</w>.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of rowing will <w>callouse</w> your hands.",
                            "target_lang_translations": {
                                "nl": "Door jarenlang roeien zul je <w>eelt op je handen krijgen</w>."
                            }
                        },
                        {
                            "text": "The heavy work began to <w>callouse</w> his skin.",
                            "target_lang_translations": {
                                "nl": "Het zware werk begon zijn huid <w>eeltig te maken</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het vormen van eelt op de huid door herhaalde wrijving."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "eelt vormen",
                                "target_lang_sense_clarification": "het proces waarbij de huid dikker en harder wordt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}