                        "glosses": [
                            "von außen durchgeführter, gezielter Angriff auf ein Computernetzwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a47f9c-1a89-4962-bc77-2ffb7aed7a66",
                                "sense_id": "a5fe87f2-0ac2-3672-ba94-9676f0d94521",
                                "text": "„Bei der Mitte Mai bekannt gewordenen Cyberattacke auf das Computernetzwerk des deutschen Bundestags handelt es sich nach Angaben der Grünen um einen \"hochkarätigen Angriff von geheimdienstlicher Qualität\".“"
                            }
                        ],
