                        "sense_id": "91990881-b8fc-3319-ad49-8b84b1523b67",
                        "entry_id": "1322fd34-4019-3ed8-802f-652145cfb305",
                        "glosses": [
                            "Sorte de bâton en forme de matraque utilisée comme arme de jet."
                        ],
                        "tags": [
                            "Maroc"
                        ],
                        "examples": [
                            {
                                "example_id": "fdff0f60-62df-4d07-96ef-ce6733f2ff1b",
                                "sense_id": "91990881-b8fc-3319-ad49-8b84b1523b67",
                                "text": "Le lièvre est très commun. Les Bédouins le chassent de préférence à cheval, avec ou sans chiens et armés de la zerouata, bâton, court terminé par un renflement à l'une de ses extrémités, qu’ils savent lancer avec beaucoup d’adresse."
                            },
                            {
                                "example_id": "52d302d3-21b4-4b40-82a9-a7ad5c3f3f69",
                                "sense_id": "91990881-b8fc-3319-ad49-8b84b1523b67",
                                "text": "Il les aurait gardées les bouteilles. Assurément personne ne se serait aventuré à pénétrer dans sa réserve sans qu’il ne bondisse aussitôt sur le gredin une zerouata à la main."
                            }
                        ]
                    }
