                                        "entry_id": "09510996-ecc5-3ab1-a300-700f72e29020",
                                        "glosses": [
                                            "One of several pipes that carry resources to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d999271c-994a-4a51-aa5c-27e349a4ada4",
                                                "sense_id": "75a0edff-296c-3501-8fe4-dacbdde9af1d",
                                                "text": "There are gaps above head height where timber-effect ribs have yet to be fitted but from those already in place it is clear the final effect will be impressive. Service pipes above the ribs are black so that they appear invisible."
                                            }
                                        ]
                                    }
                                ]
