                                        "sense_id": "2ebf6fa1-13be-3ae2-89fb-92d2058ab3aa",
                                        "entry_id": "c568838e-f59e-3f7f-9ed1-0dfec6d6c7a1",
                                        "glosses": [
                                            "A chamberpot."
                                        ],
                                        "tags": [
                                            "Australia",
