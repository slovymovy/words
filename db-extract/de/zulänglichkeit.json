                                                "sense_id": "403106d2-3d50-3cbe-ad08-2040c1763b91",
                                                "text": "L’adéquation d’un employé avec sa tâche."
                                            },
                                            {
                                                "example_id": "910f4806-cb64-4bec-ab46-5ea0aff5615b",
                                                "sense_id": "403106d2-3d50-3cbe-ad08-2040c1763b91",
