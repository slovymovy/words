                    "sense_definition": "meervoud van <w>leen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "feodaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de middeleeuwen bestond het rijk uit verschillende <w>lenen</w> die door ridders werden bestuurd.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, the empire consisted of various <w>fiefs</w> ruled by knights.",
                                "ru": "В Средние века империя состояла из различных <w>ленов</w>, которыми управляли рыцари."
                            }
                        },
                        {
                            "text": "De koning verdeelde de veroverde gebieden als <w>lenen</w> onder zijn trouwe volgelingen.",
                            "target_lang_translations": {
                                "en": "The king distributed the conquered territories as <w>fiefs</w> among his loyal followers.",
                                "ru": "Король распределил завоеванные территории в качестве <w>феодов</w> между своими верными последователями."
                            }
                        }
                    ],
