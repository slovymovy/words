        "nl-extract.jsonl": [
            {
                "entry_id": "847a43ab-395b-3228-8c40-289d51e520e0",
                "word": "onkreukbaarheid",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a118d907-d39c-3875-ba5c-3b229c820607",
                        "entry_id": "847a43ab-395b-3228-8c40-289d51e520e0",
                        "glosses": [
                            "het heel eerlijk en betrouwbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d665a419-0a36-4b27-a4f5-1e1c45a7b0fc",
                                "sense_id": "a118d907-d39c-3875-ba5c-3b229c820607",
                                "text": "Stepan Arkadjevitsj'vrienden en kennissen hielden niet alleen van hem om zijn goedhartige, vrolijke aard en zijn volstrekte onkreukbaarheid, maar er was in zijn montere, knappe verschijning, in zijn glinsterende ogen, zijn zwarte wenkbrauwen en donkere haar, in het blank en rood van zijn gelaat iets bijzonder innemends, iets dat alle mensen die hem ontmoetten, een plezierig gevoel van opgewektheid gaf."
                            },
                            {
                                "example_id": "867cb1f1-fe7b-4f87-bdb4-90cfe61b4888",
                                "sense_id": "a118d907-d39c-3875-ba5c-3b229c820607",
                                "text": "Met haar activistische achtergrond en imago van onkreukbaarheid was Marina Silva een van de weinige politici die kon profiteren van deze massabeweging. Ze profileert zich als alternatief voor de traditionele tweedeling: de linkse Arbeiderspartij van Rousseff versus de centrumrechtse PSDB. Ook presenteert Marina Silva zich als buitenstaander en kandidaat van verandering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb25557b-d2cc-4440-b049-cef375849889",
                        "source_entry_id": "847a43ab-395b-3228-8c40-289d51e520e0",
                        "source_sense_id": "a118d907-d39c-3875-ba5c-3b229c820607",
                        "source_sense_description": "het heel eerlijk en betrouwbaar zijn",
                        "target_lang_word": "uprightness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uprightness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The state of being honest, honourable, and moral."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15daf465-3697-4947-982c-49a826d328f8",
                                                "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                                "text": "You are responsible only for your own uprightness. See to that and all else will take care of itself. - Miles Williams Mathis"
                                            },
                                            {
                                                "example_id": "00214b5a-559f-4c07-b655-9e3193b2e93b",
                                                "sense_id": "a7971487-4c69-372d-bbe2-26f8f34c8b74",
                                                "text": "[S]uch as therefore ſhould not be adventured vpon vvithout mature and vnpartiall diſquiſition of the vprightneſſe of our affections therein, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b43369bd-24bf-31dc-a77d-eea4f7e45096",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The state of being erect or vertical."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51951c9e-1138-4be7-bc49-bfc36b8169f2",
                                                "sense_id": "b43369bd-24bf-31dc-a77d-eea4f7e45096",
                                                "text": "It is singular how forcibly this passage in my narrative brings to my mind a picture which used to be, some years ago, at a broker's—that charnel-house of the comforts and graces of life. It had been taken out of its frame, and leant in a dark and dusty corner against a perpendicular armchair, whose rigid uprightness seemed suited only to the parlour of a dentist, repose being the last idea it suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7991116-066d-30ee-836d-97cc2e6125c7",
                                        "entry_id": "8ff20714-ee9e-3716-864f-5748e5cdf687",
                                        "glosses": [
                                            "The product or result of being upright."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e19641f-7a83-4cb0-b4be-f434145c8003",
