    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3165a50-b53b-3027-866b-13fe47c20c39",
                    "sense_definition": "Совокупность обстоятельств, условия жизни или возникшая ситуация.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "situation_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После потери работы его финансовое <w>положение</w> стало очень сложным и нестабильным.",
                            "target_lang_translations": {
                                "en": "After losing his job, his financial <w>situation</w> became very difficult and unstable.",
                                "zh": "失业后，他的财务<w>处境</w>变得非常困难且不稳定。"
                            }
                        },
                        {
                            "text": "Мы должны найти выход из этого затруднительного <w>положения</w> как можно скорее.",
                            "target_lang_translations": {
                                "en": "We must find a way out of this difficult <w>situation</w> as soon as possible.",
                                "zh": "我们必须尽快找到摆脱这种困境的<w>办法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ситуация",
                        "обстановка",
                        "условия",
                        "состояние",
                        "статус"
                    ],
                    "common_phrases": [
                        "безвыходное положение",
                        "финансовое положение",
                        "исправить положение",
                        "войти в положение"
                    ],
                    "target_lang_definitions": {
                        "en": "A set of circumstances, living conditions, or a situation that has arisen.",
                        "zh": "指一系列情况、生活条件或已经出现的局面。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "situation",
                                "target_lang_sense_clarification": "general state of affairs"
                            },
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "financial or social condition"
                            },
                            {
                                "target_lang_word": "circumstances",
                                "target_lang_sense_clarification": "conditions of life"
                            },
                            {
                                "target_lang_word": "plight",
                                "target_lang_sense_clarification": "difficult or dangerous situation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情况",
                                "target_lang_sense_clarification": "一般事态"
                            },
                            {
                                "target_lang_word": "处境",
                                "target_lang_sense_clarification": "生活或财务状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2992be63-0f9c-328d-a3c4-22f0bc6b6b9d",
                    "sense_definition": "Местонахождение в пространстве, то, как и где расположен объект.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Географическое <w>положение</w> этого города делает его важным торговым центром региона.",
                            "target_lang_translations": {
                                "en": "The geographical <w>location</w> of this city makes it an important regional trade center.",
                                "zh": "这座城市的地理<w>位置</w>使其成为该地区重要的贸易中心。"
                            }
                        },
                        {
                            "text": "Туристы долго пытались определить своё точное <w>положение</w> на карте леса.",
                            "target_lang_translations": {
                                "en": "The tourists tried for a long time to determine their exact <w>position</w> on the forest map.",
                                "zh": "游客们花了很长时间试图在森林地图上确定自己的准确<w>方位</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "местоположение",
                        "место",
                        "координаты",
                        "позиция"
                    ],
                    "common_phrases": [
                        "географическое положение",
                        "определить положение",
                        "исходное положение"
                    ],
                    "target_lang_definitions": {
                        "en": "Location in space; how and where an object is situated.",
                        "zh": "空间中的位置；物体被放置的方式和地点。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "location",
                                "target_lang_sense_clarification": "geographical place"
                            },
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "place or arrangement in space"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "位置",
                                "target_lang_sense_clarification": "空间中的地点或排列"
                            },
                            {
                                "target_lang_word": "方位",
                                "target_lang_sense_clarification": "地理位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0d7cd9f-d6d5-3d37-adbf-4c8df69c65fd",
                    "sense_definition": "Место и роль человека в обществе, коллективе или служебной иерархии.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "situation_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Благодаря упорному труду он занял высокое <w>положение</w> в крупной международной компании.",
                            "target_lang_translations": {
                                "en": "Thanks to hard work, he occupied a high <w>position</w> in a large international company.",
                                "zh": "凭借努力工作，他在一家大型国际公司中占据了很高的<w>职位</w>。"
                            }
                        },
                        {
                            "text": "Её социальное <w>положение</w> обязывало посещать различные официальные мероприятия и приёмы.",
                            "target_lang_translations": {
                                "en": "Her social <w>status</w> obliged her to attend various official events and receptions.",
                                "zh": "她的社会<w>地位</w>要求她必须参加各种正式活动和招待会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "статус",
                        "должность",
                        "место"
                    ],
                    "common_phrases": [
                        "социальное положение",
                        "служебное положение",
                        "высокое положение",
                        "занимать положение"
                    ],
                    "target_lang_definitions": {
                        "en": "A person's place and role in society, a group, or a professional hierarchy.",
                        "zh": "一个人在社会、团体或职业等级制度中的地位和角色。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "job or rank"
                            },
                            {
                                "target_lang_word": "status",
                                "target_lang_sense_clarification": "social standing"
                            },
                            {
                                "target_lang_word": "standing",
                                "target_lang_sense_clarification": "reputation or rank"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "职位",
                                "target_lang_sense_clarification": "工作或职级"
                            },
                            {
                                "target_lang_word": "地位",
                                "target_lang_sense_clarification": "社会声望或等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e55c528e-ed57-343a-922d-b37c34cfc7c2",
                    "sense_definition": "Поза, способ размещения тела или его частей в пространстве.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач попросил пациента принять горизонтальное <w>положение</w> на медицинской кушетке для осмотра.",
                            "target_lang_translations": {
                                "en": "The doctor asked the patient to assume a horizontal <w>position</w> on the medical couch for examination.",
                                "zh": "医生要求病人躺在检查床上，保持水平<w>姿势</w>以便检查。"
                            }
                        },
                        {
                            "text": "Долгое <w>положение</w> сидя вредно для здоровья спины и требует регулярных перерывов.",
                            "target_lang_translations": {
                                "en": "A prolonged sitting <w>position</w> is harmful to back health and requires regular breaks.",
                                "zh": "长时间保持坐姿对背部健康有害，需要定期休息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "поза",
                        "конфигурация"
                    ],
                    "common_phrases": [
                        "положение сидя",
                        "положение лёжа",
                        "неудобное положение",
                        "принять положение"
                    ],
                    "target_lang_definitions": {
                        "en": "A pose; the way the body or its parts are arranged in space.",
                        "zh": "姿势；身体或其部位在空间中的排列方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "position",
                                "target_lang_sense_clarification": "physical arrangement of the body"
                            },
                            {
                                "target_lang_word": "posture",
                                "target_lang_sense_clarification": "way of holding the body"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "姿势",
                                "target_lang_sense_clarification": "身体的排列方式"
                            },
                            {
                                "target_lang_word": "体位",
                                "target_lang_sense_clarification": "医学或特定身体姿态"
                            }
                        ]
