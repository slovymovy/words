                        "glosses": [
                            "Féminin singulier de mahométan."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3fbcb772-a512-442e-8654-87fc4a670bae",
                                "sense_id": "b28a87ab-4c0a-333c-8442-3fba5bcef9af",
                                "text": "Ce noyau spirituel d’un mouvement qui court depuis les marches du Levant jusqu’à l’extrême Maghreb, le renouveau de la religion mahométane, de nos jours si frappant, le vient vigorer, corrigeant une crise de la foi par ailleurs sensible, due sans doute à la contagion de l’Occident, et dont s’inquiètent les maîtres de la pensée orthodoxe."
                            }
                        ]
                    }
                ],
