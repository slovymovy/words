                "senses": [
                    {
                        "sense_id": "ba09348f-1fe7-3222-a730-54a7bb4d8e05",
                        "entry_id": "fc28d39b-935e-3f26-9745-5116c7b1781b",
                        "glosses": [
                            "weiblicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81e4e5cd-4297-482b-9fb2-09de219a0f5e",
                                "sense_id": "ba09348f-1fe7-3222-a730-54a7bb4d8e05",
                                "text": "In Bonn befindet sich Eleonores Kleingartenparzelle."
                            },
                            {
                                "example_id": "9b786ab9-22f5-4a60-86fb-7369c73b211f",
                                "sense_id": "ba09348f-1fe7-3222-a730-54a7bb4d8e05",
                                "text": "„Er zeigte ihn Frau Ryder, erklärte ihr offen sein bisheriges Schweigen und hielt augenblicklich in einem jugendlich stylisirten Briefe an Eleonoren um deren Hand an.“"
                            },
                            {
                                "example_id": "9b49607b-7f7a-4e2f-9ee2-bbaa983fd5e0",
                                "sense_id": "ba09348f-1fe7-3222-a730-54a7bb4d8e05",
                                "text": "„Eleonorens Gemüth war zwar mit dem Gedanken an des Geliebten Untreue bereits vertraut geworden, aber diese Begeisterung für ihre siegreiche Nebenbuhlerin, welche der Brief athmete, überstieg alle ihre Erwartungen und erregte noch stärker ihren Zorn, als ihren Schmerz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e07729b1-87ce-4666-b13e-214cec0a1702",
                        "source_entry_id": "fc28d39b-935e-3f26-9745-5116c7b1781b",
                        "source_sense_id": "ba09348f-1fe7-3222-a730-54a7bb4d8e05",
                        "source_sense_description": "weiblicher Vorname",
                        "target_lang_word": "Eleanor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eleanor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                                        "entry_id": "df5b5f5a-a4bd-38be-a2d3-0f7b5d4e57a1",
                                        "glosses": [
                                            "A female given name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f47e3d-4ef1-4e6e-85e2-37c3a871dd09",
                                                "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                                                "text": "Nay, Eleanor, then must I chide outright: / Presumptuous dame! ill-nurtured Eleanor! / Art thou not second woman in the realm, / And the protector's wife, belov'd of him?"
                                            },
                                            {
                                                "example_id": "808e3b8d-2064-4753-8dfd-655689db90f2",
                                                "sense_id": "7d35bf22-cfc1-3c51-9fa2-9094788d8416",
                                                "text": "When you hear a young lady called Eleanor, you think of a tall, beautiful, interesting creature directly - the very opposite of me! With my personal appearance, Eleanor sounds ridiculous - and Neelie, as you yourself remarked, is just the thing. No! no! don't say any more - - -"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
