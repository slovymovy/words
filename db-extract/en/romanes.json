                        "cross_references": [
                            {
                                "target_word": "Romani",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a537aaf-1a7b-30b3-aadf-d422da032352",
                                        "entry_id": "2743749f-742b-354b-add3-f314fc28cdff",
                                        "glosses": [
                                            "stark dialektal zerklüftete indoarische Sprache der europäischen Roma mit Interferenzen aus den jeweiligen Kontaktsprachen (insbesondere dem Griechischen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be59c541-db95-427c-adba-26d94260ecd6",
                                                "sense_id": "6a537aaf-1a7b-30b3-aadf-d422da032352",
                                                "text": "„Romani ist eine balkanisierte neuind. Sprache, die sich seit mehr als 800 Jahren unabhängig von anderen indischen Sprachen entwickelt hat. Seit mindestens 700 Jahren wird Romani in Europa gesprochen. In Wortschatz und Lautsystem weist das Romani die meisten Parallelen zu den ind. Sprachen der zentralen Gruppe auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8222a850-0de4-4dbc-8ecb-55fe6def463f",
                        "source_entry_id": "a85ed8fa-d298-3e72-9c20-90789f4e30e5",
                        "source_sense_id": "8d4c7794-a8a6-3111-a1c4-5a756a755356",
                        "source_sense_description": "Romanes",
                        "target_lang_word": "Romanes",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Romanes",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                        "entry_id": "07887a8e-9246-399b-9fc8-b76cded1abc2",
                                        "glosses": [
                                            "stark dialektal zerklüftete indoarische Sprache der europäischen Roma mit Interferenzen aus den jeweiligen Kontaktsprachen (insbesondere dem Griechischen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9b720a-652f-4761-9822-5bbe2cc8f49b",
                                                "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                                "text": "Romanes ist eine in Deutschland anerkannte Minderheitensprache."
                                            },
                                            {
                                                "example_id": "3bd88ac0-8aff-44e0-84fb-2d371bf9fc39",
                                                "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                                "text": "„Die Verwandtschaft des Romanes mit den indischen Sprachen wurde zum ersten Mal von Johann Christian Christoph Rüdiger in seinem Aufsatz Von der Sprache und Herkunft der Zigeuner aus Indien (Rüdiger 1782) systematisch nachgewiesen.“"
                                            },
                                            {
                                                "example_id": "c6dd1333-b703-476c-ad2d-84cc0f2e3421",
                                                "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                                "text": "„Das Romanes – die Sprache der Sinti und Roma – gehört zu den weniger bekannten Sprachen in Europa, obwohl sich Schätzungen auf ungefähr 10–12 Millionen Angehörige der Minderheit belaufen. Das mag daran liegen, dass es keine bestimmte Region gibt, in der das Romanes vorherrschend ist oder als Amtssprache gebraucht wird.“"
                                            },
                                            {
                                                "example_id": "ffd9d322-69af-4477-ba94-7d83c04b819c",
                                                "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                                "text": "„Jede Sprache, die wie das Romanes ihren ursprünglichen Charakter bewahrt hat, stellt aus ihrer Sicht ein erhebliches kulturelles Kapital dar.“"
                                            },
                                            {
                                                "example_id": "1c51623e-4a12-4967-8ca5-5cfee9034a64",
                                                "sense_id": "991ed050-ca85-33dd-a958-2cc6daad81d3",
                                                "text": "„Folgt man Angaben des Bundesministerium des Inneren so wird Romanes von ca. 60.000 deutschen Sinti und 10.000 deutschen Roma gesprochen (BMI, 2009, S. 39), allerdings ist ungewiss auf welchem Niveau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8259e16f-3c70-4e17-b107-b914bb4e7bac",
                        "source_entry_id": "a85ed8fa-d298-3e72-9c20-90789f4e30e5",
                        "source_sense_id": "8d4c7794-a8a6-3111-a1c4-5a756a755356",
                        "source_sense_description": "Romanes",
                        "target_lang_word": "Zigeunersprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigeunersprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                        "entry_id": "f483e4de-071d-304e-a5d7-5ae1333b0f4d",
                                        "glosses": [
                                            "Sprache der Zigeuner (= Roma bzw. Sinti und Roma)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72f31c47-5dfc-4bdd-a0f0-c062850dbe4b",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "Die Zigeunersprache gehört zum indo-iranischen Zweig der indogermanischen Sprachen."
                                            },
                                            {
                                                "example_id": "297f6be9-3a89-4dc8-851a-3a0e662c9225",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "„Und seit dem ersten Drittel des fünfzehnten Jahrhunderts hat das Rotwelsch auch vieles aus der Zigeunersprache empfangen.“"
                                            },
                                            {
                                                "example_id": "c7cc20fd-8b03-40ac-bbd9-08adb1b24049",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "„Alle genannten Sprachen gehören dem indogermanischen Stamm an, ebenso die in Dialekte aufgespaltene, weit außerhalb Indiens bis nach Europa hin gesprochene Zigeunersprache.“"
                                            },
                                            {
                                                "example_id": "2e7ab4da-ed1a-4c29-82ac-8a1bcae04679",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "„Bei dem dreitägigen Verhör in Stuttgart erklärten alle, sie würden derselben Familie angehören, von Zigeunern abstammen und die Zigeunersprache sprechen: also ein deutlicher Beweis, daß sie sich selbst als Mitglieder einer ethnischen Gruppe betrachteten.“"
                                            },
                                            {
                                                "example_id": "794b3e13-849f-4a9f-9db4-5ec31709bb7f",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "„Einen Teil seiner Wörter verdankt das Rotwelsch deutschen Dialekten; ein anderer, großer Teil geht aber auf das Jiddische und die Zigeunersprache zurück.“"
                                            },
                                            {
                                                "example_id": "ccbfae96-3e51-4b7f-b5ca-5ece2d35c21a",
                                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                                "text": "„Es erscheint ganz logisch, daß in die Geheimsprachen der Räuber und Vaganten hebräische, jiddische Begriffe und Begriffe der Zigeunersprache Eingang gefunden haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
