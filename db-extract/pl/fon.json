                            {
                                "target_word": "Fon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc88973-3f09-3360-abbf-2dac692fd59b",
                                        "entry_id": "91299e00-47f1-3328-9bcb-cc651a3e40ec",
                                        "glosses": [
                                            "Einheit der Lautstärke"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                                        "entry_id": "41989d01-057e-3d5d-b1c9-b56962d9774c",
                                        "glosses": [
                                            "eine Kwa-Sprache, die in Benin und Togo gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb7ab2bd-6ab1-43eb-94af-8ff77e22a81f",
                                                "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                                                "text": "„Aus der Tatsache seines prozentualen Anteils und seiner relativ weiten Verbreitung resultiert auch, daß bereits seit längerem eine Reihe von Arbeiten zum Fon existiert.“"
                                            },
                                            {
                                                "example_id": "4c02dede-18a9-4ded-aba8-4c631f5d60f5",
                                                "sense_id": "04dad1c5-6f19-3823-a959-e579c0cffb70",
                                                "text": "„›Tchan‹ ist die Bezeichnung auf Fon; im Yoruba spricht man von ›mariwu‹, was gleichzeitig als Name für die Initiierten verwendet wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2aabcc9e-fe22-3a56-b2a2-a6af12fd612a",
                                        "entry_id": "ca70ce61-0a6d-307f-b670-062809053332",
                                        "glosses": [
                                            "ein Volk in Benin und Nigeria"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b94477-169e-49f8-92ed-427d21961473",
                                                "sense_id": "2aabcc9e-fe22-3a56-b2a2-a6af12fd612a",
                                                "text": "„Bei den Fon in Benin bedeutet ‚Rote Augen haben‘ ehrgeizig sein.“"
                                            },
                                            {
                                                "example_id": "d32ebc1f-6d49-44ea-a995-b10d7de64a3d",
                                                "sense_id": "2aabcc9e-fe22-3a56-b2a2-a6af12fd612a",
                                                "text": "„Diese Symbole beziehen sich einerseits auf unterschiedliche Gottheiten, repräsentieren aber auch bestimmte Herrscher der Fon in der Vergangenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23e59e44-e83d-319a-acd8-18646c13032b",
                                        "entry_id": "ca70ce61-0a6d-307f-b670-062809053332",
                                        "glosses": [
                                            "Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb582b6-351f-4ab8-a428-6694acfef5b9",
                                                "sense_id": "23e59e44-e83d-319a-acd8-18646c13032b",
                                                "text": "„Insbesondere gilt für den Fon die Verpflichtung, seine Stellung zum Wohl des Landes zu nutzen.“"
                                            },
                                            {
                                                "example_id": "25ba5e8d-44ba-44de-a27f-830b0212a93c",
                                                "sense_id": "23e59e44-e83d-319a-acd8-18646c13032b",
                                                "text": "Mein Nachbar ist ein Fon."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
