{
    "word_family": [
        "escorter",
        "escorteur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9f15a94-d920-3941-a384-af21006122ec",
                    "sense_definition": "Troupe ou groupe qui accompagne une personne ou un convoi pour assurer sa protection ou sa surveillance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président se déplace toujours avec une <w>escorte</w> policière dans la capitale."
                        },
                        {
                            "text": "Les deux suspects ont été transférés sous bonne <w>escorte</w> vers le tribunal ce matin."
                        }
                    ],
                    "common_phrases": [
                        "escorte policière",
                        "sous bonne escorte"
                    ]
                },
                {
                    "sense_id": "b3090c3d-ed74-32e4-98ac-7b31489f69bf",
                    "sense_definition": "Cortège réuni pour accompagner une personnalité afin de lui rendre hommage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ceremonie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une impressionnante <w>escorte</w> de motards accompagnait le cortège royal à travers la ville."
                        },
                        {
                            "text": "Le général a été accueilli avec une <w>escorte</w> d'honneur par les soldats de la base."
                        }
                    ],
                    "common_phrases": [
                        "escorte d'honneur"
                    ]
                },
                {
                    "sense_id": "cd0dda2f-857d-36b1-89e4-5f06dc5c71cf",
                    "sense_definition": "Personne rémunérée pour accompagner un client ou pour fournir des prestations tarifées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prostitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a travaillé plusieurs mois comme <w>escorte</w> pour payer ses frais de scolarité."
                        },
                        {
                            "text": "Cette agence spécialisée propose un service d'<w>escorte</w> discret pour les événements mondains."
                        }
                    ],
                    "synonyms": [
                        "prostitué",
                        "prostituée"
                    ],
                    "common_phrases": [
                        "service d'escorte"
                    ]
                },
                {
                    "sense_id": "58a3a1cc-ba2e-3c42-a265-d527384bf38a",
                    "sense_definition": "Navire militaire ou ensemble de bâtiments assurant la protection de navires civils en mer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les navires de ravitaillement naviguaient sous l'<w>escorte</w> de plusieurs frégates de combat."
                        },
                        {
                            "text": "Chaque bâtiment d'<w>escorte</w> surveillait attentivement l'horizon pour détecter d'éventuels sous-marins."
                        }
                    ],
                    "common_phrases": [
                        "bâtiment d'escorte"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eba58bfb-da9a-315e-a407-f9e28be7dc67",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>escorter</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police <w>escorte</w> le convoi exceptionnel à travers le centre de la ville."
