                                    {
                                        "sense_id": "ca522bea-17ac-3305-9aff-207f7fc6de03",
                                        "entry_id": "2de39209-19de-302d-aed9-195ecda84a7f",
                                        "glosses": [
                                            "Que está afectado del vicio de la gula y por ello come en exceso."
                                        ],
                                        "tags": [
                                            "se usa también como sustantivo"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
