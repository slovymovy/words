                        "entry_id": "c3eda0b8-4806-3a18-82c4-8f47ffa41bfc",
                        "glosses": [
                            "The worldwide Muslim community."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474c63cd-d3ac-449e-8b69-4841aab5296e",
                                "sense_id": "7f935f44-ec96-376a-ab1a-8fd5de61e0e0",
                                "text": "That concept of a united ummah has survived all subsequent divisions in Islam, including the great and so far permanent rupture between Sunni and Shī‘a [...]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a53919d-d116-4100-bc41-da100d899b67",
                        "source_entry_id": "c3eda0b8-4806-3a18-82c4-8f47ffa41bfc",
                        "source_sense_id": "7f935f44-ec96-376a-ab1a-8fd5de61e0e0",
                        "source_sense_description": "the worldwide Muslim community",
                        "target_lang_word": "oumma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oumma",
