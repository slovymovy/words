                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4633ca50-202c-43d2-94d3-55f6b104e6d9",
                                "sense_id": "766703d1-99b6-3665-9bb5-efcc8a60b858",
                                "text": "„In der Mitte stand eine riesige schwarze Müllpresse, die niemand zu benutzen schien.“"
                            },
                            {
                                "example_id": "defba41d-384b-46cc-ad09-9d8104880aaa",
                                "sense_id": "766703d1-99b6-3665-9bb5-efcc8a60b858",
                                "text": "„In diesem Land zahlt man für 100 Quadratmeter Wohnfläche 45 Millionen Dollar, und zwei Straßen weiter wird ein Obdachloser in der Müllpresse zerquetscht.“"
                            },
                            {
                                "example_id": "7b5076e0-52e5-4344-bcda-e326c1ef5bcb",
                                "sense_id": "766703d1-99b6-3665-9bb5-efcc8a60b858",
                                "text": "„Hier gab's neulich mal eine Frau, die hat ihr Baby in eine Müllpresse geworfen.“"
                            }
                        ],
