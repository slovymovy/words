                        "entry_id": "883331cc-3b92-3a4f-b70c-dfe29e02c594",
                        "glosses": [
                            "een spel dat via of met de computer gespeeld wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55883dfc-54ed-4468-a073-868307d25c58",
                                "sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                                "text": "Papa, wil je dat computerspel voor mij kopen?"
                            },
                            {
                                "example_id": "a0cf6f73-4c2c-43c7-9e1d-7e3a60f85ec6",
                                "sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                                "text": "Met een zwaar Israëlisch accent waren al zijn grappen bezaaid met grove straattaal. Het was alsof hij Engels had leren spreken tijdens het spelen van het computerspel ‘Grand Theft Auto’."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d808f415-3f2b-4ae0-9af5-f0ad1b39774b",
                        "source_entry_id": "883331cc-3b92-3a4f-b70c-dfe29e02c594",
                        "source_sense_id": "a4652eda-38da-3c22-9f1d-89e401e849c6",
                        "source_sense_description": "een spel dat via of met de computer gespeeld wordt",
                        "target_lang_word": "Computerspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Computerspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "231389ee-eb52-3005-8071-01921ea84c1c",
                                        "entry_id": "4cdaef3d-e53c-3ef1-8a28-0db310f3a851",
                                        "glosses": [
                                            "Programm auf einem Computer, das einem oder mehreren Benutzern ermöglicht, ein durch implementierte Regeln beschriebenes Spiel zu spielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "116696d7-0dff-4c5f-a68c-09ed5e0923d4",
                                                "sense_id": "231389ee-eb52-3005-8071-01921ea84c1c",
                                                "text": "Computerspiele werden immer wieder zu Unrecht wegen ihrer Gewaltdarstellung kritisiert."
                                            },
                                            {
                                                "example_id": "006907b1-23ad-4513-87ea-19e71ee000ca",
                                                "sense_id": "231389ee-eb52-3005-8071-01921ea84c1c",
                                                "text": "„In Japan wurden die Pokemon vor zwölf Jahren als Helden eines Computerspiels geboren und dann als Charaktere in Serien und Kinofilmen weltweit bekannt.“"
                                            },
                                            {
                                                "example_id": "5dc2a435-34d7-4fc3-a951-ee092942c4d2",
                                                "sense_id": "231389ee-eb52-3005-8071-01921ea84c1c",
                                                "text": "„Eine Mutter stand am Ende der lichten Geschäftspassage und ließ sich von ihrem Kind die neuesten Computerspiele erklären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f71b761f-6686-4f7e-b239-587c77f2c491",
                        "source_entry_id": "883331cc-3b92-3a4f-b70c-dfe29e02c594",
