            {
                "entry_id": "8a716785-0157-354e-8d13-2ecd00de58d2",
                "word": "acrook",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f3912e5-5623-3ff3-911b-5b800ad5d4f6",
                        "entry_id": "8a716785-0157-354e-8d13-2ecd00de58d2",
                        "glosses": [
                            "In an oblique or crooked direction."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9e78a0c5-6232-4896-bdb4-0374e70d4235",
                                "sense_id": "5f3912e5-5623-3ff3-911b-5b800ad5d4f6",
                                "text": "C. Custance. Wife, why cal ye me wife?\nSim Sure. Wife? this gear goth acrook."
                            },
                            {
                                "example_id": "92c46e4e-5829-4d08-b1c2-3384a7c68777",
                                "sense_id": "5f3912e5-5623-3ff3-911b-5b800ad5d4f6",
                                "text": "Loe, is not there the draught of some gold-sandy brooke\nThat on this azure ground glydes (as it were) acrooke?"
                            },
                            {
                                "example_id": "513d1d8f-1bce-400e-8a55-3293db3e4fc5",
                                "sense_id": "5f3912e5-5623-3ff3-911b-5b800ad5d4f6",
                                "text": "[…] our spirits immersed / In wilfulness, our steps run all acrook."
                            },
                            {
                                "example_id": "8d4010e7-673b-4a65-979c-52adaff73235",
                                "sense_id": "5f3912e5-5623-3ff3-911b-5b800ad5d4f6",
                                "text": "And night ten years, o’er rough and smooth,\nAnd up and down, and acrook and across,\nI lead my pupils by the nose,"
                            }
                        ]
                    }
                ],
