        "fr-extract.jsonl": [
            {
                "entry_id": "be1b0563-3ff3-3362-9bd0-abb732a2572e",
                "word": "érotomanie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "10e3f229-fd46-4f81-a373-8ac1f96c7cc8",
                        "entry_id": "be1b0563-3ff3-3362-9bd0-abb732a2572e",
                        "tags": [
