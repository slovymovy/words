                        ],
                        "examples": [
                            {
                                "example_id": "bf732732-2cee-416d-b2e3-8b1c69e7d6bb",
                                "sense_id": "7e6cf0f9-3f04-35a1-9495-92e8a520cd6c",
                                "text": "\"You woz saying,\" said the farmer, with slow, matter of fact, New England deliberation, \"ez how you guessed you woz beguiled amongst the Injins by your Mexican partner, a pow'ful influential man, and yet you woz the only one escaped the gen'ral slarterin'."
                            },
                            {
                                "example_id": "64857f00-18a5-429a-9e19-0e8668895f09",
                                "sense_id": "7e6cf0f9-3f04-35a1-9495-92e8a520cd6c",
                                "text": "'If she woz mine' - tapping a brick - 'I'd bash 'er 'ed in!'"
                            },
                            {
                                "example_id": "804fdf6e-5fc1-4f61-8c09-fc8c6a03db3f",
                                "sense_id": "7e6cf0f9-3f04-35a1-9495-92e8a520cd6c",
                                "text": "We woz robbed, Brian."
                            }
                        ]
                    }
                ],
