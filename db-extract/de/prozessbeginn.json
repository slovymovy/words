                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c193aae-c8a8-4557-b008-205c0b763557",
                                "sense_id": "c59b8443-3b97-36db-afb3-26d5d7a0e0bb",
                                "text": "„Als man mich damals hierherbrachte, wusste ich nicht, wie ich die Nacht überstehen sollte, geschweige denn die Monate bis zum Prozessbeginn.“"
                            },
                            {
                                "example_id": "622d816a-476a-4eac-b1e4-cbe9bda8cc63",
                                "sense_id": "c59b8443-3b97-36db-afb3-26d5d7a0e0bb",
                                "text": "„In den Tagen unmittelbar vor Prozessbeginn trafen sich Williams und Carter zu einem Gespräch mit Dr. Battle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
