                "senses": [
                    {
                        "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                        "entry_id": "8a0ce49d-1a36-3a37-9d22-4424c5bae2cb",
                        "glosses": [
                            "Herrschaftssymbol in Form einer Kugel mit aufgesetztem Kreuz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b7490f-eaa6-4be5-a895-e4dafb20b1ce",
                                "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                                "text": "„Im Mittelalter waren Reichsapfel, Zepter, Schwert und Heilige Lanze die wichtigsten Zeichen der kaiserlichen Macht.“"
                            },
                            {
                                "example_id": "b3bdaacf-c0b7-49dd-962a-7dd5fbac1803",
                                "sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
                                "text": "„Der Palast auf dem Hradschin wird erweitert, der Bau einer weiteren Burg ist begonnen - später werden hier die Reichsinsignien Reichsapfel, Krone, die Lanze mit dem Nagel vom Kreuze Christi aufbewahrt, …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c296020-c439-4802-903c-735c7a162ab8",
                        "source_entry_id": "8a0ce49d-1a36-3a37-9d22-4424c5bae2cb",
                        "source_sense_id": "add5e578-5c5e-3faa-bb68-91f0b3cbb9dc",
