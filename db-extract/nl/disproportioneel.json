                        "examples": [
                            {
                                "example_id": "2d00d3fd-f6e8-4015-8a8d-b9d7f0399ccd",
                                "sense_id": "b103e9f3-0b4d-3c03-a874-a90d7fcf5100",
                                "text": "Het leger maakte zich schuldig aan standrechtelijke executies, mishandeling en marteling, detentie onder inhumane omstandigheden, brandstichting van huizen en dorpen, diefstal en vernieling van goederen en levensmiddelen, disproportionele luchtaanvallen en artilleriebeschietingen, en veelal willekeurige massa-arrestaties en -interneringen."
                            }
                        ]
                    }
