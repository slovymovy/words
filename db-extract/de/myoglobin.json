                        "entry_id": "2bfa8e46-89ac-347a-a5fc-2f971e28c514",
                        "glosses": [
                            "roter Farbstoff, der in der Muskulatur vorkommt und als Speicher für Sauerstoff dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f505026e-72c3-4fda-8124-35c85d04af3e",
                                "sense_id": "1496f334-30cf-3f60-9835-6a99c6e30eba",
                                "text": "„Die Lebensmittelreste waren durchsetzt mit Spuren von Myoglobin, einem menschlichen Muskelprotein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79af714c-f3ca-4b8f-912a-ea62a6027332",
                        "source_entry_id": "2bfa8e46-89ac-347a-a5fc-2f971e28c514",
                        "source_sense_id": "1496f334-30cf-3f60-9835-6a99c6e30eba",
                        "source_sense_description": "Biologie: roter Farbstoff, der in der Muskulatur vorkommt und als Speicher für Sauerstoff dient",
                        "target_lang_word": "myoglobin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myoglobin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c675b60-a64f-3234-8a3e-ca9998680443",
                                        "entry_id": "b7045896-4c97-3926-9010-ee0feb3ed670",
                                        "glosses": [
                                            "A small globular protein, containing a heme group, that carries oxygen to muscles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
