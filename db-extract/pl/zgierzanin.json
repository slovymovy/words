                "translations": [
                    {
                        "translation_id": "e9427bbb-b524-4389-a1a2-c44267231d38",
                        "source_entry_id": "94948450-0701-37c6-87ba-b1a73404c65b",
                        "source_sense_id": "2f2fc53b-468e-308c-959b-08a1bfe1d88e",
                        "target_lang_word": "житель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "житель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                        "entry_id": "48058ecc-8620-3a80-8fdc-61f58a8f68c0",
                                        "glosses": [
                                            "представитель населения; тот, кто живёт где-либо, в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6093453-1613-49b6-8b67-86a6c6bd12df",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "[Платон Михайлович:] Как видишь, брат: // Московский житель и женат."
                                            },
                                            {
                                                "example_id": "b8563718-ed44-4c84-b82c-94c55cf554ca",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "— Ты не можешь представить себе, как для меня, деревенского жителя, всё это дико .."
                                            },
                                            {
                                                "example_id": "4b57b5cc-26f2-4119-8e0f-069a4bb0b28c",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Городские жители начинали вспоминать о своих деревенских друзьях и родственниках и посещать их."
                                            },
                                            {
                                                "example_id": "bacf6630-448d-4ad0-b622-7f5d29d82700",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Мне, жителю севера, ещё не доводилось бывать зимою в южной степи."
                                            },
                                            {
                                                "example_id": "3b553bd8-39c1-4f92-a583-9c5872a336cf",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Жители Тифлиса покинули свои квартиры, захватив ценные вещи."
                                            },
                                            {
                                                "example_id": "8d3180ab-95aa-4174-83ba-2ff7eb98051a",
                                                "sense_id": "d150b7d7-5acd-3bc4-98b6-7d615dfc954d",
                                                "text": "Как у всех приморских жителей, у неё был запас раскладушек и постельного белья для немереных приезжих родственников."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
