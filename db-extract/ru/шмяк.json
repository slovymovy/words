                            },
                            {
                                "target_word": "whack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "264abb6e-396b-3544-86a5-f3766bccc55d",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To hit, slap or strike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0c5ee3-0d08-44ce-873d-8a4c89a6f106",
                                                "sense_id": "264abb6e-396b-3544-86a5-f3766bccc55d",
                                                "text": "The bat whacked the baseball."
                                            },
                                            {
                                                "example_id": "91ed44e6-1761-4fee-92b3-ba2452708711",
                                                "sense_id": "264abb6e-396b-3544-86a5-f3766bccc55d",
                                                "text": "Therefore he whacked the old nigger mercilessly, while a big crowd of his people watched him, thunderstruck, till some man, - I was told the chief's son, - in desperation at hearing the old chap yell, made a tentative jab with a spear at the white man - and of course it went quite easy between the shoulder-blades."
                                            },
                                            {
                                                "example_id": "4efd110d-de2e-42f1-a9e2-ce932d5f7be4",
                                                "sense_id": "264abb6e-396b-3544-86a5-f3766bccc55d",
                                                "text": "G. W. Cable\nRodsmen were whacking their way through willow brakes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd383ec7-95ff-3426-afbc-e87c75720582",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To assassinate, bump off."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45a79bef-f25e-4882-8264-88b0ef134863",
                                                "sense_id": "dd383ec7-95ff-3426-afbc-e87c75720582",
                                                "text": "Niko Bellic: So you want me to talk to him? / Jimmy Pegorino: I want you to whack him! And after that I want you to kill all the other rats I surround myself with..."
                                            },
                                            {
                                                "example_id": "b1787535-9569-4809-a916-2145e1bf235f",
                                                "sense_id": "dd383ec7-95ff-3426-afbc-e87c75720582",
                                                "text": "Ken Barrett, a loyalist gunman who eventually confessed to killing Mr. Finucane on orders from the paramilitary Ulster Defense Association, told a BBC investigative reporter, John Ware, that when he’d expressed reluctance about “whacking” a solicitor[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "297d8c6b-6483-3993-9d39-f5576c750d03",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To share or parcel out (often with up)."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1afd68a6-b0e7-4913-9dad-88f3416d26bb",
                                                "sense_id": "297d8c6b-6483-3993-9d39-f5576c750d03",
                                                "text": "to whack the spoils of a robbery"
                                            },
                                            {
                                                "example_id": "9ba41383-c6e2-4c7f-bc71-6e4fe22946fd",
                                                "sense_id": "297d8c6b-6483-3993-9d39-f5576c750d03",
                                                "text": "When the sewer-hunters consider they have searched long enough […] the gang […] count out the money they have picked up, and proceed to dispose of the old metal, bones, rope, &c.; this done, they then, as they term it, “whack” the whole lot; that is, they divide it equally among all hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec7815bc-5a62-32ea-a941-187c126a28c7",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To beat convincingly; to thrash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213f4aed-a15a-4986-a98e-47a3271b4103",
                                                "sense_id": "ec7815bc-5a62-32ea-a941-187c126a28c7",
                                                "text": "The fidgety Majors were whacked 9-1 by the Kitchener Panthers at Couch and now trail their rivals 2-0 in an increasingly uncomfortable best-of-seven Intercounty Baseball League first-round series."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d0165fa-9977-36a8-b2e8-b765703abc01",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To surpass; to better."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0a28b96-b5a3-49c9-a94d-29eccb6867c1",
                                                "sense_id": "6d0165fa-9977-36a8-b2e8-b765703abc01",
                                                "text": "Recently I was over in Ireland, I love the place, proper fishing, can't whack it!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f50cfd2-38fb-3962-bf0d-e387a68ba32c",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To attempt something despite not knowing how to do it; to take on a task spontaneously and carelessly without planning."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "Singlish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fc71bc9-72e0-4d27-a669-f442e02012d2",
                                                "sense_id": "4f50cfd2-38fb-3962-bf0d-e387a68ba32c",
                                                "text": "Miss Loi always tells her students not to anyhow whack, stay calm and know thy approach before attempting each question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fe4d43b-d8f4-3670-8031-be4202706aeb",
                                        "entry_id": "0f430245-a0fd-3a26-a626-edfe7d312e5c",
                                        "glosses": [
                                            "To eat something hurriedly."
                                        ],
                                        "tags": [
                                            "Singapore",
                                            "Singlish"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "whack",
