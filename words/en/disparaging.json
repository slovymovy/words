{
    "word_family": [
        "disparage",
        "disparagement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8fb7f472-3d28-3b37-9d71-6e90ec441895",
                    "sense_definition": "Expressing a low opinion of someone or something; insulting or belittling.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "insulting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made <w>disparaging</w> remarks about his opponent during the televised debate.",
                            "target_lang_translations": {
                                "zh": "那位政客在电视辩论中对他的对手发表了<w>贬低</w>性的言论。"
                            }
                        },
                        {
                            "text": "She felt hurt by his <w>disparaging</w> comments regarding her professional achievements.",
                            "target_lang_translations": {
                                "zh": "他对他职业成就的<w>贬低</w>评论让她感到受伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "degrading",
                        "derogatory"
                    ],
                    "antonyms": [
                        "laudatory"
                    ],
                    "common_phrases": [
                        "disparaging remarks",
                        "disparaging comments"
                    ],
                    "target_lang_definitions": {
                        "zh": "表达对某人或某事的低评价；侮辱或贬低。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "指降低对某人或某事的评价，带有轻视意味。"
                            },
                            {
                                "target_lang_word": "诋毁",
                                "target_lang_sense_clarification": "指恶意批评或毁坏名誉。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ddef80b-bc24-3ebb-b574-4ad01591e551",
                    "sense_definition": "The act of speaking about someone or something in a way that shows a lack of respect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insulting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author was known for his sharp <w>disparagings</w> of contemporary literary trends.",
                            "target_lang_translations": {
                                "zh": "这位作家以对当代文学潮流的尖锐<w>贬损</w>而闻名。"
                            }
                        },
                        {
                            "text": "Her constant <w>disparagings</w> of the staff created a very toxic work environment.",
                            "target_lang_translations": {
                                "zh": "她对员工不断的<w>贬损</w>营造了一种非常糟糕的工作环境。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "以缺乏尊重的方式谈论某人或某事的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贬损",
                                "target_lang_sense_clarification": "指贬低和损害，常用于描述言论行为。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f42129cc-1893-393a-95cb-d61915dcd4db",
                    "sense_definition": "Present participle and gerund of <w>disparage</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insulting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>disparaging</w> his colleague's hard work in front of the entire team.",
                            "target_lang_translations": {
                                "zh": "他在整个团队面前<w>贬低</w>他同事的辛勤工作。"
                            }
                        },
                        {
                            "text": "Stop <w>disparaging</w> yourself because you are actually very talented at what you do.",
                            "target_lang_translations": {
                                "zh": "别再<w>贬低</w>你自己了，因为你在你所做的事情上其实非常有天赋。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb disparage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 disparage 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贬低",
                                "target_lang_sense_clarification": "指贬低某人或某事。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}