                    {
                        "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                        "entry_id": "b98eda35-a1e0-3f81-8f39-0cf3f82e6eaa",
                        "glosses": [
                            "mit einem Telefon ausgestattete Kabine im öffentlichen Raum"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "0b74e3b4-7e91-4bdd-be54-dfe94b3353ee",
                                "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                                "text": "„Auf dem Programm ist etwa eine Jukebox-Party in der Telefonkabine.“"
                            },
                            {
                                "example_id": "58dcdd5b-af6d-4dd3-b99d-674ea2bc0efe",
                                "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                                "text": "„Am Donnerstagmorgen moderierte Nadja Hüppi aus einer Telefonkabine an der St.Leonhard-Strasse.“"
                            },
                            {
                                "example_id": "8227c87b-6a22-4358-bc5e-8db8bcd8f5b7",
                                "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                                "text": "„Die Antwort darauf erhält, wer in die kleine Telefonkabine tritt.“"
                            },
                            {
                                "example_id": "71f4d1c2-beb6-4f2e-a482-b63ba2be419c",
                                "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                                "text": "„Die Telefonkabinen verschwinden aus unseren Stadtbildern.“"
                            },
                            {
                                "example_id": "2348549d-90d1-4c4d-bc02-8a518e25daa7",
                                "sense_id": "e6d52158-4480-3867-8928-4ad0696ac1f4",
                                "text": "„Telefonkabinen haben ausgedient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
