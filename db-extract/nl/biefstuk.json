                "senses": [
                    {
                        "sense_id": "93fa2bbb-7f79-3f13-a170-3feec63ef754",
                        "entry_id": "41ef499e-30a5-337f-9192-c44f128ecf53",
                        "glosses": [
                            "een lap rundvlees, kalfsvlees of paardenvlees van de bovenbil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9cd3bc0-cae9-47c0-83d6-42e0b56db5ad",
                                "sense_id": "93fa2bbb-7f79-3f13-a170-3feec63ef754",
                                "text": "Biefstuk moet je niet te lang bakken anders word hij taai."
                            },
                            {
                                "example_id": "6bf25fa9-bd9a-4f57-aed4-4c690597f197",
                                "sense_id": "93fa2bbb-7f79-3f13-a170-3feec63ef754",
                                "text": "Biefstuk van een paard is extra mals en bevat meer ijzer."
                            },
                            {
                                "example_id": "43bcc0dd-919c-4900-b4a8-a02938a4caae",
                                "sense_id": "93fa2bbb-7f79-3f13-a170-3feec63ef754",
                                "text": "Ik bleef maar naar het all-you-can-eatbuffet teruggaan voor meer eten. Er kwam geen einde aan: zalmsalade, pasta, groente, sushi, biefstuk, soep, chocoladetaart, witte chocoladetaart, crème brûlee, vers fruit met room, bier, koffie en whisky."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9395a2c8-b4aa-4e2f-8132-442ffba00bbd",
                        "source_entry_id": "41ef499e-30a5-337f-9192-c44f128ecf53",
                        "source_sense_id": "93fa2bbb-7f79-3f13-a170-3feec63ef754",
                        "source_sense_description": "dunne lap vlees van de bovenbil van een rund",
                        "target_lang_word": "Steak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                        "entry_id": "03022063-77d9-3aaf-b451-c1582480927b",
                                        "glosses": [
                                            "zum Kurzbraten oder Grillen geeignete Fleischscheibe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28ca12f-b8c8-4eaf-a5a9-9d15b53a7730",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "Ich habe jetzt Appetit auf ein schönes Steak."
                                            },
                                            {
                                                "example_id": "4a96ddb9-f53c-41f7-9acd-5a05e4aadc5f",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Alle Steaks werden durch Braten oder Grillen gegart, selten auch durch Pochieren.“"
                                            },
                                            {
                                                "example_id": "f2a22541-745a-4dc4-a669-0133ae577d8a",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Als nächstes gingen sie zum Clubhaus und sahen ein luxuriöses Büffet mit allen nur erdenklichen Spezialitäten, von Meeresfrüchten über Steaks bis zu exotischen Desserts, allen möglichen Getränken und einem Champagnerbrunnen.“"
                                            },
                                            {
                                                "example_id": "88b3cdbf-e313-417d-8ca1-176b11a0ac98",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Jan saß am Esstisch und stocherte in den grünen Bohnen, die er uns zum Steak mit Rosmarinkartoffeln serviert hatte.“"
                                            },
                                            {
                                                "example_id": "dca25fa9-22fd-46e2-a02f-e07f204ab048",
                                                "sense_id": "69f65c5d-502c-307f-adef-102956380e80",
                                                "text": "„Er wollte ein gutes Steak, blutig, und ich bestellte zwei Tournedos mit Sauce béarnaise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f52ee2a-d976-403b-932b-8fd18adc7de3",
                        "source_entry_id": "41ef499e-30a5-337f-9192-c44f128ecf53",
