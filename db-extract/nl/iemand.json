                        "examples": [
                            {
                                "example_id": "17605bc4-fdb6-4015-ada7-f81d7cdb6183",
                                "sense_id": "d8d71180-ffb6-3090-a4c3-219e7498d3d6",
                                "text": "Is daar iemand?",
                                "translation": "Ist da jemand?"
                            },
                            {
                                "example_id": "83573352-20eb-45ff-bd46-45895138e728",
                                "sense_id": "d8d71180-ffb6-3090-a4c3-219e7498d3d6",
                                "text": "Men schijnt, dat ik iemand heb gehoord.",
                                "translation": "Mir scheint, dass ich jemanden gehört habe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ab8694c-464a-4ef0-a9e1-c633c4c6a029",
                        "source_entry_id": "9d4f83ca-537b-3928-86c8-b79659808442",
                        "source_sense_id": "d8d71180-ffb6-3090-a4c3-219e7498d3d6",
                        "source_sense_description": "jemand",
                        "target_lang_word": "jemand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jemand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                        "entry_id": "8e9941d7-427b-3da2-a899-1904b8ca39c7",
                                        "glosses": [
                                            "eine oder mehrere unbestimmte Person(en)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1166f5ef-9049-4c24-9882-8b553b36abb1",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Ist da jemand?"
                                            },
                                            {
                                                "example_id": "21f85d42-5ade-4a77-9c53-e557552f0f9b",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Oh, ich habe jemand anderen erwartet."
                                            },
                                            {
                                                "example_id": "a7cf9065-03b3-4be7-a8e6-8ed761297556",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Oh, ich habe jemand (selten: jemanden) anders erwartet."
                                            },
                                            {
                                                "example_id": "2e1a23b2-ce3a-4d07-a04e-0386f4ab438c",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Ich habe mit jemand Unbekanntes (oder: jemand Unbekanntem, jemandem Unbekanntem; von manchen als umgangssprachlich empfunden: jemandem Unbekannten) gesprochen."
                                            },
                                            {
                                                "example_id": "7d4d21ca-2d49-4c5a-87b9-c17b8d37de67",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Könnte mir bitte jemand mit dem Sonnenschirm helfen?"
                                            },
                                            {
                                                "example_id": "2609e8f2-1b73-48ad-b0d1-5e85b238cc98",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Jemand, der sich auf Motorräder versteht, hat die Maschine dann umgeparkt."
                                            },
                                            {
                                                "example_id": "a863fdba-ea9a-49a3-b9b8-3e0da37bc022",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Gehört das Fahrrad jemand(em) von Ihnen?"
                                            },
                                            {
                                                "example_id": "3070fd43-ce2c-426f-93a4-0e922e057159",
                                                "sense_id": "e5a60d46-0129-39c4-b457-e57851b6f560",
                                                "text": "Es gibt sicher Vorschriften, wie man jemandes Nachlass übernimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
