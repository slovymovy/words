{
    "word_family": [
        "foot",
        "footage",
        "footer",
        "footing",
        "footless",
        "underfoot"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "336f752e-07b2-30e7-97ba-2f9e4040e597",
                    "sense_definition": "Simple past and past participle of <w>foot</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foot_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company generously <w>footed</w> the entire bill for the celebratory dinner.",
                            "target_lang_translations": {
                                "cs": "Společnost velkoryse <w>zaplatila</w> celý účet za slavnostní večeři."
                            }
                        },
                        {
                            "text": "After a long hike, they <w>footed</w> their way slowly down the rocky mountain.",
                            "target_lang_translations": {
                                "cs": "Po dlouhé túře se pomalu <w>vydali pěšky</w> dolů ze skalnaté hory."
                            }
                        }
                    ],
                    "common_phrases": [
                        "footed the bill"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Minulý čas a minulé příčestí od slovesa foot (zaplatit/uhradit účet; jít pěšky)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zaplatil",
                                "target_lang_sense_clarification": "účet, výdaje"
                            },
                            {
                                "target_lang_word": "uhradil",
                                "target_lang_sense_clarification": "náklady"
                            },
                            {
                                "target_lang_word": "kráčel",
                                "target_lang_sense_clarification": "šel pěšky"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36423864-9e09-31a5-8c92-16d0bce65619",
                    "sense_definition": "Having a foot, feet, or base; or in combination, having a specified kind or number of feet.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "having_feet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby wore warm <w>footed</w> pajamas to protect against the chilly night air.",
                            "target_lang_translations": {
                                "cs": "Dítě mělo na sobě teplé pyžamo <w>s ťapkami</w>, které ho chránilo před chladným nočním vzduchem."
                            }
                        },
                        {
                            "text": "She displayed the fresh fruit in an antique <w>footed</w> bowl on the dining table.",
                            "target_lang_translations": {
                                "cs": "Čerstvé ovoce naaranžovala do starožitné mísy <w>na nožce</w> stojící na jídelním stole."
                            }
                        }
                    ],
                    "synonyms": [
                        "feeted"
                    ],
                    "common_phrases": [
                        "footed pajamas",
                        "footed bowl",
                        "bare-footed",
                        "sure-footed"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající nohy, nožky, podstavec; nebo ve složeninách s určitým typem či počtem nohou."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "s ťapkami",
                                "target_lang_sense_clarification": "např. o dětském oblečení s uzavřenými chodidly"
                            },
                            {
                                "target_lang_word": "na nožce",
                                "target_lang_sense_clarification": "např. mísa, pohár s podstavcem"
                            },
                            {
                                "target_lang_word": "-nohý",
                                "target_lang_sense_clarification": "ve složeninách, např. four-footed (čtyřnohý)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b22a9e9d-26c4-3e0a-ae10-7f85bdc5dce0",
                    "sense_definition": "Consisting of, or divided into, a specified number or type of metrical feet in verse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metrical_feet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The classic hexameter is a six-<w>footed</w> line composed of dactyls and spondees.",
                            "target_lang_translations": {
                                "cs": "Klasický hexametr je <w>šestistopý</w> verš složený z daktylů a spondejí."
                            }
                        },
                        {
                            "text": "Scholars analyzed each four-<w>footed</w> stanza to understand the rhythm of the poem.",
                            "target_lang_translations": {
                                "cs": "Odborníci analyzovali každou <w>čtyřstopou</w> strofu, aby porozuměli rytmu básně."
                            }
                        }
                    ],
                    "common_phrases": [
                        "four-footed line",
                        "six-footed verse"
                    ],
                    "target_lang_definitions": {
                        "cs": "Skládající se z určitého počtu nebo typu metrických stop (ve verši)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "-stopý",
                                "target_lang_sense_clarification": "ve složeninách v poezii, např. šestistopý verš"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}