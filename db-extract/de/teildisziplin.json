                ],
                "senses": [
                    {
                        "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                        "entry_id": "d41c6137-87b9-3b8f-99df-9ccc37956dc3",
                        "glosses": [
                            "ein einzelnes Gebiet innerhalb eines umfassenderen Fachs, Bereichs oder (sportlichen) Tätigkeitsfelds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6240b4cc-cba9-4c9c-89fc-fec9587f7a04",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„Sie gehören zu der Teildisziplin der Volkswirtschaftslehre, die sich nach dem Ausbruch der Finanzkrise im Herbst 2008 harte Kritik anhören musste: der Makroökonomik.“"
                            },
                            {
                                "example_id": "13fa646f-f332-40f7-8aef-acd82da07f91",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„So allgemein formuliert, klingt diese zentrale Definition der Karpologie, jener Teildisziplin der Botanik, die sich mit dem Aufbau, der Entwicklung und der Funktion von Früchten befasst, noch ganz nachvollziehbar.“"
                            },
                            {
                                "example_id": "4f6f8ccc-f96b-4322-98c6-dd60f2d71050",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„Der evolutionär-vergleichende Ansatz ist dabei mehr als nur eine Teildisziplin der Entwicklungsbiologie oder der Evolutionsbiologie, sondern wird mittlerweile als eine eigene biologische Disziplin angesehen.“"
                            },
                            {
                                "example_id": "e5c930b9-ef7a-4e57-81df-fb7bab531f4f",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„Gewichtheberin Nina Schroth holt hat bei der EM in Batumi gleich drei Medaillen. 222 Kilogramm reichten im Zweikampf zu Silber und auch in den Teildisziplinen zu Edelmetall.“"
                            },
                            {
                                "example_id": "0d267bdd-7943-4e29-83b7-d46f5524d767",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„Ein Slalomspezialist wie Marcel Hirscher nutzte bei der WM in Vail 2015 die Unausgewogenheit der Teildisziplinen und fuhr nach verhaltener Abfahrt von Rang 30 mit überlegener Slalombestzeit noch zum Kombinations-Titel.“"
                            },
                            {
                                "example_id": "779456a9-1450-49f9-a8a1-88ebf96c235a",
                                "sense_id": "3a835ab2-bfc0-3191-ad08-37ad0023f9f5",
                                "text": "„Eingestellt wurde diese Bestmarke sofort und mit tollen Leistungen in den Teildisziplinen Rückrudern und Abringen von Trögers Kollegen Hein Verbruggen: ‚Es war von Anfang an klar, dass die Spiele auf chinesische Art gemacht würden, nicht auf unsere‘, erläuterte der Niederländer unserer Sportreporterin Evi Simeoni und fragte sie dann noch: „Brauchen Sie denn all die Websites, um von den Spielen zu berichten?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
