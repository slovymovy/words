                        "entry_id": "bca9d6fe-9428-32f5-bc63-8eb9e6cfcd5b",
                        "glosses": [
                            "Relatif à l'onomasiologie, qui relève de l'onomasiologie ; qui étudie une démarche pour aller d'une idée vers ses expressions dans une langue, vers des mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c5e7ffd-85bb-4ece-9d03-9a59c900c4b9",
                                "sense_id": "dace0ff5-6bec-3b70-affd-82cd584cf26b",
                                "text": "Une recherche onomasiologique à partir de \"fruit, jaune, et acide\" amène forcément au mot \"citron\"!"
                            },
                            {
                                "example_id": "7475e44a-91c6-4918-a678-37156a5d980b",
                                "sense_id": "dace0ff5-6bec-3b70-affd-82cd584cf26b",
                                "text": "La traduction d'un mot vers une autre langue requiert une approche onomasiologique."
                            }
                        ]
                    }
                ],
