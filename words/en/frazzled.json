{
    "word_family": [
        "frazzle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f201c29-0e94-3c94-8c99-069430757cd3",
                    "sense_definition": "Stressed, nervous, and exhausted, usually due to overwork or worry.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt completely <w>frazzled</w> after organizing the large event by herself.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя совершенно <w>измотанной</w> после того, как в одиночку организовала это крупное мероприятие.",
                                "fr": "Elle se sentait complètement <w>épuisée</w> après avoir organisé le grand événement toute seule."
                            }
                        },
                        {
                            "text": "The <w>frazzled</w> parents tried to calm their crying baby in the restaurant.",
                            "target_lang_translations": {
                                "ru": "<w>Издерганные</w> родители пытались успокоить своего плачущего ребенка в ресторане.",
                                "fr": "Les parents <w>à bout de nerfs</w> essayaient de calmer leur bébé qui pleurait dans le restaurant."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhausted",
                        "stressed",
                        "worn out",
                        "harried"
                    ],
                    "antonyms": [
                        "calm",
                        "relaxed",
                        "composed",
                        "fresh"
                    ],
                    "common_phrases": [
                        "completely frazzled",
                        "look frazzled",
                        "feel frazzled",
                        "frazzled nerves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уставший, нервный и истощенный, обычно из-за переутомления или беспокойства.",
                        "fr": "Stressé, nerveux et épuisé, généralement en raison d'une surcharge de travail ou d'inquiétudes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "измотанный",
                                "target_lang_sense_clarification": "крайне уставший физически или морально"
                            },
                            {
                                "target_lang_word": "издерганный",
                                "target_lang_sense_clarification": "находящийся в состоянии нервного напряжения"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "épuisé",
                                "target_lang_sense_clarification": "extrêmement fatigué physiquement ou mentalement"
                            },
                            {
                                "target_lang_word": "à bout de nerfs",
                                "target_lang_sense_clarification": "dans un état de tension nerveuse extrême"
                            },
                            {
                                "target_lang_word": "surmené",
                                "target_lang_sense_clarification": "fatigué par un excès de travail"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcbeefbf-0359-344a-88d4-a0997dc699d4",
                    "sense_definition": "Worn out or frayed at the edges, typically referring to fabric or material.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a pair of old jeans with <w>frazzled</w> hems.",
                            "target_lang_translations": {
                                "ru": "На нем были старые джинсы с <w>обтрепанными</w> краями.",
                                "fr": "Il portait un vieux jean aux ourlets <w>effilochés</w>."
                            }
                        },
                        {
                            "text": "The ancient rope was <w>frazzled</w> and looked like it might snap at any moment.",
                            "target_lang_translations": {
                                "ru": "Старая веревка была <w>потрепана</w> и выглядела так, будто может порваться в любой момент.",
                                "fr": "La vieille corde était <w>effilochée</w> et semblait pouvoir rompre à tout moment."
                            }
                        }
                    ],
                    "synonyms": [
                        "frayed",
                        "tattered",
                        "worn",
                        "ragged"
                    ],
                    "antonyms": [
                        "intact",
                        "new",
                        "pristine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изношенный или обтрепанный по краям (обычно о ткани или материале).",
                        "fr": "Usé ou effiloché sur les bords, se dit généralement d'un tissu ou d'un matériau."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтрепанный",
                                "target_lang_sense_clarification": "имеющий растрепавшиеся края или нитки"
                            },
                            {
                                "target_lang_word": "потрепанный",
                                "target_lang_sense_clarification": "сильно изношенный"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "effiloché",
                                "target_lang_sense_clarification": "dont les fils se détachent sur les bords"
                            },
                            {
                                "target_lang_word": "usé",
                                "target_lang_sense_clarification": "abîmé par l'usage prolongé"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5058e3ea-5a8e-3ddc-b6c8-41c6d768e757",
                    "sense_definition": "Simple past and past participle of <w>frazzle</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat <w>frazzled</w> the electrical wires instantly.",
                            "target_lang_translations": {
                                "ru": "Сильный жар мгновенно <w>опалил</w> электрические провода.",
                                "fr": "La chaleur intense a instantanément <w>brûlé</w> les fils électriques."
                            }
                        },
                        {
                            "text": "Years of constant pressure finally <w>frazzled</w> his nerves.",
                            "target_lang_translations": {
                                "ru": "Годы постоянного давления окончательно <w>истрепали</w> ему нервы.",
                                "fr": "Des années de pression constante ont fini par <w>épuiser</w> ses nerfs."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола frazzle (изматывать, истрепывать, опалять).",
                        "fr": "Forme passée et participe passé du verbe frazzle (épuiser, user, brûler)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истрепал",
                                "target_lang_sense_clarification": "привел в негодность или измучил (о нервах)"
                            },
                            {
                                "target_lang_word": "опалил",
                                "target_lang_sense_clarification": "повредил огнем или жаром"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "épuisé",
                                "target_lang_sense_clarification": "avoir vidé quelqu'un de son énergie"
                            },
                            {
                                "target_lang_word": "brûlé",
                                "target_lang_sense_clarification": "endommagé par une chaleur intense"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}