                "senses": [
                    {
                        "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                        "entry_id": "7116c7a7-1bd6-3131-877a-ec5d14cf44b4",
                        "glosses": [
                            "eine Primzahl, die rückwärts gelesen eine andere Primzahl ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd20ff54-9837-4bd9-b105-618b31281077",
                                "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                                "text": "31 ist eine Mirpzahl."
                            },
                            {
                                "example_id": "7cc6b807-c7a0-41d0-afb4-f156d0a95488",
                                "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                                "text": "„Eine Mirpzahl ist im Grunde eine Spielerei, nämlich eine Primzahl, die rückwärts gelesen eine andere Primzahl ergibt.“"
                            },
                            {
                                "example_id": "31a4e4e0-b0b9-427d-98be-382700bcd483",
                                "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                                "text": "„Wir vermuten einen Fall von Überkompensation der Triskaidekaphobie, der abergläubischen Angst vor der Zahl 13, die sich u. a. dadurch auszeichnet, dass sie die erste Mirpzahl ist.“"
                            },
                            {
                                "example_id": "ae8415f7-ae0e-4963-8af5-800faf198ea2",
                                "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                                "text": "„Die Tafelrunde als Gleichnis für die kleinste Mirpzahl, den fünftenn Exponent einer Mersenne-Primzahl oder als zentrierte Quadratzahl?“"
                            },
                            {
                                "example_id": "7c564f99-6d79-427c-a3fc-a6472caa1bb9",
                                "sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                                "text": "„Die Dreizehn ist die sechste Primzahl, die zweite Wilson-Primzahl, eine zentrierte Quadratzahl und die kleinste Mirpzahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db78ac0e-592d-487e-bad3-0b1a6e173b5e",
                        "source_entry_id": "7116c7a7-1bd6-3131-877a-ec5d14cf44b4",
                        "source_sense_id": "baeba92d-e271-350d-b95d-f49a0665aeaf",
                        "source_sense_description": "Mathematik: eine Primzahl, die rückwärts gelesen eine andere Primzahl ergibt",
                        "target_lang_word": "emirp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emirp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee703da7-3301-3dca-bc24-829b413895b1",
                                        "entry_id": "e5aacb01-4898-3563-be43-a9aa90ff20e7",
                                        "glosses": [
                                            "A prime number that becomes a different prime when its decimal digits (or digits in some specified other base) are reversed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f028d34c-7648-4889-9b6a-c4e561ae88db",
                                                "sense_id": "ee703da7-3301-3dca-bc24-829b413895b1",
                                                "text": "The sequence of emirps begins: 13, 17, 31, 37, 71, 73, 79, 97, 107, ..."
                                            },
                                            {
                                                "example_id": "dbff023d-b1f8-4dc8-a4f0-e9c17e5542d6",
                                                "sense_id": "ee703da7-3301-3dca-bc24-829b413895b1",
                                                "text": "The first few emirps in base 12 (using the convention T for ten and E for eleven) are: 15, 51, 57, 5E, 75, E5, 107, ..."
                                            },
                                            {
                                                "example_id": "a075f307-9dbf-4b51-a169-c3190853d825",
                                                "sense_id": "ee703da7-3301-3dca-bc24-829b413895b1",
                                                "text": "Therefore we do not yet know whether the general emirps go on forever or whether they too eventually end with a largest emirp of all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
