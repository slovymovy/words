                "senses": [
                    {
                        "sense_id": "40416548-4296-3015-ac12-984a740f35c0",
                        "entry_id": "4367d96a-d251-3621-8bb0-21ec35cb0140",
                        "glosses": [
                            "Ensemble de signes utilisés pour représenter les phonèmes d’une langue, une certaine voyelle étant rajoutée à chaque consonne, sauf indication contraire (grâce à quelque chose qui indique la voyelle à utiliser ou l’absence de la voyelle)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3285edc5-cfcf-4843-8c82-508375972dc4",
                                "sense_id": "40416548-4296-3015-ac12-984a740f35c0",
                                "text": "Hélas, elle ne tarde pas à déchanter : si son oreille est habituée aux fréquences étrangères, l’alphasyllabaire local lui donne plus de fil à retordre qu’elle ne l’imaginait."
                            },
                            {
                                "example_id": "b53e6573-816d-4933-9da6-cea66d8bf858",
                                "sense_id": "40416548-4296-3015-ac12-984a740f35c0",
                                "text": "Un alphasyllabaire regroupe des caractères composites correspondant à des syllabes et, au sein de celles-ci, à des consonnes, et à des voyelles."
                            }
                        ]
                    }
                ],
