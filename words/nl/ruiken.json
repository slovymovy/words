                    "sense_definition": "Een geur waarnemen met de neus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zintuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ruik</w> verse koffie in de keuken.",
                            "target_lang_translations": {
                                "en": "I <w>smell</w> fresh coffee in the kitchen.",
                                "ru": "Я <w>чувствую запах</w> свежего кофе на кухне.",
                                "pl": "<w>Czuję</w> świeżą kawę w kuchni.",
                                "de": "Ich <w>rieche</w> frischen Kaffee in der Küche.",
                                "fr": "Je <w>sens</w> du café frais dans la cuisine.",
                                "it": "<w>Sento</w> odore di caffè fresco in cucina.",
                                "cs": "V kuchyni <w>cítím</w> čerstvou kávu.",
                                "tr": "Mutfakta taze kahve kokusu <w>alıyorum</w>.",
                                "es": "<w>Huelo</w> café recién hecho en la cocina."
                            }
                        },
                        {
                            "text": "Kan jij de bloemen in de tuin <w>ruiken</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>smell</w> the flowers in the garden?",
                                "ru": "Ты <w>чувствуешь</w> запах цветов в саду?",
                                "pl": "Czy możesz <w>poczuć</w> zapach kwiatów w ogrodzie?",
                                "de": "Kannst du die Blumen im Garten <w>riechen</w>?",
                                "fr": "Peux-tu <w>sentir</w> les fleurs du jardin ?",
                                "it": "Riesci a <w>sentire</w> i fiori in giardino?",
                                "cs": "Můžeš <w>cítit</w> ty květiny na zahradě?",
                                "tr": "Bahçedeki çiçeklerin kokusunu <w>alabiliyor</w> musun?",
                                "es": "¿Puedes <w>oler</w> las flores del jardín?"
                            }
                        }
                    ],
                    "common_phrases": [
