                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2b2020-69c2-414a-8406-a27d084c3c2b",
                                "sense_id": "69644a11-e59f-3557-9e15-3fb55f23eb4e",
                                "text": "Les lueurs clignotantes multicolorent les visages impassibles de Swaï Palmes d’Or et de l’androïde imparfait."
                            },
                            {
                                "example_id": "96f80e3d-a830-4a75-8f07-0503c0a700ae",
                                "sense_id": "69644a11-e59f-3557-9e15-3fb55f23eb4e",
                                "text": "Des cent mille espèces de papillons qui décomposent la matière et la lumière pour multicolorer leurs ailes avec plus d’audace et de nuance qu’un maître-verrier, retenons la Timandre aimée, de son nom noble, l’ACIDALIE."
                            }
                        ]
                    }
