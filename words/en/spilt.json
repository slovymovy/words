{
    "word_family": [
        "spill",
        "spillage",
        "spiller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da1bfa9b-f437-34b6-9499-58d4910986f2",
                    "sense_definition": "The simple past and past participle of <w>spill</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally <w>spilt</w> his coffee all over the clean white tablecloth.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>пролил</w> свой кофе на чистую белую скатерть."
                            }
                        },
                        {
                            "text": "The water had <w>spilt</w> onto the floor before I could grab a towel.",
                            "target_lang_translations": {
                                "ru": "Вода <w>пролилась</w> на пол, прежде чем я успел схватить полотенце."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «проливать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролил",
                                "target_lang_sense_clarification": "мужской род, прошедшее время"
                            },
                            {
                                "target_lang_word": "пролитый",
                                "target_lang_sense_clarification": "причастие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b71cccc7-59ed-35d0-8784-ea65a5a78db8",
                    "sense_definition": "Having been caused to flow or fall out of a container accidentally.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_being",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no use crying over <w>spilt</w> milk.",
                            "target_lang_translations": {
                                "ru": "Слезами горю не поможешь (букв. нет смысла плакать над <w>пролитым</w> молоком)."
                            }
                        },
                        {
                            "text": "She quickly wiped up the <w>spilt</w> juice from the kitchen counter.",
                            "target_lang_translations": {
                                "ru": "Она быстро вытерла <w>пролитый</w> сок с кухонной столешницы."
                            }
                        }
                    ],
                    "synonyms": [
                        "scattered",
                        "overflowed"
                    ],
                    "common_phrases": [
                        "spilt milk"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что случайно вылилось или вытекло из емкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пролитый",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "разлитый",
                                "target_lang_sense_clarification": "о жидкости, растекшейся по поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}