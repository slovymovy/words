                                        "examples": [
                                            {
                                                "example_id": "59e28701-03bf-4c2a-a66c-0ed8c140b25f",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "Well, the new restaurant seems nice, but their menu is a little blah."
                                            },
                                            {
                                                "example_id": "86052150-ae63-470b-a3c0-f9671030468f",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "He was struck by how much pleasure they seemed to take in their daytime lives, how blah their night work was by contrast, how altogether meaningless; […]"
                                            },
                                            {
                                                "example_id": "5ba1cfff-92e1-4fe5-9405-59f4cef5e44d",
                                                "sense_id": "f609658e-2340-32d0-9828-8138e8ac3a38",
                                                "text": "[…] although the show deliberately showcases various luxury goods […], the overall ambience is extraordinarily bare of style and beauty, offering instead a world of blah décor, undistinguished fashions and cavernous homes that just look like overpriced McMansions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3205b791-1b14-3188-8087-54ca593fb798",
                                        "entry_id": "4031d892-8c36-3ca2-9aa4-dc5d481031a8",
                                        "glosses": [
                                            "Low in spirit or health; down."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d72398dc-6373-4f30-bf87-fefc6b2aa785",
                                                "sense_id": "3205b791-1b14-3188-8087-54ca593fb798",
                                                "text": "I decided to go exercise rather than sit around all day feeling blah."
                                            }
                                        ]
                                    }
                                ]
                            },
