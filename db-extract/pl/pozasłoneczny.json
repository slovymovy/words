                "senses": [
                    {
                        "sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                        "entry_id": "ce8f1dfd-e19d-3e61-aadf-cde43bb91120",
                        "glosses": [
                            "znajdujący się poza Układem Słonecznym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9fbf8e9-36ef-4795-91cc-76a21e6e22af",
                                "sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                                "text": "Trzynaście lat temu prof. Aleksander Wolszczan znalazł pierwszy pozasłoneczny układ planetarny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "911360b8-8dfc-4a8c-bacf-eed9c1d85340",
                        "source_entry_id": "ce8f1dfd-e19d-3e61-aadf-cde43bb91120",
                        "source_sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                        "target_lang_word": "extrasolar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrasolar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd8d687b-d79c-3b32-b060-51bec31aa7cc",
                                        "entry_id": "b6124a87-2dd1-32b1-b1b1-1afa1ece603a",
                                        "glosses": [
                                            "of or originating outside the Solar System."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35b1372-32b4-44ea-8237-dc33bb85a5e5",
                                                "sense_id": "bd8d687b-d79c-3b32-b060-51bec31aa7cc",
                                                "text": "Some comets are thought to have an extrasolar origin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f85c8a41-d43d-3920-a29b-f8fa4d665822",
                                        "entry_id": "b6124a87-2dd1-32b1-b1b1-1afa1ece603a",
                                        "glosses": [
                                            "of or originating in a system other than Earth's, the solar system."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86b9677e-0987-44be-89a1-1fbd035593c2",
                                                "sense_id": "f85c8a41-d43d-3920-a29b-f8fa4d665822",
                                                "text": "A four-inch telescope was once used to find an extrasolar planet."
                                            },
                                            {
                                                "example_id": "56d00d08-a6da-48f8-acf9-70f87e8ca0f8",
                                                "sense_id": "f85c8a41-d43d-3920-a29b-f8fa4d665822",
                                                "text": "Of course, no one has any idea whether the extrasolar life is anything more than a few trillion microbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e509a8-a45b-4e2e-ae68-148729e49baa",
                        "source_entry_id": "ce8f1dfd-e19d-3e61-aadf-cde43bb91120",
                        "source_sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                        "target_lang_word": "extrasolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrasolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3cf1437-5c79-3e2a-b697-2f350fdd2ede",
                                        "entry_id": "83948264-d460-3091-83ee-94417c054b0f",
                                        "glosses": [
                                            "Qui est en dehors du Système solaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8de6d3-a01c-4694-8530-e303e0aeef29",
                                                "sense_id": "a3cf1437-5c79-3e2a-b697-2f350fdd2ede",
                                                "text": "Côté américain, le télescope Kepler a récemment découvert une exoplanète (Un exoplanète ou planète extrasolaire désigne une planète orbitant autour d'une étoile autre que le Soleil."
                                            },
                                            {
                                                "example_id": "b1263399-24f6-4f7e-b359-1eedaba31530",
                                                "sense_id": "a3cf1437-5c79-3e2a-b697-2f350fdd2ede",
                                                "text": "La chasse a été ouverte en 1995, quand deux scientifiques suisses de l'observatoire de Genève , Michel Mayor et Didier Queloz, ont annoncé la toute première planéte extrasolaire, baptisée 51 Pegasi b … ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "facaf185-6e26-41c7-8050-ebaaca25ecce",
                        "source_entry_id": "ce8f1dfd-e19d-3e61-aadf-cde43bb91120",
                        "source_sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                        "target_lang_word": "extrasolar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrasolar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "126bde8e-ee9a-3376-86e8-90ac0e1f5cbb",
                                        "entry_id": "d00f6876-c46b-3331-81e9-54b957ba9def",
                                        "glosses": [
                                            "Propio o proveniente de fuera del Sistema Solar."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c97248-78c6-454d-b7d7-a3d491691f48",
                        "source_entry_id": "ce8f1dfd-e19d-3e61-aadf-cde43bb91120",
                        "source_sense_id": "ea630f86-76e0-3390-ad5b-d8ede2967be6",
                        "target_lang_word": "extrasolar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extrasolar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c46c3684-8753-3b9a-b8ae-442998d2582c",
                                        "entry_id": "7852add1-55a8-3655-928b-7d8b6c509840",
                                        "glosses": [
                                            "außerhalb des Sonnensystems"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3da59279-5a1d-4369-bda9-29908ee4c627",
                                                "sense_id": "c46c3684-8753-3b9a-b8ae-442998d2582c",
                                                "text": "Die Frage nach extrasolaren Planeten wird sich dann wohl mit erstklassigen Bildern beantworten lassen."
                                            },
                                            {
                                                "example_id": "65708e61-a9a5-40b0-804b-8a53ca7b59af",
                                                "sense_id": "c46c3684-8753-3b9a-b8ae-442998d2582c",
                                                "text": "55 Cancri c ist ein extrasolarer Planet, der die Komponente A des Doppelsternsystems 55 Cancri umkreist."
                                            },
                                            {
                                                "example_id": "25c23a13-95e5-4a31-b074-841d3b2919bf",
                                                "sense_id": "c46c3684-8753-3b9a-b8ae-442998d2582c",
                                                "text": "Mehr als 300 extrasolare Planeten sind inzwischen bekannt – doch alle wurden nur indirekt über Bahn- oder Helligkeitsschwankungen entdeckt, die sie bei ihrem Mutterstern hervorrufen."
                                            },
                                            {
                                                "example_id": "52f6f6d0-5659-47bb-ad7a-ed2564711de4",
                                                "sense_id": "c46c3684-8753-3b9a-b8ae-442998d2582c",
                                                "text": "Den Aufbau rund 25 extrasolarer Planetensysteme haben Astronomen bislang genauer erkundet – doch keines davon ähnelt unserem eigenen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
