                    "sense_id": "16c8cca1-1bcf-3b6f-905c-a9de8168795d",
                    "sense_definition": "an allen Orten; an jeder Stelle",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "ort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir haben <w>überall</w> im Haus nach meiner Brille gesucht.",
                            "target_lang_translations": {
                                "en": "We looked <w>everywhere</w> in the house for my glasses.",
                                "ru": "Мы искали мои очки <w>везде</w> в доме.",
                                "nl": "We hebben <w>overal</w> in huis naar mijn bril gezocht.",
                                "pl": "Szukaliśmy moich okularów <w>wszędzie</w> w domu.",
                                "fr": "Nous avons cherché mes lunettes <w>partout</w> dans la maison.",
                                "it": "Abbiamo cercato i miei occhiali <w>dappertutto</w> in casa.",
                                "cs": "Hledali jsme moje brýle <w>všude</w> po domě.",
                                "tr": "Gözlüğümü evin <w>her yerinde</w> aradık.",
                                "es": "Buscamos mis gafas <w>por todas partes</w> en la casa.",
                                "zh": "我们在屋里<w>到处</w>寻找我的眼镜。"
                            }
                        },
                        {
                            "text": "Menschen nutzen heutzutage fast <w>überall</w> auf der Welt das Internet.",
                            "target_lang_translations": {
                                "en": "Nowadays, people use the internet almost <w>everywhere</w> in the world.",
                                "ru": "В наши дни люди пользуются интернетом почти <w>повсюду</w> в мире.",
                                "nl": "Mensen gebruiken tegenwoordig bijna <w>overal</w> ter wereld internet.",
                                "pl": "W dzisiejszych czasach ludzie korzystają z internetu prawie <w>wszędzie</w> na świecie.",
                                "fr": "De nos jours, les gens utilisent Internet presque <w>partout</w> dans le monde.",
                                "it": "Oggi le persone usano Internet quasi <w>ovunque</w> nel mondo.",
                                "cs": "V dnešní době lidé používají internet téměř <w>všude</w> na světě.",
                                "tr": "Günümüzde insanlar dünyanın neredeyse <w>her yerinde</w> internet kullanıyor.",
                                "es": "Hoy en día, la gente usa internet casi <w>en todas partes</w> del mundo.",
                                "zh": "如今，人们在世界上几乎<w>到处</w>都在使用互联网。"
                            }
                        }
