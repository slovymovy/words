                ],
                "translations": [
                    {
                        "translation_id": "5d2f051f-2a02-48ef-8bc9-2fb60960ff93",
                        "source_entry_id": "f8e2fbbf-6c94-3708-b18e-6248a15143c1",
                        "source_sense_id": "c0c0f2b8-2e25-355a-8ebc-c42e28ddff4f",
                        "source_sense_description": "Person, die einem Golfspieler auf dem Platz die Ausrüstung trägt und ihn berät",
                        "target_lang_word": "caddy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4288ee9-cba8-3e47-9051-032beca11171",
                                        "entry_id": "1b37ac34-8e5e-3c6a-a867-c99277921009",
                                        "glosses": [
                                            "A small box or tin (can) with a lid for holding dried tea leaves used to brew tea."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91fa7df8-58ca-4c66-bd75-71e158bee910",
                                                "sense_id": "a4288ee9-cba8-3e47-9051-032beca11171",
                                                "text": "The Carneses imported lacquer teapoys in sets. These sets could be easily stacked in a corner of the drawing room and brought out at teatime to hold a teacup, a set, or a caddy. The Carneses purchased lacquered teapoys sets for four dollars in China and probably sold them for twice that amount in America."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83ec6e59-4851-397e-8069-26d9f0472977",
                                        "entry_id": "1b37ac34-8e5e-3c6a-a867-c99277921009",
                                        "glosses": [
                                            "A (usually small) box, chest, or tin with a lid, and often with partitions, used to keep things in."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "355730d8-7913-44df-97a1-48439c170855",
                                                "sense_id": "83ec6e59-4851-397e-8069-26d9f0472977",
                                                "text": "A sauce caddy brought with the tacos offers a choice of salsa cruda, a thin puree of tomatillos, and an emulsion of red chilies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8cdbad-8761-384b-a035-dcecb4d0e3ed",
                                        "entry_id": "1b37ac34-8e5e-3c6a-a867-c99277921009",
                                        "glosses": [
                                            "A small lidded bin for food waste."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0269c64b-d7dd-3d55-9e6f-4107d2ef73be",
                                        "entry_id": "1b37ac34-8e5e-3c6a-a867-c99277921009",
                                        "glosses": [
                                            "A movable tray or other mechanism for holding (sometimes within a piece of equipment or machinery), securing, and transporting a removable component."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e8aa335-133f-40c7-9d63-d82114bbf803",
                                                "sense_id": "0269c64b-d7dd-3d55-9e6f-4107d2ef73be",
                                                "text": "Place the disc in the DVD caddy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d0f468-0c6d-334a-8eba-76f1ab3f7db9",
                                        "entry_id": "1b37ac34-8e5e-3c6a-a867-c99277921009",
                                        "glosses": [
                                            "A lightweight wheeled cart; specifically, one attached to a bicycle as a conveyance for a child, or pulled by hand and used to transport groceries away from a shop."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15918126-59f2-3a18-b1e5-c9f668a5da42",
                                        "entry_id": "02b90af5-2d38-338f-8767-5f438e23abd3",
                                        "glosses": [
                                            "Alternative spelling of caddie (“a person hired to assist a golfer by carrying their golf clubs and providing advice”)."
                                        ],
                                        "tags": [
                                            "also",
                                            "alt-of",
                                            "alternative",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5314a1c7-37e1-4247-9859-fee769ab8201",
                                                "sense_id": "15918126-59f2-3a18-b1e5-c9f668a5da42",
                                                "text": "Caddy, pass me my five iron."
                                            },
                                            {
                                                "example_id": "d3c3e70b-b6ae-42c4-a6c2-da62d5f69068",
                                                "sense_id": "15918126-59f2-3a18-b1e5-c9f668a5da42",
                                                "text": "As caddy I had to carry the clubs, for there are four varieties almost everyone used, and some used more. Besides doing this, the caddy has to keep score of the number of strokes used, and watch and find each ball."
                                            },
                                            {
                                                "example_id": "b60bb1ab-24b1-41c5-bc26-ec9ccf3f8757",
                                                "sense_id": "15918126-59f2-3a18-b1e5-c9f668a5da42",
                                                "text": "Then Carter Chapman picked out his putter, stepped confidently up to the ball, sighted once along the ground, and made his stroke. The ball rolled straight as a die toward the caddy who was holding the flag, and tinkled into the cup for a birdie three!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "524fac7d-d696-32f5-ba10-ba38a7f31c35",
                                        "entry_id": "9c3dd19c-20d5-3f5c-8a4b-017472715c33",
                                        "glosses": [
                                            "Chiefly followed by for: alternative spelling of caddie (“to serve as a caddy (noun sense) for a golfer”)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe9e1d0-a490-4c3a-80c5-392762c58518",
                                                "sense_id": "524fac7d-d696-32f5-ba10-ba38a7f31c35",
                                                "text": "I was honored to caddy for Tiger Woods at a charity golf game."
                                            },
                                            {
                                                "example_id": "233227a2-05a7-4bdf-bf97-15e4a3e4cbbe",
                                                "sense_id": "524fac7d-d696-32f5-ba10-ba38a7f31c35",
                                                "text": "We took turns caddying, one caddying, two playing. We went out across the river to the teeing ground of the first hole."
                                            },
                                            {
                                                "example_id": "ab7a4375-a7d8-4637-9687-b7b5659a4392",
                                                "sense_id": "524fac7d-d696-32f5-ba10-ba38a7f31c35",
                                                "text": "The next day the thirty-two qualifying players were paired off into sixteen sets of opponents. Charlotte was matched against a girl from California. After the first few minutes, the result was never in doubt. \"Take it easy, miss,\" said the highly gratified Mr. Ogilvie, who was caddying for Charlotte. \"You hold her in the hollow of your hand.\""
                                            },
                                            {
                                                "example_id": "7b6f2517-bdcf-4730-8436-a44b2aa77f44",
                                                "sense_id": "524fac7d-d696-32f5-ba10-ba38a7f31c35",
                                                "text": "The scheme had been, if I remember, that after lunch I should go off and caddy for Honoria on a shopping tour down Regent Street; but when she got up and started collecting me and the rest of her things, Aunt Agatha stopped her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5c2269e-8cb7-4bee-a521-fb320cd65ccc",
                        "source_entry_id": "f8e2fbbf-6c94-3708-b18e-6248a15143c1",
                        "source_sense_id": "c0c0f2b8-2e25-355a-8ebc-c42e28ddff4f",
                        "source_sense_description": "Person, die einem Golfspieler auf dem Platz die Ausrüstung trägt und ihn berät",
                        "target_lang_word": "caddie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40a65820-4e9d-38b6-9296-ea3be7e557c8",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "Synonym of cadet (“a gentleman (often a younger son from a noble family) who joined the military without a commission as a career”)."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "also",
                                            "attributive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b76af762-03cd-3fb6-a81a-74fe4220dc9a",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A young man; a boy, a lad; specifically (derogatory), one regarded as of low social status; a ragamuffin."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06ad347-b442-4a00-8630-c29fac997719",
                                                "sense_id": "b76af762-03cd-3fb6-a81a-74fe4220dc9a",
                                                "text": "But gie him't het, my hearty cocks! / E'en cowe the cadie!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A person engaged to run errands such as carrying goods and messages; a commissionaire, an errand boy or errand girl, a gofer; specifically, a member of an organized group of such persons working in large Scottish cities and towns in the early 18th century."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "225b500e-4168-415a-8daf-640c2e0bc319",
                                                "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                                "text": "A tattered cadie, or errand porter, whom David Deans had jostled in his attempt to extricate himself from the vicinity of the scorners, exclaimed in a strong north-country tone, \"Ta de'il ding out her Cameronian een—what gi'es her titles to dunch gentlemans about?\""
                                            },
                                            {
                                                "example_id": "bd715b45-df7b-49cf-b238-078f8c0b8374",
                                                "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                                "text": "There would be a prosperity such as might seem fabulous, a prosperity of which every Scotchman, from the peer to the cadie, would partake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A person hired to assist a golfer by carrying their golf clubs and providing advice."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766b7691-ed30-4e8e-bd74-3fa40270e48d",
                                                "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                                "text": "As caddy I had to carry the clubs, for there are four varieties almost everyone used, and some used more. Besides doing this, the caddy has to keep score of the number of strokes used, and watch and find each ball."
                                            },
                                            {
                                                "example_id": "ab9037bf-0e16-4a3a-bebb-404daa63fffa",
                                                "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                                "text": "Then Carter Chapman picked out his putter, stepped confidently up to the ball, sighted once along the ground, and made his stroke. The ball rolled straight as a die toward the caddy who was holding the flag, and tinkled into the cup for a birdie three!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                        "entry_id": "639cfc58-6088-3159-878f-bbf84a74e5c6",
                                        "glosses": [
                                            "Chiefly followed by for: to serve as a caddie (noun sense 2) for a golfer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a1926c-1d49-4675-9bcc-50f7d28cb421",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "We took turns caddying, one caddying, two playing. We went out across the river to the teeing ground of the first hole."
                                            },
                                            {
                                                "example_id": "88e7f996-325d-4019-a54f-16db8af6fe2a",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "The next day the thirty-two qualifying players were paired off into sixteen sets of opponents. Charlotte was matched against a girl from California. After the first few minutes, the result was never in doubt. \"Take it easy, miss,\" said the highly gratified Mr. Ogilvie, who was caddying for Charlotte. \"You hold her in the hollow of your hand.\""
                                            },
                                            {
                                                "example_id": "51b64d25-1ce2-43a9-bc26-027a262e5abd",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "The scheme had been, if I remember, that after lunch I should go off and caddy for Honoria on a shopping tour down Regent Street; but when she got up and started collecting me and the rest of her things, Aunt Agatha stopped her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
