                {
                    "sense_id": "af05ec4c-7ef3-323e-a0df-886f2d9835c9",
                    "sense_definition": "Simple past and past participle of <w>bake</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother <w>baked</w> a delicious apple pie for us.",
