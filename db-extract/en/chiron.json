                "word": "Chiron",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7bc0de68-3640-3674-942f-f48cefddc527",
                        "entry_id": "3e5569f0-0cb6-39af-a544-7784d16a7c15",
                        "glosses": [
                            "An old, wise centaur who served as Achilles' mentor and teacher."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8f2660ad-3379-3376-83fd-5b07bb0ec767",
                        "entry_id": "3e5569f0-0cb6-39af-a544-7784d16a7c15",
                        "glosses": [
                            "A centaur (minor planet) and comet-like/asteroid-like object, orbiting between Saturn and Uranus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f10163a9-da37-3cb2-895b-666cfc1b2894",
                        "entry_id": "3e5569f0-0cb6-39af-a544-7784d16a7c15",
                        "glosses": [
                            "A male given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
