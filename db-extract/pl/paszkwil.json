                "senses": [
                    {
                        "sense_id": "ae0b055b-d1d8-39ca-9650-9d5e0b2cb3e3",
                        "entry_id": "159981cd-d1dc-3aea-8a3d-d42f733ef37a",
                        "glosses": [
                            "publikacja brukająca czyjąś reputację"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfd27f9-85e9-4e6f-8d54-3f3294271b02",
                                "sense_id": "ae0b055b-d1d8-39ca-9650-9d5e0b2cb3e3",
                                "text": "Premier skarżył się, że jest regularnie szkalowany paszkwilami w prasie."
                            },
                            {
                                "example_id": "62345bef-9040-4527-b4f0-1beafa4fee89",
                                "sense_id": "ae0b055b-d1d8-39ca-9650-9d5e0b2cb3e3",
                                "text": "Podczas rządów Władysława Jagiełły został w 1410 powołany na sekretarza kancelarii królewskiej, lecz pozbawiony tej funkcji w 1419 roku za napisanie paszkwilu na królową Elżbietę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edaea773-8d7b-4477-ba23-dd6fd5b6177b",
                        "source_entry_id": "159981cd-d1dc-3aea-8a3d-d42f733ef37a",
                        "source_sense_id": "ae0b055b-d1d8-39ca-9650-9d5e0b2cb3e3",
                        "target_lang_word": "lampoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lampoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b90dfe00-c1e9-3dd3-a83b-e638164af95d",
                                        "entry_id": "d1577b58-642b-3d2b-9714-415d9964c636",
                                        "glosses": [
                                            "A written attack or other work ridiculing a person, group, or institution; especially, a satirical one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774698c1-e91a-4ae7-aea5-88459a278368",
                                                "sense_id": "b90dfe00-c1e9-3dd3-a83b-e638164af95d",
                                                "text": "To say truth, Ma'am, 'tis very vulgar to Print and as my little Productions are mostly Satires and Lampoons I find they circulate more by giving copies in confidence to the Friends of the Parties—"
                                            },
                                            {
                                                "example_id": "b90c6354-8e97-4eb0-8ac9-ca0eda51cd89",
                                                "sense_id": "b90dfe00-c1e9-3dd3-a83b-e638164af95d",
                                                "text": "\"Dangerous things, sir—dangerous things!\" exclaimed Mr. Lintot, drawing a deep breath of air from the open window: \"do you know, sir, Curl published a lampoon on Lord Hervey the other day, who said that he would have horsewhipped him if he could have found his way into the city..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lampoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24e673c4-fe1d-3a57-8c56-29b7eeb22a4b",
                                        "entry_id": "637155ea-a6c9-3c38-ac1a-49ced8536760",
                                        "glosses": [
                                            "To satirize or poke fun at."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde36e58-7ecd-4906-880e-0b56eadefdf2",
                                                "sense_id": "24e673c4-fe1d-3a57-8c56-29b7eeb22a4b",
                                                "text": "Her tone shift involved former Presidents Barack Obama and Bill Clinton lampooning their fellow ex-president as a figure of ridicule. Then Harris closed the trap with a line in her convention speech: “Trump is an unserious man. But the consequences … of putting Donald Trump back in the White House are extremely serious.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a3021dd-135f-4032-8286-b04bcc987acf",
                        "source_entry_id": "159981cd-d1dc-3aea-8a3d-d42f733ef37a",
                        "source_sense_id": "ae0b055b-d1d8-39ca-9650-9d5e0b2cb3e3",
                        "target_lang_word": "libelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c41c8b2b-8d84-3a81-ae28-053bfbf50100",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Placet, petit écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70f5c233-17b6-4da3-8e32-5a55a832f410",
                                                "sense_id": "c41c8b2b-8d84-3a81-ae28-053bfbf50100",
                                                "text": "Faiseur de libelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Acte signifié par écrit."
                                        ],
                                        "tags": [
                                            "Droit romain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f6aed5b-8462-492c-b419-a28b5d893727",
                                                "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                                "text": "Libelle de divorce, acte par lequel un époux annonçait à l'autre qu'il divorçait."
                                            },
                                            {
                                                "example_id": "b070a1a2-320b-44b0-9770-e8685bc5bf64",
                                                "sense_id": "8c77b148-9355-31c3-b26c-c27cc36dfee4",
                                                "text": "Libelle de proclamation, action intentée en justice pour obtenir la réparation d'un dommage quelconque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                        "entry_id": "8ecf4c45-515f-348e-8c61-668cbabf1eda",
                                        "glosses": [
                                            "Écrit, ordinairement court, injurieux, diffamatoire ou calomnieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc644cb4-f5b1-4b9e-b68b-7f5298f8a08b",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Si je me présente ici, c'est pour ne pas manquer une occasion solennelle d'éclaircir des faits, que mon profond mépris pour les libelles, et mon insouciance trop grande pour les bruits calomnieux, ne m'ont jamais permis d'attaquer hors de cette Assemblée."
                                            },
                                            {
                                                "example_id": "86f6da99-7fce-40ba-8ece-ecb066f92dda",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Que l'on veuille bien ne pas considérer ce livre comme un libelle à l'adresse du Maroc. Personnellement, j'aime ce pays tel que je l'ai connu et je lui suis reconnaissant de la vie nomade et libre que j'y ai menée pendant bien des mois."
                                            },
                                            {
                                                "example_id": "8326f5be-dd01-4ce5-a1b8-3fff7e30ac16",
                                                "sense_id": "c8822a66-097f-3f57-a6c3-07fa2d15261c",
                                                "text": "Les chrétiens s’efforcèrent d’agir sur l’opinion publique en diffusant une série de libelles, […], où les juifs étaient dépeints sous les traits les plus odieux."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
