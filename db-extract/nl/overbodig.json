                ],
                "senses": [
                    {
                        "sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                        "entry_id": "90cbc6aa-5f15-335f-8f1d-6dbdfaba793c",
                        "glosses": [
                            "niet of niet langer nodig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6017f177-1387-4e5d-8b38-198d830afae9",
                                "sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                                "text": "Daarmee is die procedure alleen maar overbodiger geworden."
                            },
                            {
                                "example_id": "bdb1dedc-dbce-42ab-9d97-2fa46f98839c",
                                "sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                                "text": "Ik wilde van veel overbodige spullen af."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8c42521-bd2d-427d-b33d-c84a8cc2733b",
                        "source_entry_id": "90cbc6aa-5f15-335f-8f1d-6dbdfaba793c",
                        "source_sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                        "target_lang_word": "overflowing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overflowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8ba6f09-29db-3725-b2bd-e1d2fc19f7c7",
                                        "entry_id": "271948e8-d05e-32c9-97a4-546ed724efa8",
                                        "glosses": [
                                            "overflow"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "898dc266-0a43-4c32-9c8a-54a3f0e344f2",
                                                "sense_id": "c8ba6f09-29db-3725-b2bd-e1d2fc19f7c7",
                                                "text": "[T]hough he had, as it were, from the overflowings of his heart, given Sophia as a toast among the officers, where he thought it was impossible she should be known; yet, even there, the reader may remember how difficultly he was prevailed upon to mention her surname."
                                            },
                                            {
                                                "example_id": "cf76dc11-c57d-4ee3-8ac6-6afc0a814bd0",
                                                "sense_id": "c8ba6f09-29db-3725-b2bd-e1d2fc19f7c7",
                                                "text": "the great overflowings and recedings of the waters"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overflowing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e605f39-86da-37da-85d5-c4a9b3cfa2f3",
                                        "entry_id": "ce19bde9-b56b-3c7b-89ac-dce1acc028fd",
                                        "glosses": [
                                            "present participle and gerund of overflow"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7da51c6b-bfed-4d53-8555-e5c2ff25732a",
                        "source_entry_id": "90cbc6aa-5f15-335f-8f1d-6dbdfaba793c",
                        "source_sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                        "target_lang_word": "superfluous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superfluous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                        "entry_id": "0d4a640d-b010-30a1-9949-2e95d86eff2b",
                                        "glosses": [
                                            "In excess of what is required or sufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77362d98-2f9e-44e6-9adf-eb10b1229484",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "With a full rain suit, carrying an umbrella may be superfluous."
                                            },
                                            {
                                                "example_id": "35ad54e6-a8c0-48a7-a66b-d7855c96647e",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "Then I began to play in timid fashion, venturing only twenty or thirty gulden at a time. Meanwhile, I observed and took notes. It seemed to me that calculation was superfluous, and by no means possessed of the importance which certain other players attached to it, even though they sat with ruled papers in their hands, whereon they set down the coups, calculated the chances, reckoned, staked, and—lost exactly as we more simple mortals did who played without any reckoning at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6b3930d-1b71-400b-a815-1fab1c1faf80",
                        "source_entry_id": "90cbc6aa-5f15-335f-8f1d-6dbdfaba793c",
                        "source_sense_id": "50e32c4c-4426-38e9-9e25-eaab1f826169",
                        "target_lang_word": "superfluo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superfluo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "3ecb1fb9-10e6-36d9-95fa-f74178f59494",
                                        "entry_id": "20cc4cfc-1997-3ac8-a100-943a372992bd",
                                        "glosses": [
                                            "Innecesario, sin función alguna, ni utilidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "124f6821-6c40-4786-a08c-9750ce223010",
                                                "sense_id": "3ecb1fb9-10e6-36d9-95fa-f74178f59494",
                                                "text": "El término superfluo remitía originalmente a las ideas de abundancia, prodigalidad y exuberancia. Progresivamente, ha ido derivando hacia nociones de connotación peyorativa, como pomposo, fútil o innecesario. Esta depreciación interpretativa desde lo superabundante a lo sobrante, lo superficial y frívolo proviene de una concepción moral muy austera, severa y restrictiva. Están aquí en juego dos concepciones opuestas del mundo, las que representan, por ejemplo, Rousseau y Voltaire. Y, en medio, Joseph Fouché, el eterno equidistante."
                                            },
                                            {
                                                "example_id": "71702ccc-8bf4-4cab-9fd9-7a4f407b377f",
                                                "sense_id": "3ecb1fb9-10e6-36d9-95fa-f74178f59494",
                                                "text": "Elimine cualquier comentario superfluo del código antes de implementar el proyecto."
                                            },
                                            {
                                                "example_id": "e8ae01c0-18b8-4d33-9ae5-962d7f63dcad",
                                                "sense_id": "3ecb1fb9-10e6-36d9-95fa-f74178f59494",
                                                "text": "Con esta crisis lo mejor es que eliminemos los gastos superfluos en cosas que sean prescindibles."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
