                "senses": [
                    {
                        "sense_id": "47686d6c-a9e9-38b0-beec-31034fabc8e6",
                        "entry_id": "86981514-584f-33ae-9a71-8376e51b5f59",
                        "glosses": [
                            "Faire, souvent inutilement, une chose en double."
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "a851e746-8513-4650-aef3-4e97472243da",
                                "sense_id": "47686d6c-a9e9-38b0-beec-31034fabc8e6",
                                "text": "Devons-nous continuer à consacrer une part importante de nos ressources à duplifier l'effort que notre partenaire a déjà fait ou n'est-il pas préférable d'utiliser ces ressources à faire ensemble des choses nouvelles ?"
                            },
                            {
                                "example_id": "d0c09e81-c07f-489a-af65-7860b62d58d3",
                                "sense_id": "47686d6c-a9e9-38b0-beec-31034fabc8e6",
                                "text": "Une manière de contourner cette difficulté consiste à duplifier tous les sommets intermédiaires de ces chemins (...)"
                            }
                        ]
                    }
                ],
