                "senses": [
                    {
                        "sense_id": "3a65d51c-ce28-3fb5-a285-5c18039efcae",
                        "entry_id": "b2cec73c-82b2-39c0-bc03-c423ef716ef5",
                        "glosses": [
                            "Stale brioche, spread with almond cream and sliced almonds and then baked"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1238ed12-65c0-44c9-9f7f-3ad57a13a933",
                                "sense_id": "3a65d51c-ce28-3fb5-a285-5c18039efcae",
                                "text": "To make a single portion of bostock, cut a slice of brioche ½ to ¾ inch thick."
                            },
                            {
                                "example_id": "263df951-ce66-4943-b0cb-e86a2deb5aad",
                                "sense_id": "3a65d51c-ce28-3fb5-a285-5c18039efcae",
                                "text": "It was also where I had my first taste of bostock, a French pastry originally devised as a thrifty way to use up stale brioche."
                            },
                            {
                                "example_id": "8681008f-cb00-45ff-be0f-18468ddb6ae3",
                                "sense_id": "3a65d51c-ce28-3fb5-a285-5c18039efcae",
                                "text": "It’s walk-up only, so plan on enjoying your tarts, bostocks, sourdough loaves, and coffee (drip only; no espresso drinks) elsewhere."
                            },
                            {
                                "example_id": "761145b7-fd7b-4e3d-8556-c96d96521937",
                                "sense_id": "3a65d51c-ce28-3fb5-a285-5c18039efcae",
                                "text": "Stale pastries never seem to be a problem in my house, so I buy sliced brioche to make these bostocks: think of them as a hybrid of a brioche bun and an almond croissant."
                            }
                        ]
                    }
                ],
