                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce0bf66c-ddec-485a-ab4e-3ab3907c6fa1",
                        "source_entry_id": "76ef02b2-f772-3479-89ce-11a6dae03706",
                        "source_sense_id": "f9bcd402-3189-3933-9b47-1de9264007fd",
                        "target_lang_word": "calomnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calomnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Attaquer, blesser quelqu’un par des calomnies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559b23af-7710-455f-86dd-2229b57a89ac",
                                                "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                                "text": "Il aurait été exclu du groupe de Tiflis pour en avoir calomnié certains membres afin d'acquérir lui-même plus d'autorité."
                                            },
                                            {
                                                "example_id": "89e14aaf-658d-4d3f-8019-15f6514ba459",
                                                "sense_id": "5a7f14bf-8619-32ce-8eea-4d0b00228c1b",
                                                "text": "Qu’il avoue avoir calomnié la comtesse Ludwig de Godesberg, et je le laisse libre d’aller faire pénitence où il voudra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Critiquer en mal, en parlant des actions, des intentions, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb67760f-816e-4232-a4e9-db78fce5e89d",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Si les pièces qu'on y insère n'ont pas toutes le même mérite, au moins est-on sûr de n'y jamais rencontrer de ces fades et plattes rimailles qui, tant de fois on servi de prétexte à calomnier la Poésie."
                                            },
                                            {
                                                "example_id": "9d230c0d-8283-4169-883d-c734a33c8393",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Haï, Épicure le fut et le sera parce qu'il est un des héros de l'humanité. […]. Et si, à sa suite, l'ensemble de l’épicurisme fut maudit, et calomnié comme libertinage dévergondé, c'est parce qu'il guérit de la peur dont tout pouvoir, religieux ou politique, a besoin !"
                                            },
                                            {
                                                "example_id": "9e8b909b-935a-4979-8b9e-5172bb52eeaa",
                                                "sense_id": "34eeed0c-82b3-31af-a2ac-a4bc9a11a0e1",
                                                "text": "Se plaire à mentir et à calomnier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95815abe-792a-3171-ba39-85ae3e2d7681",
                                        "entry_id": "58844e8d-3123-3c48-bf13-0265efef3c6b",
                                        "glosses": [
                                            "Dégrader, déqualifier la perception, ne pas rendre honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8cf789-e19f-468f-af86-fb2716815801",
                                                "sense_id": "95815abe-792a-3171-ba39-85ae3e2d7681",
                                                "text": "Puis l’idée me vint que cet homme était vêtu de cotonnade bleue, alors qu’un sauvage eût été nu, et d’après ce que j’essayai de me persuader qu’il était probablement d’un caractère très pacifique et que la morne férocité de son aspect le calomniait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
