    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "28f84d4d-9a94-3dc5-a84a-ecae21a908ec",
                    "sense_definition": "To cause someone to go insane or lose their mental balance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The extreme isolation and fear began to <w>derange</w> his mind over the long winter months."
                        },
                        {
                            "text": "Tragic grief threatened to completely <w>derange</w> the young soldier."
                        }
                    ],
                    "synonyms": [
                        "crazify",
                        "unhinge"
                    ],
                    "common_phrases": [
                        "derange the mind"
                    ]
                },
                {
                    "sense_id": "6a7833d2-b7c7-38a7-b0ca-63201dfbcfc6",
                    "sense_definition": "To throw something into confusion or disorder; to disturb the regular arrangement of.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden economic crisis threatened to <w>derange</w> the natural distribution of resources."
                        },
                        {
                            "text": "Sudden gusts of wind would <w>derange</w> the neat piles of documents on her desk."
                        }
                    ],
                    "synonyms": [
                        "disarrange",
                        "disorder",
                        "disorganize"
                    ],
                    "antonyms": [
