                "senses": [
                    {
                        "sense_id": "58dab55a-5e9e-3f4a-aa27-45c95cd93d35",
                        "entry_id": "56165b00-f1db-32b7-b1c0-982d77f687cf",
                        "glosses": [
                            "хим. простой углевод (моносахарид), содержащий на одну гидроксильную группу меньше, чем рибоза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1f970c-f446-4fe9-b5b6-904af1923978",
                                "sense_id": "58dab55a-5e9e-3f4a-aa27-45c95cd93d35",
                                "text": "В каждой из двух длиннейших цепей, составляющих молекулу, правильно чередуются звенья из сахара (дезоксирибозы) и фосфата, к которым, подобно зубьям гребенки, прикреплены молекулы четырех азотистых оснований: гуанина, цитозина, аденина и тимина."
                            }
                        ]
                    }
