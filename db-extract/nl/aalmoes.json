                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c14264c-af06-43f1-b8ed-71312524d0ea",
                        "source_entry_id": "b1a13cb6-ce8f-33d0-9bfd-f36a2fee0806",
                        "source_sense_id": "b198d3dd-1129-33ac-ad4a-e344ae66beee",
                        "source_sense_description": "Almosen, Scherflein",
                        "target_lang_word": "Almosen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Almosen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                        "entry_id": "bfcdc966-af6f-3383-9d45-23c7b71c10c3",
                                        "glosses": [
                                            "kleine materielle Unterstützung für eine bedürftige Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf38c9a-ddf2-44ab-b315-dec1e6ca063c",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "Sie gab dem Bettler ein Almosen."
                                            },
                                            {
                                                "example_id": "dac64a99-bd5d-43ac-934d-cd5ca0236bb7",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Das wird mit den auf Almosen zielenden Legenden, von denen die Chroniken Kenntnis geben, nicht anders gewesen sein.“"
                                            },
                                            {
                                                "example_id": "0123573e-a99e-4226-8e88-334d0b2ce7c6",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Der einzige Unterschied besteht darin, dass Lwandle heute kein Lager für überarbeitete Männer mehr ist, sondern arbeitslose Familien beherbergt, die sich mit Almosen und Hilfsarbeiten über Wasser halten.“"
                                            },
                                            {
                                                "example_id": "1b5d34da-0f6d-4f77-bcdd-7515e4157da6",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Im frommen Nandgaon fand Tilak gute Bedingungen für seinen Plan, ein Sannyasin zu werden, welcher der Welt und allen Besitztümern entsagt, meditiert und sich ausschließlich von Almosen ernährt.“"
                                            },
                                            {
                                                "example_id": "5ecfa33b-1b79-4e45-93c7-abfe2eaae833",
                                                "sense_id": "c8bfc22a-91d1-3060-82a5-7cdb79e0c352",
                                                "text": "„Eine Woche später reiste Pierre, nachdem er von den Maurern als seinen neuen Freunden Abschied genommen und ihnen einen grösseren Geldbetrag für Almosen übergeben hatte, auf seine Güter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ae4f192-366d-3dda-b03a-a668b8add6b4",
                                        "entry_id": "bfcdc966-af6f-3383-9d45-23c7b71c10c3",
                                        "glosses": [
                                            "Entgelt für eine Leistung, das als zu niedrig/ungerecht empfunden wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc6fbd6-5351-435e-a3e7-a127f447d2d0",
                                                "sense_id": "6ae4f192-366d-3dda-b03a-a668b8add6b4",
                                                "text": "Die Bezahlung war nicht mehr als ein Almosen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5afbc4d7-53e4-4376-8da1-c0c90e02e6ef",
                        "source_entry_id": "b1a13cb6-ce8f-33d0-9bfd-f36a2fee0806",
                        "source_sense_id": "b198d3dd-1129-33ac-ad4a-e344ae66beee",
                        "source_sense_description": "Almosen, Scherflein",
                        "target_lang_word": "Scherflein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scherflein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b94bd2e-cae8-38e7-8b24-2b260c5151a8",
                                        "entry_id": "c1cba44e-05b6-34b3-8feb-1e02e00791e0",
                                        "glosses": [
                                            "historisch, selten, kleine Geldspende, kleiner finanzieller Beitrag"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa65090d-ebc1-4311-97d0-56addad73333",
                                                "sense_id": "6b94bd2e-cae8-38e7-8b24-2b260c5151a8",
                                                "text": "Er trägt sein Scherflein dazu bei. (Er gibt einen kleinen Teil zu einem größeren Ganzen.)"
                                            },
                                            {
                                                "example_id": "08fc3171-b53c-4c34-8b7f-4a6cb8c620a5",
                                                "sense_id": "6b94bd2e-cae8-38e7-8b24-2b260c5151a8",
                                                "text": "„Durch allerlei Wallfahrer-Nippes kann der geneigte Pilger sein Scherflein zur Finanzierung des voraussichtlich knapp 100 Millionen Euro teuren Weltjugendtags beisteuern.“"
                                            },
                                            {
                                                "example_id": "c057224f-f8b3-4b7f-87f5-176d8c1ae418",
                                                "sense_id": "6b94bd2e-cae8-38e7-8b24-2b260c5151a8",
                                                "text": "„Nun wolle er sein Scherflein als Angebinde für die Zukunft dem Schatz des Archivs überreichen.“"
                                            },
                                            {
                                                "example_id": "9a603121-cf8e-4063-a195-bab133f8f9f4",
                                                "sense_id": "6b94bd2e-cae8-38e7-8b24-2b260c5151a8",
                                                "text": "„Natürlich erwarteten sie in dem Falle auch ihr Scherflein von freiwillig und unfreiwillig gegebenen Körnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
