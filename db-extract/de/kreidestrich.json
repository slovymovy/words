                        "examples": [
                            {
                                "example_id": "7836ab0f-636c-45d4-bfbc-29de0709fc08",
                                "sense_id": "ab7f0e43-5a5b-3f1f-8931-96aa80648f90",
                                "text": "„Atticus ritzte sich die Handflächen, während Braithwhite in die Hocke ging und rasch zwei Kreidestriche zog.“"
                            },
                            {
                                "example_id": "f02f2dad-3d26-4ffe-ad56-0af3b94d6fac",
                                "sense_id": "ab7f0e43-5a5b-3f1f-8931-96aa80648f90",
                                "text": "„In sechs Monaten sitzt du sowieso wegen einer anderen Sache wieder in Untersuchungshaft, gibt der Detective dem Angeklagten zu verstehen. Und wenn nicht, dann nur, weil jemand aus meiner Schicht eines Nachts auf dem Asphalt einen Kreidestrich um deinen Arsch zieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
