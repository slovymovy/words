                ],
                "senses": [
                    {
                        "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                        "entry_id": "1a3bf9b0-0615-3f2e-bdc6-ed8bf6e973fc",
                        "glosses": [
                            "Schlaginstrument mit einem metallenem Kessel, der mit natürlichem oder künstlichem Fell bespannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f42554e-4db8-436c-8934-5371c9c51a45",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Der dumpfe Laut einer Kesselpauke ertönte.“"
                            },
                            {
                                "example_id": "ba016896-4318-4284-8871-393bde031a9b",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Im Gegensatz zu den meisten anderen Trommeln und Pauken werden Kesselpauken auf bestimmte Töne gestimmt – große, tiefe, schlagende, göttliche Töne.“"
                            },
                            {
                                "example_id": "89bb7684-d85e-4941-ab1d-3913e4ebeb33",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Tschinellen und Kesselpauke und die sogenannten Tschandressen machten mehr Lärm, als die persische Nationalhymne unbedingt erfordert hätte.“"
                            },
                            {
                                "example_id": "06e2991c-1f11-4555-a172-dd1148e6b6d5",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Der Stadtvater schlägt erneut die Kesselpauke und ruft: »Ende des Kampfes!«“"
                            },
                            {
                                "example_id": "54ed2e3a-4eeb-41bf-ae6b-80cd3fabb646",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Auf meinen Vorschlag, sich mal Instrumente zu suchen und die Gefühle zu spielen, die bei diesem Thema auftauchen, holte er sich zunächst eine große Kesselpauke mit Paukenschlägel.“"
                            },
                            {
                                "example_id": "c6cd7e9b-fdc5-4720-a7f4-dd7d3052341b",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Wir wollen aber gleich anmerken, daß sich die Obertöne einer Kesselpauke von denen einer schwingenden Saite oder einer Flöte fundamental unterscheiden.“"
                            },
                            {
                                "example_id": "e95cf7a9-7b44-4097-b61f-14d485e6c35e",
                                "sense_id": "dc272c6b-cbd9-35ae-b671-cd6f50bcfe87",
                                "text": "„Hinter den Ballisten war eine Reihe von Kamelreitern erschienen, vor deren Sättel mächtige Kesselpauken geschnallt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
