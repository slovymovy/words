                        "sense_id": "adcb5731-b159-3f0d-9a9e-eb03dfc11b3b",
                        "entry_id": "d26403fe-afc3-3e27-a54b-3db979ac3c15",
                        "glosses": [
                            "een zoete lekkernij die traditioneel gemaakt is van amandelen en suiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3bb4071-43f9-44b1-94ab-9426a261d81c",
                                "sense_id": "adcb5731-b159-3f0d-9a9e-eb03dfc11b3b",
                                "text": "wat vind je daarvan?' Nella herinnert zich dat ze nul op het rekest kreeg toen ze om marsepein vroeg, en ze is dankbaar voor zijn onverwachte aandacht."
                            },
                            {
                                "example_id": "142e216e-d954-47ea-ae37-b5346fd22dd5",
                                "sense_id": "adcb5731-b159-3f0d-9a9e-eb03dfc11b3b",
                                "text": "Maar ja, denkt ze, als ik zo'n ruzie met Carel had gehad, zou ik mijn eigen gewicht in marsepein opeten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "830f2c9d-24b1-43ae-bb34-49a4db910c87",
