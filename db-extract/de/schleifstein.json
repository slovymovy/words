                        "target_lang_word": "whetstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whetstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "caba41fd-bc73-3fe5-87d6-ae96f94fe6da",
                                        "entry_id": "b6ae91ea-045b-3c22-9ca9-d1d4005d1bb8",
                                        "glosses": [
                                            "A sharpening stone; a hard stone or piece of synthetically bonded hard minerals that has been formed with at least one flat surface, used to sharpen or hone an edged tool."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da4d79af-8c40-4051-8569-8958cc8cce93",
                                                "sense_id": "caba41fd-bc73-3fe5-87d6-ae96f94fe6da",
                                                "text": "[…]for alwaies the dulneſſe of the foole, is the whetstone of the wits."
                                            },
                                            {
                                                "example_id": "9650d587-6594-490b-8f21-5902aecd2a2c",
                                                "sense_id": "caba41fd-bc73-3fe5-87d6-ae96f94fe6da",
                                                "text": "It was as if a stone were ground to dust; as if white sparks flew from a livid whetstone, which was his spine; as if the switchback railway, having swooped to the depths, fell, fell, fell."
                                            }
                                        ]
                                    },
