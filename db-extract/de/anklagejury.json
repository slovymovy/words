                        "sense_id": "b60b5cba-c8ad-3212-ba9a-b60bc475df56",
                        "entry_id": "2d625821-7a1b-319c-a44b-148c7d4f4e71",
                        "glosses": [
                            "Geschworenenbank, die über die Erhebung der Anklage entscheidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61adfc77-fe5a-4cd3-981f-55e0d3749251",
                                "sense_id": "b60b5cba-c8ad-3212-ba9a-b60bc475df56",
                                "text": "„Ich erblicke vielmehr die Lösung des Räthsels in der Geschichte der Anklagejury, welche von Anfang an nicht den Charakter eines Gerichtes, sondern denjenigen einer Polizeibehörde an sich trug und auch gegenwärtig noch nicht als Richter, sondern als Ankläger handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
