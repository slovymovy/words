                ],
                "translations": [
                    {
                        "translation_id": "6a5e4c8b-2bb0-4c64-9b83-ed5cd47f878d",
                        "source_entry_id": "ecd5fc17-c00c-3017-86ab-07fdba3d7807",
                        "source_sense_id": "982663c0-e408-30cb-97f6-ccf0395fb8d0",
                        "target_lang_word": "vial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                        "entry_id": "8bc918b2-874b-3673-986c-0e92c5e78cf9",
                                        "glosses": [
                                            "A glass or plastic vessel or bottle, especially a small tube-shaped bottle used to store medicine, perfume or other chemicals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399fff0c-484f-493a-a488-be76a1cd4a0e",
                                                "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                                "text": "Take thou this vial, being then in bed, / And this distilled liquor drink thou off."
                                            },
                                            {
                                                "example_id": "12e5b6e8-b9fe-42b0-8390-1872ba131f33",
                                                "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                                "text": "And the second angel poured out his vial upon the sea; and it became as the blood of a dead man: and every living soul died in the sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "999caade-8f85-332d-9304-6d7a59a6d4e4",
                                        "entry_id": "18bd4f7a-6118-3c4d-a64d-d416d5e7722f",
                                        "glosses": [
                                            "To keep or put (something, especially a liquid) in, or as if in, a vial (noun sense)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2464bea-db7c-44bc-813d-b9bacbf3557c",
                        "source_entry_id": "ecd5fc17-c00c-3017-86ab-07fdba3d7807",
                        "source_sense_id": "982663c0-e408-30cb-97f6-ccf0395fb8d0",
                        "target_lang_word": "phial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                        "entry_id": "27f003f5-04d5-37e3-a585-e21a6b0da3ce",
                                        "glosses": [
                                            "A bottle or other vessel for containing a liquid; originally any such vessel, especially one for holding a beverage; now (specifically), a small, narrow glass bottle with a cap used to hold liquid chemicals, medicines, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "932c3563-e567-4977-95b2-9d356ce61d17",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "VVo to you that are rich in Sion, and haue confidence in the mountaine of Samaria: […] That drinke vvine in phials, and are annoynted vvith the beſt oyntment: and they ſuffred nothing vpon the contrition of Ioſeph."
                                            },
                                            {
                                                "example_id": "cb92bc91-a7ab-47e5-946f-abb442568c0f",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "And when he had taken the booke, the foure Beaſts, and foure and twenty Elders fel down before the Lambe, hauing euery one of them harps, and golden vials full of odours, which are the prayers of Saints."
                                            },
                                            {
                                                "example_id": "ed92c053-d609-4461-8774-2fe70a1214d9",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "AA Is a glaſs phial filled vvith mercury to the ſuperficies DD, or thereabout."
                                            },
                                            {
                                                "example_id": "b23ef628-6d13-4d24-8397-1b904bb9f7b1",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "And I heard a great voyce out of the Temple, ſaying to the ſeven Angels, Goe your wayes, and powre out the vials of the wrath of God vpõ the earth."
                                            },
                                            {
                                                "example_id": "7e97566c-e3f5-499b-b55a-05d9ab806964",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "You must open the middle drawer of my toilet-table and take out a little phial and a little glass you will find there,—quick! […] He held out the tiny glass, and I half filled it from the water bottle on the wash-stand. / “That will do:⁠—now wet the lip of the phial.” / I did so: he measured twelve drops of a crimson liquid, and presented it to Mason. / “Drink, Richard: it will give you the heart you lack, for an hour or so.”"
                                            },
                                            {
                                                "example_id": "694eacd8-7b19-426d-bd00-c4d297a290da",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "Thou still, upon the broad vine-sheltered path, / Mayst wait the turning of the phials of wrath / For certain years, for certain months and days."
                                            },
                                            {
                                                "example_id": "80702bb7-7f9d-4cf1-a0cd-dd77f2491e50",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "In testimony of the affection of the American people, of their confidence in your [Marie Curie's] scientific work, and of their earnest wish that your genius and energy may receive all encouragement to carry forward your efforts for the advance of science and conquest of disease, I have been commissioned to present to you this little phial of radium."
                                            },
                                            {
                                                "example_id": "f3a911c3-5eb8-4bae-af5c-c22a8fcb89a9",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "He sat musing for a little with the phial in his hand, looking at the clear liquid within."
                                            },
                                            {
                                                "example_id": "ee2e41e7-1bbc-41fd-8ba8-b2f4bc7c5fc2",
                                                "sense_id": "a8258410-0f2c-36c0-bbe7-6472beee0e35",
                                                "text": "She held up a small crystal phial: it glittered as she moved it, and rays of white light sprang from her hand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phial",
                                "target_lang_code": "en",
                                "target_senses": [
