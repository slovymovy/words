                                "target_senses": [
                                    {
                                        "sense_id": "73f40bb4-2ff7-3d88-a9f3-ba2b86a98209",
                                        "entry_id": "85743837-7a55-3b4f-b250-3081b21ba19f",
                                        "glosses": [
                                            "Moitié d’une mesure de capacité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0198920a-bc13-4b74-98db-3c9df2eb08d1",
                                                "sense_id": "73f40bb4-2ff7-3d88-a9f3-ba2b86a98209",
                                                "text": "Une demi-mesure de farine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1412e2a-67e0-3039-9d5f-685603e96c6b",
                                        "entry_id": "85743837-7a55-3b4f-b250-3081b21ba19f",
                                        "glosses": [
                                            "Solution insuffisante, incomplète, qui n’apporte pas de réponse satisfaisante au problème considéré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872ec563-e3bf-45b2-ba8f-8fa416e33f5d",
                                                "sense_id": "a1412e2a-67e0-3039-9d5f-685603e96c6b",
                                                "text": "Ne nous cachons pas derrière des demi-mesures, des aménagements contre-productifs ou des couvertures partielles qui ne résoudront jamais rien, mais coûteraient assurément beaucoup."
                                            },
                                            {
                                                "example_id": "3d09b23f-c388-4b60-afb2-32e1b6c5233d",
                                                "sense_id": "a1412e2a-67e0-3039-9d5f-685603e96c6b",
                                                "text": "Malheureusement pour M. Trudeau, il n’y a pas de demi-mesure dans ce débat."
                                            },
                                            {
                                                "example_id": "d0144bef-5e14-4ea1-b38e-31c2b1c757ff",
                                                "sense_id": "a1412e2a-67e0-3039-9d5f-685603e96c6b",
                                                "text": "Les Bruins sont aujourd’hui ce qu’était le Canadien autrefois, un club qui dicte la marche et qui forme ses joueurs par l’exemple. Il serait très gênant pour un nouveau d’y aller de demi-mesures sous les yeux de Patrice Bergeron, de Brad Marchand ou de David Pastrnak qui mangent les bandes soir après soir."
                                            }
                                        ]
                                    }
                                ]
