                    {
                        "translation_id": "1159d2c1-daa6-4ba2-89cb-b5ef752148d3",
                        "source_entry_id": "e9af7608-03c2-32ed-a239-3ef9b41a838b",
                        "target_lang_word": "Küsserei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
