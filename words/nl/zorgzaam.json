                                "target_lang_sense_clarification": "kind and empathetic towards others"
                            },
                            {
                                "target_lang_word": "nurturing",
                                "target_lang_sense_clarification": "providing care and encouragement"
                            },
                            {
                                "target_lang_word": "considerate",
                                "target_lang_sense_clarification": "thoughtful of others' needs"
