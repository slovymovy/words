                ],
                "senses": [
                    {
                        "sense_id": "442a03d9-9981-339f-a690-2dde19f942df",
                        "entry_id": "60603c48-06a6-3473-923d-1e988cabea97",
                        "glosses": [
                            "Zaun aus Latten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc831c54-280b-4c3a-8f71-e976967cab2b",
                                "sense_id": "442a03d9-9981-339f-a690-2dde19f942df",
                                "text": "„Ihre Räder bedächtig gegen das Staket des Vorgartens in der Lindenallee 113 lehnend und sorgfältig sichernd, sprachen Chaim und Siegfried Kanten mit fast blutsverwandter Anhänglichkeit bei den Bertinis vor."
                            },
                            {
                                "example_id": "bbb1c0f2-252a-4d3b-910d-d4e1ea8e3f3d",
                                "sense_id": "442a03d9-9981-339f-a690-2dde19f942df",
                                "text": "„An dem Staket aber trockneten Netze, wähend eine Sichel an der alten Linde hing.“"
                            },
                            {
                                "example_id": "5cb07250-31a0-469b-a619-02923419be6e",
                                "sense_id": "442a03d9-9981-339f-a690-2dde19f942df",
                                "text": "„Ihre Masten und Antennen scheinen wie bizarre Stakete auf die verschachtelten Dächer gesteckt zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45c14e0d-09e1-437a-a123-027e625e0642",
                        "source_entry_id": "60603c48-06a6-3473-923d-1e988cabea97",
                        "source_sense_id": "442a03d9-9981-339f-a690-2dde19f942df",
                        "source_sense_description": "Zaun aus Latten",
                        "target_lang_word": "sztacheta",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sztacheta",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "666cb91d-162f-3bd8-95a1-dae3bbc654a2",
                                        "entry_id": "7300229f-5b4f-3d66-9a9a-256b20a6ba11",
                                        "glosses": [
                                            "wąska deska będąca częścią pionowego obicia płotu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d797d55d-0edd-467f-a74a-f3426f52dc01",
                                                "sense_id": "666cb91d-162f-3bd8-95a1-dae3bbc654a2",
                                                "text": "Koło ogrodu wysoki płot z zielonych sztachet, a każda sztacheta u góry w uproszczony kształt serca rzezana. Ile sztachet, tyle serc zielonych. Ładne to było"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7ade05b3-c662-3d3a-b7b6-7cf199df5b0c",
                                        "entry_id": "7300229f-5b4f-3d66-9a9a-256b20a6ba11",
                                        "glosses": [
                                            "metalowy pręt stanowiący element konstrukcyjny płotu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9490b5b8-9867-4184-8144-022580edf144",
                                                "sense_id": "7ade05b3-c662-3d3a-b7b6-7cf199df5b0c",
                                                "text": "Kilku mężczyznom udało się przeleźć przez wysokie ogrodzenie, inni siedzieli na żelaznych prętach sztachet i lżyli żołnierzy"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
