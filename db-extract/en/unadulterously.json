                        "glosses": [
                            "In an unadulterous way."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "04deb0f9-c08b-4296-a9ee-5be6779450d7",
                                "sense_id": "0ddbe40f-5686-3576-9b23-2f251fface34",
                                "text": "[…] seeing many beasts in voluntary and chosen couples, live together as unadulterously, and are as truly married in that respect."
                            },
                            {
                                "example_id": "d0062367-34ba-4257-8951-3342d3130c6c",
                                "sense_id": "0ddbe40f-5686-3576-9b23-2f251fface34",
                                "text": "One would have to be very unworldly to believe that most men of this kind live ascetically and unadulterously."
                            },
                            {
                                "example_id": "5961e3d6-e25f-4da7-beea-f80d09be987b",
                                "sense_id": "0ddbe40f-5686-3576-9b23-2f251fface34",
                                "text": "And a big reason we were able to come together with such decisiveness is we were both emphatically, unadulteratedly, unadulterously single."
                            }
                        ]
                    }
