                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bcf12fa-699f-4b58-a266-b0d398821aa5",
                                "sense_id": "ec3bb332-2bbe-34f6-84b7-f69a9bfa7165",
                                "text": "Een conflict kan optreden tussen mensen wanneer een meningsverschil uitmondt in ruzie, tussen organisaties in bijvoorbeeld een handelsoorlog en tussen landen in oorlog."
                            }
                        ]
