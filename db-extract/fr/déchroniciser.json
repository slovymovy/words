                        "glosses": [
                            "Faire perdre son caractère considéré comme chronique à la maladie de quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2832144b-69ac-49be-af11-fd4fbf246ecc",
                                "sense_id": "69123db9-412e-3a7d-b7c7-9effb0a266ad",
                                "text": "Il est question de la déchroniciser en lui refusant l’accueil au Transit : elle doit se contenter des rendez-vous au CMP ouvert aux heures administratives !"
                            },
                            {
                                "example_id": "3d8a0077-2408-4b7b-b32c-909ec787fbf8",
                                "sense_id": "69123db9-412e-3a7d-b7c7-9effb0a266ad",
                                "text": "L'un des objectifs de l'institution est de \"déchroniciser\" la santé mentale."
                            },
                            {
                                "example_id": "dacaffa4-0c2c-4bdb-96e1-e8d7665308b2",
                                "sense_id": "69123db9-412e-3a7d-b7c7-9effb0a266ad",
                                "text": "Il arrivait pourtant que les cliniques nous envoient des patients pour les \"déchroniciser\"."
                            }
                        ]
