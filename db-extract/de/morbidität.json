                                        "glosses": [
                                            "The quality of being morbid; an attitude or state of mind marked by gloom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ad413e-edb1-4d54-a496-d3c131c810bb",
                                                "sense_id": "3a5a5adb-8efa-3751-adb9-0a1226c13a75",
                                                "text": "He taught him how to be superior to human foibles and how to give a godlike laugh at himself as a way of fending off morbidity. He did all the things for him that a woman is grateful for, except that Magnus is a man."
                                            }
                                        ]
                                    },
