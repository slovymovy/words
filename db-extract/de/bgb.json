                "senses": [
                    {
                        "sense_id": "7645f009-3397-3c0e-8f77-eb1bd3120737",
                        "entry_id": "f219923b-44e6-341a-bd1a-dafb302b0739",
                        "glosses": [
                            "Bürgerliches Gesetzbuch (der Bundesrepublik Deutschland)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff026157-8c93-405e-b53b-d627535764c6",
                                "sense_id": "7645f009-3397-3c0e-8f77-eb1bd3120737",
                                "text": "§ 823 Abs. 2 BGB, mit gleicher Bedeutung: § 823 II BGB"
                            },
                            {
                                "example_id": "289930e3-385d-48a4-a528-807dc31b11e6",
                                "sense_id": "7645f009-3397-3c0e-8f77-eb1bd3120737",
                                "text": "„Nach dem BGB haftet der Erbe für Nachlassverbindlichkeiten mit seinem Vermögen, das heißt seinem Eigenvermögen und dem Nachlass, unbeschränkt, aber beschränkbar.“"
                            },
                            {
                                "example_id": "b99538dc-dc4e-485d-b4f7-e1f21688f335",
                                "sense_id": "7645f009-3397-3c0e-8f77-eb1bd3120737",
                                "text": "„Ebenso überliefert das BGB so manches Wort und manche Wortbedeutung aus dem Mittelalter und der frühen Neuzeit, sprachgeschichtlich also aus dem Mittelhochdeutschen und dem Frühneuhochdeutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
