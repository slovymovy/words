                                        "entry_id": "d7373626-87c6-30ff-bff6-9920499bdf0e",
                                        "glosses": [
                                            "een spotnaam voor een soldaat in het landleger (iemand die als een haas in het zand rondspringt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb31eb1c-16fd-48ab-8352-64094fa75762",
                                                "sense_id": "a8b86c50-4527-3dbe-b7bc-bcc0547d5858",
                                                "text": "Ik ga liever naar zee dan een zandhaas te worden."
