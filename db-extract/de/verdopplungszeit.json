                "senses": [
                    {
                        "sense_id": "311f503e-e308-33b6-a2a6-e5023c5a3bbc",
                        "entry_id": "5fe32796-603a-3842-a422-cc51ed68c63a",
                        "glosses": [
                            "Zeit, die verstreicht, bis eine gewissen Anzahl (zum Beispiel an Erkrankungen, Einwohnern) zwei mal so groß geworden ist, sich verdoppelt hat"
                        ],
                        "tags": [
                            "Demographie",
                            "Epidemiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e3153c14-56e9-400b-a54e-93ebda53cfc9",
                                "sense_id": "311f503e-e308-33b6-a2a6-e5023c5a3bbc",
                                "text": "„Wir schätzen, dass die Verdopplungszeit der Einwohnerzahl annähernd 20 Jahre ist. Natürlich ist die Extrapolation, so weit in die Zukunft hinein, zweifelhaft, da das exponentielle Wachstum einer Population nicht für immer weiter gehen kann.“"
                            },
                            {
                                "example_id": "f84b4514-5741-471d-af19-fe654dc2b7d9",
                                "sense_id": "311f503e-e308-33b6-a2a6-e5023c5a3bbc",
                                "text": "„Die Verdopplungszeit der meisten Bakterien liegt zwischen 20 und 60 Minuten.“"
                            },
                            {
                                "example_id": "53aa1a03-5ee5-470e-8531-30fe12dd5d3c",
                                "sense_id": "311f503e-e308-33b6-a2a6-e5023c5a3bbc",
                                "text": "„Grundsätzlich ist jeder Berechnungsweg für sich nachvollziehbar, führt aber auch dazu, dass je nach Medium verschiedene Werte für die aktuelle Verdopplungszeit des neuartigen Coronavirus' in Deutschland existieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
