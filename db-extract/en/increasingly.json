    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e9488ebf-6e6d-362f-8a84-6800d721f9d8",
                "word": "increasingly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                        "entry_id": "e9488ebf-6e6d-362f-8a84-6800d721f9d8",
                        "glosses": [
                            "Increasing in amount or intensity."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e174cd7-5cf0-4aca-83cd-804a76b84b79",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "After the introduction of the Highland Railway class, the progress of the 4-6-0 was tardy for some years.Then, when designers were increasingly turning to it as the answer to their growing motive power problems, production of 4-6-0s swelled into a flood tide."
                            },
                            {
                                "example_id": "2f6e2b92-6c0a-45c7-b47d-d35174097e76",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "Sydney is a fast city, and the pace is becoming increasingly more frantic."
                            },
                            {
                                "example_id": "4609bf1d-9d25-4ae9-ad19-dabc9887715d",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "As more and more people moved behind the increasingly larger walls, the fortress settlement evolved into the walled city."
                            },
                            {
                                "example_id": "056f380b-f10a-4c01-b111-b5be5134a282",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "Rooney had been suffered a barren spell for England with only one goal in 15 games but he was in no mood to ignore the gifts on offer in front of an increasingly subdued Bulgarian support."
                            },
                            {
                                "example_id": "3d3a1f0e-da5e-4cfd-ba12-805a055be7fb",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "They will remind you that rail already faces fierce competition from cars, coaches, airlines, and (increasingly) remote working and videoconferencing."
                            },
                            {
                                "example_id": "72fb4f19-307f-4bc0-8ba0-100d2a7d0cbe",
                                "sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                                "text": "So why is Ethiopia, Africa’s second most populous country, seven years and eight months “behind” much of the rest of the world? And how does that work for Ethiopians living on an increasingly interconnected planet that mostly operates in an entirely different era?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ae006a5-047d-4923-b420-c3f97735e411",
                        "source_entry_id": "e9488ebf-6e6d-362f-8a84-6800d721f9d8",
                        "source_sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                        "source_sense_description": "increasing in amount or intensity",
                        "target_lang_word": "in toenemende mate",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7147c4d3-4aec-45da-8e1d-c091a9a4f0b7",
                        "source_entry_id": "e9488ebf-6e6d-362f-8a84-6800d721f9d8",
                        "source_sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
                        "source_sense_description": "increasing in amount or intensity",
                        "target_lang_word": "de plus en plus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de plus en plus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                        "entry_id": "9fed7b6e-0661-3363-a533-4a30c0e9fa75",
                                        "glosses": [
                                            "En progressant, en bien comme en mal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a2531d-fe2a-4e57-8426-ef8ede9a9c00",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "Je m’épanouis de plus en plus dans ce championnat, confie Philippe Hirschberger, actuel entraîneur d’Amiens, qui a coaché plus de 560 matchs de Ligue 2."
                                            },
                                            {
                                                "example_id": "4832e011-4113-4cd8-a351-bbcd3a4e6f7f",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "Les postiches rejettent encore en arrière le développement de la jupe, tandis que le vaste fichu de linon, le fichu menteur, engonçant le cou, amplifiant la poitrine, se projette de plus en plus en avant."
                                            },
                                            {
                                                "example_id": "e20a83fa-81aa-4b26-846f-c0386b3495c8",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "En outre, du fait de la conversion au christianisme de l’ancien païen Clovis et de l’ancien arien Sigismond de Bourgogne, l’autorité de l’Église devenait de plus en plus forte."
                                            },
                                            {
                                                "example_id": "edcf1270-7c00-4467-ba93-530e8bc0b8af",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "Mais, à côté de ces favorisés, il y a la masse des autres paysans qui n’ont pas de bonne terre à faire valoir ; ceux-là, devant l’extension du machinisme, trouveront de plus en plus difficilement à affermer des champs où leur force de travail puisse s’employer."
                                            },
                                            {
                                                "example_id": "319fb6d7-b723-4b3e-b186-fe3b93e7b6f8",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "Je sentais l’intensité du courant grandir et à mesure ma gorge, mes mâchoires, tous les muscles de mon visage, jusqu’à mes paupières se contacter dans une crispation de plus en plus douloureuse."
                                            },
                                            {
                                                "example_id": "1e7f8f4a-b7ea-4bba-aa07-177aad023465",
                                                "sense_id": "ae596eb3-2be2-39e1-9a63-ae5296e7d057",
                                                "text": "Et l'on avait encore par la suite réglementé la pose des lacs à terre si bien que c'était de plus en plus hasardeux d'essayer d'en profiter quand les bêtes rusées refusent la « graine », à la branche !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e926c1-067a-3d00-9d98-2cad36673f26",
                                        "entry_id": "9fed7b6e-0661-3363-a533-4a30c0e9fa75",
                                        "glosses": [
                                            "Un nombre croissant de, une quantité croissante de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd70bf1-3e13-435e-8cb9-1972bdaadc74",
                                                "sense_id": "00e926c1-067a-3d00-9d98-2cad36673f26",
                                                "text": "Notre avion prenait de plus en plus de vitesse."
                                            },
                                            {
                                                "example_id": "f40b2c51-d70a-4ee1-a0bd-499c93b4955c",
                                                "sense_id": "00e926c1-067a-3d00-9d98-2cad36673f26",
                                                "text": "Après 2008, de plus en plus de personnes nées au cours de la période du baby boom vont atteindre l’âge de la retraite, et l’effet de leurs départs va se faire sentir de plus en plus fortement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af84f2a-3b6f-4d1d-b888-5c681bf431bc",
                        "source_entry_id": "e9488ebf-6e6d-362f-8a84-6800d721f9d8",
                        "source_sense_id": "37327d01-69cf-3d73-99d5-f8a74f872243",
