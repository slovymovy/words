                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complementary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58f669fc-b415-35a7-bcc9-5a6787a3b730",
                                        "entry_id": "b6171950-e517-34cd-9981-7b3d8c2362f8",
                                        "glosses": [
                                            "Acting as a complement; making up a whole with something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05812218-79ec-4a1b-b6dd-de568e9ecb4a",
                                                "sense_id": "58f669fc-b415-35a7-bcc9-5a6787a3b730",
                                                "text": "I'll provide you with some complementary notes to help you study."
                                            },
                                            {
                                                "example_id": "a9df147e-5b6a-48a8-828a-530012183672",
                                                "sense_id": "58f669fc-b415-35a7-bcc9-5a6787a3b730",
                                                "text": "The two business partners had complementary abilities: one had excellent people skills, while the other had a head for figures."
                                            },
                                            {
                                                "example_id": "6da42cb5-1f7d-4269-9c61-435e3718b6d5",
                                                "sense_id": "58f669fc-b415-35a7-bcc9-5a6787a3b730",
                                                "text": "Using the terminology we introduced earlier, we might then say that black and white squares are in complementary distribution on a chessboard. By this we mean two things: firstly, black squares and white squares occupy different positions on the board: and secondly, the black and white squares complement each other in the sense that the black squares together with the white squares comprise the total set of 64 squares found on the board (i.e. there is no square on the board which is not either black or white)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf65531-5389-33cc-af22-99518e5a1041",
                                        "entry_id": "b6171950-e517-34cd-9981-7b3d8c2362f8",
                                        "glosses": [
                                            "Of the specific pairings of the bases in DNA and RNA."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5972061f-7aa7-3176-8bcc-4f6339f7af3a",
                                        "entry_id": "b6171950-e517-34cd-9981-7b3d8c2362f8",
                                        "glosses": [
                                            "Pertaining to pairs of properties in quantum mechanics that are inversely related to each other, such as speed and position, or energy and time. (See also Heisenberg uncertainty principle.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
