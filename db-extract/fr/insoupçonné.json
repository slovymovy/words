                "senses": [
                    {
                        "sense_id": "c7b72f10-9fe3-3fee-a4ef-9f7038669462",
                        "entry_id": "8669a07f-e9fc-3ad4-8309-ef3a67292cb2",
                        "glosses": [
                            "Que l’on ne soupçonne pas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c018053-fb98-4bce-89a0-0865913a1d69",
                                "sense_id": "c7b72f10-9fe3-3fee-a4ef-9f7038669462",
                                "text": "Le plus curieux, c'est qu'ils sont presque tous affligés d'un travers, d'un vice, d'un maboulisme périlleux, d'une tare, ou qu'ils ont des histoires intimes, des saletés familiales, tous, les plus respectés, les plus grands, les plus insoupçonnés."
                            },
                            {
                                "example_id": "00bfbf55-7069-4180-a6ea-0dd7a8b9d31a",
                                "sense_id": "c7b72f10-9fe3-3fee-a4ef-9f7038669462",
                                "text": "Je n'en perdais pas une broquille de toute cette bidoche exposée, de ces mamelles volumineuses, de ces cuisses grasses, vergeturées, s'entrouvrant sur des paysages insoupçonnés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "480b8cb4-8651-4a8b-bade-eb40b4648ec1",
                        "source_entry_id": "8669a07f-e9fc-3ad4-8309-ef3a67292cb2",
                        "source_sense_id": "c7b72f10-9fe3-3fee-a4ef-9f7038669462",
                        "target_lang_word": "unsuspected",
                        "target_lang_code": "en",
