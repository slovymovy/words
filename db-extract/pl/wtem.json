                        "form_id": "c626c51a-557e-4dfb-a5fe-6b879f9ab720",
                        "entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "tags": [
                            "positive"
                        ],
                        "form": "wtem"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                        "entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "glosses": [
                            "plötzlich, auf einmal, unerwartet, überraschend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2262648-8afd-4b83-9369-1f96a7b2a9cc",
                                "sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                                "text": "„Zaczynali już kłócić się, ale wtem oblała ich światłość wychodząca z okien karczmy, przed którą przechodzili.“",
                                "translation": "Sie begannen schon sich zu streiten, aber plötzlich übergoss sie Licht, das aus den Fenstern des Wirtshauses herauskam, an dem sie vorbeiliefen."
                            },
                            {
                                "example_id": "aa1918a2-34a0-4729-82f7-2c28334a3ea9",
                                "sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                                "text": "„Wtém się coś zdala na polu ukaże, / Jakowiś ludzie biegą tu po błoniach, / A gałąź cieniu za każdym się czerni, / A biegą prędko, muszą być na koniach; / A świécą mocno, muszą być pancerni.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24037bd5-255e-448a-b9de-f3661456a530",
                        "source_entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "source_sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                        "source_sense_description": "plötzlich, auf einmal, unerwartet, überraschend",
                        "target_lang_word": "plötzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plötzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                        "entry_id": "c73bb506-ab8d-352d-bea5-febb8093ff05",
                                        "glosses": [
                                            "unerwartet, überraschend, auf einen Schlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe462d18-3e11-4cea-a2fa-3e86ec9a388d",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Plötzlich hörte der Motorflieger auf zu kreisen. In eine ganz andere Richtung ging es auf einmal.“"
                                            },
                                            {
                                                "example_id": "58ce6522-464f-4631-bc76-66fa3aa3b039",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Plötzlich kam ein alter Mann in den Laden."
                                            },
                                            {
                                                "example_id": "77ac4a65-d7bc-4919-9c01-d2f09eb7f8b9",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Was soll denn dieser plötzliche Aufbruch?"
                                            },
                                            {
                                                "example_id": "46522f9e-ef96-4047-a682-d1a8c0fd3d90",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "Mein Vater ist ganz plötzlich gestorben."
                                            },
                                            {
                                                "example_id": "91a330df-bb50-473d-a752-beed10e2de7f",
                                                "sense_id": "d89b399e-d1dd-34f4-bdba-e39a3db5e87e",
                                                "text": "„Eine plötzliche Vertragskündigung durch Yahoo beendete laut dem Verein die Geschäftsbeziehung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c79a674-ba4b-4dc6-b3ab-141cebd340e0",
                        "source_entry_id": "106e7ec8-3d6d-36af-a090-4147b63f33dc",
                        "source_sense_id": "90253238-1b7b-3736-a9a2-1e9409405b05",
                        "source_sense_description": "plötzlich, auf einmal, unerwartet, überraschend",
