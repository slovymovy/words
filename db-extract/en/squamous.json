                                "target_senses": [
                                    {
                                        "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                        "entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                                        "glosses": [
                                            "Qui est écailleux, couvert de squames."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e757d11-0c92-4f05-b278-3cff969f5def",
                                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                                "text": "Tige squameuse."
                                            },
                                            {
                                                "example_id": "b8b9651f-e0b6-442d-ad0b-c7e1ac7dcfb5",
                                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                                "text": "Ah ! l’affreux, le hideux, le squameux, venimeux, écumeux, écumant, glapissant crapaud !…"
                                            },
                                            {
                                                "example_id": "690cdd40-f03d-4694-b705-2b7967465685",
                                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                                "text": "Le python tourne lentement sa hideuse tête squameuse vers cette proie inattentive."
                                            },
                                            {
                                                "example_id": "33119bc0-0ca7-46d7-b35d-49aead561292",
                                                "sense_id": "aa1742e3-3d47-34b9-876f-482a7e6579c4",
                                                "text": "Ils m’étaient soumis, ces dragons ; je souriais de les voir se déformer et grandir, enlaçant tout de leurs corps squameux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff50a2b2-cd8b-3314-98c5-b2a81b3fa1f2",
                                        "entry_id": "77fef5dd-9dfe-33e8-90e3-20bf971b1f64",
                                        "glosses": [
                                            "Qui a l’aspect d’une écaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5da537c3-13f0-48ac-93dd-b9787fa1a947",
                                                "sense_id": "ff50a2b2-cd8b-3314-98c5-b2a81b3fa1f2",
                                                "text": "La portion squameuse du temporal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d0139b8-ca05-4647-b1ef-724d346703d8",
                        "source_entry_id": "78b6564f-ed37-337d-99de-a66a3868288f",
                        "source_sense_description": "scaly",
                        "target_lang_word": "écailleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écailleux",
