                "senses": [
                    {
                        "sense_id": "78a07a34-79d1-3d52-8d07-28907b0257c0",
                        "entry_id": "827bddc7-47ea-3e2a-972c-6c62140e0bb2",
                        "glosses": [
                            "Put down on paper by a printing press or a computer printer."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a8b8eda3-422b-4ea1-a7a2-95439918645d",
                                "sense_id": "78a07a34-79d1-3d52-8d07-28907b0257c0",
                                "text": "The parliament levied a tax on all printed matter."
                            },
                            {
                                "example_id": "df553232-d5af-4267-bab7-b055c3207351",
                                "sense_id": "78a07a34-79d1-3d52-8d07-28907b0257c0",
                                "text": "All printed personal information must be shredded before it leaves this building."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6733eb8-c274-3a7b-93e0-be8e7d228bc8",
                        "entry_id": "827bddc7-47ea-3e2a-972c-6c62140e0bb2",
                        "glosses": [
                            "Written to a data file."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "451045cf-b908-48e7-af34-c2ca25c20cf1",
                                "sense_id": "f6733eb8-c274-3a7b-93e0-be8e7d228bc8",
                                "text": "The output of this sample program is simply some printed lines such as \"Hello, World; my name is [Name].\""
                            }
                        ]
                    },
                    {
                        "sense_id": "a0592c25-6069-3ee5-ac87-fb985b879449",
                        "entry_id": "827bddc7-47ea-3e2a-972c-6c62140e0bb2",
                        "glosses": [
                            "Written on paper by hand in noncursive script."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "28bf84ea-ad0c-4b5b-bf64-e8e81a1da05c",
                                "sense_id": "a0592c25-6069-3ee5-ac87-fb985b879449",
                                "text": "The signature was illegible, but the printed name beneath it clearly said \"William Wilson.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "aaa6e923-de9b-378e-8a5b-58ca86f62b8b",
                        "entry_id": "827bddc7-47ea-3e2a-972c-6c62140e0bb2",
                        "glosses": [
                            "Ellipsis of 3D printed"
                        ],
                        "tags": [
