                                                "sense_id": "268ed049-e502-3eba-8e9a-f284fecff591",
                                                "text": "Dave: Livin’ the litigation life, ya gotta catch that courtroom rhythm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4012ce21-ff20-4c02-9f37-fb8e01affcc2",
                        "source_entry_id": "2dfc3e84-781e-3a80-89aa-ae1123471e0f",
