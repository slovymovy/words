                "senses": [
                    {
                        "sense_id": "7bb33f6b-decc-3ff3-91fe-70318df70644",
                        "entry_id": "fd04ddea-3237-3a86-b09f-bce02858a54f",
                        "glosses": [
                            "зоол., орнитол. певчая птица отряда воробьиных семейства вьюрковых; юрок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a4ea1ec-b1e6-4a5f-879a-7494eed52f66",
                                "sense_id": "7bb33f6b-decc-3ff3-91fe-70318df70644",
                                "text": "Проснулись птицы, в кустах на горе звонко кричал вьюрок .."
                            },
                            {
                                "example_id": "6d3175cd-3ca1-4a54-8154-08a8fb4f6dc4",
                                "sense_id": "7bb33f6b-decc-3ff3-91fe-70318df70644",
                                "text": "В середине мая вьюрки приступают к гнездованию в расщелинах скал, на деревьях, кустарниках туркестанского можжевельника."
                            },
                            {
                                "example_id": "e8a1fce6-cc59-4512-a266-4ca1cf8004b3",
                                "sense_id": "7bb33f6b-decc-3ff3-91fe-70318df70644",
                                "text": "Вьюрок вооружается острой и тонкой иглой кактуса, и с её помощью извлекает личинок из самых мелких щелей."
                            }
                        ]
                    }
                ],
