                                    },
                                    {
                                        "sense_id": "d5de169e-020b-35fc-8b42-24dff1d4d03e",
                                        "entry_id": "03b8b6f5-33dc-3bb1-9b11-7c4e76b837ea",
                                        "glosses": [
                                            "land in het Caribisch gebied bestaande uit het bovengenoemde eiland. Het wordt ook wel Little England genoemd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02f455e6-bfc4-495a-9396-5f6bff7598fa",
                                                "sense_id": "d5de169e-020b-35fc-8b42-24dff1d4d03e",
                                                "text": "Ik ben op Tobago, Grenada en Barbados geweest. De andere eilanden ken ik niet. Ik ken Londen beter dan Jamaica."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0f94645-5e4e-4ff7-9127-b5f160f460ed",
