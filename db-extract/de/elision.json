                        "entry_id": "cda6f2e2-3dfb-36ae-b96c-e94c2fcf8cb5",
                        "glosses": [
                            "Wegfall eines meist unbetonten Lautes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef9ea4a-a7b9-4051-8a22-63afa9bdf766",
                                "sense_id": "82c89a1d-cd8c-3643-aa5f-4925c538b951",
                                "text": "Elisionen können an unterschiedlichen Positionen im Wort auftreten."
                            },
                            {
                                "example_id": "e91d50c7-f25d-4f08-b733-1af2218d2273",
                                "sense_id": "82c89a1d-cd8c-3643-aa5f-4925c538b951",
                                "text": "„Mit Elision wird der Ausfall von Segmenten bezeichnet.“"
                            },
                            {
                                "example_id": "26dec966-bab6-4420-bf68-6b2a6cc2ad5a",
                                "sense_id": "82c89a1d-cd8c-3643-aa5f-4925c538b951",
                                "text": "„Relativ gesehen ist der Lateralengelaut am häufigsten von Elisionen betroffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
