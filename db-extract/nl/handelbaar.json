                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2987c976-5495-426f-908d-e5c9f0dd57fd",
                                "sense_id": "da1d6c17-eff2-307f-8ef3-10e485138a5c",
                                "text": "Een verschrikking maak je onschadelijk door hem te ontrafelen, daar wijst Pieters op. Een aanslag is persoonlijk en dat moet weg. Niet dat je er dan iets van snapt, maar de pijn wordt handelbaar. Je weet het nog wel, maar je voelt het niet meer zo."
                            }
