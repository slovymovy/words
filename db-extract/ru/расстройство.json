                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545e4ba0-0b58-43c0-bf9e-df79fcbf8f0d",
                                "sense_id": "af0e94e9-81a4-3776-a80e-7f5909861c40",
                                "text": "С этим видом навязанного повторения связано так называемое эмирячение, которое тоже может быть поставлено в ряд распространенных у северных народов нервных расстройств."
                            }
                        ]
