                                            {
                                                "example_id": "dd692ba2-89c9-4af7-a499-c339607e75a2",
                                                "sense_id": "26e3fa52-96ae-3a1c-a0f8-424f64f7d112",
                                                "text": "nonhuman animals"
                                            },
                                            {
                                                "example_id": "0ee86b8a-f107-4f49-948e-8f28d19c0fb8",
                                                "sense_id": "26e3fa52-96ae-3a1c-a0f8-424f64f7d112",
                                                "text": "nonhuman agents"
                                            },
                                            {
                                                "example_id": "684fd142-c057-4149-960e-bb1b88ea5ec7",
                                                "sense_id": "26e3fa52-96ae-3a1c-a0f8-424f64f7d112",
                                                "text": "Other examples of nonhuman self-domestication in the wild exist—for instance, the Zanzibar red colobus monkey diverged from the mainland African red colobus in similar ways during its island isolation—but bonobos are the closest and most relevant to us."
                                            },
                                            {
                                                "example_id": "c82a3e10-8daa-4f27-a0e7-e79e270c8e6b",
                                                "sense_id": "26e3fa52-96ae-3a1c-a0f8-424f64f7d112",
                                                "text": "Much, perhaps most, Minecraft fiction follows the robinsonade template, emphasizing the day-to-day life of a character, including nonhuman characters, striving to survive and thrive in a recognizably Minecraftian world by utilizing its resources."
                                            }
                                        ]
                                    }
                                ]
                            },
