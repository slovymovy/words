                    {
                        "translation_id": "5d21fae5-9545-4c3a-b002-937e2cccd716",
                        "source_entry_id": "43e2940b-9dd1-3e15-a409-af7eed33bc2d",
                        "source_sense_id": "84a47f27-ca55-3ab0-acb7-719f48123fd3",
