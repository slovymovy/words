                ],
                "senses": [
                    {
                        "sense_id": "903954de-0001-3ead-a0d3-2ab8095a3fb6",
                        "entry_id": "7ccc3de7-4eb8-395f-9ad8-7af969b2f451",
                        "glosses": [
                            "volledig dronken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feb40eaf-1211-41bd-829a-5268613c3366",
                                "sense_id": "903954de-0001-3ead-a0d3-2ab8095a3fb6",
                                "text": "Vader Briel heeft het nieuws in een café gehoord. Hij is zat. (…) Hij is niet strontzat, maar hij heeft heel wat moeite om rechtaan te lopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e23f87b-2e69-3385-81f4-0eb20aa3c80f",
                        "entry_id": "7ccc3de7-4eb8-395f-9ad8-7af969b2f451",
                        "glosses": [
                            "ergens meer dan genoeg van hebbend, iets niet langer duldend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f9f6b3ad-aee0-4ed7-bdfa-65d778b0860b",
                                "sense_id": "5e23f87b-2e69-3385-81f4-0eb20aa3c80f",
                                "text": "Actieleider L. Zomer trad voor de rechtbank op voor 23 boeren die niet verbonden zijn aan een boerenorganisatie. In zijn pleidooi stelde hij dat de maat bij de boeren meer dan vol is. “Wij zijn er strontzat van.” Het injecteren van mest kost een gemiddeld boerenbedrijf 4000 tot 5000 gulden en is derhalve volgens Zomer veel te duur."
                            },
                            {
                                "example_id": "b9a7958c-1fea-40e5-b5c6-dd59c2c1e462",
                                "sense_id": "5e23f87b-2e69-3385-81f4-0eb20aa3c80f",
                                "text": "Toen een van zijn collega's per microfoon de aanwezige Kamerleden liet weten dat hij strontzat was van het bla-bla, duwde de jonge Jos nog eens een extra stootje op zijn hoorn. “In het CDA zitten van die overlopers, daar heb je niks meer aan, die laten ons boeren mooi stikken”."
                            }
                        ]
                    }
