                                        "entry_id": "6ee44c9d-8bc2-3674-b4e6-a9572423543b",
                                        "glosses": [
                                            "Of a proportionate or similar measurable standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8af848-9a55-4bf7-ae09-1372a12cc371",
                                                "sense_id": "1202fc06-89ed-3661-8a50-e908f453c2d0",
                                                "text": "Kettering will become an important interchange for passengers making these journeys, and EMR is considering improvements to the station's facilities commensurate with this status."
                                            },
                                            {
                                                "example_id": "93a8a00e-45bc-452e-a807-3989d21071da",
                                                "sense_id": "1202fc06-89ed-3661-8a50-e908f453c2d0",
                                                "text": "commensurate punishments"
                                            },
                                            {
                                                "example_id": "ba88bdad-3fd6-4bc7-859b-37336013386b",
                                                "sense_id": "1202fc06-89ed-3661-8a50-e908f453c2d0",
                                                "text": "If it is essential in our interests to maintain a quasi-permanent position of power on the Asian mainland as against the Chinese then we must be prepared to continue to pay the present cost in Vietnam indefinitely and to meet any escalation on the other side with at least a commensurate escalation of commitment of our own."
                                            },
                                            {
                                                "example_id": "b32c5518-ada3-41c1-a568-235888ce3141",
                                                "sense_id": "1202fc06-89ed-3661-8a50-e908f453c2d0",
                                                "text": "The $100 settlement was hardly commensurate with the humiliation his client had experienced."
                                            },
                                            {
                                                "example_id": "bb586fe1-ff6b-47fd-8118-397aa6876dd9",
                                                "sense_id": "1202fc06-89ed-3661-8a50-e908f453c2d0",
                                                "text": "Mr. Katzenberg is now taking his commensurate lumps, particularly because contributors feel he helped disabuse donors’ concerns about Mr. Biden’s physical state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a6d9a8-1656-3578-bcfd-3513c1e23b1a",
                                        "entry_id": "6ee44c9d-8bc2-3674-b4e6-a9572423543b",
                                        "glosses": [
                                            "Describing a crystal in which every atom or molecule is placed in the same relative position"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "commensurate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e54093f-a1bb-3831-8776-a4e352570808",
                                        "entry_id": "1c1b81b8-773f-30a2-8954-5014039bdb4a",
                                        "glosses": [
                                            "To reduce to a common measure."
