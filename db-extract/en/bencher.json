                "translations": [
                    {
                        "translation_id": "c830b89b-f279-43b4-b4d6-405ec849e805",
                        "source_entry_id": "4488ea38-ac49-36f2-8b86-92cfbaee928b",
                        "source_sense_id": "2fc233ea-708c-3665-9d29-4f433b683af9",
                        "source_sense_description": "Vorstandsmitglied einer Anwaltsinnung",
                        "target_lang_word": "Vorstandsmitglied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorstandsmitglied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                        "entry_id": "95cde92f-7d8c-3d33-bd2a-9535b8e2358d",
                                        "glosses": [
                                            "eine Person, die Teil der Führungsgruppe in einem Verein oder Unternehmen (des Vorstands) ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c618988-cd4e-483e-87e0-de0e81564321",
                                                "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                                "text": "„Roland Heinisch […] war Vorstandsmitglied der Deutschen Bahn AG.“"
                                            },
                                            {
                                                "example_id": "fd0f37f6-2d56-46de-83d0-8d5e04a40a69",
                                                "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                                "text": "„Die Schutzgemeinschaft der Kapitalanleger (SdK) wehrt sich gegen den Vorwurf, amtierende Vorstandsmitglieder der Aktionärsvertretung könnten in kriminelle Börsengeschäfte involviert sein.“"
                                            },
                                            {
                                                "example_id": "7517382e-ad5b-4442-b9d2-7f1f570cf585",
                                                "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                                "text": "„Klingelzeichen ertönten, die Vorstandsmitglieder stürzten zum Eingang, und die in den verschiedenen Räumen zerstreuten Gäste drängten sich auf einen Haufen zusammen – es erinnerte an das Zusammenrinnen der Roggenkörner auf der Worfschaufel – und blieben im grossen Salon an der Saaltür stehen.“"
                                            },
                                            {
                                                "example_id": "d15cc41a-ee89-4020-beac-50741e0b9691",
                                                "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                                "text": "„Er hat eine nette, hilfsbereite Nachbarschaft, trifft sich seit vierzig Jahren mit seinen Freunden sonntags zum Frühschoppen und wurde als Vorstandsmitglied des Turnvereins zur großen Europa-Kreisel-Eröffnung sogar persönlich eingeladen.“"
                                            },
                                            {
                                                "example_id": "02afcfc5-bf73-4455-b366-d58c0844d27c",
                                                "sense_id": "62af0972-e30a-3952-9452-d155744a95a5",
                                                "text": "„Im Frühjahr 1977 trafen sich die Vorstandsmitglieder der ZANU sowie des Dare in der mosambikanischen Hauptstadt Maputo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
