                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tłumie dostał mocny <w>dubel</w> w żebra od spieszącego się pasażera.",
                            "target_lang_translations": {
                                "ru": "В толпе он получил сильный <w>тычок локтем</w> в рёбра от спешащего пассажира."
                            }
                        },
                        {
                            "text": "Niespodziewany <w>dubel</w> między żebra sprawił, że na chwilę stracił oddech.",
                            "target_lang_translations": {
                                "ru": "Неожиданный <w>удар локтем</w> под рёбра заставил его на секунду затаить дыхание."
                            }
