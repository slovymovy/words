                                        "entry_id": "0f7a336a-be92-375d-82f8-c1a711848c35",
                                        "glosses": [
                                            "Treatment with disinfectant materials in order to destroy harmful microorganisms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d356125b-223a-42f2-a7ae-e0abc6d29c70",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "Recent activity in the field of blood product disinfection has been based on a photovirucidal approach, with the requirement that the other microbial branches are also susceptible."
                                            },
                                            {
                                                "example_id": "0cb4f165-561c-4c59-a571-caaf71597e20",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "In brief, after application of the speculum and disinfection of the cervix, the hysterovideoscope was introduced intracervically."
                                            },
                                            {
                                                "example_id": "4b077f40-eda9-422d-af16-073704093eb8",
                                                "sense_id": "5ddd3ada-1443-3c22-a91b-f3ee5acd48f1",
                                                "text": "Whether full-room disinfections are necessary is not always clear."
                                            }
                                        ]
