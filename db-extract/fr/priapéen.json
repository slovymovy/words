                                "example_id": "a0b499a3-f8ed-425c-9e29-92665182b89f",
                                "sense_id": "8fa872cf-fe99-379b-81ac-780ba79c6f8c",
                                "text": "Mètre priapéen : vers composé d’un glyconique et d’un phérécratien."
                            },
