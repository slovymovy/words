                "senses": [
                    {
                        "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                        "entry_id": "2003d87f-338d-3773-aa5f-3e848be4ec6b",
                        "glosses": [
                            "ungewolltes Ereignis in einem Unternehmen oder einem Amt, durch das vertrauliche Daten öffentlich einsehbar werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2ee787a-ae60-4a79-8776-5cba6e2a02d1",
                                "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                                "text": "„Bei großen Datenleaks ist dann eher Detektivarbeit gefragt, die oft im Team geleistet wird.“"
                            },
                            {
                                "example_id": "f14ea1da-60ef-4d64-a15e-60fa12ef0390",
                                "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                                "text": "„Es steht außer Frage: Die Sorgen über Datenleaks und Missbrauch müssen ernstgenommen werden.“"
                            },
                            {
                                "example_id": "afeca6bc-fe4f-4fa9-808c-1137dc9262f8",
                                "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                                "text": "„Eine andere Möglichkeit zur Aufklärung sind Geheiminformationen, die von Überläufern, angeworbenen Quellen oder Datenleaks stammen.“"
                            },
                            {
                                "example_id": "69038ce9-9459-4e14-a918-97a688b21f64",
                                "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                                "text": "„Selbst zahlreiche Datenleaks oder die Skandale um einige der bekannten großen Anbieter mit dem Verkauf von Profildaten änderten daran bisher noch wenig.“"
                            },
                            {
                                "example_id": "0de67246-34d6-4a68-b690-f89546971138",
                                "sense_id": "0b4f9ba4-be84-3fb6-82e6-3a44f2743d68",
                                "text": "„Seine Forschungsschwerpunkte liegen im Bereich Identitätsdiebstahl und KIunterstützte Sammlung von Informationen über Datenleaks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
