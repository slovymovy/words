                ],
                "senses": [
                    {
                        "sense_id": "ac2e3345-34b8-3b9d-9d48-257b593fe489",
                        "entry_id": "4f962a5b-8b33-3498-84e0-78096c763db9",
                        "glosses": [
                            "S’adresser mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde5f137-8166-444a-ba37-6644ea0b81fa",
                                "sense_id": "ac2e3345-34b8-3b9d-9d48-257b593fe489",
                                "text": "Tous les personnages de nos mythologies pourraient s’entre-adresser et s’auto-adresser ce leitmotiv mélancolique et sacrificiel."
                            },
                            {
                                "example_id": "5da2feaf-7597-448f-abcc-7a34304d8d91",
                                "sense_id": "ac2e3345-34b8-3b9d-9d48-257b593fe489",
                                "text": "Fort curieusement, pourtant, et bien qu’elles n'aient aucun motif de se battre froid, bien qu’au contraire elles continuent à s’entre-adresser de temps en temps de francs et beaux sourires, elles ne font pas un pas l’une vers l’autre, en tant qu’Etats, du début d'août 1959 au début de février 1960."
                            }
                        ]
                    }
