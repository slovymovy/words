                                        "glosses": [
                                            "een lijn die getrokken is met een krijtje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b69b947e-e2b4-43fd-981d-974aea4dee50",
                                                "sense_id": "9569e926-7cbc-3fbd-9b01-ffabcea84550",
                                                "text": "Aan de andere kant stond Dolochovs kozak die de gevangenen telde en voor iedere honderd een krijtstreep op de poort zette."
                                            },
                                            {
                                                "example_id": "136e7770-bd50-44f0-95f2-16e74bd21f94",
                                                "sense_id": "9569e926-7cbc-3fbd-9b01-ffabcea84550",
                                                "text": "Tijdens de demonstratie gingen vrouwen op de grond liggen, met een krijtstreep om zich heen zoals dat op de plaats van een misdrijf wordt gedaan. Zo symboliseerden ze de vrouwen die zijn omgekomen door huiselijk geweld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8af6bf6f-b178-3435-922f-2f7b6ddcb200",
                                        "entry_id": "73408f5d-e670-395a-adf0-b457719a797b",
                                        "glosses": [
                                            "een textielpatroon bestaande uit dunne, parallel lopende lijnen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af48acf7-4e25-41f5-888e-6b7a3df35267",
                        "source_entry_id": "14d3d3f7-fc8f-32b6-bb07-714ebb1021e3",
                        "source_sense_description": "thin stripe on fabric",
                        "target_lang_word": "Nadelstreifen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nadelstreifen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                        "entry_id": "16e58927-fb6a-384c-9eff-5b7475d7da12",
                                        "glosses": [
                                            "in Anzugs- oder Kostümstoffen sich klar von den Grundstreifen abhebender, mäßig breiter Längsstreifen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b3a9262-492d-423b-8a44-6f40f615fbe8",
                                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                                "text": "Da der Anzugstoff mit Nadelstreifen einige Fehler hatte, so konnte ich ihn günstig kaufen."
                                            },
                                            {
                                                "example_id": "a1f7fd8b-0f21-4a0e-93bb-3f95b91505dc",
                                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                                "text": "„Mit seiner sanften Stimme und dem eleganten Anzug, den, passend zum rosa Hemd, rote Nadelstreifen durchziehen, ist Fawcett der perfekte Repräsentant einer Branche, bei der die Öffentlichkeit an vorlaute 30-Jährige im Ferrari denkt.“"
                                            },
                                            {
                                                "example_id": "49c748c5-64c9-4779-b198-01f29ba2a686",
                                                "sense_id": "f0342c65-62d8-33d6-b2b3-927c68c17393",
                                                "text": "„Die Liberalen im Bund geben sich wie Revolutionäre in Nadelstreifen - die letzte übrig gebliebene Reformpartei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
