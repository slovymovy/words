{
    "word_family": [
        "equipment",
        "equippable",
        "reequip"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbda3912-efce-3433-9897-a14447c63645",
                    "sense_definition": "To supply with something necessary in order to carry out a specific action or task",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "provide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>equip</w> its boxes with software that maintains a mesh network.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>оснастить</w> свои приставки программным обеспечением, поддерживающим ячеистую сеть."
                            }
                        },
                        {
                            "text": "They need to fit out the laboratory before they can <w>equip</w> the team with the necessary tools.",
                            "target_lang_translations": {
                                "ru": "Им нужно обустроить лабораторию, прежде чем они смогут <w>снабдить</w> команду необходимыми инструментами."
                            }
                        }
                    ],
                    "synonyms": [
                        "fit out",
                        "kit out"
                    ],
                    "common_phrases": [
                        "equip with tools",
                        "fully equip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать чем-либо необходимым для выполнения определенного действия или задачи"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оснащать",
                                "target_lang_sense_clarification": "техникой или оборудованием"
                            },
                            {
                                "target_lang_word": "оборудовать",
                                "target_lang_sense_clarification": "помещение или рабочее место"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "в поход или экспедицию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93351ebe-6c79-3b48-b44e-42decc9d2998",
                    "sense_definition": "To prepare someone with a specific skill or knowledge for a future purpose",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prepare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The course is designed to <w>equip</w> students with the skills needed for the modern workplace.",
                            "target_lang_translations": {
                                "ru": "Курс разработан для того, чтобы <w>вооружить</w> студентов навыками, необходимыми для современной работы."
                            }
                        },
                        {
                            "text": "Primary schools should <w>equip</w> pupils with basic knowledge to help them succeed in later life.",
                            "target_lang_translations": {
                                "ru": "Начальные школы должны <w>давать</w> ученикам базовые знания, чтобы помочь им преуспеть в дальнейшей жизни."
                            }
                        }
                    ],
                    "common_phrases": [
                        "equip with skills",
                        "equip for life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготавливать кого-либо, давая определенные навыки или знания для будущих целей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вооружать",
                                "target_lang_sense_clarification": "знаниями или навыками"
                            },
                            {
                                "target_lang_word": "подготавливать",
                                "target_lang_sense_clarification": "к будущей деятельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b10a6b9f-4f6e-3110-bfe7-e93c806d1ade",
                    "sense_definition": "To bring an item or piece of equipment into active use, especially in a game context",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>equip</w> your sword and attack the monster at close range.",
                            "target_lang_translations": {
                                "ru": "Тебе следует <w>экипировать</w> меч и атаковать монстра в ближнем бою."
                            }
                        },
                        {
                            "text": "The player must <w>equip</w> the magic armor to survive the next level of the dungeon.",
                            "target_lang_translations": {
                                "ru": "Игрок должен <w>надеть</w> магическую броню, чтобы выжить на следующем уровне подземелья."
                            }
                        }
                    ],
                    "common_phrases": [
                        "equip a weapon",
                        "equip an item"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить предмет или часть снаряжения в активное использование, особенно в игровом контексте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экипировать",
                                "target_lang_sense_clarification": "надеть предмет на персонажа"
                            },
                            {
                                "target_lang_word": "снаряжать",
                                "target_lang_sense_clarification": "выбирать активное оружие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "719797f3-4473-3fe6-89a0-d9756f249363",
                    "sense_definition": "To dress up or clothe someone in a particular way",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors were <w>equipped</w> in ridiculous habits for the historical play.",
                            "target_lang_translations": {
                                "ru": "Актеры были <w>облачены</w> в нелепые одеяния для исторической пьесы."
                            }
                        },
                        {
                            "text": "She was <w>equipped</w> in the height of the mode for the evening gala.",
                            "target_lang_translations": {
                                "ru": "Она была <w>одета</w> по последнему слову моды для вечернего торжества."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothe",
                        "dress",
                        "don"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is less common in modern usage compared to providing tools."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наряжать или одевать кого-либо определенным образом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облачать",
                                "target_lang_sense_clarification": "в одежду, часто торжественную"
                            },
                            {
                                "target_lang_word": "наряжать",
                                "target_lang_sense_clarification": "в костюм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38b583a5-2c64-3b6e-b543-11a2e06eacbd",
                    "sense_definition": "A piece of equipment carried by a character in a video game",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Check your inventory to see if you have any new <w>equip</w> to use.",
                            "target_lang_translations": {
                                "ru": "Проверь свой инвентарь, нет ли там новой <w>экипировки</w> для использования."
                            }
                        },
                        {
                            "text": "The boss dropped some rare <w>equip</w> that significantly boosted my character's stats.",
                            "target_lang_translations": {
                                "ru": "С босса выпал редкий <w>шмот</w>, который значительно повысил характеристики моего персонажа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rare equip",
                        "new equip"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in gaming communities as a shorthand for equipment."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет снаряжения, носимый персонажем в видеоигре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экипировка",
                                "target_lang_sense_clarification": "игровой предмет"
                            },
                            {
                                "target_lang_word": "шмот",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "снаряга",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}