                                "target_senses": [
                                    {
                                        "sense_id": "f7727c11-7d0e-3ddd-b273-b78e86fb3e70",
                                        "entry_id": "f51a51ab-7dc7-3fb1-af13-6e2fda53b338",
                                        "glosses": [
                                            "To shake or move with slight and tremulous motion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a6e028-4f11-4fa8-8f2f-423093c92c51",
                                                "sense_id": "f7727c11-7d0e-3ddd-b273-b78e86fb3e70",
                                                "text": "The birds chaunt melodie on euerie buſh,\n The ſnakes^([sic – meaning ſnake]) lies rolled in the chearefull ſunne,\n The greene leaues quiuer with the cooling winde,\n And make a checkerd ſhadow on the ground: [...]"
                                            },
                                            {
                                                "example_id": "22c2627c-79cb-4d6c-86cd-09a292ac087a",
                                                "sense_id": "f7727c11-7d0e-3ddd-b273-b78e86fb3e70",
                                                "text": "And left the limbs still quivering on the ground."
                                            },
                                            {
                                                "example_id": "3a58c793-2269-4331-9ead-82f129d70b32",
                                                "sense_id": "f7727c11-7d0e-3ddd-b273-b78e86fb3e70",
                                                "text": "Next moment with a rapid, nameless impulse, in a superb lofty arch the bright steel spans the foaming distance, and quivers in the life spot of the whale."
                                            },
                                            {
                                                "example_id": "63bb1d2a-31a6-4bf7-b68a-d7846a1e7b95",
                                                "sense_id": "f7727c11-7d0e-3ddd-b273-b78e86fb3e70",
                                                "text": "And the moonlight on the Church seemed to shift and quiver—some pigeons perhaps had been disturbed up there."
                                            }
                                        ]
                                    }
