                "senses": [
                    {
                        "sense_id": "8ee62c76-189e-37eb-ba7b-eed79e23acdc",
                        "entry_id": "2ca46c04-d537-3016-9eb7-91ab2b39d3d5",
                        "glosses": [
                            "Particule élémentaire hypothétique qui transmet la gravité dans la plupart des systèmes de gravité quantique."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "cca013e6-0339-472a-bc0b-417e1da9aed3",
                                "sense_id": "8ee62c76-189e-37eb-ba7b-eed79e23acdc",
                                "text": "Le graviton serait le quantum de la force gravitationnelle."
                            },
                            {
                                "example_id": "baf73e01-66bb-4a1c-a801-e6cd2accf584",
                                "sense_id": "8ee62c76-189e-37eb-ba7b-eed79e23acdc",
                                "text": "S’il existe, le graviton serait un boson dépourvu de masse et de charge, de spin égal à 2."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a3f02bb-47f9-43eb-a417-2b9df332ac63",
                        "source_entry_id": "2ca46c04-d537-3016-9eb7-91ab2b39d3d5",
                        "source_sense_id": "8ee62c76-189e-37eb-ba7b-eed79e23acdc",
