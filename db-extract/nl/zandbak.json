                                        "entry_id": "92cf2669-72e6-344e-9532-3c9635b91794",
                                        "glosses": [
                                            "mit Sand gefüllte Holz- oder Kunststoffkonstruktion zum Spielen für Kinder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "228448d4-a95f-4a0b-bd11-ce974e010c1d",
                                                "sense_id": "a8b0332b-b202-33b3-99c2-ab558bfacee8",
                                                "text": "Das Kind spielt im Sandkasten."
                                            },
                                            {
                                                "example_id": "7f71ffa8-0e94-437f-b334-9e1170f9ea94",
                                                "sense_id": "a8b0332b-b202-33b3-99c2-ab558bfacee8",
                                                "text": "„Wir durften sie alle mal halten, und dann verbuddelten wir sie im Sandkasten vorm Hochhaus.“"
                                            },
                                            {
                                                "example_id": "996ad9b8-8831-47f9-b37e-847d232d79e3",
                                                "sense_id": "a8b0332b-b202-33b3-99c2-ab558bfacee8",
                                                "text": "„Achtzehn Kinderköpfe schauten kurz hoch und sahen ihre Mütter am Rand des Sandkastens stehen.“"
                                            },
                                            {
                                                "example_id": "58bde839-5429-43a7-97a8-0340b149d961",
                                                "sense_id": "a8b0332b-b202-33b3-99c2-ab558bfacee8",
                                                "text": "„Auf einem Spielplatz mit obligatorischem Sandkasten und TÜV-geprüften Rutschen, Schaukeln, Klettergerüsten und Wipptieren kann man wohl spielen, aber die Möglichkeiten, etwas spielerisch zu erkunden, zu entdecken und zu erproben, sind gering.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "785a138d-f81f-3668-affb-e50e8b802629",
                                        "entry_id": "92cf2669-72e6-344e-9532-3c9635b91794",
                                        "glosses": [
                                            "Landschaftsmodell für die Planung militärischer Operationen, für geographischen Unterricht oder zu therapeutischen Zwecken (Sandspiel-Therapie)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "76badd2a-fc6d-35ab-ba62-2a0000b6fbc9",
                                        "entry_id": "92cf2669-72e6-344e-9532-3c9635b91794",
                                        "glosses": [
                                            "Behälter für den Bremssand bei Schienenfahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b3aed9-d27a-45b0-bc08-961bae0b87c1",
                                                "sense_id": "76badd2a-fc6d-35ab-ba62-2a0000b6fbc9",
                                                "text": "In der Remise wurde der Sandkasten der Lokomotive wieder aufgefüllt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
