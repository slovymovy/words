        "fr-extract.jsonl": [
            {
                "entry_id": "400d5c34-2c47-389a-8b7e-9efe8db1e085",
                "word": "Picardie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d448593d-658a-391e-a54f-cfeb9fb221d1",
                        "entry_id": "400d5c34-2c47-389a-8b7e-9efe8db1e085",
                        "glosses": [
                            "Ancienne région administrative de France située au nord de Paris."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "b47f2a88-5e8e-44de-98a5-20d39bc27d0d",
                                "sense_id": "d448593d-658a-391e-a54f-cfeb9fb221d1",
                                "text": "Rappelons, en effet, que la Thiérache, au sens géographique, fait partie de trois régions, Champagne-Ardennes, Picardie et Nord-Pas de Calais, qui sont toutes trois des régions fortement céréalières, ou encore dominées par la betteraviculture ou la viticulture."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1bfb8ed-fa91-314a-b73d-56b7860d962e",
                        "entry_id": "400d5c34-2c47-389a-8b7e-9efe8db1e085",
                        "glosses": [
                            "La Picardie fut aussi de la fin du Moyen Age à 1790 une province du royaume de France, en même temps qu'un territoire géographique et culturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30daa8eb-066e-4db3-aca5-1cefb0ec6690",
                                "sense_id": "e1bfb8ed-fa91-314a-b73d-56b7860d962e",
                                "text": "Après Amiens, il y a un grand espace fort laid, la Picardie, grise et tondue ; les moissons ont été enlevées ; pas un arbre, pas d’eau, des tranchées crayeuses."
                            },
                            {
                                "example_id": "06708722-3b06-46bd-ab4a-c4652dd80499",
                                "sense_id": "e1bfb8ed-fa91-314a-b73d-56b7860d962e",
                                "text": "Ces nodules sphéroïdes ou cylindroïdes, si singulièrement affublés, en Champagne, comme en Picardie ou en Haute-Normandie, de l’appellation imprévue de pierres de tonnerre ou de pierres de foudre sont formés de cristaux prismatiques de bisulfure de fer irradiant de leur centre."
                            },
                            {
                                "example_id": "b74fa04c-b2ce-4d49-bc17-d594a8ffc414",
                                "sense_id": "e1bfb8ed-fa91-314a-b73d-56b7860d962e",
                                "text": "Malade, il se retira chez sa sœur, Rosalie, veuve d'un comte de Creny, au petit château de Ménival, dans la commune de Lannoy-Cuillère, aux confins du pays de Bray et de la Picardie, où il fit son testament, laissant à ses proches le peu qui lui restait, et mourut le 26 janvier 1816."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "124dec95-e55b-4908-8c0f-d33829543a65",
                        "source_entry_id": "400d5c34-2c47-389a-8b7e-9efe8db1e085",
                        "target_lang_word": "Picardie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Picardie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b114cf65-5092-38a6-9c1c-dab03be905e7",
                                        "entry_id": "43f82969-eb64-3a12-8809-f941d16ba876",
                                        "glosses": [
                                            "Region (ehemalige Provinz) in Frankreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee595f6e-2517-4df6-acd4-d727b60853fa",
                                                "sense_id": "b114cf65-5092-38a6-9c1c-dab03be905e7",
                                                "text": "Die Picardie ist schön."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0586ea7-ac37-4354-ba0e-646f1a1c9202",
                        "source_entry_id": "400d5c34-2c47-389a-8b7e-9efe8db1e085",
                        "target_lang_word": "Pikardie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pikardie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0c856c-5398-3057-9ed5-b61f2c0937f6",
                                        "entry_id": "0242d56f-dc56-3942-b0f5-8c8ef324dcd6",
                                        "glosses": [
                                            "alternative Schreibweise für die Picardie (Region im Norden Frankreichs)"
                                        ],
                                        "tags": [],
