                {
                    "sense_id": "ef2c8bef-f700-3908-868b-fb9fc08b7907",
                    "sense_definition": "Ноющий, не резкий, приглушённый (о физической боли).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sensory_dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В затылке пульсировала постоянная <тупая> боль.",
                            "target_lang_translations": {
                                "en": "A constant <dull> pain throbbed in the back of his head.",
                                "de": "Im Hinterkopf pulsierte ein ständiger <w>dumpfer</w> Schmerz."
                            }
                        },
                        {
                            "text": "После падения он почувствовал <тупую> боль в правом плече.",
                            "target_lang_translations": {
                                "en": "After the fall, he felt a <dull> pain in his right shoulder.",
                                "de": "Nach dem Sturz spürte er einen <w>dumpfen</w> Schmerz in der rechten Schulter."
                            }
                        }
                    ],
                    "synonyms": [
                        "приглушённый",
                        "ноющий"
                    ],
                    "antonyms": [
                        "острый",
                        "резкий"
                    ],
                    "common_phrases": [
                        "тупая боль"
                    ],
                    "target_lang_definitions": {
                        "en": "Not intense or sharp; felt indistinctly (of pain).",
                        "de": "Nicht intensiv oder stechend; dumpf und kontinuierlich spürbar (von Schmerz)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dull",
                                "target_lang_sense_clarification": "of pain"
                            },
                            {
                                "target_lang_word": "aching",
                                "target_lang_sense_clarification": "continuous pain"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dumpf",
                                "target_lang_sense_clarification": "von Schmerz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98792d10-1e27-30ce-ac42-feffbaec9107",
                    "sense_definition": "Геометрический угол, который больше прямого (90°) и меньше развёрнутого (180°).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Треугольник, у которого один угол <тупой>, называется тупоугольным.",
                            "target_lang_translations": {
                                "en": "A triangle that has one <obtuse> angle is called an obtuse triangle.",
                                "de": "Ein Dreieck, das einen <w>stumpfen</w> Winkel hat, wird als stumpfwinkliges Dreieck bezeichnet."
                            }
                        },
                        {
                            "text": "Учитель попросил начертить в тетради <тупой> угол.",
                            "target_lang_translations": {
                                "en": "The teacher asked to draw an <obtuse> angle in the notebook.",
                                "de": "Der Lehrer bat darum, einen <w>stumpfen</w> Winkel ins Heft zu zeichnen."
                            }
                        }
                    ],
                    "antonyms": [
                        "острый"
                    ],
                    "common_phrases": [
                        "тупой угол"
                    ],
                    "target_lang_definitions": {
                        "en": "(Geometry) An angle greater than 90° and less than 180°.",
                        "de": "(Geometrie) Ein Winkel, der größer als 90° und kleiner als 180° ist."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obtuse",
                                "target_lang_sense_clarification": "geometry"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "stumpf",
                                "target_lang_sense_clarification": "Geometrie, von Winkeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe27e1ea-f814-30bb-af97-6c78ab772fe8",
                    "sense_definition": "Ничего не выражающий, бессмысленный (о взгляде или выражении лица).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_dullness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он смотрел на доску совершенно <тупым> взглядом, не понимая ни слова.",
                            "target_lang_translations": {
                                "en": "He looked at the board with a completely <vacant> stare, not understanding a word.",
                                "de": "Er starrte mit einem völlig <w>leeren</w> Blick an die Tafel und verstand kein Wort."
                            }
                        },
                        {
                            "text": "На его лице застыло <тупое> и равнодушное выражение.",
                            "target_lang_translations": {
                                "en": "A <dull> and indifferent expression froze on his face.",
                                "de": "Auf seinem Gesicht fror ein <w>stumpfer</w> und gleichgültiger Ausdruck ein."
                            }
                        }
                    ],
                    "synonyms": [
                        "бессмысленный",
                        "невыразительный"
                    ],
                    "antonyms": [
                        "осмысленный",
                        "выразительный"
                    ],
                    "common_phrases": [
                        "тупой взгляд",
                        "тупое выражение лица"
                    ],
                    "target_lang_definitions": {
                        "en": "Showing no intelligence, interest, or emotion; vacant.",
                        "de": "Zeigt keine Intelligenz, kein Interesse oder keine Emotion; ausdruckslos."
                    },
