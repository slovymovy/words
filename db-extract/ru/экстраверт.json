                                        "entry_id": "a0de248f-2db1-30b8-8998-e48c3b8aa07f",
                                        "glosses": [
                                            "Personne tournée vers l’extérieur, vers les autres, vers son environnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e7530c-f344-4647-8e5c-d734f6c66c27",
                                                "sense_id": "d2637bd4-8fa4-3f02-afd5-fc6c64ca6962",
                                                "text": "– Je suis un extraverti… Est-ce que ce n’est pas dangereux ?… À cause des invertis…\n– Aucun rapport, voyons !"
                                            },
                                            {
                                                "example_id": "a190e59b-5d8c-41c2-9c7b-c4815c897e85",
                                                "sense_id": "d2637bd4-8fa4-3f02-afd5-fc6c64ca6962",
                                                "text": "Mon but ici est de vous mettre en garde : si vous vous faites happer par le tourbillon d’un extraverti, assurez-vous que vous le faites consciemment et pour les bonnes raisons."
                                            }
                                        ]
                                    }
