                "senses": [
                    {
                        "sense_id": "ab786f10-f355-3913-9085-77a839953ba8",
                        "entry_id": "6f01d80f-9e0f-3cb9-b725-d3ad6a9afdea",
                        "glosses": [
                            "Ware, die aus dem Westen stammt und zur Zeit des Kalten Krieges im Osten begehrt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e144ca7-56f1-4510-b9fc-e1f0bea4cbd5",
                                "sense_id": "ab786f10-f355-3913-9085-77a839953ba8",
                                "text": "„Was wir zum Arbeiten brauchten, hatte Staszek nach Warschau vorgeschickt, und so hatten wir das Auto nur mit Westwaren vollgepackt, mit denen man Nachtquartiere bezahlen, Tür und Tor öffnen oder die man verschenken konnte.“"
                            },
                            {
                                "example_id": "d12e0066-a066-4167-b645-47e9f1e5bc84",
                                "sense_id": "ab786f10-f355-3913-9085-77a839953ba8",
                                "text": "„Die Bauern, bei denen Staszek unterkommt, geben ihm Brot zu essen und Rhabarberwein zutrinken - verlangen dafür allerdings Westwaren wie Strumpfhosen, Kaffee und Socken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
