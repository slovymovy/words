                                "target_senses": [
                                    {
                                        "sense_id": "4255bb25-4af6-3677-b116-f8b5afb7498f",
                                        "entry_id": "55baab9b-a29f-3d8c-a787-71b474c8f38e",
                                        "glosses": [
                                            "Pâtisserie légère qu’on sert soit à la fin d’un repas, soit au cours d’une matinée, d’une soirée, etc."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67482a35-b3b3-4929-ac9c-26a3d4f001e7",
                                                "sense_id": "4255bb25-4af6-3677-b116-f8b5afb7498f",
                                                "text": "La pâtisserie est aussi bonne qu’elle peut l’être dans un pays où il n’y a pas de beurre, où du moins il est si cher et de si mauvaise qualité qu’on n’en peut guère faire usage ; elle se rapproche de ce que nous appelons petit four."
                                            },
                                            {
                                                "example_id": "8df8b6b3-b19a-4fe2-a27e-5bd78628fd6e",
                                                "sense_id": "4255bb25-4af6-3677-b116-f8b5afb7498f",
                                                "text": "Nous arrivâmes chargés de fleurs et de petits fours."
                                            },
                                            {
                                                "example_id": "59aef020-d16d-45fe-a24d-ee76b8e635cf",
                                                "sense_id": "4255bb25-4af6-3677-b116-f8b5afb7498f",
                                                "text": "Et j’ai assisté à un minidéfilé de Lussan et Livonnière qui gueulaient : « Libérez les petits fours ! » Je croyais que les situationnistes étaient toujours en vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
