                        "examples": [
                            {
                                "example_id": "87319928-197b-448c-b950-e0bd58929d0d",
                                "sense_id": "1d78912d-8be5-30d7-9a39-af2d24bd796b",
                                "text": "За полночь послышалось Помаде, будто кто-то стучит в сеничную дверь."
