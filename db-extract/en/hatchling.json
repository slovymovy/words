                    {
                        "translation_id": "dc75aa4e-391f-49ff-8364-b2bb3d652ca5",
                        "source_entry_id": "bc51a0c7-f654-3f68-885a-3715995f2342",
                        "source_sense_description": "a newly hatched animal",
                        "target_lang_word": "Schlüpfling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlüpfling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                        "entry_id": "78c5ed9d-eada-3edc-a301-aba4a483e001",
                                        "glosses": [
                                            "(aus einem Ei) geschlüpftes Jungtier; (nach der Metamorphose aus der Puppe) geschlüpftes Imago"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e3711ea-6390-4536-813d-260b91ff8067",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Das sechs Zentimeter große und 400 Gramm schwere Ei, dessen Schlüpfling 15 Zentimeter groß gewesen wäre, stammt aus der Provinz Henan in Zentralchina, wo 1992 während der Begrünung des Funiu-Berges Tausende von Dinosaurier-Eiern zum Vorschein kamen.“"
                                            },
                                            {
                                                "example_id": "825c3a61-38ee-4d7b-82eb-4d960f98f975",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Es wäre wünschenswert, wenn hier die Schmetterlingszüchter mitarbeiten würden und durch genaue Aufzeichnungen über ihre Schlüpflinge für die Frage der Proterandrie und Protogynie weiteres Material lieferten.“"
                                            },
                                            {
                                                "example_id": "dc65ba31-548c-48b7-99ef-6c12b10ba871",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Langsam bewegte sich der Vogel auf die Nestöffnung zu und fing an, auf den Kopf des Schlüpflings einzuhacken.“"
                                            },
                                            {
                                                "example_id": "10a5e051-b70a-4cba-9046-447c04ecd225",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Immer häufiger würden die Schildkröteneier in den Brutgebieten von Schweinen ausgegraben, während die übriggebliebenen Schlüpflinge Hunden und Ratten zum Opfer fielen.“"
                                            },
                                            {
                                                "example_id": "024850e1-1d32-4cd2-a081-64f96dfd5514",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„In seinen Terrarien tummeln sich zur Zeit sieben Schlüpflinge einer Chamäleonart aus dem Jemen und täglich kommen noch einige hinzu.“"
                                            },
                                            {
                                                "example_id": "35d3e53c-e932-4f2e-9f51-5ae4ccf9b793",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Grund ist den Imkern zufolge eine ‚explosionsartige‘ Vermehrung der so genannten Varroa-Milbe. Diese winzigen Tierchen legen ihre Eier in die Bienenwaben, wo die Schlüpflinge den Bienennachwuchs töten.“"
                                            },
                                            {
                                                "example_id": "6712b551-b1f6-4911-97d0-436d566eebbc",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„2009 kamen noch fünf Vögel zurück, es gab zwei Nester mit drei Schlüpflingen, von denen bislang bereits zwei ums Leben kamen.“"
                                            },
                                            {
                                                "example_id": "7bc80c7b-d017-481b-b19d-42d4ef03c860",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Auch wenn die Aufzucht von Jungvögeln für Bärbel Rogoschik, Leiterin des Artenschutzzentrums, keine neue Situation ist, eine besondere ist sie dennoch: ‚Es ist immer wieder faszinierend zu beobachten, in welch kurzer Zeit sich ein Storch vom Schlüpfling zu einem flüggen Jungvogel entwickelt.‘“"
                                            },
                                            {
                                                "example_id": "0efd04e9-e409-49f5-9913-86461c52fcf6",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Bei den insgesamt 106 umgesiedelten Zauneidechsen habe es sich um 23 ausgewachsene Tiere, um elf Tiere mittleren Alters sowie um 72 Jungtiere – überwiegend Schlüpflinge – gehandelt.“"
                                            },
                                            {
                                                "example_id": "39d4c81a-6a8b-4476-964c-9f9143dcd5a8",
                                                "sense_id": "1074b378-ebbe-38c4-a719-74496a866430",
                                                "text": "„Wie bei den Vögeln haben übrigens die Schlüpflinge auch bei den meisten Reptilien einen so genannten Eizahn auf dem Schnabel beziehungsweise an der Spitze des Mauls.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
