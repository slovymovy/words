                "senses": [
                    {
                        "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                        "entry_id": "6dcd5e40-c919-3859-b183-dc80a0d5ff68",
                        "glosses": [
                            "analytische und physikalische Betrachtung zu lüftungstechnischen Strömungen, technischen Maßnahmen und baulichen Notwendigkeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11475027-e2d5-4676-a30f-b80d14534101",
                                "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                                "text": "„Die Lüftungsberechnung im Internet für den Tunnelbau und Bergbau nach der international anerkannten Schweizer Norm SIA-196.“"
                            },
                            {
                                "example_id": "476c49de-d3f3-4f1f-9ee2-0f5544e044ef",
                                "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                                "text": "„Ebenfalls ergänzt wurde eine Lüftungsberechnung zur Einhaltung des Feuchteschutzes für Gebäude beim Einsatz einer kontrollierten Wohnraumbelüftung.“"
                            },
                            {
                                "example_id": "d5696d21-9b1b-4111-b7fe-08eff2da2f23",
                                "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                                "text": "„Es wurden Lüftungsberechnungen für den Regelbetrieb nach RABT (2006) durchgeführt.“"
                            },
                            {
                                "example_id": "d6e21111-6208-4c41-bba0-3ef0b244823f",
                                "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                                "text": "„Am Markt werden Falschplanungen und Fehlberatungen durchgeführt: Oft werden zu geringe Luftvolumenströme als Basis der Planungen angesetzt – dies ist bereits ein Baumangel und der häufigste Fehler bei der Lüftungsberechnung!“"
                            },
                            {
                                "example_id": "145bf896-c857-4821-852e-91710d5c2a9c",
                                "sense_id": "53f819cd-403b-3a31-b102-869f4a33db15",
                                "text": "„Dem Antrag der Beigeladenen vom 01.03.2006 waren umfangreiche Unterlagen beigefügt, etwa die Vorhabensbeschreibung, eine Geruchs- und Ammoniakimmissionsprognose, eine Umweltverträglichkeitsstudie, Bauplanungsunterlagen, Beschreibung der zu erwartenden Emissionen und Immissionen, eine Stalllüftungsbeschreibung, eine Lüftungsberechnung, eine Beschreibung der Gülleanlage, eine Beschreibung der Abluftreinigungsanlage, Zeichnungen der Abwäscheranlagen, Aussagen zur Wasserversorgung und zur Abwasserbeseitigung sowie Aussagen zum Umgang mit wassergefährdenden Stoffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
