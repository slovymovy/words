                        "glosses": [
                            "A song or poem in honour of a bride and bridegroom about to be married."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "09841cff-aeee-4b6e-ac4d-4ee28bbaa613",
                                "sense_id": "886b0dfe-95e0-373e-b3b7-9f709a99d4f9",
                                "text": "Zauq then wrote his own prothalamion in which the last verse (in the same vein as Ghalib's) challenged the ability of those who made a claim to be poets to equal his writing of a sehra. Zauq's prothalamion was given very wide publicity by the professional singers in the palace, and the next day it was published in the local newspaper."
                            }
                        ]
