                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f4bc3a-9e8a-4ba7-8b32-34a93fce63e2",
                                                "sense_id": "1cc8e0ba-c219-3052-ab37-f0f595df8037",
                                                "text": "Het gezellig samenzijn met je geliefde is toch het leukste wat er is."
                                            },
                                            {
                                                "example_id": "54e4d27e-2a38-41e7-8897-b8d62622d8b3",
                                                "sense_id": "1cc8e0ba-c219-3052-ab37-f0f595df8037",
                                                "text": "Mijn laatste afscheidstoespraak had ik gehouden voor een bejaardenkoortje. `U allen moet blijven. Ik moet nu gaan.' Er werd geweend om mijn vertrek. Hoe vaak had ik niet ergens opnieuw moeten beginnen, om uiteindelijk de meest ontroerende momenten van samenzijn te ervaren op het moment dat ik had besloten te vertrekken?"
                                            }
                                        ]
