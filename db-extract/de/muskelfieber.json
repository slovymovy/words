                "senses": [
                    {
                        "sense_id": "c699a478-b8e9-39ce-9e18-77b5262b3d73",
                        "entry_id": "00c3a0ac-adb2-3b32-9494-bd0cc0bdb11e",
                        "glosses": [
                            "vorübergehende Schmerzen in den Muskeln, die, nach (ungewohnter) körperlicher Anstrengung, durch zur Verhärtung des Muskelgewebes führende kleine Risse in Teilen der Muskelfasern sowie nachfolgender Bildung lokaler Ödeme entstehen"
                        ],
                        "tags": [
                            "especially",
                            "outdated",
                            "plural",
                            "rare",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "8ca4dd2a-8dbf-4cca-b754-72dde5c323c4",
                                "sense_id": "c699a478-b8e9-39ce-9e18-77b5262b3d73",
                                "text": "„Mit Klatschungen und Klopfungen des Rumpfes und der Glieder, wie das heute auch in der finnischen Massage geschieht, wurden besonders Übermüdungszustände behandelt, ob sie nun in Muskelspannungen (Muskelfieber) oder in allgemeiner Erschlaffung bestanden.“"
                            },
                            {
                                "example_id": "8b1a1e9b-a490-46c4-a424-3b8dff7df65f",
                                "sense_id": "c699a478-b8e9-39ce-9e18-77b5262b3d73",
                                "text": "„Aufgrund körperlicher Schwächen durch Muskelfieber musste der 45-jährige seine Mission für die Herzkinder Österreich nach 12 Ironman abbrechen.“"
                            },
                            {
                                "example_id": "41e8e3ec-60f6-465b-9e87-7fa8bb53561b",
                                "sense_id": "c699a478-b8e9-39ce-9e18-77b5262b3d73",
                                "text": "„Am nächsten Tag gab es Muskelfieber, vom vielen Fallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
