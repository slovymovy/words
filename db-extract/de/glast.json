                ],
                "senses": [
                    {
                        "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                        "entry_id": "73ea24f3-93a0-34c7-a4f8-19a3ca8a909d",
                        "glosses": [
                            "Glanz, Schein, Schimmer, Leuchten, von einem Naturelement ausgehend (Sonne, Feuer, Blitz, Sterne)"
                        ],
                        "tags": [
                            "South-German",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "dd3f2af3-ae23-48ac-a99b-08d2f2090221",
                                "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                                "text": "„Ihr Alle, mein’ ich, habt gehört von jenem seltnen Eispalast! / Auf der gefrornen Newafluth aufstarrte der gefrorne Glast!”"
                            },
                            {
                                "example_id": "b0c152a1-f8bc-4abe-ba5a-8affc1e367fb",
                                "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                                "text": "„Doch von des Auges kaltem Glast, Voll toten Lichts, gebrochen fast, Gespenstig, würd', ein scheuer Gast, Weit, weit ich meinen Schemel rücken.“"
                            },
                            {
                                "example_id": "6f2f2cec-9bfb-4286-8f5f-b6e037a1b4f1",
                                "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                                "text": "„Dann flirrten nur die Peitschenschläge der Mokassin- und der Indigo-Schlangen durch den Glast.“"
                            },
                            {
                                "example_id": "98b03e34-b55d-4cd7-a3e6-19a0a54ea09f",
                                "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                                "text": "„Nachdem sie seinen Blicken entschwunden war, spähte er in die von ihr bezeichnete Richtung, wo er die im Glast der Luft zitternden Umrisse eines sich verjüngenden Giebels wahrnahm, die auf ein Kultgebäude deuteten.“"
                            },
                            {
                                "example_id": "f821f846-7155-443d-bd3a-075321f08126",
                                "sense_id": "644ab95c-192a-35af-a67b-e51ce80d0dfc",
                                "text": "„Fern standen im silbernen Glast die scharzen Wälder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
