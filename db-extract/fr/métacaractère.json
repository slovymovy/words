                "word": "métacaractère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0dc540c0-00b0-4cb6-b46f-0e101b7a2a6d",
                        "entry_id": "5c1f4d9e-9e02-32b4-b377-ed810f518698",
                        "tags": [
                            "plural"
                        ],
                        "form": "métacaractères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9a98ef6-556a-3ca0-bbdc-d2e776553a90",
                        "entry_id": "5c1f4d9e-9e02-32b4-b377-ed810f518698",
                        "glosses": [
                            "Type de caractère informatique, utilisé lors de la recherche d'un mot ou d'une expression incomplète sur un réseau informatisé, ordinateur ou internet."
                        ],
                        "tags": [
                            "Expressions rationnelles"
                        ],
                        "examples": [
                            {
                                "example_id": "baf85fb2-bcfe-437a-ae9f-de4f87d0c19d",
                                "sense_id": "d9a98ef6-556a-3ca0-bbdc-d2e776553a90",
                                "text": "Dans les expressions régulières, le métacaractère * signifie en général des caractères quelconques en nombre quelconque."
                            },
                            {
                                "example_id": "ea1da3fa-ec7a-466a-862f-598488306935",
                                "sense_id": "d9a98ef6-556a-3ca0-bbdc-d2e776553a90",
                                "text": "Le caractère \\ empêche l’interprétation particulière du métacaractère qui suit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be93158c-a397-4693-8691-f0a980c484b2",
                        "source_entry_id": "5c1f4d9e-9e02-32b4-b377-ed810f518698",
                        "source_sense_id": "d9a98ef6-556a-3ca0-bbdc-d2e776553a90",
                        "target_lang_word": "Wildcard",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wildcard",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                                        "entry_id": "095bb470-036d-32fa-ace5-7daf41c964a6",
                                        "glosses": [
                                            "Berechtigung für die Teilnahme an einem Wettbewerb oder Turnier, die von dem Veranstalter an einen Teilnehmer vergeben wird, der nicht über die formellen Qualifikationen verfügt"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3808ca1-9bd2-4606-be18-0f97405dac9e",
                                                "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                                                "text": "„Es ist das bedeutendste Mannschaftsturnier im Golfsport – und Martin Kaymer ist erneut dabei: Der Deutsche erhielt eine Wildcard für das europäische Team.“"
                                            },
                                            {
                                                "example_id": "41922870-e9f8-4dfa-b5c8-e72a5f556ae9",
                                                "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                                                "text": "„Mit einer Wildcard nimmt er in den kommenden drei Tagen am Turnier in Jeddah teil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85c7299e-74de-30c4-a9d4-fcb92daffd39",
                                        "entry_id": "095bb470-036d-32fa-ace5-7daf41c964a6",
                                        "glosses": [
                                            "Zeichen oder Zeichenfolge, die stellvertretend für beliebige andere Zeichen steht"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f824ea-b79e-4860-ab20-cc49f93da8cd",
                                                "sense_id": "85c7299e-74de-30c4-a9d4-fcb92daffd39",
                                                "text": "Das * in der Abfrage *.com ist eine Wildcard und steht für jede beliebige Zeichenfolge vor der Dateiendung.com."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ced5992-08bd-470e-8107-c7c3d22d411d",
                        "source_entry_id": "5c1f4d9e-9e02-32b4-b377-ed810f518698",
                        "source_sense_id": "d9a98ef6-556a-3ca0-bbdc-d2e776553a90",
                        "target_lang_word": "Platzhalter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzhalter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2415039a-9032-320d-a137-53deac50b871",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "allgemein: Person, die für eine andere einen Platz freihält"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "grammatische Einheit in einem übergeordneten Teilsatz, die auf etwas im untergeordneten Teilsatz hinweist, selbst keine eigene Bedeutung hat und in vielen Fällen auch einfach weggelassen werden kann."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e174a173-702b-4256-b049-f1ab83e6cfef",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "Der Platzhalter \"es\" in dem Satz \"Es ist richtig, dass du kommen willst\" weist auf den untergeordneten Teilsatz (= Nebensatz) \"dass du kommen willst\" hin und wird ausgelassen, wenn die Stellung der Wortgruppen verändert wird: \"Dass du kommen willst, ist richtig.\" Das \"es\" ist in diesem Fall an die erste Position gebunden."
                                            },
                                            {
                                                "example_id": "fd807076-e113-4fbe-b1eb-ee25f1c6eeff",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "Auch Pronominaladverbien werden oft als Platzhalter verwendet und können meist ausgelassen werden: \"Wir freuen uns darüber, dass du kommst.\" Der Platzhalter \"darüber\" kann problemlos ausgelassen werden."
                                            },
                                            {
                                                "example_id": "a5b5cdcf-6e65-42d0-abf2-df395880591f",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "„Man spricht dann von einen Vorfeldplatzhalter oder meist kürzer von einem Platzhalter.“"
                                            },
                                            {
                                                "example_id": "d9dbd190-d70a-4884-a8c7-eb3bfbc5e5db",
                                                "sense_id": "1aa0e9f7-5339-3c30-af00-da13739d5d19",
                                                "text": "„Wir unterscheiden zunächst nach unterordnenden und gleichordnenden Verknüpfungsmitteln und werden dann die sogenannten Vertreterelement, oft Platzhalter genannt, behandeln…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "94e34199-519e-324a-805f-38829f70f577",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "ein Zeichen oder eine Zeichenkette, die stellvertretend für etwas steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff973d36-06cc-44e1-910a-ea791064e729",
                                                "sense_id": "94e34199-519e-324a-805f-38829f70f577",
                                                "text": "„Dort, wo, aus welchem Grunde auch immer, im Schriftbild Buchstaben ausgelassen sind, oder beim Lesen und Sprechen Laute, da ist – quasi als Platzhalter und zum Zeichen des Tilgens – ein Apostroph zu setzen, zu schreiben, zu drucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b401f377-7336-37f7-a251-e62c4b13a22d",
                                        "entry_id": "7054a115-2470-3f76-b62a-00d5a7d2a125",
                                        "glosses": [
                                            "Name für eine Leerstelle in einem logischen oder mathematischen Ausdruck"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ae7b1ad-daa6-46ad-b3ff-bf31bc4de5c6",
                        "source_entry_id": "5c1f4d9e-9e02-32b4-b377-ed810f518698",
