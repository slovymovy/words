                        "wayside stand"
                    ],
                    "target_lang_definitions": {
                        "pl": "Znajdujący się przy drodze lub ścieżce."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przydrożny",
                                "target_lang_sense_clarification": "przymiotnik określający coś przy drodze"
                            }
                        ]
                    }
                }
            ]
        },
