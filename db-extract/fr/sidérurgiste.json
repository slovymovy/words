                                "target_senses": [
                                    {
                                        "sense_id": "f63efd56-9cc4-3e51-a64a-68cf42bd0993",
                                        "entry_id": "41e2c452-103b-32d1-95f3-3855290292b1",
                                        "glosses": [
                                            "A person who works in a steel mill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f4fe3a5-ad94-4007-8e87-b189e7365e64",
                                                "sense_id": "f63efd56-9cc4-3e51-a64a-68cf42bd0993",
                                                "text": "The United Steelworkers strike closed the mill."
                                            },
                                            {
                                                "example_id": "ef792273-0551-45be-a886-61103629654a",
                                                "sense_id": "f63efd56-9cc4-3e51-a64a-68cf42bd0993",
                                                "text": "The steelworkers union has been joined by members from the teachers, hotel, and postal workers unions in getting out the vote for Lamb. […] Denny Cregut is a former steelworker who now works for the United Steelworkers Union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83e7c83d-1612-3229-9d5c-840ed08a033a",
                                        "entry_id": "41e2c452-103b-32d1-95f3-3855290292b1",
                                        "glosses": [
                                            "A person employed to build steel structures, an ironworker."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9208f1f6-970a-4efc-98e6-edeeebd98983",
                                                "sense_id": "83e7c83d-1612-3229-9d5c-840ed08a033a",
                                                "text": "The steelworkers and electricians went on strike, halting construction."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
