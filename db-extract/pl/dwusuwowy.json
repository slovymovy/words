                        "sense_id": "492edc94-99d9-31bd-bbba-f8994b4d0111",
                        "entry_id": "f982afeb-42cb-38e9-a9a8-2047ce0f286d",
                        "glosses": [
                            "o silniku: wykonujący cały obieg pracy w ciągu dwóch ruchów tłoka w cylindrze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37cd335d-60c3-4696-afad-19a76a175388",
                                "sense_id": "492edc94-99d9-31bd-bbba-f8994b4d0111",
                                "text": "Niektóre silniki są skomplikowane, inne zaś prostsze, ale w swej prostocie równie genialne. Przykładem może być silnik dwusuwowy, który dziś jest już niemal zabytkiem, ale w swych czasach napędzał wiele aut."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "99552776-82b8-3e1a-9cb4-d643e31c2652",
                        "entry_id": "f982afeb-42cb-38e9-a9a8-2047ce0f286d",
                        "glosses": [
                            "taki, który napędzany jest silnikiem dwusuwowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6f8a55-df89-4814-937b-922458298c3b",
                                "sense_id": "99552776-82b8-3e1a-9cb4-d643e31c2652",
                                "text": "Kiedy zależy nam na szybkim i sprawnym uprzątnięciu naszego np. ogrodu, możemy wykorzystać urządzenia mechaniczne. Wystarczy tutaj odśnieżarka dwusuwowa."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
