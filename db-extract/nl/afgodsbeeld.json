                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2cbc8d97-e736-4c44-af9e-27ce8e256aa2",
                        "entry_id": "2f30c84d-c11b-3645-a148-03fc2fb036bd",
