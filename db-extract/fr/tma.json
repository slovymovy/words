                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e724edcd-4701-44d4-856a-01234cdab941",
                                                "sense_id": "a18251dc-020f-3350-8ebb-93f7caa6ae48",
                                                "text": "a TMA system is the kind of thing that explains English “would”, “could”, “-ed”, “-ing”, “-s”, “have”, “been”, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2660be7c-7b5e-3db6-bec9-a9939332b050",
                                        "entry_id": "99e7ec35-4c89-3f63-bd1d-18459e933875",
                                        "glosses": [
                                            "Initialism of trimethoxyamphetamine."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a128900-6133-4371-bc8b-f34784cf3e72",
                                                "sense_id": "2660be7c-7b5e-3db6-bec9-a9939332b050",
                                                "text": "A little over 50 years later – with LSD, psilocybin, psilocin, TMA, several compounds based on DMT and various other isomers – the number was up to almost 20."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20f2230c-8fe2-390e-93e7-e22a75d65ce1",
                                        "entry_id": "99e7ec35-4c89-3f63-bd1d-18459e933875",
