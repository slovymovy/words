                            }
                        },
                        {
                            "text": "De <w>entree</w> voor het concert was behoorlijk duur.",
                            "target_lang_translations": {
                                "ru": "<w>Входная плата</w> за концерт была довольно высокой.",
                                "en": "The <w>entrance fee</w> for the concert was quite expensive.",
                                "pl": "<w>Wstęp</w> na koncert był dość drogi.",
