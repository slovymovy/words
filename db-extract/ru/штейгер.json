                ],
                "senses": [
                    {
                        "sense_id": "fde448b8-a5f8-3f78-9d67-280c3768e1f4",
                        "entry_id": "1bbce641-1162-3ab0-883a-ad8b0e25f6c7",
                        "glosses": [
                            "устар., горн. горный мастер, ведающий рудничными работами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc6db15-75a7-4e3e-9fea-544dbbd051d6",
                                "sense_id": "fde448b8-a5f8-3f78-9d67-280c3768e1f4",
                                "text": "В примитивном горном хозяйстве штейгер был одновременно и маркшейдером, и пробщиком руды, и руководителем бурения — словом, универсальным горным специалистом."
                            },
                            {
                                "example_id": "cdb44d33-3022-461f-8a28-54d853ffddc5",
                                "sense_id": "fde448b8-a5f8-3f78-9d67-280c3768e1f4",
                                "text": "Наблюдал за этими работами Родион Потапыч Зыков, старейший штейгер на всех Балчуговских золотых промыслах."
                            },
                            {
                                "example_id": "03ad0c55-023d-4029-97dd-5cf1940b6d95",
                                "sense_id": "fde448b8-a5f8-3f78-9d67-280c3768e1f4",
                                "text": "Горного инженера, которого общество обязано иметь по контракту, нет, и копями заведует простой штейгер."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d7e71b5-7a5d-422d-a477-d68b10607396",
                        "source_entry_id": "1bbce641-1162-3ab0-883a-ad8b0e25f6c7",
                        "source_sense_id": "fde448b8-a5f8-3f78-9d67-280c3768e1f4",
                        "target_lang_word": "Steiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de4da1f4-4b09-3eaf-8696-59eca4232502",
                                        "entry_id": "51d56dd1-eadb-393e-b643-533a84fe6523",
                                        "glosses": [
                                            "eine Aufsichtsperson im Bergbau"
                                        ],
                                        "tags": [
                                            "Bergbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f32a9b25-f143-4f99-af3a-03d9680203e6",
                                                "sense_id": "de4da1f4-4b09-3eaf-8696-59eca4232502",
                                                "text": "„Der Steiger griff zum Werkzeug, schlug und schlug, aber kein Gestein löste sich.“"
                                            },
                                            {
                                                "example_id": "b9c39f80-634f-4efd-92b2-a7afc6af841a",
                                                "sense_id": "de4da1f4-4b09-3eaf-8696-59eca4232502",
                                                "text": "„Erst Jahre später erzählte er uns die Geschichte, wie sein Steiger ihm geholfen hatte.“"
                                            },
                                            {
                                                "example_id": "ff4f34f8-4adb-44b3-9ade-b753b015be03",
                                                "sense_id": "de4da1f4-4b09-3eaf-8696-59eca4232502",
                                                "text": "„Mehrere Jahre arbeitete er in Bottrop und Elberfeld als Hauer und Steiger.“"
                                            }
                                        ],
