                },
                {
                    "sense_id": "9b2c194e-0ebb-3966-b235-3f79c06b3079",
                    "sense_definition": "Лингвистический термин: о предложении, имеющем второстепенные члены.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученики должны были составить <w>распространённое</w> предложение с причастным оборотом.",
                            "target_lang_translations": {
                                "de": "Die Schüler sollten einen <w>erweiterten</w> Satz mit einem Partizipialattribut bilden."
                            }
                        },
                        {
                            "text": "В отличие от простого, <w>распространённое</w> предложение содержит определения или дополнения.",
                            "target_lang_translations": {
                                "de": "Im Gegensatz zum einfachen Satz enthält ein <w>erweiterter</w> Satz Attribute oder Ergänzungen."
                            }
                        }
                    ],
                    "antonyms": [
                        "нераспространённый"
                    ],
                    "common_phrases": [
                        "распространённое предложение"
                    ],
                    "target_lang_definitions": {
                        "de": "Linguistischer Fachbegriff für einen Satz, der durch Satzglieder wie Attribute oder Ergänzungen erweitert ist."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erweitert",
                                "target_lang_sense_clarification": "in der Grammatik: ein Satz mit Satzgliedern über Subjekt und Prädikat hinaus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a4768ee-6f48-3034-9e25-df8267e1932c",
                    "sense_definition": "Устаревшее или книжное: подробный, пространный, расширенный.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "detailed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор представил <w>распространённое</w> описание событий того времени.",
                            "target_lang_translations": {
                                "de": "Der Autor legte eine <w>ausführliche</w> Beschreibung der Ereignisse jener Zeit vor."
                            }
                        },
                        {
                            "text": "Существует краткая и более <w>распространённая</w> версия этого документа.",
                            "target_lang_translations": {
