                        "source_entry_id": "8e989671-2259-3702-b733-2ea4dbfa7b4c",
                        "source_sense_id": "1c921fb1-a528-3890-be5d-7b47f4531a00",
                        "source_sense_description": "Translations",
                        "target_lang_word": "myriamètre",
