    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                "word": "indefinable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08cabe7a-a31b-3702-8315-9b634221b5b7",
                        "entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "glosses": [
                            "That which cannot be precisely defined or put into words."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "037a8371-ba3c-41e7-ad15-425cd2569f26",
                                "sense_id": "08cabe7a-a31b-3702-8315-9b634221b5b7",
                                "text": "They apparently have a theory that the indefinable psychic gift that they call magic, and which we might designate \"psychicism\", can be acquired by accosting the soul of a murdered man in a burial ground at midnight."
                            }
                        ]
                    },
                    {
                        "sense_id": "04590a4e-951d-3771-aa74-b5ff9e49d904",
                        "entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "glosses": [
                            "That which defies description; indescribable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bbf627a-e2b3-4717-952a-af0b9a333907",
                        "source_entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "source_sense_description": "that which defies description",
                        "target_lang_word": "nedefinovatelný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aa1446bc-d4e1-4e47-b998-39307c54eb39",
                        "source_entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "source_sense_description": "that which defies description",
                        "target_lang_word": "ondefinieerbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ondefinieerbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "68dcb568-18d5-36d7-87e6-43f49e95a05d",
                                        "entry_id": "6eca2403-6a74-36f7-b6b0-705db3c63c50",
                                        "glosses": [
                                            "wat niet duidelijk te beschrijven is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bff268c-4bc8-4f2b-ba4b-f89e054a1c63",
                                                "sense_id": "68dcb568-18d5-36d7-87e6-43f49e95a05d",
                                                "text": "Schoonheid en kunstbeleving zijn vaak ondefinieerbare gevoelens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6be8c2c-7e5b-4a36-af06-6825cc206fac",
                        "source_entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "source_sense_description": "that which defies description",
                        "target_lang_word": "indéfinissable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéfinissable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                        "entry_id": "e59eddfd-6cec-3f8c-91ae-408c0104e19d",
                                        "glosses": [
                                            "Qu’on ne peut définir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bdd4607-a464-4c6b-bbf5-ad94bfb21280",
                                                "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                                "text": "Malgré la brièveté de son regard, il put alors admirer l'expression de mélancolie qui donnait à la figure pensive de la comtesse je ne sais quel attrait indéfinissable."
                                            },
                                            {
                                                "example_id": "e4bffd12-bf2c-4572-851d-65a4ec76b264",
                                                "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                                "text": "Les Liméniennes ont toutes de belles couleurs, les lèvres d’un rouge vif, de beaux cheveux noirs et bouclés naturellement, des yeux noirs d’une expression indéfinissable d’esprit, de fierté et de langueur."
                                            },
                                            {
                                                "example_id": "ccf77cd7-7aaf-4f1f-9b2b-63eb254a9ba9",
                                                "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            },
                                            {
                                                "example_id": "5eb1ecc9-6197-4955-90f6-ec2dab7b42d1",
                                                "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                                "text": "Mais c'était l’irrégularité de la couleur de ses iris, l'un bleu pâle et l'autre jaune, qui achevait de conférer à son visage une étrangeté indéfinissable."
                                            },
                                            {
                                                "example_id": "a12bc870-4d23-4496-bc02-6f73fc3fcf42",
                                                "sense_id": "bcf2ff79-5685-384d-8331-62734b16c5c2",
                                                "text": "« C'est pour qui ? » se renseigna le Michel-Ange de l'épiderme, tout en se grattant les roustons à travers son calfouette distendu et d'une couleur indéfinissable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24b7c00f-34f3-3e18-8a43-e1aa0088826c",
                                        "entry_id": "e59eddfd-6cec-3f8c-91ae-408c0104e19d",
                                        "glosses": [
                                            "Qualifie les choses dont on ne peut se rendre compte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8231cc-3701-4f5a-a806-2b1cf3162e91",
                                                "sense_id": "24b7c00f-34f3-3e18-8a43-e1aa0088826c",
                                                "text": "Une indéfinissable attraction poussait en avant ces hardis pionniers."
                                            },
                                            {
                                                "example_id": "f8305576-e273-481a-bbc5-81becb4a67cf",
                                                "sense_id": "24b7c00f-34f3-3e18-8a43-e1aa0088826c",
                                                "text": "Et puis quelque chose d'indéfinissable, mais de troublant et d'enivrant, qui émanait il ne savait d'où, tout cela l'avait bouleversé, avait fait jaillir en lui des sources d'émotion dont il n'eût jamais soupçonné l'existence."
                                            },
                                            {
                                                "example_id": "12394df3-f761-4505-b424-5476a57c773a",
                                                "sense_id": "24b7c00f-34f3-3e18-8a43-e1aa0088826c",
                                                "text": "Un sourire d’une expression indéfinissable glissa sur les lèvres pâles et minces du pirate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b23d084a-15f8-4958-8286-5477ac3fc99c",
                        "source_entry_id": "c06cad82-dec6-3497-9419-e61062728e40",
                        "source_sense_description": "that which defies description",
                        "target_lang_word": "undefinierbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
