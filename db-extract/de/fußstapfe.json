                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa6a7ad-8ccb-42f0-a516-d8679f0086c6",
                                "sense_id": "1457a600-3731-373c-998c-932bd07f4260",
                                "text": "„Plötzlich aber, sehr wahrscheinlich durch die vielen Fußtapfen aufmerksam gemacht, blieb er stehen und überschaute spähend den engen Raum.“"
                            },
                            {
                                "example_id": "066e1db2-56f0-4436-b296-13bf842105a8",
                                "sense_id": "1457a600-3731-373c-998c-932bd07f4260",
                                "text": "„Gemeinsam liefen wir die Pfade des Labyrinths ab, ich in seine Fußstapfen tretend und er in meine, wenn wir umdrehten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
