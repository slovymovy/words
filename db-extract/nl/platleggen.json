                "senses": [
                    {
                        "sense_id": "829e3e49-6077-3f43-9b48-249de101b82d",
                        "entry_id": "33455dd6-1276-39f8-9d5c-b89a275fd8be",
                        "glosses": [
                            "in een vlakke stand op de grond of ergens anders op leggen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e44797dd-406a-44d3-b001-b250523d5546",
                                "sense_id": "829e3e49-6077-3f43-9b48-249de101b82d",
                                "text": "Ze gromt naar Jack en legt haar oren plat tegen haar kop."
                            },
                            {
                                "example_id": "0ef65a04-ddee-40cf-82a6-cf53d2daea07",
                                "sense_id": "829e3e49-6077-3f43-9b48-249de101b82d",
                                "text": "De coureurs leggen tegenwoordig hun motor in de bocht bijna plat, zodanig dat het onmogelijk lijkt overeind te blijven. En toch slagen ze daarin. Hoe lukt hen dat? Over welke vaardigheden moeten zij beschikken? Een analyse."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbf447d7-cae6-34ac-9fa6-cd3f786c9f7b",
                        "entry_id": "33455dd6-1276-39f8-9d5c-b89a275fd8be",
                        "glosses": [
                            "slopen of voorgoed buiten werking stellen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b10dab81-4e26-4ab2-a672-3e3830770667",
                                "sense_id": "cbf447d7-cae6-34ac-9fa6-cd3f786c9f7b",
                                "text": "De mijnbouwers zijn intussen woedend. De mijnbouwkamer noemt Lopez' sluitingen 'onwettig en oneerlijk' en spreekt van onbehoorlijk bestuur, omdat de resultaten van het onderzoek vorig jaar niet met de sector zijn gedeeld. Volgens Artemio Disini van de kamer is Lopez vooringenomen. 'Zij wil gewoon alle mijnbouw in de Filipijnen platleggen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "6541eee3-3a25-3f89-b238-9500e89a962c",
                        "entry_id": "33455dd6-1276-39f8-9d5c-b89a275fd8be",
                        "glosses": [
                            "door werkstaking stilleggen"
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "896d6960-8f01-48a1-97d5-c168337ae30f",
                                "sense_id": "6541eee3-3a25-3f89-b238-9500e89a962c",
                                "text": "Een fabriek platleggen voor amper twee seconden. Voor buitenstaanders lijkt het van de pot gerukt, maar ervaren arbeiders zoals ACV-vakbondsman Gino Hautekeete die al 29 jaar dienst bij Volvo is, begrijpen het maar al te goed. ‘De eerste dagen aan de band bij Volvo zijn niet de mooiste. Je kan met moeite een plug recht indraaien. Het belang van routine is niet te onderschatten.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "f82c81bc-8e77-3586-9db4-372472ae336d",
                        "entry_id": "33455dd6-1276-39f8-9d5c-b89a275fd8be",
                        "glosses": [
                            "zorgen dat iets niet meer werkt"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e2221af4-c648-496c-aa06-6bfbe1bb0a09",
                                "sense_id": "f82c81bc-8e77-3586-9db4-372472ae336d",
                                "text": "Het inbreken in computersystemen of het platleggen daarvan wordt strafbaar."
                            }
                        ]
                    }
