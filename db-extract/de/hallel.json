                        "examples": [
                            {
                                "example_id": "247f398d-6c48-4910-89ff-50489ab6263e",
                                "sense_id": "d4aed858-3708-3e72-973f-bfc85c00675d",
                                "text": "„Die Geschichte des Auszugs selbst ward [am Passah-Fest] vorgelesen, am Schlusse der Mahlzeit aber wurden vier Becher Wein herumgereicht, wo beim zweiten Becher der Hausvater seinem Sohne auf dessen Befragen, Zweck und symbolische Bedeutung der Mahlzeit zu erklären hatte und darauf das große Hallel (Lobgesang) angestimmt.“"
                            },
                            {
                                "example_id": "a151a5b6-2d90-4f7f-a4dc-33d63c489618",
                                "sense_id": "d4aed858-3708-3e72-973f-bfc85c00675d",
                                "text": "„Zugleich war es [das Laubhüttenfest] mit öffentlichen Lustbarkeiten u[nd] glänzenden Gastgeboten verbunden, u[nd] es wurde an demselben das sogenannte Hallel od[er] die Psalmen Davids 113–115 gesungen.“"
                            }
                        ],
