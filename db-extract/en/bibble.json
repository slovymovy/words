                        "sense_id": "792d2990-a33d-3a78-8afa-ad25b1a1fe5a",
                        "entry_id": "62067373-3922-3b5a-b520-cdb682fc6658",
                        "glosses": [
                            "A bit."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "9002e2be-0fbe-407e-98b7-53fb5e7bb797",
                                "sense_id": "792d2990-a33d-3a78-8afa-ad25b1a1fe5a",
                                "text": "She burst into his studio one afternoon as the light failed, in disarray, a tear freezing on her cheek, her lips trembling and a little bibble of moisture working back and forth in her nostril as she breathed."
                            },
                            {
                                "example_id": "6238f6ef-8045-43d6-9925-f4c5afe9f3f8",
                                "sense_id": "792d2990-a33d-3a78-8afa-ad25b1a1fe5a",
                                "text": "[…] punish Glori because she prefers to rinse its cotton dress at home, in the toilet bowl? This time I wrapped the doll in corduroy before I chucked it in. \"No bleach, Glori. Just a bibble of soap.\""
                            },
                            {
                                "example_id": "92c455b2-e9a3-4699-91ff-a0f4b5b30e51",
                                "sense_id": "792d2990-a33d-3a78-8afa-ad25b1a1fe5a",
                                "text": "I found an old black jumper, but it is ancient and has bibbles of fluff all over it. As we walk from the car to the church entrance, a bus changes gear at the brow of the hill, slowing down. I glance up. It is full of younger pupils[…]"
                            }
                        ]
                    }
