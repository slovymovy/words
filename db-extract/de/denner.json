                ],
                "senses": [
                    {
                        "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                        "entry_id": "83f91687-18b2-3e6c-965f-c9237e2ce3aa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5098186-cbc0-4fef-824a-358ee98512c2",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Frau Denner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "02b7c70e-4f11-49c1-9272-f018fb541a2c",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Herr Denner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b5d1e049-9385-4e6b-a229-8f669152c6d6",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Die Denners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1e76b9e6-2663-4b9f-822d-b90489bcae03",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Der Denner trägt nie die Schals, die die Denner ihm strickt."
                            },
                            {
                                "example_id": "eb52b786-6ab0-4342-8a1e-b0eb05917a0d",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Denner kommt, geht der Herr Denner.“"
                            },
                            {
                                "example_id": "1957aa07-00b0-4e40-9fc4-52f6a2e464ec",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Denner kommt und geht."
                            },
                            {
                                "example_id": "c15c85a9-cad9-407e-9647-f88c42d2d7b3",
                                "sense_id": "1aa76888-2482-376e-b31b-bd973a7db272",
                                "text": "Denners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
