        "nl-extract.jsonl": [
            {
                "entry_id": "fec22cb4-5947-339d-8837-030f6b9b5f3e",
                "word": "instuderen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9ce183dd-8fc8-3559-bd08-99378e2f2601",
                        "entry_id": "fec22cb4-5947-339d-8837-030f6b9b5f3e",
                        "glosses": [
                            "iets zo goed leren, oefenen en repeteren dat je het je eigen gemaakt hebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5326a909-6257-4cce-a78f-666ca396003b",
                                "sense_id": "9ce183dd-8fc8-3559-bd08-99378e2f2601",
                                "text": "Ca. 1,5 miljoen kinderen zitten in Nederland op de basisschool. Hoe leer je die zingen en muziek maken? Het probleem met muziekeducatie: iedereen vindt het leuk en belangrijk, maar scholen en juffen verdrinken in een zee van initiatieven. Terwijl de oplossing makkelijk is. Volgende week Sint Maarten? Instuderen die liedjes!"
                            },
                            {
                                "example_id": "562d31e2-d3f4-4822-835c-8a8a6130595b",
                                "sense_id": "9ce183dd-8fc8-3559-bd08-99378e2f2601",
                                "text": "Een groepje voetballers uit de jeugdtraining van ADO Den Haag gaat met jonge dansers van het Koninklijk Ballet een voetbalchoreografie instuderen en opvoeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27351453-806b-4699-8c13-d48a39718ee9",
                        "source_entry_id": "fec22cb4-5947-339d-8837-030f6b9b5f3e",
                        "source_sense_id": "9ce183dd-8fc8-3559-bd08-99378e2f2601",
                        "source_sense_description": "(toneel) (muziek) (dans) iets zo goed leren, oefenen en repeteren dat je het je eigen gemaakt hebt",
                        "target_lang_word": "practise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "practise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3434e57f-89d6-39e9-9fd7-3041f1bb9e49",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To repeat (an activity) as a way of improving one's skill in that activity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bbb51be-08d9-4fc9-acdc-9bab78459f2a",
                                                "sense_id": "3434e57f-89d6-39e9-9fd7-3041f1bb9e49",
                                                "text": "You should practise playing piano every day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1def8077-3e71-33d5-adbd-37ad9de0e324",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To repeat an activity in this way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053fb9c6-4cfc-4f91-8c78-d6f3408ac223",
                                                "sense_id": "1def8077-3e71-33d5-adbd-37ad9de0e324",
                                                "text": "If you want to speak French well, you need to practise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a21750-ef64-33bc-93c6-482c6ab65f55",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To perform or observe in an habitual fashion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e40f0e2-c8a0-4789-8ecb-c178c789c8c2",
                                                "sense_id": "06a21750-ef64-33bc-93c6-482c6ab65f55",
                                                "text": "They gather to practise religion every Saturday."
                                            },
                                            {
                                                "example_id": "9a5615a8-dbaf-4464-8068-e32a6ab49152",
                                                "sense_id": "06a21750-ef64-33bc-93c6-482c6ab65f55",
                                                "text": "Hydromancy was extensively practised by the Egyptian priests and sorcerers[.]"
                                            },
                                            {
                                                "example_id": "12b772bf-9311-473f-8bdf-27fd60375fe9",
                                                "sense_id": "06a21750-ef64-33bc-93c6-482c6ab65f55",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record. With this biological framework in place, Corning endeavors to show that the capitalist system as currently practiced in the United States and elsewhere is manifestly unfair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8df1bb5e-a4dc-32e2-aeef-9e95ed7ddf5b",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To pursue (a career, especially law, fine art or medicine)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af94a1e-1662-4ece-9430-ea53ba5cc416",
                                                "sense_id": "8df1bb5e-a4dc-32e2-aeef-9e95ed7ddf5b",
                                                "text": "She practised law for forty years before retiring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "724a2c6d-fd3c-3639-8d9d-8c495711e22d",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To conspire."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95a76c05-3ca3-3f3d-904f-09873f339938",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To put into practice; to carry out; to act upon; to commit; to execute; to do."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52cead7e-c043-4451-b77b-7f0280b1b310",
                                                "sense_id": "95a76c05-3ca3-3f3d-904f-09873f339938",
                                                "text": "Aught but Talbot's shadow whereon to practise your severity."
                                            },
                                            {
                                                "example_id": "0e9664a6-76fd-459d-82ca-7006076a4832",
                                                "sense_id": "95a76c05-3ca3-3f3d-904f-09873f339938",
                                                "text": "As this advice ye practise or neglect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a00b55a-6d1d-3443-81a3-347e211d953c",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To make use of; to employ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c410cb66-55e6-40d6-8ac8-020b8c4ec3ac",
                                                "sense_id": "9a00b55a-6d1d-3443-81a3-347e211d953c",
                                                "text": "In malice to this good knight's wife, I practised Ubaldo and Ricardo to corrupt her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "103a72b9-860b-3086-be56-bc2c90608e97",
                                        "entry_id": "637137b9-fc2d-3c50-bd0d-2b21a17ad0f4",
                                        "glosses": [
                                            "To teach or accustom by practice; to train."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b497e39-a716-4d8d-b1e2-e1ec9c75bd3c",
                                                "sense_id": "103a72b9-860b-3086-be56-bc2c90608e97",
                                                "text": "In church they are taught to love God; after church they are practised to love their neighbour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "practise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                        "entry_id": "061bea2d-13ef-3c08-82a3-dbaf2178d2a8",
                                        "glosses": [
                                            "Obsolete spelling of practice."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd17df1-57a2-4e0a-a18e-4e3f9ecc8423",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "And againe You ſaw that I ſpake to you from Heauen, therefore yee ſhall make no Gods of Golde nor ſiluer: as if he ſhould haue ſaide, my practiſe in ſpeakeing to you by voyce and not by Image ſhoulde teach you that by my word and not by image, I am be remembred."
                                            },
                                            {
                                                "example_id": "29b67f78-ec29-4e38-8af8-954c7fbbee39",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "By heauen (fond vvretch) yͧ knovvſt not vvhat thou ſpeak'ſt, / Or elſe thou art ſuborn'd againſt his honor / In hatefull practiſe: […]"
                                            },
                                            {
                                                "example_id": "2668e08c-08a4-4cdc-82a8-42cc91290ed3",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "[T]he practiſe of the Normans, who as a monument of the Conqueſt, would have yoaked the Engliſh vnder their tongue, as they did vnder their command, by compelling them to teach their children in ſchooles nothing but French, […]"
                                            },
                                            {
                                                "example_id": "13b7aaea-760e-465c-9632-950c80292dad",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "[C]ome forth, / And taſt the ayre of Palaces, eate, drinke / The toyles of Empricks, and their boaſted practiſe: / Tincture of Pearle, an Corall, Gold, and Amber; […]"
                                            },
                                            {
                                                "example_id": "a8a396d5-815e-4a4d-9b42-1df5d6d5a704",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "[T]heſe Muſhrome Lords (Spirituall onely in Title, but wholly Temporall in reality), firſt ſprouted up by inſenſible degrees in the Church of Christ; ſo it is moſt infallibly convinced of notorious falſehood, by the multitude of thoſe moſt execrable Treaſons, Treacheries, Conſpiracies, Rebellions, Contumacies, Inſurrections, Seditions, and Anti-Monarchiall practiſes of Lordly Prelates, againſt their Soveraignes, in all ages ſince they grew rich and potent, in all Kingdomes and Churches where they have been admitted; […]"
                                            },
                                            {
                                                "example_id": "3380c739-a210-48bc-a710-3edc2fc8264b",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
                                                "text": "All wᶜʰ I have thus largely ſet down to ſhew the perfect conſonancie of our perſecuted Church to the doctrine of Scripture and Antiquity in this point, whereon ſo much depends for the ſtating & determining other differences, which have alſo a ſpecial influence on practiſe."
                                            },
                                            {
                                                "example_id": "a448d86e-23b4-4b7a-8a03-294cab5a4349",
                                                "sense_id": "1afc2750-db08-3a1f-988c-5cdb3fd94b65",
