                "senses": [
                    {
                        "sense_id": "5d90e4f0-5f6e-364c-a7e5-34bc51ed0dda",
                        "entry_id": "1a7fdf71-4bb4-3421-889d-21265b97c8ff",
                        "glosses": [
                            "подача электрической энергии на жилые, промышленные и хозяйственные объекты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6084833b-97d8-42aa-a8e4-52b200945c85",
                                "sense_id": "5d90e4f0-5f6e-364c-a7e5-34bc51ed0dda",
                                "text": "Объединение электростанций в энергосистемы позволяет увеличить эффективность электроснабжения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25380f8e-dbc8-4f64-9335-7751c480d405",
                        "source_entry_id": "1a7fdf71-4bb4-3421-889d-21265b97c8ff",
                        "source_sense_id": "5d90e4f0-5f6e-364c-a7e5-34bc51ed0dda",
                        "target_lang_word": "Energieversorgung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Energieversorgung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                        "entry_id": "88063e80-6881-3150-8a0b-77a26be959fa",
                                        "glosses": [
                                            "die Bereitstellung und Lieferung von Energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972391f1-cdc0-4c27-8f9a-5378114e8d67",
                                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                                "text": "Die Energieversorgung war durch den Stromausfall unterbrochen."
                                            },
                                            {
                                                "example_id": "15a5c41f-c3b6-452a-ae62-c4643392e7ae",
                                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                                "text": "„Ein wesentlicher Vorteil des Obusses gegenüber einer Umstellung auf Busse mit Verbrennungsmotor war - wie bei der Straßenbahn - die Energieversorgung aus der Verstromung heimischer Kohlevorkommen.“"
                                            },
                                            {
                                                "example_id": "c86bb2e7-d726-46df-a9c6-4cc27d500282",
                                                "sense_id": "efc30835-3535-309a-8173-adf3ad6f063c",
                                                "text": "„Eine einschneidende Transformation der globalen Energieversorgung lassen diese Zahlen also nicht erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7504570-8d26-49d7-815c-15b28aaa558b",
                        "source_entry_id": "1a7fdf71-4bb4-3421-889d-21265b97c8ff",
                        "source_sense_id": "5d90e4f0-5f6e-364c-a7e5-34bc51ed0dda",
                        "target_lang_word": "Stromversorgung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stromversorgung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0bb54cd7-39ca-3371-9bd2-d85ae1cde639",
                                        "entry_id": "871f2932-f3ed-3d18-8f86-6469e245128b",
                                        "glosses": [
                                            "Bereitstellung und Lieferung von Elektrizität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e81cff-8a3f-45df-9f7c-91741c23e7a8",
                                                "sense_id": "0bb54cd7-39ca-3371-9bd2-d85ae1cde639",
                                                "text": "„Die meisten Bauern sind von der Stromversorgung ausgeschlossen und haben keinen direkten Zugang zu sauberem Trinkwasser.“"
                                            },
                                            {
                                                "example_id": "9e46ef6b-96c8-420b-91f2-985bd70c2de4",
                                                "sense_id": "0bb54cd7-39ca-3371-9bd2-d85ae1cde639",
                                                "text": "„Am Dienstag war die Stromversorgung in großen Teilen des Stadtteils zusammengebrochen, nachdem bei Bauarbeiten zwei Hochspannungskabel durchtrennt worden waren.“"
                                            },
                                            {
                                                "example_id": "6e8e4404-6025-414f-84fd-c35abbb70c14",
                                                "sense_id": "0bb54cd7-39ca-3371-9bd2-d85ae1cde639",
                                                "text": "„Am Donnerstagmorgen sind noch immer 13.700 Kunden im Berliner Südosten von der Stromversorgung abgeschnitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
