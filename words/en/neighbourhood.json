            "senses": [
                {
                    "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                    "sense_definition": "A particular area of a town or city and the people who live there.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moved to a quiet <w>neighbourhood</w> near the park.",
                            "target_lang_translations": {
                                "ru": "Мы переехали в тихий <w>район</w> недалеко от парка.",
                                "nl": "We zijn verhuisd naar een rustige <w>buurt</w> vlakbij het park.",
                                "pl": "Przeprowadziliśmy się do cichej <w>okolicy</w> w pobliżu parku.",
                                "de": "Wir sind in eine ruhige <w>Gegend</w> in der Nähe des Parks gezogen.",
                                "fr": "Nous avons déménagé dans un <w>quartier</w> calme près du parc.",
                                "it": "Ci siamo trasferiti in un <w>quartiere</w> tranquillo vicino al parco.",
                                "cs": "Přestěhovali jsme se do klidné <w>čtvrti</w> blízko parku.",
                                "tr": "Parkın yakınında sessiz bir <w>mahalleye</w> taşındık.",
                                "es": "Nos mudamos a un <w>barrio</w> tranquilo cerca del parque.",
                                "zh": "我们搬到了公园附近一个安静的<w>社区</w>。",
                                "ja": "私たちは公園の近くの静かな<w>住宅街</w>に引っ越しました。",
                                "pt": "Mudámo-nos para um <w>bairro</w> tranquilo perto do parque."
                            }
                        },
                        {
                            "text": "Everyone in the <w>neighbourhood</w> knows each other.",
                            "target_lang_translations": {
                                "ru": "Все в <w>округе</w> знают друг друга.",
                                "nl": "Iedereen in de <w>buurt</w> kent elkaar.",
                                "pl": "Wszyscy w <w>sąsiedztwie</w> się znają.",
                                "de": "Jeder in der <w>Nachbarschaft</w> kennt sich untereinander.",
                                "fr": "Tout le monde dans le <w>voisinage</w> se connaît.",
                                "it": "Tutti nel <w>vicinato</w> si conoscono.",
                                "cs": "Všichni v <w>sousedství</w> se navzájem znají.",
                                "tr": "<w>Mahalledeki</w> herkes birbirini tanır.",
                                "es": "Todos en el <w>vecindario</w> se conocen.",
                                "zh": "这个<w>街区</w>里的每个人都互相认识。",
                                "ja": "<w>近所</w>の人は皆、互いに顔見知りです。",
                                "pt": "Toda a gente na <w>vizinhança</w> se conhece."
                            }
                        }
                    ],
                    "synonyms": [
                        "district",
                        "area",
                        "community",
                        "locality"
                    ],
                    "common_phrases": [
                        "residential neighbourhood",
                        "quiet neighbourhood",
                        "friendly neighbourhood",
                        "whole neighbourhood"
                    ],
                    "traits": [
