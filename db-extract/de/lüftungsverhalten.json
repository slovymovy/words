                "senses": [
                    {
                        "sense_id": "447234e3-a638-3b00-b05d-0d92a20ec82e",
                        "entry_id": "5700f241-137a-3140-8937-28dccd4d50b9",
                        "glosses": [
                            "eigenes, effektives Handeln wenn es um den notwendigen Luftwechsel im Raum geht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52972408-874a-495d-9293-b893a2cf414e",
                                "sense_id": "447234e3-a638-3b00-b05d-0d92a20ec82e",
                                "text": "„Für die Frage, was als ausreichendes und sachgerechtes Lüftungsverhalten mindestens vom Mieter verlangt werden kann, spielen im Rahmen der Zumutbarkeitserwägungen verschiedene Faktoren eine Rolle.“"
                            },
                            {
                                "example_id": "bdf87fe0-a27c-44b6-9e78-e3e7bdafe0f6",
                                "sense_id": "447234e3-a638-3b00-b05d-0d92a20ec82e",
                                "text": "„Die hohe Gebäudedichtigkeit stellt höhere Anforderungen an das Lüftungsverhalten der Bewohner als das noch zu Zeiten der undichten Fenster und Einzelofenheizung der Fall war“"
                            },
                            {
                                "example_id": "a54499e9-0634-4869-81c9-9735c61ba915",
                                "sense_id": "447234e3-a638-3b00-b05d-0d92a20ec82e",
                                "text": "„Auf die Notwendigkeit, das Lüftungsverhalten zu ändern, muss ihn der Vermieter hingewiesen haben.“"
                            },
                            {
                                "example_id": "17c9d377-4a77-44db-aa52-3b508cb29228",
                                "sense_id": "447234e3-a638-3b00-b05d-0d92a20ec82e",
                                "text": "„Dies ist ein Zeichen, dass am Lüftungsverhalten unbedingt was verändert werden muss: Mehr Lüften oder eine Zwangsbelüftung, wie z.B ein Dunstabzug, die Absaugung mittels Rohr oder Schlauch nach außen zu verlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
