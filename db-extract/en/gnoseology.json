                "senses": [
                    {
                        "sense_id": "68b3e63e-0722-3299-9af7-939725f32ee9",
                        "entry_id": "6f5e67ff-c51f-3033-9664-bb671f6753f3",
                        "glosses": [
                            "The philosophical study of knowledge."
                        ],
                        "tags": [
                            "uncommon",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "59c22869-c590-4b86-9730-0e19125db570",
                                "sense_id": "68b3e63e-0722-3299-9af7-939725f32ee9",
                                "text": "GNOSEOLOGY, GNOSOLOGY, GNOSTOLOGY, in Metaphysics, doctrine or system of cognition; theory of knowledge; used by Stirling to render Wissenschaftslehre (Fichte's)."
                            },
                            {
                                "example_id": "ea3e50bd-77e6-4e3e-89b1-09ac1f059527",
                                "sense_id": "68b3e63e-0722-3299-9af7-939725f32ee9",
                                "text": "Like Wolff, he makes the theory of knowledge precede both speculative and practical philosophy, the former of which embraces metaphysics, although, just as Wolff did, he often hesitates whether this theory ought not to be combined with psychology. He [Baumgarten] applies to it the name \"gnoseology.\""
                            }
                        ]
                    }
                ],
