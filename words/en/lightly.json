{
    "word_family": [
        "light",
        "lightness",
        "lighten"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                    "sense_definition": "With little weight, pressure, or force; in a gentle manner.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tapped him <w>lightly</w> on the shoulder to get his attention.",
                            "target_lang_translations": {
                                "ru": "Она <w>слегка</w> похлопала его по плечу, чтобы привлечь его внимание.",
                                "zh": "她<w>轻轻地</w>拍了拍他的肩膀，以引起他的注意。"
                            }
                        },
                        {
                            "text": "The bird landed <w>lightly</w> on the thin branch without breaking it.",
                            "target_lang_translations": {
                                "ru": "Птица <w>легко</w> приземлилась на тонкую ветку, не сломав её.",
                                "zh": "那只鸟<w>轻轻地</w>落在细枝上，没有把树枝压断。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gently",
                        "softly",
                        "delicately"
                    ],
                    "antonyms": [
                        "heavily",
                        "forcefully",
                        "roughly"
                    ],
                    "common_phrases": [
                        "tread lightly",
                        "touch lightly",
                        "travel lightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без должной серьезности, внимания или заботы; беспечно.",
                        "zh": "以较小的力度、压力或以温和的方式；在程度上较小或不严重；缺乏应有的严肃性或关切。",
                        "nl": "Zonder de gepaste ernst, zorg of aandacht; onbezonnen.",
                        "pl": "W sposób delikatny, z małą siłą lub naciskiem; w niewielkim stopniu lub natężeniu; bez należytej powagi.",
                        "de": "Mit wenig Gewicht, Druck oder Kraft; auf sanfte Weise; in geringem Maße oder ohne die gebotene Ernsthaftigkeit.",
                        "fr": "Sans le sérieux, l'attention ou la préoccupation appropriés ; de manière inconsidérée.",
                        "it": "Con poco peso, pressione o forza; in modo delicato, in misura ridotta o senza la dovuta serietà.",
                        "cs": "S malou silou, tlakem nebo jemným způsobem; v malé míře nebo bez náležité vážnosti.",
                        "tr": "Az miktarda ağırlık, basınç veya güç ile; nazik bir şekilde; hafifçe veya ciddiyetten uzak bir tavırla.",
                        "es": "De manera suave, con poca presión, fuerza o intensidad; también se usa para indicar falta de seriedad o cuidado."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легкомысленно",
                                "target_lang_sense_clarification": "несерьезно, необдуманно"
                            },
                            {
                                "target_lang_word": "беспечно",
                                "target_lang_sense_clarification": "беззаботно"
                            },
                            {
                                "target_lang_word": "несерьезно",
                                "target_lang_sense_clarification": "шутливо, без ответственности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻轻地",
                                "target_lang_sense_clarification": "形容动作力度小"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "形容程度轻微"
                            },
                            {
                                "target_lang_word": "轻率地",
                                "target_lang_sense_clarification": "形容态度不严肃、不慎重"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "lichtzinnig",
                                "target_lang_sense_clarification": "zonder voldoende ernst"
                            },
                            {
                                "target_lang_word": "onbezonnen",
                                "target_lang_sense_clarification": "zonder na te denken over de gevolgen"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "lekko",
                                "target_lang_sense_clarification": "w sposób delikatny, z małą siłą lub w niewielkim stopniu"
                            },
                            {
                                "target_lang_word": "delikatnie",
                                "target_lang_sense_clarification": "w sposób subtelny, z wyczuciem"
                            },
                            {
                                "target_lang_word": "lekkomyślnie",
                                "target_lang_sense_clarification": "bez należytej powagi, nieodpowiedzialnie"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "leicht",
                                "target_lang_sense_clarification": "allgemein für sanfte Art oder geringes Maß"
                            },
                            {
                                "target_lang_word": "sanft",
                                "target_lang_sense_clarification": "bei körperlicher Berührung oder Bewegung"
                            },
                            {
                                "target_lang_word": "leichtfertig",
                                "target_lang_sense_clarification": "wenn es um mangelnde Ernsthaftigkeit geht"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "légèrement",
                                "target_lang_sense_clarification": "de façon inconsidérée ou sans sérieux"
                            },
                            {
                                "target_lang_word": "à la légère",
                                "target_lang_sense_clarification": "sans prendre au sérieux"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "leggermente",
                                "target_lang_sense_clarification": "indica un grado o una quantità ridotta"
                            },
                            {
                                "target_lang_word": "delicatamente",
                                "target_lang_sense_clarification": "indica un modo gentile o soffice"
                            },
                            {
                                "target_lang_word": "alla leggera",
                                "target_lang_sense_clarification": "indica una mancanza di serietà o riflessione"
                            },
                            {
                                "target_lang_word": "superficialmente",
                                "target_lang_sense_clarification": "indica un comportamento poco attento o non approfondito"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "lehce",
                                "target_lang_sense_clarification": "vyjadřuje malou sílu, jemnost nebo nízkou míru"
                            },
                            {
                                "target_lang_word": "zlehka",
                                "target_lang_sense_clarification": "vyjadřuje jemný dotek nebo malý tlak"
                            },
                            {
                                "target_lang_word": "lehkovážně",
                                "target_lang_sense_clarification": "vyjadřuje nedostatek vážnosti nebo zodpovědnosti"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hafifçe",
                                "target_lang_sense_clarification": "fiziksel olarak az bir güç veya basınçla"
                            },
                            {
                                "target_lang_word": "hafif",
                                "target_lang_sense_clarification": "derece veya miktar olarak az"
                            },
                            {
                                "target_lang_word": "ciddiye almadan",
                                "target_lang_sense_clarification": "bir durumu önemsemeyerek veya hafife alarak"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ligeramente",
                                "target_lang_sense_clarification": "de forma suave o con poca intensidad"
                            },
                            {
                                "target_lang_word": "suavemente",
                                "target_lang_sense_clarification": "con delicadeza o poca fuerza"
                            },
                            {
                                "target_lang_word": "a la ligera",
                                "target_lang_sense_clarification": "sin la seriedad o reflexión necesaria"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                    "sense_definition": "To a small degree or amount; not thickly, deeply, or severely.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer my toast <w>lightly</w> buttered rather than soaked in grease.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю тост, <w>слегка</w> смазанный маслом, а не пропитанный жиром.",
                                "zh": "我喜欢吐司上<w>稍微</w>抹点黄油，而不是浸满油脂。"
                            }
                        },
                        {
                            "text": "It was raining <w>lightly</w> when we left the house, so we did not need an umbrella.",
                            "target_lang_translations": {
                                "ru": "Когда мы вышли из дома, дождь шел <w>слабо</w>, поэтому зонт нам не понадобился.",
                                "zh": "我们离开家时只<w>稍微</w>下了点雨，所以不需要带伞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slightly",
                        "faintly",
                        "sparsely",
                        "thinly"
                    ],
                    "antonyms": [
                        "heavily",
                        "densely",
                        "intensely"
                    ],
                    "common_phrases": [
                        "lightly salted",
                        "lightly seasoned",
                        "lightly toasted",
                        "lightly cooked"
                    ],
