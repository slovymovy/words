                                        "entry_id": "16d598d3-24ee-38f8-bf59-4810869bb803",
                                        "glosses": [
                                            "Ellipsis of rolling in it (“very wealthy”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1999bc-2419-4d78-9eaf-dfc6b732825d",
                                                "sense_id": "9e847342-b263-345c-8ad1-906991191b78",
                                                "text": "Why one man who used to take me out, who was absolutely rolling, never tipped anyone."
                                            }
