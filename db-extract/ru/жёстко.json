        "ru-extract.jsonl": [
            {
                "entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                "word": "жёстко",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "585a36d7-4bf1-34a9-bfa3-75caf40743ab",
                        "entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "glosses": [
                            "наречие к жёсткий; не подвергаясь изменениям, сохраняя форму, плохо поддаваясь деформации или разделению"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "bc0f54c5-dea6-4343-bdc6-d4ef5610b82a",
                                "sense_id": "585a36d7-4bf1-34a9-bfa3-75caf40743ab",
                                "text": "Верхний её конец жёстко соединён с вибратором, который тросами зацеплен за крюк крана."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1822aad-b6a5-3313-b0a4-ba7e17472435",
                        "entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "glosses": [
                            "перен. сурово, резко, строго"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b470da01-e691-4282-adcf-fb8b8d90e6f1",
                                "sense_id": "e1822aad-b6a5-3313-b0a4-ba7e17472435",
                                "text": "Она жёстко ответила на его признание в любви."
                            },
                            {
                                "example_id": "f69b6aee-2f29-4de2-83b3-5be700ef526a",
                                "sense_id": "e1822aad-b6a5-3313-b0a4-ba7e17472435",
                                "text": "Этот человек любил её, а она жёстко и неприязненно оттолкнула его от себя."
                            }
                        ]
                    },
                    {
                        "sense_id": "271ea624-f6e5-3608-bcb8-3f4af27521d7",
                        "entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "glosses": [
                            "предик. о жёстком и неудобном месте"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e232c30-7149-49e7-aa58-eb75f223ade7",
                                "sense_id": "271ea624-f6e5-3608-bcb8-3f4af27521d7",
                                "text": "И на кольчуге боевой // Ему не жёстко."
                            }
                        ]
                    },
                    {
                        "sense_id": "1329adc5-f271-379d-ac36-9ee4b6bbade2",
                        "entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "glosses": [
                            "перен. без отклонений; безоговорочно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef67bca9-050a-4f69-b219-85f1e0436cd3",
                                "sense_id": "1329adc5-f271-379d-ac36-9ee4b6bbade2",
                                "text": "Сегодня заявив, что никаких революций не надо, никаких радикальных реформ не надо, и Россия будет развивать то, что у неё есть, и развивать постепенно, Медведев от так называемой „либеральной тусовки“ жёстко отмежевался."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fdd2bda-c68e-4ffb-abbb-b92591e52650",
                        "source_entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "source_sense_description": "о физическом свойстве",
                        "target_lang_word": "stiffly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiffly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "873fd2db-c810-3ab7-aac0-96da2a19ab31",
                                        "entry_id": "12cd3932-9875-3dd8-88c7-5070b51fcdb4",
                                        "glosses": [
                                            "In a stiff manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32576ba7-20de-4e5e-a542-fb4e747474d7",
                                                "sense_id": "873fd2db-c810-3ab7-aac0-96da2a19ab31",
                                                "text": "'Twas Mr. Glennie who first moved to seek me; for when the second day came that I was not at school, he thought that I was ill, and went to my aunt's to ask how I did, as was his wont when any ailed. But Aunt Jane answered him stiffly that she could not say how I did."
                                            },
                                            {
                                                "example_id": "83e88db0-df62-40e1-8f86-1ee99dc6fd72",
                                                "sense_id": "873fd2db-c810-3ab7-aac0-96da2a19ab31",
                                                "text": "'Very well, Clara,' she said stiffly, 'but I shall also speak to your father.'"
                                            },
                                            {
                                                "example_id": "1b430172-ca69-4897-ba2f-dbce4687e59e",
                                                "sense_id": "873fd2db-c810-3ab7-aac0-96da2a19ab31",
                                                "text": "It’s recited in schools across the US every day by students standing stiffly with their hands over their hearts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5b162a0-2c0b-4e42-8c50-54c5a9f885b6",
                        "source_entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "source_sense_description": "о физическом свойстве",
                        "target_lang_word": "rigidly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigidly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a5dd8b4-9e9b-31ed-be87-e82070f176d5",
                                        "entry_id": "ffa1139b-8662-3e36-9c12-f518a4cb8c49",
                                        "glosses": [
                                            "In a rigid manner; stiffly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaac355f-c48f-49e2-bb81-2d60eab99cd7",
                                                "sense_id": "9a5dd8b4-9e9b-31ed-be87-e82070f176d5",
                                                "text": "What could have been done by such a machine downhill can only be conjectured, for the maximum speed was restricted rigidly to 80 m.p.h."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ce15e0a-4288-48de-ab10-e790740fc573",
                        "source_entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "source_sense_description": "о физическом свойстве",
                        "target_lang_word": "rigidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "150418e6-ed59-3487-9308-745ac0bcdad1",
                                        "entry_id": "448eb42a-b8db-31a5-befc-464cce86d37a",
                                        "glosses": [
                                            "D’une manière rigide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a7dfb4-f728-4c1d-a640-5f103f2d0146",
                                                "sense_id": "150418e6-ed59-3487-9308-745ac0bcdad1",
                                                "text": "La figure 3.32 montre le banc d'essai utilisé à l'EPFL pour des tests statiques-cycliques sur des refends en maçonnerie renforcés par des matériaux composites [3.14]. Les refends sont fixés rigidement au sol du laboratoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533f0441-1e98-3611-8bb3-a8c829a914cb",
                                        "entry_id": "448eb42a-b8db-31a5-befc-464cce86d37a",
                                        "glosses": [
                                            "Strictement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fd29c82-dc15-4caa-98db-e78cf6e3b607",
                                                "sense_id": "533f0441-1e98-3611-8bb3-a8c829a914cb",
                                                "text": "Quand les lois n'étaient plus rigidement observées,"
                                            },
                                            {
                                                "example_id": "b34ec910-7830-4944-971f-a6b0789d5242",
                                                "sense_id": "533f0441-1e98-3611-8bb3-a8c829a914cb",
                                                "text": "La discipline militaire, l’âme du service, si rigidement soutenue par Louvois, tomba dans un relâchement funeste,"
                                            },
                                            {
                                                "example_id": "67aa7b87-d0eb-4d62-b25f-9f6ec2e6f28b",
                                                "sense_id": "533f0441-1e98-3611-8bb3-a8c829a914cb",
                                                "text": "Les visites très rigidement domiciliaires qui seront faites pendant l’insurrection,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "799ce7b7-769d-45ca-8834-2f3d4f4386d4",
                        "source_entry_id": "11d5bf73-eba0-3854-bbb4-85f1c2846a63",
                        "source_sense_description": "о физическом свойстве",
                        "target_lang_word": "durement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32466013-4376-3b7f-b902-b1c3c47c5a33",
                                        "entry_id": "f1f5b256-073f-35d0-b440-ca4da1a3b18a",
                                        "glosses": [
                                            "D’une manière dure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aca9879-7653-426b-8b3d-746d164e7d57",
                                                "sense_id": "32466013-4376-3b7f-b902-b1c3c47c5a33",
                                                "text": "Un jour, en bateau, voulant manier la godille à grand renflement de biceps, il tombait dans la Loire ; une autre fois, qu’il caracolait à la portière du landau, sa bête le serrait si durement contre la roue, qu’on était obligé de le garder et cataplasmer à la chambre plusieurs jours."
                                            },
                                            {
                                                "example_id": "47594a22-a6e7-4ff4-8de4-637423c0f12a",
                                                "sense_id": "32466013-4376-3b7f-b902-b1c3c47c5a33",
                                                "text": "La wilaya (province) d’El Tarf à l’extrême est du pays (700 km à l’est d'Alger) a été la plus durement touchée, avec au moins 30 morts dont 11 enfants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
