                        }
                    ]
                },
                {
                    "sense_id": "8fc62b89-49a6-3d55-ba54-f941427d835d",
                    "sense_definition": "D'une manière directe, résolue et sans détours.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maniere_directe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lieu d'hésiter pendant des heures, tu devrais y aller <w>carrément</w> et exposer ton projet."
                        },
                        {
                            "text": "Elle lui a dit <w>carrément</w> ce qu'elle pensait de sa façon de travailler."
                        }
                    ],
                    "synonyms": [
