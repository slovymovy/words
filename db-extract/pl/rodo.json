                    {
                        "translation_id": "5d3f2f1b-e625-4ae6-ba87-ec8cbf8d8c9e",
                        "source_entry_id": "b1958639-8bf4-310b-91dd-cb28b8e16a2c",
                        "source_sense_id": "9e86558a-9fec-3463-bb3d-22d3dfc8d858",
