                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f11432e-3144-3d22-956f-733537a2c22f",
                                        "entry_id": "eebba66b-51d7-36cf-aa5b-0a22cb394bcd",
                                        "glosses": [
                                            "Qui est suffisant, convenable, requis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98530867-aa9a-41d3-9cf6-86fac96824dd",
                                                "sense_id": "0f11432e-3144-3d22-956f-733537a2c22f",
                                                "text": "Âge compétent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                        "entry_id": "eebba66b-51d7-36cf-aa5b-0a22cb394bcd",
                                        "glosses": [
                                            "Qui a la compétence pour traiter une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd9e6a26-d8f6-4ebb-8856-9c2b0b24d953",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Il est juge compétent."
                                            },
                                            {
                                                "example_id": "b8b7e567-5ebc-400c-8292-2a805c0b9901",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Il a été déclaré compétent."
                                            },
                                            {
                                                "example_id": "6b4d1660-2658-4a24-ad6e-9ecd16c6f5d8",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Tribunal compétent. On dit dans un sens analogue"
                                            },
                                            {
                                                "example_id": "602bc9aa-1ea4-411f-8e9c-f6c4aed68fc5",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Autorité compétente."
                                            },
                                            {
                                                "example_id": "8cd9da02-7085-431e-87c8-1017b46a4225",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Partie compétente, Celui qui a qualité pour contester en justice, pour être partie au procès."
                                            },
                                            {
                                                "example_id": "cbf7197e-a008-4dd2-8e0f-1bcd18034e5d",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Il est partie compétente en cette affaire."
                                            },
                                            {
                                                "example_id": "c08311cc-fb9b-4e30-b5f0-4b015365b655",
                                                "sense_id": "0048e35e-7163-38c0-9a6b-b8f29e7c0b6e",
                                                "text": "Vous n’êtes pas partie compétente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33897fc5-1857-32ba-8258-8612c19305f7",
                                        "entry_id": "eebba66b-51d7-36cf-aa5b-0a22cb394bcd",
                                        "glosses": [
                                            "Qui peut donner son avis sur une chose, sur une matière, qui est capable d’en bien juger."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783cee30-c0c9-4108-acb9-f4df18b118ed",
                                                "sense_id": "33897fc5-1857-32ba-8258-8612c19305f7",
                                                "text": "Il n’est pas juge compétent de cela."
                                            },
                                            {
                                                "example_id": "a091ec51-1ebe-4560-b1e7-fac748d843d0",
                                                "sense_id": "33897fc5-1857-32ba-8258-8612c19305f7",
                                                "text": "Nul n’est plus compétent dans les questions de linguistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d64d35-d3d9-3199-b0f3-43fafe1f7401",
                                        "entry_id": "eebba66b-51d7-36cf-aa5b-0a22cb394bcd",
                                        "glosses": [
                                            "Qui est efficace dans sa fonction, son travail."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "749254b6-54ed-4770-9546-f59d62e7cfa5",
                                                "sense_id": "76d64d35-d3d9-3199-b0f3-43fafe1f7401",
                                                "text": "Il est difficile de trouver des employés compétents dans ce pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933fd758-6639-3636-b60a-b360900d57af",
                                        "entry_id": "eebba66b-51d7-36cf-aa5b-0a22cb394bcd",
                                        "glosses": [
                                            "Se dit d’un minéral, d’une roche qui peut se briser sous l’effet des contraintes tectoniques. → voir compétence"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9af434-1a40-43b4-be64-5cfb09967261",
                                                "sense_id": "933fd758-6639-3636-b60a-b360900d57af",
                                                "text": "Une roche compétente résiste peu à une déformation et se fracture rapidement sous l'effet de contraintes, le comportement élastique est donc très limité et le domaine de plasticité n'est pas atteint (exemples : granite, grès, calcaire) . Une roche incompétente a, en revanche, la faculté de se déformer facilement et de façon irréversible sous l'effet de contraintes : ce comportement est ductile (exemples : gypse , argile)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
