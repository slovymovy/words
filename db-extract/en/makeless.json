                "senses": [
                    {
                        "sense_id": "64a83408-0040-3a41-b130-5f7a63071ffe",
                        "entry_id": "f8185bde-7176-3516-a43e-14f3de48df08",
                        "glosses": [
                            "Matchless, without equal, peerless."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "89a3b9af-16d2-4128-9a2d-63abf25e4865",
                                "sense_id": "64a83408-0040-3a41-b130-5f7a63071ffe",
                                "text": "Consider Cyrus in your cruell thought,\nA makelesse Prince in riches, and in might."
                            },
                            {
                                "example_id": "5556f53d-c9bf-4b21-b787-2b08680498cc",
                                "sense_id": "64a83408-0040-3a41-b130-5f7a63071ffe",
                                "text": "That which I mentioned of the makeless Bride [translating Italian unica sposa]\nOf God the Spirit[…]"
                            },
                            {
                                "example_id": "959b9f6e-4430-4e6b-bfbc-7b66ec15ad0d",
                                "sense_id": "64a83408-0040-3a41-b130-5f7a63071ffe",
                                "text": "I just peeped into the Mediæval Court, in search of the mummy of a cat[…]a bright-eyed little girl directed me to her ancient feline majesty—a thing shapeless and makeless—done up in that queer old mouldering[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a8d917de-a115-3576-9405-67652829f4e2",
                        "entry_id": "f8185bde-7176-3516-a43e-14f3de48df08",
                        "glosses": [
                            "Without a mate; widowed."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1c6b2beb-4530-45b0-a41e-fa28b003c1b8",
                                "sense_id": "a8d917de-a115-3576-9405-67652829f4e2",
                                "text": "For, stoode it with the pleasure of his will\nTo marrie me, my fortune is not such,\nSo hard, that I so long should still persist\nMakelesse alone in wofull widowhood."
                            },
                            {
                                "example_id": "886d002b-d522-414f-9efb-306c0b0a671c",
                                "sense_id": "a8d917de-a115-3576-9405-67652829f4e2",
                                "text": "The world will wail thee, like a makeless wife."
                            }
                        ]
                    }
                ],
                "translations": [
