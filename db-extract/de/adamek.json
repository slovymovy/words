                ],
                "senses": [
                    {
                        "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                        "entry_id": "a4566f55-367b-365b-9d1a-237c358c0204",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "736228a3-5498-47dd-9ec8-eb3cde3452e5",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Frau Adamek ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "65bf07f8-9131-43b1-9990-c3f68de3adb1",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Herr Adamek wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2fe82118-1310-4c8a-a316-2cfdfc1089ad",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Die Adameks fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "b2d57451-3065-476c-9a51-2922656d1f14",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Der Adamek trägt nie die Pullover, die die Adamek ihm strickt."
                            },
                            {
                                "example_id": "542906bc-9e16-46a1-8cdd-eaafe2a4f126",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Adamek kommt, geht der Herr Adamek.“"
                            },
                            {
                                "example_id": "3d5c619b-99b3-4304-8f28-0304fe0dbcc6",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Adamek kommt und geht."
                            },
                            {
                                "example_id": "ee4d85e7-7bfd-4289-84dd-b18a48c0ff15",
                                "sense_id": "7ef56b23-781a-316b-977b-c3d4cfedcdbf",
                                "text": "Adameks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
