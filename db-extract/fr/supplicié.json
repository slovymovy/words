                    {
                        "sense_id": "5b1bac19-1575-391a-b12a-b543001aae8d",
                        "entry_id": "4aa551ce-b769-3374-bb7c-9b8a78ed654e",
                        "glosses": [
                            "Qui est soumis à d’affreuses douleurs, dont l’objectif est la mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e339de8d-b918-4abe-aa18-be9d3dfd68d8",
                                "sense_id": "5b1bac19-1575-391a-b12a-b543001aae8d",
                                "text": "Cela dura douze heures. Je ne perdis aucun des mouvements, aucune des grimaces, aucun des frissons de cette chair suppliciée."
                            },
                            {
                                "example_id": "b9c8931a-5e47-4502-9f43-06d2f9345862",
                                "sense_id": "5b1bac19-1575-391a-b12a-b543001aae8d",
                                "text": "—— Vous voulez dire qu’elle n’avait pas d’autres moyens, pour rendre son deuil supportable, que de photograhier ce corps supplicé?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ea271e9-143d-4689-96d8-d2e34c568bc0",
                        "source_entry_id": "4aa551ce-b769-3374-bb7c-9b8a78ed654e",
                        "source_sense_id": "5b1bac19-1575-391a-b12a-b543001aae8d",
