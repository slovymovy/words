                    },
                    {
                        "form_id": "d8d5a300-d438-47fd-9814-fc6a18d2fbf7",
                        "entry_id": "9fd2b7c6-8395-3d2e-81d3-8ef9ac4af8e3",
                        "tags": [
                            "past"
                        ],
                        "form": "debarred"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa894b2a-d430-370e-9931-1e67338909e2",
                        "entry_id": "9fd2b7c6-8395-3d2e-81d3-8ef9ac4af8e3",
                        "glosses": [
                            "To exclude or shut out; to bar."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ccd5602d-63f9-4788-97ff-641101606efe",
                                "sense_id": "fa894b2a-d430-370e-9931-1e67338909e2",
                                "text": "As for the guides, they were debarred from the pleasure of discourse, the one being placed in the van, and the other obliged to bring up the rear."
                            },
                            {
                                "example_id": "e65721ca-5f9f-44b5-bd6e-89fa0cf9217c",
                                "sense_id": "fa894b2a-d430-370e-9931-1e67338909e2",
                                "text": "The Minister of Transport has debarred BR workshops from seeking orders for private owners' wagons like this [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c830793-550c-3e51-b058-0d32fa75649e",
                        "entry_id": "9fd2b7c6-8395-3d2e-81d3-8ef9ac4af8e3",
                        "glosses": [
                            "To hinder or prevent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d3bf3d-9b0f-432f-af3d-38cfdda7eb99",
                                "sense_id": "6c830793-550c-3e51-b058-0d32fa75649e",
                                "text": "How can I then return in happy plight,\nThat am debarr'd the benefit of rest?"
                            },
                            {
                                "example_id": "c597414a-b0b3-42a1-b950-38d06ef1dfa9",
                                "sense_id": "6c830793-550c-3e51-b058-0d32fa75649e",
                                "text": "She had also been so long debarred from any interchange of feelings and sentiments—so surrounded by strangers, that it was a true enjoyment to meet with one, who, if she did not enter into many of the emotions connected with it, was yet able and ready to talk of the past."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca59f9ec-5355-3a1f-b935-a94418b90995",
                        "entry_id": "9fd2b7c6-8395-3d2e-81d3-8ef9ac4af8e3",
                        "glosses": [
                            "To prohibit (a person or company that has been convicted of criminal acts in connection with a government program) from future participation in that program."
                        ],
                        "tags": [
                            "US",
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f096fbc-a56a-492d-8873-8465696b31fb",
                        "source_entry_id": "9fd2b7c6-8395-3d2e-81d3-8ef9ac4af8e3",
                        "source_sense_description": "To exclude or shut out; to bar",
                        "target_lang_word": "vyloučit",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vyloučit",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2c53cd-b114-3e94-a089-1d7f09c4ef47",
                                        "entry_id": "95942740-d7a0-334d-9363-b941fd5b5a6f",
                                        "glosses": [
                                            "ukončit příslušnost k určité skupině; odmítnout"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b773e8b-c2a0-4e6c-9e61-8d16d450f6c7",
                                                "sense_id": "ab2c53cd-b114-3e94-a089-1d7f09c4ef47",
                                                "text": "Z důvodu problémového chování byli oba žáci vyloučeni ze školy."
                                            },
                                            {
                                                "example_id": "54e527f0-8bb2-450d-bf36-c3c590c7cc2e",
                                                "sense_id": "ab2c53cd-b114-3e94-a089-1d7f09c4ef47",
                                                "text": "Někteří žebráci mají to štěstí, že je příroda obdařila takovým vzezřením, že vzbuzují lítost bez jakéhokoli vlastního přičinění. Ti méně šťastní musí k dosažení úspěchu vynaložit jisté úsilí. Zvláštní kapitolu věnoval [Cimrman] proto otázce správného oblékání. Vyloučil zejména drahé kožešiny, jako jsou např. norek, stříbrná liška, perzián apod. Odmítal i elegantní obleky, sportovní (motoristické, golfové, tenisové atd.)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f64473-aab8-361d-bf12-6e4b6155ec1b",
                                        "entry_id": "95942740-d7a0-334d-9363-b941fd5b5a6f",
                                        "glosses": [
                                            "označit určité tvrzení za nepravdivé"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e387df-8d5c-41ce-86d3-c2145e2726c3",
                                                "sense_id": "14f64473-aab8-361d-bf12-6e4b6155ec1b",
                                                "text": "Nelze vyloučit, že za úbytek hmyzu v přírodě může používání pesticidů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d27145b-6648-3e0a-be44-dcc81fce0793",
                                        "entry_id": "95942740-d7a0-334d-9363-b941fd5b5a6f",
                                        "glosses": [
                                            "přemístit mimo organismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39218a8c-63d0-47fb-a5aa-b3f0e9132c06",
                                                "sense_id": "3d27145b-6648-3e0a-be44-dcc81fce0793",
                                                "text": "Škodlivé látky jsou vyloučeny močí."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3955985-c8a4-3215-bf50-7cf67a028a74",
                                        "entry_id": "95942740-d7a0-334d-9363-b941fd5b5a6f",
                                        "glosses": [
                                            "chemickým nebo fyzikálním pochodem vydělit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114e3141-1fc5-4c5c-b6b8-1e6e9f39b17a",
                                                "sense_id": "e3955985-c8a4-3215-bf50-7cf67a028a74",
                                                "text": "Při elektrolýze roztoku síranu měďnatého se na katodě vylučuje měď."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b6c246c-88ff-33ba-b1d8-a118a659f799",
                                        "entry_id": "95942740-d7a0-334d-9363-b941fd5b5a6f",
                                        "glosses": [
                                            "zakázat hráči družstva další účast v utkání"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
