                "senses": [
                    {
                        "sense_id": "3f96abe5-c533-3dbd-93ac-39a6f09f732a",
                        "entry_id": "8499168a-97e0-3b60-b8a7-3971a85470de",
                        "glosses": [
                            "najmniejszy, a zarazem najgęściej zaludniony okręg Nowego Jorku, położony na wyspie o tej samej nazwie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9944aaa-e586-4f22-9e11-170879dcc3d6",
                                "sense_id": "3f96abe5-c533-3dbd-93ac-39a6f09f732a",
                                "text": "Z sąsiednimi dzielnicami Manhattan łączy kilka mostów."
                            },
                            {
                                "example_id": "ab567716-2761-4372-8ede-858c73306e3f",
                                "sense_id": "3f96abe5-c533-3dbd-93ac-39a6f09f732a",
                                "text": "Aby zwiedzić cały Manhattan, potrzeba co najmniej dwóch tygodni – zważywszy, że zajmuje on prawie 60 kilometrów kwadratowych powierzchni, czyli więcej, niż niektóre małe europejskie państewka."
                            },
                            {
                                "example_id": "b5b553e2-c522-40c7-9446-dd505ad5f8b4",
                                "sense_id": "3f96abe5-c533-3dbd-93ac-39a6f09f732a",
                                "text": "Kiedyś były tu podobno największe znane ludzkości pola ostrygowe, ciągnące się wzdłuż południowego cypla Manhattanu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
