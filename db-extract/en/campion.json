                    },
                    {
                        "sense_id": "8d445a32-f390-3f00-893e-a4af8681880c",
                        "entry_id": "2b72e928-6306-356b-9725-b60e25f644e6",
                        "glosses": [
                            "Any flowering plant of the genus Silene."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a777a1-fb7a-4ed9-8880-1baf739904a4",
                                "sense_id": "8d445a32-f390-3f00-893e-a4af8681880c",
                                "text": "Then over his turnèd temples—here— / Was a rose, or, failing that, / Rough-Robin or five-lipped campion clear / For a beauty-bow to his hat, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eca69cef-1928-46a1-8f0d-210c5bada4a9",
                        "source_entry_id": "2b72e928-6306-356b-9725-b60e25f644e6",
                        "source_sense_description": "Lychnis",
                        "target_lang_word": "kohoutek",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kohoutek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e8cf6c8d-7f58-3e67-9fbe-c5afaeb12d60",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "součást potrubí umožňující ovládání průtoku kapaliny"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fa115be-4eb1-4621-ae91-22d5396f56e7",
                                                "sense_id": "e8cf6c8d-7f58-3e67-9fbe-c5afaeb12d60",
                                                "text": "Z otevřeného kohoutku tekla proudem horká voda."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7228e9df-1f98-30d8-afc2-cc347d0c5d29",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "část střelné zbraně která spouští výstřel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0bbf0ac-7394-4b0f-a68f-4816195d4d3c",
                                                "sense_id": "7228e9df-1f98-30d8-afc2-cc347d0c5d29",
                                                "text": "Přiložil pušku k líci a dlouho mířil, než stiskl kohoutek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a8c803c-b80c-37b4-b703-922b4f2904ef",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "nejvyšší část hřbetu pod šíjí u čtyřnohých zvířat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021adcef-e50f-4382-8eba-f9fa748ab8d4",
                                                "sense_id": "3a8c803c-b80c-37b4-b703-922b4f2904ef",
                                                "text": "„To jsi pacholek,“ rozkřiknou se náhle. „Koně máš špinavého“ a chlapec červený jako rak už upaluje drhnout zabláceného koníka. Kůň stává se modelem, na kterém chlapci se učí hned od malička sedět, učí se jmenovat části jeho těla, kohoutek, bok, kotník, hřívu, plec, učí se i koně „kšírovat“ a zapřahat."
                                            },
                                            {
                                                "example_id": "b76db627-453c-40ef-b782-fd50d5369f0c",
                                                "sense_id": "3a8c803c-b80c-37b4-b703-922b4f2904ef",
                                                "text": "Mladý jelen měřil v kohoutku více než metr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e205e1d-40e6-39f3-8ada-d3b2a0fd8fc2",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "rod lučních květin z čeledi hvozdíkovité (Lychnis)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18438a8d-9ba5-4b43-892b-632c63d55376",
                                                "sense_id": "4e205e1d-40e6-39f3-8ada-d3b2a0fd8fc2",
                                                "text": "kohoutek luční"
                                            },
                                            {
                                                "example_id": "6ac6c4d6-57be-4b38-a95c-d5f252d7d834",
                                                "sense_id": "4e205e1d-40e6-39f3-8ada-d3b2a0fd8fc2",
                                                "text": "kohoutek věncový"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c216df4c-b42c-3c12-a598-4659681a5ca3",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "luční květina se sytě růžovými, jemně dřípenými květy; kohoutek luční"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0196ae4-5593-4e75-8164-905c60874d26",
                                                "sense_id": "c216df4c-b42c-3c12-a598-4659681a5ca3",
                                                "text": "Neb zajděte mezi nejmenší a pozorujte dítky hrající si na lučině. Ty zvláště pozorujte, které se s ostatními neveselí a netrhají ani kohoutky, ani sasanky, ani mák plápolavý, ale bloudí zamlkle vysokou travou u bažiny, zastavujíce se, jakoby v rozpacích, nad trsem bolehlavu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a3695c-1b1f-36e7-a423-ee33d5886b32",
                                        "entry_id": "68292a50-d124-32ab-80b3-19d8ac3084b3",
                                        "glosses": [
                                            "lidový název rozličných rostlin: orlíček obecný, psárka luční, smolnička obecná, atd."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d0e3f1-adac-4cca-95d5-d2f48558ba0e",
                                                "sense_id": "23a3695c-1b1f-36e7-a423-ee33d5886b32",
                                                "text": "Vlaštovky už stavěly a opravovaly hnízda, fialky už kvetly až u jejich plotu, petrklíče a kohoutky (lecha) rostly v každém koutě, a on tu měl všechnu krásu nechat a jít do školy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kohoutek",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3c954d59-2db9-3799-880b-351e631af8cc",
                                        "entry_id": "b07cec47-a7c3-3099-ac55-948692db88a0",
                                        "glosses": [
                                            "kohout"
