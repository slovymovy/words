                ],
                "senses": [
                    {
                        "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                        "entry_id": "09992206-9feb-3d9a-a128-7adf6304f350",
                        "glosses": [
                            "Wirtschaftsbereich, der sich mit der Produktion und Ausstrahlung von Werbung beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8437712-2117-4087-8d60-2ff8a7537d7e",
                                "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                                "text": "„In den weiteren Ausführungen werden die Ergebnisse zu den Einflussfaktoren und Zukunftsentwicklungen der deutschen Werbebranche im Einzelnen vorgestellt.“"
                            },
                            {
                                "example_id": "055d517a-f638-4c44-ac6a-e0c5d65e4df8",
                                "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                                "text": "„Influencer-Marketing ist seit einigen Jahren eines der Buzzwörter in der Werbebranche.“"
                            },
                            {
                                "example_id": "6371055d-c298-43f6-a080-04c71df7f5fb",
                                "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                                "text": "„Die Werbebranche versichert stets, dass Werbung einen rein informativen Zweck verfolgt.“"
                            },
                            {
                                "example_id": "3d6d3d7b-e814-4c13-b6f2-38930c651acd",
                                "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                                "text": "„Die wachsende Bedeutung des Internets in der Werbebranche bestimmt bereits das Werbegeschäft und sie wird auch die Werbung der Zukunft bestimmen.“"
                            },
                            {
                                "example_id": "64fa78bf-1e24-4fdf-bfc4-9bed4f7ae25a",
                                "sense_id": "aed1863f-370a-3a09-89b0-677a7c97eb08",
                                "text": "„Die Werbebranche nimmt hin, dass Google, Facebook und Amazon den Werbemarkt beherrschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
