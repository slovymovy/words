                                "sense_id": "e3506e48-1703-3648-8c23-e3300681df57",
                                "text": "Thee bist rayther too much a feelosofer, I be afeard, for me."
                            },
                            {
                                "example_id": "bf74a4b0-75cd-4504-9098-3bfe533f1a68",
                                "sense_id": "e3506e48-1703-3648-8c23-e3300681df57",
                                "text": "Lookee, thee bist purty, my love; lookee, thee bist purty: thee hast dove's eyes betwix thy locks; thy locks be like a flock o' ship fur thickedness."
                            },
                            {
                                "example_id": "688d2d6b-0314-4f2d-9f1d-5c8878b23271",
                                "sense_id": "e3506e48-1703-3648-8c23-e3300681df57",
                                "text": "\"[…] Stay thee where tha bist, sit down on thi property; what's the sense of wanderen over the barren sea and maybe happenen an accident?\""
                            },
                            {
                                "example_id": "ea23ff59-b93f-4544-bf73-3efe220d9084",
                                "sense_id": "e3506e48-1703-3648-8c23-e3300681df57",
                                "text": "Where bist goin'.\nWhere are you going?"
                            },
                            {
                                "example_id": "3e0fa6d8-9cef-46ea-b9a7-d826ea0fd9ba",
                                "sense_id": "e3506e48-1703-3648-8c23-e3300681df57",
                                "text": "How bist?\nHow are you?"
                            }
                        ]
                    }
