            {
                "entry_id": "4549d840-a543-3b8e-a585-f9f9820b16de",
                "word": "prote",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "30080961-60b1-4bfd-8a1d-8f435501d002",
                        "entry_id": "4549d840-a543-3b8e-a585-f9f9820b16de",
                        "tags": [
                            "plural",
