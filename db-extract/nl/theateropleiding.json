                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea5cbf5f-9cac-457b-9691-b7c890e0d0f5",
                                "sense_id": "12bfd2ed-8ba0-3bae-9379-203f19eebdc3",
                                "text": "Vooral Mordecai en ik, we hadden Napoleon samen geschreven als een obstinaat verzet tegen het gevoel dat we op onze theateropleiding hadden gekregen waar ons keer op keer hetzelfde stuk werd voorgeschoteld leek het wel, het ene klassieke drama na het andere."
                            },
                            {
                                "example_id": "38c70a05-5840-43b4-a348-86eac4cf0f64",
                                "sense_id": "12bfd2ed-8ba0-3bae-9379-203f19eebdc3",
                                "text": "Daarom wil ze de komende jaren aan een theateropleiding beginnen, al weet ze nog niet precies in welke richting. Misschien komt ze wel in musicals terecht, net als haar trainer. Thorsdottir is al met zanglessen begonnen."
                            }
                        ]
