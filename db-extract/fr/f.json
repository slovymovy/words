            {
                "entry_id": "b896d4dd-951f-3961-94b4-9a129f2a7a49",
                "word": "f",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3da4ca69-b2c7-48b4-b16e-d7eb6a33e65e",
                        "entry_id": "b896d4dd-951f-3961-94b4-9a129f2a7a49",
                        "tags": [
                            "canonical"
                        ],
                        "form": "f…"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                        "entry_id": "b896d4dd-951f-3961-94b4-9a129f2a7a49",
                        "glosses": [
                            "de foutre."
                        ],
                        "tags": [
                            "figuratively",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9a541904-745b-4af0-a1bf-b99f4ed947f0",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "— F…-moi le camp ! lui dit Leuwen. Et toi, marche au galop, dit-il au postillon."
                            },
                            {
                                "example_id": "2da139a3-1387-4aae-9a41-54053f4fa645",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "— Ah ! il voulait te défendre ça… eh bien, tu te f… de lui parbleu !"
                            },
                            {
                                "example_id": "c8f0b6e3-a3cc-43c7-b309-5410c700fd70",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "— Tu te f… de moi, dis… ?"
                            },
                            {
                                "example_id": "bdaca2f8-4010-407f-b06a-c484a29233b3",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "— Elle m’a f… à la porte."
                            },
                            {
                                "example_id": "733b0067-ec47-49af-87f8-2d1359e1c221",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "– Et d’ailleurs, l’opinion de la Comtesse de Noailles, je m’en f… un peu."
                            },
                            {
                                "example_id": "e52445b8-cf5a-49c8-9a39-7ca4619c28b9",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "« F…-moi le camp, eh purée, pedzouille ! F…-moi le camp que j’t’ai assez vu."
                            },
                            {
                                "example_id": "bea25423-7eda-40cc-88e7-361e260d4e3d",
                                "sense_id": "f3f7fe44-2416-38fe-a473-056bc5d882a5",
                                "text": "Qu’est-ce que tu f… dans la capitale ! Si au moins tu cherchais une femme !… »"
                            }
                        ]
                    }
                ],
