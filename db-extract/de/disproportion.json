                    {
                        "sense_id": "c57689a0-5e0e-3fdd-b43a-579edaeea923",
                        "entry_id": "eb20618d-f5d2-31e3-bf78-af10a0d2ffc2",
                        "glosses": [
                            "ungleiches Verhältnis zwischen zwei Teilen"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0d4b4b53-f5ee-4069-a2fc-7c5e6c64242c",
                                "sense_id": "c57689a0-5e0e-3fdd-b43a-579edaeea923",
                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d60cc42-e712-4712-8440-9be5d9b375a3",
                        "source_entry_id": "eb20618d-f5d2-31e3-bf78-af10a0d2ffc2",
                        "source_sense_id": "c57689a0-5e0e-3fdd-b43a-579edaeea923",
                        "source_sense_description": "bildungssprachlich: ungleiches Verhältnis zwischen zwei Teilen",
                        "target_lang_word": "disproportion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disproportion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5926ef-90b9-323e-a9fd-9be400b46f40",
                                        "entry_id": "dbec5efe-38a6-317e-8da5-51e680dd875e",
                                        "glosses": [
                                            "The state of being out of proportion; an abnormal or improper ratio; an imbalance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de99ab66-87ce-435e-8e9e-836780422468",
                                                "sense_id": "4e5926ef-90b9-323e-a9fd-9be400b46f40",
                                                "text": "[…] a handsome creature, remarkably so, with features so symmetrical […] that a micrometer gauge could scarcely find a disproportion in her smooth and broad mahogany-coloured face."
                                            },
                                            {
                                                "example_id": "ac179207-1de3-4fd7-831c-c4917a907731",
                                                "sense_id": "4e5926ef-90b9-323e-a9fd-9be400b46f40",
                                                "text": "Then we, the social outsiders, turn around and dictate how men shall treat women (seldom, if ever, how women shall treat men; power in men's rather than women's hands being the excuse offered for this lop-sided arrangement), and how whites shall treat blacks (the same disproportion exists here too)."
                                            },
                                            {
                                                "example_id": "8206770a-0eb3-4aeb-a295-61a5bdcaec7a",
                                                "sense_id": "4e5926ef-90b9-323e-a9fd-9be400b46f40",
                                                "text": "the disproportion of the length of a building to its height"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db38de7e-edaa-3b13-a733-253e50078fb8",
                                        "entry_id": "dbec5efe-38a6-317e-8da5-51e680dd875e",
                                        "glosses": [
                                            "Lack of suitableness, adequacy, or due proportion to an end or use; unsuitableness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e9d41a-d327-4eac-98ef-9e6285ac5fde",
                                                "sense_id": "db38de7e-edaa-3b13-a733-253e50078fb8",
                                                "text": "the disproportion of strength or means to an object"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disproportion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42c4dbe6-c514-30a7-8255-a20b1d1b0ec9",
                                        "entry_id": "08fb7783-a75b-37d5-a6f0-9c310578080a",
                                        "glosses": [
                                            "To make unsuitable in quantity, form, or fitness; to violate symmetry in; to mismatch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f080ec1c-9803-45d2-8207-d71289f4112c",
                                                "sense_id": "42c4dbe6-c514-30a7-8255-a20b1d1b0ec9",
                                                "text": "To shape my legs of an unequal size; / To disproportion me in every part."
                                            },
                                            {
                                                "example_id": "50b026f0-05d2-4ac2-ad1f-7c4b609dc2db",
                                                "sense_id": "42c4dbe6-c514-30a7-8255-a20b1d1b0ec9",
                                                "text": "a degree of strength altogether disproportioned to the extent of its territory"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47a182e8-8d1d-4710-8ffa-729d669be724",
                        "source_entry_id": "eb20618d-f5d2-31e3-bf78-af10a0d2ffc2",
                        "source_sense_id": "c57689a0-5e0e-3fdd-b43a-579edaeea923",
                        "source_sense_description": "bildungssprachlich: ungleiches Verhältnis zwischen zwei Teilen",
                        "target_lang_word": "disproportion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disproportion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c61dc22-ab35-3ce4-ae64-98477e9fd7ea",
                                        "entry_id": "6d8ce2b4-5e09-3bb6-bf68-cded08148a9f",
                                        "glosses": [
                                            "Défaut de proportion entre différentes choses ou entre les parties d’une même chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab906374-b96a-41d5-ab47-c3661772e8a0",
                                                "sense_id": "4c61dc22-ab35-3ce4-ae64-98477e9fd7ea",
                                                "text": "Vous devez savoir que cette loi agraire, dont vous avez tant parlé, n’est qu’un fantôme créé par les fripons pour épouvanter les imbéciles ; il ne fallait pas une révolution sans doute pour apprendre à l’univers que l’extrême disproportion des fortunes est la source de bien des maux et de bien des crimes, mais nous n’en sommes pas moins convaincus que l’égalité des biens est une chimère."
                                            },
                                            {
                                                "example_id": "804bb5ea-9e7b-45dc-bf45-45e8bfc4f04a",
                                                "sense_id": "4c61dc22-ab35-3ce4-ae64-98477e9fd7ea",
                                                "text": "Travaillant douze et quatorze heures par jour, devant sa table de bois blanc, à la défense de la patrie en péril, cet humble secrétaire d’un comité de section ne voyait point de disproportion entre l’énormité de la tâche et la petitesse de ses moyens, tant il se sentait uni dans un commun effort à tous les patriotes, tant il faisait corps avec la nation, tant sa vie se confondait avec la vie d’un grand peuple."
                                            },
                                            {
                                                "example_id": "43cc0748-4772-4c8f-b737-94bb8f09dbce",
                                                "sense_id": "4c61dc22-ab35-3ce4-ae64-98477e9fd7ea",
                                                "text": "Et il réfléchissait. Ce qui est inintelligible, se dit-il, c’est la disproportion qui existe entre les promesses que Jésus lui fit et les résultats qu’elles obtinrent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
