                        ],
                        "examples": [
                            {
                                "example_id": "31b83abd-d72f-4d3c-b5f2-087dc1a35347",
                                "sense_id": "44d04f9b-7fda-35f2-8be2-279080a24dde",
                                "text": "\"I was very much interested to notice the relations which exist between the pastor and his people, and was pleased also with the kind greetings which the newly arrived teacher and teacheress received.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2cc75c61-369c-3ea2-b76b-1e0c58901c56",
                        "entry_id": "5f09a485-7317-3e08-b0db-8f98fe8a5516",
