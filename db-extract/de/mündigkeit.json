                        "form": "der Mündigkeit"
                    },
                    {
                        "form_id": "cd53a5d3-8774-4133-861f-bdd0ba850fc0",
                        "entry_id": "ca7e390e-7ef9-396e-9704-e74838c4d3ea",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Mündigkeit"
                    },
                    {
                        "form_id": "e7a1de29-4227-46a5-9df4-20ea4b68d88a",
                        "entry_id": "ca7e390e-7ef9-396e-9704-e74838c4d3ea",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Mündigkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "22be757a-9b32-3238-b904-bd1ecca881de",
                        "entry_id": "ca7e390e-7ef9-396e-9704-e74838c4d3ea",
                        "glosses": [
                            "Zustand, im rechtlichen Sinne erwachsen zu sein (meist mit Vollendung des 18. Lebensjahres)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca1bd2c-27d0-45e7-9992-f8311c35de1e",
                                "sense_id": "22be757a-9b32-3238-b904-bd1ecca881de",
                                "text": "„Der bundesrätliche Gegenvorschlag räumt den Opfern von Straftaten gegen Kinder eine Bedenkfrist bis zur Mündigkeit ein, also bis 18.“"
                            },
                            {
                                "example_id": "d220f455-c2c3-4cf8-ae79-26a2d9db41a9",
                                "sense_id": "22be757a-9b32-3238-b904-bd1ecca881de",
                                "text": "„Und nach ausgedehnter Diskussion über die politische Mündigkeit unterlag schliesslich mit 40 gegen 44 Stimmen ein Vorschlag, das Stimmrechtsalter zu senken und es Schweizerinnen und Schweizern zu ermöglichen, sich ab zurückgelegtem 16.“"
                            },
                            {
                                "example_id": "4e709a88-b448-4d3a-9713-b432ae7227ff",
                                "sense_id": "22be757a-9b32-3238-b904-bd1ecca881de",
                                "text": "„Ob sie das Wahlrecht schon besitzen oder nicht, sie müssen sich ihre politische Mündigkeit erst noch verdienen.“"
                            },
                            {
                                "example_id": "8ca62b29-00a7-45f2-b251-2ea575c47efb",
                                "sense_id": "22be757a-9b32-3238-b904-bd1ecca881de",
                                "text": "„Nach geltendem Recht ist künstliche Befruchtung dort nur gestattet, wenn die Eltern ‚aufgrund ihres Alters und ihrer persönlichen Verhältnisse voraussichtlich bis zur Mündigkeit der Kinder für deren Pflege und Erziehung sorgen können‘.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                        "entry_id": "ca7e390e-7ef9-396e-9704-e74838c4d3ea",
                        "glosses": [
                            "Fähigkeit aufgrund seines Alters, bestimmte Entscheidungen zu treffen und eigenständig und verantwortlich zu handeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "809fd327-33d8-4e20-a0c0-f529909fc3e7",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Programmieren ist Ausdruck unserer Mündigkeit in einer modernen Welt.“"
                            },
                            {
                                "example_id": "28c2623f-d5a8-4bd3-8dd6-604f80515100",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Der Grundsatz einer totalen Nähe zum Kind war schon im Pietismus oft gepaart mit einer lebenslangen Abhängigkeit, die sich gerade nicht in Mündigkeit auflösen konnte.“"
                            },
                            {
                                "example_id": "09c2604f-ac95-448b-9498-798c5202fe5c",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Ein aufgeklärtes Christentum, das die religiöse Mündigkeit des Einzelnen als Bestandteil seiner selbst begreift, wird zudem Muslimen schwerlich das Recht absprechen können, ihre Religion auch hierzulande ohne besondere Einschränkungen leben zu können.“"
                            },
                            {
                                "example_id": "0702991b-c248-4e4d-83da-2bb78c993429",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Den Weg zur neuen Mündigkeit des Bürgers glaubt er auch zu kennen.“"
                            },
                            {
                                "example_id": "b0435b3b-1bce-40d3-808f-ef7b1e3b630c",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Ökonomische Bildung sei Teil der Allgemeinbildung und Voraussetzung für die Entwicklung von Mündigkeit, Urteilsvermögen und Verantwortungsbewusstsein, heißt es im Strategiepapier des Bündnisses.“"
                            },
                            {
                                "example_id": "760ac6a9-01aa-4348-8ab4-38c5759c28fe",
                                "sense_id": "af71f62e-904f-35e2-8a09-b318fecf4497",
                                "text": "„Es geht um die Erziehung zu Selbstbestimmung und Mündigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
