                "senses": [
                    {
                        "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                        "entry_id": "a018d6b1-7513-3ce6-babc-3db8f0b8c13f",
                        "glosses": [
                            "Irritated, in a bad mood; disparaging."
                        ],
                        "tags": [
                            "Australia",
                            "Ireland",
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7d6b79a5-a1af-4852-8abc-f3f4bfc91168",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "The war had made Stan narkier than ever."
                            },
                            {
                                "example_id": "458166d2-7c53-459b-8944-2f5e2f5a390a",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "2003, Justine Larbalestier, A Buffy Confession, Glenn Yeffeth (editor), Seven Seasons of Buffy: Science Fiction and Fantasy Authors Discuss Their Favorite Television Show, BenBella Books, US, page 83,\nI′m now one of those people I used to defend the show against. There is no one more bitter than an ex-true believer. Color me narky and picky."
                            },
                            {
                                "example_id": "a5f34c33-9e4f-450d-9a84-3a908b395789",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "It was a special request and Mrs. Fleming had to do it all on the spot, so that′s made her even more narky than usual."
                            },
                            {
                                "example_id": "eecf8227-3ac3-477a-b722-28caa00292f6",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "Foolishly, I went to the National Right dinner last night. What a narky, miserable bunch of sods."
                            },
                            {
                                "example_id": "858a8f6f-3ecc-4b69-b4c4-32b07d7a99d9",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "I had to endure the narkiest taxi driver complaining about ‘Foreign lads takin′ taxi plates’, who then managed to test my patience even more by leaving me a good walk from Parker′s apartment block."
                            },
                            {
                                "example_id": "053ee343-b412-4aea-9064-e49c5c203b26",
                                "sense_id": "166341ab-f2b1-32cd-95a6-828a4323d2e2",
                                "text": "2008, Claudia Carroll, Do You Want to Know a Secret?, Random House, UK, unnumbered page,\nAge is definitely making me narkier. The only difference between me and my moany Auntie Maisie is a plaid shopping trolley and a tracheotomy."
                            }
                        ]
                    }
