                                "target_lang_sense_clarification": "часть конструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篮筐",
                                "target_lang_sense_clarification": "篮球运动术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d2a3908-af23-3007-80f5-3a2dd9e6970c",
                    "sense_definition": "The act of putting the ball through the hoop, thereby scoring points.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "basketball_senses",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team needed one more <w>basket</w> to win the championship game.",
                            "target_lang_translations": {
                                "ru": "Команде нужно было еще одно <w>попадание</w>, чтобы выиграть финальный матч.",
                                "zh": "球队还需要一次<w>进球</w>才能赢得冠军赛。"
                            }
                        },
                        {
                            "text": "She scored a <w>basket</w> from the three-point line just before the buzzer.",
                            "target_lang_translations": {
                                "ru": "Она забросила <w>мяч</w> с трехочковой линии прямо перед сиреной.",
                                "zh": "她在终场哨响前从三分线外<w>投篮</w>得分。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "score a basket",
                        "three-point basket"
                    ],
                    "target_lang_definitions": {
                        "ru": "Попадание мячом в кольцо, приносящее очки.",
                        "zh": "将球投入篮筐并得分的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попадание",
                                "target_lang_sense_clarification": "результативный бросок"
                            },
                            {
                                "target_lang_word": "мяч",
                                "target_lang_sense_clarification": "метонимия: забитый мяч"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进球",
                                "target_lang_sense_clarification": "得分行为"
                            },
                            {
                                "target_lang_word": "投篮",
                                "target_lang_sense_clarification": "投球动作"
                            }
                        ]
                    }
