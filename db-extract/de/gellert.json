                "senses": [
                    {
                        "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                        "entry_id": "9e19545e-b830-3b16-a5dc-d71ffca20b18",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74764e8-7841-4998-9066-5310ab116830",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Frau Gellert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bb6681c3-2dc7-4904-9d60-9d537b6716db",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Herr Gellert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "90cd5d41-77f8-454a-9518-d4f2a36ab838",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Die Gellerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7fa6181e-0c17-48da-878d-74b280afe78f",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Der Gellert trägt nie die Schals, die die Gellert ihm strickt."
                            },
                            {
                                "example_id": "3ff2f849-7c4a-486d-ab23-f614036b3585",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gellert kommt, geht der Herr Gellert.“"
                            },
                            {
                                "example_id": "1383bd9e-28ef-4ff9-81ff-a05d427969f2",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Gellert kommt und geht."
                            },
                            {
                                "example_id": "7d939d88-b5a5-4f3a-90e1-a8f37eee5971",
                                "sense_id": "9335e487-808b-39b8-b97d-1034758f29bd",
                                "text": "Gellerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
