                        "glosses": [
                            "Abend, an dem Leute sich treffen, um Skat zu spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056eb589-93a8-4ea6-af2c-e23e973b4bac",
                                "sense_id": "d65b9f8f-2309-36ba-a1c4-8c15ae830dd4",
                                "text": "„Der Vater hat beim Skatabend seine kleinen Spielsiege mit zuviel Bier befeiert, und es ist hoher Morgen, und er liegt noch im Bett und er will nicht raus.“"
                            },
                            {
                                "example_id": "ad6a2468-ce65-4d0e-a554-23a8c1c14b34",
                                "sense_id": "d65b9f8f-2309-36ba-a1c4-8c15ae830dd4",
                                "text": "„Letzte Reste dieser Äfferei kann man bei Skatabenden unter Männern erleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
