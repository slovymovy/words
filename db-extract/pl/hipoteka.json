                        "entry_id": "61e3aaa7-a116-3a1a-8c85-cfd15f326310",
                        "glosses": [
                            "rodzaj zabezpieczenia długu poprzez umożliwienie wierzycielowi odzyskanie go z nieruchomości, której to zabezpieczenie dotyczy"
                        ],
                        "tags": [],
