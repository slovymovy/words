{
    "word_family": [
        "obfuscation",
        "obfuscator",
        "obfuscatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e96cd966-d1e4-34e6-9f32-c1ccbdcf886e",
                    "sense_definition": "To deliberately make something more confusing or difficult to understand in order to conceal the truth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "make_confusing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>obfuscate</w> the truth by giving a long and complicated answer.",
                            "target_lang_translations": {
                                "tr": "Politikacı, uzun ve karmaşık bir cevap vererek gerçeği <w>bulandırmaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "The company attempted to <w>obfuscate</w> facts about their financial losses in the annual report.",
                            "target_lang_translations": {
                                "tr": "Şirket, yıllık raporda mali kayıplarıyla ilgili gerçekleri <w>gizlemeye</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "muddle",
                        "obscure"
                    ],
                    "antonyms": [
                        "explain",
                        "simplify"
                    ],
                    "common_phrases": [
                        "obfuscate facts",
                        "obfuscate the truth"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gerçeği gizlemek amacıyla bir şeyi kasten daha karmaşık veya anlaşılması güç hale getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "bulandırmak",
                                "target_lang_sense_clarification": "Zihni veya durumu karmaşıklaştırarak netliği bozmak."
                            },
                            {
                                "target_lang_word": "gizlemek",
                                "target_lang_sense_clarification": "Gerçeği veya bilgiyi saklamak."
                            },
                            {
                                "target_lang_word": "örtbas etmek",
                                "target_lang_sense_clarification": "Bir olayı veya gerçeği gizlemek için çaba sarf etmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fef7ea40-4716-3db7-8276-6eebdc8b82d4",
                    "sense_definition": "To alter computer code while preserving its behavior but concealing its structure and intent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "code_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>obfuscate</w> these classes before we ship the final release to protect our intellectual property.",
                            "target_lang_translations": {
                                "tr": "Fikri mülkiyetimizi korumak için son sürümü yayınlamadan önce bu sınıfları <w>karartmamız</w> gerekiyor."
                            }
                        },
                        {
                            "text": "Developers often <w>obfuscate</w> code to prevent competitors from easily reverse-engineering their software.",
                            "target_lang_translations": {
                                "tr": "Geliştiriciler, rakiplerin yazılımlarını kolayca tersine mühendislik yapmasını önlemek için genellikle kodu <w>karartırlar</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obfuscate code"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bilgisayar kodunun işleyişini koruyarak yapısını ve amacını gizlemek için kodu değiştirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karartmak",
                                "target_lang_sense_clarification": "Teknik bağlamda kodun okunabilirliğini bozmak."
                            },
                            {
                                "target_lang_word": "kod gizlemek",
                                "target_lang_sense_clarification": "Yazılımın tersine mühendisliğini zorlaştırmak için yapılan işlem."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66230084-92dd-3e58-93a9-eb9d5edc6926",
                    "sense_definition": "To make dark or to overshadow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick black clouds began to <w>obfuscate</w> the sun, bringing an early darkness to the valley.",
                            "target_lang_translations": {
                                "tr": "Kalın kara bulutlar güneşi <w>karartmaya</w> başladı ve vadiye erken bir karanlık çöktü."
                            }
                        },
                        {
                            "text": "The towering new skyscrapers threaten to <w>obfuscate</w> the historic monument nearby.",
                            "target_lang_translations": {
                                "tr": "Yükselen yeni gökdelenler, yakındaki tarihi anıtı <w>gölgelemekle</w> tehdit ediyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "darken",
                        "eclipse",
                        "overshadow"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in literal sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Karanlık hale getirmek veya gölgede bırakmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "karartmak",
                                "target_lang_sense_clarification": "Işığı kesmek veya karanlık duruma getirmek."
                            },
                            {
                                "target_lang_word": "gölgelemek",
                                "target_lang_sense_clarification": "Bir şeyin üzerine gölge düşürerek görünmesini engellemek."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba6dab01-6332-3c7b-9b34-49ce3502691c",
                    "sense_definition": "Being <w>obfuscated</w>; darkened or obscured.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "darken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text remained <w>obfuscate</w> and difficult for modern scholars to interpret.",
                            "target_lang_translations": {
                                "tr": "Antik metin <w>belirsiz</w> kaldı ve modern akademisyenlerin yorumlaması zor oldu."
                            }
                        },
                        {
                            "text": "His vision became <w>obfuscate</w> as the thick smoke filled the room.",
                            "target_lang_translations": {
                                "tr": "Yoğun duman odayı doldurdukça görüşü <w>karardı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Karartılmış veya üzeri örtülmüş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kararmış",
                                "target_lang_sense_clarification": "Işığı azalmış veya rengi koyulaşmış."
                            },
                            {
                                "target_lang_word": "belirsiz",
                                "target_lang_sense_clarification": "Net olmayan, anlaşılması güç."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}