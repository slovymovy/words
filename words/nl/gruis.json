{
    "word_family": [
        "gruizen",
        "vergruizen",
        "gruislaag",
        "steengruis",
        "koolgruis"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be704b18-deee-3721-b068-75a684a91c64",
                    "sense_definition": "Kleine stukjes steen of ander hard materiaal die grover zijn dan stof maar fijner dan brokken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "materiaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het afbreken van het oude huis kwam de hele tuin onder het <w>gruis</w> te liggen.",
                            "target_lang_translations": {
                                "en": "When the old house was demolished, the entire garden was covered in <w>rubble</w>."
                            }
                        },
                        {
                            "text": "De wandelaar gleed bijna uit over het losse <w>gruis</w> op de steile vulkaanhelling.",
                            "target_lang_translations": {
                                "en": "The hiker almost slipped on the loose <w>grit</w> on the steep volcanic slope."
                            }
                        }
                    ],
                    "synonyms": [
                        "steengruis",
                        "grit"
                    ],
                    "common_phrases": [
                        "los gruis",
                        "fijn gruis"
                    ],
                    "target_lang_definitions": {
                        "en": "Small pieces of stone or other hard material that are coarser than dust but finer than chunks."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grit",
                                "target_lang_sense_clarification": "small hard particles of stone or debris"
                            },
                            {
                                "target_lang_word": "gravel",
                                "target_lang_sense_clarification": "small fragments of rock often used on roads"
                            },
                            {
                                "target_lang_word": "rubble",
                                "target_lang_sense_clarification": "fragments from demolished buildings"
                            },
                            {
                                "target_lang_word": "screenings",
                                "target_lang_sense_clarification": "fine material left over from crushing stone"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff8c6c84-5206-3d71-b310-4181581d04a8",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>gruizen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>gruis</w> de stenen tot een fijn poeder voor mijn experiment.",
                            "target_lang_translations": {
                                "en": "I <w>crush</w> the stones into a fine powder for my experiment."
                            }
                        },
                        {
                            "text": "Wanneer ik de schelpen <w>gruis</w>, gebruik ik daarvoor een zware hamer.",
                            "target_lang_translations": {
                                "en": "When I <w>grind</w> the shells, I use a heavy hammer for that."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of the verb 'gruizen' (to crush/grind)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to press or grind into small pieces"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "to reduce to small particles by friction"
                            },
                            {
                                "target_lang_word": "pulverize",
                                "target_lang_sense_clarification": "to reduce to fine powder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f458b99-bdc1-352c-9a27-3a631c146d01",
                    "sense_definition": "De gebiedende wijs van <w>gruizen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gruis</w> die brokken nu eindelijk eens zodat we verder kunnen met de bouw.",
                            "target_lang_translations": {
                                "en": "<w>Crush</w> those chunks finally so we can proceed with the construction."
                            }
                        },
                        {
                            "text": "<w>Gruis</w> de tabletten voordat je ze door het eten van de hond mengt.",
                            "target_lang_translations": {
                                "en": "<w>Grind</w> the tablets before you mix them into the dog's food."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of the verb 'gruizen' (to crush/grind)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "command to press or grind into small pieces"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "command to reduce to small particles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ef98232-4b27-3d09-b1c6-59e1149e9e8b",
                    "sense_definition": "De tweede persoon enkelvoud tegenwoordige tijd van <w>gruizen</w> bij inversie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>gruis</w> je die stenen eigenlijk met de hand in plaats van met een machine?",
                            "target_lang_translations": {
                                "en": "Why do you actually <w>crush</w> those stones by hand instead of with a machine?"
                            }
                        },
                        {
                            "text": "Wanneer <w>gruis</w> je de rest van het materiaal voor de weg?",
                            "target_lang_translations": {
                                "en": "When will you <w>grind</w> the rest of the material for the road?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "second-person singular present inversion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The second-person singular present tense of 'gruizen' used in inversion (e.g., in questions)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crush",
                                "target_lang_sense_clarification": "to press or grind into small pieces"
                            },
                            {
                                "target_lang_word": "grind",
                                "target_lang_sense_clarification": "to reduce to small particles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}