                        "entry_id": "f7a192df-f34a-3e0b-9e07-ff66e26449ad",
                        "glosses": [
                            "Besitzer eines Vermögens im Wert von mindestens einer Million \\\"Währungseinheiten\\\" (Euro, Dollar, Pfund oder Ähnliches)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9b3d1f-feb7-4211-bf5a-37a1d89ee18c",
                                "sense_id": "d9ff2fd7-67ff-3efd-9294-624b82a3e529",
                                "text": "Ich bin doch kein Millionär."
