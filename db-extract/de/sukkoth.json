                    {
                        "translation_id": "a4c14f50-b2fe-44be-89a8-ca5925dafc5f",
                        "source_entry_id": "0eb32d13-881d-3cbf-a996-09c630b6e6ed",
                        "source_sense_id": "92bcee4a-b2eb-3a76-a29c-edf1fd9f965b",
                        "target_lang_word": "Soukkot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soukkot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1de55628-b2a7-3a03-b581-0d1e195ffa1f",
                                        "entry_id": "d8c1fb94-1dac-3a7e-83e9-11171c7d1e60",
                                        "glosses": [
                                            "Fête juive de sept jours, une des trois fêtes de pèlerinage, qui marque la fin du cycle agricole annuel, et où les repas (au minimum) doivent être pris dans la cabane appelée soukka."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efbd4f4f-5e4a-4f68-9f7b-c72f5bfa6b6b",
                                                "sense_id": "1de55628-b2a7-3a03-b581-0d1e195ffa1f",
                                                "text": "Durant la fête des cabanes, l’eau a également une certaine importance. Selon la tradition rabbinique, Soukkot était, à l’époque du temple de Jérusalem, l’occasion de la cérémonie de la libation d'eau, au cours de laquelle de l’eau, puisée à la source de Gihon, était versée sur l’autel, afin d’obtenir la grâce divine pour les pluies."
                                            },
                                            {
                                                "example_id": "473aaec2-b6e8-4f40-83bc-ea7f243d5b43",
                                                "sense_id": "1de55628-b2a7-3a03-b581-0d1e195ffa1f",
                                                "text": "Soukkot est une fête juive durant laquelle on habite et reçoit ses amis dans une cabane construite selon des règles précises."
                                            },
                                            {
                                                "example_id": "b0b786ff-39ad-4aaa-8750-5bbadcc2f8b5",
                                                "sense_id": "1de55628-b2a7-3a03-b581-0d1e195ffa1f",
                                                "text": "Après la catastrophe, il essaie juste de poursuivre sa petite vie et de vendre des cédrats pour la fête de Soukkot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
