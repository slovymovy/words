                                        "sense_id": "f2c9cf41-3eee-36d5-909e-a8d06b5847c7",
                                        "entry_id": "8a55bc69-c335-347b-85a8-a7b1cae552f1",
                                        "glosses": [
                                            "zonder dat er mensen wonen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2f36ccc-0b5c-4ae2-909b-d0aca4c7192f",
                                                "sense_id": "f2c9cf41-3eee-36d5-909e-a8d06b5847c7",
                                                "text": "Robinson Crusoe woonde op een onbewoond eiland."
                                            },
                                            {
                                                "example_id": "ac03d802-747f-4dac-8921-1aaf01b8e9b8",
                                                "sense_id": "f2c9cf41-3eee-36d5-909e-a8d06b5847c7",
                                                "text": "Omdat ik nog nooit op een naaktstrand of naturistencamping was geweest, merkte ik voor het eerst hoe natuurlijk het voelt om zonder kleren door de natuur te lopen. In deze onbewoonde omgeving was het ook niet raar of rebels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4268dc9c-e180-40ff-80cb-1e9da7fa4d8b",
                        "source_entry_id": "f56f4425-bec3-383e-aa28-d4c2aaeedecd",
                        "source_sense_description": "not inhabited",
                        "target_lang_word": "inhabité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhabité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b788ae6e-6f59-3a2c-a082-9e1f385a7460",
                                        "entry_id": "50c06783-88b0-3d71-b45d-387113e26bb4",
                                        "glosses": [
                                            "Espace qui n’est pas habité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4a04225-0f8f-47d9-99c0-04b082431fd1",
                                                "sense_id": "b788ae6e-6f59-3a2c-a082-9e1f385a7460",
                                                "text": "Elle me fit entrer en me recommandant de faire le moins de bruit possible, bien que la chambre de sa mère fût sur la cour, et m’introduisit dans une pièce étroite qui devait être le salon. Il y faisait froid et il avait l’odeur de l’inhabité."
                                            },
                                            {
                                                "example_id": "8cc0d5ef-80b3-448a-b4c6-a3f50283f94d",
                                                "sense_id": "b788ae6e-6f59-3a2c-a082-9e1f385a7460",
                                                "text": "« Je vous avertis, je vais franchir le pas, sauter hors de ce monde décent, habité, tiède et doux, je vais m’en arracher, tomber, choir dans l’inhabité, dans le vide… »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhabité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f31cdb5-0d65-3070-a62d-bd8cfbd044b5",
                                        "entry_id": "80618860-4772-36dc-8667-592c6b5eef7f",
                                        "glosses": [
                                            "Participe passé masculin singulier de inhabiter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "inhabité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                        "entry_id": "e801e570-095a-3ec1-a057-b26c602babe8",
                                        "glosses": [
                                            "Qui n’est pas habité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4abea4bf-f587-40c9-975e-95c587bd3dbf",
                                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                                "text": "Aux aventureux, l'Islande offre aussi l’attrait de l’inconnu. Le cœur de l’île, inhabité et inhabitable, est encore une terre incognito."
                                            },
                                            {
                                                "example_id": "093fe3ac-4013-4e73-b338-ea3d5c93b0c1",
                                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                                "text": "Les îles Galapagos, autrefois inhabitées, n'étaient alors visitées que par quelques baleiniers qui venaient s'y ravitailler en eau."
                                            },
                                            {
                                                "example_id": "eba619dc-9392-4da4-8bc9-ee3122e00f28",
                                                "sense_id": "50552f82-d560-3f1d-9a88-e38bf39df76e",
                                                "text": "Peu de villages. Quelques rares masures dont la plupart sont inhabitées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
