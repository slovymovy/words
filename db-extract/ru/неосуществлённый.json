                "senses": [
                    {
                        "sense_id": "e02022b7-d32a-3bee-b987-988a22f32bc5",
                        "entry_id": "4e02d57f-48f4-3c92-8580-2e802193fbe2",
                        "glosses": [
                            "страд. прич. прош. вр. от не осуществить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "22410623-4184-443d-8184-77caaf8912b1",
                                "sense_id": "e02022b7-d32a-3bee-b987-988a22f32bc5",
                                "text": "Неосуществлённые проекты не приносили доходов."
                            }
                        ]
                    },
                    {
                        "sense_id": "eaaab2ea-d09d-30f6-9299-c1c5d484bdc1",
                        "entry_id": "4e02d57f-48f4-3c92-8580-2e802193fbe2",
                        "glosses": [
                            "субстантивир. то, что не воплощённо в действительность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b419be1-4fe1-4de2-858e-4c4959ed226f",
                                "sense_id": "eaaab2ea-d09d-30f6-9299-c1c5d484bdc1",
                                "text": "А рядом, совсем в другом масштабе, шло лето; осквернённое городом, но всё же торжественное, оно разворачивалось, созревало, готовилось опадать и хватало меня за душу всеми своими вечерами, дождями, запахами, напоминая о неосуществлённом, растраченном…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7316a896-1b14-44c7-8deb-740b48d39ee2",
                        "source_entry_id": "4e02d57f-48f4-3c92-8580-2e802193fbe2",
                        "target_lang_word": "unfulfilled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfulfilled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccb7a50a-e1f4-3090-81cf-03be16d89e4e",
                                        "entry_id": "8a7f7abc-64c0-3eb9-a611-b877727b9b0f",
                                        "glosses": [
                                            "Lacking fulfillment; marked by a feeling of failure to achieve goals or desires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed8ec15-834a-40ec-905d-496f80432fb6",
                                                "sense_id": "ccb7a50a-e1f4-3090-81cf-03be16d89e4e",
                                                "text": "Drag this neurotic to hysterics, leave him balked and unfulfilled;\nholding inside, outwardly patient 'til the time he'll call it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd593329-413d-32d7-8a71-bdf0b817d8d4",
                                        "entry_id": "8a7f7abc-64c0-3eb9-a611-b877727b9b0f",
                                        "glosses": [
                                            "Not yet provided as promised, particularly with respect to a contract or an order for a supply of something."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
