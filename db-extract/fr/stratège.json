        "fr-extract.jsonl": [
            {
                "entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
                "word": "stratège",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "63bb156d-019d-47c6-ba89-ed91df602b9e",
                        "entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
                        "tags": [
                            "plural"
                        ],
                        "form": "stratèges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0fe0f2bb-f49c-3f07-8283-a8f4dc9fed12",
                        "entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
                        "glosses": [
                            "Général ; titre des dix chefs élus qui commandaient l’armée à Athènes et remplissaient quelques autres fonctions du pouvoir exécutif."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e50100e1-785f-4b60-8e09-0ce9be3117d2",
                                "sense_id": "0fe0f2bb-f49c-3f07-8283-a8f4dc9fed12",
                                "text": "Ainsi dit-il un jour à Simonide de Céos qui requérait de lui, alors qu’il était stratège, un acte illégal : « Il ne serait pas bon poète celui qui chanterait contre la mesure, pas plus que je ne serais, moi, un magistrat correct en accordant une faveur contraire à la loi »."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a0fdb03-c60c-31ce-96a0-faf8f7106689",
                        "entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
                        "glosses": [
                            "Celui ou celle qui connaît et qui applique les règles de la stratégie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "722af57e-9302-42ee-a75e-493f10ec8321",
                                "sense_id": "1a0fdb03-c60c-31ce-96a0-faf8f7106689",
                                "text": "Hannibal s’était montré aussi habile tacticien qu’éminent stratège ; il triomphait cette fois sans coup férir."
                            },
                            {
                                "example_id": "1af0604e-015f-4b98-bb54-96cf674452a7",
                                "sense_id": "1a0fdb03-c60c-31ce-96a0-faf8f7106689",
                                "text": "On a une voiture plus performante, de six ou sept dixièmes au tout, mais les stratèges ont fait n’importe quoi en faisant rentrer Leclerc pour lui mettre des gommes dures, pas du tout performantes, se désole le twitto."
                            },
                            {
                                "example_id": "d32587e4-1bca-4c32-bd6f-6544473dd942",
                                "sense_id": "1a0fdb03-c60c-31ce-96a0-faf8f7106689",
                                "text": "Pourquoi les stratèges américains souhaiteraient-ils la fin d’une guerre aussi providentielle ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5a13ba3-7389-4560-b10b-02cbc924abfe",
                        "source_entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
                        "target_lang_word": "Stratege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stratege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dff6358-7553-3cff-a761-e4786625509e",
                                        "entry_id": "1c5d260a-d72b-39ea-ae3e-574cbcaa3c40",
                                        "glosses": [
                                            "jemand, der sich eine Strategie überlegt; jemand, der strategisch vorgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ae7eeb-be9e-4d17-a728-9b9caf6ebd3c",
                                                "sense_id": "3dff6358-7553-3cff-a761-e4786625509e",
                                                "text": "„Rund 85 Prozent aller Audi A6 werden in Deutschland an Geschäftskunden verkauft - da ist es kaum verwunderlich, wenn die Ingolstädter Strategen auch bei der Produktaufwertung des A6 diese Klientel besonders im Visier haben.“"
                                            },
                                            {
                                                "example_id": "3dbaf1b7-435b-42ed-866e-183e9093d475",
                                                "sense_id": "3dff6358-7553-3cff-a761-e4786625509e",
                                                "text": "„Er ist auch ein Stratege der Gesprächsführung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73e9c1f3-b593-41f0-bf21-b121ac4e91b9",
                        "source_entry_id": "7cb074fa-22c2-3c31-ba80-aee009ee189c",
