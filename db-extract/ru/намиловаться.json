                "senses": [
                    {
                        "sense_id": "e2b149bf-acd1-338a-8032-4a6fe2e4ad8e",
                        "entry_id": "0523224d-085c-3119-9f85-1bef5ffa9ed3",
                        "glosses": [
                            "нар.-разг. вдоволь помиловаться друг другом, поласкаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5281df-eb07-4a13-9cfd-e7d3acf9232f",
                                "sense_id": "e2b149bf-acd1-338a-8032-4a6fe2e4ad8e",
                                "text": "Мы с ним видались почти каждый божий день; не могли наглядеться друг на друга, не могли наговориться, намиловаться."
                            },
                            {
                                "example_id": "c4479de2-f443-4dc9-870f-0ee505bedc14",
                                "sense_id": "e2b149bf-acd1-338a-8032-4a6fe2e4ad8e",
                                "text": "Намиловались, наласкались, и куда только девалась гордыня, зло будто только что не пировало в избе."
                            }
                        ]
                    }
