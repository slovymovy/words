        "fr-extract.jsonl": [
            {
                "entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
                "word": "belladone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c063f5aa-9d1c-4b05-961e-079b4c5ddf71",
                        "entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
                        "tags": [
                            "plural"
                        ],
                        "form": "belladones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                        "entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
                        "glosses": [
                            "Plante vénéneuse, de la famille des Solanacées, qui est employée en médecine (Atropa belladonna)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8cb42c-12c8-4565-bd75-5e63d2c772ea",
                                "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                                "text": "Toutefois, Madge, qui avait soigné plusieurs cas de scarlatine, connaissait l’efficacité de la teinture de belladone."
                            },
                            {
                                "example_id": "1a610473-9faa-4fa1-ade7-b70f8ee93a07",
                                "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                                "text": "Les plantes narcotiques, plantes à aspect triste & presque sinistre, ne manquent pas non plus dans les Ardennes, car on trouve la belladone à Saint-Aignan, Vendresse, &c., la jusquiame à Noyers, Artaise-le-Vivier, Villers-le-Tourneur, &c. ; l’Atropa physaloides, subspontanée près de Sedan, de même que le Datura stramonium."
                            },
                            {
                                "example_id": "ce1271c8-a385-46c6-8fb7-225376b6455a",
                                "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                                "text": "Un alourdissement de tous ses membres, accompagné d’un commencement de nausées l’avertit bientôt qu’il avait sous la main un laboratoire naturel de belladone, c’est-à-dire du plus actif des narcotiques."
                            },
                            {
                                "example_id": "1f24b9e3-bb7a-4c0d-ab3f-67d8e0390d4f",
                                "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                                "text": "Des mandragores, des ciguës, des hellébores, des belladones, montait un vertige à leurs tempes."
                            },
                            {
                                "example_id": "042e5534-33bb-4131-9142-d972913586a3",
                                "sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                                "text": "Il y a bien longtemps, au Moyen Age, les femmes se mettaient de la belladone (de l’italien belladonna, belle dame) pour dilater leurs pupilles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a8c4a95-5553-4915-925c-c70998e8bd80",
                        "source_entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
                        "source_sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                        "target_lang_word": "Tollkirsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tollkirsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "Giftpflanze der Gattung Atropa aus der Familie der Nachtschattengewächse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a8382f3-212e-4ea5-962b-5c1d16feac32",
                                                "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                                "text": "Tollkirschen sind krautige, aufrecht wachsende Pflanzen."
                                            },
                                            {
                                                "example_id": "e7116aa0-8db1-4620-8d06-87a51de9ed90",
                                                "sense_id": "07008641-065a-33a2-a0ef-fced39e9e7fc",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "speziell die schwarze Tollkirsche (Atropa belladonna)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fe21ba4-6236-4639-b890-966ca0ec6a23",
                                                "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                                "text": "„In der mittelalterlichen Volkskunde spielte Bilsenkraut bei den Praktiken des Hexenkults eine wichtige Rolle, wo es zusammen mit Stechapfel und Tollkirsche als Ingredienz von Hexensalben verwandt wurde.“"
                                            },
                                            {
                                                "example_id": "3d81fce8-7878-4252-8aa2-220e6ca049ee",
                                                "sense_id": "6af66c0b-49cc-3b11-ac57-f5a2e5a49d3f",
                                                "text": "Die Tollkirsche ist in unseren Wäldern weit verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "864f4939-6852-3ffb-98ca-a7ae9c662d78",
                                        "entry_id": "b882986b-af02-3719-a70f-4567cf58c86e",
                                        "glosses": [
                                            "Frucht von [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c75c762-ade2-4f3f-9ccf-cdcc56809581",
                                                "sense_id": "864f4939-6852-3ffb-98ca-a7ae9c662d78",
                                                "text": "Bei Kindern können schon 3 bis 5 Tollkirschen zum Tod führen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "584d9a0e-9db5-4370-b2ce-1e0c38392f4b",
                        "source_entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
                        "source_sense_id": "05233982-1793-3fc5-9ea8-8f834de41fdc",
                        "target_lang_word": "belladonna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belladonna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "070afa7f-f1e6-3c63-9a0b-71f1483846c1",
                                        "entry_id": "01c8c713-4e0a-3f96-bef5-81a6eabcc2aa",
                                        "glosses": [
                                            "A plant, Atropa belladonna, having purple bell-shaped flowers and poisonous black glossy berries."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90a2a7c-16a9-4850-89b9-8272efa3a72b",
                                                "sense_id": "070afa7f-f1e6-3c63-9a0b-71f1483846c1",
                                                "text": "Witches always anointed themselves with ointments before departing up the chimney to their Sabbaths. One such ointment was composed of Aconite, Belladonna, Water Parsley, Cinquefoil and Babies' Fat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b7f3465-647a-33ae-a27a-3564e071f7ae",
                                        "entry_id": "01c8c713-4e0a-3f96-bef5-81a6eabcc2aa",
                                        "glosses": [
                                            "An alkaloid extracted from this plant, sometimes used medicinally, containing atropine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4305116-0ab7-4ad7-ab15-53ebcb734232",
                                                "sense_id": "6b7f3465-647a-33ae-a27a-3564e071f7ae",
                                                "text": "The elderly women who practiced herbalism and administered belladonna (a pain killer) to pregnant women were apt to be accused of witchcraft. The Medieval church was against the administration of belladonna because they believed women were meant to suffer pain in childbirth as a result of Eve's sin."
                                            },
                                            {
                                                "example_id": "08568bca-a04d-4374-bb4d-59c08aef265e",
                                                "sense_id": "6b7f3465-647a-33ae-a27a-3564e071f7ae",
                                                "text": "Cathy teetered downstairs on very high heels, her hair swept up in a disintegrating “brioche”, her eyes glistening with belladonna drops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4fb0963-f775-4f9d-9730-c260de12a564",
                        "source_entry_id": "b4259ced-3258-3a7d-8b4c-08152d9be731",
