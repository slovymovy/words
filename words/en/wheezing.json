                            }
                        },
                        {
                            "text": "He lay in bed, coughing and <w>wheezing</w> throughout the cold night.",
                            "target_lang_translations": {
                                "de": "Er lag im Bett und verbrachte die kalte Nacht hustend und <w>röchelnd</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gasping",
                        "panting"
