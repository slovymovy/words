                        ],
                        "examples": [
                            {
                                "example_id": "356cfaf8-5d53-4b10-b120-cd843b278f2d",
                                "sense_id": "15e464cd-cb5b-3fe1-b4db-debb598f6515",
                                "text": "The Gadfly’s venom, fifty times distilled,\nIs mingled with the vomit of the Leech,\nIn due proportion, and black ratsbane, which\nThat very Rat, who, like the Pontic tyrant,\nNurtures himself on poison, dare not touch;—"
                            },
                            {
                                "example_id": "54aa22a9-8061-4367-a4be-dc754d09e9e0",
                                "sense_id": "15e464cd-cb5b-3fe1-b4db-debb598f6515",
                                "text": "Before him set the grim baron, with a face worthy of the father of such a daughter, and looking daggers and rat's bane."
                            }
                        ]
                    }
