                "translations": [
                    {
                        "translation_id": "27e8dac6-7649-46d1-bee4-d6dafb021f4c",
                        "source_entry_id": "527407ec-4fb0-3635-9b5c-bd4c8c16c00a",
                        "target_lang_word": "déshydrater",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déshydrater",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d45e83-9c2e-31e8-a764-75bde9baf222",
                                        "entry_id": "080d56e8-1af7-3cc9-868f-f07855bf9cfc",
                                        "glosses": [
                                            "Enlever à un corps une partie ou la totalité de l'eau qu'il contient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f7c947-dc7d-47f0-9716-5f77a9c16653",
                                                "sense_id": "b6d45e83-9c2e-31e8-a764-75bde9baf222",
                                                "text": "Au contraire, l’acide de Reychler déshydrate quantitativement le paraméthylcyclohexanol vers 120°."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09e5a942-771c-3c1d-a3b8-329ede3763e9",
                                        "entry_id": "080d56e8-1af7-3cc9-868f-f07855bf9cfc",
                                        "glosses": [
                                            "Enlever à un organisme, à la peau une partie de l'eau qu'il contient."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ef6abc-64ac-4904-b33e-210ba510f9fa",
                                                "sense_id": "09e5a942-771c-3c1d-a3b8-329ede3763e9",
                                                "text": "D'une façon générale, il faut se méfier du vent qui déshydrate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed78999-9c07-3195-af91-678077893ab6",
                                        "entry_id": "080d56e8-1af7-3cc9-868f-f07855bf9cfc",
                                        "glosses": [
                                            "Avoir besoin de boire."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634b996f-4da9-44b3-b3cc-12dfd24abfbf",
                        "source_entry_id": "527407ec-4fb0-3635-9b5c-bd4c8c16c00a",
                        "target_lang_word": "sécher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sécher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a36a37e-1d72-37de-b73d-d429c20de6f5",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Rendre sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0754fb69-ba25-4868-8548-adccca66772b",
                                                "sense_id": "9a36a37e-1d72-37de-b73d-d429c20de6f5",
                                                "text": "[…] on vient d’inaugurer un séchoir artificiel : c’est un four à chaleur modérée, où l’on dispose les poissons sur des lattes ; au bout de trois jours ils sont séchés à point."
                                            },
                                            {
                                                "example_id": "5f3c3d57-83a6-4d87-a4e5-27d6922b5c38",
                                                "sense_id": "9a36a37e-1d72-37de-b73d-d429c20de6f5",
                                                "text": "Les deux moines qui entraient en charge pour leur semaine de service commençaient par l’abbé : le plus ancien (selon le rang monastique) lavait les pieds et le plus jeune les séchait."
                                            },
                                            {
                                                "example_id": "25872302-be18-4915-b26d-a615db759b89",
                                                "sense_id": "9a36a37e-1d72-37de-b73d-d429c20de6f5",
                                                "text": "Elle se soumit avec un abandon lascif aux mains expertes des deux jeunes femmes qui la lavèrent, la séchèrent et lui brossèrent les cheveux […]"
                                            },
                                            {
                                                "example_id": "a68d5ea0-1a4e-4603-81ad-61f63ed1ff61",
                                                "sense_id": "9a36a37e-1d72-37de-b73d-d429c20de6f5",
                                                "text": "En octobre 1854, la boulangère de Méobecq qui, comme c'était l'usage, avait fait sécher du chanvre dans son four avant de le broyer et de le filer, met le feu à la boulangerie : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e5e0fd3-665d-3155-8f68-deaf817df682",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Faire cesser l’affliction, en parlant des larmes ou des pleurs."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dd7792f-209e-4bfd-8834-63be495c0a6c",
                                                "sense_id": "8e5e0fd3-665d-3155-8f68-deaf817df682",
                                                "text": "Sèche tes pleurs, Serena, sèche tes pleurs & cours annoncer à ta mère la délivrance de Sophronie."
                                            },
                                            {
                                                "example_id": "8b118d7c-b76c-44e6-9ccf-7eaee0cc4408",
                                                "sense_id": "8e5e0fd3-665d-3155-8f68-deaf817df682",
                                                "text": "Il n’y eût pas une âme qui sympathisât avec celle d’Athanase ; pas une femme, pas un ami ne vinrent à lui pour sécher ses larmes, il les jeta dans la Sarthe."
                                            },
                                            {
                                                "example_id": "1b244ea3-861c-446c-8c96-4322d8f83f04",
                                                "sense_id": "8e5e0fd3-665d-3155-8f68-deaf817df682",
                                                "text": "À cette pensée désolante je séchais mes larmes, je reprenais ma tâche en maudissant ma faiblesse, en me disant que mon enfant ressentirait peut-être la réaction de mes chagrins […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5cb1cd-ab07-37bc-9732-779b3b7e63e8",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Mettre à sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11fefee4-d3cc-4fdd-98d4-6126f30a17b4",
                                                "sense_id": "7c5cb1cd-ab07-37bc-9732-779b3b7e63e8",
                                                "text": "Ce général des Assyriens, ne pouvant sécher un ruisseau qui fournissait abondamment de l’eau à cette ville, ordonna qu’on le fit répandre sur des lieux sablonneux pour en faire perdre les eaux et pour faire périr de soif les assiégés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76be5fa5-c144-3f4b-8480-40c51cbc84a9",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Boire et vider complètement un verre ou une bouteille."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e07094-5ce3-4261-aabe-77228ee2fc51",
                                                "sense_id": "76be5fa5-c144-3f4b-8480-40c51cbc84a9",
                                                "text": "Pour toute réponse, le père sécha son Picon et piocha une nouvelle bière dans la glacière."
                                            },
                                            {
                                                "example_id": "daf347da-675f-4f91-bf75-c0f4a46e107a",
                                                "sense_id": "76be5fa5-c144-3f4b-8480-40c51cbc84a9",
                                                "text": "Il se défendrait mieux, il convient, s'il n'aimait pas tant la dive. Je vous ai dit, déjà trois guindals… il est peut-être dix heures, et à midi il aura séché son premier litre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2290ab36-53e6-3ce4-996e-081af74e3f57",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Ne pas aller en cours ou à l’école quand cela est obligatoire."
                                        ],
                                        "tags": [],
                                        "note": "On ne peut pas parler de sécher un cours facultatif : on se contente de ne pas y aller",
                                        "examples": [
                                            {
                                                "example_id": "d09f19aa-5876-47ba-8bf3-e219dd7ba82f",
                                                "sense_id": "2290ab36-53e6-3ce4-996e-081af74e3f57",
                                                "text": "Pourtant, peu d’étudiants séchaient ce cours, et à cela n’étaient que les deux raisons innées de la condition humaine : les filles étaient sérieuses et les garçons, alléchés par les formes avantageuses de leur jeune enseignante, se découvraient soudain intérêt pour les choses de l’esprit."
                                            },
                                            {
                                                "example_id": "3420d5dd-6956-454e-b19a-584bb0e7cd6f",
                                                "sense_id": "2290ab36-53e6-3ce4-996e-081af74e3f57",
                                                "text": "Nos lycéens séchaient les cours pour se retrouver dans des bouis-bouis où ils s’essayaient aux jurons employés par leurs parents, la langue brûlée par le café sucré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cecebe93-7166-3797-8404-33f43f125cee",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Ne pas venir à un endroit où l’on était attendu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b04c4c-fb76-4f14-b42d-57d35cf1d9e9",
                                                "sense_id": "cecebe93-7166-3797-8404-33f43f125cee",
                                                "text": "Le président américain, Donald Trump, prétextant un emploi du temps chargé pour sécher le sommet, y a finalement fait une apparition, mais sans prendre la parole."
                                            },
                                            {
                                                "example_id": "81759dfa-0388-482f-bc62-9821bd9cce19",
                                                "sense_id": "cecebe93-7166-3797-8404-33f43f125cee",
                                                "text": "Il sèche le déjeuner, car ce matin même, il a fixé un rendez-vous à quinze heures : un contrat, reçu la veille au soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b23f5b-d8bc-3b5e-a4bf-a276a8e2431c",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Procéder au séchage d’une solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd28f10-03c4-4da8-a154-66e7459b9768",
                                                "sense_id": "47b23f5b-d8bc-3b5e-a4bf-a276a8e2431c",
                                                "text": "Les desséchants rencontrés en chimie organique sont des sels anhydres. Ils doivent être inertes chimiquement et absorber l’eau rapidement et efficacement sans se dissoudre dans le milieu organique à sécher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a08ef8-14c5-3ed5-b84e-9bf79594472e",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Perdre du gras pour rendre les muscles plus apparents."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e94b266e-1e44-4825-84ae-fcfcab6cfc9c",
                                                "sense_id": "22a08ef8-14c5-3ed5-b84e-9bf79594472e",
                                                "text": "Le mercredi, vous pouvez ajouter une petite séance si vous voulez sécher et/ou améliorer votre sangle abdominale et/ou exercer le cou et les mollets."
                                            },
                                            {
                                                "example_id": "43a4dfef-e71b-44e1-998e-8f244dc3002d",
                                                "sense_id": "22a08ef8-14c5-3ed5-b84e-9bf79594472e",
                                                "text": "Il s’agit d’un régime souvent utilisé dans le cadre de la musculation pour « sécher », c’est-à-dire perdre de la masse grasse au profit de la masse maigre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9f444ca-c176-350f-8b19-8bf8613a6283",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Mettre une raclée."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5dd4e28-f371-4818-9d57-69f83755ab34",
                                                "sense_id": "f9f444ca-c176-350f-8b19-8bf8613a6283",
                                                "text": "Du tranchant de la main droite, il atteignit le Kurde à la base du nez, faisant suivre un direct appuyé au menton et termina en empoignant par les revers de son blouson pour le sécher d'un magistral coup de boule en pleine face."
                                            },
                                            {
                                                "example_id": "a6be6597-b449-4b36-b9f9-a0ccc00596a8",
                                                "sense_id": "f9f444ca-c176-350f-8b19-8bf8613a6283",
                                                "text": "Combien de fois, alors que j'avais le dessous, que mon adversaire me croyait calmé, me suis-je jeté sur ses jambes pour le mordre ou me suis-je relevé pour le « sécher » d'un coup bas qui ne pardonne pas chez les hommes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749b806e-e57a-3b8e-8b2f-0d0534b7f8a2",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Assommer ou accabler."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6393fc0-3fd2-48f7-9294-19404c0e060d",
                                                "sense_id": "749b806e-e57a-3b8e-8b2f-0d0534b7f8a2",
                                                "text": "Tout d'abord, sa visite m'avait complètement pris au dépourvu. La surprise m’avait séché en plein vol, tétanisé jusque dans mes facultés d'indignation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c182ab4-3ad4-3a1a-9499-e89eac2f438b",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Tuer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2e51221-b507-4f8b-b2c8-a6bf742cc072",
                                                "sense_id": "3c182ab4-3ad4-3a1a-9499-e89eac2f438b",
                                                "text": "L’oncle Jules m’annonça, avec une fierté joviale, qu’il l’avait « séché sur place » avec une charge de chevrotines dans la nuque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Devenir sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5707664-6005-411b-b14f-db0a79fce113",
                                                "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                                "text": "Le sable ne produit qu'un effet physique : il divise les particules de chaux et empêche la matière de prendre trop de retrait en séchant, ce qui entraînerait des fendillements."
                                            },
                                            {
                                                "example_id": "498049e4-4142-4f26-ac4a-16dad5ac5a5e",
                                                "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                                "text": "[…] ; on donne un coup de rouleau de gélatine pour obtenir une planéité parfaite, on laisse sécher et on collodionne avec un collodion à 3 % légèrement riciné […]."
                                            },
                                            {
                                                "example_id": "3fab5a4e-d001-4c3f-ae3c-a9c9daf2c474",
                                                "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                                "text": "Mon attention a été attirée par un pantalon de velours côtelé, assez usagé, et qui séchait sur un fil de fer à proximité de la porte de la cuisine, ou plus précisément en face de cette porte."
                                            },
                                            {
                                                "example_id": "f5d516cd-330a-46bd-a712-c7789caf0c97",
                                                "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                                "text": "Les pièces de bois, séparées les unes des autres par des taquets pour favoriser la circulation de l'air, séchaient tranquillement pendant un an ou deux. Yolaine Goulet,"
                                            },
                                            {
                                                "example_id": "8a3aec59-7812-4972-a697-1c849e02e2f6",
                                                "sense_id": "4bfa7b8b-b082-301b-bbf5-50eb2d83472e",
                                                "text": "Pour faire sécher le foin, l'herbe coupée est étendue puis retournée dans la journée avant d'être ramassée en andains le soir venu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a3197c-3d7f-39c9-9dbc-2bb82348dddf",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Ne pas disposer des connaissances ou de l’inspiration nécessaires pour effectuer un devoir écrit ou répondre à une interrogation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e4723f-3dde-4dc2-9871-8b67d5149398",
                                                "sense_id": "c5a3197c-3d7f-39c9-9dbc-2bb82348dddf",
                                                "text": "Elle séchait sur son devoir de grammaire. Elle disait qu’elle ne se souvenait plus de la règle des participes. Passés. Les présents ne s’accordent pas."
                                            },
                                            {
                                                "example_id": "30605af8-2538-41f9-86ee-212cb3bf0859",
                                                "sense_id": "c5a3197c-3d7f-39c9-9dbc-2bb82348dddf",
                                                "text": "Ce qui est singulier, c’est que je n’ai presque jamais envie d’écrire sur ce qui me tient le plus au cœur, à moins que cela ne soit transposé dans un roman ; autrement je « sèche » comme on dit au lycée, et la page reste blanche."
                                            },
                                            {
                                                "example_id": "e4ea57de-d85a-46e1-893b-0c27383de98c",
                                                "sense_id": "c5a3197c-3d7f-39c9-9dbc-2bb82348dddf",
                                                "text": "La seule notion de fraternité qui m’intéressait était celle à laquelle j’avais parfois recours lorsque je séchais sur un devoir. A ce moment, un grand frère ne m’aurait pas déplu."
                                            },
                                            {
                                                "example_id": "8f4cc37e-d244-4b0b-8538-30ef5750ece6",
                                                "sense_id": "c5a3197c-3d7f-39c9-9dbc-2bb82348dddf",
                                                "text": "Pendant sa campagne, il a séché devant des journalistes qui l’avaient piégé en lui demandant quel était le taux de chômage en Australie et le taux directeur de la banque centrale. \"C’est le genre de choses que les Premiers ministres doivent savoir\", s’était délecté Scott Morrison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc252bd-a0d6-3cf3-aee2-e9ed8a7045db",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Ne pas trouver à se marier, en parlant d’une fille."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e41c511e-61d2-4f89-8d1c-882f7910b9a9",
                                                "sense_id": "3bc252bd-a0d6-3cf3-aee2-e9ed8a7045db",
                                                "text": "Il me confia un jour qu'il me préférait alors à Mˡˡᵉ Henrion, cette vieille fille triste comme un bonnet de nuit et qui séchait sur pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf24d89-bcd6-369f-95aa-a084889f60d4",
                                        "entry_id": "1795fc30-ebf3-3b71-9461-0a0f29cced3c",
                                        "glosses": [
                                            "Se consumer d’ennui, de tristesse ou être en proie à une vive impatience."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7adfafc8-b76a-468a-90b9-b1b45bc6c39e",
                                                "sense_id": "0bf24d89-bcd6-369f-95aa-a084889f60d4",
                                                "text": "On a vu à Copenhague des Lapons regreter leurs montagnes de glace , & sécher de langueur & de chagrin , de ce qu'on leur refusoit la permission d'y retourner."
                                            },
                                            {
                                                "example_id": "58b951f5-332b-4e6c-ae07-7442c16e9303",
                                                "sense_id": "0bf24d89-bcd6-369f-95aa-a084889f60d4",
                                                "text": "Oh ! je sais, my love, pourquoi vous êtes venue à la gare. Votre femme de chambre vous a trahie. Elle m’a dit que vous attendiez une robe rose qui ne venait pas, et que vous en séchiez d’impatience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
