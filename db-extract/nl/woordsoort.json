                "senses": [
                    {
                        "sense_id": "94cf47d6-cbbc-3430-a412-0e1fcd3709d5",
                        "entry_id": "2bc21702-a412-327a-94c5-fd030d9690e7",
                        "glosses": [
                            "categorie waarin bepaalde woorden naar gelang het grammaticale gebruik in onderverdeeld worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3818881-f3be-4fc9-9b46-370a8ea7cdde",
                                "sense_id": "94cf47d6-cbbc-3430-a412-0e1fcd3709d5",
                                "text": "Deze woorden behoren tot dezelfde woordsoort."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6c1f2fd-7bff-4132-9ca3-570d166d470d",
                        "source_entry_id": "2bc21702-a412-327a-94c5-fd030d9690e7",
                        "source_sense_id": "94cf47d6-cbbc-3430-a412-0e1fcd3709d5",
                        "source_sense_description": "categorie waarin bepaalde woorden naar gelang het grammaticale gebruik in onderverdeeld worden",
                        "target_lang_word": "Wortart",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wortart",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                        "entry_id": "2ce92c85-dfc6-3d23-a6f3-2ca62b8f7f71",
                                        "glosses": [
                                            "Wortklasse; Menge von Wörtern, die danach bestimmt wird, ob beziehungsweise wie sie flektiert werden können, in welcher syntaktischen Umgebung sie verwendet werden können oder welche Art von Bedeutung sie tragen. Die Wortarten werden meistens durch eine Mischung dieser Kriterien bestimmt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44e4c77-2af2-4aa5-8f63-3514c3022841",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "Zu den Wortarten gehören die Präpositionen."
                                            },
                                            {
                                                "example_id": "ef507b96-1992-4d4b-aa82-42cdd9e49f41",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "Es gibt verschiedene Möglichkeiten, Wortarten zu definieren. Entsprechend unterscheiden sich Zahl und Art der Wortarten."
                                            },
                                            {
                                                "example_id": "ccad4246-4473-4f6d-bff0-2317b004f336",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "„Es gibt Wortarten, wie zum Beispiel die Funktionswörter, wie Präpositionen, Konjunktionen, die nicht durch deren beste Vertreter, sondern nur durch typische Distributionen beschrieben werden können.“"
                                            },
                                            {
                                                "example_id": "ee2de03f-bd37-4895-875d-8036909c9922",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "„Für die flektierenden Sprachen stellt die formale Ausrichtung der Wörter auf den Satz die Frage nach den Wortarten.“"
                                            },
                                            {
                                                "example_id": "23a5ecfe-f620-4e1f-8265-54c1fb705df7",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "„Schließlich geht es bei den Anglizismen auch darum, Aussagen über einzelne Wortarten zu machen.“"
                                            },
                                            {
                                                "example_id": "5523dd5e-226e-41b7-a487-8d9a632b35d0",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "„Die klassische Wortart ist deswegen interessant, weil man aus einer Zusammenstellung der Wortarten des Textes auf bestimmte Eigenschaften von ihm schließen kann.“"
                                            },
                                            {
                                                "example_id": "003e0de2-de50-4819-9f17-36adeb181c9e",
                                                "sense_id": "40815b3f-82c7-3cfd-894a-c221480279db",
                                                "text": "„Alle Wörter einer Wortart haben eine bestimmte Art der Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
