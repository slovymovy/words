                "senses": [
                    {
                        "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                        "entry_id": "66f5f7ae-ef87-38ec-a956-f8a1ae81932b",
                        "glosses": [
                            "Faire un bruit de tactactac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7c18c9-861e-40af-acaf-be13f5f7ff1f",
                                "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                                "text": "Le raccord en virage cela va aussi (chez moi...) mais cela tactactaque pas mal, la loco ayant bien sur tendance à pousser vers l'extérieur."
                            },
                            {
                                "example_id": "fc8e27fb-fe62-43fb-9b77-9f291adbf990",
                                "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                                "text": "Sinon je tactactaque avec mes ongles, ou je boude."
                            },
                            {
                                "example_id": "650620eb-c1dc-43b5-9d00-20a3d38fd68b",
                                "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                                "text": "Des péripéties servies par une écriture survoltée, imaginative avec réveils qui tictaquent et armes qui tactactaquent."
                            },
                            {
                                "example_id": "76de09e1-5eb0-4b8f-bb75-151d89e7df8e",
                                "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                                "text": "Au moment où tactactaquait une mitraillette, à l’intérieur même de la tente."
                            },
                            {
                                "example_id": "260e1feb-0525-412d-b5ff-b7a43bc43bd4",
                                "sense_id": "7e876916-9563-3889-929e-826d26486b5b",
                                "text": "NAN, moi c'est un bruit lancinant et aigu qui tactactaque sans fin dans ma cervelle jusqu'au réveil et me fais me ronger les ongles faute d’identifier exactement où niche la Woodywoodpecker qui s’immisce ainsi dans chacun de mes songes matinaux."
                            }
                        ]
                    }
