{
    "word_family": [
        "squirmy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b1fd960-6407-31ec-aeee-4ade27c7a540",
                    "sense_definition": "To twist one's body with snakelike motions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child began to <w>squirm</w> in his seat because he was bored.",
                            "target_lang_translations": {
                                "zh": "孩子因为无聊，开始在座位上<w>扭动</w>起来。"
                            }
                        },
                        {
                            "text": "The snake <w>squirm</w>ed through the tall grass to hide.",
                            "target_lang_translations": {
                                "zh": "蛇在长草丛中<w>蠕动</w>着躲藏起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wriggle"
                    ],
                    "common_phrases": [
                        "squirm away"
                    ],
                    "target_lang_definitions": {
                        "zh": "指身体像蛇一样扭动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "指身体或肢体不规则地摆动或扭转。"
                            },
                            {
                                "target_lang_word": "蠕动",
                                "target_lang_sense_clarification": "指像虫子一样缓慢地移动或扭动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c541ccb4-8c25-34e4-8741-12914c070537",
                    "sense_definition": "To twist in discomfort, especially from shame or embarrassment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discomfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult questions made the politician <w>squirm</w> during the interview.",
                            "target_lang_translations": {
                                "zh": "那些棘手的问题让政客在采访中感到<w>局促不安</w>。"
                            }
                        },
                        {
                            "text": "I watched him <w>squirm</w> when his secret was finally revealed.",
                            "target_lang_translations": {
                                "zh": "当他的秘密最终被揭露时，我看着他<w>坐立难安</w>的样子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fidget"
                    ],
                    "target_lang_definitions": {
                        "zh": "因羞愧或尴尬而感到局促不安，身体扭动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "局促不安",
                                "target_lang_sense_clarification": "形容因尴尬或紧张而表现出的不安状态。"
                            },
                            {
                                "target_lang_word": "坐立难安",
                                "target_lang_sense_clarification": "形容因心烦或尴尬而无法安稳坐着。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5323b2b-ab64-3da1-be1a-6998a1b6e7ba",
                    "sense_definition": "To evade a question or an interviewer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discomfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>squirm</w> out of answering the direct question about his finances.",
                            "target_lang_translations": {
                                "zh": "他试图<w>推诿</w>，不正面回答关于他财务状况的直接提问。"
                            }
                        },
                        {
                            "text": "The witness began to <w>squirm</w> under the intense pressure of the cross-examination.",
                            "target_lang_translations": {
                                "zh": "在交叉盘问的巨大压力下，证人开始<w>闪烁其词</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "squirm out"
                    ],
                    "target_lang_definitions": {
                        "zh": "指试图逃避回答问题或推卸责任。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推诿",
                                "target_lang_sense_clarification": "指推卸责任或找借口逃避。"
                            },
                            {
                                "target_lang_word": "闪烁其词",
                                "target_lang_sense_clarification": "指说话躲躲闪闪，不正面回答问题。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4688e16f-39c9-34d9-bf74-ec238296a55c",
                    "sense_definition": "A twisting, snakelike movement of the body.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>squirm</w>, the cat escaped from my arms.",
                            "target_lang_translations": {
                                "zh": "猫快速地<w>扭动</w>了一下，从我怀里逃脱了。"
                            }
                        },
                        {
                            "text": "The worm made a sudden <w>squirm</w> before disappearing into the soil.",
                            "target_lang_translations": {
                                "zh": "虫子突然<w>扭动</w>了一下，随后钻进土里不见了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种像蛇一样的扭动动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "指身体或物体扭转的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}