                "translations": [
                    {
                        "translation_id": "b689d6cf-d45f-441d-9807-88c5271308e2",
                        "source_entry_id": "34c9265e-792e-3a85-a1d8-64f39ba9ffce",
                        "source_sense_id": "02c5bac4-3b91-3a16-bb09-0f78efaef38a",
                        "target_lang_word": "quick-dissolving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b2ff8bb0-c637-4054-b9bf-fbca5b19cae2",
                        "source_entry_id": "34c9265e-792e-3a85-a1d8-64f39ba9ffce",
                        "source_sense_id": "02c5bac4-3b91-3a16-bb09-0f78efaef38a",
                        "target_lang_word": "soluble",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soluble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                        "entry_id": "b4606955-5a84-3519-9627-1d5be022d59f",
                                        "glosses": [
                                            "Qui peut être solubilisé ou dissous ; dissoluble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e81f26a-41c9-4e06-b0de-e266835f8cec",
                                                "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                                "text": "L’acide palmitique forme des cristaux blancs en forme de paillettes, très ténus, insolubles dans l'eau, solubles dans l'alcool et l'éther."
                                            },
                                            {
                                                "example_id": "dbe4527e-fb58-4db2-9125-9d7cc90f5b71",
                                                "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                                "text": "Les chlorhydrates et bromhydrates de quinine sont beaucoup plus solubles."
                                            },
                                            {
                                                "example_id": "f48d473b-173b-4492-8b01-1e3ec4fa6205",
                                                "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                                "text": "On a constaté que la cellulose sous forme de papier-filtre est soluble dans les solutions aqueuses concentrées de certains sels, tel que ceux d'antimoine, chlorure d'étain, bromure de zinc."
                                            },
                                            {
                                                "example_id": "b02b8400-aebc-43a9-bc1b-8acbd502b462",
                                                "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                                "text": "La morphine-base, insoluble dans l'eau froide, est ainsi transformée en son sel, le morphinate de calcium, parfaitement soluble."
                                            },
                                            {
                                                "example_id": "50ee9875-bf00-49cf-944a-eb1e102867d6",
                                                "sense_id": "d7febbff-5de6-3791-a8e6-99f47cba7982",
                                                "text": "A titre d'exemple, la réaction simplifiée (3) résume la transformation de phosphate tricalcique insoluble en phosphate monocalcique nettement plus soluble sous l'effet d'un acide carboxylique : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8266728-4cca-35b0-bf73-f2006597c31e",
                                        "entry_id": "b4606955-5a84-3519-9627-1d5be022d59f",
                                        "glosses": [
                                            "Qui peut être résolu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b56668d-08dc-4f80-8097-47881e3e941a",
                                                "sense_id": "d8266728-4cca-35b0-bf73-f2006597c31e",
                                                "text": "Le logarithme discret est considéré comme un problème difficile, soluble en un temps qui varie exponentiellement avec la taille du problème (c’est-à-dire la taille des nombres impliqués)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soluble",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff9efa8-cc70-32ed-917d-d83728018d0b",
                                        "entry_id": "c01b81ca-c698-33ce-8456-0c424dca8209",
                                        "glosses": [
                                            "Fraction d'un matériau qui peut être solubilisé ou dissout."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bf1b73-3681-400e-8dc7-fe2a856bb8f4",
                                                "sense_id": "8ff9efa8-cc70-32ed-917d-d83728018d0b",
                                                "text": "Un anneau composé de soluble dans la pyridine pour 64 % en poids, de silice (sable, diatomées, foraminifères) pour 18 % et de sulfate de calcium pour 12 %, et datant de 3500 avant J.C. a été découvert à Ur en Irak du Sud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d87f8fcf-23b0-46be-903b-fe2ce85b7866",
                        "source_entry_id": "34c9265e-792e-3a85-a1d8-64f39ba9ffce",
                        "source_sense_id": "02c5bac4-3b91-3a16-bb09-0f78efaef38a",
                        "target_lang_word": "instantané",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantané",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                        "entry_id": "65af2f2c-8a2d-325e-a8a5-1582340a2096",
                                        "glosses": [
                                            "Qui ne dure qu’un instant, qui se produit soudainement, en un instant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b670850-d5b7-457c-a2ff-4dd61aa4f64b",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Ce mouvement n’a été qu’instantané."
                                            },
                                            {
                                                "example_id": "cdbcc462-0c5e-425d-8d12-5ea066b1e342",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Une frayeur instantanée."
                                            },
                                            {
                                                "example_id": "3fcce8a1-6625-407b-90e8-eb3f9d231c33",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Une photographie instantanée"
                                            },
                                            {
                                                "example_id": "ef188dc0-df2a-4e32-9e46-a11f0f138d81",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "– La mort a dû être instantanée, déclara le docteur… un coup de couteau a suffi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d71b011-7a4f-30e6-b6e9-f90ba31e86dc",
                                        "entry_id": "65af2f2c-8a2d-325e-a8a5-1582340a2096",
                                        "glosses": [
                                            "Qui caractérise l’état à l’instant, par opposition à une valeur moyenne, une valeur efficace, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d202aa-8a18-4d31-9fc4-9c294208a901",
                                                "sense_id": "7d71b011-7a4f-30e6-b6e9-f90ba31e86dc",
                                                "text": "La puissance instantanée, la valeur instantanée, une dérivée instantanée, la vitesse instantanée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instantané",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Photographie obtenue par une très courte exposition."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2fb28-32e2-4817-bf40-5c8d529ae0ca",
                                                "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                                "text": "L’instantané est plus vivant, mais moins exact que la pose."
                                            },
                                            {
                                                "example_id": "c45724e7-6ff4-46c2-977c-c63ccea0aa2d",
                                                "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                                "text": "Prendre un instantané, des instantanés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Image capturée d’une action, d’un évènement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820cbd0b-e244-4ca4-9355-539c4f7f9ce3",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Il y a vous-même, voyez : cet instantané qu’on vous prit à Monte-Carlo, où vous êtes si parfaitement ridicule et si correctement élégant !"
                                            },
                                            {
                                                "example_id": "adc2d5e3-8e79-40cb-b9f3-cee5baad71c1",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Froberval passa la photographie. Beautrelet eut un geste de surprise. Il venait, sur l’instantané, de se reconnaître, debout, les deux mains dans ses poches, avec, autour de lui, une pelouse où se dressaient des arbres et des ruines."
                                            },
                                            {
                                                "example_id": "240bbea0-be8c-4c48-ba8a-331e6b9f7e05",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Michel empila aussi dans la cassette les photographies de sa femme, tant vivante que morte, et les instantanés pris au cours de leurs voyages."
                                            },
                                            {
                                                "example_id": "24d71051-b982-4d9d-8e36-9a6a84fdaabb",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "À la différence du portrait, l’instantané saisit le moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1a028b-4084-38d2-8811-99f6104e3e6e",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Appareil qui sert à faire des photographies instantanées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd4a06e4-3407-3759-91de-419547a0a834",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "État d'un système sauvegardé à un instant donné."
                                        ],
