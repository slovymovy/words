                    {
                        "sense_id": "9457b0d6-6385-34b2-874f-13fed16012f0",
                        "entry_id": "8350c92e-4c65-3592-ab9b-8e798af2df33",
                        "glosses": [
                            "motyw zdobniczy stosowany w architekturze, sztuce, rzemiośle artystycznym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbda6aa9-75eb-496d-bd1e-534f91e49153",
                                "sense_id": "9457b0d6-6385-34b2-874f-13fed16012f0",
                                "text": "Ornament roślinny nie zjawia się tedy sam przez się z prostego wyboru lub natchnienia artysty, lecz jest wynikiem olbrzymiej społecznej przemiany"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9d40aa65-3b42-3553-8321-9ec5f7d3307d",
                        "entry_id": "8350c92e-4c65-3592-ab9b-8e798af2df33",
                        "glosses": [
                            "dźwięk lub grupa dźwięków służących do urozmaicenia i ożywienia melodii"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "2aae23e0-8681-3fc3-82f1-cc019a564691",
                        "entry_id": "8350c92e-4c65-3592-ab9b-8e798af2df33",
                        "glosses": [
