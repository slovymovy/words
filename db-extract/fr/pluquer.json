                "senses": [
                    {
                        "sense_id": "0f92c828-13a3-3df0-8f0c-3713f5f34e12",
                        "entry_id": "a088eaf2-1260-3d3e-a6b4-857b74391162",
                        "glosses": [
                            "Grignoter, picorer, prendre des petits morceaux."
                        ],
                        "tags": [
                            "Nord de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "eedbbad5-25b2-4d90-8924-937ac8982294",
                                "sense_id": "0f92c828-13a3-3df0-8f0c-3713f5f34e12",
                                "text": "Ma grand-mère la regarda chipoter dans son assiette sans faire de commentaire, mais je devinais ce qu’elle pensait : ce n’était pas en pluquant de cette façon que la femme de Georges aurait suffisamment de forces pour supporter le travail de la ferme."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8f98c31-c8d3-3932-9c62-ad36e708f35f",
                        "entry_id": "a088eaf2-1260-3d3e-a6b4-857b74391162",
                        "glosses": [
                            "Prélever un aliment en petite quantité, le plus souvent dans une assiette autre que la sienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935ec4e0-e68a-4048-a624-1a3ab7507598",
                                "sense_id": "d8f98c31-c8d3-3932-9c62-ad36e708f35f",
                                "text": "Il avait pris l’habitude de pluquer des frites dans l’assiette de son petit frère."
                            }
                        ]
                    }
                ],
