                "senses": [
                    {
                        "sense_id": "fd17acf3-d2b8-39b0-a124-d50bfd94b12d",
                        "entry_id": "75819313-329d-3cb0-ba2a-48a966d3de2c",
                        "glosses": [
                            "heroic death; a hero's death"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ea3fdfd8-62f7-49bd-ab08-ec0dadac526b",
                                "sense_id": "fd17acf3-d2b8-39b0-a124-d50bfd94b12d",
                                "text": "Instinktiv flüchtete er in das Wort hinein: „Sie sterben den Heldentod, auf dem Felde der Ehre.“ „Ja, Feld der Ehre! Ihr habt meinen Mann erschlagen. Mein Mann ist tot. Tot!“",
                                "translation": "Instinctively he took refuge in the words: “They will die a heroic death in the field of honor.” “Yes, field of honor! You killed my husband. My husband is dead. Dead!”",
                                "english": "Instinctively he took refuge in the words: “They will die a heroic death in the field of honor.” “Yes, field of honor! You killed my husband. My husband is dead. Dead!”"
                            }
                        ]
                    }
