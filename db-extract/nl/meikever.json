                ],
                "translations": [
                    {
                        "translation_id": "46027ac5-4a5b-4da8-929e-a0cb85abb9b5",
                        "source_entry_id": "dd236890-6905-30d9-8a9e-af7c68be9859",
                        "source_sense_id": "699d2d24-a9bc-3442-a26f-ea87ecffbf90",
                        "source_sense_description": "Melolontha melolontha, schildvleugelig insect dat in mei te voorschijn komt",
                        "target_lang_word": "Maikäfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maikäfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f57881e7-cd92-38e2-af84-84e638aa3b17",
                                        "entry_id": "a0197983-42d2-3bfd-8ef2-c71584c28ba1",
                                        "glosses": [
                                            "die Insektengattung Melolontha aus der Familie der Blatthornkäfer"
                                        ],
                                        "tags": [
                                            "Entomologische Taxonomie",
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2f9ffbd-e06f-4b30-87e5-7adfafee6616",
                                                "sense_id": "f57881e7-cd92-38e2-af84-84e638aa3b17",
                                                "text": "Maikäfer werden bis zu 23 mm groß."
                                            },
                                            {
                                                "example_id": "d0074d91-5161-4cd4-8814-3e377ebd454b",
                                                "sense_id": "f57881e7-cd92-38e2-af84-84e638aa3b17",
                                                "text": "„Maikäfer haben eine Zykluszeit von drei bis fünf, meist vier Jahren. Das heißt, die frischgeschlüpften Engerlinge benötigen vier Jahre, bis sie eine vollständige Metamorphose zum geschlechtsreifen Tier durchgemacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                        "entry_id": "a0197983-42d2-3bfd-8ef2-c71584c28ba1",
                                        "glosses": [
                                            "ein Vertreter von [1]; brauner, blattfressender Käfer, dessen Larven (die Engerlinge) sich von Wurzeln ernähren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1719b07a-0a13-437c-98ce-c8e3b900bdfd",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "„Nach Beendigung der Metamorphose gräbt sich der Maikäfer, seinem Namen entsprechend, in den Monaten April und Mai aus dem Erdboden, fliegt hauptsächlich im Mai und Juni und ernährt sich überwiegend von den Blättern von Laubbäumen.“"
                                            },
                                            {
                                                "example_id": "f480433e-4f23-49d1-b7eb-e9fd1a6f2383",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "Die Fühler des Maikäfers zitterten, er witterte schon von Ferne Nahrung oder einen Geschlechtspartner."
                                            },
                                            {
                                                "example_id": "95ed3b76-371c-4d59-8d54-7443eba4f9a2",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "„Jeder weiß, was so ein Mai-",
                                                "translation": "Käfer für ein Vogel sei.“"
                                            },
                                            {
                                                "example_id": "52c9b95a-2522-4a07-802f-91f6bcf1da75",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "Maikäfer flieg, / Dein Vater ist im Krieg - (Volkslied)"
                                            },
                                            {
                                                "example_id": "2d9d146c-3d90-4498-b871-c8b230edd6db",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "„Reinhard Mey beschreibt in dem bekannten Lied ‚Es gibt keine Maikäfer mehr‘ (Album: Wie vor Jahr und Tag, 1974) die Folgen der massiven Bekämpfung der Maikäfer mit dem inzwischen verbotenen Insektizid DDT zwischen Anfang der 1950er Jahre und etwa 1972.“"
                                            },
                                            {
                                                "example_id": "4a4ab8ab-91ba-4a4b-80c3-76a8ea6dc49f",
                                                "sense_id": "77c8598e-3958-33ec-8d5e-81cb5745754e",
                                                "text": "„Weihrauch quillt in die Dämmerung, die Monstranz funkelt, und nach der Andacht treiben sich die jungen Leute noch einige Zeit umher auf den Plätzen mit den Bäumen, wo die Maikäfer summen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3356f297-8b97-448e-a079-ec2d7a44431e",
                        "source_entry_id": "dd236890-6905-30d9-8a9e-af7c68be9859",
                        "source_sense_id": "699d2d24-a9bc-3442-a26f-ea87ecffbf90",
                        "source_sense_description": "Melolontha melolontha, schildvleugelig insect dat in mei te voorschijn komt",
                        "target_lang_word": "cockchafer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cockchafer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                        "entry_id": "96c6fdc6-35c1-3252-95b2-0cd29676a9f8",
                                        "glosses": [
                                            "Any of the large European beetles from the genus Melolontha that are destructive to vegetation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6798926-f36b-49b9-b320-d633e8f08bbf",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "To the person who shall discover to the Society an effectual method, verified by repeated and satisfactory trials, of destroying the Grub of the Cockchafer, so destructive to the roots of all sorts of Corn, Pease, Beans, and Turneps, the gold medal."
                                            },
                                            {
                                                "example_id": "b101c15f-759b-4d0e-a66c-2e6776d7aee4",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "His impassioned words buzzed about my ears like cockchafers round the top of the lime-trees."
                                            },
                                            {
                                                "example_id": "a7aa9df4-82bc-43d8-b196-dde73b1f9003",
                                                "sense_id": "4855f3e3-95b4-3699-8933-50d7cfdc81aa",
                                                "text": "With regard to the playing of the female part by the weaker rats it is interesting to observe that Féré found among insects that the passive part in homosexual relations is favored by fatigue; among cockchafers it was the male just separated from the female who would take the passive part (on the rare occasions when homosexual relations occurred) with a fresh male."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "292e3506-1555-32c5-8686-7fb5702f014f",
                                        "entry_id": "96c6fdc6-35c1-3252-95b2-0cd29676a9f8",
                                        "glosses": [
                                            "Any of various other similar beetles, such as of the genera Acrossidius, Cyphochilus, Rhopaea, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "597e0661-2176-425a-b2ee-b51f3bea4ef5",
                        "source_entry_id": "dd236890-6905-30d9-8a9e-af7c68be9859",
                        "source_sense_id": "699d2d24-a9bc-3442-a26f-ea87ecffbf90",
                        "source_sense_description": "Melolontha melolontha, schildvleugelig insect dat in mei te voorschijn komt",
                        "target_lang_word": "hanneton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hanneton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                        "entry_id": "d985c050-5d1f-3381-9719-6eee42de2dc6",
                                        "glosses": [
                                            "Insecte coléoptère (Melolontha melolontha) d’un rouge brun, qui a des antennes courtes, frangées à leur extrémité, et qui paraît au printemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4cea9e-b928-4628-9536-d375c9b28800",
                                                "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                                "text": "Dans cette voie et au moyen de primes en argent payées aux ramasseurs, MM. Lalouette, de Barbery (Oise), Reisel, à Écorchebœuf (Seine-Inférieure), et l’administration préfectorale du département de la Somme, paraissent avoir obtenu de bons résultats, mais si l’on peut donner le conseil d’imiter ces bons exemples, il est absolument impossible d’aller jusqu’à la contrainte, car le hanneton est volage et le propriétaire qui aura consciencieusement déhannetonné son jardin ou son champ, n’en sera pas moins exposé à recevoir les hannetons du voisin."
                                            },
                                            {
                                                "example_id": "7992a8bf-c590-4457-b02b-c8ef1b01639e",
                                                "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                                "text": "Des hannetons aussi volaient en tous sens, avec de gros bourdonnements sourds ; parfois l’un d’eux choquait le zinc des gouttières avec un bruit mat, et tombait sur le sol, comme une balle."
                                            },
                                            {
                                                "example_id": "82b11f5d-62aa-4e41-8c9e-91bf8843098b",
                                                "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                                "text": "Oui, imitant la pharmacopée homéopathique qui se sert encore de substances infâmes, de jus de cloporte, de venin de serpent, de suc de hanneton, de sécrétion de putois et de pus de variole, le tout enrobé dans du sucre de lait pour en céler la saveur et l’aspect, le monde des lettres triture, lui aussi, dans le but de les faire absorber sans hauts de cœur, les plus dégoûtantes des matières."
                                            },
                                            {
                                                "example_id": "b128db27-8e46-4141-b47c-9e201997bba2",
                                                "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                                "text": "Il est vrai que les hannetons et les chauves-souris, par exemple, ont une façon de voler qui nous semble déraisonnable ; mais elle ne le semble ainsi qu’à nous autres dont ce n’est pas la fonction de voler."
                                            },
                                            {
                                                "example_id": "aa9e944a-14af-44fd-a3b3-37e5448f21f6",
                                                "sense_id": "54eed7e1-24cc-3021-a07b-d2e6db78831f",
                                                "text": "La situation des fils d’instituteurs n’est guère enviable. Non seulement il faut être en classe l’élève modèle qui reçoit seul des coups de règle sur les doigts, à titre d’exemple, mais il faut faire à la maison des devoirs supplémentaires, citer à n’importe quel moment du repas la date de la bataille d’Azincourt ou dire à la première personne rencontrée pendant la promenade du dimanche si les pattes du hanneton se rattachent au thorax ou bien à l’abdomen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9fe5e2-5591-3bf8-ae1b-ac68b2d29eb2",
                                        "entry_id": "d985c050-5d1f-3381-9719-6eee42de2dc6",
                                        "glosses": [
                                            "Personne étourdie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89be4a8e-8a43-4011-935f-bdb22ceb37e5",
                                                "sense_id": "9f9fe5e2-5591-3bf8-ae1b-ac68b2d29eb2",
                                                "text": "Il est étourdi comme un hanneton."
                                            },
                                            {
                                                "example_id": "422e1664-79a5-4200-8e4a-b51b5e741c16",
                                                "sense_id": "9f9fe5e2-5591-3bf8-ae1b-ac68b2d29eb2",
                                                "text": "C’est un hanneton le pauvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
