                                "sense_id": "2b6ff55a-5b1b-3b21-abd0-0e7c2841b4d3",
                                "text": "Hij bestudeert de geschiedenis van de kruisvaarders.",
                                "translation": "He studies the history of the crusaders.",
                                "english": "He studies the history of the crusaders."
                            },
                            {
                                "example_id": "c8fbd3e4-022d-4815-9939-8d6bb4e9a1b6",
                                "sense_id": "2b6ff55a-5b1b-3b21-abd0-0e7c2841b4d3",
                                "text": "De kruisvaarders hadden een sterk geloof dat hen dreef.",
                                "translation": "The crusaders had a strong faith that drove them.",
                                "english": "The crusaders had a strong faith that drove them."
