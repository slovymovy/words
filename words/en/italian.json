                    "sense_id": "d3ff1c49-420d-30be-9868-f5481906ba33",
                    "sense_definition": "Relating to Italy, its people, culture, or language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went to a nice <w>Italian</w> restaurant for dinner.",
