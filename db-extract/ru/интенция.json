                    },
                    {
                        "translation_id": "8561e9f8-1a82-4e96-afee-73ca9fe6f315",
                        "source_entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "target_lang_word": "intencja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intencja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb5950d-8825-32d5-a13a-6d80c88d4cbb",
                                        "entry_id": "77857604-8faa-3d79-8dfe-92cbf19d3c88",
                                        "glosses": [
                                            "chęć, zamiar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65410e72-658b-4bd3-80ca-d893a5fc89bb",
                                                "sense_id": "8cb5950d-8825-32d5-a13a-6d80c88d4cbb",
                                                "text": "Dlatego, że jest osobą odważną, zawsze pozwala sobie na ujawnianie swoich intencji."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c41574c-6c5a-4cc0-b45e-d0f564ab22ef",
                        "source_entry_id": "ce063b8f-f50d-3cae-a6c2-9a064208e671",
                        "target_lang_word": "intention",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intention",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3aff870-8c3e-31d1-a2f0-f51521f2befe",
                                        "entry_id": "5be340e9-20b7-3684-801e-a16da400b254",
                                        "glosses": [
                                            "Mouvement de l’âme par lequel on tend à quelque fin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a73e835-54b8-4642-b7cf-3e6277e487c0",
                                                "sense_id": "b3aff870-8c3e-31d1-a2f0-f51521f2befe",
                                                "text": "Il truffait ses sermons de paraboles modernes, d'images progressistes, magnifiés par sa verve naturelle et mordante et appuyés par un langage coloré qui choquèrent plus d'une grenouille de bénitier et d'une punaise de sacristie, mais que voulez-vous, il faut s'adapter ou périr, et le père Benoît La Poudrière n'avait aucune intention de baisser les bras face aux temps modernes."
                                            },
                                            {
                                                "example_id": "50f5f0b5-bd10-48b7-bc03-2c302d5fe91b",
                                                "sense_id": "b3aff870-8c3e-31d1-a2f0-f51521f2befe",
                                                "text": "Une intention louable. — Avoir l’intention de faire quelque chose. — Mon intention n’était pas de vous déplaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f3634e2-d17c-30cb-82ea-0f3f6ea7b4fe",
                                        "entry_id": "5be340e9-20b7-3684-801e-a16da400b254",
                                        "glosses": [
                                            "Volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57a87541-56a2-4e51-a5d7-e00b997bfb6f",
                                                "sense_id": "8f3634e2-d17c-30cb-82ea-0f3f6ea7b4fe",
                                                "text": "Quoi que nous fassions, il nous faudra en tout cas bien prendre garde de ne point agir à rebours de nos intentions."
                                            },
                                            {
                                                "example_id": "f4c4a56c-5212-4927-aa18-8c65733d722c",
                                                "sense_id": "8f3634e2-d17c-30cb-82ea-0f3f6ea7b4fe",
                                                "text": "C’est ainsi que, le 21 adar 4996 (1236), un pêcheur chrétien étant mort des coups que lui avait portés un juif au cours d’une rixe, la foule envahit la juiverie vicomtale, avec l’intention de la mettre à sac."
                                            },
                                            {
                                                "example_id": "0f2adbfb-0085-4dd3-bec3-ffcb99828df1",
                                                "sense_id": "8f3634e2-d17c-30cb-82ea-0f3f6ea7b4fe",
                                                "text": "Mine de rien, il lui annonça son intention d'aller faire un tour à la « butte aux maringouins», comme disait Julie, pour voir de ses yeux comment leur mère s'adaptait à la vie champêtre, elle qui était partie à reculons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5aadee-90ca-359d-883c-b2ae83b5b15f",
                                        "entry_id": "5be340e9-20b7-3684-801e-a16da400b254",
                                        "glosses": [
                                            "But ; destination ; dessein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2511643-4576-4831-b90b-527123cb65e1",
                                                "sense_id": "0c5aadee-90ca-359d-883c-b2ae83b5b15f",
                                                "text": "D’après la NHK, il aurait confié aux enquêteurs qu’il était « frustré » vis-à-vis de Shinzo Abe et qu’il lui a tiré dessus avec l’intention de le tuer."
                                            },
                                            {
                                                "example_id": "e7a362b0-cb28-4648-a890-eee526e9c50c",
                                                "sense_id": "0c5aadee-90ca-359d-883c-b2ae83b5b15f",
                                                "text": "Les autres convives européens ou asiatiques sont installés passim, avec l’évidente intention de faire honneur à ce repas."
                                            },
                                            {
                                                "example_id": "b9fcfa84-f6f9-4878-9fc9-b647bd940652",
                                                "sense_id": "0c5aadee-90ca-359d-883c-b2ae83b5b15f",
                                                "text": "Les slavistes les plus autorisés ont immédiatement flairé les intentions secrètes du traducteur magyar."
                                            },
                                            {
                                                "example_id": "eabd10dc-a467-4a5e-812f-a0c73df28bc9",
                                                "sense_id": "0c5aadee-90ca-359d-883c-b2ae83b5b15f",
                                                "text": "Pourtant, d’autres chasseurs hantent ces rivages, avec des intentions moins ludiques : des liches amies, des sérioles ambrées, des tassergals aux dents pointues errent dans la frange côtière, à la poursuite des mulets et orphies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f399a0b6-9654-3141-8aaa-307e9e84c55f",
                                        "entry_id": "5be340e9-20b7-3684-801e-a16da400b254",
                                        "glosses": [
                                            "Prière catholique dans un but particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85425b95-5346-43d5-80c8-791fa163b11e",
                                                "sense_id": "f399a0b6-9654-3141-8aaa-307e9e84c55f",
                                                "text": "...Offenserais-je le Très-Haut si à la messe dimanche prochain, j’ai pour mes paroissiens une intention particulière ?"
                                            },
                                            {
                                                "example_id": "2ab75f1a-7859-47d7-8493-3567477d3e06",
                                                "sense_id": "f399a0b6-9654-3141-8aaa-307e9e84c55f",
                                                "text": "La question de savoir si une infraction a été commise dans une intention frauduleuse ou à dessein de nuire gît donc en fait et est dès lors laissée à l'appréciation souveraine du juge du fond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
