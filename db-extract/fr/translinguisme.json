                    },
                    {
                        "translation_id": "9e458ba1-8878-43a2-bf63-90fe3de33b1b",
                        "source_entry_id": "dcf56a25-b605-3a75-a09f-950e3b796477",
                        "source_sense_id": "25bbce0e-8728-3545-8208-fc42b2fd9d96",
                        "target_lang_word": "translingualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "translingualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b32bbb73-d9d4-3d58-b5ce-0788af45d934",
                                        "entry_id": "fc319c6e-3676-3745-9f07-bad6cb624b00",
                                        "glosses": [
                                            "The phenomenon of translingually relevant aspects of language."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bb0754e-150b-44da-b0bb-f563cba4ba9c",
                                                "sense_id": "b32bbb73-d9d4-3d58-b5ce-0788af45d934",
                                                "text": "Essentially, translingualism questions the idea that only one type of English is acceptable in academic writing."
                                            },
                                            {
                                                "example_id": "b811ea72-339a-4748-972d-5a484f4b8f8b",
                                                "sense_id": "b32bbb73-d9d4-3d58-b5ce-0788af45d934",
                                                "text": "The idea of translingualism, as it is often called in composition studies or translanguaging as it is often called in linguistics, rejects the monolingual norm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22934ab6-c608-30ef-b359-b00d511f7098",
                                        "entry_id": "fc319c6e-3676-3745-9f07-bad6cb624b00",
                                        "glosses": [
                                            "A specific phenomenon of translingually relevant aspects of language, such as a term or symbol used in more than one language."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f16815e6-b080-4c26-9143-6bb55ad7482d",
                                                "sense_id": "22934ab6-c608-30ef-b359-b00d511f7098",
                                                "text": "This third approach can be illustrated by one of the most frequently-observed of Okara's translingualisms, the transposition into English of Ijo word-order."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
