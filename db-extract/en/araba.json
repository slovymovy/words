                                        "entry_id": "7163e426-f2eb-3c7a-94e5-cfb7f24046f8",
                                        "glosses": [
                                            ": высокая двухколёсная повозка"
                                        ],
                                        "tags": [
                                            "в Средней Азии, на Кавказе и в астраханском регионе"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af18c7f-2aa9-471e-a9ca-9a7d69c8f651",
                                                "sense_id": "bbfea15a-f4ff-3bc8-8f64-268d5322bfc5",
                                                "text": "Стада теснились и шумели, // Арбы́ тяжёлые скрыпели .."
                                            },
                                            {
                                                "example_id": "cd3df3cb-1b91-477d-bdd4-541b3bbd0afd",
                                                "sense_id": "bbfea15a-f4ff-3bc8-8f64-268d5322bfc5",
                                                "text": "Эта дорога удобна для колёсной езды, по крайней мере, на азиатских двухколёсных арбах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af76f739-28df-3022-bcab-b35c5bbb3885",
                                        "entry_id": "7163e426-f2eb-3c7a-94e5-cfb7f24046f8",
                                        "glosses": [
                                            "истор. : длинная четырёхколёсная повозка"
                                        ],
                                        "tags": [
                                            "в южных районах России и Украины"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b79920f-7334-4b71-a578-20f3cf9181b9",
                                                "sense_id": "af76f739-28df-3022-bcab-b35c5bbb3885",
                                                "text": "По пыльной дороге, ведущей к садам, тянулись скрипучие арбы, верхом наложенные чёрным виноградом."
                                            },
                                            {
                                                "example_id": "b2f93018-376f-406f-a1c1-71eab90e1ca7",
                                                "sense_id": "af76f739-28df-3022-bcab-b35c5bbb3885",
                                                "text": "Около высоких свежих скирд копошились бабы с граблями и двигались арбы .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
