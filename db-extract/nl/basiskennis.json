                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd90338-51c9-3c04-a339-bb6d65e2b9dd",
                                        "entry_id": "0a7e4ca0-3497-35af-bb0d-833f8689a49b",
