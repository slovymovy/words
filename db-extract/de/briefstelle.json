                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36473df4-fdda-4ecc-9ee9-fae2789c5764",
                                "sense_id": "d7918435-7602-381a-8f8c-e50a6698decb",
                                "text": "„Diese Briefstelle, wie so manches Theoretische, was Busch seinen Korrespondenten als gelegentliche Geistesblitze zukommen ließ, ist gar zu pauschal vereinfacht.“"
                            },
                            {
                                "example_id": "4034f2e2-9c33-4f19-b949-18faeabf34e1",
                                "sense_id": "d7918435-7602-381a-8f8c-e50a6698decb",
                                "text": "„Aus den Briefstellen können wir kein Gesamtbild extrapolieren, doch eines kann man vielleicht sagen: Goethes Bedeutung stand für ihn immer außer Frage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
