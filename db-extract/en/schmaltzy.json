                                        "entry_id": "d094beb9-9e7c-3e78-b31c-e124265b528c",
                                        "glosses": [
                                            "Œuvre littéraire, musicale ou cinématographique au caractère sentimental marqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d256642-744b-4c22-bb7f-edf0266f9c12",
                                                "sense_id": "6cd5a4b1-33c4-3cba-9dbc-f46e2de683cc",
                                                "text": "Son projet suivant était pour Darryl Zanuck à la Fox, La vie commence à huit heures trente, un tire-larmes hollywoodien avec John Barrymore dans le rôle principal, qui devait jouer un père Noël alcoolique affligé d'une fille handicapée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tire-larmes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4051b222-59e0-3128-bb2a-a1401dfefb95",
                                        "entry_id": "4b69e8e1-fe50-3c4d-aa7e-8c5f94082f97",
                                        "glosses": [
                                            "Qui cherche à susciter l'émotion, généralement de manière appuyée et insincère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783c5c63-afd9-4673-8aab-fa27083a851c",
                                                "sense_id": "4051b222-59e0-3128-bb2a-a1401dfefb95",
                                                "text": "Autre curiosité : son interview tire-larmes dans le « JDD » sur son enfance à Évreux dans 15 m² (« La fenêtre donnait sur la maison d’arrêt, on s’habillait au Secours populaire… ») a été amplement relayée par la presse pipole, notamment « Closer »."
                                            }
                                        ]
                                    }
                                ]
                            }
