                    "sense_definition": "iemand die onderwijs volgt aan een school of bij een meester",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "onderwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De meester gaf de <w>leerlingen</w> een moeilijk proefwerk voor geschiedenis.",
                            "target_lang_translations": {
                                "en": "The teacher gave the <w>pupils</w> a difficult history test.",
                                "ru": "Учитель дал <w>ученикам</w> трудную контрольную работу по истории."
                            }
                        },
                        {
                            "text": "Elke <w>leerling</w> op deze basisschool moet een eigen rugzak meenemen.",
                            "target_lang_translations": {
                                "en": "Every <w>student</w> at this primary school must bring their own backpack.",
                                "ru": "Каждый <w>ученик</w> в этой начальной школе должен приносить свой собственный рюкзак."
                            }
                        }
                    ],
                    "synonyms": [
                        "scholier",
                        "leerder"
                    ],
                    "antonyms": [
                        "leraar",
                        "docent",
                        "onderwijzer"
                    ],
                    "common_phrases": [
                        "ijverige leerling",
                        "nieuwe leerling",
                        "leerling van de school"
                    ],
                    "target_lang_definitions": {
