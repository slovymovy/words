                    }
                ],
                "senses": [
                    {
                        "sense_id": "99e080d7-0dac-3076-96b8-2c703cacc791",
                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                        "glosses": [
                            "Action de griller, manière d’apprêter certains morceaux de viande ou de poisson en les grillant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf1ff39-dbca-456c-97a5-6fc39e32d10d",
                                "sense_id": "99e080d7-0dac-3076-96b8-2c703cacc791",
                                "text": "Mettre des tranches de filet de bœuf à la grillade."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cd9e418-4556-34ea-ab4f-8892dcb1ddc3",
                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                        "glosses": [
                            "Action de griller, manière d’apprêter certains morceaux de viande ou de poisson en les grillant.",
                            "Se dit aussi de personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d51583-f0fb-4404-b7b6-5fb0522e928e",
                                "sense_id": "5cd9e418-4556-34ea-ab4f-8892dcb1ddc3",
                                "text": "Non, non, j’ai pris sur-le-champ la résolution d’aider à quelque bonne œuvre, comme à la grillade d’une sorcière, à un combat judiciaire ou à quelque service pareil, et voilà pourquoi je suis ici."
                            }
                        ]
                    },
                    {
                        "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                        "glosses": [
                            "Ces viandes et ces poissons grillés."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "15bce340-47f1-4cdb-bebf-d284d0008b31",
                                "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                                "text": "Ce soir les hommes ont allumé un brasier et nous avons dîné de succulentes grillades, merguez et côtes d'agneau. Nous avons même bu un verre de boulaouane, mais discrètement."
                            },
                            {
                                "example_id": "5f87bb37-c690-4120-85c0-391b805e0c77",
                                "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                                "text": "Grillade d’agneau, de porc. Grillade de saumon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98288542-17ca-488b-aa70-f6c2293446e8",
                        "source_entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                        "target_lang_word": "parrillada",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parrillada",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "07ab1fbe-0d67-3907-b53d-5a464046af99",
                                        "entry_id": "ab32d204-6a2e-3d62-a838-9e28e1231bbd",
                                        "glosses": [
                                            "Comida de varias carnes o pescados preparados a la parrilla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7324ae59-4ae4-4ae0-a07d-64ce53d32dd0",
                                                "sense_id": "07ab1fbe-0d67-3907-b53d-5a464046af99",
                                                "text": "Al preparar una parrillada debe evitarse que se pierdan los jugos naturales del alimento, para lo cual se favorecerá, como ya se ha dicho, la formación de una costra impermeable en la superficie que impida la salida de los mismos."
                                            },
                                            {
                                                "example_id": "6a865ffe-8f2d-4c50-8dfe-5e8844d49ead",
                                                "sense_id": "07ab1fbe-0d67-3907-b53d-5a464046af99",
                                                "text": "Esta acompaña muy bien los mariscos, sobre todo en parrillada."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "16d2f57b-c042-38e9-9127-81b1cfb9fe3a",
                                        "entry_id": "ab32d204-6a2e-3d62-a838-9e28e1231bbd",
                                        "glosses": [
                                            "Restaurante que sirve parrilladas₁ y otros platos a la parrilla."
                                        ],
                                        "tags": [
                                            "America",
                                            "Galicia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d9c0166-f540-446b-85d3-ea4f2bdea9b8",
                                                "sense_id": "16d2f57b-c042-38e9-9127-81b1cfb9fe3a",
                                                "text": "Las recovas de la plaza Independencia, vos también las conocés, Horacio, esa plaza tan triste con las parrilladas, seguro que por la tarde hubo algún asesinato y los canillitas están voceando el diario en las recovas."
                                            },
                                            {
                                                "example_id": "7f2e8969-630b-44c9-8720-6ff3b28d44d7",
                                                "sense_id": "16d2f57b-c042-38e9-9127-81b1cfb9fe3a",
                                                "text": "Disfrute de todo lo que desee en comida mexicana a tan sólo 9.99 dólares, en horario especial de lunes a jueves, de 20:00 hasta las 00:00, y los viernes y sábados hasta las 22:00. En Av. Las Aguas, junto a la parrillada La Vaca Gaucha."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc242d77-ccdf-47e4-8807-7c96934bec4b",
