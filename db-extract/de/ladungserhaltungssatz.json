                ],
                "senses": [
                    {
                        "sense_id": "527037b0-72d0-3b1d-9d74-77fc19af77e6",
                        "entry_id": "5b7b25b8-647b-381f-9f0c-5b63aa94f25f",
                        "glosses": [
                            "Erhaltungssatz, der besagt, dass in jedem abgeschlossenen System (System ohne Wechselwirkungen mit seiner Umgebung) die Summe der vorhandenen elektrischen Ladung konstant bleibt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "52921e98-0ee6-4f05-a312-bd512bb4dd74",
                                "sense_id": "527037b0-72d0-3b1d-9d74-77fc19af77e6",
                                "text": "„Es gilt somit das Gesetz von der Erhaltung der elektrischen Ladung, welches besagt, daß in einem abgeschlossenen System die Summe der elektrischen Ladungen konstant ist. Die hier zu betrachtenden Schaltungen sind abgeschlossene Systeme, für die der Ladungserhaltungssatz gilt.“"
                            },
                            {
                                "example_id": "8ba4508e-c970-4a65-877a-99b72d116387",
                                "sense_id": "527037b0-72d0-3b1d-9d74-77fc19af77e6",
                                "text": "„Der Ladungserhaltungssatz verlangt für diesen abgeschlossenen Raum, daß die eingeschlossene Ladung konstant bleibt, also vor und nach Schließen des Schalters gleich ist.“"
                            },
                            {
                                "example_id": "4ddc02b7-cd9b-4ba3-962b-6ba7f08ac2d9",
                                "sense_id": "527037b0-72d0-3b1d-9d74-77fc19af77e6",
                                "text": "„Immerhin ist also der Ladungserhaltungssatz in den Maxwell-Gleichungen enthalten, was für eine weitere, grundlegende Beobachtung, welche die elektrischen Ladungen betrifft, nicht der Fall ist: Die Ladungen sind quantisierte Größen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
