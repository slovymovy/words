                "senses": [
                    {
                        "sense_id": "0afc55cc-73db-363e-95a1-54a407574af5",
                        "entry_id": "7cee2c0c-2c00-34e5-aee5-3a74d610b956",
                        "glosses": [
                            "Truqué dans le but de faire perdre un adversaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf5d513-84e1-4baf-9977-3527fa26013c",
                                "sense_id": "0afc55cc-73db-363e-95a1-54a407574af5",
                                "text": "Et d’expliquer les mécanismes : « des responsables d’achat organisent cette corruption via des appels d’offres pipés, des hausses artificielles de prix, des faveurs pour la promotion de produits et d’autres irrégularités au service qualité et au contrôle financier, notamment sur la compliance », raconte le juriste."
                            },
                            {
                                "example_id": "d589a46e-f841-426f-895b-e05f3156041c",
                                "sense_id": "0afc55cc-73db-363e-95a1-54a407574af5",
                                "text": "Ce jeu est pipé."
                            }
                        ]
                    },
                    {
                        "sense_id": "b459c7d5-5f84-3422-bcb7-04f480c1f355",
                        "entry_id": "7cee2c0c-2c00-34e5-aee5-3a74d610b956",
                        "glosses": [
                            "Dans l’expression « les dés sont pipés », signifie qu’une situation est biaisée au détriment d’une des parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf7789d-2309-4810-bcb5-48e97b6af263",
                                "sense_id": "b459c7d5-5f84-3422-bcb7-04f480c1f355",
                                "text": "J’ai tenté de revendre mes parts de l’entreprise, mais les dés étaient complètement pipés."
                            }
                        ]
                    },
                    {
                        "sense_id": "4549ef5a-74ee-3da1-916f-03dfb13ec5e1",
                        "entry_id": "7cee2c0c-2c00-34e5-aee5-3a74d610b956",
                        "glosses": [
                            "Super, génial, sensas, formidable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b5c5ed-0b6e-4c66-b956-048440fe9068",
                                "sense_id": "4549ef5a-74ee-3da1-916f-03dfb13ec5e1",
                                "text": "J'ai eu un 18 en maths, ça c'est pipé !"
                            }
                        ]
                    }
