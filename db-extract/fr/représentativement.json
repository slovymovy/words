                                "example_id": "2fd30e66-6de0-479d-bf98-c0c1031b8e55",
                                "sense_id": "bb657798-bf0b-328d-b83f-11fe6d266f7d",
                                "text": "Des métaphysiciens ont dit que la sensation consistait en une propagation de formes extérieures jusqu’à un sensorium où elles se témoignaient représentativement."
                            },
                            {
                                "example_id": "bd2581c6-9341-4a03-b841-c73f74b8b2cd",
                                "sense_id": "bb657798-bf0b-328d-b83f-11fe6d266f7d",
                                "text": "Imaginata pictura, pour exprimer les peintures qu’on faisait autour des autels et dans les églises ; de là vient aussi le mot imaginariè, pour dire représentativement."
                            }
                        ]
                    }
