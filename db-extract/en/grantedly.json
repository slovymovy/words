                        "examples": [
                            {
                                "example_id": "2efe02ff-a4fa-4ce3-b8dc-1c505f4ce4ae",
                                "sense_id": "1a1a44b8-1b47-33a5-b6ed-e9b7a332ea76",
                                "text": "The psychological simplification, implicit in an attempt to explain five adult lives by the - grantedly dramatic - events of one night is heavy-handed and untrue, and the characters think tritely, with lines like \"I sit helpless, chained to my chair, manacled to my unedited and unacceptable life.\""
                            }
                        ]
