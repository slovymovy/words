                "senses": [
                    {
                        "sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                        "entry_id": "9bd59a34-0682-3b6e-881f-d52ec1a6b3a7",
                        "glosses": [
                            "Caractère de celui, celle ou ce qui est méticuleux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73d1e3f5-7de9-4530-95d9-30e387e2ea24",
                                "sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                                "text": "Cela ne devrait pas vous nuire : il est prouvé que l’éducation des public-schools développe merveilleusement bien les qualités nécessaires aux grands assassins : méticulosité, flegme et absence totale de sensiblerie…"
                            },
                            {
                                "example_id": "e9aa8d6e-f578-4559-8960-3fc296e03a22",
                                "sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                                "text": "Il rangeait sa chambre avec méticulosité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a2f253-55fa-4b4d-a1e5-5c9d9fea3309",
                        "source_entry_id": "9bd59a34-0682-3b6e-881f-d52ec1a6b3a7",
                        "source_sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                        "target_lang_word": "Akribie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akribie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                        "entry_id": "6a3d8b4f-54d7-3544-a579-72df21b92a87",
                                        "glosses": [
                                            "höchste Sorgsamkeit, höchste Genauigkeit, äußerste Gründlichkeit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b59fa24-481a-4580-b843-30b99190daab",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "Er erledigte diese Aufgabe mit großer Akribie."
                                            },
                                            {
                                                "example_id": "d936c86c-6249-48db-a20c-77fb4d227a7c",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Mir wurde bald deutlich, daß man sogenannter objektiver Wahrheit nicht ohne alle erdenkliche Akribie habhaft werden kann.“"
                                            },
                                            {
                                                "example_id": "2b04487e-9a0c-4906-9c01-42686ac26bf7",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "In der Orthodoxie ist Akribie die äußerste Genauigkeit, nach der alle Gebote gewissenhaft befolgt werden müssen."
                                            },
                                            {
                                                "example_id": "c1519b5c-fa35-4172-b230-cdef38c0ef13",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Aber die Akribie derartiger Zusammenstellungen verrät einen Hang zur Eindeutigkeit, den die folgenden Ausschweifungen nicht teilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06a6419d-e523-46c5-93fd-d4f4245accc3",
                        "source_entry_id": "9bd59a34-0682-3b6e-881f-d52ec1a6b3a7",
                        "source_sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                        "target_lang_word": "Gründlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gründlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                        "entry_id": "2bfc5916-689f-3261-ab9b-5bb3077df806",
                                        "glosses": [
                                            "Gründlichsein; gründliche Eigenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d84a788e-8e20-4fce-b23f-67774dc036b1",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "Mit verminderter Gründlichkeit ging er hier ans Werk."
                                            },
                                            {
                                                "example_id": "f31e312a-58e2-4cf3-afee-f94d64add36b",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "„Auf alle Vorstellungen Denissows, er solle dableiben, antwortete Petja nur, er sei ebenso wie Dolochow an klare Verhältnisse und Gründlichkeit gewöhnt und tue nichts blindlings, und die Gefahr mache ihm nichts aus.“"
                                            },
                                            {
                                                "example_id": "d3ee619c-5cd0-4b37-befa-320f97605736",
                                                "sense_id": "39552e79-dddd-3e37-915d-89fd99b26cad",
                                                "text": "„Er verhimmelt seine Tüchtigkeit, seine Gründlichkeit, seinen Gehorsam, seine Ordnungsliebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79389459-28ea-4509-9e54-167d619e6d81",
                        "source_entry_id": "9bd59a34-0682-3b6e-881f-d52ec1a6b3a7",
                        "source_sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                        "target_lang_word": "Genauigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genauigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                        "entry_id": "52ddb228-dc4f-3aff-aad7-903d5ee30d9e",
                                        "glosses": [
                                            "das Genausein als Präzision; die Eigenschaft, dass etwas seine Aufgabe mit großer Exaktheit ausführt und es keine Abweichungen gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a96f2d6-5ef4-46cb-94fe-805939a8c971",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "Die Laborwaage funktioniert mit großer Genauigkeit."
                                            },
                                            {
                                                "example_id": "3a43c00c-5332-4504-b2d2-08b51d154832",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Dort erfahren Sie auch mehr zur Genauigkeiten der Angaben.“"
                                            },
                                            {
                                                "example_id": "2eff2990-3187-49ed-9ae3-2f8c1c7e7ecd",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Bei der Ausrichtung geht es um Genauigkeiten von 0,01 Millimetern.“"
                                            },
                                            {
                                                "example_id": "bd4db140-5fd2-42b5-ac7f-5988545b5ee8",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Es ergab sich das Diagramm 8.3.1, wobei die Genauigkeiten aller drei Voraussetzungen nach Satz 6.3.7 berechnet wurden.“"
                                            },
                                            {
                                                "example_id": "18d35a37-601f-444a-bc91-0d94f4e5e20b",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Mit einfachen Registrierverfahren werden Genauigkeiten zwischen 1,5 und 3 mm erreicht.“"
                                            },
                                            {
                                                "example_id": "559a1abe-d90e-4ba9-a112-06cd3404bcdc",
                                                "sense_id": "f5db2283-d6d4-32de-b0d4-a3119470b0a9",
                                                "text": "„Wesentliche Merkmale von Ingenieurvermessungen sind zum einen die Zuverlässigkeit, d.h. die Reproduzier- und Kontrollierbarkeit, sowie die definierten Genauigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                        "entry_id": "52ddb228-dc4f-3aff-aad7-903d5ee30d9e",
                                        "glosses": [
                                            "das Genausein als Sorgfalt; das Pflichtbewusstsein einer Person, die Aufgaben mit großer Richtigkeit erledigt und es kaum Fehler gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e716d9a1-a052-49a0-a3c5-e7b84c1ddd66",
                                                "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                                "text": "Die Arbeit im Operationssaal erfordert Fleiß und Genauigkeit."
                                            },
                                            {
                                                "example_id": "bc65e1bf-96cb-44a2-becc-d52d1720efd0",
                                                "sense_id": "4e076441-eeb6-3631-8215-ce82db9fd1a3",
                                                "text": "„Pécuchet schlug in der Universal-Biographie nach und machte sich daran, Dumas auf wissenschaftliche Genauigkeit zu prüfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8287071-a02c-4036-b8f9-be730a21a793",
                        "source_entry_id": "9bd59a34-0682-3b6e-881f-d52ec1a6b3a7",
                        "source_sense_id": "846a618c-a878-3a78-8864-09d235876b05",
                        "target_lang_word": "Akkuratesse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkuratesse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                        "entry_id": "f76b2371-426a-3223-a063-1dec1eb7ac57",
                                        "glosses": [
                                            "die Sorgfalt, die Gründlichkeit, mit der eine Handlung ausgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70a0cbf9-52a8-4a96-b4d4-d5fc6cf07cb7",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Ein Mann von solcher Akkuratesse, von solchem Scharfsinn … Ihre vorgesetzte Behörde muß Sie einfach schätzen, muß schließlich Verständnis für Sie gewinnen!“"
                                            },
                                            {
                                                "example_id": "16d6923d-d9d2-4dc8-a8fb-bf88e78dbffe",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Auf der einen Seite treibt der Staat seine Steuern mit der Strenge und Akkuratesse des Rechtsstaates ein.“"
                                            },
                                            {
                                                "example_id": "f07508ca-53ad-4421-9ce4-94bd2cd7cfba",
                                                "sense_id": "387cc993-be5a-3545-b124-70b07a1079e6",
                                                "text": "„Dem Motiv ‚Neid‘ kommt die zentrale Rolle zu: Selten sah man diese Emotion mit derart abstoßender Akkuratesse dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                        "entry_id": "f76b2371-426a-3223-a063-1dec1eb7ac57",
                                        "glosses": [
                                            "die Art einer Arbeit, die mit höchster Sorgfältigkeit durchgeführt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d923939d-a8fe-4420-8068-687e57e4fda3",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„An die zurücktretenden Winkel der einen fügen sich mit geometrischer Akkuratesse die herausspringenden Winkel der andern.“"
                                            },
                                            {
                                                "example_id": "6943debb-7f30-4a7b-8e7a-f5c857be9459",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„Ein Lichtblick nicht nur dank klanglicher Akkuratesse, sondern auch auf Grund spielerischen Engagements, das in den Dialogen mit Nicholas Ofczarek zuweilen zu großer theatralischer Intensität anschwoll.“"
                                            },
                                            {
                                                "example_id": "0c2e9ca3-e01b-4d3e-b300-9d195423dcd8",
                                                "sense_id": "49929565-9403-30fb-80bc-30ef35225457",
                                                "text": "„Zwar entspricht das nicht einmal einem Promille des gesamten Genoms des Ursäugers, doch nach Kontrollrechnungen bescheinigten die Genarchäologen ihrem Ergebnis im Fachblatt Genome Research 98 Prozent Akkuratesse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
