                    "frequency": "Low",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Kromme Rijn <w>doorstroomt</w> de stad Utrecht en gaat over in de Vecht.",
                            "target_lang_translations": {
                                "en": "The Kromme Rijn <w>flows through</w> the city of Utrecht and turns into the Vecht."
                            }
                        },
                        {
                            "text": "Het bloed <w>doorstroomt</w> alle delen van het menselijk lichaam.",
                            "target_lang_translations": {
                                "en": "Blood <w>flows through</w> all parts of the human body."
                            }
                        }
