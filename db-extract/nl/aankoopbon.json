                        "entry_id": "6c8d6ff2-4892-3753-9070-2ea24e1bbdf1",
                        "glosses": [
                            "papieren bewijs dat men een bepaald product gekocht heeft en men ontvangt na het betalen van de prijs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7bc585-d8ec-46e2-a205-475b1540e128",
                                "sense_id": "5c9f542a-f5eb-35ae-8392-47665735be11",
                                "text": "Klanten die het product niet willen gebruiken, kunnen de peertjes terugbrengen en hun geld terugkrijgen. Een aankoopbon is niet nodig."
                            },
                            {
                                "example_id": "ef999322-0862-4796-8ac5-125197bcc703",
                                "sense_id": "5c9f542a-f5eb-35ae-8392-47665735be11",
                                "text": "Hij vraagt daarom iedereen nog eens op zolder of in de kelder te zoeken naar oude kasboekjes of bijvoorbeeld de aankoopbon van de eerste auto en die op te sturen naar Kasboekje van Nederland aan de Universiteit Utrecht."
                            }
                        ]
