                        ]
                    },
                    {
                        "translation_id": "79183582-20b2-4355-a2fd-7fde39b4585a",
                        "source_entry_id": "906ed68b-9413-38e9-8338-c219f527e9bf",
                        "source_sense_id": "4f2e0349-d8a3-37ea-8fb4-d40e8c90e7d9",
                        "target_lang_word": "Schanghai",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schanghai",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "56ff3f48-b05f-314d-92e8-4c93117e55f5",
                                        "entry_id": "cd09fb5f-0169-3f82-96fc-f408601b5be9",
                                        "glosses": [
                                            "Stadt der Volksrepublik China"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "107fa97c-0903-4b87-8835-abb99bdc1bf2",
                                                "sense_id": "56ff3f48-b05f-314d-92e8-4c93117e55f5",
                                                "text": "Im Ballungsraum Schanghai wohnen über 17 Millionen Menschen."
                                            },
                                            {
                                                "example_id": "0633fadc-1fc0-41b7-afea-f6ebe2959560",
                                                "sense_id": "56ff3f48-b05f-314d-92e8-4c93117e55f5",
                                                "text": "Das Schanghai der dreißiger Jahre war ein architektonischer Dialog zwischen Ost und West."
                                            },
                                            {
                                                "example_id": "45a6ebaa-11b0-4545-8e65-eebe30ba1a55",
                                                "sense_id": "56ff3f48-b05f-314d-92e8-4c93117e55f5",
                                                "text": "Die Feierlichkeiten an Schanghais neuem Superturm beenden eine zehnjährige Bauphase, in der die Entwickler um das japanische Immobilienunternehmen Mori eine Reihe von Rückschlägen hinnehmen mussten."
                                            },
                                            {
                                                "example_id": "c56262e8-13aa-4a42-871a-d1543d5c26b1",
                                                "sense_id": "56ff3f48-b05f-314d-92e8-4c93117e55f5",
                                                "text": "Schanghai wird die Kulisse für das letzte Rennen der Saison bieten, das aller Voraussicht nach als Nachtrennen ausgetragen wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
