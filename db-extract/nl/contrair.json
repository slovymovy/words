                        ]
                    },
                    {
                        "translation_id": "41038976-21e9-4977-a6dd-b2d3e207f7f2",
                        "source_entry_id": "51088227-f477-3f26-9ae5-83563b780e8c",
                        "source_sense_id": "e0de5298-fd81-3a66-969b-55931d536141",
                        "target_lang_word": "contraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                        "entry_id": "bced7fdb-e8d0-3385-82a6-459583182dfe",
                                        "glosses": [
                                            "Concept inverse, logiquement opposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e56587b-220f-420b-9f86-b61d21fd91c8",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Le contraire d'en haut est en bas."
                                            },
                                            {
                                                "example_id": "1023ff94-e700-476f-91b4-73fd8c845153",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Vous m’avez dit le contraire."
                                            },
                                            {
                                                "example_id": "df9aa487-e410-42e9-a5fc-6d5031f9161c",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Je vois tout le contraire de ce qu’on m’avait promis."
                                            },
                                            {
                                                "example_id": "ee2d0a5d-e5c3-44a5-812f-4aaa2edc79d9",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Je soutiens le contraire."
                                            },
                                            {
                                                "example_id": "cd120ca2-c845-4d2e-8f66-6e93acdedc48",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Je vous prouverai le contraire."
                                            },
                                            {
                                                "example_id": "63023baf-c104-4749-a15c-6552d34e44a0",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Je ne dis pas le contraire."
                                            },
                                            {
                                                "example_id": "fd3da002-38a8-4cfa-8c9d-47406bf9e764",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Deux contraires ne peuvent subsister ensemble."
                                            },
                                            {
                                                "example_id": "86ae4831-73e0-41b2-87e8-9cbbc2d07fda",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Concilier les contraires."
                                            },
                                            {
                                                "example_id": "4ffec42a-3268-485e-b3ab-f0b31faec99e",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "Or le droit et la justice sont le contraire de la violence et de la force."
                                            },
                                            {
                                                "example_id": "11d86ce6-0d2f-4344-b150-bce583803007",
                                                "sense_id": "b86ada83-37d1-3c04-8c9e-5d6f7b86a84b",
                                                "text": "– Qu’en savez-vous ?\n– Prouvez le contraire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contraire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8f16b2-f8e4-3140-828b-ff6e4217e027",
                                        "entry_id": "3905b2b2-408a-33e1-a4c1-f4d35ddf49e9",
                                        "glosses": [
                                            "Qui est opposé à ; qui est à l'opposé de."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfd84ad1-32cc-4c46-a4a0-ff9e5d0792b8",
                                                "sense_id": "8d8f16b2-f8e4-3140-828b-ff6e4217e027",
                                                "text": "Ils auraient alors passé de l’Ouest à l’Est, vers la fin du tertiaire, dans le sens contraire à celui qu'on attribuait à l’émigration humaine."
                                            },
                                            {
                                                "example_id": "c0923049-7576-410a-9c91-39fea6332f63",
                                                "sense_id": "8d8f16b2-f8e4-3140-828b-ff6e4217e027",
                                                "text": "Sous les instances de deux officiers, je renonce à aller voir si les deux autres passerelles du génie existent, malgré les affirmations contraires des officiers relevés."
                                            },
                                            {
                                                "example_id": "02fbc7c3-50c0-4a04-a344-14f5d45b446a",
                                                "sense_id": "8d8f16b2-f8e4-3140-828b-ff6e4217e027",
                                                "text": "Le philosophe doit éviter les ambiguïtés ou les plurivocités, et décider du langage qu'il entend au juste parler. Dans le cas contraire, les portes sont grandes ouvertes aux malentendus."
                                            },
                                            {
                                                "example_id": "6acb4dba-e257-49d4-96da-3779a9bf2110",
                                                "sense_id": "8d8f16b2-f8e4-3140-828b-ff6e4217e027",
                                                "text": "Avoir le vent contraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255f743b-f876-31b0-a148-08f4d40ebd46",
                                        "entry_id": "3905b2b2-408a-33e1-a4c1-f4d35ddf49e9",
                                        "glosses": [
                                            "Qui est défavorable, hostile ou nuisible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b168dd8-7f32-4f76-acec-d642812f97ea",
                                                "sense_id": "255f743b-f876-31b0-a148-08f4d40ebd46",
                                                "text": "Ce genre de vie est contraire à sa santé."
                                            },
                                            {
                                                "example_id": "1061b0ee-114f-41ca-8c57-0f986c98d1ea",
                                                "sense_id": "255f743b-f876-31b0-a148-08f4d40ebd46",
                                                "text": "L’enfant du vieil Auffray et de sa jeune épouse était frêle, petite et malingre : l’air humide du Marais lui fut contraire."
                                            },
                                            {
                                                "example_id": "8c0c5d15-5502-4975-9e6b-5bf5ee2f9acb",
                                                "sense_id": "255f743b-f876-31b0-a148-08f4d40ebd46",
                                                "text": "Et, mein Führer, si mon entreprise — qui, je dois l’avouer, à^([sic]) peu de chances de succès — devait échouer, si le sort devait m’être contraire, cela n’aurait pour vous ou pour l’Allemagne aucune conséquence négative : vous pourrez à tout moment me désavouer, en me déclarant fou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff661cc7-ca34-3dcc-a8d1-d8fcbfc36e6d",
                                        "entry_id": "3905b2b2-408a-33e1-a4c1-f4d35ddf49e9",
                                        "glosses": [
                                            "Peu accommodant."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272768ff-3d09-4815-870a-d3d627f468b2",
                                                "sense_id": "ff661cc7-ca34-3dcc-a8d1-d8fcbfc36e6d",
                                                "text": "Il n’est pas contraire, il est toujours d’accord avec nous."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
