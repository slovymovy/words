                "senses": [
                    {
                        "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                        "entry_id": "7146040c-9b1a-3ea7-8ca8-63cfe10ce409",
                        "glosses": [
                            "Treppenhaus"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "dff2c3d8-542a-4368-9338-45fc3e483286",
                                "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                                "text": "Bisweilen stinkt es im Stiegenhaus nach Rauch."
                            },
                            {
                                "example_id": "e95cefe3-3e47-4ce9-b71f-a5f474a1d767",
                                "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                                "text": "„Im Stiegenhaus war es dunkel.“"
                            },
                            {
                                "example_id": "a817eecb-5377-4e95-bc2c-ca1da33517b9",
                                "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                                "text": "„Vom Stiegenhaus her näherten sich Schritte.“"
                            },
                            {
                                "example_id": "e3e44b2e-3554-4731-8cfa-012d006b80e5",
                                "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                                "text": "„Ihre hallenden Schritte im Stiegenhaus hätten auch einer Kriminalgeschichte entnommen sein können.“"
                            },
                            {
                                "example_id": "6e6708d3-4103-445d-a122-5c2553a71251",
                                "sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                                "text": "„Diese schöne und gepflegte Erscheinung ging in ein gesichtsloses Stiegenhaus eines geschlossenen Gebäudes in einem ebenso gesichtslosen Viertel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2b03724-a086-41af-8d16-9be8aae72f46",
                        "source_entry_id": "7146040c-9b1a-3ea7-8ca8-63cfe10ce409",
                        "source_sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                        "source_sense_description": "bayrisch, österreichisch: Treppenhaus",
                        "target_lang_word": "staircase",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staircase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76c46971-3a70-3070-a7fb-c6507073fbfb",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A flight of stairs; a stairway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e311c1f-6b1c-4fa9-bbb5-f8d7a08c0eb1",
                                                "sense_id": "76c46971-3a70-3070-a7fb-c6507073fbfb",
                                                "text": "I was on the staircase by the bell / Blinded by the black magician's spell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A connected set of flights of stairs; a stairwell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fed937-7c37-48cc-9a58-18bfa3434696",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "2be7a2ad-4e7d-43f7-8c82-edcf3c55a3cf",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            },
                                            {
                                                "example_id": "2feb1466-1d9c-42cb-89dc-f0ca75d5385e",
                                                "sense_id": "52dfda60-39a9-3207-bf42-5f53d98aee19",
                                                "text": "Oliver immediately gets a 'guided tour, Felix wheeling through libraries and endless colour-coded rooms, up and down staircases and along echoing halls where various \"dead relly[s]\" stare down from the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c71c303-768d-36ce-ace8-86ea31448bc1",
                                        "entry_id": "7840418c-b833-3a52-97b5-c1223a29cc4f",
                                        "glosses": [
                                            "A set of locks (enclosed sections of waterway) mounted one above the next."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "staircase",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8cea6da-adf4-358d-ba4d-fd0ac2ac8bf8",
                                        "entry_id": "479c8de7-bf51-3f7b-bd40-1ed3a0c45b4a",
                                        "glosses": [
                                            "To modify (a signal, a graph, etc.) to reduce a smooth curve to a series of discrete steps."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa944f74-30bb-47f0-a004-46dee669f4e9",
                                                "sense_id": "a8cea6da-adf4-358d-ba4d-fd0ac2ac8bf8",
                                                "text": "This leads to much smoother reconstructions in regions of moderate gradient and thus prevents staircasing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c150bb2-df39-39c3-ac18-ce35bc457a26",
                                        "entry_id": "479c8de7-bf51-3f7b-bd40-1ed3a0c45b4a",
                                        "glosses": [
                                            "To increase one's share in a co-ownership."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a18807d4-bd85-479b-bcbb-92c4f5e609b8",
                                                "sense_id": "5c150bb2-df39-39c3-ac18-ce35bc457a26",
                                                "text": "It is a good idea to make plans for staircasing when you first buy your shared ownership home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16ff8938-b366-40e6-942e-44afa7808ae8",
                        "source_entry_id": "7146040c-9b1a-3ea7-8ca8-63cfe10ce409",
                        "source_sense_id": "a5c5bfea-e66a-3829-8435-da1b201d9ebb",
                        "source_sense_description": "bayrisch, österreichisch: Treppenhaus",
                        "target_lang_word": "cage d’escalier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cage d’escalier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e790b80b-de5a-3e6a-ac36-30cd35a866ec",
                                        "entry_id": "12fb7362-5aac-39bc-b3af-f45abddd15c9",
                                        "glosses": [
                                            "Espace compris entre les murs qui enferment un escalier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "680e48e8-0cb1-405c-9d0b-4d07c2a80ff5",
                                                "sense_id": "e790b80b-de5a-3e6a-ac36-30cd35a866ec",
                                                "text": "Ses parents l’enfermaient toujours dans la cage d’escalier quand il ne les écoutait pas."
                                            },
                                            {
                                                "example_id": "e891dab9-e155-4186-9ed0-63237196479f",
                                                "sense_id": "e790b80b-de5a-3e6a-ac36-30cd35a866ec",
                                                "text": "Pour décupler les logements, il fallut entresoler presque toutes les grandes salles, les couper de deux ou trois cloisons, ouvrir dans l’épaisseur des murs des cages d’escaliers, des gaines de cheminée."
                                            },
                                            {
                                                "example_id": "dd7a1b7e-9118-4ae5-b8eb-49b36627ea68",
                                                "sense_id": "e790b80b-de5a-3e6a-ac36-30cd35a866ec",
                                                "text": "Sur les marches, leurs semelles produisaient de désagréables couinements que réverbérait la cage d’escalier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
