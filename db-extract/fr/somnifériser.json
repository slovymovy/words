                "senses": [
                    {
                        "sense_id": "a65d87fa-21fb-37a5-bc33-b647003a0268",
                        "entry_id": "41608cf2-cb28-3240-b677-7b4be605b139",
                        "glosses": [
                            "Administrer des somnifères, endormir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3abc4ed6-a75b-42fc-a8c8-bf244c5c41da",
                                "sense_id": "a65d87fa-21fb-37a5-bc33-b647003a0268",
                                "text": "Il s'est contenté de vulgariser Nietzsche, et d'autres mais comme nous venons d'en parler (comme je viens de somnifériser littéralement la ChatBox avec mon enthousiasme sur la question) un petit moment de la nuit, des auteurs croyants comme Kierkegaard, par exemple."
                            },
                            {
                                "example_id": "6f7577ad-b2ad-4f64-88dc-bcb4faa63479",
                                "sense_id": "a65d87fa-21fb-37a5-bc33-b647003a0268",
                                "text": "la prochaine fois, n'oublie pas de somnifériser le malotru qui ose te déranger dans un trip aussi sensuel!"
                            },
                            {
                                "example_id": "79c22eb2-599e-4403-907c-3d7ac49264d7",
                                "sense_id": "a65d87fa-21fb-37a5-bc33-b647003a0268",
                                "text": "Je me contenterais du grinch pour tenter de me consoler et de me somnifériser…"
                            }
                        ]
                    }
