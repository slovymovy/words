                                "target_senses": [
                                    {
                                        "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                        "entry_id": "f324955b-1d1d-3477-829b-0cf6d83881c1",
                                        "glosses": [
                                            "In that place; there (at some distance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c9367e-0960-40c8-9a3e-316660282464",
                                                "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                                "text": "You see that house over there? That's where I used to live."
                                            },
                                            {
                                                "example_id": "5bcc92d5-85f6-4738-9ecc-a31e43c45b39",
                                                "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                                "text": "Shepard: I'm looking for an asari.\nDr. Palon: Asari? Well, there's Dr. Iallis over there.\nDr. Palon: There's also our guest, Lady Benezia. Captain Ventralis might know where she is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8183779e-4824-343e-9f15-7fcdeaa1b8e2",
                                        "entry_id": "f324955b-1d1d-3477-829b-0cf6d83881c1",
                                        "glosses": [
                                            "To that place; thither (at some distance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a817f239-ed59-4d6c-961d-33d7717e3fb2",
                                                "sense_id": "8183779e-4824-343e-9f15-7fcdeaa1b8e2",
                                                "text": "Let's head over there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9580a41-a75d-38c9-9495-57e576850459",
                                        "entry_id": "f324955b-1d1d-3477-829b-0cf6d83881c1",
                                        "glosses": [
                                            "overseas to Europe (for military engagement), especially to the Western Front in France during World War I"
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29cf154e-8042-40c3-96be-5ceebc51f1be",
                        "source_entry_id": "d3f1f6f4-f424-397d-aecc-d5ec0f62024d",
                        "source_sense_id": "4a7b5e40-2ddc-33d2-8898-4c7191747888",
                        "target_lang_word": "yon",
