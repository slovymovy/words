                                "target_senses": [
                                    {
                                        "sense_id": "53582d98-5046-3dea-8e80-a8fae666c0df",
                                        "entry_id": "88e20276-9a1d-39ab-b62d-0c8811512bf6",
                                        "glosses": [
                                            "mehr von jemandem verlangen, als er leisten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "896101a0-23a0-4ccb-b725-0d475e91545b",
                                                "sense_id": "53582d98-5046-3dea-8e80-a8fae666c0df",
                                                "text": "Ich bin mit dieser Arbeit überfordert."
                                            },
                                            {
                                                "example_id": "ba8de869-919e-4ce0-a14d-cf523f4494e5",
                                                "sense_id": "53582d98-5046-3dea-8e80-a8fae666c0df",
                                                "text": "Sie darf das Kind nicht ständig überfordern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
