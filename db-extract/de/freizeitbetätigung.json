                "senses": [
                    {
                        "sense_id": "2bfb9597-5f48-3ac0-8182-c6a84b0eb48a",
                        "entry_id": "e1157af7-5228-31ca-8a28-2a1f227dfc6b",
                        "glosses": [
                            "Aktivität, die in der Freizeit ausgeübt wird, meistens aus Spaß oder zur Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ae37b95-a9b4-4f4d-864f-edab0152ae3a",
                                "sense_id": "2bfb9597-5f48-3ac0-8182-c6a84b0eb48a",
                                "text": "„Schwimmsport kann aber auch ohne Zeitdruck zur Verbesserung der eigenen Schwimmtechnik oder als Freizeitbetätigung und zur Gesundheitsförderung betrieben werden.“"
                            },
                            {
                                "example_id": "ef137709-28d9-423b-8e15-a5cf5044880a",
                                "sense_id": "2bfb9597-5f48-3ac0-8182-c6a84b0eb48a",
                                "text": "„Radfahren als alltägliches Fortbewegungsmittel, Sport oder Freizeitbetätigung ist in praktisch jedem Alter möglich und auch für Menschen mit körperlichen Einschränkungen durchführbar, da es sehr gelenkschonend ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c58c798e-13f3-4bcc-aa2a-70ba0864f501",
                        "source_entry_id": "e1157af7-5228-31ca-8a28-2a1f227dfc6b",
