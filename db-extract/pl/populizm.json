                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5209a371-a9a5-405f-9f6a-e6736956786f",
                        "source_entry_id": "75b9ce1f-8891-3ff5-be81-c6a0c4d0a691",
                        "source_sense_id": "f97173b5-d2d0-3635-a1d7-408734da0ccd",
                        "target_lang_word": "популизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "популизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3221f293-ef9b-366b-9fa8-526cad490289",
                                        "entry_id": "b1845432-31ae-3e2c-9bcc-044e5992b0d6",
                                        "glosses": [
                                            "полит. политическая стратегия, сочетающая антиэлитизм, антиплюрализм (восприятие народа как однородной массы, борьба со сдержками и противовесами в обществе) и самоотождествление с народом, его волей"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bd7ff0f-b71e-3945-87f8-d19d5fb191be",
                                        "entry_id": "b1845432-31ae-3e2c-9bcc-044e5992b0d6",
                                        "glosses": [
                                            "разг. политическая позиция или стиль риторики, апеллирующая к широким народным массам и обычно оцениваемая как потакание их слабостям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd88d13d-3e93-4ea5-a88e-0df951ea8da7",
                                                "sense_id": "6bd7ff0f-b71e-3945-87f8-d19d5fb191be",
                                                "text": "Несомненно, в этом документе есть некоторый налет популизма. Потому как во всех действиях, снижающих налоговое бремя, есть доля популизма, главное, чтобы он был здоровым."
                                            },
                                            {
                                                "example_id": "980d8033-5c39-42cb-bf89-569c063f3853",
                                                "sense_id": "6bd7ff0f-b71e-3945-87f8-d19d5fb191be",
                                                "text": "Однако уверения в том, что «пивная» реклама способствует пропаганде алкоголизма, — не более чем популизм."
                                            },
                                            {
                                                "example_id": "a380a34d-aced-47a4-859a-312501b01be6",
                                                "sense_id": "6bd7ff0f-b71e-3945-87f8-d19d5fb191be",
                                                "text": "В последние дни из штаб-квартиры МВФ в Вашингтоне Москве намекнули: предвыборный популизм, в случае последовательного проведения в жизнь подобных лозунгов, может стоить $9 млрд."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
