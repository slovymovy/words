                        "glosses": [
                            "Homme membre d’un fraternité universitaire nord-américaine ou ayant adopté cette culture, favorisant les autres hommes membres de son groupe."
                        ],
                        "tags": [
                            "Anglicism",
                            "familiar"
                        ],
