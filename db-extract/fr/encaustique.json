        "fr-extract.jsonl": [
            {
                "entry_id": "179e4795-fe9b-30ee-b8e0-d3a0e618e066",
                "word": "encaustique",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8816fca-63ca-41cd-9d6b-89b73d2aeffc",
                        "entry_id": "179e4795-fe9b-30ee-b8e0-d3a0e618e066",
                        "tags": [
                            "plural"
                        ],
                        "form": "encaustiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9afc6d2-74a5-35a6-8e14-f6f223318f3c",
                        "entry_id": "179e4795-fe9b-30ee-b8e0-d3a0e618e066",
                        "glosses": [
                            "Préparation faite avec de la cire d'abeille et de l’essence de térébenthine, qu’on étend sur les parquets et sur certains meubles de bois pour leur donner du lustre, du poli."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302ecddb-53dd-48a5-8bd9-e59667ced4fc",
                                "sense_id": "f9afc6d2-74a5-35a6-8e14-f6f223318f3c",
                                "text": "Le sommier, à lui seul, était aussi grand que la hutte de ses parents, et une toile aérienne le coiffait comme une chevelure d’ange. Des meubles luisants comme de la houille et qui sentaient bon l’encaustique complétaient le mobilier cossu de la pièce."
                            },
                            {
                                "example_id": "0680c430-332c-4155-aa70-2c3ed29b53ce",
                                "sense_id": "f9afc6d2-74a5-35a6-8e14-f6f223318f3c",
                                "text": "Passer à l’encaustique un buffet, une armoire."
                            },
                            {
                                "example_id": "c2aa554a-ddd4-4229-97d2-939c733ebd0f",
                                "sense_id": "f9afc6d2-74a5-35a6-8e14-f6f223318f3c",
                                "text": "Pour supprimer une encaustique encrassée, passez du pétrole désodorisé, au pinceau."
                            },
                            {
                                "example_id": "4ec19ba0-dc3b-4fde-9045-b0e272e8e2cf",
                                "sense_id": "f9afc6d2-74a5-35a6-8e14-f6f223318f3c",
                                "text": "C'était une salle sévère qui empestait l'encaustique."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4b60fee-c64f-3fe8-b67c-2127fdfbf001",
                        "entry_id": "179e4795-fe9b-30ee-b8e0-d3a0e618e066",
                        "glosses": [
                            "Enduit à base de cire qui sert à donner aux statues de plâtre le poli du marbre et à rendre plus mate la blancheur des statues de marbre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9bfd0e04-a2f2-36ff-9adc-0f6110b74e5d",
                        "entry_id": "179e4795-fe9b-30ee-b8e0-d3a0e618e066",
                        "glosses": [
                            "Peinture, d’un tableau dont les couleurs étaient préparées avec de la cire et qu’employaient les grecs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c0bcc4-c315-44dd-85ec-3247ca3cc85a",
                                "sense_id": "9bfd0e04-a2f2-36ff-9adc-0f6110b74e5d",
                                "text": "Peinture encaustique."
                            }
                        ]
                    }
                ],
