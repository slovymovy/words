                            {
                                "example_id": "08825de0-a840-4ef7-a544-89588a774709",
                                "sense_id": "17b1a3cf-939e-3b6d-ba16-8ea31566b0c9",
                                "text": "Ce qui me blesse les yeux, quant à moi, vocifère Coselli, ce qui me blesse les yeux, c'est votre louche nombril, votre ombilic obscène, la peau de tambour moisie de votre bedaine, votre exhibitionnisme sénile, Géronte de la galonnaille, Ratapoil de fête nationale, bubon du chancre militaire."
                            },
                            {
                                "example_id": "a7161442-db40-46af-b2f3-5c234d763a45",
                                "sense_id": "17b1a3cf-939e-3b6d-ba16-8ea31566b0c9",
                                "text": "Nous nous trouvions, au surplus, nettement fixés sur les intentions de l'état-major et de toute la galonnaille de la rue Saint-Dominique. Nous devrions en venir à bout de vive force !"
                            },
                            {
                                "example_id": "527b3923-62d8-4ac7-b1d9-1116e8449f19",
                                "sense_id": "17b1a3cf-939e-3b6d-ba16-8ea31566b0c9",
                                "text": "J'ai vu les parlements sauter,\nDisparaître la galonnaille,\nJ'ai vu le mot humanité\nRemplacer celui de racaille."
                            }
                        ]
