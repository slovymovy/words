                                        "entry_id": "733b39ee-2949-3b08-9aa9-fbc8f65c21c9",
                                        "glosses": [
                                            "Cada uno de los círculos en la esfera celeste, paralelos al horizonte, que ayudaban a determinar la altura o depresión de los astros para navegación, relojes y otros fines."
                                        ],
                                        "tags": [
                                            "adjective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40710cc2-3148-45ea-9e09-68887d04d0fd",
                                                "sense_id": "e61b4dfc-eb37-3805-b524-8837b8690952",
                                                "text": "Los círculos pequeños paralelos al horizonte se llaman también círculos horizontales ó almicantarates."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
