        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d6c93d0-1bd7-3790-8401-17fe7443f2e2",
                    "sense_definition": "A title used after a son's name when he has exactly the same name as his father.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "suffix_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please sign your full name as William Smith <w>Junior</w> on the form.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подпишитесь полным именем как Уильям Смит <w>младший</w> в бланке.",
                                "zh": "请在表格上签上你的全名：威廉·史密斯<w>二世</w>。"
                            }
                        },
                        {
                            "text": "The actor Robert Downey <w>Junior</w> is famous for his role in superhero movies.",
                            "target_lang_translations": {
                                "ru": "Актер Роберт Дауни <w>младший</w> известен своей ролью в фильмах о супергероях.",
                                "zh": "演员<w>小</w>罗伯特·唐尼（Robert Downey Junior）以其在超级英雄电影中的角色而闻名。"
                            }
                        }
                    ],
                    "antonyms": [
                        "senior"
                    ],
                    "common_phrases": [
                        "Sammy Davis Junior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приставка к имени сына, если его зовут так же, как отца.",
                        "zh": "用于儿子名字后，以区分与父亲同名的情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "младший",
                                "target_lang_sense_clarification": "приставка к имени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二世",
                                "target_lang_sense_clarification": "用于名字后"
                            },
                            {
                                "target_lang_word": "小",
                                "target_lang_sense_clarification": "用于姓氏前"
                            }
                        ]
