    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cb9de873-4ee2-3bd7-95b0-eaf9057317cc",
                "word": "boondoggle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6653126f-759b-46f0-a333-4bfc51340210",
                        "entry_id": "cb9de873-4ee2-3bd7-95b0-eaf9057317cc",
                        "tags": [
                            "plural"
                        ],
                        "form": "boondoggles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7737b33f-538c-3da1-8f68-2f7b76238c1a",
                        "entry_id": "cb9de873-4ee2-3bd7-95b0-eaf9057317cc",
                        "glosses": [
                            "A braided ring to hold a neckerchief."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                        "entry_id": "cb9de873-4ee2-3bd7-95b0-eaf9057317cc",
                        "glosses": [
                            "A waste of time or money; a pointless activity."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "figuratively",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f3c19d02-1244-4106-b6bc-89691d08754b",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "Opponents consider this another billion-dollar government boondoggle."
                            },
                            {
                                "example_id": "10d661db-05e2-4ed5-9b61-3c3b2f02fe61",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "Senator John Stennis […] has been active and effective for so long as a member of the Armed Services Committee that he knows as well as any man can where the bodies are buried in the Pentagon and the boondoggles are buried in the defense budget."
                            },
                            {
                                "example_id": "9bc943a7-35b5-4092-a2cd-b0bdf584e5c6",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "By its strictest definition, a boondoggle is a recreational trip out of town, but it has been blurred by threadbare jokes to mean any trip that is desirable, whether for work or not."
                            },
                            {
                                "example_id": "29f80a8c-4662-47c3-aa4a-44e19b06f2f7",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "“Oh, for the-- how much did you waste on that little boondoggle?” “Well, it's not that so much as--” “Krieger.” “Well, I needed ballast, and what better to simulate bricks of cocaine than, you know, bricks of cocaine.”"
                            },
                            {
                                "example_id": "ce3cb548-0f0a-4064-aaff-b8908a20e0f0",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "Klein dismantles the boondoggle that is cap and trade."
                            },
                            {
                                "example_id": "3da4179d-7182-408f-af42-7d528db98ed9",
                                "sense_id": "73d5438b-76be-3c61-bd37-4d753d74c14c",
                                "text": "For cynics, it is a boondoggle plagued by delays (it began in 2007 and was supposed to begin experiments in 2016, but this will not now happen until 2025), questionable management and ballooning costs (double the original estimate)."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f2a67ca-0b4b-3ffb-ab4e-15077a0505f5",
                        "entry_id": "cb9de873-4ee2-3bd7-95b0-eaf9057317cc",
                        "glosses": [
                            "A non-work trip away from a research station."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "17cca211-a82a-4416-a3c3-c09bb930a67d",
                                "sense_id": "2f2a67ca-0b4b-3ffb-ab4e-15077a0505f5",
                                "text": "A non-work excursion away from the station in US Antarctic English is a “boondoggle”, or a “jolly” for the Britons."
                            }
                        ]
                    }
                ],
                "translations": [
