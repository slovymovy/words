                        "glosses": [
                            "Alphabet utilisé par les Berbères, essentiellement les Touaregs."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cfbeed27-100e-3bfa-b440-903f6f06641b",
                        "entry_id": "9c3a098a-fcaf-377f-8de0-9631a32e1708",
                        "glosses": [
                            "Caractère de cette écriture."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e5b86622-5b6b-40a8-b48f-8a6184577a07",
                                "sense_id": "cfbeed27-100e-3bfa-b440-903f6f06641b",
                                "text": "D’abord parce que, jusque-là, les tifinaghs s’inscrivaient non pas sur le papier, mais sur des rochers, pour indiquer une direction, ou sur le sable, pour parler d’amour."
                            }
                        ]
                    }
