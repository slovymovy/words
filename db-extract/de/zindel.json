                    {
                        "sense_id": "5194cf31-c82e-3e96-8d63-f556173cba16",
                        "entry_id": "12b7ad6c-4784-3963-bcee-c424279d4304",
                        "glosses": [
                            "dünner seidener Stoff, der oft zum Füttern, Unterlegen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ed94ff-8d56-4d5b-bbcd-5604be81ffa9",
                                "sense_id": "5194cf31-c82e-3e96-8d63-f556173cba16",
                                "text": "„hier wird er ganz entkleidet, daß er so nackt ist, wie ihn seine Mutter geboren, mit lauem Wasser gebadet, und mit schön duftenden Salben gesalbt, dann wird er mit einem Hemde vom feinsten Zindel bekleidet , das Wohlgeruch duftet“"
                            },
                            {
                                "example_id": "f8bffd8e-1cf9-41f1-839b-77e727a2b268",
                                "sense_id": "5194cf31-c82e-3e96-8d63-f556173cba16",
                                "text": "„Gen Ribe gieng Herrn Esberns Zug, Er käuft sich Zindel und Seide gnug. Er käuft sich Zindel und Seide fein; Das Alles schickt er dem Mägdelein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
