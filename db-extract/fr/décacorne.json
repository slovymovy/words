                    {
                        "sense_id": "dbc4545a-ee03-3fdc-add4-e7b2e4cdcc80",
                        "entry_id": "67878f6a-16a1-34ec-8601-cffb6147a177",
                        "glosses": [
                            "Startup évaluée à plus de 10 milliard de dollars et qui est financée par un fonds de capital-risque."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "a614ab79-6dbc-41d2-b221-bd9b0a5bc70e",
                                "sense_id": "dbc4545a-ee03-3fdc-add4-e7b2e4cdcc80",
                                "text": "Pour les décrire, ces entreprises ont fait naître de nouveaux termes : «licorne» (valorisées de 1 milliard à 10 milliards de dollars), «décacorne» (de 10 à 49,9 milliards) et bientôt les «pentacornes» (plus de 50 milliards)."
                            },
                            {
                                "example_id": "ff411f5c-98a3-48f1-a5fc-76c6e8406e3f",
                                "sense_id": "dbc4545a-ee03-3fdc-add4-e7b2e4cdcc80",
                                "text": "Slack devient donc une « décacorne » (une start-up valorisée au moins 10 milliards de dollars)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8e42238-aa08-4952-81a3-02e77da92d33",
                        "source_entry_id": "67878f6a-16a1-34ec-8601-cffb6147a177",
                        "source_sense_id": "dbc4545a-ee03-3fdc-add4-e7b2e4cdcc80",
