                    {
                        "translation_id": "504fb03d-ccad-40e7-b0eb-fd639b820a68",
                        "source_entry_id": "f1ec33ce-a8fe-3666-b56d-d87c2222065f",
                        "source_sense_id": "ffc0d146-19f4-36b1-ba38-747134f34890",
