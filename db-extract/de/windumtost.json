                "senses": [
                    {
                        "sense_id": "86c11c1f-2c66-3790-91ab-5b9f7e894866",
                        "entry_id": "5be99c97-8a27-392b-93ce-53d8329a1b28",
                        "glosses": [
                            "von starken Winden umweht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ec3702-3d2a-45b5-880e-843d4f4c38bb",
                                "sense_id": "86c11c1f-2c66-3790-91ab-5b9f7e894866",
                                "text": "„Meine Abende verbrachte ich oft am windumtosten Rand des Plateaus, einem der interessantesten Orte in Zak.“"
                            },
                            {
                                "example_id": "4e27c80c-d328-4edb-ab31-69f545644d3e",
                                "sense_id": "86c11c1f-2c66-3790-91ab-5b9f7e894866",
                                "text": "„Tausend Kilo weißes Pulver über den Ozean, dann auf dem Landweg quer durch Europa, von den windumtosten Küsten Portugals bis in die kalten Straßen Berlins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
