                    {
                        "sense_id": "81d489bc-aa96-35a9-b9e3-8e9e96da48ae",
                        "entry_id": "e0433bd2-3702-3184-bdc3-367c2507172c",
                        "glosses": [
                            "Nom usuel d'un arbre de la famille des Euphorbiaceae, des régions tropicales du sud-est de l'Asie, nommé Vernicia cordata, et anciennement Elaeococca cordata ou Aleurites cordata. On peut extraire de l'huile de ses graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93bc581-64c4-4b83-98b4-322386044b7c",
                                "sense_id": "81d489bc-aa96-35a9-b9e3-8e9e96da48ae",
                                "text": "L’abrasin est un arbre qui croît rapidement en hauteur."
                            },
                            {
                                "example_id": "1439bf09-2cbd-40f0-9385-208ba358d9ad",
                                "sense_id": "81d489bc-aa96-35a9-b9e3-8e9e96da48ae",
                                "text": "Le mortier à l'huile d'abrasin est signalé en Chine où l'on confectionne depuis longtemps, nous dit-on en 1903, d'excellents mortiers, mastics et enduits hydrofuges en malaxant, dans un mortier à riz, de la chaux en poudre avec l'huile très siccative extraite des fruits de l'abrasin ou faux bancoulier."
                            }
                        ]
                    }
