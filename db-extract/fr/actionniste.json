                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e585ae3-8e2d-41c5-8f51-68e5f476fac9",
                                                "sense_id": "4bdd7323-ed2a-396b-9d8d-7cc7c33e469f",
                                                "text": "De aandeelhouders werden erg zenuwachtig over een mogelijk naderende beurskrach."
                                            },
                                            {
                                                "example_id": "1ac4cf25-8f3d-4c0d-8879-5549920a4440",
                                                "sense_id": "4bdd7323-ed2a-396b-9d8d-7cc7c33e469f",
                                                "text": "Nadat ik mijn verhaal had gedaan, vertelde Tom dat hij heeft ontdekt dat de vijf procent van het verkoopbedrag van iedere vervalsing naar een Zwitserse GmbH ging waarvan Heinz Kramm nog steeds enig aandeelhouder is."
                                            },
                                            {
                                                "example_id": "3a45c49d-89b5-48cc-81eb-a58bc1523aa9",
                                                "sense_id": "4bdd7323-ed2a-396b-9d8d-7cc7c33e469f",
                                                "text": "'Heeft dan echt niemand van jullie bedacht dat mij dit als aandeelhouder ook aangaat?' Lauren is de eerste die haar mond opendoet."
                                            }
