                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "18271fd6-50fe-3e72-a461-6cc5fbf36776",
                        "entry_id": "88fbf758-b34a-3488-8867-d2531c05be1d",
                        "glosses": [
