    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91fe7ded-d35b-3108-9f12-2d1cdbe95856",
                    "sense_definition": "Changer, se modifier ou fluctuer au cours du temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La température <w>varie</w> souvent de façon spectaculaire entre le jour et la nuit."
                        },
                        {
                            "text": "Le prix du carburant continue de <w>varier</w> au fil des semaines."
                        }
                    ],
                    "synonyms": [
                        "changer",
                        "fluctuer",
                        "osciller"
                    ],
                    "antonyms": [
                        "stagner"
                    ],
                    "common_phrases": [
                        "varier dans le temps",
                        "varier d'intensité"
                    ]
                },
                {
                    "sense_id": "96c59b36-200c-3df1-a512-a026a1a2f493",
                    "sense_definition": "Être différent selon les circonstances, les personnes ou les lieux.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les coutumes locales <w>varient</w> selon les régions traversées au cours du voyage."
                        },
                        {
                            "text": "Le temps de trajet peut <w>varier</w> d'un jour à l'autre en fonction du trafic."
                        }
                    ],
                    "synonyms": [
                        "différer"
                    ],
                    "common_phrases": [
                        "varier selon les régions",
                        "varier d'une personne à l'autre"
                    ]
                },
                {
                    "sense_id": "8e326b41-4e2c-3809-a3f4-1734c3a18d2f",
                    "sense_definition": "Diversifier ou rendre différent pour éviter l'uniformité ou la monotonie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "diversification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est recommandé de <w>varier</w> son alimentation pour conserver une excellente santé."
                        },
                        {
                            "text": "Le professeur cherche toujours à <w>varier</w> les exercices afin de captiver les élèves."
                        }
                    ],
                    "synonyms": [
                        "diversifier",
                        "alterner"
                    ],
                    "antonyms": [
                        "uniformiser"
                    ],
                    "common_phrases": [
                        "varier les plaisirs",
                        "varier son alimentation"
                    ]
                },
                {
                    "sense_id": "1b70b5a0-bee7-3723-a6f3-ca8d6a212dfa",
                    "sense_definition": "Être d'avis différent ou rapporter un même fait de manières divergentes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "divergence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les avis des experts <w>varient</w> quant à la gravité exacte de cette crise financière."
                        },
                        {
                            "text": "Les témoins <w>variaient</w> sur plusieurs détails cruciaux lors de leurs dépositions devant le juge."
                        }
                    ],
                    "synonyms": [
                        "diverger"
                    ],
                    "antonyms": [
                        "s'accorder"
                    ],
                    "common_phrases": [
                        "les avis varient"
                    ]
                },
                {
                    "sense_id": "e4bd7796-9961-3ae8-ba8f-80bda9cadbbb",
                    "sense_definition": "Dévier par rapport au nord magnétique en parlant d'une aiguille de boussole.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navigateur a constaté que l'aiguille magnétique <w>variait</w> légèrement sous l'influence du gisement de fer."
                        },
                        {
                            "text": "À cette latitude extrême, la boussole peut <w>varier</w> de plusieurs degrés par rapport au nord."
                        }
                    ],
                    "synonyms": [
                        "dévier"
                    ],
                    "common_phrases": [
                        "varier de quelques degrés"
                    ]
                }
            ]
        }
    ]
