                    "sense_definition": "En imposer aux autres en étalant sa fortune ou son luxe de manière ostentatoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
