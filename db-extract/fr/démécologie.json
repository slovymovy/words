                        "glosses": [
                            "Écologie des populations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d3f8dd-5c21-45c0-bcb3-9e945393e731",
                                "sense_id": "0315f2dc-869d-3248-969a-394931a41809",
                                "text": "En démécologie (écologie des populations) ou en biologie des populations, on parle de prolifération ou de pullulation à propos d’une espèce qui se reproduit abondamment dans un environnement donné."
                            },
                            {
                                "example_id": "d3eb2b95-eed8-4374-a901-10334e22e509",
                                "sense_id": "0315f2dc-869d-3248-969a-394931a41809",
                                "text": "Cet ouvrage consacré à l’autoécologie, c’est-à-dire à l’étude des relations entre l’individu en tant que tel (ou représentant type de son espèce) et son « environnement », est la réédition de la première partie d’un ensemble de trois volumes consacrés à l’écologie animale, les volumes II et III traitant respectivement de la démécologie (écologie des populations) et de la synécologie (écologie des communautés)."
                            }
                        ]
                    }
