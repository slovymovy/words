                "senses": [
                    {
                        "sense_id": "e81269f3-9022-38b1-b13e-53ec95df3495",
                        "entry_id": "34764870-669e-325e-8396-dbb2d9690ba5",
                        "glosses": [
                            "Variante de carapater : partir rapidement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3ac0fb-6c9c-41a8-97a5-52a8152100d6",
                                "sense_id": "e81269f3-9022-38b1-b13e-53ec95df3495",
                                "text": "Nous avons observé le même style d’investisseur sur Biomérieux, qui décarapatent dès que cela chauffe."
                            },
                            {
                                "example_id": "4bb316d8-fb3c-4ed1-ac86-b0af831a3d10",
                                "sense_id": "e81269f3-9022-38b1-b13e-53ec95df3495",
                                "text": "Il n’est rentré rue de Courty qu’à 8 h du soir, je m’y couchais pour me décarapater mardi à 8h1/2 de façon à pouvoir rentrer dîner et coucher."
                            },
                            {
                                "example_id": "123a45d1-d8c7-4044-a86f-2042dab24223",
                                "sense_id": "e81269f3-9022-38b1-b13e-53ec95df3495",
                                "text": "Pris de désirs indépendants, Si l’un d’eux se décarapate, Le marchand, brutal, le prend dans Sa grosse patte, Et rejette au milieu du tas Cet être mou qui fait le brave… Lui, ça le met dans des états !… Il rage ; il bave !…"
                            }
                        ]
                    }
