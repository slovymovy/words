                "senses": [
                    {
                        "sense_id": "af15c17d-0426-3239-9786-9c04b125565e",
                        "entry_id": "8b2acd73-97aa-3596-bc70-6a913d52ae18",
                        "glosses": [
                            "Ridicule, niais."
                        ],
