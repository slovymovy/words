            {
                "entry_id": "a40b59a3-2401-3dbc-8c03-02262d357ddf",
                "word": "ocha",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "652019bb-b878-3ef9-a6c6-5e795e19edd5",
                        "entry_id": "a40b59a3-2401-3dbc-8c03-02262d357ddf",
                        "glosses": [
                            "Japanese tea, usually green tea."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a07722c-e004-488d-9377-bc5cbf48c61f",
                                "sense_id": "652019bb-b878-3ef9-a6c6-5e795e19edd5",
                                "text": "Right now I am drinking ocha and listening to the rain whipping across the windowpanes."
                            },
                            {
                                "example_id": "f04fb9d3-dc6a-4ae2-883b-2df7a22ce1ed",
                                "sense_id": "652019bb-b878-3ef9-a6c6-5e795e19edd5",
                                "text": "In the winters, they would sit together in the tiny attic space that the old man had been occupying in the house for the past 25 years and drink hot ocha as Rakesh-7 wove together seemingly simple threads into complex and detailed narrations […]"
                            },
                            {
                                "example_id": "957347ac-ce15-4443-ab6a-30c9cbb01505",
                                "sense_id": "652019bb-b878-3ef9-a6c6-5e795e19edd5",
                                "text": "Before each she quickly dispatched a bowl of miso soup, a small but steaming cup of ocha (green tea), some sushimi (raw fish), sukiyaki, boiled rice, octopus, udon noodles and some eel and sushi."
                            },
                            {
                                "example_id": "f595c272-8109-4259-8fe4-40a6728d929f",
                                "sense_id": "652019bb-b878-3ef9-a6c6-5e795e19edd5",
                                "text": "Good quality tea can be steeped up to five times as the flavor evolves and becomes more subtle with each steep. In this way, we honor the tea plant and the labor of the many hands that create a single cup of ocha."
                            }
                        ]
                    }
                ],
