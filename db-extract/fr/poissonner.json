                ],
                "senses": [
                    {
                        "sense_id": "050ee4a7-76e2-3b40-9a10-b1bfce6cac5d",
                        "entry_id": "05a5cbd9-8563-3839-8f6c-caa036a3e51b",
                        "glosses": [
                            "Empoissonner."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0321c9d5-8c5c-472c-91a1-f8162b4779f0",
                                "sense_id": "050ee4a7-76e2-3b40-9a10-b1bfce6cac5d",
                                "text": "M. Grandis a eu l’heureuse idée de poissonner toutes les sources qui découlent des lacs de Merveilles."
                            },
                            {
                                "example_id": "f083a9d2-5c8d-4b7e-98eb-59b320500c4e",
                                "sense_id": "050ee4a7-76e2-3b40-9a10-b1bfce6cac5d",
                                "text": "Votre pétitionnaire démontre aussi qu’on ne trouve dans aucune partie du lac Érié et de nos eaux de l’ouest, au-dessus des Chutes de Niagara, de ce poisson succulent et délicieux qu’on appelle anguille, et étant persuadé que la nappe d’eau dormante appelée Rondeau, (tel qu’indiquée sur le plan) est tout-à-fait convenable pour ces poissons, lesquels seraient pour lui une source de profit dans peu d’années, il désire ardemment que cette eau soit comprise dans son bail, voulant entreprendre de la poissonner dans deux ans de temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c36d19a-4412-3e88-8a19-3c36f2bc6478",
                        "entry_id": "05a5cbd9-8563-3839-8f6c-caa036a3e51b",
                        "glosses": [
                            "Attraper du poisson."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "54cdaa66-8211-45d1-b62a-88a582f7799b",
                                "sense_id": "0c36d19a-4412-3e88-8a19-3c36f2bc6478",
                                "text": "La ligne est bien, dit Collard; ça va poissonner, y a plus qu’à espérer."
                            },
                            {
                                "example_id": "2e81a806-3df1-4669-a32f-d47858b5831f",
                                "sense_id": "0c36d19a-4412-3e88-8a19-3c36f2bc6478",
                                "text": "Toutefois, à cette époque, il quittait chaque matin le voilier pour haler les cordes qui, tendues la veille au soir, avaient « poissonné » toute la nuit."
                            }
                        ]
                    },
                    {
                        "sense_id": "037a4162-8cb7-3ed5-9f97-75b7ebf839b5",
                        "entry_id": "05a5cbd9-8563-3839-8f6c-caa036a3e51b",
                        "glosses": [
                            "Attraper (comme du poisson)."
                        ],
                        "tags": [
                            "définition à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "2c4dfdce-a60c-4826-a438-a6c812f3982e",
                                "sense_id": "037a4162-8cb7-3ed5-9f97-75b7ebf839b5",
                                "text": "je n’ai pas jugé à propos, de me faire poissonner la veille de Paques, après avoir eu patience pendant plus que quatre ans."
                            },
                            {
                                "example_id": "b192e313-9e62-404f-84e7-24a1b4c9d85d",
                                "sense_id": "037a4162-8cb7-3ed5-9f97-75b7ebf839b5",
                                "text": "Voilà un homme qui se fait poissonner la veille de Pâques;"
                            }
                        ]
                    }
                ],
