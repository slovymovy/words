                            },
                            {
                                "target_word": "optique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "386e387a-dcad-331d-82f1-6dd473acbce6",
                                        "entry_id": "c8630466-6dff-32c4-9d0e-85d5a33a4490",
                                        "glosses": [
                                            "Partie de la physique qui étudie les phénomènes lumineux et les lois de la vision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07ffddc2-665f-4466-a1e2-72b7bee5cb68",
                                                "sense_id": "386e387a-dcad-331d-82f1-6dd473acbce6",
                                                "text": "Traité d’optique."
                                            },
                                            {
                                                "example_id": "cd330a99-a8b8-4d9e-8c24-22329e94db74",
                                                "sense_id": "386e387a-dcad-331d-82f1-6dd473acbce6",
                                                "text": "Instruments d’optique."
                                            },
                                            {
                                                "example_id": "b9e0de44-1ffd-400d-9d97-98b921bce54c",
                                                "sense_id": "386e387a-dcad-331d-82f1-6dd473acbce6",
                                                "text": "Une illusion d’optique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d014f5-8303-3aee-a70e-96812a7a6876",
                                        "entry_id": "c8630466-6dff-32c4-9d0e-85d5a33a4490",
                                        "glosses": [
                                            "Manière d’observer une situation, un événement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067b4e26-ad72-48b5-80de-cdd961b8d983",
                                                "sense_id": "39d014f5-8303-3aee-a70e-96812a7a6876",
                                                "text": "L’optique du théâtre, l’optique de la scène, se dit de la nécessité où est l’auteur dramatique de présenter d’une certaine manière, avec un certain grossissement, les personnages ou les effets destinés à être vus au théâtre dans l’éloignement de la scène."
                                            },
                                            {
                                                "example_id": "112060ca-241c-44f1-a31f-c3e1f608a3f2",
                                                "sense_id": "39d014f5-8303-3aee-a70e-96812a7a6876",
                                                "text": "Ce décor est peint avec beaucoup plus de fini qu’il ne convient pour l’optique du théâtre."
                                            },
                                            {
                                                "example_id": "b92517c4-e69d-49ef-b704-ced4d3b44bd0",
                                                "sense_id": "39d014f5-8303-3aee-a70e-96812a7a6876",
                                                "text": "- Décidément, ce garçon doit avoir une optique particulière quant à la beauté des femmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac7f7af7-f7ed-3c20-b9eb-440914771b5c",
                                        "entry_id": "c8630466-6dff-32c4-9d0e-85d5a33a4490",
                                        "glosses": [
                                            "Événement ou ensemble d'événements futurs envisagés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e57db75f-efb3-3b25-9c39-65fc99dbcb07",
                                        "entry_id": "c8630466-6dff-32c4-9d0e-85d5a33a4490",
                                        "glosses": [
                                            "Lentille utilisée dans un appareil photo, une caméra, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1c42006-6985-4943-9d13-92cdfa4658de",
                                                "sense_id": "e57db75f-efb3-3b25-9c39-65fc99dbcb07",
                                                "text": "J’ai toujours de bonnes photos aussi parce que Minolta est un des seuls à fabriquer lui-même toutes ses optiques."
                                            }
                                        ]
                                    }
                                ]
                            }
