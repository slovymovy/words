                                "sense_id": "938b9055-02cf-3f35-a11b-9a7119970ab6",
                                "text": "The horizon was distantly visible in the grey light of dawn."
                            },
                            {
                                "example_id": "50f0ca72-0419-4466-9e32-44c6011fa34c",
                                "sense_id": "938b9055-02cf-3f35-a11b-9a7119970ab6",
                                "text": "I’m distantly related to the truly great writer, Chaim Potok, which for a magazine editor seems like a good thing."
                            }
