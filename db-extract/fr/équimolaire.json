                                        "glosses": [
                                            "ein einem Mischungsverhältnis 1:1; dieselbe Anzahl Molen in einer Menge enthaltend"
                                        ],
                                        "tags": [
                                            "auf Stoffmengen und -gemische bezogen"
                                        ],
