                                            {
                                                "example_id": "caa14eef-68f6-459a-a0ae-cb2e2a0921e0",
                                                "sense_id": "c5c74f3e-4fc9-31f3-9b5f-d79596753c10",
                                                "text": "En 1886, nous avons présenté à la Société de biologie un seringue à injections hypodermiques stérilisable par la chaleur."
                                            },
                                            {
                                                "example_id": "7d67da86-ec9a-47a9-aa81-131dfd3d5e22",
                                                "sense_id": "c5c74f3e-4fc9-31f3-9b5f-d79596753c10",
                                                "text": "Le choix du matériel stérilisable ou du matériel jetable ne répond pas qu’à des préoccupations économiques mais aussi à des contraintes administratives et réglementaires."
                                            },
                                            {
                                                "example_id": "f12d7965-dd30-4615-b175-04c30c5c246b",
                                                "sense_id": "c5c74f3e-4fc9-31f3-9b5f-d79596753c10",
                                                "text": "Le PETG est stérilisable, ce qui en fait un bon matériau pour les implants médicaux ainsi que pour les emballages de produits pharmaceutiques et de dispositifs médicaux."
                                            }
                                        ]
