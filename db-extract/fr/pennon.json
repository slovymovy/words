        "fr-extract.jsonl": [
            {
                "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                "word": "pennon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f0ae079b-ed62-43f6-9778-dab5829847a8",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "tags": [
                            "plural"
                        ],
                        "form": "pennons"
                    },
                    {
                        "form_id": "508beea6-06ee-40c4-9319-44a473920278",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "tags": [],
                        "form": "penon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fbca1a1-5928-3b0f-a5d3-d7b17509f631",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "Sorte d’étendard en forme de queue d’oiseau, en usage au temps de la chevalerie. Un chevalier devait commander au moins vingt hommes pour avoir le droit de l'arborer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c197dc25-5c3d-4aeb-96b1-c242cda2bfed",
                                "sense_id": "6fbca1a1-5928-3b0f-a5d3-d7b17509f631",
                                "text": "Vous tous qui avez vu ces panaches, ces aigrettes, ces plumes flottantes, ces pennons surmontés du coq gaulois et laissant déployer au vent les couleurs de l’indépendance."
                            },
                            {
                                "example_id": "718dd115-89ad-4236-8e44-5ad7240510e4",
                                "sense_id": "6fbca1a1-5928-3b0f-a5d3-d7b17509f631",
                                "text": "Le voilà dans sa bonne armure de Milan, avec sa puissante dague à moitié tirée, et son pennon arboré !"
                            },
                            {
                                "example_id": "e5a49357-c17b-4627-8310-11f68d129f8d",
                                "sense_id": "6fbca1a1-5928-3b0f-a5d3-d7b17509f631",
                                "text": "Plus haut, une trentaine de paons tendaient leurs pennons colorés comme des flèches de direction."
                            }
                        ]
                    },
                    {
                        "sense_id": "ecf19e46-73f3-3cbf-9f59-49c6887c65f1",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "Petite bande de tissu attachée aux haubans d'un voilier et servant à définir la direction du vent, pour aider le barreur à se positionner."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "77735dfb-2dbb-3f57-be7a-b068cce6e34f",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "Girouette faite de petites plumes montées sur des morceaux de liège traversés d’un fil, qu’on laisse flotter au gré du vent pour en connaître la direction ; on y substitue souvent une petite flamme d’étamine qui remplit le même objet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7f36f321-3dca-3223-85df-9559e609e08a",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "Milices urbaines de la ville de Lyon, entre 1228 et 1789, remplacé par les sections puis par les arrondissements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a9913d-31b9-4cba-9936-8205bf72c958",
                                "sense_id": "7f36f321-3dca-3223-85df-9559e609e08a",
                                "text": "Les pennons sont donc au départ une organisation à des fins de défense des libertés communales."
                            },
                            {
                                "example_id": "96c79dd6-53d7-4046-90f0-6f6058a10e41",
                                "sense_id": "7f36f321-3dca-3223-85df-9559e609e08a",
                                "text": "[Les] dignitaires ne représentent pas davantage les cadres de la milice urbaine des pennons : les grades qui lui sont propres (pennons, quarteniers, dizainiers) n’apparaissent jamais dans la Magnificience, pas plus que les titres cérémoniels ne figurent dans les Établies."
                            }
                        ]
                    },
                    {
                        "sense_id": "54858799-7be4-3f29-8839-d36ead630f26",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "À Lyon, capitaine d’un pennon."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9f22f309-89cf-3622-a4dc-a062506eb4cc",
                        "entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "glosses": [
                            "Meuble représentant la bannière du même nom dans les armoiries. Il est rarement représenté seul mais plutôt comme complément à un autre meuble (agneau pascal, navire, château, chevalier…). Il est généralement figuré attaché à un mât, flottant au vent, long et fourché. À rapprocher de bannière, étendard, gonfanon, guidon, oriflamme et pavillon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027d32c9-f0d3-4407-908e-80692b7e8bcf",
                                "sense_id": "9f22f309-89cf-3622-a4dc-a062506eb4cc",
                                "text": "D’azur à la tour donjonnée d’argent, ouverte et ajourée de sable, sommée d’un pennon de gueules chargé d’une croix d’or, qui est de la commune de Châteauvieux des Hautes-Alpes → voir illustration « armoiries avec un pennon »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9a942ca-13e9-42ee-b9d5-6a7be9b5c598",
                        "source_entry_id": "ceedc636-fa07-3613-819f-89fe27552a39",
                        "target_lang_word": "pennon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pennon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                        "entry_id": "0e4a90f8-c3ef-33f6-b8c7-2148e95a730c",
                                        "glosses": [
                                            "A thin, often triangular flag or streamer, especially as hung from the end of a lance or spear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "404a8960-7b24-4e69-833a-5b115c48d921",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "Her yellow lockes crisped, like golden wyre,\nAbout her shoulders weren loosely shed,\nAnd when the winde emongst them did inspyre,\nThey waued like a penon wyde dispred\nAnd low behinde her backe were scattered:"
                                            },
                                            {
                                                "example_id": "2704fbbc-7cff-483c-b804-949c51943155",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "Bar Harry England, that sweeps through our land\nWith pennons painted in the blood of Harfleur:"
                                            },
                                            {
                                                "example_id": "014019dd-9dc2-47b8-ae33-ad132d8c0f4c",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "[…] in spite of a sort of screen intended to protect them from the wind, the flame of the torches streamed sideways into the air, like the unfurled pennon of a chieftain."
                                            },
                                            {
                                                "example_id": "0e5dd681-9713-4b76-ac1e-f738d5d5d3fe",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "Precisely in the middle of the quadrangle were placed perpendicularly in the ground, a hundred or more slender, fresh-cut poles, stripped of their bark, and decorated at the end with a floating pennon of white tappa;"
                                            },
                                            {
                                                "example_id": "e8bb78cb-0221-4e3f-a878-7d952b115e5b",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "1863, Christina Rossetti, “A Royal Princess” in Isa Craig (ed.), An Offering to Lancashire, London: Emily Faithfull, p. 3,\nVassal counts and princes follow where his pennon goes,"
                                            },
                                            {
                                                "example_id": "1047e46d-a1e9-41e4-823b-24b69076f5c4",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "Nearly all the Norman spears were embellished with pennons of from two to five points."
                                            },
                                            {
                                                "example_id": "50dba443-51a6-479b-9a02-065917d76c92",
                                                "sense_id": "0a2b5f8a-da93-3946-ae5c-ab13936c0d76",
                                                "text": "In 1821 the hobby-horse could have a real mane and a pretty topknot of wire, pennons and bells but with no wheels at the back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c13e4d9c-c04c-3cb3-ad61-6a3f4f075539",
                                        "entry_id": "0e4a90f8-c3ef-33f6-b8c7-2148e95a730c",
                                        "glosses": [
                                            "A long pointed streamer or flag on a vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6ac881a-ba5f-4032-b3b2-b9d61ff0071f",
                                                "sense_id": "c13e4d9c-c04c-3cb3-ad61-6a3f4f075539",
                                                "text": "1631, Michael Drayton, The Battaile of Agincourt, London: William Lee, p. 21,\n… a ship most neatly that was lim’d,\nIn all her sailes with Flags and Pennons trim’d."
                                            },
                                            {
                                                "example_id": "e4179997-a998-46bd-85c8-13f67f84ca8f",
                                                "sense_id": "c13e4d9c-c04c-3cb3-ad61-6a3f4f075539",
                                                "text": "1780, Hannah Cowley, The Maid of Arragon, London: L. Davis et al.,\nFair Commerce wav’d her pennons in our ports;"
                                            },
                                            {
                                                "example_id": "75510191-817e-4d04-9f4a-3ea13bab78ce",
                                                "sense_id": "c13e4d9c-c04c-3cb3-ad61-6a3f4f075539",
                                                "text": "[…] as his eye swept the horizon, clear against the rosy sky shone the white sails of a ship, so near that they could see the pennon at her mast-head and black figures moving on the deck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d5580f-3163-3911-9c15-9a5a123fbb2f",
                                        "entry_id": "0e4a90f8-c3ef-33f6-b8c7-2148e95a730c",
                                        "glosses": [
                                            "A wing (appendage of an animal's body enabling it to fly); any of the outermost primary feathers on a wing."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d5c4ca5-5d4a-4068-8260-b80524989b65",
                                                "sense_id": "74d5580f-3163-3911-9c15-9a5a123fbb2f",
                                                "text": "1630, Henry Lord, A Display of Two Forraigne Sects in the East Indies, London: Francis Constable, “The Religion of the Persees,” Chapter 4, p. 16,\n[…] sodainly there descended before him, as his face was bent towards the earth, an Angell, whose wings had glorious Pennons, and whose face glistered as the beames of the Sunne,"
                                            },
                                            {
                                                "example_id": "6d575386-b315-47f1-985b-f4a06685c4d3",
                                                "sense_id": "74d5580f-3163-3911-9c15-9a5a123fbb2f",
                                                "text": "Fluttring his pennons vain plumb down he [Satan] drops\nTen thousand fadom deep,"
                                            },
                                            {
                                                "example_id": "99534c42-3ca1-45df-b3d0-0d47917c8075",
                                                "sense_id": "74d5580f-3163-3911-9c15-9a5a123fbb2f",
                                                "text": "Favonius gentle skims along the Grove,\nAnd sheds sweet Odors from his Pennons light."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b668df6-2cb5-4076-a7ab-cfbbffe9f279",
