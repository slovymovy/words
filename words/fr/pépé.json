                    "examples": [
                        {
                            "text": "Ce vieux <w>pépé</w> marche lentement tous les matins jusqu'à la boulangerie du quartier.",
                            "target_lang_translations": {
                                "en": "That <w>old man</w> walks slowly every morning to the neighbourhood bakery.",
                                "ru": "Этот <w>старик</w> каждое утро медленно идёт до местной булочной.",
                                "de": "Dieser alte <w>Mann</w> geht jeden Morgen langsam bis zur Bäckerei im Viertel.",
                                "es": "Ese <w>viejo</w> camina despacio todas las mañanas hasta la panadería del barrio.",
                                "zh": "这个<w>老头</w>每天早上都慢慢走到附近的面包店去。"
                            }
                        },
                        {
                            "text": "Plusieurs <w>pépés</w> jouent tranquillement à la pétanque à l'ombre des platanes.",
                            "target_lang_translations": {
                                "en": "Several <w>old men</w> play pétanque quietly in the shade of the plane trees.",
                                "ru": "Несколько <w>стариков</w> спокойно играют в петанк в тени платанов.",
                                "de": "Mehrere alte <w>Männer</w> spielen ruhig Pétanque im Schatten der Platanen.",
                                "es": "Varios <w>viejos</w> juegan tranquilamente a la petanca a la sombra de los plátanos.",
                                "zh": "几个<w>老头</w>在梧桐树的树荫下安静地玩法式滚球。"
                            }
