                        "glosses": [
                            "Variante de paperolle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d296f4-4efa-45e9-80e1-b9944c3f0b70",
                                "sense_id": "0b2ef3ce-43c9-3b09-b0cc-4f6208285124",
                                "text": "[…], les premières paperoles sont comme tassées, imitant des feuillages et des rinceaux sculptés avec une certaine lourdeur, sur un seul plan. […]. Plus tard, les sœurs hachurent la tranche avec un petit canif, multipliant la brillance de la paperole, utilisent des papiers colorés sur le plat, superposent et enchevêtrent les bandes de papier, ce qui enrichit encore leurs compositions."
                            },
                            {
                                "example_id": "fc73f341-5516-45cc-8c97-ae24570217d9",
                                "sense_id": "0b2ef3ce-43c9-3b09-b0cc-4f6208285124",
                                "text": "Car le verso des deux paperoles collées constitue une aire d'inscription plus importante, qui permet d'aligner l'écriture en un mouvement réorienté vers le verso 11 d'origine […]."
                            },
                            {
                                "example_id": "3704fbc4-a6dd-4bb7-8b9d-0b5b0ca3f62f",
                                "sense_id": "0b2ef3ce-43c9-3b09-b0cc-4f6208285124",
                                "text": "Je déplie une paperole de An sur Katia : Katia est une femme admirable, contrairement à Marie. J'ai décidé d'aider Katia à revoir son amant et à revivre charnellement avec lui, […]."
                            }
                        ]
                    }
