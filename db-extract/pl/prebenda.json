                                "target_senses": [
                                    {
                                        "sense_id": "70a20f2c-43f6-3253-854e-ff27ef8c4d89",
                                        "entry_id": "9b7b262c-e376-3b4e-930c-4a90a4ca6abe",
                                        "glosses": [
                                            "A stipend paid to a canon of a cathedral."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "472a1775-f163-3b0a-884d-c0539a499b6f",
                                        "entry_id": "9b7b262c-e376-3b4e-930c-4a90a4ca6abe",
                                        "glosses": [
                                            "The property or other source of this endowment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c397a7f6-9a49-4542-a0af-80a180cebb4f",
                                                "sense_id": "472a1775-f163-3b0a-884d-c0539a499b6f",
                                                "text": "He is said to have added prebends to Southwell; it is more probable that he gave estates to the church which were afterwards made into separate prebends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c6d75b-f5cc-3fc1-89e7-91631b87f0cb",
                                        "entry_id": "9b7b262c-e376-3b4e-930c-4a90a4ca6abe",
                                        "glosses": [
                                            "Political patronage employment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd92a414-4f38-37bd-8431-ae965774b1d6",
                                        "entry_id": "9b7b262c-e376-3b4e-930c-4a90a4ca6abe",
                                        "glosses": [
                                            "A prebendary."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d07e00a-a4a4-4a38-920c-e0217e3296d5",
                                                "sense_id": "fd92a414-4f38-37bd-8431-ae965774b1d6",
                                                "text": "c. 1593, Francis Bacon, letter to Sir Thomas Coneysby\na lease of the prebend of Withington"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prebend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "991cc330-b8c1-3e37-bb67-471f61f34e61",
                                        "entry_id": "7749d5fd-2574-334e-b0e0-b405578540c4",
                                        "glosses": [
                                            "To bend in advance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a385d155-2453-4bc1-9223-8691c8967c80",
                                                "sense_id": "991cc330-b8c1-3e37-bb67-471f61f34e61",
                                                "text": "For large and/or dense bones compression plate fixation achieves absolute stability but the fragments have to be in contact remote to the plate by prebending the plate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64f821d2-8f14-43f4-ba96-6a1bedd32f5a",
                        "source_entry_id": "5e772343-a28b-3688-a914-6c5da664b74b",
                        "source_sense_id": "2a3fb570-a5f7-3820-a48a-4610719e15ed",
                        "target_lang_word": "bénéfice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bénéfice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "880ac5b8-186e-3577-8527-603944544ea3",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Gain ou profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fdeec3-760f-4402-8d1d-4ecbc6aad7e2",
                                                "sense_id": "880ac5b8-186e-3577-8527-603944544ea3",
                                                "text": "Il hypothéqua les biens de sa femme pour tenter une spéculation dont les bénéfices devaient restituer à sa famille toute sa première fortune ; mais cette entreprise acheva de le ruiner."
                                            },
                                            {
                                                "example_id": "19617a4e-5b92-41f9-9f64-83765d619ca8",
                                                "sense_id": "880ac5b8-186e-3577-8527-603944544ea3",
                                                "text": "Quand un Indien se présente au fort, les agents lui remettent autant de fiches de bois qu’il apporte de peaux, et, sur les lieux mêmes, il échange ces fiches contre des produits manufacturés. Avec ce système, la Compagnie, qui, d’ailleurs, fixe arbitrairement la valeur des objets qu’elle achète et des objets qu’elle vend, ne peut manquer de réaliser et réalise en effet des bénéfices considérables."
                                            },
                                            {
                                                "example_id": "fecf0c2b-07cf-44e4-acfb-e29cb96bb685",
                                                "sense_id": "880ac5b8-186e-3577-8527-603944544ea3",
                                                "text": "Souvent deux familles prennent une ferme indivise, et les bénéfices sont partagés proportionnellement au nombre d'enfants et aux services qu'ils rendent."
                                            },
                                            {
                                                "example_id": "98d95778-19e1-46e6-b6a5-5b911a7ce850",
                                                "sense_id": "880ac5b8-186e-3577-8527-603944544ea3",
                                                "text": "Dans le village Les Clérimois dans l'Yonne, un fonds de pension états-unien reçoit 12-15 % de retour sur investissement des quatre éoliennes qui y sont installées. La société française Poweo, après avoir financé la construction des moulins, a revendu l'ensemble avec bénéfice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab14d7b6-9861-3d77-a8f8-83f3f09ea451",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Avantage que procure quelque chose"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ddfef14-effe-4e48-966f-048de7bca56f",
                                                "sense_id": "ab14d7b6-9861-3d77-a8f8-83f3f09ea451",
                                                "text": "Arsène André étend ce mépris aux méthodes scolaires. […], une pédagogie qui refuse par système le bénéfice éprouvé des leçons sues par cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6803d1a-c101-3deb-8812-1afde70ef37f",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Droit de n’admettre une chose qu’avec certaines réserves."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e970f98b-55ff-407c-9e6f-c51f4a6b4e24",
                                                "sense_id": "f6803d1a-c101-3deb-8812-1afde70ef37f",
                                                "text": "Il est intéressant de noter au bénéfice de nos modernes souverainistes que des romantiques comme Mazzini, Michelet, Lamartine ou Hugo ne voyaient aucune contradiction entre nationalité et européanité."
                                            },
                                            {
                                                "example_id": "f47e655c-6230-4c1b-b475-865eecd5e878",
                                                "sense_id": "f6803d1a-c101-3deb-8812-1afde70ef37f",
                                                "text": "Sous le bénéfice de ces observations, je me range à votre opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c202baf9-8e96-3e41-b984-c5dfd8d5ff52",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Terre conquise dans la Gaule par les Francs et que les chefs ou princes distribuaient à leurs compagnons d’armes, dépositaires de la potestas sur un territoire donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93ff250f-3931-4319-90a8-66a201bf62f2",
                                                "sense_id": "c202baf9-8e96-3e41-b984-c5dfd8d5ff52",
                                                "text": "Originairement les bénéfices ou fiefs n’étaient donnés qu’à vie ; ensuite ils devinrent héréditaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba239657-f3fc-368b-a80f-254cbd32160e",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Titre ou dignité ecclésiastique accompagnée d’un revenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b3ef00-b67b-4ede-b7f2-1af34487360c",
                                                "sense_id": "ba239657-f3fc-368b-a80f-254cbd32160e",
                                                "text": "Je fis des progrès étonnans dans mes études. […]. Enchanté des dispositions que je montrois , mon protecteur voulut que je prisse le petit collet, & promit de me faire avoir au premier jour un bénéfice."
                                            },
                                            {
                                                "example_id": "7731643d-d8e2-4272-82da-354a25cd7f93",
                                                "sense_id": "ba239657-f3fc-368b-a80f-254cbd32160e",
                                                "text": "D’ailleurs, plusieurs riches bénéfices appartenaient à divers patronats, et étaient par conséquent, indépendans de l’élection royale."
                                            },
                                            {
                                                "example_id": "391075e3-7016-43a7-901f-611aab1276c5",
                                                "sense_id": "ba239657-f3fc-368b-a80f-254cbd32160e",
                                                "text": "Ainsi le secrétaire pour l’intérieur nomme à certains bénéfices ecclésiastiques, dans le petit nombre de ceux qui sont à la disposition du Roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe04281-7194-3ca9-8c8b-108968957b7f",
                                        "entry_id": "00799807-1879-39f1-addd-bbc742b0d7ec",
                                        "glosses": [
                                            "Lieu où étaient l’église et le bien du bénéfice."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aba4d8b-9373-415a-86f9-ccef3f09f7f8",
                                                "sense_id": "ffe04281-7194-3ca9-8c8b-108968957b7f",
                                                "text": "Guillaume du Temple a été fait chanoine de Saint-Julien du Sault, au diocèse de Sens. Cela ne suffit pas car Saint-Julien du Sault est une ville où peuvent exister plusieurs bénéfices."
                                            },
                                            {
                                                "example_id": "54780a2f-9434-457a-aaca-f93cc1a7f6ab",
                                                "sense_id": "ffe04281-7194-3ca9-8c8b-108968957b7f",
                                                "text": "Résider à son bénéfice, dans son bénéfice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc407ef3-ee44-49c3-b5c4-1a35276e4e36",
                        "source_entry_id": "5e772343-a28b-3688-a914-6c5da664b74b",
                        "source_sense_id": "2a3fb570-a5f7-3820-a48a-4610719e15ed",
