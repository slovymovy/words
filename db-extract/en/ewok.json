                "senses": [
                    {
                        "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                        "entry_id": "9d0fc1f3-acab-3fd9-ac6d-b6b3757684a1",
                        "glosses": [
                            "A member of a fictional, primitive race of teddy-bear-like creatures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7cc5dd8-20ef-410d-8234-7ffaa2639d46",
                                "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                                "text": "Those vampire-wanna-bes, who are actually cute in a Ewok/troll doll sort of way, pick their teeth nightly after a six-course wing fling."
                            },
                            {
                                "example_id": "e87a76ae-2c7e-4c3d-98f1-7fe45a8f81b1",
                                "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                                "text": "Tripping a walker the size of a house is difficult but not impossible. You will need high-tensile wire and suitably grounded posts. Ask your Ewok friends for help."
                            },
                            {
                                "example_id": "0b829375-b593-46b5-a0c0-91d6485bf194",
                                "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                                "text": "My answer to those who believe that all Bigfoot are just huge cuddly Ewoks is to remind them that there is plenty of evidence that every member of the great apes family […] has exhibited hostility […]."
                            },
                            {
                                "example_id": "5a0988ae-f59f-4c43-8c68-6f92eb635187",
                                "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                                "text": "She looked like a little plump Ewok, standing with Big Foot."
                            },
                            {
                                "example_id": "0fa13db3-cdd5-46ed-9012-0fd7994896d4",
                                "sense_id": "cbd854f9-eb9c-3c0b-9f11-ee58f768b918",
                                "text": "It’s been claimed that Jon has a string of mistresses, that Kate had an affair with her bodyguard and that Baby Number Six is actually a shaved Ewok with a catastrophic heroin addiction. Or something."
                            }
                        ]
                    }
                ],
