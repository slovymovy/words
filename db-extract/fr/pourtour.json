        "fr-extract.jsonl": [
            {
                "entry_id": "f04bdd34-c129-3ba9-9ae1-f15bf0dcccbb",
                "word": "pourtour",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d32ed10e-7804-4988-b958-7cbb192448d4",
                        "entry_id": "f04bdd34-c129-3ba9-9ae1-f15bf0dcccbb",
                        "tags": [
                            "plural"
                        ],
                        "form": "pourtours"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e42604ae-5e77-3d69-a6ca-6959fc544f15",
                        "entry_id": "f04bdd34-c129-3ba9-9ae1-f15bf0dcccbb",
                        "glosses": [
                            "Tour ou circuit de certaines choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfeca7b3-56b1-4caa-99cb-d9bb33245033",
                                "sense_id": "e42604ae-5e77-3d69-a6ca-6959fc544f15",
                                "text": "Ce pavillon, cette colonne a tant de pourtour. — Pourtour extérieur, intérieur."
                            },
                            {
                                "example_id": "780004e6-07fe-4c54-8a03-4481aa08fef6",
                                "sense_id": "e42604ae-5e77-3d69-a6ca-6959fc544f15",
                                "text": "Seize colonnes de marbre ornent le pourtour de cette rotonde."
                            },
                            {
                                "example_id": "9a4cf6d4-c5be-4d4e-835f-67a29798a70b",
                                "sense_id": "e42604ae-5e77-3d69-a6ca-6959fc544f15",
                                "text": "La chambre de Raoule était capitonnée de damas rouge et lambrissée, aux pourtours, de bois des îles sertis de cordelières de soie."
                            }
                        ]
                    },
                    {
                        "sense_id": "b096a7a4-488f-3b3b-9e1a-0742d797c3e3",
                        "entry_id": "f04bdd34-c129-3ba9-9ae1-f15bf0dcccbb",
                        "glosses": [
                            "Partie qui fait le tour d’un lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea6906f8-d3cf-4084-a559-78e8eb2a7ed6",
                                "sense_id": "b096a7a4-488f-3b3b-9e1a-0742d797c3e3",
                                "text": "On a donné au mur de pourtour du réservoir de la Dhuys 1m,70 d'épaisseur."
                            },
                            {
                                "example_id": "143a922c-62e2-4a07-a753-48809854024a",
                                "sense_id": "b096a7a4-488f-3b3b-9e1a-0742d797c3e3",
                                "text": "Mais le bal finissait… Il ne resta bientôt plus aux tables de pourtour que des Marseillais dont les femmes travaillaient dehors, des nègres, des boxeuses…."
                            },
                            {
                                "example_id": "2b49c7d8-f281-40a5-9c6c-b0210d10e0b8",
                                "sense_id": "b096a7a4-488f-3b3b-9e1a-0742d797c3e3",
                                "text": "Le pourtour est marqué par une ceinture de Phalaris arundinacea et de diverses Joncacées, dans laquelle apparaissent quelques plants d’Alnus glutinosa et de Salix aurita."
                            },
                            {
                                "example_id": "7f2fa870-caf0-4593-a376-da5a1c78cc70",
                                "sense_id": "b096a7a4-488f-3b3b-9e1a-0742d797c3e3",
                                "text": "L’État vient d’obtenir une décision favorable du Tribunal arbitral, ce qui leur permet de déposer une requête en Cour supérieure contre la station pour faire résilier des ententes signées en 1994 et 2008 sur les «terrains du pourtour»."
                            }
                        ]
                    },
                    {
                        "sense_id": "64fa6b3a-52b6-3241-85ea-49e2cda2a4f2",
                        "entry_id": "f04bdd34-c129-3ba9-9ae1-f15bf0dcccbb",
                        "glosses": [
                            "Nef entourant l’abside ; déambulatoire."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "006b7c08-1c83-4a22-b6a4-9de0fb5ac3f8",
                                "sense_id": "64fa6b3a-52b6-3241-85ea-49e2cda2a4f2",
                                "text": "Souvent la nuit on voyait errer une forme hideuse sur la frêle balustrade découpée en dentelle qui couronne les tours et borde le pourtour de l’abside."
                            }
                        ]
                    }
                ],
