                "senses": [
                    {
                        "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                        "entry_id": "0c4331df-3312-39e6-866b-b7281919d675",
                        "glosses": [
                            "Art de la navigation aérienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b26c41-a1b5-4d95-b386-995484169fb9",
                                "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                                "text": "L’engouement pour l’aéronautique commençait."
                            },
                            {
                                "example_id": "7853b1a0-a73b-49f2-b5cd-9eeadf7ff25c",
                                "sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                                "text": "L'aéronautique navale est la composante aérienne d'une marine militaire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73792d40-a352-45de-b5d6-62df5eca94d4",
                        "source_entry_id": "0c4331df-3312-39e6-866b-b7281919d675",
                        "source_sense_id": "e90839bb-9483-3945-9ae9-284a784d7fdb",
                        "target_lang_word": "Luftfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                        "entry_id": "491f2eee-9dd0-3229-8676-797eddbebb07",
                                        "glosses": [
                                            "Technik- und Industriebereich, der sich mit der Fortbewegung durch die Luft befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49100ef1-abef-4f0f-8d98-721b34364d2a",
                                                "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                                "text": "Auch in der Luftfahrt gibt es Kapitäne."
                                            },
                                            {
                                                "example_id": "c24f03c8-c2d7-49de-b08c-2b392d14b32c",
                                                "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                                "text": "„Damals steckte die Luftfahrt noch in den Kinderschuhen.“"
                                            },
                                            {
                                                "example_id": "631162f8-0e52-4a5f-8f3f-3b90010bf5d7",
                                                "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                                "text": "„Damit begann für die Luftpost und Luftfahrt eine neue Ära, handelte es sich doch um den ersten planmäßigen, auf Dauer angelegten regelmäßigen Linienflugverkehr der Welt!“"
                                            },
                                            {
                                                "example_id": "fa16ee84-7f98-43b8-bfe5-b9142d44ff24",
                                                "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                                            },
                                            {
                                                "example_id": "7af34b70-e658-40e3-9736-470febb79a3f",
                                                "sense_id": "a4e630b7-8f0b-3824-9eab-a4c6ff0d474f",
                                                "text": "„Den größten Anteil am touristischen CO₂-Fußabdruck macht die Luftfahrt aus, gefolgt von An- und Abreisen mit dem Privatauto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9910bc4-2b36-3b96-b278-a7d019edeebb",
                                        "entry_id": "491f2eee-9dd0-3229-8676-797eddbebb07",
                                        "glosses": [
                                            "das Fliegen an sich betreffend mit Luftfahrzeugen oder der Flug selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ad8ca0-cdd2-4caa-9cd1-6c8446b22323",
                                                "sense_id": "d9910bc4-2b36-3b96-b278-a7d019edeebb",
                                                "text": "Die zivile Luftfahrt ist natürlich durch den Terrorismus extrem bedroht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3a55f879-11fc-379c-a906-12b39b087865",
                                        "entry_id": "491f2eee-9dd0-3229-8676-797eddbebb07",
                                        "glosses": [
                                            "die Reise durch die Luft mit einem Ballon oder Luftschiff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed47402b-e104-4e5e-8da0-9a36e90948de",
                                                "sense_id": "3a55f879-11fc-379c-a906-12b39b087865",
                                                "text": "Diese Luftfahrt 1811 gehörte zu den gefährlichsten Unternehmungen des Jahres."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
