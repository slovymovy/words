                "senses": [
                    {
                        "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                        "entry_id": "c8df30fc-1ef1-32b9-9f83-cd7bb2ed78ef",
                        "glosses": [
                            "satzwertige Äußerung, die aus nur einem Wort besteht"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "0b52bb67-ce96-4028-90f3-31171e400323",
                                "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                                "text": "„Das 1. Stadium ist das der Einwortäußerungen beziehungsweise Holophrasen.“"
                            },
                            {
                                "example_id": "ec646c10-4214-4a74-b8f1-d3863fca30f6",
                                "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                                "text": "„Er spricht daher von Einwortsätzen oder »Holophrasen« und meint, daß Kinder, die Einwortäußerungen hervorbringen, schon syntaktische Relationen (zum Beispiel Subjekt - Objekt) beherrschen.“"
                            },
                            {
                                "example_id": "eb43ca00-e427-4114-991f-a21760e31f9f",
                                "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                                "text": "„Die frequentesten Wörter hatten keine festen Positionen, kamen auch als Einwortäußerungen und kombiniert miteinander vor.“"
                            },
                            {
                                "example_id": "4a669cd8-4d3e-493c-97e1-208db914f78b",
                                "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                                "text": "„Einwortäußerungen erfüllen die Funktion einer sprachlichen Handlung, deren Bedeutung durch Handlungskontext und Intonation erkennbar ist.“"
                            },
                            {
                                "example_id": "d4fd7439-2ecc-4bc3-a026-278e1b2c09f0",
                                "sense_id": "2dbcf1dd-da7f-3f5f-b512-615b71fa36ff",
                                "text": "„Es sollte spontan gebraucht werden, und der Sinn als Einwortäußerung deutlich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
