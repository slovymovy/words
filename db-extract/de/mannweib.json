                "senses": [
                    {
                        "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                        "entry_id": "7fd8aaad-4ea3-36fe-a681-2d3bff3eb05a",
                        "glosses": [
                            "Frau, die sich wie ein Mann verhält oder so aussieht"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "7e2c33b1-090a-436e-92ff-862426cf4ffa",
                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                "text": "Heute scheint es so, als würde es die „Mannweiber“ von gestern nicht mehr geben, weil ja heute die „schönen“ Frauen Fußball spielen, es gibt sogar eine schlanke, langhaarige, blonde Barbie, die angeblich Fußball spielen kann."
                            },
                            {
                                "example_id": "0c102d80-c2bf-4073-a6ae-ced9046aecb9",
                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                "text": "Die Töchter [von Meerschweinchen] werden aggressive Mannweiber, die Männchen bleiben sehr lange kindliche Mamasöhnchen."
                            },
                            {
                                "example_id": "ba48e52c-0e79-4fb3-9afc-b3d3509af6b6",
                                "sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                                "text": "„Das Gemächte müßt man ihm wegmetzeln, grollt Mannweib Pauline.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee742fea-6b05-4a5f-ad5a-daeea6bf90fe",
                        "source_entry_id": "7fd8aaad-4ea3-36fe-a681-2d3bff3eb05a",
                        "source_sense_id": "987e5e47-0d30-35be-be3b-46063fb0677a",
                        "source_sense_description": "abwertend: Frau, die sich wie ein Mann verhält oder so aussieht",
                        "target_lang_word": "hommasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hommasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a66645-9c5b-35f3-8247-45254b39917b",
                                        "entry_id": "d5b596ef-728c-37bc-895d-6c061636202a",
                                        "glosses": [
                                            "Femme dont la corpulence et les manières tiennent de celles de l’homme."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84bfcc9c-88c1-41c5-bf94-b9ce65afc3a5",
                                                "sense_id": "f6a66645-9c5b-35f3-8247-45254b39917b",
                                                "text": "C’était une hommasse plus âgée que moi, contre qui je ne pus rien faire."
                                            },
                                            {
                                                "example_id": "37b210e0-4870-4445-9750-8f927ac53bae",
                                                "sense_id": "f6a66645-9c5b-35f3-8247-45254b39917b",
                                                "text": "C’était une hommasse balèze, qui travaillait à la mine."
                                            },
                                            {
                                                "example_id": "fca62c02-4204-48d5-a37e-3f11090c33ac",
                                                "sense_id": "f6a66645-9c5b-35f3-8247-45254b39917b",
                                                "text": "Elle tournait autour de Martine Lemay, la chef du service contentieux, une hommasse bâtie comme Mick Tyson qui occupait ses loisirs en pratiquant la lutte bretonne et l’haltérophilie."
                                            },
                                            {
                                                "example_id": "e0563286-2648-41d3-8f0b-0e2bac19aac6",
                                                "sense_id": "f6a66645-9c5b-35f3-8247-45254b39917b",
                                                "text": "C’est un être hommasse et carré, avec une figure violacée, de petits yeux porcins, méfiants, des yeux qui n’ont jamais dû avoir le temps d’exprimer autre chose que l’affût, la vigilance du guet nocturne…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hommasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84138306-a02b-3ef8-b805-69b9eb35454b",
                                        "entry_id": "14683eab-d0a1-3812-b9cc-006fe8466579",
