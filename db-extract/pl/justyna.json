                    },
                    {
                        "translation_id": "6d531be2-d6eb-4610-ab77-7e932440ca17",
                        "source_entry_id": "53a5fc3c-6f54-3f5d-b42f-1b96f1c490e7",
                        "source_sense_id": "d0bea1a4-6751-3d88-a9cc-09193e817f88",
                        "target_lang_word": "Justine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Justine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                        "entry_id": "5ad69d9c-c84d-3fd8-9903-88c953736876",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a01b28-ca84-4efb-ba84-c19c8ed458c8",
                                                "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                                "text": "O you who have wept tears upon hearing of Virtue's miseries; you who have been moved to sympathy for the woe-ridden Justine; the while forgiving the perhaps too heavy brushstrokes we have found ourselves compelled to employ, may you at least extract from this story the same moral which determined Madame de Lorsange!"
                                            },
                                            {
                                                "example_id": "fb8a322a-005f-44ee-bc84-7d4d0ba16931",
                                                "sense_id": "7d0fedd2-57be-3b6a-be7f-d20053fed421",
                                                "text": "\"What are you going to call your noisy daughter?\" he asked as the door closed and they were alone.\n\"Justine.\"\n\"It's a very good name, but why did you choose it?\"\n\"I read it somewhere, and I liked it.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b979c489-4e39-3fdc-b797-9c1ba1fd8ba5",
                                        "entry_id": "5ad69d9c-c84d-3fd8-9903-88c953736876",
                                        "glosses": [
                                            "A male given name from French and Latin, of chiefly Philippine usage, variant of Justin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b6ec041-d9e5-4159-8119-5270452a44e1",
                        "source_entry_id": "53a5fc3c-6f54-3f5d-b42f-1b96f1c490e7",
                        "source_sense_id": "d0bea1a4-6751-3d88-a9cc-09193e817f88",
                        "target_lang_word": "Justýna",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d6b05310-a785-4f7c-b58a-a5cbf16921cf",
                        "source_entry_id": "53a5fc3c-6f54-3f5d-b42f-1b96f1c490e7",
                        "source_sense_id": "d0bea1a4-6751-3d88-a9cc-09193e817f88",
                        "target_lang_word": "Justine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Justine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc7a001-e65d-30d5-ad76-915322c69334",
                                        "entry_id": "4a081dc5-b53f-30fd-9157-206794ec925c",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b6a9665-6996-487f-b87e-9784800bf994",
                                                "sense_id": "6dc7a001-e65d-30d5-ad76-915322c69334",
                                                "text": "« De même, quelqu’un a ramené la grenouille taureau des États-Unis, parce qu’il trouvait son chant harmonieux », confie Jean-Lou Justine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Justine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c4d5cd3-86a4-3ab0-b2e8-6b075f8c89e2",
                                        "entry_id": "4c6cf236-58a5-3fe0-8157-4973bf9d54f6",
                                        "glosses": [
                                            "Ancienne commune du département des Ardennes, qui fusionna, le 15 février 1965, avec Herbigny pour former la commune de Justine-Herbigny."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4410f40-fae8-44ae-9001-e235cad18bc0",
                                                "sense_id": "9c4d5cd3-86a4-3ab0-b2e8-6b075f8c89e2",
                                                "text": "Dans un Recueil des Élections de Champagne, imprimé à Châlons en 1688, l'élection de Reims contient le Doyenné, dit de Justine (Commune de l'Arrondissement de Rethel), lequel comprend sept localités, dont une est celle de Gerson. Ainsi, en 1688, Gerson existait encore, […]."
                                            },
                                            {
                                                "example_id": "64a8a390-3122-46d8-add7-5fb934ad71eb",
                                                "sense_id": "9c4d5cd3-86a4-3ab0-b2e8-6b075f8c89e2",
                                                "text": "1759. Au mois de février, Jean DUCHESNE, fils d'un cloutier de Moncy-Notre-Dame; il avait été successivement employé dans le ministère aux Mazures, à Damouzy, Rethel, Doux, Justine, Maubert-Fontaine et Guignicourt. Sa belle conduite dans l'incendie de 1783 lui valut sans doute le titre de chanoine de Braux, qu'il prend dès le 10 janvier 1784."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Justine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28bac01e-45df-3818-8053-14cb8786bb14",
                                        "entry_id": "e6221ba3-c82a-3f0c-8dde-a6863a4a1ba6",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa0272d-69cf-439a-8803-b555eae3af51",
                                                "sense_id": "28bac01e-45df-3818-8053-14cb8786bb14",
                                                "text": "Des amis, des connaissances de Justine Vayrac, rejoints par des anonymes, ont participé, dimanche, à une marche blanche en hommage à la jeune femme de 20 ans, tuée après une sortie en discothèque."
                                            },
                                            {
                                                "example_id": "12f806e9-f5fb-47cd-95a7-b2e0164f0ff1",
                                                "sense_id": "28bac01e-45df-3818-8053-14cb8786bb14",
                                                "text": "La Suissesse Justine Mettraux, épaulée par Teamwork embarquera sur l’Imoca pour la Route du Rhum 2022 et le Vendée Globe 2024."
                                            },
                                            {
                                                "example_id": "90d0abd0-6300-445a-bc63-5d0d7fd2b341",
                                                "sense_id": "28bac01e-45df-3818-8053-14cb8786bb14",
                                                "text": "Justine Garaudel est conseillère justice à la préfecture de Police de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6de64acf-1386-3735-9548-673899e317a9",
                                        "entry_id": "e6221ba3-c82a-3f0c-8dde-a6863a4a1ba6",
                                        "glosses": [
                                            "Justine de Padoue, sainte et martyre du IIIᵉ s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c48cad7-12ce-479f-b074-ed18feb9c5ba",
                                                "sense_id": "6de64acf-1386-3735-9548-673899e317a9",
                                                "text": "Eh ? ne suis-je pas tout à la fois l’infante d’Irlande, la reine de Saba, la reine Thomyris, Vénus et sainte Justine, vierge et martyre ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f30f133c-3123-4ae8-9a5d-bd354f54f013",
                        "source_entry_id": "53a5fc3c-6f54-3f5d-b42f-1b96f1c490e7",
                        "source_sense_id": "d0bea1a4-6751-3d88-a9cc-09193e817f88",
