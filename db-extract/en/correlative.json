                    }
                ],
                "senses": [
                    {
                        "sense_id": "83e8e57d-14a3-3074-94b4-63ee66e63802",
                        "entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                        "glosses": [
                            "Either of two correlative things."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "88d56417-f899-46be-88b6-d9971e2d878d",
                                "sense_id": "83e8e57d-14a3-3074-94b4-63ee66e63802",
                                "text": "The actual motivation for this separation was a curious mixture of arrogance and respect: the new arrogance of the administrators abroad who faced 'backward populations' or 'lower breeds' found its correlative in the respect of old-fashioned statesmen at home who felt that no nation had the right to impose its law upon a foreign people."
                            }
                        ]
                    },
                    {
                        "sense_id": "757b0456-0524-3b17-9b99-38f3d675c3f7",
                        "entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                        "glosses": [
                            "A pro-form; a non-personal pronominal, proadjectival, or proadverbial form"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d051578c-e48d-4465-a330-1f610daba1b8",
                        "source_entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                        "source_sense_description": "correlative thing",
                        "target_lang_word": "correlato",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "correlato",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                        "entry_id": "97674c07-9a5c-34ab-8d71-a4e6f232df0a",
                                        "glosses": [
                                            "Término o elemento que se relaciona con otro u otros en sucesión, correspondencia o influencia recíproca, de tal modo que hace parte de una correlación o serie lógica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "365934ec-440d-4b74-bd10-4e964707ba9d",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* Los adverbios \"aquí\" y \"allá\" son correlatos en la indicación de lugar."
                                            },
                                            {
                                                "example_id": "5f212b68-8c60-4ab7-84ab-eace0af86338",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* La suerte es un correlato del talento para obtener un buen ingreso."
                                            },
                                            {
                                                "example_id": "fcf12378-b3be-437d-a3e3-3f590a2577b7",
                                                "sense_id": "02a2c30b-2cda-38f0-b079-71297069a129",
                                                "text": "* El término \"tanto...\" es correlato de \"como...\" en la frase \"Tanto ella como él juegan al fútbol\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29c7a9d9-8e82-4fe6-af57-1ff4d45f4a1d",
                        "source_entry_id": "674b903f-f386-30ed-91c9-ba1ae66031f2",
                        "source_sense_description": "grammar term",
                        "target_lang_word": "corrélatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrélatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4dea964-831c-3a5b-bcc4-c853d92167b0",
                                        "entry_id": "22aca4b3-999c-3c6a-91b0-0d94018c1ff8",
                                        "glosses": [
                                            "Qui marque entre deux termes une relation telle que l’un des deux appelle logiquement l’autre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013c92ab-e826-4021-8a8f-66552f00d04a",
                                                "sense_id": "c4dea964-831c-3a5b-bcc4-c853d92167b0",
                                                "text": "Ce que nous venons de dire suppose que l’exégèse et l’eiségèse sont corrélatives, comme la montée et la descente d'un même chemin. Il ne serait pas nécessaire d’inventer le mot \"eiségèse\" si l’exégèse n'avait la prétention d'être seulement une \"sortie\" à partir du texte."
                                            },
                                            {
                                                "example_id": "0a44e9a0-73f4-4622-9722-680198975be9",
                                                "sense_id": "c4dea964-831c-3a5b-bcc4-c853d92167b0",
                                                "text": "Cette nouvelle doctrine doit rester en cohérence avec l’objectif de réduction des surfaces utilisées par l’État, qui permet d’infléchir les dépenses de location, d’entretien et de rénovation associées, et qui constitue également un puissant levier pour réduire son impact environnemental, avec la diminution corrélative des consommations énergétiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "767b5c4e-823e-3100-80df-c39980779284",
                                        "entry_id": "22aca4b3-999c-3c6a-91b0-0d94018c1ff8",
                                        "glosses": [
                                            "Se dit des mots qui vont ordinairement ensemble et qui servent à indiquer une certaine relation entre deux membres de phrase, comme « tellement » et « que »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "157d6576-0963-4431-b41b-9c8a7fe07c61",
                                                "sense_id": "767b5c4e-823e-3100-80df-c39980779284",
                                                "text": "Deux propositions se succèdent, la première comporte un mot en qu-, la seconde un élément corrélatif en t-"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corrélatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c280ecbf-dbd5-3271-ad9e-958ba3d80021",
                                        "entry_id": "b004bede-4c99-3215-bbcc-0c02d08ebedf",
                                        "glosses": [
                                            "Mot qui est corrélatif d'un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa831be-a7b4-4c1b-a943-29b5586b0ba2",
                                                "sense_id": "c280ecbf-dbd5-3271-ad9e-958ba3d80021",
                                                "text": "La seconde grande fonction de is est d'être, par excellence, le corrélatif du relatif à l'époque archaïque et classique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
