                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee78efca-5b57-4351-9d5d-cadfad03a2f0",
                                "sense_id": "9bd41158-f6ec-380c-9f32-44a851bae22b",
                                "text": "„In der Nähe von Düsseldorf, auf dem Gerresheimer Waldfriedhof, fand man einen 1,5 Meter langen Mammutstoßzahn, der etwa 20 000 bis 50 000 Jahre alt ist.“"
                            },
                            {
                                "example_id": "eb2eb309-b3a4-470e-bc77-ba626572ec2a",
                                "sense_id": "9bd41158-f6ec-380c-9f32-44a851bae22b",
                                "text": "„Schon 1770 bat der Jakutsker Kaufmann Iwan Ljachow Zarin Katharina II. um das erste Monopol zur Suche von Mammutstoßzähnen am Nordmeer.“"
                            },
                            {
                                "example_id": "bba7989d-9ece-43f2-982e-02fd09b2abcc",
                                "sense_id": "9bd41158-f6ec-380c-9f32-44a851bae22b",
                                "text": "„Fast 90 Prozent aller Mammutstoßzähne aus Sibirien landen in China, wo Legionen von Neureichen die Nachfrage nach Elfenbein regelrecht explodieren lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
