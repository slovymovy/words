    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "732cf5a4-42c7-3e4c-8fcc-b642eb3a75b9",
                    "sense_definition": "The action of protecting someone or something from attack, danger, or criticism.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He carried a heavy stick for <w>defense</w> while walking home at night.",
                            "target_lang_translations": {
                                "ru": "Он носил с собой тяжелую палку для <w>защиты</w>, когда возвращался домой ночью.",
                                "pl": "Nosił ze sobą ciężki kij do <w>obrony</w>, wracając nocą do domu."
                            }
                        },
                        {
                            "text": "She was quick to come to the <w>defense</w> of her friend during the argument.",
                            "target_lang_translations": {
                                "ru": "Она быстро встала на <w>защиту</w> своей подруги во время спора.",
                                "pl": "Szybko stanęła w <w>obronie</w> swojej przyjaciółki podczas kłótni."
                            }
                        }
                    ],
                    "synonyms": [
                        "protection",
                        "safeguard",
                        "shield",
                        "security",
                        "resistance"
                    ],
                    "antonyms": [
                        "attack"
                    ],
                    "common_phrases": [
                        "self-defense",
                        "in defense of",
                        "come to someone's defense",
                        "line of defense"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по защите кого-либо или чего-либо от нападения, опасности или критики.",
                        "pl": "Działanie mające na celu ochronę kogoś lub czegoś przed atakiem, niebezpieczeństwem lub krytyką."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "общее понятие: ограждение от опасности"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "активное сопротивление нападению"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obrona",
                                "target_lang_sense_clarification": "ogólne pojęcie: przeciwdziałanie atakowi lub agresji"
                            },
                            {
                                "target_lang_word": "ochrona",
                                "target_lang_sense_clarification": "zapewnienie bezpieczeństwa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7da5215-0ba3-3fa2-b29a-55682eef7e19",
                    "sense_definition": "The military resources, systems, and organizations used by a country to protect itself.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to increase the budget for national <w>defense</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство решило увеличить бюджет на национальную <w>оборону</w>.",
                                "pl": "Rząd zdecydował o zwiększeniu budżetu na <w>obronę</w> narodową."
                            }
                        },
                        {
                            "text": "They are testing a new air <w>defense</w> system to intercept missiles.",
                            "target_lang_translations": {
                                "ru": "Они испытывают новую систему противовоздушной <w>обороны</w> для перехвата ракет.",
                                "pl": "Testują nowy system <w>obrony</w> przeciwlotniczej do przechwytywania pocisków."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Department of Defense",
                        "national defense",
                        "civil defense",
                        "air defense"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Военные ресурсы, системы и организации, используемые страной для защиты своей территории.",
                        "pl": "Zasoby wojskowe, systemy i organizacje służące państwu do ochrony terytorium."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "военный контекст"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obrona",
                                "target_lang_sense_clarification": "kontekst militarny i państwowy"
                            },
                            {
                                "target_lang_word": "obronność",
                                "target_lang_sense_clarification": "potencjał militarny kraju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8793e680-f35f-30b2-a0d7-07b2d662d7e4",
                    "sense_definition": "The players or tactics used in a game to prevent the other team from scoring.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team has a very strong <w>defense</w>, but our offense needs improvement.",
                            "target_lang_translations": {
                                "ru": "У нашей команды очень сильная <w>защита</w>, но нападение требует улучшения.",
                                "pl": "Nasza drużyna ma bardzo silną <w>obronę</w>, ale nasz atak wymaga poprawy."
                            }
                        },
                        {
                            "text": "The coach decided to switch to a zone <w>defense</w> in the second half.",
                            "target_lang_translations": {
                                "ru": "Тренер решил перейти на зонную <w>защиту</w> во второй половине игры.",
                                "pl": "Trener zdecydował się przejść na <w>obronę</w> strefową w drugiej połowie."
                            }
                        }
                    ],
                    "antonyms": [
                        "offense"
                    ],
                    "common_phrases": [
                        "play defense",
                        "zone defense",
                        "strong defense"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игроки или тактика в спорте, используемые для предотвращения набора очков соперником.",
                        "pl": "Zawodnicy lub taktyka stosowana w grze, aby zapobiec zdobyciu punktów przez przeciwnika."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "спорт: линия игроков или тактика"
                            },
                            {
                                "target_lang_word": "оборона",
                                "target_lang_sense_clarification": "спорт: действия по защите ворот/кольца"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obrona",
                                "target_lang_sense_clarification": "sport: formacja zawodników lub działania defensywne"
                            },
                            {
                                "target_lang_word": "defensywa",
                                "target_lang_sense_clarification": "sport: styl gry nastawiony na odpieranie ataków"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23c43dcb-e203-3488-ba08-4a869914e6f7",
                    "sense_definition": "The lawyer or team of lawyers representing a person accused of a crime in a legal case.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>defense</w> rested their case after calling three witnesses.",
                            "target_lang_translations": {
                                "ru": "<w>Защита</w> завершила представление доказательств после вызова трех свидетелей.",
                                "pl": "<w>Obrona</w> zakończyła prezentację dowodów po wezwaniu trzech świadków."
                            }
                        },
                        {
                            "text": "Her lawyer prepared a solid <w>defense</w> to prove her innocence in court.",
                            "target_lang_translations": {
                                "ru": "Ее адвокат подготовил надежную <w>защиту</w>, чтобы доказать ее невиновность в суде.",
                                "pl": "Jej prawnik przygotował solidną <w>linię obrony</w>, aby udowodnić jej niewinność w sądzie."
                            }
                        }
                    ],
                    "antonyms": [
                        "prosecution"
                    ],
                    "common_phrases": [
                        "defense attorney",
                        "witness for the defense",
                        "defense lawyer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Адвокат или группа юристов, представляющих интересы обвиняемого в суде.",
                        "pl": "Prawnik lub zespół prawników reprezentujących osobę oskarżoną o przestępstwo w sprawie sądowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защита",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obrona",
                                "target_lang_sense_clarification": "prawo: strona procesowa reprezentująca oskarżonego"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ad82e46e-078d-3f22-83bc-ff2c03abf202",
                    "sense_definition": "To use defensive tactics against an opponent or a specific play in a sport.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team struggled to <w>defense</w> against the fast break effectively.",
                            "target_lang_translations": {
                                "ru": "Команде было трудно эффективно <w>защищаться</w> против быстрого прорыва.",
                                "pl": "Drużyna miała trudności ze skuteczną <w>obroną</w> przeciwko szybkiemu atakowi."
                            }
                        },
                        {
                            "text": "They <w>defensed</w> the final play perfectly and won the game.",
                            "target_lang_translations": {
                                "ru": "Они идеально <w>отзащищались</w> в последнем розыгрыше и выиграли матч.",
                                "pl": "Idealnie <w>zagrali w obronie</w> przy ostatniej akcji i wygrali mecz."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять оборонительную тактику против соперника в спорте.",
                        "pl": "Stosowanie taktyki obronnej przeciwko przeciwnikowi lub konkretnemu zagraniu w sporcie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "защищаться",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "обороняться",
                                "target_lang_sense_clarification": "глагол"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bronić",
                                "target_lang_sense_clarification": "czasownik: odpierać ataki w sporcie"
                            },
                            {
                                "target_lang_word": "grać w obronie",
                                "target_lang_sense_clarification": "czasownik: wykonywać zadania defensywne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}