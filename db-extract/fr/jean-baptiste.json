                    },
                    {
                        "form_id": "6d22de1f-2b48-4a61-9344-a02c903952b1",
                        "entry_id": "a8f22795-13b2-3f57-8626-d05166d25dd5",
                        "tags": [],
                        "form": "Yohanân le Plongeur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57ca7666-b1b9-3856-9a94-67f8622823ef",
                        "entry_id": "a8f22795-13b2-3f57-8626-d05166d25dd5",
                        "glosses": [
                            "Prophète du Nouveau Testament qui baptisait les pénitents et a baptisé Jésus sur les rives du Jourdain."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "92c8711e-3820-4653-bc6f-6b0556e1b7ce",
                                "sense_id": "57ca7666-b1b9-3856-9a94-67f8622823ef",
                                "text": "Saint Jean-Baptiste."
                            },
                            {
                                "example_id": "e1c5ddef-e4a9-445a-ac95-33957424e6d4",
                                "sense_id": "57ca7666-b1b9-3856-9a94-67f8622823ef",
                                "text": "Or en ce temps-là vint Jean-Baptiste, prêchant dans le désert de la Judée,\net disant : Convertissez-vous, car le royaume des cieux est proche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d4faaca-1432-4838-b2fb-b41e4ac9a27e",
                        "source_entry_id": "a8f22795-13b2-3f57-8626-d05166d25dd5",
                        "source_sense_id": "57ca7666-b1b9-3856-9a94-67f8622823ef",
                        "target_lang_word": "John the Baptist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "John the Baptist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "177dc3af-f23b-34f4-9ead-cdf2443b86c9",
                                        "entry_id": "c5ae673b-5c26-3473-80a7-d1c07e5cad2a",
                                        "glosses": [
                                            "A New Testament prophet who baptized Jesus and was subsequently executed by Herod Antipas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2982d99b-4206-4098-9a69-24f3beb16cee",
                                                "sense_id": "177dc3af-f23b-34f4-9ead-cdf2443b86c9",
                                                "text": "In those daies came Iohn the Baptist, preaching in the wildernesse of Iudea, And saying, Repent yee: for the kingdome of heauen is at hand."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "John the Baptist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff6c34a-b137-32b5-afa6-75c5386b860c",
                                        "entry_id": "fb7540e6-553f-306a-8a3a-efaee2afeff4",
                                        "glosses": [
                                            "A harbinger or prophetic figure, often one initially ignored or rejected by others."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a4b56fe-89ff-4775-b916-47487165ef4f",
                                                "sense_id": "eff6c34a-b137-32b5-afa6-75c5386b860c",
                                                "text": "[…] and praise such as Glenn Frank’s: “Keyserling may turn out to be a John the Baptist of a new Western civilization.”"
                                            },
                                            {
                                                "example_id": "9cade0ed-c7fb-4c9b-a16d-716289826339",
                                                "sense_id": "eff6c34a-b137-32b5-afa6-75c5386b860c",
                                                "text": "In 1935 Szálasi had been a lonely John the Baptist in Hungarian politics, the self-appointed leader of a tiny party, less than 500 strong, advocating an unpopular cause."
                                            },
                                            {
                                                "example_id": "7c8311da-b071-4100-8001-d8c5107c665a",
                                                "sense_id": "eff6c34a-b137-32b5-afa6-75c5386b860c",
                                                "text": "Ellis makes Diaghilev a John the Baptist of a ‘classico-mathematical Renaissance’, and the notion that this was a renaissance of some kind or other was evidently in the air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "639843a7-0f15-4d61-9892-4773df490c0c",
                        "source_entry_id": "a8f22795-13b2-3f57-8626-d05166d25dd5",
