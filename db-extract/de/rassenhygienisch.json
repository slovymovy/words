                ],
                "senses": [
                    {
                        "sense_id": "96086ce1-ab3a-3f5c-838d-d4ef7a88ade6",
                        "entry_id": "9c01b0e9-eafd-3069-916a-f222a7878c71",
                        "glosses": [
                            "auf der Rassenhygiene basierend, mithilfe der Rassenhygiene, durch die die (Methoden der) Rassenhygiene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90fbc248-4fe1-44cf-b393-e97a4fc7c985",
                                "sense_id": "96086ce1-ab3a-3f5c-838d-d4ef7a88ade6",
                                "text": "„Neben rassenhygienischen Vorstellungen der Eugenik wurden kriegswirtschaftliche Erwägungen während des Zweiten Weltkrieges zur Begründung der Vernichtung lebensunwerten Lebens herangezogen.“"
                            },
                            {
                                "example_id": "19577723-3c04-4007-869b-2b2256bfcd17",
                                "sense_id": "96086ce1-ab3a-3f5c-838d-d4ef7a88ade6",
                                "text": "„Rüdin, der den Nationalsozialimus als Gelegenheit genutzt hatte, eugenische und rassenhygienische Gedanken zu verwirklichen, hat wesentlich dazu beigetragen, dass sich Psychiatrie und Humangenetik in den Dienst des nationalsozialistischen Staates stellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
