                    "sense_definition": "słowa lub czyny znieważające Boga, religię lub to, co uznawane jest za święte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religijne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W wielu dawnych kodeksach prawnych za publiczne <w>bluźnierstwo</w> groziła surowa kara więzienia.",
                            "target_lang_translations": {
                                "ru": "Во многих старинных сводах законов за публичное <w>богохульство</w> грозило суровое тюремное заключение."
                            }
                        },
                        {
                            "text": "Mężczyzna został oskarżony o <w>bluźnierstwo</w> przeciwko tradycji po tym, jak zniszczył zabytkowy ołtarz.",
                            "target_lang_translations": {
                                "ru": "Мужчину обвинили в <w>святотатстве</w> против традиции после того, как он разрушил старинный алтарь."
                            }
                        }
                    ],
                    "synonyms": [
