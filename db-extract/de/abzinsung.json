                "senses": [
                    {
                        "sense_id": "59fcb34a-2189-3111-aae4-5bc1feb50f9a",
                        "entry_id": "8421665f-4a70-3a5a-b475-03f7c5250ac2",
                        "glosses": [
                            "Berechnung des aktuellen Werts einer zukünftigen Zahlung unter Berücksichtigung eines bestimmten Zinssatzes"
                        ],
                        "tags": [
                            "Finanzmathematik"
                        ],
                        "examples": [],
