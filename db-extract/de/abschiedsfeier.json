                "senses": [
                    {
                        "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                        "entry_id": "78f49129-c7f2-33d5-ab6e-074b7b440c02",
                        "glosses": [
                            "Feier, die veranstaltet wird, um jemanden zu verabschieden (beispielsweise bei einem Umzug, einer Reise oder Ähnlichem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8212df3b-18cf-4e39-b9c3-2c17b994f82e",
                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                "text": "Ich werde für ihn eine Abschiedsfeier organisieren."
                            },
                            {
                                "example_id": "376b8b35-8fcc-40c9-9175-9661254444d3",
                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                "text": "„Freunde und Familie hatten eine königliche Abschiedsfeier für mich veranstaltet, viele von ihnen waren, trotz kühler Temperaturen, auf den verschiedensten Motorrädern aus allen Ecken Großbritanniens angereist.“"
                            },
                            {
                                "example_id": "9f19055f-ccbd-4ae0-a14d-2ac83bde35d9",
                                "sense_id": "da07415f-39d2-33b9-86b8-d89387cc874a",
                                "text": "„Die Abschiedsfeier für Rolande begann pünktlich um sechs Uhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
