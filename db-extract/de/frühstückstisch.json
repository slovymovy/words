                "senses": [
                    {
                        "sense_id": "016c4806-4da2-34ea-aa88-aa513dee1bc9",
                        "entry_id": "2a02fda8-7bb4-36c3-b3a1-725eb38bf997",
                        "glosses": [
                            "für das Frühstück gedeckter Tisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0ede2c-bb7e-44ad-9670-a12f0f41897e",
                                "sense_id": "016c4806-4da2-34ea-aa88-aa513dee1bc9",
                                "text": "„Heute vertreiben Kräuter- und Früchtetees den schwarzen Tee - und schon bei Klassenfahrten in den Siebzigern standen Hagebutten- und Pfefferminztee als oft einzige Getränke auf dem Frühstückstisch.“"
                            },
                            {
                                "example_id": "a0149d62-1766-4779-90e9-8e7099da7687",
                                "sense_id": "016c4806-4da2-34ea-aa88-aa513dee1bc9",
                                "text": "„Sonntags deckte ich den Frühstückstisch jetzt auch mal selbst.“"
                            },
                            {
                                "example_id": "44e65db8-637c-456d-a224-dc49451f69ca",
                                "sense_id": "016c4806-4da2-34ea-aa88-aa513dee1bc9",
                                "text": "„Jack saß am Frühstückstisch.“"
                            },
                            {
                                "example_id": "e52060fa-60d4-4b17-a2cd-aecccb5aacbd",
                                "sense_id": "016c4806-4da2-34ea-aa88-aa513dee1bc9",
                                "text": "„Und neben unserem Frühstückstisch standen oft die Vermieter, redeten in ihrem breiten badischen Dialekt und meine Eltern bemühten sich, es zu verstehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
