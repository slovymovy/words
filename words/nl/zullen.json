                {
                    "sense_id": "b6ae0d61-37dc-3055-ac6e-143ee167f6d4",
                    "sense_definition": "Gebruikt om een voorstel te doen, iets aan te bieden of een intentie uit te spreken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zullen</w> we vanavond samen naar de film gaan?",
                            "target_lang_translations": {
                                "en": "<w>Shall</w> we go to the movies together tonight?",
                                "ru": "<w>Давай</w> сходим сегодня вечером в кино вместе?",
                                "pl": "<w>Może</w> pójdziemy dziś wieczorem razem do kina?",
                                "de": "<w>Sollen</w> wir heute Abend zusammen ins Kino gehen?",
                                "fr": "Et si nous <w>allions</w> au cinéma ensemble ce soir ?",
                                "it": "<w>Vogliamo</w> andare al cinema insieme stasera?",
                                "cs": "<w>Půjdeme</w> dnes večer společně do kina?",
                                "tr": "Bu akşam birlikte sinemaya <w>gidelim mi</w>?",
                                "es": "¿<w>Vamos</w> al cine juntos esta noche?"
                            }
                        },
                        {
                            "text": "<w>Zal</w> ik de deur voor je openhouden?",
                            "target_lang_translations": {
                                "en": "<w>Shall</w> I hold the door open for you?",
                                "ru": "<w>Давай</w> я подержу дверь для тебя?",
                                "pl": "<w>Mam</w> przytrzymać dla ciebie drzwi?",
                                "de": "<w>Soll</w> ich dir die Tür offen halten?",
                                "fr": "<w>Veux-tu</w> que je te tienne la porte ?",
                                "it": "<w>Vuoi che</w> ti tenga aperta la porta?",
                                "cs": "<w>Mám</w> ti podržet dveře?",
                                "tr": "Kapıyı senin için <w>tutayım mı</w>?",
                                "es": "¿<w>Quieres que</w> te sujete la puerta?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "zullen we",
                        "zal ik"
                    ],
                    "target_lang_definitions": {
