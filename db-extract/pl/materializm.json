                                "target_senses": [
                                    {
                                        "sense_id": "0533631e-e105-3143-aa33-05883f42b536",
                                        "entry_id": "cb262bf8-22d7-36b5-94e4-b45779a4c218",
                                        "glosses": [
                                            "Doctrina filosófica que admite como única sustancia la material, negando la existencia de realidades espirituales."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14d3c55a-68ec-4671-b843-61757b507bb1",
                        "source_entry_id": "71ab3fdd-d073-3918-8ba4-181de7a8d22c",
                        "source_sense_id": "56721d12-43fd-3e3b-a4ee-6759743b3d88",
                        "target_lang_word": "Materialismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Materialismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84b1d6f1-a36a-3f6b-b6fa-8d1a4b263a0a",
                                        "entry_id": "ba6ebcb3-f720-3455-9935-2659c909bf87",
                                        "glosses": [
                                            "Lehre, die alles Sein auf Materie zurückführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4da13f7b-0aad-4a65-98c4-897b0d215955",
                                                "sense_id": "84b1d6f1-a36a-3f6b-b6fa-8d1a4b263a0a",
                                                "text": "„Für die breite Öffentlichkeit geht jedoch ein Verteidiger des Absolutismus, ein Kritiker der politischen Ansprüche der Kirche, vor allem ein Monstrum des Materialismus, des Hedonismus und des Unglaubens dahin.“"
                                            },
                                            {
                                                "example_id": "f71a72c7-4adc-49e6-a259-d6c97213bcd8",
                                                "sense_id": "84b1d6f1-a36a-3f6b-b6fa-8d1a4b263a0a",
                                                "text": "„Sie, die Kommunistin, die wortgewaltige Verfechterin des Materialismus, lief mit einem Schutzzauber durch die Gegend.“"
                                            },
                                            {
                                                "example_id": "d342a3f0-3fdc-4edd-b743-da1341d9ce9f",
                                                "sense_id": "84b1d6f1-a36a-3f6b-b6fa-8d1a4b263a0a",
                                                "text": "„Der Materialismus, der Sensualismus, der Atheismus des Zeitalters sind der theoretische Boden, in den sich die Wurzeln senken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fbb1c060-e32e-3aa5-ba93-21e3baed0b50",
                                        "entry_id": "ba6ebcb3-f720-3455-9935-2659c909bf87",
                                        "glosses": [
                                            "Streben nach primär materiellen Gütern"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "outdated",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3d8519-789c-460a-8e3c-d2c6bc569286",
                                                "sense_id": "fbb1c060-e32e-3aa5-ba93-21e3baed0b50",
                                                "text": "Sollten wir nicht den Materialismus unserer Gesellschaft abschütteln?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
