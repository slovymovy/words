                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hôtel de ville",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "92e5c1a5-394f-38b0-b8c9-ff29391c27bc",
                                        "entry_id": "a8792f48-f46e-3172-ae75-a4d3d8b1ab65",
                                        "glosses": [
                                            "Bâtiment où se tient l’administration d’une municipalité, commune ou ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3585659-ee81-421e-8db0-5ed46cf161c9",
                                                "sense_id": "92e5c1a5-394f-38b0-b8c9-ff29391c27bc",
                                                "text": "À midi seize, les rares employés qui travaillaient ce jour-là quittèrent l’hôtel de ville puis ce fut le tour des « administratifs » de l’hôtel de police."
                                            },
                                            {
                                                "example_id": "eff7ffe5-fed4-4062-abc5-df483ce48333",
                                                "sense_id": "92e5c1a5-394f-38b0-b8c9-ff29391c27bc",
                                                "text": "Les prostituées invitées aux banquets des hôtels de ville de Haute-Allemagne afin de réjouir les invités de marque ne sortaient certainement pas de la grande cohorte prostibulaire, mais étaient d'aimables et généreuses (charnellement parlant) maîtresses accointées aux patriciens du lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351c31db-0c9d-3030-9e2d-1048e1743bbd",
                                        "entry_id": "a8792f48-f46e-3172-ae75-a4d3d8b1ab65",
                                        "glosses": [
                                            "Administration de cette municipalité, commune ou ville."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4265b599-2727-401f-ad13-94d16a584db2",
                                                "sense_id": "351c31db-0c9d-3030-9e2d-1048e1743bbd",
                                                "text": "Sur les deux mâles, […]. L’autre, plus moutonnier, entrait à l’Hôtel de Ville, sur les traces du paternel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
