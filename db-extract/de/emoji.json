                "senses": [
                    {
                        "sense_id": "0845af8b-539e-3010-b75a-c9477a0ea0cc",
                        "entry_id": "307f3600-5130-3f3c-90bd-3ca0482adcfb",
                        "glosses": [
                            "emoji (digital graphic icon used to represent a concept or object)"
                        ],
                        "tags": [
                            "masculine",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b59248d6-61bd-40b0-a843-8a37c22f6ff9",
                                "sense_id": "0845af8b-539e-3010-b75a-c9477a0ea0cc",
                                "text": "Nun feilscht er um den Preis. Erklärungen von Twitter-Chef Parag Agrawal kommentiert Musk gerne mal mit einem Kothaufen-Emoji. Welchen Emoji hat Musk verdient?"
                            },
                            {
                                "example_id": "d58d1d78-5f96-4c84-9846-b60859e2132e",
                                "sense_id": "0845af8b-539e-3010-b75a-c9477a0ea0cc",
                                "text": "In den letzten Wochen machte sich Musk via Twitter über das Aussehen von Microsoft-Mitgründer Bill Gates lustig und postete während einer Online-Diskussion mit Twitter-Chef Parag Agrawal das Emoji eines Kothaufens."
                            },
                            {
                                "example_id": "2fdc0fe3-5488-452d-aad9-7a2eabb5384c",
                                "sense_id": "0845af8b-539e-3010-b75a-c9477a0ea0cc",
                                "text": "Der Leopard wurde dabei mit einem Emoji dargestellt. Der Tweet wurde bereits am 24. Januar veröffentlicht."
                            }
                        ]
                    }
