                ],
                "senses": [
                    {
                        "sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                        "entry_id": "9931cf82-c3dd-3312-8318-23636306bf45",
                        "glosses": [
                            "unbeherrschbarer innerer Drang, unsinnig viel Geld/Vermögen zu verschleudern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02653835-96ba-4285-b13b-0c94a99bab2e",
                                "sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                                "text": "„Er soll wegen Verschwendungssucht entmündigt werden.“"
                            },
                            {
                                "example_id": "c59621bf-c32c-45d8-9b1d-033f1296a60d",
                                "sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                                "text": "„Sie waren nachdenklich und stellten wohl Überlegungen über die Verschwendungssucht von Spielern an, die das Geld nichts kostet; dennoch sah ich sie erstaunt, und andere staunen zu lassen, war meine Leidenschaft.“"
                            },
                            {
                                "example_id": "36da8229-6ad5-4382-913f-1c2e11d3c5dd",
                                "sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                                "text": "„Madame hat nie vorgegeben, moralischer zu sein als die damalige Gesellschaft, sie hat den unausgesetzten Ehebruch ihres Schwiegersohns ganz gelassen hingenommen, sich viel mehr über seine Verschwendungssucht geärgert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d88beb8-990f-4633-9dbe-15e79e9d42b7",
                        "source_entry_id": "9931cf82-c3dd-3312-8318-23636306bf45",
                        "source_sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                        "source_sense_description": "unbeherrschbarer innerer Drang, unsinnig viel Geld/Vermögen zu verschleudern",
                        "target_lang_word": "prodigality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodigality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                                        "entry_id": "dcd4487e-2132-3206-bc89-5b1f1c8a85d5",
                                        "glosses": [
                                            "Wasteful extravagance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a09a2f6-e651-42c3-804c-9a880980fffe",
                                                "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                                                "text": "The plain where he was riding was one immense thicket of the gum cistus, whose frail white leaves, just veined with the faintest pink, fell in showers at the least movement of the passer-by. What a prodigality of blossom!—for the gum cistus, born and withered in an hour, is the most ephemeral of flowers."
                                            },
                                            {
                                                "example_id": "37560d1a-e857-440d-9da3-f9c3bc3a1c4e",
                                                "sense_id": "6b57baeb-834f-3be7-903e-2bba65ef2e9f",
                                                "text": "Mother[…]considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom, from which every Kensingtonian held aloof, except on the conventional tip-and-run excursions in pursuit of shopping, tea and theatres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e36a0ea-68de-3852-a6a2-fccc10a2eda8",
                                        "entry_id": "dcd4487e-2132-3206-bc89-5b1f1c8a85d5",
                                        "glosses": [
                                            "Lavish generosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7cbbac5-9836-4d2d-96c8-8503f3276344",
                        "source_entry_id": "9931cf82-c3dd-3312-8318-23636306bf45",
                        "source_sense_id": "4f3c7964-f03b-3546-bfb2-39bd84eac821",
                        "source_sense_description": "unbeherrschbarer innerer Drang, unsinnig viel Geld/Vermögen zu verschleudern",
                        "target_lang_word": "prodigalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prodigalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Caractère, habitude de celui ou de celle qui est prodigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44c15877-82cc-4e6f-a3d4-a7ec585a5678",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "Le sophisme que je combats dans cet écrit est d’autant plus dangereux, appliqué aux travaux publics, qu’il sert à justifier les entreprises et les prodigalités les plus folles. Quand un chemin de fer ou un pont ont une utilité réelle, il suffit d’invoquer cette utilité. Mais si on ne le peut, que fait-on ? On a recours à cette mystification : « Il faut procurer de l’ouvrage aux ouvriers. »"
                                            },
                                            {
                                                "example_id": "854c229d-e473-4ee9-bb39-8f60540a6ca1",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "La parole n’était-elle pas une des plus effrayantes prodigalités de fluide vital que l’homme pouvait se permettre […]."
                                            },
                                            {
                                                "example_id": "3266bbba-522f-47c1-99f3-ee2bc7f8923b",
                                                "sense_id": "71a03f20-52c8-3970-aebc-acce3f9051c8",
                                                "text": "Soyez radin. La prodigalité attire de nombreux amis sur le court terme mais, plus tard, personne ne vous en remerciera jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Action de prodiguer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf238888-2fe1-4578-a9f9-11e129f4f71b",
                                                "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                                "text": "« La ferme parfaitement autarcique de nos amis restait sur le modèle des fermes de l’an mil, racontait-il au soir de sa vie. Le monde, lui, a plus changé pendant le déroulement de ma propre existence qu’il n’avait changé depuis le néolithique à la ferme de Marcillat. » Cette expérience de vie simple, où la subsistance est suspendue à la prodigalité de la nature, le marque profondément."
                                            },
                                            {
                                                "example_id": "a70caa62-0423-45e8-8396-9a367f4cc3e2",
                                                "sense_id": "3f1f0409-ea8d-319e-8973-20f62a14d78e",
                                                "text": "Ses prodigalités l’ont ruiné en peu de temps. - Il s’est ruiné en folles prodigalités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc005cde-a909-3095-8526-e1671c7dcc11",
                                        "entry_id": "9b836d86-ae3e-311d-b3d2-8b38babcac82",
                                        "glosses": [
                                            "Richesse, exubérance, profusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a6a22ec-4fbf-4c1e-8f19-be5fd3318bd1",
                                                "sense_id": "dc005cde-a909-3095-8526-e1671c7dcc11",
                                                "text": "Quels hommes étaient-ce donc que ceux qui exécutaient ces merveilleuses constructions que les prodigalités des palais féeriques ne pourraient dépasser ? La race en est-elle donc perdue ? Et nous, qui nous vantons d’être civilisés, ne serions-nous, en effet, que des barbares décrépits ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
