                    {
                        "sense_id": "77dfa92f-8d3f-3e19-9854-9dbc2fa75ff2",
                        "entry_id": "63149af6-10df-3f05-aa76-0825cbec30c7",
                        "glosses": [
                            "het water buiten een schip"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a648c33-8740-4645-a82e-91b1e05db971",
                                "sense_id": "77dfa92f-8d3f-3e19-9854-9dbc2fa75ff2",
                                "text": "In speciale palingaken konden de vissen levend worden vervoerd, in een ruimte onder het schip die met gaatjes in verbinding stond met het buitenwater. Je kunt zo'n model nog zien in het Fries Scheepvaartmuseum."
                            }
                        ]
                    },
                    {
                        "sense_id": "b95627d0-e3ca-39fb-9083-522669216f83",
                        "entry_id": "63149af6-10df-3f05-aa76-0825cbec30c7",
                        "glosses": [
                            "water in de buitenlucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f2e4525-493a-43aa-a9af-5144e3b3c83a",
                                "sense_id": "b95627d0-e3ca-39fb-9083-522669216f83",
                                "text": "Maar let op: wie door al die zonnestralen af wil koelen met een duik in buitenwater doet er goed aan beschermende kleding te dragen. Daarvoor waarschuwt de Reddingsbrigade. Het eerste warme weekend leidde de voorgaande jaren nog wel eens tot problemen, zo zegt de brigade."
                            },
                            {
                                "example_id": "e2e108f6-ac1a-48b9-9718-b02b91fee61d",
                                "sense_id": "b95627d0-e3ca-39fb-9083-522669216f83",
                                "text": "Omdat de huidige rioolwaterzuivering niet alle medicijnresten kan verwijderen, komen deze in het buitenwater terecht."
                            },
                            {
                                "example_id": "63386977-c71d-40bb-8e86-22c58ee125c8",
                                "sense_id": "b95627d0-e3ca-39fb-9083-522669216f83",
                                "text": "Nog even met de tenen in het buitenwater komende weken? Het De Mirandabad in Amsterdam-Zuid zou eerst het buitenbad sluiten op 20 september, maar blijft een weekje langer open."
                            }
                        ]
                    }
