                                    {
                                        "sense_id": "96665d74-63cd-35cf-b63e-f1ef20bedeb1",
                                        "entry_id": "511b0680-213c-3628-a275-ff4fe2bd8322",
                                        "glosses": [
                                            "die Gesundheit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34b237fb-32eb-48d3-92af-856d882885d1",
                                                "sense_id": "96665d74-63cd-35cf-b63e-f1ef20bedeb1",
                                                "text": "Aus gesundheitlichen Gründen ist er heute nicht auf der Arbeit erschienen."
                                            },
                                            {
                                                "example_id": "67864847-c1a3-489e-ae63-7577a1133376",
                                                "sense_id": "96665d74-63cd-35cf-b63e-f1ef20bedeb1",
                                                "text": "„Viele Artikel des täglichen Bedarfs, vom Lippenstift bis zum Abflußreiniger, dürfen nicht in den Handel gebracht werden, bevor ihre gesundheitliche Unbedenklichkeit nachgewiesen ist.“"
                                            },
                                            {
                                                "example_id": "1aba2330-020b-414d-91ac-98d4ffebab6f",
                                                "sense_id": "96665d74-63cd-35cf-b63e-f1ef20bedeb1",
                                                "text": "„Die jetzt veröffentlichten Fälle bestätigen die Befürchtungen, dass COVID-19 bei einigen Patienten langfristige gesundheitliche Probleme verursacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
