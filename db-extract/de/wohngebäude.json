                "senses": [
                    {
                        "sense_id": "61603edf-b38a-3a9a-b30e-9316b8746f7e",
                        "entry_id": "7c13861b-0188-3b75-8e92-aeddf124046b",
                        "glosses": [
                            "Gebäude, das zum Bewohnen gedacht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6d153e-5578-42fc-afe1-bb4b4a2dd6fc",
                                "sense_id": "61603edf-b38a-3a9a-b30e-9316b8746f7e",
                                "text": "Das Wohngebäude war baufällig und konnte nicht mehr erhalten werden."
                            },
                            {
                                "example_id": "002f9e19-4c3d-40bf-a80e-5bc38a39c198",
                                "sense_id": "61603edf-b38a-3a9a-b30e-9316b8746f7e",
                                "text": "„In einem Flächenland, das die Freiheit der afrikanischen Weite feierte, war jedes größere Wohngebäude von Mauern umgeben, jedes Haus eine Festung.“"
                            },
                            {
                                "example_id": "47faf95d-4edb-43a8-9590-ab7cf4cb22a2",
                                "sense_id": "61603edf-b38a-3a9a-b30e-9316b8746f7e",
                                "text": "„Zypressen umgaben das Grundstück, und die Morgensonne tauchte das ansehnliche Wohngebäude, den großen Stall und die Pferdekoppel in ein romantisches Licht.“"
                            },
                            {
                                "example_id": "70cd992c-d06c-4beb-b3e1-eb54aa4f39aa",
                                "sense_id": "61603edf-b38a-3a9a-b30e-9316b8746f7e",
                                "text": "„Das erste Gebäude enthielt die Empfangshalle für Gäste, eines diente als Opferstätte für Buddha und die Vorfahren, eines als Wohngebäude und das letzte als Küche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
