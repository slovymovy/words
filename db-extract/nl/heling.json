                        "target_lang_word": "guérison",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guérison",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                        "entry_id": "424df60a-476f-3e30-8e8b-3a657ef066f8",
                                        "glosses": [
                                            "Action de guérir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c53d7e8-d3b3-4ae5-a39a-93ed5f8ce785",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "Le Dr Aignier déclare au Congrès des monistes (Magdebourg, 6-10 septembre 1912) n'avoir constaté à Lourdes ni guérison ni amélioration véritables."
                                            },
                                            {
                                                "example_id": "fc330ffc-1a07-49c4-ad5e-0f2e70590b27",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "Guérison entière, parfaite, imparfaite."
                                            },
                                            {
                                                "example_id": "1d845bc2-dbf9-4646-a317-ff5e2b3cef0e",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "Il doit sa guérison à tel médecin, à tel remède."
                                            },
                                            {
                                                "example_id": "dad4a813-9497-4cdc-bc25-ae032f070514",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "Il ne pourra partir qu’après sa guérison, qu’après guérison."
                                            },
                                            {
                                                "example_id": "ac1d2a54-94f8-4596-8695-b6d1614de682",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "La guérison de ces sortes de maux, de maladies est lente, est difficile."
                                            },
                                            {
                                                "example_id": "1d8a5213-27d5-47ad-a14e-593c02fba889",
                                                "sense_id": "0ff3e5f7-574c-31ba-98e1-e23079a88556",
                                                "text": "Ce sont les machines qui, littéralement, enfantent notre monde. Et qui, de cet enfantement, permettent l’émergence d’un nouvel écosystème, d’une nouvelle espèce : depuis un peu moins d’un siècle, vous, moi, tous ceux qui lisent ce livre, doivent leur vie, leurs guérisons, leur agonie, leur bonheur et désespoir de moins en moins aux êtres qui peuplent leur désirs et de plus en plus aux machines qui les veillent calmement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
