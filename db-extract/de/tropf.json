                "senses": [
                    {
                        "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                        "entry_id": "05fbe601-a8ca-3810-8dab-9c569724dd55",
                        "glosses": [
                            "Vorrichtung für eine medizinische Infusion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405c520c-e968-46fc-8344-a8a0551fd43d",
                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                "text": "Sie lag im Koma und wurde mit dem Tropf ernährt."
                            },
                            {
                                "example_id": "4a2413bd-fefc-4052-8c85-48bf7096a9d6",
                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                "text": "„Die Schwester kam und hängte ein kleines Fläschchen vom Tropf ab und ein neues hinzu.“"
                            },
                            {
                                "example_id": "3b24338e-fe38-4c11-baa8-38801e11e977",
                                "sense_id": "398bc41e-8728-3fe8-830c-1fbe8b934c2d",
                                "text": "„Eigentlich müsste es längst pleite und verwüstet sein und am Tropf hängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                        "entry_id": "05fbe601-a8ca-3810-8dab-9c569724dd55",
                        "glosses": [
                            "armer oder bedauernswerter Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29bb3c8-6fab-4b25-bd76-4f7e1bb7e64e",
                                "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                                "text": "Lass ihn in Frieden, der arme Tropf hat's schwer genug."
                            },
                            {
                                "example_id": "134fbb02-fd42-4d44-84f5-3ab74bbac6ae",
                                "sense_id": "636032af-3daa-3bd8-b325-995da01e996a",
                                "text": "„Die Komödie lässt den armen Tropf neben all den glücklichen Paaren nicht nur im Regen stehen, sondern tunkt ihn in die Traufe des Wahnsinns.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
