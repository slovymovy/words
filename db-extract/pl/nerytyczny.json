                                    {
                                        "sense_id": "08670e96-7723-35c0-b831-18189b202d1d",
                                        "entry_id": "04e754c3-204b-3809-91da-67e98a7693f1",
                                        "glosses": [
                                            "Of or relating to a marine environment of shallow waters."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666d815c-7a1a-44b5-872f-79b6eb066ceb",
                                                "sense_id": "08670e96-7723-35c0-b831-18189b202d1d",
                                                "text": "Accessory benthic foraminiferal events reported by Berggren and Miller (1989) to occur in the late Eocene are the migrations into the bathyal realm from the neritic realm of planulinids and siphoninids."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93ebc490-7cb4-422c-a054-9769a2a62018",
                        "source_entry_id": "44b5cd85-3f87-3207-ac10-34527baf45ab",
                        "source_sense_id": "adbf244e-205d-31ca-83ea-4902e491fb0d",
                        "target_lang_word": "néritique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néritique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9908905-b18e-393c-858f-df315971850f",
                                        "entry_id": "6cde63e0-14c5-3c95-98c4-45eb23791b9d",
                                        "glosses": [
                                            "Se dit de la zone immergée qui surplombe le plateau continental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73fa02e7-3b99-4b49-9972-4b50f9b93031",
                                                "sense_id": "f9908905-b18e-393c-858f-df315971850f",
                                                "text": "Cependant, pour que des comparaisons soient possibles, il ne faut pas se contenter des prises absolues, mais les rapporter à la surface effectivement utilisée par les pêcheurs, en entendant par là les marges continentales et insulaires jusqu'à la profondeur de 1,000 m et les eaux néritiques sus-jacentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
