                "senses": [
                    {
                        "sense_id": "78a23e15-6b9f-36a0-851e-0e0be0a3d33f",
                        "entry_id": "ecad721d-b468-3a11-a4c8-7f4ba1663a93",
                        "glosses": [
                            "bedekt of doortrokken met fijverdeeld materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f6b2cb-d2e8-46d5-9f0f-7213171a4fd0",
                                "sense_id": "78a23e15-6b9f-36a0-851e-0e0be0a3d33f",
                                "text": "Wat is dat oude boek stoffig!"
                            },
                            {
                                "example_id": "d81155cf-120e-4ee3-8bef-520c2c0ade6c",
                                "sense_id": "78a23e15-6b9f-36a0-851e-0e0be0a3d33f",
                                "text": "Napoleon gaf de Route Nationale 7 haar naam. Hij maakte zelf ook gebruik van de weg. Zo overnachtte hij in de Auberge de la Teste Noire in Saint-Symphorien-de-Lay, net als Frans I, Rousseau en Rabelais. Het gebouw is niet meer in gebruik als herberg. In 1814 sliep Napoleon op weg naar Elba in het Relais de l'Empereur in Montélimar. Dat hotel is een paar jaar geleden gesloten. Volgens Trip Advisor stond het de laatste jaren bekend om zijn stoffige kamers, deplorabele ontvangst en gesloten restaurant."
                            },
                            {
                                "example_id": "56c6957c-f627-48db-94e7-6f2f4b397d51",
                                "sense_id": "78a23e15-6b9f-36a0-851e-0e0be0a3d33f",
                                "text": "Op de trail had ik eindelijk het gevoel een hippie te zijn omdat ik in een gemeenschap leefde van vrije geesten, kleurrijk en stoffig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57e23c0d-9ff7-4cba-b471-886359d91732",
                        "source_entry_id": "ecad721d-b468-3a11-a4c8-7f4ba1663a93",
                        "source_sense_id": "78a23e15-6b9f-36a0-851e-0e0be0a3d33f",
                        "target_lang_word": "polvoriento",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polvoriento",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f6edb939-5e6f-36d4-b12d-57ddf14c03ea",
                                        "entry_id": "26f167bb-08dc-398f-976b-7126cf1412d3",
                                        "glosses": [
                                            "Cubierto de polvo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f999b684-0e83-4726-955f-da87e9f5665f",
                                                "sense_id": "f6edb939-5e6f-36d4-b12d-57ddf14c03ea",
                                                "text": "Cómo lograste tanta precisión\ndescribiendo a mi pueblo blanco y polvoriento\nsi el sacristán por ahí no te vio,\nni el cura, ni el cabo, ni el polvo ni el viento."
