                ],
                "senses": [
                    {
                        "sense_id": "f71c0e16-f09f-37a2-9740-95cac0fbdddc",
                        "entry_id": "65f2470e-ee3b-37d9-ae87-9725e003d55c",
                        "glosses": [
                            "Faktor, um den zur Ermittlung der Steuerschuld oder Kammerumlage der Messbetrag erhöht wird"
                        ],
                        "tags": [
                            "Steuerwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "3fb94b25-0d26-4a22-aa9d-a92120d0954f",
                                "sense_id": "f71c0e16-f09f-37a2-9740-95cac0fbdddc",
                                "text": "„Der Hebesatz der Gewerbesteuer wurde im bundesweiten Durchschnitt um 2 Prozentpunkte auf 399 Prozent angehoben.“"
                            },
                            {
                                "example_id": "af33e7ec-0bb5-44a6-923a-41d1a3a42fd5",
                                "sense_id": "f71c0e16-f09f-37a2-9740-95cac0fbdddc",
                                "text": "„Die Gemeinden sind nach dem Finanzausgleichsgesetz ermächtigt, bei der Steuerfestsetzung einen einheitlichen Hebesatz von bis zu 500 Prozent auf den Grundsteuermessbetrag anzuwenden.“"
                            },
                            {
                                "example_id": "65ebbb04-0eb3-415e-a4e6-bd121432d9d5",
                                "sense_id": "f71c0e16-f09f-37a2-9740-95cac0fbdddc",
                                "text": "„ Der Hebesatz der Landeskammerumlage wird alljährlich von der Vollversammlung der Landes-Landwirtschaftskammer festgesetzt.“"
                            },
                            {
                                "example_id": "a530b26b-e434-4f07-824d-0aec11636fbc",
                                "sense_id": "f71c0e16-f09f-37a2-9740-95cac0fbdddc",
                                "text": "„Der Arbeitgeber hat die Lohnkirchensteuer in Höhe von 9% (Hebesatz am Sitz der Betriebsstätte) einzubehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5d14db91-26d6-3373-b7e7-59cc90d61f87",
                        "entry_id": "65f2470e-ee3b-37d9-ae87-9725e003d55c",
                        "glosses": [
                            "Zusammenstellung von Hydraulikzylindern mit handbetriebener Hydraulikpumpe und Zubehör"
                        ],
                        "tags": [
                            "Rettungsdienst"
                        ],
                        "examples": [
                            {
                                "example_id": "3ed3c3a7-7660-4297-a51f-35293b534c52",
                                "sense_id": "5d14db91-26d6-3373-b7e7-59cc90d61f87",
                                "text": "Mit einem Hebesatz kann man auch einen ganzen LKW bewegen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
