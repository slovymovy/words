                    {
                        "sense_id": "c49e9ccb-6e10-3fe4-9cca-3f0c40248752",
                        "entry_id": "b8882f6b-d5ec-3d16-97f0-f34bd96289bf",
                        "glosses": [
                            "Proclamation pour annoncer la vente des biens en justice."
                        ],
                        "tags": [
                            "Pratique"
                        ],
                        "examples": [
                            {
                                "example_id": "515c4fe9-4b1a-44c9-9e04-f819ac9f2c2f",
                                "sense_id": "c49e9ccb-6e10-3fe4-9cca-3f0c40248752",
                                "text": "Le code a substitué les affiches à la criée."
                            },
                            {
                                "example_id": "28ef4b95-c8ea-48a1-9a13-76b39cc8938f",
                                "sense_id": "c49e9ccb-6e10-3fe4-9cca-3f0c40248752",
                                "text": "Audience des criées : Celle où l’on vend les biens devant le tribunal."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0da13f8-64db-3b36-8599-375c17c8d0ae",
                        "entry_id": "b8882f6b-d5ec-3d16-97f0-f34bd96289bf",
                        "glosses": [
                            "Vente publique aux enchères."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "7553f5fb-8ace-4a77-99d7-2a3ec80aff21",
                                "sense_id": "c0da13f8-64db-3b36-8599-375c17c8d0ae",
                                "text": "Une vente à la criée."
                            },
                            {
                                "example_id": "2b02db8d-1c7d-4976-bdea-021ec92a517e",
                                "sense_id": "c0da13f8-64db-3b36-8599-375c17c8d0ae",
                                "text": "— Les grandes collections ne sont pas de froids entassements de bibelots, d’immobiles cimetières d’ossements comme l’imagine le public des criées célèbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ccf7abb-e795-30cf-a327-71948fea20ea",
                        "entry_id": "b8882f6b-d5ec-3d16-97f0-f34bd96289bf",
                        "glosses": [
                            "Marché de gros ou de détail spécialisé dans la vente de la pêche du jour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441e53e3-48da-4b8e-a270-9e12ce96ee14",
                                "sense_id": "3ccf7abb-e795-30cf-a327-71948fea20ea",
                                "text": "Vente à la criée : Se dit d’une vente en gros faite à la halle avant l’ouverture du marché."
                            },
                            {
                                "example_id": "905c0be8-5f61-4b0d-8e9f-6635418d5edf",
                                "sense_id": "3ccf7abb-e795-30cf-a327-71948fea20ea",
                                "text": "En passant de nouveau devant la criée du poisson d’eau douce, où les enchères étaient plus froides, il lui dit que cette vente baissait, que la pêche fluviale en France se trouvait fort compromise."
                            }
                        ]
                    }
