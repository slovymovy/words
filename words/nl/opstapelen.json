    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3cc405a3-0e29-386e-b104-178b75b1a8e4",
                    "sense_definition": "Iets op een hoop leggen of boven op elkaar plaatsen.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "stapelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>stapelen</w> de blokken op tot een hoge toren.",
                            "target_lang_translations": {
                                "pl": "Dzieci <w>układają</w> klocki w wysoką wieżę."
                            }
                        },
                        {
                            "text": "Hij <w>stapelt</w> de boeken <w>op</w> op zijn bureau.",
                            "target_lang_translations": {
                                "pl": "On <w>układa</w> książki w stos na swoim biurku."
                            }
                        }
                    ],
                    "synonyms": [
                        "stapelen",
                        "opeenhopen"
                    ],
                    "common_phrases": [
                        "boeken opstapelen",
                        "blokken opstapelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Układać rzeczy jedna na drugiej lub tworzyć z nich stos."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "układać w stos",
                                "target_lang_sense_clarification": "fizyczne układanie przedmiotów jeden na drugim"
                            },
                            {
                                "target_lang_word": "piętrzyć",
                                "target_lang_sense_clarification": "układać coś wysoko, tworząc konstrukcję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1335b8ce-3a81-3f22-9dc1-ebe3031eb3aa",
                    "sense_definition": "In grotere hoeveelheid aanwezig worden of toenemen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accumuleren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De onbetaalde rekeningen <w>stapelen</w> zich <w>op</w> op de keukentafel.",
                            "target_lang_translations": {
                                "pl": "Nieopłacone rachunki <w>piętrzą</w> się na stole kuchennym."
                            }
                        },
                        {
                            "text": "Tijdens de vakantie <w>stapelde</w> het werk zich <w>op</w> op kantoor.",
                            "target_lang_translations": {
                                "pl": "Podczas urlopu praca <w>nawarstwiała</w> się w biurze."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumuleren",
                        "ophopen",
                        "aangroeien"
                    ],
                    "antonyms": [
                        "krimpen"
                    ],
                    "common_phrases": [
                        "schulden opstapelen",
                        "werk opstapelen"
                    ],
                    "target_lang_definitions": {
                        "pl": "Gromadzić się w większej ilości, narastać."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gromadzić się",
                                "target_lang_sense_clarification": "zbieranie się czegoś w jednym miejscu"
                            },
                            {
                                "target_lang_word": "piętrzyć się",
                                "target_lang_sense_clarification": "narastanie problemów lub zadań"
                            },
                            {
                                "target_lang_word": "nawarstwiać się",
                                "target_lang_sense_clarification": "stopniowe zwiększanie się ilości czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
