                        ],
                        "form": "der Polygamie"
                    },
                    {
                        "form_id": "03996dee-00d9-4653-825b-5f9e196679ce",
                        "entry_id": "266ad17b-c75d-3021-9421-ffe4a8cfc256",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Polygamie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                        "entry_id": "266ad17b-c75d-3021-9421-ffe4a8cfc256",
                        "glosses": [
                            "eheliche Verbindung eines Menschen mit mehr als einer anderen Ehepartei gleichzeitig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43c16da-c7de-4ade-a5ad-949ba6353e17",
                                "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                                "text": "In Deutschland ist Polygamie nicht erlaubt."
                            },
                            {
                                "example_id": "26135970-baff-4ddc-8164-42e35de051f1",
                                "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                                "text": "„Er war nicht auf die Debatte um Polygamie eingegangen, doch war das Publikum der Meinung, dass er der Frage durch unmoralische Geistesgegenwart ausgewichen war - er, der weder von Geistesblitzen noch von Moral etwas versteht.“"
                            },
                            {
                                "example_id": "60d44338-4b4b-429f-a9fc-c11b722da0b3",
                                "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                                "text": "„In vielen afrikanischen Staaten wird zwar die monogame Ehe gefördert, doch ist die Polygamie nicht verboten.“"
                            },
                            {
                                "example_id": "90f5d4c8-2250-4282-a90e-3a7cef90a446",
                                "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                                "text": "„In besonders archaisch denkenden Kreisen stellt auch die Polygamie kein Problem dar, das will man sich im 21. Jahrhundert eigentlich gar nicht mehr vorstellen.“"
                            },
                            {
                                "example_id": "54a998e1-e2f1-4d88-9f8f-800f34e27b62",
                                "sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                                "text": "„Die Mission will in Afrika den Sklavenhandel und die Polygamie bekämpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c7385f3-7113-4b7d-be91-a4a2c9fdd097",
                        "source_entry_id": "266ad17b-c75d-3021-9421-ffe4a8cfc256",
                        "source_sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                        "source_sense_description": "Ehe mit mehr als einer anderen Ehepartei",
                        "target_lang_word": "多配偶制",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7778cabe-0201-4c51-b441-b41578235f8b",
                        "source_entry_id": "266ad17b-c75d-3021-9421-ffe4a8cfc256",
                        "source_sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                        "source_sense_description": "Ehe mit mehr als einer anderen Ehepartei",
                        "target_lang_word": "polygamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The condition of having more than one spouse or marriage partner at one time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d4a3cd-4495-4f67-8e0b-bb0c3290985b",
                                                "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                                "text": "Are there countries where polygamy is legal for both men and women?"
                                            },
                                            {
                                                "example_id": "e3804f52-81b4-47e6-a246-f548e8d35e93",
                                                "sense_id": "ba66faf3-6bf3-3e28-b7ee-042184594313",
                                                "text": "Miss Griffin was a model of propriety, and I am at a loss to imagine what the feelings of the virtuous woman would have been, if she had known, when she paraded us down the Hampstead Road two and two, that she was walking with a stately step at the head of Polygamy and Mahomedanism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "Synonym of polygyny (“marriage of a man to more than one wife, the practice of having several wives at the same time”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fe671a3-19e0-45fa-9662-828b9bd3016f",
                                                "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                                "text": "Though Islam allows polygamy, it is frowned upon in many contemporary Muslim societies."
                                            },
                                            {
                                                "example_id": "754179c2-7e27-46ec-bd3e-6bc5f2b932b9",
                                                "sense_id": "bfd92742-110f-3c27-84c4-14f975a2c4de",
                                                "text": "Because Mormon polygamy was an unusual family form in nineteenth-century America […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e7f698-9ab0-3b8b-87db-aaff238ca34f",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The state or habit of having more than one sexual mate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e515f38-ac55-4099-84ae-8b3b8839ed8b",
                                                "sense_id": "10e7f698-9ab0-3b8b-87db-aaff238ca34f",
                                                "text": "An insect queen actually practices polygamy only one day, while for an alpha-male defending his harem is the very essence of both his status and polygamy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95dfaae-84a0-3131-8785-cb581d5a4a23",
                                        "entry_id": "eef20e26-ff06-321f-ae21-49226ef409c0",
                                        "glosses": [
                                            "The condition or state of a plant which bears both perfect and unisexual flowers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fab4a959-6249-4c1c-a6a2-5b59e836b5f8",
                        "source_entry_id": "266ad17b-c75d-3021-9421-ffe4a8cfc256",
                        "source_sense_id": "ac54c69e-5f58-33f4-b974-813ee76bfe02",
                        "source_sense_description": "Ehe mit mehr als einer anderen Ehepartei",
                        "target_lang_word": "polygamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                        "entry_id": "a7a18008-1cbd-3c98-b1ac-037519227f11",
                                        "glosses": [
                                            "Relation conjugale où une personne est mariée à plusieurs autres à la fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db1d5de-7271-4b8a-a555-c54570083b54",
                                                "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                                "text": "La polygamie est défendue dans le christianisme."
                                            },
                                            {
                                                "example_id": "d2e44224-dc5d-4549-9f76-62ef3518f37b",
                                                "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                                "text": "Dans nos pays, la polygamie est un crime puni par les lois."
                                            },
                                            {
                                                "example_id": "71cf3581-9d2d-4d55-9aab-fcb913bafe95",
                                                "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                                "text": "Son provincial, il va le cuisiner aux petits oignons : en le faisant poursuivre par des médecins complètement givrés, armés de clystère, en répandant le bruit qu’il est criblé de dettes, en l’accusant de polygamie, avec comparution devant un faux juge, etc."
                                            },
                                            {
                                                "example_id": "8b676b33-e012-4af3-9b1a-263ec7ac8f06",
                                                "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                                "text": "Un fonctionnaire est marié à l’État et toute polygamie est interdite."
                                            },
                                            {
                                                "example_id": "72e4af4b-53f6-4232-9010-3ba09dc262a3",
                                                "sense_id": "2380fcef-6c8a-3ff6-be35-7c7162bd8410",
                                                "text": "Quoique ni les lois, ni les mœurs ne s’y opposent, l’immense majorité des Chinois n’est pas polygame, et leur langage écrit semble refléter leurs idées sur la polygamie : le caractère qui figure une femme sous un toit, signifie \"paix\". Deux femmes sous un toit signifient \"querelle\", et trois signifient l’intrigue et le désordre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c739ca-8f41-303f-aaa2-019d19a4453f",
                                        "entry_id": "a7a18008-1cbd-3c98-b1ac-037519227f11",
                                        "glosses": [
                                            "Polygynie, forme la plus répandue chez les humains de la polygamie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b73a5de-9c41-4946-a7c7-ce08f440d20f",
                                                "sense_id": "50c739ca-8f41-303f-aaa2-019d19a4453f",
                                                "text": "Il me déconcerta en me déclarant à brûle-pourpoint : « Il faut rendre libre la polygamie; ainsi une immense quantité de femmes, non mariées aujourd'hui, pourront l'être et connaîtront les joies de la maternité. »"
                                            },
                                            {
                                                "example_id": "00fcb4b2-24fb-4132-98b4-01ca5d6251e9",
                                                "sense_id": "50c739ca-8f41-303f-aaa2-019d19a4453f",
                                                "text": "La concession de l’oncle Moussa est l’exemple même d’une polygamie chaotique. … Les coépouses, rivales acharnées, qui en viennent aux mains, les adolescents frustrés qui se querellent à arme blanche entre frères, des filles répudiées et remariées, des accusations de maraboutage, de sorcellerie, de drogue ou d’alcool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86f6dc4c-1373-3ba6-8205-a02e9de94f59",
                                        "entry_id": "a7a18008-1cbd-3c98-b1ac-037519227f11",
                                        "glosses": [
                                            "Classe du système de Linné, qui renferme les plantes qui portent des fleurs staminées ou pistillées, ou stamino-pistillées sur un ou plusieurs individus."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3de14b9c-31dc-4236-96ef-afb96690906a",
