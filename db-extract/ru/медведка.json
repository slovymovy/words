                                    {
                                        "sense_id": "c489a2ee-6d42-3ac1-a2c8-0a336f3846a4",
                                        "entry_id": "a4dc6bc8-de35-3a6b-89d0-b14a25cecbee",
                                        "glosses": [
                                            "Any of various large insects from the family Gryllotalpidae that burrow into moist soil and feed on plant roots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148b5f5b-ec10-406a-b661-0007cc0a033f",
                                                "sense_id": "c489a2ee-6d42-3ac1-a2c8-0a336f3846a4",
                                                "text": "Spain is full of mole-crickets, shrill little underground insects whose goggle eyes you may sometimes see peering sleeplessly out of their burrows, and whose buzz is so energetic that their whole bodies vibrate down there like the radiators of very old motor-cars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
