                ],
                "senses": [
                    {
                        "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                        "entry_id": "f75c27ad-eb68-343f-a224-3d3acfc0d602",
                        "glosses": [
                            "kleinster, charakteristischer Durchmesser eines Tropfens, der relevant ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "229ae034-ce86-4425-a958-eeb06a9e3d18",
                                "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                                "text": "„Dagegen bezieht sich der Fraktionsabscheidegrad auf die Abscheidung von Tropfen in einem bestimmten Durchmesserintervall (Fraktion). Er steigt mit zunehmendem Tropfendurchmesser und beträgt beim Grenztropfendurchmesser definitionsgemäß 50 %.“"
                            },
                            {
                                "example_id": "d5b8ec9d-91f6-40cc-9a78-e5ed9eb1e075",
                                "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                                "text": "„Bild F2-27 zeigt beispielhaft für einige Tropfenabscheider die von Bürkholz ermittelte Beziehung zwischen Grenztropfendurchmesser und gasseitigem Druckverlust.“"
                            },
                            {
                                "example_id": "a95c1eae-ab4e-4cde-8732-f97f2ab9dfd4",
                                "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                                "text": "„Ein Dralltropfenabscheider mit Drallerzeuger und Wendelrohr zeigt einen Druckverlust, der mit sinkendem Grenztropfendurchmesser sehr stark ansteigt.“"
                            },
                            {
                                "example_id": "e5e252f4-1814-441a-8416-e6fa11947317",
                                "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                                "text": "„Für jeden Abscheider gibt es einen bestimmten Grenztropfendurchmesser, bis zu dem kleinere Tropfen den Abscheider passieren.“"
                            },
                            {
                                "example_id": "72659495-d8c0-4a95-8fef-d83155594b44",
                                "sense_id": "2f117c83-7b0b-391c-a613-927f397b3c5c",
                                "text": "„Der größte Teil der Tropfen oberhalb eines Grenztropfendurchmessers wird dabei durch Trägheitskräfte an die Tropfenabscheiderwand geschleudert und abgeschieden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
