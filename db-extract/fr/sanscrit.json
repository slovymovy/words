                                "text": "La langue sanscrite."
                            }
                        ]
                    },
                    {
                        "sense_id": "844ed6ab-d77e-3fea-aaab-252480f66ccf",
                        "entry_id": "d74f0e3e-6c19-30f7-aca0-d2e6cc5fb91e",
