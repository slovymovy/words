                                                "sense_id": "94ef0327-06bf-33d3-9899-cb6f6ac43261",
                                                "text": "Andere materialen geschikt voor de allerkleinsten zijn polypropyleen (een soort plastic), rvs of siliconen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rvs",
