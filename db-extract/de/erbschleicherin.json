                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b84c66-952e-4c28-9e3a-76d713bacd82",
                                "sense_id": "22ac0c1a-b1f2-389e-81ac-86a567869c78",
                                "text": "„Das war ein stinkreicher Opa, der in einer Villa in der Gartenstadt wohnte und mit einer mindestens dreißig Jahre jüngeren Erbschleicherin verheiratet war.“"
                            },
                            {
                                "example_id": "1f86285e-120f-4185-94e3-79d064c06517",
                                "sense_id": "22ac0c1a-b1f2-389e-81ac-86a567869c78",
                                "text": "„Klaus Schmidt sagt, er sei Opfer von einer Erbschleicherin geworden - und er ist nicht der einzige.“"
                            }
                        ],
