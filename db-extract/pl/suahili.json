                    },
                    {
                        "translation_id": "5249fec4-ac97-45bb-8f7d-12c6bd9652f6",
                        "source_entry_id": "e59315a6-21e4-3fc6-bb8d-ec9bf0b8f9b8",
                        "source_sense_id": "4ec932e0-e07d-369d-8b47-1b00a206e313",
                        "target_lang_word": "Swahili",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                        "entry_id": "7559d4d5-3f4b-326b-a00e-654a18f5e4d5",
                                        "glosses": [
                                            "eine in Kenia und Tansania gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a10e87e-06bd-4735-b1b5-55063d508ad1",
                                                "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                                "text": "„Mehr als 80 Millionen Menschen beherrschen Swahili, was die Sprache zu der am meisten gesprochenen Bantusprache der Welt macht.“"
                                            },
                                            {
                                                "example_id": "284f68ad-c1b9-4680-a877-b70e71a42612",
                                                "sense_id": "f96ad57e-0067-3d7e-a85e-18a9a85dc479",
                                                "text": "„Jonathan hielt die Schwarzen an, redete auf Swahili mit ihnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                        "entry_id": "7f441410-5b36-3e19-9fb9-5006f1d3c788",
                                        "glosses": [
                                            "Bewohner Ostafrikas, der die Bantusprache Swahili als Muttersprache spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42bd1159-7339-472e-af78-931337bc8f3b",
                                                "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                                "text": "„Der Wohlstand der Swahili gründete auf dem Handel.“"
                                            },
                                            {
                                                "example_id": "5bb65aea-914a-4368-ab52-e9df45274451",
                                                "sense_id": "2c75bf6d-f550-3d1a-bc66-d98d3ebab01d",
                                                "text": "„Die Chagga profitierten von den Beziehungen mit den Swahili, gelangten an Schusswaffen, die ihren Einfluss und ihre Macht festigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99cc6285-8834-40f4-96e2-04fbad4fe1d5",
                        "source_entry_id": "e59315a6-21e4-3fc6-bb8d-ec9bf0b8f9b8",
                        "source_sense_id": "4ec932e0-e07d-369d-8b47-1b00a206e313",
                        "target_lang_word": "Suaheli",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suaheli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                        "entry_id": "20028f0f-1a5e-308d-abca-15e66f3f58f5",
                                        "glosses": [
                                            "eine in Kenia und Tansania gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eeaca0-21de-42be-92f2-b7920e489b21",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Wilson sprach auf Suaheli mit dem Fahrer.“"
                                            },
                                            {
                                                "example_id": "1aa8659f-edc9-41e3-a6d4-ab5773ad6d65",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Sprechen Sie Suaheli?"
                                            },
                                            {
                                                "example_id": "49d9fca8-ca9a-4fa1-a8e7-adce02e15336",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Hast Du in Afrika auch Suaheli gelernt?"
                                            },
                                            {
                                                "example_id": "1af430a4-9eae-447c-9b91-a0d8ede750fa",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Das Suaheli erlangte durch den Film „Der König der Löwen“ größere Bekanntheit in Europa."
                                            },
                                            {
                                                "example_id": "6919bd76-189a-46a8-82b0-328d7e18e085",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Dort gab es die politische Entscheidung, Suaheli zur Nationalsprache zu machen, was aber keine rein afrikanische Sprache ist, sondern eine durch den Sklavenhandel entstandene Mischung aus afrikanischen Dialekten, Arabisch und portugiesischen Brocken.“"
                                            },
                                            {
                                                "example_id": "b793fc9d-4bc7-43ca-a676-c6acc80d243b",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Über Finschs Kopf tauchte die Afrikanerin auf, schrie etwas auf Suaheli und schlug mit den Fäusten auf Finsch ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
