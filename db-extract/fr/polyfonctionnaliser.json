                "senses": [
                    {
                        "sense_id": "2043afbf-1880-3d77-89b2-fd6504273825",
                        "entry_id": "ac339c24-5d0d-3932-bf8e-eea9c3997169",
                        "glosses": [
                            "Donner un caractère polyfonctionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80b7d418-449e-485a-b20e-f0d2f3637dff",
                                "sense_id": "2043afbf-1880-3d77-89b2-fd6504273825",
                                "text": "En effet, il est possible de polyfonctionnaliser de façon régiosélective et indépendante la sphère de C₆₀ par des groupements de type malonate en six positions équivalentes (Figure 1), permettant ainsi l'accès à des structures organiques inédites possédant un nombre variable de groupements mésogènes répartis en des positions précises sur la sphère de carbone."
                            },
                            {
                                "example_id": "656189cd-549e-4949-bcc1-0fd63533208c",
                                "sense_id": "2043afbf-1880-3d77-89b2-fd6504273825",
                                "text": "Il est possible de polyfonctionnaliser ces structures par exemple par des médicaments ou d’autre molécules d’intérêts en plus d’un adressage qui permettra après excitation lumineuse une libération à un endroit précis."
                            }
                        ]
                    }
