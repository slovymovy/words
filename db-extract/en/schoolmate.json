                        "translation_id": "ee4c423e-0ac5-4617-a340-a56ad5e7f710",
                        "source_entry_id": "9235123b-7a7e-3a62-a5a9-a0d738700730",
                        "source_sense_id": "57dec2e6-75ad-30bb-8cb7-6ca3ec4f5e0d",
