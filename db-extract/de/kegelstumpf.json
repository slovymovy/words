                "senses": [
                    {
                        "sense_id": "46df14f8-e06a-37bf-961c-b5f2d6f4be3c",
                        "entry_id": "ca7a3fb0-aa52-32f7-9542-707be2608c5b",
                        "glosses": [
                            "Stumpf, der durch einen parallel zur Grundfläche eines Kegels geführten Schnitt entsteht"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3ba87a-0fe8-4228-bd6b-376ea590cd69",
                                "sense_id": "46df14f8-e06a-37bf-961c-b5f2d6f4be3c",
                                "text": "„Ein Highlight der außergewöhnlichen Architektur dieses Gebäudekomplexes ist ein 8 m hoher Medienturm im Empfangsbereich. Als offener, auf der Spitze stehender Kegelstumpf, stellte er nicht nur eine Herausforderung für das Rohbauunternehmen Göbel und die Betontechnologie dar, sondern auch für die Schalungsplaner von MEVA.“"
                            }
                        ],
