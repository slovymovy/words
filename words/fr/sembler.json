                },
                {
                    "sense_id": "4e3746fb-24e8-3408-b6ff-ba2ae6f4c8f5",
                    "sense_definition": "Être perçu d'une certaine façon dans l'esprit de quelqu'un, souvent dans une tournure impersonnelle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il me <w>semble</w> que nous avons déjà pris une décision à ce sujet.",
                            "target_lang_translations": {
                                "en": "It <w>seems</w> to me that we have already made a decision on this matter.",
                                "ru": "Мне <w>кажется</w>, что мы уже приняли решение по этому вопросу.",
                                "nl": "Het <w>lijkt</w> me dat we hierover al een besluit hebben genomen.",
                                "de": "Mir <w>scheint</w>, dass wir in dieser Frage schon eine Entscheidung getroffen haben.",
                                "pl": "<w>Wydaje</w> mi <w>się</w>, że w tej sprawie już podjęliśmy decyzję.",
                                "it": "Mi <w>sembra</w> che abbiamo già preso una decisione in merito.",
                                "cs": "<w>Zdá se</w> mi, že jsme v této věci už přijali rozhodnutí.",
                                "tr": "Bana öyle <w>geliyor</w> ki bu konuda zaten bir karar aldık.",
                                "es": "Me <w>parece</w> que ya hemos tomado una decisión al respecto.",
                                "zh": "我<w>觉得</w>我们已经就这件事做出了决定。"
                            }
                        },
                        {
                            "text": "Tu peux organiser ton emploi du temps comme bon te <w>semble</w>.",
                            "target_lang_translations": {
                                "en": "You can organise your timetable as <w>seems</w> best to you.",
                                "ru": "Ты можешь составлять своё расписание, как тебе <w>заблагорассудится</w>.",
                                "nl": "Je kunt je rooster indelen zoals het jou het beste <w>lijkt</w>.",
                                "de": "Du kannst deinen Zeitplan so gestalten, wie es dir richtig <w>erscheint</w>.",
                                "pl": "Możesz ułożyć swój plan zajęć, jak ci <w>się podoba</w>.",
                                "it": "Puoi organizzare il tuo orario come meglio ti <w>pare</w>.",
                                "cs": "Rozvrh si můžeš uspořádat, <w>jak uznáš za vhodné</w>.",
                                "tr": "Ders programını sana nasıl uygun <w>geliyorsa</w> öyle düzenleyebilirsin.",
                                "es": "Puedes organizar tu horario como mejor te <w>parezca</w>.",
                                "zh": "你<w>觉得</w>怎么合适，就怎么安排日程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apparaître"
                    ],
                    "common_phrases": [
                        "il me semble",
                        "il semble que",
                        "comme bon lui semble"
                    ],
                    "target_lang_definitions": {
                        "en": "To seem or appear to someone in a certain way, often in impersonal phrases such as 'it seems to me'.",
                        "ru": "Складываться в чьём-либо мнении определённым образом; часто употребляется в безличном обороте «мне кажется».",
                        "nl": "Op iemand op een bepaalde manier overkomen, vaak onpersoonlijk gebruikt in zinnen als 'het lijkt mij'.",
                        "de": "Im Urteil einer Person auf eine bestimmte Weise erscheinen, oft in unpersönlichen Wendungen wie „mir scheint“.",
                        "pl": "Jawić się komuś w określony sposób w jego ocenie, często w zdaniach bezosobowych, np. „wydaje mi się”.",
                        "it": "Apparire a qualcuno in un certo modo, spesso in costruzione impersonale.",
                        "cs": "Někomu připadat nebo se jevit určitým způsobem, často v bezosobním obratu „zdá se mi“.",
                        "tr": "Birinin düşüncesinde belirli bir izlenim bırakmak; çoğunlukla 'bana öyle geliyor' gibi kalıplarda kullanılır.",
                        "es": "Causar a alguien una determinada impresión, a menudo en construcciones impersonales como «me parece».",
                        "zh": "在某人看来呈现出某种样子，常用于“我觉得……”之类的句式。"
                    },
