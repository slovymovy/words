                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "Payment by the groom or his family to the bride's family."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b0c6b11-1160-43c7-b0aa-7d0eab74eb61",
                                                "sense_id": "1d9d370d-43b9-3333-b5b6-854c6ecdc241",
                                                "text": "The family of the groom makes sure the new couple has a house to live in and land to cultivate; they will also pay for the dowry (crucial, for without dowry the new father has no rights over his children; Trouwborst 1962: 136ff.)"
                                            }
                                        ]
                                    },
