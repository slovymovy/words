                {
                    "sense_id": "0afdbb69-543b-35f6-84f1-04b64c2c48ca",
                    "sense_definition": "Specyficzny klimat lub wrażenia emocjonalne charakterystyczne dla danego miejsca, sytuacji lub utworu.",
