                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23e38dce-9e69-40b0-927b-520577892b9c",
                                "sense_id": "48a069dd-bb07-377f-8166-1edea4788fc9",
                                "text": "At last the Altitonant displaz me hiz mayn poour ; with blaz of burning darts, flying too and fro, learns of starz corruscant, streamz and hail of firie sparkes, lightninges of wildfier a-water and lond."
                            },
                            {
                                "example_id": "9fc2673f-cf6c-4f8d-82e3-d65fda64c3b2",
                                "sense_id": "48a069dd-bb07-377f-8166-1edea4788fc9",
                                "text": "The thunderstorm had stopped, the rain merely drizzled down and the aunt's boom had settled down from seemingly trying to equal the altitonant above even her considerable range by the time, a brief trip, the cabbie, his neat uniform sodden from sweating, drove up to the minicipal cemetery's entrance."
                            }
                        ]
