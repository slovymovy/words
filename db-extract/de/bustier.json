                                "target_senses": [
                                    {
                                        "sense_id": "98f6242f-9ec8-3476-8677-24ac5567a3af",
                                        "entry_id": "939e7849-6a81-3b63-84d1-aa4b519fe832",
                                        "glosses": [
                                            "Corset souple, serre-taille, sous-vêtement féminin qui soutient la poitrine et la met en valeur. Il peut se fixer ou non au moyen de bretelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc636bab-eccf-4a00-9a3b-7c8e5960df7c",
                                                "sense_id": "98f6242f-9ec8-3476-8677-24ac5567a3af",
                                                "text": "Je pensais que j’avais des seins à bustier, mais comme je suis une couarde, j’ai choisi le dos nu à ficelle amovible."
                                            },
                                            {
                                                "example_id": "17f1ec39-36d9-4121-aa79-95d530c93182",
                                                "sense_id": "98f6242f-9ec8-3476-8677-24ac5567a3af",
                                                "text": "Pour un véritable « bustier », c’est-à-dire un corsage qui peut faire office de soutien-gorge, la fixation des baleines ne peut pas être invisible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bustier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f781c59f-d41f-3af3-b054-1584d6eaeaa9",
                                        "entry_id": "caeb790a-c66e-312d-ae63-4bcfe7e57c8b",
                                        "glosses": [
                                            "Sculpteur spécialisé dans la réalisation de bustes."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29490384-5900-4d1a-b4ef-458fd3c3a5e1",
                                                "sense_id": "f781c59f-d41f-3af3-b054-1584d6eaeaa9",
                                                "text": "Il serait superflu de souligner l'intérêt exceptionnel que présenterait un portrait du plus grand bustier du XVIIIᵉ siècle par son émule en peinture."
                                            },
                                            {
                                                "example_id": "3864256a-78f1-4e53-92a0-f9df42ea0d34",
                                                "sense_id": "f781c59f-d41f-3af3-b054-1584d6eaeaa9",
                                                "text": "Le bustier et médailleur Charles Samuel érige en 1894 un monument commémoratif le long des étangs où l’illustre écrivain aimait s’asseoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
