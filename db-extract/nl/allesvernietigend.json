                "senses": [
                    {
                        "sense_id": "d4a7f777-05fa-3931-8955-50e3251bd5da",
                        "entry_id": "d3b631c0-c1d0-340e-9523-c03f8cefb352",
                        "glosses": [
                            "alles en iedereen kapotmakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f916abab-07c3-410a-bda3-ae6fc6475a15",
                                "sense_id": "d4a7f777-05fa-3931-8955-50e3251bd5da",
                                "text": "En terwijl de regen monotoon tegen de ramen ketste, bladerde ik gefascineero door het gevoelsleven van mensen die zich los wilden boksen van een gevestigde orde, maar vertrapt werden door die grote allesvernietigende oorlog die zich reeds aankondigde."
                            },
                            {
                                "example_id": "ee243d89-2648-4c95-83f5-7c984f9d409d",
                                "sense_id": "d4a7f777-05fa-3931-8955-50e3251bd5da",
                                "text": "Zijn krachtige blik leek allesvernietigende kreten uit te stoten: 'Loop niet weg! Ik zal jullie doden! Ik zal jullie opeten!' Toen de haka voorbij was werd Fraisse weer zijn gewone, vriendelijke zelf."
                            }
                        ]
                    }
