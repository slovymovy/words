                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe790f3e-29d9-4fec-b693-8d38d366e9d2",
                                                "sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                                                "text": "Wordt er in uw beroep vaak gebruik gemaakt van technieken?"
                                            },
                                            {
                                                "example_id": "73840385-0b1a-4d49-bd24-510fe6dd84cc",
                                                "sense_id": "b0355d4d-1007-3bca-9fb4-e0b323e7a7da",
                                                "text": "Normaal gesproken was dat geen enkel probleem geweest, ze gebruikten een eenvoudige en beproefde techniek met platen en bouten voor de samenvoeging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                                        "glosses": [
                                            "de bewerkingen en verrichtingen die horen bij de industrie en de exacte wetenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d630994-c25f-4546-9cae-2725d48188cf",
                                                "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                                                "text": "Er is een speciale techniek voor reanimatie."
                                            },
                                            {
                                                "example_id": "3ad0df1f-9d57-4abe-a2c8-491614502efd",
                                                "sense_id": "b721cbc2-b97f-3a24-8152-8a2863e443b1",
                                                "text": "En met de Duitse organisatie en techniek kon er de hoognodige orde komen in het Franse gekkenhuis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb12ca0-b5f7-33cc-ac2b-3942275efb4e",
                                        "entry_id": "83ee2a37-9789-34d1-94cd-8ef3c140b4b0",
                                        "glosses": [
                                            "de manier waarop dingen zijn verricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f87d1c4-3b07-49e7-b9a6-fd893039ed83",
                                                "sense_id": "9cb12ca0-b5f7-33cc-ac2b-3942275efb4e",
                                                "text": "Hier worden echt speciale technieken gebruikt..."
