                ],
                "senses": [
                    {
                        "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                        "entry_id": "bf419538-095d-3899-9798-e71fc9a41010",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05f64527-4642-491d-bb0d-34b4e9471c81",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Frau Haab ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7e5a4155-0fee-4aec-9a59-84ad60a6b424",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Herr Haab wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2c1d9b2d-8e07-4a87-a789-433a15255c5e",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Die Haabs kommen heute aus Mainz."
                            },
                            {
                                "example_id": "fc24dc55-20bf-47a1-af91-14c1a40cc87b",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Der Haab trägt nie die Schals, die die Haab ihm strickt."
                            },
                            {
                                "example_id": "d36f029a-aa41-4543-b2d3-41ac58061698",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haab kommt, geht der Herr Haab.“"
                            },
                            {
                                "example_id": "cd83d073-ad83-46c6-b538-20914fb51628",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Haab kommt und geht."
                            },
                            {
                                "example_id": "5ee88a10-0479-4066-87d3-6507f9a86a38",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "Haabs kamen, sahen und siegten."
                            },
                            {
                                "example_id": "b7e0d6c1-6616-488d-a891-c2bdd9dd003a",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "An verregneten Herbsttagen ist Familie Haabs liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "fc88c8c0-99d8-4b8f-b0bf-25101a876d82",
                                "sense_id": "e6e57779-9a36-39dc-b234-7fb450c92572",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Haab das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
