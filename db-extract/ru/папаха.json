                "senses": [
                    {
                        "sense_id": "9cef24ad-8e17-3f58-bc35-c3b8ed6973a2",
                        "entry_id": "1c63722d-d921-38bc-919f-ab956f0fb63c",
                        "glosses": [
                            "у казаков, народов Кавказа и Средней Азии: высокая мужская косматая меховая шапка из овчины, обычно с суконным верхом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15f3792-f7d5-416d-9ff6-1d59fd6bfdc2",
                                "sense_id": "9cef24ad-8e17-3f58-bc35-c3b8ed6973a2",
                                "text": "Солдаты были в полушубках и папахах."
                            },
                            {
                                "example_id": "14c977d0-8ad2-489c-959e-d7a2a0e0fda1",
                                "sense_id": "9cef24ad-8e17-3f58-bc35-c3b8ed6973a2",
                                "text": "Рисунок красками: голова с отвисшими усами, в папахе с синим хвостом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "750b6460-7736-4559-80ba-48c9c66827ea",
                        "source_entry_id": "1c63722d-d921-38bc-919f-ab956f0fb63c",
                        "source_sense_id": "9cef24ad-8e17-3f58-bc35-c3b8ed6973a2",
                        "source_sense_description": "головной убор",
                        "target_lang_word": "papakha",
