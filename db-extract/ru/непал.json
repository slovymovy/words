                                        "glosses": [
                                            "A country in South Asia, located between China and India. Official name: Federal Democratic Republic of Nepal. Capital and largest city: Kathmandu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba385b89-71cd-4a65-9730-9deb218b650e",
                                                "sense_id": "71b5737a-d304-365e-95f9-31a24506174e",
                                                "text": "The Newa script, also known as Nepaalalipi in Nepal and as Newar in English-speaking countries, is a Brahmi-based script that dates to the tenth century ce."
                                            }
                                        ]
                                    }
                                ]
                            }
