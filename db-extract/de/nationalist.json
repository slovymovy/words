                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Nationalisten"
                    },
                    {
                        "form_id": "e28a8fea-cf8e-442b-865e-51f1654b2864",
                        "entry_id": "59e507b2-9159-37ad-bcf2-adf9d7d315ab",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nationalisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "49acc446-4287-32a3-a5f0-087ddc7fe136",
                        "entry_id": "59e507b2-9159-37ad-bcf2-adf9d7d315ab",
                        "glosses": [
                            "Anhänger/Vertreter des Nationalismus; jemand, der die Interessen der eigenen Nation über alle anderen stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f3c22a9-ad3c-457e-9a06-7ec8733e6c5e",
                                "sense_id": "49acc446-4287-32a3-a5f0-087ddc7fe136",
                                "text": "„Meine Großeltern und meine Urgroßmutter hatten schon 1930 ihre Heimat verlassen müssen, als immer mehr Muslime Opfer der Gewalt serbischer Nationalisten wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "636009bc-ae93-4285-8ef8-6e4d0c3c83d3",
                        "source_entry_id": "59e507b2-9159-37ad-bcf2-adf9d7d315ab",
                        "source_sense_id": "49acc446-4287-32a3-a5f0-087ddc7fe136",
                        "target_lang_word": "nationalist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nationalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51f98d0c-138c-3931-8ab8-f2347310c15f",
                                        "entry_id": "9f63df44-5db0-3d9d-aab0-177be9a38ef0",
                                        "glosses": [
                                            "Of or relating to nationalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc231c1a-4a7e-431a-adb4-ecf7ebb11f45",
                                                "sense_id": "51f98d0c-138c-3931-8ab8-f2347310c15f",
                                                "text": "The anti-German riots which erupted simultaneously in many countries in response to the torpedoing of the Lusitania by a German U-boat in 1915 reflected shifts in the status of minorities in multi-ethnic societies at a time of escalating nationalist emotions."
                                            },
                                            {
                                                "example_id": "5dd416b9-0d95-41a5-a415-9064e35f31d5",
                                                "sense_id": "51f98d0c-138c-3931-8ab8-f2347310c15f",
                                                "text": "Nationalism has been on the rise worldwide, as evidenced by the success of nationalist political parties in Europe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nationalist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eac7d270-54a6-3528-83c9-7ed5275d5680",
                                        "entry_id": "f01f3194-cf26-3214-a7c2-a46effe6534b",
                                        "glosses": [
                                            "An advocate of nationalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0460876-4418-4f58-a7cf-533603fe1ace",
                                                "sense_id": "eac7d270-54a6-3528-83c9-7ed5275d5680",
                                                "text": "You are either a globalist or a nationalist; one cannot be both."
                                            },
                                            {
                                                "example_id": "980d82f7-85bf-4544-82bb-46b4e86d6690",
                                                "sense_id": "eac7d270-54a6-3528-83c9-7ed5275d5680",
                                                "text": "The dilemma arose from what nationalists perceived as an intolerable disjuncture between the broad geographical extent of Serbdom—the imagined community of Serbs—and the Serbian state as a territorial homeland."
                                            },
                                            {
                                                "example_id": "689e2aca-ad5e-48ea-92b8-d1d646c6713f",
                                                "sense_id": "eac7d270-54a6-3528-83c9-7ed5275d5680",
                                                "text": "It also would cut deeply into the trans-Atlantic alliance at the worst possible time by giving anti-American, anti-capitalist nationalists and protectionists in Europe a platform to thrive. Anti-American sentiment will grow, and Europe risks a retreat to protectionism. Those of us who make the case for the trans-Atlantic alliance will have a much harder job."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cec3980-5dbf-4cc6-9841-58d8ccaca4bd",
                        "source_entry_id": "59e507b2-9159-37ad-bcf2-adf9d7d315ab",
                        "source_sense_id": "49acc446-4287-32a3-a5f0-087ddc7fe136",
