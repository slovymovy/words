                    {
                        "translation_id": "ee58048d-68a5-4e20-a732-fef043df719b",
                        "source_entry_id": "1c0b2b93-7035-3440-b66d-50d43b0b465f",
                        "source_sense_id": "7176cb5d-3e43-365f-a809-9183c61eab6f",
                        "target_lang_word": "silencieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silencieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "122c189e-bd89-3630-ba3d-37f3888a785d",
                                        "entry_id": "452d291e-f59a-32f2-b385-34bf79b782f5",
                                        "glosses": [
                                            "D’une manière silencieuse; en silence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3fd4578-977a-4ede-a28c-6da71ac36409",
                                                "sense_id": "122c189e-bd89-3630-ba3d-37f3888a785d",
                                                "text": "Afin que, retraçant aux jeunes gens le souvenir des hommes illustres, ils invitassent silencieusement à les imiter,"
                                            },
                                            {
                                                "example_id": "f3a6852b-026e-4554-9b7b-fe2a15eca486",
                                                "sense_id": "122c189e-bd89-3630-ba3d-37f3888a785d",
                                                "text": "Dans ces murailles, les murmures, les lamentations, les appels à la justice et les cris de la souffrance meurent tous silencieusement."
                                            },
                                            {
                                                "example_id": "0a054a63-ecd4-4b52-a608-8d6eb528a387",
                                                "sense_id": "122c189e-bd89-3630-ba3d-37f3888a785d",
                                                "text": "Les uns allaient rendre leurs armes ; d'autres, qui les avaient abandonnées déjà, marchaient silencieusement, les mains ballantes."
                                            },
                                            {
                                                "example_id": "13b75681-d0e5-4694-9e1e-8f59cfcec567",
                                                "sense_id": "122c189e-bd89-3630-ba3d-37f3888a785d",
                                                "text": "Le Père Directeur, qui était venu me rejoindre dans mon bureau de l’hôpital , ne me répondit rien et continua à tirer silencieusement sur son long fume-cigare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "997b2293-8e83-34a8-aa6b-1aaf31d8991a",
                                        "entry_id": "452d291e-f59a-32f2-b385-34bf79b782f5",
                                        "glosses": [
                                            "Sans faire parler de soi."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956d9b5a-c17c-429a-9918-18f7fcd0b34f",
                                                "sense_id": "997b2293-8e83-34a8-aa6b-1aaf31d8991a",
                                                "text": "Naguère l'artiste rebuté par la stupidité de la foule se repliait dans sa coquille, œuvrait silencieusement, en garde contre le pompiérisme odieux de son époque, attendant son heure qui sonnait toujours trop tard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1a58b6-f4aa-49b9-aa87-19785082873b",
                        "source_entry_id": "1c0b2b93-7035-3440-b66d-50d43b0b465f",
                        "source_sense_id": "7176cb5d-3e43-365f-a809-9183c61eab6f",
                        "target_lang_word": "en silence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en silence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                        "entry_id": "ab1320ab-26c6-37f4-b882-98f548cb973f",
                                        "glosses": [
                                            "Sans faire de bruit ; silencieusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cafdde1-4f14-47a8-8a9b-ca7ee6e11753",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Ils cheminaient donc en silence et ils allaient traverser la chaussée pour remonter le côté gauche du boulevard Malesherbes, lorsque le financier s'arrêta."
                                            },
                                            {
                                                "example_id": "fd7bf09a-1201-411b-893b-eb2593204309",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                                            },
                                            {
                                                "example_id": "73f39fe4-10d1-46de-8cbf-20490c629df0",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Le repas était, comme toujours en Polynésie, une affaire très sérieuse et tout le monde mangeait en silence."
                                            },
                                            {
                                                "example_id": "fdcdb57b-413e-4421-b240-825cb04bdabf",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "François s’exécuta, puis, d'un coup de pouce, il enflamma son briquet d’amadou et le tendit, en silence, à la fille."
                                            },
                                            {
                                                "example_id": "44708851-23dd-4447-84b7-adf9ab4c6902",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Nous écoutâmes un morceau en silence."
                                            },
                                            {
                                                "example_id": "2c36c133-cb9d-4448-ba58-df40129a0e33",
                                                "sense_id": "535bcfa9-e316-39b0-9744-087469654b82",
                                                "text": "Un soir, t’en souvient-il ? nous voguions en silence ;\nOn n’entendait au loin, sur l’onde et sous les cieux,\nQue le bruit des rameurs qui frappaient en cadence\nTes flots harmonieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b015f0c5-1bd3-4deb-a43e-b4c271b7b0ba",
                        "source_entry_id": "1c0b2b93-7035-3440-b66d-50d43b0b465f",
                        "source_sense_id": "7176cb5d-3e43-365f-a809-9183c61eab6f",
                        "target_lang_word": "tacitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tacitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                        "entry_id": "ae076d72-f647-307e-b61a-291cf4e2ae0e",
                                        "glosses": [
                                            "D’une manière tacite, sans être formellement exprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df4603ed-41a2-47a7-a14e-5b3cf158f1ee",
                                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                                "text": "Les ennemis de Lamotte l’ont accusé d’avoir ambitionné la monarchie universelle en littérature ; peut-être aspirait-il tacitement à cette gloire, sans trop s'en douter,"
                                            },
                                            {
                                                "example_id": "76285917-36a1-4af3-8915-38efa8786de2",
                                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                                "text": "Cela n’est pas exprimé dans le traité, mais cela y est compris tacitement."
                                            },
                                            {
                                                "example_id": "5bada42d-4e7a-4297-9bc9-0a5a509f0c09",
                                                "sense_id": "03123fb5-993f-3bf0-8a68-d30148fa13d4",
                                                "text": "Ce contrat est tacitement reconductible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
