            {
                "entry_id": "e1f1b1a5-3db9-3c8e-962b-d8486eee6438",
                "word": "snift",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "06e5627b-23c9-4449-ae4a-bf8544c61fbb",
