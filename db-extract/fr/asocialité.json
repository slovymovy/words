                "translations": [
                    {
                        "translation_id": "534268a0-59bc-424a-9ef1-3bdf003eb104",
                        "source_entry_id": "e60cfa97-685e-3d66-afa4-e5de98f6d946",
                        "source_sense_id": "6c79aec3-92ea-35c1-ae77-9a872c9678c8",
                        "target_lang_word": "Asozialität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asozialität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f3e6208-04cd-349e-b432-ee3e27aada7b",
                                        "entry_id": "02a275b2-2286-3852-93d4-9b7beae9e72a",
                                        "glosses": [
                                            "Haltung/Handlungsweise, die in deutlichem Maße gemeinschaftsschädliches (asoziales), und/oder von den gestellten sozialen Erwartungen, der geltenden/herrschenden sozialen Norm abweichendes Verhalten zeigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5b24d8-d940-4008-a519-d864f63d94e8",
                                                "sense_id": "4f3e6208-04cd-349e-b432-ee3e27aada7b",
                                                "text": "„Die Ahornstraße wird insgesamt als spezifisches Milieu betrachtet, das gekennzeichnet sei von der Asozialität der Bewohner.“"
                                            },
                                            {
                                                "example_id": "27fb66f3-0666-4248-a014-83faabed6951",
                                                "sense_id": "4f3e6208-04cd-349e-b432-ee3e27aada7b",
                                                "text": "„Vor diesem Hintergrund wird insbesondere die intensivierte Verfolgung von ‚Asozialen‘ in der Ära Honecker erklärbar. Die Fälle der in § 249 StGB erfaßten sog. kriminellen Asozialität galten zum einen als ‚Spitze eines Eisberges‘ aller Arten von Disziplinverstößen, wie sie oben angesprochen wurden.“"
                                            },
                                            {
                                                "example_id": "de8e7977-8892-4f6e-b7c2-e752a0e2a2f1",
                                                "sense_id": "4f3e6208-04cd-349e-b432-ee3e27aada7b",
                                                "text": "„Die angeführten Beispiele sind mit Ausnahme des ‚asozialen Lebenswandels‘ der Erziehungsberechtigten hinreichend konkretisierbar. Daher ist der Begriff der ‚Asozialität‘ mit Substanz auszufüllen.“"
                                            },
                                            {
                                                "example_id": "ce76b18f-1b3a-4fa9-9fee-22cdaee94199",
                                                "sense_id": "4f3e6208-04cd-349e-b432-ee3e27aada7b",
                                                "text": "„«Asozialität», so hat vor allem Gisela Bock in ihren Untersuchungen über den Zusammenhang von «hygienischem» und «anthropologischem» Rassismus betont, war nun «zu einer zentralen Kategorie» geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
