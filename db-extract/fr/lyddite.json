                        "examples": [
                            {
                                "example_id": "3d6876ff-840b-4853-ad61-65e7b5affb9a",
                                "sense_id": "23c0f784-c587-37cc-a7a8-5d0318526052",
                                "text": "Les propriétés de l’acide picrique comme explosif furent découvertes par Eugène Turpin qui la commercialisa sous le nom de mélinite ou lyddite."
                            },
                            {
                                "example_id": "83b75f09-224e-4fd0-9640-296ab221b94a",
                                "sense_id": "23c0f784-c587-37cc-a7a8-5d0318526052",
                                "text": "Le camp ennemi fut bombardé et les obus à la lyddite tombèrent drus dans les retranchements."
                            }
                        ]
                    }
                ],
