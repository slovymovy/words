{
    "word_family": [
        "promotion",
        "promoter",
        "promotional",
        "promotive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3f0bc3cb-1d74-3c16-826e-7219d03daeca",
                    "sense_definition": "To raise someone to a more important, responsible, or higher-paying job or rank.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "career advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>promote</w> him to manager after his excellent performance this year.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>повысить</w> его до менеджера после его отличных результатов в этом году.",
                                "tr": "Şirket, bu yılki mükemmel performansının ardından onu müdürlüğe <w>terfi ettirmeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "She was <w>promoted</w> to senior partner because she consistently met all her sales targets.",
                            "target_lang_translations": {
                                "ru": "Её <w>повысили</w> до старшего партнера, так как она стабильно выполняла все планы по продажам.",
                                "tr": "Tüm satış hedeflerini istikrarlı bir şekilde tutturduğu için kıdemli ortaklığa <w>terfi ettirildi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "elevate",
                        "upgrade"
                    ],
                    "antonyms": [
                        "demote"
                    ],
                    "common_phrases": [
                        "promote to manager",
                        "get promoted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повысить кого-либо в должности или звании, предоставив более ответственную или высокооплачиваемую работу.",
                        "tr": "Birini daha önemli, sorumluluk gerektiren veya daha yüksek maaşlı bir işe ya da makama yükseltmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повысить",
                                "target_lang_sense_clarification": "в должности или звании"
                            },
                            {
                                "target_lang_word": "продвинуть",
                                "target_lang_sense_clarification": "по службе"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "terfi ettirmek",
                                "target_lang_sense_clarification": "işte veya makamda yükseltmek"
                            },
                            {
                                "target_lang_word": "terfi almak",
                                "target_lang_sense_clarification": "daha üst bir göreve gelmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8d9e426-e6f0-368a-b31f-2b6b5b2cce5c",
                    "sense_definition": "To advocate for something or to try to sell a product through advertising and publicity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "marketing and advocacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency will <w>promote</w> a product using social media influencers to reach a younger audience.",
                            "target_lang_translations": {
                                "ru": "Агентство будет <w>продвигать</w> продукт с помощью инфлюенсеров в социальных сетях, чтобы охватить более молодую аудиторию.",
                                "tr": "Ajans, daha genç bir kitleye ulaşmak için sosyal medya fenomenlerini kullanarak ürünün <w>tanıtımını yapacak</w>."
                            }
                        },
                        {
                            "text": "They <w>promoted</w> the new film with giant billboards all across the city center.",
                            "target_lang_translations": {
                                "ru": "Они <w>рекламировали</w> новый фильм с помощью гигантских билбордов по всему центру города.",
                                "tr": "Şehrin dört bir yanındaki dev bilboardlarla yeni filmin <w>reklamını yaptılar</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "advertise",
                        "publicize",
                        "push",
                        "market"
                    ],
                    "antonyms": [
                        "oppose"
                    ],
                    "common_phrases": [
                        "promote a product",
                        "promote a brand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рекламировать товар или услугу, либо активно выступать в поддержку какой-либо идеи.",
                        "tr": "Bir şeyi savunmak veya reklam ve tanıtım yoluyla bir ürünün satışını artırmaya çalışmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвигать",
                                "target_lang_sense_clarification": "товар, бренд или идею"
                            },
                            {
                                "target_lang_word": "рекламировать",
                                "target_lang_sense_clarification": "с целью продажи"
                            },
                            {
                                "target_lang_word": "пропагандировать",
                                "target_lang_sense_clarification": "идеи или ценности"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tanıtımını yapmak",
                                "target_lang_sense_clarification": "ürün veya markayı öne çıkarmak"
                            },
                            {
                                "target_lang_word": "reklamını yapmak",
                                "target_lang_sense_clarification": "pazarlamak"
                            },
                            {
                                "target_lang_word": "öne çıkarmak",
                                "target_lang_sense_clarification": "desteklemek veya vurgulamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa30072f-b70e-3af9-b20e-7fe136ab128a",
                    "sense_definition": "To encourage the growth, development, or occurrence of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "encouragement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise and a balanced diet help to <w>promote</w> good health and longevity.",
                            "target_lang_translations": {
                                "ru": "Регулярные физические упражнения и сбалансированное питание помогают <w>укрепить</w> здоровье и способствуют долголетию.",
                                "tr": "Düzenli egzersiz ve dengeli beslenme, sağlığı <w>desteklemeye</w> ve uzun ömürlü olmaya yardımcı olur."
                            }
                        },
                        {
                            "text": "The new government policy aims to <w>promote</w> economic growth in rural areas.",
                            "target_lang_translations": {
                                "ru": "Новая государственная политика направлена на то, чтобы <w>стимулировать</w> экономический рост в сельских районах.",
                                "tr": "Yeni hükümet politikası, kırsal bölgelerde ekonomik büyümeyi <w>teşvik etmeyi</w> amaçlıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "encourage",
                        "foster",
                        "stimulate",
                        "further"
                    ],
                    "antonyms": [
                        "oppose"
                    ],
                    "common_phrases": [
                        "promote good health",
                        "promote economic growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способствовать росту, развитию или возникновению чего-либо.",
                        "tr": "Bir şeyin büyümesini, gelişmesini veya gerçekleşmesini teşvik etmek, desteklemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способствовать",
                                "target_lang_sense_clarification": "развитию или росту"
                            },
                            {
                                "target_lang_word": "содействовать",
                                "target_lang_sense_clarification": "осуществлению чего-либо"
                            },
                            {
                                "target_lang_word": "стимулировать",
                                "target_lang_sense_clarification": "процесс или активность"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "teşvik etmek",
                                "target_lang_sense_clarification": "gelişimini veya artışını sağlamak"
                            },
                            {
                                "target_lang_word": "desteklemek",
                                "target_lang_sense_clarification": "katkıda bulunmak"
                            },
                            {
                                "target_lang_word": "artırmak",
                                "target_lang_sense_clarification": "olumlu yönde güçlendirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b0a3592-f1ab-3034-bd84-d7476143a37b",
                    "sense_definition": "To elevate a sports team to a higher league or division.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At the end of the season, three teams are <w>promoted</w> to the Premier League.",
                            "target_lang_translations": {
                                "ru": "В конце сезона три команды <w>выходят</w> в Премьер-лигу.",
                                "tr": "Sezon sonunda üç takım Premier Lig'e <w>yükselir</w>."
                            }
                        },
                        {
                            "text": "The club worked hard all year to be <w>promoted</w> to the top division.",
                            "target_lang_translations": {
                                "ru": "Клуб упорно трудился весь год, чтобы <w>подняться</w> в высший дивизион.",
                                "tr": "Kulüp, en üst lige <w>yükselmek</w> için bütün yıl çok çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "elevate"
                    ],
                    "antonyms": [
                        "relegate"
                    ],
                    "common_phrases": [
                        "promoted to the league"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевести спортивную команду в более высокую лигу или дивизион.",
                        "tr": "Bir spor takımını daha üst bir lige veya kümeye yükseltmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выходить",
                                "target_lang_sense_clarification": "в высшую лигу"
                            },
                            {
                                "target_lang_word": "повышаться в классе",
                                "target_lang_sense_clarification": "о спортивной команде"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "üst lige yükseltmek",
                                "target_lang_sense_clarification": "spor takımı hakkında"
                            },
                            {
                                "target_lang_word": "yükselmek",
                                "target_lang_sense_clarification": "bir üst kümeye geçmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a9c82f4-20c7-35c9-a1de-eec1d9ffb9fb",
                    "sense_definition": "To move a student on to a subsequent stage or grade of education.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students who pass the final exam will <w>promote</w> directly to the secondary section of the school.",
                            "target_lang_translations": {
                                "ru": "Ученики, сдавшие выпускной экзамен, <w>перейдут</w> сразу в среднюю школу.",
                                "tr": "Final sınavını geçen öğrenciler doğrudan okulun ortaokul kısmına <w>geçecekler</w>."
                            }
                        },
                        {
                            "text": "The teacher decided to <w>promote</w> the gifted student to the next grade early.",
                            "target_lang_translations": {
                                "ru": "Учитель решил досрочно <w>перевести</w> одаренного ученика в следующий класс.",
                                "tr": "Öğretmen, üstün zekalı öğrenciyi bir üst sınıfa erkenden <w>geçirmeye</w> karar verdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "advance",
                        "move up"
                    ],
                    "common_phrases": [
                        "promote to the next grade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевести учащегося на следующий этап обучения или в следующий класс.",
                        "tr": "Bir öğrenciyi eğitimde bir sonraki aşamaya veya sınıfa geçirmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переводить",
                                "target_lang_sense_clarification": "в следующий класс"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sınıf geçirmek",
                                "target_lang_sense_clarification": "bir üst sınıfa aktarmak"
                            },
                            {
                                "target_lang_word": "ilerletmek",
                                "target_lang_sense_clarification": "eğitim seviyesini yükseltmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70689111-9a72-3662-be57-16f8e20d56bc",
                    "sense_definition": "To exchange a pawn for a queen or another piece when it reaches the opponent's end of the board in chess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having crossed the chessboard, his pawn was <w>promoted</w> to a queen.",
                            "target_lang_translations": {
                                "ru": "Пройдя через всю шахматную доску, его пешка <w>превратилась</w> в ферзя.",
                                "tr": "Satranç tahtasını kateden piyonu vezire <w>dönüştü</w>."
                            }
                        },
                        {
                            "text": "He managed to <w>promote</w> his last pawn, turning the tide of the game.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>провести</w> свою последнюю пешку, что изменило ход игры.",
                                "tr": "Son piyonunu da <w>terfi ettirmeyi</w> başararak oyunun seyrini değiştirdi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "promote a pawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заменить пешку на ферзя или другую фигуру при достижении последней горизонтали в шахматах.",
                        "tr": "Satrançta bir piyonu tahtanın son karesine ulaştığında vezir veya başka bir taşa dönüştürmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превращать",
                                "target_lang_sense_clarification": "пешку в фигуру"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "пешку в ферзи"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "terfi ettirmek",
                                "target_lang_sense_clarification": "piyonu başka bir taşa dönüştürmek"
                            },
                            {
                                "target_lang_word": "terfi etmek",
                                "target_lang_sense_clarification": "piyonun seviye atlaması"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca37c846-6fdc-3bf6-97af-ce21e6088ca2",
                    "sense_definition": "To increase the activity of a catalyst by changing its surface structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding a small amount of alkali can <w>promote</w> the iron catalyst used in the reaction.",
                            "target_lang_translations": {
                                "ru": "Добавление небольшого количества щелочи может <w>активировать</w> железный катализатор, используемый в реакции.",
                                "tr": "Küçük bir miktar alkali eklemek, reaksiyonda kullanılan demir katalizörünü <w>aktifleştirebilir</w>."
                            }
                        },
                        {
                            "text": "The researcher studied how different additives <w>promote</w> the efficiency of the chemical process.",
                            "target_lang_translations": {
                                "ru": "Исследователь изучал, как различные добавки <w>повышают</w> эффективность химического процесса.",
                                "tr": "Araştırmacı, farklı katkı maddelerinin kimyasal sürecin verimliliğini nasıl <w>artırdığını</w> inceledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "activate",
                        "stimulate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышать активность катализатора путем изменения его структуры или добавления веществ.",
                        "tr": "Kimyada bir katalizörün yüzey yapısını değiştirerek veya madde ekleyerek aktivitesini artırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промотировать",
                                "target_lang_sense_clarification": "катализатор"
                            },
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "химический процесс"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aktifleştirmek",
                                "target_lang_sense_clarification": "katalizör etkinliğini artırmak"
                            },
                            {
                                "target_lang_word": "promotörlük yapmak",
                                "target_lang_sense_clarification": "tepkimede etkinliği yükseltmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}