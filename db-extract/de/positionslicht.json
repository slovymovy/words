                        "form": "das Positionslicht"
                    },
                    {
                        "form_id": "c9a6545c-92fb-41e7-aff1-d6ba56d6c27e",
                        "entry_id": "04c00c5d-f7c4-3861-b533-e4b3e6ed71f7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Positionslichter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                        "entry_id": "04c00c5d-f7c4-3861-b533-e4b3e6ed71f7",
                        "glosses": [
                            "(rote, grüne oder weiße) Leuchten an Schiffen, Flugzeugen, Raumschiffen, die (nachts oder bei Nebel) deren Position und Richtung, in die sie sich bewegen, anzeigen, um Kollisionen zu vermeiden"
                        ],
                        "tags": [
                            "Schifffahrt",
                            "Luftfahrt",
                            "Raumfahrt",
                            "oft im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e2f78267-6b96-43c6-904e-194565da5529",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Die Chancen, dass die relativ schwachen Positionslichter einer Yacht gesehen werden, sind sehr gering.“"
                            },
                            {
                                "example_id": "7d268504-c2c7-40da-b51b-72340499952a",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Die vorgeschriebenen Positionslichter sind bei jedem Wetter zwischen Sonnenuntergang und Sonnenaufgang zu führen.“"
                            },
                            {
                                "example_id": "e38bcb7c-0089-49d3-971b-365d27a8460a",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Sie sind nicht nur eindeutig gesetzlich vorgeschrieben, sondern dienen auch tatsächlich der Sicherheit; Positionslichter braucht jedes Boot.“"
                            },
                            {
                                "example_id": "c90f2617-6cb4-46f8-a1bb-bb984ae8480c",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Um die Fahrtrichtung anderer Schiffe auch nachts zu erkennen sind Schiffe mit Positionslichtern gekennzeichnet.“"
                            },
                            {
                                "example_id": "24ad1acc-04b3-43a2-a162-2979e02fc617",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Um eine Karambolage im Schneegestöber zu vermeiden, lässt der Kapitän Positionslichter setzen.“"
                            },
                            {
                                "example_id": "a9507b79-b222-4570-82b6-70c9bea24e8f",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Beide Schiffe hatten trotz dichten Nebels keine Positionslichter gesetzt.“"
                            },
                            {
                                "example_id": "050284a1-b3d5-4dfb-92f1-acf4a311aedb",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Die Positionslichter der Kriegsschiffe waren sicher ausgeschaltet.“"
                            },
                            {
                                "example_id": "7c3760f5-e269-401c-80cb-e5949e83f602",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Aus Furcht vor deutschen U-Boot-Angriffen fuhren die Schiffe verdunkelt mit abgeschwächten Positionslichtern und unter absoluter Funkstille.“"
                            },
                            {
                                "example_id": "aab77a78-b313-46a6-9cdf-afa59f0cc4e7",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Madho hatte das grüne und rote Positionslicht seines Boots und auch eine weiße Lampe eingeschaltet, als die »Carr« begann, auf das Fischerboot zu schießen.“"
                            },
                            {
                                "example_id": "f7a8e894-fa59-4d10-b68d-83749814106c",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Kurz vor dem Absturz teilte der Pilot dem Tower mit, er habe jetzt die Positionslichter eingeschaltet.“"
                            },
                            {
                                "example_id": "80344166-25a1-4017-a011-060b289bd05a",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Als wir den Landeanflug beginnen, wird deutlich, dass dies kein normaler Passagierflug ist. Am Flugzeug werden sämtliche Positionslichter ausgeschaltet.“"
                            },
                            {
                                "example_id": "93444fb8-fab1-47c5-89bb-22bc56939b31",
                                "sense_id": "2ffc8cd9-f850-3e4a-8b92-c29029180a42",
                                "text": "„Man kann im Raum bewegliche Lichtpunkte antreffen – die Positionslichter von Raketen. Normalerweise jedoch werden diese Lichter nicht eingeschaltet, es geschieht nur auf besondere Aufforderung über Funk, zum Zwecke der Identifizierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                        "entry_id": "04c00c5d-f7c4-3861-b533-e4b3e6ed71f7",
                        "glosses": [
                            "feststehendes Licht, das der Umgebung anzeigt, dass an dieser Stelle etwas markiert ist (beispielsweise eine Gefahrenstelle/eine Einfahrt mit einer Boje, eine Windkraftanlage)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe5b5d9-9db6-4aad-8bb4-573bc5021b28",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "[Windkrafträder:] „Parallel dazu wächst der Widerstand von Bürgerinitiativen. Sie beklagen die \"Verspargelung\" der Landschaft, Schattenwurf durch die Rotoren, nervende Geräusche und des Nachts blinkende Positionslichter.“"
                            },
                            {
                                "example_id": "e751ea7c-7b68-49a2-88e3-e03cb9959bd9",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "„Rote Positionslichter leuchten an Windrädern in einem Windenergiepark.“"
                            },
                            {
                                "example_id": "b3e705f3-a832-4c89-a1dc-621fa4f92b65",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "„»Eine Stunde später etwa waren dann die Lichter von Helgoland sehr schön zu sehen. Da lag Helgoland quasi wie so ein Lichtermeer auf dem Horizont. Oben halt der Leuchtturm und links daneben die Positionslichter des Fernsehturms.«“"
                            },
                            {
                                "example_id": "40e5c566-1bef-46ad-9214-6fb7e823b6d3",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "„Dort war in mehr als anderthalb Kilometern Entfernung ein knapp vierzig Meter hoher, schlanker Turm mit einem hellen, weißen Positionslicht auf dem Dach zu erkennen.“"
                            },
                            {
                                "example_id": "55677e1e-a1af-47e2-a144-883421dd8a20",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "„Er meinte, es sähe aus wie ein Positionslicht an einem hohen Turm, aber er konnte nicht sagen, wie weit es entfernt war.“"
                            },
                            {
                                "example_id": "df7ed045-2455-4681-a887-56417335ed46",
                                "sense_id": "53ff592c-3822-3568-8d0c-c370568f9428",
                                "text": "„Auf dem Bergkamm, links versetzt vom Hotel aus, mindestens fünfhundert Meter davon entfernt, kreiselten die drei Flügel des Windrads nunmehr wieder gemächlich,“ […] „Das Positionslicht trat hervor in der Dämmerung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5a3c521-f8f5-4dd6-ad57-8b3821b7e001",
