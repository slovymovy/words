                                        "sense_id": "21838bb0-59f7-3f1e-ab75-885bbfd74d84",
                                        "entry_id": "42422143-6b9c-3244-b691-125d36157a9e",
                                        "glosses": [
                                            "The trait of sincerity and focused purpose."
