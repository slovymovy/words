        "fr-extract.jsonl": [
            {
                "entry_id": "442a3415-bf28-3c1f-bc1b-460e85a12d83",
                "word": "papier-monnaie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                        "entry_id": "442a3415-bf28-3c1f-bc1b-460e85a12d83",
                        "glosses": [
                            "Monnaie créée par le gouvernement, et imprimée sur papier pour avoir valeur et cours d’argent monnayé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71aa9012-d2e4-4d05-b4cc-d34957332adb",
                                "sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                                "text": "A mesure qu’augmentait les émissions de papier-monnaie, s’accentuait la dépréciation du mark, et de plus en plus les particuliers s’efforçaient, quand ils recevaient de billets, de les échanger aussitôt contre des marchandises."
                            },
                            {
                                "example_id": "c6b8d725-4f9d-4d1c-b0e1-73b2e1093869",
                                "sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                                "text": "On se rappelait l’avoir vu, les poches alourdies d’or et doublées de billets chiffonnés, jetant l’un d’eux au garçon de place qui lui appelait une voiture, nullement par ostentation et à peine par générosité, mais parce qu’il préférait les louis à ces papiers-monnaie qui lui paraissaient toujours sales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11c13572-4ec0-4634-a0ac-a3e494fd4001",
                        "source_entry_id": "442a3415-bf28-3c1f-bc1b-460e85a12d83",
                        "source_sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                        "target_lang_word": "Banknote",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Banknote",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                        "entry_id": "ff8f5ad3-3c11-3404-82f8-34c011287aea",
                                        "glosses": [
                                            "Geldschein, der im alltäglichen Zahlungsverkehr genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9e6ec0-35f1-41dd-9b74-23cbc67f59a0",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "Wer Banknoten nachmacht oder fälscht, wird mit Gefängnis nicht unter zwei Jahren bestraft."
                                            },
                                            {
                                                "example_id": "a878388a-0706-43e7-a82f-1a031e13d5ad",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Sechzig Berliner Privatdruckereien sind mit dem Druck von Banknoten beschäftigt.“"
                                            },
                                            {
                                                "example_id": "62dcfe97-6a33-416e-ad66-79647509f1ac",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Die Schönheit der Banknoten machte ihn schwach, als er sie zählte.“"
                                            },
                                            {
                                                "example_id": "95e5cfc9-ad12-40b9-8a59-b8b07b5c0fc1",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„1661 war Schweden das erste Land Europas, das Banknoten druckte.“"
                                            },
                                            {
                                                "example_id": "7c0870f3-8df7-4665-8ad9-ac96a3f0566e",
                                                "sense_id": "98e29a8d-e10c-3ea3-9557-30d2874635be",
                                                "text": "„Ich ging in mein Zimmer; während der Graf bei seiner Frau war, steckte ich die fünfzehntausend Lire in Banknoten ein, die ich mir von Greppi geholt hatte, und legte das ganze Geld des Marchese Triulzi beiseite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34e029db-bdb5-4a04-a857-d0eca8065c5c",
                        "source_entry_id": "442a3415-bf28-3c1f-bc1b-460e85a12d83",
                        "source_sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                        "target_lang_word": "Papiergeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papiergeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                        "entry_id": "4e684b16-8e9a-389d-aa14-3d5909606107",
                                        "glosses": [
                                            "Teil einer Währung, der in Form von Geldscheinen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f588d9e2-1e16-4076-9b61-c25d975d819d",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "Ich nehme sicherheitshalber immer nur ein bisschen Papiergeld mit zum Einkaufen."
                                            },
                                            {
                                                "example_id": "18edff56-785c-4f58-a8f7-e9de16c3a7e4",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "„Ich vertrieb mir die Zeit, indem ich den Schreibtisch durchsuchte, allerdings nichts fand außer fünfzig Billionen altes Inflationsgeld, das unser Lieblingswärter sammelte wie jedes andere entwertete Papiergeld.“"
                                            },
                                            {
                                                "example_id": "21c8887c-bcab-44cb-9369-fb7a0fddc07e",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "„Als Kinder hatten wir nie Papiergeld in der Tasche, unser Alltag war ein Kopeken-Leben.“"
                                            },
                                            {
                                                "example_id": "1e9eddd7-2ec6-42c1-9184-d5e8b17e40ed",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "„Das war echtes Papiergeld, da gab es keinen Zweifel.“"
                                            },
                                            {
                                                "example_id": "a7c102f8-bb16-4e77-b345-123719ba692e",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "„Schließlich erfasste das grassierende Misstrauen auch das Papiergeld.“"
                                            },
                                            {
                                                "example_id": "fe5165c3-5fa1-4942-b32c-5ad23476fff2",
                                                "sense_id": "e67f062c-c4b6-397c-9466-25fea741ac2f",
                                                "text": "„Das Papiergeld, das die Nordamerikaner ausgaben, verlor mit jeder Schlacht an Wert – selbst wenn diese siegreich endete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f19a9b6a-b4e8-4f2f-b3c2-9861b6543b1b",
                        "source_entry_id": "442a3415-bf28-3c1f-bc1b-460e85a12d83",
                        "source_sense_id": "8c8248c6-5641-3331-b861-9ae7bdc14b74",
                        "target_lang_word": "paper money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paper money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f7c24c6-1d8e-32e6-8fd5-52d852aa3456",
                                        "entry_id": "8c8b3845-ae5f-317f-8a69-70aefcdca97c",
                                        "glosses": [
                                            "Cash in the form of banknotes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paper money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                        "entry_id": "c482e4d5-7a3a-37cc-a780-b750c6916422",
                                        "glosses": [
                                            "A type of joss paper resembling banknotes burnt to venerate the deceased, ancestor spirits, deities, etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaba2ac9-1954-459b-abcb-5b7843dd5970",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Moreover, you say that serving Fuh is a profitable service; that if you burn paper money, present offerings, and keep fasts before the face of your god Fuh, he will dissipate calamities, blot out your sins, increase your happiness, and prolong your age!"
                                            },
                                            {
                                                "example_id": "49af5ed2-ad59-4eb2-a86c-34d37881ae56",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Tablets in honour of the dead are set up in every house over a sort of family altar; and at certain times flowers are offered and paper-money is burned at these shrines."
                                            },
                                            {
                                                "example_id": "773cc52c-ce10-4e6f-8daf-75e8546de2c1",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Tsze Chien means “paper money” – not the real bank notes which are so extensively used in China as money but the make-believe tinsel money which the Chinese burn as part of their religious worship."
                                            },
                                            {
                                                "example_id": "700149b8-531a-410e-be58-a66a13678e05",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "People had also begun to burn paper money (it was believed that burning transformed it into real money that could be used by the departed souls in hades) instead of placing actual coins in the tombs."
                                            },
                                            {
                                                "example_id": "1d67b42b-3785-492d-ac99-ffee26c3e7f4",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "“Let’s burn the paper money,” Mai Mai said. She brought out a stack of yellow paper from her pocket – coarse paper with small circles cut in it to represent coins. Longevity lighted the paper money and kowtowed another time."
                                            },
                                            {
                                                "example_id": "1af3a52c-82c6-491b-9917-2028c15912f4",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "The paper money for the spirits consisted of imitations either of metal coins or of real money, but the latter had different sets of inscriptions and patterns to distinguish it from counterfeit money."
                                            },
                                            {
                                                "example_id": "5c2aad8e-e625-4e8a-9169-a978e9c9fed0",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "After paying homage to the departed, the ritual is concluded by a libation of rice wine poured on to an additional stack of burning paper money."
                                            },
                                            {
                                                "example_id": "e77197e4-a3e4-49f7-814b-10c9957c5c54",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Supplicants burn paper money and joss sticks, and pray for good fortune to the temple deity, Tua Pek Kong."
                                            },
                                            {
                                                "example_id": "cc12cd94-bc6a-4cad-b44a-7cc759329637",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Many societies follow traditional funeral rites and practices. In China, this may involve burning paper money or possessions for the deceased to use in the afterlife."
                                            },
                                            {
                                                "example_id": "1f15cb6a-b0fd-409e-83a1-41d41a1db894",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "If a mourner is either Taoist or Buddhist they may hold a burning joss stick while bowing. A family member will usually be kneeling nearby to burn joss sticks and paper money."
                                            },
                                            {
                                                "example_id": "b05ef2a2-8e97-4491-a7e6-7094208c4e6d",
                                                "sense_id": "9fea21a6-90ff-3aa5-8077-bc25efd825d2",
                                                "text": "Built in the early 19th century by the first Hokkien and Cantonese settlers in Penang, the temple isn’t so impressive architecturally, but it’s very central and popular with the Chinese community, and seems to be forever swathed in smoke from the outside furnaces where whorshippers burn paper money, and from the incense sticks waved around inside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
