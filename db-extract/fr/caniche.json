                        "sense_id": "affa4280-eda6-3d5d-99c4-d7e462b2607c",
                        "entry_id": "78fc1098-5da4-3547-8dab-6bf0d3dd6335",
                        "glosses": [
                            "Qualifie un chien de cette race."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d1bb04d5-b2e6-4fad-9062-8e0b8e01a8a6",
                                "sense_id": "affa4280-eda6-3d5d-99c4-d7e462b2607c",
                                "text": "Un chien, une chienne caniche, des chiens caniches."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9c683bf5-4837-37a0-9c02-a2a697f128a4",
                "word": "caniche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a16a5dba-bce9-4e1b-8b61-e2d5bf4e1eaf",
                        "entry_id": "9c683bf5-4837-37a0-9c02-a2a697f128a4",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "caniches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1b6f9f4-1d41-354d-9108-541309bb8aa7",
                        "entry_id": "9c683bf5-4837-37a0-9c02-a2a697f128a4",
                        "glosses": [
                            "Race de chien de compagnie, originaire d’Allemagne et de France, probablement dérivé du barbet, grand, moyen ou nain, à poil bouclé ou cordé."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1081f4fc-1345-40be-8b0b-b12be8109f1d",
                                "sense_id": "d1b6f9f4-1d41-354d-9108-541309bb8aa7",
                                "text": "Les caniches arrivaient pendant que mon clown racontait ses histoires, ils le faisaient tourner en bourrique et lui apprenaient, à lui, à sauter pour attraper un os au bout d’un bâton."
                            },
                            {
                                "example_id": "cd23d416-6214-462f-9c43-70209afdb542",
                                "sense_id": "d1b6f9f4-1d41-354d-9108-541309bb8aa7",
                                "text": "Il n’est pas très-bien coiffé, reprit-il en regardant la chevelure ébouriffée et luxuriante du provincial, mais je vais le mener chez Marius qui va lui ôter cette apparence de caniche si nuisible à sa considération et à la nôtre."
                            },
                            {
                                "example_id": "a2f40c44-ad0a-49bd-873b-805869485401",
                                "sense_id": "d1b6f9f4-1d41-354d-9108-541309bb8aa7",
                                "text": "Et toute sa tête, qu’on ne songeait pas à rattacher à son corps, était comme un caniche qui aboie perché sur un meuble."
                            },
                            {
                                "example_id": "fb1007f1-655d-4d0d-91f3-ccaf1079f40d",
                                "sense_id": "d1b6f9f4-1d41-354d-9108-541309bb8aa7",
                                "text": "Quelle ne fut pas la surprise du maître en ouvrant la lourde porte, de se retrouver face au bon vieux caniche Bouboule, le poil hérissé et le regard désespéré."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fdcff77-96a0-3dd8-b528-b1b827cb9c79",
                        "entry_id": "9c683bf5-4837-37a0-9c02-a2a697f128a4",
                        "glosses": [
                            "Personne particulièrement servile."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c4b32ce6-7ceb-427c-b678-29d6f6bd729d",
                                "sense_id": "4fdcff77-96a0-3dd8-b528-b1b827cb9c79",
                                "text": "Et à force de t’casser les couilles avec ses bisous, ses câlins tout ça, elle te transforme : t’étais le dernier des thugs, tu deviens le premier des caniches, laisse tomber ! C’est un truc de ouf."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c5e9078-c531-4fa3-a014-6e6e972edf83",
                        "source_entry_id": "9c683bf5-4837-37a0-9c02-a2a697f128a4",
                        "source_sense_description": "Chien",
                        "target_lang_word": "Pudel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "eine mittelgroße Hunderasse mit häufig lockigem Fell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ea2905-1927-459d-8971-9eb16fcf7cff",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Die Jacob Sisters haben immer ihre weißen Pudel bei sich, die zu ihrem Markenzeichen geworden sind."
                                            },
                                            {
                                                "example_id": "4e128a7d-1808-4a69-b224-58176c1ada8b",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "Er sah aus wie ein begossener Pudel."
                                            },
                                            {
                                                "example_id": "c4281a62-a878-49ec-b33a-e551e10aa5d8",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Sie kommt immer mit ihrem Pudel und bindet ihn an einen Fuß ihrer Staffelei.“"
                                            },
                                            {
                                                "example_id": "c6f5aad7-accf-4fdc-9c5a-a5cedcc0e1d9",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Es kam ihm vor, als reisten in der U-Bahn genauso viele Menschen wie Pudel.“"
                                            },
                                            {
                                                "example_id": "b7b8a6dd-3b4c-40ee-888c-bf0c5cf24fa1",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Weiter konnten wir uns nicht bekannt machen, denn sie hatte zwei Hunde dabei, einen braunen und einen schwarzen Pudel, die um uns herumtollten und vor Freude über die Rückkehr meines Vaters fast den Leiterwagen umrissen.“"
                                            },
                                            {
                                                "example_id": "6b859e18-0d67-468d-b1b1-9c51309629b2",
                                                "sense_id": "37948748-4acf-36f8-8347-84f93a46b60d",
                                                "text": "„Bundschuhs Pudel war sehr kräftig und auf einem Auge blind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "ein Fehlwurf beim Kegeln, der gar keinen Kegel umwirft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5d286bd-2e3a-4f16-98e5-a79aa633cb71",
                                                "sense_id": "51eac3c1-9f11-3823-925c-3f1821cf7ff2",
                                                "text": "Verlässt die Kugel die Bahn beim Kegeln und fällt in die Rinne, dann nennt man das einen Pudel, Pumpe, Gosse oder anders."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "der Woll-Rindeneule, einem Nachtfalter aus der Familie der Eulenfalter"
                                        ],
                                        "tags": [
                                            "Trivialname"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0a386b-ec92-4b79-85ea-426215904dc5",
                                                "sense_id": "e3c1ec17-518a-352c-bb6a-31b33352801c",
                                                "text": "Die Raupen des Pudels haben lange weiße bis gelbe Haare."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                        "entry_id": "6c22c764-c8fb-3e89-8830-b8bcfb36978e",
                                        "glosses": [
                                            "Kurzform für Pudelmütze: eine gestrickte Kopfbedeckung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "410a6b56-a4ed-460f-b7f4-92bb2050bbeb",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Du setzt Deinen Pudel auf, heute morgen ist es saukalt!"
                                            },
                                            {
                                                "example_id": "47c05193-ebf6-4d6b-ba76-4406d3b12077",
                                                "sense_id": "a6d0345e-bf2c-39f2-97f8-63ecacb545fc",
                                                "text": "Weißt Du, wo mein roter Pudel geblieben ist?."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pudel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54d91560-3070-3838-93ad-11369f8ccffc",
                                        "entry_id": "2eb23533-0ddb-3916-a751-e8b44a93e80b",
                                        "glosses": [
                                            "Laden- oder Wirtshaustheke"
                                        ],
                                        "tags": [
                                            "Bavarian"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8859bc13-513b-4adb-a0f1-3294b9cb4505",
                                                "sense_id": "54d91560-3070-3838-93ad-11369f8ccffc",
                                                "text": "„Nun war ein Außenseiter der Herr über die Pudel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
