                                        "entry_id": "f1d7e7f5-d3e7-3956-806a-942c1a9e5e2b",
                                        "glosses": [
                                            "Haushaltsfolie aus Aluminium zum Verpacken von Lebensmitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11d1328-8c1a-4787-af3b-095d748ebc4a",
                                                "sense_id": "263bb5c6-ee79-30eb-b0e3-5365baeb0e27",
                                                "text": "In Alufolie gewickelt halten Lebensmittel länger."
                                            },
                                            {
                                                "example_id": "4a16dc7b-4f55-498f-8f20-f59a5c45780c",
                                                "sense_id": "263bb5c6-ee79-30eb-b0e3-5365baeb0e27",
                                                "text": "„55 Jahre ist es her, dass Familie Hayer unter der Marke Alufix mit dem Handel von Alufolien, Müllsäcken und Plastikfolien startete.“"
                                            },
                                            {
                                                "example_id": "329dc17c-32c1-443d-84aa-af5511a7ac69",
                                                "sense_id": "263bb5c6-ee79-30eb-b0e3-5365baeb0e27",
                                                "text": "„Auf der Treppe stand eine Ofenform, die mit Alufolie bedeckt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
