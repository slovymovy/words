                        "sense_id": "162e0ad0-8df5-3aef-85ee-b6a2e2bb6689",
                        "entry_id": "36b205d8-e24a-31fe-ad3d-77c25db6212a",
                        "glosses": [
                            "meist intensives Training, das die körperliche Leistungsfähigkeit verbessern soll"
                        ],
