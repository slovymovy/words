                                        "sense_id": "1baf02d3-6708-3911-9788-ccf3ea361070",
                                        "entry_id": "334dc655-1b52-34a8-bfc2-5f5f23cee19d",
                                        "glosses": [
                                            "politische Bewegung und Einstellung zur Vereinigung aller Völker islamischen Glaubens"
                                        ],
                                        "tags": [],
