                "senses": [
                    {
                        "sense_id": "a5996fbf-cf2c-3bd4-8d35-4112602dea07",
                        "entry_id": "93b6b497-3523-381c-915e-b733b8561c9e",
                        "glosses": [
                            "het best mogelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f1990e0-e412-42e6-8e42-de5b800fe3fc",
                                "sense_id": "a5996fbf-cf2c-3bd4-8d35-4112602dea07",
                                "text": "Daarnaast, papier kan zeven keer hergebruikt worden. Toiletpapier zit helemaal onderaan de papierketen; als het eenmaal in de toiletpot valt, is het niet meer te recyclen. „Het is dus optimaal gebruik van papiervezels als ze die zevende keer in toiletpapier belanden”, zegt Milieu Centraal."
                            },
                            {
                                "example_id": "1d4eb872-202c-45ac-9081-9280505ad4cd",
                                "sense_id": "a5996fbf-cf2c-3bd4-8d35-4112602dea07",
                                "text": "Rond elf uur hield ik het niet meer en nam één hap van mijn Snicker. Ik kauwde zorgvuldig om optimaal te genieten van de nougat, pinda’s, karamel en melkchocolade."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ef9c21e-14d3-3092-820e-abd7bdc32be3",
                        "entry_id": "93b6b497-3523-381c-915e-b733b8561c9e",
                        "glosses": [
                            "goed"
                        ],
                        "tags": [
                            "heel"
                        ],
                        "examples": [
                            {
                                "example_id": "62fa5d70-c0bc-4025-a40e-b4c9adf8f9b2",
                                "sense_id": "3ef9c21e-14d3-3092-820e-abd7bdc32be3",
                                "text": "Hoe hoger het gemiddeld opleidingsniveau op de afdeling, des te minder tevreden zijn de managers in hun functie en des te minder optimaal ze ook volgens henzelf functioneren."
                            }
                        ]
                    }
