{
    "word_family": [
        "wenken",
        "wenkbrauw"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66751525-79f0-3795-bf8c-a404c404e064",
                    "sense_definition": "een kort gebaar of teken met het hoofd, de ogen of de hand om iets duidelijk te maken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebaar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een kleine <w>wenk</w> liet de ober weten dat onze tafel klaar was.",
                            "target_lang_translations": {
                                "fr": "D'un petit <w>signe</w>, le serveur nous a fait savoir que notre table était prête."
                            }
                        },
                        {
                            "text": "Hij gaf haar een <w>wenk</w> met zijn ogen om stilletjes de kamer te verlaten.",
                            "target_lang_translations": {
                                "fr": "Il lui a fait un <w>signe</w> des yeux pour qu'elle quitte discrètement la pièce."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebaar",
                        "teken",
                        "knik"
                    ],
                    "common_phrases": [
                        "een wenk geven"
                    ],
                    "target_lang_definitions": {
                        "fr": "un geste bref ou un signe de la tête, des yeux ou de la main pour faire comprendre quelque chose"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "signe",
                                "target_lang_sense_clarification": "signe discret de la tête, de la main ou des yeux"
                            },
                            {
                                "target_lang_word": "clin d'œil",
                                "target_lang_sense_clarification": "mouvement discret des yeux ou de la tête"
                            },
                            {
                                "target_lang_word": "geste",
                                "target_lang_sense_clarification": "mouvement pour communiquer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "163f97fc-c9df-3b09-b59f-ec43ffcec219",
                    "sense_definition": "een bruikbare aanwijzing, raadgeving of tip om iemand te helpen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "advies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dankzij een handige <w>wenk</w> van de docent vonden we snel het juiste antwoord.",
                            "target_lang_translations": {
                                "fr": "Grâce à un <w>conseil</w> judicieux de l'enseignant, nous avons vite trouvé la bonne réponse."
                            }
                        },
                        {
                            "text": "In het tijdschrift vind je praktische <w>wenken</w> voor het onderhouden van de tuin.",
                            "target_lang_translations": {
                                "fr": "Dans le magazine, vous trouverez des <w>conseils</w> pratiques pour entretenir le jardin."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanwijzing",
                        "hint",
                        "raadgeving",
                        "tip"
                    ],
                    "common_phrases": [
                        "praktische wenken"
                    ],
                    "target_lang_definitions": {
                        "fr": "une indication utile, un conseil ou une astuce pour aider quelqu'un"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "conseil",
                                "target_lang_sense_clarification": "recommandation pratique"
                            },
                            {
                                "target_lang_word": "tuyau",
                                "target_lang_sense_clarification": "astuce ou renseignement utile"
                            },
                            {
                                "target_lang_word": "indication",
                                "target_lang_sense_clarification": "directive ou indice"
                            },
                            {
                                "target_lang_word": "astuce",
                                "target_lang_sense_clarification": "conseil ingénieux"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6927e945-95b2-3377-b679-26594995ccd6",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>wenken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>wenk</w> naar mijn vriend aan de overkant van de straat.",
                            "target_lang_translations": {
                                "fr": "Je <w>fais signe</w> à mon ami de l'autre côté de la rue."
                            }
                        },
                        {
                            "text": "Als ik de ober zie lopen, <w>wenk</w> ik even naar hem.",
                            "target_lang_translations": {
                                "fr": "Quand je vois passer le serveur, je lui <w>fais un signe</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "première personne du singulier au présent de l'indicatif de faire signe"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fais signe",
                                "target_lang_sense_clarification": "forme conjuguée de faire signe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fb60e96-22e8-38a1-b027-34e16055eaf1",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>wenken</w> bij inversie",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wenk</w> je even naar de ober zodat we kunnen betalen?",
                            "target_lang_translations": {
                                "fr": "Tu <w>fais signe</w> au serveur pour qu'on puisse payer ?"
                            }
                        },
                        {
                            "text": "Waarom <w>wenk</w> je zo geheimzinnig naar die man aan de bar?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>fais-tu signe</w> de façon si mystérieuse à cet homme au bar ?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "deuxième personne du singulier au présent de l'indicatif de faire signe (en inversion)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fais signe",
                                "target_lang_sense_clarification": "forme conjuguée de faire signe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a25394a1-ee55-3901-be51-8766569b363d",
                    "sense_definition": "gebiedende wijs van <w>wenken</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wenk</w> hem maar even hierheen, dan kunnen we overleggen.",
                            "target_lang_translations": {
                                "fr": "<w>Fais-lui signe</w> de venir ici, pour qu'on puisse discuter."
                            }
                        },
                        {
                            "text": "<w>Wenk</w> niet zo opvallend naar die mensen aan de overkant!",
                            "target_lang_translations": {
                                "fr": "Ne <w>fais</w> pas <w>signe</w> de manière si voyante à ces gens d'en face !"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "impératif de faire signe"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fais signe",
                                "target_lang_sense_clarification": "impératif singulier de faire signe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}