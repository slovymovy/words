                "senses": [
                    {
                        "sense_id": "30d24647-781d-3781-b78b-9a3f2c642602",
                        "entry_id": "7418ffb7-3a8c-328c-aa9a-b78b1dede183",
                        "glosses": [
                            "szereg dyscyplin naukowych zajmujących się badaniem Biblii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8adb28b5-211e-4eef-9458-a5610780406d",
                                "sense_id": "30d24647-781d-3781-b78b-9a3f2c642602",
                                "text": "Wykłady z biblistyki odbywają się w sąsiednim budynku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e5ec5a3-c8e5-462f-996b-1ac0fe0d9c89",
                        "source_entry_id": "7418ffb7-3a8c-328c-aa9a-b78b1dede183",
                        "source_sense_id": "30d24647-781d-3781-b78b-9a3f2c642602",
                        "target_lang_word": "biblical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biblical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbd5abe7-e653-306a-9650-5872e609c89d",
                                        "entry_id": "46cb4faa-f045-38c5-b66b-c5745074238f",
                                        "glosses": [
                                            "Of or relating to the Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee5cca1-4b0e-4590-9863-4a345aeaed4c",
                                                "sense_id": "fbd5abe7-e653-306a-9650-5872e609c89d",
                                                "text": "Tithing is both a quranic and biblical virtue."
                                            },
                                            {
                                                "example_id": "b42ee451-ac66-4523-ac58-1b855026aa30",
                                                "sense_id": "fbd5abe7-e653-306a-9650-5872e609c89d",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            },
                                            {
                                                "example_id": "97e9f8c5-c9b7-4c46-ad6f-abe541a466e6",
                                                "sense_id": "fbd5abe7-e653-306a-9650-5872e609c89d",
                                                "text": "She claws it away with her fingers. Falls heavily on her shoulders. Accepts the congratulations of her teammates, who look like they have just seen a biblical miracle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baf8767f-b4d5-3f1a-b19e-b4661bc01d92",
                                        "entry_id": "46cb4faa-f045-38c5-b66b-c5745074238f",
                                        "glosses": [
                                            "In accordance with the teachings of the Bible (according to some interpretation of it)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba06059-8be8-46df-8799-f9dd625f864f",
                                                "sense_id": "baf8767f-b4d5-3f1a-b19e-b4661bc01d92",
                                                "text": "biblical morality"
                                            },
                                            {
                                                "example_id": "603b4d23-33ed-45d6-b280-5b87c31a5781",
                                                "sense_id": "baf8767f-b4d5-3f1a-b19e-b4661bc01d92",
                                                "text": "The biblical teaching is that…"
                                            },
                                            {
                                                "example_id": "5d28317c-2c53-44c4-ac62-17099377ccfa",
                                                "sense_id": "baf8767f-b4d5-3f1a-b19e-b4661bc01d92",
                                                "text": "Mike Pompeo, the former US secretary of state, has defended Israel’s decades-long control of the Palestinian territories by claiming that the Jewish state has a biblical claim to the land and is therefore not occupying it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                        "entry_id": "46cb4faa-f045-38c5-b66b-c5745074238f",
                                        "glosses": [
                                            "Very great; especially, exceeding previous records in scale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29892362-4a7b-4388-a71d-87be7c9e6690",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "of biblical proportions"
                                            },
                                            {
                                                "example_id": "7ca8908d-f375-4063-8cfc-5aed4a097f88",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "with biblical fury"
                                            },
                                            {
                                                "example_id": "dba8a982-d88a-4044-97c4-96b7bbece9cd",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "To have striven so hard, to have molded a public personality out of so amorphous an identity, to have sustained that superhuman effort only to end with every weakness disclosed and every error compounding the downfall—that was a fate of biblical proportions."
                                            },
                                            {
                                                "example_id": "6720bfd8-a5c0-4242-b3c1-6b786bd153c1",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "Dr. Peter Venkman: This city is headed for a disaster of biblical proportions.\nMayor: What do you mean, \"biblical\"?\nDr. Raymond Stantz: What he means is Old Testament, Mr. Mayor, real wrath-of-God type stuff."
                                            },
                                            {
                                                "example_id": "e3fc71de-98d7-4824-828a-bb68f7a93d80",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "We gather tonight at a dramatic and deeply promising time in our history, and in the history of man on earth. For in the past 12 months, the world has known changes of almost biblical proportions. And even now, months after the failed coup that doomed a failed system, I am not sure we have absorbed the full impact, the full import of what happened."
                                            },
                                            {
                                                "example_id": "304cbef9-0cbd-4ddc-9628-e123a0ccc57b",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "Russell Banks's “Cloudsplitter,” a novel of near-biblical proportions about the abolitionist freedom fighter John Brown, is shaped like an explosive with an exceedingly long and winding fuse."
                                            },
                                            {
                                                "example_id": "e6f699a6-170e-4450-b5cd-4cf634d19a8f",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "During a thundershower of biblical proportions, hundreds of people dash from a train station in the Tokyo suburb of Kawaguchi, across a bricked plaza and into a modern civic center."
                                            },
                                            {
                                                "example_id": "fdf6d531-0b7a-4d68-adfd-c0d24db6843e",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "The Da Vinci Code resurrects a debate of biblical proportions."
                                            },
                                            {
                                                "example_id": "d3b7acb1-b026-42ca-8c38-7535689ca234",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "He also drilled into us that all the secrets of the structure of matter were implicit in Charlotte Moore's tables, which assumed an authority and role of biblical proportions."
                                            },
                                            {
                                                "example_id": "fbb968da-7022-4437-bc2c-3caf8b4bc3c1",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "In the midst of a national disaster of biblical proportions, it is difficult for the American people to participate fully in the selection of the next chief justice."
                                            },
                                            {
                                                "example_id": "90331e34-46ca-41d7-9c70-b94ac75d6627",
                                                "sense_id": "e920cfdd-0463-3b47-8511-b7e9e212a5d6",
                                                "text": "An increase in the pace at which sea levels are rising threatens “a mass exodus of entire populations on a biblical scale”, the UN secretary general has warned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
