                ],
                "senses": [
                    {
                        "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                        "entry_id": "48791f87-4362-3f5f-b9b4-538a61531ebd",
                        "glosses": [
                            "Ergebnis eines Wettspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405efeae-b98c-4876-b94e-f32e0628fb36",
                                "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                                "text": "„Die Ungewissheit des Spielausgangs schafft eine Atmosphäre und Gefühlslage gespannter Erwartung.“"
                            },
                            {
                                "example_id": "e624439f-845e-4e3a-8e23-23591567333a",
                                "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                                "text": "„Wir wählen als eine unserer Tippreihen 0000. Sollte der tatsächliche Spielausgang auch 0000 sein, so haben wir einen 1. Rang.“"
                            },
                            {
                                "example_id": "ca5028f0-c6c5-4057-a785-c82c4ad6ced2",
                                "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                                "text": "„Der Spielausgang wird im Einzelspiel insgesamt nur durch den Zufall beeinflusst, wenn der Spieler an der Kandidatenauswahl scheitert. In diesem Fall ist sein potentielles Wissen in keiner Weise kausal für den Spielausgang.“"
                            },
                            {
                                "example_id": "37025893-ced4-4c93-899d-1534831d9b1f",
                                "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                                "text": "„Illegale Wetten und die Manipulation von Spielausgängen bilden nach Ansicht von Platini eine größere Gefahr für den Fußball als Rassismus oder gewaltsame Fan-Ausschreitungen.“"
                            },
                            {
                                "example_id": "a8ee3e2a-7264-4211-a8b4-d2d913441193",
                                "sense_id": "5fae7680-9b58-358e-9a52-2c687d67ae3c",
                                "text": "„Dem BVB und Dortmund genügen unentschiedene Spielausgänge, Mainz und die Hertha müssen gewinnen, um die Bayern hinter sich zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
