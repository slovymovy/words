    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "00be5818-fd2c-39cd-ac43-b2dfb673dea6",
                    "sense_definition": "The ordinal form of the number five; coming after the fourth.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ordinal_number",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is my <w>fifth</w> time visiting this beautiful city.",
                            "target_lang_translations": {
                                "ru": "Это мой <w>пятый</w> раз в этом прекрасном городе.",
                                "zh": "这是我第<w>五</w>次访问这座美丽的城市。"
                            }
                        },
                        {
                            "text": "She lives on the <w>fifth</w> floor of the apartment building.",
                            "target_lang_translations": {
                                "ru": "Она живёт на <w>пятом</w> этаже многоквартирного дома.",
                                "zh": "她住在公寓楼的第<w>五</w>层。"
                            }
                        }
                    ],
                    "synonyms": [
                        "5th"
                    ],
                    "common_phrases": [
                        "fifth floor",
                        "fifth grade",
                        "fifth century",
                        "fifth wheel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Порядковая форма числа пять; следующий за четвёртым.",
                        "zh": "数字五的序数形式；排在第四之后。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятый",
                                "target_lang_sense_clarification": "порядковое числительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "第五",
                                "target_lang_sense_clarification": "序数词"
                            }
                        ]
                    }
                }
            ]
        },
        {
