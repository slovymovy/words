                        "examples": [
                            {
                                "example_id": "a319de34-c1fb-4ef4-9496-1f47080603b8",
                                "sense_id": "bdb98fda-37ab-3aa6-8455-710ad69442f0",
                                "text": "De chauffeurs die voor Uber werken, hebben contact via een app. Volgens het bedrijf zijn het zelfstandigen, maar volgens FNV is er sprake van een schijnconstructie. Dit omdat via de app wordt bepaald welke opdrachten een chauffeur krijgt tegen welke prijs. In 2017 bepaalde het Europees Hof van Justitie dat Uber een transportbedrijf is en geen bemiddelingsdienst."
                            },
                            {
                                "example_id": "59118b74-1b5f-4d47-b944-cdad0f2062fd",
                                "sense_id": "bdb98fda-37ab-3aa6-8455-710ad69442f0",
                                "text": "Het kan Tesco per winkelmedewerker zo'n 22.500 euro kosten voor achterstallig loon over de laatste zes jaar. De eerste claims zijn ingediend bij een bemiddelingsdienst. Dat is de eerste stap tot een rechtszaak bij het zogenoemde werktribunaal van het Verenigd Koninkrijk. Een openbaar orgaan bij conflicten tussen werknemers en werkgevers."
                            }
                        ]
