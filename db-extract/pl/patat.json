                                    {
                                        "sense_id": "6d8e672c-26af-3976-83ec-86c1e06f212f",
                                        "entry_id": "755a0d67-34db-3d6f-b5e0-3c9638d6e4fe",
                                        "glosses": [
                                            "Nutzpflanze, deren Knolle ein süßliches Aroma hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b79415d-4519-45cf-9bff-527664ecc81a",
                                                "sense_id": "6d8e672c-26af-3976-83ec-86c1e06f212f",
                                                "text": "„Keine Knolle liegt derzeit so im Trend wie die Süßkartoffel.“"
                                            },
                                            {
                                                "example_id": "343d6f85-ab7d-4484-bb7c-b348cbfa4e19",
                                                "sense_id": "6d8e672c-26af-3976-83ec-86c1e06f212f",
                                                "text": "„Auf Terrassenfeldern wachsen Zuckerrohr, Süßkartoffeln, Kampferbäume und Tabak, dazwischen Maulbeerbäume, die Nahrungsgrundlage für Seidenraupen.“"
                                            },
                                            {
                                                "example_id": "46aeb594-d31e-486c-a853-2828f3bad30b",
                                                "sense_id": "6d8e672c-26af-3976-83ec-86c1e06f212f",
                                                "text": "„Sie war zu einer enthusiastischen Teilnehmerin geworden und steuerte ihre eigene, definitiv französisch gefärbte Version von Süßkartoffeln bei, die sie mit Butter und dunklem Zucker fast zu einer Mousse aufschlug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
