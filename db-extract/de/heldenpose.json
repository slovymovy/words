                "senses": [
                    {
                        "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                        "entry_id": "9ee0ff13-2c02-3ed8-98ad-1cc39ceb74cf",
                        "glosses": [
                            "affektierte Art einer überheblichen Selbstinszenierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "104534e3-5fcd-4676-b23d-9206a9d085f6",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Ob sie von der Schlacht bei Leuthen redet oder von der Schlacht bei Langemark – in Heldenpose stürmen Jugendliche singend ins vom Feind gelegte Feuer, sacken mit erhobenen Armen, wiederum in Heldenpose, auf die Knie, Blut rinnt seitlich an der Stirn herunter, und in Heldenpose hauchen sie ihr Leben aus.“"
                            },
                            {
                                "example_id": "887a4782-5971-4658-a74a-7a715602956f",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Viele Gipfelsammler empfinden sich als Bezwinger der Bergriesen, die sie bestiegen haben. In Heldenpose stellen sie ihren Fuß auf den Gipfelpunkt wie der Großwildjäger auf das Haupt des erlegten Löwen.“"
                            },
                            {
                                "example_id": "be81b025-d4ba-48bb-8f1d-d7f429d6e22f",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Dabei hängen Fotos, auf denen Leni Ottos griechischen Schwiegervater in Heldenpose porträtiert hat, durchaus an Gästen zugänglichen Stellen.“"
                            },
                            {
                                "example_id": "f870bfad-1489-46ef-9eed-67e0d14f9a62",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Einzig bei seinen zwar in Heldenpose dargebotenen, aber nicht immer heldenhaft treffsicher gespielten Soli schaut Kleinkrieg ab und zu ins Publikum, als könne er es selbst gar nicht fassen, daß er diesen tollen Lärm produziert.“"
                            },
                            {
                                "example_id": "10ea5535-5568-4b2e-a2ef-bd3211cebeed",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Das mag besonders schwerfallen am Beispiel der Treptower Gedenkstätte mit dem Bronzekoloß in pathetischer Heldenpose und den stalinistischen Spruchweisheiten an schweren Sarkophagen.“"
                            },
                            {
                                "example_id": "49531a9d-deb2-48da-9442-c229955cf776",
                                "sense_id": "0a43b087-0e90-35d6-bbad-318b3d397b8b",
                                "text": "„Damals fast eine kleine Provokation dagegen das dritte Standbild: Lässig und freundlich schaut der alte Moltke zu uns herunter -- mit übergeschlagenen Beinen, ohne Heldenpose, ohne den Mantel der Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
