                ],
                "senses": [
                    {
                        "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                        "entry_id": "c08de665-ff8c-3c7e-b055-36b7570e31e4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c0c051-3155-4192-9b4c-90fec5413251",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Frau Bürkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5bfb815d-132d-4133-b175-868f579319ca",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Herr Bürkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "86590026-0375-4867-a04c-9787e3912d50",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Die Bürkles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "068ee472-c9e6-4c6f-96dd-e4bb381e7592",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Der Bürkle trägt nie die Pullover, die die Bürkle ihm strickt."
                            },
                            {
                                "example_id": "f4363462-d92d-4464-ac20-781a1e8e8d10",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bürkle kommt, geht der Herr Bürkle.“"
                            },
                            {
                                "example_id": "72cf29e8-9b9c-4eb8-9482-0ae1168b1bf1",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Bürkle kommt und geht."
                            },
                            {
                                "example_id": "74ad6397-b394-4ed9-9e7d-9e76f9623b99",
                                "sense_id": "c5a6197b-e5e7-370f-b53a-70fe39c0b1f1",
                                "text": "Bürkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
