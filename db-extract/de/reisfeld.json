                "senses": [
                    {
                        "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                        "entry_id": "aa3cf350-f6ca-3323-97be-ac938e0e2b47",
                        "glosses": [
                            "Feld, auf dem Reis angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1d2ecd2-5598-40bb-aaff-60eee29366f7",
                                "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                                "text": "„Überflutete Reisfelder setzen einen Großteil des Treibhausgases Methan frei.“"
                            },
                            {
                                "example_id": "5f0d89e3-0317-43b9-80d2-174a20fc9315",
                                "sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                                "text": "„Wenn alles vorbei war, kehrten sie auf ihre Reisfelder zurück, als wäre nichts geschehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08d8d0ec-843b-4c55-b631-8f40e14303ab",
                        "source_entry_id": "aa3cf350-f6ca-3323-97be-ac938e0e2b47",
                        "source_sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                        "source_sense_description": "Feld, auf dem Reis angebaut wird",
                        "target_lang_word": "rice field",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rice field",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "177ab2ba-010e-3ff5-ae76-61a567ff76a6",
                                        "entry_id": "af48ebfa-f415-3c83-b094-cbc8879190c2",
                                        "glosses": [
                                            "Alternative form of ricefield."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb4c3342-3751-4e40-83fb-cb2886d9324b",
                                                "sense_id": "177ab2ba-010e-3ff5-ae76-61a567ff76a6",
                                                "text": "For the first 60 miles from Padang Besar, the railway passes through a succession of rice fields, with villages at regular intervals, but then crosses a jungle-clad mountain range to reach the west coast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4079190d-6197-45b3-a599-13edd74f6fb4",
                        "source_entry_id": "aa3cf350-f6ca-3323-97be-ac938e0e2b47",
                        "source_sense_id": "a21e57b7-14da-37fe-902d-5b0c77827896",
                        "source_sense_description": "Feld, auf dem Reis angebaut wird",
                        "target_lang_word": "rice paddy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rice paddy",
