                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se v dialektu ve významu „ne“ nebo „žádný“."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ne",
