                    {
                        "sense_id": "b510fb09-1e6e-38c3-ac6c-be0cdfb39315",
                        "entry_id": "79b45795-e423-306d-bc91-67b8c3535d33",
                        "glosses": [
                            "Being or relating to a direction between two adjacent cardinal points, i.e. northwest, northeast, southwest, or southeast."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eb32a238-d17e-4c11-a220-282e82e7522e",
                                "sense_id": "b510fb09-1e6e-38c3-ac6c-be0cdfb39315",
                                "text": "Let the general division of the winds be as follows: Cardinal Winds, which blow from the cardinal points of heaven; Semicardinal, which blow halfway between those points"
                            },
                            {
                                "example_id": "fa9668b2-ca1a-4af7-a71f-6270867a0648",
                                "sense_id": "b510fb09-1e6e-38c3-ac6c-be0cdfb39315",
                                "text": "Historically these colors were associated with the semicardinal directions as follows: black and northeast; yellow and southeast; red and southwest; white and northwest."
                            }
                        ]
                    }
                ],
