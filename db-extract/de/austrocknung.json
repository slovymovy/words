                                    {
                                        "sense_id": "0dc29be9-b7d2-3fcb-9f0b-cf96996c97f9",
                                        "entry_id": "ad19c865-b3a3-3bde-a2d6-77fbd556fde3",
                                        "glosses": [
                                            "The act of operation of drying; evaporation or expulsion of moisture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0d818c0-5b8d-43ee-a78a-c536a7b6fd96",
                                                "sense_id": "0dc29be9-b7d2-3fcb-9f0b-cf96996c97f9",
                                                "text": "That which is concreted by exsiccation or expression of humidity, will be resolved by humectification, as earth, dirt and clay."
                                            },
                                            {
                                                "example_id": "9c5847e2-6ac8-491d-83aa-b0a78d599424",
                                                "sense_id": "0dc29be9-b7d2-3fcb-9f0b-cf96996c97f9",
                                                "text": "This property is […] more specific than that of hardening in the air; which may be reckoned a kind of exsiccation, like the drying of clay into bricks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a4b185a-22f6-446a-9ed6-a38aa8033ff2",
                        "source_entry_id": "e5fe9628-3701-37cc-94be-3845dc431a11",
