                "translations": [
                    {
                        "translation_id": "a6ba7101-ed9a-4397-bf3b-5f5aad0360ff",
                        "source_entry_id": "71dd8f5c-94bd-38bb-a930-fc4d239103bf",
                        "source_sense_id": "4a67fa5e-4a11-3e13-80c9-2a45b0d2c638",
                        "source_sense_description": "geheel van machines",
                        "target_lang_word": "Maschinerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maschinerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc6dea91-4371-3138-b7d5-04df06ade4cd",
                                        "entry_id": "910df356-f339-3d06-9989-c37cdc045ae9",
                                        "glosses": [
                                            "komplexe, maschinelle Einrichtung oder mehrere zusammenwirkende Maschinen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "149ea5cf-6fd5-4373-948e-59a1682bde02",
                                                "sense_id": "bc6dea91-4371-3138-b7d5-04df06ade4cd",
                                                "text": "In Atomkraftwerken ist Energietechnik zu einer hochkomplexen Maschinerie verdichtet."
                                            },
                                            {
                                                "example_id": "7e47e8e5-d66b-43a7-8d22-c7d3e0f6869a",
                                                "sense_id": "bc6dea91-4371-3138-b7d5-04df06ade4cd",
                                                "text": "Der Kapitän und die Passagiere ergehen sich unterdessen ruhig auf dem Verdecke, ruhig flattert die Flagge auf dem Seitenmast, und wer das Boot so ruhig dahinschwimmen sieht, ahnet nicht, welche gefährliche Maschinerie und welche Sorge und Not in seinem Bauche verborgen ist."
                                            },
                                            {
                                                "example_id": "20be9f09-2536-42d3-aed0-ce1028e605cf",
                                                "sense_id": "bc6dea91-4371-3138-b7d5-04df06ade4cd",
                                                "text": "„Sie ergriff mich dann am Handgelenk, führte mich zu dem Tisch, auf dem die Maschinerie stand, um die Daumenabdrücke der Transitäre festzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d684c2a0-50a2-38a1-9ab9-10cf00999da6",
                                        "entry_id": "910df356-f339-3d06-9989-c37cdc045ae9",
                                        "glosses": [
                                            "maschinelle Einrichtungen des Theaters"
                                        ],
                                        "tags": [
                                            "Bühnentechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b652dc-e3d7-469a-b709-1a68fc9e3748",
                                                "sense_id": "d684c2a0-50a2-38a1-9ab9-10cf00999da6",
                                                "text": "Dieses Geschehen findet auf der großen Bühne statt, mit raffinierter Hydraulik-Verwandlung: Wenn Orpheus in die Unterwelt steigt, setzt die Maschinerie ganze Stockwerke in Bewegung."
                                            },
                                            {
                                                "example_id": "278c38e3-7114-4ed1-b74c-0aa867ad5cbf",
                                                "sense_id": "d684c2a0-50a2-38a1-9ab9-10cf00999da6",
                                                "text": "Dann entdeckte ich die Maschinerie des Vorhanges, und es gelang mir, denselben aufzuziehen. Da lag der Zuschauerraum dunkel und schwarz vor mir, […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a5b9f572-642e-3a63-8b28-b39cf5468203",
                                        "entry_id": "910df356-f339-3d06-9989-c37cdc045ae9",
                                        "glosses": [
                                            "starres, einem Automaten gleichendes System, das nicht oder nur schwer von außen beeinflusst werden kann"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0777f077-3f4d-4c85-b8de-4f58f0a02767",
                                                "sense_id": "a5b9f572-642e-3a63-8b28-b39cf5468203",
                                                "text": "Doch die Maschinerie war bereits in Gang gesetzt."
                                            },
                                            {
                                                "example_id": "4b17717a-8a2c-493a-be6d-c21c34f0a0e0",
                                                "sense_id": "a5b9f572-642e-3a63-8b28-b39cf5468203",
                                                "text": "Dabei sind einige der Essays an sich durchaus lesenswert. Es werden konstruktive Einblicke in die bürokratische Maschinerie gewährt und lebensnahe Anekdoten über die Sprachenvielfalt in Brüssel erzählt."
                                            },
                                            {
                                                "example_id": "084c579e-cee3-43da-ba9b-4cb693d58537",
                                                "sense_id": "a5b9f572-642e-3a63-8b28-b39cf5468203",
                                                "text": "Der Umgang mit Schwermut und Beklemmung gehört hier zum Alltag. Schon Stunden nach den Anschlägen schaltete also eine gut geölte Maschinerie in den fünften Gang - die Maschinerie der New Yorker Psychoindustrie."
                                            },
                                            {
                                                "example_id": "c8281632-9689-45ff-a2be-6e2d99c1818f",
                                                "sense_id": "a5b9f572-642e-3a63-8b28-b39cf5468203",
                                                "text": "„Die Maschinerie des Massenkriegs verschlingt ungeheure Ressourcen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "861213a4-b3b1-433a-b24a-8d555abeb755",
                        "source_entry_id": "71dd8f5c-94bd-38bb-a930-fc4d239103bf",
                        "source_sense_id": "4a67fa5e-4a11-3e13-80c9-2a45b0d2c638",
                        "source_sense_description": "geheel van machines",
                        "target_lang_word": "machinery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machinery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcf7b8b4-e7d9-3d57-a3db-e1317b08ab88",
                                        "entry_id": "b629b9c1-fe1a-3094-a211-f11280a93450",
                                        "glosses": [
                                            "The machines constituting a production apparatus, in a plant etc., collectively."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466a0d27-5480-4285-8dc4-0d7de4f8d45d",
                                                "sense_id": "bcf7b8b4-e7d9-3d57-a3db-e1317b08ab88",
                                                "text": "The external aspect of the oficina was not unlike that of a north-country coal or iron mine—tall chimneys and machinery, corrugated iron buildings, offices and houses, the shanties of workmen, a high bank of refuse."
                                            },
                                            {
                                                "example_id": "c2b2af04-2cee-4a11-a650-d1afd5260cf0",
                                                "sense_id": "bcf7b8b4-e7d9-3d57-a3db-e1317b08ab88",
                                                "text": "One or two wondered then, as if suddenly recalling the outlander, how he would manage, or if he would perish, up there among his unholy modern machineries that puffed out frozen steam to store the deer meat and shot fowl for him, […] \"And there were big boxes lugged up there, done up in iron clasps. Cruel-cold earth in those.\" […] \"Like corpse boxes,\" someone else suggested, down in the half-light, snug fust of the village drinking shop."
                                            },
                                            {
                                                "example_id": "e4e5eacf-d04c-49dc-8cd3-a33fd9e51316",
                                                "sense_id": "bcf7b8b4-e7d9-3d57-a3db-e1317b08ab88",
                                                "text": "All Mr. Yeats's grotesque machinery of sowlths and tevishes and sheogues leaves us without a shudder; his fantasies are stage-properties of the most unillusive kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a030950-e1af-3636-a353-5e065616db54",
                                        "entry_id": "b629b9c1-fe1a-3094-a211-f11280a93450",
                                        "glosses": [
                                            "The working parts of a machine as a group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ca8030a-057c-3757-be23-ce3378d31333",
                                        "entry_id": "b629b9c1-fe1a-3094-a211-f11280a93450",
                                        "glosses": [
                                            "The collective parts of something which allow it to function."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46a50e37-ed47-4f4b-8302-b12592381f89",
                                                "sense_id": "1ca8030a-057c-3757-be23-ce3378d31333",
                                                "text": "All of the machinery of the law was brought to bear on the investigation."
                                            },
                                            {
                                                "example_id": "e755e816-ffe8-432c-bb02-69f584c1f63d",
                                                "sense_id": "1ca8030a-057c-3757-be23-ce3378d31333",
                                                "text": "Since the three histone-fold domain amino acids are located at the surface of the α-helix 2 domain that is responsible for the formation of H3-H4 dimers and accessible in prenucleosomal complexes, it has been suggested that the specificity associated with these amino acid positions derives from interactions with different assembly or post-translational-modification machineries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c446eb-8402-3f1d-a6f3-abee83485d74",
                                        "entry_id": "b629b9c1-fe1a-3094-a211-f11280a93450",
                                        "glosses": [
                                            "The literary devices used in a work, notably for dramatic effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
