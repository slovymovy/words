                                "example_id": "34a7b662-2e1f-45bc-8c85-e07b0bbf2a4d",
                                "sense_id": "692beb0e-f4cb-3494-b981-fa0f544c8f4c",
                                "text": "„Im Jaipur an der Mundsburg kann man bis Mitternacht indisch schlemmen, das Silvestermenü gibt es ab 40 Mark.“"
                            },
                            {
                                "example_id": "8d766888-b9d1-4d1b-861e-2e9ad94ee21f",
                                "sense_id": "692beb0e-f4cb-3494-b981-fa0f544c8f4c",
                                "text": "„Die Konstellation beginnt sich zuzuspitzen, als alle zum Silvestermenü versammelt sitzen, ein jeder mit irgendeinem Geheimnis oder einer Mitwisserschaft behaftet.“"
                            }
                        ],
