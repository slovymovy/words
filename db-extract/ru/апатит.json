                ],
                "senses": [
                    {
                        "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                        "entry_id": "1bded655-259c-35e2-ac92-0298122aad2e",
                        "glosses": [
                            "минер. минерал, фосфат кальция, обычно используемый для производства фосфорных удобрений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb6cd2e-7191-4376-9805-7709f62228b8",
                                "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                                "text": "Лишь в порту лебёдок визг обычный, // Новый деррик над углём кряхтит – // В трюмы пароходов заграничных // Грузят лес и камень-апатит."
                            },
                            {
                                "example_id": "06e71600-9707-4628-bae1-71228ef63f74",
                                "sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                                "text": "Наиболее распространёнными и почти постоянно присутствующими в них минералами являются рудные — магнетит, ильменит, лейкоксен, пирит и лимонит и минералы — циркон, гранат, апатит, турмалин и рутил."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acfc4dfa-012c-4dcc-bd85-83c1ae5d6c63",
                        "source_entry_id": "1bded655-259c-35e2-ac92-0298122aad2e",
                        "source_sense_id": "c6e879df-67fe-34f9-9f56-7edf6b78adee",
                        "target_lang_word": "apatite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apatite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc99a93-f82b-32bf-9737-3afc1bbac46d",
                                        "entry_id": "f0594692-c478-39a8-a964-d49bc992aa87",
                                        "glosses": [
                                            "A calcium fluoride phosphate of variable composition, sometimes used in the manufacture of fertilizer, as a gemstone, and (in powdered form) as a pigment, and also produced biologically in bones and teeth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cc2b1ec-db31-4d19-b9be-783e9471c32c",
                                                "sense_id": "7bc99a93-f82b-32bf-9737-3afc1bbac46d",
                                                "text": "We had prepared, by precipitation methods, finely divided crystalline apatites that were similar in crystal size and x-ray diffraction profile to bone apatite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
