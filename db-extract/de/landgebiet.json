                "senses": [
                    {
                        "sense_id": "37582b0e-687e-37b7-b7c2-829087e50f29",
                        "entry_id": "c97ce43d-9397-36b9-89fd-d0a321fe2e41",
                        "glosses": [
                            "Territorium zu Lande, oft mit dem Hinweis, wem es zugehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25a7f07-9dd2-48ca-b4ce-7123d5d5a9b2",
                                "sense_id": "37582b0e-687e-37b7-b7c2-829087e50f29",
                                "text": "„Das Verhältnis der Stadt Ulm zu seinem weitläufigen Landgebiet war in erster Linie gekennzeichnet durch eine zentralistisch ausgerichtete Verwaltung.“"
                            },
                            {
                                "example_id": "ad9ab56e-8175-42fc-b194-4b841c90c02f",
                                "sense_id": "37582b0e-687e-37b7-b7c2-829087e50f29",
                                "text": "„Dabei senkt sich auch die Vergletscherungsgrenzfläche, was eine vermehrte Vergletscherung zur Folge hat, denn immer grössere Landgebiete kommen oberhalb jener zu liegen.“ (1915)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
