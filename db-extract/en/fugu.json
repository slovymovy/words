                        "glosses": [
                            "Blowfish: a delicacy popular in Japan served raw as sushi that may, if improperly prepared, contain deadly levels of neurotoxins."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "15c4bb7a-0d97-4b9f-b708-056fb44f8244",
                                "sense_id": "512b87f8-e927-3376-ae41-66400a7f7e49",
                                "text": "Twenty minutes later, the chef has successfully prepared a whole fugu—or puffer fish—a Japanese delicacy whose capacity to maim and kill is dividing the country’s culinary world."
                            },
                            {
                                "example_id": "36db205f-75f2-448e-b537-ea7e44ef01ff",
                                "sense_id": "512b87f8-e927-3376-ae41-66400a7f7e49",
                                "text": "A sluggish swimmer, fugu has stunted fins and often flat-lying spikes instead of scales, and when confronted by predators it compensates for its lack of speed by swallowing enough water to swell up until its spikes stand on end, so it looks like an angry armored balloon."
                            }
                        ]
                    }
