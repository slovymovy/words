{
    "word_family": [
        "bind",
        "binding",
        "bound"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58f0ef34-be2e-38e6-9914-532534fea143",
                    "sense_definition": "A cover or folder used to hold loose papers or pages together.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "office_supplies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put all your notes into a <w>binder</w> so they do not get lost.",
                            "target_lang_translations": {
                                "cs": "Prosím, dej si všechny poznámky do <w>pořadače</w>, aby se neztratily."
                            }
                        },
                        {
                            "text": "She organized her school reports in a thick blue <w>binder</w>.",
                            "target_lang_translations": {
                                "cs": "Své školní zprávy si uspořádala do tlustého modrého <w>šanonu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "three-ring binder"
                    ],
                    "target_lang_definitions": {
                        "cs": "Desky nebo pořadač používané k uchování volných papírů nebo stránek pohromadě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pořadač",
                                "target_lang_sense_clarification": "kancelářská pomůcka pro zakládání dokumentů"
                            },
                            {
                                "target_lang_word": "šanon",
                                "target_lang_sense_clarification": "běžně používaný název pro kroužkový pořadač"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea51e560-cc47-348a-9080-bd6cd6a8916e",
                    "sense_definition": "A substance that helps other materials stick together.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The paint manufacturer added a <w>binder</w> to ensure the color stays on the wall.",
                            "target_lang_translations": {
                                "cs": "Výrobce barvy přidal <w>pojivo</w>, aby zajistil, že barva na zdi udrží."
                            }
                        },
                        {
                            "text": "This natural resin acts as a strong <w>binder</w> for the construction materials.",
                            "target_lang_translations": {
                                "cs": "Tato přírodní pryskyřice funguje jako silné <w>pojivo</w> pro stavební materiály."
                            }
                        }
                    ],
                    "synonyms": [
                        "binding agent"
                    ],
                    "target_lang_definitions": {
                        "cs": "Látka, která pomáhá jiným materiálům držet pohromadě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pojivo",
                                "target_lang_sense_clarification": "chemická nebo fyzikální látka spojující složky směsi"
                            },
                            {
                                "target_lang_word": "vazač",
                                "target_lang_sense_clarification": "technický termín pro látku zajišťující soudržnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b929a4ce-abfc-3377-bee8-a0dc6c8cfd2e",
                    "sense_definition": "A machine used in farming to tie cut grain into bundles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "machinery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>binder</w> was still used on the farm to harvest the wheat.",
                            "target_lang_translations": {
                                "cs": "Starý <w>vazač</w> se na farmě stále používal ke sklizni pšenice."
                            }
                        },
                        {
                            "text": "Farmers once relied on a horse-drawn <w>binder</w> to collect their crops.",
                            "target_lang_translations": {
                                "cs": "Zemědělci se kdysi při sklizni spoléhali na koňský <w>vazač</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sheaving machine"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zemědělský stroj používaný k vázání posekaného obilí do snopů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vazač",
                                "target_lang_sense_clarification": "zemědělský stroj na vázání obilí"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2cc465f4-5a43-3a44-963b-3b5318a0843b",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the report is named Mr. <w>Binder</w>.",
                            "target_lang_translations": {
                                "cs": "Autorem zprávy je pan <w>Binder</w>."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Binder</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "cs": "Včera jsem na konferenci potkal ženu jménem Sarah <w>Binder</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Binder",
                                "target_lang_sense_clarification": "příjmení (ponechává se v původním tvaru)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}