                ],
                "senses": [
                    {
                        "sense_id": "79d986fd-0cb4-3311-b1eb-62fe79a28f18",
                        "entry_id": "3d53db02-a7c6-34cd-b8c7-9b4f54102e29",
                        "glosses": [
                            "höheres Bauwerk, auf dem die Zeit angezeigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37cd8c1b-6440-4426-b18f-025e87bd1b7d",
                                "sense_id": "79d986fd-0cb4-3311-b1eb-62fe79a28f18",
                                "text": "„Der neunstöckige Uhrenturm deutet wohl an, dass die Hofanlage eine Stadt in der Stadt sein könnte, wie sie dem Namensgeber, Bürgermeister Karl Seitz, durchaus zugestanden wäre.“"
                            },
                            {
                                "example_id": "75847d8d-c7d9-4197-a2c2-f990f9d5a6a9",
                                "sense_id": "79d986fd-0cb4-3311-b1eb-62fe79a28f18",
                                "text": "„Dann fuhren sie durch das üppige Susquehannatal und sahen die Kuppeln und Dächer und den Uhrenturm des Campus, das ganze amerikanische, nicht jüdische Kleinstadtambiente, bürgerlich und republikanisch, aber unprätentiös und einladend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
