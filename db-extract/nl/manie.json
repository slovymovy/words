                                "target_senses": [
                                    {
                                        "sense_id": "5a8451ce-3f8a-3bcd-af88-d28259f1d79d",
                                        "entry_id": "b8e52589-e9f8-3a0d-943f-3afd6f0c331d",
                                        "glosses": [
                                            "Violent derangement of mind; madness; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ec926b7-a4d6-3038-9f9a-52e542e967ee",
                                        "entry_id": "b8e52589-e9f8-3a0d-943f-3afd6f0c331d",
                                        "glosses": [
                                            "Excessive or unreasonable desire; insane passion affecting one or many people; fanaticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b676bd46-6184-450d-b52a-fd1b5320f5b2",
                                                "sense_id": "0ec926b7-a4d6-3038-9f9a-52e542e967ee",
                                                "text": "One of the manias of the present day, which especially excites my spleen, is the locomotive rage which seems to possess all ranks—that necessity of going out of town in the summer..."
                                            },
                                            {
                                                "example_id": "1eb8d2fe-7233-47f6-9b40-5036358f52f4",
                                                "sense_id": "0ec926b7-a4d6-3038-9f9a-52e542e967ee",
                                                "text": "Dotcom mania was slow in coming to higher education, but now it has the venerable industry firmly in its grip. Since the launch early last year of Udacity and Coursera, two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations."
                                            },
                                            {
                                                "example_id": "af395cca-1f5a-4387-8e5a-f25f71a0a712",
                                                "sense_id": "0ec926b7-a4d6-3038-9f9a-52e542e967ee",
                                                "text": "The eugenics mania that swept the country in the late 19th and early 20th centuries led to forced sterilizations and the passage of laws in 27 states designed to limit the numbers of those considered genetically unfit: immigrants, Jews, African-Americans, the mentally ill and those deemed “morally delinquent.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5bbbca2-6482-3425-8c19-8ed3ca2cb0a8",
                                        "entry_id": "b8e52589-e9f8-3a0d-943f-3afd6f0c331d",
                                        "glosses": [
                                            "The state of abnormally elevated or irritable mood, arousal, and/or energy levels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
