                        "examples": [
                            {
                                "example_id": "7588bbb7-69ee-4be4-8f18-cd931c77da35",
                                "sense_id": "66c80cc9-5e0e-34d2-b84c-c5b162af1b80",
                                "text": "C’était pourtant une période marrante niveau histoires naturelles. Car en 1750, Buffon faisait son gros troll et profitait de l’écriture de son gros bouquin Histoires naturelles pour bitcher sur les Américains."
                            },
                            {
                                "example_id": "a24b997c-bb07-40b5-bc66-f8e3138598b2",
                                "sense_id": "66c80cc9-5e0e-34d2-b84c-c5b162af1b80",
                                "text": "JE BITCHE, TU BITCHES\n Ici au Québec, où on parle de plus en plus franglais, combien de personnes se traitent de bitche ? On conjugue même le verbe bitcher à tous les temps."
                            }
                        ]
