                "senses": [
                    {
                        "sense_id": "b6675340-5902-3b33-a932-951b55d6676a",
                        "entry_id": "7e15dca0-c7be-37aa-a824-f9a413ad78e3",
                        "glosses": [
                            "Donner un caractère représentatif à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3363c02f-ce6d-4381-a1b5-99ba69d95235",
                                "sense_id": "b6675340-5902-3b33-a932-951b55d6676a",
                                "text": "Autonomisation de la société civile, cela veut dire libération d’un pôle pratique de mouvement par rapport à un pôle transcendant de stabilité. Lequel n’existe à son tour de façon véritablement indépendante qu’une fois le pouvoir impersonnifié, désincorporé, expressément « représentativisé »."
                            },
                            {
                                "example_id": "e81f222b-448b-44ac-b833-0cab61bccbee",
                                "sense_id": "b6675340-5902-3b33-a932-951b55d6676a",
                                "text": "Pour revenir au sujet, les pouvoirs législatifs et exécutifs étant devenus représentatifs de ton zaïm et de celui de ton frère, il fallait représentativiser le pouvoir (…)"
                            }
                        ]
                    }
