                                            {
                                                "example_id": "b1bf53e2-650b-4965-a8e0-d2265c662e58",
                                                "sense_id": "1660f17f-5e15-3f95-a4de-fd6ed43eaeb3",
                                                "text": "Chez les peuples exogames, aucun homme ne peut épouser une femme portant le même nom de famille."
                                            },
                                            {
                                                "example_id": "3db96d65-e80c-472e-853d-cc3e542cc9ac",
                                                "sense_id": "1660f17f-5e15-3f95-a4de-fd6ed43eaeb3",
                                                "text": "La multiplication de ces unions exogames menace donc de priver de statut des descendants de Hurons-Wendats dans les prochaines années."
                                            },
                                            {
                                                "example_id": "d4e068bf-e8e6-4207-a424-82810abdbc32",
                                                "sense_id": "1660f17f-5e15-3f95-a4de-fd6ed43eaeb3",
                                                "text": "En Ontario, deux enfants sur trois qui fréquentent l’école de langue française proviennent de couples exogames. Cela signifie que seulement un des parents est francophone."
                                            }
                                        ]
