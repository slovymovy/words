                                "example_id": "89883050-a180-4efb-867e-aed3f3248582",
                                "sense_id": "aa28d8f0-e9ed-3adc-9279-6a891873b423",
                                "text": "Trainer Mario Been van het dolende Feyenoord blijft strijdbaar. De Rotterdamse coach reageerde vrijdag geprikkeld op enkele uitspraken van clubheld Willem van Hanegem in diens lijfblad AD Sportwereld."
                            },
                            {
                                "example_id": "1394705a-f810-4987-953c-5d54a3539a7c",
                                "sense_id": "aa28d8f0-e9ed-3adc-9279-6a891873b423",
                                "text": "Volgens Johan Cruijff is in de strijd om de macht bij Ajax een patstelling ontstaan. Dat zegt de legendarische nummer 14 vrijdag in zijn lijfblad De Telegraaf."
                            },
                            {
                                "example_id": "a04a4834-dd63-4331-82d8-9ee9b57d1770",
                                "sense_id": "aa28d8f0-e9ed-3adc-9279-6a891873b423",
                                "text": "Het idee voor zijn spreekbeurt haalde de 11-jarige Jelmer Immink van de christelijke basisschool De Ark in Daarle uit zijn lijfblad, de Donald Duck."
                            }
                        ]
                    }
