{
    "word_family": [
        "paganism",
        "paganize",
        "paganly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "06aa91ce-6797-317e-af62-13ca97f1f9b8",
                    "sense_definition": "Relating to religions that are not part of the major world religions, often involving nature worship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient societies practiced <w>pagan</w> rituals to honor the changing seasons.",
                            "target_lang_translations": {
                                "nl": "Veel oude samenlevingen voerden <w>heidense</w> rituelen uit om de wisselende seizoenen te eren."
                            }
                        },
                        {
                            "text": "The historian studied how <w>pagan</w> traditions influenced local folklore over many centuries.",
                            "target_lang_translations": {
                                "nl": "De historicus bestudeerde hoe <w>heidense</w> tradities de plaatselijke folklore gedurende vele eeuwen hebben beïnvloed."
                            }
                        }
                    ],
                    "synonyms": [
                        "heathen"
                    ],
                    "common_phrases": [
                        "pagan ritual",
                        "pagan tradition"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met betrekking tot religies of tradities die niet tot de grote wereldgodsdiensten behoren, vaak met natuuraanbidding."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "heidens",
                                "target_lang_sense_clarification": "met betrekking tot heidense religies of tradities; niet behorend tot de grote wereldgodsdiensten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca4384c1-6575-3a95-ac49-867587e3069f",
                    "sense_definition": "Describing someone or something as uncivilized, wild, or lacking moral refinement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers described the remote tribe as having a <w>pagan</w> way of life.",
                            "target_lang_translations": {
                                "nl": "De ontdekkingsreizigers beschreven de afgelegen stam als mensen met een <w>onbeschaafde</w> levenswijze."
                            }
                        },
                        {
                            "text": "He rejected the <w>pagan</w> behavior of the crowd during the chaotic festival.",
                            "target_lang_translations": {
                                "nl": "Hij wees het <w>onbeschaafde</w> gedrag van de menigte tijdens het chaotische festival af."
                            }
                        }
                    ],
                    "synonyms": [
                        "barbarian",
                        "barbaric",
                        "savage"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand of iets beschrijvend als onbeschaafd, wild of zonder morele verfijning."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onbeschaafd",
                                "target_lang_sense_clarification": "onbeschaafd, ruw of zonder verfijning in gedrag"
                            },
                            {
                                "target_lang_word": "immoreel",
                                "target_lang_sense_clarification": "moreel verwerpelijk of zonder zedelijke normen"
                            },
                            {
                                "target_lang_word": "barbaars",
                                "target_lang_sense_clarification": "bruut, ruw en wreed van aard"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16039b3b-7303-3bf7-9661-88202b830c4e",
                    "sense_definition": "A person who follows a religion that is not one of the major world religions, often focusing on nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The modern <w>pagan</w> gathered with others to celebrate the summer solstice.",
                            "target_lang_translations": {
                                "nl": "De moderne <w>heiden</w> kwam met anderen samen om de zomerzonnewende te vieren."
                            }
                        },
                        {
                            "text": "Many <w>pagans</w> feel a deep spiritual connection to the natural world.",
                            "target_lang_translations": {
                                "nl": "Veel <w>heidenen</w> voelen een diepe spirituele verbondenheid met de natuur."
                            }
                        }
                    ],
                    "synonyms": [
                        "heathen"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iemand die een religie volgt die niet tot de grote wereldgodsdiensten behoort, vaak met nadruk op de natuur."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "heiden",
                                "target_lang_sense_clarification": "aanhanger van een heidense of natuurgerichte religie"
                            },
                            {
                                "target_lang_word": "heidin",
                                "target_lang_sense_clarification": "vrouwelijke aanhanger van een heidense religie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ab78ad2-b3f0-3299-bb30-d5d6880f6296",
                    "sense_definition": "An uncivilized or unsocialized person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acted like a total <w>pagan</w> at the formal dinner party.",
                            "target_lang_translations": {
                                "nl": "Hij gedroeg zich als een complete <w>barbaar</w> op het formele etentje."
                            }
                        },
                        {
                            "text": "The refined guests looked down upon the <w>pagan</w> who disrupted the event.",
                            "target_lang_translations": {
                                "nl": "De verfijnde gasten keken neer op de <w>barbaar</w> die het evenement verstoorde."
                            }
                        }
                    ],
                    "synonyms": [
                        "philistine",
                        "savage"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een onbeschaafd of niet gesocialiseerd persoon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "barbaar",
                                "target_lang_sense_clarification": "onbeschaafd of grof persoon"
                            },
                            {
                                "target_lang_word": "heiden",
                                "target_lang_sense_clarification": "figuurlijk: onbeschaafd persoon"
                            },
                            {
                                "target_lang_word": "wildeman",
                                "target_lang_sense_clarification": "ruwe, onbeschaafde man"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2f87d6c-d501-31a4-acfc-c2ea2b999e86",
                    "sense_definition": "An unruly or poorly behaved child.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher struggled to control the little <w>pagan</w> in the back of the room.",
                            "target_lang_translations": {
                                "nl": "De leraar had moeite om die kleine <w>deugniet</w> achter in het lokaal in toom te houden."
                            }
                        },
                        {
                            "text": "Stop acting like a <w>pagan</w> and sit down quietly.",
                            "target_lang_translations": {
                                "nl": "Doe niet zo'n <w>deugniet</w> en ga rustig zitten."
                            }
                        }
                    ],
                    "synonyms": [
                        "brat"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een onhandelbaar of slecht opgevoed kind."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "deugniet",
                                "target_lang_sense_clarification": "ondeugend of lastig kind"
                            },
                            {
                                "target_lang_word": "ettertje",
                                "target_lang_sense_clarification": "vervelend, slecht opgevoed kind"
                            },
                            {
                                "target_lang_word": "snotaap",
                                "target_lang_sense_clarification": "brutaal of lastig kind"
                            }
                        ]
                    }
                }
            ]
        },
        {
