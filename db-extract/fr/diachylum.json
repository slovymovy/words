                "senses": [
                    {
                        "sense_id": "92569b6d-37ca-3b47-bfca-8d72824db04a",
                        "entry_id": "b80d3398-a87a-3a99-93e7-b4ccce5bfcf4",
                        "glosses": [
                            "Emplâtre considéré comme résolutif, composé de savon de plomb, de gommes-résines, de cire jaune, de poix de Bourgogne et de térébenthine de mélèze."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "2a7e3880-9d37-481e-9d8c-0282f1377209",
                                "sense_id": "92569b6d-37ca-3b47-bfca-8d72824db04a",
                                "text": "Appliquez sur le charbon ou bubon, par où le venin sera sorti, une emplâtre de diachylum."
                            },
                            {
                                "example_id": "28ba071f-5be6-4171-8e01-9814d74a29f0",
                                "sense_id": "92569b6d-37ca-3b47-bfca-8d72824db04a",
                                "text": "Vainqueur et vaincu — celui-ci ayant couvert son égratignure de deux centimètres de diachylum — sablèrent gaiement le Champagne."
                            },
                            {
                                "example_id": "5717a041-3c53-489a-887d-64dbd9477efc",
                                "sense_id": "92569b6d-37ca-3b47-bfca-8d72824db04a",
                                "text": "Charles la rassura, le cas n’était point grave, et il alla chercher du diachylum."
                            },
                            {
                                "example_id": "21584606-22c5-40ed-9083-ec1ce37b8776",
                                "sense_id": "92569b6d-37ca-3b47-bfca-8d72824db04a",
                                "text": "Au début du XXᵉ siècle, le diachylum a aussi été utilisé comme isolant électrique."
                            }
                        ]
                    }
