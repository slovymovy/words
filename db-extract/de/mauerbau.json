                ],
                "senses": [
                    {
                        "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                        "entry_id": "7deb46ce-439a-3bad-82d7-dc58b84a8533",
                        "glosses": [
                            "die Errichtung der Berliner Mauer"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "7e60e7da-c3c9-45df-aa35-a29ec947ca38",
                                "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                                "text": "„Für die Bevölkerung der geteilten Stadt hatte der Mauerbau einschneidende Folgen.“"
                            },
                            {
                                "example_id": "5abcde9a-e074-4f81-8232-06f23efc6ffe",
                                "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                                "text": "„Täglich überschritten vor dem Mauerbau rd. 60 000 Grenzgänger die Demarkationslinie, um ihrer Arbeit im anderen Teil der Stadt nachzugehen (49 000 Ostberliner arbeiteten in Westberlin, 10 000 Westberliner in Ostberlin).“"
                            },
                            {
                                "example_id": "dc3fc336-fadf-47af-bdde-1ff6a057916d",
                                "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                                "text": "„Durch den Mauerbau wurden beide Teile der Stadt hermetisch voneinander abgeriegelt.“"
                            },
                            {
                                "example_id": "ba19cadb-a7db-4642-b640-46a85595c345",
                                "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                                "text": "„Der Mauerbau weckte im Westen eine Welle von Empörung.“"
                            },
                            {
                                "example_id": "c16e2975-c96d-4ec5-ba46-d3a2efb90f5e",
                                "sense_id": "665634f8-ce24-3e1e-ad88-0606a72533ad",
                                "text": "„So wenig wie ich vom Mauerbau mitbekommen habe, so wenig bekam ich auch von der Mauer selbst etwas mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
