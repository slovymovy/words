                                "target_senses": [
                                    {
                                        "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                                        "entry_id": "93c88681-28a2-303a-85c0-67c01b52c8b3",
                                        "glosses": [
                                            "Capitale de la Mongolie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf5080d6-bdef-4c3a-8060-0d5ecb7609eb",
                                                "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                                                "text": "Le Jebtsundamba Khutuktu est le chef spirituel de l’église bouddhiste en Mongolie. Il serait la réincarnation du lama Zanabazar, lama fondateur de la ville d’Oulan-Bator qui occupe une place importante dans l'iconographie nationale de la Mongolie contemporaine."
                                            },
                                            {
                                                "example_id": "9589f0d3-3e04-47e9-b796-6ae4fb622e4a",
                                                "sense_id": "026e752b-db45-30bb-850d-25c2ce3d9354",
                                                "text": "La chambre de commerce et d’industrie (CCI) France Mongolie, située à Oulan-Bator, la capitale mongole, recherche un stagiaire pour une durée de deux mois."
                                            }
                                        ]
                                    }
