                "senses": [
                    {
                        "sense_id": "ad64264f-9e6c-374d-b9cc-429c44881410",
                        "entry_id": "3bf1a425-5e37-3b6a-a9d2-88583755f7c1",
                        "glosses": [
                            "odnoszący się do Manchesteru, związany z Manchesterem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0499b82-427f-4aca-83c9-c8907b3afe76",
                                "sense_id": "ad64264f-9e6c-374d-b9cc-429c44881410",
                                "text": "Jej plakaty wyborcze pojawiły się w kilku manchesterskich dzielnicach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00f74b0b-36ef-492d-aee0-71cf903026ca",
                        "source_entry_id": "3bf1a425-5e37-3b6a-a9d2-88583755f7c1",
                        "source_sense_id": "ad64264f-9e6c-374d-b9cc-429c44881410",
                        "target_lang_word": "Mancunian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mancunian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6306228-d9ef-33bd-b4ac-396975e84816",
                                        "entry_id": "6a0dedea-d1c4-3839-a942-8da9042e8c87",
                                        "glosses": [
                                            "Related or pertaining to Manchester, England, in the United Kingdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02245fce-079b-4204-a6a5-ec7c94915004",
                                                "sense_id": "d6306228-d9ef-33bd-b4ac-396975e84816",
                                                "text": "Current among the Britons, the name of Manchester was equally received and retained by the Saxons. […] [M]oſt of the more remarkable objects about the town, at this period, exchanged their Britiſh denominations for Saxon. And even one of the rivers, even the monarch of the Mancunian currents, now reſigned up its original name of Beliſama, and received another; from the marſhes and marſhy meadows, that ſkirt its channel on both ſides in one continued line to the ſea, obtaining the deſcriptive denomination of Merſc-ey, Merſ-ey, or marſhy water."
                                            },
                                            {
                                                "example_id": "35ca8ed6-5332-433f-b978-8ee083bd46f2",
                                                "sense_id": "d6306228-d9ef-33bd-b4ac-396975e84816",
                                                "text": "The Bridgewater Canal in Manchester during the summer months is colonised every Sunday by hundreds of Mancunian men and boys involved in angling competitions, a very traditional and gendered practice."
                                            },
                                            {
                                                "example_id": "03e6ae69-c235-4a41-bc18-80906f771211",
                                                "sense_id": "d6306228-d9ef-33bd-b4ac-396975e84816",
                                                "text": "The Sex Pistols' first performance at Manchester's Lesser Free Trade Hall on June 4, 1976 has become widely accredited as 'year zero' in the history of Mancunian rock music."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mancunian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d77db8ca-7998-3660-bcb4-d956fe70aecb",
                                        "entry_id": "c67bd388-8e6d-3a7e-9465-39942afc6b91",
                                        "glosses": [
                                            "A person raised or living in the city of Manchester, England, in the United Kingdom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31f81ddd-d4af-4c9d-b43f-7d22e1bfbb0a",
                                                "sense_id": "d77db8ca-7998-3660-bcb4-d956fe70aecb",
                                                "text": "But the Mancunians are of all men the most disposed to peace. Their name has become a bye-word because they are said to require peace at any price. If the Mancunians are satisfied, for Heaven's sake do not let us put it into their heads that they could gain anything by change."
                                            },
                                            {
                                                "example_id": "b35c5d90-dc94-44cd-a6f2-78d73974d70c",
                                                "sense_id": "d77db8ca-7998-3660-bcb4-d956fe70aecb",
                                                "text": "In this epitome of local medical history there is much of which any Mancunian can be proud, be he a medical man, a citizen of Greater Manchester or a member of its universities."
                                            },
                                            {
                                                "example_id": "4386cbac-4c89-461b-bbeb-bec6a2811f16",
                                                "sense_id": "d77db8ca-7998-3660-bcb4-d956fe70aecb",
                                                "text": "Mancunians have shown their defiance in the face of terror after a suicide bomber killed 22 people in the city on Monday night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Mancunian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "639829ab-455c-3493-bf00-e52ff056b024",
                                        "entry_id": "f601b52d-ba9d-348c-97b4-ee972d7c0699",
                                        "glosses": [
                                            "The accent and dialect of English spoken in Manchester and some of its environs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
