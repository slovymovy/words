                "senses": [
                    {
                        "sense_id": "e654304e-3adf-3bb4-9401-af565045d79a",
                        "entry_id": "ffcddd36-d533-37c3-832d-cd776c849828",
                        "glosses": [
                            "Rendre moins clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "091426bc-6b5d-499a-b7f2-88d4a90ab725",
                                "sense_id": "e654304e-3adf-3bb4-9401-af565045d79a",
                                "text": "Il y a des oublis et ça ne fait que déclarifier ce tableau déjà compliqué !"
                            },
                            {
                                "example_id": "8093792f-5536-41a5-bc5f-0662ed00ae83",
                                "sense_id": "e654304e-3adf-3bb4-9401-af565045d79a",
                                "text": "Il se demande pourquoi le monde prend de telles mesures pour « déclarifier » ce qu'ils disent - juste dis-le!"
                            },
                            {
                                "example_id": "5e34c72c-b7cb-4415-8f70-b3c984319838",
                                "sense_id": "e654304e-3adf-3bb4-9401-af565045d79a",
                                "text": "Mais la position de l'Église a en fait toujours été très claire. On se demande pourquoi ils se sont amusés à la \"déclarifier\" ces derniers temps !"
                            }
                        ]
                    }
