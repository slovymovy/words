                                                "sense_id": "fc2f0e3b-40e8-3809-a0b3-e0dfd6684f00",
                                                "text": "Faire le guet."
                                            },
                                            {
                                                "example_id": "9826245f-1210-4553-b147-09058dccc58a",
                                                "sense_id": "fc2f0e3b-40e8-3809-a0b3-e0dfd6684f00",
                                                "text": "Ce chien aboie à propos, il est de très bon guet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93e098c4-b291-34c3-a970-f7a2c38a879e",
                                        "entry_id": "e8849d57-921b-335c-b350-febfd18ffeff",
                                        "glosses": [
                                            "Surveillance qu’on exerçait, pendant la nuit, dans une place de guerre pour prévenir les surprises de l’ennemi, ou dans une ville quelconque pour maintenir le bon ordre, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86677d1c-f15b-4851-8d79-2e0670d8be5a",
                                                "sense_id": "93e098c4-b291-34c3-a970-f7a2c38a879e",
                                                "text": "Dans cette ville, ce sont les bourgeois qui font le guet."
                                            },
                                            {
                                                "example_id": "bff73f2e-6ccc-4294-acd1-fc4474ca756a",
                                                "sense_id": "93e098c4-b291-34c3-a970-f7a2c38a879e",
                                                "text": "Être chargé du guet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a0baf2-abf0-39f9-bc9a-5282fce7a90e",
                                        "entry_id": "e8849d57-921b-335c-b350-febfd18ffeff",
                                        "glosses": [
                                            "Troupe chargée de faire le guet ou la ronde pendant la nuit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527b49dd-7f50-4e8f-beeb-3cd520817425",
                                                "sense_id": "91a0baf2-abf0-39f9-bc9a-5282fce7a90e",
                                                "text": "Guet à pied."
                                            },
                                            {
                                                "example_id": "3591a67e-5269-4990-b826-7768fbd4acbb",
                                                "sense_id": "91a0baf2-abf0-39f9-bc9a-5282fce7a90e",
                                                "text": "Guet à cheval."
                                            },
                                            {
                                                "example_id": "f6dd43e8-a652-4668-b328-5c7cd086e87f",
                                                "sense_id": "91a0baf2-abf0-39f9-bc9a-5282fce7a90e",
                                                "text": "Le guet vient de passer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811958be-b4bd-3a82-9971-633075ed56ee",
                                        "entry_id": "e8849d57-921b-335c-b350-febfd18ffeff",
                                        "glosses": [
                                            "Variante orthographique de guett."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bc7c747-e35a-4b01-9574-bc1e6a7ee1cf",
                                                "sense_id": "811958be-b4bd-3a82-9971-633075ed56ee",
                                                "text": "Mariée durant quinze ans, la première réclame depuis des mois son \"guet\", cette lettre de répudiation qui délie l’épouse des liens du mariage."
                                            }
                                        ]
