                                        "sense_id": "242c10cb-6688-32e1-a9f5-4110eb02ea79",
                                        "entry_id": "76a098ef-d95f-3cb1-8a32-71b4dd6d6a34",
                                        "glosses": [
                                            "Bois du sidéroxylon."
                                        ],
                                        "tags": [
                                            "Ébénisterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c279b96c-ffe3-4989-8d3b-4b0261e2e842",
                                                "sense_id": "242c10cb-6688-32e1-a9f5-4110eb02ea79",
                                                "text": "Le salon, parqueté tout en bois de fer, offre aux regards les merveilles d’une peinture imitant les laques de Chine."
                                            },
                                            {
                                                "example_id": "c64437ee-cf91-468d-ae83-cd0772749c55",
                                                "sense_id": "242c10cb-6688-32e1-a9f5-4110eb02ea79",
                                                "text": "L’on ne voit, à de rares intervalles, que des arbres à bois de fer, des gommiers, des arbres du Pérou aux grappes rouges et pimentées, des nopals et des cactus, seuls arbres qui peuvent croître dans un terrain calciné par les rayons incandescents d’un soleil perpendiculaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c776e7e-0f90-3701-b58e-9cdf751f1f11",
