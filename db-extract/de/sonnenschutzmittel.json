                        "source_sense_id": "c406529e-d3b2-3ed0-b2f8-9d4224610473",
                        "source_sense_description": "Emulsionen als Hautschutz gegen gefährliche UV-Strahlungen und Sonnenbrand",
                        "target_lang_word": "sunscreen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
