                "senses": [
                    {
                        "sense_id": "79158667-b0d8-3dbc-8c30-eded8e661c6a",
                        "entry_id": "472d42ad-7d2e-3d6b-b1be-e6689945240a",
                        "glosses": [
                            "绕的，绕来绕去的，复杂纷繁的，拐弯抹角的"
                        ],
                        "tags": [
                            "常比喻義"
                        ],
                        "examples": [
                            {
                                "example_id": "6b1c5f2c-2bb8-4599-bf36-7c94eee2163d",
                                "sense_id": "79158667-b0d8-3dbc-8c30-eded8e661c6a",
                                "text": "The badger made his dark and tortuous hole on the side of every hill where the copsewood grew thick."
                            },
                            {
                                "example_id": "f6b81b54-bdd2-4d06-9c2c-89dd5bd58d2f",
                                "sense_id": "79158667-b0d8-3dbc-8c30-eded8e661c6a",
                                "text": "The Southern acquired them because the little Class \"B4\" 0-4-0 tanks were finding heavy modern rolling stock more and more of a handful, and at war's end the railway had nothing of suitable power but short wheelbase on its books to take their place on the more tortuous of the dock lines."
                            },
                            {
                                "example_id": "c7cc1b74-513a-4d5b-a6a8-e9721160e8af",
                                "sense_id": "79158667-b0d8-3dbc-8c30-eded8e661c6a",
                                "text": "It still takes almost half a year for the average veteran’s claim for disability benefits to be decided in a tortuous process that can involve four separate hearings."
                            },
                            {
