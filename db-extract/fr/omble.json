                                                "sense_id": "f12e7d98-6997-39e8-b330-0adce2facf9b",
                                                "text": "I charred the wood."
                                            },
                                            {
                                                "example_id": "db036869-e722-42c9-a7a1-e369c98ac44f",
                                                "sense_id": "f12e7d98-6997-39e8-b330-0adce2facf9b",
                                                "text": "The wood charred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f04e11ef-3e7a-398e-aafc-7c296eb64b84",
                                        "entry_id": "16c1a6c8-e30c-302f-a39a-36bfec943360",
                                        "glosses": [
                                            "To burn (something) severely, so as to blacken it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fbf3cf-3d46-42f9-90de-51817a71b6dc",
                                                "sense_id": "f04e11ef-3e7a-398e-aafc-7c296eb64b84",
                                                "text": "The fire charred her down to the bone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a10a6784-f4a5-35bb-bb1b-17c05e23643c",
                                        "entry_id": "16c1a6c8-e30c-302f-a39a-36bfec943360",
                                        "glosses": [
                                            "To burn (something) slightly or superficially so as to affect colour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4c212b-bf26-4fa3-8d74-aeb4e628bb29",
                                                "sense_id": "a10a6784-f4a5-35bb-bb1b-17c05e23643c",
                                                "text": "The chef charred the scallops just right."
                                            }
                                        ]
                                    }
                                ]
                            },
