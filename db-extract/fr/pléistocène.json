                                                "example_id": "cd145417-15ce-4c02-930e-bc34c0061194",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Zu dieser Zeit herrschten in Mitteleuropa noch kaltzeitliche Verhältnisse mit deutlich geringeren Jahresmitteltemperaturen als heute, die - abgesehen von kurzen Wärmeschwankungen - für fast das gesamte damals ausklingende Pleistozän, das Eiszeitalter, kennzeichnend waren.“"
                                            },
                                            {
                                                "example_id": "d00e6573-25a1-45cc-b78a-be3efc12e97f",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im Pleistozän herrschten in Europa mehrere Eiszeiten.“"
                                            },
                                            {
                                                "example_id": "d8b73ce5-4bd9-436f-8fef-cfea21d6fc88",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im mittleren Pleistozän wirkten sich die klimatischen Bedingungen der Eiszeiten auf die biologische und kulturelle Evolution des Frühmenschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53ba0836-6c48-40f2-a95a-d186f89a4128",
                        "source_entry_id": "f67c9c7d-32a0-37a6-bca0-306471838f14",
                        "source_sense_id": "5ef5f2d7-0915-361a-ab38-13d99cfeb92b",
                        "target_lang_word": "Pleistocene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pleistocene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378d66f3-6311-3be2-a781-189f3f61d09c",
                                        "entry_id": "3ff86171-a6a9-37c7-a0b5-bc6251c52189",
                                        "glosses": [
                                            "Of a geologic epoch within the Quaternary period from about 2,588,000 to 11,700 years ago (earlier definition 1.7 million to 11,000 years ago); marked by the evolution of man, and the extinction of the large mammals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pleistocene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                        "entry_id": "52df202c-1959-307c-b1a7-cd13f065f007",
                                        "glosses": [
                                            "The Pleistocene epoch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91b8b68-8d55-48cf-a2f5-88293c60ce77",
                                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                                "text": "A prehistoric site of late Pleistocene age, which was especially prepared for our visit, was seen at Ting-ts'un, above the Fen River (Shansi)."
                                            },
                                            {
                                                "example_id": "3cf5beac-bbeb-41b1-9920-caae0799d442",
                                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                                "text": "Throughout the Pleistocene, climatic changes exerted another type of selective pressure on human biological evolution, contributing to the rapid emergence of various Homo species over time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
