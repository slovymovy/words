                "senses": [
                    {
                        "sense_id": "a8d7333c-568a-3d53-aea3-29888920880e",
                        "entry_id": "40b5a265-19d0-3adf-ae8c-678d35fe1d01",
                        "glosses": [
                            "Flexion (Beugung) der Verben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d545f2-e8f3-4c04-a757-c97b0c169097",
                                "sense_id": "a8d7333c-568a-3d53-aea3-29888920880e",
                                "text": "„Zugleich muss ich auf der dritten Ebene an bestimmte brenzlige Punkte der deutschen Grammatik denken, an den richtigen Artikel beispielsweise, an die ordnungsgemäße Deklination, an die korrekte Verbflexion, an die genaue Verbposition im Nebensatz.“"
                            },
                            {
                                "example_id": "c6a10566-3630-4bad-ac09-349f560404c1",
                                "sense_id": "a8d7333c-568a-3d53-aea3-29888920880e",
                                "text": "„Die Verbflexion fungiert dabei als oft und gern zelebriertes Paradebeispiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
