                "senses": [
                    {
                        "sense_id": "6cd8683b-48cd-345c-adbb-3842d618a599",
                        "entry_id": "5cb316a7-ca0d-3676-9df1-a111d68aa058",
                        "glosses": [
                            "превосх. ст. к прил. любопытный"
                        ],
                        "tags": [
                            "superlative"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f20057-8d9f-429a-9be1-d3ed1c3ecbdd",
                                "sense_id": "6cd8683b-48cd-345c-adbb-3842d618a599",
                                "text": "Разговорились, конечно, и об Египте. Любопытнейшая страна."
                            },
                            {
                                "example_id": "992b7d99-2a2f-4290-999d-f079ad6cd148",
                                "sense_id": "6cd8683b-48cd-345c-adbb-3842d618a599",
                                "text": "Он обегает вокруг Марса втрое скорее, чем сам Марс успевает обернуться вокруг своей оси, и отсюда вытекает любопытнейшее следствие: так как истинное движение спутника по небу с запада на восток быстрее, чем кажущееся обратное движение небесного свода, то для наблюдателя на Марсе эта луна восходит на западе и заходит на востоке!"
                            }
                        ]
                    }
                ],
