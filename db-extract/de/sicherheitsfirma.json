                "senses": [
                    {
                        "sense_id": "40ed0b8b-66bd-3bd6-b7ef-2b20b09d2db7",
                        "entry_id": "4d5f6c8b-328d-3ef2-8b33-5f4d14b111f9",
                        "glosses": [
                            "Firma, die Dienstleistungen im Bereich der Sicherung von Personen und Objekten anbietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0b92d3b-d90c-4818-a144-f50791ca927d",
                                "sense_id": "40ed0b8b-66bd-3bd6-b7ef-2b20b09d2db7",
                                "text": "„Der Mittvierziger hatte nach seinem Militärdienst eine Sicherheitsfirma an der Ostküste eröffnet, damit aber wenig Erfolg gehabt und den Laden wieder geschlossen.“"
                            },
                            {
                                "example_id": "7f1b0aa2-8068-496c-ae50-e523bba20108",
                                "sense_id": "40ed0b8b-66bd-3bd6-b7ef-2b20b09d2db7",
                                "text": "„Ich habe bei einer Sicherheitsfirma angeheuert.“"
                            },
                            {
                                "example_id": "6c8f2d68-1cb5-4953-977b-15f8cf68a058",
                                "sense_id": "40ed0b8b-66bd-3bd6-b7ef-2b20b09d2db7",
                                "text": "„›Sie sollten sich bei Ihrer Sicherheitsfirma beschweren.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
