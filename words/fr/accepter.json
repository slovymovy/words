{
    "word_family": [
        "acceptable",
        "inacceptable",
        "acceptation",
        "acceptabilité"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3efaf92b-3021-34ee-940a-a0d80d28bc5e",
                    "sense_definition": "Recevoir de bon gré ce qui est offert ou proposé (un cadeau, une invitation, une offre), ou consentir à ce qui est demandé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "acceptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'<w>accepte</w> volontiers ton invitation à dîner samedi soir."
                        },
                        {
                            "text": "Elle a <w>accepté</w> le cadeau avec un grand sourire."
                        },
                        {
                            "text": "Nous <w>acceptons</w> les paiements par carte dans notre magasin."
                        }
                    ],
                    "synonyms": [
                        "agréer"
                    ],
                    "antonyms": [
                        "refuser",
                        "décliner"
                    ],
                    "common_phrases": [
                        "accepter une invitation",
                        "accepter une offre",
                        "accepter un cadeau",
                        "accepter une proposition"
                    ]
                },
                {
                    "sense_id": "667b7498-bb91-3d71-8407-f2fec7602246",
                    "sense_definition": "Approuver une chose, la considérer comme juste, valable ou inévitable, et ne pas s'y opposer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a du mal à <w>accepter</w> que son équipe ait perdu le match."
                        },
                        {
                            "text": "Les scientifiques ont fini par <w>accepter</w> cette théorie après de nombreuses expériences."
                        }
                    ],
                    "synonyms": [
                        "approuver",
                        "admettre"
                    ],
                    "antonyms": [
                        "rejeter",
                        "refuser"
                    ],
                    "common_phrases": [
                        "accepter une théorie",
                        "accepter la situation",
                        "accepter une idée"
                    ]
                },
                {
                    "sense_id": "5d187440-cd42-362e-98db-4f7d882b460d",
                    "sense_definition": "Faire entrer une personne dans un groupe, une école ou un milieu, ou la reconnaître comme l'un de ses membres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après deux ans de prépa, elle a été <w>acceptée</w> dans une grande école."
                        },
                        {
                            "text": "Le club a <w>accepté</w> le nouveau joueur dans son équipe sans hésiter."
                        }
                    ],
                    "synonyms": [
                        "admettre",
                        "recevoir"
                    ],
                    "antonyms": [
                        "refuser",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "accepter un candidat",
                        "être accepté dans une école",
                        "accepter dans un groupe"
                    ]
                },
                {
                    "sense_id": "0929ae28-aa13-3040-829d-8a4947e81221",
                    "sense_definition": "En commerce, s'engager à payer un effet de commerce (une lettre de change, une traite) à son échéance.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour <w>accepter</w> une lettre de change, le tiré doit y apposer sa signature."
                        },
                        {
                            "text": "Le client a <w>accepté</w> la traite et s'est engagé à payer à l'échéance."
                        }
                    ],
                    "antonyms": [
                        "refuser"
                    ],
                    "common_phrases": [
                        "accepter une lettre de change",
                        "accepter une traite"
                    ]
                }
            ]
        }
    ]
}