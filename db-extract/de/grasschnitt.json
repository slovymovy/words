                ],
                "senses": [
                    {
                        "sense_id": "93a64bad-a193-3671-a4e6-33027f120416",
                        "entry_id": "61e6386d-9924-3e0b-8cd8-0a9fd2769887",
                        "glosses": [
                            "das Abmähen von Gras"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ed1232f-d0c4-4d77-a9ac-0253e562223f",
                                "sense_id": "93a64bad-a193-3671-a4e6-33027f120416",
                                "text": "Beim ersten Grasschnitt in diesem Jahr war die Mutter des Kitzes von einer Mähmaschine erfasst worden, das junge Reh aber konnte Elfriede Rasch retten."
                            },
                            {
                                "example_id": "a13b1e1c-791c-460d-9090-f11e01e5a957",
                                "sense_id": "93a64bad-a193-3671-a4e6-33027f120416",
                                "text": "Dass der von den Straßenmeistereien geplante Grasschnitt ausbleibt bzw. später als bisher angesetzt wird, sieht Karrer als Chance für das Verkümmern des Ragweeds."
                            },
                            {
                                "example_id": "dd84760d-3968-41b6-9439-e0f04d40868f",
                                "sense_id": "93a64bad-a193-3671-a4e6-33027f120416",
                                "text": "Mängel beim Grasschnitt sind ebenso wenig ein Grund zur Aufregung wie hie und da ein holpriges Grün."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f778ad7b-5b95-30f1-98f4-05ddeb048fbf",
                        "entry_id": "61e6386d-9924-3e0b-8cd8-0a9fd2769887",
                        "glosses": [
                            "abgemähtes Gras"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f7f2f8-12a8-464a-a535-46b082d1e8cd",
                                "sense_id": "f778ad7b-5b95-30f1-98f4-05ddeb048fbf",
                                "text": "Die Kombination aus strahlendem Sonnenschein und kräftigen Gewitterschauern sorgt für große Mengen an Grasschnitt, die ja nun irgendwie entsorgt werden müssen."
                            },
                            {
                                "example_id": "b839f500-9060-48f5-b08f-e0dce43773a6",
                                "sense_id": "f778ad7b-5b95-30f1-98f4-05ddeb048fbf",
                                "text": "Grasschnitt sollte nur angewelkt in die Biotonne gelangen. Der feine Rasenschnitt verklebt schnell, wird warm, fängt an zu stinken und wirkt wie eine luftundurchlässige Schicht."
                            },
                            {
                                "example_id": "13007090-fdc4-4996-b766-4f618000fbac",
                                "sense_id": "f778ad7b-5b95-30f1-98f4-05ddeb048fbf",
                                "text": "„Mulch wie getrockneter Grasschnitt, Stroh oder Rhabarberblätter halten die Feuchtigkeit besser im Boden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
