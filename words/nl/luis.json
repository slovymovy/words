                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Luis</w> die kat onmiddellijk, want hij krabt zich voortdurend.",
                            "target_lang_translations": {
                                "en": "<w>Delouse</w> that cat immediately, because it is scratching itself constantly.",
                                "ru": "<w>Выведи вшей</w> у этого кота немедленно, потому что он постоянно чешется.",
                                "fr": "<w>Épouille</w> ce chat immédiatement, car il se gratte constamment."
                            }
                        },
                        {
                            "text": "<w>Luis</w> hem erin als je de kans krijgt!",
                            "target_lang_translations": {
