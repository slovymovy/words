                        ],
                        "examples": [
                            {
                                "example_id": "79f6f4d6-a3c0-43b6-941f-f8e516d71a31",
                                "sense_id": "605cb864-15ce-3d6a-98b5-0eaa9bd917e9",
                                "text": "A partir du fural, Schiff d'abord, Wissell et Tollens, puis tout récemment Hurd, Garret et Osborne, préparent, par cette réaction, l’alcool furylique."
                            },
                            {
                                "example_id": "932a3bfa-3c8f-4057-94b5-7de91db77721",
                                "sense_id": "605cb864-15ce-3d6a-98b5-0eaa9bd917e9",
                                "text": "Le furfurol (furfural, fural) matière première des résines furaniques, est tiré du son, de certaines parties de l'épi de maïs, etc. C'est un aldéhyde dont on obtient par hydrogénation l’alcool furfurylique (furol)."
                            }
                        ]
                    }
