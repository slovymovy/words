                "senses": [
                    {
                        "sense_id": "c0427840-bb1c-34b1-9c3f-d37ab1cf6d7a",
                        "entry_id": "13c94bc0-69b1-3881-a9bc-0a8003a73f2f",
                        "glosses": [
                            "A Māori social gathering or assembly."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "db77b8a3-073c-4425-99ff-537b9a48aef7",
                                "sense_id": "c0427840-bb1c-34b1-9c3f-d37ab1cf6d7a",
                                "text": "[…] accounts of the proceedings of important huis at which Maori leaders took the initiative in discussing their educational and vocational needs […]."
                            },
                            {
                                "example_id": "195c67f5-ac8b-41a3-ad23-87860774f2fe",
                                "sense_id": "c0427840-bb1c-34b1-9c3f-d37ab1cf6d7a",
                                "text": "“I even started training as a seminarian. It lasted till I met Hana at an interchurch hui.”"
                            },
                            {
                                "example_id": "e5937826-51a0-4ebe-8b47-110c4caad213",
                                "sense_id": "c0427840-bb1c-34b1-9c3f-d37ab1cf6d7a",
                                "text": "[T]ribal leaders […] organised a series of hui in 1950 to celebrate the 600th anniversary of the arrival of the Great Fleet, which by this time had grown to nine canoes."
                            }
                        ]
                    },
                    {
                        "sense_id": "83e81a38-3ab1-3360-b02d-4aa26dc823c3",
                        "entry_id": "13c94bc0-69b1-3881-a9bc-0a8003a73f2f",
                        "glosses": [
                            "A meeting to discuss plans held by an organization, especially one that considers itself progressive."
                        ],
                        "tags": [
                            "New-Zealand",
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "dfa7a32f-1f3b-4948-a7ee-adfead3e97df",
                                "sense_id": "83e81a38-3ab1-3360-b02d-4aa26dc823c3",
                                "text": "Shelley's document hadn't mentioned the billionaire at all, and although Mira had said at the hui that Lemoine used the airstrip frequently, she'd seemed to suggest that the farm was his destination, not his point of departure, which would imply that he was living somewhere else."
                            }
                        ]
                    }
                ],
