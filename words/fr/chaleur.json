                        "vague de chaleur",
                        "coup de chaleur"
                    ]
                },
                {
                    "sense_id": "b658f93b-3410-33e9-89ca-33979c51b56f",
                    "sense_definition": "Sentiment d'ardeur, d'enthousiasme, de vivacité ou de cordialité bienveillante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a accueilli ses nouveaux voisins avec beaucoup de <w>chaleur</w> et de gentillesse."
                        },
                        {
                            "text": "L'avocat a défendu son client avec une grande <w>chaleur</w> devant le tribunal."
