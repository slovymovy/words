                    },
                    {
                        "translation_id": "82612e8d-4597-4205-88b3-cd6312a61401",
                        "source_entry_id": "9110023b-8a40-33d8-a780-35886f0fa836",
                        "source_sense_description": "музыкальный инструмент",
                        "target_lang_word": "Nabla",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nabla",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bc4874-d093-3cfe-b8fd-fee3831406f4",
                                        "entry_id": "fd162a05-1fa9-3870-8bf6-8ac107b0a61f",
                                        "glosses": [
                                            "dreieckiges Symbol, das dem umgedrehten griechischen Buchstaben Delta (Δ) ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3b5e65-0e58-4272-ba6f-baa0d35837dc",
                                                "sense_id": "f8bc4874-d093-3cfe-b8fd-fee3831406f4",
                                                "text": "„Das Dreieck mit der Spitze nach unten ist der dreidimensionale Ableitungsoperator und heißt Nabla.“"
                                            },
                                            {
                                                "example_id": "734057e4-968b-446a-8edb-dc545e93abbb",
                                                "sense_id": "f8bc4874-d093-3cfe-b8fd-fee3831406f4",
                                                "text": "„Bei der Einführung des Nabla in die Vektorenrechnung ist diese Vereinbarung auf die skalaren und vektoriellen Produkte übertragen worden, in welche Nabla als Faktor eingeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Nabla",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                        "entry_id": "728aac8a-f144-3583-a713-a7289c7cf65d",
                                        "glosses": [
                                            "im Altertum verwendetes Saiteninstrument, das wahrscheinlich der Harfe ähnlich war"
                                        ],
                                        "tags": [
                                            "historical",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5f3b083-dc61-430a-9c03-951fb1184231",
                                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                                "text": "„Nach Clemens Alexandrinus und Eusebios war die Nabla eine Erfindung der Kappadoker, nach Athenaios war sie eine Erfindung der Phönizier.“"
                                            },
                                            {
                                                "example_id": "7ef630ba-02ec-42e3-abc9-ab0eaf40ccad",
                                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                                "text": "„Dazu stimmt vor allem die Angabe der Kirchenväter, daß bei der Nabla der Resonanzkörper oben gewesen sei (s. o.).“"
                                            },
                                            {
                                                "example_id": "9cb39cdb-692d-4209-a462-64ab3b190341",
                                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                                "text": "„Auch Euphorion in Tepi Ploduiwy (Athen. IV. 182) betont, daß die Spieler der Nabla, Pandura und Sambyke durchaus nicht neuere Instrumente spielen […]“"
                                            },
                                            {
                                                "example_id": "d4c8dc62-1ce7-445b-9961-49bf6293bfa8",
                                                "sense_id": "3ff3b2d0-2551-39b6-b5b0-55027767926d",
                                                "text": "„Mag das Wort Amby was immer bedeuten (und am allerwenigsten kann es ‚Jungfrauen‘ bedeuten), so kann es hier nur die Bedeutung eines Instrumentes, d. h. eines eigenen Nabla haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
