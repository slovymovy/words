{
    "word_family": [
        "repute",
        "reputable",
        "reputation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e57fb013-d1df-35ec-a638-f6167c6134a5",
                    "sense_definition": "A state of having a bad reputation or being held in low regard.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The once famous restaurant has fallen into <w>disrepute</w> due to poor service and bad food.",
                            "target_lang_translations": {
                                "ru": "Когда-то знаменитый ресторан приобрел <w>дурную славу</w> из-за плохого обслуживания и невкусной еды."
                            }
                        },
                        {
                            "text": "Scientific theories that fail to provide evidence often fall into <w>disrepute</w> among experts.",
                            "target_lang_translations": {
                                "ru": "Научные теории, не подкрепленные доказательствами, часто теряют авторитет и приобретают <w>сомнительную репутацию</w> среди экспертов."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "dishonour",
                        "infamy",
                        "notoriety"
                    ],
                    "antonyms": [
                        "credit",
                        "distinction",
                        "esteem",
                        "renown",
                        "repute"
                    ],
                    "common_phrases": [
                        "fall into disrepute",
                        "bring into disrepute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором кто-либо или что-либо имеет плохую репутацию или не пользуется уважением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурна́я сла́ва",
                                "target_lang_sense_clarification": "общее состояние плохой известности"
                            },
                            {
                                "target_lang_word": "плоха́я репута́ция",
                                "target_lang_sense_clarification": "негативное мнение окружающих"
                            },
                            {
                                "target_lang_word": "сомни́тельная репута́ция",
                                "target_lang_sense_clarification": "репутация, вызывающая недоверие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1f973f8-7cc5-3c4c-b1ee-3a0f60aaf563",
                    "sense_definition": "To cause someone or something to lose their good reputation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal threatened to <w>disrepute</w> the entire organization in the eyes of the public.",
                            "target_lang_translations": {
                                "ru": "Скандал грозил <w>дискредитировать</w> всю организацию в глазах общественности."
                            }
                        },
                        {
                            "text": "His reckless actions served only to <w>disrepute</w> his family name.",
                            "target_lang_translations": {
                                "ru": "Его безрассудные поступки лишь <w>опорочили</w> имя его семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "disgrace",
                        "dishonour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать кого-либо или что-либо доброго имени, порочить репутацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поро́чить",
                                "target_lang_sense_clarification": "наносить ущерб чьей-либо репутации"
                            },
                            {
                                "target_lang_word": "дискредити́ровать",
                                "target_lang_sense_clarification": "подрывать доверие или авторитет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}