                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The courthouse in <w>Bison</w> serves all of Perkins County.",
                            "target_lang_translations": {
                                "pl": "Gmach sądu w <w>Bison</w> obsługuje całe hrabstwo Perkins."
                            }
                        },
                        {
                            "text": "He moved to <w>Bison</w> to take a job with the local government.",
                            "target_lang_translations": {
