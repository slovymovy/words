                "senses": [
                    {
                        "sense_id": "6d8f4464-ae07-3f34-a38a-a242f4b6e37c",
                        "entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "glosses": [
                            "Doctrine of preordination; doctrine of absolute decrees; doctrine that God acts in an absolute manner."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3935668e-743d-3518-a9c4-8d2d4e25bb7b",
                        "entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "glosses": [
                            "The principles or practice of absolute or arbitrary government; Synonym of despotism."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2793fe3a-ed93-42f0-bb03-a0dff407b285",
                                "sense_id": "3935668e-743d-3518-a9c4-8d2d4e25bb7b",
                                "text": "The element of absolutism and prelacy was more controlling in the counsels of the rival corporation."
                            },
                            {
                                "example_id": "bb4ed5e6-1c15-4fc2-815e-969b99d21757",
                                "sense_id": "3935668e-743d-3518-a9c4-8d2d4e25bb7b",
                                "text": "As absolutism became more consolidated in Europe, and particularly in France, such nonabsolutist states tended to define themselves in opposition to their absolutist rivals: hence, those features of their government which differed from absolutism tended to be given special prominence."
                            }
                        ]
                    },
                    {
                        "sense_id": "f77de9d6-3910-326c-adf5-d1cca2adc7e4",
                        "entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "glosses": [
                            "Belief in a metaphysical absolute; belief in Absolute."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ed8d3c07-79d6-3e17-a12a-79b58635f839",
                        "entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "glosses": [
                            "Positiveness; the state of being absolute."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "31dddcee-7365-37a7-b427-1aed7b20e108",
                        "entry_id": "416f7c03-5ec0-3f71-8412-0a440796a2bd",
                        "glosses": [
                            "The characteristic of being absolute in nature or scope; absoluteness."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "675bf3a1-ba97-4ce7-b3e2-4b2b374e32d3",
                                "sense_id": "31dddcee-7365-37a7-b427-1aed7b20e108",
                                "text": "It was the absolutism of his ambition to be a perfect writer (and perhaps also the perfect son) that imperiled him."
                            }
                        ]
                    }
                ],
