                        "source_sense_id": "a3defe97-85fb-3e9a-b1b9-d6f83bbbc42c",
                        "source_sense_description": "weibliche Person, die im Gericht die Anklage vertritt",
                        "target_lang_word": "prosecutor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
