                        "form": "more grimly"
                    },
                    {
                        "form_id": "c92370c0-ec93-4c3e-9567-4a90c71f11dc",
                        "entry_id": "649e425d-f6a5-3320-aad9-a75161ca7a2f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most grimly"
