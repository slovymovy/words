    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f7d2422d-c687-383a-8820-893b2fbcc172",
                    "sense_definition": "A small horse; specifically, any of several small breeds of horse under 14.2 hands at the withers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to go for a ride on the <w>pony</w>.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге от поездки на <w>пони</w>.",
                                "zh": "孩子们很兴奋能去骑<w>小马</w>。"
                            }
                        },
                        {
                            "text": "She keeps a Shetland <w>pony</w> in the paddock behind her house.",
                            "target_lang_translations": {
                                "ru": "Она держит шетлендского <w>пони</w> в загоне за домом.",
                                "zh": "她在屋后的围场里养了一匹设得兰<w>矮种马</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Shetland pony",
                        "ride a pony",
                        "pony club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая лошадь; конкретно, любая из нескольких низкорослых пород лошадей (ниже 147 см в холке).",
                        "zh": "一种小型马；特指几种肩高低于14.2掌（约147厘米）的马种。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пони",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小马",
                                "target_lang_sense_clarification": "动物"
                            },
                            {
                                "target_lang_word": "矮种马",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32a6c7b7-a089-3f2f-bc27-a95b88389376",
                    "sense_definition": "A ponytail hairstyle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pulled her hair back into a messy <w>pony</w> before going to the gym.",
                            "target_lang_translations": {
                                "ru": "Она собрала волосы в небрежный <w>хвост</w> перед походом в спортзал.",
                                "zh": "去健身房前，她把头发扎成了一个凌乱的<w>马尾</w>。"
                            }
                        },
                        {
                            "text": "I usually wear a high <w>pony</w> when the weather is hot.",
                            "target_lang_translations": {
                                "ru": "Я обычно ношу высокий <w>хвост</w>, когда на улице жарко.",
                                "zh": "天气热的时候，我通常会扎一个高<w>马尾</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high pony",
                        "side pony"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of ponytail"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прическа, при которой волосы собраны сзади и стянуты резинкой.",
                        "zh": "马尾辫发型。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "прическа"
                            },
                            {
                                "target_lang_word": "конский хвост",
                                "target_lang_sense_clarification": "прическа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马尾",
                                "target_lang_sense_clarification": "发型"
                            },
                            {
                                "target_lang_word": "马尾辫",
                                "target_lang_sense_clarification": "发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7af559-38e5-355b-8f16-a22b407eefae",
                    "sense_definition": "Twenty-five pounds (money).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He still owes me a <w>pony</w> for the ticket I bought him.",
                            "target_lang_translations": {
                                "ru": "Он все еще должен мне <w>двадцать пять фунтов</w> за билет, который я ему купил.",
                                "zh": "我帮他买的票，他现在还欠我<w>二十五英镑</w>。"
                            }
                        },
                        {
                            "text": "The repair job will cost you a <w>pony</w> at least.",
                            "target_lang_translations": {
                                "ru": "Ремонт обойдется тебе по меньшей мере в <w>двадцать пять фунтов</w>.",
                                "zh": "修理费至少要花你<w>二十五英镑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "owe a pony"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "British"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двадцать пять фунтов стерлингов (британский сленг).",
                        "zh": "二十五英镑（英国俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "двадцать пять фунтов",
                                "target_lang_sense_clarification": "сумма денег"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "二十五英镑",
                                "target_lang_sense_clarification": "金额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1990ef51-ca42-321e-afe0-9105bc2d24b4",
                    "sense_definition": "One horsepower.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This classic car has over three hundred <w>ponies</w> under the hood.",
                            "target_lang_translations": {
                                "ru": "У этого классического автомобиля под капотом более трехсот <w>лошадок</w>.",
                                "zh": "这辆经典款汽车引擎盖下有超过三百<w>马力</w>。"
                            }
                        },
                        {
                            "text": "We need to squeeze a few more <w>ponies</w> out of this engine.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выжать еще несколько <w>лошадиных сил</w> из этого двигателя.",
                                "zh": "我们需要从这台引擎里再压榨出几<w>马力</w>来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "automotive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна лошадиная сила (автомобильный сленг).",
                        "zh": "一马力（汽车俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лошадка",
                                "target_lang_sense_clarification": "лошадиная сила (сленг)"
                            },
                            {
                                "target_lang_word": "лошадиная сила",
                                "target_lang_sense_clarification": "единица мощности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马力",
                                "target_lang_sense_clarification": "功率单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e94a2d90-b1be-3a54-b916-60131f97fdc8",
                    "sense_definition": "A small serving of an alcoholic beverage, especially beer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man sat at the bar nursing a <w>pony</w> of ale.",
                            "target_lang_translations": {
                                "ru": "Старик сидел у барной стойки, потягивая <w>маленькую порцию</w> эля.",
                                "zh": "老人坐在吧台边，慢慢喝着一<w>小杯</w>艾尔啤酒。"
                            }
                        },
                        {
                            "text": "I will just have a <w>pony</w>, as I am driving later.",
                            "target_lang_translations": {
                                "ru": "Я выпью только <w>маленькую рюмку</w>, так как мне потом за руль.",
                                "zh": "我只喝一<w>小杯</w>，因为待会儿还要开车。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia/UK"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая порция алкогольного напитка, особенно пива.",
                        "zh": "小份的酒精饮料，尤指啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маленькая рюмка",
                                "target_lang_sense_clarification": "мера напитка"
                            },
