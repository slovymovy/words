                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36778e7a-5dad-42b9-aaf4-4bb574c4ab71",
                                                "sense_id": "fe084abb-e427-3ba0-91f7-382a00603ce5",
                                                "text": "Enfermées dans le terem, gynécée tatar ou byzantin, les tsarines et les tsarevnas laissaient les tsars à la grossièreté de leur sexe. La Moscovie n’eut ni châteaux ni palais ; le Kremlin n’était qu’une forteresse et un couvent, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "925e96c0-04d1-4998-beb2-405334d9e399",
                        "source_entry_id": "74857f95-fb01-34f1-a25c-a217de8e1186",
                        "source_sense_description": "Grand Duchy of Moscow",
                        "target_lang_word": "Moskau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moskau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c022022e-3f4f-3686-839e-34278b77578a",
                                        "entry_id": "c2bb84ac-8e59-396a-b4d3-b271d0fce6a9",
                                        "glosses": [
                                            "Stadt, Hauptstadt der Russischen Föderation (Russland), zugleich eine Oblast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9cbf674-dad9-442d-8b70-ce48a8521f43",
                                                "sense_id": "c022022e-3f4f-3686-839e-34278b77578a",
                                                "text": "Moskau liegt am Fluss Moskwa."
                                            },
                                            {
                                                "example_id": "a5b5d612-560f-4f1a-b338-c01390e40132",
                                                "sense_id": "c022022e-3f4f-3686-839e-34278b77578a",
                                                "text": "„Nun war er wieder in Moskau. Und obwohl ihm die Stadt noch nie so dreckig, so roh, so anstrengend erschienen war wie bei diesem Besuch – die langen Wege, die Betrunkenen, die allgegenwärtigen ‹Diensthabenden› mit ihren griesgrämigen Gesichtern, sogar die berühmte Metro, auf die er immer so stolz gewesen war, weil er als junger Mann bei Subbotniks an ihrem Bau teilgenommen hatte, alles war ihm auf die Nerven gegangen: die Enge, der Lärm, das guillotineartige Zuschnappen der automatischen Türen (…); auf dem Roten Platz war ihm der Fotoapparat aus der Hand gefallen, und auf dem Nowodewitschi-Friedhof, dem er aus Pflichtgefühl einen Besuch abstattete, weil er einmal mit Irina dort gewesen war, um sich vor den Gräbern Tschechows und Majakowskis zu verneigen, hatte ihn ein kalter Regen erwischt, ein Aprilregen, wie es ihn nur in Moskau gab, imstande, einen Menschen zu töten – obwohl das alles unangenehm und abstoßend gewesen war, konnte er nicht leugnen, Genugtuung empfunden zu haben über die Hochachtung, die man ihm nun, nach zehn Jahren, plötzlich in diesem Land entgegenbrachte: dem Exsträfling, dem ‹Auf ewig Verbannten›.“"
                                            },
                                            {
                                                "example_id": "8b24483b-04ba-45c2-be6a-144640fada9b",
                                                "sense_id": "c022022e-3f4f-3686-839e-34278b77578a",
                                                "text": "„Sie bat die Gräfin, Nikolai zu einer Fahrt nach Moskau zu veranlassen.“"
                                            },
                                            {
                                                "example_id": "aabe8342-f53a-4a81-8b6f-817d465c5a78",
                                                "sense_id": "c022022e-3f4f-3686-839e-34278b77578a",
                                                "text": "„Als die neue Geheimdienstzentrale am nordwestlichen Stadtrand Moskaus 2006 eingeweiht wurde, landete Putin mit einem Hubschrauber auf einem Heliport, der das Dach des Hauptquartiers krönt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
