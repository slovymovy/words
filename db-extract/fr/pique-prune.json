                            "plural"
                        ],
                        "form": "pique-prunes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1e64284-b9db-32ef-9757-6a67cb118fa9",
                        "entry_id": "57f54465-3ac7-3bcc-9586-7f1bff849eba",
                        "glosses": [
                            "Insecte de la famille des cétoines, également dénommé scarabée pique-prune ou plus rarement barbot (Osmoderma eremita)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3ab6b3e-fa9c-4437-add0-c84f0332d404",
                                "sense_id": "a1e64284-b9db-32ef-9757-6a67cb118fa9",
                                "text": "Il est rare que les phéromones sexuelles d'un insecte soient perçues aussi nettement par l'odorat humain que celles du pique-prune. Par ailleurs, alors que le message sexuel vient généralement des femelles, ici c'est le mâle qui attire la femelle."
                            },
                            {
                                "example_id": "af9ed703-8a79-4661-a573-3efc56f56b33",
                                "sense_id": "a1e64284-b9db-32ef-9757-6a67cb118fa9",
                                "text": "Les larves de pique-prunes sont saproxylophages : elles consomment le bois mort peu attaqué par les champignons et les bactéries. Leur développement demande de 2 à 4 ans"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c9e6d8a-61e8-48bb-ba8b-836fba5daa2c",
                        "source_entry_id": "57f54465-3ac7-3bcc-9586-7f1bff849eba",
                        "source_sense_id": "a1e64284-b9db-32ef-9757-6a67cb118fa9",
                        "target_lang_word": "Eremit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eremit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "in Zurückgezogenheit lebender Mann (zum Beispiel aus religiöser Überzeugung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "025662d5-ec63-4bbd-9f19-f458542696df",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "Nicht alle Eremiten haben sich aus religiösen Gründen für ein Leben in Abgeschiedenheit entschieden."
                                            },
                                            {
                                                "example_id": "946db05e-05d8-4147-98be-4cff5d18c96a",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„1573 hatte sich der Eremit Claus Scheffer am Rande der Nuenhagener Wüstung niedergelassen.“"
                                            },
                                            {
                                                "example_id": "eea747de-1d52-4231-92a8-18c21edef9b4",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Endlich erblickte ich in der Ferne eine gotische Kapelle mit einer Hütte, die die Klause eines Eremiten zu sein schien.“"
                                            },
                                            {
                                                "example_id": "eeb390ff-9b8d-4afe-8bc2-3a70c44af328",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Zum gottgefälligen Büßerleben zogen sich Eremiten, Klausner und Inklusen in die Waldeinsamkeit zurück und lebten dort in Höhlen oder Hütten, vom Volk mit schaudernder Ehrfurcht bestaunt.“"
                                            },
                                            {
                                                "example_id": "fa9da3af-67d5-414a-8436-b5d040c1e38b",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die ernste, eindringliche Warnung des heiligen Eremiten, die so voll Vernunft war, hatte Eingang nicht nur in seine Ohrmuschel, sondern auch in seinen Verstand und sein Herz gefunden und sein Gewissen wachgerüttelt.“"
                                            },
                                            {
                                                "example_id": "d4c49fea-2d00-4cc7-9206-7744ffc90e65",
                                                "sense_id": "665ba93d-7a17-366b-8d22-d8005f43c50f",
                                                "text": "„Die frühen Asketen hatten auch Kontakte mit christlichen Eremiten im Irak und in Syrien, und es gab einen gewissen Austausch zwischen den beiden Gruppen, die gleichermaßen von der Vergänglichkeit und Nutzlosigkeit aller irdischen Freuden wussten und nur Gott ersehnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                        "entry_id": "f6352f79-1ace-3163-89ba-a5e633ba22e3",
                                        "glosses": [
                                            "seltener Käfer der Art Osmoderma eremita aus der Familie der Rosenkäfer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53634d08-be47-4ff7-a7be-6ed012457470",
                                                "sense_id": "541a4ee7-616e-37cf-89a9-44a76400ad87",
                                                "text": "Eremiten leben in Baumhöhlen, vor allem an Eichen, die sie oft ihr Leben lang nicht verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7623fb0-1291-4dcc-92ee-98e7a66579e3",
                        "source_entry_id": "57f54465-3ac7-3bcc-9586-7f1bff849eba",
                        "source_sense_id": "a1e64284-b9db-32ef-9757-6a67cb118fa9",
                        "target_lang_word": "Juchtenkäfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juchtenkäfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efaa01c7-7090-3f14-8214-5a53ece6a1f4",
                                        "entry_id": "d063aabe-2bbc-386a-99c8-8af298ad1b70",
                                        "glosses": [
                                            "seltener Käfer aus der Familie der Rosenkäfer"
                                        ],
                                        "tags": [
                                            "speziell Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd77202-bdf3-4965-9ad7-49ae6760bf6e",
                                                "sense_id": "efaa01c7-7090-3f14-8214-5a53ece6a1f4",
                                                "text": "Der Juchtenkäfer verbringt oft sein ganzes Leben in einer einzigen Baumhöhle."
                                            },
                                            {
                                                "example_id": "ad7701d6-cf24-4bd7-a0e4-765b953b1368",
                                                "sense_id": "efaa01c7-7090-3f14-8214-5a53ece6a1f4",
                                                "text": "„Als ich im Herbst 2010 ein Gastspiel in Stuttgart gab, drückte mir eine ältere Dame auf dem Bahnhofsvorplatz ein Fähnchen in die Hand und versuchte mich davon zu überzeugen, für den Juchtenkäfer zu demonstrieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
