                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226dec6c-a183-4bf6-b10d-e372ddcf34fb",
                                                "sense_id": "e6b8f2a5-d848-3b6e-92bd-9414a236e847",
                                                "text": "Der isländische Eyjafjallajökull dagegen ist ein Feuerberg vom Typus Ejektion, also \"Auswurf\". Er speit magmatisches Material, also geschmolzene Gesteine, dazu Gase und Wasserdampf."
                                            },
                                            {
                                                "example_id": "8a295f99-92e0-4879-884c-7c33bd96e75b",
                                                "sense_id": "e6b8f2a5-d848-3b6e-92bd-9414a236e847",
                                                "text": "Magma, magmatische Materie muß nahe an die Oberfläche dringen, um die nötige Hitze zu schüren."
                                            },
                                            {
                                                "example_id": "0c39e86c-08c4-4f26-827c-cabdf9bed0a4",
                                                "sense_id": "e6b8f2a5-d848-3b6e-92bd-9414a236e847",
                                                "text": "Seit das magmatische Ausgangsmaterial aus zahlreichen Vulkanen und Rissen in der Erdkruste an die Oberfläche gesickert ist, haben sich über den Basaltdecken mehr als 200 Meter dicke, feinkörnige Sedimentschichten aufgetürmt."
                                            },
                                            {
                                                "example_id": "61fa0c6d-9f1a-4f1d-8b64-21d52f6b6eab",
                                                "sense_id": "e6b8f2a5-d848-3b6e-92bd-9414a236e847",
                                                "text": "An dieser Oberfläche (sie wird durch den Dichte-Unterschied zwischen Eisen und Gestein bestimmt) treffen die obersten Bereiche der eisernen Konvektionsströme auf die untersten Ausläufer der magmatischen Kreisläufe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
