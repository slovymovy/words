                                        "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                        "entry_id": "864f6d6b-7b72-3d3b-8ea5-50cd3945b837",
                                        "glosses": [
                                            "The state of being stubborn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaf384cd-7809-415a-aabb-b9dbbb274f55",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "[H]appy is your Grace / That can tranſlate the ſtubbornneſſe of fortune / Into ſo quiet and ſo ſweet a ſtile."
                                            },
                                            {
                                                "example_id": "3b38afaf-cca1-481b-b6fc-909e6574e7e6",
                                                "sense_id": "d87cb368-7f14-36b9-96a0-6d5f0161ea32",
                                                "text": "Brant Rios and Eos Parish have been dating five years and experienced their state’s stubbornness firsthand Friday when they were the first couple to arrive at the Ouachita Parish Courthouse to be wed – and were the first to be turned away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b370f769-6046-4990-ae12-712114e9050c",
                        "source_entry_id": "ba59cf12-a310-3c67-a72f-a5867bc6f273",
                        "source_sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                        "source_sense_description": "hartnäckiges Beharren auf einer Meinung oder Absicht (ohne den Rat anderer anzunehmen)",
                        "target_lang_word": "entêtement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entêtement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                                        "glosses": [
                                            "Attachement opiniâtre d’une personne à ses opinions, à ses goûts, à ses vues, à ses projets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a3111a-bf9a-4bfd-8755-dc21fb456da3",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Il était d’un entêtement de brute ; devant une volonté étrangère, nettement formulée, il se serait emporté grossièrement jusqu’à battre les gens."
                                            },
                                            {
                                                "example_id": "be9aa9d9-358d-41d4-8b6e-2d5650f95d57",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Sur le même ton caustique, elle décrivait ses trois mariages soldés par deux divorces et un veuvage, son entêtement obsessionnel pour racheter sa bastide, mais aussi ses souvenirs de jeunesse à l’époque des gemmeurs et de la splendeur des Nogaro."
                                            },
                                            {
                                                "example_id": "08f60b9f-6831-4b0e-bbcb-76c7dc2d9a58",
                                                "sense_id": "cb71e8e9-4012-34f7-9de9-0e07cbc655db",
                                                "text": "Une nouvelle trajectoire budgétaire « crédible » doit être présentée en septembre à la Commission européenne, qui a ouvert une procédure de déficit excessif visant la France, l’entêtement des gouvernements macronistes à ne pas augmenter les impôts ayant conduit à un dérapage des finances publiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                        "entry_id": "7dc0c5be-d236-3477-979f-c1f7c0759e1f",
                                        "glosses": [
                                            "Engouement pour une personne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5e96f9-af16-4bfc-ae60-791cbc17b22e",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Il a un grand entêtement pour cette femme."
                                            },
                                            {
                                                "example_id": "1f776b7b-cc35-4588-8571-a0f45a1e4fb4",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Rien ne la lasse, elle tient bon ! Je le lui dis, ce n’est pas de l’amour, c’est de l’entêtement."
                                            },
                                            {
                                                "example_id": "72e15f3a-3911-4184-9ce9-0b27e7a48653",
                                                "sense_id": "1a049cfd-187f-3c68-89cb-d8ad4bae28b6",
                                                "text": "Maintes fois tu m’as blessée en entretenant Juliette ou Abel de ce qui eût dû rester entre toi et moi, et c’est bien là ce qui, longtemps avant que tu t’en doutes, m’a fait penser que ton amour était surtout un amour de tête, un bel entêtement intellectuel de tendresse et de fidélité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0b3f724-db38-474e-a11f-81f019ccd61d",
                        "source_entry_id": "ba59cf12-a310-3c67-a72f-a5867bc6f273",
                        "source_sense_id": "3d064fef-f180-3373-958c-c70f9c57e3c2",
                        "source_sense_description": "hartnäckiges Beharren auf einer Meinung oder Absicht (ohne den Rat anderer anzunehmen)",
                        "target_lang_word": "obstination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Action de s’obstiner, de s’attacher opiniâtrement à une idée, à un sentiment, à une entreprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972d2eb0-447b-422f-b6d2-0b1f16a0be5c",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Me voilà donc partagé entre travail et amusement, une vie de patachon qui inquiète maman, tandis qu'Alphonse est surtout embarrassé par mon obstination à vouloir embrasser une carrière d'artiste."
                                            },
                                            {
                                                "example_id": "aff67e05-7b30-4dd6-962b-537919578aea",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Bert, avec l’obstination convulsive de l’instinct, s’étaya contre les parois, jusqu’à ce que le ballon piquât du nez."
                                            },
                                            {
                                                "example_id": "5be05d1d-d382-460d-928b-389a81431b76",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Tout vous révèle qu’entre Le Havre et Rouen se poursuit avec obstination la création d’une zone où, inévitablement, le colossal et l’extraordinaire sont en genèse."
                                            },
                                            {
                                                "example_id": "dde59327-a008-4bf0-a59d-4be24a1c2d72",
                                                "sense_id": "bb9ce751-83a6-3bc0-900d-760d115b7dc7",
                                                "text": "Il était célèbre par une obstination admirable à apprendre à écrire et à lire ; le résultat ne fut pas étonnant ; il faut croire qu’il est bien difficile d'apprendre à lire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                        "entry_id": "53862eac-edb4-38d1-ae91-e53900b8f2df",
                                        "glosses": [
                                            "Qualité de celui qui est obstiné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ce6648-3fbc-43f5-a51e-a5aa281e99bd",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Il lui a fallu beaucoup d’obstination pour réussir dans son examen."
                                            },
                                            {
                                                "example_id": "e78b43aa-b59a-4477-afdd-a974f29de28b",
                                                "sense_id": "f222c879-2cd0-332c-8af3-335957ac22bd",
                                                "text": "Obstination au travail, à l’étude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
