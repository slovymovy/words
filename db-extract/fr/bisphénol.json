                ],
                "senses": [
                    {
                        "sense_id": "68a7ecff-b033-34c7-ad61-c94d7514bfc5",
                        "entry_id": "69244482-e313-3b42-8e48-295113320f1c",
                        "glosses": [
                            "Composé chimique portant deux groupes phénol, généralement liés par un pont méthyle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ef9457-ec68-4797-91e4-0a9c7e298a6b",
                                "sense_id": "68a7ecff-b033-34c7-ad61-c94d7514bfc5",
                                "text": "Les substances toxiques telles que les phtalates et les bisphénols qui diffusent à partir des emballages plastiques surtout s’ils ont été soumis à la chaleur."
                            },
                            {
                                "example_id": "f5a60bac-1747-4797-be0c-ea561a48c398",
                                "sense_id": "68a7ecff-b033-34c7-ad61-c94d7514bfc5",
                                "text": "La préparation du polycarbonate est faite par polycondensation, principalement à partir d’un bisphénol sur un phosgène avec dégagement d’acide chlorhydrique."
                            },
                            {
                                "example_id": "b2056d64-d075-42be-98d2-8625a7f4e2f9",
                                "sense_id": "68a7ecff-b033-34c7-ad61-c94d7514bfc5",
                                "text": "Comme d’autres publications antérieures, celle-ci indique que les garçons ayant été exposés in utero à des taux élevés de bisphénol A ont un risque accru de développer un syndrome autistique, mais les chercheurs sont cette fois parvenus à mettre en lumière un mécanisme biologique susceptible d’élucider l’un des modes d’action du BPA sur le cerveau en développement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c434236c-113b-4520-a44b-cf3954264198",
                        "source_entry_id": "69244482-e313-3b42-8e48-295113320f1c",
                        "source_sense_id": "68a7ecff-b033-34c7-ad61-c94d7514bfc5",
