                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd0b8ec-e823-41c6-bc99-1a3f5f1281be",
                                "sense_id": "fd7a0869-40b8-36f8-9a2d-d6c2243c9f98",
                                "text": "Ce Grec, natif des environs de l’Arta, qui se coucha sous la roue du carrosse du visir, afin qu’il n’éprouvât pas de secousse, eut pour récompense, la pension d’une oque (deux livres et demie) de pain par jour, sa vie durant."
                            }
                        ]
                    },
                    {
                        "sense_id": "51c3837a-8a15-36e8-945c-42e234497b92",
                        "entry_id": "f11b9cd9-aab8-37f7-b8c2-431e6d00c658",
                        "glosses": [
                            "Ancienne mesure ottomane de la masse, valant environ 1 280 grammes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "026929e0-7e3b-3008-a565-0958b9c3d229",
                        "entry_id": "f11b9cd9-aab8-37f7-b8c2-431e6d00c658",
                        "glosses": [
                            "Mesure usuelle des volumes de liquides alimentaires en Grèce, qui valait environ 1,33 litre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5364ecd3-2d9f-43ad-813a-d920cbfcf1fe",
                                "sense_id": "026929e0-7e3b-3008-a565-0958b9c3d229",
                                "text": "La production du vin de l'Olympe varie de 40,000 à 60,000 oques par an ; 50 oques donnent 84 bouteilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff576944-a398-3533-b11f-69d8d90902f2",
                        "entry_id": "f11b9cd9-aab8-37f7-b8c2-431e6d00c658",
                        "glosses": [
                            "Récipient de cette contenance."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
