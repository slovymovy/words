                    },
                    {
                        "translation_id": "efb36122-6dbc-4a21-9b50-a5df0ba130f5",
                        "source_entry_id": "1a66d947-ec69-38fe-8c70-d068c7263999",
                        "source_sense_id": "47b5f41d-ddc4-3492-90d3-601b983909f7",
                        "target_lang_word": "instamment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instamment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                        "entry_id": "8ce52479-c53c-32d1-a378-b2995552a500",
                                        "glosses": [
                                            "D’une manière instante ou pressante ; avec instance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9681ac54-269f-46bb-a1e3-dd785399cff7",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Je demande si instamment à Dieu qu’il ne t’arrive aucun mal."
                                            },
                                            {
                                                "example_id": "2bf18b04-5619-47e3-a79a-a021b5f9058f",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Oh ! Madame, si vous êtes si instamment attendue, permettez-moi de m’éloigner, car il me serait impossible de vous parler en ce moment."
                                            },
                                            {
                                                "example_id": "69f85a99-ddfe-45a0-aa99-e186bafb7864",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "Cette constatation faite, nous n'en avons pas moins à compter avec la nombreuse cohorte des névropathes vraiment insomniaques, qui souffrent de ne pas dormir, et qui prient instamment que le sommeil leur soit rendu."
                                            },
                                            {
                                                "example_id": "487c109a-7b94-45a7-8772-21d437cd6e19",
                                                "sense_id": "136711c7-4cc1-3402-9d99-b4d370443d30",
                                                "text": "— Édith vous prie de bien vouloir descendre un instant dans sa chambre. Rien qu’un instant. Elle vous en prie instamment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37286a4e-9c73-464c-b1b4-1946d02a98b8",
                        "source_entry_id": "1a66d947-ec69-38fe-8c70-d068c7263999",
                        "source_sense_id": "47b5f41d-ddc4-3492-90d3-601b983909f7",
                        "target_lang_word": "obstinément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstinément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                        "entry_id": "66a8e28d-ae98-3def-aa8c-c1992f1f0a8e",
                                        "glosses": [
                                            "Avec obstination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4afccc-d60e-4fa8-a425-e41859a43e62",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Sa femme s’étant obstinément refusée à céder à ses injonctions, il se résigna de fort méchante humeur à vaquer à ses travaux quotidiens dans la ferme ; […]."
                                            },
                                            {
                                                "example_id": "ea7eb16f-ef17-4ffb-b25d-acda6da6feb1",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Et bien que tout mon cœur obstinément se donne, Ma raison n'ose me donner."
                                            },
                                            {
                                                "example_id": "dcd9695b-b836-4d9b-aea2-d6e7038621f8",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "J'ai beau la conjurer de montrer son visage ; Ma prière au refus obstinément l’engage."
                                            },
                                            {
                                                "example_id": "b387e8db-a3ac-4649-a43a-06ba3c41ff7c",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Après m’avoir obstinément refusé quand je l’en pressais devant sa maîtresse."
                                            },
                                            {
                                                "example_id": "d3ca5658-68bf-40b8-9ba3-7ed26778466d",
                                                "sense_id": "bf94f18d-919f-3f3a-bb68-e9ac54c57cba",
                                                "text": "Si je parvins à mes fins pour le jeûne, elle refusa obstinément que je déroge aux classes de catéchisme, convaincue que la science de Dieu est plus nécessaire encore que celle du collège."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
