                                "sense_id": "3644c770-580a-39bb-97ce-aadb5d0a8831",
                                "text": "O tej porze zazwyczaj jadam obiad."
                            },
                            {
                                "example_id": "e14be300-6780-41ca-a42c-c62dfdc8def0",
                                "sense_id": "3644c770-580a-39bb-97ce-aadb5d0a8831",
                                "text": "Środkowy palec jest zazwyczaj najdłuższym palcem u ręki."
