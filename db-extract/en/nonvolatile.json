                    {
                        "sense_id": "034d1ba6-025f-3417-a312-497b8a9d55fd",
                        "entry_id": "6bbf6ef4-2bb0-3887-9e3a-6a42298a6c06",
                        "glosses": [
                            "Not volatile (in any sense)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "13695827-6c66-41e1-8fbe-f31d7ab026f9",
                                "sense_id": "034d1ba6-025f-3417-a312-497b8a9d55fd",
                                "text": "The chemical is nonvolatile so it will not evaporate."
                            },
                            {
                                "example_id": "af4f03dc-21e7-4ebc-87ea-ca20cdf392c5",
                                "sense_id": "034d1ba6-025f-3417-a312-497b8a9d55fd",
                                "text": "His nonvolatile demeanor was tested by the constant pestering."
                            },
                            {
                                "example_id": "26822dab-c8ed-480e-b6dd-1055e5ea3164",
                                "sense_id": "034d1ba6-025f-3417-a312-497b8a9d55fd",
                                "text": "The hard drive is nonvolatile, but the RAM is volatile."
                            },
                            {
                                "example_id": "2c4d205a-e5e1-4c33-942f-4425e33a3637",
                                "sense_id": "034d1ba6-025f-3417-a312-497b8a9d55fd",
                                "text": "A nonvolatile variable may misbehave if accessed from multiple threads at once."
                            }
                        ]
                    }
