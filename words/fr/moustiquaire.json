                {
                    "sense_id": "cb10a12f-d855-3941-a666-4fff6b1ebc9e",
                    "sense_definition": "Toile ou filet fin suspendu autour d'un lit pour se protéger des piqûres de moustiques.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protection_insectes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant notre séjour dans cette région tropicale, nous devions dormir sous une <w>moustiquaire</w>."
                        },
                        {
                            "text": "Il a soigneusement bordé la <w>moustiquaire</w> sous le matelas pour empêcher les insectes d'entrer."
                        }
                    ],
                    "common_phrases": [
                        "dormir sous une moustiquaire",
                        "installer une moustiquaire"
                    ]
                },
                {
                    "sense_id": "86f5783b-3e1c-3338-ba39-c54d2aa49a7e",
                    "sense_definition": "Treillis ou grillage fin posé sur une porte ou une fenêtre pour empêcher les insectes de pénétrer.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "protection_insectes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons fixé une <w>moustiquaire</w> sur la fenêtre afin de pouvoir aérer la pièce la nuit."
                        },
                        {
                            "text": "Avant l'été, mon voisin pose des <w>moustiquaires</w> sur toutes les ouvertures de sa maison."
                        }
                    ],
                    "common_phrases": [
