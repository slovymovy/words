                ],
                "senses": [
                    {
                        "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                        "entry_id": "2c9ca4c2-e3a4-31b8-9a81-b1e17e9b85a3",
                        "glosses": [
                            "klar umrissene Ausrichtung oder gedanklicher Endpunkt einer lärmschutztechnischen Bestrebung, Lebewesen vor schädlichem Lärm zu bewahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c406b4dc-003c-4242-8585-a17bde3ef793",
                                "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                                "text": "„Weiterhin bitten die Umweltministerinnen, -minister, -senatorin und -senatoren der Länder den Bund, um ein einheitliches Lärmschutzziel für alle Verkehrswege zu erreichen, die Sanierungswerte für bestehende Verkehrswege schrittweise an die strengeren Grenzwerte der Verkehrslärmschutzverordnung für Aus- und Neubaumaßnahmen von Verkehrswegen anzupassen und bei der Betrachtung des Nachtzeitraums an Schienenwegen den Schutz vor Aufwachreaktionen sicherzustellen.“"
                            },
                            {
                                "example_id": "1454031a-23b3-48f0-9a4b-5eaa443256b4",
                                "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                                "text": "„Bei Betrachtung der aktuellen Zahlen ist es grotesk, dass die Bundesregierung ihre Lärmschutzziele immer noch für erreichbar hält.“"
                            },
                            {
                                "example_id": "d3f8b89f-c103-49f1-8759-78d88453e332",
                                "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                                "text": "„Sie fordern die Bundesregierung auf, ein gesetzlich verankertes Lärmschutzziel für alle Verkehrsträger zu schaffen.“"
                            },
                            {
                                "example_id": "adef4d18-d8ce-4f6a-9487-7fdbb860b14b",
                                "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                                "text": "„Doch weder der Autobahngesellschaft noch dem Verkehrsministerium haben Informationen darüber, ob und inwieweit das Lärmschutzziel damit erreicht wurde, kritisiert der Rechnungshof.“"
                            },
                            {
                                "example_id": "50b6511e-5db7-4b68-b803-70249a9dd8ab",
                                "sense_id": "022920bd-4894-30f2-a68b-ed891eec28fc",
                                "text": "„Kann das Lärmschutzziel gemäss Artikel 2 Absatz 3 des Bundesgesetzes vom 24. März 2000 über die Lärmsanierung der Eisenbahnen innert der gesetzten Frist nicht erreicht werden, hat der Bundesrat dem Parlament einen Bundesbeschluss über einen zusätzlichen Verpflichtungskredit so rechtzeitig zu unterbreiten, dass das Ziel innert den vorgesehenen Fristen erreicht wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
