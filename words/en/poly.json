                    "frequency": "VeryLow",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wizard managed to <w>poly</w> the enemy into a harmless sheep.",
                            "target_lang_translations": {
                                "ru": "Волшебнику удалось <w>превратить</w> врага в безобидную овцу."
