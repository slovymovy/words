                    "sense_definition": "Demander de nouveau quelque chose, ou en demander une quantité supplémentaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "demander_encore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gâteau était si délicieux que les enfants en ont tous <w>redemandé</w> à la fin du repas."
                        },
                        {
                            "text": "Si vous n'avez pas compris la consigne, vous devriez lui <w>redemander</w> une explication claire."
                        }
                    ],
                    "synonyms": [
                        "réitérer",
                        "réclamer"
                    ],
                    "common_phrases": [
                        "en redemander"
                    ]
                },
                {
                    "sense_id": "14162c8b-a444-3a36-8662-554eca879209",
                    "sense_definition": "Demander la restitution d'une chose que l'on avait prêtée ou donnée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recouvrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a prêté un livre rare et a finalement décidé de le <w>redemander</w> à son collègue."
                        },
                        {
                            "text": "Après plusieurs semaines d'attente, elle n'osait toujours pas lui <w>redemander</w> la somme prêtée."
                        }
                    ],
                    "synonyms": [
                        "réclamer",
                        "revendiquer"
                    ],
                    "common_phrases": [
