                ],
                "senses": [
                    {
                        "sense_id": "29674d0e-582a-349e-ba43-2764cca2ba01",
                        "entry_id": "0304af29-6cc2-3b27-b019-b601f8dbba9c",
                        "glosses": [
                            "Délivrer des mouches en les chassant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e923f2-1a9c-43bc-9eab-8379c1d3a015",
                                "sense_id": "29674d0e-582a-349e-ba43-2764cca2ba01",
                                "text": "Émoucher un cheval."
                            },
                            {
                                "example_id": "4468a679-0602-47b9-b378-ef8fb7cc6359",
                                "sense_id": "29674d0e-582a-349e-ba43-2764cca2ba01",
                                "text": "Les chevaux s’émouchent avec leur queue."
                            },
                            {
                                "example_id": "3a2705d3-716c-4a6c-a3c7-3964c3597bdb",
                                "sense_id": "29674d0e-582a-349e-ba43-2764cca2ba01",
                                "text": "Sur ces banquettes s'étalent deux ou trois gros turcs, et dans le dernier compartiment quatre enfants qu'on émouche avec des éventails."
                            },
                            {
                                "example_id": "92b65d19-906d-4d4f-852f-d8fda9efb77e",
                                "sense_id": "29674d0e-582a-349e-ba43-2764cca2ba01",
                                "text": "Un paysan achète à la foire une vache qui a la plus belle queue que jamais vache ait eue, avec une pareille queue elle pourra s’émoucher jusqu’au bout du nez, ce qui, tout le monde le sait, est un grand avantage ; il rentre chez lui triomphant, car il n’a pas payé cher cette vache extraordinaire ; le lendemain matin il va la voir, elle n’a plus de queue du tout ; celle qui pendait derrière elle si noblement avait été collée à un moignon ; c’était un chignon, une queue postiche."
                            }
                        ]
                    }
