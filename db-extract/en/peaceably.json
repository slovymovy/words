                    {
                        "sense_id": "459f0d17-44b8-31be-9b10-b7f16216b062",
                        "entry_id": "178006e4-95c6-30e3-96f8-dcad8768aa4a",
                        "glosses": [
                            "ειρηνικά, με τρόπο που δείχνει ότι προσπαθώ να ζήσω εν ειρήνη και ότι δεν θέλω βία ή λογομαχία"
                        ],
                        "tags": [],
                        "examples": [
                            {
