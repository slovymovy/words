                    }
                ],
                "translations": [
                    {
                        "translation_id": "696e5ecb-13f7-4e10-839d-aec1fa2db806",
                        "source_entry_id": "d672cbe0-181e-3971-9f57-caa936f97de6",
                        "source_sense_id": "34db43db-439c-3fa1-8f61-d2abc175750d",
                        "source_sense_description": "Spiel, bei dem es etwas zu gewinnen gibt",
                        "target_lang_word": "розыгрыш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "розыгрыш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3604a459-3aad-31bc-9e11-8b3d0f1cfdd7",
                                        "entry_id": "9407f475-5674-3896-89a8-d0a0930733fc",
                                        "glosses": [
                                            "действие по значению гл. разыгрывать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4311176e-5dc6-4215-bd74-c6abbf5c2c0b",
                                                "sense_id": "3604a459-3aad-31bc-9e11-8b3d0f1cfdd7",
                                                "text": "Сейчас, товарищи, будет производиться розыгрыш двадцатирублевых выигрышей."
                                            },
                                            {
                                                "example_id": "29fa7979-e697-4488-bdeb-aa4f88c3a49f",
                                                "sense_id": "3604a459-3aad-31bc-9e11-8b3d0f1cfdd7",
                                                "text": "Если шарик упадет на zero, то всё, что ни поставлено на столе, принадлежит банку без расчета. Правда, дается ещё удар на розыгрыш, но зато банк ничего не платит"
                                            },
                                            {
                                                "example_id": "a85dcf09-810e-4468-a48f-71e5a0343321",
                                                "sense_id": "3604a459-3aad-31bc-9e11-8b3d0f1cfdd7",
                                                "text": "Иван Борисыч всё делал с изумительною скоростью и часто, не дожидаясь розыгрыша игры, вычислив все ходы в уме, писал мелом свой будущий выигрыш или проигрыш."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab622e8-a384-337c-8d77-234c4416b8dc",
                                        "entry_id": "9407f475-5674-3896-89a8-d0a0930733fc",
                                        "glosses": [
                                            "редк. ничейный результат игры"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23d36d26-bb67-30e6-9cbc-e055e1080133",
                                        "entry_id": "9407f475-5674-3896-89a8-d0a0930733fc",
                                        "glosses": [
                                            "разг. шутка с целью одурачить кого-либо, поставить кого-либо в глупое, смешное положение, заставив поверить во что-либо придуманное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8412096f-cf08-4c6e-9b52-6ece7014aab1",
                                                "sense_id": "23d36d26-bb67-30e6-9cbc-e055e1080133",
                                                "text": "Лучшее из лекарств от хандры — шутка, весёлый розыгрыш."
                                            },
                                            {
                                                "example_id": "1978d625-89ee-451f-bb5b-10cd0ec413f4",
                                                "sense_id": "23d36d26-bb67-30e6-9cbc-e055e1080133",
                                                "text": "Ну их к дьяволу — народ коварный да подковыристый, — нарвёшься опять на розыгрыш какой-нибудь и посмешищем сделаешься."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
