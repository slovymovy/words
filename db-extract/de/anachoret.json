                                    {
                                        "sense_id": "a7d7dbec-803c-3b78-bc95-47d2b9b46223",
                                        "entry_id": "18bfb0ae-f1fa-32e5-89ed-9fc837876100",
                                        "glosses": [
                                            "истор., религ. монах-отшельник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a85e49f-d2b5-47f8-a5b7-4c7e1628bff7",
                                                "sense_id": "a7d7dbec-803c-3b78-bc95-47d2b9b46223",
                                                "text": "Во времена язычества какой-нибудь анахорет уносил свою идею в пустыню, к зверям, и оттуда мир она завоевала."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e6c08d4-7557-31de-8aaa-d04c559d7d3e",
                                        "entry_id": "18bfb0ae-f1fa-32e5-89ed-9fc837876100",
                                        "glosses": [
                                            "книжн., устар., шутл. тот, кто живёт уединённо, избегая общества"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443cb8ea-9e15-47e1-8eb8-1e86c0a3aa45",
                                                "sense_id": "2e6c08d4-7557-31de-8aaa-d04c559d7d3e",
                                                "text": "Хорошо анахорету: виски с Гиннессом мешая, он плетётся меж сугробов, тихо песенки поёт."
                                            }
                                        ]
