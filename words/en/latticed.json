{
    "word_family": [
        "lattice",
        "latticework"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6014ba46-8617-36c7-ae5f-0b32dbe865a4",
                    "sense_definition": "Having or fitted with a lattice or latticework.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "lattice_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sunlight filtered softly through the <w>latticed</w> windows of the old garden gazebo.",
                            "target_lang_translations": {
                                "es": "La luz del sol se filtraba suavemente a través de las ventanas <w>enrejadas</w> de la vieja glorieta del jardín."
                            }
                        },
                        {
                            "text": "Ivy climbed up the <w>latticed</w> screen that separated the patio from the lawn.",
                            "target_lang_translations": {
                                "es": "La hiedra trepaba por la pantalla <w>con celosía</w> que separaba el patio del césped."
                            }
                        }
                    ],
                    "synonyms": [
                        "trellised"
                    ],
                    "common_phrases": [
                        "latticed window",
                        "latticed screen"
                    ],
                    "target_lang_definitions": {
                        "es": "Que tiene celosía, enrejado o entramado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "enrejado",
                                "target_lang_sense_clarification": "con rejas o celosía"
                            },
                            {
                                "target_lang_word": "con celosía",
                                "target_lang_sense_clarification": "provisto de celosía"
                            },
                            {
                                "target_lang_word": "entramado",
                                "target_lang_sense_clarification": "con estructura de rejilla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c89c270-198a-39e7-b5ae-fbf78d65c107",
                    "sense_definition": "Arranged or patterned in a crisscross structure resembling a lattice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lattice_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baker decorated the top of the fruit tart with a delicate <w>latticed</w> crust.",
                            "target_lang_translations": {
                                "es": "El pastelero decoró la parte superior de la tarta de frutas con una delicada masa <w>entrecruzada</w>."
                            }
                        },
                        {
                            "text": "The overhead steel beams formed a complex <w>latticed</w> pattern across the ceiling.",
                            "target_lang_translations": {
                                "es": "Las vigas de acero superiores formaban un complejo patrón <w>reticulado</w> a lo largo del techo."
                            }
                        }
                    ],
                    "synonyms": [
                        "crisscross",
                        "reticulated"
                    ],
                    "common_phrases": [
                        "latticed crust",
                        "latticed pattern"
                    ],
                    "target_lang_definitions": {
                        "es": "Dispuesto con un diseño o patrón entrecruzado similar a una celosía."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrecruzado",
                                "target_lang_sense_clarification": "dispuesto en forma de rejilla"
                            },
                            {
                                "target_lang_word": "reticulado",
                                "target_lang_sense_clarification": "en forma de red o cuadrícula"
                            },
                            {
                                "target_lang_word": "enrejado",
                                "target_lang_sense_clarification": "con dibujo cruzado"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1aeb45f6-858f-338d-b2dc-9030488f20bd",
                    "sense_definition": "simple past and past participle of <w>lattice</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lattice_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener <w>latticed</w> the wooden strips to give the climbing roses more support.",
                            "target_lang_translations": {
                                "es": "El jardinero <w>entrelazó</w> los listones de madera para darles más soporte a los rosales trepadores."
                            }
                        },
                        {
                            "text": "Shadows of bare branches had <w>latticed</w> the stone wall in the afternoon light.",
                            "target_lang_translations": {
                                "es": "Las sombras de las ramas desnudas habían <w>cubierto con un entramado</w> el muro de piedra bajo la luz de la tarde."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio del verbo lattice (formar un enrejado, cruzar o entrelazar en forma de celosía)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "entrelazó",
                                "target_lang_sense_clarification": "cruzó en forma de rejilla"
                            },
                            {
                                "target_lang_word": "enrejó",
                                "target_lang_sense_clarification": "puso rejas o celosía"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}