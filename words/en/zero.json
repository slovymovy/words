                    "sense_id": "85e3db23-f71c-3972-ba5e-1448878b735f",
                    "sense_definition": "The cardinal number occurring before one that denotes no quantity or amount at all; represented as 0.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "number_value",
                    "name_type": "no",
