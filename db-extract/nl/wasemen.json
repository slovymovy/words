                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92d20827-3d0e-3fc4-b6d5-1feeed9462e7",
                                        "entry_id": "c2cb7b0f-db7e-3f75-96fc-fb9656bfa4a0",
                                        "glosses": [
                                            "Dampf entwickeln, Dampf ausstoßen"
                                        ],
                                        "tags": [
                                            "intransitiv, Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca0ede5c-bdab-4a3e-9fd6-626b48ac913e",
                                                "sense_id": "92d20827-3d0e-3fc4-b6d5-1feeed9462e7",
                                                "text": "Der Kartoffelbrei dampft verführerisch!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f5acdcb-d72e-3d92-a5dd-2df0ca541a9c",
                                        "entry_id": "c2cb7b0f-db7e-3f75-96fc-fb9656bfa4a0",
                                        "glosses": [
                                            "eine E-Zigarette konsumieren"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aa7ab20-8ec1-4051-a79c-0d81e7ad6d33",
                                                "sense_id": "6f5acdcb-d72e-3d92-a5dd-2df0ca541a9c",
                                                "text": "Wenn du am Bahnhof dampfen willst, musst du in den Raucherbereich gehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5ef3c2b1-0754-3d8d-aeac-7a99d66ab008",
                                        "entry_id": "c2cb7b0f-db7e-3f75-96fc-fb9656bfa4a0",
                                        "glosses": [
                                            "sich mithilfe von Dampftechnik fortbewegen"
                                        ],
                                        "tags": [
                                            "intransitiv, Hilfsverb sein",
                                            "von Fahrzeugen (Schiff, Zug)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ba6f7c5-6611-4cf6-ad66-10e0668ec366",
                                                "sense_id": "5ef3c2b1-0754-3d8d-aeac-7a99d66ab008",
                                                "text": "„Bis sechs Uhr abends wurde dauernd mit halber Kraft gegen Sturm gedampft. Gegen sieben Uhr abends flaute der Wind ab, so daß ein Treiben möglich war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3301021c-abce-3aea-a1ac-950b4fb35cdb",
                                        "entry_id": "c2cb7b0f-db7e-3f75-96fc-fb9656bfa4a0",
                                        "glosses": [
                                            "sich mit einem (dampfbetriebenen) Fahrzeug fortbewegen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e080b9e4-5519-4c6b-bd6e-3e94974e4669",
                                                "sense_id": "3301021c-abce-3aea-a1ac-950b4fb35cdb",
                                                "text": "„Den ganzen folgenden Tag dampften wir weiter den Mississippi hinunter und begegneten nur einem einzigen Dampfboot, das obendrein, wie ich durch das Fernrohr erspähte, meinen Namen trug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
