                "senses": [
                    {
                        "sense_id": "8f3bb5f5-5a80-3116-8b16-731d876e1b57",
                        "entry_id": "4bc63e5a-dad1-3912-a934-59f6ba993483",
                        "glosses": [
                            "Any of a number of Old Testament men."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1af95b2b-82b8-386e-953e-b1752e8298f7",
                        "entry_id": "4bc63e5a-dad1-3912-a934-59f6ba993483",
                        "glosses": [
                            "Any of a number of Old Testament men.",
                            "The husband of Bathsheba whom David sent to death."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06bd17d-c9f4-4f33-9c31-c65e29f18ab0",
                                "sense_id": "1af95b2b-82b8-386e-953e-b1752e8298f7",
                                "text": "And he wrote in the letter, saying, Set ye Uriah in the forefront of the hottest battle, and retire ye from him, that he may be smitten, and die."
                            },
                            {
                                "example_id": "a9f6931d-9a65-476f-a948-35e9e8b89a6e",
                                "sense_id": "1af95b2b-82b8-386e-953e-b1752e8298f7",
                                "text": "Some devout Christians are among the most fervent advocates of the death penalty, contradicting Jesus Christ and misinterpreting Holy Scriptures and numerous examples of mercy. We remember God’s forgiveness of Cain, who killed Abel, and the adulterer King David, who arranged the killing of Uriah, the husband of Bathsheba, his lover."
                            }
                        ]
                    },
                    {
                        "sense_id": "765157d3-221d-375f-a912-2ff0018eb5e1",
                        "entry_id": "4bc63e5a-dad1-3912-a934-59f6ba993483",
                        "glosses": [
                            "A male given name from Hebrew of Biblical origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bf210e-ed4f-4ba8-bf81-373b5ae60bef",
                                "sense_id": "765157d3-221d-375f-a912-2ff0018eb5e1",
                                "text": "but the thing that struck me most, was, that with the evidences of his native superiority still upon him, he should submit himself to that crawling impersonation of meanness, Uriah Heep."
                            }
                        ]
                    }
                ],
