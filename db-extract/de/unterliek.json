                "senses": [
                    {
                        "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                        "entry_id": "9e221ad4-b100-3837-840b-c92ac17adea5",
                        "glosses": [
                            "untere Seite/ unterer Rand eines Segels"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "2f18c0f2-bd3d-48bf-981d-0b65359fdf03",
                                "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                                "text": "„Es ist ein typisches Problem auf vielen Yachten, so auch bei uns: In der Wende bleibt das Unterliek der Genua an der Reling hängen.“"
                            },
                            {
                                "example_id": "b2c6d89d-59ca-4714-a665-9073c1f05b33",
                                "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                                "text": "Vor- und Unterliek sind durch ein Liektau oder einen Liekdraht aus rostfreiem Stahl verstärkt."
                            },
                            {
                                "example_id": "01283799-b675-4bb6-9e65-0ea375e30a12",
                                "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                                "text": "„Der neuseeländische Riggbauer Southern Spars hat seinen Rollbaum überarbeitet. […] Das Großsegel wird dabei über das Unterliek aufgerollt.“"
                            },
                            {
                                "example_id": "68be00d7-19a3-43e4-887f-2307af43e78e",
                                "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                                "text": "„Hier hat sich in den letzten Jahren einiges getan und drei von vier Schiffen fahren mittlerweile ein sogenanntes offenes Unterliek. Das bedeutet, dass das Unterliek nicht mit dem Baum verbunden ist.“"
                            },
                            {
                                "example_id": "a778a8d3-e2d0-4c94-a744-d8b429a5c8e0",
                                "sense_id": "6f0d0943-aa4a-3d2e-b3f7-f5f511433090",
                                "text": "„Das Großsegel wird wohl als sogenannter Decksweeper gefahren, das Unterliek schließt also mit dem Deck ab, um aerodynamische Vorteile zu generieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "590e529a-77d0-42b7-a153-42bacb2605ff",
