                        "glosses": [
                            "One who grits anything."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959212e1-5480-4d2c-874e-b2848d4203f1",
                                "sense_id": "cbaeeb33-5fcc-3c42-a033-58592d76ac3e",
                                "text": "He was gritting his teeth while lifting weights. I am from the teeth-gritters myself, and my teeth are also very soft."
                            }
                        ]
                    },
                    {
                        "sense_id": "177f8b40-4ade-32d8-b019-7905b35a1d67",
                        "entry_id": "30af6347-26a5-3ae3-a53a-29bc8c1d4f6e",
                        "glosses": [
                            "A vehicle that applies grit to icy roads to improve traction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5e50e8-5946-483a-a929-2daae5eeb1ef",
                                "sense_id": "177f8b40-4ade-32d8-b019-7905b35a1d67",
                                "text": "You need more than gritters, you need ploughs."
                            }
                        ]
