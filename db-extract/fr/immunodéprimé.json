                ],
                "senses": [
                    {
                        "sense_id": "d0ee96ed-fa60-337e-92a4-239f3d283e5a",
                        "entry_id": "8685bdf3-67df-316a-9415-c3b9de6e4b13",
                        "glosses": [
                            "Dont le système immunitaire fonctionne moins bien que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dbf49af-47dc-4889-8b24-af611d328e8f",
                                "sense_id": "d0ee96ed-fa60-337e-92a4-239f3d283e5a",
                                "text": "Les personnes de 60 ans et plus, celles qui sont immunodéprimées et leur entourage, les résidents d’Ehpad, les femmes enceintes, ainsi que les enfants et adolescents à haut risque sont ainsi invités à se faire vacciner."
                            },
                            {
                                "example_id": "3f97d6b3-19df-4002-a284-a1f89e25a831",
                                "sense_id": "d0ee96ed-fa60-337e-92a4-239f3d283e5a",
                                "text": "Ce n’est pas parce qu'il pleut un 31 mars, que tu es sous le coup de l’épuisement (d’après la souris que je viens de voir je suis sous le coup de l’épuisement) et que tu es immunodéprimée (d’après moi-même je suis en plus immunodéprimée) qu’il faut cesser le combat."
                            },
                            {
                                "example_id": "3d116efd-5cd3-46c3-9c64-b9d7acc8aaff",
                                "sense_id": "d0ee96ed-fa60-337e-92a4-239f3d283e5a",
                                "text": "Les patients immunodéprimés sont à risque d’infections virales sévères."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9554e2cf-1f68-405f-b12b-a3fcd08da321",
                        "source_entry_id": "8685bdf3-67df-316a-9415-c3b9de6e4b13",
