                    {
                        "translation_id": "cf27e080-3f38-42af-a2ea-400820312ae1",
                        "source_entry_id": "f4d376a8-1a0b-3737-8277-eb16aba6951e",
                        "source_sense_id": "be21f406-1390-3aae-9e9e-5a0eb0a98c0a",
                        "source_sense_description": "cold soup of Spanish origin",
                        "target_lang_word": "гаспа́чо",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гаспа́чо",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                        "entry_id": "6dc495d4-14f0-31e2-9560-59445c1cae1e",
                                        "glosses": [
                                            "кулин. блюдо испанской кухни («средиземноморской диеты»), холодный суп из перетёртых или пюрированных сырых овощей, прежде всего помидоров"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b7cfc9-0e0f-4a2f-bff6-c6b26765e41f",
                                                "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                                "text": "В Андалусии, например, едят холодный томатный суп гаспачо и запекают в морской соли дорадо и лумину."
                                            },
                                            {
                                                "example_id": "d0d3824c-230b-49d9-87d3-8529416bd2a5",
                                                "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                                "text": "Пожалуй, самым известным холодным супом, ставшим мировым кулинарным хитом, является гаспачо. ❬…❭ Этот суп первоначально был едой испанских крестьян, которые добавляли к своему скудному обеду, состоящему из хлеба, политого оливковым маслом, любые имеющиеся под рукой овощи."
                                            },
                                            {
                                                "example_id": "6f4adaab-6af3-4860-bdf8-3d97f62afc7e",
                                                "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                                "text": "В основе своей холодный суп, приготовленный из свежих овощей, — это не что иное, как салат, только все его ингредиенты мелко нарезаны или вообще натёрты на крупной тёрке. ❬…❭ Пример — вкуснейший болгарский суп таратор .. Или не менее аппетитный испанский традиционный суп гаспачо, приготовленный из помидоров, сладкого перца, огурцов и ржаного хлеба, щедро сдобренный оливковым маслом."
                                            },
                                            {
                                                "example_id": "aa930a07-8cb6-4836-8791-59bc99d9ba9d",
                                                "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                                "text": "В Испании первым делом стоит попробовать холодный суп-пюре гаспачо, родиной которого является Андалузия."
                                            },
                                            {
                                                "example_id": "95344219-235b-4d7e-90a2-e74f829d8996",
                                                "sense_id": "33216a84-0197-3a8d-8505-e3fb3709e940",
                                                "text": "В национальной кухне каждой страны есть свои знаменитые супы. В России это борщ и щи, солянка и уха, окрошка и рассольник, в Грузии — харчо, в Испании — гаспачо, во Франции — французский луковый суп, в Дании — гороховый суп с копчёностями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
