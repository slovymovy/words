        "fr-extract.jsonl": [
            {
                "entry_id": "816c4906-626c-329b-9345-303b32f58945",
                "word": "immense",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9eff4b58-3a75-4b87-ac9b-c00f81407d62",
                        "entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "immenses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "86b6a1a6-eae3-3fa6-9dbf-6d982a2e89ed",
                        "entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "glosses": [
                            "Qui est sans borne ou sans mesure ; dont l’étendue ou la grandeur sont infinies."
                        ],
                        "tags": [],
                        "note": "En ce sens, il se dit proprement de Dieu",
                        "examples": [
                            {
                                "example_id": "1be4f78e-d7c0-4ab6-8805-dfe5c4ef518a",
                                "sense_id": "86b6a1a6-eae3-3fa6-9dbf-6d982a2e89ed",
                                "text": "Dieu est immense. — C’est un être immense."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                        "entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "glosses": [
                            "Qui est d’une très grande étendue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7768f93-d3c0-4bb2-b432-6cdf737d7451",
                                "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                                "text": "Nous parcourons la vaste plaine fertile des Doukkala, sans pierres et sans arbres, où s’étalent à perte de vue d’immenses champs de blé, d'orge, de maïs, de fèves et de pois chiches."
                            },
                            {
                                "example_id": "27eed156-b588-41d3-bf74-830e6c41f4e0",
                                "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                                "text": "Alors se dressait devant eux l’immense cône du Popocatepelt, d’une telle altitude que l’œil s’égarait dans les nuages en cherchant le sommet de la montagne."
                            },
                            {
                                "example_id": "0a940e8a-e62a-4bb7-9002-5516db647a31",
                                "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                                "text": "Les communes rurales y sont bien rarement groupées; elles sont au contraire disséminées, sur l'immense et fécond plateau, en un éparpillement de fermes; […]."
                            },
                            {
                                "example_id": "b123bdc9-7858-45f1-93c4-af227e70bf3a",
                                "sense_id": "0fd67d49-908d-37ff-befa-3864b479c588",
                                "text": "La neige en cristaux fins tombe en voltigeant comme une immense nuée de moustiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                        "entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "glosses": [
                            "Qui est très considérable en son genre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348077db-0a70-4af2-8527-2018be27d3f1",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "[…] ; il déplorait, dans son cœur, qu'un défaut de combinaison, ou qu'une vaine jalousie le privassent des immenses résultats qu'il était à la veille de recueillir."
                            },
                            {
                                "example_id": "4b1fef59-f193-4bee-b8ac-309cfff6f2b8",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "Quelques instants après, la République était proclamée du haut du balcon, aux applaudissements d'un peuple immense, […]."
                            },
                            {
                                "example_id": "06b9fe06-c22b-4ae3-b125-fd74660a8dad",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                            },
                            {
                                "example_id": "c4489050-0fef-421d-b34e-1fbbbc33abf4",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "D’immenses désirs."
                            },
                            {
                                "example_id": "e36d2cbd-eabc-4790-9924-1e653ed081af",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "Il a une immense érudition, un savoir immense."
                            },
                            {
                                "example_id": "9238103c-9700-4f3d-b8b3-276f2ee0a255",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "Une immense vanité."
                            },
                            {
                                "example_id": "8592b795-90e1-40bc-8626-5f8a6fb8daf5",
                                "sense_id": "d6b6daf2-bb9d-3ed6-8ac5-f6fadf95f1eb",
                                "text": "Une sottise immense."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b170b3ee-cc19-421b-9f27-d3da46db5978",
                        "source_entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "target_lang_word": "immens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                        "entry_id": "d5b02a8e-d5b7-345c-83cd-5aa728eeac59",
                                        "glosses": [
                                            "derart unermesslich, über die Maßen, überdimensioniert, groß oder riesig, dass es in Erstaunen versetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0e343a-30bd-4eab-90cf-e68796c898f0",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "In der Atmosphäre schlummern immense Energien."
                                            },
                                            {
                                                "example_id": "d0c5d3db-8dcf-4bc8-90d3-2ac5682a86ad",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "Sein Stromverbrauch ist immens."
                                            },
                                            {
                                                "example_id": "91b455a0-0e7d-4064-8a48-e1859b103e20",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "Deine Hobbys verursachen immense Kosten."
                                            },
                                            {
                                                "example_id": "f2aa9cd1-dbcc-40d3-9cb2-16544989b91e",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "Ludger kann auf seinen immensen Ruhm stolz sein."
                                            },
                                            {
                                                "example_id": "51cf1315-2305-4ba6-9ca2-eac4f444437e",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "Nach dem Hagelschlag haben wir einen immensen Schaden zu beklagen."
                                            },
                                            {
                                                "example_id": "6290a846-3f31-45cc-b9ca-829b3a15721b",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "Um Lisl zu retten, hat Franzl immense Gefahren auf sich genommen."
                                            },
                                            {
                                                "example_id": "233654ab-7460-48a3-a9ca-bb588e057162",
                                                "sense_id": "13742600-3096-3e4d-940e-e55010e5e8b2",
                                                "text": "„Die letzte Nummer bringt die Variationen, die auch die Originalausgabe beschließen, dieselben, die H. W. Ernst zu seinem „Venezianischen Carnaval“ angeregt haben mögen; die Lißt’sche Bearbeitung halten wir für das musikalisch Interessanteste des ganzen Werkes; aber auch hier finden sich, oft im kleinsten Raume von einigen Tacten, Schwierigkeiten der immensesten Art, der Art, daß wohl Lißt selbst daran zu studiren haben mag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55447d1e-3c68-48f4-9360-bfca7308439c",
                        "source_entry_id": "816c4906-626c-329b-9345-303b32f58945",
                        "target_lang_word": "immense",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef3ec37-b87d-3ed0-9e3a-a5c103f106aa",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Huge, gigantic, very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b6c134-5640-4579-958b-19a07656048f",
                                                "sense_id": "6ef3ec37-b87d-3ed0-9e3a-a5c103f106aa",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d04976-b77e-3dd9-8593-60027cf73ff6",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Supremely good."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254fd7ff-4a00-33ad-a774-2e568344aad6",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Major; to a great degree."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d221fbf-7788-4d55-a5e7-797678b33649",
                                                "sense_id": "254fd7ff-4a00-33ad-a774-2e568344aad6",
                                                "text": "The gallant young Indian dandies at home on furlough—immense dandies these—chained and moustached—driving in tearing cabs […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                        "entry_id": "8b36f04a-4c37-3b74-88ff-388d399eb7ee",
                                        "glosses": [
                                            "Immense extent or expanse; immensity."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a5d50e-0d56-48e4-bf61-2b3b90b410be",
                                                "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                                "text": "The half of Asia is my prison-house,\nMyriads of convicts lost in its Immense—\nI look with terror to my crowning day."
                                            },
                                            {
                                                "example_id": "93d99b44-4928-4937-80c8-8245ba1fa958",
                                                "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                                "text": "The events that took place in the immenses of the former USSR three years ago remind one about ancient rule of everyday life which is equally applicable both to daily routine and to politics: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
