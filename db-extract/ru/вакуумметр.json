                        "glosses": [
                            "спец. вакуумный манометр, прибор для измерения давления разреженных газов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ee2941-9cd4-4b8b-a52e-a214fc1dd2a6",
                                "sense_id": "411c945d-a5bb-3bbc-b808-5aa24ac4a65e",
                                "text": "Вакуумметрическое давление (15—30 см рт. ст.), необходимое для правильного отсасывания воздуха из фарша, отмечается на вакуумметре."
                            }
                        ]
                    }
