        "nl-extract.jsonl": [
            {
                "entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                "word": "influisteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b87ebec1-c231-39cd-9566-da79eb371ffe",
                        "entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                        "glosses": [
                            "iemand heimelijk iets zeggen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "67bc111f-52a6-43ea-b141-29a139e09395",
                                "sense_id": "b87ebec1-c231-39cd-9566-da79eb371ffe",
                                "text": "Rob had gehoopt dat Jalal voor het chirurgische gedeelte in de commissie zou zitten, maar die was normaal in het ziekenhuis aan het werk. Even later kwam Mirdin hem influisteren dat als laatste examinator Ibn al-Natheli was gearriveerd, iemand die ze nauwelijks kenden."
                            },
                            {
                                "example_id": "cb875f77-566d-451e-801f-dcc05f8ded0d",
                                "sense_id": "b87ebec1-c231-39cd-9566-da79eb371ffe",
                                "text": "Tezelfdertijd echter liet Juliana zich door de Hofmanssekte wel influisteren dat Bernhard bezig was haar zo te tergen dat ze letterlijk krankzinnig zou worden en stelde ze, daartoe aangezet door dezelfde club, als persoonlijk adviseur de wonderlijke Van Hamel aan, naar wie ze vervolgens dan weer vaak niet luisterde."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ea04fac-7060-3a93-b4ca-e229ebc543ae",
                        "entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                        "glosses": [
                            "iets met een geringe geluidssterkte in het oor zeggen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ccbdc4d1-9904-4ed7-8454-0dda2a682f37",
                                "sense_id": "8ea04fac-7060-3a93-b4ca-e229ebc543ae",
                                "text": "Show, don’t tell is het motto van cinema, en ook van de expo Master of Light. Je kan je in het Eye twee uur onderdompelen in een sacrale schemerwereld, voor kolossale drieluiken met ‘geluiddouches’ die op je influisteren. Dan krijgen de woorden een gestalte en gaan de toelichtingen van Wim Wenders, Jim Jarmusch, Lars von Trier en Steve McQueen leven, vier filmmakers met wie Müller samenwerkte en op wie deze expositie zich concentreert."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d59bb69-8f8a-30fd-8c96-89376886dcce",
                        "entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                        "glosses": [
                            "voorzeggen tijdens een toneel voorstelling, souffleren"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f0d77329-a219-3617-93ea-7947733ded02",
                        "entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                        "glosses": [
                            "proberen door zachtjes te spreken iemands gedachten of handelen te sturen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f817bc51-6547-47d5-8e8e-c268c6ff96a9",
                        "source_entry_id": "6308d9fe-b686-3022-b2b5-3f831f8538e9",
                        "source_sense_id": "f0d77329-a219-3617-93ea-7947733ded02",
                        "source_sense_description": "proberen door zachtjes te spreken iemands gedachten of handelen te sturen",
                        "target_lang_word": "suggest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suggest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec6f51e-5724-3c2d-bcc2-2000f2721cd9",
                                        "entry_id": "1e541bc1-de47-3a9a-976f-e0aa31a2839b",
                                        "glosses": [
                                            "To imply but stop short of explicitly stating (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0be89e1c-d7bb-4500-aaab-da0d833adacc",
                                                "sense_id": "5ec6f51e-5724-3c2d-bcc2-2000f2721cd9",
                                                "text": "Are you suggesting that I killed my wife?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                                        "entry_id": "1e541bc1-de47-3a9a-976f-e0aa31a2839b",
                                        "glosses": [
                                            "To cause one to suppose (something); to bring to one's mind the idea (of something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6483631-c844-409b-8b4a-08c5fa61e3cb",
                                                "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                                                "text": "The name \"hamburger\" suggests that hamburgers originated from Hamburg."
                                            },
                                            {
                                                "example_id": "6937afe2-1572-4fbf-b448-eefd0aa081a3",
                                                "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                                                "text": ", Book II, Chapter III\nSome ideas […] are suggested to the mind by all the ways of sensation and reflection."
                                            },
                                            {
                                                "example_id": "141a0286-a7f8-41d2-8030-1f22aaca4014",
                                                "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                                                "text": "In the abstract, Stuhlbarg’s twinkly-eyed sidekick suggests Joe Pesci in Lethal Weapon 2 by way of late-period Robin Williams with an alien twist, but Stuhlbarg makes a character that easily could have come across as precious into a surprisingly palatable, even charming man."
                                            },
                                            {
                                                "example_id": "3f185e66-6c8a-4a97-8822-b084bbfe3fae",
                                                "sense_id": "e850d307-a804-340b-9955-d5e97ac4c555",
                                                "text": "The [British Heart Foundation's] data […] suggests there has been little improvement in eating, drinking and exercise habits in spite of the concern about obesity and the launch of the government's child measurement programme, which warns parents if their children are overweight. About a third of under-16s across the UK are either overweight or obese."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                        "entry_id": "1e541bc1-de47-3a9a-976f-e0aa31a2839b",
                                        "glosses": [
                                            "To explicitly mention (something) as a possibility for consideration, often to recommend it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e367f8-afca-4d3e-9790-c21448d1a276",
                                                "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                                "text": "This meeting venue was suggested to us by our boss."
                                            },
                                            {
                                                "example_id": "f1aebeee-8720-4620-a68b-69083d7b6c51",
                                                "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                                "text": "He suggests that we celebrate with dinner at Bellissimo. He suggests our celebrating with dinner at Bellissimo."
                                            },
                                            {
                                                "example_id": "b827ca7d-9d82-4f4d-abfb-191f005d44cb",
                                                "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                                "text": "The guidebook suggested that we visit the local cathedral, so that's what we did."
                                            },
                                            {
                                                "example_id": "7275ad3c-8741-463f-9117-eeefe0421b32",
                                                "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                                "text": "But Rachida Dati has now turned on her own party elite with such ferocity that some have suggested she should be expelled from the president's ruling party."
                                            },
                                            {
                                                "example_id": "988fd00c-87ac-40ad-8592-2ebc5a1d746c",
                                                "sense_id": "79df55d5-4e5d-3194-b591-8331c3b998f0",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "117fe8a1-74df-36f1-b461-80d91363456b",
                                        "entry_id": "1e541bc1-de47-3a9a-976f-e0aa31a2839b",
                                        "glosses": [
                                            "To seduce; to prompt to evil; to tempt."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9a4de2-1169-43f2-8584-49130c5b7bd7",
                                                "sense_id": "117fe8a1-74df-36f1-b461-80d91363456b",
                                                "text": "Knowing that tender youth is soon suggested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
