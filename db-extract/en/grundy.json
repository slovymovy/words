                "senses": [
                    {
                        "sense_id": "9d24ce56-4015-3437-bc4c-1bd4621b5179",
                        "entry_id": "eac14ae1-e8a7-3587-aec1-3883514cdf34",
                        "glosses": [
                            "A narrow-minded person or group that is overly concerned with censoring or criticizing personal conduct."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ab83da4-697b-473d-b8c7-33049e487f11",
                        "source_entry_id": "eac14ae1-e8a7-3587-aec1-3883514cdf34",
                        "source_sense_id": "9d24ce56-4015-3437-bc4c-1bd4621b5179",
                        "source_sense_description": "narrow-minded person(s), censoring personal conduct",
                        "target_lang_word": "Spießer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spießer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7005a110-8ef9-3b77-b59a-873d2cba2b41",
                                        "entry_id": "da6e85cc-c5d9-3adc-b8e7-bc62c13f98b3",
                                        "glosses": [
                                            "Person, die sich durch geistige Unbeweglichkeit, ausgeprägte Konformität mit gesellschaftlichen Normen, Abneigung gegen Veränderungen der gewohnten Lebensumgebung und ein starkes Bedürfnis nach sozialer Sicherheit auszeichnet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fe5fc6f-1bb9-43d3-b2b2-be6eba1d9956",
                                                "sense_id": "7005a110-8ef9-3b77-b59a-873d2cba2b41",
                                                "text": "Mein Nachbar klopft jedes Mal an die Wand, wenn ich nach zehn Uhr den Fernseher an hab. Was für ein Spießer!"
                                            },
                                            {
                                                "example_id": "28b2491f-9b89-43c6-8059-d27996d0f8f6",
                                                "sense_id": "7005a110-8ef9-3b77-b59a-873d2cba2b41",
                                                "text": "„In der Trambahn spricht mich ein bieraufgeschwemmter Spießer an.“"
                                            },
                                            {
                                                "example_id": "f25603b5-ce44-464a-9b4c-07ffca70e69b",
                                                "sense_id": "7005a110-8ef9-3b77-b59a-873d2cba2b41",
                                                "text": "„Den eßfreudigen Spießer ergreift die Angst vor der Auslöschung seiner Persönlichkeit durch den unvermeidlichen Tod.“"
                                            },
                                            {
                                                "example_id": "54d7aa5c-e745-4a68-8ed6-116a6bdaf69f",
                                                "sense_id": "7005a110-8ef9-3b77-b59a-873d2cba2b41",
                                                "text": "„Während ich mit meiner Reisetasche ins Hotel der Abteilung gehe, wundere ich mich wieder einmal darüber, daß in dieser Nobelgegend dieses regelrechte Puffhotel existiert: genauso eingerichtet, wie sich der französische Spießer das sprichwörtliche verschwiegene Liebesnest vorstellen dürfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99ea5011-f070-3eb7-8d3b-11f2af1f1ab8",
                                        "entry_id": "da6e85cc-c5d9-3adc-b8e7-bc62c13f98b3",
                                        "glosses": [
                                            "Hirsch, Elch oder Rehbock mit Spießen (Geweihstange junger Hirsche, Elche und Rehböcke, die noch keine Enden hat)"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1187fb6b-58ca-4431-aeeb-93ebfaaf8507",
                                                "sense_id": "99ea5011-f070-3eb7-8d3b-11f2af1f1ab8",
                                                "text": "„Den Abschuß der Spießer und Thiere haben die am Saupark angestellten Jagdbeamten auf jedesmalige specielle Anordnung wahrzunehmen.“"
                                            },
                                            {
                                                "example_id": "e3c49a56-baff-47d1-bb21-a7da60ac320a",
                                                "sense_id": "99ea5011-f070-3eb7-8d3b-11f2af1f1ab8",
                                                "text": "„Nur wenige Schritte von ihm entfernt stand ein bedeutend jüngerer Mann, eifrig beschäftigt, einen frischerlegten Spießer zu häuten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7a029856-fecb-365d-8622-7fa027d2dbea",
                                        "entry_id": "da6e85cc-c5d9-3adc-b8e7-bc62c13f98b3",
                                        "glosses": [
                                            "Beschreibt eine mittelalterliche, militärische Einheit, die mit einem meist langen Spieß ausgerüstet war. (Siehe Pikenier und Landsknecht)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c923f93-780e-466f-aa1d-292ba76b41be",
                        "source_entry_id": "eac14ae1-e8a7-3587-aec1-3883514cdf34",
                        "source_sense_id": "9d24ce56-4015-3437-bc4c-1bd4621b5179",
                        "source_sense_description": "narrow-minded person(s), censoring personal conduct",
                        "target_lang_word": "Biedermann",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biedermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe87ab4-3cce-36e5-adf0-c154f1e1d806",
                                        "entry_id": "47c06490-aabd-3670-b39c-a34f8b72c383",
                                        "glosses": [
                                            "jemand, der bieder, brav, oft übertrieben anständig und loyal, spießig ist, eine Bezeichnung für einen Menschen, der sich selbst als viel ansieht, diesen Ansprüchen aber im Grunde nicht genügt, jemand, der eine Doppelmoral lebt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646570df-4bf3-4694-a206-0b950a5021a3",
                                                "sense_id": "8fe87ab4-3cce-36e5-adf0-c154f1e1d806",
                                                "text": "Das beste Beispiel dafür ist die Lektüre ohne Lehre ``Biedermann und die Brandstifter´´ von Max Frisch. Das Buch ist eine Burleske, eine im Theater und der Literatur derbe Komödie."
                                            },
                                            {
                                                "example_id": "8b0a48bc-4779-4593-9132-b12341692618",
                                                "sense_id": "8fe87ab4-3cce-36e5-adf0-c154f1e1d806",
                                                "text": "„Die deutsche Revolution fand ein unwissendes Volk, eine Führerschicht bürokratischer Biedermänner.“"
                                            },
                                            {
                                                "example_id": "e1add6db-6c4c-460e-a60b-816a70a52b5b",
                                                "sense_id": "8fe87ab4-3cce-36e5-adf0-c154f1e1d806",
                                                "text": "„Es ist nur die Maske des Biedermanns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Biedermann",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                        "entry_id": "474c9ac5-f690-3738-b947-bad6bd8355a5",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8145c1cb-3489-4210-bf62-09afc739994b",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "An verregneten Herbsttagen ist Familie Biedermanns liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "8fc4c471-27a9-43fd-8ca3-b4ff054a668e",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Biedermann kommt, geht der Herr Biedermann.“"
                                            },
                                            {
                                                "example_id": "37571648-778d-4c48-9b13-3a4c1362dbc4",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Biedermann kommt und geht."
                                            },
                                            {
                                                "example_id": "acb62a56-2d58-4db7-a4db-a91135f66eb1",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Herr Biedermann hat sechs Kinder."
                                            },
                                            {
                                                "example_id": "c25ad816-823d-44c8-8667-fd8a72badafd",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Biedermanns lassen sich vermutlich bald scheiden."
                                            },
                                            {
                                                "example_id": "8e958e96-8fe3-4be1-a1c7-a3bcc747b8e7",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Der Biedermann ist 45 Jahre alt, die Biedermann 40."
                                            },
                                            {
                                                "example_id": "8f2ff199-1592-490d-a916-72124a52b0db",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Frau Biedermann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c004e922-decc-4488-a9ad-60c341df32c9",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Herr Biedermann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "c21eb166-dd02-4ee4-a586-47a3b5b34439",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Die Biedermanns kommen heute aus dem Engadin."
                                            },
                                            {
                                                "example_id": "f4265229-45d7-4745-b108-296c14f8d5b5",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Der Biedermann trägt nie die Schals, die die Biedermann ihm strickt."
                                            },
                                            {
                                                "example_id": "1ab10ef8-62ed-4d38-a96f-12f6ab38dcb7",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "Biedermanns kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "8ee980d5-f4f6-4c2c-8e93-b63bc5505960",
                                                "sense_id": "6aa1167e-c0a7-3aa4-9d74-e5075f9385bf",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Biedermann das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
