        "fr-extract.jsonl": [
            {
                "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                "word": "dolent",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f535e568-82c1-4e43-960c-7a8ce0ae7919",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "dolents"
                    },
                    {
                        "form_id": "7d9ee3a7-2132-43d0-a674-aad0058ae30a",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "dolente"
                    },
                    {
                        "form_id": "1f2be563-6003-4bee-93cf-87da926bbdda",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "dolentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dd71ad2-0c2b-35ea-8177-90239a8d00a2",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "glosses": [
                            "Qui est dans un état de souffrance pénible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "393aec9e-0191-4844-96f1-3f049bf304cb",
                                "sense_id": "2dd71ad2-0c2b-35ea-8177-90239a8d00a2",
                                "text": "Mais quelle souffrance à se dire que cette noble femme, tant aimée, et si purement, allait être, dans la catastrophe, la plus dolente des victimes !"
                            },
                            {
                                "example_id": "25520bba-6840-4754-ad90-006dc4bab793",
                                "sense_id": "2dd71ad2-0c2b-35ea-8177-90239a8d00a2",
                                "text": "Ah ! la dolente humanité, toujours à se battre, à se dévorer, dans les parlements et sur les champs de bataille, quand donc désarmerait-elle pour vivre enfin selon la justice et la raison ?"
                            },
                            {
                                "example_id": "dedd459d-1f9a-41a2-9907-2f23046413a1",
                                "sense_id": "2dd71ad2-0c2b-35ea-8177-90239a8d00a2",
                                "text": "Sans doute n’était-ce pas assez de cette blessure, sans doute n’était-ce pas assez de la misère contre laquelle il allait maintenant toute sa vie se débattre… sans doute lui faudrait-il porter un cœur dolent ! Comme il était difficile de vivre !"
                            },
                            {
                                "example_id": "d50ba63b-556c-4f5a-9f92-fb9382e66ffd",
                                "sense_id": "2dd71ad2-0c2b-35ea-8177-90239a8d00a2",
                                "text": "À trente-deux ans, ayant l'habitude de l'indépendance et le goût de la vie énergique, je me voyais le mari empêché d'une jeune femme dolente, et j'avoue, bien que ce sentiment ne soit pas beau, que je le supportais sans patience."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ca0904d-fc54-3276-a580-7a8180e66b1b",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "glosses": [
                            "Qui affecte un air plaintif ou une voix plaintive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "325c1d93-8d2d-46a8-87a6-784fbea53374",
                                "sense_id": "3ca0904d-fc54-3276-a580-7a8180e66b1b",
                                "text": "Le garde s'abrita les yeux d'une main et regarda l'oiseau en fronçant ses épais sourcils, puis d'une voix dolente: - Voulez-vous tirer? dit-il."
                            },
                            {
                                "example_id": "0ece77f1-9f85-4595-96d3-d650b8ec4027",
                                "sense_id": "3ca0904d-fc54-3276-a580-7a8180e66b1b",
                                "text": "Et sa voix alors prenait une intonation dolente et uniforme, enflant les mots, appuyant indéfiniment sur les syllabes. Cela m’agaçait beaucoup."
                            },
                            {
                                "example_id": "8561e7ae-460a-479d-9008-28e6fa224a8c",
                                "sense_id": "3ca0904d-fc54-3276-a580-7a8180e66b1b",
                                "text": "Et, d’une voix dolente, parfois, il expliquait à sa femme le malheur des temps […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "02b896bf-4957-3637-930a-4b477cf795a0",
                        "entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "glosses": [
                            "Qui est causé par un mal physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd86337a-a115-4856-b991-b2501f0758e9",
                                "sense_id": "02b896bf-4957-3637-930a-4b477cf795a0",
                                "text": "Mine dolente. Démarche dolente."
                            },
                            {
                                "example_id": "2ef15639-a6f0-4470-a118-0253a8ba06b7",
                                "sense_id": "02b896bf-4957-3637-930a-4b477cf795a0",
                                "text": "Il maigrit, sa taille s’allongea, et sa figure prit une sorte d’expression dolente qui la rendit presque intéressante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fe84968-ff70-47ee-aad2-28aca950f11e",
                        "source_entry_id": "8fc4d128-d888-3f13-ace1-d572c958b06f",
                        "target_lang_word": "plaintive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
