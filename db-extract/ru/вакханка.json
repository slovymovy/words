                                            {
                                                "example_id": "75d62097-ca78-47e9-a8fe-7ff1adf9e434",
                                                "sense_id": "212e0cc1-7f4c-37aa-9a2e-a203e40c1052",
                                                "text": "Szły za nim inne wozy, pełne dworzan w świetnych strojach, senatorów, kapłanów i nagich bachantek z wieńcami na głowach i dzbanami wina w ręku, w części spitych i wydających dzikie okrzyki."
                                            }
                                        ],
