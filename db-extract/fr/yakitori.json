                "entry_id": "79de8077-15ae-3b28-bcd2-1b03d24957eb",
                "word": "yakitori",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9744d38d-5500-4838-9f3b-4fd9f165a1c2",
                        "entry_id": "79de8077-15ae-3b28-bcd2-1b03d24957eb",
