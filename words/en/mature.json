    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fedfc4ca-135a-37bd-9cab-87246de3118b",
                    "sense_definition": "Fully developed in personality, emotional behavior, or physical appearance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "human_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is very <w>mature</w> for her age and handles responsibility well.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>зрелая</w> для своего возраста и хорошо справляется с ответственностью."
                            }
                        },
                        {
                            "text": "He showed a <w>mature</w> attitude when dealing with the difficult problem.",
                            "target_lang_translations": {
                                "ru": "Он проявил <w>зрелое</w> отношение при решении этой сложной проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "adult",
                        "grown up",
                        "grown",
                        "responsible",
                        "sensible"
                    ],
                    "antonyms": [
                        "childish",
                        "immature"
                    ],
                    "common_phrases": [
                        "mature attitude",
                        "mature for one's age",
                        "emotionally mature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигший высшей стадии развития; спелый.",
                        "zh": "指在性格、情感行为或外表上完全发育成熟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спелый",
                                "target_lang_sense_clarification": "о фруктах, овощах"
                            },
                            {
                                "target_lang_word": "выдержанный",
                                "target_lang_sense_clarification": "о сыре, вине"
                            },
                            {
                                "target_lang_word": "зрелый",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成熟",
                                "target_lang_sense_clarification": "指人或事物的发育、完善程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fedfc4ca-135a-37bd-9cab-87246de3118b",
                    "sense_definition": "Having reached the most advanced stage of growth or development; ripe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mature</w> cheese has a much stronger flavor than the mild one.",
                            "target_lang_translations": {
                                "ru": "<w>Выдержанный</w> сыр имеет гораздо более сильный вкус, чем мягкий.",
                                "zh": "这种<w>成熟</w>的奶酪比那种温和的口味浓郁得多。"
                            }
                        },
                        {
                            "text": "We harvested the <w>mature</w> vegetables from the garden yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы собрали <w>спелые</w> овощи с огорода.",
                                "zh": "我们昨天从花园里采摘了<w>成熟</w>的蔬菜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "full-grown",
                        "grown"
                    ],
                    "common_phrases": [
                        "mature cheese",
                        "mature skin",
                        "mature plants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигший высшей стадии развития; спелый.",
