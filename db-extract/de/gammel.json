                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c120ad15-b648-4c43-a478-00b804acea27",
                                                "sense_id": "bd9a4548-889a-38e9-9fb0-fa3ad4ebd5dd",
                                                "text": "This shed is full of junk – will you help me sort it out?"
                                            },
                                            {
                                                "example_id": "d17143d1-e724-496d-ba4c-c7ce7da4df73",
                                                "sense_id": "bd9a4548-889a-38e9-9fb0-fa3ad4ebd5dd",
                                                "text": "She needs to find a better place to keep her junk [= belongings]."
                                            },
                                            {
                                                "example_id": "3abde26e-8cf9-4990-b1d1-4075a39bb2a6",
                                                "sense_id": "bd9a4548-889a-38e9-9fb0-fa3ad4ebd5dd",
                                                "text": "What a piece of junk!"
