                "senses": [
                    {
                        "sense_id": "1816a9cb-76e8-3dae-a11c-c4c60876a905",
                        "entry_id": "7106dabc-98ba-3d90-8eb1-480fbaee41f4",
                        "glosses": [
                            "zwischen Gattung (Fachsprache: Genus) und Unterfamilie (Fachsprache: Subfamilia)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f06425db-3ac2-46e8-9d05-8c46501a8a43",
                                "sense_id": "1816a9cb-76e8-3dae-a11c-c4c60876a905",
                                "text": "Die Lamprologini sind eine Tribus der Buntbarsche (Cichlidae)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c5565856-9034-311a-b503-87ede697982f",
                        "entry_id": "7106dabc-98ba-3d90-8eb1-480fbaee41f4",
                        "glosses": [
                            "Wahlbezirk im Römischen Reich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a828eba1-6169-403a-b331-1f923b883300",
                                "sense_id": "c5565856-9034-311a-b503-87ede697982f",
                                "text": "Jede Tribus untergliederte sich in fünf centuriae seniorum und fünf centuriae iuniorum."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4474dfe5-4043-42e4-ac6e-84d2dce3fdd6",
                        "source_entry_id": "7106dabc-98ba-3d90-8eb1-480fbaee41f4",
                        "source_sense_id": "1816a9cb-76e8-3dae-a11c-c4c60876a905",
                        "source_sense_description": "Biologie: zwischen Gattung (Fachsprache: Genus) und Unterfamilie (Fachsprache: Subfamilia)",
                        "target_lang_word": "tribe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a38cb7d5-631a-3727-b5f2-5e578c83c56c",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "An ethnic group larger than a band or clan (and which may contain clans) but smaller than a nation (and which in turn may constitute a nation with other tribes). The tribe is often the basis of ethnic identity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869612d2-f2f3-4065-bcf2-fe79cef0e68f",
                                                "sense_id": "a38cb7d5-631a-3727-b5f2-5e578c83c56c",
                                                "text": "the Twelve Tribes of Israel; Germanic tribes; Celtic tribes"
                                            },
                                            {
                                                "example_id": "5b2adcf3-ffe9-43d3-a547-f36877d88796",
                                                "sense_id": "a38cb7d5-631a-3727-b5f2-5e578c83c56c",
                                                "text": "The Formation of Kazakh Identity: From Tribe to Nation-state"
                                            },
                                            {
                                                "example_id": "50ad6d95-c6d1-49ee-975b-92babeb95671",
                                                "sense_id": "a38cb7d5-631a-3727-b5f2-5e578c83c56c",
                                                "text": "If two persons bore the same name, […] ambiguity was avoided by […] indicating their place of origin, the name of the tribe or deme being added for persons of the same town […], and the name of the country or town for foreigners […]."
                                            },
                                            {
                                                "example_id": "60c8c6df-3e88-4e63-bf9b-d8d3591e9b72",
                                                "sense_id": "a38cb7d5-631a-3727-b5f2-5e578c83c56c",
                                                "text": "There have been other encounters with uncontacted tribes in recent years.\nIn February, a young man from an isolated Indigenous tribe in Brazil made brief contact with the outside world before returning to the Amazon rainforest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31734cfc-4be4-3ca2-9137-d8b7a6012bca",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A tribal nation or people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2cdd44c-328a-44e3-b4a2-9c5595db978f",
                                                "sense_id": "31734cfc-4be4-3ca2-9137-d8b7a6012bca",
                                                "text": "This leaves for consideration of this group of small tribes, or subtribes, so far as mapped by the writer quoted, the Teule, Cazcan, and Tecuexe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2bb9e93-b6c9-3316-a718-56177d27ceab",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A nation or people considered culturally primitive, as may be the case in Africa, Australia or Native America."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7027e913-4ee1-347d-936f-b61634c33643",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A socially cohesive group of people within a society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea9a38b-bfea-4119-93e3-ec2d27258956",
                                                "sense_id": "7027e913-4ee1-347d-936f-b61634c33643",
                                                "text": "Near-synonym: ingroup"
                                            },
                                            {
                                                "example_id": "5968eedb-66e3-4694-b113-6c0a1c3f9ab2",
                                                "sense_id": "7027e913-4ee1-347d-936f-b61634c33643",
                                                "text": "The thought of spending a year in close company with twitchers chilled me to the core. Not that I have anything against them, I am terribly fond of the members of the tribe, it is just that basically, they are a bunch of obsessive freaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "124a0d65-4c2c-3fd3-ba22-ea3707d3b29f",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A class or group of things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7ee8b48-2c56-4c47-a126-e008109454a3",
                                                "sense_id": "124a0d65-4c2c-3fd3-ba22-ea3707d3b29f",
                                                "text": "In 1968, estimates of the number of active reprint publishers ranged from about 20 to 100 publishers. The fact that almost 300 U.S. reprint publishers have been identified is evidence that the reprint tribe continues to increase."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a053a7-b211-300d-afee-eb7560da009f",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A group of apes who live and work together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49ae251b-fd7d-3101-a52f-f2ed6925bbb7",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A hierarchical rank between family and genus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfa002c-1656-4284-bce7-8eab1733fc44",
                                                "sense_id": "49ae251b-fd7d-3101-a52f-f2ed6925bbb7",
                                                "text": "The tempo of evolution in South American hamsters was very rapid – in the course of the Pliocene and Anthropocene 40 genera were formed here, at which time a series of them attained the level of tribe and subtribe (Oxymycteri, Phyllotiini, Ichthyomyini)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9bf25bd-aa9a-365d-b179-f6224c872584",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A group of affiliated Mardi Gras Indians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80b3454d-1424-3d91-b681-b0c3b21207d4",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "The collective noun for various animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3ef23dd-a0ec-3e0a-befe-4e4489da9dad",
                                        "entry_id": "1a885f10-d193-33ea-a10f-ae7149a2b728",
                                        "glosses": [
                                            "A family of animals descended from some particular female progenitor, through the female line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c6a56d-67cb-4279-af0c-878f9f4e6063",
                                                "sense_id": "c3ef23dd-a0ec-3e0a-befe-4e4489da9dad",
                                                "text": "the Duchess tribe of shorthorns"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tribe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41868290-22f7-344d-9d16-96c917f55bb9",
                                        "entry_id": "93bf1ea5-bccc-34f9-b592-f77aefc0e870",
