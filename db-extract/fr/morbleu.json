        "fr-extract.jsonl": [
            {
                "entry_id": "6ccbf504-8b7c-3a61-8625-8fb4bbbe8a67",
                "word": "morbleu",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                        "entry_id": "6ccbf504-8b7c-3a61-8625-8fb4bbbe8a67",
                        "glosses": [
                            "Euphémisme du juron Par la mort de Dieu."
                        ],
                        "tags": [
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "995f5c94-7ee9-43fa-8d3e-fab30a9d61a4",
                                "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                                "text": "À l’instant même, morbleu ! s’écria M. de Rênal, ivre de colère, et cependant plus heureux qu’il ne l’avait été depuis douze heures."
                            },
                            {
                                "example_id": "1d145063-ada4-4287-9fe6-d8774b9ba21d",
                                "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                                "text": "— Eh ! tant mieux, morbleu ! dit le préfet s’oubliant tout à fait."
                            },
                            {
                                "example_id": "98c51827-8b16-43fb-9c74-c2ed20b093ac",
                                "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                                "text": "Les « morbleu ! » les « sangdieu ! » les « morts de tous les diables ! » se croisaient dans l’air."
                            },
                            {
                                "example_id": "c986f690-71bf-4058-a69a-0f025a1bdeeb",
                                "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                                "text": "Un peu d’aplomb, morbleu ! dévisage les femmes, bouscule les hommes, tiens, imite-moi… Est-ce que deux gars de notre espèce craignent le feu de la rampe ?"
                            },
                            {
                                "example_id": "36628289-3519-496b-9553-c3814e192617",
                                "sense_id": "8eabea5e-29bd-3140-bd7f-638a36c7291d",
                                "text": "Vous, Dickson, assumez celle de Cruxley, puisque telle est votre mission, moi je me garderai moi-même et après cela stop ! Que la fête continue, morbleu !"
                            }
                        ]
                    }
                ],
