{
    "word_family": [
        "billowy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8401de96-7c60-37ac-a67e-818d28d2f0b7",
                    "sense_definition": "To rise, surge, or roll in large, swelling waves or clouds, such as smoke, steam, or water.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "billow-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick black smoke began to <w>billow</w> from the factory chimney after the explosion.",
                            "target_lang_translations": {
                                "ru": "После взрыва из заводской трубы начал <w>клубиться</w> густой черный дым."
                            }
                        },
                        {
                            "text": "We watched the heavy fog <w>billow</w> over the mountain peaks as the sun went down.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как густой туман <w>клубился</w> над горными вершинами на закате."
                            }
                        }
                    ],
                    "synonyms": [
                        "surge",
                        "roll",
                        "swell"
                    ],
                    "common_phrases": [
                        "smoke billowing from",
                        "billow over the hills"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подниматься, клубиться или катиться большими волнами или облаками (о дыме, паре, воде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клубиться",
                                "target_lang_sense_clarification": "о дыме, паре"
                            },
                            {
                                "target_lang_word": "вздыматься",
                                "target_lang_sense_clarification": "о дыме, пыли или волнах"
                            },
                            {
                                "target_lang_word": "валить",
                                "target_lang_sense_clarification": "густым потоком, о дыме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1bdd0e4-b17d-36bc-890a-e29193824ef7",
                    "sense_definition": "To swell out, puff up, or bulge, especially due to the action of wind on fabric.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "billow-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sails of the sailboat started to <w>billow</w> as the strong wind caught them.",
                            "target_lang_translations": {
                                "ru": "Паруса парусника начали <w>надуваться</w>, когда их поймал сильный ветер."
                            }
                        },
                        {
                            "text": "Her long dress would <w>billow</w> in the wind as she walked along the beach.",
                            "target_lang_translations": {
                                "ru": "Ее длинное платье <w>развевалось</w> на ветру, когда она шла по пляжу."
                            }
                        }
                    ],
                    "synonyms": [
                        "swell",
                        "bulge",
                        "puff"
                    ],
                    "antonyms": [
                        "deflate"
                    ],
                    "common_phrases": [
                        "billow in the wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздуваться, надуваться или выгибаться, особенно под воздействием ветра на ткань."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надуваться",
                                "target_lang_sense_clarification": "о парусах, одежде от ветра"
                            },
                            {
                                "target_lang_word": "развеваться",
                                "target_lang_sense_clarification": "о ткани на ветру"
                            },
                            {
                                "target_lang_word": "выпячиваться",
                                "target_lang_sense_clarification": "выгибаться наружу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a35d5533-912a-367d-b7ab-a4d48e2abc0f",
                    "sense_definition": "A large wave, swell, or undulating mass of something, such as water, smoke, or fabric.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat was tossed violently by a massive ocean <w>billow</w>.",
                            "target_lang_translations": {
                                "ru": "Маленькую лодку сильно швыряло на огромном океанском <w>валу</w>."
                            }
                        },
                        {
                            "text": "A great <w>billow</w> of dust rose behind the truck as it sped down the dirt road.",
                            "target_lang_translations": {
                                "ru": "Огромное <w>облако</w> пыли поднялось за грузовиком, когда он мчался по грунтовой дороге."
                            }
                        }
                    ],
                    "synonyms": [
                        "wave",
                        "swell",
                        "surge"
                    ],
                    "common_phrases": [
                        "ocean billow",
                        "billow of smoke"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Often used in the plural form 'billows' in literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая волна, вал или клубящаяся масса чего-либо (воды, дыма, ткани)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вал",
                                "target_lang_sense_clarification": "крупная волна"
                            },
                            {
                                "target_lang_word": "большая волна",
                                "target_lang_sense_clarification": "водная масса"
                            },
                            {
                                "target_lang_word": "клубы",
                                "target_lang_sense_clarification": "дыма, пыли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3dc189b4-a2d1-30e7-8539-c166c519ff5d",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local directory listed a family named <w>Billow</w> living on the corner of the street.",
                            "target_lang_translations": {
                                "ru": "В местном справочнике значилась семья по фамилии <w>Биллоу</w>, живущая на углу улицы."
                            }
                        },
                        {
                            "text": "We invited Mr. <w>Billow</w> to speak at our annual community meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Биллоу</w> выступить на нашем ежегодном собрании жителей."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Биллоу",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}