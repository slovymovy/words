                        "entry_id": "418bc8b1-ebe2-3f9b-a277-262c16cde751",
                        "glosses": [
                            "To dig or uproot; to scrape."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "39447f91-f6db-472e-8a29-1c0e1119bc5d",
                                "sense_id": "d30a32e7-3f8f-389e-899b-3f223d138b77",
                                "text": "I took my revenge on th' round-house, for I piggled all th' plaster off o' the walls that I could […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "664811e7-5309-3139-86a7-79552791d193",
                        "entry_id": "418bc8b1-ebe2-3f9b-a277-262c16cde751",
                        "glosses": [
                            "To toy or fiddle."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ee0558c4-0e18-4e11-92df-952ad48928bd",
                                "sense_id": "664811e7-5309-3139-86a7-79552791d193",
                                "text": "Then all nature was presently converted into an object for microscopic study, so that everything, whether near or far, must be piggled at and made clear to the utmost limit of human power."
                            },
                            {
                                "example_id": "c2c534bf-e5dc-4559-955f-f04083a6e2b5",
                                "sense_id": "664811e7-5309-3139-86a7-79552791d193",
                                "text": "Banford, at the other end of the table, said not a word, but piggled with the sardine on her plate."
                            }
                        ]
                    },
                    {
                        "sense_id": "13ba7c2f-f43c-3710-bb2a-734d3cf036ca",
                        "entry_id": "418bc8b1-ebe2-3f9b-a277-262c16cde751",
                        "glosses": [
                            "To cause to worry, to make uncomfortable; niggle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897eeb29-8273-4593-9754-0c2e838c5f47",
                                "sense_id": "13ba7c2f-f43c-3710-bb2a-734d3cf036ca",
                                "text": "BUDD. Get up yourself, and shut up, too! You have piggled me enough, you old smooty-snoot!"
                            }
                        ]
                    },
                    {
                        "sense_id": "6d5672cd-dff2-3025-b0ff-d369b2f10fee",
                        "entry_id": "418bc8b1-ebe2-3f9b-a277-262c16cde751",
                        "glosses": [
                            "To worry about minor points."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42992481-411e-41da-b6ef-a93b3d2d60aa",
                                "sense_id": "6d5672cd-dff2-3025-b0ff-d369b2f10fee",
                                "text": "But of what value is all that piggling, niggling, — you call the little thing piggling, niggling?"
                            }
                        ]
                    }
                ],
