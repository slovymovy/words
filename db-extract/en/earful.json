                        "examples": [
                            {
                                "example_id": "04cc53a3-f8e0-40b3-ad02-c4e9b7fe5e8a",
                                "sense_id": "122b19e5-68c3-30ba-a037-a5d6ee926628",
                                "text": "give someone an earful"
                            },
                            {
                                "example_id": "66199367-3253-4f1d-af29-92bfe35ea249",
                                "sense_id": "122b19e5-68c3-30ba-a037-a5d6ee926628",
                                "text": "Ivan Kruzliak had already taken an earful from Gary Neville at half-time and it was rare to see Hodgson as annoyed as he was while remonstrating with the fourth official."
                            }
                        ]
                    },
                    {
                        "sense_id": "2855ffcd-d52f-3537-b620-3cbbd0f638ef",
