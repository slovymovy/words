                "translations": [
                    {
                        "translation_id": "8bae5c2d-21dc-402e-bf60-6e15091163c5",
                        "source_entry_id": "446032b5-131c-3b20-95f4-c682298f2acb",
                        "source_sense_id": "67408236-827c-341a-a8a3-2910665fa443",
                        "source_sense_description": "een bril die de ogen beschermt",
                        "target_lang_word": "Schutzbrille",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schutzbrille",
