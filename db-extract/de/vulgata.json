                        "examples": [
                            {
                                "example_id": "93f20be0-d5cb-4803-8bda-8e1fd9546d1c",
                                "sense_id": "7a50a220-f4e3-3fb9-a187-ef4119e4e1a4",
                                "text": "Das Konzil von Trient erklärte 1546 die Vulgata für authentisch."
                            },
                            {
                                "example_id": "58ded706-4245-43d3-a3b3-d90baef4b293",
                                "sense_id": "7a50a220-f4e3-3fb9-a187-ef4119e4e1a4",
                                "text": "Die Vulgata löste die älteren lateinischen Texte – die Vetus Latina – ab."
                            },
                            {
                                "example_id": "5371ce78-7a3f-482c-ae38-f9b664e6ab37",
                                "sense_id": "7a50a220-f4e3-3fb9-a187-ef4119e4e1a4",
                                "text": "„Der Angelsachse begnügte sich mit sprachlichen Korrekturen am Text der Vulgata, während der Westgote tiefer in die textliche Gestaltung eingriff.“"
                            }
                        ],
