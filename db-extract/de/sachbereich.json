                "senses": [
                    {
                        "sense_id": "30b10587-4dcd-3d48-8ecf-07db6be29373",
                        "entry_id": "69085486-7979-3b71-bf69-820055deb516",
                        "glosses": [
                            "zu einem Begriff zusammengefasstes Arbeitsgebiet, das aus einer Sammlung von Themen und Akteuren zur gleichen inhaltlichen Thematik besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79063833-a74f-4d0c-9298-f7dd12e756d7",
                                "sense_id": "30b10587-4dcd-3d48-8ecf-07db6be29373",
                                "text": "„Echte Anglizismen und Amerikanismen, also direkte Entlehnungen aus dem Englischen, finden sich bei uns in allen Lebenslagen und Sachbereichen.“"
                            },
                            {
                                "example_id": "ffb1d39d-4220-4e16-aff4-b4fcaf2f1f7a",
                                "sense_id": "30b10587-4dcd-3d48-8ecf-07db6be29373",
                                "text": "„Das Bundesministerium für Gesundheit kann den Rat oder einzelne Mitglieder des Rates ersuchen, eine Kurzexpertise zu einem bestimmten Sachbereich zu verfassen.“"
                            },
                            {
                                "example_id": "af613fa1-87cb-4bb1-a1bf-be009225c63e",
                                "sense_id": "30b10587-4dcd-3d48-8ecf-07db6be29373",
                                "text": "„Denn in keinem anderen Sachbereich blockiert sich das aktuelle Regierungsbündnis so nachhaltig und verbissen wie in der Steuerpolitik.“"
                            },
                            {
                                "example_id": "ba11ab1e-cb9e-4fc1-a407-4e6fa7ac96c9",
                                "sense_id": "30b10587-4dcd-3d48-8ecf-07db6be29373",
                                "text": "„Der Arbeitgeber hat für jeden Arbeitnehmer in den Zuschlagszeiträumen von April bis November […] einen Zuschlag zum Lohn für den Sachbereich der Winterfeiertagsregelung zu entrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
