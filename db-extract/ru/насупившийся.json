                                        "entry_id": "61490d52-a5a3-3c5f-8f41-7ff0e2adedae",
                                        "glosses": [
                                            "present participle and gerund of frown"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9fe3482-8f6d-4dae-818e-fb7b7a17c229",
                                                "sense_id": "00591467-4c09-38f4-aacf-468fccb24436",
                                                "text": "Frowning heads are still gloomily shaken when the subject is raised on the NER, [...]."
                                            }
