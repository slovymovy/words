                ],
                "senses": [
                    {
                        "sense_id": "f2ad4d92-02b4-3305-a95e-0ffaa007a947",
                        "entry_id": "2f5e0bd8-bd48-3639-ac00-96cff4b59c67",
                        "glosses": [
                            "Flexion der deklinierbaren Wortarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a03f398-48d0-4188-b67c-da553134a967",
                                "sense_id": "f2ad4d92-02b4-3305-a95e-0ffaa007a947",
                                "text": "„Es weist Züge einer restflektierenden, aber auch einer agglutinierenden Sprache auf: Alle Kasus der Nominalflexion sind bis auf den Genitiv (einheitlich auf -s) verschwunden und im verbalen Bereich gibt es nur noch eine Einheitsflexion, die keine Kongruenzbeziehungen mehr in bezug auf Numerus oder Person aufweist.“"
                            },
                            {
                                "example_id": "ee048993-baff-410e-aaf0-e7113c7f9d25",
                                "sense_id": "f2ad4d92-02b4-3305-a95e-0ffaa007a947",
                                "text": "„Die obligatorische Doppelmarkierung ist auch dafür verantwortlich zu machen, daß in den slavischen Dialekten, in denen die Nominalflexion in Verfall geriet, der Lokativ als einer der ersten Kasus schwand.“"
                            },
                            {
                                "example_id": "188dbe92-2230-4e74-9db4-95c01f1c5a17",
                                "sense_id": "f2ad4d92-02b4-3305-a95e-0ffaa007a947",
                                "text": "„In der vorliegenden Untersuchung geht es darum, die Morphologie der Nominalflexion, verstanden als die Markierung von Numerus, Genus und Kasus, unter dem Gesichtspunkt darzustellen, daß es sich bei diesen Komplexen um Lerngegenstände handelt.“"
                            },
                            {
                                "example_id": "7352e2ef-6501-4c78-9a4e-895b7b7192dc",
                                "sense_id": "f2ad4d92-02b4-3305-a95e-0ffaa007a947",
                                "text": "„Unter Nominalflexion versteht man die Flexion von allen deklinierbaren Wortarten, d.h. Substantiven, Adjektiven, Pronomen und Artikeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
