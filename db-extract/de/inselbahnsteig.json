                        "glosses": [
                            "Bahnsteig, der sich zwischen zwei Gleisen befindet und von beiden Gleisen aus verwendet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e0a0d57-27fd-4445-9145-85f607b5ef80",
                                "sense_id": "c7d86164-198f-3e24-896d-bb2b0b912f2f",
                                "text": "„Der Hausbahnsteig wurde mit einer Länge von 160 Metern, der Inselbahnsteig mit einer Länge von 220 Metern errichtet.“"
                            },
                            {
                                "example_id": "44311011-2b19-4fb9-8651-ded461b17141",
                                "sense_id": "c7d86164-198f-3e24-896d-bb2b0b912f2f",
                                "text": "„Der Bahnhof erhält einen Personentunnel, der vom Vorplatz auf den Inselbahnsteig führt.“"
                            }
