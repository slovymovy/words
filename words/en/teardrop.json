{
    "word_family": [
        "tear",
        "drop",
        "teardrop-shaped"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa5b9cad-c0ea-3644-8b34-d7b7a8fc71de",
                    "sense_definition": "A single tear, which is the clear salty liquid produced by the eye.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A single <w>teardrop</w> rolled down her cheek as she said goodbye.",
                            "target_lang_translations": {
                                "ru": "Одинокая <w>слезинка</w> скатилась по её щеке, когда она прощалась."
                            }
                        },
                        {
                            "text": "He tried to hide his sadness, but a <w>teardrop</w> fell on the letter.",
                            "target_lang_translations": {
                                "ru": "Он пытался скрыть свою грусть, но <w>слеза</w> упала на письмо."
                            }
                        }
                    ],
                    "synonyms": [
                        "tear"
                    ],
                    "common_phrases": [
                        "single teardrop",
                        "teardrop fell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна слеза, прозрачная соленая жидкость, выделяемая глазом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слезинка",
                                "target_lang_sense_clarification": "одна капля слезы"
                            },
                            {
                                "target_lang_word": "слеза",
                                "target_lang_sense_clarification": "капля жидкости из глаза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b610c8e-a620-3293-98d8-b75eaa703924",
                    "sense_definition": "A shape that is rounded at the bottom and pointed at the top, like a falling drop of liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The necklace featured a beautiful <w>teardrop</w> pendant made of blue glass.",
                            "target_lang_translations": {
                                "ru": "Ожерелье украшала красивая <w>каплевидная</w> подвеска из синего стекла."
                            }
                        },
                        {
                            "text": "The designer chose a <w>teardrop</w> shape for the new car's headlights.",
                            "target_lang_translations": {
                                "ru": "Дизайнер выбрал форму <w>капли</w> для фар нового автомобиля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "teardrop shape",
                        "teardrop pendant",
                        "teardrop trailer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма, закругленная снизу и заостренная сверху, напоминающая падающую каплю жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каплевидный",
                                "target_lang_sense_clarification": "имеющий форму капли"
                            },
                            {
                                "target_lang_word": "в форме капли",
                                "target_lang_sense_clarification": "описание формы предмета"
                            },
                            {
                                "target_lang_word": "слеза",
                                "target_lang_sense_clarification": "о форме ювелирных изделий или деталей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}