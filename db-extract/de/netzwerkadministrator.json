                        "examples": [
                            {
                                "example_id": "1aa67e34-d822-4504-9a4a-e1f338739be1",
                                "sense_id": "66dd0bb2-9bae-3bea-b075-d758cda0a8de",
                                "text": "„Da war zum Beispiel der deutsche Elektrohandwerksbetrieb, dessen Netzwerkadministrator eine Liste mit den E-Mail-Nutzernamen und Passwörtern der eigenen Mitarbeiter in einem Textdokument gesichert hat - in einem offen am Netz hängenden Netzlaufwerk.“"
                            },
                            {
                                "example_id": "ca754501-513f-452f-84ce-64f84817be09",
                                "sense_id": "66dd0bb2-9bae-3bea-b075-d758cda0a8de",
                                "text": "„Auch der Netzwerkadministrator einer Versicherung will damit Flüchtlingen helfen: \"Mir würde was fehlen ohne Internetanschluss. Und für die Flüchtlinge ist es noch wichtiger.\"“"
                            }
                        ],
