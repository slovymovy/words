            "senses": [
                {
                    "sense_id": "1792f26c-8bfa-32ef-a624-890515d902c7",
                    "sense_definition": "The obligatory prayer performed five times a day by Muslims, representing the second pillar of Islam.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_practice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many believers gather at the mosque to perform their daily <w>salat</w> together.",
                            "target_lang_translations": {
                                "ru": "Многие верующие собираются в мечети, чтобы вместе совершить свой ежедневный <w>намаз</w>."
                            }
                        },
                        {
                            "text": "The timing of <w>salat</w> changes slightly throughout the year based on the position of the sun.",
                            "target_lang_translations": {
                                "ru": "Время <w>намаза</w> немного меняется в течение года в зависимости от положения солнца."
                            }
                        }
                    ],
                    "synonyms": [
                        "namaz"
                    ],
                    "common_phrases": [
                        "perform salat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обязательная молитва, совершаемая мусульманами пять раз в день, являющаяся вторым столпом ислама."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нама́з",
                                "target_lang_sense_clarification": "наиболее распространенный термин для обозначения мусульманской молитвы в русском языке"
                            },
                            {
                                "target_lang_word": "саля́т",
                                "target_lang_sense_clarification": "терминологический вариант, используемый в исламоведении"
                            }
                        ]
                    }
                }
            ]
        },
        {
