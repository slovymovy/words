                                "target_senses": [
                                    {
                                        "sense_id": "bfc9c13d-ab9c-3f82-9626-6790937ba70d",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "The course of a story, comprising a series of incidents which are gradually unfolded, sometimes by unexpected means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ea1a57d-ff61-4a2a-b229-ef2e7c37c25f",
                                                "sense_id": "bfc9c13d-ab9c-3f82-9626-6790937ba70d",
                                                "text": "If the plot or intrigue must be natural, and such as springs from the subject, then the winding up of the plot must be a probable consequence of all that went before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cadd631-5d81-3ad4-ad86-54394a9a916a",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "An area or land used for building on or planting on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "382e9984-2b13-38ac-995c-39474988dedf",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "A grave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aef824d-7918-4f64-a5b5-2e1a2d5444bf",
                                                "sense_id": "382e9984-2b13-38ac-995c-39474988dedf",
                                                "text": "He's buried in the family plot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a5991a-f01c-3760-9138-325518163881",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "A graph or diagram drawn by hand or produced by a mechanical or electronic device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7124e68f-a9df-4dcf-acf1-8c3b6f90c863",
                                                "sense_id": "63a5991a-f01c-3760-9138-325518163881",
                                                "text": "I was told to fly out on a vector of 100 degrees to meet a strong plot of aircraft 30 miles from the coast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e99a1e5-7c72-34cd-8145-98dd617ca55a",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "A secret plan to achieve an end, the end or means usually being illegal or otherwise questionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "579f22f1-1e79-470d-addd-7565cd37301b",
                                                "sense_id": "4e99a1e5-7c72-34cd-8145-98dd617ca55a",
                                                "text": "The plot would have enabled them to get a majority on the board."
                                            },
                                            {
                                                "example_id": "16b82c83-13f5-4238-958b-136f576adf3d",
                                                "sense_id": "4e99a1e5-7c72-34cd-8145-98dd617ca55a",
                                                "text": "The assassination of Lincoln was part of a larger plot."
                                            },
                                            {
                                                "example_id": "7446ecdb-5135-413f-b8da-5847952351d9",
                                                "sense_id": "4e99a1e5-7c72-34cd-8145-98dd617ca55a",
                                                "text": "I have o'erheard a plot of death."
                                            },
                                            {
                                                "example_id": "e18dab88-3ee8-4e2e-bd26-303ff64913c4",
                                                "sense_id": "4e99a1e5-7c72-34cd-8145-98dd617ca55a",
                                                "text": "O, think what anxious moments pass between / The birth of plots and their last fatal periods!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6418209f-a242-3aa0-8c11-7bb119ab99e9",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "Contrivance; deep reach thought; ability to plot or intrigue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d5ab3e8-9542-4375-9e4d-880c1aea2291",
                                                "sense_id": "6418209f-a242-3aa0-8c11-7bb119ab99e9",
                                                "text": "a man of much plot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891c2a0a-cea6-3083-9537-2332ffefc560",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "Participation in any stratagem or conspiracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269e6637-978a-40c0-899e-0d161343b4ec",
                                                "sense_id": "891c2a0a-cea6-3083-9537-2332ffefc560",
                                                "text": "And when Christ saith, Who marries the divorced commits adultery, it is to be understood, if he had any plot in the divorce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0d6176-1f8b-3e6a-9735-82f9721fe7d2",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "A plan; a purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fbb0fc7-04c8-40de-9807-dc92a8099a82",
                                                "sense_id": "cf0d6176-1f8b-3e6a-9735-82f9721fe7d2",
                                                "text": "no other plot in their religion but serve God and save their souls"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711fce5d-7b87-3a13-9e9c-bfdd84a353bb",
                                        "entry_id": "d69e22b6-4f07-3b88-8b89-7c7f2086dabc",
                                        "glosses": [
                                            "Attractive physical attributes of a fictional character; assets."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1a225d2-395a-44f7-a8b0-9483fbc4bf93",
                                                "sense_id": "711fce5d-7b87-3a13-9e9c-bfdd84a353bb",
                                                "text": "Actor X has some great plot near the end of E07."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5106376-c662-3747-b421-da5772f2c925",
                                        "entry_id": "9b0b4768-a5e1-374d-919f-25bf31599cd8",
                                        "glosses": [
                                            "To conceive (a crime, misdeed etc)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4007a60-a589-4ac8-ba66-985f385a1a8b",
                                                "sense_id": "b5106376-c662-3747-b421-da5772f2c925",
                                                "text": "They had plotted a robbery."
                                            },
                                            {
                                                "example_id": "70792ee3-d201-4fdc-bc81-6d1e5997efb8",
                                                "sense_id": "b5106376-c662-3747-b421-da5772f2c925",
                                                "text": "They were plotting against the king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88db75e4-971a-3632-bc25-e677870287c1",
                                        "entry_id": "9b0b4768-a5e1-374d-919f-25bf31599cd8",
                                        "glosses": [
                                            "To trace out (a graph or diagram)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ef80a5-e1c2-4d2f-bad6-63fef91d6145",
                                                "sense_id": "88db75e4-971a-3632-bc25-e677870287c1",
                                                "text": "They plotted the number of edits per day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb4cbb7-eccf-3af4-93f0-ca87f8d3f345",
                                        "entry_id": "9b0b4768-a5e1-374d-919f-25bf31599cd8",
                                        "glosses": [
                                            "To mark (a point on a graph, chart, etc)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0993e1e9-2cca-48cc-b1e1-fd8bd3c0c148",
                                                "sense_id": "5bb4cbb7-eccf-3af4-93f0-ca87f8d3f345",
                                                "text": "Every five minutes they plotted their position."
                                            },
                                            {
                                                "example_id": "4ae0eef1-a7b5-46b4-9e0d-8f7fc5d03c13",
                                                "sense_id": "5bb4cbb7-eccf-3af4-93f0-ca87f8d3f345",
                                                "text": "This treatise plotteth down Cornwall as it now standeth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc551baa-51d6-480e-814e-3ba421c19ed7",
                        "source_entry_id": "fd164009-1b6a-36b2-9cfc-3ad6d1cd877a",
                        "source_sense_id": "ac053dbb-9fe2-3519-81b6-7a04d34f0a93",
                        "target_lang_word": "tangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26a558f-2637-389d-a80c-8c83d1ee8d64",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To mix together or intertwine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To become mixed together or intertwined."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2873175a-a9e8-42b0-9a36-9782fdbb8323",
                                                "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                                "text": "Her hair was tangled from a day in the wind."
                                            },
                                            {
                                                "example_id": "a3f4607c-a914-4a3c-8f0d-70a91bec5fec",
                                                "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                                "text": "By the afternoon it seemed as if the storm had passed and that frost was setting in; but in the evening the wind rose to gale force, bringing telegraph poles down like skittles and tangling power and telephone lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To enter into an argument, conflict, dispute, or fight."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463a4562-367e-47ed-836a-bb2760cc2164",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "Don't tangle with someone three times your size."
                                            },
                                            {
                                                "example_id": "4be7dc12-caaa-4384-aaa9-a00be9e6f683",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "He tangled with the law."
                                            },
                                            {
                                                "example_id": "3df7ebef-7096-48ea-87b1-7b52d3bb8dc1",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "Compared to the last time they'd tangled with the U.S. Navy's carriers, the antiaircraft fire had been much, much more effective, even if the Wildcats hadn't done particularly well in their intercepts. They couldn't know it, of course, but the officer aboard Enterprise who'd recommended recarpeting the ship with 20-mm Oerlikons had, at least partially, been listened to, and the effect on the Japanese Navy's elite aircrews had been devastating."
                                            },
                                            {
                                                "example_id": "8ada5550-f47e-4471-b605-293858034888",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "After a few attempts at counseling, they separated in January 2015. Since then, they have tangled in the courts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To catch and hold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9bea344-16f0-4438-9561-9da2da70dba0",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "When my simple weakness strays, / Tangled in forbidden ways."
                                            },
                                            {
                                                "example_id": "2f74f1a2-157a-44e9-a435-3611c1fd767e",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "tangled in amorous nets"
                                            },
                                            {
                                                "example_id": "49b48468-190c-49e3-bfb7-3f62a5309334",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "This is a book about the potential for the reclamation, reform, and enlightened transformation of the most expansive elements of the liberal tradition— that social and economic justice remain tangled in liberalism's web of pretentious institutions and betrayed promises is the reason for this battle from within."
                                            },
                                            {
                                                "example_id": "8b8b2857-8ddb-485e-94c3-c4a3f5a59a54",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "He spent the night at a friend's place unable to sleep and wondering how he got himself tangled in this mess."
                                            },
                                            {
                                                "example_id": "920f38f2-53cf-429c-8b61-098d2dc16f8b",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "Why else would she have tangled him in spells of illusion to get him to keep her company?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b53a3ba3-7c8c-38f4-ac7b-0499b5959719",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A tangled twisted mass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A complicated or confused state or condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a36daac-eff2-4761-855e-c275b2865801",
                                                "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                                "text": "I tried to sort through this tangle and got nowhere."
                                            },
                                            {
                                                "example_id": "e28246bf-3502-4e1d-b989-19170689179f",
                                                "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b830b86a-ff44-37a5-8387-425fb4bcbb85",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "An argument, conflict, dispute, or fight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d61e7167-bc4c-3e92-a9e8-928b33bb359f",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A region of the projection of a knot such that the knot crosses its perimeter exactly four times."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3968af7c-f5b6-3e8f-a869-1bf0ba1268f8",
