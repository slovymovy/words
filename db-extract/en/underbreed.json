                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5423a12a-a135-4590-81ce-b0409107b00c",
                                "sense_id": "3a4bab28-a7e7-302c-ad91-7ceb8167a178",
                                "text": "Whether this political torrent is to be for good or bad for the country at large, whether it is going to breed statesmen or underbreed statesmanship, are points on which a physician need offer no opinion."
                            },
                            {
                                "example_id": "7cf71afd-28f1-49e1-9320-32bf5481576a",
                                "sense_id": "3a4bab28-a7e7-302c-ad91-7ceb8167a178",
                                "text": "It is just as hopeless to overbreed the under-cultured, as it is to underbreed the cultural."
                            },
                            {
                                "example_id": "76b1fae7-9425-405f-927d-6ddee5dd0cf3",
                                "sense_id": "3a4bab28-a7e7-302c-ad91-7ceb8167a178",
                                "text": "\"Some owners underbreed and lose out on making money,\" Gurrola said."
                            }
