                                "target_senses": [
                                    {
                                        "sense_id": "08054158-b06e-3ef7-a4f6-74d33c375090",
                                        "entry_id": "e720cf62-f12a-3766-92ee-30976ef19686",
                                        "glosses": [
                                            "japanisches alkoholisches Getränk, das aus mit Hefe vergorenem Reis hergestellt wird und heiß getrunken wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ad35f7-af03-48a4-9239-8c6b029d5c00",
                                                "sense_id": "08054158-b06e-3ef7-a4f6-74d33c375090",
                                                "text": "Zum Sushi tranken wir Sake."
                                            },
                                            {
                                                "example_id": "173c1f48-8ac6-4be0-9e0a-917550a64222",
                                                "sense_id": "08054158-b06e-3ef7-a4f6-74d33c375090",
                                                "text": "„Der Sake hielt mich warm.“"
                                            },
                                            {
                                                "example_id": "0583df08-fc27-428e-9905-e491cec345df",
                                                "sense_id": "08054158-b06e-3ef7-a4f6-74d33c375090",
                                                "text": "„Er roch ein wenig nach Sake, als er zu sprechen begann, und später erfuhr ich, dass er an diesem Morgen bis fünf Uhr getrunken hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
