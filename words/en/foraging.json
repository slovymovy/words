                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wild birds spent the entire morning <w>foraging</w> for seeds in the tall grass.",
                            "target_lang_translations": {
                                "ru": "Дикие птицы провели всё утро, <w>разыскивая</w> семена в высокой траве."
                            }
                        },
                        {
                            "text": "We saw several bears <w>foraging</w> along the riverbank before dusk.",
                            "target_lang_translations": {
                                "ru": "Перед сумерками мы увидели нескольких медведей, <w>искавших пищу</w> вдоль берега реки."
                            }
                        }
                    ],
                    "common_phrases": [
