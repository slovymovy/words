                            "target_lang_translations": {
                                "en": "The farmer made deep <w>furrows</w> in the earth to plant the seeds."
                            }
                        },
                        {
                            "text": "Er zaten kleine <w>rillen</w> in het oppervlak van de oude tafel.",
                            "target_lang_translations": {
                                "en": "There were small <w>grooves</w> in the surface of the old table."
                            }
