                    {
                        "sense_id": "ac977f46-c254-35c8-af52-176dd37e08f6",
                        "entry_id": "7d884f00-bebd-34b9-8593-c9d1bef69005",
                        "glosses": [
                            "stuk land dat men kan gebruiken om zaken te bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26192504-1ad0-4ad4-bcf4-f527d2e76639",
                                "sense_id": "ac977f46-c254-35c8-af52-176dd37e08f6",
                                "text": "Hun bestemming was Split City, een klein opslagterrein ongeveer zes kilometer buiten de bebouwde kom."
                            },
                            {
                                "example_id": "e39f7af9-11c7-4aeb-80d9-230e3f63e98b",
                                "sense_id": "ac977f46-c254-35c8-af52-176dd37e08f6",
                                "text": "Ook is een begin gemaakt met het weghalen van de auto's die bij de flat stonden. Alle beschadigde auto's worden naar een opslagterrein in Beetsterzwaag gebracht, waar schade-experts morgen aan het werk kunnen om de schade op te nemen."
                            },
                            {
                                "example_id": "044310cc-f368-487f-a1fc-dec85555140c",
                                "sense_id": "ac977f46-c254-35c8-af52-176dd37e08f6",
                                "text": "Het opslagterrein van Defensie in het Limburgse Eygelshoven wordt zaterdag overgedragen aan het Amerikaanse leger. Die gaat er rond de 1600 militaire voertuigen opslaan vanwege de \"verslechterde veiligheidssituatie in Europa\", aldus het ministerie van Defensie."
                            }
                        ]
                    }
