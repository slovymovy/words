                                        "glosses": [
                                            "Something opposite or contrary to something else."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "005583ee-dde7-3eb7-957c-a954c9b504e8",
                                        "entry_id": "36fbdfbe-8389-3271-865d-88cff35494e1",
                                        "glosses": [
                                            "A person or thing that is entirely different from or the reverse of someone or something else; used to show contrast between two people or two things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade162ae-f9c3-4b7e-9b87-b8b928bb9dcc",
                                                "sense_id": "005583ee-dde7-3eb7-957c-a954c9b504e8",
                                                "text": "She is the opposite of her ex-boyfriend who abused her both physically and verbally nearly every day for five years. She now works as an advocate and supportive listener for others who have endured abusive relationships."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b25fce9-4779-3afe-b98a-070f22c9927a",
                                        "entry_id": "36fbdfbe-8389-3271-865d-88cff35494e1",
