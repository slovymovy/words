                "senses": [
                    {
                        "sense_id": "62a4802e-2dbf-3484-b4e5-a180abf246ab",
                        "entry_id": "9725c710-c284-33c6-b9f9-65f1b1465aca",
                        "glosses": [
                            "Donner un caractère ivoirien, ou plus ivoirien, à"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29427721-df5d-40be-9547-89ab868584da",
                                "sense_id": "62a4802e-2dbf-3484-b4e5-a180abf246ab",
                                "text": "Un personnel de contrepartie local sera nommé tant à la SODEFOR qu’au Ministère afin de pouvoir ivoirianiser ces postes a la fin de la période d’exécution du projet."
                            },
                            {
                                "example_id": "109f330c-36b9-4440-8639-dd12d81a076d",
                                "sense_id": "62a4802e-2dbf-3484-b4e5-a180abf246ab",
                                "text": "C’est une chance d’avoir accès à ces langues, il faut arrêter de dire qu’elles continuent de perpétrer la colonisation, d’autant que ça fait longtemps que notre français est ivoirianisé, par exemple."
                            },
                            {
                                "example_id": "fb872062-af0f-4808-913d-4cf816eff1ca",
                                "sense_id": "62a4802e-2dbf-3484-b4e5-a180abf246ab",
                                "text": "On aurait dû ivoirianiser l'armée algérienne pour se venger !"
                            }
                        ]
                    }
