                                            {
                                                "example_id": "d58d9bc4-2246-4797-93d5-a02479fcdc30",
                                                "sense_id": "f316eb81-08d5-3eca-b712-68ce474c1b26",
                                                "text": "Il l’a menée à Longchamp d’où elle est revenue avec une de ses violentes migraines habituelles, qu’il lui a conseillé d’aller soigner en Angleterre."
                                            }
                                        ]
                                    },
