                "senses": [
                    {
                        "sense_id": "f9d49127-5d4d-3c0c-979a-645e80c356b6",
                        "entry_id": "f822c492-d11d-376e-b4cb-152832e77b00",
                        "glosses": [
                            "zawierający elementy o różnym pochodzeniu lub cechach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c7ece1-cbfa-4b28-a1d6-fae7bb3ce8c4",
                                "sense_id": "f9d49127-5d4d-3c0c-979a-645e80c356b6",
                                "text": "Złożoność tych interakcji czyni cząstki HDL wielce heterogennymi poprzez ich kształt, wielkość i ładunek powierzchniowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad08ddd4-fb3f-4a7f-8eda-ea8980f39b9d",
                        "source_entry_id": "f822c492-d11d-376e-b4cb-152832e77b00",
                        "source_sense_id": "f9d49127-5d4d-3c0c-979a-645e80c356b6",
                        "target_lang_word": "heterogeneous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heterogeneous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Diverse in kind or nature; composed of diverse parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "984df843-f9c1-4990-ad16-ce013c74e2a2",
                                                "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                                "text": "He had a large and heterogeneous collection of books."
                                            },
                                            {
                                                "example_id": "42393dbf-d686-4b5e-81c7-a8c6683ca7c1",
                                                "sense_id": "6669e8aa-b635-30df-be0d-55085dfd3757",
                                                "text": "With a vague curiosity I began to trace the outline of some of the heterogeneous impressions, trying meanwhile to curb the flights of macabre fancy which the place and its memories suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0e2710c-c75f-3d10-a081-0cb6331014c9",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Incommensurable because of different kinds."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bffacdb-1649-388e-a63c-0d7b4c23451e",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Having more than one phase (solid, liquid, gas) present in a system or process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61322d13-2f1e-36d1-8ccd-bcac8dcb064d",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Visibly consisting of different components."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "560b5b6a-b848-3f6b-a7da-ad9b9d5a8ce3",
                                        "entry_id": "f994cf70-c2a1-3bf3-b74b-061cdc553760",
                                        "glosses": [
                                            "Of a network comprising different types of computers, potentially with vastly differing memory sizes, processing power and even basic underlying architecture; alternatively, of a data resource with multiple types of formats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "160fa1c8-f08f-4bfe-ba1b-ec274537c521",
                        "source_entry_id": "f822c492-d11d-376e-b4cb-152832e77b00",
                        "source_sense_id": "f9d49127-5d4d-3c0c-979a-645e80c356b6",
