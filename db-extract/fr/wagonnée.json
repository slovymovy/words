                "senses": [
                    {
                        "sense_id": "e98cf66d-3019-3743-8e2c-d441f275ac0a",
                        "entry_id": "06aa2859-84d8-3540-82ff-d3125e10f7aa",
                        "glosses": [
                            "Contenu d’un wagon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a23f149d-f242-4a52-baad-74d1e2e7262e",
                                "sense_id": "e98cf66d-3019-3743-8e2c-d441f275ac0a",
                                "text": "Un jour il apprit qu’on en expédiait une wagonnée entière en gare des Aubrais, à vingt kilomètres de sa paroisse, et il en eut le coeur ulcéré."
                            },
                            {
                                "example_id": "c6869234-ad59-4f8c-922e-4ff3c0699ac4",
                                "sense_id": "e98cf66d-3019-3743-8e2c-d441f275ac0a",
                                "text": "Ils lurent à haute voix, pour toute la wagonnée et je vous prie de croire qu’on ne trouva plus l’arrêt trop long."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c124e14-747c-4231-a1d1-979e01d209c3",
                        "source_entry_id": "06aa2859-84d8-3540-82ff-d3125e10f7aa",
                        "source_sense_id": "e98cf66d-3019-3743-8e2c-d441f275ac0a",
