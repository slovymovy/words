                ],
                "senses": [
                    {
                        "sense_id": "595cfec0-d1f4-3ec7-b7be-38bcf5e7a9c1",
                        "entry_id": "9521c6bc-f6fc-36bb-82c5-592029451389",
                        "glosses": [
                            "Küste, die am Schwarzen Meer liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a8422d-3a88-4b05-9053-bfaa6854ca03",
                                "sense_id": "595cfec0-d1f4-3ec7-b7be-38bcf5e7a9c1",
                                "text": "„Nansen und Quisling nahmen auch die Pipeline in Augenschein, durch die seit der Jahrhundertwende Öl von Baku, wo die größten Ölfelder der Welt lagen, an die Schwarzmeerküste transportiert wurde.“"
                            },
                            {
                                "example_id": "2b5fc85f-1947-41fc-9de1-74b58ea9d7a7",
                                "sense_id": "595cfec0-d1f4-3ec7-b7be-38bcf5e7a9c1",
                                "text": "„Nirgendwo sonst in Europa sind Hotel und Bier am Strand billiger zu haben als an der bulgarischen Schwarzmeerküste.“"
                            },
                            {
                                "example_id": "97dd0392-4992-4232-a8a5-a60e8f9ebd9f",
                                "sense_id": "595cfec0-d1f4-3ec7-b7be-38bcf5e7a9c1",
                                "text": "„An der östlichen Schwarzmeerküste ist Erdogan ein Ja zur umstrittenen Verfassungsänderung sicher.“"
                            },
                            {
                                "example_id": "c0ce8df1-8e09-4612-b4fd-085c18fb929a",
                                "sense_id": "595cfec0-d1f4-3ec7-b7be-38bcf5e7a9c1",
                                "text": "„Jordan Hristov besitzt mehrere Hotels in Primorsko, und hier im Süden der bulgarischen Schwarzmeerküste, wo man die Türkei schon erahnen kann, ist diese Küste eine wildere als im Norden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
