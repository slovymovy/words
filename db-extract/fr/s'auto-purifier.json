                ],
                "senses": [
                    {
                        "sense_id": "912f0c28-1344-31e2-b7a7-2951ba38d985",
                        "entry_id": "25037a1e-a5c9-35fa-9ccf-e148dea75e99",
                        "glosses": [
                            "Se purifier par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dddda7fd-8e14-41b2-8456-27a002ceab0b",
                                "sense_id": "912f0c28-1344-31e2-b7a7-2951ba38d985",
                                "text": "Cette réaction fait honneur à la République tchèque et à sa classe politique qui possède la capacité de s'auto-purifier."
                            },
                            {
                                "example_id": "d1882e55-b992-48f7-b6c6-47bf4d589770",
                                "sense_id": "912f0c28-1344-31e2-b7a7-2951ba38d985",
                                "text": "Il pratiquait de rigoureux jeûnes sur de longues périodes, pour s'auto-purifier mais aussi comme moyen de protestation, d'influence et de réforme chez autrui."
                            },
                            {
                                "example_id": "091c5be9-dc9c-41eb-b621-89c8598fbbdb",
                                "sense_id": "912f0c28-1344-31e2-b7a7-2951ba38d985",
                                "text": "Dans son état originel, la forme physique était censée s'auto-purifier, s'auto-régénérer et s'auto-transfigurer."
                            }
                        ]
                    }
                ],
