                    {
                        "translation_id": "1038562a-4f96-4e33-a90b-108230fb78b1",
                        "source_entry_id": "18f363e0-2e2a-31b0-8bf9-f633c1a86b4e",
                        "source_sense_id": "78f055e6-a044-3f8d-a49a-4c43eee5b0dd",
                        "target_lang_word": "monotheistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monotheistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                        "entry_id": "85d1ebdd-dfc1-3835-a118-e9988adc7a5e",
                                        "glosses": [
                                            "sich auf den Monotheismus beziehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b5e1dc1-a70b-42a8-b4b2-198c88e6e373",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Demzufolge wären die drei monotheistischen Religionen gleichgeartet, und der demokratische Staat müsste nur danach trachten, jeglicher Glaubensrichtung neutral gegenüberzustehen.“"
                                            },
                                            {
                                                "example_id": "16520ccc-d6a3-43c7-98bf-c9d35843d243",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Der Papst sprach sich für die freie Religionsausübung aller drei großen monotheistischen Glaubensrichtungen in der für sie heiligen Stadt Jerusalem aus:“"
                                            },
                                            {
                                                "example_id": "7119ea3a-af9c-42d7-a22e-4018d4f25d63",
                                                "sense_id": "50b2e7ce-93b9-3368-a684-869755ef3ab2",
                                                "text": "„Ob im alten Ägypten, im alten China oder in der biblischen Genesis, in welcher der monotheistische Gott dem Menschen bei dessen Erschaffung den Odem des Lebens einhaucht: Die Seele hat Eigenschaften des Atems, des Windes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0104f7a-4b35-4568-98c6-792c9d12bed4",
                        "source_entry_id": "18f363e0-2e2a-31b0-8bf9-f633c1a86b4e",
                        "source_sense_id": "78f055e6-a044-3f8d-a49a-4c43eee5b0dd",
                        "target_lang_word": "монотеистический",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "монотеистический",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ab06b7cd-00b2-348e-b9c4-1fd836314a3e",
                                        "entry_id": "eb33e47e-4a15-3d50-b2bf-a5fbedc49941",
                                        "glosses": [
                                            "религ. имеющий отношение к монотеизму"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c2a41fc-cd2e-428c-9e5c-3539c1cd17fb",
                                                "sense_id": "ab06b7cd-00b2-348e-b9c4-1fd836314a3e",
                                                "text": "Становившиеся очевидными тщетность и суетность грандиозных забот о земном доме для умершего привели к зарождению представлений о небесном суде по окончании земного существования и к осознанию необходимости праведности жизни. Эти идеи, созвучные фундаментальным понятиям крупнейших монотеистических конфессий ― иудаизма, христианства и ислама, во многом предопределили отношение к смерти и особенности погребальных обрядов."
                                            },
                                            {
                                                "example_id": "f942bff5-5701-42a6-b991-d63fe01d32d3",
                                                "sense_id": "ab06b7cd-00b2-348e-b9c4-1fd836314a3e",
                                                "text": "Библия, возвышая Иосию над другими царями Иудеи, не скрывает, что его отец и дед потакали идолопоклонству, отменив монотеистические реформы прадеда ― царя Езекии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
