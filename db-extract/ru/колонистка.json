                "senses": [
                    {
                        "sense_id": "716c8d9a-28ab-3fbe-9b27-b7ef43f6a625",
                        "entry_id": "9d685249-243d-353c-b0c2-a6dceb0d3201",
                        "glosses": [
                            "женск. к колонист, жительница переселенческой колонии; переселенка из другой страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d3ab2d-1839-43f3-a17a-8162c2b9c7bf",
                                "sense_id": "716c8d9a-28ab-3fbe-9b27-b7ef43f6a625",
                                "text": "Колонист тщательно выбрит, одежда у него немецкого покроя, а колонистки являются в город, на рынок, в неизбежных чепчиках."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
