                "senses": [
                    {
                        "sense_id": "38640ff2-3837-37ec-a332-b7c147181816",
                        "entry_id": "abce8d96-d671-3a68-b1c7-955c1623afd2",
                        "glosses": [
                            "Session de formation de haut niveau dispensée par un artiste dont l’autorité est reconnue dans une discipline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ba2231-964d-42ad-af87-7e3d71b1ab10",
                                "sense_id": "38640ff2-3837-37ec-a332-b7c147181816",
                                "text": "La deuxième masterclass, dédiée à la cuvée Dom Ruinart et animée par l’œnologue Florence Boubée-Legrand, nous a montré ce qui définit une maison de luxe : l’attention à chaque détail."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd70a89f-15ac-30a3-8632-b921baaa23a3",
                        "entry_id": "abce8d96-d671-3a68-b1c7-955c1623afd2",
                        "glosses": [
                            "Action ou performance virtuose démontrant la maitrise brillante d’un sujet par une personne."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "72202ea9-f199-471f-9359-f4450a5c5963",
                                "sense_id": "fd70a89f-15ac-30a3-8632-b921baaa23a3",
                                "text": "Les Wolves ont répondu quatre minutes plus tard par Leander Dendoncker, mais De Bruyne a ajouté trois autres buts dans une masterclass de quatre buts, avant que Raheem Sterling n'achève la déroute."
                            }
                        ]
                    }
                ],
