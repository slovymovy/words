                ],
                "senses": [
                    {
                        "sense_id": "204135ef-bcb9-3b8b-9c17-e2ea6d0c7cdd",
                        "entry_id": "ddfa4f21-c518-3c21-bd53-f0e2a924affe",
                        "glosses": [
                            "Verkehrsmittel zur Beförderung von einer größeren Gruppe von Personen, welches auf einer über größere Distanzen verlaufenden Route/Linie zwischen verschiedenen Orten eingesetzt wird"
                        ],
                        "tags": [
                            "Verkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "3cb67ab5-a567-404a-835c-a69459ca8875",
                                "sense_id": "204135ef-bcb9-3b8b-9c17-e2ea6d0c7cdd",
                                "text": "„Für Reisen zwischen deutschen Städten sollen Fahrgäste bald bundesweit in Fernbusse steigen können – als neue Konkurrenz zu Pkw, Bahn und Billigfliegern.“"
                            },
                            {
                                "example_id": "1106868e-1f6d-49bf-82d7-1d187bf80409",
                                "sense_id": "204135ef-bcb9-3b8b-9c17-e2ea6d0c7cdd",
                                "text": "„Das Unternehmen DeinBus.de hatte die strikten Gesetzesvorgaben umschifft, indem es Fahrten mit Fernbussen als eine Art Mitfahrzentrale organisierte.“"
                            },
                            {
                                "example_id": "7bf89ac3-3efb-4eb3-914a-118930114422",
                                "sense_id": "204135ef-bcb9-3b8b-9c17-e2ea6d0c7cdd",
                                "text": "„Grundsätzlich soll der Fernbus deshalb erst ab einer Strecke von 50 Kilometern von klar festgelegten Haltestellen verkehren dürfen.“"
                            },
                            {
                                "example_id": "c9fe28b5-92a7-4311-9796-1ee10a629305",
                                "sense_id": "204135ef-bcb9-3b8b-9c17-e2ea6d0c7cdd",
                                "text": "„Der Fernbus muss erst noch beweisen, dass er im großflächigen Linienverkehr so gute Werte wie das umweltfreundlichste Verkehrsmittel, die Eisenbahn, erzielen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
