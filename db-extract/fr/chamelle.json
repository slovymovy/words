        "fr-extract.jsonl": [
            {
                "entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                "word": "chamelle",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6ba8775e-3220-48a0-b976-b1833cfe8fae",
                        "entry_id": "e1717f12-aeea-3e05-af39-4a9db2484383",
                        "tags": [
