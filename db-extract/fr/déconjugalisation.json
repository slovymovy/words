                        "sense_id": "53690e55-5956-3eec-bce5-a445bf68417f",
                        "entry_id": "b4d61ed9-cd2e-3991-89a3-c691b45a2577",
                        "glosses": [
                            "Action de déconjugaliser ; résultat de cette action.",
                            "Processus de destruction du lien conjugal, de désengagement conjugal ou de réadaptation après la disparition du couple et la fin de la vie conjugale."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0fcb5310-8d45-4704-addd-a971e8065653",
                                "sense_id": "53690e55-5956-3eec-bce5-a445bf68417f",
                                "text": "Leur objet était d’appréhender le processus de déconjugalisation, ses étapes, les ressources mobilisées pour y parvenir, pour le réussir."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f91c4e-4ff0-3890-8972-588373ea0c39",
                        "entry_id": "b4d61ed9-cd2e-3991-89a3-c691b45a2577",
                        "glosses": [
                            "Action de déconjugaliser ; résultat de cette action.",
                            "Fait de ne pas prendre en compte, dans le calcul d’une allocation ou d’une prestation, les revenus du conjoint ou de la conjointe du bénéficiaire."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "95e4b37b-59c0-4972-9f24-b34d17a03b40",
                                "sense_id": "30f91c4e-4ff0-3890-8972-588373ea0c39",
                                "text": "L’Assemblée nationale a rejeté une nouvelle fois, jeudi 7 octobre, l’« individualisation » de l’allocation aux adultes handicapés (AAH) des personnes vivant en couple, au terme d’un débat mouvementé. Des Républicains (LR) à La France insoumise (LFI), l’opposition réclamait à l’unisson cette « déconjugalisation » de l’allocation, afin de ne plus tenir compte, dans son calcul, des revenus du conjoint."
                            }
                        ]
                    }
