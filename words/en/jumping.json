        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "59b1fc22-78e7-3d7d-87ca-71e5f7bf783c",
                    "sense_definition": "Exuberantly active; in full swing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By midnight, the club was <w>jumping</w> with people dancing everywhere.",
                            "target_lang_translations": {
                                "ru": "К полуночи клуб <w>ходил ходуном</w> от танцующих повсюду людей.",
                                "zh": "午夜时分，俱乐部里到处都是跳舞的人，显得非常<w>热闹</w>。",
                                "nl": "Tegen middernacht was de club <w>bruisend</w> met overal dansende mensen.",
                                "pl": "O północy klub <w>tętnił życiem</w>, a wszędzie tańczyli ludzie.",
                                "de": "Um Mitternacht <w>ging es im Club hoch her</w>, überall tanzten Leute.",
                                "fr": "À minuit, le club était <w>en pleine effervescence</w> avec des gens qui dansaient partout.",
                                "it": "A mezzanotte, il locale era <w>animatissimo</w> con gente che ballava ovunque.",
                                "cs": "O půlnoci byl klub <w>živý</w> a všude tančili lidé.",
                                "tr": "Gece yarısına doğru kulüp, her yerde dans eden insanlarla çok <w>hareketliydi</w>.",
                                "es": "A medianoche, el club estaba <w>muy animado</w> con gente bailando por todas partes."
                            }
                        },
                        {
                            "text": "We looked for a <w>jumping</w> spot to celebrate the victory.",
                            "target_lang_translations": {
                                "ru": "Мы искали <w>оживленное</w> место, чтобы отпраздновать победу.",
                                "zh": "我们找了一个<w>热闹</w>的地方来庆祝胜利。",
                                "nl": "We zochten naar een <w>levendige</w> plek om de overwinning te vieren.",
                                "pl": "Szukaliśmy <w>ożywionego</w> miejsca, żeby uczcić zwycięstwo.",
                                "de": "Wir suchten nach einem <w>lebhaften</w> Ort, um den Sieg zu feiern.",
                                "fr": "Nous avons cherché un endroit <w>très animé</w> pour fêter la victoire.",
                                "it": "Abbiamo cercato un posto <w>vivace</w> per festeggiare la vittoria.",
                                "cs": "Hledali jsme <w>rušné</w> místo, kde bychom oslavili vítězství.",
                                "tr": "Zaferi kutlamak için <w>canlı</w> bir mekan aradık.",
                                "es": "Buscamos un lugar <w>animado</w> para celebrar la victoria."
                            }
