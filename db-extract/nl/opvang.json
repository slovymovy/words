                "senses": [
                    {
                        "sense_id": "29eb66a2-62fb-3799-b5df-56706f699b74",
                        "entry_id": "17eea17b-b99d-320e-8f4d-193f6bf6f744",
                        "glosses": [
                            "het verzorgen van kinderen op de uren dat de ouders dat niet zelf kunnen doen, kinderopvang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c07106-8a27-4dc0-b6c4-da94182c0fb0",
                                "sense_id": "29eb66a2-62fb-3799-b5df-56706f699b74",
                                "text": "De buitenschoolse opvang is een plek waar kinderen na schooltijd hun vrije tijd doorbrengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "654c67da-6c88-3483-b12b-32e9de04ff8c",
                        "entry_id": "17eea17b-b99d-320e-8f4d-193f6bf6f744",
                        "glosses": [
                            "het opvangen en hulp verlenen aan dieren of mensen in nood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0d7cc8-0092-45f8-bbc2-f8360ba0903f",
                                "sense_id": "654c67da-6c88-3483-b12b-32e9de04ff8c",
                                "text": "De regering heeft geld uitgetrokken voor de eerste opvang van de slachtoffers van de aarbeving."
                            },
                            {
                                "example_id": "7c0ffd45-e37a-4116-a641-3c10cf08acd8",
                                "sense_id": "654c67da-6c88-3483-b12b-32e9de04ff8c",
                                "text": "Met de vrijlating van de laatste twee aangesterkte zeehonden Ollie en Brandy heeft de opvang in Pieterburen gisteren een punt gezet achter meer dan vijftig jaar geschiedenis. Toch zijn de bassins in het centrum nog niet helemaal leeg. Er zwemmen nog een paar dagen dieren rond die te verzwakt zijn om uit te zetten."
                            }
                        ]
                    }
                ],
