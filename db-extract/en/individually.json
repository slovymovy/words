                                    {
                                        "sense_id": "9a955799-e208-37ac-82d4-0922e9b896f8",
                                        "entry_id": "dc7619c4-3b12-3a5b-8bd4-49c980b7babd",
                                        "glosses": [
                                            "auf das Individuum, den einzelnen Menschen bezogen (auch übertragen zu anderen Gegenständen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef27aec-77ea-4ad7-98c3-cf48111d5726",
                                                "sense_id": "9a955799-e208-37ac-82d4-0922e9b896f8",
                                                "text": "„Sie arbeiten in Kleingruppen und werden von Mentoren individuell betreut.“"
                                            },
                                            {
                                                "example_id": "9f008b09-f449-4786-a70a-f38b99c41ade",
                                                "sense_id": "9a955799-e208-37ac-82d4-0922e9b896f8",
                                                "text": "Man soll jedes Problem früh erkennen und es individuell lösen, bevor es zu spät wird."
                                            },
                                            {
                                                "example_id": "6c8e75fa-8c23-48d3-a1ac-1813f8fc814b",
                                                "sense_id": "9a955799-e208-37ac-82d4-0922e9b896f8",
                                                "text": "In diesem Zimmer gibt es drei Lichter, die man individuell an- und ausschalten kann."
                                            },
                                            {
                                                "example_id": "0afc7515-e05a-47ee-af4c-8080b0b3b454",
                                                "sense_id": "9a955799-e208-37ac-82d4-0922e9b896f8",
                                                "text": "„Eine gebundene Handschrift zu erlernen, sei ein elementarer individueller Lernprozess für jedes Kind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5d139d6-4614-3d2b-a459-a3e16b74ea9b",
                                        "entry_id": "dc7619c4-3b12-3a5b-8bd4-49c980b7babd",
                                        "glosses": [
                                            "personalisiert, auf die Individualität abgestimmt, die Persönlichkeit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a309b6-3a68-432c-9caf-68cff978d66e",
                                                "sense_id": "a5d139d6-4614-3d2b-a459-a3e16b74ea9b",
                                                "text": "„Eine gebundene Handschrift zu erlernen, sei ein elementarer individueller Lernprozess für jedes Kind.“"
                                            },
                                            {
                                                "example_id": "a1cfd16e-8020-4cdf-b820-d215340c1f1a",
                                                "sense_id": "a5d139d6-4614-3d2b-a459-a3e16b74ea9b",
                                                "text": "„Da ist ein Einzelner, der versucht etwas, was ihm Spaß macht, ganz individuell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
