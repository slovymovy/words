                "senses": [
                    {
                        "sense_id": "27560d47-2a1b-3c08-8411-a717a3da6999",
                        "entry_id": "33541b43-0e29-361e-8290-42c01f85a83d",
                        "glosses": [
                            "Faire perdre son caractère littéral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a54390-46bc-4d0d-9096-9cd708013e33",
                                "sense_id": "27560d47-2a1b-3c08-8411-a717a3da6999",
                                "text": "Si l’on compare Kahane et Couturier, Kahane semble délittéraliser l’original en l’explicitant, Couturier, à l’inverse, semble le relittéraliser en lui redonnant sa forme implicite."
                            },
                            {
                                "example_id": "fe4b213e-e671-4ad0-8e48-696070c98ff3",
                                "sense_id": "27560d47-2a1b-3c08-8411-a717a3da6999",
                                "text": "Dans tous les cas, le pathos implique le constat d’une identité qu’il faut délittéraliser."
                            }
                        ]
                    }
                ],
