                "senses": [
                    {
                        "sense_id": "cd6ef422-e13e-338b-ae8b-370385d8cfaa",
                        "entry_id": "67760b56-edf6-3bc3-ad78-145f3535a843",
                        "glosses": [
                            "Synonyme de arachique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb424043-4137-491f-9fab-7d1857b32201",
                                "sense_id": "cd6ef422-e13e-338b-ae8b-370385d8cfaa",
                                "text": "Acide arachidique: nom vernaculaire de l'acide eicosanoïque, un acide gras saturé dont la chaîne aliphatique comporte 20 atomes de carbone, de formule semi-développée CH₃(CH₂)₁₈COOH (formule standard selon la terminologie des lipides simples: C20:0)."
                            },
                            {
                                "example_id": "7ecf51e7-03b6-4930-a2a3-6d426b29fb3e",
                                "sense_id": "cd6ef422-e13e-338b-ae8b-370385d8cfaa",
                                "text": "L'acide arachidique, nom vernaculaire de l'acide eicosanoïque, est l'un des acides gras et autres lipides que l'on retrouve en abondance dans diverses huiles végétales telles l'huile d'arachide, dans les huiles de divers poissons, etc."
                            },
                            {
                                "example_id": "07277889-e8ea-4e36-b1fc-2141624571a9",
                                "sense_id": "cd6ef422-e13e-338b-ae8b-370385d8cfaa",
                                "text": "L'acide arachidique est saponifiable comme tous les acides gras saturés, avec des bases fortes telle la soude caustique (NaOH), l'hydroxyde de baryum (Ba(OH)₂), ou l'ammoniaque ((NH₄OH)."
                            }
                        ]
                    }
