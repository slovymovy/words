{
    "word_family": [
        "adverse",
        "adversely",
        "adversary",
        "adversarial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1b30c85-8cf0-3f35-9be0-7c210397f9d5",
                    "sense_definition": "A state of hardship, misfortune, or difficult circumstances that one must face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hardship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed great courage and determination while facing <w>adversity</w> during her long recovery from the accident.",
                            "target_lang_translations": {
                                "ru": "Она проявила огромное мужество и решимость, столкнувшись с <w>невзгодами</w> во время долгого восстановления после аварии."
                            }
                        },
                        {
                            "text": "True friends are those who stay by your side and help you overcome <w>adversity</w> when times get tough.",
                            "target_lang_translations": {
                                "ru": "Настоящие друзья — это те, кто остается рядом и помогает преодолевать <w>трудности</w>, когда наступают тяжелые времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "misfortune",
                        "hard luck",
                        "unluckiness"
                    ],
                    "common_phrases": [
                        "overcome adversity",
                        "face adversity",
                        "triumph over adversity",
                        "in the face of adversity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние лишений, неудач или трудных обстоятельств, с которыми человеку приходится сталкиваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невзгоды",
                                "target_lang_sense_clarification": "жизненные трудности и испытания"
                            },
                            {
                                "target_lang_word": "трудности",
                                "target_lang_sense_clarification": "препятствия и тяжелые условия"
                            },
                            {
                                "target_lang_word": "несчастья",
                                "target_lang_sense_clarification": "череда неблагоприятных событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36bced25-9416-36af-86c9-317b80cb2894",
                    "sense_definition": "A specific unfortunate event or a calamity that causes distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "hardship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loss of his job was a major <w>adversity</w> that forced the family to move to a smaller house.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря работы стала серьезным <w>несчастьем</w>, которое вынудило семью переехать в дом поменьше."
                            }
                        },
                        {
                            "text": "Every family is struck by <w>adversity</w> at one time or another, regardless of their social status.",
                            "target_lang_translations": {
                                "ru": "Каждая семья рано или поздно сталкивается с <w>бедой</w>, независимо от их социального статуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "mishap",
                        "mischance",
                        "misfortune"
                    ],
                    "common_phrases": [
                        "struck by adversity",
                        "sudden adversity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное неблагоприятное событие или бедствие, причиняющее страдания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "крайне тяжелое или неприятное событие"
                            },
                            {
                                "target_lang_word": "несчастье",
                                "target_lang_sense_clarification": "горестное событие или случай"
                            },
                            {
                                "target_lang_word": "бедствие",
                                "target_lang_sense_clarification": "катастрофическая ситуация или крупная неудача"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
