                "senses": [
                    {
                        "sense_id": "0207ce00-39e5-3639-9063-915c43aaec15",
                        "entry_id": "223e2542-f2d2-3fbd-9133-712830e9b413",
                        "glosses": [
                            "Ensemble de la progéniture d’une personne ou d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a5cf0d-8025-4c65-a2a9-18bfd608e0e0",
                                "sense_id": "0207ce00-39e5-3639-9063-915c43aaec15",
                                "text": "Il n'était pas de bon ton de les voir au comptoir et le chef de famille n'était pas peu fier d'une suitée anémiée par la claustration et la sousalimentation mais qui avait pu échapper à la promiscuité des usines."
                            },
                            {
                                "example_id": "878e74d6-2f8b-4f91-a27a-ea0984d5d9b5",
                                "sense_id": "0207ce00-39e5-3639-9063-915c43aaec15",
                                "text": "Quand accompagnée de sa suitée, elle croisait une assemblée quelconque, son mot était rituel : « Je sors mes poules, rentrez vos coqs »."
                            }
                        ]
                    }
