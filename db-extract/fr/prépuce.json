                    {
                        "sense_id": "687cc334-d44b-3dc4-b221-db052a66d11f",
                        "entry_id": "66c41b31-3141-384f-a848-fdd66ca97c48",
                        "glosses": [
                            "Le repli mobile de peau et de muqueuse coulissant et non roulant, qui couvre plus ou moins le gland du pénis de l'homme et le protège à l’état de flaccidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eeecbb0-0135-4421-8036-857db839cb2d",
                                "sense_id": "687cc334-d44b-3dc4-b221-db052a66d11f",
                                "text": "Astrologues, guérisseurs et chamanes avaient été consultés, on lui avait prescrit d’avaler, à chaque pleine lune, le prépuce d’un enfant fraîchement circoncis."
                            },
                            {
                                "example_id": "cf8d4162-a267-4cfc-8b55-a95e12dbdc81",
                                "sense_id": "687cc334-d44b-3dc4-b221-db052a66d11f",
                                "text": "Le prépuce est un repli cylindrique de peau qui présente sur la face externe un épithélium kératinisé et sur sa face interne, qui est en contact avec le gland, une muqueuse."
                            },
                            {
                                "example_id": "4dbb7465-7d5f-4b02-a51a-1752c7181401",
                                "sense_id": "687cc334-d44b-3dc4-b221-db052a66d11f",
                                "text": "Parce que si tu forces sur ton prépuce pour décalotter, tu peux finir par y arriver."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5291de4-c7fe-41b3-89d7-55f5b69daf9f",
