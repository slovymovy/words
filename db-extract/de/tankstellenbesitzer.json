                "senses": [
                    {
                        "sense_id": "0c542ed4-546c-33ca-9c53-b2b620959bc1",
                        "entry_id": "18915f9b-c046-3d8f-bfc8-4298674e9aaf",
                        "glosses": [
                            "Person, die eine Tankstelle besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c095019a-5060-4e31-bbee-b909c6f51cf5",
                                "sense_id": "0c542ed4-546c-33ca-9c53-b2b620959bc1",
                                "text": "„Sie haben ja eine ganze Menge Fragen, sagte der Tankstellenbesitzer.“"
                            },
                            {
                                "example_id": "ce0c7a7e-5c1c-4557-aaf7-d789b022f57d",
                                "sense_id": "0c542ed4-546c-33ca-9c53-b2b620959bc1",
                                "text": "„In diesem Teil der Stadt war es besonders ruhig geblieben, bis ein örtlicher Hagana-Kommandeur beschlossen hatte, die Palästinenser dieser Gegend unter dem Vorwand einzuschüchtern, ein Tankstellenbesitzer ermuntere Einwohner zu Angriffen auf vorbeifahrende jüdische Fahrzeuge.“"
                            },
                            {
                                "example_id": "ae1570fd-4c49-4587-a39e-245781dddd1a",
                                "sense_id": "0c542ed4-546c-33ca-9c53-b2b620959bc1",
                                "text": "„Ich wiederum erhielt ihren Segen und Geld, Bargeld von den Ladeninhabern und Händlern, den Tankstellenbesitzern und Dhaba-Besitzern der Gegend, damit wir sie und ihre Etablissements beschützten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
