                    {
                        "translation_id": "a1644e6d-fd4e-43af-ad3a-ac3aa6c53350",
                        "source_entry_id": "eb404f5b-a609-39f5-a38a-b7e64ba16221",
                        "source_sense_id": "0e8cb340-4a31-3509-9cac-68899916af9b",
