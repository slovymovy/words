                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autrefois, on disait pudiquement d'une paysanne fatiguée qu'elle s'était <w>blessée</w>."
