                                                "example_id": "27d39e3c-a900-4f63-b046-7d03d7d8b4bc",
                                                "sense_id": "3fad2b02-95a3-3e85-b0a7-28705ca20f8b",
                                                "text": "„Da die verfilzten Locken der Rastafari dem Schönheitsideal der Weißen nun so gar nicht entsprachen, wurden sie von Außenstehenden als bedrohlich oder abstoßend empfunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
