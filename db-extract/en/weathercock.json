                                        "entry_id": "a9c21467-1715-3851-9f16-32e084904b3f",
                                        "glosses": [
                                            "fahnenförmige, drehbare Metallfigur in auf dem Dach, die die Windrichtung anzeigt"
                                        ],
                                        "tags": [],
