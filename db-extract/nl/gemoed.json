                        "entry_id": "7d3fe597-d828-3f25-a8d9-a08198a80e30",
                        "glosses": [
                            "feeling; heart; soul; mind"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b83d14-c37a-41c3-9434-6422e083301e",
                                "sense_id": "47e99f43-3f6f-3c63-a3c2-dca8b1c5bde1",
                                "text": "Het lied raakte haar gemoed.",
                                "translation": "The song touched her heart.",
                                "english": "The song touched her heart."
                            },
                            {
                                "example_id": "d4f1c9af-d8d7-4431-a358-c943af30e243",
                                "sense_id": "47e99f43-3f6f-3c63-a3c2-dca8b1c5bde1",
                                "text": "Hij sprak met passie, vanuit zijn gemoed.",
                                "translation": "He spoke with passion, from his soul.",
                                "english": "He spoke with passion, from his soul."
                            },
                            {
                                "example_id": "7ab8a855-07cb-45ec-935c-74f4c0d3f360",
                                "sense_id": "47e99f43-3f6f-3c63-a3c2-dca8b1c5bde1",
                                "text": "Ze deed het met heel haar gemoed.",
                                "translation": "She did it with all her feeling.",
                                "english": "She did it with all her feeling."
                            },
                            {
                                "example_id": "67c83b41-5461-4320-b797-782dab5261a7",
                                "sense_id": "47e99f43-3f6f-3c63-a3c2-dca8b1c5bde1",
                                "text": "Hij probeert zijn gemoed te kalmeren.",
                                "translation": "He is trying to calm his mind.",
                                "english": "He is trying to calm his mind."
                            }
                        ]
                    }
                ],
