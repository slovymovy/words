                    {
                        "translation_id": "85057ccd-809e-4691-9701-62559dfc06f8",
                        "source_entry_id": "09b3f907-8862-38d1-a4b4-6cf8fed338bb",
                        "source_sense_description": "element",
                        "target_lang_word": "конденса́тор",
