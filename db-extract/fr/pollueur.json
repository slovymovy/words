                "senses": [
                    {
                        "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                        "entry_id": "514cc121-cf75-3956-94a4-38d01f7386e0",
                        "glosses": [
                            "Celui qui pollue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f7d3f4-8a94-4162-9575-cc9ce8263588",
                                "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                                "text": "Il ne suffit pas que le pollueur ait à établir qu’il n’est pas responsable des dégâts causés par ses installations ou son exploitation."
                            },
                            {
                                "example_id": "a07b1d9d-c217-4d84-8aff-d2b6d7c236ab",
                                "sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                                "text": "Au bout du compte, jeudi, après plusieurs semaines de rudes débats, l’Australie a adopté un plan ciblant les plus gros pollueurs de l’île-continent, dont les géants miniers Rio Tinto ou BHP."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f57da833-2e8d-42d3-88c0-1d077d536f57",
                        "source_entry_id": "514cc121-cf75-3956-94a4-38d01f7386e0",
                        "source_sense_id": "cbfa9173-2acc-3c6b-8e87-bc41c620a5b1",
                        "target_lang_word": "polluter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polluter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                        "entry_id": "cd692a04-882b-3c6e-8c6b-bafc9dd2930d",
                                        "glosses": [
                                            "A subject that pollutes, be it a person, company, country, factory or another subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cd10e45-d9c3-441b-9517-4d057fda6243",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "During the last session of Parliament a Rivers' Pollution Prevention Act was passed, after it had been carefully divested of most of the provisions which could make it objectionable to polluters."
                                            },
                                            {
                                                "example_id": "8bbaf90e-3ca0-4837-add3-80bad7aff3aa",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "The Environmental Protection Agency said it gets stuck with the bills because it often can't locate polluters or they are out of business or bankrupt."
                                            },
                                            {
                                                "example_id": "914781cf-8e78-4119-998e-63d7b54afe6d",
                                                "sense_id": "0b65c87f-53ce-3062-ab09-df8544ea1670",
                                                "text": "Goodbye from the world's biggest polluter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
