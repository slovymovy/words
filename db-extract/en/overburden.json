                        "sense_id": "9a546079-23e4-3f7b-9213-1d7cd7c36201",
                        "entry_id": "0babf7e6-048a-3103-bb0e-b2dd4cdfe3d8",
                        "glosses": [
                            "To overload or overtax."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "814d5a2c-c455-4586-a4d0-f14fc1687eaa",
                                "sense_id": "9a546079-23e4-3f7b-9213-1d7cd7c36201",
                                "text": "In reality, the levels of work varied: some internationals seemed overburdened with tasks and responsibility, some seemed underburdened, and some faced apparently just the right amount of work."
                            },
                            {
                                "example_id": "8ae174a6-a4eb-4e69-b468-4f223ba8adc0",
                                "sense_id": "9a546079-23e4-3f7b-9213-1d7cd7c36201",
                                "text": "He said the increase would avoid overburdening taxpayers who have subsidised the railways by £31 billion since the start of the Coronavirus pandemic."
                            }
                        ]
                    }
                ],
