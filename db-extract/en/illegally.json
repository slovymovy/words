                                                "example_id": "1208be5d-e506-489d-9c27-07907949ce3d",
                                                "sense_id": "6df25e0e-c09e-3eb5-8cf8-9489953a68c5",
                                                "text": "„Kim Davis, eine Standesbeamtin aus dem ländlichen Kentucky, wurde zur Jeanne d'Arc religiöser Fundamentalisten, weil sie sich rechtswidrig weigerte, gleichgeschlechtlichen Paaren Ehedokumente auszustellen.“"
                                            },
                                            {
                                                "example_id": "8bc27427-9d20-4d51-8c4e-d858e5df9cb8",
                                                "sense_id": "6df25e0e-c09e-3eb5-8cf8-9489953a68c5",
                                                "text": "„Erstmals hat ein Gericht die Zurückweisung von Asylbewerbern an den Grenzen für rechtswidrig erklärt.“"
                                            }
