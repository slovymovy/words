                                "target_senses": [
                                    {
                                        "sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                                        "entry_id": "ab8b6358-2f04-3c65-82c6-391dca00d39f",
                                        "glosses": [
                                            "Celle qui élève des animaux."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5453f81f-1760-44e2-8206-42a672c34e82",
                                                "sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                                                "text": "Nous souhaitons continuer à défendre et à représenter tous les paysans, a promis Laurence Marandola, nouvelle porte-parole du syndicat et éleveuse de lamas et productrice de plantes aromatiques dans l’Ariège."
                                            },
                                            {
                                                "example_id": "e1074fb0-e155-4fb1-95fb-3d239c5771f3",
                                                "sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                                                "text": "La jeune éleveuse en cours d’installation en Haute-Ariège vient d’intégrer le groupe de Vicdessos, son territoire préféré pour randonner avec sa bande de copines."
                                            },
                                            {
                                                "example_id": "b6fc1426-a1d9-4c34-9685-f3548a76a186",
                                                "sense_id": "24e0c699-006c-3b99-95a1-00bab91119ab",
                                                "text": "Sortir de cet accord serait « déjà un premier pas », estime Sylvie Colas, secrétaire nationale de la Conférence paysanne et éleveuse de volailles dans le Gers qui plaide pour une sortie des accords de libre-échange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a747fd-0f62-3d3a-9bb3-fa3722bc2a89",
                                        "entry_id": "ab8b6358-2f04-3c65-82c6-391dca00d39f",
                                        "glosses": [
                                            "Celle qui surveille le vieillissement des vins, après la récolte."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "697986b7-b652-328a-a722-09f42cedee21",
                                        "entry_id": "ab8b6358-2f04-3c65-82c6-391dca00d39f",
                                        "glosses": [
                                            "Couveuse ou parquet chauffé qui fournit aux poussins nouvellement éclos la chaleur nécessaire à leur développement."
                                        ],
                                        "tags": [],
