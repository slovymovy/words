                                    },
                                    {
                                        "sense_id": "1f4e7615-6198-3418-8726-8fd9898298f0",
                                        "entry_id": "411b75ff-bbb0-3414-8e74-caf550c4fd22",
                                        "glosses": [
                                            "A subjective thought or idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54921b08-8607-4664-859f-ca695f642033",
                                                "sense_id": "1f4e7615-6198-3418-8726-8fd9898298f0",
                                                "text": "Beyond bringing women back into analyses of the workplace and the labor process, we now have to analyze how work is gendered and gendering: gender as a means of control and an organizing principle for class relations at the point of production, and workplace as a site for gender construction, formation, and reproduction. In the latest development, seeing gender as a power process also directs our attention toward the politics of identity, or the formation and claiming of collective subjectivities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e83aff5-cc85-4f41-ae9f-37db1b2bbaba",
                        "source_entry_id": "bafdc650-927c-3315-bd3a-e0e2bf9272f2",
                        "source_sense_id": "ba1a53b2-1139-328f-8085-e32e41c40df0",
                        "target_lang_word": "judgment call",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judgment call",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c07618c9-bdca-39e3-8428-ac380046c46f",
                                        "entry_id": "e4e91b5e-b3d9-3adb-b178-b5b37ef0e686",
                                        "glosses": [
                                            "A ruling by an umpire, referee, or similar official during a sporting event, based on his or her perception of events and in the absence of any objective measurement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2405b6d4-cd9a-4ae8-abe6-5f02a9bdbeeb",
                                                "sense_id": "c07618c9-bdca-39e3-8428-ac380046c46f",
                                                "text": "The rookie outfielder was waved out before he reached the plate. The reason for the rare judgment call? According to Rule 7.09 (i), a coach cannot \"assist\" a runner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fb811b1-60f2-3c4c-9d53-c01c5eef591d",
                                        "entry_id": "e4e91b5e-b3d9-3adb-b178-b5b37ef0e686",
                                        "glosses": [
                                            "Any decision or other determination based on subjective criteria, especially one which takes into account the particular circumstances of a situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a5231a-9fa0-4712-8c37-50c5a780ec01",
                                                "sense_id": "7fb811b1-60f2-3c4c-9d53-c01c5eef591d",
                                                "text": "This probably ought to be a judgment call made by individual teachers who know their students well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff98be93-e978-3110-a361-6c5fa195ca90",
                                        "entry_id": "e4e91b5e-b3d9-3adb-b178-b5b37ef0e686",
                                        "glosses": [
                                            "The summons which will call the spirits of the deceased to their heavenly reward at the time of Final Judgment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1092c9a4-2744-4e74-be13-7fc31fa17717",
                                                "sense_id": "ff98be93-e978-3110-a361-6c5fa195ca90",
                                                "text": "So stood I, by an atmosphere beguiled\nOf glad surprise, when first thy lips let fall\nThe name I lightly carried when a child,\nThat I shall rise to at the judgment call."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
