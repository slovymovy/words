                "senses": [
                    {
                        "sense_id": "6e5af493-1b70-31e4-adf3-bd3f7d393b53",
                        "entry_id": "40577f16-31ff-3438-9345-38c4f5e96aee",
                        "glosses": [
                            "To soil or befoul; to beray."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "a2d04404-525e-46cd-93ae-0932dbb01116",
                                "sense_id": "6e5af493-1b70-31e4-adf3-bd3f7d393b53",
                                "text": "Obscene with filth the varlet lies bewray’d,\nFal’n in the plash his wickedness had lay’d:"
                            },
                            {
                                "example_id": "52cd4d0f-2c40-4d42-92ac-4de5c5bb154f",
                                "sense_id": "6e5af493-1b70-31e4-adf3-bd3f7d393b53",
                                "text": "Like caterpillars dangling under trees\nBy slender threads, and swinging in the breeze,\nWhich filthily bewray and sore disgrace\nThe boughs in which are bred th’ unseemly race […]"
                            }
                        ]
                    }
                ],
