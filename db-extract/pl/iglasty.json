                                "sense_id": "4e8c90ad-a915-37a2-8dc7-5a41340a4c70",
                                "text": "Złotoborowik wysmukły rośnie w lasach iglastych, przede wszystkim wśród sosen"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
