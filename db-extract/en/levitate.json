                                            {
                                                "example_id": "cf998eae-38a1-4f5e-b7fe-5bccbdb903d6",
                                                "sense_id": "79f79e6c-b434-3052-ba77-26085d937021",
                                                "text": "„Autolevitationen, bei denen sich Personen selbst zu levitieren vermögen, spielten schon in der Geschichte früher christlicher Heilige eine nicht unwesentliche Rolle.“"
                                            },
                                            {
                                                "example_id": "c45974a5-22eb-4a13-b336-14e1e60f1a88",
                                                "sense_id": "79f79e6c-b434-3052-ba77-26085d937021",
                                                "text": "„Es sind deshalb eine Reihe von Verfahren entwickelt worden, um einzelne Tröpfchen zu levitieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
