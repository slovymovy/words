                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in social media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одеваться или вести себя идентично кому-то другому.",
                        "zh": "与他人穿着或行为完全一致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть как близняшки",
                                "target_lang_sense_clarification": "разговорное выражение"
                            },
                            {
                                "target_lang_word": "одеться одинаково",
                                "target_lang_sense_clarification": "описательный перевод действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穿得一模一样",
                                "target_lang_sense_clarification": "指着装风格同步"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78f41b78-9585-38e2-9d48-1a3ae9616ae5",
                    "sense_definition": "To give birth to twins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biological_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd noticed that two of his ewes had <w>twinned</w> during the night.",
                            "target_lang_translations": {
                                "ru": "Пастух заметил, что две его овцы за ночь <w>принесли двойню</w>.",
                                "zh": "牧羊人发现他的两只母羊在夜里<w>生了双胞胎</w>。"
                            }
                        },
                        {
                            "text": "It is rare for this species to <w>twin</w> in the wild.",
                            "target_lang_translations": {
                                "ru": "Для этого вида редкость <w>рожать двойню</w> в дикой природе.",
                                "zh": "这种动物在野外<w>生双胞胎</w>的情况很少见。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Родить близнецов.",
                        "zh": "产下双胞胎。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родить двойню",
                                "target_lang_sense_clarification": "о людях и животных"
                            },
                            {
                                "target_lang_word": "принести двойню",
                                "target_lang_sense_clarification": "обычно о животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生双胞胎",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b0cad90-54d5-35d2-93ad-843b80c05d36",
                    "sense_definition": "To separate or divide into two parts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient path <w>twins</w> at the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Древняя тропа <w>раздваивается</w> у старого дуба.",
                                "zh": "那条古老的小路在老橡树那里<w>分叉</w>了。"
                            }
                        },
                        {
                            "text": "Their fates <w>twinned</w> when they chose different careers.",
                            "target_lang_translations": {
                                "ru": "Их судьбы <w>раздвоились</w>, когда они выбрали разные карьеры.",
                                "zh": "当他们选择不同的职业时，他们的命运便<w>分道扬镳</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделяться или делиться на две части.",
                        "zh": "分离或分成两部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздваиваться",
                                "target_lang_sense_clarification": "делиться надвое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分叉",
                                "target_lang_sense_clarification": "指路径或事物一分为二"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fcc6ac14-ed19-3666-ad9d-16e8045ef3e1",
                    "sense_definition": "A town in Marion County, Alabama.",
                    "learner_level": "C2",
