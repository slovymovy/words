                    {
                        "translation_id": "b80653ed-ad47-42d8-b3ec-11ec6118ff66",
                        "source_entry_id": "f51295ea-6cb6-3785-91a3-1fdc5d8d3bd7",
                        "source_sense_description": "to move in circles",
                        "target_lang_word": "circuler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circuler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bd343c-8d4e-3e12-9f37-62ea15010d4d",
                                        "entry_id": "f605e89d-5b3c-3521-8cc1-bfc6a54e2518",
                                        "glosses": [
                                            "Se mouvoir circulairement. Se dit des choses que leur mouvement ramène au point de départ, et principalement du sang et de la sève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e60c7f-bb00-403a-9225-9cf68e2d90a4",
                                                "sense_id": "e2bd343c-8d4e-3e12-9f37-62ea15010d4d",
                                                "text": "Le sang circule dans les veines. - La sève circule dans les plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4aa3cd-6171-3a96-be13-f51cfa90b9a7",
                                        "entry_id": "f605e89d-5b3c-3521-8cc1-bfc6a54e2518",
                                        "glosses": [
                                            "Se déplacer, en parlant de moyens de transport."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aad21a3-3385-472b-ac6d-846c8c879596",
                                                "sense_id": "6a4aa3cd-6171-3a96-be13-f51cfa90b9a7",
                                                "text": "Les tramways, les chemins de fer, les bacs à vapeur avaient cessé de circuler, et seule la lumière des flammes éclairait la route des fugitifs affolés dans cette ténébreuse confusion."
                                            },
                                            {
                                                "example_id": "73397155-4d33-4ab8-9093-e0957b73027e",
                                                "sense_id": "6a4aa3cd-6171-3a96-be13-f51cfa90b9a7",
                                                "text": "Sans les camionneurs, l’économie brésilienne serait paralysée. Sur les routes en bon état de Rio, de Sâo Paulo ou de Belo Horizonte, les camions circulent par milliers, tous les jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c64442-fc64-390e-ae2f-725d81c7cfec",
                                        "entry_id": "f605e89d-5b3c-3521-8cc1-bfc6a54e2518",
                                        "glosses": [
                                            "Aller çà et là ; aller et venir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb424edc-892e-4e37-9f28-2e73db71771e",
                                                "sense_id": "b2c64442-fc64-390e-ae2f-725d81c7cfec",
                                                "text": "On arriva sur une petite place circulaire, où étaient dressées quelques boutiques, un bal, un manège. Il n'y avait pas grande foule, quelques badauds seulement circulaient."
                                            },
                                            {
                                                "example_id": "19a05638-830a-40a8-a79a-9d242c5dfd52",
                                                "sense_id": "b2c64442-fc64-390e-ae2f-725d81c7cfec",
                                                "text": "Vers 23 h 30, les danseuses de l'établissement, encore habillées pour l'heure, circulèrent de table en table pour distribuer les inévitables cotillons du réveillon : chapeaux, mirlitons, faux-nez, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bab3c8b8-240b-32f2-954c-de790ea4a00f",
                                        "entry_id": "f605e89d-5b3c-3521-8cc1-bfc6a54e2518",
                                        "glosses": [
                                            "Passer, aller de main en main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b96f7ff-7afb-4458-a014-78fc06e50167",
                                                "sense_id": "bab3c8b8-240b-32f2-954c-de790ea4a00f",
                                                "text": "L’insuffisance du numéraire circulant en France étant avérée, Colbert avait résolu de protéger à outrance l'industrie du royaume."
                                            },
                                            {
                                                "example_id": "a5a03185-6dba-405d-9790-4798e458c83e",
                                                "sense_id": "bab3c8b8-240b-32f2-954c-de790ea4a00f",
                                                "text": "L’argent, les effets de commerce, les capitaux circulent. - Faire circuler des billets. - Les papiers de toute espèce qui circulent dans le commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4692c10-5a44-3bcc-b09e-8b27425950ac",
                                        "entry_id": "f605e89d-5b3c-3521-8cc1-bfc6a54e2518",
                                        "glosses": [
                                            "Se propager, se répandre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61782a37-955d-4996-a228-b268f7c7fd1d",
                                                "sense_id": "b4692c10-5a44-3bcc-b09e-8b27425950ac",
                                                "text": "Certains « on dit » circulent, s'amplifient, se font écho à eux-mêmes indéfiniment, sans avoir cependant de substance réelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
