                },
                {
                    "sense_id": "c0287680-57e6-3af2-9a9a-1bf4f30b72b6",
                    "sense_definition": "het met veel geweld en lawaai overtrekken van een natuurverschijnsel zoals een storm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "natuurkracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een zuidwesterstorm <w>raast</w> met hevige wind en slagregens over het land.",
                            "target_lang_translations": {
                                "en": "A southwesterly storm <w>rages</w> across the country with heavy winds and driving rain."
                            }
                        },
                        {
                            "text": "De bewoners bleven binnen terwijl de orkaan buiten <w>raasde</w>.",
                            "target_lang_translations": {
