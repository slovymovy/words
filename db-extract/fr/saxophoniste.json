        "fr-extract.jsonl": [
            {
                "entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
                "word": "saxophoniste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eec16df5-ceb9-43dc-bcd2-75542b339e29",
                        "entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "saxophonistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                        "entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
                        "glosses": [
                            "Celui, celle qui fait profession de jouer du saxophone, ou qui, n’étant qu’amateur, en joue avec plus ou moins de talent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15f133c2-5723-4988-9b7a-62a49b5b59c6",
                                "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                                "text": "Le saxophoniste britannique Andy Sheppard, s’inspirant du théâtre et de la musique indienne, poursuit son exploration des genres et des arts à Coutances (Manche) avec le festival Jazz sous les Pommiers, qui s’achève ce week-end."
                            },
                            {
                                "example_id": "25d1295a-925b-4096-b836-fa5f142fac41",
                                "sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                                "text": "Swing traditionnel, boogie-woogie, blues… les sonorités et les prestations seront variées avec le showman Lluís Coloma, le saxophoniste David Sauzay ou encore le trompettiste Michel Bonnet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a45a4301-c1cc-4bfc-a50d-df3a9074b999",
                        "source_entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
                        "source_sense_id": "158d17fb-99f2-3933-9209-47e03ab1d5a3",
                        "target_lang_word": "Saxophonist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saxophonist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85c770ab-38f9-3b7d-8c38-7cdafc962797",
                                        "entry_id": "4de710b1-17ef-3a5f-a6ad-dbbf6aad1be8",
                                        "glosses": [
                                            "(männliche) Person, die beruflich oder hobbymäßig Saxophon spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6706474c-e117-4b30-be07-5c3a2699fe03",
                                                "sense_id": "85c770ab-38f9-3b7d-8c38-7cdafc962797",
                                                "text": "Ich suche dringend einen Saxophonisten für meine Jazzband."
                                            },
                                            {
                                                "example_id": "686fa542-23c4-4868-bd41-e18d7da2a7d9",
                                                "sense_id": "85c770ab-38f9-3b7d-8c38-7cdafc962797",
                                                "text": "„Heute kann ich mich nicht zurücklehnen und den tonreichen Improvisationen unseres besten Saxophonisten lauschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6eb6159-dd2d-4e29-8adf-ed87639903ce",
                        "source_entry_id": "08260e32-ba85-3844-8272-a17c66c43957",
