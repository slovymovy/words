                "senses": [
                    {
                        "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                        "entry_id": "cb8a3c92-574b-3033-ba6c-27982a78df83",
                        "glosses": [
                            "Brot, das aus ökologischer Landwirtschaft und umweltfreundlicher Herstellung stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3127416f-4f0a-481a-b747-2e54a18a0efb",
                                "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                                "text": "„Hast du eigentlich schon das Biobrot probiert, das ich dir gestern vorbeigebracht habe?““"
                            },
                            {
                                "example_id": "6e72c9eb-b330-4cca-bf71-f6eae4b9fa08",
                                "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                                "text": "„Es gibt selbstgebackenes Biobrot und hausgemachte Marmeladen, vegane, laktose- und glutenfreie Speisen.“"
                            },
                            {
                                "example_id": "c1eafa9b-50ce-4414-9c07-3c521cc1f4ce",
                                "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                                "text": "„Man kann den Bengeln und Gören schließlich nicht jeden Morgen das Biobrot schmieren und sie zwingen, ungespritztes Obst statt Schokoriegel zu essen.“"
                            },
                            {
                                "example_id": "3ec0f3d7-ed9e-4f1c-86ec-8aa25ac28787",
                                "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                                "text": "„Wieder ein anderer Bäcker entwickelte ein Biobrot und erschloss gemeinsam mit Kollegen einen neuen Markt in der Region.“"
                            },
                            {
                                "example_id": "1f628dbf-dcdb-4050-9bb1-d6f9e0253fb0",
                                "sense_id": "73895f20-b12b-37c2-b99a-0add39525d2f",
                                "text": "„Der Türke hatte erste Erdbeeren aus Spanien, der Weinladen verkaufte jetzt auch Biobrot, die Eisdiele hatte die Markise ausgerollt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
