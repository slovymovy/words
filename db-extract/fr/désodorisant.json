                        "source_sense_description": "Produit.",
                        "target_lang_word": "Lufterfrischer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lufterfrischer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6cbb581-ac9f-3a92-9cee-b168c383d71f",
                                        "entry_id": "8241ab33-f281-30d8-89db-cf8ea0bfee52",
                                        "glosses": [
                                            "Stoff/Flüssigkeit zum Beduften von Innenräumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a665c6cf-d49a-433c-8c4e-265794e3c466",
                                                "sense_id": "b6cbb581-ac9f-3a92-9cee-b168c383d71f",
                                                "text": "„Sie wühlte im Schrank unter dem Spülbecken nach einem Lufterfrischer, fand eine alte Flasche und drückte die klebrige Düse herunter.“"
                                            },
                                            {
                                                "example_id": "47d13671-d96d-4bdc-9b45-1419b936a99c",
                                                "sense_id": "b6cbb581-ac9f-3a92-9cee-b168c383d71f",
                                                "text": "„Er hatte dieses Haus betreten, als wäre es ein Haus wie jedes andere, mit Möbeln und Teppichen und einem Lufterfrischer und einer röchelnden Kaffeemaschine in der Küche.“"
                                            },
                                            {
                                                "example_id": "d7d42e2e-5791-4cbb-a571-0e1a4dded40d",
                                                "sense_id": "b6cbb581-ac9f-3a92-9cee-b168c383d71f",
                                                "text": "„Als Adele den kleinen Raum verließ, wurde der Geruch von Eistee und Schweiß durch billiges Kölnischwasser und duftenden Lufterfrischer ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
