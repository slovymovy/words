{
    "word_family": [
        "chief",
        "chieftain",
        "chiefdom",
        "chiefship"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5c07c481-b98f-3411-b324-f0c9ac4e1ec6",
                    "sense_definition": "Especially or primarily; above all others in importance or frequency.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new scholarship program is <w>chiefly</w> intended for students from low-income families.",
                            "target_lang_translations": {
                                "ru": "Новая стипендиальная программа <w>в первую очередь</w> предназначена для студентов из малообеспеченных семей."
                            }
                        },
                        {
                            "text": "Although he enjoys many sports, he is <w>chiefly</w> interested in competitive swimming.",
                            "target_lang_translations": {
                                "ru": "Хотя ему нравятся многие виды спорта, он <w>особенно</w> интересуется спортивным плаванием."
                            }
                        }
                    ],
                    "synonyms": [
                        "above all",
                        "particularly",
                        "first and foremost"
                    ],
                    "common_phrases": [
                        "chiefly interested in",
                        "chiefly concerned with"
                    ],
                    "target_lang_definitions": {
                        "ru": "В особенности или прежде всего; важнее или чаще всего остального."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в первую очередь",
                                "target_lang_sense_clarification": "прежде всего остального"
                            },
                            {
                                "target_lang_word": "особенно",
                                "target_lang_sense_clarification": "в большей степени, чем прочее"
                            },
                            {
                                "target_lang_word": "преимущественно",
                                "target_lang_sense_clarification": "по большей части, отдавая предпочтение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f75cb2-c23e-32af-9c10-e5fb32f5fa8c",
                    "sense_definition": "Mainly or principally; for the most part.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "priority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local economy depends <w>chiefly</w> on tourism during the summer months.",
                            "target_lang_translations": {
                                "ru": "Местная экономика в летние месяцы зависит <w>главным образом</w> от туризма."
                            }
                        },
                        {
                            "text": "The book consists <w>chiefly</w> of interviews with retired jazz musicians.",
                            "target_lang_translations": {
                                "ru": "Книга состоит <w>в основном</w> из интервью с джазовыми музыкантами на пенсии."
                            }
                        }
                    ],
                    "synonyms": [
                        "mostly",
                        "largely",
                        "for the most part",
                        "by and large"
                    ],
                    "common_phrases": [
                        "consists chiefly of",
                        "depends chiefly on"
                    ],
                    "target_lang_definitions": {
                        "ru": "В основном или главным образом; по большей части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главным образом",
                                "target_lang_sense_clarification": "преимущественно, в основном"
                            },
                            {
                                "target_lang_word": "в основном",
                                "target_lang_sense_clarification": "почти полностью, в главных чертах"
                            },
                            {
                                "target_lang_word": "преимущественно",
                                "target_lang_sense_clarification": "в большинстве случаев"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0452993e-2b90-3f78-82c2-7720246c07cf",
                    "sense_definition": "Of or relating to a <w>chief</w> or leader.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed several <w>chiefly</w> artifacts from the ancient island tribes.",
                            "target_lang_translations": {
                                "ru": "В музее было выставлено несколько артефактов, <w>принадлежавших вождям</w> древних островных племен."
                            }
                        },
                        {
                            "text": "He wore a <w>chiefly</w> headdress to signify his high status within the community.",
                            "target_lang_translations": {
                                "ru": "Он носил головной убор <w>вождя</w>, чтобы подчеркнуть свой высокий статус в общине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chiefly dignity",
                        "chiefly authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к вождю или лидеру племени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принадлежащий вождю",
                                "target_lang_sense_clarification": "связанный со статусом вождя"
                            },
                            {
                                "target_lang_word": "подобающий вождю",
                                "target_lang_sense_clarification": "соответствующий положению лидера"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}