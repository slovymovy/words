                "senses": [
                    {
                        "sense_id": "7944dd46-ae61-391c-9184-3c6209f9b2f8",
                        "entry_id": "30e7b53d-cbd1-3ec5-94fb-235ff905b480",
                        "glosses": [
                            "Donner un caractère quasi-légitime à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ab943c-1f57-4c6a-9864-b06a1ea1c4f9",
                                "sense_id": "7944dd46-ae61-391c-9184-3c6209f9b2f8",
                                "text": "Plus tard, on a voulu restaurer, légitimer ou quasi-légitimer l’œuvre des anglomanes; mais la restauration, la légitimité ou quasi-légitimité sont mortes à la peine."
                            },
                            {
                                "example_id": "93468969-dee0-4855-ba8e-b09f4e678c23",
                                "sense_id": "7944dd46-ae61-391c-9184-3c6209f9b2f8",
                                "text": "À défaut du prince d’Orange, que les cinq puissances eussent préféré à toute autre pour quasi-légitimer les Belges, même au risque du danger que sa rentrée en Belgique, eût fait courir a l’une d’elles, ce fut vous qui devintes leur agent."
                            }
                        ]
                    }
                ],
