                ],
                "senses": [
                    {
                        "sense_id": "2be9e019-c9c8-317d-b023-dbb0d3d6adf6",
                        "entry_id": "0c35befc-5ffa-346c-a7ea-05e6019e5c07",
                        "glosses": [
                            "Casanier, terre-à-terre."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "559bd254-c9be-4dea-a2d7-036913c74430",
                                "sense_id": "2be9e019-c9c8-317d-b023-dbb0d3d6adf6",
                                "text": "c’était surtout là le grand étonnement de Georges. Il les trouvait « popote» , il avait cru qu’on allait s’embrasser tout de suite."
                            },
                            {
                                "example_id": "5034dbc7-cef3-4475-9df5-e745015408c6",
                                "sense_id": "2be9e019-c9c8-317d-b023-dbb0d3d6adf6",
                                "text": "– Entre nous, il est beaucoup plus popote qu'on ne se le figure, ce brave Schmidt."
                            },
                            {
                                "example_id": "ecb73d5d-6abd-4048-a3ce-38fbec8c6e6d",
                                "sense_id": "2be9e019-c9c8-317d-b023-dbb0d3d6adf6",
                                "text": "Il n’a pas la naïveté de croire que le lavage de ses chaussettes me comble de bonheur, il me dit et me répète qu’il a horreur des femmes popotes."
                            },
                            {
                                "example_id": "d8a66dbe-48f8-4e44-8b84-658fa35e1e65",
                                "sense_id": "2be9e019-c9c8-317d-b023-dbb0d3d6adf6",
                                "text": "Moi qui craignais que tu sois trop professeur, trop popote."
                            }
                        ]
                    }
                ],
