                    {
                        "sense_id": "5c07dcf4-d5e1-37e1-8ba0-0ebe5d86d007",
                        "entry_id": "2440881c-7591-376a-90dd-b7de25b8de3d",
                        "glosses": [
                            "dandy, snob, someone conceited, smug, unctuous (of any age)"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "masculine",
