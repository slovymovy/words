                        "target_lang_word": "Singvogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Singvogel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "565be25d-03f9-383b-9d63-6940be8904de",
                                        "entry_id": "e16b9f36-9740-3e6c-979c-1f69dec7a741",
                                        "glosses": [
                                            "die größte klassische Unterordnung (Oscines) der Sperlingsvögel (Passeriformes). Der typische Sperlingsvogel ist klein und lebt auf Bäumen (es gibt aber Ausnahmen wie den Raben und die Lerchen). Da die Singvögel in der Alten Welt (Europa, Asien, Afrika) die einzige Unterordnung sind, wird das Wort häufig synonym mit „Sperlingsvogel“ verwendet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2a40cf-4ab1-4361-8d3c-ef24bc3b37cc",
                                                "sense_id": "565be25d-03f9-383b-9d63-6940be8904de",
                                                "text": "Kaum zu glauben: Der Rabe ist ein Singvogel!"
                                            },
                                            {
                                                "example_id": "f1dd5381-548d-4d56-b00f-6d76047a3cc5",
                                                "sense_id": "565be25d-03f9-383b-9d63-6940be8904de",
                                                "text": "„In den Büschen wurden die kleineren Singvögel munter, und weit im Walde drinnen krähte auf einem einsam liegenden Farmhofe ein wackerer Haushahn sein gellendes Morgenlied in die frische, erquickende Frühluft hinaus.“"
                                            },
                                            {
                                                "example_id": "e7cec52b-5a1b-4bfd-8122-97449b123bd9",
                                                "sense_id": "565be25d-03f9-383b-9d63-6940be8904de",
                                                "text": "„Singvögel boten einen Ohren- und waren selbst ein Gaumenschmaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db02fde-b722-46c3-89e5-0225bf16cbc8",
                        "source_entry_id": "47b5bfc3-52d1-308c-b9f5-bc448b359dc3",
                        "source_sense_id": "3ed394e7-ea4f-31ca-a43b-9680ce19cd2c",
                        "source_sense_description": "Personne qui excite les autres à la joie",
                        "target_lang_word": "Anführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                        "entry_id": "60d57abc-34e7-365c-aeb5-906a800cd6bb",
                                        "glosses": [
                                            "Person, die eine Gruppe leitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f557c2bc-fcb3-4a3f-93dd-5c9102229ffc",
                                                "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                                "text": "Der Anführer der Räuberbande wurde verurteilt und anschließend erhängt."
                                            },
                                            {
                                                "example_id": "c74defd6-db46-4088-90bb-dc99b1f91a59",
                                                "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                                "text": "„Der auf Island verurteilte Totschläger ist nun ein geachteter Anführer der Pioniere, seine Kinder könnten auf Grönland für alle ihre Tage Ansehen und Land beanspruchen.“"
                                            },
                                            {
                                                "example_id": "c4a9943c-87d8-4642-8c0c-8959fc0a7e4e",
                                                "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                                "text": "„Er war der nominelle Anführer der Rebellion und starb fünf Jahre später in der Verbannung in Burma.“"
                                            },
                                            {
                                                "example_id": "995f5fd4-0b2c-4a4e-93e9-da02606a697d",
                                                "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                                "text": "„Anders als die meisten Anführer gehörte er nicht zur gebildeten Elite.“"
                                            },
                                            {
                                                "example_id": "da0484ea-984d-4872-ba56-3ff6cf49008a",
                                                "sense_id": "c5c421cc-1838-335f-8c0c-31610739733b",
                                                "text": "„Die Augen der ganzen Versammlung hingen in sprachloser Rührung auf dem jungen Anführer, als er in tiefer Bewegung innehielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "397771ce-663e-328a-a6d2-775d4ac52b47",
                                        "entry_id": "60d57abc-34e7-365c-aeb5-906a800cd6bb",
                                        "glosses": [
                                            "Person oder Gruppe, die den ersten Platz eines noch nicht entschiedenen Ereignisses belegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1062147d-36c5-494c-9a39-cd618af920de",
                                                "sense_id": "397771ce-663e-328a-a6d2-775d4ac52b47",
                                                "text": "Die Mannschaft, die zu Beginn der Winterpause Anführer der Tabelle ist, ist Herbstmeister."
                                            },
                                            {
                                                "example_id": "903cecff-4aab-479d-b292-466a047aa8b0",
                                                "sense_id": "397771ce-663e-328a-a6d2-775d4ac52b47",
                                                "text": "„Nachdem alle Fahrer bewegt wurden (der Anführer des Feldes zuerst, der Nachzügler zuletzt), werden die Bewegungspunkte je nach der Rennposition des Fahrers ergänzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f68ee4de-6c7e-4ae9-bc6e-103b97cf752d",
                        "source_entry_id": "47b5bfc3-52d1-308c-b9f5-bc448b359dc3",
