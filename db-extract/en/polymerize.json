                    {
                        "sense_id": "f0987f72-ea14-3a86-b287-0ba310d3eade",
                        "entry_id": "405d962a-0740-3d4c-8d74-2e510eb6e156",
                        "glosses": [
                            "To undergo polymerization."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b05e136f-ae6f-4c33-a584-53d13c650f6a",
                                "sense_id": "f0987f72-ea14-3a86-b287-0ba310d3eade",
                                "text": "Non-polymerized lamins are dimers and they can polymerize to structures such as head to tail or by unparallel dimers which aggregate in tetramers and polymerize to thick fibers."
