                ],
                "senses": [
                    {
                        "sense_id": "0f9c012a-05a7-3c55-8054-ed67b6f0cbba",
                        "entry_id": "713c9dd2-0b9b-3a56-98d1-d33ce8467362",
                        "glosses": [
                            "включённый в табель, предусмотренный табелем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eaae00f-9424-4331-a9e6-edb36c9b96c9",
                                "sense_id": "0f9c012a-05a7-3c55-8054-ed67b6f0cbba",
                                "text": "Табельное имущество, находящееся на боевых постах согласно описи, используется только по прямому назначению."
                            },
                            {
                                "example_id": "b158aff8-1c48-4a82-b055-4b8e64061b82",
                                "sense_id": "0f9c012a-05a7-3c55-8054-ed67b6f0cbba",
                                "text": "Для дымообразования, помимо табельных средств, использовать подручные средства (сырое сено и солому, валежник, хвойные сучья и др.)."
                            },
                            {
                                "example_id": "4f0aab3c-61ae-4491-84d0-a49660a2194e",
                                "sense_id": "0f9c012a-05a7-3c55-8054-ed67b6f0cbba",
                                "text": "Табельное оружие — пистолет Макарова — нам выдавали перед каждой сменой."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dcfb99e-3b9e-3162-beb9-7b4d84fe4376",
                        "entry_id": "713c9dd2-0b9b-3a56-98d1-d33ce8467362",
                        "glosses": [
                            "осуществляемый с помощью табеля"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bae4970-bc6e-4c5d-a535-c8fcdad8b58c",
                                "sense_id": "9dcfb99e-3b9e-3162-beb9-7b4d84fe4376",
                                "text": "Поручили ей дополнительную работу — вести табельный учёт."
                            },
                            {
                                "example_id": "efba263e-f3ca-43d5-84a7-60c4fbec7b6f",
                                "sense_id": "9dcfb99e-3b9e-3162-beb9-7b4d84fe4376",
                                "text": "ЭВМ следит за состоянием машин, наличием и распределением запчастей, ведёт табельный учёт, рассчитывает маршруты и распределяет рабочую силу."
                            }
                        ]
                    },
                    {
                        "sense_id": "5585cad0-17ae-36d8-9f1c-bc45e52bed7f",
                        "entry_id": "713c9dd2-0b9b-3a56-98d1-d33ce8467362",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным табель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164c1118-49de-4add-8000-13f6b755238b",
                                "sense_id": "5585cad0-17ae-36d8-9f1c-bc45e52bed7f",
                                "text": "На работе не было ни табельной доски, ни табельщицы."
                            }
                        ]
                    }
                ],
