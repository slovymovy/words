                ],
                "senses": [
                    {
                        "sense_id": "d27da546-f7b1-379b-9b2d-b2b291cdd791",
                        "entry_id": "eab66e39-f521-313a-8ed0-adc4001ed8f8",
                        "glosses": [
                            "das Gebiet zwischen der Polarzone und der gemäßigten Klimazone betreffend, zu ihm gehörig"
                        ],
                        "tags": [
                            "Klimatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6f581cbe-e488-4afc-a323-28afa7319d30",
                                "sense_id": "d27da546-f7b1-379b-9b2d-b2b291cdd791",
                                "text": "„Klimatisch umfasst die laurentinische Bergkette Gebiete warmgemäßigten Kontinentalklimas im Süden, bis zu Gebieten subpolaren Klimas in ihren nördlichsten Ausläufern.“"
                            },
                            {
                                "example_id": "5e889c18-ccbc-40b6-baf2-5f22320ae46e",
                                "sense_id": "d27da546-f7b1-379b-9b2d-b2b291cdd791",
                                "text": "„Es entstanden breite, aus zahlreichen Kiesbänken und verflochtenen Rinnsalen bestehende verwilderte Flussbetten, wie sie heute aus subpolaren oder hochalpinen Gebieten bekannt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
