                    {
                        "translation_id": "2bbe4d0d-91bf-460c-b67a-82c1b1dac067",
                        "source_entry_id": "79705386-8a3d-3c2d-b18d-b10515f521cf",
                        "source_sense_id": "89500b7b-cf95-33b4-98a2-e406d7f5ea33",
                        "source_sense_description": "of or relating to money",
                        "target_lang_word": "geldlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
