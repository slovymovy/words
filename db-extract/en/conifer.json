                        "target_lang_word": "naaldboom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naaldboom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "12f9d922-dfb6-3261-9771-0785ee125e4e",
                                        "entry_id": "65d3e783-8d9c-38d0-84f4-5a0a77246955",
                                        "glosses": [
                                            "conifeer (kegeldrager)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d65f81b5-7773-49e1-8fb3-5d58c460a434",
                                                "sense_id": "12f9d922-dfb6-3261-9771-0785ee125e4e",
                                                "text": "De meeste coniferen zijn bladhoudend, maar er zijn ook enkele soorten die 's winters de naalden verliezen, zoals de lariks, de watercipres en de moerascipres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e91d04d5-5003-4da5-9a05-e1d808c1f530",
                        "source_entry_id": "2b9f67bb-20ed-3fc3-965c-b06a3fab5c53",
                        "source_sense_id": "1620b21f-1133-35b1-89bd-f5bb872577ed",
