    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83f19bf1-d830-345b-a7fc-813f605de875",
                    "sense_definition": "Dringend en ernstig tekortschietend; acute problemen veroorzakend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ernst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is een <w>nijpend</w> tekort aan leraren in het basisonderwijs.",
                            "target_lang_translations": {
                                "en": "There is a <w>dire</w> shortage of primary school teachers."
                            }
                        },
                        {
                            "text": "Door de droogte ontstond er een <w>nijpende</w> situatie met betrekking tot het drinkwater.",
                            "target_lang_translations": {
                                "en": "Due to the drought, a <w>pressing</w> situation arose regarding drinking water."
                            }
                        }
                    ],
                    "synonyms": [
                        "dringend",
                        "acuut",
                        "schrijnend"
                    ],
                    "antonyms": [
                        "overvloedig"
                    ],
                    "common_phrases": [
                        "nijpend tekort",
                        "nijpende situatie"
                    ],
                    "target_lang_definitions": {
                        "en": "Urgently and seriously lacking; causing acute problems."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "urgent",
                                "target_lang_sense_clarification": "requiring immediate attention"
                            },
                            {
                                "target_lang_word": "pressing",
                                "target_lang_sense_clarification": "needing immediate action or attention"
                            },
                            {
                                "target_lang_word": "dire",
                                "target_lang_sense_clarification": "extremely serious or urgent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f87586bb-43d5-3781-942d-b9f19eb7a5f4",
                    "sense_definition": "Ernstig en pijnlijk voelbaar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ernst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kou was deze winter uitzonderlijk <w>nijpend</w> voor de daklozen.",
                            "target_lang_translations": {
                                "en": "The cold was exceptionally <w>biting</w> for the homeless this winter."
                            }
                        },
                        {
                            "text": "Zij leefden in <w>nijpende</w> armoede aan de rand van de grote stad.",
                            "target_lang_translations": {
                                "en": "They lived in <w>dire</w> poverty on the outskirts of the big city."
                            }
                        }
                    ],
                    "synonyms": [
                        "ernstig",
                        "schrijnend",
                        "bitter"
                    ],
                    "common_phrases": [
                        "nijpende armoede",
                        "nijpende kou"
                    ],
                    "target_lang_definitions": {
                        "en": "Severely and painfully felt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dire",
                                "target_lang_sense_clarification": "dreadful, severe, or painful"
                            },
                            {
                                "target_lang_word": "acute",
                                "target_lang_sense_clarification": "intense or severely felt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d13f728-7d13-372f-95c7-995d49d0cdf7",
                    "sense_definition": "Onvoltooid deelwoord van <w>nijpen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kou, gemeen <w>nijpend</w> in hun gezichten, hield hen binnen.",
                            "target_lang_translations": {
                                "en": "The cold, viciously <w>biting</w> into their faces, kept them indoors."
                            }
                        },
                        {
                            "text": "Met <w>nijpende</w> tangen probeerde de smid het ijzer te buigen.",
                            "target_lang_translations": {
                                "en": "With <w>pinching</w> pliers, the blacksmith tried to bend the iron."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of 'nijpen' (to pinch or bite)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pinching",
                                "target_lang_sense_clarification": "squeezing tightly or causing sharp discomfort"
                            },
                            {
                                "target_lang_word": "biting",
                                "target_lang_sense_clarification": "piercingly cold or harsh"
                            }
                        ]
                    }
                }
            ]
        }
    ]
