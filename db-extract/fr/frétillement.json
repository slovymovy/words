                        ],
                        "examples": [
                            {
                                "example_id": "b452d5dc-bcd2-4a7d-83d1-25ea188ede97",
                                "sense_id": "f4640abc-a2fc-36eb-962c-76e9f228343d",
                                "text": "Luis était médusé par le frétillement du ver.",
                                "translation": "Luis was mesmerized by the worm's wriggling.",
                                "english": "Luis was mesmerized by the worm's wriggling."
                            },
                            {
                                "example_id": "ccdce488-5268-476e-b0d7-eb6eb066e3bb",
                                "sense_id": "f4640abc-a2fc-36eb-962c-76e9f228343d",
                                "text": "... et qu'il entende le frétillement d'un grand poisson, son désir est allumé et il veut l'attraper"
                            }
                        ]
                    },
                    {
                        "sense_id": "54dabbe0-7f0f-32be-ad1f-e65f77d435c8",
                        "entry_id": "5469169b-57a5-3aed-b94c-62c4f330627b",
                        "glosses": [
