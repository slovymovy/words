                "senses": [
                    {
                        "sense_id": "5f0289e1-ba34-3946-94b8-7c2229991e1b",
                        "entry_id": "8d373896-64d0-3e2b-8634-85721bad1db4",
                        "glosses": [
                            "simply, merely, just"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d8339d2a-7349-4a5c-82f5-08f4697cb244",
                                "sense_id": "5f0289e1-ba34-3946-94b8-7c2229991e1b",
                                "text": "Вы по́просту сле́довали инстру́кциям.",
                                "translation": "You were merely following instructions.",
                                "english": "You were merely following instructions."
                            }
                        ]
                    },
                    {
                        "sense_id": "26f98153-3c3b-3fe3-897f-9422232e2c8e",
                        "entry_id": "8d373896-64d0-3e2b-8634-85721bad1db4",
                        "glosses": [
                            "simply (without ceremony or embarrassment, easily)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4bc10cf-d37e-3f8f-8f52-a984ca1e8ea3",
                        "entry_id": "8d373896-64d0-3e2b-8634-85721bad1db4",
                        "glosses": [
                            "simply. quite simply, plainly (put simply/directly)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9195d6ba-322c-4fe1-b101-363cb2e4c856",
                                "sense_id": "e4bc10cf-d37e-3f8f-8f52-a984ca1e8ea3",
                                "text": "У нас по́просту нет ме́ста для вас.",
                                "translation": "We simply do not have room for you.",
                                "english": "We simply do not have room for you."
                            },
                            {
                                "example_id": "4e4a9a12-74ce-4001-afd3-3edf25382b1e",
                                "sense_id": "e4bc10cf-d37e-3f8f-8f52-a984ca1e8ea3",
                                "text": "Э́то по́просту поли́тика униже́ния.",
                                "translation": "This is quite simply a policy of humiliation.",
                                "english": "This is quite simply a policy of humiliation."
                            }
                        ]
                    }
                ],
                "translations": [],
