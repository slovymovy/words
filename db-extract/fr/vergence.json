                        "examples": [
                            {
                                "example_id": "15a8e52e-5db6-43bc-94b6-a99ff8408f1b",
                                "sense_id": "4e581d5f-c1e2-3fba-9ca8-21370028478d",
                                "text": "1738 Philippe Hecquet, La medecine naturelle chez Guillaume Cavelier, p. 646.\n\"il [Hippocrate] recommande de bien s'assurer de la vergence des humeurs, cest-a-dire, d'où elles partent & vers où elles tendent.\""
                            },
                            {
                                "example_id": "2f967edb-afe7-4375-b521-f3b82ef3b582",
                                "sense_id": "4e581d5f-c1e2-3fba-9ca8-21370028478d",
                                "text": "1740 Philippe Hecquet, La medecine, la chirurgie, et la pharmacie des pauvres, t. 2, chez la Veuve Alix, p. 354.\n\"C'est que, suivant le langage dHippocrate, l'on ne sçauroit avoir trop d'égard à la vergence des humeurs en fait de purgation, quò vergunt humores eò ducendi.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "9c5e2ee5-666f-32f6-9565-64d710bc806d",
                        "entry_id": "d8c5fa18-09db-31aa-85a7-3bdbe579c71b",
                        "glosses": [
