                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b62b2705-0f04-33f0-9733-c549ae5ec58c",
                                        "entry_id": "62977de6-10e4-3ac7-839a-25eb0293318c",
                                        "glosses": [
                                            "The dried, wrinkled fruit of certain species of plum."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "706e0ff2-86f0-3d88-8190-250238ce89c9",
                                        "entry_id": "62977de6-10e4-3ac7-839a-25eb0293318c",
                                        "glosses": [
                                            "Something wrinkly like a prune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a81af2-7769-4663-afb4-84c6220bc162",
                                                "sense_id": "706e0ff2-86f0-3d88-8190-250238ce89c9",
                                                "text": "We are not free when we are in the grip of the false conditioning that decrees that we need sex. We are not free if we believe the culture's ominous warnings that we will become \"horny\" (what a callous, offensive word) and frustrated and neurotic and finally shrivel up into prunes and have to abandon hope of being good, creative, effective people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c909697-aaff-3f7c-a529-3f7d93a46c35",
                                        "entry_id": "62977de6-10e4-3ac7-839a-25eb0293318c",
                                        "glosses": [
                                            "An old woman, especially a wrinkly one."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "prune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "315df4cc-d091-3abc-aea3-50b36816fa19",
                                        "entry_id": "7347a26a-47b3-35c1-a524-435744dc3d34",
                                        "glosses": [
                                            "To become wrinkled like a dried plum, as the fingers and toes do when kept submerged in water."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41684c08-cfaa-437a-b60b-28ce06806718",
                                                "sense_id": "315df4cc-d091-3abc-aea3-50b36816fa19",
                                                "text": "I hardly left that spot in my pool that month even when my fingers pruned and chlorine dried out my skin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prune",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee26403f-c6d0-3647-89ae-7e94bc573dc4",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "To remove excess material from a tree or shrub; to trim, especially to make more healthy or productive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbaebb76-171a-4594-9cd8-f96f2b770f48",
                                                "sense_id": "ee26403f-c6d0-3647-89ae-7e94bc573dc4",
                                                "text": "A good grape grower will prune the vines once a year."
                                            },
                                            {
                                                "example_id": "03183bdc-6a8e-4ab0-8615-1b21662fb146",
                                                "sense_id": "ee26403f-c6d0-3647-89ae-7e94bc573dc4",
                                                "text": "But poore old man, thou prun'ſt a rotten tree, / That cannot ſo much as a bloſſome yeelde"
                                            },
                                            {
                                                "example_id": "3c3f5ac6-41d8-4303-bcdf-9dd96cc0babc",
                                                "sense_id": "ee26403f-c6d0-3647-89ae-7e94bc573dc4",
                                                "text": "Our delightful task / To prune these growing plants, and tend these flowers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8704a5b-f76e-360a-a0b2-2661d23132a4",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "To cut down or shorten (by the removal of unnecessary material)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "791d704e-dfc0-46f2-a72e-1732277e38b4",
                                                "sense_id": "b8704a5b-f76e-360a-a0b2-2661d23132a4",
                                                "text": "to prune a budget, or an essay"
                                            },
                                            {
                                                "example_id": "23800068-d7bf-47b8-8697-2890f208b67c",
                                                "sense_id": "b8704a5b-f76e-360a-a0b2-2661d23132a4",
                                                "text": "taking into consideration how they [laws] are to be pruned and reformed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5aef5b2-f697-3272-9046-62dcf1708847",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "To remove (something unnecessary) for the sake of cutting down or shortening that which it was previously part of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "611f7fb5-5d4f-4442-b427-f309e789ceb1",
                                                "sense_id": "c5aef5b2-f697-3272-9046-62dcf1708847",
                                                "text": "When internal dissension and a decline in popularity set in, Johnny was pruned from the Crests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5276e703-a9e0-3988-9d91-2f83e693e086",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "To remove unnecessary branches from a tree data structure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5edfd05-6d3d-37ca-a99f-e86b7d7783c3",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "to trim the feathers with the beak"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f03b2f0e-4b43-373c-9354-767a52f64058",
                                        "entry_id": "bebb4da3-6eaf-383c-be89-92103ce7f4d7",
                                        "glosses": [
                                            "To preen; to prepare; to dress."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36a5f4b0-7904-4b5a-9abf-3024725a0b2c",
                                                "sense_id": "f03b2f0e-4b43-373c-9354-767a52f64058",
                                                "text": "She gins her feathers fowle disfigured\nProwdly to prune, and sett on every side."
                                            },
                                            {
                                                "example_id": "c547629a-d6e8-49fa-aa5a-6434ae873eda",
                                                "sense_id": "f03b2f0e-4b43-373c-9354-767a52f64058",
                                                "text": "For 'tis observed of every scribbling man, / He grows a fop as fast as e'er he can; / Prunes up, and asks his oracle, the glass, / If pink or purple best become his face."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
