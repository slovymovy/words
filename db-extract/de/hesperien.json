                "senses": [
                    {
                        "sense_id": "3f089a1c-af58-3cbd-82a6-be01924a68d4",
                        "entry_id": "88398a7b-18b0-3a10-a3bb-52befdeb29e4",
                        "glosses": [
                            "(von Griechenland aus) gegen Westen gelegenes Land, besonders Spanien und Italien"
                        ],
                        "tags": [
                            "antike Literatur"
                        ],
                        "examples": [
                            {
                                "example_id": "80ba25de-567a-4192-baf1-344a09be4450",
                                "sense_id": "3f089a1c-af58-3cbd-82a6-be01924a68d4",
                                "text": "„Griechenland und Hesperien, die beiden Kristallisationspunkte der abendländischen Kulturgeschichte, waren für ihn die Pforten zum Verständnis des Ganges von Leben und Poesie.“"
                            },
                            {
                                "example_id": "d9ac4d62-5640-4fda-baee-750ec9158f07",
                                "sense_id": "3f089a1c-af58-3cbd-82a6-be01924a68d4",
                                "text": "„Der Rest seines kurzen Lebens bestand aus einer Reihe von Ortswechseln, von denen ihn jeder ein wenig weiter nach Hesperien verwies als der vorherige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
