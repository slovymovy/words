                "senses": [
                    {
                        "sense_id": "e1a65ee3-253c-3547-a6fa-3bb85b6888cc",
                        "entry_id": "a03015c0-5845-3d8b-bda0-d6488bc32381",
                        "glosses": [
                            "onvoltooid deelwoord van zwaaien"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "aa5bfa36-6e4d-45d9-8ac2-3ea3840db99a",
                                "sense_id": "e1a65ee3-253c-3547-a6fa-3bb85b6888cc",
                                "text": "De man probeerde het vliegtuig al schreeuwend en zwaaiend te stoppen, maar werd tegen gehouden door grondpersoneel. ,,Hij klopte ook nog op het raam van de terminal om te zorgen dat het toestel zou wachten\", aldus een woordvoerder van de luchthaven."
                            },
                            {
                                "example_id": "7a281506-f413-49a7-8c86-0149d718c410",
                                "sense_id": "e1a65ee3-253c-3547-a6fa-3bb85b6888cc",
                                "text": "Iets hiervan heeft nog lang geleefd in de `Sinterklaaskerels'. Het waren jongens in vrouwenkleren, zwaaiend met een bezem."
                            },
                            {
                                "example_id": "fcbc6aa7-7bb3-4098-9e93-6e7a4ffe894d",
                                "sense_id": "e1a65ee3-253c-3547-a6fa-3bb85b6888cc",
                                "text": "Luidkeels schreeuwend en wild zwaaiend met mijn armen hoopte ik de mensen voor me te doen stoppen, maar ze waren te ver vooruit en zagen me niet."
                            }
                        ]
                    }
