                        "entry_id": "1d6a92de-7e37-3ba6-b22b-9c555e2b64c1",
                        "glosses": [
                            "feiger, verschüchterter, unfähiger oder dummer Mensch"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "96324f17-9a20-4877-b5aa-57ec367bdfdb",
                                "sense_id": "158edcf0-f04a-3200-b661-790747939101",
                                "text": "Der kann gar nichts, dieser Schwachmat!"
                            }
                        ],
                        "sense_index_json": "\"1\""
