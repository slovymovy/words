                                        "entry_id": "a29020cf-2d16-394c-9124-f1e93082f032",
                                        "glosses": [
                                            "Liege, auf der man sich sonnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5144449f-9368-4d35-800a-ef45e98b8f82",
                                                "sense_id": "ae456141-ff4a-36ed-b593-86057d7f7d7b",
                                                "text": "Die bestellten Sonnenliegen sind nicht vor der Saison angekommen."
                                            },
                                            {
                                                "example_id": "54817fdf-401c-4d4a-95f5-84605197b4b4",
                                                "sense_id": "ae456141-ff4a-36ed-b593-86057d7f7d7b",
                                                "text": "„Nina und drei andere Mädchen drängten sich auf einer Sonnenliege.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ada8cf1-583e-4dcd-89f1-2b3dfdb1287c",
                        "source_entry_id": "8f5bf42c-970a-38f9-8254-2c72e62899a5",
