                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sucedáneo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a16ef9b4-4a61-3567-a709-a9fe3d8d9c97",
                                        "entry_id": "9c0b310f-cc5b-3cca-b03f-453125dacde6",
                                        "glosses": [
                                            "Que se usa para reemplazar a otra sustancia, por tener propiedades parecidas o iguales. Generalmente se hace por escasez o precio. Se aplica mucho en los alimentos, por ejemplo, en la leche materna."
                                        ],
                                        "tags": [
                                            "masculine",
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a26b4c09-fd63-398e-bcc3-278dd63093c3",
                                        "entry_id": "9c0b310f-cc5b-3cca-b03f-453125dacde6",
                                        "glosses": [
                                            "Que por ser de baja calidad parece una mala imitación.^([cita requerida])"
                                        ],
                                        "tags": [
                                            "Se usa más como sustantivo"
                                        ],
