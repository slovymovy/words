                    "frequency": "Low",
                    "semantic_group_id": "anatomie_humaine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'athlète impressionnait ses adversaires par sa massive <w>encolure</w> et la largeur de sa carrure."
