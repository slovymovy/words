                "senses": [
                    {
                        "sense_id": "1c326e9d-9d6d-3305-9c17-2161e15bf2ef",
                        "entry_id": "2b75ec58-2662-3d47-85a7-5e1ffd7d6dab",
                        "glosses": [
                            "odnoszący się do Nazaretu, związany z Nazaretem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92eb9460-3ba8-4762-83d8-57ab51afce2b",
                                "sense_id": "1c326e9d-9d6d-3305-9c17-2161e15bf2ef",
                                "text": "Przez dłuższy czas Domek Nazaretański, zwany obecnie Loretańskim, stał na wolnym powietrzu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "49ad8907-d741-38f7-a5e9-ba072698584e",
                        "entry_id": "2b75ec58-2662-3d47-85a7-5e1ffd7d6dab",
                        "glosses": [
                            "odnoszący się do nazaretanek, związany z nazaretankami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f357fa-71c0-4c2b-a307-71827ff7adc1",
                                "sense_id": "49ad8907-d741-38f7-a5e9-ba072698584e",
                                "text": "Najpiękniejszym owocem nazaretańskiego charyzmatu jest męczeńska śmierć sióstr z Nowogródka"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3fcaf6d-3b88-43e0-9463-d04eec6ceb21",
                        "source_entry_id": "2b75ec58-2662-3d47-85a7-5e1ffd7d6dab",
                        "source_sense_id": "1c326e9d-9d6d-3305-9c17-2161e15bf2ef",
                        "target_lang_word": "Nazarene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nazarene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73accfeb-be21-3ea3-b099-3470b72a0cad",
                                        "entry_id": "a447031f-46a4-304e-a0a6-ea980499b60f",
                                        "glosses": [
                                            "Of or pertaining to Nazareth or its people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "49bdb198-eb33-3743-8733-a22440d49a94",
                                        "entry_id": "a447031f-46a4-304e-a0a6-ea980499b60f",
                                        "glosses": [
                                            "Of or relating to the Church of the Nazarene."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a88c3f09-15a5-4d28-9fd8-132d0a81c592",
                                                "sense_id": "49bdb198-eb33-3743-8733-a22440d49a94",
                                                "text": "Holiness Today is a Nazarene magazine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nazarene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df24f16f-5610-37b0-93c7-abe634e76491",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A person from Nazareth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b84be66-3eff-4253-b8e2-ea8c4e5d0daf",
                                                "sense_id": "df24f16f-5610-37b0-93c7-abe634e76491",
                                                "text": "While Jenin was starving under curfew, Nazarenes were only twenty minutes away, watching televised footage of their neighbours ‘in solidarity’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533f3bba-34f5-366d-9926-20f4f15f2d84",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A member of the Jewish sect of the Nazarenes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b19b8cfc-19f0-47dc-8451-d22586397d06",
                                                "sense_id": "533f3bba-34f5-366d-9926-20f4f15f2d84",
                                                "text": "He was formerly with the sect of the Pharisees, but now he is a Nazarene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a28392b-3814-3405-8d9f-fdaa795d8551",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A Christian, a follower of Jesus."
                                        ],
                                        "tags": [
                                            "in Greek"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c0784dc-7725-3e00-9d0b-ec4055f9eb09",
                                        "entry_id": "c4a8213a-0373-3c55-8c5d-6ea355a7edc5",
                                        "glosses": [
                                            "A member of the Church of the Nazarene."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cb0d614-483b-4d77-8b84-09a9cb93c5b1",
                                                "sense_id": "2c0784dc-7725-3e00-9d0b-ec4055f9eb09",
                                                "text": "I have been a Nazarene for several years; I joined the church in 1946."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Nazarene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b50bf1c0-fcf4-3102-ad53-3e5b1ead1e77",
                                        "entry_id": "801cf7b0-8b92-3342-a414-b3f3c404814e",
                                        "glosses": [
                                            "an epithet of Jesus Christ"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf93fe07-493b-4ca5-be76-f9eb436a2ebd",
                        "source_entry_id": "2b75ec58-2662-3d47-85a7-5e1ffd7d6dab",
                        "source_sense_id": "1c326e9d-9d6d-3305-9c17-2161e15bf2ef",
                        "target_lang_word": "nazaréen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nazaréen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51a202e8-2cc4-3f87-8260-8155f5585490",
                                        "entry_id": "fca35dbf-3bbf-35e1-a318-9fab571e8bd2",
                                        "glosses": [
                                            "Relatif à Nazareth, en Palestine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f946e20-8c03-4dec-8196-0a58e79565d6",
                                                "sense_id": "51a202e8-2cc4-3f87-8260-8155f5585490",
                                                "text": "Jean-Paul II, regardant la maison nazaréenne à Lorette, fait un vœu pour tous les enfants du monde."
                                            },
                                            {
                                                "example_id": "cdc5cb74-4150-4940-8f1a-341ddf0cf4b9",
                                                "sense_id": "51a202e8-2cc4-3f87-8260-8155f5585490",
                                                "text": "La nuit commençait à geler dur. Les rues étaient aussi désertes qu’une crypte nazaréenne. Seuls les boulangers étaient encore éveillés. — (Daniel Nayeri, Brigade des crimes imaginaires, dans Brigade des crimes imaginaires et autres histoires fantastiques et déglinguées, traduit de l’anglais par Valérie Le Plouhinec, Hélium, 2008, page 23)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a511eac0-e47d-3803-85be-010b877bffda",
                                        "entry_id": "fca35dbf-3bbf-35e1-a318-9fab571e8bd2",
                                        "glosses": [
                                            "Chrétien, du Christ."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd22cff2-1525-475e-b4c2-07d27b32d243",
                                                "sense_id": "a511eac0-e47d-3803-85be-010b877bffda",
                                                "text": "Le fier chrétien verrait alors si la fille du peuple élu de Dieu ne saurait pas affronter la mort avec autant de courage que la plus fière des jeunes filles nazaréennes, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9ddc2e-6132-36c4-9d5b-e82bcd42fba4",
                                        "entry_id": "fca35dbf-3bbf-35e1-a318-9fab571e8bd2",
                                        "glosses": [
                                            "Relatif au mouvement pictural germanique de renouveau de la peinture religieuse au début du XIXᵉ siècle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92d25fd9-45bb-42db-b6e8-5d7d1bacf25b",
                                                "sense_id": "7b9ddc2e-6132-36c4-9d5b-e82bcd42fba4",
                                                "text": "Les peintres nazaréens, influencés à la fois par le catholicisme et le romantisme se donnèrent pour objectif de renouveler l'art religieux par l'étude des anciens maîtres italiens et allemands."
                                            },
                                            {
                                                "example_id": "25a2c6ed-48c8-468a-8b24-5bb993fe2e21",
                                                "sense_id": "7b9ddc2e-6132-36c4-9d5b-e82bcd42fba4",
                                                "text": "Rome ne fera que renforcer l’inspiration religieuse de Philipp. Il rejoint là-bas l’école dite nazaréenne, un groupe de jeunes artistes allemands ou autrichiens qui, iconographiquement, renouent avec la naïve piété de la Renaissance italienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nazaréen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "872c6efa-81af-3d22-b303-431229ed0117",
                                        "entry_id": "e351890b-695a-3b1b-ac86-7404901b8380",
                                        "glosses": [
                                            "Hérétique appartenant aux nazaréens."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b94a531f-1066-310a-90c8-3e34fdf5c869",
                                        "entry_id": "e351890b-695a-3b1b-ac86-7404901b8380",
                                        "glosses": [
                                            "Membre du mouvement artistique (pictural) dit des « nazaréens » (XIXᵉ siècle germanique : au départ à Vienne en Autriche)."
                                        ],
                                        "tags": [],
