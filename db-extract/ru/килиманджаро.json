                                        "entry_id": "1b63f04b-7b40-3d86-bf11-eb284ee96df4",
                                        "glosses": [
                                            "najwyższa góra Afryki położona w Tanzanii niedaleko granicy z Kenią"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d35ff8-0f81-4037-a120-3a49c7e56d1c",
                                                "sense_id": "40102af6-2fad-3992-b7b5-f5345278e51e",
                                                "text": "Radził iść nie do Kilimandżaro, ale do Mrogoro i Usangora, bo tam są misje, zapewnił przyjęcie w nich, którego kilimandżarska, jako nowo utworzona i nie skończona, dać by nie mogła"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
