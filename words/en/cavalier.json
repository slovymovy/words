                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to adopt a <w>cavalier</w> because of their friendly and gentle temperament.",
                            "target_lang_translations": {
                                "ru": "Она решила завести <w>кавалера</w> из-за их дружелюбного и мягкого характера."
                            }
                        },
                        {
                            "text": "The <w>cavalier</w> sat patiently on the sofa waiting for its owner to return.",
                            "target_lang_translations": {
                                "ru": "<w>Кавалер</w> терпеливо сидел на диване, ожидая возвращения хозяина."
                            }
                        }
                    ],
                    "traits": [
