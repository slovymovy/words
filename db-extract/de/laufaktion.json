                ],
                "senses": [
                    {
                        "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                        "entry_id": "e4f3132d-1fda-31a1-9b3b-983f18a2e985",
                        "glosses": [
                            "Veranstaltung/Initiative, bei der Personen einzeln oder gemeinsam laufen – meist mit dem Ziel, sie zum Laufen zu motivieren oder einem bestimmten gemeinnützlichen Zweck (zum Beispiel dem Sammeln von Spenden) zu dienen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "636a4ba6-182e-4aa2-a601-ff30f95046c4",
                                "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                                "text": "„Wir wünschen allen Teilnehmern schon jetzt viel Spaß bei der Laufaktion und natürlich das Erreichen des angestrebten Ziels.“"
                            },
                            {
                                "example_id": "a3891352-8e60-4c4c-87b5-f3dc0541fc49",
                                "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                                "text": "„Es wäre natürlich begrüßenswert, wenn diese Laufaktion auch über die weitere Schulzeit beibehalten werden könnte.“"
                            },
                            {
                                "example_id": "a249878b-6e69-4e68-ba6e-6ce5e78988e1",
                                "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                                "text": "„Die Sponsoren für die Laufaktion hatten sich die Schülerinnen und Schüler zuvor in ihrem Bekanntenkreis selbst gesucht.“"
                            },
                            {
                                "example_id": "dca9ed50-ebe3-41ce-83d9-c763cd54bf3a",
                                "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                                "text": "„Die Preisgelder der Laufaktion, die von der Mainova AG jedes Jahr an die drei Kommunen vergeben werden, die im Aktionszeitraum die meisten Kilometer pro Einwohner erlaufen, müssen gemeinnützigen Organisationen zugutekommen – so die Teilnahmebedingung des Energiedienstleisters.“"
                            },
                            {
                                "example_id": "2d7b522a-f982-42bb-9716-cf449675c557",
                                "sense_id": "94bc5ef6-f1da-3442-903e-026c826e81b1",
                                "text": "„‚[…] Mein Dank gilt allen, die gelaufen sind, die als Sponsor fungierten und die die Laufaktion als Zuschauer zu einem unvergesslichen Erlebnis gemacht haben‚‘ erklärt Thorsten Kaatze, Vorstand der Stiftung Universitätsmedizin Essen und Kaufmännischer Direktor des UK Essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7dac3352-9184-3944-8c64-5471e31fa098",
                        "entry_id": "e4f3132d-1fda-31a1-9b3b-983f18a2e985",
                        "glosses": [
                            "No glosses available"
                        ],
                        "tags": [
                            "no-gloss"
                        ],
                        "examples": [
                            {
                                "example_id": "4f275a14-c4aa-4032-a540-a395fc83bfcb",
                                "sense_id": "7dac3352-9184-3944-8c64-5471e31fa098",
                                "text": "„Higgins ging bei seiner Laufaktion mit der Schulter voran und traf den Verteidiger in der Brust.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
