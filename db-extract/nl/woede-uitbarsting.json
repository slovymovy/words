                "senses": [
                    {
                        "sense_id": "0c446ded-3abe-335b-b578-63706f02166a",
                        "entry_id": "1c0e577f-2cdb-3676-af42-8db8ca83abc6",
                        "glosses": [
                            "plotselinge uiting van grote woede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280c792a-96c5-4d8c-8169-947a302de9ff",
                                "sense_id": "0c446ded-3abe-335b-b578-63706f02166a",
                                "text": "Een wonderschone solo op de 'Nederlandse berg', een onvervalste woede-uitbarsting, een zoekgeraakt tijdritpak, drie Nederlandse etappeoverwinningen en een tweede en vijfde plaats in het eindklassement. Over deze Tour zal vooral vanuit Nederlands perspectief nog lang worden nagepraat."
                            },
                            {
                                "example_id": "5e250516-789a-4250-ae7e-9c33906b479f",
                                "sense_id": "0c446ded-3abe-335b-b578-63706f02166a",
                                "text": "De Argentijnse trainer zit een schorsing van vier wedstrijden uit vanwege zijn woede-uitbarsting langs de lijn tijdens het eerste duel met Arsenal in de halve finales van de Europa League."
                            },
                            {
                                "example_id": "ba7a114e-3a86-4e69-aa1e-73a67658765c",
                                "sense_id": "0c446ded-3abe-335b-b578-63706f02166a",
                                "text": "Een decadent etentje van de Venezolaanse president Nicolás Maduro heeft voor een woede-uitbarsting gezorgd onder de Venezolaanse bevolking. Er heerst al tijden hongersnood in het land."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa445f71-c212-4bd1-bb86-968942dd461d",
                        "source_entry_id": "1c0e577f-2cdb-3676-af42-8db8ca83abc6",
                        "source_sense_id": "0c446ded-3abe-335b-b578-63706f02166a",
                        "target_lang_word": "Wutausbruch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wutausbruch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fb31441-9b26-3466-8065-87dcded90fda",
                                        "entry_id": "71d70702-7fca-3c46-a1b4-211757f3f058",
                                        "glosses": [
                                            "plötzliche, oft heftige Entladung von Wut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656118a3-2aee-4d6e-a524-a749f30a3e88",
                                                "sense_id": "2fb31441-9b26-3466-8065-87dcded90fda",
                                                "text": "„Er suchte nur nach einem Grund für einen weiteren Wutausbruch.“"
                                            },
                                            {
                                                "example_id": "43f55ca9-9b8a-44fc-ab06-d54fa72a0278",
                                                "sense_id": "2fb31441-9b26-3466-8065-87dcded90fda",
                                                "text": "„Doch im Jahr 2005 reichte auch das nicht mehr, um seine Wutausbrüche zu besänftigen.“"
                                            },
                                            {
                                                "example_id": "92bfab9e-32b9-4e2c-b4d9-edc0e0a5858f",
                                                "sense_id": "2fb31441-9b26-3466-8065-87dcded90fda",
                                                "text": "„Seine Reizbarkeit nahm zu, und seine grundlosen Wutausbrüche gingen jetzt grösstenteils auf die Prinzessin Marja nieder.“"
                                            },
                                            {
                                                "example_id": "7528c7f6-a945-4699-b855-cca7eadc0cee",
                                                "sense_id": "2fb31441-9b26-3466-8065-87dcded90fda",
                                                "text": "„Gerettet hat mich meine Angst, das Volk zu reizen, dessen Wutausbrüche ich kannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
