                            {
                                "example_id": "17ec5a79-4d2b-45c2-82a5-79095bba8242",
                                "sense_id": "ff0280d3-e70b-3822-bd8e-793c25a8ed8a",
                                "text": "Hou toch op, je gedraagt je als een wijsneus."
