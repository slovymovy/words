                ],
                "senses": [
                    {
                        "sense_id": "c06baa53-ec9d-336e-a367-e214f306b5bc",
                        "entry_id": "e35dc2c9-aab2-3152-9c79-f083bbb6a621",
                        "glosses": [
                            "weibliche Person, die uriniert"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "8980510c-c95b-4827-abd4-e258d5b71669",
                                "sense_id": "c06baa53-ec9d-336e-a367-e214f306b5bc",
                                "text": "„›Pisserin‹ nannte sie ihre Mutter. Wenn sie in ihr Höschen gemacht hatte, musste Myriam es ausziehen, sich damit das Gesicht abwischen und es dann wieder anziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                        "entry_id": "e35dc2c9-aab2-3152-9c79-f083bbb6a621",
                        "glosses": [
                            "eine Beleidigung in der Bedeutung verachtenswerte weibliche Person"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "31f6db75-c132-43ea-a5d0-a2d2bb505f8f",
                                "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                                "text": "„Und ich sage Ihnen, dass Sie nichts weiter als eine bekackte Spießerin sind, die Knackis besuchen kommt, um sich ein gutes Gewissen zu holen, Sie dämliche Pisserin!“"
                            },
                            {
                                "example_id": "75364ad7-4491-4ed2-893d-e32e93347b36",
                                "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                                "text": "„Trauen Sie niemandem! Auch der kleinen Pisserin nicht. Hat sie doch eben noch freundlich und lieb mit Ihnen gesprochen, und schon ist sie weg.“"
                            },
                            {
                                "example_id": "9508bb4c-148d-42b1-bcc1-2ced14336a6e",
                                "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                                "text": "„Heilige Jungfrau, Pisserin, Pisserin, Pisserin, ich werde dich schlagen mit einer eisernen Ruthe! (Der Name des betreffenden Menschen ist dreimal zu rufen – Characteristisch ist das dreimalige Wiederholen des Schimpfwortes ‚Pisserin‘ […])“"
                            },
                            {
                                "example_id": "f42f7bea-b00f-4a3e-a5f5-90bff9fc91f8",
                                "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                                "text": "„Ich habe sieben Söhne,",
                                "translation": "eine Tochter, eine Pisserin.“"
                            },
                            {
                                "example_id": "068b38e5-a229-4887-bcb1-1daa6fa688f9",
                                "sense_id": "596c1dd7-4095-384f-88a8-b61b0c1e07ad",
                                "text": "„Weißt du Scheißhure nicht, ob es ein Rotzer oder eine Pisserin ist?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
