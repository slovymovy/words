                        "examples": [
                            {
                                "example_id": "fd9186e0-447a-4795-b1bc-8d9fad398f1f",
                                "sense_id": "96b71a21-7ed3-38d4-b287-5d66b7b6cf8d",
                                "text": "Zondagavond kwam het leven van de 41-jarige superster onverwachts ten einde. Hij stortte neer met zijn privéhelikopter. Samen met zijn 13-jarige dochter Gianna, ook een basketbaltalent, en nog een aantal andere inzittenden. De precieze oorzaak wordt nog onderzocht."
                            },
                            {
                                "example_id": "c3ebe625-438d-446d-992c-933f5e381ed5",
                                "sense_id": "96b71a21-7ed3-38d4-b287-5d66b7b6cf8d",
                                "text": "In 2003 werd zijn enorme basketbaltalent erkend en was hij de eerste keuze van Cleveland in de jaarlijkse draft. Hij nam direct het team bij de hand, haalde de play-offs voor het eerst in jaren en stond zelfs een keer in de NBA-finale."
                            },
                            {
                                "example_id": "4a917154-1d2f-4db1-a43e-9e435206f4d7",
                                "sense_id": "96b71a21-7ed3-38d4-b287-5d66b7b6cf8d",
                                "text": "Basketbaltalent Voorn in Groningen"
                            }
                        ]
