                                "target_senses": [
                                    {
                                        "sense_id": "dc47f65a-cbb0-37fb-8d97-ca96a657fbb0",
                                        "entry_id": "4d4cd714-0a14-3756-9392-42d1653922d6",
                                        "glosses": [
                                            "Prosateur grec."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904b1180-3671-4081-a449-94badd454c54",
                                                "sense_id": "dc47f65a-cbb0-37fb-8d97-ca96a657fbb0",
                                                "text": "Hérodote trouva des matériaux pour son histoire dans les écrits des logographes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a78995-d77b-3a31-a120-5f4ae6040815",
                                        "entry_id": "4d4cd714-0a14-3756-9392-42d1653922d6",
                                        "glosses": [
                                            "Prosateur grec.",
                                            "Rhéteur qui composait des plaidoyers pour des accusés qui les lisaient devant le tribunal."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84d5bc04-a6ad-4234-a17c-27eec52801e6",
                                                "sense_id": "f5a78995-d77b-3a31-a120-5f4ae6040815",
                                                "text": "À qui s’adresse-t-il ? Essentiellement aux logographes, qui font profession d’écrire les discours et les plaidoiries de ceux qui vont être confrontés à la justice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60f84215-3144-3c29-a46e-278923f00b73",
                                        "entry_id": "4d4cd714-0a14-3756-9392-42d1653922d6",
                                        "glosses": [
                                            "Sténographe."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85ab618d-0e4f-4b4d-b99f-6d9a417033ea",
                                                "sense_id": "60f84215-3144-3c29-a46e-278923f00b73",
                                                "text": "La famille royale fut replacée dans la loge du logographe, pour assister aux décisions qui allaient être prises, et aux scènes qui allaient se passer dans le corps législatif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04cf5ebb-005a-4c22-8fe4-aa56eb1a50b6",
                        "source_entry_id": "721d6efb-64d3-3fd4-bf8b-2ebab3c76069",
                        "source_sense_id": "696226ab-9ef0-398d-9b5a-411c18b474d5",
                        "source_sense_description": "character or symbol that represents a word or phrase",
                        "target_lang_word": "Logogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Logogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                        "entry_id": "ebf7b398-daf4-32d9-8319-396fed4f0324",
                                        "glosses": [
                                            "Zeichen, das symbolisch für ein Wort/Lexem steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9fe95ab-6da9-421a-9e56-b36609ef2883",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "„Wenn diese nicht nur für Begriffe und Ideen standen, sondern für Wörter, spricht man von Logogrammen.“"
                                            },
                                            {
                                                "example_id": "ef00715a-3d2a-4b2b-964f-72acfb6fdf29",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "„Nicht nur die Inhalts-, auch die Ausdrucksseite der Logogramme liegt fest, lässt sich aber nicht aus den einzelnen Segmenten des Zeichens erschließen.“"
                                            },
                                            {
                                                "example_id": "f20333a0-268f-46fe-b895-80e232d193ca",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "Beispiele für Logogramme findet man auf jeder Schreibmaschinentastatur/Computertastatur: §, $, @, %, &."
                                            },
                                            {
                                                "example_id": "1355b854-aa22-4b65-a8f5-8ebe4c1fee15",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "„Das Interessante an der japanischen Schrift in dieser Hinsicht ist, daß sie in systematischer Funktionsdifferenzierung Elemente strukturell verschieden konstituierter Zeichenklassen verwendet: nicht selbst bedeutungstragende Silbenzeichen (Kana) und bedeutungstragende Logogramme (Kanji).“"
                                            },
                                            {
                                                "example_id": "097d1136-f693-41c4-ae6b-c441a7d8ff72",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "„Die ältesten Schriftformen haben mit dem Wortklang überhaupt nichts zu tun. Sie setzen für jede Sache ein Symbol, ein Zeichen, ein Ideo- oder Logogramm.“"
                                            },
                                            {
                                                "example_id": "17b28f30-a9c7-48b0-97d0-828ac2e932fb",
                                                "sense_id": "1c2bd075-1fc3-3ea6-95a0-b36af99a3835",
                                                "text": "„Logogramme sind auch unsere Zahlzeichen wie 1, 2, 3.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
