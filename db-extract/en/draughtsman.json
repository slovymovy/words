                                                "example_id": "6b10738b-9c4f-4c81-81ed-7611800e22ad",
                                                "sense_id": "b6c19450-e304-355d-8540-cfd6e85812c8",
                                                "text": "„Die Bekanntschaft mit den dortigen Redakteurinnen und Zeichnern soll ihm später noch einmal sehr nützlich werden.“"
                                            },
                                            {
                                                "example_id": "09a422ba-7e5a-4b88-a68f-aebe10465673",
                                                "sense_id": "b6c19450-e304-355d-8540-cfd6e85812c8",
                                                "text": "„Der Zeichner stand in beredter Stummheit neben ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "32257e4d-9a16-317c-b244-c25f2be3dd9b",
