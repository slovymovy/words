                ],
                "senses": [
                    {
                        "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                        "entry_id": "94e6c512-26e8-3495-b704-4e86aaec7fc2",
                        "glosses": [
                            "Resonanzfrequenz des Vokaltraktes"
                        ],
                        "tags": [
                            "Phonetik",
                            "speziell akustische Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "bc0274f5-dcc8-4507-a8e2-77453313f872",
                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                "text": "„Die absolute Lage der Formanten ist von der Gesamtlänge des Ansatzrohres abhängig (invers proportional)…“"
                            },
                            {
                                "example_id": "e3cf6414-0dd0-44c9-a1bc-ac95d78dfd2c",
                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                "text": "„Vor allem die drei untersten Formanten sind im Allgemeinen deutlich ausgeprägt und sind verschieden für verschiedene Vokale.“"
                            },
                            {
                                "example_id": "da357a22-7837-45cb-9e96-ebbfd42b16b8",
                                "sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                                "text": "„Wie Sie sehen, sind die Vokale durch die unterschiedlich gelagerten Formanten und Formantenkombinationen voneinander abgehoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4337cdc9-15f8-4970-9ef8-c19ecfeb835a",
                        "source_entry_id": "94e6c512-26e8-3495-b704-4e86aaec7fc2",
                        "source_sense_id": "0eda8875-669b-300e-b282-5b77a68ad8a7",
                        "source_sense_description": "Phonetik, speziell akustische Phonetik: Resonanzfrequenz des Vokaltraktes",
                        "target_lang_word": "formant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb3a16b-10ac-3a41-8606-0f1116209ebc",
                                        "entry_id": "a3afca15-0352-3da7-9512-677b93b8f5b2",
                                        "glosses": [
                                            "A band of frequencies, in a sound spectrum, that have a greater intensity; they determine the quality of a sound; especially the characteristic sounds of the consonants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba191ef-3102-400a-91d5-1cd76b50bff9",
                                                "sense_id": "5cb3a16b-10ac-3a41-8606-0f1116209ebc",
                                                "text": "The resonances of the vocal tract are called formants. Trying to hear the separate formants in a vowel is difficult. We are so used to a vowel being a single meaningful entity that it is difficult to consider it as a sound with separable bits. But it is possible to say vowels so that some of their component parts are more obvious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e72f086c-5e92-3881-9bc0-6cf838ea78f8",
                                        "entry_id": "a3afca15-0352-3da7-9512-677b93b8f5b2",
                                        "glosses": [
                                            "Synonym of formative (“language unit, typically a morph, that has a morphological function”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
