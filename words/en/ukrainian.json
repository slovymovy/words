    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e69d01ad-c4e8-3e0e-ba3d-f94bf2c1478a",
                    "sense_definition": "Relating to Ukraine, its people, or its language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a traditional <w>Ukrainian</w> dinner with dumplings.",
                            "target_lang_translations": {
                                "ru": "Они подали традиционный <w>украинский</w> ужин с варениками.",
                                "zh": "他们供应了传统的<w>乌克兰的</w>晚餐，配有饺子。"
                            }
                        },
                        {
                            "text": "The <w>Ukrainian</w> flag has two horizontal bands of blue and yellow.",
                            "target_lang_translations": {
                                "ru": "<w>Украинский</w> флаг состоит из двух горизонтальных полос: синей и жёлтой.",
                                "zh": "<w>乌克兰的</w>国旗由蓝黄两色横条组成。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Ukrainian culture",
                        "Ukrainian border",
                        "Ukrainian people",
                        "Ukrainian government"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Украине, её народу или языку",
                        "zh": "与乌克兰、乌克兰人或乌克兰语相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украи́нский",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌克兰的",
                                "target_lang_sense_clarification": "形容词，表示所属或相关"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0621a52-8a34-35e9-b3f0-3f6704dca2d6",
                    "sense_definition": "A citizen of Ukraine or a person of Ukrainian ethnicity.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>Ukrainian</w> who lives in London.",
                            "target_lang_translations": {
                                "ru": "Он <w>украинец</w>, который живёт в Лондоне.",
                                "zh": "他是一位住在伦敦的<w>乌克兰人</w>。"
                            }
                        },
                        {
                            "text": "Many <w>Ukrainians</w> are proud of their national heritage.",
                            "target_lang_translations": {
                                "ru": "Многие <w>украинцы</w> гордятся своим национальным наследием.",
                                "zh": "许多<w>乌克兰人</w>为他们的民族遗产感到自豪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "native Ukrainian",
                        "young Ukrainian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гражданин Украины или человек украинского происхождения",
                        "zh": "乌克兰公民或具有乌克兰血统的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украи́нец",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "украи́нка",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌克兰人",
                                "target_lang_sense_clarification": "名词，指代乌克兰国民或族裔"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6f3bad71-50ab-3ee4-9885-6832f1c1daf7",
                    "sense_definition": "The East Slavic language spoken by Ukrainians; the official language of Ukraine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She wants to learn to speak <w>Ukrainian</w> fluently.",
                            "target_lang_translations": {
                                "ru": "Она хочет научиться бегло говорить на <w>украинском</w>.",
                                "zh": "她想学习如何流利地说<w>乌克兰语</w>。"
                            }
                        },
                        {
                            "text": "The instructions are written in both <w>Ukrainian</w> and English.",
                            "target_lang_translations": {
                                "ru": "Инструкции написаны как на <w>украинском</w>, так и на английском.",
                                "zh": "说明书是用<w>乌克兰语</w>和英语两种语言编写的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Ukrainian",
                        "learn Ukrainian",
                        "in Ukrainian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восточнославянский язык, на котором говорят украинцы; официальный язык Украины",
                        "zh": "乌克兰人使用的东斯拉夫语，也是乌克兰的官方语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украи́нский язы́к",
                                "target_lang_sense_clarification": "название языка"
                            },
                            {
                                "target_lang_word": "украи́нский",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乌克兰语",
                                "target_lang_sense_clarification": "名词，指代语言名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}