                ],
                "senses": [
                    {
                        "sense_id": "bab3472d-5fa6-34e7-bed5-34eaec599f05",
                        "entry_id": "3a5bbbd2-5c89-3a55-b2fd-5018416e7c00",
                        "glosses": [
                            "Extracôtier, se trouvant en haute mer, au large des côtes."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b2e2fd4d-699b-41fb-8ba3-798a541084e0",
                                "sense_id": "bab3472d-5fa6-34e7-bed5-34eaec599f05",
                                "text": "Les plateformes pétrolières offshores se multiplient."
                            },
                            {
                                "example_id": "43a6351d-0661-488a-843f-c4fee6f46b1b",
                                "sense_id": "bab3472d-5fa6-34e7-bed5-34eaec599f05",
                                "text": "Dans l’ensemble, on estime que la Roumanie possède des réserves de gaz offshore d’environ 200 milliards de mètres cubes, ce qui devrait contribuer à diversifier l’approvisionnement de la région."
                            }
                        ]
                    },
                    {
                        "sense_id": "4708413c-aaa4-3ef6-9c3c-94f0297fd668",
                        "entry_id": "3a5bbbd2-5c89-3a55-b2fd-5018416e7c00",
                        "glosses": [
                            "Qualifie la pratique consistant à réaliser des activités, en particulier bancaires, dans certains pays où la législation offre des facilités."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29dc0e70-5780-4064-9360-14d9997576eb",
                                "sense_id": "4708413c-aaa4-3ef6-9c3c-94f0297fd668",
                                "text": "Le GAFI traque les pays permettant le trafic international utilisant des comptes offshore."
                            },
                            {
                                "example_id": "1b110bf0-a44c-441f-b1ef-08db9996d9c1",
                                "sense_id": "4708413c-aaa4-3ef6-9c3c-94f0297fd668",
                                "text": "Transaction discrète avec la justice belge contre l’abandon des poursuite pour fraude à la domiciliation, immatriculation de son bateau à Malte avec pavillon des îles Caïmans, lobbying auprès des députés pour qu’ils votent un amendement sur mesure permettant la construction de la Fondation Vuitton au cœur du bois de Boulogne, multiplication gourmande de sociétés offshore, de libertés avec l’impôt, de gestes philanthropiques liés à la défiscalisation plus qu’au mécénat."
                            }
                        ]
                    },
                    {
                        "sense_id": "f230d9a4-5bdc-39ac-88ec-8d0b24befd4d",
                        "entry_id": "3a5bbbd2-5c89-3a55-b2fd-5018416e7c00",
                        "glosses": [
                            "Qualifie une organisation permettant de réaliser un service depuis un autre pays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ae4da9-adb3-4e8c-8400-ebbc201a22db",
                                "sense_id": "f230d9a4-5bdc-39ac-88ec-8d0b24befd4d",
                                "text": "Le centre d’appel a été délocalisé auprès d’une société offshore située à l’ile Maurice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eba6ab45-f0d8-4dc5-a3b9-ab0cd1b27503",
                        "source_entry_id": "3a5bbbd2-5c89-3a55-b2fd-5018416e7c00",
