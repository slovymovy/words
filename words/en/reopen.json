                    "sense_definition": "To open again after being closed, either temporarily or permanently.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "open_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local library will <w>reopen</w> to the public next Monday after extensive renovations."
                        },
                        {
                            "text": "Many small shops struggled during the winter and could not <w>reopen</w> in the spring."
                        }
                    ],
                    "antonyms": [
                        "close"
                    ],
                    "common_phrases": [
                        "reopen to the public",
                        "reopen next week"
                    ]
                },
                {
                    "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                    "sense_definition": "To resume, start, or open something again, such as an investigation, a debate, or an establishment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "open_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police decided to <w>reopen</w> the investigation after new evidence came to light."
                        },
                        {
                            "text": "The government does not want to <w>reopen</w> the debate on international trade tariffs."
