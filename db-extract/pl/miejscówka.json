                        "target_lang_word": "Platzkarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platzkarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4894ac12-2556-3d30-814b-04fc948ff39a",
                                        "entry_id": "a0d3257d-be2c-328c-b3f0-d59a66527dbf",
                                        "glosses": [
                                            "Reservierung für einen Sitzplatz in Verkehrsmitteln oder bei Veranstaltungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeb358d2-a213-4a07-9f35-aeebee354e8b",
                                                "sense_id": "4894ac12-2556-3d30-814b-04fc948ff39a",
                                                "text": "„Ziel des Konzerns muß es deshalb sein, die bisherigen Bahn-Abstinenzler zu überzeugten Schienenfans zu machen […]. Fraglich ist allerdings, ob die Rechnung bei Neukunden aufgeht, die mit einem Billigticket, aber ohne Platzkarte in einen überfüllten Zug steigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "912b70cd-7cab-3f1f-a3e1-e53d19424f07",
                                        "entry_id": "a0d3257d-be2c-328c-b3f0-d59a66527dbf",
                                        "glosses": [
                                            "Karte mit Namen, die einem Gast bei festlichen Veranstaltungen seinen Platz am Tisch gemäß einer Sitzordnung zuweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df841dba-441f-4ab1-b8b9-e27862a6e0bc",
                                                "sense_id": "912b70cd-7cab-3f1f-a3e1-e53d19424f07",
                                                "text": "„Ich war einer von Hunderten Gästen beim Dinner in Berlin. […] Als ich auf meine Platzkarte guckte, sah ich, dass ich genau an dem Tisch von der Frau Bundeskanzlerin und Herrn Obama sitze, und dachte noch einmal: O mein Gott.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
