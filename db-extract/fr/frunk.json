                    {
                        "sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
                        "entry_id": "45b0660c-bafc-3c41-bb4a-a6fcb22eee6a",
                        "glosses": [
                            "Coffre situé à l'avant d'une automobile."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "216d3e91-c636-43f7-8c67-36844e583817",
                                "sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
                                "text": "[…] ouvrez le frunk – l’air de rien – , posez votre poulet à l’intérieur, refermez votre frunk puis rentrez dans la boulangerie pour finir vos emplètes."
                            },
                            {
                                "example_id": "92c13f2f-92e2-4081-89a2-86d8686a2f15",
                                "sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
                                "text": "VW a décidé d’éviter un frunk, au lieu de pousser le pare-feu vers l’avant pour gagner plus d’espace pour les passagers."
                            },
                            {
                                "example_id": "6c37b83a-0e54-4a13-8aa2-4754daf39ef8",
                                "sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
                                "text": "Volvo fournit un câble de recharge, d’une longueur de deux mètres, pouvant être branché à une prise de 240 ou de 120 volts, lequel est remisé dans le frunk […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80d0e514-82ee-486d-94ab-b8d14a904e49",
                        "source_entry_id": "45b0660c-bafc-3c41-bb4a-a6fcb22eee6a",
                        "source_sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
                        "source_sense_description": "Coffre",
                        "target_lang_word": "froot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "froot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "178fe5d3-09da-3c97-bd83-c11a2b0a86af",
                                        "entry_id": "b2661a89-e557-36ca-9a9e-27b359d589a4",
                                        "glosses": [
                                            "A boot (storage compartment) located at the front rather than the rear of a car, especially an electric vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600a7176-7c56-4757-9583-a77a487e8aef",
                                                "sense_id": "178fe5d3-09da-3c97-bd83-c11a2b0a86af",
                                                "text": "\"There’s a tiny froot (front boot), and a long if not particularly deep actual boot with 656 litres of lugging capacity.\")"
                                            },
                                            {
                                                "example_id": "708c4320-4809-4f88-88a9-5c6f38032571",
                                                "sense_id": "178fe5d3-09da-3c97-bd83-c11a2b0a86af",
                                                "text": "\"In Australia, we like ‘froot’, for front boot.\")"
                                            },
                                            {
                                                "example_id": "c8ebb757-77ec-49f7-9a06-e131319d9ce8",
                                                "sense_id": "178fe5d3-09da-3c97-bd83-c11a2b0a86af",
                                                "text": "\"There is so much luggage space in the boot as well as under the bonnet, in the US that’s called the front trunk or “Frunk”, we call it the “Froot”. \")"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8b76efe-5601-4cde-b047-c11ba94a9044",
                        "source_entry_id": "45b0660c-bafc-3c41-bb4a-a6fcb22eee6a",
                        "source_sense_id": "17f9f3c8-9f31-34e1-b2ed-a2c8097b3689",
