        "fr-extract.jsonl": [
            {
                "entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                "word": "duègne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "575f7e89-e5cd-4eb2-997a-4c9ef8a19787",
                        "entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                        "tags": [
                            "plural"
                        ],
                        "form": "duègnes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                        "entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                        "glosses": [
                            "Gouvernante ou femme âgée chargée de veiller sur la conduite d’une jeune personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c00cf2c-d4d7-47c3-85fd-5e9c17459e10",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "C'était d'abord la duègne Barbara qui grondait cet imbécile de Pierrot …"
                            },
                            {
                                "example_id": "b2719fa1-795c-4995-8563-6bb02fd16345",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "Dumay devenu féroce, […], madame Latournelle en duègne trompée, madame Dumay qui partagea les craintes de son mari, se firent alors les espions de Modeste."
                            },
                            {
                                "example_id": "59ad7088-122d-4331-959c-81c88641ea82",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "Les alcades, les duègnes, les valets coquins et la sainte inquisition n'étaient, au dire de tous les vaudevillistes, institués que pour cela !"
                            },
                            {
                                "example_id": "642d1679-750d-4f4b-9722-b37b0e8b352f",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "Quant à la duègne, elle jouissait, grâce à son âge, du privilège d’une immuable laideur ; rien ne pouvait altérer cette physionomie de buis sculpté, où luisaient des yeux de chouette."
                            },
                            {
                                "example_id": "2b4eaccf-d70f-4401-bd78-8de21148ec9c",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "— J'ai le pressentiment que cette Espagnole est une affreuse duègne."
                            },
                            {
                                "example_id": "fb9a1347-4478-4d89-ab5a-fecfdde663d4",
                                "sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
                                "text": "« Ma fille, dit-il ne sera pas élevée par une duègne. Ces vieilles sottes inculquent à l’enfance des idées d’un autre âge ; elles ont des manies invétérées et l’obstination des mules, sans compter qu’il leur arrive fréquemment de répandre une aigre odeur. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35b86cd0-6830-4e1a-aef5-d7b0ffcfac7e",
                        "source_entry_id": "f22c4afa-7361-3cfb-b16e-8299743afd42",
                        "source_sense_id": "90a1d6c0-0e5a-3751-880c-5f208471ef43",
