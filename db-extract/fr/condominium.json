                    },
                    {
                        "form_id": "12cf8c0b-2de0-4913-8522-e4f76cf0c375",
                        "entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "tags": [],
                        "form": "condominion"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "467e3a20-b6c4-3eff-bfd4-ce1d43bd6c9c",
                        "entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "glosses": [
                            "Souveraineté de deux ou de plusieurs puissances sur un même pays."
                        ],
                        "tags": [
                            "Latinisme en droit"
                        ],
                        "examples": [
                            {
                                "example_id": "0ce710ba-ee57-4e88-ad60-12e8dc58dd12",
                                "sense_id": "467e3a20-b6c4-3eff-bfd4-ce1d43bd6c9c",
                                "text": "Il a été question d’un condominium : ce ne serait qu’une solution provisoire, peu satisfaisante du problème marocain."
                            },
                            {
                                "example_id": "8ceb52c9-29b9-4c98-b86f-5d4925b7ca34",
                                "sense_id": "467e3a20-b6c4-3eff-bfd4-ce1d43bd6c9c",
                                "text": "La rivalité franco-britannique aux Nouvelles-Hébrides se résout en 1906 par une convention instituant un condominium."
                            }
                        ]
                    },
                    {
                        "sense_id": "51d5ff4d-7530-3871-b3c0-c454a4a7b470",
                        "entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "glosses": [
                            "Pays ayant ce statut."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e2a74a67-ac78-3fe2-acff-cf5f9fc0ea17",
                        "entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "glosses": [
                            "Immeuble en copropriété."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "652f8058-45ce-4265-9fc5-2df68bd2efaf",
                                "sense_id": "e2a74a67-ac78-3fe2-acff-cf5f9fc0ea17",
                                "text": "Villes nouvelles, condominiums climatisés pour la classe moyenne supérieure, maisons en dur sur plusieurs étages destinées aux habitants des nouvelles marges urbaines des grandes métropoles, mais aussi ports, ponts et barrages : le marché africain du ciment connaît une croissance de 5 % en moyenne par an depuis le début du siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a004428-fe41-31ef-989d-7b23a08a5e0a",
                        "entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "glosses": [
                            "Appartement dans un immeuble en copropriété."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72a32d82-771f-4ab5-b6ee-30ea3d350ef2",
                        "source_entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
                        "source_sense_id": "467e3a20-b6c4-3eff-bfd4-ce1d43bd6c9c",
                        "source_sense_description": "Souveraineté de deux ou de plusieurs puissances sur un même pays.",
                        "target_lang_word": "Kondominium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kondominium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "21521378-6ff3-3b6f-acca-b55af3dd6a87",
                                        "entry_id": "aa5905c1-e119-383f-a92a-e13a887c570e",
                                        "glosses": [
                                            "Herrschaft mehrerer Staaten über dasselbe Gebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffe612a7-c824-44d4-b7f2-3a3281ba45cb",
                                                "sense_id": "21521378-6ff3-3b6f-acca-b55af3dd6a87",
                                                "text": "„Bei einem Kondominium teilen sich mehrere Staaten die territoriale Souveränität über ein ihnen gemeinsam gehörendes Gebiet. Das Gebiet selbst ist nicht Träger von Souveränität und damit auch nicht Völkerrechtssubjekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65ecf909-d167-33d8-af43-f22a88409f5b",
                                        "entry_id": "aa5905c1-e119-383f-a92a-e13a887c570e",
                                        "glosses": [
                                            "Gebiet, das unter der Herrschaft mehrerer Staaten steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6747f14-926f-4f51-b7ba-8e9325239ae7",
                                                "sense_id": "65ecf909-d167-33d8-af43-f22a88409f5b",
                                                "text": "„Erweiterungen der vier „alten“ Kondominien im Kesrouane Al Sahl, Almaya, Zopik und Bel Horizon schritten nur langsam oder gar nicht voran.“"
                                            },
                                            {
                                                "example_id": "7882c6a6-8c18-4286-b358-c8b0b3f35b4c",
                                                "sense_id": "65ecf909-d167-33d8-af43-f22a88409f5b",
                                                "text": "„Dass die Preußen und Österreicher anschließend ganz Jütland einnehmen, ist in erster Linie eine Machtdemonstration, denn nach dem Wiener Frieden im selben Jahr ziehen sie sich wieder hinter die Grenzen Schleswigs zurück, das zunächst als österreichisch-preußisches Kondominium und ab 1865 unter preußischer Verwaltung weiterbesteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d9fdf6c-4482-3841-8810-f2efe3c375d8",
                                        "entry_id": "aa5905c1-e119-383f-a92a-e13a887c570e",
                                        "glosses": [
                                            "größeres Haus mit mehreren Wohnungen, in der Regel Eigentumswohnungen, im Besitz einer Eigentümergemeinschaft"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68c715a6-c8eb-4208-8740-ec1b98c3ce7a",
                                                "sense_id": "9d9fdf6c-4482-3841-8810-f2efe3c375d8",
                                                "text": "„Die Kondominiumsversammlung ist – rechtlich gesehen – das Organ, das über die Dienstleistungen und gemeinsamen Sachen des Kondominiums berät und einen Beschluss fasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "65966bc4-f8d0-4dc6-a889-31f4f89e5d60",
                        "source_entry_id": "1ec3e78e-d165-380f-a236-279f16351dda",
