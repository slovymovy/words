                "senses": [
                    {
                        "sense_id": "36e509a9-73a0-3ca6-bc2a-55b43261b132",
                        "entry_id": "9fcf3b0c-4b65-3de0-89c3-8ab6a69fae9c",
                        "glosses": [
                            "to sail in a canoe"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "00ec5ab9-a0f6-498a-9cba-6fa2c48446fa",
                                "sense_id": "36e509a9-73a0-3ca6-bc2a-55b43261b132",
                                "text": "We gingen kanoën op het meer en genoten van de rust en natuur.",
                                "translation": "We went canoeing on the lake and enjoyed the peace and nature.",
                                "english": "We went canoeing on the lake and enjoyed the peace and nature."
                            },
                            {
                                "example_id": "4b034382-445f-45ea-996b-e03994b87a32",
                                "sense_id": "36e509a9-73a0-3ca6-bc2a-55b43261b132",
                                "text": "Tijdens onze vakantie besloten we te kanoën langs de rivier.",
                                "translation": "During our vacation, we decided to go canoeing along the river.",
                                "english": "During our vacation, we decided to go canoeing along the river."
                            },
                            {
                                "example_id": "42e298fb-4ada-4f0a-b31c-dc9de1880593",
                                "sense_id": "36e509a9-73a0-3ca6-bc2a-55b43261b132",
                                "text": "Kanoën is een leuke en ontspannende manier om de natuur te verkennen.",
                                "translation": "Canoeing is a fun and relaxing way to explore nature.",
                                "english": "Canoeing is a fun and relaxing way to explore nature."
                            }
                        ]
                    }
