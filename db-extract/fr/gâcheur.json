                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd4f9bc2-a411-32f9-af46-11b098ca789d",
                                        "entry_id": "68b32288-7051-3b28-a4e8-a4e7dbb01f04",
                                        "glosses": [
                                            "The vagina."
                                        ],
                                        "tags": [
