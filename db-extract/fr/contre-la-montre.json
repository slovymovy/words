                    {
                        "translation_id": "a6b3979c-af86-4614-b1d9-0d31efc34a56",
                        "source_entry_id": "5ea2e186-41ed-316d-bcba-251cb4e45a9f",
                        "source_sense_id": "d1dff647-481f-360c-b140-20709a04a8c0",
                        "source_sense_description": "Action devant être terminée rapidement",
                        "target_lang_word": "Wettlauf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wettlauf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0467e366-5f40-3927-a846-253af3908fa3",
                                        "entry_id": "0930110d-e71c-3f0a-98b5-861b9979971d",
                                        "glosses": [
                                            "eine Konkurrenz, in der mehrere Personen ermitteln, wer der schnellste Läufer von ihnen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7ee6b3-61d3-43e5-901e-1bad29f1ffd0",
                                                "sense_id": "0467e366-5f40-3927-a846-253af3908fa3",
                                                "text": "1884/85 trat Deutschland in den Wettlauf der imperialistischen Staaten um die Aufteilung der Welt ein, ohne aber das Kolonialreich wesentlich zu vergrößern."
                                            },
                                            {
                                                "example_id": "0163cb4f-2014-4390-9980-4a8a7bbd160f",
                                                "sense_id": "0467e366-5f40-3927-a846-253af3908fa3",
                                                "text": "Trotz leichten Verzerrungen im Oberschenkel beendete die 400-m-Läuferin den Wettlauf mit Bravur."
                                            },
                                            {
                                                "example_id": "6b104d01-73e6-4ed9-8b7e-3d960fda1c9f",
                                                "sense_id": "0467e366-5f40-3927-a846-253af3908fa3",
                                                "text": "„Wilson befand sich, als jener den ersten Satz tat, vor dem Bowitt mehr überrascht als erschreckt zurückfuhr, in kaum zehn Schritt Entfernung von ihm und hatte ihn nach kurzem Wettlauf eingeholt.“"
                                            },
                                            {
                                                "example_id": "12bd2b3d-969a-4923-83d1-7a648121e4e9",
                                                "sense_id": "0467e366-5f40-3927-a846-253af3908fa3",
                                                "text": "„Nach einer Viertelstunde hatten Harbert, der Reporter und Pencroff das Ende der Steilwand erreicht, der sie bei ihrem Wettlauf mit dem Sturm immer ausgewichen waren und verschnauften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87d98d8b-9e2b-4c8f-a4cb-a39d8a8441bb",
                        "source_entry_id": "5ea2e186-41ed-316d-bcba-251cb4e45a9f",
                        "source_sense_id": "d1dff647-481f-360c-b140-20709a04a8c0",
                        "source_sense_description": "Action devant être terminée rapidement",
                        "target_lang_word": "Zeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc0cbf55-4a4a-31e9-b23e-857331f6bea8",
                                        "entry_id": "11f9ce41-d6d4-334d-9be3-b91189b13e5e",
                                        "glosses": [
                                            "der stetige Ablauf von Zeiteinheiten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d40cc052-04dc-47d4-b94d-8d299ef45aa1",
                                                "sense_id": "fc0cbf55-4a4a-31e9-b23e-857331f6bea8",
                                                "text": "„Früher hat man geglaubt, wenn alle Dinge aus der Welt verschwinden, so bleiben noch Raum und Zeit übrig. Nach der Relativitätstheorie verschwinden aber Raum und Zeit mit den Dingen.“"
                                            },
                                            {
                                                "example_id": "729c4805-d4ab-48c3-9a82-2a4c36b276c1",
                                                "sense_id": "fc0cbf55-4a4a-31e9-b23e-857331f6bea8",
                                                "text": "Wie schnell die Zeit vergeht."
                                            },
                                            {
                                                "example_id": "f7542865-18b4-49f3-8a6e-5c75c72c640d",
                                                "sense_id": "fc0cbf55-4a4a-31e9-b23e-857331f6bea8",
                                                "text": "Zeit ist ein Mysterium."
                                            },
                                            {
                                                "example_id": "c58c56dd-2f16-4f0f-83ca-34f00b84e01a",
                                                "sense_id": "fc0cbf55-4a4a-31e9-b23e-857331f6bea8",
                                                "text": "Kinder, wie die Zeit vergeht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                        "entry_id": "11f9ce41-d6d4-334d-9be3-b91189b13e5e",
                                        "glosses": [
                                            "begrenzter Abschnitt innerhalb des Ablaufes von Zeiteinheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf20f16-db7f-4d65-a04d-abb47bfe5928",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "Mir ist die Zeit mit den Kindern sehr wichtig."
                                            },
                                            {
                                                "example_id": "db3e4de0-fa64-4c0f-b41a-bbd4db101bdf",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "Er ist seit einiger Zeit beurlaubt."
                                            },
                                            {
                                                "example_id": "cb94f757-0c56-4f25-98e0-c253d900cada",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "„In der schwärmerischen Sprache der Zeit wird zum Ausdruck gebracht, was die Bergwanderer und Kletterer bewegt: […].“"
                                            },
                                            {
                                                "example_id": "38ae58ae-6980-4811-8416-3d207142e397",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "„In den alten Zeiten, wo das Wünschen noch geholfen hat, lebte ein König, dessen Töchter waren alle schön, aber die jüngste war so schön, daß die Sonne selber, die doch so vieles gesehen hat, sich verwunderte so oft sie ihr ins Gesicht schien.“"
                                            },
                                            {
                                                "example_id": "b7fc18d0-af9f-4e9e-9da6-7816ddc515d3",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "Zur Zeit der Wikinger gab es dort eine Siedlung."
                                            },
                                            {
                                                "example_id": "d7d3920c-dea1-474a-9666-584174ca9177",
                                                "sense_id": "ca3e4003-c4a6-3c31-9cc3-16ab7b684f22",
                                                "text": "„In der nationalsozialistischen Zeit war die Psychoanalyse verfemt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "99535576-2df0-37c3-a8b0-3796a4a14d5c",
                                        "entry_id": "11f9ce41-d6d4-334d-9be3-b91189b13e5e",
                                        "glosses": [
                                            "bestimmter Moment im Ablauf von Zeiteinheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "432f0530-3c05-4347-acb9-ba3dbd12a30b",
                                                "sense_id": "99535576-2df0-37c3-a8b0-3796a4a14d5c",
                                                "text": "Zu welcher Zeit fährt der Zug?"
                                            },
                                            {
                                                "example_id": "d85a3f23-655a-49c5-8b08-f0a378e47bd6",
                                                "sense_id": "99535576-2df0-37c3-a8b0-3796a4a14d5c",
                                                "text": "Zu der Zeit schlafe ich noch."
                                            },
                                            {
                                                "example_id": "6d188e68-8a87-47a2-b89c-4fd8cff00b95",
                                                "sense_id": "99535576-2df0-37c3-a8b0-3796a4a14d5c",
                                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1e2aaebb-ed08-3d63-8e57-f16c4825687f",
                                        "entry_id": "11f9ce41-d6d4-334d-9be3-b91189b13e5e",
                                        "glosses": [
                                            "Gegenwart, das zeitliche Jetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52f60a6-3c59-4a09-b6aa-bf305f763c49",
                                                "sense_id": "1e2aaebb-ed08-3d63-8e57-f16c4825687f",
                                                "text": "Er war immer auf der Höhe der Zeit."
                                            },
                                            {
                                                "example_id": "c51e3575-e25c-4abf-94b3-66206618910c",
                                                "sense_id": "1e2aaebb-ed08-3d63-8e57-f16c4825687f",
                                                "text": "Zur Zeit bin ich arbeitslos."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6d44ad69-ae90-34f7-b5ad-5af8fac2fa19",
                                        "entry_id": "11f9ce41-d6d4-334d-9be3-b91189b13e5e",
                                        "glosses": [
                                            "grammatische Kategorie des Zeitworts zur Anzeige einer Zeit oder Zeitstufe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "add1d446-d0bd-41ef-a5be-fc1bce91771b",
                                                "sense_id": "6d44ad69-ae90-34f7-b5ad-5af8fac2fa19",
                                                "text": "Welche Zeit benutzte man in diesem Konditionalsatz hier?"
                                            },
                                            {
                                                "example_id": "861c30d3-2133-4736-a09f-7a9fea2e8e14",
                                                "sense_id": "6d44ad69-ae90-34f7-b5ad-5af8fac2fa19",
                                                "text": "„Sinn und Gebrauch der Zeiten sind ihm noch nicht klar, besonders das Futur bereitet ihm Schwierigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
