                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c968c83-b9b5-4084-88ee-c4d4609adea4",
                                "sense_id": "8dc8fad1-e1ac-3079-8124-e6ff301610a4",
                                "text": "Le principe des caloducs repose sur la transformation (transition de phase) d’un liquide en gaz pour absorber la chaleur, puis sur la transformation de ce gaz en liquide pour restituer la chaleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "5058829f-94a1-389e-9b26-0920c0ffa23f",
                        "entry_id": "5da1c39e-5ce1-3d07-9117-d2563f5b5a85",
                        "glosses": [
                            "Dispositif de transfert de chaleur, hermétique et autonome, dans lequel un fluide caloporteur prélève de la chaleur dans une zone chaude en passant de l’état liquide à l’état gazeux, puis la transporte vers une zone froide où le retour à l’état liquide permet de la restituer."
                        ],
