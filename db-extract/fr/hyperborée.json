                "senses": [
                    {
                        "sense_id": "e4894783-f137-33fe-a1f8-9954f3e3eea0",
                        "entry_id": "6c246385-7f89-3a63-8c11-7ca8f74e21e3",
                        "glosses": [
                            "Septentrional, nordique, hyperboréen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2099c080-1923-49c2-9458-4635dab06873",
                                "sense_id": "e4894783-f137-33fe-a1f8-9954f3e3eea0",
                                "text": "Les pâles habitants de ces froides contrées,\nQu'assiégent de glaçons les mers hyperborées."
                            },
                            {
                                "example_id": "a9918ee3-df04-48f9-922b-224f42918ded",
                                "sense_id": "e4894783-f137-33fe-a1f8-9954f3e3eea0",
                                "text": "Peuples que Dieu fit naître aux portes du soleil,\nVous, nations hyperborées."
                            },
                            {
                                "example_id": "b73d396c-26ed-4ae4-8574-927b5cd12dbd",
                                "sense_id": "e4894783-f137-33fe-a1f8-9954f3e3eea0",
                                "text": "Allons dans cette immense région hyperborée [la Russie], qui était si barbare il y a quatre-vingts ans, et qui est aujourd'hui si éclairée et si invincible."
                            },
                            {
                                "example_id": "c1314aae-fdab-40b6-be15-f9a82ae679d4",
                                "sense_id": "e4894783-f137-33fe-a1f8-9954f3e3eea0",
                                "text": "Cette puissance occulte se donne ce soir une grande fête, par cette nuit d’hiver, là-bas dans les régions hyperborées."
                            }
                        ]
                    }
                ],
