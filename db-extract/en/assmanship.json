                "senses": [
                    {
                        "sense_id": "cf27fe5f-28a4-3428-9ddd-6d7a293a9fca",
                        "entry_id": "76c45728-77b3-3f68-bc0d-0e44e17157f0",
                        "glosses": [
                            "The skill of riding a donkey."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c1addef8-7e96-45f9-b0ef-ba1033411320",
                                "sense_id": "cf27fe5f-28a4-3428-9ddd-6d7a293a9fca",
                                "text": "Ned Shuter’s assmanship, however, was not an unique performance, exhibited in this double character; for the celebrated Joe Haines, a comedian, in the reign of Queen Anne, spoke an epilogue on assback, at Lincoln’s-Inn-fields theatre;"
                            },
                            {
                                "example_id": "8d074000-d03e-42b9-972f-ccd5d5c2dc10",
                                "sense_id": "cf27fe5f-28a4-3428-9ddd-6d7a293a9fca",
                                "text": "1843, Thomas Wilson, The Pitman’s Pay and Other Poems, Gateshead: William Douglas, Notes, p. 96,\nHe had put the assmanship of many to the test, but none were able to sit him, whenever he had arrived at a suitable place for depositing his load […]"
                            },
                            {
                                "example_id": "a44ba53c-92fa-49fb-9899-372fcea6a000",
                                "sense_id": "cf27fe5f-28a4-3428-9ddd-6d7a293a9fca",
                                "text": "1906, E. V. Lucas, “Scourhill’s Adventures” in Forgotten Tales of Long Ago, London: Wells-Gardner-Darton, 1907, p. 163,\n[…] Master Scourhill would find himself much fatigued after his brilliant display of assmanship, which so much astonished the village."
                            },
                            {
                                "example_id": "f60e3bb8-9b66-4f69-ad35-4608b62b1f28",
                                "sense_id": "cf27fe5f-28a4-3428-9ddd-6d7a293a9fca",
                                "text": "Eventually the master blew the whistle, the asses were rehoused and we trooped back to school, sweating, excited, recounting mighty deeds of assmanship."
                            }
                        ]
                    }
