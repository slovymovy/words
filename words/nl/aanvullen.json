    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37d42213-cd78-3a8b-8680-6a1089e624a1",
                    "sense_definition": "het ontbrekende bijvoegen om iets weer vol of compleet te maken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toevoegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedere dag moest de supermarkt zijn voorraden weer <w>aanvullen</w>.",
                            "target_lang_translations": {
                                "en": "Every day the supermarket had to <w>replenish</w> its stocks."
                            }
                        },
                        {
                            "text": "Je moet de voorraad <w>aanvullen</w> voordat de winkel morgenochtend opengaat.",
                            "target_lang_translations": {
                                "en": "You must <w>top up</w> the stock before the shop opens tomorrow morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "completeren"
                    ],
                    "common_phrases": [
                        "voorraad aanvullen",
                        "tekorten aanvullen",
                        "gegevens aanvullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to add what is missing in order to make something full or complete again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "replenish",
                                "target_lang_sense_clarification": "to refill or supply again"
                            },
                            {
                                "target_lang_word": "supplement",
                                "target_lang_sense_clarification": "to add to something to make up for a deficiency"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "to make whole or entire"
                            },
                            {
                                "target_lang_word": "add",
                                "target_lang_sense_clarification": "to join or unite to increase quantity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7f6cb32-c10e-3da0-bf54-3a014c3fa21e",
                    "sense_definition": "goed bij iets anders passen zodat het een compleet of beter geheel vormt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "combineren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mooie das <w>vulde</w> het nieuwe pak perfect <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The beautiful tie <w>complemented</w> the new suit perfectly."
                            }
                        },
                        {
                            "text": "Zij <w>vullen</w> elkaar <w>aan</w> omdat zij heel rustig is en hij juist erg druk.",
                            "target_lang_translations": {
                                "en": "They <w>complement</w> each other because she is very calm and he is very busy."
                            }
                        }
                    ],
                    "synonyms": [
                        "complementeren"
                    ],
                    "common_phrases": [
                        "elkaar aanvullen",
                        "perfect aanvullen"
                    ],
                    "target_lang_definitions": {
                        "en": "to fit well with something else so that it forms a complete or better whole"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "complement",
                                "target_lang_sense_clarification": "to contribute extra features to someone or something in a way that improves them"
                            },
                            {
                                "target_lang_word": "supplement",
                                "target_lang_sense_clarification": "to add an extra element to enhance something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
