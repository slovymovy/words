                "senses": [
                    {
                        "sense_id": "677b7957-416a-3547-bd6a-9e1078c72fd2",
                        "entry_id": "dd6a54cc-d4b5-3f96-b7a3-0956d1064b7d",
                        "glosses": [
                            "monogram symbolizujący Chrystusa w formie akronimu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bf23af-70cb-4935-98c6-d5b32b574226",
                                "sense_id": "677b7957-416a-3547-bd6a-9e1078c72fd2",
                                "text": "Obserwanci rozpowszechnili chrystogram IHS na terenie Europy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b1bd262-7c2d-40f8-8e7a-fe3026ad794c",
                        "source_entry_id": "dd6a54cc-d4b5-3f96-b7a3-0956d1064b7d",
                        "source_sense_id": "677b7957-416a-3547-bd6a-9e1078c72fd2",
                        "target_lang_word": "Christogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Christogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0058e5-d5f9-3bc8-be80-cd29f0b3fc84",
                                        "entry_id": "55bcae86-d864-3ed8-a416-8be9dc6b5897",
                                        "glosses": [
                                            "A monogram that forms an abbreviation for the name of Jesus Christ, traditionally used as a Christian symbol, such as the chi-rho."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ea6126-39bc-4699-b5cc-5fcacdd84b37",
                                                "sense_id": "ea0058e5-d5f9-3bc8-be80-cd29f0b3fc84",
                                                "text": "Had he [the creator of a Pompeiian mosaic] been a Christian, he would certainly have given expression to his faith by some definite Christian symbol, — the fish or the ΑΩ, or the Christogram."
                                            },
                                            {
                                                "example_id": "8d2ea8b4-62b5-47c7-a2af-d5b150b2aa6f",
                                                "sense_id": "ea0058e5-d5f9-3bc8-be80-cd29f0b3fc84",
                                                "text": "About thirty of these [markings on Pompeiian amphorae] appear to be either the so-called christograms […] or other monograms disturbingly reminiscent of the various christograms"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49647621-bfd7-4ee3-b2b5-7be1c9f55286",
                        "source_entry_id": "dd6a54cc-d4b5-3f96-b7a3-0956d1064b7d",
                        "source_sense_id": "677b7957-416a-3547-bd6a-9e1078c72fd2",
                        "target_lang_word": "christogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "christogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90b60abf-a7f1-3144-b68e-9682c927774f",
                                        "entry_id": "ba1c55b9-deae-3dd2-b9eb-f720aaf1e0ac",
                                        "glosses": [
                                            "Monogramme représentant le nom de Jésus-Christ, utilisé comme symbole chrétien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "609ff78d-acb8-45d4-b8e6-438a894e8c99",
                                                "sense_id": "90b60abf-a7f1-3144-b68e-9682c927774f",
                                                "text": "La contremarque de ce papier représente le « christogramme », c’est-à-dire, les lettres I H S surmontées d’une croix et, en-dessous, un cartouche renfermant les lettres I et C (sans doute les initiales du fabricant) à chaque côté d’un cœur."
                                            },
                                            {
                                                "example_id": "24c2554a-a1eb-4fc7-b093-b596a781c141",
                                                "sense_id": "90b60abf-a7f1-3144-b68e-9682c927774f",
                                                "text": "Les quatre derniers apôtres trouvent place sur les voûtes en berceau des bras est et ouest, de part et d'autre de christogrammes cerclés de couronnes, et cette disposition souligne une nouvelle fois l'orientation à l'est de la croix parousiaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
