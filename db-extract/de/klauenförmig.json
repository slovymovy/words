                "senses": [
                    {
                        "sense_id": "248853c4-a448-3eea-bf3f-dbdcddd0d33b",
                        "entry_id": "b9382a9c-2978-3353-b165-63a3c4550ee2",
                        "glosses": [
                            "wie eine Klaue geformt, die Form einer Klaue habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8023815-5527-499d-bfb4-3898dabc539e",
                                "sense_id": "248853c4-a448-3eea-bf3f-dbdcddd0d33b",
                                "text": "„Während er so Minute um Minute vorwärtstapste, mühte er sich vergeblich, das halb gefrorene Unterhemd auszuziehen, aber einarmig schaffte er es nicht; die Hand an seinem gebrochenen Arm hatte sich inzwischen klauenförmig verkrampft.“"
                            },
