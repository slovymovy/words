                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hou op met dat gepruts, jij onrustige <w>peuter</w>.",
                            "target_lang_translations": {
                                "en": "Stop messing around, you restless <w>fiddler</w>.",
                                "ru": "Прекрати возиться, ты, беспокойный <w>копуша</w>.",
                                "pl": "Przestań się tak guzdrać, ty niespokojny <w>wiercipięto</w>.",
                                "de": "Hör auf mit der Fummelei, du unruhiger <w>Fummler</w>.",
                                "fr": "Arrête de chipoter, espèce de <w>tripoteur</w> agité.",
                                "it": "Smettila di armeggiare, <w>giocherellone</w> irrequieto che non sei altro.",
                                "cs": "Nech toho piplání, ty neposedný <w>šťourale</w>.",
