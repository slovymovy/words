                        "examples": [
                            {
                                "example_id": "6a68c542-8323-4396-9b81-ee5799798452",
                                "sense_id": "9e84cc35-dc4e-371e-abfe-97a5affc7b93",
                                "text": "Вы́шла ку́рочка гуля́ть,\nСве́жей тра́вки пощипа́ть,\nА за ней ребя́тки,\nЖёлтые цыпля́тки.",
                                "translation": "Out went a hen for a walk,\nTo nip some fresh grass,\nAnd behind her [were] the children,\nYellow baby chicks.",
                                "english": "Out went a hen for a walk,\nTo nip some fresh grass,\nAnd behind her [were] the children,\nYellow baby chicks."
                            }
                        ]
                    }
