                        "glosses": [
                            "Façonner de façon préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a52917-b84f-494e-b726-a2ce309b7234",
                                "sense_id": "36c770c6-68da-3ffc-b828-f222ecd07833",
                                "text": "Une fois que la pâte est prête, il faut la détailler et la préfaçonner."
                            },
                            {
                                "example_id": "8a2f6b11-ceb8-4742-a68c-9f95de6e4db9",
                                "sense_id": "36c770c6-68da-3ffc-b828-f222ecd07833",
                                "text": "Couper des morceaux de 200 g et les préfaçonner."
                            },
                            {
                                "example_id": "2a2cfce1-0fba-4541-98f9-4de0f5c8707b",
                                "sense_id": "36c770c6-68da-3ffc-b828-f222ecd07833",
                                "text": "Façonnage: Peser des pâtons, les préfaçonner en rond, puis en ovale après un court temps de repos."
                            }
                        ]
