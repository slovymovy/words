                        "examples": [
                            {
                                "example_id": "7c59d7fb-7bb3-4d1d-9e83-77fc2295a629",
                                "sense_id": "cc02bd88-fa5d-3ea2-bc04-012745345dbb",
                                "text": "In de vroege ochtend van de 16de verliet het eskadron van Denisov, waarin Nikolaj Rostov diende en dat deel uitmaakte van het detachement van vorst Bagration, de nachtkwartieren om ten strijde te trekken, zoals men zei, en nadat ze ongeveer een werst achter andere colonnes waren voortgegaan, werd er op de hoofdweg halt gehouden."
                            },
                            {
                                "example_id": "95f3b0a2-80e7-4e55-b0ac-19b05a2a7683",
                                "sense_id": "cc02bd88-fa5d-3ea2-bc04-012745345dbb",
                                "text": "Het water stroomde door de muizenstad en over de bakken waarin de diertjes hun nachtkwartier hadden. De ongeveer honderd muizen zijn verdronken."
                            }
                        ]
                    }
