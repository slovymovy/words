                            {
                                "example_id": "bbe3b925-ac5a-4ff7-9571-42c54dd2d7c4",
                                "sense_id": "3e26f6ac-ebfc-3ae1-a7b2-82a4a3aa2a06",
                                "text": "On ralluma les lampes du porte-chaleil, attendit qu’Antoine vienne s’asseoir avec les autres, puis Pierrot prit la parole."
                            },
                            {
                                "example_id": "118f12d3-24c4-4516-8ce8-852d084a5662",
                                "sense_id": "3e26f6ac-ebfc-3ae1-a7b2-82a4a3aa2a06",
                                "text": "Lorsque les hommes se lèvent, elle allume le chaleil."
                            },
                            {
                                "example_id": "e1ec6a95-3ad4-4717-9bbc-a33341b00e76",
                                "sense_id": "3e26f6ac-ebfc-3ae1-a7b2-82a4a3aa2a06",
                                "text": "On ne voyait pas bien clair à la lumière du chaleil."
                            },
                            {
