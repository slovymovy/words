                        "examples": [
                            {
                                "example_id": "3dfb1842-83dd-49c8-a743-b82f42751c94",
                                "sense_id": "d42426d9-00dc-3567-8e75-d6a665fc4b00",
                                "text": "„Sein Sohn hat einst ein Fischermädchen geliebt und sie ist ins Seereich herabgestiegen.“"
                            },
                            {
                                "example_id": "27cec8e8-dd31-451d-8633-f296fdedc806",
                                "sense_id": "d42426d9-00dc-3567-8e75-d6a665fc4b00",
                                "text": "„Meyerbeer vollzog mit seiner Version des Fischermädchens – dies sei abschließend nochmals festgehalten – überzeugend jene interessante Schwerpunktverlagerung von der betont liebreizend-volkstümlichen Naturschau Schuberts zum dramatisch fesselnden Liebesständchen und öffnet den Blick somit für eine weitere Facette von Heines Text.“"
                            }
                        ],
