                        "sense_id": "c9c0e08d-a13d-36a9-8440-90402b205b3a",
                        "entry_id": "0d73a57e-33a3-3593-998d-11eaad05f2ee",
                        "glosses": [
                            "Angehöriger des gleichnamigen, antiken Stammes in Mittelitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c30d2f0d-65cc-4c1b-a8ea-92a4779a9aa5",
                                "sense_id": "c9c0e08d-a13d-36a9-8440-90402b205b3a",
                                "text": "„Das energische Vorgehen der Römer hat dann anscheinend die anderen Stämme des Zentralapennin (die Marser, Paeligner, Marruciner, Frentaner) dazu gebracht, sich ohne wesentlichen Widerstand, entsprechend ihrem loyalen Verhalten während des Samnitenkrieges, in die römische Bundesgenossenschaft zu begeben.“"
                            },
                            {
                                "example_id": "7f7b3804-676c-4899-8172-6c41281d6010",
                                "sense_id": "c9c0e08d-a13d-36a9-8440-90402b205b3a",
                                "text": "„Laut Diodor besiegten die Römer zuerst die Paeligner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
