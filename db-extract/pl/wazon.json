                                "target_senses": [
                                    {
                                        "sense_id": "4d9a5a14-52c2-3885-8776-28c61e4ceba0",
                                        "entry_id": "4904b2ac-342b-3152-afa5-5637e6bc761c",
                                        "glosses": [
                                            "сосуд разнообразной формы, используемый в хозяйстве под фрукты, сласти, цветы или служащий украшением жилья и общественных мест"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e094b5b-af97-4225-b060-4854f7f59dbd",
                                                "sense_id": "4d9a5a14-52c2-3885-8776-28c61e4ceba0",
                                                "text": "Посредине стола стояла большая хрустальная ваза с фруктами .."
                                            },
                                            {
                                                "example_id": "d11d8e7b-17e2-4d93-b532-b38f33690a56",
                                                "sense_id": "4d9a5a14-52c2-3885-8776-28c61e4ceba0",
                                                "text": "Потом пришла Люся с букетом цветов. ❬…❭ Она поставила цветы в вазу .."
                                            }
                                        ]
                                    }
                                ]
                            }
