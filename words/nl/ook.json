{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "91eeb0c4-6250-3d81-bd95-9a54aa7a26a4",
                    "sense_definition": "geeft aan dat iets of iemand anders hetzelfde doet of is; daarnaast, tevens",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "toevoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga naar de markt en mijn zus gaat <w>ook</w> mee.",
                            "target_lang_translations": {
                                "en": "I am going to the market and my sister is coming <w>too</w>.",
                                "ru": "Я иду на рынок, и моя сестра <w>тоже</w> идет со мной."
                            }
                        },
                        {
                            "text": "Dat is een <w>ook</w> goed idee voor ons nieuwe project.",
                            "target_lang_translations": {
                                "en": "That is <w>also</w> a good idea for our new project.",
                                "ru": "Это <w>также</w> хорошая идея для нашего нового проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "eveneens",
                        "tevens"
                    ],
                    "common_phrases": [
                        "ik ook",
                        "ook goed",
                        "net als ook"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates that something or someone else does or is the same; in addition, also",
                        "ru": "указывает на то, что кто-то другой или что-то другое делает то же самое или является таким же; также, тоже"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "also",
                                "target_lang_sense_clarification": "in addition"
                            },
                            {
                                "target_lang_word": "too",
                                "target_lang_sense_clarification": "likewise"
                            },
                            {
                                "target_lang_word": "as well",
                                "target_lang_sense_clarification": "in addition"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тоже",
                                "target_lang_sense_clarification": "в равной мере"
                            },
                            {
                                "target_lang_word": "также",
                                "target_lang_sense_clarification": "в дополнение"
                            },
                            {
                                "target_lang_word": "ещё",
                                "target_lang_sense_clarification": "кроме того"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aea7a73a-1ba3-3261-83b0-a859ba9aa110",
                    "sense_definition": "wordt gebruikt in ontkennende zinnen om aan te sluiten bij een eerdere ontkenning",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "toevoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij lust geen spruitjes en ik lust ze <w>ook</w> niet.",
                            "target_lang_translations": {
                                "en": "He doesn't like Brussels sprouts and I don't like them <w>either</w>.",
                                "ru": "Он не любит брюссельскую капусту, и я её <w>тоже</w> не люблю."
                            }
                        },
                        {
                            "text": "Ik kan dat <w>ook</w> niet begrijpen in deze situatie.",
                            "target_lang_translations": {
                                "en": "I can't understand that <w>either</w> in this situation.",
                                "ru": "Я <w>тоже</w> не могу этого понять в данной ситуации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ook niet"
                    ],
                    "target_lang_definitions": {
                        "en": "used in negative sentences to align with a previous negation",
                        "ru": "используется в отрицательных предложениях для присоединения к предыдущему отрицанию"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "either",
                                "target_lang_sense_clarification": "in negative sentences"
                            },
                            {
                                "target_lang_word": "neither",
                                "target_lang_sense_clarification": "not one or the other"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тоже",
                                "target_lang_sense_clarification": "в отрицательном контексте"
                            },
                            {
                                "target_lang_word": "также",
                                "target_lang_sense_clarification": "при отрицании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0624d562-e7f5-318e-86cc-b4ae0b758ef2",
                    "sense_definition": "wordt gebruikt om een bewering te benadrukken, vaak bij irritatie of verbazing",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nadruk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>ook</w> nooit goed wat ik voor je doe.",
                            "target_lang_translations": {
                                "en": "It's <w>just</w> never good enough, whatever I do for you.",
                                "ru": "Что бы я для тебя ни делал, всё <w>вечно</w> не так."
                            }
                        },
                        {
                            "text": "Ik moet <w>ook</w> alles alleen doen in dit huis.",
                            "target_lang_translations": {
                                "en": "I <w>really</w> have to do everything by myself in this house.",
                                "ru": "Я <w>же</w> должен всё делать один в этом доме."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ook nooit goed",
                        "ook alles alleen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in gesproken taal voor emotionele nadruk"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "used to emphasize a statement, often expressing irritation or surprise",
                        "ru": "используется для усиления высказывания, часто при выражении раздражения или удивления"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "for emphasis in complaints"
                            },
                            {
                                "target_lang_word": "simply",
                                "target_lang_sense_clarification": "to emphasize a point"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "expressing annoyance"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вечно",
                                "target_lang_sense_clarification": "при выражении недовольства"
                            },
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "и",
                                "target_lang_sense_clarification": "для эмоционального акцента"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a9a03b8-7212-31b9-8440-d0a9fdf9da68",
                    "sense_definition": "wordt gebruikt in combinatie met vragende voornaamwoorden om onbepaaldheid uit te drukken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbepaald",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt me bellen wanneer dan <w>ook</w> als er iets is.",
                            "target_lang_translations": {
                                "en": "You can call me <w>whenever</w> if something is wrong.",
                                "ru": "Ты можешь позвонить мне в <w>любое</w> время, если что-то случится."
                            }
                        },
                        {
                            "text": "Wie dan <w>ook</w> dit gedaan heeft, moet zich melden.",
                            "target_lang_translations": {
                                "en": "<w>Whoever</w> did this must come forward.",
                                "ru": "<w>Кто бы ни</w> сделал это, он должен сознаться."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wie dan ook",
                        "waar dan ook",
                        "wanneer dan ook"
                    ],
                    "target_lang_definitions": {
                        "en": "used in combination with interrogative pronouns to express indefiniteness",
                        "ru": "используется в сочетании с вопросительными местоимениями для выражения неопределенности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "-ever",
                                "target_lang_sense_clarification": "suffix for whoever, whenever, etc."
                            },
                            {
                                "target_lang_word": "at all",
                                "target_lang_sense_clarification": "used for emphasis in 'any... at all'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "бы ни",
                                "target_lang_sense_clarification": "в сочетании с кто, что, где и т.д."
                            },
                            {
                                "target_lang_word": "угодно",
                                "target_lang_sense_clarification": "в значении 'любой'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}