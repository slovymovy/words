                ],
                "senses": [
                    {
                        "sense_id": "df1e72de-8376-38b5-a9c9-197912e61b70",
                        "entry_id": "6a80d91b-b7f1-3920-b2fd-f93a58077c64",
                        "glosses": [
                            "van een situatie dat deze heel gevaarlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96e4ce5-b059-438c-a1a3-7c74c7249fc4",
                                "sense_id": "df1e72de-8376-38b5-a9c9-197912e61b70",
                                "text": "In plaats van de ogen te openen voor de vicieuze cirkel waartoe hun beleid leidt, verschuilen politici zich achter niet-gestaafde beschuldigingen richting hulporganisaties en individuen die mensen in penibele omstandigheden proberen te helpen. Artsen Zonder Grenzen werd tijdens haar zoek- en reddingsoperatie op zee beschoten door de Libische kustwacht en wordt er herhaaldelijk van beschuldigd onder één hoedje met de smokkelaars te spelen. Maar wíé zit er nu precies met criminelen in het complot? Zij die mensen willen redden of zij die faciliteren dat mensen als een supermarktartikel worden verkocht?"
                            },
                            {
                                "example_id": "24688747-10af-4187-8bba-be76dd3374a4",
                                "sense_id": "df1e72de-8376-38b5-a9c9-197912e61b70",
                                "text": "Veel opgesloten Amerikanen slaan noodkreten via Twitter en Facebook. Ze posten foto's van hun penibele situatie, zetten hun adres erbij en vragen mensen die noodkreet verder te verspreiden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fd8dcde-2ef7-43b2-ad99-f46a952a0a54",
                        "source_entry_id": "6a80d91b-b7f1-3920-b2fd-f93a58077c64",
                        "source_sense_id": "df1e72de-8376-38b5-a9c9-197912e61b70",
                        "source_sense_description": "van een situatie dat deze heel gevaarlijk is",
                        "target_lang_word": "critical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "critical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2bb9734-d1e0-35bf-907b-d57ef4f86a1f",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Inclined to find fault or criticize."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640b8b2a-ed45-47fa-b8f2-4c9a37f138ff",
                                                "sense_id": "e2bb9734-d1e0-35bf-907b-d57ef4f86a1f",
                                                "text": "A good teacher is fair but critical."
                                            },
                                            {
                                                "example_id": "495c55ab-7001-454e-b073-f56b297a1be0",
                                                "sense_id": "e2bb9734-d1e0-35bf-907b-d57ef4f86a1f",
                                                "text": "Let us go back to the beginning and consider what the charge is that has made people so critical of me, and has encouraged Meletus to draw up this indictment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9a60ced-52ae-319d-b3c0-660d1072e1d5",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Pertaining to, or indicating, a crisis or turning point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb1d680b-7473-42d8-b4bf-e94e33783aed",
                                                "sense_id": "c9a60ced-52ae-319d-b3c0-660d1072e1d5",
                                                "text": "This is a critical moment."
                                            },
                                            {
                                                "example_id": "fe83bc08-73cb-4c23-9a80-967d9a7da742",
                                                "sense_id": "c9a60ced-52ae-319d-b3c0-660d1072e1d5",
                                                "text": "Such a scandal as the prosecution of a brother for forgery—with a verdict of guilty—is a most truly horrible, deplorable, fatal thing. It takes the respectability out of a family perhaps at a critical moment, when the family is just assuming the robes of respectability: […] it is a black spot which all the soaps ever advertised could never wash off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3401a6b0-67cc-330f-8268-109954dd2755",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Extremely important."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcd31d8-aeae-43ed-a7cc-5dda4168f22b",
                                                "sense_id": "3401a6b0-67cc-330f-8268-109954dd2755",
                                                "text": "It's critical that you deliver this on time."
                                            },
                                            {
                                                "example_id": "fef420fa-ccf6-4c90-84f0-ce6fe706e30c",
                                                "sense_id": "3401a6b0-67cc-330f-8268-109954dd2755",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis:[…]. The evolutionary precursor of photosynthesis is still under debate, and a new study sheds light. The critical component of the photosynthetic system is the “water-oxidizing complex”, made up of manganese atoms and a calcium atom."
                                            },
                                            {
                                                "example_id": "cecad33f-42b3-46f1-a106-d92f1946afa0",
                                                "sense_id": "3401a6b0-67cc-330f-8268-109954dd2755",
                                                "text": "Third Pole glaciers are critical to billions of people from Vietnam to Afghanistan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c312bfd-e21b-3bd3-b08f-26b944148a96",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Relating to criticism or careful analysis, such as literary or film criticism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd9268b-8342-4586-b991-43315435ec55",
                                                "sense_id": "4c312bfd-e21b-3bd3-b08f-26b944148a96",
                                                "text": "The movie was a critical success, but bombed at the box-office."
                                            },
                                            {
                                                "example_id": "0d0114c1-f0cd-4b07-a79b-6066c0ee8c43",
                                                "sense_id": "4c312bfd-e21b-3bd3-b08f-26b944148a96",
                                                "text": "“Unless you are purchasing cereal from a health food store, many brands that are marketed as healthy are usually full of sugar and processed ingredients,” says Garcia.\n So when you’re choosing cereal, bread or any other whole-grain product, Garcia recommends reading labels with a critical eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c99b8d5-b74e-3167-9c8b-289c52d7783a",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Of a patient condition involving unstable vital signs and a prognosis that predicts the condition could worsen; or, a patient condition that requires urgent treatment in an intensive care or critical care medical facility."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f5064b6-e3d1-4a75-8556-3210e780eda5",
                                                "sense_id": "2c99b8d5-b74e-3167-9c8b-289c52d7783a",
                                                "text": "The patient's condition is critical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a048de2-1fad-3615-b092-a8adae71e683",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "In such a condition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01acf4e-74a9-4ab6-83b6-c9324a1ac7fe",
                                                "sense_id": "0a048de2-1fad-3615-b092-a8adae71e683",
                                                "text": "The patient is critical."
                                            },
                                            {
                                                "example_id": "030c6b8c-965b-474f-b23d-843344f0455b",
                                                "sense_id": "0a048de2-1fad-3615-b092-a8adae71e683",
                                                "text": "Two critical after fatal Wimbledon school crash"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65452dd-f73b-3eeb-adbd-ced1a8dfab82",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Likely to go out of control if disturbed, that is, opposite of stable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84f72c92-0635-4e7c-a912-1294f1c103b6",
                                                "sense_id": "e65452dd-f73b-3eeb-adbd-ced1a8dfab82",
                                                "text": "The political situation was so critical that the government declared the state of siege."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74cd7342-00ac-3fda-8122-fda5812f54fd",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Of the point (in temperature, reagent concentration etc.) where a nuclear or chemical reaction becomes self-sustaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a00a4de-0e8e-408c-8428-6ad4cb9398c6",
                                                "sense_id": "74cd7342-00ac-3fda-8122-fda5812f54fd",
                                                "text": "The reaction was about to become critical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b531a3b-4bda-304c-9b71-2a701cb3848f",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Of a temperature that is equal to the temperature of the critical point of a substance, i.e. the temperature above which the substance cannot be liquefied."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1a52311-585e-3662-b9a9-6e3238d5ffe0",
                                        "entry_id": "2f64df9a-7839-3b2f-961f-e7a9c9c18f77",
                                        "glosses": [
                                            "Needing great discrimination to be correctly classified; easily confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba265a43-91a3-4204-9d11-51a577164737",
                                                "sense_id": "f1a52311-585e-3662-b9a9-6e3238d5ffe0",
                                                "text": "critical plants"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "critical",
