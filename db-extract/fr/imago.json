                                "target_senses": [
                                    {
                                        "sense_id": "81c324fb-4d5e-3507-a49a-e78ceee02744",
                                        "entry_id": "0224cfb1-c7e7-3f74-b35c-fbd338cb254a",
                                        "glosses": [
                                            "The final developmental stage of an insect after undergoing metamorphosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "244a5467-8b21-4cf2-bffe-8bcabdbfa664",
                                                "sense_id": "81c324fb-4d5e-3507-a49a-e78ceee02744",
                                                "text": "‘But still,’ he said to himself, drawing the metamorphoses of a red admiral, egg, caterpillar, chrysalis and imago on his pad, ‘what shall I say to him when we meet?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b4319e-aaa2-3d8e-a1d1-fef3f39eebee",
