                        "entry_id": "b811bd03-2c9c-3f89-a296-8d9d16d9c94a",
                        "glosses": [
                            "с.-х. сельскохозяйственное орудие для окучивания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de0cd0f-dafe-4083-b6e6-9782d606e085",
                                "sense_id": "97acb12d-69c1-32be-84b4-06d6607a26ae",
                                "text": "Устройство окучника представляет много сходного с устройством плуга."
                            },
                            {
                                "example_id": "ed536fdd-b176-4d4f-8d2e-d7e8f08857ad",
                                "sense_id": "97acb12d-69c1-32be-84b4-06d6607a26ae",
                                "text": "К трактору прицепляется тележка, плуг, культиватор, борона или окучник."
                            }
                        ]
                    }
                ],
