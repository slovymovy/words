                "senses": [
                    {
                        "sense_id": "f1e292e1-1bb6-3b48-bc20-17f8f176b3ea",
                        "entry_id": "12759375-aef2-3195-89ed-3c928995f50e",
                        "glosses": [
                            "heel prettig en comfortabel"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "92f9f20b-e830-469c-afdf-820aa4d7fbc8",
                                "sense_id": "f1e292e1-1bb6-3b48-bc20-17f8f176b3ea",
                                "text": "Pas toen er zondag een foto opdook van de pinguïn merkte het Sea Life Park dat een van hun bewoners miste. Op de foto is te zien dat de pinguïn -ogenschijnlijk- prinsheerlijk een baantje zwemt in een baai bij Tokio. Hier nog wat beelden van de pinguïn."
                            },
                            {
                                "example_id": "6af08f5e-3293-46a5-ae14-f504a8826e71",
                                "sense_id": "f1e292e1-1bb6-3b48-bc20-17f8f176b3ea",
                                "text": "Heracles voelde zich prinsheerlijk en was op zoek naar een grotere score, maar die tocht werd gestaakt nadat Lerin Duarte zijn tweede gele kaart had ontvangen."
                            }
                        ]
                    }
                ],
