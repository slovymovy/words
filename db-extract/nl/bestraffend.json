        "nl-extract.jsonl": [
            {
                "entry_id": "7b006a26-c756-3f06-873d-9acc42469d21",
                "word": "bestraffend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a63d8d88-c6b3-3407-8c24-3933b29ead1e",
                        "entry_id": "7b006a26-c756-3f06-873d-9acc42469d21",
                        "glosses": [
                            "betrekking hebbend op het toedienen van of dreigen met een straf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3328d5d-dce4-436e-bba4-6c5f9678458e",
                                "sense_id": "a63d8d88-c6b3-3407-8c24-3933b29ead1e",
                                "text": "“Sint en zijn pieten moeten vreugde en plezier brengen, geen angst in boezemen. De uitstraling van piet moest daarom vriendelijker worden. We schminken onze pieten nu een jaar of acht bruin in plaats van inktzwart, en twee jaar geleden hebben we zelfs voor een nog lichtere tint gekozen. Ook van de grote rode lippen hebben we afscheid genomen. En de roe? Die is denk ik al wel zo’n 15 of 20 jaar uit beeld. Sint moest vooral leuk zijn, niet bestraffend.”"
                            },
                            {
                                "example_id": "694c8650-722b-43b2-a9d8-f8f9f9098074",
                                "sense_id": "a63d8d88-c6b3-3407-8c24-3933b29ead1e",
                                "text": "Een aantal jaren geleden werkte ik bij het Andreas ziekenhuis in Amsterdam. Met de auto vanaf Purmerend ongeveer twintig minuten rijden. Maar natuurlijk op een dag extra fileleed die ruim twee uur duurde en regen waar geen einde aan kwam.. Mijn auto langs de kant met al die vragende en bestraffende ogen op mij gericht was geen optie maar ik werd stapelgek van mijn blaas die absoluut leeg moest!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "2e8e5b93-1374-3df4-a72a-378590bdaf3e",
                "word": "bestraffend",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "10e94d4f-8915-3bac-b61c-9a841a44407a",
                        "entry_id": "2e8e5b93-1374-3df4-a72a-378590bdaf3e",
                        "glosses": [
                            "betrekking hebbend op het toedienen van of dreigen met een straf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf298530-bd68-406d-9be8-68afa386bb3f",
                                "sense_id": "10e94d4f-8915-3bac-b61c-9a841a44407a",
                                "text": "‘Rogier heeft hem van internet gedownload. ’Terwijl ze deed alsof ze naar links keek, zag Chantal in haar rechterooghoek hoe Max zijn broer bestraffend aankeek."
                            }
                        ]
                    }
