                        "glosses": [
                            "Appât animal ou végétal utilisé par les pêcheurs pour attirer le poisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de5f715-4845-4c97-a512-9c2d7447e1cb",
                                "sense_id": "2e020c4c-4fe9-37b8-b8d0-bf5dc1d463ed",
                                "text": "« Consciencieusement et pour n’avoir rien à se reprocher, il change de temps en temps l’esque à demi-rongée par la tourbe des infiniment petits. »"
                            },
                            {
                                "example_id": "d59369c1-cb57-42f1-9ebf-99495c41bf70",
                                "sense_id": "2e020c4c-4fe9-37b8-b8d0-bf5dc1d463ed",
                                "text": "Ce couillon peut aller aux esques ! : il peut aller se faire voir !"
                            },
                            {
                                "example_id": "6184ca09-5788-4113-88db-5caec83907ee",
                                "sense_id": "2e020c4c-4fe9-37b8-b8d0-bf5dc1d463ed",
                                "text": "Aller se faire une soupe d’esques : aller se faire voir"
                            },
                            {
                                "example_id": "51517748-3785-4cb6-a161-05f167114397",
                                "sense_id": "2e020c4c-4fe9-37b8-b8d0-bf5dc1d463ed",
                                "text": "Tronche d’esque : abruti"
                            }
                        ]
                    }
