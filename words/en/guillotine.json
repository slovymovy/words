                    "frequency": "Low",
                    "semantic_group_id": "politics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government imposed a <w>guillotine</w> to speed up the passage of the controversial bill."
                        },
                        {
                            "text": "Opposition members protested against the use of the <w>guillotine</w> during the debate."
                        }
                    ],
                    "synonyms": [
                        "cloture"
