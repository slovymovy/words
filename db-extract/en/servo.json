                        "entry_id": "8b756d49-d84b-3c17-ac49-fdc3d413524b",
                        "glosses": [
                            "A service station, being a place to buy petrol for cars etc., as well as various convenience items, with or without actual car service facilities."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "2d8156cd-ed91-4fae-966d-7eee6a82d05b",
                                "sense_id": "7a98e8cb-cce8-33c2-aa63-15bd6af2c419",
                                "text": "Two hours later Susan pulled the Pajero off the road onto the floodlit apron of the servo at the end of the Bowen bypass."
                            },
                            {
                                "example_id": "00342d79-f712-4a2e-92c8-fafa535e7413",
                                "sense_id": "7a98e8cb-cce8-33c2-aa63-15bd6af2c419",
                                "text": "Crude oil is purchased in US dollars, so the price of the petrol at your local servo is heavily influenced by the rate of exchange between the greenback and the Aussie dollar."
                            }
                        ]
                    }
                ],
