                "senses": [
                    {
                        "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                        "entry_id": "4f9114b3-77e4-3b21-819b-e7fb2e99e1ea",
                        "glosses": [
                            "Handelsplatz im Internet, in dem die Kryptowährung Bitcoin gehandelt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf464b1-192d-49a1-a595-996f4e7ae9d3",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Es gilt als sehr wahrscheinlich, dass V. einer der Betreiber der Bitcoinbörse BTC-e war.“"
                            },
                            {
                                "example_id": "046f17d5-732c-4f74-9fa2-e68055506e00",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Theoretisch könnten nun viel mehr Transaktionen bei angemessener Geschwindigkeit durchgeführt werden, sagt Arthur Hayes, Gründer der Bitcoinbörse BitMex.“"
                            },
                            {
                                "example_id": "9761f367-d114-49d0-a14f-d2b6a9ba39d3",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Die in Slovenien beheimatete Bitcoinbörse Bitstamp hat wegen mutmaßlicher Sicherheitslücken am heutigen Montag den Betrieb vorerst eingestellt.“"
                            },
                            {
                                "example_id": "2cf03efa-ad47-4a8d-ba56-b1db2efecebf",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Wer nur ein Bitcoinguthaben bei einer Bitcoinbörse besitzt, hat möglicherweise Pech gehabt.“"
                            },
                            {
                                "example_id": "879a6487-4876-4f1b-94ee-3ca18770db57",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Die größte deutsche Bitcoinbörse Bitcoin.de möchte in den Handel einsteigen.“"
                            },
                            {
                                "example_id": "3c038a30-616e-4af2-bb56-f23b42a78567",
                                "sense_id": "1593552a-cc22-3147-94fc-1a222ff78fb7",
                                "text": "„Wie die chinesischen Bitcoinbörse Bter mitteilte, wurden ihr 7170 Bitcoin im Wert von insgesamt 1,5 Millionen Franken gestohlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
