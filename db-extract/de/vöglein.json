                    {
                        "translation_id": "3f97baff-2c45-45bd-bb30-e6f5cc65fee3",
                        "source_entry_id": "a7797655-3750-3b71-8daf-971961ecb684",
                        "source_sense_id": "48149fe8-467b-332c-99a4-3c74a44aa88e",
