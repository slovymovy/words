                "senses": [
                    {
                        "sense_id": "eaedf951-9b50-3528-b81e-383c240f68a7",
                        "entry_id": "4b305421-2ac6-325b-ae16-6f8c674dfd5d",
                        "glosses": [
                            "Se persécuter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5cff3e-c978-4e9c-9d7c-a8fd4fac3c5a",
                                "sense_id": "eaedf951-9b50-3528-b81e-383c240f68a7",
                                "text": "Mais, puisqu'elle fait partie de moi, je ne l'insulte pas, ce serait de m'auto-dénigrer, m'auto-persécuter."
                            },
                            {
                                "example_id": "519c7cb7-b195-4d4a-91db-ce95b917e349",
                                "sense_id": "eaedf951-9b50-3528-b81e-383c240f68a7",
                                "text": "Il nous gonfle le Benji à s'auto-persécuter."
                            },
                            {
                                "example_id": "a009d5ae-346f-462b-8b04-953a4d19b138",
                                "sense_id": "eaedf951-9b50-3528-b81e-383c240f68a7",
                                "text": "Et, TheShow, quand même, je pense que tu devrais arrêter de t'auto-persécuter en public."
                            }
                        ]
