                "senses": [
                    {
                        "sense_id": "57347c78-fb45-3e8e-9cd0-1935174b9cba",
                        "entry_id": "dc8b2daf-b3ad-3a7a-b98b-52c83f3141ec",
                        "glosses": [
                            "zweischneidige Hieb- und Stichwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8dc504-b755-4328-9c1d-dea700dd2d39",
                                "sense_id": "57347c78-fb45-3e8e-9cd0-1935174b9cba",
                                "text": "„Auf dem Heck der Schiffe waren Totenköpfe zu sehen, und auf den Decks standen Kapitäne mit Dreispitz auf dem Kopf, die ihre Pistolen und Rapiere schwangen.“"
                            },
                            {
                                "example_id": "1e5bf545-c823-4d37-9f42-13684d257c19",
                                "sense_id": "57347c78-fb45-3e8e-9cd0-1935174b9cba",
                                "text": "„Wir entschuldigen uns für den Verlust des Rapiers und verabschieden uns von den Oskorušanern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ccfb179-d17a-4e4e-b724-2baf3e0e5395",
                        "source_entry_id": "dc8b2daf-b3ad-3a7a-b98b-52c83f3141ec",
                        "source_sense_id": "57347c78-fb45-3e8e-9cd0-1935174b9cba",
