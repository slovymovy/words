                "senses": [
                    {
                        "sense_id": "e1dac4a2-9344-3778-8b2e-36fc4dd02ea4",
                        "entry_id": "312139f9-a4a1-3f34-8285-5eb7df7714c0",
                        "glosses": [
                            "Zeitraum zur Einschreibung an österreichischen Universitäten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fa91a47-ca1f-48b9-8c67-53e6d8d78d9c",
                                "sense_id": "e1dac4a2-9344-3778-8b2e-36fc4dd02ea4",
                                "text": "„Ab sofort gibt es für Studienanfänger eine neue, einheitliche Inskriptionsfrist an den Universitäten: Wer sich erstmals für ein Bachelor- oder Diplomstudium einschreibt, muss dies bis 5. September für das Wintersemester bzw. 5. Februar für das Sommersemester tun.“"
                            },
                            {
                                "example_id": "e72a2d44-bc32-4116-bb0f-942e35bbe36e",
                                "sense_id": "e1dac4a2-9344-3778-8b2e-36fc4dd02ea4",
                                "text": "„Dass die Ablegung der Diplomprüfung innerhalb der Inskriptionsfrist des laufenden Semesters zur Zurechnung zum Vorsemester führe, lässt sich dem StudFG 1992 nicht entnehmen.“"
                            },
                            {
                                "example_id": "492f571c-7a9c-4a79-b93d-8af0a0d2036e",
                                "sense_id": "e1dac4a2-9344-3778-8b2e-36fc4dd02ea4",
                                "text": "„Wissenschaftsminister Karlheinz Töchterle (ÖVP) ist gegen eine Verlängerung der heuer erstmals schon am 5. September auslaufenden Inskriptionsfrist für Studienanfänger an den Universitäten.“"
                            },
                            {
                                "example_id": "0b77fa4a-5133-4c52-959f-91d1642a01c2",
                                "sense_id": "e1dac4a2-9344-3778-8b2e-36fc4dd02ea4",
                                "text": "„An der MedUni Innsbruck endet die Inskriptionsfrist am 3. Oktober, vier bzw. fünf Tage später an der WU Wien und der Wiener Boku.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
