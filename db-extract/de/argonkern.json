                "senses": [
                    {
                        "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                        "entry_id": "94414c66-e7ec-3b0c-bcbe-02da144557cb",
                        "glosses": [
                            "der Kern des Argonatoms"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "653793a9-dfd6-421b-886d-cbd2a883dd29",
                                "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                                "text": "„Wenn ein Neutrino mit dem Kern eines Chloratoms zusammentrifft, dann wird dieser in einen radioaktiven Argonkern umgewandelt. Auf diese Weise läßt sich die Zahl der Neutrinos durch die Anzahl der radioaktiven Argonkerne messen, […]“"
                            },
                            {
                                "example_id": "ae57d2af-cd61-4835-83e0-29efd23a4743",
                                "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                                "text": "„Ein Kalziumatom wird durch Verlust eines Heliumkerns, wie er im α-Strahl ausgesandt wird, zu einem Argonkern vom Atomgewicht 36, während durch Hinzutritt von zwei Kernelektronen ein Argonatom vom Atomgewicht 40 entstehen würde.“"
                            },
                            {
                                "example_id": "52cad6cd-78c0-4c39-aa39-b11972b30c36",
                                "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                                "text": "„Der nächste Schritt läuft dann mit einer Halbwertszeit von 35 Tagen ab: Der Argonkern fängt ein Atomelektron ein und verwandelt sich in den stabileren Chlor-37-Kern zurück.“"
                            },
                            {
                                "example_id": "1260bfdb-27dd-465d-98c1-90be75101315",
                                "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                                "text": "„Ein Beispiel ist der Kaliumkern ÄK, der sich durch Elektronenstrahlung in den Calciumkern Ca oder durch Positronenstrahlung in den Argonkern A umwandeln kann.“"
                            },
                            {
                                "example_id": "ddda0fee-d30c-45c9-8ea0-040e3605fec2",
                                "sense_id": "22899021-820f-3203-93e1-bd7e2d606456",
                                "text": "„Die größte Annäherung an einen Argonkern betrug bei den Versuchen von BLACKETT 7·10⁻¹² m.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
