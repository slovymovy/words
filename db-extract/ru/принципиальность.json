                "senses": [
                    {
                        "sense_id": "392a4e55-8a72-3e19-ad46-71287af0dd6e",
                        "entry_id": "3273725a-72b0-385c-8b14-8e2add065a53",
                        "glosses": [
                            "свойство по значению прилагательного принципиальный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d7ad5f4-1bcf-42fb-9b58-c290ba3796d4",
                                "sense_id": "392a4e55-8a72-3e19-ad46-71287af0dd6e",
                                "text": "Виктору стало стыдно, но он успокаивал себя тем, что успеет проявить принципиальность, когда станет главным инженером."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "751cc52c-676c-4aa3-9e00-17acf80435e0",
