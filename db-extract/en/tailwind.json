                    {
                        "translation_id": "1719e4b1-832b-48e4-a3df-57fd81364caa",
                        "source_entry_id": "678e7831-e9f6-3244-b829-7e71e49c3467",
                        "source_sense_description": "a wind that blows in the same direction as the course of an aircraft or ship",
                        "target_lang_word": "Rückenwind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rückenwind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39284d0f-11ee-3dc2-a187-4703f239360c",
                                        "entry_id": "869fff55-2ef8-3534-83cc-e34f4927f654",
                                        "glosses": [
                                            "Wind von hinten, Wind in Bewegungsrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96226f81-7074-42c1-9f64-c27b98f4fe8c",
                                                "sense_id": "39284d0f-11ee-3dc2-a187-4703f239360c",
                                                "text": "„Die ›Marat‹ legte bei Rückenwind, ohne sich anzustrengen, ihre zehn Knoten zurück.“"
                                            },
                                            {
                                                "example_id": "ff5773eb-5326-4065-ace5-927ec16c5e5d",
                                                "sense_id": "39284d0f-11ee-3dc2-a187-4703f239360c",
                                                "text": "„Lewis erzielte während des bisher besten Weitsprung-Wettkampfes in seinem vierten Sprung eine Weite von 8,91 m, jedoch mit zu starkem Rückenwind, so dass der Rekord nicht gewertet werden konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                        "entry_id": "869fff55-2ef8-3534-83cc-e34f4927f654",
                                        "glosses": [
                                            "Unterstützung, Zuspruch für eigene Pläne"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fef755dc-c265-431d-a642-96007cc8a65d",
                                                "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                                "text": "„[…] die SRF 3 Musikredaktion [hat] eine Liste mit einigen ihrer Lieblingen kuratiert. Die verleihen bei jedem Jogging Rückenwind.“"
                                            },
                                            {
                                                "example_id": "03b268ae-7a80-4aee-9a63-a4284174626a",
                                                "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                                "text": "„Mit dem Rückenwind arabischer Wertschätzung, der sich Gerhard Schröder eine Woche lang in sieben Golfstaaten erfreuen durfte, kehrt der Bundeskanzler in die Niederungen deutscher Parteipolitik ein.“"
                                            },
                                            {
                                                "example_id": "89ec1914-b583-4336-bb72-2e6424c98d93",
                                                "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                                "text": "„[…] mit dem Rückenwind eines robusten Wachstums hat Peking den Spielraum, diese Probleme Schritt für Schritt zu lösen.“"
                                            },
                                            {
                                                "example_id": "37abe6d2-3594-43f9-8cbb-9b1cebbfca87",
                                                "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                                "text": "„CSU-Generalsekretär Blume spürt \"Rückenwind\" für den EVP-Spitzenkandidaten Manfred Weber.“"
                                            },
                                            {
                                                "example_id": "21430a27-2ef0-49c5-a434-3a9ced3ac65f",
                                                "sense_id": "c54a1e21-45f3-3b33-b437-5acea25f453a",
                                                "text": "Im Regensburger Korruptionsprozess bekommt Joachim Wolbergs, der suspendierte und angeklagte SPD-Oberbürgermeister der Stadt, Rückenwind: Ein 51-jähriger Zeuge hat Wolbergs Version von einem Treffen während der damals bereits laufenden Ermittlungen bestätigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
