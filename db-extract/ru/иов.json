                                                "example_id": "f739dc26-6a23-40ee-a64c-6f577d338c0a",
                                                "sense_id": "52f6aac7-dec4-3d0d-87e7-9af6f4ac92a9",
                                                "text": "En signe de piété et de soumission aux décrets de la Providence, l’aveugle était agenouillé sur quelques brins de paille plus triturés et pourris que l’antique fumier de Job."
                                            },
                                            {
                                                "example_id": "ffcb9056-58e3-4180-b63b-c541bae0d638",
                                                "sense_id": "52f6aac7-dec4-3d0d-87e7-9af6f4ac92a9",
                                                "text": "Il domine notre âme entière,\nÉzéchiel sous le palmier\nL’attend, et c’est dans sa litière\nQue Job prend son tas de fumier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae113e3-d44b-3544-b89a-db9fce628567",
                                        "entry_id": "1300e6de-4ffe-33f2-8752-8abb52df2459",
                                        "glosses": [
                                            "Nom du vingt-deuxième livre de l’Ancien Testament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Job",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1cf1fe5-79e1-3cc5-935a-82a50468b801",
                                        "entry_id": "6a393443-ca00-30da-ba61-7eefd5238701",
                                        "glosses": [
                                            "Commune française, située dans le département du Puy-de-Dôme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Job",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9aa04cf-ecd4-3636-ac7f-9601626f124c",
                                        "entry_id": "c00c2799-176a-3a3e-9877-d9d95f0dd84c",
                                        "glosses": [
                                            "Marque française de papier à cigarette fondée en 1849."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "408dba05-2d13-48d2-928d-d0587d4a0f6d",
                                                "sense_id": "c9aa04cf-ecd4-3636-ac7f-9601626f124c",
                                                "text": "L’existence acquérait une épaisseur particulière ; l’amitié, la conversation, la belle humeur, le zouave du Job lui donnaient une saveur nourrissante."
                                            },
                                            {
                                                "example_id": "8ffad4fb-c12b-4650-a68d-d25963ef9aa4",
                                                "sense_id": "c9aa04cf-ecd4-3636-ac7f-9601626f124c",
                                                "text": "Il s’accota contre le mur, écarta sa musette du coude, retira de sa poche un petit carnet de job dont il détacha une feuille. Il colla le coin de la feuille entre ses lèvres.\n— J’ai eu de la veine, répéta-t-il, et tandis qu’il parlait, la feuille de papier à cigarettes descendait et remontait entre ses lèvres."
                                            },
                                            {
                                                "example_id": "a15fccf2-68de-42e7-8532-66e138ee6223",
                                                "sense_id": "c9aa04cf-ecd4-3636-ac7f-9601626f124c",
                                                "text": "À l’ombre de la Dame du Job qui déforme les perspectives, reste cachée, subtile et grave, autoritaire et puérile, et fume une cigarette peinte sur une calendrier déteint."
                                            },
                                            {
                                                "example_id": "64eeb1b2-8fa4-4113-95f4-9583f55506d9",
                                                "sense_id": "c9aa04cf-ecd4-3636-ac7f-9601626f124c",
                                                "text": "Balèze, l'orgueilleux Balèze, le \"mauvais esprit de la classe\", qui imitait avec du papier Job le son du cor, l'instrument préféré de notre principal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
