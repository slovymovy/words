                        "glosses": [
                            "Qui commet l’inceste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55bb9593-ebf0-4465-9b66-76e1efe00619",
                                "sense_id": "391e78ba-376a-30af-9dd8-8a1d58598548",
                                "text": "Parce qu’il aime son incesteur, qu’il lui fait a priori confiance, et qu’il sait qu’on ne se plaint pas à sa mère (par exemple) d’une expérience imposée par le parent incesteur puisque son statut lui attribue toute légitimité d’agir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "152781e3-d5e1-4f5d-b092-ea78d3e457db",
                        "source_entry_id": "0ea513fd-de34-3d90-8fc1-d741e1a0f767",
                        "source_sense_id": "391e78ba-376a-30af-9dd8-8a1d58598548",
                        "target_lang_word": "incestuous",
