                    {
                        "sense_id": "3abc50c7-8c65-3baa-8323-469419209e65",
                        "entry_id": "cb9cfaae-54b4-39da-81fe-2d81abd917b3",
                        "glosses": [
                            "Grundgedanke, dass jedes Ereignis eine Ursache in einem anderen Ereignis hat, und selbst Ursache eines anderen Ereignisses wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1abc5899-3505-4f80-978c-8a681da8b340",
                                "sense_id": "3abc50c7-8c65-3baa-8323-469419209e65",
                                "text": "„Diesem Dilemma glauben manche wie John Eccles durch den Hinweis auf die begrenzte Gültigkeit des Kausalitätsprinzips im Bereich der Quantenphysik zu entgehen. “"
                            },
                            {
                                "example_id": "541b3127-b71c-431e-94e8-edc9b308a92b",
                                "sense_id": "3abc50c7-8c65-3baa-8323-469419209e65",
                                "text": "„Eng mit dieser Begreifbarkeit hängt das Kausalitätsprinzip zusammen, an dem Spinoza wie Einstein festgehalten haben.“"
                            },
                            {
                                "example_id": "4d327068-f60a-4a04-9b21-94813e5afa41",
                                "sense_id": "3abc50c7-8c65-3baa-8323-469419209e65",
                                "text": "„Der Satz vom Grund ist in dieser Hinsicht das Kausalitätsprinzip.“"
                            }
                        ],
