                                        "entry_id": "d862a250-e931-31bf-9815-183d7f4cf286",
                                        "glosses": [
                                            "Pertaining to divine providence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34dd1324-8e3d-40f0-b458-d8724683896a",
                                                "sense_id": "db26fb02-87d0-3c4c-9dce-f0356385f292",
                                                "text": "The same belief underlay the providential view of history, in which the rise and fall of nations appeared as the expression of God's unsearchable purposes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a692c3d2-abea-35a0-a09a-4013d8a5f80a",
                                        "entry_id": "d862a250-e931-31bf-9815-183d7f4cf286",
                                        "glosses": [
                                            "Fortunate, as if occurring through the intervention of Providence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "444f0b01-4bee-4bd7-9c83-ed6f79bf0ca5",
                                                "sense_id": "a692c3d2-abea-35a0-a09a-4013d8a5f80a",
                                                "text": "“Why, Jane,” he cried, “what do you mean? What has our providential rescue to do with altering your feelings toward me? You are but unstrung—tomorrow you will be yourself again.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
