{
    "word_family": [
        "inaccessibilité",
        "accessible",
        "accessibilité",
        "accès",
        "accéder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dbdf8e4e-1079-349d-8532-43a9cd801940",
                    "sense_definition": "Où l'on ne peut pas parvenir, qu'on ne peut atteindre ou obtenir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu_ou_but",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce sommet de montagne est resté <w>inaccessible</w> pendant plusieurs siècles aux explorateurs."
                        },
                        {
                            "text": "Les livres anciens sont rangés sur une étagère très haute, totalement <w>inaccessible</w> aux enfants."
                        }
                    ],
                    "synonyms": [
                        "inatteignable"
                    ],
                    "antonyms": [
                        "accessible"
                    ],
                    "common_phrases": [
                        "sommet inaccessible",
                        "endroit inaccessible",
                        "rêve inaccessible"
                    ]
                },
                {
                    "sense_id": "accb243e-bab6-3f97-9e56-220eeae399ea",
                    "sense_definition": "Qualifie une personne qu'il est très difficile de rencontrer, d'aborder ou de contacter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis sa nomination au poste de ministre, il est devenu totalement <w>inaccessible</w> pour ses anciens amis."
                        },
                        {
                            "text": "Le directeur de l'entreprise reste <w>inaccessible</w> aux journalistes qui demandent une entrevue."
                        }
                    ],
                    "antonyms": [
                        "accessible"
                    ]
                },
                {
                    "sense_id": "829854da-5a60-392e-aaf6-f71c1beb4ca4",
                    "sense_definition": "Qualifie une personne insensible ou fermée à certains sentiments, émotions ou influences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux juge semblait <w>inaccessible</w> à la pitié face aux supplications des accusés."
                        },
                        {
                            "text": "Ce chercheur persévérant demeure <w>inaccessible</w> au découragement malgré les échecs répétés."
                        }
                    ],
                    "antonyms": [
                        "accessible"
                    ],
                    "common_phrases": [
                        "inaccessible au doute",
                        "inaccessible à la peur",
                        "inaccessible à la pitié"
                    ]
                }
            ]
        }
    ]
}