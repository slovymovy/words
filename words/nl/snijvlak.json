            "senses": [
                {
                    "sense_id": "0497d30f-d336-3db0-b42f-6db5cb512b40",
                    "sense_definition": "het punt of gebied waar twee verschillende onderwerpen of vakgebieden elkaar raken of beïnvloeden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overlap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn onderzoek bevindt zich precies op het <w>snijvlak</w> van kunst en wetenschap.",
                            "target_lang_translations": {
                                "en": "His research is located exactly at the <w>intersection</w> of art and science."
                            }
                        },
                        {
                            "text": "Op het <w>snijvlak</w> van technologie en ethiek ontstaan vaak de meest interessante discussies.",
                            "target_lang_translations": {
                                "en": "The most interesting discussions often arise at the <w>interface</w> of technology and ethics."
                            }
                        }
                    ],
                    "synonyms": [
                        "raakvlak",
                        "overlap",
                        "grensvlak"
                    ],
                    "common_phrases": [
                        "op het snijvlak van"
                    ],
                    "target_lang_definitions": {
                        "en": "the point or area where two different subjects or fields of study touch or influence each other"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "intersection",
                                "target_lang_sense_clarification": "where two fields or ideas meet"
                            },
                            {
                                "target_lang_word": "interface",
                                "target_lang_sense_clarification": "the point where two systems or subjects interact"
                            },
                            {
                                "target_lang_word": "cutting edge",
                                "target_lang_sense_clarification": "metaphorical point of innovation between fields"
                            },
                            {
                                "target_lang_word": "overlap",
                                "target_lang_sense_clarification": "common area between two subjects"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77683cf6-78b7-3e93-83f1-e2d12f84953a",
                    "sense_definition": "het oppervlak dat ontstaat op de plaats waar een object is doorgesneden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek oppervlak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>snijvlak</w> van de houten balk was nog ruw en moest worden geschuurd.",
                            "target_lang_translations": {
                                "en": "The <w>cut surface</w> of the wooden beam was still rough and needed to be sanded."
                            }
                        },
                        {
                            "text": "Je kunt de jaarringen van de boom goed zien op het gladde <w>snijvlak</w>.",
                            "target_lang_translations": {
                                "en": "You can clearly see the tree's growth rings on the smooth <w>cross-section</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorsnede",
                        "zaagvlak"
                    ],
                    "common_phrases": [
                        "glad snijvlak"
                    ],
                    "target_lang_definitions": {
                        "en": "the surface created at the location where an object has been cut through"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cross-section",
                                "target_lang_sense_clarification": "the surface exposed by a cut"
                            },
                            {
                                "target_lang_word": "cut surface",
                                "target_lang_sense_clarification": "the physical face of a cut object"
                            },
                            {
                                "target_lang_word": "section",
                                "target_lang_sense_clarification": "a surface revealed by cutting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13f00b4a-5884-3b32-a93a-bdabd4a37e1e",
                    "sense_definition": "het scherpe deel van een gereedschap of instrument dat bedoeld is om te snijden",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman controleerde of het <w>snijvlak</w> van zijn beitel nog wel scherp genoeg was.",
                            "target_lang_translations": {
                                "en": "The carpenter checked if the <w>cutting edge</w> of his chisel was still sharp enough."
                            }
                        },
                        {
                            "text": "Door intensief gebruik is het <w>snijvlak</w> van het mes bot geworden.",
                            "target_lang_translations": {
                                "en": "Due to intensive use, the <w>edge</w> of the knife has become blunt."
                            }
                        }
                    ],
                    "synonyms": [
                        "snijkant",
                        "snede"
                    ],
                    "common_phrases": [
                        "scherp snijvlak"
                    ],
                    "target_lang_definitions": {
