                {
                    "sense_id": "88d75a68-01d0-3b1a-9abb-60dfaafd9e8e",
                    "sense_definition": "Existing as a part or portion; not complete or whole.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "completeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police were only able to provide a <w>partial</w> description of the suspect.",
                            "target_lang_translations": {
                                "ru": "Полиция смогла предоставить лишь <w>частичное</w> описание подозреваемого.",
                                "zh": "警方只能提供嫌疑人的<w>部分</w>描述。"
                            }
                        },
                        {
                            "text": "We reached a <w>partial</w> agreement on the contract terms today.",
                            "target_lang_translations": {
                                "ru": "Сегодня мы достигли <w>частичного</w> соглашения по условиям контракта.",
                                "zh": "我们今天就合同条款达成了<w>部分</w>协议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fractional"
                    ],
                    "common_phrases": [
                        "partial agreement",
                        "partial success",
                        "partial eclipse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий как часть или порция; неполный или незавершенный.",
                        "zh": "指事物的一部分，而非整体或全部。"
                    },
