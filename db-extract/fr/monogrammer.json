                "senses": [
                    {
                        "sense_id": "84c2cb9f-abe8-3e53-81d4-c965026f2ade",
                        "entry_id": "66324968-7a46-3052-92e1-af4a168f7a38",
                        "glosses": [
                            "Marquer d’un monogramme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb6f9924-032e-4614-9091-930789cf1247",
                                "sense_id": "84c2cb9f-abe8-3e53-81d4-c965026f2ade",
                                "text": "En effet, au cours du dernier quart du XVe siècle, la coutume de monogrammer les tableaux à cette place, était répandue à Louvain, dans l’école des Bouts, dont ce tableau semble montrer l’influence."
                            },
                            {
                                "example_id": "d85d33c0-8e90-4ed0-8919-ae789d122467",
                                "sense_id": "84c2cb9f-abe8-3e53-81d4-c965026f2ade",
                                "text": "Ils prennent alors l’habitude de signer ou de monogrammer, parfois de dater, leurs œuvres."
                            }
                        ]
                    }
                ],
