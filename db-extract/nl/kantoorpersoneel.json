                        "glosses": [
                            "mensen die in loondienst administratieve werkzaamheden op een kantoor verrichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1597e016-fd4e-472f-a9a0-960fcdde77b8",
                                "sense_id": "5c50839c-e972-3dbc-9193-059f75dbabf8",
                                "text": "Sellouf had geen symptomen of klachten. De test werd preventief afgenomen in aanloop naar het eerstvolgende duel, zoals NEC dat bij de selectiespelers, stafleden en kantoorpersoneel die regelmatig in contact komen met de selectie voorafgaand aan elk competitieduel doet."
                            },
                            {
                                "example_id": "72af1c41-862c-4d5b-b9f7-ca05cd634c93",
                                "sense_id": "5c50839c-e972-3dbc-9193-059f75dbabf8",
                                "text": "Het schoonmaakpersoneel dat de treinen en stations schoon hoort te houden staakt al sinds vorige week dinsdag. Zij liggen in de clinch met de vervoerder vanwege een vastgelopen CAO-conflict. De NS zijn momenteel ten einde raad, en overwegen de reizigers afvalzakken te geven, of om kantoorpersoneel in te zetten voor de schoonmaak van de treinstellen."
                            }
                        ]
                    }
