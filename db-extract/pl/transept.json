                "senses": [
                    {
                        "sense_id": "718f2526-5293-3d6a-b30e-098952f9d98b",
                        "entry_id": "70e14914-5fac-31c2-b6a2-7fea78b60435",
                        "glosses": [
                            "nawa poprzeczna w kościele, oddzielająca prezbiterium od reszty budynku"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca639dc8-0da4-4d19-be84-c911b61c8a90",
                                "sense_id": "718f2526-5293-3d6a-b30e-098952f9d98b",
                                "text": "Transept ułożony jest prostopadle do osi głównej kościoła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c71bbf5a-c7d3-4692-a034-2aad52ccf6c5",
                        "source_entry_id": "70e14914-5fac-31c2-b6a2-7fea78b60435",
                        "source_sense_id": "718f2526-5293-3d6a-b30e-098952f9d98b",
                        "target_lang_word": "transept",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transept",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc873e3-2bd0-39c3-a787-4e96a5466735",
                                        "entry_id": "c044dc39-b6cf-3cea-80fd-b46537c79b77",
                                        "glosses": [
                                            "The transversal part of a church, which crosses at right angles to the greatest length, and between the nave and choir. In the basilicas, this had often no projection at its two ends. In Gothic churches these project greatly, and should be called the arms of the transept. It is common, however, to speak of the arms themselves as the transepts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8129cc51-b92e-454a-b402-17366f228cb4",
                                                "sense_id": "8fc873e3-2bd0-39c3-a787-4e96a5466735",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d23ec284-5228-4464-9839-d05be92ec17c",
                        "source_entry_id": "70e14914-5fac-31c2-b6a2-7fea78b60435",
                        "source_sense_id": "718f2526-5293-3d6a-b30e-098952f9d98b",
                        "target_lang_word": "transept",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transept",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                        "entry_id": "9b6b4238-efb6-3948-8558-cd08cb8607b6",
                                        "glosses": [
                                            "Partie transversale d’une église qui coupe à angle droit la nef. Elle donne ainsi à l’édifice religieux la forme d’une croix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb8d686-74f2-4c42-9e13-885ddd05c963",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "Cette église se compose d’une nef […], et d’un transept avec abside et chapelles, datant du commencement du XIVᵉ siècle."
                                            },
                                            {
                                                "example_id": "43596ba3-3741-41d1-943e-de6d97ade014",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "Au XIIIᵉ siècle, on éventra les murs latéraux du chœur, comme à Laffaux (Aisne), pour établir un transept voûté d’ogives."
                                            },
                                            {
                                                "example_id": "aff618a9-ef63-49e0-8a85-cd5d83aead85",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "À sa gauche et à sa droite, deux minuscules galeries dessinaient les bras de croix d’un petit transept."
                                            },
                                            {
                                                "example_id": "28a7b904-08ea-43e1-9d05-dc0b09661ee6",
                                                "sense_id": "badf57bb-11a5-387c-bf8c-b990d1861475",
                                                "text": "[…] ; la forme de l’église est celle de la basilique ancienne à croix latine, au transept visible seulement par les voûtes ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc84d1c3-5ed7-486f-8d18-9e3ff290d8a7",
                        "source_entry_id": "70e14914-5fac-31c2-b6a2-7fea78b60435",
                        "source_sense_id": "718f2526-5293-3d6a-b30e-098952f9d98b",
                        "target_lang_word": "Querschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Querschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                                        "entry_id": "28e69812-f23b-376c-8ea8-1ffac7a7ad80",
                                        "glosses": [
                                            "Kirchenschiff, das sich quer zum Hauptschiff befindet oder das Hauptschiff kreuzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461a8983-10ce-4e8b-b846-b5ec601ea1b7",
                                                "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                                                "text": "„Erst einige Zeit später hätten die Christen begonnen, andere Kirchen zu bauen, Kirchen mit einem Altar in der Mitte und einer großen Kuppel darüber, oder Kirchen in Kreuzform mit einem großen Hauptschiff und einem Querschiff.“"
                                            },
                                            {
                                                "example_id": "9d96c804-379c-49d4-8e21-0a2cf02fcfda",
                                                "sense_id": "84e03d4b-015a-3c3d-b75a-6beb9894755e",
                                                "text": "„Robert, der langsam in Richtung auf die Apsis durch die Leere des Längsraums geschritten war, sah sich unvermutet an der Stelle, wo ein breit ausladendes Querschiff die Raumanlage kreuzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
