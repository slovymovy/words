{
    "word": "dugong",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                "word": "dugong",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5aefe86f-a48c-491d-92f2-e3fa633c5c93",
                        "entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "tags": [
                            "plural"
                        ],
                        "form": "dugongs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "glosses": [
                            "A plant-eating aquatic marine mammal, of the species Dugong dugon, found in tropical regions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d439a8a-8ef2-4d6c-a066-ef8de110dac2",
                                "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                                "text": "The Ceylong dugong is an extraordinary and interesting animal which is often seen on the coast. It is plentiful in and about the Gulf of Manaar, and resembles somewhat a huge, thickly-made, bluff-headed seal."
                            },
                            {
                                "example_id": "9ba6a425-7786-4953-b243-54b147dfcea9",
                                "sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                                "text": "“What are those things that aren’t seals? Much worse than seals. Big, blubbery things. Dugongs.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfbab8d5-6ace-4828-850b-bbd0a33626fc",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "doejong",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doejong",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                        "entry_id": "7c23de78-fd9b-3064-9016-171a6a0b49a6",
                                        "glosses": [
                                            "bepaald soort in het water levend zoogdier, Dugong dugon, dat voorkomt langs de kusten van de Indische Oceaan en het zuidwesten van de Stille Oceaan"
                                        ],
                                        "tags": [
                                            "zeekoeien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c273f2-0382-4c40-aefd-41e875082367",
                                                "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                                "text": "In het donker zag je doejongs, grijze zeekoeien van een meter of drie lang, als donkere gestalten langs je boot glijden, het maanlicht weerkaatste op hun brede ruggen."
                                            },
                                            {
                                                "example_id": "513169a4-8640-45ee-8adb-f390446c096f",
                                                "sense_id": "130d0f1a-e967-3b06-ae67-a0c3d76099f8",
                                                "text": "De uitgestrekte zeegrasvelden voor de kust van de Indonesische eilanden vormen het terrein van de doejong, of Indische zeekoe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56e09498-faea-4dfc-9f72-6181c4e74d00",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "Indische zeekoe",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a79fb7d0-4a5b-4059-99bd-af118f12a172",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "vache marine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vache marine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84b89f9d-8a1c-32a3-8f11-4ef8537204fe",
                                        "entry_id": "b7d376bc-8686-3e11-aae5-44945c9ba6c0",
                                        "glosses": [
                                            "Un des noms usuels des lamantins ou du dugong."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9de77be3-13d2-3789-b30c-2c1e1dda47c5",
                                        "entry_id": "b7d376bc-8686-3e11-aae5-44945c9ba6c0",
                                        "glosses": [
                                            "Morse."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adcac9cf-6ebd-4ec3-91bb-0afbd36431e0",
                                                "sense_id": "9de77be3-13d2-3789-b30c-2c1e1dda47c5",
                                                "text": "Dans l'éléphant et la vache marine, elles sont cylindriques et longues de quelques pieds ; dans le sanglier et le cochon mâle, elles se courbent, en portion de cercle ; elles sont plates et tranchantes, et j'en ai vu de neuf à dix pouces de longueur […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5329c82-6d3b-4047-b8f5-95719e85c253",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "dugong",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dugong",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                                        "entry_id": "a151bcd3-eb0d-32ac-b9df-061545d1fae7",
                                        "glosses": [
                                            "Mammifère marin au corps fuselé et à queue échancrée, qui appartient à l’ordre des siréniens avec les lamantins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ab8c50-83b0-4780-a886-95f63054c1ee",
                                                "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                                                "text": "— Est-ce que ce dugong est dangereux à attaquer ? demandai-je malgré le haussement d’épaule du Canadien."
                                            },
                                            {
                                                "example_id": "52ff1bfe-e6dd-4b62-94c4-f9d494b93102",
                                                "sense_id": "fd6f0c27-0fc3-35dd-a972-3be96ddb2449",
                                                "text": "D’après les indigènes, un poisson qu’ils appellent mammba, a des mamelles qui donnent du lait ; c’est probablement un dugong."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2399a18-552b-4834-af6c-438e5e9de578",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "Gabelschwanzseekuh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "518a1716-4a30-4d2d-9db2-59f1e2f33648",
                        "source_entry_id": "0b84be46-91e8-36c0-a5f8-e2396e38e7e7",
                        "source_sense_id": "b8390524-529c-3457-bb50-b8e425e331ef",
                        "source_sense_description": "Dugong dugon",
                        "target_lang_word": "Dugong",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dugong",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                        "entry_id": "7199dca1-d6c6-33f9-8e4d-ec808c7c1362",
                                        "glosses": [
                                            "ein herbivores Säugetier, das die australischen und philippinischen Küstengewässer sowie die des Roten Meeres bewohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d91568b3-1a4d-45b0-ae84-8d736fadc29f",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Hier auf Utupua schweben die Dugongs noch über den Riffen, müden Walfischen gleich, mit dem sanften Blick der Sirene."
                                            },
                                            {
                                                "example_id": "a354f9ac-1ba7-4caa-9126-8178774c1ac9",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Er war ins Meer gesprungen und hatte den vier Meter langen Dugong an der Schwanzflosse gepackt, damit Biologen das Tier zu Forschungszwecken markieren konnten."
                                            },
                                            {
                                                "example_id": "3f01dfba-a752-499c-82bc-90cfd22617ff",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "In der Resolution Bay auf Tanna haben sich seit 1970 Dugongs an die dort lebenden Fischer angeschlossen."
                                            },
                                            {
                                                "example_id": "ef5c858f-1ee7-4926-a81d-09a20b5e53b5",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Die Dugonge gelten bei den Malayen für das Muster ehelicher Zärtlichkeit und man erzählt, dass sie die Thränen dieses Thiers als ein sicheres Mittel betrachten, sich die Gegenliebe einer geliebten Person zu verschaffen."
                                            },
                                            {
                                                "example_id": "e24c0e79-d661-40a4-be00-bf6cf289b57a",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "Strände und kleine Inseln bieten Lebensraum für Seevögel, Meeressäuger, Haie, Schildkröten und Mantas, in der Dungonab-Bucht leben auch Dugongs."
                                            },
                                            {
                                                "example_id": "9f24e570-b05d-489e-ba70-a4c1f8564d52",
                                                "sense_id": "e33b647b-0a24-3fbe-b2f6-cb77d0336b3f",
                                                "text": "„Diesmal täuschte sich der junge Forscher, denn es war kein Manati, sondern ein Dugong mit großen Nasenlöchern über dem Maul.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
