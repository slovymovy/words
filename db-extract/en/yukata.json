                    },
                    {
                        "form_id": "1d9056b5-f2c4-41d1-a919-8391b50bbb99",
                        "entry_id": "e7a49eda-291b-3fd2-beb3-c94eb0059032",
                        "tags": [
                            "plural"
                        ],
                        "form": "yukatas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                        "entry_id": "e7a49eda-291b-3fd2-beb3-c94eb0059032",
                        "glosses": [
                            "An unlined cotton summer kimono worn by both men and women."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4e154a3-292c-425f-b0cd-f8fa97d8c838",
                                "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                                "text": "When made of lightweight cotton, the unlined and partially lined kimono become yukata. Yukata, however, do not have flutter sleeves, as they are considered too dressy for this informal kimono."
                            },
                            {
                                "example_id": "a05a98f4-2f00-4434-85cf-a7904019ea87",
                                "sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                                "text": "Most Japanese now wear yukata as summer kimono that are cool and comfortable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a025545-a658-4baf-9b84-2f07d4601e72",
                        "source_entry_id": "e7a49eda-291b-3fd2-beb3-c94eb0059032",
                        "source_sense_id": "b455f47f-e2c4-36d0-a5f7-96500655510c",
                        "source_sense_description": "a light kimono",
                        "target_lang_word": "yukata",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yukata",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                        "entry_id": "874a5e80-67f9-3d7e-96c2-de30be9c5f8d",
                                        "glosses": [
                                            "Léger kimono d’été."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387f6ea8-e615-41bd-9c79-9f86cab8a0d4",
                                                "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                                "text": "Après son bain, elle enfila son yukata bleu et blanc, et se dirigea vers sa chambre, où son mari ronflait innocemment."
                                            },
                                            {
                                                "example_id": "083bce4a-e894-4abb-9dac-981f4958f22a",
                                                "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                                "text": "Quand j’étais étudiante, on pouvait rentrer du bain public à minuit passé, en yukata, serviette et savon à la main, en faisant claquer ses geta dans les ruelles désertes."
                                            },
                                            {
                                                "example_id": "7f5f3056-71df-4044-8773-4f112ba463af",
                                                "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                                "text": "Suivant le conseil de la femme, ayant revêtu un yukata après m’être baignée à la source chaude, j’ai emprunté les sandales de l’auberge pour aller marcher sur le sentier."
                                            },
                                            {
                                                "example_id": "a0a3c0bf-69a7-4322-992a-cd0ca72ac0e9",
                                                "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                                "text": "Emballées dans nos yukatas, nous descendons dans le hall, où le tenancier joue le rôle de veilleur de nuit."
                                            },
                                            {
                                                "example_id": "3c75b4bf-f029-4e81-8bc9-639600280540",
                                                "sense_id": "2b48b224-fc17-30a2-be91-82a8e9b1871e",
                                                "text": "Yukata – Robe de coton, sans doublure, qui se porte en été, ou au sortir du bain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
