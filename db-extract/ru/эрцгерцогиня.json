                    {
                        "translation_id": "18423616-942a-46c4-821a-7b5e05d4c102",
                        "source_entry_id": "fe7823c6-a7a6-3218-9a01-d3971e68adb2",
                        "source_sense_id": "23212a72-1aa6-37b2-b0c2-9f59c1b25154",
