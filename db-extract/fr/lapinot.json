                                        "entry_id": "3724c271-d000-3d48-895d-bea319fccd8f",
                                        "glosses": [
                                            "Bunny chow; a snack of bread filled with curry."
                                        ],
                                        "tags": [
                                            "South-Africa"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79255064-f387-4d15-beeb-0a7baa904872",
                                                "sense_id": "3551bc8a-a56d-3ec7-8db5-02635496b06c",
                                                "text": "Surfers from Durban grew up on bunnies. You get the curry in the bread with the removed square chunk, used to dunk back in the curry."
                                            }
