                    {
                        "translation_id": "82a7728c-0d24-4488-ac2d-8fb01d85ac00",
                        "source_entry_id": "b34737bc-c150-352e-915b-66769ffb2b70",
                        "target_lang_word": "acanthus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acanthus",
