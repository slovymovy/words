                ],
                "senses": [
                    {
                        "sense_id": "f0d02893-997b-3bb9-8471-1781fca82969",
                        "entry_id": "cb49e55f-b944-37ed-8ba0-0591bd0d9401",
                        "glosses": [
                            "A fee charged by a restaurant to serve wine that a diner has provided."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ef686b9-c10b-49fd-abf3-e53a784550fe",
                                "sense_id": "f0d02893-997b-3bb9-8471-1781fca82969",
                                "text": "While the Black-nebs wanted only the tea and sugar cheap, and a drap brandy at a reasonable rate, I was hand in glove wi' them; and ga'e them ben the house to meet in, free o' a charge—save the natural corkage."
                            },
                            {
                                "example_id": "1647dc06-eca7-4702-95f8-239bfb5ddf06",
                                "sense_id": "f0d02893-997b-3bb9-8471-1781fca82969",
                                "text": "‘Corkage’ is the peculiar vail of the superior of the establishment. You must, if you are the stranger within his gates, imbibe his very bad 18s. sherry at a charge of 36s., or his fifth-rate bottled beer, or pay the ‘corkage’ fee of 1s. 6d. per dozen on everything of your own ordering from which a cork has to be extracted, and probably also forfeit the bottles, charged, in the case of beer, at 2s. per dozen."
                            },
                            {
                                "example_id": "7ca32d6d-bb23-4e12-9d0e-0a7e3558d2dc",
                                "sense_id": "f0d02893-997b-3bb9-8471-1781fca82969",
                                "text": "Five of their favorite destinations are included below and, although their wines lists are pedestrian, modest corkages are the rule."
                            }
                        ]
                    }
                ],
