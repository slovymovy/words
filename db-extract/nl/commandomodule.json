                        "entry_id": "bbfc429b-dec4-3cdf-a7f6-34bdfcce70b2",
                        "glosses": [
                            "deel van een ruimtevaartuig van waaruit de bemanningsleden het ruimteschip kunnen besturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07fefa6b-f705-49a7-8760-09d80b69c4fa",
                                "sense_id": "6033535c-b87d-354f-ae8b-aebe008773a2",
                                "text": "Precies met zo'n servicemodule ging het bij Apollo 13 rampzalig mis. Een zuurstoftank explodeerde, de tweede liep leeg en in enkele uren zaten de drie astronauten zonder stroom, water en zuurstof in hun commandomodule. Door in ijltempo naar de maanlander over te stappen wisten ze te overleven."
                            },
                            {
                                "example_id": "d0992605-1628-4218-b2bc-f7ebbbee42d2",
                                "sense_id": "6033535c-b87d-354f-ae8b-aebe008773a2",
                                "text": "Gordon is niet zelf op de maan geweest. Terwijl Conrad en Bean twee wandelingen op de maan maakten, bleef hij volgens afspraak achter in de commandomodule Yankee Clipper. Bij terugkeer op aarde werd de bemanning door de USS Hornet uit de oceaan gevist."
                            }
                        ]
                    }
