                {
                    "sense_id": "b96cdc2b-5b98-3e54-b476-b7b33971ffdc",
                    "sense_definition": "geld bijleggen of gezamenlijk een bedrag betalen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "betalen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moesten allemaal een tientje <w>lappen</w> voor het cadeau.",
                            "target_lang_translations": {
                                "en": "We all had to <w>chip in</w> ten euros for the gift.",
                                "ru": "Нам всем пришлось <w>скинуться</w> по десятке на подарок.",
                                "zh": "我们每个人都得为这份礼物<w>凑</w>十块钱。"
                            }
                        },
                        {
                            "text": "Als iedereen een beetje <w>lapt</w>, kunnen we deze rekening betalen.",
                            "target_lang_translations": {
                                "en": "If everyone <w>chips in</w> a little, we can pay this bill.",
                                "ru": "Если каждый немного <w>даст</w> денег, мы сможем оплатить этот счет.",
                                "zh": "如果每个人都<w>分摊</w>一点，我们就能付清这笔账单。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel gebruik rondom geld"
