                "senses": [
                    {
                        "sense_id": "32bb6128-3ef9-388d-907a-e0641221842d",
                        "entry_id": "6fcbb2b1-3be1-30e8-b0c0-3b81c9c2231d",
                        "glosses": [
                            "Hafenstadt im mexikanischen Bundesstaat Veracruz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a7ba9f-fd2c-4d6c-a014-4caa1e548791",
                                "sense_id": "32bb6128-3ef9-388d-907a-e0641221842d",
                                "text": "„Als sie, die Tochter eines Nahua-Adligen aus Coatzacoalcos, weiter im Westen an der Küste nahe dem heutigen Veracruz geboren wurde, hatte ihre Mutter wahrscheinlich ihre Nabelschnur neben die Herdstelle gelegt, wie es die meisten Nahuatl-sprachigen Mütter taten.“"
                            },
                            {
                                "example_id": "a8e8d11e-f695-4285-9c85-223c08955359",
                                "sense_id": "32bb6128-3ef9-388d-907a-e0641221842d",
                                "text": "„Gonzalo de Sandoval leitete die Eroberungen im Südosten (Coatzacoalcos, Oaxaca, Tuxtepec) und Nordosten (Huatusco und Pánuco).“"
                            },
                            {
                                "example_id": "a6e9f577-e456-47ed-b55c-347b6a93004a",
                                "sense_id": "32bb6128-3ef9-388d-907a-e0641221842d",
                                "text": "„Rund 75 Seemeilen weiter westlich nahe der heutigen Stadt Coatzacoalcos richtet sich der Küstenverlauf des Golfs von Mexiko zunehmend nach Norden aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
