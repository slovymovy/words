        "fr-extract.jsonl": [
            {
                "entry_id": "497fc558-f867-3263-8bb6-6b610ea52ede",
                "word": "logiciellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                        "entry_id": "497fc558-f867-3263-8bb6-6b610ea52ede",
                        "glosses": [
                            "De manière logicielle, à l’aide d’un logiciel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f308a48-1d28-47d9-b8a9-cbc75241d5a1",
                                "sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                                "text": "Ces équipements commercialisés à des prix parfois très faibles peuvent être détournés –logiciellement ou matériellement– de leurs fonctions premières, pour être ensuite utilisés comme des outils d’analyse."
                            },
                            {
                                "example_id": "b20c2f7e-8d74-4123-9a0f-5466b3f899f6",
                                "sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                                "text": "Ainsi, la carte réseau peut être associée logiciellement à la suite de protocoles TCP/IP ou à tout autre protocole."
                            },
                            {
                                "example_id": "d2523182-b869-426a-90bd-4cbd33126ce0",
                                "sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                                "text": "Dans certains cas, il peut être souhaitable d’aider logiciellement le sujet, lors de ses mouvements sans contrainte d’effort."
                            },
                            {
                                "example_id": "efccbd00-2cef-452e-9379-5adc1b235707",
                                "sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                                "text": "Un « hypertexte » est un document dont des termes choisis comme étant les termes prégnants des subdivisions dans lesquels ils se trouvent sont réalisés, logiciellement, comme des « boutons » qui ouvrent des portes donnant sur d’autres subdivisions connexes : paragraphes, arbres, schémas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f09efd8-d908-456f-aca7-672f4e98ddb1",
                        "source_entry_id": "497fc558-f867-3263-8bb6-6b610ea52ede",
                        "source_sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                        "target_lang_word": "program",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "program",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c51aa40a-89ee-3b64-80f5-b407ce2efb67",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A set of structured activities; a plan of action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e12aadce-5d05-4bd4-9e47-5082a4d34527",
                                                "sense_id": "c51aa40a-89ee-3b64-80f5-b407ce2efb67",
                                                "text": "get with the program"
                                            },
                                            {
                                                "example_id": "0a2c3437-79a4-48d9-ad00-6b238e705a37",
                                                "sense_id": "c51aa40a-89ee-3b64-80f5-b407ce2efb67",
                                                "text": "Our program for today’s exercise class includes swimming and jogging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c67ba6f0-00e1-3ab2-9f80-1ab9c26f4b3a",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A leaflet listing information about a play, game or other activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa55134-1d28-4ec7-96d3-42ee26ab46c9",
                                                "sense_id": "c67ba6f0-00e1-3ab2-9f80-1ab9c26f4b3a",
                                                "text": "The program consisted of ads for restaurants and the credits of everyone connected with the play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67dda13-0bfc-34a0-9a3c-2e5cef84c7d3",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A set of principal goals which someone, especially a political party or candidate, supports."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38022396-76e9-4e87-8524-fb916d9cfc19",
                                                "sense_id": "d67dda13-0bfc-34a0-9a3c-2e5cef84c7d3",
                                                "text": "the Toronto Sun, a daily tabloid whose programme is roughly that of the American National Enquirer or the British News of the World"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1496566-eb5c-3011-a6d7-aa2642874701",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A performance of a show or other broadcast on radio or television."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72a9a49d-6178-4aaa-a29b-f4290e5937cd",
                                                "sense_id": "a1496566-eb5c-3011-a6d7-aa2642874701",
                                                "text": "Tonight’s program was hosted by Johnny Carson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31199160-e268-35f5-9963-00e104ad66ed",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A computer program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543545cd-5b6e-4d25-8dc3-e55529d53b35",
                                                "sense_id": "31199160-e268-35f5-9963-00e104ad66ed",
                                                "text": "The program runs on both Linux and Microsoft Windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63659266-afa2-3c51-a6e6-86665d3571d8",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A particular mindset or method of doing things."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1157dfbb-5f61-4649-94dd-f36808a626da",
                                                "sense_id": "63659266-afa2-3c51-a6e6-86665d3571d8",
                                                "text": "Ellis: Come on, John, why don’t you get with the program and tell him where the detonators are?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5285ea-df7b-3bcd-9887-9d3db98cc9b2",
                                        "entry_id": "7a2618d8-4b5f-3bf4-863a-6f99477457d4",
                                        "glosses": [
                                            "A custom tracklist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eccf3089-4480-408b-b5b2-4b317b75164d",
                                                "sense_id": "0c5285ea-df7b-3bcd-9887-9d3db98cc9b2",
                                                "text": "program playback",
                                                "translation": "playing tracks in a custom order",
                                                "english": "playing tracks in a custom order"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "program",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a86d7b2-f88d-3e32-98a6-cc0ab5b7d63f",
                                        "entry_id": "f3be954f-85e7-32ea-9c5a-b0dac8733ff1",
                                        "glosses": [
                                            "To enter a program or other instructions into (a computer or other electronic device) to instruct it to do a particular task."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb8cc72e-949a-47dd-94d4-2aeb6dfdf850",
                                                "sense_id": "8a86d7b2-f88d-3e32-98a6-cc0ab5b7d63f",
                                                "text": "He programmed the DVR to record his favorite show."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c80c040-2b21-3acc-b534-1fd748ec7ea8",
                                        "entry_id": "f3be954f-85e7-32ea-9c5a-b0dac8733ff1",
                                        "glosses": [
                                            "To develop (software) by writing program code."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060f58a4-5389-49fb-9b8b-4c87d03d6d63",
                                                "sense_id": "6c80c040-2b21-3acc-b534-1fd748ec7ea8",
                                                "text": "I programmed a small game as a demonstration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "097ae155-47fc-3a91-b0e9-01edd93054ad",
                                        "entry_id": "f3be954f-85e7-32ea-9c5a-b0dac8733ff1",
                                        "glosses": [
                                            "To put together the schedule of an event."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05868813-ebba-48b5-ad5e-65d1abe37f5d",
                                                "sense_id": "097ae155-47fc-3a91-b0e9-01edd93054ad",
                                                "text": "Mary will program Tuesday’s festivities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d0c469-70f5-321a-afe6-f10b86c981a6",
                                        "entry_id": "f3be954f-85e7-32ea-9c5a-b0dac8733ff1",
                                        "glosses": [
                                            "To schedule the programming; to determine what will be broadcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e567efe8-8c04-4385-a077-53e90c81db58",
                                                "sense_id": "b3d0c469-70f5-321a-afe6-f10b86c981a6",
                                                "text": "We program for special audience groups, too, as shown by our Mexican language program each Sunday morning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19cd5947-6d04-3c11-94b5-45d2acf9fd13",
                                        "entry_id": "f3be954f-85e7-32ea-9c5a-b0dac8733ff1",
                                        "glosses": [
                                            "To cause to automatically behave in a particular way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a84009a2-cf32-4210-961d-0b1b57cca68b",
                                                "sense_id": "19cd5947-6d04-3c11-94b5-45d2acf9fd13",
                                                "text": "The lab rat was programmed to press the lever when the bell rang."
                                            },
                                            {
                                                "example_id": "088a8590-8180-4cc9-bca6-a2d847778f33",
                                                "sense_id": "19cd5947-6d04-3c11-94b5-45d2acf9fd13",
                                                "text": "My point was not to commend but to expose her, and her way of thinking. In another place a teenage character worries that her stomach is too big. I, the author don't think her stomach is too big—the character does, because she's been programmed that way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78b10a37-8255-4948-99d9-ad7ea592e7c8",
                        "source_entry_id": "497fc558-f867-3263-8bb6-6b610ea52ede",
                        "source_sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                        "target_lang_word": "reprogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6c2114-1f28-3cdb-bb8c-e15b1a76bb8c",
                                        "entry_id": "c22e5536-0d08-3764-8566-dfaf15795930",
                                        "glosses": [
                                            "To program anew or differently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb89018-5378-4b6f-b253-3d5db5313347",
                                                "sense_id": "2c6c2114-1f28-3cdb-bb8c-e15b1a76bb8c",
                                                "text": "Installing a new hard drive would require a modchip that can reprogram or bypass the hard drive lock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24b3352f-1b13-3446-9c99-0886ce499745",
                                        "entry_id": "c22e5536-0d08-3764-8566-dfaf15795930",
                                        "glosses": [
                                            "To make a fundamental change to the behaviour or habits of."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f12ed482-8581-3062-87ac-771f3d207767",
                                        "entry_id": "c22e5536-0d08-3764-8566-dfaf15795930",
                                        "glosses": [
                                            "To shift funds appropriated for one government program to a different government program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e65044-a716-4f5e-9fcd-6795ff41bff4",
                                                "sense_id": "f12ed482-8581-3062-87ac-771f3d207767",
                                                "text": "Technically, DOE did not need authority to reprogram the funds as long as the spending didn't span different appropriation line items."
                                            },
                                            {
                                                "example_id": "ee363455-9c0c-46ad-82ce-842efbeb23a7",
                                                "sense_id": "f12ed482-8581-3062-87ac-771f3d207767",
                                                "text": "This deferral is reported to give Congress time to consider a request to reprogram the funds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c44ae8b6-f979-4fe6-a109-6fa8ddc562ad",
                        "source_entry_id": "497fc558-f867-3263-8bb6-6b610ea52ede",
                        "source_sense_id": "5b07d1aa-342f-3958-b160-9d8e71ce0405",
                        "target_lang_word": "software",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "software",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4868757c-273b-39d7-aaa3-65960db7be9f",
                                        "entry_id": "69942127-9d71-3349-8360-e9fc48d591ef",
                                        "glosses": [
                                            "Encoded computer instructions, usually modifiable (unless stored in some form of unalterable memory such as ROM)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed32ba44-dcbd-4644-a4d4-855ffb1f293b",
                                                "sense_id": "4868757c-273b-39d7-aaa3-65960db7be9f",
                                                "text": "The \"software\" comprising the carefully planned interpretive routines, compilers, and other aspects of automative programming are at least as important to the modern electronic calculator as its \"hardware\" of tubes, transistors, wires, tapes and the like."
                                            },
                                            {
                                                "example_id": "0157b333-7f96-4ca5-8c61-3169d5a29f89",
                                                "sense_id": "4868757c-273b-39d7-aaa3-65960db7be9f",
                                                "text": "As originally conceived, the word \"software\" was merely an obvious way to distinguish a program from the computer itself. A program comprised sequences of changeable instructions each having the power to command the behavior of the permanently crafted machinery, the \"hardware.\""
                                            },
                                            {
                                                "example_id": "9e732cf2-05f3-4c1f-9d87-64290bb6f8f0",
                                                "sense_id": "4868757c-273b-39d7-aaa3-65960db7be9f",
                                                "text": "Cris “Space Rogue” Thomas, another ex-L0pht member who testified alongside Zatko that day, said that L0pht would do everything it could to get companies to collaboratively fix software issues the hacker group found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a33325-b215-340a-b417-3d15b636186c",
                                        "entry_id": "69942127-9d71-3349-8360-e9fc48d591ef",
                                        "glosses": [
                                            "The human beings involved in warfare, as opposed to hardware such as weapons and vehicles."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768e55d4-7cf5-4408-be99-a9360ed78776",
                                                "sense_id": "d7a33325-b215-340a-b417-3d15b636186c",
                                                "text": "The Americans have devoted their attention to the hardware of disarmament: Europeans can make a special contribution to the 'software' or human content of detente."
                                            },
                                            {
                                                "example_id": "e6c47d8c-6172-43ba-988c-56a73991bd0f",
                                                "sense_id": "d7a33325-b215-340a-b417-3d15b636186c",
                                                "text": "[…] preview of horrific images to come, as the hardware stage of the war yields to the software — or human — stage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
