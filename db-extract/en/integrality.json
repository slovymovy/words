                        "source_sense_id": "17bff7cb-4ba9-3489-b397-80a60776eb38",
                        "source_sense_description": "condition of being integral",
                        "target_lang_word": "це́лостность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "це́лостность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                                        "glosses": [
                                            "свойство по значению прилагательного целостный; полнота, завершённость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "269366cd-f047-4e88-9f5b-9d0ddb27d33e",
                                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                                "text": "Восприятие зрительного поля определяется не отдельными элементами, как в случае ассоциаций, предшествующим опытом и т. д., а динамическими силами, определяющими целостность восприятия."
                                            },
                                            {
                                                "example_id": "046a994f-b872-4ae0-b340-2fa266444ffa",
                                                "sense_id": "dffcf0f0-56fb-311c-bfc9-bd493bf5b211",
                                                "text": "При подсветке водных объектов уместно цветное освещение — главное, чтобы сохранилась целостность композиционного замысла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                        "entry_id": "c1e7d102-bba3-3335-bb08-14aae3af86d4",
                                        "glosses": [
                                            "свойство по значению прилагательного целый; отсутствие повреждений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8e0d4a-7bc8-4263-8f9f-ca0689cb4e4e",
                                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                                "text": "Опустите глубоко в землю фундамент — и вы не будете бояться за целостность вашего жилища."
                                            },
                                            {
                                                "example_id": "3bffc3f8-a1dd-4636-b578-3758d9c2d514",
                                                "sense_id": "27125d0c-87be-349d-9551-de7e927f2700",
                                                "text": "Отщепившись от молекулы белка в результате ряда жизненных процессов, ароматическая группа, правда, претерпевает целый ряд превращений, но ароматическое ядро во всех фазах своего превращения и вплоть до момента своего выделения из организма животного сохраняет свою целостность."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b45b4c7-346d-41c1-85df-de38a09265c8",
                        "source_entry_id": "995ffa9f-aa42-3b4c-bfc8-f29d246ef61d",
                        "source_sense_id": "17bff7cb-4ba9-3489-b397-80a60776eb38",
                        "source_sense_description": "condition of being integral",
                        "target_lang_word": "полнота́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "полнота́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbd88b5-557e-3e7d-b3c1-b849a27e32bb",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "свойство по значению прилагательного полный; наполненность, достаточное наличие чего-либо; полная мера, полный состав, предельное количество || исчерпанность, обстоятельность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ede76f2-25a1-40e4-90a1-0bdeba5ed186",
                                                "sense_id": "1cbd88b5-557e-3e7d-b3c1-b849a27e32bb",
                                                "text": "По роже видно, что для полноты её счастья не хватает только присутствия в ящике «его», отца её детей, которому она так беззаветно отдалась!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ec57a6b-6c16-3d9f-8de2-432cf4861c03",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "наличие разнообразия, множества свойств в чём-либо; насыщенность, содержательность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446ced9b-56c1-462a-a3f7-c436c274aadb",
                                                "sense_id": "2ec57a6b-6c16-3d9f-8de2-432cf4861c03",
                                                "text": "Так как от невежества мы ушли, но к цивилизации, слава богу, ещё не дошли, а обретаемся на золотой середине, то этот языческий праздник сохранился и до нашего времени во всей своей полноте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "348d61c4-ec4e-3160-a24a-4aec3e5e2659",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "тучность, толщина тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f02157-6697-4aeb-87ff-cf9a3f239211",
                                                "sense_id": "348d61c4-ec4e-3160-a24a-4aec3e5e2659",
                                                "text": "Как он ни разглядывал её, как ни пытал, с какой стороны ни заходил, а всё видел пока только, что Марфенька была свежая, белокурая, здоровая, склонная к полноте девушка, живая и весёлая."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de63e3d6-e338-3fca-b8c7-31d43de510c2",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "округлость, пышность какой-либо части тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d5535d-2940-4bd4-8354-0f8f781b2274",
                                                "sense_id": "de63e3d6-e338-3fca-b8c7-31d43de510c2",
                                                "text": "Полнота и свежесть щёк её и пышность груди подтверждали обещание насчёт детей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33103c20-45e3-327e-b133-6911dc2cf953",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "спец. характеристика размера одежды по объёму"
                                        ],
