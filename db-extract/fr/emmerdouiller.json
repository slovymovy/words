                "senses": [
                    {
                        "sense_id": "2344b606-6a28-34ab-82dc-e188171268ac",
                        "entry_id": "219cf824-a152-360e-b37c-ad89617a27ae",
                        "glosses": [
                            "Emmerder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "625dc827-abfe-407b-a5c4-ef4a2f0bc136",
                                "sense_id": "2344b606-6a28-34ab-82dc-e188171268ac",
                                "text": "Je crois que je vais emmerdouiller mon monde ici ce soir."
                            },
                            {
                                "example_id": "39a51b39-964d-4646-91ad-fc7219f75efe",
                                "sense_id": "2344b606-6a28-34ab-82dc-e188171268ac",
                                "text": "Pour emmerdouiller les passants, Lucien s’y entend à merveille. Tout simplement parce qu’il pose des questions qu’un gamin de son âge ne devrait pas poser."
                            }
                        ]
                    },
                    {
                        "sense_id": "351a73ed-d0c4-32a1-ac81-0e81fb4972d5",
                        "entry_id": "219cf824-a152-360e-b37c-ad89617a27ae",
                        "glosses": [
                            "S’emmerder."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2eca108d-120e-4369-be83-61b6f6c6724e",
                                "sense_id": "351a73ed-d0c4-32a1-ac81-0e81fb4972d5",
                                "text": "Qu’est-ce qu’elle pouvait trouver comme plaisir à s’emmerdouiller pour expliquer Baudelaire ou Zola à des merdeux qui n’en avaient qu’après Zidane ou Beckham ?"
                            }
                        ]
                    }
