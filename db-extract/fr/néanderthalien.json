                "senses": [
                    {
                        "sense_id": "56770a7c-2492-3f73-93fd-2fa4ff6d5c80",
                        "entry_id": "e14ecf9e-1b71-35b8-ba81-23208d131bd1",
                        "glosses": [
                            "Espèce humaine cousine de l'homme contemporain (Homo sapiens sapiens) et disparue il y a apparemment 30 000 ans environ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd0c28d-6dd5-4491-b946-e36ba0843d2c",
                                "sense_id": "56770a7c-2492-3f73-93fd-2fa4ff6d5c80",
                                "text": "Le succès des hommes de Cro-Magnon a entraîné directement ou indirectement la disparition des Néanderthaliens."
                            },
                            {
                                "example_id": "d807b43c-181b-4881-9599-377d465c8e99",
                                "sense_id": "56770a7c-2492-3f73-93fd-2fa4ff6d5c80",
                                "text": "Certains linguistes, suivis par quelques préhistoriens, notamment anglo-saxons, s’appuient sur les recherches de Meritt Ruhlen pour expliquer que c’est cette langue mère qui aurait permis à Homo sapiens « de l’emporter » sur les Néanderthaliens."
                            }
                        ]
                    }
