                ],
                "senses": [
                    {
                        "sense_id": "16af1f21-ff70-3be4-9908-618551355d89",
                        "entry_id": "6f25e16e-c865-35b2-bf10-899f1e428c01",
                        "glosses": [
                            "Celle qui mène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04f24035-dd31-4565-a10d-b0959dba0bc7",
                                "sense_id": "16af1f21-ff70-3be4-9908-618551355d89",
                                "text": "Il sortit assez vite pour voir qu’il s’agissait d’une grosse clarine, réservée d’ordinaire à la vache meneuse."
                            },
                            {
                                "example_id": "29c0ad94-bbe2-41fa-9776-4d1c66e9aec8",
                                "sense_id": "16af1f21-ff70-3be4-9908-618551355d89",
                                "text": "Pour lancer sa ligne de prêt-à-porter, la meneuse de Bptich Control invite ses confrères derrière les platines. (journal 20 minutes édition Paris, nᵒ 919 du 3 mars 2006)."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a3667e6-36a0-3550-bb96-9f1ed17e2ba2",
                        "entry_id": "6f25e16e-c865-35b2-bf10-899f1e428c01",
                        "glosses": [
                            "Joueuse qui dirige son équipe."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7294ef-b494-4d10-8667-96a426d5cf1e",
                                "sense_id": "1a3667e6-36a0-3550-bb96-9f1ed17e2ba2",
                                "text": "Arrivée, il y a un peu plus d'un an, en équipe de France, pour pallier l’absence de la meneuse Bria Hartley, Gabby Williams a vite pris ses aises dans sa sélection d’adoption."
                            },
                            {
                                "example_id": "8fa5c32d-8f4a-42c8-8b33-e2e63132e05a",
                                "sense_id": "1a3667e6-36a0-3550-bb96-9f1ed17e2ba2",
                                "text": "Une cohésion et une combativité qu’il faudra retenir pour la suite de cette jeune équipe de France, incarnée par la meneuse Marine Fauthoux, qui a surnagé jeudi."
                            },
                            {
                                "example_id": "00e23a98-de46-4eba-856f-b9f194b22cda",
                                "sense_id": "1a3667e6-36a0-3550-bb96-9f1ed17e2ba2",
                                "text": "C’est une équipe qui a beaucoup de cœur, on a vu leurs célébrations, livrait la meneuse française Romane Bernies."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebbac142-c006-3565-851f-a6a4c80ce85b",
                        "entry_id": "6f25e16e-c865-35b2-bf10-899f1e428c01",
                        "glosses": [
                            "Personne qui dirige et mène un attelage équestre."
                        ],
