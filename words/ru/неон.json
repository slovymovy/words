{
    "word_family": [
        "неоновый",
        "неонка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7fb9bdc-e2d5-304b-bf39-1ca3f5fc58ca",
                    "sense_definition": "Яркое свечение неоновых ламп, рекламных вывесок",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечером шумные улицы большого города заливает холодный <w>неон</w> витрин и ресторанов.",
                            "target_lang_translations": {
                                "fr": "Le soir, les rues animées de la métropole sont inondées par le <w>néon</w> froid des vitrines et des restaurants."
                            }
                        },
                        {
                            "text": "Разноцветный <w>неон</w> ночного клуба привлекал внимание прохожих издалека.",
                            "target_lang_translations": {
                                "fr": "Le <w>néon</w> multicolore de la boîte de nuit attirait de loin l'attention des passants."
                            }
                        }
                    ],
                    "common_phrases": [
                        "яркий неон",
                        "холодный неон",
                        "неон вывесок"
                    ],
                    "target_lang_definitions": {
                        "fr": "Lumière vive ou éclairage produit par des tubes ou des enseignes au néon"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "néon",
                                "target_lang_sense_clarification": "lumière d'un néon"
                            },
                            {
                                "target_lang_word": "lumière de néon",
                                "target_lang_sense_clarification": "éclairage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e11287-8ecd-32c8-a6f2-f81e84634e56",
                    "sense_definition": "Неоновая лампа или трубка для световой рекламы",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер заменил старый повреждённый <w>неон</w> в наружной рекламе магазина.",
                            "target_lang_translations": {
                                "fr": "Le réparateur a remplacé le vieux <w>néon</w> endommagé de l'enseigne extérieure du magasin."
                            }
                        },
                        {
                            "text": "В оформлении стильной вывески дизайнер решил использовать гибкий <w>неон</w>.",
                            "target_lang_translations": {
                                "fr": "Pour concevoir une enseigne élégante, le designer a décidé d'utiliser du <w>néon flexible</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "неонка"
                    ],
                    "common_phrases": [
                        "гибкий неон"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное сокращение"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Tube fluorescent ou enseigne lumineuse servant à l'éclairage ou à la publicité"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "néon",
                                "target_lang_sense_clarification": "tube ou enseigne lumineuse"
                            },
                            {
                                "target_lang_word": "tube néon",
                                "target_lang_sense_clarification": "tube luminescent"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3171c3bc-8c34-39a7-bab8-d88367d58352",
                    "sense_definition": "Маленькая яркая пресноводная рыбка, популярная у аквариумистов",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стайка маленьких голубых <w>неонов</w> красиво плавает между зелёными растениями.",
                            "target_lang_translations": {
                                "fr": "Un banc de petits <w>néons</w> bleus nage gracieusement parmi les plantes vertes."
                            }
                        },
                        {
                            "text": "Для нового аквариума мы решили купить несколько ярких <w>неонов</w>.",
                            "target_lang_translations": {
                                "fr": "Pour le nouvel aquarium, nous avons décidé d'acheter quelques <w>néons</w> éclatants."
                            }
                        }
                    ],
                    "common_phrases": [
                        "голубой неон",
                        "стайка неонов"
                    ],
                    "target_lang_definitions": {
                        "fr": "Petit poisson d'eau douce aux couleurs vives et irisées, très populaire en aquariophilie"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "néon",
                                "target_lang_sense_clarification": "poisson d'aquarium"
                            },
                            {
                                "target_lang_word": "tétra néon",
                                "target_lang_sense_clarification": "espèce de poisson"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bad5b5a-c445-32d9-aa8b-ce12552c51a5",
                    "sense_definition": "Химический элемент, инертный одноатомный газ без цвета и запаха",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В периодической таблице Менделеева <w>неон</w> обозначается символом Ne.",
                            "target_lang_translations": {
                                "fr": "Dans le tableau périodique de Mendeleïev, le <w>néon</w> est désigné par le symbole Ne."
                            }
                        },
                        {
                            "text": "Благородный газ <w>неон</w> практически не вступает в реакции с другими веществами.",
                            "target_lang_translations": {
                                "fr": "Le gaz noble qu'est le <w>néon</w> ne réagit presque pas avec d'autres substances."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ne"
                    ],
                    "common_phrases": [
                        "инертный газ неон"
                    ],
                    "target_lang_definitions": {
                        "fr": "Élément chimique (gaz rare ou noble), incolore, inodore et monoatomique, de symbole Ne"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "néon",
                                "target_lang_sense_clarification": "élément chimique, gaz noble"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}