                            "straalvinnigen"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6192d72f-30c0-48bc-ac86-72e86d8ce5b8",
                        "source_entry_id": "543d15c8-a88e-3145-98c7-6ec195bbd1ca",
                        "source_sense_id": "b55a3cc4-8425-3ee3-9cf0-9676265895e5",
                        "source_sense_description": "bepaald soort zoetwaterroofvis, Sander lucioperca",
                        "target_lang_word": "Zander",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                        "entry_id": "6899381c-0a92-3cdf-9f84-175b3c77a72f",
                                        "glosses": [
                                            "im Süßwasser lebender Raubfisch aus der Familie der Barsche, Speisefisch"
                                        ],
                                        "tags": [
                                            "Ichthyologie",
                                            "Fischwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b67c9683-d345-4fb0-831e-89938a1aeb72",
                                                "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                                "text": "Der Zander frisst vorwiegend Kleinfische."
                                            },
                                            {
                                                "example_id": "b413929b-651e-475a-a682-b26e978e1450",
                                                "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                                "text": "„Im Handel wird der Zander frisch, ganz oder als Filet angeboten - zunehmend auch gefrostet.“"
                                            },
                                            {
                                                "example_id": "453ad6cd-da5c-4c44-a723-bce3f3cc6179",
                                                "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                                "text": "„Barsche zuckten vor uns zur Seite; wir stöberten große Döbel auf, Karpfen, Schleie, hier und da einen Hecht oder sehr selten einen stattlichen Zander.“"
                                            },
                                            {
                                                "example_id": "aa361d7b-dd42-4e1d-8467-8ab48a916e69",
                                                "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                                "text": "„Die Zander sehen aus wie Mumien, gelblich-grün, mit gezackter Rückenflosse kreuzen sie durchs Wasser.“"
                                            },
                                            {
                                                "example_id": "534a6073-9476-4155-8f62-93e413f97db4",
                                                "sense_id": "f512d5fe-fe23-3f0b-b89d-b0b5f11d004c",
                                                "text": "„Sie liefern den unvergleichlichen Zander.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f26a4adf-6dfd-3921-9d1a-e4b632665592",
                                        "entry_id": "d2bf5318-bba8-3f8f-8f4f-dc733d905865",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fb1504f-b125-4b1d-872c-238f783abc23",
                                                "sense_id": "f26a4adf-6dfd-3921-9d1a-e4b632665592",
                                                "text": "Beim Essen verzichtet Zander auf den Nachtisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zander",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                        "entry_id": "b04eb8bc-c9be-3eae-8d09-905f4bda0c26",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b76dbcf3-f028-4dca-b801-4f69f515df04",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Zander kommt und geht."
                                            },
                                            {
                                                "example_id": "4f35461e-b177-47a5-9193-09b86d2e0a67",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Zanders kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "554e30e0-4351-453e-8878-db94faa47682",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Der Zander trägt nie die Pullover, die die Zander ihm strickt."
                                            },
                                            {
                                                "example_id": "de7dd4a7-3ccb-429f-bbcc-8a31f94484cc",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zander kommt, geht der Herr Zander.“"
                                            },
                                            {
                                                "example_id": "1934d430-2bd8-450b-bb33-0d3acaf44408",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Frau Zander ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "1b26c4e8-ae8b-43a8-aeaf-d40c14fae786",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Herr Zander wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "0b805fd3-d30a-43a7-af98-dfd8f9c18a40",
                                                "sense_id": "9882f7bb-54ae-3d27-b7eb-cea14270a4c3",
                                                "text": "Die Zanders fliegen heute nach Sri Lanka."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
