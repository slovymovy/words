                        "glosses": [
                            "Enzyme qui oxyde un substrat par le transfert d'un ou plusieurs ions (H+) à un accepteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21570dd8-cdca-47d1-bf3d-e1e06bc8d7af",
                                "sense_id": "540d8193-bf60-3ed3-99e9-88024a13dee9",
                                "text": "En histochimie, les oxydases se distinguent nettement des déshydrogénases du point de vue purement opérationnel, parce qu’elles sont révélées par des réactifs chromogéniques différents."
                            }
                        ]
                    }
