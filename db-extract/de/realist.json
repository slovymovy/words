                ],
                "senses": [
                    {
                        "sense_id": "395532e9-0b19-3ee6-adf7-9ce3d38df90a",
                        "entry_id": "6a7ffa04-1b8f-32d4-a79d-0d563aa66a57",
                        "glosses": [
                            "Réaliste : partisan du réalisme, orienté sur la réalité concrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dfbed97-94b5-45e4-a987-b509f2eba887",
                                "sense_id": "395532e9-0b19-3ee6-adf7-9ce3d38df90a",
                                "text": "Ich bin ein Realist: An solche Fabeln glaube ich nicht!",
                                "translation": "Je suis un réaliste : je ne crois pas à de telles fables !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4a5a4a3-0926-3a9c-95fe-e85a29e92bd4",
                        "entry_id": "6a7ffa04-1b8f-32d4-a79d-0d563aa66a57",
                        "glosses": [
                            "Réaliste : adepte du réalisme, mouvement artistique."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "380ac77e-2384-4702-99ca-8bb268e83414",
                                "sense_id": "e4a5a4a3-0926-3a9c-95fe-e85a29e92bd4",
                                "text": "Für die Realisten steht nicht die Masse der Gesellschaft im Vordergrund, sondern die einzelne Persönlichkeit in ihrer gesellschaftlichen Prägung.",
                                "translation": "Pour les réalistes, ce n’est pas la masse de la société qui est au premier plan, mais l’individu dans son moule sociétal."
                            }
                        ]
                    }
                ],
