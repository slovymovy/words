                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>crooked</w> his finger to signal for me to come closer.",
                            "target_lang_translations": {
                                "de": "Er <w>krümmte</w> seinen Finger, um mir zu signalisieren, dass ich näher kommen sollte.",
                                "es": "Él <w>dobló</w> su dedo para hacerme señas de que me acercara.",
                                "it": "Ha <w>piegato</w> il dito per farmi segno di avvicinarmi.",
                                "fr": "Il a <w>tordu</w> son doigt pour me faire signe de m'approcher."
                            }
