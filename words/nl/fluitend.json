                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb to whistle."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whistling",
                                "target_lang_sense_clarification": "producing a tune or sound with one's lips"
                            }
                        ]
                    }
                }
            ]
        }
    ]
