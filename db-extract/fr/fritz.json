            {
                "entry_id": "79aaed8f-1b54-3a0f-8e1d-835d321a30fa",
                "word": "fritz",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71c25328-abd6-3e57-bd8f-30de254d0dd3",
                        "entry_id": "79aaed8f-1b54-3a0f-8e1d-835d321a30fa",
                        "glosses": [
                            "Allemand et en particulier soldat allemand, sobriquet employé depuis la Première Guerre Mondiale."
                        ],
                        "tags": [
                            "dated",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "8771db41-a4bb-4323-9d81-a8fc07962aa3",
                                "sense_id": "71c25328-abd6-3e57-bd8f-30de254d0dd3",
                                "text": "Derrière la troisième tranchée allemande, sur la crête, je m’amuse à regarder les fritz faire l’exercice."
                            },
                            {
                                "example_id": "b4e63a8e-e5d6-4528-95f8-2dab73b44be7",
                                "sense_id": "71c25328-abd6-3e57-bd8f-30de254d0dd3",
                                "text": "— Ça se calme, dit Tigeaine. Quand j’entrai dans notre taule, y avait des avions qui bagarraient… Des fritz et des canadiens… Une vingtaine…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30152794-3409-445b-a5d2-9f36bc4d804f",
                        "source_entry_id": "79aaed8f-1b54-3a0f-8e1d-835d321a30fa",
                        "source_sense_id": "71c25328-abd6-3e57-bd8f-30de254d0dd3",
                        "target_lang_word": "Kraut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kraut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19b51a98-57b6-3f5e-b334-07fd6732ab98",
                                        "entry_id": "2d87a250-d91e-32c7-a720-d48284e0cc80",
                                        "glosses": [
                                            "A German."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "offensive",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e21df1f-738e-4a51-b7b0-ae4acc4c917e",
                                                "sense_id": "19b51a98-57b6-3f5e-b334-07fd6732ab98",
                                                "text": "Those Krauts can't hurt you anymore. The only ones left are dead or dying."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1238095-fa87-4926-a3a5-f3dba382dd01",
                        "source_entry_id": "79aaed8f-1b54-3a0f-8e1d-835d321a30fa",
                        "source_sense_id": "71c25328-abd6-3e57-bd8f-30de254d0dd3",
