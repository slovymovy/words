                    {
                        "translation_id": "e6da639f-0051-4491-832c-98f77a94b5ef",
                        "source_entry_id": "d6058385-a1f3-332b-afe7-501253595105",
                        "source_sense_id": "7468af56-f203-3a79-8cc6-8389b0319209",
                        "source_sense_description": "characterized by scurf, scabby",
                        "target_lang_word": "verkrustet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verkrustet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60219330-9bd8-3672-b765-6fcef1308aa9",
                                        "entry_id": "583c3648-95a9-335c-bfc2-92906905af7c",
                                        "glosses": [
                                            "(beispielsweise bezogen auf Haut, Erde) von einer vertrockneten, harten Kruste bedeckt sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538844f0-fdc3-4cff-b763-5e62b2ee9e4f",
                                                "sense_id": "60219330-9bd8-3672-b765-6fcef1308aa9",
                                                "text": "„Wir müssen deine verkrustete Wunde am Knie mal säubern!“"
                                            },
                                            {
                                                "example_id": "f5f10db8-3d73-4abe-80c9-5eed85b32c34",
                                                "sense_id": "60219330-9bd8-3672-b765-6fcef1308aa9",
                                                "text": "Der Arzt versorgte als erstes die Nase mit dem verkrusteten Blut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2dc4ddc4-81c9-382e-aa8e-4abf43989e45",
                                        "entry_id": "583c3648-95a9-335c-bfc2-92906905af7c",
                                        "glosses": [
                                            "ohne die Fähigkeit, sich zu verändern und an veränderte Bedingungen anzupassen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "500ec856-573f-4909-a17b-221d96db607d",
                                                "sense_id": "2dc4ddc4-81c9-382e-aa8e-4abf43989e45",
                                                "text": "Früher galt die deutsche Wirtschaft als überreguliert, verkrustet und unflexibel."
                                            },
                                            {
                                                "example_id": "024a1963-362d-4ae3-96dd-aa8bfe21d340",
                                                "sense_id": "2dc4ddc4-81c9-382e-aa8e-4abf43989e45",
                                                "text": "[…] jetzt hat der US-Präsident gestern in dieser Rede auch die UNO-Bürokratie kritisiert […] und die verkrusteten Strukturen."
                                            },
                                            {
                                                "example_id": "41a1caf2-7aa6-4989-b04a-df4ffb3f72ad",
                                                "sense_id": "2dc4ddc4-81c9-382e-aa8e-4abf43989e45",
                                                "text": "[… Eine] Minderheitsregierung würde ein „völlig verkrustetes, veraltetes System“ aufbrechen, so Clement. Eine Regierung mit offenen Mehrheiten würde neue Gesichter und neue Themen auf die Agenda bringen."
                                            },
                                            {
                                                "example_id": "b1b8bae5-4c9a-4b17-a29e-63dc908e178e",
                                                "sense_id": "2dc4ddc4-81c9-382e-aa8e-4abf43989e45",
                                                "text": "Italien will die nun geforderten Reformen im Eiltempo verabschieden – nachdem sie jahrzehntelang aufgeschoben wurden. Die italienische Wirtschaft schrumpft, die Exporte sinken, das System ist verkrustet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
