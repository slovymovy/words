                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c29560d-61f9-44db-9371-d470146a7d88",
                                                "sense_id": "05eb6c79-de0d-3c86-9299-90a31db5e631",
                                                "text": "Les 2700 tonnes de sels débarquées, à Blainville-sur-Orne, d’un vraquier en provenance de Sardaigne étaient très attendues."
                                            },
                                            {
                                                "example_id": "90a7d146-07ee-482d-8866-70d8a38dfdaa",
                                                "sense_id": "05eb6c79-de0d-3c86-9299-90a31db5e631",
                                                "text": "L'imposant vraquier Federal Crimson est entré en collision avec la poupe du brise-glace Pierre Radisson, samedi à Québec."
                                            },
                                            {
                                                "example_id": "6466efdd-660e-412c-8c3b-634c0ef11f54",
                                                "sense_id": "05eb6c79-de0d-3c86-9299-90a31db5e631",
                                                "text": "C’est un vraquier à double coque, donc qui est extrêmement sécuritaire, a-t-il fait valoir, en soulignant qu’aucune pollution n’a été signalée."
                                            },
                                            {
                                                "example_id": "c32709a6-eafe-47df-8bf6-67102cad222e",
                                                "sense_id": "05eb6c79-de0d-3c86-9299-90a31db5e631",
                                                "text": "Un vraquier plutôt petit dans sa catégorie, mais énorme à mes yeux."
                                            }
                                        ]
