                "senses": [
                    {
                        "sense_id": "c127e552-ded5-3244-a1da-b76e5dd93ecf",
                        "entry_id": "929b1d7c-579e-3908-b0c4-714041ca10f8",
                        "glosses": [
                            "Verkaufsfläche für Käseprodukte"
