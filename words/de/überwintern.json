                {
                    "sense_id": "d0ce8b94-1c02-3a19-994d-5dc5af94c016",
                    "sense_definition": "Pflanzen oder Gegenstände über den Winter an einem geschützten Ort aufbewahren und pflegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "aufbewahren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Empfindliche Topfpflanzen sollte man rechtzeitig ins Haus holen und an einem hellen Ort <w>überwintern</w>."
                        },
                        {
                            "text": "Der Gärtner <w>überwintert</w> die exotischen Blumen im kühlen Keller, damit sie im Frühjahr wieder austreiben."
