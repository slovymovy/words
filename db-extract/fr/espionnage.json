        "fr-extract.jsonl": [
            {
                "entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
                "word": "espionnage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d1787052-5768-42fb-825d-1c4a831f34ab",
                        "entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
                        "tags": [
                            "plural"
                        ],
                        "form": "espionnages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                        "entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
                        "glosses": [
                            "Action d’espionner, d'utiliser un ou des espions ; métier d’espion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52c0a6d4-53a7-4ac6-97b0-9219b14fafdd",
                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                "text": "Il déroulait les curiosités, dépistait les espionnages, se servant de ses amis, sans qu'ils se doutassent du rôle qu'il leur faisait jouer."
                            },
                            {
                                "example_id": "f7a90c4b-e25a-44ca-8c94-5c98cfc7c7fb",
                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                "text": "Je venais de me dire, en effet, que ma poursuite était tout à fait incorrecte et que la façon d’espionnage à laquelle je me livrais était indigne de moi."
                            },
                            {
                                "example_id": "ada5c23f-c92a-471d-8d1a-de5957d416a3",
                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                "text": "Deux jours après, je passai devant le conseil de guerre, qui, après plaidoirie d'un avoué allemand, me condamna à mort pour espionnage […]."
                            },
                            {
                                "example_id": "c69c3750-6551-43e9-9263-630779377856",
                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                "text": "Mais cette scolastique de l’espionnage, et la méthode si raisonnable des recoupements, enivrent ceux qui y participent, et encore plus ceux qui les ont inventées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6a5159d-23a9-46d4-bbff-68b780eb66ad",
                        "source_entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
                        "source_sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                        "target_lang_word": "Spionage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spionage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                        "entry_id": "0f7f9214-be27-3954-a0aa-a1509c8894df",
                                        "glosses": [
                                            "Beschaffung von geheimen Informationen von fremdem Organisationen, Staaten oder dergleichen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e49bd59-fc45-4015-b20c-f7cd7592d789",
                                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                                "text": "„In Turin wird der weltberühmte italienische Fallschirmspringer Giorgio Rinaldi unter dem Verdacht der Spionage festgenommen.“"
                                            },
                                            {
                                                "example_id": "9377055b-df55-45df-8e73-8ffc85903f5f",
                                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                                "text": "„In Norwegen wurden Jahnn und Harms der Spionage verdächtigt.“"
                                            },
                                            {
                                                "example_id": "f7d5d3e7-e54f-424f-8f65-97a7697a31c4",
                                                "sense_id": "9203a7d9-f47a-3802-86be-eda692182acf",
                                                "text": "„Martha Dodd kehrt 1937 in die USA zurück, zusammen mit ihrem deprimierten und desillusionierten Vater, und gerät noch während des Kriegs in den Verdacht der Spionage für die Sowjetunion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c009d8-d68a-411a-8683-54a6cf4dc01a",
                        "source_entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
