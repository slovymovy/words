                "senses": [
                    {
                        "sense_id": "2b272b95-6e0e-3aeb-9dbf-b3ccc4662fe3",
                        "entry_id": "a4252a70-c003-3d6f-86eb-53f21108c697",
                        "glosses": [
                            "Donner une origine ou un caractère yéménite à (quelque chose ou quelqu’un)."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3c95c029-0b94-45a8-9175-c1b24662da6e",
                                "sense_id": "2b272b95-6e0e-3aeb-9dbf-b3ccc4662fe3",
                                "text": "La tentative impérialiste pour « yéméniser » le conflit a échoué."
                            },
                            {
                                "example_id": "73eb2133-3672-4fd7-863c-7c51254315ae",
                                "sense_id": "2b272b95-6e0e-3aeb-9dbf-b3ccc4662fe3",
                                "text": "Contrairement à leurs prédécesseurs, ils se laissent « yéméniser ». Malgré leur origine turkmène, ils se forgent une généalogie yéménite, en rattachant leur branche à la glorieuse souche des ghassanides."
                            },
                            {
                                "example_id": "78558a0b-4ac3-49a0-98ab-32c7c863fbe7",
                                "sense_id": "2b272b95-6e0e-3aeb-9dbf-b3ccc4662fe3",
                                "text": "Toutefois, l’uniformisation de la production et la domination qu’elle implique n’aboutissent pas à une disparition des référents construits comme proprement locaux. Un angle important consiste ainsi à « yéméniser » des productions venues d’ailleurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b733a91-a8ba-4cac-88f1-0e6e14d78466",
                        "source_entry_id": "a4252a70-c003-3d6f-86eb-53f21108c697",
                        "source_sense_id": "2b272b95-6e0e-3aeb-9dbf-b3ccc4662fe3",
                        "target_lang_word": "Yemenize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yemenize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acdb4f7f-3a76-3fe2-9b83-50dfa432d591",
                                        "entry_id": "9b2f92b8-fb1b-31c3-a5b5-01c3d2f3903c",
                                        "glosses": [
                                            "To make Yemeni."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890285e9-e6eb-43a1-b708-b293f2bf7104",
                                                "sense_id": "acdb4f7f-3a76-3fe2-9b83-50dfa432d591",
                                                "text": "1982, Abdul Rahman al-Haddad, Unesco, Cultural Policy in the Yemen Arab Republic, United Nations Educational\nThe most difficult problem that faced the revolution in expanding schools and developing education, however, was the problem of Yemenizing curricula and training qualified teachers."
                                            },
                                            {
                                                "example_id": "8dd5d79f-b7a6-4643-ace6-9a339b9476e8",
                                                "sense_id": "acdb4f7f-3a76-3fe2-9b83-50dfa432d591",
                                                "text": "To what extent is the project likely to provide results useful in the effort to Yemenize the teacher corps?"
                                            },
                                            {
                                                "example_id": "3940b7c8-6a14-4fe2-bebd-ce00322bd351",
                                                "sense_id": "acdb4f7f-3a76-3fe2-9b83-50dfa432d591",
                                                "text": "This output would be insufficient to Yemenize the preparatory and secondary teaching force by the end of the decade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
