                        "glosses": [
                            "En un sens distributif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d83acaa-8799-4410-af8a-8b9f62f88bc9",
                                "sense_id": "4a8200bb-3e66-38ab-90ac-b04cc481c5c0",
                                "text": "Que la connaissance de ces procès appartienne distributivement, savoir est à nostre cour de parlement pour ce qui concerne la police, et à nos dits élus pour ce qui concerne la perception."
                            },
                            {
                                "example_id": "c9ec2ae8-c6e8-40b0-b39b-1265b052712d",
                                "sense_id": "4a8200bb-3e66-38ab-90ac-b04cc481c5c0",
                                "text": "Si les genres et les espèces existent distributivement chez tous les individus d'une même espèce, comment concilier l'unité numérique de l'être individuel avec les formes substantielles qui s'emboitent en lui comme un jeu de poupées japonaises ?"
                            }
                        ]
                    }
