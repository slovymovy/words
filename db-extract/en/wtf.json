                                "example_id": "9fc50997-bcc3-4cb8-b78e-8b47b3b1e00e",
                                "sense_id": "2517bf82-22da-3d30-b6f4-6ef81cc8602b",
                                "text": "WTF are you on about? We played some very good football for most of the match, …",
                                "translation": "Usenet"
                            }
                        ]
                    },
