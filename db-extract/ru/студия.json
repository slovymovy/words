                        "form": "сту́дии"
                    },
                    {
                        "form_id": "b4dc5f1c-c8cc-411c-be14-4e7f80faa981",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "сту́диях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd2d504f-1b95-36c7-a534-3e6aec262df5",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "мастерская художника или скульптора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cef4ef5-35ad-4bc5-ae6b-e6a068f7b4d9",
                                "sense_id": "cd2d504f-1b95-36c7-a534-3e6aec262df5",
                                "text": "Утро он работал в студии над большою картиной."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef487971-aa56-30a4-93bf-2cc64bed81ed",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "специально оборудованное помещение, откуда ведутся радио- и телепередачи, где производятся съёмки кинофильмов и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3319595d-e21b-36c3-8635-1d6bcf7613f4",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "компания, занимающаяся производством кинопродукции, аудиопродукции и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c482ab-78a1-4237-8a84-12ef7a1d96b4",
                                "sense_id": "3319595d-e21b-36c3-8635-1d6bcf7613f4",
                                "text": "Американская ассоциация кинопроизводителей объединяет крупнейшие студии Голливуда, в том числе Warner Brothers, Twentieth Century Fox и Walt Disney."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2d636fa-501b-32d8-8521-9260f2e35b5d",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "школа, готовящая художников, скульпторов, актёров и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "506b6295-62c4-46f3-8074-17b7c38c317c",
                                "sense_id": "d2d636fa-501b-32d8-8521-9260f2e35b5d",
                                "text": "Тогда в Киеве при Союзе писателей существовала литературная студия, которую вел прозаик и драматург Дмитрий Урин."
                            }
                        ]
                    },
                    {
                        "sense_id": "930f1772-d903-3349-8718-8c8573e6f3a4",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "театральный коллектив (обычно молодых актёров), сочетающий учебный процесс и постановку спектаклей"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69da4435-0483-3627-b77b-625ba968d406",
                        "entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "glosses": [
                            "квартира, в которой жилое помещение, спальня и кухня располагаются в одной комнате"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf7aaf3-de92-434c-aff3-a13b38c4c8cd",
                                "sense_id": "69da4435-0483-3627-b77b-625ba968d406",
                                "text": "А с последнего этажа можно пробить люк на чердак и там сделать в мансарде студию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0363f6e-76ab-4a1f-9b88-a1b725b58013",
                        "source_entry_id": "fd60eb7b-80f3-3175-a275-b88e6ef6cf5e",
                        "source_sense_description": "спец. помещение, откуда ведутся радио- и телепередачи, где производятся съёмки фильмов",
                        "target_lang_word": "studio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "studio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An artist’s or photographer’s workshop or the room in which an artist works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae716b34-e328-4b2e-8954-92a5d5f7bccd",
                                                "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                                "text": "His studio was cramped when he began as an artist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An establishment where an art is taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61d982f-0191-49a0-97f0-617506bdb573",
                                                "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                                "text": "As he gained a reputation, he took larger space and took students into his studio,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A place where radio or television programs, records or films are made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bf6f4f-6370-421d-b18b-4596593ee1a4",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The recording studio had some slight echo, but was good enough to make a demo."
                                            },
                                            {
                                                "example_id": "631d0afd-713c-4ff6-a1a7-dfbf20daea60",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The studio was dark and cool, with thick cords running from one end to the other and huge cameras on either side, each primed to swivel and record what the lights from above illuminated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A company or organization that makes films, records or other artistic works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4507543-b4af-4928-bb57-a20c876f2a56",
                                                "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                                "text": "The studios still make films, but they rely on the strength of their distribution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A studio apartment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee61de42-7a79-45d1-8bbd-09699b5af2e1",
                                                "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                                "text": "It’s a lovely little studio with almost a river view."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
