            {
                "entry_id": "854c3106-64b6-3352-ad4e-8f5c679c5402",
                "word": "bobettes",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd18e892-cf82-3310-b99a-ec33b8f318d6",
                        "entry_id": "854c3106-64b6-3352-ad4e-8f5c679c5402",
                        "glosses": [
                            "Sous-vêtements d’homme ou petite culotte de femme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "33407a4d-a315-477f-91a7-36edd958bdc0",
                                "sense_id": "fd18e892-cf82-3310-b99a-ec33b8f318d6",
                                "text": "Je constate qu’on nous incitera sous peu à trouver parfaitement normal qu’on inspecte nos bobettes à l’aérogare."
                            },
                            {
                                "example_id": "2429e892-3cc9-46b1-9801-1f65f6f8047c",
                                "sense_id": "fd18e892-cf82-3310-b99a-ec33b8f318d6",
                                "text": "La caméra s’arrête longuement sur le corps superbe du héros mettant son chandail, dormant en bobettes, dardant sa prunelle incendiaire sur les femmes pâmées, jouant du beau biceps."
                            },
                            {
                                "example_id": "75e53b27-c09b-41ad-bf56-3ec888b52a10",
                                "sense_id": "fd18e892-cf82-3310-b99a-ec33b8f318d6",
                                "text": "Ils causaient du métier de libraire, se disaient traités comme des vendeurs de bobettes plutôt que comme des émissaires de culture."
                            },
                            {
                                "example_id": "a8bd9679-91b4-4b3a-bfae-f6a61b303b19",
                                "sense_id": "fd18e892-cf82-3310-b99a-ec33b8f318d6",
                                "text": "Nous avons demandé à des lectrices qui n’ont pas des corps de mannequin de poser en bobettes. C’était très touchant. Nous étions très fières de ce numéro. Mais il s’est très mal vendu!"
                            }
                        ]
                    }
                ],
