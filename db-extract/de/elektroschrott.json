                        "cross_references": [
                            {
                                "target_word": "e-waste",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b271d814-3fef-3e98-9657-8d453bf42a60",
                                        "entry_id": "abc4de39-7c29-38c1-86d1-a101b9f28508",
                                        "glosses": [
                                            "Discarded electrical and electronic equipment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33f89f5b-1bd3-41a9-8122-fbb889468db5",
                                                "sense_id": "b271d814-3fef-3e98-9657-8d453bf42a60",
                                                "text": "Following up news articles and e-mails from mainland China, BAN was directed to an e-waste processing area known as Guiyu on the Longdong River near the city of Shantou in the northeast [of] Guangdong Province, four hours by car from Hong Kong. In the course of three intensive days in and around Guiyu's four villages, the small investigative team witnessed firsthand what passes for recycling of e-waste in Asia."
                                            },
                                            {
                                                "example_id": "2bba43f3-1148-40d7-acbd-adf1cd1cd791",
                                                "sense_id": "b271d814-3fef-3e98-9657-8d453bf42a60",
                                                "text": "In June of last year, the Thai Ministry of Industry announced with great fanfare the ban on foreign e-waste. The police made a series of high-profile raids on at least 10 factories, including New Sky Metal."
                                            }
                                        ]
                                    }
                                ]
