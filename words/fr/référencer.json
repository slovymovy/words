                {
                    "sense_id": "fba3ff82-274e-3a79-a022-42d5289df754",
                    "sense_definition": "Inscrire un produit ou un fournisseur dans un catalogue, une base de données ou un point de vente.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le supermarché refuse de <w>référencer</w> cette nouvelle marque de céréales bio."
                        },
                        {
                            "text": "Cette librairie en ligne a choisi de <w>référencer</w> tous les livres récents de cet auteur."
                        }
                    ],
                    "antonyms": [
                        "déréférencer"
                    ],
                    "common_phrases": [
                        "référencer un produit",
                        "référencer un nouveau fournisseur",
                        "être référencé en magasin"
                    ]
                },
                {
                    "sense_id": "db482f84-aaf8-3344-a333-58732d62a0c5",
                    "sense_definition": "Pourvoir une affirmation, un fait ou un document d'une source ou d'une référence précise pour en vérifier l'exactitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "documentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant doit impérativement <w>référencer</w> chaque citation dans son mémoire universitaire."
                        },
                        {
                            "text": "Vous devez <w>référencer</w> les sources utilisées pour garantir la fiabilité de cet article."
                        }
                    ],
                    "common_phrases": [
                        "référencer une source",
                        "référencer ses citations"
                    ]
                },
                {
                    "sense_id": "1f4f038b-6373-355e-8c3f-a0f9820cfc95",
                    "sense_definition": "Évaluer ou comparer des pratiques par rapport à un ou plusieurs modèles reconnus dans un secteur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour améliorer ses performances, l'entreprise souhaite se <w>référencer</w> aux leaders mondiaux du secteur."
                        },
                        {
                            "text": "La direction cherche à <w>référencer</w> ses méthodes de travail sur les standards internationaux."
