                        "examples": [
                            {
                                "example_id": "14c13956-3749-46d6-9da7-7e7dec2f0a7b",
                                "sense_id": "fab45327-4782-3786-b18c-873aa8584077",
                                "text": "„Zur Unterstützung der Minimumlüftung in Gewächshäusern, Geflügel- und Schweineställen bietet Vostermans Ventilation den Multifan Casing Fan 92 an.“"
                            },
                            {
