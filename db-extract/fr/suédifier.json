                ],
                "senses": [
                    {
                        "sense_id": "6d9e0291-0092-36ba-abab-dc658b52268e",
                        "entry_id": "b86e9d8f-f102-3006-ad57-a7154353383f",
                        "glosses": [
                            "Donner un caractère suédois à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "392d16f3-3138-4ed6-9146-0f8d203d279f",
                                "sense_id": "6d9e0291-0092-36ba-abab-dc658b52268e",
                                "text": "Enfin c’est lui qui est forcé de s’accommoder à la vie laponne au lieu d’amener les enfants aux mœurs de la civilisation, au lieu de les suédifier, si on peut parler ainsi."
                            },
                            {
                                "example_id": "9ceed6cc-9828-4a7a-9324-c031824b15e4",
                                "sense_id": "6d9e0291-0092-36ba-abab-dc658b52268e",
                                "text": "Bien que le pays ait joui d’une certaine autonomie, la tendance constante de la Suède était de suédifier le pays; les intellectuels étaient devenus de vrais Suédois et la langue scandinave repoussait de plus en plus l’idiome ougro-altaique des habitants."
                            },
                            {
                                "example_id": "2e4f2be2-60de-4418-b01d-f87d0631b4f0",
                                "sense_id": "6d9e0291-0092-36ba-abab-dc658b52268e",
                                "text": "Jadis, les deux groupes s’équilibraient : l’occupation suédoise avait « suédifié » fortement les Finnois."
                            }
                        ]
                    }
                ],
