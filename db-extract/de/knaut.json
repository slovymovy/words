                ],
                "senses": [
                    {
                        "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                        "entry_id": "882b9605-eb39-372c-9b32-06c35caa9e10",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed00e4be-a168-467b-84c0-1b4917b69e96",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Frau Knaut ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7fb4bab9-b44a-471a-bcd7-c673fcf9e19c",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Herr Knaut wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f931d85c-fb82-49e5-a481-40d40a2acb6c",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Die Knauts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "deaee861-c5a5-4a44-9d6f-e69f0e0293bd",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Der Knaut trägt nie die Schals, die die Knaut ihm strickt."
                            },
                            {
                                "example_id": "ebb0d69d-4dc0-43d5-8e44-52e3b1f5bb5f",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knaut kommt, geht der Herr Knaut.“"
                            },
                            {
                                "example_id": "cad357ea-b165-4413-b762-3fb532431867",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Knaut kommt und geht."
                            },
                            {
                                "example_id": "868c766d-b083-4da3-b187-383dce570b2f",
                                "sense_id": "f18646ba-6cc6-3483-8489-c06aff817279",
                                "text": "Knauts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
