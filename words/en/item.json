                    "synonyms": [
                        "article"
                    ],
                    "common_phrases": [
                        "news item",
                        "item of news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое новостное сообщение или статья в газете.",
                        "tr": "Bir gazetede yer alan kısa bir haber veya makale."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметка",
                                "target_lang_sense_clarification": "краткая статья"
                            },
                            {
                                "target_lang_word": "новость",
                                "target_lang_sense_clarification": "информационное сообщение"
                            },
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "информационный материал"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "haber",
                                "target_lang_sense_clarification": "kısa gazete haberi"
                            },
                            {
                                "target_lang_word": "yazı",
                                "target_lang_sense_clarification": "kısa haber metni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b502993d-d178-3f7d-951c-83d160815b9d",
                    "sense_definition": "Two people who are involved in a romantic relationship.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard that Jack and Jill are an <w>item</w> now.",
                            "target_lang_translations": {
                                "ru": "Я слышал, что Джек и Джилл теперь <w>пара</w>.",
                                "tr": "Jack ve Jill'in artık <w>sevgili</w> olduklarını duydum."
                            }
                        },
                        {
                            "text": "They have been an <w>item</w> for several months.",
                            "target_lang_translations": {
                                "ru": "Они уже несколько месяцев <w>пара</w>.",
                                "tr": "Aylardır <w>birlikteler</w>."
                            }
