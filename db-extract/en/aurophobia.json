                        "glosses": [
                            "The fear of gold; by extension, the fear of wealth."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "90e73cdc-4f4b-4fc1-88f2-a84505eb4087",
                                "sense_id": "e9e14282-c162-3fe8-81fe-3bfbd028568a",
                                "text": "If this be true, it certainly shows the power of suggestion, idiosyncrasy or aurophobia to an extent scarcely equaled by Mr. Bryan himself, who was said to be sorely distressed a short time ago on account of finding gold in his well."
                            },
                            {
                                "example_id": "09c3353c-56b8-4743-8bdc-18ed7d9074fb",
                                "sense_id": "e9e14282-c162-3fe8-81fe-3bfbd028568a",
                                "text": "Slaves are we then to a superstition — aurophobia — for there is never enough; fear of insecurity will not be remedied by any amount, whether counted in hundreds of thousands or millions."
                            },
                            {
                                "example_id": "09fc2e2d-a734-4a2c-a584-55ff2d0790be",
                                "sense_id": "e9e14282-c162-3fe8-81fe-3bfbd028568a",
                                "text": "The other main reason for the aurophobia that prevails in many quarters is that the monetary use of gold implies fixed parities, […]"
                            }
                        ]
