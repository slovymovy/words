                "senses": [
                    {
                        "sense_id": "d852c23b-81e0-3ecb-98cb-ca4f5eaeadc8",
                        "entry_id": "a9f68a65-9d4a-3f2a-b7d1-20fdd7e3a768",
                        "glosses": [
                            "Genre de tritons de grande taille, comprenant des espèces de la péninsule ibérique et du Maghreb."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb851b49-fe8c-4f15-acb2-7ef106c70ffd",
                                "sense_id": "d852c23b-81e0-3ecb-98cb-ca4f5eaeadc8",
                                "text": "Vogt, qui lors d’un voyage en Espagne a découvert un autre urodèle aquatique, le pleurodèle, encore mieux adapté à la vie en aquarium et dont les œufs sont plus gros que ceux du triton, imagine purement et simplement un système de tatouage cellulaire."
                            },
                            {
                                "example_id": "88f4fda8-d54a-4316-aebf-f8d9f4792f1a",
                                "sense_id": "d852c23b-81e0-3ecb-98cb-ca4f5eaeadc8",
                                "text": "A la différence des autres tritons, l’accouplement des pleurodèles se fait par enlacement des deux tritons."
                            },
                            {
                                "example_id": "6d604ec8-1160-4c27-a048-4720a05f2aa4",
                                "sense_id": "d852c23b-81e0-3ecb-98cb-ca4f5eaeadc8",
                                "text": "Les pleurodèles sont des animaux essentiellement aquatiques, qui sortent peu ou pas de l’eau."
                            },
                            {
                                "example_id": "d206f87b-ec33-4bf9-8dda-e8345c38e5cc",
                                "sense_id": "d852c23b-81e0-3ecb-98cb-ca4f5eaeadc8",
                                "text": "Les pleurodèles vivent aux abords de zones humides se cachant sous les pierres, dans des anfractuosités naturelles ou entre les racines des arbres. Au printemps ils rejoignent des ruisseaux à faible courant, prairies inondées, bassins où s’effectueront accouplements et pontes."
                            }
                        ]
                    }
                ],
