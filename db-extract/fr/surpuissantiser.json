                        "examples": [
                            {
                                "example_id": "ba28e6e4-3d99-4485-884c-6b11ee8520f4",
                                "sense_id": "c12b6637-2a77-394e-a744-cab1639be9be",
                                "text": "je pense que tu n'augmenteras pas la puissance du blank par le montage, et que pour jouer avec 80 ou 100 grs ça ne sert à rien de le surpuissantiser."
                            },
                            {
                                "example_id": "8790256c-2a90-42e3-9274-a2512030ca02",
                                "sense_id": "c12b6637-2a77-394e-a744-cab1639be9be",
                                "text": "Le temps de travail est carrément augmenté, et je dirais même plus: il est carrément augmenté... le but n'est pas de surpuissantiser les magiciens mais de rendre la magie de laboratoire plus intéressante... quitte à ne pas attirer les joueurs en quête de bonus."
                            }
                        ]
                    }
