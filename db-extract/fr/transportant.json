                        "entry_id": "bd604b6d-b0c9-323b-9858-6e9c9ba310a6",
                        "glosses": [
                            "Qui transporte l’esprit ou les sens, qui exalte."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "522d5a35-21e5-49f2-af89-98fc7c008b31",
                                "sense_id": "8ef9fa97-0ad5-3d3f-b1ce-c79c9213ef29",
                                "text": "L’orchestre répand ses airs légers, presque en sourdine pendant le spectacle, et sonores, excitants, transportants et à demi hystériques pendant les entr’actes."
                            },
                            {
                                "example_id": "e8a631df-7907-4857-8f99-9af750d0b23b",
                                "sense_id": "8ef9fa97-0ad5-3d3f-b1ce-c79c9213ef29",
                                "text": "[…] un jour, alors qu’une des sœurs bleues de Beaune, sous son hennin et son splendide habit du quinzième siècle, priait, agenouillée, les bras en croix, j’ai eu la transportante vision des anciens âges, mais l’arrivée de dévotes modernes […] m’a rejeté dans l’implacable dégoût de mon époque […]"
                            }
                        ]
                    }
