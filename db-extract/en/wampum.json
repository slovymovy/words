                                                "sense_id": "ace6a056-ab54-32b7-84ea-e43dcd5f81dd",
                                                "text": "„Klauen oder Stoßzähne geben Waffen oder Wampum ab.“"
                                            },
                                            {
                                                "example_id": "0a73425d-2d93-4b39-8536-005ebd67b572",
                                                "sense_id": "ace6a056-ab54-32b7-84ea-e43dcd5f81dd",
                                                "text": "„Die Anordnung der Schnüre, die Verteilung der Motive sowie die Farbauswahl dienen in diesen Wampums als Informationsträger.“"
                                            }
                                        ],
