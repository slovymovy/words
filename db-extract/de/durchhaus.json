                "senses": [
                    {
                        "sense_id": "ad073425-e118-3d40-8bda-ccceb706e96c",
                        "entry_id": "ad9c10cf-dd79-3e20-8436-004033eae5ae",
                        "glosses": [
                            "Gebäude, das zwei öffentliche Verkehrsflächen verbindet"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "186cfb41-7f95-449e-a8ad-889e84529c53",
                                "sense_id": "ad073425-e118-3d40-8bda-ccceb706e96c",
                                "text": "„Dieses Durchhaus wird bereits als Bad 1310 urkundlich erwähnt.“"
                            },
                            {
                                "example_id": "3dbcbde8-e0dd-4d2a-928b-9f62427e5128",
                                "sense_id": "ad073425-e118-3d40-8bda-ccceb706e96c",
                                "text": "„Im Parlament folgten die ‚typischen Klischeeanfragen‘, so ‚Die Presse‘ am 4. März 1978, samt dem Vorwurf, Benning ‚mache das Burgtheater zu einem Durchhaus für DDR-Theater und DDR-Regisseure‘; […]“"
                            },
                            {
                                "example_id": "459f79ef-ca64-410d-81f9-69d4bbc4f733",
                                "sense_id": "ad073425-e118-3d40-8bda-ccceb706e96c",
                                "text": "„Prag ist nicht gerade berühmt für seine Durchhäuser - wenige wissen von ihrer Existenz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
