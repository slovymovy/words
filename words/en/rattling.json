                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chrastící",
                                "target_lang_sense_clarification": "příčestí činné"
                            },
                            {
                                "target_lang_word": "drnčící",
                                "target_lang_sense_clarification": "příčestí činné"
                            }
