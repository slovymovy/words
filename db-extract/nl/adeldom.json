                "forms": [],
                "senses": [
                    {
                        "sense_id": "db1a189b-0c1b-3e33-9707-eebf92fa6493",
                        "entry_id": "6ad004ea-321d-32fb-83e8-4a4b0a46d263",
                        "glosses": [
                            "de groep van mensen die van edele afkomst is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc688a6-e5d9-4d9a-b32b-671575783644",
                                "sense_id": "db1a189b-0c1b-3e33-9707-eebf92fa6493",
                                "text": "- Hun hoge geboorte zit eigenlijk alleen nog in hun eigen hoofd. De drie zussen, gravinnen, niet jong maar nog lang niet bejaard, bewonen een afbladderend palazzo dat niet meer hun eigendom is. Hun decorum verviel tot zonderling gedrag. Alleen hun stijfhoofdig verlangen naar geluk verraadt nog hun adeldom. Een ‘nee’ accepteren? De zussen zouden niet weten hoe dat moet."
                            }
                        ]
                    },
                    {
                        "sense_id": "dee343f7-19bb-374b-9aa2-50bc374c9b69",
                        "entry_id": "6ad004ea-321d-32fb-83e8-4a4b0a46d263",
                        "glosses": [
                            "een edele aard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3888142-5fc7-4304-b6b8-cd9a1ac42db0",
                                "sense_id": "dee343f7-19bb-374b-9aa2-50bc374c9b69",
                                "text": "- Iemand met een natuurlijke adeldom die klassenloos was en die het afgelopen jaar bewees dat ze geen koninklijke titel nodig had om de magie te verspreiden waarop zij het patent had”, zei graaf Spencer. Daarmee een sneer gevend naar het koninklijk huis dat Diana bij haar scheiding de titel 'Koninklijke Hoogheid' had ontnomen."
                            }
                        ]
                    }
