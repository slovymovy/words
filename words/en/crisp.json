                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food_dessert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For dessert, we served warm apple <w>crisp</w> with vanilla ice cream.",
                            "target_lang_translations": {
                                "ru": "На десерт мы подали теплый яблочный <w>крисп</w> с ванильным мороженым.",
