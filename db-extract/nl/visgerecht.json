                        "examples": [
                            {
                                "example_id": "7bd1a084-4b80-43c9-9b6c-e1d7b8ee74b0",
                                "sense_id": "79d0dd29-7627-373d-baf1-5a80259ca52e",
                                "text": "Zij zei dat ze twijfelde tussen gepocheerde schol en zeetong meunière (het goedkoopste en het duurste visgerecht)."
                            },
                            {
                                "example_id": "81449594-6b5e-419a-bdf9-ecf8f60d93cc",
                                "sense_id": "79d0dd29-7627-373d-baf1-5a80259ca52e",
                                "text": "Zelfgemaakte pesto maak je in een handomdraai. In tegenstelling tot de klassieke pesto met basilicum, pijnboompitten en Parmezaanse kaas maken we deze versie met dille, walnoot en ricotta. Ideaal als dip bij een borrel of heerlijk om te verwerken in een visgerecht."
                            }
