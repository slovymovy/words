                            {
                                "target_word": "Hollywood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1951e84c-21ce-3476-9e43-36b7cdf4ac0a",
                                        "entry_id": "27bb05b0-d16c-355c-a5c9-1d9f2f98f62d",
                                        "glosses": [
                                            "Resembling or relating to the Hollywood movie industry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b210114-f997-43ab-8589-0a83ed2357af",
                                                "sense_id": "1951e84c-21ce-3476-9e43-36b7cdf4ac0a",
                                                "text": "What did they say when they shipped you away to fight somebody's Hollywood war?"
                                            },
                                            {
                                                "example_id": "ef32abc0-c87c-446e-b814-b8c22439a68f",
                                                "sense_id": "1951e84c-21ce-3476-9e43-36b7cdf4ac0a",
                                                "text": "As many critics pointed out, the timely (but mostly tame and light) comedy was not too controversial, but too popular, too American, and too Hollywood to headline a festival that was scheduled to screen the likes of Robert Bresson's Un Feme Douce, Jean-Luc Godard's Le Gai Savior, Eric Rohmer's My Night at Maud's, Agnes Varda's Lion's Love, Paola Pier Pasolini's Pigpen, and Bo Widenberg's Adelen '31."
                                            },
                                            {
                                                "example_id": "806e0c37-2279-448c-babe-c30d8fa66dff",
                                                "sense_id": "1951e84c-21ce-3476-9e43-36b7cdf4ac0a",
                                                "text": "The film is at once too Hollywood and too realistic. It is tied to genre conventions while stylistically following the new code of realism, especially with regard to mise-en-scène and performance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c93ff14e-f6d1-37b1-bd38-e34c656a7b62",
                                        "entry_id": "27bb05b0-d16c-355c-a5c9-1d9f2f98f62d",
                                        "glosses": [
                                            "Of or characteristic of a Hollywood film."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8391805e-88ce-471b-a837-c56a39bd35b6",
                                                "sense_id": "c93ff14e-f6d1-37b1-bd38-e34c656a7b62",
                                                "text": "A Time reporter called Reagan \"Hollywood handsome and remarkably youthful in appearance\", a candidate who had \"rattled political seismographs from coast to coast.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hollywood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46e008ff-e2cb-3f5b-bf4e-82665d659487",
                                        "entry_id": "67be8290-cb8b-343d-aca7-b3a11c2f1352",
                                        "glosses": [
                                            "A waxing practice that removes all of the pubic hair, unlike a Brazilian which leaves a small strip behind."
                                        ],
