                        ]
                    },
                    {
                        "translation_id": "09fd69d4-3920-493d-9723-5fcd1f0a55e6",
                        "source_entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "source_sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "target_lang_word": "irreprochável",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irreprochável",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2e7c99-ab29-324d-9648-d80369596b03",
                                        "entry_id": "67cac929-f0c8-309d-9d71-488ecbbbfdbf",
                                        "glosses": [
                                            "diz-se daquele que não merece reproches, castigos; perfeito, sem defeitos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2951f6fa-bc3a-4910-bfb7-c6ce3f3ce2b6",
                                                "sense_id": "3d2e7c99-ab29-324d-9648-d80369596b03",
                                                "text": "Aquele garoto é simplesmente irreprochável!"
                                            },
                                            {
                                                "example_id": "0cff9ae2-a962-43e0-ab47-39259030780d",
                                                "sense_id": "3d2e7c99-ab29-324d-9648-d80369596b03",
                                                "text": "Você foi irreprochável na sua apresentação"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47526674-04ab-480e-bb97-552a964b6f37",
                        "source_entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "source_sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "target_lang_word": "безупречный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безупречный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "067e4d22-3fbd-37be-adec-8cc6756ff7d4",
                                        "entry_id": "5077da37-01e2-3bf7-8fe6-afaba387f207",
                                        "glosses": [
                                            "не заслуживающий ни в чём упрёка, ничем не опороченный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcf277a2-d5a8-4bfb-a48e-ac0b6e552bd8",
                                                "sense_id": "067e4d22-3fbd-37be-adec-8cc6756ff7d4",
                                                "text": "Он не мог поверить, что эти крупные учёные, люди безупречной честности, научной добросовестности, могли оказаться вредителями, или проходимцами, или врагами народа."
                                            },
                                            {
                                                "example_id": "d9a61288-05ce-453a-aba3-470fb3db0a93",
                                                "sense_id": "067e4d22-3fbd-37be-adec-8cc6756ff7d4",
                                                "text": "Какие маленькие они в сравнении с этим провидцем-философом, безупречным общественным деятелем, чутким воспитателем, вдохновенным поэтом!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ca4e2ae-468d-4a0a-aa93-0df75a89304e",
                        "source_entry_id": "4e5ff205-e84e-329b-9eba-c95fceee9e07",
                        "source_sense_id": "80678dc3-66eb-387e-87e2-77f6efba1b6f",
                        "target_lang_word": "безукоризненный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "безукоризненный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ee7b567b-5abc-308c-8c31-4afb7b9cacb2",
                                        "entry_id": "bd6644d7-33de-3256-81b3-ad4b6f70ddd8",
                                        "glosses": [
                                            "не заслуживающий укора, порицания; безупречный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b618a9dd-32cf-4975-ba1e-8e49e108773f",
                                                "sense_id": "ee7b567b-5abc-308c-8c31-4afb7b9cacb2",
                                                "text": "Он и в деревне остаётся таким, каким был в Петербурге: безукоризненный чёрный костюм, победоносцевский профиль; властный, притягательный, моложавый."
                                            },
                                            {
                                                "example_id": "314b7899-cc4c-49c2-921a-8d4454dd1c20",
                                                "sense_id": "ee7b567b-5abc-308c-8c31-4afb7b9cacb2",
                                                "text": "Разве он идеальный, безукоризненный человек, без недостатков?"
                                            },
                                            {
                                                "example_id": "a35e05bd-8b00-4101-84b6-68a965e5b9ec",
                                                "sense_id": "ee7b567b-5abc-308c-8c31-4afb7b9cacb2",
                                                "text": "Великолепный сценарий! Безукоризненный подбор актеров!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
