                        "examples": [
                            {
                                "example_id": "a20b7116-d861-4234-aced-772d1c1bbd5c",
                                "sense_id": "bbc6a1b9-67bd-344c-8c38-67ff79073f11",
                                "text": "Profitant des démêlés de la France et de la Savoie, et du mécontentement extrême d’Henri IV, il avait conçu le dessein de récupérer, par ce puissant roi, les quatre lettres fameuses qui signifient, comme chacun sait : Fortitudo Ejus Rhodum Tenuit — se fondant sur ce que c’était un de ses Ancêtres, à lui, qui avait autrefois sauvé l’île de Rhodes menacée par Ottoman."
                            },
                            {
                                "example_id": "3ccf98d6-fb64-4857-ade8-737daa660794",
                                "sense_id": "bbc6a1b9-67bd-344c-8c38-67ff79073f11",
                                "text": "La culture des roses sur l'île de Rhodes pourrait expliquer l'origine de son nom et de celui de la ville homonyme, le grec ancien rhodon signifiant « rose », mais rien n'est moins sûr."
                            }
                        ]
                    },
