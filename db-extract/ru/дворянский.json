                                                "sense_id": "d7de61fc-e176-37e9-bc2d-d58a429c0805",
                                                "text": "Er behauptet adlig zu sein, ist es jedoch nicht, denn er hat gar keinen Titel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc83ec46-c786-3518-9a62-c1de29f97c3b",
