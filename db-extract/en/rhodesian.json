        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c666fcfb-b3f5-37f0-bd3d-35bb4f5fd14e",
                "word": "Rhodesian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31047222-0031-38d0-ac8c-3b60ad930faf",
                        "entry_id": "c666fcfb-b3f5-37f0-bd3d-35bb4f5fd14e",
                        "glosses": [
                            "From, pertaining, or relating to Rhodesia or its people or culture."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9fa2687c-d268-4c23-908f-3ce1b91b21cc",
                                "sense_id": "31047222-0031-38d0-ac8c-3b60ad930faf",
                                "text": "“Take it easy, Tahm-boo,” your boss says, her Rhodesian accent returning inexplicably."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "324c92f2-99be-4808-9a40-4244b0af6898",
                        "source_entry_id": "c666fcfb-b3f5-37f0-bd3d-35bb4f5fd14e",
                        "source_sense_id": "31047222-0031-38d0-ac8c-3b60ad930faf",
                        "source_sense_description": "from Rhodesia",
                        "target_lang_word": "rhodésien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhodésien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d61f360-1c0c-39bf-b9d7-8bcd9432598d",
                                        "entry_id": "d6a2caaa-73be-3f80-a8fb-f2de5155a3f9",
                                        "glosses": [
                                            "Qui a un rapport avec la Rhodésie ou ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6462d238-3d14-4d6e-b9d7-de57a1557893",
                                                "sense_id": "2d61f360-1c0c-39bf-b9d7-8bcd9432598d",
                                                "text": "Il doit mener le télégraphe jusqu’à l’extrémité septentrionale du territoire britannique, si toutefois, l’Allemagne ou l’État du Congo lui permettent de poursuivre son œuvre au delà du Nord rhodésien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd6072a-47c6-3e49-bf15-2c64574ee990",
                                        "entry_id": "d6a2caaa-73be-3f80-a8fb-f2de5155a3f9",
                                        "glosses": [
                                            "Qui a rapport avec la Rhodésie et ses politiques de discrimination et de suprémacisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2889e634-6e3a-46a9-9dab-03c58fd61a3f",
                                                "sense_id": "2fd6072a-47c6-3e49-bf15-2c64574ee990",
                                                "text": "Dans tout le tollé d’indignation soulevé par l’arrogance rhodésienne du PDG d’Air Canada, une rare voix s’est élevée pour s’en réjouir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1c90bb-8a25-4206-a149-25d0596d2d6a",
                        "source_entry_id": "c666fcfb-b3f5-37f0-bd3d-35bb4f5fd14e",
                        "source_sense_id": "31047222-0031-38d0-ac8c-3b60ad930faf",
                        "source_sense_description": "from Rhodesia",
                        "target_lang_word": "rhodesisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhodesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba7e14b7-8111-3db4-a11f-58941564704e",
                                        "entry_id": "950275f0-6738-3000-bcb0-4ca2b1374137",
                                        "glosses": [
                                            "auf Rhodesien bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94bd88ed-dbe3-4cce-87ce-ba841f30956f",
                                                "sense_id": "ba7e14b7-8111-3db4-a11f-58941564704e",
                                                "text": "„Nicht zuletzt wegen der unzulänglichen Ausbildung und der mangelhaften Ausrüstung waren die Opferzahlen hoch, auf einen toten rhodesischen Soldaten kamen zehn tote Guerillakämpfer.“"
                                            },
                                            {
                                                "example_id": "460aca34-aab4-476f-88d5-5f6f5b124a57",
                                                "sense_id": "ba7e14b7-8111-3db4-a11f-58941564704e",
                                                "text": "„Ein rhodesischer Soldat hatte bemerkt, dass er die heranstürmenden Afrikaner mit seiner kleinkalibrigen Waffe mit reinen Brustschüssen nicht außer Gefecht setzen konnte, und entwickelte daher die Takti, den Kopfschuss kurz darauf folgen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
