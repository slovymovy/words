                        "examples": [
                            {
                                "example_id": "3afb6e32-ca81-4040-9e04-fbd2d9ef509e",
                                "sense_id": "64bda0d0-2772-39f5-84a1-3f2ca260d11f",
                                "text": "Selon une Vie de saint Gildas, Trémeur est le fils de sainte Trifine, cinquième épouse du cruel Conomor, roi de Domnonée au VIᵉ siècle. […] Très populaire en Bretagne, saint Trémeur est le patron de Carhaix et Kergloff en Finistère et de Camlez dans les Côtes-d’Armor."
                            }
                        ]
                    }
