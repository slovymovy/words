                "senses": [
                    {
                        "sense_id": "afbff24d-04bc-30c9-ba62-6a911067b1b0",
                        "entry_id": "b5b3528e-f678-3299-9b47-12cd52f0fa97",
                        "glosses": [
                            "ein Teil (Kammer) des Sattels, der den Pferderücken umspannt und verhindern soll, dass die Rückenmuskeln des Pferds vom Sattel belastet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87d8d07-9512-4d04-aab0-c9d276f6c6c6",
                                "sense_id": "afbff24d-04bc-30c9-ba62-6a911067b1b0",
                                "text": "„Vorder- und Hinterzwiesel verbinden die Trachten eines Reitsattels und sorgen dafür, dass kein Druck auf die Wirbelsäule des Pferdes entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfc07236-8fcf-3c90-b437-71b87e8567a5",
                        "entry_id": "b5b3528e-f678-3299-9b47-12cd52f0fa97",
                        "glosses": [
                            "Baum mit sich aufspaltendem Stamm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905b6f12-df85-4be2-97b3-3d165d6eac3b",
                                "sense_id": "cfc07236-8fcf-3c90-b437-71b87e8567a5",
                                "text": "„Bei Jungbäumen sind Konkurrenztriebe, insbesondere Zwiesel bis 4–5 cm Durchmesser zu entfernen, über 4–5 cm sind diese einzukürzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1488e1ec-eeca-4a33-bd06-c56f41407699",
                        "source_entry_id": "b5b3528e-f678-3299-9b47-12cd52f0fa97",
