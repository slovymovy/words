                                        "entry_id": "43ea4f46-1c15-37e6-bda2-d4b975790f14",
                                        "glosses": [
                                            "A small supermarket; a convenience store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fb8961c-2613-48f9-a84d-3da246abe0a7",
                                                "sense_id": "c313c146-8195-3ada-8b96-fe5672f8d5c9",
                                                "text": "Its direct competition, analysts say, include Trader Joe’s and Famima minimarkets, both also foreign-owned, by Germans and Japanese, respectively."
                                            }
