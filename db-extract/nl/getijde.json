                        ]
                    },
                    {
                        "sense_id": "25e64dc1-f523-3931-a249-5a53c42a81c0",
                        "entry_id": "7786e281-8dd3-3f89-a67b-915797f1e5f9",
                        "glosses": [
                            "een van de acht officies die het dagritme van een klooster bepalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33ad0f2-5ca4-4872-bc4c-234c1fcee49d",
                                "sense_id": "25e64dc1-f523-3931-a249-5a53c42a81c0",
                                "text": "De sext, terts en none staan bekend als de kleine getijden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c404beb-846e-449e-8adf-e7ebba48e5f8",
