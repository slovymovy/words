{
    "word_family": [
        "shunter",
        "shunting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "346ab46b-2be6-3be4-98f1-edf255074732",
                    "sense_definition": "A minor collision between vehicles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traffic was delayed for an hour after a minor <w>shunt</w> on the motorway.",
                            "target_lang_translations": {
                                "ru": "Движение было задержано на час после <w>незначительного столкновения</w> на автомагистрали."
                            }
                        },
                        {
                            "text": "The driver was lucky to walk away from the <w>shunt</w> without any serious injuries.",
                            "target_lang_translations": {
                                "ru": "Водителю повезло, что он отделался после <w>аварии</w> без серьезных травм."
                            }
                        }
                    ],
                    "common_phrases": [
                        "minor shunt",
                        "car shunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительное дорожно-транспортное происшествие, столкновение автомобилей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незначительное столкновение",
                                "target_lang_sense_clarification": "описание легкой аварии"
                            },
                            {
                                "target_lang_word": "мелкая авария",
                                "target_lang_sense_clarification": "разговорный термин для ДТП без серьезных последствий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b35e35b-7b58-338a-adfa-3cfd4181f286",
                    "sense_definition": "An act of moving suddenly, as due to a push or shove.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player received a hard <w>shunt</w> from behind during the rugby match.",
                            "target_lang_translations": {
                                "ru": "Во время матча по регби игрок получил сильный <w>толчок</w> в спину."
                            }
                        },
                        {
                            "text": "With a quick <w>shunt</w>, he pushed the heavy box out of his way.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>рывком</w> он оттолкнул тяжелую коробку с дороги."
                            }
                        }
                    ],
                    "synonyms": [
                        "shove"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое движение, толчок или рывок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "физическое воздействие"
                            },
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое перемещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a15220be-1e6d-3b62-acea-b1fd0829dfcc",
                    "sense_definition": "A switch on a railway used to move a train from one track to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train was directed onto a different track by the railway <w>shunt</w>.",
                            "target_lang_translations": {
                                "ru": "Поезд был направлен на другой путь с помощью железнодорожной <w>стрелки</w>."
                            }
                        },
                        {
                            "text": "Engineers inspected the <w>shunt</w> to ensure the trains could pass safely.",
                            "target_lang_translations": {
                                "ru": "Инженеры осмотрели <w>стрелку</w>, чтобы убедиться в безопасности проезда поездов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Железнодорожная стрелка, используемая для перевода поезда на другой путь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрелка",
                                "target_lang_sense_clarification": "железнодорожный механизм"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0a2f1c-140f-312a-82a9-52f376453f78",
                    "sense_definition": "A connection used as an alternative path for an electrical current.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician installed a <w>shunt</w> to protect the sensitive meter from high voltage.",
                            "target_lang_translations": {
                                "ru": "Техник установил <w>шунт</w>, чтобы защитить чувствительный прибор от высокого напряжения."
                            }
                        },
                        {
                            "text": "An electrical <w>shunt</w> allows current to bypass the main circuit component.",
                            "target_lang_translations": {
                                "ru": "Электрический <w>шунт</w> позволяет току идти в обход основного компонента цепи."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрическая цепь, включенная параллельно основному участку для ответвления тока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шунт",
                                "target_lang_sense_clarification": "электротехнический компонент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03670812-3bac-3b17-93fc-34deab9b43f7",
                    "sense_definition": "A tube inserted into the body to create a passage for fluid.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon placed a <w>shunt</w> to relieve pressure in the patient's brain.",
                            "target_lang_translations": {
                                "ru": "Хирург установил <w>шунт</w>, чтобы снизить давление в головном мозге пациента."
                            }
                        },
                        {
                            "text": "Regular check-ups are necessary to ensure the <w>shunt</w> remains clear and functional.",
                            "target_lang_translations": {
                                "ru": "Необходимы регулярные осмотры, чтобы убедиться, что <w>шунт</w> остается проходимым и функциональным."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственный канал, вживляемый в организм для оттока жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шунт",
                                "target_lang_sense_clarification": "медицинское устройство"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0de9e1a7-ed1c-30ec-bfe4-60becf70a47e",
                    "sense_definition": "To divert someone or something to a less important place or position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>shunted</w> off to a smaller office after the project failed.",
                            "target_lang_translations": {
                                "ru": "После провала проекта менеджера <w>задвинули</w> в кабинет поменьше."
                            }
                        },
                        {
                            "text": "Important issues are often <w>shunted</w> aside during busy political sessions.",
                            "target_lang_translations": {
                                "ru": "Важные вопросы часто <w>оттесняются</w> на второй план во время напряженных политических сессий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shunted aside",
                        "shunted off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переместить кого-либо или что-либо на менее значимую позицию или место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задвинуть",
                                "target_lang_sense_clarification": "разговорное, переместить на задний план"
                            },
                            {
                                "target_lang_word": "оттеснить",
                                "target_lang_sense_clarification": "сместить с основной позиции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d41b0c06-a5c2-39fd-8a4f-456caee6d54e",
                    "sense_definition": "To move a train or carriages from one track to another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "railway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine driver had to <w>shunt</w> the carriages into the storage yard.",
                            "target_lang_translations": {
                                "ru": "Машинисту пришлось <w>маневрировать</w> вагонами, чтобы перегнать их в депо."
                            }
                        },
                        {
                            "text": "Workers were busy <w>shunting</w> the freight cars throughout the night.",
                            "target_lang_translations": {
                                "ru": "Рабочие всю ночь были заняты <w>маневрами</w> грузовых вагонов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перемещать железнодорожные вагоны или локомотивы с одного пути на другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маневрировать",
                                "target_lang_sense_clarification": "выполнять железнодорожные маневры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bed78e99-57f9-3cb5-9c97-c68c14292be6",
                    "sense_definition": "To have a minor collision in a motor vehicle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was <w>shunted</w> from behind while waiting at the traffic lights.",
                            "target_lang_translations": {
                                "ru": "В меня <w>въехали</w> сзади, пока я стоял на светофоре."
                            }
                        },
                        {
                            "text": "It is frustrating to get <w>shunted</w> when you are driving carefully.",
                            "target_lang_translations": {
                                "ru": "Очень неприятно, когда в тебя <w>врезаются</w>, даже если ты ведешь машину аккуратно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Попасть в незначительное дорожно-транспортное происшествие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попасть в мелкую аварию",
                                "target_lang_sense_clarification": "описание ситуации столкновения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}