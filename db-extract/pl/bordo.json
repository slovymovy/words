                                    {
                                        "sense_id": "97729d6e-518d-3fa6-a6cb-55814f80b7ed",
                                        "entry_id": "ae05ed2e-6e21-3fe8-ad66-1d48efc29e6f",
                                        "glosses": [
                                            "Kurzform für den Wein aus dem Weinbaugebiet Bordeaux"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b7bde9f-44bd-4bb2-8033-62230711f75d",
                                                "sense_id": "97729d6e-518d-3fa6-a6cb-55814f80b7ed",
                                                "text": "Dieser Bordeaux hat ein schönes Bukett."
                                            },
                                            {
                                                "example_id": "da60c966-3cba-47b7-9917-7c80a113322f",
                                                "sense_id": "97729d6e-518d-3fa6-a6cb-55814f80b7ed",
                                                "text": "„Als ob es ihr Ritual wäre, wenn die Sirenen jaulten, hob Suzanne eine Flasche, in der noch ein wenig Bordeaux war, stieß damit gegen eine andere Flasche und leerte den Rest mit einem schwungvollen Zug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b73b26b-9976-4777-bd74-058dc9565f6e",
                        "source_entry_id": "3f034574-4382-3b3a-96b5-a1ae70dd23fd",
                        "source_sense_id": "fb5c7be0-d0ec-3f07-8c6f-bdab30de5f87",
