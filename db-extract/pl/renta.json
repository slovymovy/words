                        "source_entry_id": "0f3ecf13-9505-38a6-a704-797606cce37e",
                        "source_sense_id": "b0886a35-7a7d-3955-8f7a-e38ce081dc0a",
                        "target_lang_word": "disability benefit",
                        "target_lang_code": "en",
