                        "entry_id": "388b4a3a-1b47-3441-8ab4-23a443fed1f1",
                        "glosses": [
                            "lijst met kandidaten die voor een partij tijdens verkiezingen verkozen kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c13bc685-2b66-4e25-893f-9ac1afa94e33",
                                "sense_id": "7c1ad2aa-e354-3eca-8c31-a39969ce91ee",
                                "text": "Leonie Vestering, derde op de kieslijst voor Partij voor de Dieren, twittert over het politieoptreden bij de rellen in Eindhoven. Ze verwijst naar een video waarop te zien is dat een politiepaard onderuit gaat."
                            },
                            {
                                "example_id": "6afea52b-b56c-4a63-9dde-a022ba8ac233",
                                "sense_id": "7c1ad2aa-e354-3eca-8c31-a39969ce91ee",
                                "text": "Twee belangrijke kantelpunten in die ontwikkeling waren de SGP-zaak en de Urgenda-zaak. In die eerste zaak dwongen belangenorganisaties de staat om niet langer te dulden dat de SGP vrouwen van de kieslijst weerde. Met de klimaatzaak dwong Urgenda de staat extra maatregelen te nemen om de CO2-uitstoot te verminderen."
                            }
                        ]
                    }
