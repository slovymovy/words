                {
                    "sense_id": "133ed1ab-0754-325d-8ad8-6fd8d79ea674",
                    "sense_definition": "Liquid waste consisting of water, salts, and urea, which is made in the kidneys, stored in the bladder, then released through the urethra.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to provide a <w>urine</w> sample for analysis.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента предоставить образец <w>мочи</w> для анализа.",
                                "zh": "医生让患者提供一份<w>尿液</w>样本进行化验。"
                            }
                        },
                        {
                            "text": "Dehydration can cause your <w>urine</w> to become dark yellow in color.",
                            "target_lang_translations": {
                                "ru": "Обезвоживание может привести к тому, что ваша <w>моча</w> станет тёмно-жёлтого цвета.",
                                "zh": "脱水会导致你的<w>尿液</w>颜色变深变黄。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pee",
                        "piss",
                        "wee",
                        "water"
                    ],
                    "common_phrases": [
                        "pass urine",
                        "urine sample",
                        "urine test",
                        "urine retention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкий продукт жизнедеятельности, вырабатываемый почками, накапливаемый в мочевом пузыре и выводимый из организма.",
                        "zh": "由肾脏生成、储存于膀胱并通过尿道排出体外的含水、无机盐和尿素的液体排泄物。"
                    },
