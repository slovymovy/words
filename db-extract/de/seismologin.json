                "senses": [
                    {
                        "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                        "entry_id": "f6798987-29f8-3d4d-b5c1-d3d25b77f551",
                        "glosses": [
                            "weibliche Person, die sich mit der Seismologie beschäftigt, also Erdbeben erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "545eb7d8-9af9-4a59-ae23-5a45563b179b",
                                "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                                "text": "„Man könne nicht vorhersagen, ob es in den kommenden Tagen und Wochen noch zu stärkeren oder gleich starken Nachbeben komme, sagte die Seismologin auf Nachfrage.“"
                            },
                            {
                                "example_id": "8dbe4188-1409-49d6-b045-8148d76d48ff",
                                "sense_id": "edb410e2-15f6-35e1-8eeb-4c71fa71719f",
                                "text": "„Die Londoner Seismologin Paula Koelemeijer hat einen deutlichen Rückgang der durch menschliche Aktivitäten verursachten Schwingungen festgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
