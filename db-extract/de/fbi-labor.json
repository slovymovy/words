                                "example_id": "c2b98f60-5df0-4c89-9a55-64b3eebc7427",
                                "sense_id": "b1c08444-66c6-37f4-9ea8-94ff118dce60",
                                "text": "„Wir können sie in ein FBI-Labor schicken, um sie analysieren zu lassen.“"
                            },
