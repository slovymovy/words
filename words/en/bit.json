    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3175e5d0-6675-3f85-8b9c-379052a0d180",
                    "sense_definition": "A small piece, portion, or quantity of something.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "amount_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were <w>bits</w> of broken glass scattered all over the floor.",
                            "target_lang_translations": {
                                "ru": "По всему полу были разбросаны <w>осколки</w> битого стекла.",
                                "zh": "地板上到处都是碎玻璃<w>片</w>。"
                            }
                        },
                        {
                            "text": "I would like a little <w>bit</w> of cake with my coffee.",
                            "target_lang_translations": {
                                "ru": "Я бы хотел маленький <w>кусочек</w> торта к кофе.",
                                "zh": "我想配咖啡吃一小<w>块</w>蛋糕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "piece",
                        "scrap",
                        "fragment",
                        "speck",
                        "particle",
                        "portion",
                        "part"
                    ],
                    "common_phrases": [
                        "a bit of",
                        "bits and pieces",
                        "bit by bit",
                        "do one's bit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кусок, часть или количество чего-либо.",
                        "zh": "某物的一小块、一小部分或少量。"
                    },
                    "translations": {
