                    },
                    {
                        "translation_id": "831d276f-3abd-4227-8613-bb71459eaf12",
                        "source_entry_id": "227684b4-ac06-31bb-ac20-7c92e2c3fa60",
                        "source_sense_description": "En forme de labyrinthe",
                        "target_lang_word": "mazy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mazy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d78bd89-063b-31d5-8146-0c76d5e0c1d5",
                                        "entry_id": "65263136-f117-3c00-8899-a9a500bb416c",
                                        "glosses": [
                                            "Mazelike; like a maze."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29093b5f-bd9a-3594-aa4d-d7b14a466cce",
                                        "entry_id": "65263136-f117-3c00-8899-a9a500bb416c",
                                        "glosses": [
                                            "Not straight; zigzagging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a9d0f1d-9333-4d78-9158-15645928220e",
                                                "sense_id": "29093b5f-bd9a-3594-aa4d-d7b14a466cce",
                                                "text": "Five miles meandering with a mazy motion,\n Through wood and dale the sacred river ran,\n Then reached the caverns measureless to man,\n And sank in tumult to a lifeless ocean: [...]"
                                            },
                                            {
                                                "example_id": "91727653-5095-47ed-8692-0f6b256ab2de",
                                                "sense_id": "29093b5f-bd9a-3594-aa4d-d7b14a466cce",
                                                "text": "Deep into distant woodlands winds a mazy way, reaching to overlapping spurs of mountains bathed in their hill-side blue."
                                            },
                                            {
                                                "example_id": "718089fe-3bbc-4f1f-875d-12395bc18ad8",
                                                "sense_id": "29093b5f-bd9a-3594-aa4d-d7b14a466cce",
                                                "text": "England's superior conditioning began to show in the final quarter and as the game began to break up, their three-quarters began to stamp their authority on the game. And when Foden went on a mazy run from inside his own 22 and put Ashton in for a long-range try, any threat of an upset was when and truly snuffed out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1151b74-3ab8-3f8d-b289-9c8651fa723c",
                                        "entry_id": "65263136-f117-3c00-8899-a9a500bb416c",
                                        "glosses": [
                                            "Confused."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04ed2c3a-d768-4cce-ad1a-ffba6f025851",
                                                "sense_id": "a1151b74-3ab8-3f8d-b289-9c8651fa723c",
                                                "text": "I am a fool—a purblind, mazy fool,\nAnd do not know my right hand from my left."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdce203d-4d80-442d-ac60-63bbcb34ec13",
