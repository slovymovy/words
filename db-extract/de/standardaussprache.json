                ],
                "senses": [
                    {
                        "sense_id": "13dd07cf-4bfc-3e13-8b7f-785dc36a4cdc",
                        "entry_id": "6c56ad22-f4a9-33df-8cb7-01b403ba09f8",
                        "glosses": [
                            "Aussprache/Lautung von sprachlichen Einheiten, die als standardgemäß aufgefasst wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "059680f8-f1a5-4d4f-a30c-02b637aa95de",
                                "sense_id": "13dd07cf-4bfc-3e13-8b7f-785dc36a4cdc",
                                "text": "„Ganz offensichtlich deckt sich die Standardaussprache, wie sie in gängigen Aussprachewörterbüchern wiedergegeben wird, nicht mit dem Sprachgebrauch, der in den einzelnen Regionen des deutschsprachigen Gebietes vorherrscht.“"
                            },
                            {
                                "example_id": "5aa2c0dd-c469-46f5-86f2-edee30c24d48",
                                "sense_id": "13dd07cf-4bfc-3e13-8b7f-785dc36a4cdc",
                                "text": "„Das Wörterbuch berücksichtigt damit stilistische Differenzierungen der Standardaussprache und beschreibt unterschiedliche Ausprägungsgrade der Artikulationspräzision beim Vorlesen von Texten sowie beim freien Sprechen.“"
                            },
                            {
                                "example_id": "7ff158b0-c330-400e-a7c6-2d4219e95977",
                                "sense_id": "13dd07cf-4bfc-3e13-8b7f-785dc36a4cdc",
                                "text": "„Aber für beide Nutzergruppen interessant und relevant sind Fälle, in denen im Deutschen auch in der Standardaussprache (das heißt in formellen Situationen) verschiedene Aussprachevarianten gebräuchlich sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
