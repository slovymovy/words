                        "entry_id": "169ea66c-fc91-31e9-86cf-2d06b76658ea",
                        "glosses": [
                            "groep van leerlingen die in dit schooljaar eindexamen gaat doen en dus de oudste groep van de school zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f0d8679-4426-4781-a416-5dc8f2210593",
                                "sense_id": "a3227559-a334-31cb-a49f-ef31b2cd990c",
                                "text": "Sint-Maarten doet er volgens Bussemaker alles aan om te zorgen dat eindexamenklassen weer naar school kunnen en dat krijgt voorrang op ander herstelwerk."
                            },
                            {
                                "example_id": "a487391e-06ba-4e01-b4c3-3a06dc58f7a8",
                                "sense_id": "a3227559-a334-31cb-a49f-ef31b2cd990c",
                                "text": "Een leerlinge van een eindexamenklas zei voor L1 dat de school volgens haar ten onrechte in een kwaad daglicht wordt gesteld. „Grotius doet veel aan de aanpak van pesten”, zei ze. En ze voegde hieraan toe: „Ik hoor dat het niet alleen om pesten is gegaan. Er was meer aan de hand.”"
                            }
                        ]
