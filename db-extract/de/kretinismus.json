                "senses": [
                    {
                        "sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                        "entry_id": "d9497862-b49f-3cf2-939f-8d5dc1495018",
                        "glosses": [
                            "angeborene Schilddrüsenstörung, infolge Jodmangels der Mutter in der Schwangerschaft, mit Schwachsinn, Kropf und Kleinwuchs verbunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732583ae-8073-4972-88d6-148cdd6e4a30",
                                "sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                                "text": "Eine Heilung des Kretinismus ist durch Schilddrüsenpräparate bei frühzeitigem Einsatz möglich."
                            },
                            {
                                "example_id": "4cca7d97-a370-4a6d-bb81-b256545a15b4",
                                "sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                                "text": "„Mit diesem Kretinismus sollte ja keineswegs die akademische Jugend in corpore getroffn werden – aber sie fühlte sich getroffen!“"
                            },
                            {
                                "example_id": "cd7ef448-9153-419f-899c-78cecec9d44a",
                                "sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                                "text": "„Die Untersuchung betrifft den Kretinismus bei erwachsenen Frauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2769d628-95bf-4279-9e59-05a819d7436d",
                        "source_entry_id": "d9497862-b49f-3cf2-939f-8d5dc1495018",
                        "source_sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                        "target_lang_word": "cretinism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cretinism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ceba2b-71a4-3451-ab99-ec0dfe8bc307",
                                        "entry_id": "fb4c27f3-e192-3fa5-9172-c42f8da166aa",
                                        "glosses": [
                                            "A condition of severely stunted physical and mental growth due to the untreated congenital deficiency of thyroid hormones."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8529857b-db36-4e8d-ac70-bdf48856d4ac",
                                                "sense_id": "f7ceba2b-71a4-3451-ab99-ec0dfe8bc307",
                                                "text": "Cretinism is a form of amentia, which is endemic in certain districts, especially in some of the valleys of Switzerland, Savoy, and France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a6fda8c-4feb-4656-9490-60ac7cbb815e",
                        "source_entry_id": "d9497862-b49f-3cf2-939f-8d5dc1495018",
                        "source_sense_id": "5d6dca8c-3e2f-3424-9cd7-cfd5b2de7cf7",
                        "target_lang_word": "crétinisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crétinisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6caac554-79b8-32d7-bbee-c9831ced80c1",
                                        "entry_id": "29be1613-2a62-37e2-af17-7dc29ae72b86",
                                        "glosses": [
                                            "Arriération mentale, intellectuelle et parfois physique due à une insuffisance thyroïdienne congénitale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83304b13-a0ea-4a0e-b861-e4d04f61e97e",
                                                "sense_id": "6caac554-79b8-32d7-bbee-c9831ced80c1",
                                                "text": "Au milieu du XIXᵉ siècle, on se mit à rechercher scientifiquement pourquoi le crétinisme affectait certaines vallées alpines."
                                            },
                                            {
                                                "example_id": "7a88bddb-06d9-41b2-96a7-45c6d5405986",
                                                "sense_id": "6caac554-79b8-32d7-bbee-c9831ced80c1",
                                                "text": "Ailleurs des enfants en haillons, atteints de malformations diverses ou donnant des signes évidents de crétinisme, jouaient à se rouler parterre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "455e4eb9-08fa-3cf8-ad3c-a12fc287b8c9",
                                        "entry_id": "29be1613-2a62-37e2-af17-7dc29ae72b86",
                                        "glosses": [
                                            "Stupidité, imbécillité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d12bedf-7465-429d-b8ac-aab204bfa375",
                                                "sense_id": "455e4eb9-08fa-3cf8-ad3c-a12fc287b8c9",
                                                "text": "Tu veux vraiment qu'on sauve la vie amoureuse d'un gars qui est atteint de crétinisme au stade avancé?"
                                            },
                                            {
                                                "example_id": "e54d147b-20df-448b-a1d8-1cadba4e0181",
                                                "sense_id": "455e4eb9-08fa-3cf8-ad3c-a12fc287b8c9",
                                                "text": "La semaine dernière, je qualifiais d’« égoïsme pur » le choix d’aller dans le Sud en risquant de rapporter la COVID-19 au Québec et dans l’avion. Le reportage confirme qu’une dose sérieuse de crétinisme décomplexé y est aussi pour beaucoup."
                                            },
                                            {
                                                "example_id": "aad5128a-c536-479b-8399-97568e3e8323",
                                                "sense_id": "455e4eb9-08fa-3cf8-ad3c-a12fc287b8c9",
                                                "text": "C'est du crétinisme ou de la mauvaise volonté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aefa155-b116-4758-9343-1078c69df2b2",
                        "source_entry_id": "d9497862-b49f-3cf2-939f-8d5dc1495018",
