                        "examples": [
                            {
                                "example_id": "a230265e-83ad-417d-91d9-154214b384ef",
                                "sense_id": "ab62278f-7bbb-3c1a-b9e8-c6780bf2109f",
                                "text": "Si je ne t’ai pas assez marqué autrefois que je te tenais pour très coupable d’avoir séduit, à Rome, la femme d’un consulaire, c’est qu’alors tu expiais durement ta faute."
                            },
                            {
                                "example_id": "c98495fe-0118-4236-b492-45be2faf9cdc",
                                "sense_id": "ab62278f-7bbb-3c1a-b9e8-c6780bf2109f",
                                "text": "Pour rétablir l’ordre, le consulaire Ambroise se rendit à l’église."
                            }
                        ]
