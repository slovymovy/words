                        "glosses": [
                            "Relatif aux idées et à l’activisme politique du révolutionnaire italien Joseph Mazzini et de ses partisans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9524bfb1-545b-4bdc-86f1-c43ca81a2d48",
                                "sense_id": "1fac2746-427b-362e-8caf-75fa4babb18e",
                                "text": "Il me souvient de l’un d’eux, un musicien précisément, un certain Rafaëlle Trabuco, qui était professeur de cor d’harmonie et qui passait même pour avoir du talent. Il s’était trouvé impliqué dans un complot mazzinien contre la vie de l’empereur."
                            }
                        ]
                    }
