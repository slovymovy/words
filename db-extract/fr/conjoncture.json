        "fr-extract.jsonl": [
            {
                "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                "word": "conjoncture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "38cdd169-8069-401a-8f2e-b2bce77ef127",
                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "tags": [
                            "plural"
                        ],
                        "form": "conjonctures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "glosses": [
                            "État, disposition, résultat d’une rencontre de circonstances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6939a1-193e-4e73-a1d8-f012590a700c",
                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                "text": "Se trouver dans des conjonctures difficiles."
                            },
                            {
                                "example_id": "fb3fc749-14d6-4c82-96be-db8b0d2908a2",
                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                "text": "Dans les différentes conjonctures de la vie."
                            },
                            {
                                "example_id": "920a1da4-bde5-4a88-b686-0b12cde05e44",
                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                "text": "Heureuse, triste, fatale conjoncture."
                            },
                            {
                                "example_id": "14fc3398-3644-4e72-8a81-c382c9f28e5b",
                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                "text": "La conjoncture est favorable."
                            },
                            {
                                "example_id": "40ba4b2e-8470-4306-9bc9-60aa7af0194a",
                                "sense_id": "b1c3a6bc-5234-3cb4-9141-3cc9bc22f927",
                                "text": "Cela est arrivé dans une fâcheuse conjoncture."
                            }
                        ]
                    },
                    {
                        "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "glosses": [
                            "Situation économique à un certain moment, et son évolution à court terme, de quelques mois à un an."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5fb5a470-f3c2-4d0c-8f77-e8f00275940d",
                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                            },
                            {
                                "example_id": "9577f387-005e-4407-bbf2-0c6407a207d7",
                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                "text": "[Le] ralliement [au Général De Gaulle en 1958] était donné du bout des lèvres et en fonction d'une conjoncture passagère."
                            },
                            {
                                "example_id": "969170e9-89e4-4c80-afbd-502447304857",
                                "sense_id": "96ae6a93-11e8-376b-a221-ac8c1ad57bb6",
                                "text": "De toute manière, « les marchés font leurs propres évaluations et peuvent décider d’eux-mêmes d’augmenter ou non les taux. Ce sont eux qui ont la décision finale », rappelle Christophe Blot, économiste à l’Observatoire français des conjonctures économiques et spécialiste des crises financières."
                            }
                        ]
                    },
                    {
                        "sense_id": "8bdc55f5-2dee-354f-b70d-1badeec34eda",
                        "entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "glosses": [
                            "Bière de 48 ou 43 cl."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "ccf1a6b3-1394-421a-9156-d723a8b6d6b0",
                                "sense_id": "8bdc55f5-2dee-354f-b70d-1badeec34eda",
                                "text": "Pour éviter une hausse des prix, liée aux difficultés économiques, les brasseurs ont maintenu, au même niveau, les prix des bières, en réduisant la contenance des bouteilles. Le consommateur ivoirien, pas dupe, commande désormais une « conjoncture » !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc940c7-f43d-4037-bd95-953170c1aab5",
                        "source_entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "source_sense_description": "situation économique",
                        "target_lang_word": "economic environment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e713c9ad-c635-48da-bf77-90d747c893ba",
                        "source_entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "source_sense_description": "situation économique",
                        "target_lang_word": "conjunctuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjunctuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                        "entry_id": "70374407-2c17-357f-a956-ee001cec3f3a",
                                        "glosses": [
                                            "de verandering van het groeipercentage van de economie of de productie op de korte termijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac017f3e-997f-429b-ab21-221d0c6ed2c7",
                                                "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                                "text": "Aandacht voor de conjunctuur in de media en de academische wereld schommelt net zo sterk als de conjunctuur zelf."
                                            },
                                            {
                                                "example_id": "2cb08a1d-a994-4f8d-a052-232a9a4ecf57",
                                                "sense_id": "6669258b-c544-3833-9cca-f0627329c426",
                                                "text": "De vastgoedmaatschappij was dus in de huidige conjunctuur een enorm verborgen kapitaal, een vergeten en slapende goudmijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b0b6f39-1b26-42c2-b18e-6b5dd253eac4",
                        "source_entry_id": "3844bd32-7527-340e-babc-9c27ad4228e8",
                        "source_sense_description": "situation économique",
                        "target_lang_word": "omstandigheden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "omstandigheden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4828d4d4-ed1e-3b9b-8a25-8811977ccf15",
                                        "entry_id": "ffa443e7-e9f5-386c-a67b-e5b1025c44ff",
                                        "glosses": [
                                            "fysieke omgeving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ef06a6-dd2f-4e7a-8893-dc976d79c5f2",
                                                "sense_id": "4828d4d4-ed1e-3b9b-8a25-8811977ccf15",
                                                "text": "Een andere reden dat antihyperhelium-4 interessant is, zo zegt Stöcker, is dat de omstandigheden in de deeltjesversneller bij het ontstaan ervan de toestand nabootsen waarin het heelal verkeerde toen het slechts een miljoenste van een seconde oud was. Het heelal bestond op dat moment uit een ‘hete soep’ van deeltjes. Het identificeren van de materie- en antimateriedeeltjes die hieruit voortkomen, kan helpen begrijpen hoe we in een heelal terecht zijn gekomen waarin de hoeveelheid materie, inclusief de materie waaruit wijzelf bestaan, de schaarse hoeveelheid antimateriedeeltjes overschaduwt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8630236b-ee26-3033-9e6e-7f73da3f5533",
                                        "entry_id": "ffa443e7-e9f5-386c-a67b-e5b1025c44ff",
                                        "glosses": [
                                            "sociale omgeving"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5bb1ceb4-5ffe-43b3-b06a-acbcdfb6a4c7",
                                                "sense_id": "8630236b-ee26-3033-9e6e-7f73da3f5533",
                                                "text": "1 16 juni 1967 Geachte juffrouw Bastien, Dank u voor uw sollicitatiebrief en curriculum vitae. Een mens kan alleen maar hopen dat hij gedijt in de omstandigheden waar het leven hem mee opzadelt. Het is duidelijk dat u een begaafde jonge vrouw bent, ruimschoots gewapend voor de strijd."
                                            },
                                            {
                                                "example_id": "4c1613ad-9530-4a2a-af31-1f203546543e",
                                                "sense_id": "8630236b-ee26-3033-9e6e-7f73da3f5533",
                                                "text": "Ik zoek naar redenen die buiten hun persoon liggen en ik wil de omstandigheden schuldig verklaren."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "omstandigheden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "20d89d93-38f9-3662-b2bf-a6acdcfcdca2",
                                        "entry_id": "5fb81989-55af-3153-ae53-be6a1c35c19f",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord omstandigheid"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bd9c45d-06ba-4034-9f4c-3e78b6b69576",
                                                "sense_id": "20d89d93-38f9-3662-b2bf-a6acdcfcdca2",
                                                "text": "We waren niet goed voorbereid op deze omstandigheden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cec77b33-b746-4565-8995-9c847bdc818c",
