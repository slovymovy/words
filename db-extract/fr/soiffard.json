                "senses": [
                    {
                        "sense_id": "5546b8fc-d2ac-3ed1-8595-860c95c9ec40",
                        "entry_id": "c7a6af20-e0fa-369f-8ccb-48330ceb2b8c",
                        "glosses": [
                            "Relatif à la consommation excessive de boissons alcoolisées."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d38b4541-571f-4885-9885-83be6b39f82c",
                                "sense_id": "5546b8fc-d2ac-3ed1-8595-860c95c9ec40",
                                "text": "Il n’a point songé à rimer quand le hasard d’une vadrouille au Quartier le conduisit à popiner au café Vachette avec des symbolos soiffards."
                            },
                            {
                                "example_id": "ac58fa91-4465-4678-b6c5-9298dd802340",
                                "sense_id": "5546b8fc-d2ac-3ed1-8595-860c95c9ec40",
                                "text": "Une tronche d’aigrefin soiffard surmontée d’une bouse de vache rousse, la perruque la plus loupée que j’ai jamais vue sur le crâne de quelqu’un."
                            },
                            {
                                "example_id": "10a683b4-7277-4220-81fb-e82150fcbe41",
                                "sense_id": "5546b8fc-d2ac-3ed1-8595-860c95c9ec40",
                                "text": "En fait de saint-émilion, Marthe achète sa piquette à Anselme. […]. Le vin vaut ce qu’il vaut, mais Marthe le touche à bon prix et comme la clientèle est soiffarde, tout le monde est content."
                            },
                            {
                                "example_id": "244141cc-281b-412c-8403-2a0707b353d9",
                                "sense_id": "5546b8fc-d2ac-3ed1-8595-860c95c9ec40",
                                "text": "C'était le moment où les ouvriers, les agriculteurs se retrouvaient pour une partie de cartes avant dîner, où les soiffards entamaient leur longue soirée, on venait aux nouvelles, on en apportait, toutes les rumeurs passaient par ici que l'on commentait bruyamment en vidant des verres de Clacquesin, de Byrrh et de Picon-bière."
                            }
                        ]
                    }
                ],
