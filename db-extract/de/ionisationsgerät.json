                ],
                "senses": [
                    {
                        "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                        "entry_id": "5be27c2e-faa1-335c-b694-8c5553533bdb",
                        "glosses": [
                            "Gerät zur Ionisation der Luft, des Wassers oder von Stoffen basierend auf einem Ionisator"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eb9b9a2-37dd-47d4-9d7b-6ced450dd883",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Es gibt zahlreiche externe und interne Steuer- und Regelsysteme für Ionisationsgeräte mit Ionisationsröhren, die mit Betriebsspannung von 1,5–2,85 kV auf der Ionisationsröhre betrieben werden.“"
                            },
                            {
                                "example_id": "f480c04e-90cc-404f-a5d0-2268b7621188",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Die Ionisation mit unseren Ionisationsgeräten sorgt für klare, saubere Luft, die maßgeblich das Raumklima verbessert.“"
                            },
                            {
                                "example_id": "e7d76b19-d35b-4b15-852b-3ac375c8b639",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Unser Ionisationsgerät lässt sich bei gleichzeitiger Bestellung in unsere Trocknungsgeräte mit Gebläse optimal integrieren.“"
                            },
                            {
                                "example_id": "0bd43da9-f6cf-4908-904e-122bc0d3cca4",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Der EI Form ist ein Ionisationsgerät, das sich konvex und konkav gekrümmten Oberflächen anpassen lässt.“"
                            },
                            {
                                "example_id": "e9e01f54-bce8-4cfa-835c-0d8a591d584f",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Der Abstand vom Zielobjekt und die Ventilatorgeschwindigkeit beeinflussen das Leistungsvermögen des Ionisationsgerätes.“"
                            },
                            {
                                "example_id": "b75825df-41ed-4a23-92af-24b0296145d4",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„Die zuverlässigen und kostengünstigen Netzgeräte PU55 und PU80 erzeugen die Hochspannung für den Betrieb der Ionisationsgeräte der Blue Label Baureihe.“"
                            },
                            {
                                "example_id": "368e9c0c-2387-4c79-98ff-f879ac8f5dca",
                                "sense_id": "8c040f59-32c8-3fb3-b521-8f88e87990e0",
                                "text": "„An der Wand gegenüber der Tür wurde ein Wasserfall mit einem Ionisationsgerät untergebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
