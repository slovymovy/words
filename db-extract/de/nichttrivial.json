                ],
                "senses": [
                    {
                        "sense_id": "e521b95b-4f6a-32d6-8fbf-9705aff7cf0c",
                        "entry_id": "fd11b824-af93-3357-87ef-e71911e9b4a7",
                        "glosses": [
                            "aus dem Verständnis (der Definition) eines Begriffes nicht unmittelbar und nur mit weiteren Berechnungen folgend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "280c5368-3a24-4efa-8d3f-9464d31277de",
                                "sense_id": "e521b95b-4f6a-32d6-8fbf-9705aff7cf0c",
                                "text": "„Ein homogenes Gleichungssystem hat zusätzlich zur trivialen Lösung auch nichttriviale Lösungen, wenn der Rang r(A) der Koeffizientenmatrix kleiner als die Anzahl der Unbekannten n ist.“"
                            },
                            {
                                "example_id": "848a160f-4a51-4daf-982d-a707a9ebd817",
                                "sense_id": "e521b95b-4f6a-32d6-8fbf-9705aff7cf0c",
                                "text": "„Eine nichttriviale Linearkombination des Nullvektors ist eine Linearkombination mit dem Ergebnis 0_V, bei dem mindestens ein Koeffizient ungleich 0 ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
