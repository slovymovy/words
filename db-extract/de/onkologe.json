                                "target_senses": [
                                    {
                                        "sense_id": "ef86763c-2a4b-37e5-8006-d9d2f9f7b936",
                                        "entry_id": "473fa629-a137-375a-85c1-254b42363274",
                                        "glosses": [
                                            "een medisch specialist die zich bezighoudt met de gezwelgroei, in het bijzonder met kanker"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc2bd1b-af04-4a07-8c79-36b8bf516bd8",
                                                "sense_id": "ef86763c-2a4b-37e5-8006-d9d2f9f7b936",
                                                "text": "Hij is oncoloog van beroep."
                                            }
                                        ]
