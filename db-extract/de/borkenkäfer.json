                    }
                ],
                "senses": [
                    {
                        "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                        "entry_id": "85965ba9-a5fd-326a-9bc0-2248707c14a9",
                        "glosses": [
                            "ein Käfer, der unter der Borke oder im Holz eines Baumes lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f7cf682-7806-421e-98c4-5f3a34561cef",
                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                "text": "Der Borkenkäfer mag es warm und trocken."
                            },
                            {
                                "example_id": "1fbd3283-0226-4f91-8db5-a65f580ecc8b",
                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                "text": "Borkenkäfer fliegen ab dem Frühjahr auf geschwächt stehende Bäume."
                            },
                            {
                                "example_id": "f1f08623-104f-4ffc-a5e3-2765fcee4130",
                                "sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                                "text": "Borkenkäfer richten in der Forstwirtschaft große wirtschaftliche Schäden an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aef2ecb0-511d-4feb-bd4a-6f0ceb73bacb",
                        "source_entry_id": "85965ba9-a5fd-326a-9bc0-2248707c14a9",
                        "source_sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                        "source_sense_description": "Zoologie: ein Käfer, der unter der Borke oder im Holz eines Baumes lebt",
                        "target_lang_word": "bark beetle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bark beetle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8d4a133-9876-3357-b571-048550459922",
                                        "entry_id": "383da521-f9dc-3f2f-878c-00b91562cccf",
                                        "glosses": [
                                            "Any of various beetles, of the subfamily Scolytinae, many of which reproduce in the inner bark of trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52aab352-c226-487b-b662-e08b0f3bd043",
                                                "sense_id": "c8d4a133-9876-3357-b571-048550459922",
                                                "text": "Naval stores production is based upon exploiting the terpene chemical defense system of the pine tree, which protects against wood-decaying fungi and insect pests such as bark beetles (Dendroctonus Ips sp.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4998f09-5253-43cc-a93a-e794a8eb0ee2",
                        "source_entry_id": "85965ba9-a5fd-326a-9bc0-2248707c14a9",
                        "source_sense_id": "16d9b220-30dc-3e77-bbcd-0535591ce9bd",
                        "source_sense_description": "Zoologie: ein Käfer, der unter der Borke oder im Holz eines Baumes lebt",
                        "target_lang_word": "scolyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scolyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d122226d-15db-3990-9993-50b3f751ff60",
                                        "entry_id": "a0a7c0ea-1e5a-3a97-a900-9bb477bfa4cf",
                                        "glosses": [
                                            "Sous-famille d’insectes coléoptères xylophages creusant sous l’écorce des arbres des systèmes de galeries maternelles et larvaires souvent caractéristiques de l’espèce, provoquant fréquemment la mort de l’arbre attaqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d507b8f-e675-44db-bc8e-dabb814ca326",
                                                "sense_id": "d122226d-15db-3990-9993-50b3f751ff60",
                                                "text": "Par ailleurs, la succession d’étés chauds et secs est jugée responsable des attaques de scolytes, des petits coléoptères qui ont fait de gros dégâts sur les sapins."
                                            },
                                            {
                                                "example_id": "2a9b8657-12f3-4414-8213-5edf0b4fa2b2",
                                                "sense_id": "d122226d-15db-3990-9993-50b3f751ff60",
                                                "text": "Par exemple, l’Ips confusus, une espèce de scolyte, a détruit selon les endroits entre cinquante et cent pour cent des « pinyons » de la région prise en compte par David Dunn."
                                            },
                                            {
                                                "example_id": "1d0d2f88-870f-4e8f-8176-c9cb9afb6a83",
                                                "sense_id": "d122226d-15db-3990-9993-50b3f751ff60",
                                                "text": "Surtout par des bio-agresseurs, comme les scolytes, des insectes qui se nourrissent du bois des épicéas rendus vulnérables par les sécheresses répétées : les aiguilles des arbres scolytés passent du vert au brun."
                                            },
                                            {
                                                "example_id": "758f96cc-aa19-4250-b819-fd142cea7f0b",
                                                "sense_id": "d122226d-15db-3990-9993-50b3f751ff60",
                                                "text": "Dans les années soixante, Hienghène était un gros centre de caféiculture. Ce n’est plus le cas aujourd’hui. À partir de 1964, minée par un parasite, le « scolyte » (Stephanoderes hampei), la production de café s’affaisse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
