        "de-extract.jsonl": [
            {
                "entry_id": "6c7e3f86-da5f-36bf-8f5f-774e83972917",
                "word": "badness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "57178eba-95ee-3e00-8f45-4a723e575c12",
                        "entry_id": "6c7e3f86-da5f-36bf-8f5f-774e83972917",
                        "glosses": [
                            "Schlechtigkeit, Bosheit, Bösartigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6a23a94-0a2c-4633-96ad-1a4bc25006c5",
                                "sense_id": "57178eba-95ee-3e00-8f45-4a723e575c12",
                                "text": "\"And so he deprives me instantly of his favor, and not at all from badness of heart.\"",
                                "translation": "Und so beraubt er mich sofort seiner Gunst, und schon gar nicht aus Schlechtigkeit des Herzens."
                            },
                            {
                                "example_id": "17ab04cb-4842-4794-bad5-93eecba08869",
                                "sense_id": "57178eba-95ee-3e00-8f45-4a723e575c12",
                                "text": "\"But apart from their losses by famine, war and the badness of the central government, it is probable that the cultivators were held to have a hereditary right to their land, and were not liable to ejectment on the suit of any private person.\"",
                                "translation": "Aber abgesehen von ihren Verlusten durch Hunger, Krieg und der Schlechtigkeit der Zentralregierung, ist es wahrscheinlich, dass die Landwirte [in dem Rechtszustand] gehalten wurden, ein erbliches Recht auf ihr Land zu haben, und nicht einer Vertreibung durch einen Rechtsstreit irgendeiner Privatperson zu unterliegen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0842a9e-7e5e-4f78-8355-49d67242133d",
                        "source_entry_id": "6c7e3f86-da5f-36bf-8f5f-774e83972917",
                        "source_sense_id": "57178eba-95ee-3e00-8f45-4a723e575c12",
                        "source_sense_description": "Schlechtigkeit, Bosheit, Bösartigkeit",
                        "target_lang_word": "Schlechtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlechtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                        "entry_id": "a7bf7f56-91c0-3f8e-9653-08cd55243548",
                                        "glosses": [
                                            "Denkweise, Eigenschaft, Handlung, die Schlechtes/Übles beinhaltet, realisiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6b96c7-6394-4e28-965b-c71383ff04bf",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„Dennoch habe die Schlechtigkeit dieser Mönchen derart zugenommen, dass sie alle über das Klostervermögen völlig eigenmächtig verfügt hätten und das Kloster infolgedessen fast zur Einöde geworden sei.“"
                                            },
                                            {
                                                "example_id": "510eba3d-3e89-40b2-b00e-060a4edb5cc9",
                                                "sense_id": "2ad97c51-dd05-37cc-986d-867ea5ad3f34",
                                                "text": "„In seinen Augen gab es kein Arbeitsgebiet, das nicht mit Schlechtigkeit und Trug durchsetzt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fd3aaf3-76e6-4b5a-8bec-4861cd27a906",
                        "source_entry_id": "6c7e3f86-da5f-36bf-8f5f-774e83972917",
                        "source_sense_id": "57178eba-95ee-3e00-8f45-4a723e575c12",
                        "source_sense_description": "Schlechtigkeit, Bosheit, Bösartigkeit",
                        "target_lang_word": "Bosheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bosheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                        "entry_id": "4348ccad-a0a3-31fd-bd52-b715c7f34fd8",
                                        "glosses": [
                                            "böse, schlechte Gesinnung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd20881-7bc2-40e8-93c5-4d62b024e8a3",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "Er war ein Mensch voller Bosheit, viele sind ihm aus dem Weg gegangen."
                                            },
                                            {
                                                "example_id": "650cdccc-152a-48ce-8387-6d687c4e6f08",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Sloan antwortete, dass Bosheit zweifellos eine wirkungsvolle Kraft sei.“"
                                            },
                                            {
                                                "example_id": "d681fd81-1410-41d1-91e9-570908b43c18",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Selbst Menschen, die ihm früher mit Bosheit und unverhohlener Feindseligkeit begegnet waren, zeigten sich jetzt zärtlich und liebevoll.“"
                                            },
                                            {
                                                "example_id": "4210692c-e154-4651-a85b-7176409d1d1a",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Die Dummheit einer Dienerin ist viel gefährlicher als ihre Bosheit und belastet den Herrn weit mehr, denn eine Bösartige kann man mit Recht bestrafen, eine Dumme aber nicht; man kann sie nur fortschicken und sich damit abfinden.“"
                                            },
                                            {
                                                "example_id": "689184f2-ebe6-44de-a219-2a3771372e61",
                                                "sense_id": "911c3941-db7e-3320-9bf9-8efd5e751472",
                                                "text": "„Es war nicht Roheit oder Bosheit gewesen, die dem jungen Seemann die unbesonnene Frage auf die Zunge gebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                        "entry_id": "4348ccad-a0a3-31fd-bd52-b715c7f34fd8",
                                        "glosses": [
                                            "boshafte Tat; böser Scherz; boshafte Aussage; abfällige, stichelnde, verletzende Bemerkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f28e61-6c52-40e3-81c4-d59848f327d9",
                                                "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                                "text": "Das war eine Bosheit von ihr, mich so vor der Versammlung bloßzustellen."
                                            },
                                            {
                                                "example_id": "4bde873f-ab78-42aa-ad70-496f3c0e1f96",
                                                "sense_id": "267309af-ad33-3ee2-9c1c-0c11df17dc11",
                                                "text": "Immer, wenn keiner von den Anderen es hören konnte, warf er ihr Bosheiten zu, um sie zu ärgern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b95194ea-90d7-4223-917c-8d174b728306",
                        "source_entry_id": "6c7e3f86-da5f-36bf-8f5f-774e83972917",
