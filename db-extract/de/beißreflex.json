                    }
                ],
                "senses": [
                    {
                        "sense_id": "22b1ac26-1c6c-34f4-91aa-136ba2db2559",
                        "entry_id": "8280ece4-6711-3851-a4ce-0eda6f0b1e37",
                        "glosses": [
                            "instinktive, rhythmische Auf- und Abbewegungen des Unterkiefers bei menschlichen Säuglingen, die durch Stimulation der Kiefer ausgelöst werden und zu den Reflexen der Nahrungsaufnahme bei Kleinkindern gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af36b163-be46-4d72-bc0d-6f5de68467f3",
                                "sense_id": "22b1ac26-1c6c-34f4-91aa-136ba2db2559",
                                "text": "„Der Beißreflex ist schon in der 28. Schwangerschaftswoche (p.m.) vorhanden und sollte bis zum 10. Lebensmonat nicht mehr nachweisbar sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8c55c62-1097-3368-a746-84dc3dd1efa3",
                        "entry_id": "8280ece4-6711-3851-a4ce-0eda6f0b1e37",
                        "glosses": [
                            "Bezeichnung für das Verhalten von Fischen, das dazu führt einen Köder zu schlucken"
                        ],
                        "tags": [
                            "Angelsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d80248a1-dae4-4ebd-8414-65d9465c7bc7",
                                "sense_id": "e8c55c62-1097-3368-a746-84dc3dd1efa3",
                                "text": "„Viele Huchen kennen also keine Neunaugen mehr. Und trotzdem fangen die Imitate aus Gummi immer noch, wohl weil die verführerischen Bewegungen der Weichplastik-Zöpfe den Beißreflex auslösen.“"
                            },
                            {
                                "example_id": "2da55e80-a6b2-4369-bd94-94322aeb4e81",
                                "sense_id": "e8c55c62-1097-3368-a746-84dc3dd1efa3",
                                "text": "„Schlüsselreize sind Reize welche beim Fisch, gesteuert durch das Erkennen eines prinzipiellen Beuteschemas einen Beißreflex bzw. Jagdtrieb auslösen, dem Fisch genetisch bedingt nicht oder nur schwer widerstehen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ee2e92ab-b0fa-377b-9ce9-49fe3c0c0eef",
                        "entry_id": "8280ece4-6711-3851-a4ce-0eda6f0b1e37",
                        "glosses": [
                            "augenblickliche, unreflektierte und unter Umständen ungerechtfertigte Ablehnung von Meinungen oder Personen (aufgrund von Vorurteilen oder parteiischen Standpunkten)"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "85a419f9-d270-478f-abd4-e4822bcaa8d4",
                                "sense_id": "ee2e92ab-b0fa-377b-9ce9-49fe3c0c0eef",
                                "text": "„In den letzten Jahren mit Berlusconi hat man in Deutschland geradezu einen Beißreflex entwickelt. Genau hingeschaut hat keiner mehr.“"
                            },
                            {
                                "example_id": "66a0133a-a0c1-4be2-a28a-99a48e3ef256",
                                "sense_id": "ee2e92ab-b0fa-377b-9ce9-49fe3c0c0eef",
                                "text": "„Vor allem ihre Aussage, die Zeiten seien vorbei, in denen Männer per se mächtiger waren und als Alphatierchen daherkamen, löste bei einigen Parteikollegen Beißreflexe aus.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
