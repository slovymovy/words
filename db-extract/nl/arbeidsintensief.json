                                                "example_id": "2077f54e-7635-4f0b-8d5d-257663d73989",
                                                "sense_id": "29b55085-509f-3481-a338-1c3eeab36b96",
                                                "text": "Picking beans is a very labor-intensive activity, there's no machine made that can do it."
