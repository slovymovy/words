                ],
                "senses": [
                    {
                        "sense_id": "d1751b51-dbd5-31bd-814e-d79a8f2f657b",
                        "entry_id": "b6d3d85f-e964-3b61-a6eb-96c44cb26f82",
                        "glosses": [
                            "Ne pas apprécier ; ne pas aimer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f13fdac2-6cb7-4bb5-89ca-f7c766dfd57b",
                                "sense_id": "d1751b51-dbd5-31bd-814e-d79a8f2f657b",
                                "text": "Dieu homme a voulu qu'on, fût libre , même de le méconnoître et d’inapprécier sa charité infinie , tant il ménage les droits de la liberté humaine !"
                            },
                            {
                                "example_id": "e52a03cd-74c4-4d6f-be1e-85938397c6ec",
                                "sense_id": "d1751b51-dbd5-31bd-814e-d79a8f2f657b",
                                "text": "Le gracieuse négligence, la hardiesse naïve de la Fontaine furent inappréciées par le grand roi ; mais le froid et correct Boileau donna à la poésie des préceptes tels que Louis les auraient donnés lui-même"
                            }
                        ]
                    },
                    {
                        "sense_id": "93e2d90d-bdf0-381b-bfc3-4eb0a2d44c8d",
                        "entry_id": "b6d3d85f-e964-3b61-a6eb-96c44cb26f82",
                        "glosses": [
                            "Ne pas apprécier ; ne pas ressentir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "eaa5241e-749c-4c94-a431-e5d1c3f5eb9c",
                                "sense_id": "93e2d90d-bdf0-381b-bfc3-4eb0a2d44c8d",
                                "text": "C'est ainsi que la muqueuse et la peau ne peuvent plus apprécier les changements de température, et que le contact direct des boissons et des corps solides sont inappréciés."
                            }
                        ]
                    }
                ],
