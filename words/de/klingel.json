                {
                    "sense_id": "94d96223-aa31-3a5f-921a-56b066e116d1",
                    "sense_definition": "Elektrisches oder mechanisches Signalgerät zur Erzeugung eines akustischen Hinweises, beispielsweise an einer Haustür oder an einem Fahrrad",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "signalgeraet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Postbote drückte ungeduldig auf die <w>Klingel</w>, weil das Paket sehr schwer war."
                        },
                        {
                            "text": "An meinem alten Fahrrad ist die <w>Klingel</w> leider kaputtgegangen."
                        }
                    ],
                    "synonyms": [
                        "Schelle",
                        "Glocke"
                    ],
                    "common_phrases": [
                        "auf die Klingel drücken",
                        "an der Klingel läuten"
                    ]
                },
                {
                    "sense_id": "f69e9574-9ccc-3316-83c9-75e279812b4d",
                    "sense_definition": "Kleine Handglocke mit beweglichem Klöppel im Inneren, die manuell geschüttelt wird",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "handglocke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lehrer schüttelte eine silberne <w>Klingel</w>, um die Aufmerksamkeit der Schüler zu gewinnen."
                        },
                        {
                            "text": "Die Lehrerin läutete mit einer kleinen <w>Klingel</w>, und die Pause war vorbei."
                        }
                    ],
                    "synonyms": [
                        "Glöckchen",
                        "Handglocke",
                        "Tischglocke"
                    ],
                    "common_phrases": [
                        "mit der Klingel läuten"
                    ]
                }
            ]
        }
