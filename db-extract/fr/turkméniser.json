                "senses": [
                    {
                        "sense_id": "6f1dd585-3323-3253-83b0-f73980f2d194",
                        "entry_id": "6223a853-5c1c-3163-9012-01b77dd48f80",
                        "glosses": [
                            "Donner un caractère turkmène à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4652a04f-bf6b-40dd-ac10-2271bd4e71dd",
                                "sense_id": "6f1dd585-3323-3253-83b0-f73980f2d194",
                                "text": "Ce cirque de l’ère soviétique aux airs de soucoupe volante a été “turkménisé” par l’ajout d’un revêtement de marbre blanc."
                            },
                            {
                                "example_id": "e4ba6ad4-d68e-41f2-879b-d999afeed82b",
                                "sense_id": "6f1dd585-3323-3253-83b0-f73980f2d194",
                                "text": "Avec la proclamation de l'indépendance, les autorités du Turkménistan ont mené une campagne massive pour renommer et «turkméniser» les noms des colonies."
                            },
                            {
                                "example_id": "2cbc0478-84fc-4185-abb1-c61757cec7a2",
                                "sense_id": "6f1dd585-3323-3253-83b0-f73980f2d194",
                                "text": "Les descendants des esclaves iraniens, capturés jusqu'à l'arrivée des Russes en 1878, se sont turkménisés, mais restent exclus du système tribal."
                            }
                        ]
                    }
