                "senses": [
                    {
                        "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                        "entry_id": "e27b433d-b829-383a-8b72-1c5d32763066",
                        "glosses": [
                            "kleine, schlichte (zumeist illegale) Schankwirtschaft; in einem Armenviertel in einer Wellblechhütte oder einer anderen einfachen Behausung befindlicher Ausschank mit Alkohollizenz"
                        ],
                        "tags": [
                            "Austrian German",
                            "Germany",
                            "Swiss Standard German",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7c6f9e1b-d18b-42cb-8c77-9b12016f5efd",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Sie fährt in die profitträchtigen Goldminen, wo die Schwarzen preußisch stramm mit ihren Schaufeln exerzieren müssen, ehe sie zu arbeiten beginnen, in die verborgenen Spelunken, die ‚Shebeens‘, in denen sich die zerlumpten Mohren das zuführen, was laut Gesetz für die Weißen reserviert ist: Schnaps.“"
                            },
                            {
                                "example_id": "16b6aa5b-bf28-4a62-b953-0416173fb301",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„In dem Township, in dem ich wohne, gibt es Tausende Shebeens. Man braucht ein größeres Haus und mindestens ein Zimmer für den Shebeen.“"
                            },
                            {
                                "example_id": "310cc7eb-52c0-4578-852f-7ef2969ba9b1",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Viele von ihnen haben einst im Untergrund angefangen – die Frauen etwa, die Bier brauten für die Shebeens, die verbotenen Hinterhofkneipen.“"
                            },
                            {
                                "example_id": "b7e5dff7-1af0-4b0b-94f9-58737f0ed59a",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Die Touristen bekommen eine Shebeen, eine traditionelle Kneipe der Schwarzen, gezeigt und können an einem der Märkte aussteigen, wo Frauen Früchte, Eier und Altkleider verkaufen.“"
                            },
                            {
                                "example_id": "1c2384de-ab58-4a0b-88b0-5ced5f522ca4",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„ Neben kleineren, meist informell betriebenen Autowasch-Firmen prägen vor allem kleine Restaurants, Straßenstände und Shebeens das Straßenbild.“"
                            },
                            {
                                "example_id": "abe55a51-342d-4090-9336-8aab539f720c",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Während der Tour ins Township (Armenviertel), werden eine Schule und ein Shebeen (typisches Beisl) besucht.“"
                            },
                            {
                                "example_id": "f1c2df2c-5738-4208-9224-da1d5a9188c5",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Jo öffnet die Tür eines Shebeens.“"
                            },
                            {
                                "example_id": "d399534d-1bb8-43e1-85a5-fe74939aa56e",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Zu sehen gibt es Felsbilder der Ureinwohner San, aber auch Dinge der modernen Zivilisation, wie z.B. Shebeens (Bierkneipen der schwarzen Bevölkerungsschicht) und Squatter Camps (Slums).“"
                            },
                            {
                                "example_id": "8c43617d-05df-423a-a955-046813460e48",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Das Shebeen, die Bierschwemme, liegt direkt gegenüber, das Bier kostet einen Franken, und man muss hier wirklich keine Sorge haben, keinen Kontakt zur lokalen Bevölkerung zu bekommen.“"
                            },
                            {
                                "example_id": "ce1538b3-9fa8-4add-a748-af95e711a381",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Die Einschätzung Thulisiles wird von Wejekazi Mbotho geteilt, die in ihrer Hütte eine Schankstätte, eine Shebeen, betreibt. […] Mbothos Shebeen wurde zuletzt vor Weihnachten überfallen und ausgeraubt.“"
                            },
                            {
                                "example_id": "b978e62e-800d-4813-a8d2-9555bf8cdef9",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Die meisten kehren anschliessend in ein «Shebeen» ein, wie die einst illegalen Hinterhofkneipen hier heissen.“"
                            },
                            {
                                "example_id": "ba66b9b8-1a13-4686-ac74-991fb0decb83",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Die Windhoeker Stadtverwaltung will ab Januar nächsten Jahres sämtliche so genannte Shebeens in der Hauptstadt schließen, deren Betreiber bis dahin keine Gewerbelizenz vorweisen können.“"
                            },
                            {
                                "example_id": "dab03fd1-a19f-471d-a503-a25e933a91d9",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Diese Bestimmungen schreiben unter anderem vor, dass der Betreiber einer Shebeen auch Eigentümer des Etablissements sein und dauerhaft auf dem Grundstück wohnen muss, auf dem dieses steht.“"
                            },
                            {
                                "example_id": "26980d7c-3c4f-4f18-b7d8-48cc567ebc1e",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Dazu gehört unter anderem, dass die Shebeen mindestens eine Toilette haben und in einem angemessenen Abstand zu umliegenden Schulen und Kirchen liegen muss.“"
                            },
                            {
                                "example_id": "0421a1af-4ed8-4767-a303-713821923510",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„In der vergangenen Woche hatte die Polizei in Walvis Bay bei einer Razzia etliche illegale Shebeens geschlossen und den Alkohol beschlagnahmt.“"
                            },
                            {
                                "example_id": "50655384-c779-4913-b0c6-1c3549eba1f4",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Ich erinnere mich noch an einen Tag, an dem eine Delegation mit Bischof Kameeta in den Ort kam. Alle Shebeens hatten plötzlich geschlossen. Kaum hat er den Ort am Nachmittag wieder verlassen, wurden die Shebeens wieder geöffnet.“"
                            },
                            {
                                "example_id": "bea5eece-8961-4a4a-b6bb-c1904a3db905",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Nachdem ihr Mann das Kind abgeholt habe, sei sie zu einem anderen Shebeen gelaufen, wo sie auf den Angeklagten getroffen sei.“"
                            },
                            {
                                "example_id": "589caf03-b002-42fd-a213-954a0b9fd8d8",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Insbesondere geht es um die landesweit verbreiteten, sich ständig vermehrenden Shebeens, Barackenbars, Cuca Shops, Pinten und Kaschemmen, wie sie auch immer benannt werden mögen.“"
                            },
                            {
                                "example_id": "41c6df99-c1c2-4177-b05f-db05584c0b54",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Nach seiner Festnahme hatte der Polizist nach eigenen Angaben eine gestohlene Pistole, einen Bolzenschneider und eine zuvor aus der Shebeen entwendete Kasse bei Kashawa sichergestellt.“"
                            },
                            {
                                "example_id": "92305285-7c7c-4872-9e0b-a80d61808a98",
                                "sense_id": "a974ba4d-0b0c-340c-b30b-0fdbd35b2d0e",
                                "text": "„Beim bewaffneten Raubüberfall von vier Personen auf eine Trinkstube (Shebeen) ist eine Person ums Leben gekommen - von den Angreifern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
