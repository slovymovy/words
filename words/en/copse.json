{
    "word_family": [
        "coppice"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "859109f2-39d8-31b7-b11b-3bf67a41e82b",
                    "sense_definition": "A dense growth or small group of small trees or bushes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "woodland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>copse</w> of birch trees stood at the edge of the field.",
                            "target_lang_translations": {
                                "de": "Ein kleines <w>Birkengestrüpp</w> stand am Rande des Feldes."
                            }
                        },
                        {
                            "text": "We walked past the little <w>copse</w> on our way back to the village.",
                            "target_lang_translations": {
                                "de": "Auf unserem Weg zurück ins Dorf gingen wir an dem kleinen <w>Gehölz</w> vorbei."
                            }
                        }
                    ],
                    "synonyms": [
                        "thicket"
                    ],
                    "common_phrases": [
                        "little copse"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein dichter Bewuchs oder eine kleine Gruppe aus niedrigen Bäumen oder Büschen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dickicht",
                                "target_lang_sense_clarification": "dichtes Buschwerk oder Gestrüpp"
                            },
                            {
                                "target_lang_word": "Gebüsch",
                                "target_lang_sense_clarification": "Ansammlung von Sträuchern und kleinen Bäumen"
                            },
                            {
                                "target_lang_word": "Gehölz",
                                "target_lang_sense_clarification": "kleine Gruppe von Bäumen und Sträuchern"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cb9a0e8-85d7-3031-9f95-18665ca96a73",
                    "sense_definition": "An area of woodland that is managed by periodically cutting trees back to stump level.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woodland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The estate maintained a traditional hazel <w>copse</w> to supply building materials.",
                            "target_lang_translations": {
                                "de": "Das Gut unterhielt einen traditionellen Haselnuss-<w>Niederwald</w>, um Baumaterial bereitzustellen."
                            }
                        },
                        {
                            "text": "Forestry workers periodically harvest wood from the ancient <w>copse</w>.",
                            "target_lang_translations": {
                                "de": "Forstarbeiter schlagen regelmäßig Holz in dem alten <w>Schlagwald</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "coppice"
                    ],
                    "common_phrases": [
                        "hazel copse"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Waldstück, das regelmäßig zur Holzgewinnung bis auf den Stock zurückgeschnitten wird."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Niederwald",
                                "target_lang_sense_clarification": "forstwirtschaftliche Bewirtschaftungsform mit Stockausschlag"
                            },
                            {
                                "target_lang_word": "Schlagwald",
                                "target_lang_sense_clarification": "periodisch abgeholzter Wald"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0313a6f6-ed01-32ab-9c10-b49208b60299",
                    "sense_definition": "A small woodland area or woodlot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "woodland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several deer vanished into the shadowy <w>copse</w> before we could take a photo.",
                            "target_lang_translations": {
                                "de": "Mehrere Rehe verschwanden im schattigen <w>Wäldchen</w>, bevor wir ein Foto machen konnten."
                            }
                        },
                        {
                            "text": "The path curved around an isolated <w>copse</w> near the bottom of the valley.",
                            "target_lang_translations": {
                                "de": "Der Pfad schlängelte sich um ein einzeln stehendes <w>Gehölz</w> nahe dem Talgrund."
                            }
                        }
                    ],
                    "synonyms": [
                        "wood",
                        "woods"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines Waldstück oder Wäldchen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Wäldchen",
                                "target_lang_sense_clarification": "kleiner Wald"
                            },
                            {
                                "target_lang_word": "Gehölz",
                                "target_lang_sense_clarification": "kleine Waldfläche"
                            },
                            {
                                "target_lang_word": "Hain",
                                "target_lang_sense_clarification": "kleines, oft lichteres Waldstück"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de342a53-dd02-322e-97a5-65cfeb74b3d1",
                    "sense_definition": "To trim or cut trees back to stimulate new growth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forestry_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forester will <w>copse</w> the overgrown hedge during the late autumn months.",
                            "target_lang_translations": {
                                "de": "Der Förster wird die überwucherte Hecke in den Spätherbstmonaten <w>auf den Stock setzen</w>."
                            }
                        },
                        {
                            "text": "They decided to <w>copse</w> the willows along the river bank every few years.",
                            "target_lang_translations": {
                                "de": "Sie beschlossen, die Weiden entlang des Flussufers alle paar Jahre <w>zurückzuschneiden</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Bäume oder Sträucher auf den Stock setzen, um neues Wachstum anzuregen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auf den Stock setzen",
                                "target_lang_sense_clarification": "bis nahe an den Boden zurückschneiden"
                            },
                            {
                                "target_lang_word": "kappen",
                                "target_lang_sense_clarification": "stark zurückschneiden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc807433-c9cd-3431-b31a-a19fa19fa7a8",
                    "sense_definition": "To plant, enclose, or preserve an area of woodland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forestry_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Landowners sought to <w>copse</w> the common ground to prevent cattle from grazing.",
                            "target_lang_translations": {
                                "de": "Landbesitzer versuchten, das Gemeindeland <w>einzuhegen</w>, um das Weiden von Vieh zu verhindern."
                            }
                        },
                        {
                            "text": "Efforts to <w>copse</w> native trees helped restore the degraded landscape.",
                            "target_lang_translations": {
                                "de": "Bemühungen, einheimische Bäume <w>anzupflanzen und zu schützen</w>, halfen dabei, die degradierte Landschaft wiederherzustellen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically regarding forestry and land management"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Waldstück oder Gehölz anpflanzen, einzäunen oder hegen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "einzäunen",
                                "target_lang_sense_clarification": "Gehölz zum Schutz abgrenzen"
                            },
                            {
                                "target_lang_word": "hegen",
                                "target_lang_sense_clarification": "Wald schonend bewirtschaften und pflegen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}