                ],
                "senses": [
                    {
                        "sense_id": "4ea6bc1f-b2ea-3348-a554-ec1c6ac4e442",
                        "entry_id": "b6f4d1b8-7bc5-3cd6-906d-12faf2df32ff",
                        "glosses": [
                            "Qui peut se putréfier ; qui peut pourrir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "472935b9-a931-435e-a0b6-f6d3f9155fe4",
                                "sense_id": "4ea6bc1f-b2ea-3348-a554-ec1c6ac4e442",
                                "text": "Plus la substance mise en expérience est putrescible, plus vite a lieu l'apparition des infusoires."
                            },
                            {
                                "example_id": "6fa5a988-76ef-4abb-b9ba-8efbcf64717d",
                                "sense_id": "4ea6bc1f-b2ea-3348-a554-ec1c6ac4e442",
                                "text": "Elle avait des bas jaunes, une jupe courte (il faut bien suivre la mode) d’un vert cadavérique et putrescible, un corsage d’un marron nauséeux et taché de rondelles poisseuses, comme si elle l’avait acheté avec du sucre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a25f5f9-b557-4d0e-bb96-afae018a51db",
                        "source_entry_id": "b6f4d1b8-7bc5-3cd6-906d-12faf2df32ff",
                        "source_sense_id": "4ea6bc1f-b2ea-3348-a554-ec1c6ac4e442",
                        "target_lang_word": "putrescible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "putrescible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b565cb81-b442-39ad-87a4-c99290ef5a6e",
                                        "entry_id": "8d3dd42b-af0f-3c2e-884f-cfb2ac2c7ab2",
                                        "glosses": [
                                            "Decomposable; capable of becoming putrescent; rottable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ddfb9b-5dd4-451c-9fc1-2716251b99a2",
                                                "sense_id": "b565cb81-b442-39ad-87a4-c99290ef5a6e",
                                                "text": "The burying of wood in water, which dissolves out or alters its putrescible constituents, has long been practised as a means of seasoning."
                                            },
                                            {
                                                "example_id": "55e3312b-f470-4018-9adc-1d8919ee3f5c",
                                                "sense_id": "b565cb81-b442-39ad-87a4-c99290ef5a6e",
                                                "text": "For waste that is putrescible or may be infectious, on-site incineration is ideal."
                                            },
                                            {
                                                "example_id": "e0ae4542-aeaf-40c7-8d10-b6511cdde7f5",
                                                "sense_id": "b565cb81-b442-39ad-87a4-c99290ef5a6e",
                                                "text": "Some of the storefronts that sell dried clams and sea urchins and putrescible vegetables give it a kind of squalid character.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
