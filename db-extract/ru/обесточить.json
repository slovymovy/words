                        "target_lang_word": "stroom",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stroom",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "902a59d5-ed49-359d-aac8-1fe7f4da0811",
                                        "entry_id": "195bae30-186f-35dd-912d-e662a94944c3",
                                        "glosses": [
                                            "rivier, beek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e7250a0-911b-47e5-9550-9382fdef6b91",
                                                "sense_id": "902a59d5-ed49-359d-aac8-1fe7f4da0811",
                                                "text": "Bij donker woud en brede stromen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d69c530-fe92-3bf8-a5f9-67b631886243",
                                        "entry_id": "195bae30-186f-35dd-912d-e662a94944c3",
                                        "glosses": [
                                            "elektrische stroom, het transport van elektrische lading door de beweging van elektronen door geleiders en halfgeleiders onder invloed van een potentiaalverschil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a470d4d-e15b-441a-bb18-4fe631f9d22e",
                                                "sense_id": "8d69c530-fe92-3bf8-a5f9-67b631886243",
                                                "text": "We zitten zonder stroom, dat wordt geen accu opladen vandaag."
                                            },
                                            {
                                                "example_id": "64e1d4cf-a1eb-4a9f-82c4-0a7dfe55a83a",
                                                "sense_id": "8d69c530-fe92-3bf8-a5f9-67b631886243",
                                                "text": "Er hingen nog lampen met gaskousjes en om ons van stroom te voorzien werd er via een elektriciteitskabel vanaf de straat een voorlopige voorziening getroffen."
                                            },
                                            {
                                                "example_id": "c68b717f-f482-41f9-80ba-1be24f5f0fc6",
                                                "sense_id": "8d69c530-fe92-3bf8-a5f9-67b631886243",
                                                "text": "Dat moet de elektriciteitsdraad zijn geweest die ons van stroom voorzag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ba74b90-b658-3df4-994e-13f433a7c920",
                                        "entry_id": "195bae30-186f-35dd-912d-e662a94944c3",
                                        "glosses": [
                                            "in bepaalde richting bewegende massa, zoals een groep mensen, dieren, andere objecten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c6c7d1-0867-43cd-aba2-dc9d2d31c358",
                                                "sense_id": "3ba74b90-b658-3df4-994e-13f433a7c920",
                                                "text": "Tegen de stroom in lopen."
                                            },
                                            {
                                                "example_id": "bda3ea64-dbf7-40d2-8682-183b2d975bdd",
                                                "sense_id": "3ba74b90-b658-3df4-994e-13f433a7c920",
                                                "text": "Achter het lichaam van de jongen voelde ze een oceaan, weids en zwart en kolkend, en ze zag wat hij niet zag - dat er een reusachtige golf aan kwam, een dreigende muur van water, klaar om zijn leven voor de tweede keer te verwoesten en het hare in een stroom van Bijbelse omvang mee te sleuren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f5c3a6-d432-34cd-bf3a-b478e5716464",
                                        "entry_id": "195bae30-186f-35dd-912d-e662a94944c3",
                                        "glosses": [
                                            "in bepaalde richting bewegende massa niet materiële zaken"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8643f9a-53e4-469d-9d80-9681e30b7efd",
                                                "sense_id": "62f5c3a6-d432-34cd-bf3a-b478e5716464",
                                                "text": "Ze werkte aan kleinere doeken en krabbelde het ene na het andere schetsboekje vol met tekeningen; het was alsof er een luik was opengegaan - waar dat luik op uitkwam, wist ze niet precies - en hoewel ze doodsbang was dat deze stroom van inspiratie zou opdrogen, had ze ook het gevoel dat ze misschien eeuwig door zou kunnen gaan zolang Isaac in de buurt was, en zij er klaar voor was, klaar voor hem."
                                            }
                                        ]
                                    }
                                ]
                            },
