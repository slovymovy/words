                "senses": [
                    {
                        "sense_id": "78b8b0a4-d4fd-3e30-9508-b153c7828df6",
                        "entry_id": "c3f122ee-60b8-36a4-b3a5-dffc8fd5cacf",
                        "glosses": [
                            "typewritten material, especially such a copy of a manuscript"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ca700e-cc92-4428-a588-757e83bbff36",
                                "sense_id": "78b8b0a4-d4fd-3e30-9508-b153c7828df6",
                                "text": "The whole production, which consists of 16 typescript pages contained in a decorative stiff cover, forms a pleasant reminder of the conditions in which the railway enthusiast was able to pursue his hobby before the recent war."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35ca008e-2f83-4383-81ab-9e0ccecf5288",
                        "source_entry_id": "c3f122ee-60b8-36a4-b3a5-dffc8fd5cacf",
                        "source_sense_id": "78b8b0a4-d4fd-3e30-9508-b153c7828df6",
                        "source_sense_description": "typewritten material, especially such a copy of a manuscript",
                        "target_lang_word": "strojopis",
