                "senses": [
                    {
                        "sense_id": "36b82a4b-91e3-33cc-b708-526ed61f40b4",
                        "entry_id": "edfc8c52-99ac-3891-bc5e-32ac4a863a0e",
                        "glosses": [
                            "The pancreas or thymus gland of an animal, especially a lamb or calf, as food."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5179e1c-f6d6-43a0-b9db-11a3a1fdb648",
                                "sense_id": "36b82a4b-91e3-33cc-b708-526ed61f40b4",
                                "text": "SWEETBREAD SANDWICH: Cook sweetbreads until tender. When cold, remove skin, chop fine, season with salt and pepper, add one cup of finely chopped celery, and a dash of mayonnaise dressing; spread on thin slices of lightly buttered white bread. Cover with another slice and garnish with an olive."
                            },
                            {
                                "example_id": "3e14b9a1-8667-4ba6-b003-fb5172b474fb",
                                "sense_id": "36b82a4b-91e3-33cc-b708-526ed61f40b4",
                                "text": "The pancreas of an animal when cooked for consumption is known as a sweetbread."
                            }
                        ]
                    },
                    {
                        "sense_id": "c826cd23-8bba-39ea-a68d-ef998f41633b",
                        "entry_id": "edfc8c52-99ac-3891-bc5e-32ac4a863a0e",
                        "glosses": [
                            "Any of various other glands used as food, including the parotid gland, sublingual glands, ovaries, and testicles."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
