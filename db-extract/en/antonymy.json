                        "source_sense_description": "semantic relation between antonyms",
                        "target_lang_word": "antonymie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antonymie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e65cd15-5ee9-3de9-9201-bb2767fb1727",
                                        "entry_id": "df7ccdcb-e6be-3dfa-b93f-dc90288de215",
                                        "glosses": [
                                            "Caractère des mots qui sont de sens contraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e000c97-c3b4-4cb0-9087-b50b8fc2e512",
                                                "sense_id": "1e65cd15-5ee9-3de9-9201-bb2767fb1727",
                                                "text": "Comme pour les relations de synonymie, on ne peut parler de relations dʼantonymie que pour les expressions en usage au sein dʼune même communauté géographique de francophones."
                                            },
                                            {
                                                "example_id": "ef620516-5c4c-43d1-852f-84b6f0fba8dc",
                                                "sense_id": "1e65cd15-5ee9-3de9-9201-bb2767fb1727",
                                                "text": "L’incohérence du groupe des « animaux » est masquée par sa relation d’antonymie avec le groupe des humains, beaucoup plus homogène puisque regroupant des individus d’une seule espèce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e504a765-ddf1-4ad9-8e06-d5412100262a",
                        "source_entry_id": "df38abc1-1db5-37a5-8e88-3a9deeb11d06",
                        "source_sense_id": "9a6e0f9e-6b63-3cbc-be1c-05d873bba58f",
                        "source_sense_description": "semantic relation between antonyms",
                        "target_lang_word": "Antonymie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antonymie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e747db8-a20f-329f-a892-bd60055fc43d",
                                        "entry_id": "a2fa4bbb-f975-3868-91a0-7d1aeca38548",
                                        "glosses": [
                                            "semantische Beziehung zwischen Wörtern, die gegensätzliche Bedeutungen aufweisen (Antonyme)."
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d292cacb-f07b-4fec-9553-572431ee97ec",
                                                "sense_id": "7e747db8-a20f-329f-a892-bd60055fc43d",
                                                "text": "Zwischen den Wörtern schwarz und weiß besteht die Bedeutungsbeziehung der Antonymie."
                                            },
                                            {
                                                "example_id": "9b3f6b64-c6b6-4949-af52-2dd3c154a2c1",
                                                "sense_id": "7e747db8-a20f-329f-a892-bd60055fc43d",
                                                "text": "„Schließlich sind auch die semantischen Relationen im Wortschatz, wie Synonymie, Antonymie, Hierarchiebeziehungen unter soziolinguistischem Aspekt zu betrachten…“"
                                            },
                                            {
                                                "example_id": "cc6bc943-ef4b-4a11-9672-7bf48c8a1b99",
                                                "sense_id": "7e747db8-a20f-329f-a892-bd60055fc43d",
                                                "text": "„Zu den paradigmatischen Angaben gehören unter anderen Synonymie, Antonymie, Hyponymie, Hyperonymie, Komplenymie und Meronymie.“"
                                            },
                                            {
                                                "example_id": "32481c45-7b5c-4fa3-b453-508974542fab",
                                                "sense_id": "7e747db8-a20f-329f-a892-bd60055fc43d",
                                                "text": "„Semantische Verwandlung, im Extremfalle bis hin zur semantischen Antonymie, ist im Funktionszusammenhang einer Geheimsprache als zusätzliche Absicherung zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
