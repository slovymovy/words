                                                "sense_id": "75bdec7b-d45e-36c9-97e1-60cb7e98391a",
                                                "text": "Mrs. Hope was, we believe, a convert to the Roman Catholic Church, and neither she nor her editor conceals the fact that they hold a brief for the Pope and for Catharine against Henry VIII."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08b578c4-471e-309f-a9bc-db991da39683",
                                        "entry_id": "09986738-932a-3abb-81ad-491cf30c1b53",
                                        "glosses": [
                                            "An attorney's legal argument in written form for submission to a court."
                                        ],
                                        "tags": [],
