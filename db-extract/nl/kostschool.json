                                        "examples": [
                                            {
                                                "example_id": "da605163-02b6-4b30-9ade-ac42669a53d2",
                                                "sense_id": "02ccad41-efee-3a70-aa13-4858fbf79c15",
                                                "text": "water sanctified by Christ's institute"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                        "entry_id": "9073534d-44c7-3d5c-8c3d-d51876edfee3",
                                        "glosses": [
                                            "That which is instituted, established, or fixed, such as a law, habit, or custom."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9916bbc-f3f2-402c-98f9-55c51ae059ae",
                                                "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                                "text": "They made a sort of institute and digest of anarchy."
                                            },
                                            {
                                                "example_id": "24cb6a7e-5889-4505-8d16-ec97a42206ad",
                                                "sense_id": "b1d29cb6-4d82-3ed8-ad4f-14f3d0fde17a",
                                                "text": "to make the Stoic institutes thy own"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5301919-6121-3d89-acd9-584efce7f72f",
                                        "entry_id": "9073534d-44c7-3d5c-8c3d-d51876edfee3",
                                        "glosses": [
                                            "The person to whom an estate is first given by destination or limitation."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deec2568-c85e-4bbc-b55e-8f02987b241b",
                                                "sense_id": "b5301919-6121-3d89-acd9-584efce7f72f",
                                                "text": "Substitution is the nomination of substituted heirs, who take place, failing the institute."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "institute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To begin or initiate (something); to found."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5324a95f-2878-41d4-9750-848840f8fff2",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "He instituted the new policy of having children walk through a metal detector to enter school."
                                            },
                                            {
                                                "example_id": "24ad802f-cddf-48bf-96ff-e12122f3b1d4",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "And haply institute / A course of learning and ingenious studies."
                                            },
                                            {
                                                "example_id": "746316c9-3478-4ce3-9d80-88687f2b214e",
                                                "sense_id": "041c0a83-5475-34d5-90e3-89b7a0c92262",
                                                "text": "Whenever any form of government becomes destructive of these ends it is the right of the people to alter or to abolish it, and to institute a new government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To train, instruct."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ce83bf-e7f9-4179-ae68-f2675b8ee277",
                                                "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                                "text": "Publius was the first that ever instituted the Souldier to manage his armes by dexteritie and skil, and joyned art unto vertue, not for the use of private contentions, but for the wars and Roman peoples quarrels."
                                            },
                                            {
                                                "example_id": "d43dc96f-74b0-4f1f-a08b-5a1322e0da49",
                                                "sense_id": "7f607452-7ca5-382a-9d73-9ca076946169",
                                                "text": "If children were early instituted, knowledge would insensibly insinuate itself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb41909-86c1-3f43-8e24-955f86cee44c",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To nominate; to appoint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e1de496-b534-40e8-a905-debce0eb2087",
                                                "sense_id": "bcb41909-86c1-3f43-8e24-955f86cee44c",
                                                "text": "We institute your Grace / To be our regent in these parts of France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a43d98c-608d-3b91-b4dc-9f94891da79a",
                                        "entry_id": "08bc7b42-b332-3d05-9e75-e8edceb138ce",
                                        "glosses": [
                                            "To invest with the spiritual charge of a benefice, or the care of souls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63730f8f-e1a6-4ae5-9084-fef78ca4afd8",
                                                "sense_id": "1a43d98c-608d-3b91-b4dc-9f94891da79a",
                                                "text": "a writ issued to the bishop, to institute the clerk of that patron"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "institute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "568a07d0-81e4-30d3-b496-fd6d348dd58d",
                                        "entry_id": "290d9860-0bbc-31b7-b6f6-944443c1f8b4",
                                        "glosses": [
                                            "Established; organized; founded."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1653a0fe-2272-40b0-b082-08fffc84826a",
                                                "sense_id": "568a07d0-81e4-30d3-b496-fd6d348dd58d",
                                                "text": "They have but few laws. For to a people so instruct and institute, very few to suffice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "827404fc-2c53-4ef2-8dda-75e77ccb02b1",
                        "source_entry_id": "7019456b-8976-3431-b5ac-9680c2f3d709",
                        "source_sense_id": "b6f102f5-b625-3be7-bd72-19778a9a7736",
                        "source_sense_description": "een school waar de leerlingen vijf dagen per week niet alleen les volgen, maar ook maar ook kost en inwoning krijgen",
                        "target_lang_word": "boarding school",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boarding school",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                        "entry_id": "992ab997-c3a6-317c-b022-ca7f2c70fc64",
                                        "glosses": [
                                            "A residential school, where the students are housed on-site (the school provides board and lodging as well as education), sometimes involuntarily, typically at a pre-collegiate level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4b67162-ef69-404c-ae84-6b23befe05e6",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "[…] a pan-Indian movement based on the successes of the Black Power Movement […] had its roots [in] the 1870-1933 Native American boarding school experiences of their parents and grandparents. It was in these boarding schools where Native language, culture and ceremony would be beaten out of the Native children in order to 'Kill the Indian and Save the Child'."
                                            },
                                            {
                                                "example_id": "1ab3b533-7f3e-4e1b-a48b-fdbbdcf29ad1",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "[…] he looked like the housemaster [Shaun] had so hated during his time at boarding school."
                                            },
                                            {
                                                "example_id": "fa433a7c-c202-4a29-ae9e-4356c94810c0",
                                                "sense_id": "8e4bb4e1-0546-3caa-90dd-6e1fcee303cf",
                                                "text": "My brother loved his boarding school, and the few months I spent there were some of the happiest times of my life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34e4b899-cc08-40c5-a249-e989ead165bd",
                        "source_entry_id": "7019456b-8976-3431-b5ac-9680c2f3d709",
                        "source_sense_id": "b6f102f5-b625-3be7-bd72-19778a9a7736",
                        "source_sense_description": "een school waar de leerlingen vijf dagen per week niet alleen les volgen, maar ook maar ook kost en inwoning krijgen",
                        "target_lang_word": "internat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "internat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d98cd775-c9a6-3f54-a6db-ab52c6a2ec60",
                                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                                        "glosses": [
                                            "État d’un élève qui loge dans son lieu d’enseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7028cd13-940b-47e2-b20a-51bfafcb347d",
                                                "sense_id": "d98cd775-c9a6-3f54-a6db-ab52c6a2ec60",
                                                "text": "Sa liberté, son quant à soi, le plus grand bien, après l'incarcération de six années d’internat scolaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dffaf1b-6da0-3812-8c57-8dc34f8f7b55",
                                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                                        "glosses": [
                                            "Ce lieu d’enseignement lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32baf56c-6f4c-4c8d-b979-6bf02518e4c9",
                                                "sense_id": "4dffaf1b-6da0-3812-8c57-8dc34f8f7b55",
                                                "text": "Mes potes de l’internat ont eu la mauvaise idée de mettre tous les lits en cathédrale et même de jeter un matelas par la fenêtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                                        "glosses": [
                                            "Fonction des internes dans un hôpital."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f70348e-4c42-4904-96b5-3ae39cde3c95",
                                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                                "text": "Entre l’addictologie et Laurent Karila, c’est une histoire d’affect qui dure. Après un internat de psychiatrie, il s’entiche rapidement de la science des dépendances."
                                            },
                                            {
                                                "example_id": "1c54aaac-c69b-44eb-adb0-6f30c8322552",
                                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                                "text": "Il porte un jean et une veste en cuir. À peine sorti de l’internat et peut-être même encore interne."
                                            },
                                            {
                                                "example_id": "ceeb2a57-d224-4c18-a580-5622df10e0d3",
                                                "sense_id": "a77f4f78-808d-3f4f-803b-f4e527cc8f9b",
                                                "text": "Dès qu’elle peut, elle rend visite à Tamara, qui finit son internat de médecine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4d050bb-b581-3086-8380-8b0bbfcf24dd",
                                        "entry_id": "a02d1872-0e3b-3020-bfed-d35268c0f2fb",
                                        "glosses": [
                                            "Concours que doivent subir les externes des hôpitaux pour devenir internes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b0c103-ae33-4a14-b071-19540a21893c",
                                                "sense_id": "d4d050bb-b581-3086-8380-8b0bbfcf24dd",
                                                "text": "Il a passé l’internat avec succès."
                                            }
                                        ]
                                    }
                                ]
                            }
