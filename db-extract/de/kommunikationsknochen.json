                "senses": [
                    {
                        "sense_id": "efcb5bb7-0704-3468-bf88-81cd198b19a2",
                        "entry_id": "a32f4c2e-5e5e-3b90-8dea-e7095ea83740",
                        "glosses": [
                            "Mobiltelefon"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "fe36e0c5-b530-4906-9f07-f3f22c437a9d",
                                "sense_id": "efcb5bb7-0704-3468-bf88-81cd198b19a2",
                                "text": "„Und um sich von der Gemeinde der Handy-Hörigen zu distanzieren, lässt er seinen Kommunikationsknochen abschalten.“"
                            },
                            {
                                "example_id": "d4b56be8-a5d2-47ba-8671-00e966317917",
                                "sense_id": "efcb5bb7-0704-3468-bf88-81cd198b19a2",
                                "text": "„Kaum in der Küche angekommen, rappelte der Kommunikationsknochen schon wieder.“"
                            },
                            {
                                "example_id": "91aa4040-77ed-4151-9bfa-0476eb2297b5",
                                "sense_id": "efcb5bb7-0704-3468-bf88-81cd198b19a2",
                                "text": "„Meiner Tochter habe ich inzwischen verboten, ihren Kommunikationsknochen an den Futtertrog zu schleppen.“"
                            },
                            {
                                "example_id": "6edc421b-259d-4ea5-8b3d-fd8554fbdb3a",
                                "sense_id": "efcb5bb7-0704-3468-bf88-81cd198b19a2",
                                "text": "„Anders als ich, der noch nie so einen Kommunikationsknochen besessen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
