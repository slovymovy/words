                    }
                ],
                "translations": [
                    {
                        "translation_id": "8aaf637c-243c-4f27-85f3-eae5f49c3ca3",
                        "source_entry_id": "c3a9a72a-71b9-375b-b2f2-3b46192ab82e",
                        "source_sense_id": "47e35c2c-f84a-3003-aada-f56989df366d",
                        "target_lang_word": "suffragan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffragan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee72de7-c255-3db8-98e5-47d09efef3a0",
                                        "entry_id": "9864b5f3-8c96-306e-b2fe-8a62f115540e",
                                        "glosses": [
                                            "A bishop seen in relation to his archbishop or metropolitan province (which may summon him for support, to attend synods etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe28dd39-7995-450c-afad-5b7eac424e7a",
                                                "sense_id": "2ee72de7-c255-3db8-98e5-47d09efef3a0",
                                                "text": "Now take your hors said sir Tristram And as ye say / soo hit shal be / and alle thyn euylle wil god forgyue it yow and I doo / And here within this myle is the suffrecan of Carleil that shalle gyue yow the sacrament of baptym",
                                                "translation": "“Now take your horse,” said Sir Tristram, “And as you say, so it shall be and God will forgive you all your evil and I do, too. And less than a mile from here is the suffragan [bishop] of Carlisle who shall give you the sacrament of baptism.“",
                                                "english": "“Now take your horse,” said Sir Tristram, “And as you say, so it shall be and God will forgive you all your evil and I do, too. And less than a mile from here is the suffragan [bishop] of Carlisle who shall give you the sacrament of baptism.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c853d97-3f61-3163-9dd6-40673fe61ced",
                                        "entry_id": "9864b5f3-8c96-306e-b2fe-8a62f115540e",
                                        "glosses": [
                                            "An auxiliary bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a2660a-15b5-47cb-99c4-714ed1fadf91",
                                                "sense_id": "2c853d97-3f61-3163-9dd6-40673fe61ced",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.”"
                                            },
                                            {
                                                "example_id": "e5aea57f-6f72-490a-9b56-00c4f969fc66",
                                                "sense_id": "2c853d97-3f61-3163-9dd6-40673fe61ced",
                                                "text": "A suffragan could share the tasks which were special to bishops; for example, by conducting confirmations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57df37d1-d311-42c1-b0f1-47d7bdca7926",
                        "source_entry_id": "c3a9a72a-71b9-375b-b2f2-3b46192ab82e",
                        "source_sense_id": "47e35c2c-f84a-3003-aada-f56989df366d",
                        "target_lang_word": "Suffragan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suffragan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2236ca-3b9c-37d7-96ff-f80f35cff4ff",
                                        "entry_id": "c495dde3-f0ce-3e2b-8cc1-75ce0b1bab80",
                                        "glosses": [
                                            "Suffraganbischof, Bischof, der einem Erzbischof unterstellt ist im Gegensatz zu einem exempten Bischof, der direkt dem Vatikan unterstellt ist"
                                        ],
                                        "tags": [
                                            "katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc14e040-6bca-4e06-a6a8-30a653985fc8",
                                                "sense_id": "fe2236ca-3b9c-37d7-96ff-f80f35cff4ff",
                                                "text": "„Dennoch wollte die langmüthige Regierung den widersetzlichen Prälaten schonen; erst der wieder ausbrechende ernstere Streit um die gemischten Ehen zwang sie zum Bruche. Kurz bevor Droste sein Amt antrat, veröffentlichte ein clericales belgisches Blatt den Hauptinhalt jener von den Bischöfen an die Generalvicariate erlassenen geheimen Instruction; die Angaben waren im Wesentlichen richtig, nur glaubte der anonyme Einsender, das Aktenstück sei eine Weisung Spiegel's an seine Suffraganen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "765bfc0d-144c-488a-b20b-3a6ab87b7c6d",
                        "source_entry_id": "c3a9a72a-71b9-375b-b2f2-3b46192ab82e",
                        "source_sense_id": "47e35c2c-f84a-3003-aada-f56989df366d",
                        "target_lang_word": "Suffraganbischof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suffraganbischof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e968c601-5197-38ee-9851-76d3fbebd269",
                                        "entry_id": "49a8529a-4c89-3e80-b429-97ad80d2fff5",
                                        "glosses": [
                                            "Bischof, der einem Erzbischof unterstellt ist im Gegensatz zu einem exempten Bischof, der direkt dem Vatikan unterstellt ist"
                                        ],
                                        "tags": [
                                            "katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dacc51a-1260-415e-890b-13f6d2ae2dfe",
                                                "sense_id": "e968c601-5197-38ee-9851-76d3fbebd269",
                                                "text": "„Um die Freiheit der Protestanten zu schützen, bestand der Gesandte darauf, daß nicht das gesammte Staatsgebiet, wie die Curie wünschte, sondern nur die katholischen Pfarreien und Kirchen nebst ihren Gemeindegliedern den neuen Sprengeln zugewiesen würden. Neun Bisthümer, erheblich größer als die bairischen, sollten fortan bestehen: im Westen die vereinigten Erzbisthümer von Posen und Gnesen mit dem Suffraganbischof von Kulm, und die dem Papste unmittelbar unterworfenen Bisthümer Breslau und Ermeland.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
