                    {
                        "form_id": "3e07c9cb-b01b-46d4-8bec-0388334c49a2",
                        "entry_id": "cf9acba7-e3fb-3821-ad89-a2b11b71cefa",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Unabhängigkeitserklärungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                        "entry_id": "cf9acba7-e3fb-3821-ad89-a2b11b71cefa",
                        "glosses": [
                            "Dokument oder eine Handlung, mit dem Einwohner eines bisher von einem anderen Staat beherrschten Gebietes, meist einer Kolonie, ihre politische Unabhängigkeit verkünden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60bea778-baca-4276-b3ff-fb055f22a61d",
                                "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                                "text": "Die Unabhängigkeitserklärung des Kosovos verstößt nach einem Rechtsgutachten des Internationalen Gerichtshofes nicht gegen das Völkerrecht."
                            },
                            {
                                "example_id": "da140cec-2abb-4d70-8676-c9d0ea22ba80",
                                "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                                "text": "„Zu den Unterzeichnern der Unabhängigkeitserklärung zählten auch frühere Sklaven, darunter einer mit dem Spitznamen »Der gute Weiße«.“"
                            },
                            {
                                "example_id": "8f6e9fab-0591-483a-a6c8-72526eb9d37f",
                                "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                                "text": "„Die Kolonien gewannen den Krieg, ihr Sieg gipfelte in der Unabhängigkeitserklärung 1776 und der Bildung der Konföderation 1777 und damit in der Gründung der Vereinigten Staaten von Amerika.“"
                            },
                            {
                                "example_id": "e56c7565-700b-4523-b414-02d5059c8607",
                                "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                                "text": "„Als die Stimme im Radio die ersten Worte der Unabhängigkeitserklärung zu verlesen begann, hob Mira beunruhigt den massigen Kopf.“"
                            },
                            {
                                "example_id": "26e75015-5063-4e12-9aad-655a195d3c74",
                                "sense_id": "3d121340-775f-323b-913a-9f1d069fa5ed",
                                "text": "„Der eine, ein wohlhabender Farmer aus der Nachbarschaft, Kowles mit Namen, hatte die Wähler mit einem Festessen, das er am vorigen 4. Juli, am Jahrestag der amerikanischen Unabhängigkeitserklärung, gegeben, auf seine Seite zu bringen gesucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
