                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf3c7274-a39d-4364-b903-8eb8dfec73bd",
                                                "sense_id": "147a72ab-2318-355e-b708-42ce062864e1",
                                                "text": "Dans cette liste, figure la capitaine Wendie Renard, de retour de blessure, mais pas Sandy Baltimore, dont les performances ont été jugées « un peu en dessous » par le staff tricolore."
                                            },
                                            {
                                                "example_id": "77099397-cd6d-41f0-94bf-66a5dd2ff472",
                                                "sense_id": "147a72ab-2318-355e-b708-42ce062864e1",
                                                "text": "Personne n’avait vu venir la défaite de l’Argentine face à l’Arabie saoudite (1-2) au stade de Lusail, mardi. Sauf Hervé Renard, peut-être."
                                            },
                                            {
