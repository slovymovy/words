                "senses": [
                    {
                        "sense_id": "22259faf-b5ea-3603-a43e-d676c47ef0d0",
                        "entry_id": "1e3fd8c5-91ac-3162-84e3-32454a1a18f5",
                        "glosses": [
                            "schip waarmee men op walvissen jaagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c23b878-d743-4922-816e-44792b682648",
                                "sense_id": "22259faf-b5ea-3603-a43e-d676c47ef0d0",
                                "text": "De dierenrechtenactivisten van Sea Shepherd staken voorlopig hun strijd op zee tegen Japanse walvisvaarders. Oprichter Paul Watson zei volgens Australische media dat nauwelijks valt te concurreren met de „militaire technologie” die de Japanners inzetten om hun vloot te beschermen."
                            },
                            {
                                "example_id": "d1998495-2f03-4f33-8f66-2b43447f9548",
                                "sense_id": "22259faf-b5ea-3603-a43e-d676c47ef0d0",
                                "text": "In een vitrine staat de schooltas van biologieleraar dr. A.B. van Deinse. „Gemaakt van de huid van de penis van een vinvis. Had de scheepsarts van de Willem Barendsz, de laatste walvisvaarder, voor hem meegenomen en op Sinterklaasavond 1957, gerold om het bekkenbot van de vinvis, voor zijn deur gezet.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5e93cef-b930-3518-b18a-dd295990a565",
                        "entry_id": "1e3fd8c5-91ac-3162-84e3-32454a1a18f5",
                        "glosses": [
                            "kapitein van een schip waarmee men op walvissen jaagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a375af64-527e-44c6-b3ac-b645eb99bbed",
                                "sense_id": "a5e93cef-b930-3518-b18a-dd295990a565",
                                "text": "Japanse walvisvaarders hebben dinsdag voor de Amerikaanse rechter naar eigen zeggen een belangrijke overwinning behaald op hun aartsvijanden van Sea Shepherd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5875064e-a702-4420-9bf8-d465f0b85def",
                        "source_entry_id": "1e3fd8c5-91ac-3162-84e3-32454a1a18f5",
                        "source_sense_id": "22259faf-b5ea-3603-a43e-d676c47ef0d0",
                        "target_lang_word": "whaler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whaler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26356140-cd65-39df-afef-72819377f287",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "One who hunts whales; a person employed in the whaling industry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a58891c-3a31-4b09-a96a-68a4ac870769",
                                                "sense_id": "26356140-cd65-39df-afef-72819377f287",
                                                "text": "For a whaler's wife to have been “ 'round the Cape” half a dozen times, or even more, was nothing extraordinary."
                                            },
                                            {
                                                "example_id": "ad18eacc-93bc-4e10-93f9-2c1c6b3ccd57",
                                                "sense_id": "26356140-cd65-39df-afef-72819377f287",
                                                "text": "Whalers have always overexploited their stocks, driving them to commercial extinction.[…]American whalers, operating at first from the coast and later in sea-going boats, took about 200 000 right whales in addition to humpbacks and grays."
                                            },
                                            {
                                                "example_id": "35fa74c1-b835-4bd6-95e3-859fb52af9ca",
                                                "sense_id": "26356140-cd65-39df-afef-72819377f287",
                                                "text": "The whalers brought a new way of life. They brought a chance for travel. Many Chamorros traveled to London and the United States. Over eight hundred Chamorro whalers settled in Honolulu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ce6a9e-e93e-35e8-8c20-743dc3e0fb9b",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "A seagoing vessel used for hunting whales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f844800-9178-4639-a896-bad925fc9341",
                                                "sense_id": "15ce6a9e-e93e-35e8-8c20-743dc3e0fb9b",
                                                "text": "But o' Thursday t' Resolution, first whaler back this season, came in port."
                                            },
                                            {
                                                "example_id": "b93890b1-e79c-4a96-911d-8c294dd44244",
                                                "sense_id": "15ce6a9e-e93e-35e8-8c20-743dc3e0fb9b",
                                                "text": "Making myself at home with him, I desired to know what brought him so far from the \"big smoke,\" and on board a whaler of all places in the world."
                                            },
                                            {
                                                "example_id": "9d5176dd-c84b-42a8-a74c-541d0dc9775b",
                                                "sense_id": "15ce6a9e-e93e-35e8-8c20-743dc3e0fb9b",
                                                "text": "The log of the Emily Morgan, an American whaler that visited Guam many times, described Spanish control:[…]."
                                            },
                                            {
                                                "example_id": "bc491097-6483-4d7d-9283-9eebc78d83ba",
                                                "sense_id": "15ce6a9e-e93e-35e8-8c20-743dc3e0fb9b",
                                                "text": "But the Golden Lion was ambushed by a Naval frigate thinking that a whaler's crew would be useful pressed men. The whaler 's crew didn't agree, and there was a bloody skirmish on shore between the press gang and the crew of the Golden Lion which caused such a scandal that from then on whalers ' men were exempt from conscription."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7445bc5-d8ac-3e53-a85d-b2750c5655e9",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "One who whales (flogs or beats)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00122c42-9dc8-3d36-bef6-c14f7c124b87",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "A large, strong person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77afc0b5-26ae-367d-9b8a-72b1dba8ece8",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "Something of unusually great size, a whopper, a whacker."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c957a7d-5ee5-316e-ad00-6dce671d2087",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "Any shark of the family Carcharhinidae; a requiem shark."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f6b84e-1f7c-4fe7-ad32-404a74937998",
                                                "sense_id": "8c957a7d-5ee5-316e-ad00-6dce671d2087",
                                                "text": "The whalers (or requiem sharks) are one of the largest and best known family of sharks. Worldwide there are 48 species in 12 genera. However, relatively few species are on the Great Barrier Reef."
                                            },
                                            {
                                                "example_id": "1155c4cc-228c-4329-a488-a118826354b5",
                                                "sense_id": "8c957a7d-5ee5-316e-ad00-6dce671d2087",
                                                "text": "2003, Mark Thornley, Veda Dante, Peter Wilson, Action Guide: Surfing Australia, Tuttle Publishing, HK, page 264,\nThe whaler shark family, which includes the grey reef shark (Carcharhinus amblyrhynchos),silvertip (Carcharhinus albimarginatus), bull shark (Carcharhinus leucas) and bronze whaler (Carcharhinus brachyurus) are fast moving, territorial and have bitten divers snd surfers in the past."
                                            },
                                            {
                                                "example_id": "7454f4c1-55a8-4764-88a8-6a36b1b862e2",
                                                "sense_id": "8c957a7d-5ee5-316e-ad00-6dce671d2087",
                                                "text": "You can also take a dip with lemon, whaler and other nonpredatory sharks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d210f1ba-42db-3eaf-9fce-474c8d2d4186",
                                        "entry_id": "c289c169-4947-3c73-81ec-cd922874235d",
                                        "glosses": [
                                            "A sundowner; one who cruises about."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05d9a6a7-fa3c-4ffc-beba-9557b8d8cc3d",
                                                "sense_id": "d210f1ba-42db-3eaf-9fce-474c8d2d4186",
                                                "text": "the nomad, “the whaler,” it is who will find the new order hostile to his vested interest of doing nothing."
                                            }
                                        ]
                                    }
