    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                "word": "menstrual",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d17d5743-5bd7-3b26-84a4-ca927bad9a8d",
                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                        "glosses": [
                            "Of or relating to the menses."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2395a2bd-109e-4378-a7fe-ba8c4888693a",
                                "sense_id": "d17d5743-5bd7-3b26-84a4-ca927bad9a8d",
                                "text": "Recent studies in physiology have noted that women who live in close proximity to one another - nurses in a hospital or coeds in a college dormitory - tend to have their menstrual periods at the same time."
                            }
                        ]
                    },
                    {
                        "sense_id": "087ee8ff-fd8d-3897-b804-f60884dae317",
                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                        "glosses": [
                            "Occurring once a month; monthly."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3cf23c1a-98b5-3e30-b2d0-8039519d3f17",
                        "entry_id": "5d7509e6-97c8-3e7f-8dee-6053ff8488fe",
                        "glosses": [
                            "Lasting for a month."
                        ],
                        "tags": [
                            "dated",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d7bc498c-0014-4a4a-90c7-a85fcde74e8f",
                                "sense_id": "3cf23c1a-98b5-3e30-b2d0-8039519d3f17",
                                "text": "a menstrual flower"
                            }
                        ]
                    }
                ],
