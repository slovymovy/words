                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73ddd1ad-c014-461e-ac45-aba0dd07723e",
                                "sense_id": "35e8f1df-7b37-36b2-9f9b-35e4ba96069a",
                                "text": "On a raceway near Riverside, California, a dragger was fatally injured when his dragster went out of control […]"
                            },
                            {
                                "example_id": "5774f561-2e8a-4efe-8586-48a6f0a3144c",
                                "sense_id": "35e8f1df-7b37-36b2-9f9b-35e4ba96069a",
                                "text": "In 1960, Honolulu motorcycle racer (and Street Roadster dragger) Danny Ongais stepped up to the dragster ranks […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "61a80dea-1eae-37b4-9573-e54035c81dc0",
                        "entry_id": "34a478ce-7db1-3269-bdca-1e54d4a73e22",
