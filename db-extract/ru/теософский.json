                                "target_senses": [
                                    {
                                        "sense_id": "1b07f2b0-2225-3085-9460-eb7661e94a05",
                                        "entry_id": "9c091f54-b1bc-320f-bd55-1f6ec0304e11",
                                        "glosses": [
                                            "Of, or relating to theosophy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b520167-34ec-4092-8492-4369be592e5d",
                                                "sense_id": "1b07f2b0-2225-3085-9460-eb7661e94a05",
                                                "text": "Thus, while the mystic of the theopathetic species is content to contemplate, to feel, or to act, suffering under Deity in his sublime passivity, the mysticism I term theosophic aspires to know and believes itself in possession of a certain supernatural divine faculty for that purpose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ddd3719-b0bc-4fe7-8a65-83f5254c723c",
                        "source_entry_id": "b1d61b54-7760-3a8b-b857-0adb3a4f586f",
                        "source_sense_id": "01cc4d25-9500-3341-971f-5367f9bbf6ec",
                        "target_lang_word": "theosophical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theosophical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45b7d374-c3b9-37fe-bf95-4f99bf984b35",
                                        "entry_id": "891f51c6-dc8e-3bc1-b5c4-5124fff9ec17",
                                        "glosses": [
                                            "Of or pertaining to theosophy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23a8681d-4539-452d-a839-76450fd5b756",
                                                "sense_id": "45b7d374-c3b9-37fe-bf95-4f99bf984b35",
                                                "text": "The religious ideas of late Renaissance alchemists were based on the Paracelsian theosophical system, which was a half-pagan, half-Christian belief system, both a mystical path and a theurgic practice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
