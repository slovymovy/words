{
    "word_family": [
        "comedy",
        "comedian",
        "comical",
        "comically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0514744-dc10-3be0-8e63-d3c01c3769cc",
                    "sense_definition": "Pertaining to or characteristic of comedy as a literary or dramatic genre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "humor_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie provides some much-needed <w>comic</w> relief after the sad scenes.",
                            "target_lang_translations": {
                                "ru": "Фильм дает столь необходимую <w>комическую</w> разрядку после грустных сцен.",
                                "zh": "在那些悲伤的场景之后，这部电影提供了一些急需的<w>喜剧</w>调剂。"
                            }
                        },
                        {
                            "text": "He is a famous <w>comic</w> actor known for his funny expressions.",
                            "target_lang_translations": {
                                "ru": "Он известный <w>комедийный</w> актер, знаменитый своей смешной мимикой.",
                                "zh": "他是一位著名的<w>喜剧</w>演员，以其滑稽的表情而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comedic",
                        "funny",
                        "humorous"
                    ],
                    "antonyms": [
                        "tragic"
                    ],
                    "common_phrases": [
                        "comic relief",
                        "comic opera",
                        "comic actor",
                        "comic timing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к комедии как к литературному или драматическому жанру.",
                        "zh": "与喜剧这一文学或戏剧体裁相关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комеди́йный",
                                "target_lang_sense_clarification": "относящийся к жанру комедии (фильм, актер)"
                            },
                            {
                                "target_lang_word": "коми́ческий",
                                "target_lang_sense_clarification": "свойственный комедии, используемый в комедии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喜剧的",
                                "target_lang_sense_clarification": "属于喜剧体裁的"
                            },
                            {
                                "target_lang_word": "喜剧性的",
                                "target_lang_sense_clarification": "具有喜剧特征的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "936c04b8-5c36-3418-a9fc-6d40d1d7b4e3",
                    "sense_definition": "Amusing, entertaining, or causing laughter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humor_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog looked quite <w>comic</w> wearing a pair of sunglasses.",
                            "target_lang_translations": {
                                "ru": "Собака выглядела довольно <w>комичной</w> в солнечных очках.",
                                "zh": "那只狗戴着一副太阳镜，看起来十分<w>滑稽</w>。"
                            }
                        },
                        {
                            "text": "She made a <w>comic</w> face to cheer up her crying brother.",
                            "target_lang_translations": {
                                "ru": "Она состроила <w>смешную</w> гримасу, чтобы подбодрить плачущего брата.",
                                "zh": "她做了一个<w>滑稽</w>的鬼脸来逗哭泣的弟弟开心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comical"
                    ],
                    "antonyms": [
                        "serious"
                    ],
                    "common_phrases": [
                        "comic effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забавный, развлекательный или вызывающий смех.",
                        "zh": "有趣的、娱乐性的或引人发笑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешно́й",
                                "target_lang_sense_clarification": "вызывающий смех, веселый"
                            },
                            {
                                "target_lang_word": "коми́чный",
                                "target_lang_sense_clarification": "потешный, забавный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑稽的",
                                "target_lang_sense_clarification": "引人发笑的"
                            },
                            {
                                "target_lang_word": "好笑的",
                                "target_lang_sense_clarification": "有趣的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847ab206-78b7-3a30-8723-144fd7acc785",
                    "sense_definition": "Unintentionally humorous or ridiculous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "humor_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was something <w>comic</w> about his intense anger over such a small mistake.",
                            "target_lang_translations": {
                                "ru": "Было что-то <w>комичное</w> в его сильном гневе из-за такой маленькой ошибки.",
                                "zh": "他因为这么小的一个错误而大发雷霆，这显得有些<w>荒唐</w>。"
                            }
                        },
                        {
                            "text": "The situation became <w>comic</w> when everyone started slipping on the ice.",
                            "target_lang_translations": {
                                "ru": "Ситуация стала <w>комичной</w>, когда все начали скользить на льду.",
                                "zh": "当每个人都开始在冰上滑倒时，场面变得十分<w>可笑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непреднамеренно смешной, нелепый или курьезный.",
                        "zh": "非本意地显得滑稽、荒谬或可笑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коми́чный",
                                "target_lang_sense_clarification": "нелепый, курьезный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荒唐的",
                                "target_lang_sense_clarification": "因不合常理而可笑的"
                            },
                            {
                                "target_lang_word": "可笑的",
                                "target_lang_sense_clarification": "因荒谬而引人发笑的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad230bc3-5b15-3226-a085-f893af51c786",
                    "sense_definition": "A magazine or book containing stories told in a sequence of drawn images.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "publication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My brother loves to read a <w>comic</w> before going to sleep.",
                            "target_lang_translations": {
                                "ru": "Мой брат любит почитать <w>комикс</w> перед сном.",
                                "zh": "我弟弟喜欢在睡前看一本<w>漫画</w>。"
                            }
                        },
                        {
                            "text": "She bought a rare <w>comic</w> at the bookstore yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она купила в книжном магазине редкий <w>комикс</w>.",
                                "zh": "她昨天在书店买了一本稀有的<w>漫画</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "comic book",
                        "comic strip",
                        "read a comic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Журнал или книга, содержащая истории, рассказанные в последовательности рисунков.",
                        "zh": "一种通过连续图画讲述故事的杂志或书籍。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́микс",
                                "target_lang_sense_clarification": "история в картинках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "漫画",
                                "target_lang_sense_clarification": "连环画册"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "713972ef-f917-35ce-bc17-c9b2d82bc22d",
                    "sense_definition": "A person who entertains an audience by making them laugh.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humor_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>comic</w> told several jokes about his family life.",
                            "target_lang_translations": {
                                "ru": "<w>Комик</w> рассказал несколько шуток о своей семейной жизни.",
                                "zh": "那位<w>喜剧演员</w>讲了几个关于他家庭生活的笑话。"
                            }
                        },
                        {
                            "text": "She works as a stand-up <w>comic</w> in a club in London.",
                            "target_lang_translations": {
                                "ru": "Она работает стендап-<w>комиком</w> в клубе в Лондоне.",
                                "zh": "她在伦敦的一家俱乐部里担任单口<w>喜剧演员</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stand-up comic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который развлекает аудиторию, заставляя её смеяться.",
                        "zh": "通过逗人发笑来娱乐观众的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́мик",
                                "target_lang_sense_clarification": "артист, смешащий публику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喜剧演员",
                                "target_lang_sense_clarification": "以表演喜剧为职业的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}