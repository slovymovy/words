                        "glosses": [
                            "Animal (souvent un insecte ou un oiseau, tel le coucou) qui se nourrit ou nourrit ses larves aux dépens de la production ou de proies capturées par une autre espèce."
                        ],
                        "tags": [],
                        "examples": [
