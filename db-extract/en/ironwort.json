                                "target_senses": [
                                    {
                                        "sense_id": "619e3ccd-406a-388c-8eaa-42f6f2842f31",
                                        "entry_id": "8c062adb-9f2c-3a32-9a4c-97df8e68ee46",
                                        "glosses": [
                                            "ботан. представитель рода растений семейства Яснотковые"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067851f0-ae5f-47f5-94bf-c167f8acdd04",
                                                "sense_id": "619e3ccd-406a-388c-8eaa-42f6f2842f31",
                                                "text": "Заварил, как обычно, чаю с травами. Хорошими травами, здешними, полезными: железницей, зверобоем, чебрецом, мятой, мелиссой ― и еще розовыми лепестками. Попил чайку. Приободрился немного."
                                            }
                                        ]
                                    }
