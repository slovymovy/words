                ],
                "senses": [
                    {
                        "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                        "entry_id": "bbbfb0bd-6657-3eb9-9b15-5fc00dff091e",
                        "glosses": [
                            "zusätzliche unterstützende Stimme in einer Melodie"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8a1cbab5-991e-41bc-a22c-4a91f580a3ef",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Anfangs hatte ich immer die Melodiestimme gesungen, Daddy hatte den Tenor beigesteuert und Gran die Begleitstimme.“"
                            },
                            {
                                "example_id": "1e4de40b-b907-48c8-b089-07a338d4c8c7",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Die Angebote von PopSongs für das Cello sind eher enttäuschend: Meist wird weder eine Begleitstimme noch Begleitakkorde angeboten.“"
                            },
                            {
                                "example_id": "ffb3ab90-30e4-4366-8cab-9a07ab8860dd",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Die einstimmige Begleitstimme hat harmonisierende, aber auch rhythmische Funktion.“"
                            },
                            {
                                "example_id": "9fccee3b-4cf8-4af4-b764-53f7e7a74bfc",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Du spielst schon seit geraumer Zeit die Melodie, aber wir glauben, dass du den Bass oder die Begleitstimme auslässt.“"
                            },
                            {
                                "example_id": "15113bd4-776d-4d79-8c89-cfd651dce33d",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Aus diesem Grund haben wir die Begleitstimme ausnahmsweise so gesetzt, wie sie möglicherweise gemeint war und nicht, wie sie tatsächlich erklingt.“"
                            },
                            {
                                "example_id": "5d9081f3-d859-4f11-9a0a-0f75a4667e13",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Man könnte hier von einer Begleitstimme sprechen, die sich von der Melodiestimme deutlich absetzt.“"
                            },
                            {
                                "example_id": "cd8442ba-b500-45f8-a46b-4d305baad5a1",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Dann plaudern sie wieder oder singen zur Flöte mit verhaltener tiefer Begleitstimme den melancholischen Refrain.“"
                            },
                            {
                                "example_id": "abe4d8c1-e1c7-4fee-b0f7-082fc94c9ff3",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Vor Mozart war man gewohnt, bei solchen Sonaten die Violin-Stimme als etwas untergeordnetes, als Begleitstimme aufzufassen.“"
                            },
                            {
                                "example_id": "d7a789e1-286c-4875-88a7-02d3aa8d777b",
                                "sense_id": "9696f843-d71a-318d-826e-07c25d1b856e",
                                "text": "„Die Damen und Herren mit den dunkleren Stimmen sollten die Begleitstimme singen, die Sopranis die Melodie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
