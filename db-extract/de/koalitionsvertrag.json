                "senses": [
                    {
                        "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                        "entry_id": "68bac26f-dc81-3298-8dfe-db42bdfdb91f",
                        "glosses": [
                            "ein Vertrag, den die Koalitionspartner abschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e752ce-4550-4055-9f0e-93036b4d1c68",
                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                "text": "Im Koalitionsvertrag steht nichts von Radfahren zum Ministerium."
                            },
                            {
                                "example_id": "fd5a94f3-a86a-48dd-9bb2-1ca3010c2bb9",
                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                "text": "„Denn wenn die Regierung den Vertrag ernst nimmt, muss sie vom Koalitionsvertrag abweichen und noch in dieser Legislaturperiode die ersten Beschlüsse für einen endgültigen Ausstieg aus der Nutzung der Kohle fassen.“"
                            },
                            {
                                "example_id": "5175ca1c-4914-4021-a5f8-ceaf059afbb3",
                                "sense_id": "043e400f-1735-3f91-8697-9c8675e0d5c5",
                                "text": "„Im Koalitionsvertrag von SPD, Grünen und FDP sind Hackbacks ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
