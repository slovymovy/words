                "senses": [
                    {
                        "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                        "entry_id": "17e83c0f-823c-30e0-813e-e6a11c005956",
                        "glosses": [
                            "Variante de friseliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "806aa234-edb5-4346-822c-442852306e0a",
                                "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                                "text": "Mais les rives, duo, frisselisent, câlines…"
                            },
                            {
                                "example_id": "f1ff693c-db1c-4de5-a051-6a26d94e749b",
                                "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                                "text": "Les ramures des trembles friselisent dans le couchant de tout le clinquant de leur vif-argent."
                            },
                            {
                                "example_id": "9f2380bd-4343-48f1-b552-e64c19d4b625",
                                "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                                "text": "Et les voluptés sadiques, les innombrables jouissances qui vous frisselisent la carcasse de Loti quand il tient au bout de sa lorgnette d’officier un bon massacre d’Annamites ?"
                            },
                            {
                                "example_id": "eba74088-212b-411f-a09e-39b50afbb8de",
                                "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                                "text": "Tes colliers frisselisent sous tes doigts fantasques"
                            },
                            {
                                "example_id": "62d1fa19-0134-48c4-a17c-62894473745f",
                                "sense_id": "e904600b-46bd-39f2-b4cd-9e4e4afde1c1",
                                "text": "Vos marins jonchent des espaces Sous les maigres ombres des figuiers qui frisselisent"
                            }
                        ]
                    }
