                    },
                    {
                        "sense_id": "c161359c-8ce8-31b7-82fc-a842b26efc41",
                        "entry_id": "97f37107-e5c6-3ff8-88a7-e800154bea05",
                        "glosses": [
                            "iemand die iets doet dat buitengewoon gevonden wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed41f5e-d50e-4b77-acbf-e3e4ed703376",
                                "sense_id": "c161359c-8ce8-31b7-82fc-a842b26efc41",
                                "text": "Je bent echt een kanjer, dat je dat voor elkaar gekregen hebt."
                            },
                            {
                                "example_id": "f3c2c5f1-4e41-4e8b-aede-bfb53e74435c",
                                "sense_id": "c161359c-8ce8-31b7-82fc-a842b26efc41",
                                "text": "En daarbij ook nog een kanjer in roeien, waarschijnlijk, of in tennis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "378c39ef-469f-4278-9ec1-3730878e23d8",
                        "source_entry_id": "97f37107-e5c6-3ff8-88a7-e800154bea05",
                        "source_sense_id": "b47e86c9-94f3-3da0-a3b1-0b15728ef611",
                        "source_sense_description": "iets bijzonder groots of opvallends",
                        "target_lang_word": "whopper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whopper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                        "entry_id": "05559051-0076-3e8e-9632-3c40fe327ad9",
                                        "glosses": [
                                            "Something remarkably large."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae534717-6ad6-487d-9a71-47647cf0a493",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "I’d gone out pike fishing, bless you, never thinking of a trout, and when I saw that whopper on the end of my line, blest if it didn’t quite take me aback. Well, you see, he weighed twenty-six pound."
                                            },
                                            {
                                                "example_id": "fed2456d-6de6-4924-afab-b2ceb3e03379",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "I’ve just run down from Ulster County to look at the town, bein’ that the hayin’s over with. Gosh! but it’s a whopper. I thought Poughkeepsie was some punkins; but this here town is five times as big."
                                            },
                                            {
                                                "example_id": "d8810abf-5e67-47d8-bb4f-f9d42d35198a",
                                                "sense_id": "b98261ed-5204-3850-b8f7-38351bd16540",
                                                "text": "There's a storm blowing up, Sylvester—a 'whopper', speaking in the vernacular of the peasantry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                        "entry_id": "05559051-0076-3e8e-9632-3c40fe327ad9",
                                        "glosses": [
                                            "An outrageous or blatant lie."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5347f41d-b98c-4743-be26-59f9052f3ca9",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "When he got done telling it there was one of them uncomfortable silences that comes, you know, when a person has been telling a whopper and you feel sorry for him and wish you could think of some way to change the subject and let him down easy, […]"
                                            },
                                            {
                                                "example_id": "8dd56416-1a51-4e14-b0ed-560e757cbad2",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "Coming out with a whopper now. Rhapsodies about damn all. Believes his own lies. Does really. Wonderful liar. But want a good memory."
                                            },
                                            {
                                                "example_id": "a13c5af5-6488-409b-9bfa-c8638dcbba4a",
                                                "sense_id": "1ede3ef5-c049-3773-a74a-e780721e1e42",
                                                "text": "Isuzu Inc. hit pay dirt in the late '80s with its series of “Joe Isuzu” spots, featuring an oily, Satanic-looking salesman who told whoppers about Isuzu's genuine llama-skin upholstery and ability to run on tapwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05bab08c-92e2-4f70-bc10-14b8fc051e49",
                        "source_entry_id": "97f37107-e5c6-3ff8-88a7-e800154bea05",
