                    },
                    {
                        "translation_id": "8f377bca-7c81-4ecc-982c-1d6e4f52d623",
                        "source_entry_id": "133b3c31-fb3b-39d7-96c2-e6055ae61a3c",
                        "source_sense_id": "630ceab8-4ae5-3bfc-956d-2bbc7efc7b53",
                        "target_lang_word": "précis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                        "entry_id": "4eec73df-0cbd-3fb3-ab5a-39a6da051994",
                                        "glosses": [
                                            "Qui est entièrement déterminé, qui ne laisse place à aucune incertitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9fb6354-1835-436c-b3de-3763cd748e78",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Durée précise."
                                            },
                                            {
                                                "example_id": "de4c6548-b2ec-49f6-9974-66eb8c8805c0",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Jour précis."
                                            },
                                            {
                                                "example_id": "f3b4fff8-e8f1-4c09-a2fc-216243fb1356",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Venir au moment précis."
                                            },
                                            {
                                                "example_id": "7559c409-b407-40ab-a622-8acd8b470ae2",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "À cinq heures précises."
                                            },
                                            {
                                                "example_id": "479643fb-6cc6-4734-ba34-4bfc4b3a7150",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Je ne sais pas la date précise de cet événement."
                                            },
                                            {
                                                "example_id": "eb738eb7-55bf-46e6-8187-90ca3dc38048",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Une mesure précise."
                                            },
                                            {
                                                "example_id": "6cf22f4e-1d84-4ba8-854a-7ff87d38745b",
                                                "sense_id": "81daa8cf-13a0-3c4a-a144-1fcf9ec0f340",
                                                "text": "Le point précis d’une discussion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                        "entry_id": "4eec73df-0cbd-3fb3-ab5a-39a6da051994",
                                        "glosses": [
                                            "En parlant du discours ou du style, qui a de la précision, qui dit exactement ce qu’il faut, qui est net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc3b5e84-0fb9-4e4b-9a61-5dd5076fd569",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Discours précis."
                                            },
                                            {
                                                "example_id": "d5da1f9a-5aa4-4cf7-b572-53a91110a2b1",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Sigle précis."
                                            },
                                            {
                                                "example_id": "04817f99-e62a-4d38-a78a-b43be800cc97",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Langage précis."
                                            },
                                            {
                                                "example_id": "aee9fc8e-4fae-4abb-9a16-7de3b73e6b73",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Un plan précis."
                                            },
                                            {
                                                "example_id": "1c13b41e-2533-4f28-a3fe-98b40033d72c",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Des explications précises."
                                            },
                                            {
                                                "example_id": "a099826f-a63c-4e2b-92f7-d33b64d4f323",
                                                "sense_id": "22f0cfaf-1716-3a85-9361-fbc58ee7dae2",
                                                "text": "Il n’a voulu rien dire de précis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c7a2e8-1098-3124-b8de-77a1a55ac79e",
                                        "entry_id": "4eec73df-0cbd-3fb3-ab5a-39a6da051994",
                                        "glosses": [
                                            "Se dit aussi en ce sens des personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3ec9915-44c9-41e7-8aaf-93334978f9b9",
                                                "sense_id": "32c7a2e8-1098-3124-b8de-77a1a55ac79e",
                                                "text": "Un écrivain précis."
                                            },
                                            {
                                                "example_id": "41f59953-e5ca-4276-a893-a2a0044acd99",
                                                "sense_id": "32c7a2e8-1098-3124-b8de-77a1a55ac79e",
                                                "text": "Cet homme est net et précis dans ses discours."
                                            },
                                            {
                                                "example_id": "914624e0-d2ab-4206-b5bb-427f9312107f",
                                                "sense_id": "32c7a2e8-1098-3124-b8de-77a1a55ac79e",
                                                "text": "Thucydide est de tous les historiens grecs le plus serré et le plus précis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "précis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                        "entry_id": "bf0eba51-de40-3c90-a766-ae0763a60d26",
                                        "glosses": [
                                            "Sommaire, abrégé de ce qu’il y a de principal, d’essentiel, de plus important dans une affaire, dans un livre, dans une histoire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2423893-9752-4374-835d-cf09ab071926",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Ce qui me reste aujourd’hui dans la mémoire des conversations pleines de poésie que nous eûmes, Lambert et moi, sur le Prophète suédois, de qui j’ai lu depuis les œuvres par curiosité, peut se réduire à ce précis."
                                            },
                                            {
                                                "example_id": "c37e4ced-a9de-464f-936f-121ac62c9408",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Nul ne m’ayant jamais demandé, comme à George Steiner, de faire un précis de chaque lecture avant d’en entamer une autre, c’était un vagabondage anarchique, mais qui m’avait munie d’un fort lot de croyances."
                                            },
                                            {
                                                "example_id": "a3f7bdb9-8dc4-45b8-bdc8-d5731442afa5",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Julie Carville sursauta si fort lorsque les deux hommes bondirent hors de leur arbre qu’elle laissa échapper le précis de grammaire sur le sol."
                                            },
                                            {
                                                "example_id": "519e9422-ba87-4c47-b480-dc84f8040c21",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Voilà le précis de ce livre."
                                            },
                                            {
                                                "example_id": "653b90f7-0bba-48a2-a2db-67be412c8175",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Il a écrit un précis de l’histoire ancienne, de l’histoire d’Angleterre."
                                            },
                                            {
                                                "example_id": "16b50d22-8bb3-47c0-9e4c-2f3be4add514",
                                                "sense_id": "cd5e9d85-0439-39c8-b58d-fc0693f20d17",
                                                "text": "Il nous a donné le précis, tout le précis de cette affaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
