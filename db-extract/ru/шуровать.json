                    },
                    {
                        "sense_id": "e83c92e8-ae90-30d2-b9bf-4fae864436ac",
                        "entry_id": "257b1628-9323-37b7-ab86-be0e45d51d8a",
                        "glosses": [
                            "крим. жарг. искать что-либо, где-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3c4b4543-3893-3e44-891f-be39320390f8",
                        "entry_id": "257b1628-9323-37b7-ab86-be0e45d51d8a",
                        "glosses": [
                            "крим. жарг. добросовестно работать в ИТУ"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ad76e15e-1df3-3bd2-8908-25de7252025c",
                        "entry_id": "257b1628-9323-37b7-ab86-be0e45d51d8a",
                        "glosses": [
                            "крим. жарг. и разг., сниж. совершать половой акт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ab2557-6b26-429d-b92c-f66019f83db1",
                                "sense_id": "ad76e15e-1df3-3bd2-8908-25de7252025c",
                                "text": "Куклим, петрить курсак (брюхо, навар), (а раньше курсать — хезать). Отпулить, пулять, хариться, шуровать."
                            },
                            {
                                "example_id": "e38dabcc-2a20-4ee6-b67e-e98ad0ff6245",
                                "sense_id": "ad76e15e-1df3-3bd2-8908-25de7252025c",
                                "text": "Под окном кудахчут куры, — // Мы с милёнком — шуры-муры! // Солнце сядет, мы — в кровать, — // И всю ночку — шуровать!"
                            },
                            {
                                "example_id": "699b25d6-64f2-48f6-bd85-5acdd6c4efad",
                                "sense_id": "ad76e15e-1df3-3bd2-8908-25de7252025c",
                                "text": "Хорошо тебе, кукушка, // Выше леса куковать! // Хорошо тебе, подружка, // С моим милым шуровать!"
                            },
                            {
                                "example_id": "f82d773b-359f-45b2-8099-0be97f13b151",
                                "sense_id": "ad76e15e-1df3-3bd2-8908-25de7252025c",
                                "text": "Мы с тобою перешли // На семейный на подряд: // Ты по выбору даёшь, // А я шурую всех подряд!"
                            }
                        ]
                    }
                ],
