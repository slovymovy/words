            {
                "entry_id": "6575874a-4cbf-3416-87e4-70f21d373d43",
                "word": "Lacedaemonian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c2b89ced-9ece-45a6-b4e9-10581f42f2dc",
                        "entry_id": "6575874a-4cbf-3416-87e4-70f21d373d43",
                        "tags": [
                            "plural"
                        ],
                        "form": "Lacedaemonians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                        "entry_id": "6575874a-4cbf-3416-87e4-70f21d373d43",
                        "glosses": [
                            "An inhabitant of Lacedaemonia (Laconia) in Greece."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d93031-87cc-44b8-9d40-90b561ca7831",
                                "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                                "text": "[…] yet if in temperance, thriftines, & noble mind (exceeding all their vanities) he could come to reſtore the Lacedæmonians againe vnto equalitie: that then in deede he ſhould be counted a noble king."
                            },
                            {
                                "example_id": "425f139c-d90b-493d-80c5-a49edfa0e3c4",
                                "sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                                "text": "For Kallikrates died out of the battle, he came to the army the most beautiful man of the Greeks of that day - not only of the Lacedæmonians themselves, but of the other Greeks also."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "295c5b49-a7d2-4759-bff1-22c4ab32ccc8",
                        "source_entry_id": "6575874a-4cbf-3416-87e4-70f21d373d43",
                        "source_sense_id": "5e2d53ae-82b6-3546-97df-62c01f5ab0cd",
                        "source_sense_description": "inhabitant of Lacedaemonia",
                        "target_lang_word": "Lacédémonien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lacédémonien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                        "entry_id": "3d96debe-3254-3af4-bfc1-8e06c203770e",
                                        "glosses": [
                                            "Habitant de Lacédémone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a35af9-1457-4684-aa08-6b6153ac76d6",
                                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                                "text": "L’orchestre était doux et faible, par ordre de l’Empereur ; voulant peut-être, comme les Lacédémoniens, être apaisé plutôt qu’excité par la musique."
                                            },
                                            {
                                                "example_id": "68bf06a3-4e8a-4666-b546-1eae6af9936b",
                                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                                "text": "À Sparte, le vol était pratiqué et honoré : c’était une institution hiératique, un complément indispensable à l’éducation de tout Lacédémonien sérieux."
                                            },
                                            {
                                                "example_id": "b805f153-7f26-4962-9320-e50bc99116ef",
                                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                                "text": "Au cours de la guerre du Péloponnèse, Thucydide reproduit le discours des Corinthiens aux Lacédémoniens."
                                            },
                                            {
                                                "example_id": "0cc4090a-b8ed-4899-b807-db176327ef9e",
                                                "sense_id": "c7fc6a0d-a45b-3009-b17c-84db45747c1b",
                                                "text": "Si la Grèce, parmi ses artistes, ne compte aucun Lacédémonien, n’est-ce point parce que Sparte précipitait aux oubliettes ses enfants chétifs ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
