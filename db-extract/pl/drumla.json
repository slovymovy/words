                        "entry_id": "4360a4c3-4988-34ea-8799-b21310e11e1f",
                        "glosses": [
                            "metalowy instrument wydający dźwięki dzięki wzbudzaniu drgań umieszczonej w ustach sprężystej blaszki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69aaa981-03d4-4e22-936a-2bc83661ac61",
                                "sense_id": "53e1645f-271e-3d40-a961-39ef23059a8c",
                                "text": "Wyszedł z drumli głos cudny, aż rozbrzmiały echa, i zaraz w zaroślach odezwały się drozdy, zięby, sikorki, piegże i inne drobne ptactwo, jakby ukryta kapela, co tylko znaku czeka"
                            }
                        ],
