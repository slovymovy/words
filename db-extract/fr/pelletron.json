                                        "sense_id": "d0f6ece1-c852-3643-a527-88ff72eb46f7",
                                        "entry_id": "fd68070e-873b-3efd-8337-36c35b6cfd00",
                                        "glosses": [
                                            "Alternative form of Pelletron."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754ba31f-32d6-41d6-b06c-3ad782f88459",
                                                "sense_id": "d0f6ece1-c852-3643-a527-88ff72eb46f7",
                                                "text": "While one of the halls is used as the beam hall for experiments with the heavy ion beams from the pelletron accelerator, it is planned to install a superconducting linear accelerator in the other beam hall to further boost the energy of the heavy ions from the pelletron accelerator."
                                            },
                                            {
                                                "example_id": "f2cc028c-e877-4e25-8971-a3fb7e301c96",
                                                "sense_id": "d0f6ece1-c852-3643-a527-88ff72eb46f7",
                                                "text": "Two high voltage (HV) power supplies at the high and low energy ends transfer charge to the pelletron chain."
                                            },
                                            {
                                                "example_id": "8f0f87c6-5a0d-426f-9293-85faeb7ada83",
                                                "sense_id": "d0f6ece1-c852-3643-a527-88ff72eb46f7",
                                                "text": "The advantages of the pelletron system are its reproducible mechanical properties and long working life, freedom from dust generation which is an undesirable property of belts, and very stable operating conditions."
                                            },
                                            {
                                                "example_id": "a8bb537b-d672-4cc5-a6e0-5b55f6db8b7a",
                                                "sense_id": "d0f6ece1-c852-3643-a527-88ff72eb46f7",
                                                "text": "As Van de Graaffs and pelletrons are still in much use, a brief statement about the tandem Van de Graaff or pelletron accelerators is useful."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
