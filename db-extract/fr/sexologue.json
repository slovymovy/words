                    {
                        "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                        "entry_id": "1d35454c-8477-3a23-8993-7f04bef82f79",
                        "glosses": [
                            "Spécialiste de la sexologie, des troubles dans l’exercice de la sexualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ead0cd8-1ca6-4ee4-914f-ff42503f0f51",
                                "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                                "text": "Toutes les femmes sont-elles un peu ondinistes ? Je me souviens d’un vieux livre sur l’ondinisme par Havelock Ellis, sexologue avant la lettre et qui m’avait bien diverti."
                            },
                            {
                                "example_id": "4a2b4768-315a-4ca4-ae33-54fefb64663d",
                                "sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                                "text": "Il existe, outre les sexologues de formation, des médecins généralistes sexologues, des psychologues sexologues, des gynécologues sexologues, des psycothérapeutes sexologues, des psychiatres sexologues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f91c4c1d-7b66-45a3-a3ac-6767638a8ecb",
                        "source_entry_id": "1d35454c-8477-3a23-8993-7f04bef82f79",
                        "source_sense_id": "f055616b-27a0-373f-b20c-838015f92ccb",
                        "target_lang_word": "sexologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29c6efc-6ce4-3a99-a4ef-746e0e075f15",
                                        "entry_id": "901bf23b-c46c-3282-aa86-a8f1cf04ccde",
                                        "glosses": [
                                            "Someone who studies, or is an expert in, sex and sexuality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d59531-a2ea-4bc3-9f12-240f811b54a6",
                                                "sense_id": "b29c6efc-6ce4-3a99-a4ef-746e0e075f15",
                                                "text": "Daniel Bergner, age 48, the divorced father of two teenage children, is what sexologists would call a straight, vanilla teleiophile."
                                            },
                                            {
                                                "example_id": "196d8691-c7a8-49e3-9911-51855625964a",
                                                "sense_id": "b29c6efc-6ce4-3a99-a4ef-746e0e075f15",
                                                "text": "Then there's US sexologist Ray Blanchard, best known for his ... well, problematic concept of autogynyphelia: the idea that trans women are actually men who feel attracted to their female-selves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
