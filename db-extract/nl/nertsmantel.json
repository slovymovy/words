                        "examples": [
                            {
                                "example_id": "d967aaae-5934-4555-a050-50162da3ec09",
                                "sense_id": "249db07f-52ac-374d-a066-b30cdbde5925",
                                "text": "OVER DE GRENSGRONAU - Een nog onbekende man heeft dinsdagmiddag in het Duitse Gronau een nertsmantel van de schouders van een 65-jarige vrouw gegrist. Het slachtoffer viel en raakte licht gewond."
                            },
                            {
                                "example_id": "fe5898b0-a362-482a-9b9b-d7608a2bd294",
                                "sense_id": "249db07f-52ac-374d-a066-b30cdbde5925",
                                "text": "Beverratten kunnen zich net als hun soortgenoten ongelooflijk snel voortplanten, waardoor ze een goedkoop product zijn. Hun vacht werd vroeger gebruikt voor wie de traditionele, maar dure vossen- of nertsmantels niet kon betalen, waardoor ze veelvuldig werden gekweekt. Het vlees dat overbleef, werd gebruikt voor een stoofpotje."
                            }
                        ]
