                                        "examples": [
                                            {
                                                "example_id": "08a881dc-bb23-4494-b607-810375e6c538",
                                                "sense_id": "511915e0-030e-3f84-a6a2-fe00599ee4d1",
                                                "text": "After the match […], the text matched within the named capture is available via the Match object's Groups(name) property."
