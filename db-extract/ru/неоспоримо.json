                                        "entry_id": "ba360e13-06c8-3a77-a853-3242cdda3891",
                                        "glosses": [
                                            "In a conclusive manner; with finality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38df3bc9-681f-4ebe-ab29-4e8b9a340390",
                                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                                "text": "Once the final experiment had been performed, the theory was conclusively proved."
                                            },
                                            {
                                                "example_id": "acdb1a1d-5018-402d-bdd7-216a68bca6bc",
                                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                                "text": "I need not extend the subject any farther; enough has been said , and much more might be, if necessary, to prove clearly and conclusively that the odontotechny of the Greeks and Romans was advanced to a considerable degree of perfection: […]"
                                            },
                                            {
                                                "example_id": "c06a546c-e792-45bb-9e71-fcaba33e0525",
                                                "sense_id": "b7173529-57c7-34d4-8fbb-c729c22cea7e",
                                                "text": "[…] which conclusively prove the enormous superiority of the Sumerian over the Egyptian weaponsmithy."
                                            }
                                        ]
                                    }
