                    {
                        "sense_id": "5227e1c7-d4c4-358a-a69a-1e9aa9fab012",
                        "entry_id": "38d962d4-9ff7-3e8f-bc36-ca51e3601214",
                        "glosses": [
                            "gesetzliche oder vertragliche Vorgabe, nach der bestimmte Produkte zu einem festgesetzten Preis verkauft werden müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94b6be41-848e-4b3e-84ad-fdadc46906b1",
                                "sense_id": "5227e1c7-d4c4-358a-a69a-1e9aa9fab012",
                                "text": "Die Preisbindung für Bücher ist in Deutschland seit dem 1. Oktober 2002 durch ein Gesetz geregelt."
                            },
                            {
                                "example_id": "98efe582-a654-46a0-a77e-7916a39371ee",
                                "sense_id": "5227e1c7-d4c4-358a-a69a-1e9aa9fab012",
                                "text": "„Vor allem fehlen öffentlich geförderte Wohnungen mit Preisbindung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c65afcaa-a233-487a-a66f-b91897e5805f",
                        "source_entry_id": "38d962d4-9ff7-3e8f-bc36-ca51e3601214",
                        "source_sense_id": "5227e1c7-d4c4-358a-a69a-1e9aa9fab012",
