                        "glosses": [
                            "Qui contient du calcaire."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "5dda1f6b-4a19-4444-b489-6927e75e15bf",
                                "sense_id": "eac6e0c5-e0dd-34e3-b57e-1064fe4e03c8",
                                "text": "Ils s’assurèrent de la nature vraiment animale d’un grand nombre de polypiers, et allèrent même trop loin, en rangeant parmi ces derniers bon nombre de végétaux calcarifères qui n’ont recouvré que bien tard leur véritable place."
                            },
                            {
                                "example_id": "db7077e7-8fe3-4d7a-b251-e8a6ef874b06",
                                "sense_id": "eac6e0c5-e0dd-34e3-b57e-1064fe4e03c8",
                                "text": "Le Genêt à balais (Sarothamnus scorparius) envahit souvent le groupement quand les sables sont peu calcarifères ; il se forme une lande pauvre […]."
                            }
                        ]
                    }
