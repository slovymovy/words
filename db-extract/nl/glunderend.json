        "nl-extract.jsonl": [
            {
                "entry_id": "a9168cb3-4873-333e-bbe7-8b805749c2a6",
                "word": "glunderend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ccebd501-91c9-3d55-ac39-1693ea9662c7",
                        "entry_id": "a9168cb3-4873-333e-bbe7-8b805749c2a6",
                        "glosses": [
                            "van een persoon dat hij geluidloos lacht omdat hij heel blij is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdf819fb-ce83-4212-bb28-a22a0d21c6ca",
                                "sense_id": "ccebd501-91c9-3d55-ac39-1693ea9662c7",
                                "text": "De beloning: „Glunderende gezichten. Helemaal toen we Enter weer binnenkwamen en de muziekvereniging een serenade bracht. Daar doe je het allemaal voor.”"
                            },
                            {
                                "example_id": "01499fd0-3350-4f66-a448-14a2be476998",
                                "sense_id": "ccebd501-91c9-3d55-ac39-1693ea9662c7",
                                "text": "Tot haar grote verrassing zag ze glunderende familieleden en vrienden staan in de rijkelijk versierde kamer. En Aziz? Die ging op zijn knieën en vroeg haar ten huwelijk: Nadat ze van de schrik was bekomen, zei de verbijsterde Chaimae: ,,Ja, ik wil’’."
                            },
                            {
                                "example_id": "ba66fa0b-3a39-4ae2-9016-d295d9ae9f9a",
                                "sense_id": "ccebd501-91c9-3d55-ac39-1693ea9662c7",
                                "text": "Of de laatste foto op Schiphol met vier glunderende gezichten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1aaeb9b4-8611-4861-9cfc-cb2deaf58d78",
                        "source_entry_id": "a9168cb3-4873-333e-bbe7-8b805749c2a6",
