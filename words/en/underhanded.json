{
    "word_family": [
        "underhand",
        "underhandedness",
        "underhandedly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e2996f3-1175-3f45-8928-b5558d107c97",
                    "sense_definition": "Deceitful, dishonest, or done in a corrupt and sneaky way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used <w>underhanded</w> tactics to sabotage his rival before the election.",
                            "target_lang_translations": {
                                "es": "Utilizó tácticas <w>ruines</w> para sabotear a su rival antes de las elecciones."
                            }
                        },
                        {
                            "text": "Her <w>underhanded</w> trick backfired and caused her to lose the match.",
                            "target_lang_translations": {
                                "es": "Su truco <w>sucio</w> le salió el tiro por la culata y le hizo perder el partido."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhand"
                    ],
                    "antonyms": [
                        "honest",
                        "aboveboard"
                    ],
                    "common_phrases": [
                        "underhanded tactics",
                        "underhanded methods"
                    ],
                    "target_lang_definitions": {
                        "es": "Engañoso, deshonesto o hecho de manera corrupta y solapada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "deshonesto o malintencionado"
                            },
                            {
                                "target_lang_word": "deshonesto",
                                "target_lang_sense_clarification": "falto de honestidad o integridad"
                            },
                            {
                                "target_lang_word": "traicionero",
                                "target_lang_sense_clarification": "que actúa a traición o con engaño"
                            },
                            {
                                "target_lang_word": "solapado",
                                "target_lang_sense_clarification": "que oculta sus verdaderas intenciones"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667232d1-712b-3970-b4d7-a830f4f9e065",
                    "sense_definition": "Insincere, backhanded, or subtly mocking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave her an <w>underhanded</w> compliment that sounded more like an insult.",
                            "target_lang_translations": {
                                "es": "Le hizo un cumplido <w>con segundas intenciones</w> que sonaba más a insulto."
                            }
                        },
                        {
                            "text": "Poking <w>underhanded</w> fun at the contestants made everyone feel uncomfortable.",
                            "target_lang_translations": {
                                "es": "Burlarse de forma <w>solapada</w> de los concursantes hizo que todos se sintieran incómodos."
                            }
                        }
                    ],
                    "synonyms": [
                        "backhanded",
                        "underhand"
                    ],
                    "common_phrases": [
                        "underhanded compliment"
                    ],
                    "target_lang_definitions": {
                        "es": "Poco sincero, con doble sentido o sutilmente burlón."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "con segundas intenciones",
                                "target_lang_sense_clarification": "dicho de un comentario ambiguo o malicioso"
                            },
                            {
                                "target_lang_word": "malintencionado",
                                "target_lang_sense_clarification": "que encierra mala intención"
                            },
                            {
                                "target_lang_word": "solapado",
                                "target_lang_sense_clarification": "indirecto o hipócrita"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbe3417a-7e0f-3f17-80fa-8c5dc1d2ca4b",
                    "sense_definition": "Done secretly or covertly rather than openly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although the mystery note was exciting, making such deals felt completely <w>underhanded</w>.",
                            "target_lang_translations": {
                                "es": "Aunque la nota misteriosa era emocionante, hacer tratos de ese tipo se sentía totalmente <w>clandestino</w>."
                            }
                        },
                        {
                            "text": "The diplomat strongly opposed <w>underhanded</w> agreements made without the public knowledge.",
                            "target_lang_translations": {
                                "es": "El diplomático se opuso firmemente a los acuerdos <w>secretos</w> realizados a espaldas del público."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhand"
                    ],
                    "common_phrases": [
                        "underhanded dealings"
                    ],
                    "target_lang_definitions": {
                        "es": "Hecho en secreto o de forma encubierta en lugar de abiertamente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "clandestino",
                                "target_lang_sense_clarification": "hecho en secreto o al margen de la ley"
                            },
                            {
                                "target_lang_word": "secreto",
                                "target_lang_sense_clarification": "oculto a la vista pública"
                            },
                            {
                                "target_lang_word": "por debajo de la mesa",
                                "target_lang_sense_clarification": "hecho de manera encubierta y fraudulenta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a6b2f7a-ba7d-38f9-bd97-3a48579edf2d",
                    "sense_definition": "Executed with the hand and arm moving from below shoulder level.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player tossed the ball with a gentle <w>underhanded</w> motion.",
                            "target_lang_translations": {
                                "es": "El jugador lanzó la pelota con un suave movimiento <w>por abajo</w>."
                            }
                        },
                        {
                            "text": "She preferred an <w>underhanded</w> pitch because it felt much more natural.",
                            "target_lang_translations": {
                                "es": "Prefería un lanzamiento <w>por abajo</w> porque se sentía mucho más natural."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhand"
                    ],
                    "common_phrases": [
                        "underhanded pitch",
                        "underhanded throw",
                        "underhanded motion"
                    ],
                    "target_lang_definitions": {
                        "es": "Ejecutado con la mano y el brazo moviéndose desde abajo del hombro."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "por abajo",
                                "target_lang_sense_clarification": "lanzamiento o movimiento ejecutado por debajo del hombro"
                            },
                            {
                                "target_lang_word": "bajo mano",
                                "target_lang_sense_clarification": "movimiento de lanzamiento desde abajo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9ca0791-10b5-35b6-9bc8-679415073691",
                    "sense_definition": "Having insufficient workers or crew; shorthanded.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship struggled to navigate through the storm because the crew was severely <w>underhanded</w>.",
                            "target_lang_translations": {
                                "es": "El barco tuvo dificultades para navegar durante la tormenta porque la tripulación estaba muy <w>escasa de personal</w>."
                            }
                        },
                        {
                            "text": "They were too <w>underhanded</w> to manage such a demanding task on their own.",
                            "target_lang_translations": {
                                "es": "Estaban demasiado <w>faltos de personal</w> para encargarse solos de una tarea tan exigente."
                            }
                        }
                    ],
                    "synonyms": [
                        "understaffed"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now commonly shorthanded or understaffed"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Que carece de suficiente personal, tripulación o trabajadores."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "escaso de personal",
                                "target_lang_sense_clarification": "falto de trabajadores suficientes"
                            },
                            {
                                "target_lang_word": "falto de personal",
                                "target_lang_sense_clarification": "con trabajadores insuficientes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f42d904a-75f0-3fb8-acff-55885290dd01",
                    "sense_definition": "With an upward motion of the arm or hand; in an underhand manner.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach taught the students how to shoot free throws <w>underhanded</w>.",
                            "target_lang_translations": {
                                "es": "El entrenador enseñó a los alumnos a lanzar tiros libres <w>por abajo</w>."
                            }
                        },
                        {
                            "text": "He tossed the keys <w>underhanded</w> so that she could easily catch them.",
                            "target_lang_translations": {
                                "es": "Le tiró las llaves <w>por abajo</w> para que las pudiera atrapar fácilmente."
                            }
                        }
                    ],
                    "synonyms": [
                        "underhandedly"
                    ],
                    "common_phrases": [
                        "shoot underhanded",
                        "toss underhanded"
                    ],
                    "target_lang_definitions": {
                        "es": "Con un movimiento ascendente del brazo o la mano; de abajo hacia arriba."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "por abajo",
                                "target_lang_sense_clarification": "lanzar o ejecutar desde abajo"
                            },
                            {
                                "target_lang_word": "de abajo arriba",
                                "target_lang_sense_clarification": "con movimiento ascendente del brazo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d673ce9-6a77-304b-a0b3-f49cb90b08c7",
                    "sense_definition": "Simple past and past participle of <w>underhand</w>.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The softball pitcher <w>underhanded</w> the ball smoothly across the home plate.",
                            "target_lang_translations": {
                                "es": "La lanzadora de sóftbol <w>lanzó por abajo</w> la pelota suavemente hacia el plato de home."
                            }
                        },
                        {
                            "text": "He <w>underhanded</w> the softball to the catcher during practice.",
                            "target_lang_translations": {
                                "es": "Él le <w>lanzó por abajo</w> la pelota de sóftbol al receptor durante la práctica."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio pasado de underhand; lanzar por abajo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lanzó por abajo",
                                "target_lang_sense_clarification": "pasado de lanzar la pelota desde abajo del hombro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0f295a8-64e1-3e1b-875e-1542cfd5a045",
                    "sense_definition": "Deceitful or corrupt people considered as a collective group.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Honest citizens refuse to let the city fall into the hands of the <w>underhanded</w>.",
                            "target_lang_translations": {
                                "es": "Los ciudadanos honestos se niegan a dejar que la ciudad caiga en manos de <w>los corruptos</w>."
                            }
                        },
                        {
                            "text": "Unfair business practices only bring rewards to the <w>underhanded</w>.",
                            "target_lang_translations": {
                                "es": "Las prácticas comerciales desleales solo benefician a <w>los deshonestos</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the underhanded"
                    ],
                    "target_lang_definitions": {
                        "es": "Personas engañosas o corruptas consideradas como un colectivo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "los deshonestos",
                                "target_lang_sense_clarification": "personas faltas de honestidad"
                            },
                            {
                                "target_lang_word": "los corruptos",
                                "target_lang_sense_clarification": "personas tramposas o inmorales"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}