                "senses": [
                    {
                        "sense_id": "4bc07d16-da90-3904-9eed-1501e9a45651",
                        "entry_id": "d1238a67-9938-3a37-a723-4e14a085930d",
                        "glosses": [
                            "S’enfermer, s’éloigner des autres, se retirer de la société."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": [
                            {
                                "example_id": "85ab8139-afc8-4e8e-b2e6-a133d72d68c5",
                                "sense_id": "4bc07d16-da90-3904-9eed-1501e9a45651",
                                "text": "Elle revient donc sur ses pas pour s’encabaner, pour laisser passer la vague de froid qui dure finalement 10 interminables journées."
                            },
                            {
                                "example_id": "2587eaf9-2c90-4126-8134-1029f5724388",
                                "sense_id": "4bc07d16-da90-3904-9eed-1501e9a45651",
                                "text": "Il est certes aisé, l’hiver, de se montrer austère au Québec. On «s’encabane» spontanément."
                            },
                            {
                                "example_id": "3764183a-fa00-4325-8165-7631d35af8c0",
                                "sense_id": "4bc07d16-da90-3904-9eed-1501e9a45651",
                                "text": "On doit vivre en évitant le virus, pas tous s’encabaner dès qu’il se met à circuler."
                            }
                        ]
                    }
