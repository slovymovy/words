                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99b8d3d7-7c6f-3ca4-ab3e-ce061fb27ff5",
                        "entry_id": "1e45e485-b27a-3da0-8381-f084b1ac7860",
                        "glosses": [
                            "La peinture, en tant qu’art."
                        ],
                        "tags": [
                            "colloquial",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "9ab1a704-ba8d-4f79-9c83-0b3770038bb6",
                                "sense_id": "99b8d3d7-7c6f-3ca4-ab3e-ce061fb27ff5",
                                "text": "Y'a qu'les tableaux, m'exposa Bob. Voilà. Lesquels qu'on peut accrocher d'sur les murs, j'en sais rien. Alors, tu vois, j'm'en passe. Tu t'y connais toi, en barbouille?"
                            },
                            {
                                "example_id": "03f6a46f-dd1a-4441-a14b-1367c02155f1",
                                "sense_id": "99b8d3d7-7c6f-3ca4-ab3e-ce061fb27ff5",
                                "text": "Guenilleux et barbus, les artistes vendaient de la barbouille au mètre carré."
                            },
                            {
                                "example_id": "e83297de-0a35-41d2-9809-2abc0a035686",
                                "sense_id": "99b8d3d7-7c6f-3ca4-ab3e-ce061fb27ff5",
                                "text": "Je regardais les vitraux — barbouille sur verre du siècle dernier — payés par la famille au temps de sa splendeur."
                            }
                        ]
                    }
                ],
