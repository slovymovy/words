                        "sense_id": "1bb2c36f-a612-3ca5-866d-b9c3dfc394ae",
                        "entry_id": "6ac74e12-ae54-3688-88b4-1fb4f4fc5e85",
                        "glosses": [
                            "A small red or yellow berry growing on the shrub Vaccinium reticulatum of volcanic parts of the Hawaiian islands of Hawaii and Maui, or the shrub itself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5691fed9-36f2-4437-90d4-ddb5d693c92f",
                                "sense_id": "1bb2c36f-a612-3ca5-866d-b9c3dfc394ae",
                                "text": "Ohelo Vaccinium reticulatum (and V. peleanum) and kukaenene Coprosma ernodeoides […] are the most important berries in the Nenes' diet, and it is probably from such juicy fruit that much of their water intake comes."
                            },
                            {
                                "example_id": "3f552724-5599-450a-b2b5-76b82446f32c",
                                "sense_id": "1bb2c36f-a612-3ca5-866d-b9c3dfc394ae",
                                "text": "Growing on nearly bare lava flows, the flora includes small relatives of the familiar cranberry: the ohelo carries a bright red, succulent berry that was once a staple item in the diet of the nene, the Hawaiian goose."
                            }
                        ]
                    }
