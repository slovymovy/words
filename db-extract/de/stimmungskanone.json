                        "glosses": [
                            "Person, die gute Stimmung verbreitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53e48271-4f9c-4f81-b06f-5b0e300b1390",
                                "sense_id": "4e9d1d6e-31fc-376d-b92a-7705a47aefa3",
