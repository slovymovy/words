                        "sense_id": "305372c7-8adc-3ad3-a966-7f879a4dfdbb",
                        "entry_id": "f5e004c3-5cde-3cbd-921f-7a419482c49b",
                        "glosses": [
                            "extrazelluläre Matrix"
                        ],
                        "tags": [
                            "Zellbiologie",
                            "Histologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a90e7dab-1d7e-40fa-9853-f0728aa96c7b",
                                "sense_id": "305372c7-8adc-3ad3-a966-7f879a4dfdbb",
                                "text": "Unter extrazellulärer Matrix (EZM) werden alle körpereigenen Substanzen zusammengefasst, die sich außerhalb der Zellen im Interzellularraum befinden."
                            },
                            {
                                "example_id": "810e4199-f871-4ce5-97e3-c04b77839c2a",
                                "sense_id": "305372c7-8adc-3ad3-a966-7f879a4dfdbb",
                                "text": "Über andere Kollagene sorgt die EZM für die Zugfestigkeit aller Sehnen und Bänder sowie für die dreidimensionale Festigkeit der Knochen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
