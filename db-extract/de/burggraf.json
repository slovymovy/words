                                    {
                                        "sense_id": "3ef1f6f0-fbcb-3c57-936f-a5710b03f4be",
                                        "entry_id": "9bfa2725-d915-3d01-9183-17b7b36046f6",
                                        "glosses": [
                                            "The military governor of a town or castle in the Middle Ages, especially in German-speaking Europe; a nobleman of the same status."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "381b176b-0a81-314f-ae81-faaccbb1496d",
                                        "entry_id": "9bfa2725-d915-3d01-9183-17b7b36046f6",
                                        "glosses": [
                                            "One who holds a hereditary title, with an associated domain, descended from an ancestor who commanded a burg, especially in German-speaking Europe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78935115-1a0f-474f-b136-87bbca35a97c",
                        "source_entry_id": "b4a98257-c707-3adf-a8fb-10a21095a30c",
                        "source_sense_id": "8b1b7232-37c5-3c09-a12b-bc916bf62dfb",
                        "source_sense_description": "Befehlshaber einer Burg aus dem niederen Adel",
                        "target_lang_word": "burgrave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burgrave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                        "entry_id": "184cfa5b-e760-3d37-b5c2-381774105d60",
                                        "glosses": [
                                            "Au Moyen Âge, en Allemagne, commandant militaire d’une ville ou d’une place forte qui exerçait en outre sur les bourgeois le droit de juridiction."
                                        ],
                                        "tags": [
                                            "Middle-Ages"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07b0e50b-0260-43f6-8758-91089e11a253",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "À Bingen, situé au confluent de la Nahe, commence le Rhin des burgs et des burgraves, la partie véritablement pittoresque du voyage."
                                            },
                                            {
                                                "example_id": "d546506a-20f2-44e4-bbbb-d38874479951",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "Mais nous n’en sommes pas là. Nous en sommes au règne des burgraves. Il y a lutte entre les chefs des trusts, — Stinnes contre Rathenau —, comme jadis entre les forbans titrés dont le Rhin reflète les châteaux en ruines. Au reste, de même que leurs devanciers, ces burgraves modernes rencontrent des rivaux en France, en Angleterre…"
                                            },
                                            {
                                                "example_id": "986a689a-668d-4b07-a626-651641d2deac",
                                                "sense_id": "235d6264-6e75-3141-9902-dd53bf735b9f",
                                                "text": "— J’ai, six mille nuits durant, valeureusement aimé la divine langue française : je puis tout dire en Français, j’y suis burgrave sans vasselage aucun, même aux lois !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
