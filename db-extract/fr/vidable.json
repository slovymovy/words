                        "glosses": [
                            "Qui peut être vidé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c9fbe3-a2fa-4f80-ac64-77407ac671e8",
                                "sense_id": "8e3fc188-fe8b-3dc2-9946-2206b720322b",
                                "text": "Les procès peuvent être portés en audience, soit qu’il s'agisse de quelque incident ou même « au fond et mérite du principal », lorsque l’avocat de celui qui va avoir un jugement croit que la cause peut être vidable en l’audience ; il leur est d’ailleurs défendu, à peine d’amende, d’y porter des causes, si elles ne sont vidables sur le champ."
                            },
                            {
                                "example_id": "83b41ccb-62c7-4cdc-99cd-8f34ebe33900",
                                "sense_id": "8e3fc188-fe8b-3dc2-9946-2206b720322b",
                                "text": "Avant la construction d’un étang non vidable, on contrôlera la hauteur de la nappe phréatique et la qualité de l’eau (pH et dureté)."
                            },
                            {
                                "example_id": "81505eb1-b480-424d-be0d-1273872fb2af",
                                "sense_id": "8e3fc188-fe8b-3dc2-9946-2206b720322b",
                                "text": "La poche peut être adhésive sur la peau ou sur un disque porte-poche maintenu par une ceinture. Elle devra être vidable car les sécrétions sont abondantes."
                            }
                        ]
                    }
