                "senses": [
                    {
                        "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                        "entry_id": "47e26b0d-229f-3c9c-88b7-95e5bd14be7f",
                        "glosses": [
                            "durch einfache Betrachtung des Patienten erfolgende Erkennung/Bestimmung einer Krankheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56ee9f6e-6d98-4f4b-bd86-b47b9396fc22",
                                "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                                "text": "„In der Regel ist die lokalisierte Sklerodermie per Blickdiagnostik zu erkennen.“"
                            },
                            {
                                "example_id": "944e91a2-84df-4b74-83f1-ec905e0fd18c",
                                "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                                "text": "„Und schon beim ersten Patientenkontakt spielt bei erfahrenen Ärzten die Blickdiagnostik eine große Rolle, also eine erste Diagnose allein anhand des Aussehens des Patienten.“"
                            },
                            {
                                "example_id": "52277867-1041-4fa2-93aa-dc7917a38524",
                                "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                                "text": "„Von den Gesetzen über die Pflichten und einzelne Infektionskrankheiten mit Behandlungsverbot weiter zu einem Notfall bis hin zur Blickdiagnostik.“"
                            },
                            {
                                "example_id": "20ff22c2-90fa-4f81-803f-fc97c0f9c998",
                                "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                                "text": "„Die Autoren schlossen daraus, dass auch bei autistischen Kindern, die in der Blickdiagnostik sprachlich unauffällig entwickelt scheinen, immer eine differenzierte Diagnostik zumindest der rezeptiven Sprache erfolgen sollte.“"
                            },
                            {
                                "example_id": "f5dd48ff-825d-41b2-aa19-2f55f5521763",
                                "sense_id": "e4437416-9b8a-3944-b71b-a018a79e0588",
                                "text": "„Das Erkennen äußerlicher Zeichen von Krankheiten, die ‚Blickdiagnostik‘, wird leider zu wenig gelehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
