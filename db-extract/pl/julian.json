                    {
                        "translation_id": "e202a535-c890-4a08-84d9-2b7e0c1b3715",
                        "source_entry_id": "ca81844d-d005-3b9e-a7f6-b3f74577d06f",
                        "source_sense_id": "367d5275-a721-35a4-ba1e-e159ce763839",
                        "target_lang_word": "Julien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Julien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8747f43d-b885-3e88-9789-d7fc03a7c3ee",
                                        "entry_id": "4126e66a-c18c-3bda-a8be-5c982717737b",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f87dc90-7032-4067-bce7-4fb2ab41cf5b",
                                                "sense_id": "8747f43d-b885-3e88-9789-d7fc03a7c3ee",
                                                "text": "Rob Julien est propriétaire de la pourvoirie Gogama Lodge et a commencé à accueillir des travailleurs de Côté Gold en janvier. Certaines de ses cabines sont d’ailleurs déjà réservées pour le mois d’avril."
                                            },
                                            {
                                                "example_id": "5d403637-5842-4211-84b0-ccf8090af7e0",
                                                "sense_id": "8747f43d-b885-3e88-9789-d7fc03a7c3ee",
                                                "text": "Six anciens du Canadien de Montréal – les attaquants David Desharnais, Daniel Carr, Jordan Weal, Eric Staal et Adam Cracknell, de même que le défenseur Mark Barberio – seront de l’équipe de Claude Julien, assemblée par le directeur général Shane Doan."
                                            },
                                            {
                                                "example_id": "c6a8f3bd-4d8d-41a6-9018-52a950b25695",
                                                "sense_id": "8747f43d-b885-3e88-9789-d7fc03a7c3ee",
                                                "text": "Après cinq ans, elle rentre en Île-de-France enceinte de Julien Derouault, danseur rencontré dans la ville phocéenne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Julien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b5b3b29-430e-342d-8b94-6dea34afefd5",
                                        "entry_id": "27af2ec1-4df2-3e4a-b577-ceec1aa24c85",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd171dc3-a798-468c-8678-82bb2e6426cc",
                                                "sense_id": "1b5b3b29-430e-342d-8b94-6dea34afefd5",
                                                "text": "Le spectacle de cette douleur donnait son gros rire à son mari, tandis qu’elle voyait se contracter les beaux sourcils noirs et si bien arqués de Julien."
                                            },
                                            {
                                                "example_id": "90f4ef5e-ecec-42cd-90c7-dd512751e927",
                                                "sense_id": "1b5b3b29-430e-342d-8b94-6dea34afefd5",
                                                "text": "Julien se désabsorbe à regret de sa contemplation alphabétique et plafonnière, récite béat : je lis tu lis nous lisons, buvez du lait de bison."
                                            },
                                            {
                                                "example_id": "ec648212-f687-4cd6-9e52-dc68e91a0a00",
                                                "sense_id": "1b5b3b29-430e-342d-8b94-6dea34afefd5",
                                                "text": "Dès le printemps, Julien, accompagné de son chien Fax, emmène les chèvres gambader sur le terril. C'est la transhumance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
