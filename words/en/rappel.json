{
    "word_family": [
        "rappeller"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d07926a-dfc2-33ab-b578-bb6258d371dd",
                    "sense_definition": "To descend a steep slope or vertical drop by sliding down a rope in a controlled manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team had to <w>rappel</w> down the cliff to reach the stranded hiker.",
                            "target_lang_translations": {
                                "ru": "Спасательной команде пришлось <w>спуститься на веревке</w> по скале, чтобы добраться до застрявшего туриста."
                            }
                        },
                        {
                            "text": "Before you <w>rappel</w> down the mountain, make sure your harness is securely fastened.",
                            "target_lang_translations": {
                                "ru": "Прежде чем вы начнете <w>дюльферять</w> с горы, убедитесь, что ваша страховочная обвязка надежно закреплена."
                            }
                        }
                    ],
                    "synonyms": [
                        "abseil"
                    ],
                    "antonyms": [
                        "climb",
                        "ascend"
                    ],
                    "common_phrases": [
                        "rappel down the cliff",
                        "rappel from a helicopter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спускаться по крутому склону или вертикальной стене с помощью веревки контролируемым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться на веревке",
                                "target_lang_sense_clarification": "общий термин для альпинизма"
                            },
                            {
                                "target_lang_word": "дюльферять",
                                "target_lang_sense_clarification": "специальный альпинистский термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cd7927a-7cb6-3df2-839c-22aff7db5ec9",
                    "sense_definition": "To call back a hawk or falcon to the falconer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "falconry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falconer used a specific whistle to <w>rappel</w> the bird after its flight.",
                            "target_lang_translations": {
                                "ru": "Сокольничий использовал специальный свисток, чтобы <w>подозвать</w> птицу после полета."
                            }
                        },
                        {
                            "text": "It takes months of training to successfully <w>rappel</w> a hawk in the wild.",
                            "target_lang_translations": {
                                "ru": "Требуются месяцы тренировок, чтобы успешно <w>подзывать</w> ястреба в дикой природе."
                            }
                        }
                    ],
                    "synonyms": [
                        "recall"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in falconry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Призывать ястреба или сокола обратно к сокольничему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подзывать",
                                "target_lang_sense_clarification": "возвращать ловчую птицу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43a94497-a138-37a6-9062-53428a4d3098",
                    "sense_definition": "The act of descending a vertical surface using a doubled rope.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "climbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long <w>rappel</w> to the canyon floor took nearly twenty minutes.",
                            "target_lang_translations": {
                                "ru": "Долгий <w>спуск на веревке</w> ко дну каньона занял почти двадцать минут."
                            }
                        },
                        {
                            "text": "During the final <w>rappel</w> down the mountain, the wind began to pick up significantly.",
                            "target_lang_translations": {
                                "ru": "Во время последнего <w>дюльфера</w> с горы ветер начал значительно усиливаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "abseil"
                    ],
                    "antonyms": [
                        "ascent"
                    ],
                    "common_phrases": [
                        "final rappel",
                        "controlled rappel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт спуска по вертикальной поверхности с использованием двойной веревки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спуск на веревке",
                                "target_lang_sense_clarification": "процесс спуска"
                            },
                            {
                                "target_lang_word": "дюльфер",
                                "target_lang_sense_clarification": "техника скоростного спуска"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd779ac6-d49f-37bb-adb3-994f7625c4bb",
                    "sense_definition": "A specific drumbeat pattern used to signal soldiers to assemble or gather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_signals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drummer was ordered to beat the <w>rappel</w> to bring the troops back to the square.",
                            "target_lang_translations": {
                                "ru": "Барабанщику приказали бить <w>сбор</w>, чтобы вернуть войска на площадь."
                            }
                        },
                        {
                            "text": "As the sun set, the distant sound of the <w>rappel</w> echoed through the camp.",
                            "target_lang_translations": {
                                "ru": "Когда солнце зашло, далекий звук барабанного <w>сбора</w> эхом разнесся по лагерю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "beat the rappel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily historical military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный ритм барабанной дроби, используемый для сигнала солдатам собраться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "барабанный сигнал к сбору"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}