                        "entry_id": "c41d5b73-0332-3391-8892-a112e07a601e",
                        "glosses": [
                            "Boisson normande, alcoolisée et chaude composée à parts égales de cidre doux et de calvados, sucrée avec du miel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdb0680f-83c9-40cf-a135-ffe587b9be18",
                                "sense_id": "066d3b18-c570-3097-94c5-23a86e666cbb",
                                "text": "S’il a pris un chaud-froid, elle trouvera du cidre, de l’eau-de-vie ; elle lui fera un flip, comme sa mère : avec du poivre et des clous de girofle."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e09a862-93be-3134-8d01-08860e54def9",
                        "entry_id": "c41d5b73-0332-3391-8892-a112e07a601e",
                        "glosses": [
                            "Verre contenant cette boisson."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "fa40f68d-951f-31b5-b2bb-9e13ebedb408",
                        "entry_id": "c41d5b73-0332-3391-8892-a112e07a601e",
                        "glosses": [
                            "Boisson chaude faite d'ale épicée et sucrée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "25abbc46-b19f-36e5-8b71-a71de1da1782",
                        "entry_id": "c41d5b73-0332-3391-8892-a112e07a601e",
                        "glosses": [
                            "Cocktail à base de porto, de sucre et de jaunes d’œufs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a18a9c93-4f94-4068-af03-9c80b54150e0",
                                "sense_id": "25abbc46-b19f-36e5-8b71-a71de1da1782",
                                "text": "Cependant, une serveuse s'approche et le jeune homme commande :\n— Deux portos flips."
                            }
                        ]
                    }
                ],
