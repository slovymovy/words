                "senses": [
                    {
                        "sense_id": "1b852fe2-30e8-334b-b0bc-461d8573ebfb",
                        "entry_id": "ff92084f-3d4d-3f94-b26e-a8aad699f778",
                        "glosses": [
                            "de mate waarin iemand niet van zijn stuk te krijgen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b005efe8-7484-43b4-83df-6c4b54c334ba",
                                "sense_id": "1b852fe2-30e8-334b-b0bc-461d8573ebfb",
                                "text": "Het herinnerde aan de onwrikbaarheid van zijn grondvesten, die de bewoners gedurende het tijdelijke bewind van de Witten wellicht vergeten waren."
                            },
                            {
                                "example_id": "8b806317-477d-4921-8e7e-0fd6458ab00a",
                                "sense_id": "1b852fe2-30e8-334b-b0bc-461d8573ebfb",
                                "text": "Balkenende kreeg vaker dan hem lief was het verwijt onvoldoende regie te voeren wanneer er spanning binnen het kabinet of de coalitie ontstond. De politieke steun aan de Amerikaanse inval in Irak bleef hem jaren achtervolgen en zijn opstelling in dit dossier bevestigde voor de oppositie zijn koppigheid en onwrikbaarheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "f18d7ce6-3257-3d73-b6a4-df983739098b",
                        "entry_id": "ff92084f-3d4d-3f94-b26e-a8aad699f778",
                        "glosses": [
                            "iets dat helemaal vaststaat"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70269c57-23a4-4382-b64d-3672eed77e2e",
                        "source_entry_id": "ff92084f-3d4d-3f94-b26e-a8aad699f778",
                        "source_sense_id": "1b852fe2-30e8-334b-b0bc-461d8573ebfb",
                        "source_sense_description": "de mate waarin iemand niet van zijn stuk te krijgen is",
                        "target_lang_word": "obduracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obduracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                        "entry_id": "2bec784e-0b0d-356b-8850-fc2f1b96d88e",
                                        "glosses": [
                                            "The state of being obdurate, intractable, or stubbornly inflexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9346fe4e-cc29-4c91-ab33-29a89c47664d",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "By this hand thou, thinkeſt me as farre in the diuels booke, as thou and Falſtaffe, for obduracie and perſiſtancie, let the end trie the man, [...]"
                                            },
                                            {
                                                "example_id": "24cdf459-20f8-4a65-a6bd-3652eece2565",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "It might also serve to condemn the obduracy and hard-heartedness of the Jews, who relented not, when even the earth trembled and the rocks rent."
                                            },
                                            {
                                                "example_id": "c9d9321e-e65c-4242-80c4-0b0ba996c639",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "True mountain Liberty alone may heal\nThe pain which Custom's obduracies bring."
                                            },
                                            {
                                                "example_id": "ba5b085f-ad93-46ff-9474-e482f69594eb",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "She snatched up a stick and hit Cora across the rump with it. The stick was rotten and broke, without having caused Cora to budge an inch. Exasperated at an image of obduracy, the old woman scrabbled up another stick and began whacking at Cora with it[.]"
                                            },
                                            {
                                                "example_id": "67aa3e0a-67ac-4b92-aea4-2e1bcc8e469c",
                                                "sense_id": "8210221e-66e2-3af2-bf39-d7232caed009",
                                                "text": "Chanderpaul's obduracy might have broken lesser men, but Panesar more than matched him for relentlessness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
