                        "entry_id": "0ab87e0a-e506-3f50-bcbb-98013f716ed7",
                        "glosses": [
                            "A pickpocket who steals handkerchiefs."
                        ],
                        "tags": [
                            "UK",
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b06249b4-09a9-4747-afe5-e2bff015231b",
                                "sense_id": "725545f5-5754-34ef-bae2-8606891a7552",
                                "text": "You're barely breaking even with the snotters stealing handkerchiefs in the square."
                            }
                        ]
                    }
