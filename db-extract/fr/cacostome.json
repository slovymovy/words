                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e31b71-953c-4088-ba0f-c252da97b69a",
                                "sense_id": "2444b2b2-0b50-3d08-9bef-23aeda461170",
                                "text": "Ou bien , insinue ce cacostome, nos plaintes émanent de l'Envie ; laide concupiscence de qui n'a pas été convié à la table immaculée et saintement frugale de la Littérature Romande."
                            },
                            {
                                "example_id": "91f4fda4-cdce-4006-b920-bc0d1fcbcf06",
                                "sense_id": "2444b2b2-0b50-3d08-9bef-23aeda461170",
                                "text": "Toutes les fois que je me présente pour recevoir la Sainte Communion, mon sang ne fait qu'un tour en voyant, et surtout en sentant les nombreux cacostomes qui s'approchent de la Sainte Table."
                            }
                        ]
                    }
