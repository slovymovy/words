                "senses": [
                    {
                        "sense_id": "fe5ff249-b184-35ef-9d3b-f55b36c9daee",
                        "entry_id": "8c913086-b730-3178-a15f-68296addc7e1",
                        "glosses": [
                            "absichtliches oder psychisch bedingtes Verstummen einer Person, die ihre Muttersprache beherrscht, auf Zeit oder auf Dauer, ohne dass dafür organische Ursachen erkennbar sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d16933-751c-4069-9bae-a86b4a20f17e",
                                "sense_id": "fe5ff249-b184-35ef-9d3b-f55b36c9daee",
                                "text": "„8 Monate später setzt ein Zustand von partiellem Negativismus mit Mutazismus ein, derart daß die Kranke sich anfangs noch betätigt, aber nicht spricht und nur durch Zeichen ihre Wünsche zu erkennen gibt […].“"
                            },
                            {
                                "example_id": "dfb9fafc-bd3d-4636-b69a-99df823e36f0",
                                "sense_id": "fe5ff249-b184-35ef-9d3b-f55b36c9daee",
                                "text": "„Eine besondere Erscheinung ist das plötzliche Verstummen, das in seiner extremsten Entwicklung bis zum völligen Stummbleiben (Mutazismus) führen kann, in der Regel aber nur in der Form einer kurzen Pause auftritt.“"
                            }
                        ],
