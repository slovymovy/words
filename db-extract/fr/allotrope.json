                                    {
                                        "sense_id": "957d3937-2679-3caf-83c6-5274d57a4c95",
                                        "entry_id": "88b2fc69-a908-3325-90b9-65e55652fe9a",
                                        "glosses": [
                                            "Describing a form of an element that exhibits allotropy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603950e8-3130-40f5-b50b-19bd74318c6b",
                                                "sense_id": "957d3937-2679-3caf-83c6-5274d57a4c95",
                                                "text": "Graphite and diamond are allotropic forms of carbon."
                                            },
                                            {
                                                "example_id": "bb767e66-7d85-4a08-b2f7-b3a51a64f528",
                                                "sense_id": "957d3937-2679-3caf-83c6-5274d57a4c95",
                                                "text": "A symphony and a poem may be allotropic forms of the same matter: to use a common simile, there is red phosphorus and there is yellow, but both are phosphorus. Likewise there are different forms of art, but there is only one art."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
