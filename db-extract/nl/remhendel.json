                        "examples": [
                            {
                                "example_id": "b442711b-7fde-4472-89c6-5d260b7c7c83",
                                "sense_id": "0bb2c3f4-691d-38cf-83a2-5f03fc995546",
                                "text": "Een 11-jarige jongen uit Puimisson in de Franse Hérault heeft na een val in mei met zijn fiets vier maanden onbewust rondgelopen met een gebroken remhendel in het zitvlak, meldt de krant Midi Libre."
                            },
                            {
                                "example_id": "e63f41c0-3af6-48c4-b39f-b34a61055ac8",
                                "sense_id": "0bb2c3f4-691d-38cf-83a2-5f03fc995546",
                                "text": "Fenati kwam tijdens de race op het circuit van Misano op een recht stuk naast zijn landgenoot Stefano Manzi rijden en duwde de remhendel in van de motor van Manzi, die daardoor heel even uit balans raakte, maar wel overeind bleef."
                            }
                        ]
