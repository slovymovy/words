                "senses": [
                    {
                        "sense_id": "8ceb5cb7-fc73-37a7-b036-94dfbb422c4b",
                        "entry_id": "c3d598af-4a7f-3636-94c7-cbba414364ff",
                        "glosses": [
                            "Een model, een hanteerbare weergave. In het geval van een miniatuur: een verkleinde weergave."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768bf9f1-35f1-46b8-bd72-2ed4eac7afac",
                                "sense_id": "8ceb5cb7-fc73-37a7-b036-94dfbb422c4b",
                                "text": "Algauw gingen ze over in strelingen, en die strelingen werden het onmiskenbaar koppeltjeduikelen van een mens in miniatuur."
                            },
                            {
                                "example_id": "fcff79f7-6558-4ef6-8a6f-f85a36624798",
                                "sense_id": "8ceb5cb7-fc73-37a7-b036-94dfbb422c4b",
                                "text": "Als ze het pakje openmaakt, ziet ze dat er maar één miniatuur in zit."
                            },
                            {
                                "example_id": "b023fdcc-390e-446e-9bde-ca07d9fa8ce6",
                                "sense_id": "8ceb5cb7-fc73-37a7-b036-94dfbb422c4b",
                                "text": "In elke kamer staat een miniatuurtje van de miniatuur die zij heeft ontvangen: de groene stoelen, de luit, de wieg."
                            }
                        ]
                    }
                ],
