                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a5d3adbc-2359-3048-9f4f-6c103813bd66",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "Royal society.",
                                            "The residence of a sovereign, prince, nobleman, or other dignitary; a palace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b8973c-d6fa-447c-8346-5540f3ff33fb",
                                                "sense_id": "a5d3adbc-2359-3048-9f4f-6c103813bd66",
                                                "text": "The noblemen visited the queen in her court."
                                            },
                                            {
                                                "example_id": "31ee5ece-9e4f-4f55-8c1b-ca946d12cf91",
                                                "sense_id": "a5d3adbc-2359-3048-9f4f-6c103813bd66",
                                                "text": "This our court, infected with their manners, / Shows like a riotous inn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5e08df-f85b-35fd-81c3-63285f9a3900",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "Royal society.",
                                            "The collective body of persons composing the retinue of a sovereign or person high in authority; all the surroundings of a sovereign in his regal state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdef1924-0461-446c-a593-213c21333b26",
                                                "sense_id": "9c5e08df-f85b-35fd-81c3-63285f9a3900",
                                                "text": "Meronym: royal household"
                                            },
                                            {
                                                "example_id": "7882eba3-508e-49f6-b685-2c6d981513f1",
                                                "sense_id": "9c5e08df-f85b-35fd-81c3-63285f9a3900",
                                                "text": "The queen and her court traveled to the city to welcome back the soldiers."
                                            },
                                            {
                                                "example_id": "b63c0934-ae65-4649-9998-00ec9910abf0",
                                                "sense_id": "9c5e08df-f85b-35fd-81c3-63285f9a3900",
                                                "text": "My lord, there is a nobleman of the court at door would speak with you."
                                            },
                                            {
                                                "example_id": "5930b9a0-50fa-4ec9-971b-f2bbcee6e79b",
                                                "sense_id": "9c5e08df-f85b-35fd-81c3-63285f9a3900",
                                                "text": "Love rules the court, the camp, the grove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50390e9-2707-3b94-b909-4617bd0fe640",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "Royal society.",
                                            "Any formal assembling of the retinue of a sovereign."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db779b14-60c3-4a6d-b657-964fc97e88d2",
                                                "sense_id": "a50390e9-2707-3b94-b909-4617bd0fe640",
                                                "text": "The princesses[…] held their court within the fortress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69e8ac2-d4d3-372d-8af1-7b24712ba226",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "Attention directed to a person in power; behaviour designed to gain favor; politeness of manner; civility towards someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a62e6a-da8a-42a6-bd2a-02ef542f114d",
                                                "sense_id": "b69e8ac2-d4d3-372d-8af1-7b24712ba226",
                                                "text": "No solace could her paramour entreat / Her once to show, ne court, nor dalliance."
                                            },
                                            {
                                                "example_id": "2aa48faf-479c-41dc-8ea2-0fed15a94fa5",
                                                "sense_id": "b69e8ac2-d4d3-372d-8af1-7b24712ba226",
                                                "text": "I went to make court to the Duke and Duchess of Newcastle at their house in Clerkenwell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fadf98f-715b-3ed7-b72d-2e11bcca8c49",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "The hall, chamber, or place, where justice is administered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae578879-af8a-47c6-94a8-04849e523443",
                                                "sense_id": "9fadf98f-715b-3ed7-b72d-2e11bcca8c49",
                                                "text": "Many famous criminals have been put on trial in this court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "675ec35e-c5ac-3af7-b78c-0513099cd89e",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "The persons officially assembled under authority of law, at the appropriate time and place, for the administration of justice; an official assembly, legally met together for the transaction of judicial business; a judge or judges sitting for the hearing or trial of cases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a30b11c-e74b-47bf-8c11-c7de5e0831a3",
                                                "sense_id": "675ec35e-c5ac-3af7-b78c-0513099cd89e",
                                                "text": "The court started proceedings at 11 o'clock."
                                            },
                                            {
                                                "example_id": "59e4be72-5e76-4c8a-acd4-c0573daf3ff7",
                                                "sense_id": "675ec35e-c5ac-3af7-b78c-0513099cd89e",
                                                "text": "Next month, Clemons will be brought before a court presided over by a \"special master\", who will review the case one last time. The hearing will be unprecedented in its remit, but at its core will be a simple issue: should Reggie Clemons live or die?"
                                            },
                                            {
                                                "example_id": "6d832c61-846c-4e8b-adaa-ad02fe9f2d33",
                                                "sense_id": "675ec35e-c5ac-3af7-b78c-0513099cd89e",
                                                "text": "536(2.1). ... You have the option to elect to be tried by a provincial court judge without a jury; or you may elect to be tried by a judge without a jury; or you may elect to be tried by a court composed of a judge and jury."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7099d37-4ca1-303e-99b2-b618fe592bfa",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "An organization for the administration of law, consisting of a body of judges with a certain jurisdiction along with its administrative apparatus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f4fa5a8-614d-47ef-b3c7-8925ecf12711",
                                                "sense_id": "c7099d37-4ca1-303e-99b2-b618fe592bfa",
                                                "text": "Each province in Canada has three courts: a provincial court, a superior court, and a court of appeals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4267416-308f-303b-a0f3-cf4d41763aea",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "The judge or judges or other judicial officer presiding in a particular matter, particularly as distinguished from the counsel or jury, or both."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb8d4d1-746f-4549-b88e-07d5f65e5b0d",
                                                "sense_id": "c4267416-308f-303b-a0f3-cf4d41763aea",
                                                "text": "A case conference in person was convened.... To emphasize that it was a Court proceeding the Court was gowned."
                                            },
                                            {
                                                "example_id": "dc2c2964-9e9a-4c60-a386-36ec2cd52892",
                                                "sense_id": "c4267416-308f-303b-a0f3-cf4d41763aea",
                                                "text": "[5]... defence alleges there is a reasonable apprehension of bias based on the cumulative effect of several issues including the following: (1) The Court was “crying” during the victim impact statement; (2) The Court laughed or “scoffed” when defence stated its sentencing position; ...(6) The Court’s tone, facial expression and demeanor throughout the proceedings..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1327e507-d74c-3831-a809-5d7e8e71e27f",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "The session of a judicial assembly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f19db7-b5fa-4929-b753-161ab0f12cd0",
                                                "sense_id": "1327e507-d74c-3831-a809-5d7e8e71e27f",
                                                "text": "The court is now in session."
                                            },
                                            {
                                                "example_id": "0cab1946-73d0-427f-ab0b-50f91d501ce2",
                                                "sense_id": "1327e507-d74c-3831-a809-5d7e8e71e27f",
                                                "text": "On Thursday morning, a Hennepin County judge formally sentenced Julissa Thaler to the life sentence for Eli Hart's murder. […] After court, family said their focus now turns to fundraising a playground in Mound in Eli Hart's honor […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12292a7-b6d9-367f-a67b-b4ed62c21bbd",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "The administration of law.",
                                            "Any jurisdiction, civil, military, or ecclesiastical."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27c81b6a-ea3c-317c-a507-4c2afed2192e",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "A place arranged for playing the games of tennis, basketball, handball, badminton, volleyball, squash and some other games"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "986459f4-9904-44f8-bbe0-7c2845ba5131",
                                                "sense_id": "27c81b6a-ea3c-317c-a507-4c2afed2192e",
                                                "text": "The local sports club has six tennis courts and two squash courts."
                                            },
                                            {
                                                "example_id": "0299f3f6-20ec-4c49-98d1-40fba4c9c934",
                                                "sense_id": "27c81b6a-ea3c-317c-a507-4c2afed2192e",
                                                "text": "The shuttlecock landed outside the court."
                                            },
                                            {
                                                "example_id": "eefd672f-9c36-4753-8c00-cdc1a172e5b4",
                                                "sense_id": "27c81b6a-ea3c-317c-a507-4c2afed2192e",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f058e187-1160-334f-9846-021ad1212d94",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "A place arranged for playing the games of tennis, basketball, handball, badminton, volleyball, squash and some other games",
                                            "one of the two divisions of a tennis, badminton or volleyball court, in which the player or players of each team play"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae29401-a46d-44a3-a09e-0221ee45e3fb",
                                                "sense_id": "f058e187-1160-334f-9846-021ad1212d94",
                                                "text": "The photograph at left captures a great serve by Dr. Sadowsky, who will never forget one of Bobby Riggs's serves, which had such a great spin that it landed in his court and bounced back to the other side of the net before he had a chance to return it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67f9d652-03fa-31d9-bcd6-d9df7f615949",
                                        "entry_id": "67a1ddf2-ff53-3f5b-9634-f885c46c7097",
                                        "glosses": [
                                            "A space prepared and decorated by certain bird species in which to advertise themselves for a mate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f9ade01-a696-48e0-96d4-281b060084fa",
                                                "sense_id": "67f9d652-03fa-31d9-bcd6-d9df7f615949",
                                                "text": "The male Wilson's bird of paradise clears an area of rainforest to create a court in which to perform an elaborate mating dance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "court",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057138b7-9f56-39fa-b8b0-ded4db850ecb",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To seek to achieve or win (a prize)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dde6791f-81ff-49f9-b25b-a6f6609750ee",
                                                "sense_id": "057138b7-9f56-39fa-b8b0-ded4db850ecb",
                                                "text": "He was courting big new accounts that previous salesmen had not attempted."
                                            },
                                            {
                                                "example_id": "8e74bc94-68e4-4894-a338-b70e9d665b00",
                                                "sense_id": "057138b7-9f56-39fa-b8b0-ded4db850ecb",
                                                "text": "On the contrary, they employed the brief respite that was left them in fortifying one another's courage, and in bearing testimony to the truth in so earnest a manner that they might almost seem to have courted the crown of martyrdom."
                                            },
                                            {
                                                "example_id": "e20b2145-c911-4549-be7e-11cf1a2e7f90",
                                                "sense_id": "057138b7-9f56-39fa-b8b0-ded4db850ecb",
                                                "text": "Guilt and misery shrink, by a natural instinct, from public notice: they court privacy and solitude: and even in their choice of a grave will sometimes sequester themselves from the general population of the churchyard […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f84ea9a-b23f-3634-b572-72cf118c0355",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To risk (a consequence, usually negative)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855002ca-659b-4977-8fbe-e28f6aefe456",
                                                "sense_id": "1f84ea9a-b23f-3634-b572-72cf118c0355",
                                                "text": "She courted controversy with her frank speeches."
                                            },
                                            {
                                                "example_id": "f5461498-d988-43f1-9f6d-e54a910b5f79",
                                                "sense_id": "1f84ea9a-b23f-3634-b572-72cf118c0355",
                                                "text": "It is not unknown for hot axleboxes to fail completely and for wagons to become derailed as a result. Surely it is courting disaster to allow a train to proceed for up to seven miles with a defective vehicle before it can be brought to a halt?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72226ad4-e4a4-37f7-a098-9fb3a9c47ef7",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To try to win a commitment to marry from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87a3f07-545c-4da1-9ecf-9172dca38a82",
                                                "sense_id": "72226ad4-e4a4-37f7-a098-9fb3a9c47ef7",
                                                "text": "If either of you both love Katharina […] / Leave shall you have to court her at your pleasure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19fe6ef7-38c8-3b6c-a24c-96c37a1d4da1",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To engage in behavior conducive to mating with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c26ad792-3271-48bc-bedd-ee29e5d4ddc0",
                                                "sense_id": "19fe6ef7-38c8-3b6c-a24c-96c37a1d4da1",
                                                "text": "The bird was courting a potential mate by performing an elaborate dance."
                                            },
                                            {
                                                "example_id": "6cc76aa0-7f79-4eb0-882f-5e3828bf3df6",
                                                "sense_id": "19fe6ef7-38c8-3b6c-a24c-96c37a1d4da1",
                                                "text": "By one person, however, Portland was still assiduously courted, and that person was the king."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d99984ed-052e-378c-b4e5-1104e80371a5",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To attempt to attract; to invite by attractions; to allure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8af7d5b-78d4-4255-b07d-ab63398a75d6",
                                                "sense_id": "d99984ed-052e-378c-b4e5-1104e80371a5",
                                                "text": "[…] a well-worn pathway courted us / To one green wicket in a privet hedge […]"
                                            },
                                            {
                                                "example_id": "808be001-0980-4e18-9668-4f8294cf84a6",
                                                "sense_id": "d99984ed-052e-378c-b4e5-1104e80371a5",
                                                "text": "It is a grim, grey old town, standing on bleak, precipitous cliffs that court every passing hurricane, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d62578c-6ead-3f8f-8b43-c832d4558faa",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To attempt to gain alliance with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d49311d-113b-3659-a031-14628f004c12",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To engage in activities intended to win affections."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ca0dfd-8538-4cdb-875d-626eee04901f",
                                                "sense_id": "9d49311d-113b-3659-a031-14628f004c12",
                                                "text": "She's had a few beaus come courting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb35440-d109-3d66-8477-47cec734a084",
                                        "entry_id": "7f7bffa6-ac16-3c70-ae24-c9c61fc7d545",
                                        "glosses": [
                                            "To engage in courtship behavior."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "300d7e10-84cf-4178-9dbe-37f0d393eca7",
                                                "sense_id": "ecb35440-d109-3d66-8477-47cec734a084",
                                                "text": "At this time of year, you can see many animals courting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4932c65c-670e-43a2-9a0f-423acc40a4be",
                        "source_entry_id": "24176334-bd7c-3913-9e5f-3697e78b31b4",
                        "source_sense_id": "feee235c-4e35-3778-9793-280aa82c9675",
                        "source_sense_description": "een damesschoen zonder sluiting en met hoge hak",
                        "target_lang_word": "escarpin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escarpin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adcee96f-220c-3fd0-9f3a-2427497696a8",
                                        "entry_id": "db7b7116-199a-3eaf-bd37-f8a2b23938df",
                                        "glosses": [
                                            "Soulier découvert et à simple semelle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2100f34e-5e22-4ce3-93e5-24c677bd4df1",
                                                "sense_id": "adcee96f-220c-3fd0-9f3a-2427497696a8",
                                                "text": "Léon, le lendemain, fenêtre ouverte et chantonnant sur son balcon, vernit lui-même ses escarpins, et à plusieurs couches."
                                            },
                                            {
                                                "example_id": "521fa818-12ce-42ec-ade7-852878482610",
                                                "sense_id": "adcee96f-220c-3fd0-9f3a-2427497696a8",
                                                "text": "Nous sommes les petits lapins,\nGens étrangers à l’écriture\nEt chaussés des seuls escarpins\nQue nous a donnés la Nature."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13f864fc-94fb-33a0-b34d-8f43def8b61a",
                                        "entry_id": "db7b7116-199a-3eaf-bd37-f8a2b23938df",
                                        "glosses": [
                                            "Soulier féminin découvert, rigide et à talons hauts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5f9333b-723b-424e-8f8d-505a8e1d1abf",
                                                "sense_id": "13f864fc-94fb-33a0-b34d-8f43def8b61a",
                                                "text": "À l'intérieur, trois douzaines et demie de paires de souliers alignés étincellent. Des ballerines blanches. Plusieurs sortes d’escarpins noirs, des sandales vernies, des chaussures brunes à lacets qui font penser à Mary Poppins, des richelieus, des tongs, des Converse rouges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
