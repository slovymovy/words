                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "97d9764e-58f1-4679-a02d-8d36d0233450",
                        "entry_id": "1fba7f1f-6db7-30aa-a9d2-e41e6840e634",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more narcoleptic"
                    },
                    {
                        "form_id": "667312d3-6ed2-4bc7-99c7-1f6573d0f250",
                        "entry_id": "1fba7f1f-6db7-30aa-a9d2-e41e6840e634",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most narcoleptic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3319337c-9920-3c24-95f7-166fd25dfdaf",
                        "entry_id": "1fba7f1f-6db7-30aa-a9d2-e41e6840e634",
                        "glosses": [
                            "Pertaining to or affected by narcolepsy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8503ec6-2cae-4e10-b93d-9c05e2a1431e",
                                "sense_id": "3319337c-9920-3c24-95f7-166fd25dfdaf",
                                "text": "Miranda, who is narcoleptic and forgot to take her medication, was out cold for nearly 40 minutes after the plucky little girl called 911."
                            }
                        ]
                    },
                    {
                        "sense_id": "71fec000-7d99-383d-88ca-1da968b89a8c",
                        "entry_id": "1fba7f1f-6db7-30aa-a9d2-e41e6840e634",
                        "glosses": [
                            "Lacking activity; drowsy, lethargic."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5daea265-28ff-4318-8c63-af13ba7457e8",
                                "sense_id": "71fec000-7d99-383d-88ca-1da968b89a8c",
                                "text": "A tour guide, who claimed to have been a former Israeli colonel, whisked us about while he discoursed on chickpeas, the Six-Day War and, for the Christians among us, Jesus' difficult end. But the trip was pleasant in a narcoleptic, summery kind of way."
                            },
                            {
                                "example_id": "8e76283c-6bc8-444d-8b64-4151d1a4beb9",
                                "sense_id": "71fec000-7d99-383d-88ca-1da968b89a8c",
                                "text": "The loneliness of this new life, he said, is mitigated by Jacques, who spent most of the interview beached in a narcoleptic reverie at my feet, snoring and farting."
                            }
                        ]
                    },
                    {
                        "sense_id": "b95a190f-80f9-3879-ab08-1b50609fd405",
                        "entry_id": "1fba7f1f-6db7-30aa-a9d2-e41e6840e634",
                        "glosses": [
                            "Tending to \\\"put someone to sleep\\\"; extremely boring or tedious."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5dac3a48-a2ba-40ed-a720-435ef2736640",
                                "sense_id": "b95a190f-80f9-3879-ab08-1b50609fd405",
                                "text": "The debate started at 11.30am, nudging out of port with a characteristically narcoleptic speech from Lord Campbell of Alloway (Con)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9849f38d-a807-4c93-a2b7-e1ee5d963208",
