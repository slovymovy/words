                "translations": [
                    {
                        "translation_id": "95243a12-5fa5-41a2-a928-3a891388c78d",
                        "source_entry_id": "ca2dc908-3db4-3ea4-b009-8b0c59c7196a",
                        "source_sense_id": "da4daa3f-a855-3c91-a19e-8d43b013429e",
                        "target_lang_word": "relative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba44a1dd-c559-3bd6-a603-42b54db7309e",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Connected to or depending on something else; comparative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b14404c-f7a5-4387-9575-03720d4d00ab",
                                                "sense_id": "ba44a1dd-c559-3bd6-a603-42b54db7309e",
                                                "text": "For Liverpool, their season will now be regarded as a relative disappointment after failure to add the FA Cup to the Carling Cup and not mounting a challenge to reach the Champions League places."
                                            },
                                            {
                                                "example_id": "40c8021e-a704-4bf1-bad0-6beb052a7387",
                                                "sense_id": "ba44a1dd-c559-3bd6-a603-42b54db7309e",
                                                "text": "what is evidently clear is the nature and quality of rational thought exhibited by both types of minds. It can be stated that Kafka’s autistic mind is not susceptible to delusional concepts which might be presented as religious dogma by society or experienced by the self. For the neurotypical mind these concepts and experiences of existential doubt are harder to shake off since it appears that the neurotypical configuration of the self is an internal cognitive mechanism without an adequate external reality check. In contrast this external reality check appears to be present in the high-functioning autistic mind. It is thought that the autistic mind is more intimately connected with objective reality via its external sensory focus on reality and its superior understanding of physical causality, relative to neurotypical persons (Baron-Cohen et al. 1999; Paganini and Gaido 2013) and is therefore less susceptible to supernatural experiences or explanations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5273b4a7-f4b9-3821-989c-f69491c0f755",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Expressed in relation to another item, rather than in complete form."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9db52d1d-9360-4d53-8939-eff0f01a58f6",
                                                "sense_id": "5273b4a7-f4b9-3821-989c-f69491c0f755",
                                                "text": "The relative URL /images/pic.jpg, when evaluated in the context of http://example.com/index.html, corresponds to the absolute URL http://example.com/images/pic.jpg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c516aa4c-5186-3bb5-a448-e3b1f664d35b",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Depending on an antecedent; comparative."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb2d6ee2-1e75-41ac-b47a-52e24a8599b7",
                                                "sense_id": "c516aa4c-5186-3bb5-a448-e3b1f664d35b",
                                                "text": "The words “big” and “small” are relative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "707c066a-0008-3062-976a-57c03c57bb51",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Having the same key but differing in being major or minor."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825d1525-0630-30d1-9236-f7e9f78d3285",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Relevant; pertinent; related."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f82b518-c1b2-4503-8038-ff4d71afd4e8",
                                                "sense_id": "825d1525-0630-30d1-9236-f7e9f78d3285",
                                                "text": "relative to your earlier point about taxes, ..."
                                            },
                                            {
                                                "example_id": "4e11a2e0-9801-4baa-b588-473bc86e51eb",
                                                "sense_id": "825d1525-0630-30d1-9236-f7e9f78d3285",
                                                "text": "The Spirit that I haue ſeene\nMay be the Diuell, and the Diuel hath power\nT'aſſume a pleaſing ſhape, yea and perhaps\nOut of my Weakneſſe, and my Melancholly,\nAs he is very potent with ſuch Spirits,\nAbuſes me to damne me. Ile haue grounds\nMore Relatiue then this: The play's the thing,\nWherein Ile catch the Conſcience of the King."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0afe40e-3044-375d-b57e-74aa51f91c71",
                                        "entry_id": "446bd76a-1eea-33e0-817d-43d3e21f3188",
                                        "glosses": [
                                            "Capable to be changed by other beings or circumstance; conditional."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "relative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91b189c2-70e2-34ad-8873-14fff45c5d66",
                                        "entry_id": "f3332eac-a29b-319c-bb3b-8e71900b184d",
                                        "glosses": [
                                            "Alternative form of relatively."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f74f522-6f24-454e-bb33-595e4e7f4612",
                                                "sense_id": "91b189c2-70e2-34ad-8873-14fff45c5d66",
                                                "text": "In 1924 it moved to a commonious campus at Stockton. Like other Californian colleges, however, it decided to remain a relative small institution."
                                            },
                                            {
                                                "example_id": "f15f26f4-918a-47d2-9750-3df1ce41b8b7",
                                                "sense_id": "91b189c2-70e2-34ad-8873-14fff45c5d66",
                                                "text": "Mr. Schneebell. Instead of the relative small number of cases, you should phrase it probably differently.\nProfessor Brazer. I accept that correction."
                                            },
                                            {
                                                "example_id": "b78b664a-da88-43e3-bfab-df617e4414b0",
                                                "sense_id": "91b189c2-70e2-34ad-8873-14fff45c5d66",
                                                "text": "In addition to the typical external disturbances faced by small open economies, such as shocks to terms of trade, to capital flows, or to the rest of the world’s demand, it is subject to a number of idiosyncratic shocks stemming from its relative big neighbors Brazil and—especially—Argentina."
                                            }
                                        ]
                                    }
                                ]
                            },
