                "senses": [
                    {
                        "sense_id": "7677800a-0777-3973-be99-14cdd2464287",
                        "entry_id": "538e617d-24e9-3fde-93b5-18d20728c3f0",
                        "glosses": [
                            "zur Berufskleidung gehörende Kopfbedeckung für Berufsköche"
                        ],
                        "tags": [
                            "besonders bayrisch und österreichisch"
                        ],
                        "examples": [
                            {
                                "example_id": "239749c6-a107-4eeb-ac4a-8ad1e5337adf",
                                "sense_id": "7677800a-0777-3973-be99-14cdd2464287",
                                "text": "„Ihre turmhohe Kochhaube wippt im Rhythmus der Rührbewegungen. Mit flinker Hand bringt Melanie danach das Schwammerl-Risotto auf die bereits mit Salatblatt und Tomaten garnierten Teller.“"
                            },
                            {
                                "example_id": "1eb2dfab-a68f-4546-bf97-de5122802415",
                                "sense_id": "7677800a-0777-3973-be99-14cdd2464287",
                                "text": "„Hinter einer Anrichte stehen die Köche mit Kochhaube in blau-rot kariertem Rock und grinsen über alle vier Backen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
