                                    {
                                        "sense_id": "c8e1e8db-1541-3318-b8b4-581b9c954b9e",
                                        "entry_id": "809b9bfc-8f5c-3bc0-b254-970f899b9d61",
                                        "glosses": [
                                            "Ellipsis of antithetic variate."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bbfa9b2-4eaf-4157-a959-144f21d5eaf3",
                                                "sense_id": "c8e1e8db-1541-3318-b8b4-581b9c954b9e",
                                                "text": "Unlike antithetics, a control variable can be used for any attribute of the random variable Y that is being simulated […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d73b1ab1-26a9-4fac-b02f-21a9f1a15f9f",
                        "source_entry_id": "d951c55c-066e-31ef-940e-663d5b2928e4",
                        "source_sense_id": "2d65917e-fea4-3e9c-855a-2002fd5c6197",
                        "target_lang_word": "antithetical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antithetical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e55a0f5-8715-329b-ae4c-bea7f650cf69",
                                        "entry_id": "ed59cfc7-ab34-387e-a0ba-bd7c886b8d08",
                                        "glosses": [
                                            "Pertaining to antithesis, or opposition of words and sentiments; containing, or of the nature of, antithesis; contrasted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8a34cd4-004a-40cb-99f8-bff7a5a93d81",
                                                "sense_id": "6e55a0f5-8715-329b-ae4c-bea7f650cf69",
                                                "text": "His wrong-headed beliefs are antithetical to everything we stand for as a community."
                                            },
                                            {
                                                "example_id": "d3e879d1-ddad-43d5-8d45-441e831e4ce0",
                                                "sense_id": "6e55a0f5-8715-329b-ae4c-bea7f650cf69",
                                                "text": "This is precisely why insistence on relative truth is antithetical to critical thinking."
                                            },
                                            {
                                                "example_id": "529e2c43-fffb-456a-a8f2-7abe9dc79316",
                                                "sense_id": "6e55a0f5-8715-329b-ae4c-bea7f650cf69",
                                                "text": "Saladin's prophetic namesake, by any account as obviously an antiwarrior as one can imagine, seems at first too antithetical a character for comparison with the anti-Crusader par excellence, and therein lies the hagiographical dynamic at work."
                                            },
                                            {
                                                "example_id": "6a503f1d-f41b-46c4-8f2c-a11524f31c51",
                                                "sense_id": "6e55a0f5-8715-329b-ae4c-bea7f650cf69",
                                                "text": "Yet as Mr. Altman raised OpenAI’s profile, some board members worried that ChatGPT’s success was antithetical to creating safe A.I., two people familiar with their thinking said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4f77cb7-aff3-4e7a-993d-7702f496dced",
                        "source_entry_id": "d951c55c-066e-31ef-940e-663d5b2928e4",
                        "source_sense_id": "2d65917e-fea4-3e9c-855a-2002fd5c6197",
