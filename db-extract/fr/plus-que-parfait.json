                "senses": [
                    {
                        "sense_id": "6463fa10-734f-31ce-90a5-fdc4800e32f9",
                        "entry_id": "ce0f483f-3f4e-3ff3-873f-71f07d15ed76",
                        "glosses": [
                            "Temps d'un verbe à l’indicatif ou au subjonctif qui marque une action passée antérieurement à un autre temps déjà passé."
                        ],
                        "tags": [
                            "conjugation"
                        ],
                        "examples": [
                            {
                                "example_id": "3739a669-3976-43f9-bfe3-9c7203263879",
                                "sense_id": "6463fa10-734f-31ce-90a5-fdc4800e32f9",
                                "text": "Dans la phrase « J’avais fini de souper quand il arriva. », le verbe finir est au plus-que-parfait."
                            },
                            {
                                "example_id": "466658f8-0bbf-47b9-a692-de6d5a4516df",
                                "sense_id": "6463fa10-734f-31ce-90a5-fdc4800e32f9",
                                "text": "Tous les plus-que-parfaits ont les mêmes désinences : -eram / eras / erat aux 1ᵉʳ, 2ᵉ et 3ᵉ du singulier, -eramus/ eratis/ erant aux 1ʳᵉ, 3ᵉ et 3ᵉ du pluriel en latin."
                            },
                            {
                                "example_id": "400c6b34-f709-4834-a624-2be2fa5e4e52",
                                "sense_id": "6463fa10-734f-31ce-90a5-fdc4800e32f9",
                                "text": "Le père de Lamourette fut tué dès le début, à l’heure exacte où Félix Chèvreplat récitait le plus-que-parfait du verbe passif deleor."
                            }
                        ]
                    }
                ],
