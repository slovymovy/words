                ],
                "senses": [
                    {
                        "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                        "entry_id": "68897fe9-d935-3f17-9705-5b4cd4932b59",
                        "glosses": [
                            "ou Celui-ci, celui-là, la personne ou la chose dont on vient de parler. S’emploie dans le style de procédure ou plaisanterie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d1b7cce3-98c8-4072-a0ea-1554be7716d7",
                                "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                                "text": "Dans la maison d’icelui."
                            },
                            {
                                "example_id": "5758ff3f-2584-4856-9e9a-8b31e96a4170",
                                "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                                "text": "Comment Candide fut élevé dans un beau château et comment il fut chassé d’icelui."
                            },
                            {
                                "example_id": "69422fd5-dbe6-4564-ae5b-012a2ea54d8a",
                                "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                                "text": "Ça prouvait simplement qu’il y avait une justice. En bon serviteur d’icelle, il n’aurait pas dû des plaindre."
                            },
                            {
                                "example_id": "2e86f58b-10a6-4d76-ad05-b49cf79ff304",
                                "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                                "text": "J’ai le billet, et, en vertu d’icelui, une bonne sentence par corps.."
                            },
                            {
                                "example_id": "3c2f7fcd-969c-4a6e-a619-a89ae19b2b03",
                                "sense_id": "10069afe-0114-33d8-b4b8-666f63d421c9",
                                "text": "Nous, Guillaume de Nogaret, chevalier, secrétaire général du royaume et gardien des Sceaux de France par la grâce de notre bien-aimé Sire, le roi Philippe quatrième, avons, sur l’ordre d’icelui, ce jour, vingt-cinquième d’avril mille trois cent quatorze, […]"
                            }
                        ]
                    }
                ],
