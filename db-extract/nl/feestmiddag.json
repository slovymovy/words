                        "examples": [
                            {
                                "example_id": "5439673b-6bb3-459e-8453-117db5930673",
                                "sense_id": "ffb81cd8-fea4-30b8-a22f-4e62776c96cb",
                                "text": "Bayern München is voor de 29ste keer kampioen van Duitsland geworden. Ook voor Arjen Robben was er een hoofdrol op de Beierse feestmiddag."
                            },
                            {
                                "example_id": "e095cdf8-7d8a-4d57-b217-589122b9c3c3",
                                "sense_id": "ffb81cd8-fea4-30b8-a22f-4e62776c96cb",
                                "text": "De olympische medaillewinnaars sloten de feestmiddag af met een fietstocht door de Haagse binnenstad naar Paleis Noordeinde om daar de felicitaties te ontvangen van koning Willem-Alexander en koningin Máxima."
                            },
                            {
                                "example_id": "9e4cecdd-c056-41e8-b338-3995ddd38931",
                                "sense_id": "ffb81cd8-fea4-30b8-a22f-4e62776c96cb",
                                "text": "Op het Brionplein waren gisteren de repetities voor de feestmiddag op 30 april. Kinderen van verschillende basisscholen op het eiland oefenden daar een dans. Er werd muziek gemaakt en er werden podia opgebouwd."
                            }
                        ]
                    }
