                {
                    "sense_id": "0e49b8fa-87d3-3e27-8ab5-ea656088a1e3",
                    "sense_definition": "meervoud van <w>loods</w> (iemand die schepen veilig door een bepaald gebied vaart)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beroepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren <w>loodsen</w> hielpen de grote schepen om veilig de haven binnen te varen.",
                            "target_lang_translations": {
                                "en": "The experienced <w>pilots</w> helped the large ships to enter the harbor safely.",
                                "ru": "Опытные <w>лоцманы</w> помогали большим кораблям безопасно зайти в порт."
                            }
                        },
                        {
                            "text": "Zonder de hulp van lokale <w>loodsen</w> is het erg gevaarlijk om door dit kanaal te varen.",
                            "target_lang_translations": {
                                "en": "Without the help of local <w>pilots</w>, it is very dangerous to sail through this canal.",
                                "ru": "Без помощи местных <w>лоцманов</w> очень опасно идти по этому каналу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'loods' (a person who navigates ships safely through a specific area)",
                        "ru": "множественное число от 'loods' (человек, который безопасно проводит суда через определенную зону)"
