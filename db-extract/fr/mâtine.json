                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19cb7755-7186-4339-8f4a-69d6cc62310a",
                        "entry_id": "0bd8d8da-854f-3d2c-8c4d-e9ec54da866a",
                        "tags": [
