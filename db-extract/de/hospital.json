                ],
                "senses": [
                    {
                        "sense_id": "cb29430f-97f0-3200-9940-c1a0ce7260a9",
                        "entry_id": "9fe4b9d0-f7f0-3e4a-91d8-f522a6cb7e97",
                        "glosses": [
                            "Anstalt zur Versorgung Kranker und/oder Pflegebedürftiger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "250e5008-93fe-4f4f-b067-f532d151ac6c",
                                "sense_id": "cb29430f-97f0-3200-9940-c1a0ce7260a9",
                                "text": "„Wir liegen in einem katholischen Hospital, im gleichen Zimmer.“"
                            },
                            {
                                "example_id": "728ca259-0590-4a6a-8c30-adc58cce5e13",
                                "sense_id": "cb29430f-97f0-3200-9940-c1a0ce7260a9",
                                "text": "„Das Hospital lag hoch über Bamako.“"
                            },
                            {
                                "example_id": "01f4c152-280e-42c1-8930-30c952c293f7",
                                "sense_id": "cb29430f-97f0-3200-9940-c1a0ce7260a9",
                                "text": "„Nachdem wir das Hospital verlassen hatten, vereinbarten wir, dass wir jeder eine Feldflasche besorgen würden, um zwischen den Toten umherzugehen und ihren Jamaika-Rum abzuzapfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18f60b7d-1b46-4907-8c2c-e9ff710fa936",
                        "source_entry_id": "9fe4b9d0-f7f0-3e4a-91d8-f522a6cb7e97",
                        "source_sense_id": "cb29430f-97f0-3200-9940-c1a0ce7260a9",
                        "source_sense_description": "Anstalt zur Versorgung Kranker und/oder Pflegebedürftiger",
                        "target_lang_word": "hospital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hospital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A large medical facility, usually in a building with multiple floors, where seriously ill or injured patients are given extensive medical or surgical treatment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5fd76b0-2e9e-4f5e-827a-d9282fb554f1",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "Luckily an ambulance arrived quickly and he was rushed to hospital."
                                            },
                                            {
                                                "example_id": "ed5e6196-d474-416e-8e51-7dfb3308e1b5",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "Luckily an ambulance arrived quickly and he was rushed to the hospital."
                                            },
                                            {
                                                "example_id": "4bd40bbf-da3a-4080-8c58-529266bce619",
                                                "sense_id": "60f7a115-43d1-3633-941d-abc0f849afcc",
                                                "text": "This section of the Act gives the court powers to assess whether treatment is going to be beneficial and hence whether hospital is a suitable disposal option."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8b42017-7fe7-3e4c-8e2a-7e42ae70504f",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A building founded for the long-term care of its residents, such as an almshouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ba4618-0209-4a59-8136-8d14f6b3d4a2",
                                                "sense_id": "f8b42017-7fe7-3e4c-8e2a-7e42ae70504f",
                                                "text": "The foundling hospital took in abandoned children and educated them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a329a518-323f-3933-a98a-8939ae5f0c7c",
                                        "entry_id": "5fa140a8-dce7-33f9-b766-3fff1c8acdba",
                                        "glosses": [
                                            "A place of lodging."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a8c8c33-40b9-4253-b6cb-a8d9f46172e8",
                                                "sense_id": "a329a518-323f-3933-a98a-8939ae5f0c7c",
                                                "text": "[…] they spide a goodly castle, plast / Foreby a riuer in a pleasaunt dale, / Which choosing for that euenings hospitale, / They thither marcht […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hospital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86dd84c6-3740-3134-9c10-4d6561a7e26f",
                                        "entry_id": "501a7e4e-2fb4-3a85-8b73-6c5566bbd591",
                                        "glosses": [
                                            "Hospitable."
                                        ],
