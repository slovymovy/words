                                        "entry_id": "d002797e-f497-3a56-b4d1-11392307a1c3",
                                        "glosses": [
                                            "originario dei propri antenati, riconducibile ai propri avi o alla propria stirpe intesa nel significato più ampio e generico del termine"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "982c3aec-040f-4005-bb97-3e35ea9a0e86",
                                                "sense_id": "a0ee7ae3-b65e-32e1-b849-61cda5faad60",
                                                "text": "Su le ruine del castello avito, / giovine, bello, pallido, senz'ira, / ei maneggiava sopra i salïenti / la baionetta. (Giosue Carducci, Bicocca di San Giacomo, Rime e ritmi)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca8f004b-f998-32a3-87d8-92ee7d7d22ab",
                                        "entry_id": "d002797e-f497-3a56-b4d1-11392307a1c3",
                                        "glosses": [
                                            "ottenuto in eredità, sia in senso materiale che spirituale, dai propri avi"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5da2e8fc-a685-49a3-b068-ee353f0bf1c9",
                                                "sense_id": "ca8f004b-f998-32a3-87d8-92ee7d7d22ab",
                                                "text": "Ma come dire la parola necessaria senza compromettere il proprio avito nome neppure dinanzi alla fanciulla nel caso che essa sinceramente non volesse accettare da lui altro che un impiego?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
