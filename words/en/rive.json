                {
                    "sense_id": "53ac53e3-b3ca-3d58-88b5-8d9d35428499",
                    "sense_definition": "The bank of a river or the shore of a body of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman sat quietly on the <w>rive</w> waiting for a bite.",
                            "target_lang_translations": {
                                "ru": "Рыбак тихо сидел на <w>берегу</w>, ожидая клева."
                            }
                        },
                        {
                            "text": "Flowers grew in abundance along the grassy <w>rive</w> of the stream.",
                            "target_lang_translations": {
                                "ru": "Цветы в изобилии росли вдоль травянистого <w>берега</w> ручья."
                            }
