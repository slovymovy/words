                        "tags": [
                            "past"
                        ],
                        "form": "unbridled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3664df82-50ff-3551-ac5a-10d121335add",
                        "entry_id": "1cfe72fd-0303-302c-83c0-b9156a2537b1",
                        "glosses": [
                            "To remove the bridle, and other tack, from (a horse or other animal)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b49b6e00-36cc-3fb1-b6d5-2b0fc25559da",
                        "entry_id": "1cfe72fd-0303-302c-83c0-b9156a2537b1",
                        "glosses": [
                            "To remove restraint from."
                        ],
                        "tags": [
                            "figuratively",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "99ad61d5-8c8c-4c8e-8123-8c0eb8b32a71",
                                "sense_id": "b49b6e00-36cc-3fb1-b6d5-2b0fc25559da",
                                "text": "If we unbridle our greed and lust we will be nothing but animals."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23f630b1-f6f5-4802-8438-d8bdfd20847a",
                        "source_entry_id": "1cfe72fd-0303-302c-83c0-b9156a2537b1",
                        "source_sense_description": "To remove the bridle",
                        "target_lang_word": "débrider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débrider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Débarrasser de la bride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1da45ca-e4b5-4033-8418-f92616fa8316",
                                                "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                                "text": "Il ne faut pas encore débrider ce cheval."
                                            },
                                            {
                                                "example_id": "5167ecee-e693-4b67-8e97-50483e1250eb",
                                                "sense_id": "6c6420d3-323b-3f79-9b7c-13a89c54a02d",
                                                "text": "— Si je ne la débridais pas, elle casserait tout.\nFanchon, débarrassée de la bride et même de la selle que son maître lui enleva lestement, alla flairer et saluer, d’un hennissement amical, sa paisible hôtesse, la jument du métayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25be7e4a-5933-34f2-b24b-0704058ce29a",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Ôter le dispositif qui bride la vitesse d'un moteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b21fc3f2-d6d4-3d24-b491-125a8d0f3982",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Se donner un temps de repos, cesser un mouvement."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a2f208-4e77-4d17-9e83-ba028c626e7d",
                                                "sense_id": "b21fc3f2-d6d4-3d24-b491-125a8d0f3982",
                                                "text": "Il est temps de débrider. - La cavalerie venait de débrider, quand tout à coup on vit paraître les ennemis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca9546d-9058-3988-8faf-31e8d3bf3131",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Dégager ce qui est serré."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4cd082e-2277-3326-8dce-89535c485afb",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Couper les fils avec lesquels on avait attaché les membres d'une volaille, pour la faire cuire."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3386f6-4e2d-4c6f-8a0b-addb24fdfd5c",
                                                "sense_id": "c4cd082e-2277-3326-8dce-89535c485afb",
                                                "text": "Au moment de servir, déballez, débridez et dressez; passez à l’étamine le jus égoutté, ajoutez-le à une sauce financière demi-liée, et saucez les perdreaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b5d6e3-a4d8-3641-b3f5-62c5fc142bb9",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Dégager une charge du câble qui a servi à la hisser."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Couper les brides ou filaments d'une suture, qui empêchent l’écoulement du pus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d5cd05-4415-4c85-a910-d41edd44bb08",
                                                "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                                "text": "Pour prévenir le moindre soupçon, je lui tendis la lettre ; mais il affecta de ne point la lire, et comme s’il eût décidé que le moment était venu de me parler raison et de débrider largement une plaie qui languissait sans résultat : […]"
                                            },
                                            {
                                                "example_id": "7993622c-7acc-40bf-9743-ae9f231a7777",
                                                "sense_id": "46ef03fe-1fb0-374e-870b-1444b65989ca",
                                                "text": "Les choses n'iront pas plus loin, mais la soirée sera gâchée par une lancinante impression d'abcès non débridé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96cc361d-3001-3fff-9030-d57a8cb89ccd",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Contourner les protections d’un système pour supprimer les restrictions d’utilisation mises en place par le constructeur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                        "entry_id": "8aa9a1cc-11d6-3fb0-bf80-a57800b5c67a",
                                        "glosses": [
                                            "Agir sans retenue."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071166c7-3fa8-430d-8659-d72b08896a93",
                                                "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                                "text": "Ils mangent et boivent, font ripaille, remuent leurs membres, embrassent les filles, sonnent les cloches, s'emplissent de bruit : rudes bacchanales où l'homme se débride, et qui sont la consécration de la vie naturelle : les puritains ne s'y sont pas trompés."
                                            },
                                            {
                                                "example_id": "7ef15700-70cb-4610-ab91-1f45ab09d3ec",
                                                "sense_id": "39efc9db-7574-3eaf-93df-e57d1a9a3cd4",
                                                "text": "Et durant deux grandes heures, je travaillai à mon drame, écrivant sans débrider."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f9e71f9-3379-438d-97ee-ef036995c4bd",
                        "source_entry_id": "1cfe72fd-0303-302c-83c0-b9156a2537b1",
                        "source_sense_description": "To remove the bridle",
                        "target_lang_word": "abzäumen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abzäumen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "792828bb-d5d6-37b7-8780-f2a858a774fd",
                                        "entry_id": "1effe53b-8f66-3e22-8d98-a2281953a27a",
                                        "glosses": [
                                            "von einem Tier das Zaumzeug abnehmen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a3cc6b8-1b8c-4183-b6d0-cffc12544f9f",
                                                "sense_id": "792828bb-d5d6-37b7-8780-f2a858a774fd",
                                                "text": "Er zäumte sein Reitpferd ab."
                                            },
                                            {
                                                "example_id": "cf8a543e-3d49-4c1d-99f8-e3eea81847ec",
                                                "sense_id": "792828bb-d5d6-37b7-8780-f2a858a774fd",
                                                "text": "Der Bauer hat die Ochsen abgezäumt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
