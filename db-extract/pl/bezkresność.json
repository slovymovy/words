                    }
                ],
                "translations": [
                    {
                        "translation_id": "b020b53a-82dc-4260-b527-8c52e2136592",
                        "source_entry_id": "a56c4869-0b90-386b-8f75-4cdb2efa9a98",
                        "source_sense_id": "243bd30f-6d9a-3fe7-82a2-628da729be08",
                        "source_sense_description": "Weite von scheinbar grenzenlosem Ausmaß: Grenzenlosigkeit, Unendlichkeit, Endlosigkeit",
                        "target_lang_word": "Grenzenlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "91bf83b3-6f46-46da-bae2-be7c4d7ca10f",
                        "source_entry_id": "a56c4869-0b90-386b-8f75-4cdb2efa9a98",
                        "source_sense_id": "243bd30f-6d9a-3fe7-82a2-628da729be08",
                        "source_sense_description": "Weite von scheinbar grenzenlosem Ausmaß: Grenzenlosigkeit, Unendlichkeit, Endlosigkeit",
                        "target_lang_word": "Unendlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unendlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "nicht begrenzter Zustand; Ausmaß, dessen Grenzen nicht absehbar sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04b303c7-7033-4ed2-b620-d92be8286d5e",
                                                "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                                "text": "„Auch im Bild findet sich eine Grenze, die den sinnierenden Mönch von der Unendlichkeit des Meeres und des Himmels trennt.“"
                                            },
                                            {
                                                "example_id": "2b14185b-b302-4181-8442-728f4e9a630b",
                                                "sense_id": "fff9a79f-7457-339e-9728-bc4f7286a275",
                                                "text": "„Aber die alten Reisenden, die auf Segelschiffen die Welt durchquerten, waren mindestens genauso dramatisch, glaubten an Monster und rachsüchtige Göttinnen und die Unendlichkeit einer Welt, die sie nicht verstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "etwas nicht in einem begrenzten Zeitraum Abzählbares"
                                        ],
                                        "tags": [
                                            "Mengenlehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d3f2e0-d51e-4923-868e-c5d081534a5e",
                                                "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                                "text": "„Zwei Mathematiker haben bewiesen, dass zwei Unendlichkeiten gleich groß sind.“"
                                            },
                                            {
                                                "example_id": "d485011e-6dd1-4eb5-922d-d93d7c519368",
                                                "sense_id": "0a24a137-2999-3800-a788-dab38ceedf46",
                                                "text": "„Ob Keplers Vermutung zur Kugelpackung, das Rätsel der Primzahlen-Zwillinge oder die Frage nach verschiedenen Unendlichkeiten: In der Mathematik geht es oft darum, allgemeingültige Muster und Gesetzmäßigkeiten zu erkennen und mathematisch zu beweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7bb93946-76eb-38db-8810-f94b553adadf",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "etwas nicht in begrenzter Zeit Durchmessbares"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754c2d93-23d6-46e9-a7ea-511e94188894",
                                                "sense_id": "7bb93946-76eb-38db-8810-f94b553adadf",
                                                "text": "„Als Lee Jay darunter stand, meinte er, es ginge in alle Unendlichkeit des schwarzen Himmels über ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9ba934af-2ad4-3115-9dd9-f157f57fbaaf",
                                        "entry_id": "6c2160df-0be2-3e38-9b60-c2bc933b12a6",
                                        "glosses": [
                                            "langer Zeitraum"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
