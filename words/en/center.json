                            },
                            {
                                "target_lang_word": "中心",
                                "target_lang_sense_clarification": "内部区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13456927-18ed-3fca-bb0e-610b0d26c1f8",
                    "sense_definition": "A topic or person that is the main focus of attention or discussion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous actor was the <w>center</w> of attention at the party.",
                            "target_lang_translations": {
                                "ru": "Известный актер был в <w>центре</w> внимания на вечеринке.",
                                "zh": "那位著名演员是聚会上众人关注的<w>中心</w>。"
                            }
                        },
                        {
                            "text": "This controversial issue is at the <w>center</w> of the debate.",
