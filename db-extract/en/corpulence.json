                        "target_lang_word": "ту́чность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ту́чность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fd8338b6-6a4d-3d18-a728-d038784815e1",
                                        "entry_id": "5e0e26fd-962d-3e1d-bd96-c3aa687f271d",
                                        "glosses": [
                                            "свойство по значению прилагательного тучный; полнота, упитанность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08354380-b2ab-4639-98a1-eb886d9dfb35",
                                                "sense_id": "fd8338b6-6a4d-3d18-a728-d038784815e1",
                                                "text": "За ним — Чамберс, Меньшиков, Аникита Иванович Репнин и — последним — Апраксин Петр Матвеевич, — этому весьма мешала тучность и верчение головы: шутка ли взлезать на такую страсть — сажен на десять над землей."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d3b429e-73da-4f5b-adbb-aeadffc501e2",
                        "source_entry_id": "f00f9689-2cdb-3781-90e4-405259f4eada",
                        "source_sense_id": "de319926-6b64-304d-993c-3a41d2ba0c77",
                        "source_sense_description": "characteristic or state of being corpulent",
                        "target_lang_word": "доро́дность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "доро́дность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5ba926ed-0423-3fe8-8177-e2d00ef039e4",
                                        "entry_id": "2068c0bf-fd83-3b97-be9e-2d4242ba9b92",
                                        "glosses": [
                                            "устар. свойство по значению прилагательного дородный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2774cc5-496b-41ae-8404-143f74b1a548",
                                                "sense_id": "5ba926ed-0423-3fe8-8177-e2d00ef039e4",
                                                "text": "Осмотрев меня внимательно, и в особенности мою дородность, она обратилась к прежнему дворецкому и, по-видимому холоднокровно, спросила: — Ты, голубчик, зачем здесь?"
                                            },
                                            {
                                                "example_id": "b8c7d3b4-7c75-4d55-a34d-d93fc0204c7f",
                                                "sense_id": "5ba926ed-0423-3fe8-8177-e2d00ef039e4",
                                                "text": "Члены встретили его с изъявлениями глубокого подобострастия, придвинули ему кресла из уважения к его чину, летам и дородности…"
                                            },
                                            {
                                                "example_id": "8f67ed3f-9037-4956-8742-a64f4bf730f5",
                                                "sense_id": "5ba926ed-0423-3fe8-8177-e2d00ef039e4",
                                                "text": "Рост она имела почти исполинский, дородность и силу совершенно соразмерную."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
