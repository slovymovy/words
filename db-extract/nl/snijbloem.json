                "senses": [
                    {
                        "sense_id": "92c81504-c201-3ee2-914f-d2646dcde86d",
                        "entry_id": "528d32a8-1656-3dc5-8c3f-171e165916ff",
                        "glosses": [
                            "een plant die gekweekt wordt om als bloem met afgesneden steel (en dus niet als bol of plant) verkocht te worden en je in een vaas kunt zetten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74cbbc58-24b3-4e3b-82dd-c5e4e6d7725b",
                                "sense_id": "92c81504-c201-3ee2-914f-d2646dcde86d",
                                "text": "Dit is wie ik ben. Tot in de details.’ En ze wijst naar het bloemenboeket op tafel. Een mix-en-match van snijbloemen in uitbundige kleuren. ‘”Een Amsterdams boeket”, noemen ze dat in Brabant. Om maar te zeggen: dat eigen willetje steken die Amsterdammers zelfs in de boeketten die ze op tafel zetten. Ik doe het intussen ook (lacht).’"
                            },
                            {
                                "example_id": "6c08043e-a2bb-4e40-94e7-ba307c74bbb1",
                                "sense_id": "92c81504-c201-3ee2-914f-d2646dcde86d",
                                "text": "Snijbloemen leverden met een groei van 14 procent 271 miljoen euro bij aan de export. Pot- en tuinplanten waren goed voor 136 miljoen euro, hetgeen een stijging met 8 procent betekende. Dit kwam vooral doordat bloemen duurder waren."
                            }
                        ]
                    }
