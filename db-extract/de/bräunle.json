                "senses": [
                    {
                        "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                        "entry_id": "c9821459-eac3-3409-b0be-c2775bf2d423",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328d8ac3-0978-4313-96fc-6ce9ce40871a",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Frau Bräunle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7780a40b-3c83-43a6-b240-2c4b7671812f",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Herr Bräunle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bc0ef035-3c06-40d5-9a00-637aa7fd0c5a",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Die Bräunles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bccd6e29-cfd1-44a8-a15e-6c11bb7fa24d",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Der Bräunle trägt nie die Schals, die die Bräunle ihm strickt."
                            },
                            {
                                "example_id": "fed11635-4f6c-4ac1-bb1c-9995292b36a3",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bräunle kommt, geht der Herr Bräunle.“"
                            },
                            {
                                "example_id": "4be78fd2-de94-474a-be53-43c29e834d98",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Bräunle kommt und geht."
                            },
                            {
                                "example_id": "0f6777ef-bc6d-49da-b6c5-0d26c0e27d75",
                                "sense_id": "0f2f5d8a-7513-3c60-b38f-d40af909be77",
                                "text": "Bräunles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
