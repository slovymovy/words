                        "entry_id": "eabff61a-ff66-3592-a88a-32efc0c66f1b",
                        "glosses": [
                            "Extremely irrational or unreasonable, insane, crazy."
                        ],
                        "tags": [
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9f1019fb-b55d-4929-880b-56b5ca5e8d4f",
                                "sense_id": "7a332ba2-2876-3673-a6e3-151c10385398",
                                "text": "Don't take any courses from that professor. She's completely batshit."
                            },
                            {
                                "example_id": "e89a0f6d-94b4-4b07-9601-cb22e9c5b2fa",
                                "sense_id": "7a332ba2-2876-3673-a6e3-151c10385398",
                                "text": "And what the fuck are you doing on TV anyhow? You know I get calls from back home every fuckin day, they think you went batshit!"
                            },
                            {
                                "example_id": "6c123ca9-fe97-4828-ba57-10fc72c42541",
                                "sense_id": "7a332ba2-2876-3673-a6e3-151c10385398",
                                "text": "Those subpoenas went out today! The front office is gonna go batshit!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
