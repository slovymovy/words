                "senses": [
                    {
                        "sense_id": "8da78ed4-6079-3756-8029-ecd129c60fa2",
                        "entry_id": "8bf1ed16-6452-35c9-93bd-09ac87b740b6",
                        "glosses": [
                            "Trompeur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef2e48d-96ee-4fc2-9682-932c89f252f7",
                                "sense_id": "8da78ed4-6079-3756-8029-ecd129c60fa2",
                                "text": "D’ailleurs, elle relut les poésies de Canalis, vers excessivement pipeurs, pleins d’hypocrisie, et qui veulent un mot d’analyse, ne fût-ce que pour expliquer son engouement."
                            }
                        ]
                    }
                ],
