                "word": "Zanzibar",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "76a181ac-b785-3d60-921a-231ca2e0d04c",
                        "entry_id": "57f0b66a-a4ae-3a29-9bee-69a7b6bb5d54",
                        "glosses": [
                            "An island region of Tanzania in the Indian Ocean."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5820d9-f594-4403-b041-3577ee3883e3",
                                "sense_id": "76a181ac-b785-3d60-921a-231ca2e0d04c",
                                "text": "Other examples of nonhuman self-domestication in the wild exist—for instance, the Zanzibar red colobus monkey diverged from the mainland African red colobus in similar ways during its island isolation—but bonobos are the closest and most relevant to us."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e1d07b7-e8fd-3141-8330-05f5d64e9290",
                        "entry_id": "57f0b66a-a4ae-3a29-9bee-69a7b6bb5d54",
                        "glosses": [
                            "A former sultanate in East Africa in the Indian Ocean, which merged with Tanganyika in 1963 to form Tanzania."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
