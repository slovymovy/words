                                "target_senses": [
                                    {
                                        "sense_id": "d1a1996a-9150-3845-b903-3c4476b98cb4",
                                        "entry_id": "630aaf03-9c96-3bea-9170-6ade945aaa7d",
                                        "glosses": [
                                            "The cry of a rooster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b20d3a58-6636-4339-8fe8-538485ba146e",
                                                "sense_id": "d1a1996a-9150-3845-b903-3c4476b98cb4",
                                                "text": "Hark, hark, I heare, the ſtraine of ſtrutting Chanticlere cry cockadidle-dowe."
                                            },
                                            {
                                                "example_id": "b623db9a-996f-4111-803f-f6cf2d655a34",
                                                "sense_id": "d1a1996a-9150-3845-b903-3c4476b98cb4",
                                                "text": "Chook, chook, quack, quack, / Cock-a-doodle-doo; / All the ducks and the fowls / Admire me, they do."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cock-a-doodle-doo",
                                "target_lang_code": "en",
