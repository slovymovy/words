                    {
                        "translation_id": "6decf714-e12c-4faf-82df-95173681b68a",
                        "source_entry_id": "41c1bdba-5b7d-3355-b620-726bbfbfc6db",
                        "source_sense_id": "0a7cd21f-2a90-35d5-bb9d-1ec3de321d81",
                        "source_sense_description": "drank gemaakt van cacao, suiker en melk",
                        "target_lang_word": "Schokolade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schokolade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                        "entry_id": "7f293011-004d-37fa-b3f6-51fc298b2d63",
                                        "glosses": [
                                            "kakaohaltiges Lebens- und Genussmittel, das in Tafelform, als Block oder zu Figuren gegossen wird"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9941551-8c44-48b9-8a0e-775e925544b5",
                                                "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                                "text": "Schokolade wird durch Fermentierung aus den Bohnen des Kakaobaumes hergestellt. Die zwei Unterarten des Sterkuliengewächses stammen ursprünglich aus den tropischen Regenwäldern Mittel- und Südamerikas."
                                            },
                                            {
                                                "example_id": "669cab42-fb4e-4a40-aaab-63f959a9006e",
                                                "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                                "text": "„Gegen Mitternacht hatte er eine kleine Abwechslung, denn Therese, die ihn öfters mit kleinen Geschenken überraschte, brachte ihm einen großen Apfel und eine Tafel Schokolade.“"
                                            },
                                            {
                                                "example_id": "b3889349-452c-4193-a954-68b6e47e2985",
                                                "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                                "text": "„Denn offensichtlich ist Schokolade für Frauen DER Glücklichmacher schlechthin, der in allen Variationen stets zuverlässig funktioniert.“"
                                            },
                                            {
                                                "example_id": "3e1c9a7b-e97c-421c-bf81-0d8dea5dc2e2",
                                                "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                                "text": "„Zwar kommen wir noch nicht umgehend in den Genuss dieses ungewohnten Gefühls ständiger Sauberkeit und Frische, aber gewiss ist der Tag nicht mehr fern, an dem wir neben Zigaretten, Schokolade und Kaugummi auch unsere Unterwäsche aus dem Automaten ziehen.“"
                                            },
                                            {
                                                "example_id": "67ef44c7-5ee2-49b0-8536-1683df4086e8",
                                                "sense_id": "d9cc33b5-e46c-373e-b6ad-bff0982676f2",
                                                "text": "„Heroin beispielsweise wirkt etwa hundert Mal stärker als Schokolade und löst ein dementsprechendes Hochgefühl aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b4aff00-d4ce-361c-ad47-a37c7c184327",
                                        "entry_id": "7f293011-004d-37fa-b3f6-51fc298b2d63",
                                        "glosses": [
                                            "Getränk aus Kakao oder Kakaopulver, das in Milch oder Wasser aufgelöst wird"
                                        ],
                                        "tags": [
                                            "Lebensmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf539010-7ee4-40f5-91e5-23f8194df111",
                                                "sense_id": "8b4aff00-d4ce-361c-ad47-a37c7c184327",
                                                "text": "„Die Schokolade kam, wir tranken sie und setzten dann unser Spiel fort.“"
                                            },
                                            {
                                                "example_id": "4be826e4-f102-411d-911c-2b7b139ab9a3",
                                                "sense_id": "8b4aff00-d4ce-361c-ad47-a37c7c184327",
                                                "text": "„Wieder bringt mir Pierre seine Tasse mit der köstlich duftenden Schokolade.“"
                                            },
                                            {
                                                "example_id": "52d0c92c-7752-4aaf-bf3f-638dccc913b1",
                                                "sense_id": "8b4aff00-d4ce-361c-ad47-a37c7c184327",
                                                "text": "„Wie sie die Schokolade ausgetrunken und die Zeitung fertig gelesen hat, steht sie auf, zieht einen Morgenrock an, setzt sich, den Rücken zu mir, vor den Spiegel und fängt an, sich in Ordnung zu bringen.“"
                                            },
                                            {
                                                "example_id": "abb9dcbe-b45f-4ab5-9160-3c50e59fe4a2",
                                                "sense_id": "8b4aff00-d4ce-361c-ad47-a37c7c184327",
                                                "text": "„Es gab leider keine Schokolade zu trinken, keinen Fruchtsaft, nur irgendein dünnes, grünlich gefärbtes Zeug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5528ed7-4faf-424c-88e9-37e00b1a3b13",
                        "source_entry_id": "41c1bdba-5b7d-3355-b620-726bbfbfc6db",
                        "source_sense_id": "0a7cd21f-2a90-35d5-bb9d-1ec3de321d81",
                        "source_sense_description": "drank gemaakt van cacao, suiker en melk",
                        "target_lang_word": "Kakao",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kakao",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c8c0a9-4b78-3f00-b163-e7e2d099fa19",
                                        "entry_id": "fec14340-7c62-37cd-8487-4efafd37e7ee",
                                        "glosses": [
                                            "Samen des Kakaobaums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f5ea0c5-951d-438c-a092-5493f2e26257",
                                                "sense_id": "d2c8c0a9-4b78-3f00-b163-e7e2d099fa19",
                                                "text": "Die Preise für Kakao haben gestern ihre Richtung gewechselt und sind vor dem Hintergrund zahlreicher Short-Eindeckungen gestern in der Spitze um 5,9% auf 2.322 Dollar pro Tonne gestiegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6d1f38b7-7f6f-3fea-8f4d-08eebdbbc801",
                                        "entry_id": "fec14340-7c62-37cd-8487-4efafd37e7ee",
                                        "glosses": [
                                            "Pulver aus dem fermentierten, getrockneten Samen des Kakaobaums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c33a45db-3bd2-46fd-ab80-e33d33d320a6",
                                                "sense_id": "6d1f38b7-7f6f-3fea-8f4d-08eebdbbc801",
                                                "text": "Hier gibt es die besten Tiramisu Rezepte mit Kakao."
                                            },
                                            {
                                                "example_id": "cccd9378-b7ef-4cda-8a84-31fd30a07820",
                                                "sense_id": "6d1f38b7-7f6f-3fea-8f4d-08eebdbbc801",
                                                "text": "„Von Mauritius schafften Händler Gewürznelken und Kakao herbei, und alles gedieh prächtig.“"
                                            },
                                            {
                                                "example_id": "f7b096da-7d4c-4380-b833-ef2734908a5a",
                                                "sense_id": "6d1f38b7-7f6f-3fea-8f4d-08eebdbbc801",
                                                "text": "„So etwas hat es bei uns schon lange nicht mehr gegeben; der Kakao stammt wohl aus Rot-Kreuz-Paketen für die Kriegsgefangenen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4c580fcf-3c9b-34f1-82d8-b2c4740b3d36",
                                        "entry_id": "fec14340-7c62-37cd-8487-4efafd37e7ee",
                                        "glosses": [
                                            "mit Kakao ^([2]) hergestelltes Getränk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cde2cbe-e9be-4862-b261-a9a7346d697d",
                                                "sense_id": "4c580fcf-3c9b-34f1-82d8-b2c4740b3d36",
                                                "text": "Ich trinke jeden Morgen Kakao."
                                            },
                                            {
                                                "example_id": "7da5cb86-f38e-48b1-bcd5-d91316956e22",
                                                "sense_id": "4c580fcf-3c9b-34f1-82d8-b2c4740b3d36",
                                                "text": "„Ein paar Tage nach meiner Rückkehr aus England stand ich in der Küche am Herd und wärmte Milch auf für den Kakao der Kinder.“"
                                            },
                                            {
                                                "example_id": "25c7d899-9c92-4e29-930f-942e35730bbb",
                                                "sense_id": "4c580fcf-3c9b-34f1-82d8-b2c4740b3d36",
                                                "text": "„Fast fühlte er sich, als hätte er selbst den ganzen Tag auf Skiern gestanden, und er überlegte, ob der heiße Kakao unterm Strich vielleicht sogar das Beste am Skifahren war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
