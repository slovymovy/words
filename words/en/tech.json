                            {
                                "target_lang_word": "IT行业",
                                "target_lang_sense_clarification": "信息技术领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593f3282-57cf-34e4-ac04-5084fed1ccee",
                    "sense_definition": "A technician or technologist; a person skilled in a specific technical field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The service writers collaborate with the <w>techs</w> to ensure the repairs are done correctly.",
                            "target_lang_translations": {
                                "ru": "Приемщики заказов сотрудничают с <w>техниками</w>, чтобы гарантировать правильное выполнение ремонта.",
                                "zh": "服务接待员与<w>技术员</w>协作，以确保维修工作准确完成。"
                            }
                        },
                        {
                            "text": "Please ask the lab <w>tech</w> to process these blood samples immediately.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, попросите <w>лаборанта</w> немедленно обработать эти образцы крови.",
                                "zh": "请让<w>实验员</w>立即处理这些血液样本。"
                            }
                        }
