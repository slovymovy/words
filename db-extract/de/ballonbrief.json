                "senses": [
                    {
                        "sense_id": "5a1bba96-e50b-37d1-a026-10591fa76521",
                        "entry_id": "c55d0f80-8679-387d-92b1-40a6f7387fef",
                        "glosses": [
                            "Brief, der mit der Ballonpost verschickt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fed8c6a-710b-4d5d-97c7-b84475a6f787",
                                "sense_id": "5a1bba96-e50b-37d1-a026-10591fa76521",
                                "text": "„Er macht aus der Pariser Postgeschichte ein Stück Heimatgeschichte, indem er sich auf Ballonbriefe konzentriert, die allesamt in die Deutschschweiz befördert wurden – ein ebenso originelles wie schwieriges Vorhaben, das er mit Bravour meistert.“"
                            },
                            {
                                "example_id": "a7b8a4e0-582d-4396-8abd-4d1ef762b2f4",
                                "sense_id": "5a1bba96-e50b-37d1-a026-10591fa76521",
                                "text": "„Die zweite Abbildung zeigt einen Ballonbrief aus späterer Zeit, als deutlich stärkere Versorgungsengpässe in der Bevölkerung zu verzeichnen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
