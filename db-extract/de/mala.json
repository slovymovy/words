                "senses": [
                    {
                        "sense_id": "22db00fc-4b15-392d-ad67-9eeb354a5734",
                        "entry_id": "79c7e7ad-83b7-3150-9160-c453247e14ed",
                        "glosses": [
                            "Gebetskette mit oftmals 108 Perlen"
                        ],
                        "tags": [
                            "Hinduismus",
                            "Buddhismus"
                        ],
                        "examples": [
                            {
                                "example_id": "a8cf73a3-c1ca-424b-9155-855eac14f1c6",
                                "sense_id": "22db00fc-4b15-392d-ad67-9eeb354a5734",
                                "text": "Eine Mala besteht in der Regel aus 108 Perlen und besitzt häufig eine Quaste als Verzierung."
                            },
                            {
                                "example_id": "d646e23d-fbe3-4c81-a22e-3633e6070771",
                                "sense_id": "22db00fc-4b15-392d-ad67-9eeb354a5734",
                                "text": "„Es wurde mit Malas meditiert, chinesische Formeln wurden im Sprechgesang der Gruppe wieder und wieder rezitiert, und die Teilnehmer waren fasziniert von der „klosterähnlichen\", „dichten\" Atmosphäre, die in jenen zwei Kurstagen entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
