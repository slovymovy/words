                                            },
                                            {
                                                "example_id": "90031ee9-c7cd-4c76-a557-03ca8abf058d",
                                                "sense_id": "bc9b1099-9d96-3a0a-8970-978550d17736",
                                                "text": "His income of £10000 per month was stable for a healthy living."
                                            },
                                            {
                                                "example_id": "77f1b30e-8481-4c54-8a8a-5342ea8f7c3d",
                                                "sense_id": "bc9b1099-9d96-3a0a-8970-978550d17736",
                                                "text": "a stable government"
                                            },
                                            {
                                                "example_id": "7750610c-081d-4c91-b9f4-e30f3ec40e8b",
                                                "sense_id": "bc9b1099-9d96-3a0a-8970-978550d17736",
                                                "text": "In this region of chance, […] where nothing ws stable."
                                            },
                                            {
                                                "example_id": "816895a3-3e41-4ded-8851-519262ac961f",
                                                "sense_id": "bc9b1099-9d96-3a0a-8970-978550d17736",
                                                "text": "And to whoever that cry hath ever come he must needs follow and follow, leaving all stable things; only to be always with Slid in all the moods of Slid, to find no rest until he reaches the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7674dfc1-71d0-3140-ab25-59ddec9159d6",
                                        "entry_id": "f3823acd-2d73-3c37-ab7b-8c7d281ca872",
                                        "glosses": [
                                            "Of software: established to be relatively free of bugs, as opposed to a beta version."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b137536-dd31-41e6-a664-764f5a6d38fd",
                                                "sense_id": "7674dfc1-71d0-3140-ab25-59ddec9159d6",
                                                "text": "You should download the 1.9 version of that video editing software: it is the latest stable version. The newer beta version has some bugs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04a35973-e6ad-3c23-870b-504ea18cb2c5",
                                        "entry_id": "f3823acd-2d73-3c37-ab7b-8c7d281ca872",
