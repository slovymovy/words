                ],
                "senses": [
                    {
                        "sense_id": "6bcfe4e6-0cfb-3a6c-a19d-63ccf553882b",
                        "entry_id": "6ba7034a-d494-3b23-8418-ff60da43555d",
                        "glosses": [
                            "sterke beroering door een verrassend voorval of bericht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a45858-836a-42f5-982e-40f6049e614b",
                                "sense_id": "6bcfe4e6-0cfb-3a6c-a19d-63ccf553882b",
                                "text": "Die film was een grote sensatie."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f3e00b6-d923-3539-9b5f-663a3063b767",
                        "entry_id": "6ba7034a-d494-3b23-8418-ff60da43555d",
                        "glosses": [
                            "sterke emoties; grote gevoelens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245ef83f-a285-486b-b5d1-b7c38066d344",
                                "sense_id": "6f3e00b6-d923-3539-9b5f-663a3063b767",
                                "text": "Ze was niet veeleisend wat betreft hun kwaliteit of herkomst. Ze had foto's van Clemenceau, Maurras, Poincaré, Jaurès, Joffre, Briand... Sinds ze haar man had verloren, die het bevel voerde over een groep geüniformeerde suppoosten in het Musée du Louvre, bezorgden grote mannen haar heftige sensaties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d59ddd0e-5936-40ee-8ecf-113cff682345",
                        "source_entry_id": "6ba7034a-d494-3b23-8418-ff60da43555d",
                        "source_sense_id": "6bcfe4e6-0cfb-3a6c-a19d-63ccf553882b",
                        "source_sense_description": "sterke beroering door een verrassend voorval of bericht",
                        "target_lang_word": "sensation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A physical feeling or perception from something that comes into contact with the body; something sensed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10389a04-75fd-4ced-9035-d664041097b2",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Captain Edward Carlisle, soldier as he was, martinet as he was, felt a curious sensation of helplessness seize upon him as he met her steady gaze, her alluring smile; he could not tell what this prisoner might do."
                                            },
                                            {
                                                "example_id": "7c9be127-58f0-49ea-9154-2986e832d061",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Confining ourselves, for the moment, to sensations, we find that there are different degrees of publicity attaching to different sorts of sensations. If you feel a toothache when the other people in the room do not, you are in no way surprised; but if you hear a clap of thunder when they do not, you begin to be alarmed as to your mental condition."
                                            },
                                            {
                                                "example_id": "dedd57cf-65f8-4b9c-aad2-ac54f6f4c739",
                                                "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                                                "text": "Water and electricity might not mix, but water and battery-powered fun sure do. Whether you are using a vibe alone or with a partner, in the tub or in the shower, the sensation of intense vibration feels especially nice underwater. Although waterproof vibrators can resemble anything from a lipstick to a kitty cat, most have one of four basic designs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "Excitation of sensory organs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91af2e7d-86a9-4329-96bd-d8806660e650",
                                                "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                                "text": "Coordinate term: perception"
                                            },
                                            {
                                                "example_id": "c7e2b87f-a9ec-4870-99ef-69bd228abd7c",
                                                "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; […] no sensation; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A widespread reaction of interest or excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9db66ded-e9e3-4c3a-b580-9e840770ce63",
                                                "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                                "text": "“Two or three months more went by; the public were eagerly awaiting the arrival of this semi-exotic claimant to an English peerage, and sensations, surpassing those of the Tichbourne case, were looked forward to with palpitating interest. […]”"
                                            },
                                            {
                                                "example_id": "e8982a4d-2cea-42ab-b6ef-c41d01615adb",
                                                "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                                                "text": "Young Derby's odd genius developed remarkably, and in his eighteenth year his collected nightmare-lyrics made a real sensation when issued under the title Azathoth and Other Horrors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573d0ae7-8330-3eed-a184-0c532f782340",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A remarkable person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "figuratively",
                                            "uncommon",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db75fd82-a91b-4619-9574-e0faf603725c",
                                                "sense_id": "573d0ae7-8330-3eed-a184-0c532f782340",
                                                "text": "You truly are a sensation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                        "entry_id": "1acdc14f-dee5-3332-8572-16eb097bde18",
                                        "glosses": [
                                            "A small serving of gin or sherry."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7db7dbb-bf7f-4361-96ec-bfb12cc8090d",
                                                "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                                "text": "A Sensation . . . . Half-a-glass of sherry."
                                            },
                                            {
                                                "example_id": "c71284af-97ba-44c3-8eff-80d8b9f7c093",
                                                "sense_id": "9216cf9a-5cde-3379-ad17-e6e728a8c389",
                                                "text": "When men go into a 'sluicery' for a 'sensation,' a 'drain,' or a 'common sewer,' they call the glass of gin they seek, in allusion to the juniper, a 'nipper,' or, more briefly, a 'nip,' occasionally a 'bite,' and not unfrequently it turns out a 'flogger.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8e5f929-c674-4180-aac2-8e8fe716ec1e",
                        "source_entry_id": "6ba7034a-d494-3b23-8418-ff60da43555d",
                        "source_sense_id": "6bcfe4e6-0cfb-3a6c-a19d-63ccf553882b",
                        "source_sense_description": "sterke beroering door een verrassend voorval of bericht",
                        "target_lang_word": "sensation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17416a22-7a68-3ebf-b2f3-82ad1a95238f",
                                        "entry_id": "29077c01-e57a-3d0a-ab1c-9b03fd80f32c",
                                        "glosses": [
                                            "Impression ou perception physique de quelque chose qui vient en contact avec le corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90264ab5-2290-4297-81f9-b439f423953c",
                                                "sense_id": "17416a22-7a68-3ebf-b2f3-82ad1a95238f",
                                                "text": "La vie laborieuse, active, toute estimable, toute positive, d’un conseiller d’État, d’un manufacturier de tissus de coton ou d’un banquier fort alerte pour les emprunts, est récompensée par des millions, et non par des sensations tendres."
                                            },
                                            {
                                                "example_id": "955e1b33-207a-4e85-9912-74a98f696755",
                                                "sense_id": "17416a22-7a68-3ebf-b2f3-82ad1a95238f",
                                                "text": "Je n’éprouvais plus qu’une sensation vague des objets et des êtres. Tout passait devant moi, avec des formes indécises."
                                            },
                                            {
                                                "example_id": "1175e578-2b54-44b0-85f3-9c5929a12aa7",
                                                "sense_id": "17416a22-7a68-3ebf-b2f3-82ad1a95238f",
                                                "text": "Le Sampran Rehabilitation est un institut de massage dont les masseuses sont toutes des personnes non voyantes. Comme la plupart ne parlent pas anglais, tout se fait par le toucher, et donne encore plus de sensations aux soins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                        "entry_id": "29077c01-e57a-3d0a-ab1c-9b03fd80f32c",
                                        "glosses": [
                                            "Effet psychophysiologique modificateur d’un être conscient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa40f492-0869-491f-b560-a585dae9b21c",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Le rêve, it’s a feeling, c’est une sensation, une sensation réelle qui se produit si on veut."
                                            },
                                            {
                                                "example_id": "e6ebf33f-e265-4a56-87c1-1a17ccfa4d3a",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Perdre est une sensation définitive ; elle n’a que faire du temps. Quand on a perdu quelqu’un, on a beau le retrouver, on sait désormais qu’on peut le perdre."
                                            },
                                            {
                                                "example_id": "9e6f611a-c22d-4fbb-b81e-6e53a1f89fda",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Je l’aimais et ne pouvais par conséquent la voir sans ce trouble, sans ce désir de quelque chose de plus qui ôte, auprès de l’être qu’on aime, la sensation d’aimer."
                                            },
                                            {
                                                "example_id": "1067760d-1722-4af0-8642-9be7a9a4f86f",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Bonheur : sensation de bien-être qui peut conduire à l’imprudence. Si vous nagez dans le bonheur, soyez prudent, restez là où vous avez pied."
                                            },
                                            {
                                                "example_id": "79ce3a16-62b8-460d-bf52-4ad72d7359d3",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "L’irrationnel joue un rôle capital dans la naissance de l’amour, de même que dans la sensation de l’amour, l’impression de se fondre, de se dissoudre."
                                            },
                                            {
                                                "example_id": "561efdcf-482a-4146-bc96-94056f8bd16c",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Tout ce qui m’est resté, c’est la sensation d’être porté sur le sein houleux et gonflé d’un grand fleuve, de traverser le cœur d’une zone tropicale, dans un volètement de plumes éblouissantes […]"
                                            },
                                            {
                                                "example_id": "9ecfed61-b810-4e1f-ac34-b6b6a1171f3b",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Cependant, intelligent, peu expansif, il était déjà porté à analyser ses sensations, à classifier en quelque sorte ses pensées."
                                            },
                                            {
                                                "example_id": "2ddde794-9dff-4a5f-b7c2-0219d9150c4d",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "[…] et, à cet instant précis, le halètement sourd d’une locomotive et son cri rauque montant dans un jet de vapeur, m’emplirent d’un tel tumulte de sensations heurtées qu’eussé-je vu l’océan surgir et balayer de contraste le hideux mur de l’hôpital Lariboisière, ma stupéfaction n’aurait pas été plus profonde."
                                            },
                                            {
                                                "example_id": "6a2894fc-3d12-4fa7-8052-5677f98d17f6",
                                                "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                                                "text": "Poète, il voulait être poète, créer des rythmes nouveaux, des sensations neuves et souffler au ciel toutes les sottises qui tourbillonnaient dans son cerveau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ca18308-a146-3b89-9f11-8d4ccebdef70",
                                        "entry_id": "29077c01-e57a-3d0a-ab1c-9b03fd80f32c",
                                        "glosses": [
                                            "Réaction de plusieurs personnes d’intérêt ou d’excitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d541dae-f244-4d64-a47e-5232ba0325db",
                                                "sense_id": "8ca18308-a146-3b89-9f11-8d4ccebdef70",
                                                "text": "La nouvelle a fait sensation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338097b0-a145-3203-89a5-8084049708ab",
                                        "entry_id": "29077c01-e57a-3d0a-ab1c-9b03fd80f32c",
                                        "glosses": [
                                            "Succès, impression produite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa23083-f1eb-4b5f-bd30-249eb043364c",
                                                "sense_id": "338097b0-a145-3203-89a5-8084049708ab",
                                                "text": "Huit jours après, Mlle de Vénérande, belle, d’une beauté excessivement originale sous son costume de nymphe des eaux, faisait une entrée à sensation au bal de la duchesse d’Armonville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
