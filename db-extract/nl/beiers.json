                                "target_senses": [
                                    {
                                        "sense_id": "35d4c93a-0644-3bc9-9bbe-c15be85c67ba",
                                        "entry_id": "3d160fe1-f19a-3594-8a5d-d51583825d5f",
                                        "glosses": [
                                            "Dialekt des Deutschen, genauer des Oberdeutschen, der in der südlichen Hälfte Bayerns (Altbayern), dem größten Teil Österreichs und dem größten Teil Südtirols gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af05b5d9-99a6-4331-9a4d-72a69e42c547",
                                                "sense_id": "35d4c93a-0644-3bc9-9bbe-c15be85c67ba",
                                                "text": "Er hat die ganze Zeit auf Bairisch geredet und ich habe kein Wort verstanden."
                                            },
                                            {
                                                "example_id": "dbc71071-f877-4939-a2da-7f2b65115903",
                                                "sense_id": "35d4c93a-0644-3bc9-9bbe-c15be85c67ba",
                                                "text": "„Schließlich ist Bairisch die Sprache, mit der das Römische Reich auf deutschem Boden verwaltet wurde.“"
                                            },
                                            {
                                                "example_id": "2696daa4-0c70-42c2-a56b-8282558f698e",
                                                "sense_id": "35d4c93a-0644-3bc9-9bbe-c15be85c67ba",
                                                "text": "„Es gab ein frühes Fränkisch, Alemannisch oder Bairisch, aber es gab weder eine einheitliche Standardsprache noch eine einheitliche Schreibung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
