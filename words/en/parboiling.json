    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c842bfc-bebe-36a8-884d-ca52bbc0a39f",
                    "sense_definition": "present participle and gerund of <w>parboil</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>parboiling</w> the potatoes so they roast more quickly in the oven.",
                            "target_lang_translations": {
                                "de": "Sie <w>kocht</w> die Kartoffeln <w>vor</w>, damit sie im Ofen schneller rösten."
                            }
                        },
                        {
                            "text": "By <w>parboiling</w> the carrots first, you keep them bright and tender-crisp.",
                            "target_lang_translations": {
                                "de": "Indem man die Karotten zuerst <w>vorkocht</w>, bleiben sie farbintensiv und knackig-zart."
                            }
                        }
                    ],
                    "common_phrases": [
                        "parboiling potatoes",
                        "parboiling vegetables"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von parboil; etwas halbgar oder vorab kochen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vorkochend",
                                "target_lang_sense_clarification": "als Partizip Präsens"
                            },
                            {
                                "target_lang_word": "Vorkochen",
                                "target_lang_sense_clarification": "als substantiviertes Verb / Gerundium"
                            },
                            {
                                "target_lang_word": "vorgaren",
                                "target_lang_sense_clarification": "Grundform der Handlung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "42fa372e-a06d-30d4-96a5-d9d4a1c27ed4",
                    "sense_definition": "The process of partially boiling food as the first stage in cooking.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>parboiling</w> of the ribs before grilling helps make the meat very tender.",
                            "target_lang_translations": {
                                "de": "Das <w>Vorkochen</w> der Rippchen vor dem Grillen trägt dazu bei, dass das Fleisch sehr zart wird."
                            }
                        },
                        {
                            "text": "Careful <w>parboiling</w> prevents the outer layer of vegetables from becoming mushy.",
                            "target_lang_translations": {
                                "de": "Sorgfältiges <w>Vorgaren</w> verhindert, dass die äußere Schicht des Gemüses matschig wird."
                            }
                        }
                    ],
                    "synonyms": [
                        "blanching"
                    ],
                    "target_lang_definitions": {
                        "de": "Das teilweise Kochen von Lebensmitteln als erste Stufe der Zubereitung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Vorkochen",
                                "target_lang_sense_clarification": "halbgares Kochen von Speisen"
                            },
                            {
                                "target_lang_word": "das Vorgaren",
                                "target_lang_sense_clarification": "teilweises Garen"
                            },
                            {
                                "target_lang_word": "das Blanchieren",
                                "target_lang_sense_clarification": "kurzes Überbrühen bzw. Vorgaren von Gemüse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
