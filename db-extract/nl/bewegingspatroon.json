                        "examples": [
                            {
                                "example_id": "f3ec587a-8209-48f5-9504-a4224b273a5f",
                                "sense_id": "60af7316-f77e-3f5c-ae02-305fa8e5a9ac",
                                "text": "In dat grootschalige bevolkingsonderzoek worden 156.000 mensen dertig jaar lang gevolgd. Van iedere deelnemer zijn gegevens bekend over gezondheid, leefstijl, voedingsgewoonten, bewegingspatroon en medicijngebruik."
                            },
                            {
                                "example_id": "d01c3c1b-bfa4-4abd-816d-c6805e205964",
                                "sense_id": "60af7316-f77e-3f5c-ae02-305fa8e5a9ac",
                                "text": "Het systeem zit vernuftig in elkaar. Eén sensor bevindt zich in de genitaliën van de koe en registreert de lichaamstemperatuur. De informatie wordt vervolgens doorgegeven aan een andere sensor in de nek, die lichaamsbewegingen meet. De koe is tochtig bij een bepaalde combinatie van lichaamstemperatuur en bewegingspatroon. In dat geval ontvangt de boer direct een sms. Hij heeft de keuze uit maar liefst vijf verschillende talen: Duits, Frans, Engels, Spaans en Italiaans."
                            }
                        ]
                    }
