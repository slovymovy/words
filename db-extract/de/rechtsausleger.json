                "senses": [
                    {
                        "sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                        "entry_id": "b38e3324-483e-3ea7-bd39-574b78edd094",
                        "glosses": [
                            "politisch rechts stehende Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386d1749-bb13-44ec-a3f1-90ed30208911",
                                "sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                                "text": "So konnten selbst Rechtsausleger glauben, in der Partei richtig zu sein."
                            },
                            {
                                "example_id": "be3edcfc-c324-4e71-a761-669800186fe7",
                                "sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                                "text": "Krach um Koch: CDU-Rechtsausleger provoziert seine Partei."
                            },
                            {
                                "example_id": "94ee27a8-ac86-4921-b5f7-fdd67f03070c",
                                "sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                                "text": "Stärkste Fraktion wollte die FPÖ werden, das ging knapp daneben. Dafür gelangen dem Rechtsausleger jedoch bemerkenswerte Einbrüche in die Hochburgen der Sozialdemokraten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1d7ef757-e2a4-395c-92cc-eec874789abc",
                        "entry_id": "b38e3324-483e-3ea7-bd39-574b78edd094",
                        "glosses": [
                            "Boxer, der mit links schlägt"
                        ],
                        "tags": [
                            "Boxen"
                        ],
                        "examples": [
                            {
                                "example_id": "d258ef19-9167-4497-849d-4b65dec7e1c8",
                                "sense_id": "1d7ef757-e2a4-395c-92cc-eec874789abc",
                                "text": "Rechtsausleger sind Boxer, die \"verkehrt\" stehen. Das heißt: In der Grundstellung schieben sie das rechte Bein und damit die ganze rechte Körperseite nach vorn. Die rechte ist die Führhand, die linke die harte Schlaghand."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d2ef6f1-2420-44dd-b96b-25a19a7f5c2a",
                        "source_entry_id": "b38e3324-483e-3ea7-bd39-574b78edd094",
                        "source_sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                        "source_sense_description": "politisch rechts stehende Person",
                        "target_lang_word": "right-winger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "right-winger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10878800-1ab1-3fe0-8a9f-1380d3e2e4bf",
                                        "entry_id": "46034884-c35b-32ab-845e-f76604f5c3bc",
                                        "glosses": [
                                            "A person who belongs to the political right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67d38f2-47af-4e9a-b56d-9659b8d23523",
                                                "sense_id": "10878800-1ab1-3fe0-8a9f-1380d3e2e4bf",
                                                "text": "Analyses that used to exist only in arcane feminist journals are now common among right wingers and are being institutionalized as law and public policy."
                                            },
                                            {
                                                "example_id": "fe1e239b-7f3f-4615-8cd9-6f9bb7a5e32e",
                                                "sense_id": "10878800-1ab1-3fe0-8a9f-1380d3e2e4bf",
                                                "text": "The ruling led to calls from the right of the Conservative Party to leave the European Convention on Human Rights (ECHR), a prospect that has loomed over the government for months and has caused deep rifts between centrists and right-wingers in Britain’s ruling party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fcd10cd-6cda-331f-b429-eb446d715218",
                                        "entry_id": "46034884-c35b-32ab-845e-f76604f5c3bc",
                                        "glosses": [
                                            "A member of the right wing of a party or group."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8446b7e4-2579-3a95-9220-98d87cacf802",
                                        "entry_id": "46034884-c35b-32ab-845e-f76604f5c3bc",
                                        "glosses": [
                                            "A winger who plays on the right."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a82c0f3-2de6-48c6-b8e4-3737f88f7847",
                        "source_entry_id": "b38e3324-483e-3ea7-bd39-574b78edd094",
                        "source_sense_id": "024ee6d8-d8e7-3792-a829-e38c93c1c4c5",
                        "source_sense_description": "politisch rechts stehende Person",
                        "target_lang_word": "rightist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rightist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                                        "glosses": [
                                            "One who believes in the politics or policies of the political right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b524b3-ee09-430c-a0a0-bbb374c1cf33",
                                                "sense_id": "79a2d41f-fc92-36fb-b414-748486dfd240",
                                                "text": "To summarize: on the average, rightists are made more anxious by ambiguity and have a stronger need for closure, dislike novelty, are more comforted by structure and hierarchy, more readily perceive circumstances as threatening, and are more parochial in their empathy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                                        "entry_id": "14c9c543-7256-398d-9a43-3f98ec7c3fa0",
                                        "glosses": [
                                            "One who supports the rights of a specified group."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ebed41c-6b68-42de-99b9-19c656bcd96e",
                                                "sense_id": "b31e640e-42dc-3665-9f8a-401c46bc831e",
                                                "text": "an animal rightist"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rightist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                        "entry_id": "0d62020e-2011-3d37-b9aa-2f06fba08be8",
                                        "glosses": [
                                            "Of or pertaining to the political right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "439151b9-8eb7-45e9-ae50-73e1c2c3900f",
                                                "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                                "text": "Hearsay even got \"freeped.\" \"Freepers,\" followers of a rightist Web site called Free Republic, orchestrated a \"Freeper Call to Action.\""
                                            },
                                            {
                                                "example_id": "822c0b21-7211-45dc-83e7-af9201a77ad0",
                                                "sense_id": "47c0d73d-a50d-3a32-b59d-1bfbe763fae3",
                                                "text": "Whether a Hidalgo candidacy can galvanize the left and throw open an election in which Emmanuel Macron, the centrist president, and Marine Le Pen, the rightist candidate, remain favorites is unclear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
