                "senses": [
                    {
                        "sense_id": "c731440a-3513-33f5-aadd-f864b7c264c2",
                        "entry_id": "44bae7fd-bafa-351c-ba99-72b727f6cbd7",
                        "glosses": [
                            "Gesamtheit der Maßnahmen, die für die Wiedereingliederung eines Kranken oder Behinderten in das Berufs- und Privatleben ergriffen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b28212c8-c5ee-438f-8794-653e42c21d43",
                                "sense_id": "c731440a-3513-33f5-aadd-f864b7c264c2",
                                "text": "Peter hat nach seinem Schlaganfall eine mehrmonatige Reha gemacht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "33148ef1-cee4-36fa-bf57-c8379e40946a",
                        "entry_id": "44bae7fd-bafa-351c-ba99-72b727f6cbd7",
                        "glosses": [
                            "Klinik, in der die Maßnahmen unter [1] durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "111ae56f-04b1-4155-868d-724c25219bf1",
                                "sense_id": "33148ef1-cee4-36fa-bf57-c8379e40946a",
                                "text": "Simone fand das Mobiliar in der Reha, in der sie war, wenig ansprechend."
                            },
                            {
                                "example_id": "b87f3741-8dbb-4490-ba72-24b02ff40ed2",
                                "sense_id": "33148ef1-cee4-36fa-bf57-c8379e40946a",
                                "text": "„Am Nachmittag wird er seine Frau in der Reha besuchen, wie jeden Tag.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
