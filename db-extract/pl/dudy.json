                        "examples": [
                            {
                                "example_id": "fd6f120d-903e-4a50-b370-c8bcca94681d",
                                "sense_id": "875573a2-18ce-3472-97e2-a749d42f7be3",
                                "text": "Ten Szkot gra na dudach."
                            },
                            {
                                "example_id": "deed8bd2-f839-4af7-ad76-6fe63cf71291",
                                "sense_id": "875573a2-18ce-3472-97e2-a749d42f7be3",
                                "text": "Mój tata grał na dudach; pięknie grywał pijany, • Ale kiedy na trzeźwo, okropnie rzępolił"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2629a1b9-8349-37f9-914f-857686dddd7f",
                        "entry_id": "4126a082-3cd8-347b-9f37-91081dc1263c",
                        "glosses": [
                            "podroby, wnętrzności zwierząt (płuco, serce i wątroba)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f4878efa-8111-433b-9f52-04581e4ad3cb",
                                "sense_id": "2629a1b9-8349-37f9-914f-857686dddd7f",
                                "text": "Wątróbka była tania, lub tzw. dudy — śledziona, płuca, kawałek serca itd."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "4cce04f2-665a-373e-bb78-68d3c1845b01",
                        "entry_id": "4126a082-3cd8-347b-9f37-91081dc1263c",
                        "glosses": [
