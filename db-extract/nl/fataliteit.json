                    },
                    {
                        "translation_id": "6a3fa43c-0294-4b9c-b789-c3cdf4f4f7f6",
                        "source_entry_id": "3c71bded-88e9-3766-88d6-3d1a456fa286",
                        "source_sense_id": "d3e3bfb2-490d-3e97-ac2e-29d2c69535d5",
