                "senses": [
                    {
                        "sense_id": "1552b000-e4c6-3d7f-87b6-e5e7fd5c764a",
                        "entry_id": "fa8f3874-72ad-3da9-8898-a08287927ad2",
                        "glosses": [
                            "grain sorting machine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8ab17f-04e1-459a-a1a3-59d7e163cf02",
                                "sense_id": "1552b000-e4c6-3d7f-87b6-e5e7fd5c764a",
                                "text": "Ве́ялка то́лько выделя́ет зерно́ из во́роха, млы́нок сортиру́ет по ве́су, а три́ер по фо́рме зерна́.",
                                "translation": "The winnowing machine only separates the grain from the heap, the mlynok sorts by weight, and the grain sorting machine sorts by the shape of the grain.",
                                "english": "The winnowing machine only separates the grain from the heap, the mlynok sorts by weight, and the grain sorting machine sorts by the shape of the grain."
                            }
                        ]
                    }
