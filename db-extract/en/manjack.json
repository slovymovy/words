                "senses": [
                    {
                        "sense_id": "d2fbcb06-b8bd-3d43-b267-fdf512abbfa7",
                        "entry_id": "ab3ce763-927e-31ea-9077-601b48084647",
                        "glosses": [
                            "Various plants in the genus Cordia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8b64fd9-0170-4d6f-9213-d41abe4bdcc0",
                                "sense_id": "d2fbcb06-b8bd-3d43-b267-fdf512abbfa7",
                                "text": "Buck Island's uplands forest cover also includes frangipani, turpentine, Jamaican caper, manjack, Ginger Thomas, and water mampoo trees."
                            },
                            {
                                "example_id": "18bedb20-ba96-4cc3-973f-a7a245ec3727",
                                "sense_id": "d2fbcb06-b8bd-3d43-b267-fdf512abbfa7",
                                "text": "It was unsigned and merely ordered: Meet me under the great manjack tree. Lucinda did not need a signature."
                            },
                            {
                                "example_id": "b45808ba-2e1f-4e36-97fb-a88e044cd495",
                                "sense_id": "d2fbcb06-b8bd-3d43-b267-fdf512abbfa7",
                                "text": "Amid the scenery, the manjack tree grew quite low. Although it didn't grow very tall, its branches extended over two-thirds of the river in a daring, if not overbearing, fashion."
                            }
                        ]
                    }
