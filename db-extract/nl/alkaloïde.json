                    },
                    {
                        "translation_id": "cd7eda8f-0b8d-4b71-8cb0-d257ae6365dd",
                        "source_entry_id": "c1a07ad2-29e9-303d-86f0-f8439db48bde",
                        "source_sense_id": "5a945aa2-a1fc-3dd9-bbe8-b97aff76e191",
                        "source_sense_description": "een stikstof bevattende plantenbase",
                        "target_lang_word": "alkaloid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
