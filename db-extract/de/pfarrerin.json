        "fr-extract.jsonl": [
            {
                "entry_id": "9c763994-c59d-33e5-bf53-e8937cbbc64d",
                "word": "Pfarrerin",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "515546d2-144e-4f93-830c-bc62aa532e14",
                        "entry_id": "9c763994-c59d-33e5-bf53-e8937cbbc64d",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Pfarrer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2c7799af-a3a0-3bc0-a5ff-0ae4af116032",
                        "entry_id": "9c763994-c59d-33e5-bf53-e8937cbbc64d",
                        "glosses": [
                            "Pasteure, celle qui a la fonction de ministre du culte dans la religion protestante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bb05766-c4f5-4a2d-8240-69aa8164710a",
                                "sense_id": "2c7799af-a3a0-3bc0-a5ff-0ae4af116032",
                                "text": "Als evangelische Pfarrerin kann ich tun, was Gott von mir will, ohne mich irgendeiner Autorität unterwerfen oder besonders brav sein zu müssen.",
                                "translation": "En tant que pasteure protestante, je peux faire ce que Dieu veut de moi, sans devoir me soumettre à une quelconque autorité et sans devoir être particulièrement docile."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d84498c-7a4e-3ce0-a7f5-b408a9c30bb4",
                        "entry_id": "9c763994-c59d-33e5-bf53-e8937cbbc64d",
                        "glosses": [
                            "(Vieux-catholicisme) Curée, prêtre de l’Église vieille-catholique pourvue d’une cure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "064107b3-a38b-4389-bcd6-bc6e6cd02bab",
                                "sense_id": "5d84498c-7a4e-3ce0-a7f5-b408a9c30bb4",
                                "text": "In Deutschland gibt es neun Priesterinnen, sechs davon sind im allgemeinen Dienst oder üben ihr Amt im Ehrenamt aus, drei sind gewählte Pfarrerinnen.",
                                "translation": "En Allemagne, nous avons neuf femmes prêtres, six sont au service général ou bénévoles, trois sont des curées élues."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
