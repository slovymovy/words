                },
                {
                    "sense_id": "12701e5b-5e43-38fb-b627-b815a00248af",
                    "sense_definition": "Spellcraft or magic practice, particularly in hoodoo.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He claimed to understand the secrets of ancient <w>mojo</w> practiced along the delta.",
                            "target_lang_translations": {
