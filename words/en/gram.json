        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54fa04ea-9763-36a9-9c4a-bce1b5b6dab6",
                    "sense_definition": "To post a photograph or video on the social media platform Instagram.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were <w>gramming</w> our entire vacation as it happened.",
                            "target_lang_translations": {
                                "ru": "Мы <w>постили в инсту</w> весь наш отпуск прямо в процессе."
                            }
                        },
                        {
                            "text": "She <w>grammed</w> her dinner before she even took a single bite.",
                            "target_lang_translations": {
                                "ru": "Она <w>заинстаграмила</w> свой ужин, прежде чем успела откусить хоть кусочек."
                            }
                        }
                    ],
                    "synonyms": [
                        "post"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal internet usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опубликовать фотографию или видео в Instagram."
                    },
                    "translations": {
                        "ru": [
