                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "242facd3-080f-3de0-b899-d09484f0ff67",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "A young cow or bull of any bovid, such as domestic cattle or buffalo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3adc325-c80c-47dc-9790-24e3365f081f",
                                                "sense_id": "242facd3-080f-3de0-b899-d09484f0ff67",
                                                "text": "And Goldenhorns calved. A great day in the wilderness, a joy and a delight. They gave her flour-wash, and Isak himself saw to it there was no stint of flour, though he had carried it all the way himself, on his back. And there lay a pretty calf, a beauty, red-flanked like her mother, and comically bewildered at the miracle of coming into the world. In a couple of years she would be having calves of her own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d682d6ca-2aff-337b-a4bc-a1d40c89ec70",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "Leather made of the skin of domestic calves; especially, a fine, light-coloured leather used in bookbinding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2881814-6d7e-47de-a690-5f50ae9ab826",
                                                "sense_id": "d682d6ca-2aff-337b-a4bc-a1d40c89ec70",
                                                "text": "We find now, that instead of leather made from sheep, calf, goat, and pig-skins, each having, when finished, its own characteristic surface, that sheepskins are got up to look like calf, morocco, or pigskin; that calf is grained to resemble morocco or so polished and fattened as to have but little character left; while goatskins are grained in any number of ways, and pigskin is often grained like levant morocco. So clever are some of these imitations that it takes a skilled expert to identify a leather when it is on a book. . . I am inclined to consider that calf, as a sound leather, has been manufactured out of existence, for it is unusual to find a 19th century calf binding of more than fifteen years old that does not show signs of decay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6672d48f-3802-31b0-8e07-be6e42bf5a8d",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "The young of various animals, especially elephant, giraffe, reindeer, seal, or whale (also indiscriminately used of other animals)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec90178f-10b4-3fb8-8f4d-47340fc963ca",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "A mass of ice broken from a larger glacier, ice shelf, or iceberg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75effa2a-03cd-47dd-90c0-6399285b865e",
                                                "sense_id": "ec90178f-10b4-3fb8-8f4d-47340fc963ca",
                                                "text": "1915 (published), 1848 (first written), Elisha Kent Kane, Adrift in the Arctic Ice Pack\nOur swell ceases with this wind, and the floes seem disposed to come together again; but the days of winter have passed by, and the interposing calves prevent the apposition of the edges"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93469786-7506-35ae-9459-f4056618a398",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "A small island, near a larger island."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8a9c75e-ae21-47e5-bcc0-828225fa3c35",
                                                "sense_id": "93469786-7506-35ae-9459-f4056618a398",
                                                "text": "Situated in the north of the Irish Sea and to the south-west of the isle of Man, the Calf of Man is ideally placed on the bird migration routes over the western side of the British Isles. Its importance for migrating and breeding birds had been recognised long before the observatory was established in 1959. . . Visitors can explore the Calf as day visitors or can stay in the hostel accommodation. . ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64608f05-4afe-36c1-9d61-a8bfb5871d41",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "A cabless railroad engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1330e6a6-d4f1-33ba-bd66-93ef5e926eaf",
                                        "entry_id": "b790592e-4261-35fa-8fe3-afe9cae87c2c",
                                        "glosses": [
                                            "An awkward or silly boy or young man; any silly person; a dolt."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05907d43-34e4-4bad-9758-8aa8c7495e57",
                                                "sense_id": "1330e6a6-d4f1-33ba-bd66-93ef5e926eaf",
                                                "text": "some silly, doating, brainless calf"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
