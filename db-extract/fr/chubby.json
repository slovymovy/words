                        "examples": [
                            {
                                "example_id": "f1a3a0fb-d94f-459c-9de2-8e39fd8c4711",
                                "sense_id": "79e851f5-d647-35e1-b887-924c0485c42d",
                                "text": "moi je suis juste triste j’ai pas vu bcp de fan art ou il est chubby 😞 en vrai il est chubby le boug"
                            },
                            {
                                "example_id": "9157bb96-443e-430c-9a3d-cc802f0adfe5",
                                "sense_id": "79e851f5-d647-35e1-b887-924c0485c42d",
                                "text": "Mémo pour les copines chubbies comme moi : c'est pas parce que vous êtes victimes de grossophobie qu'il faut body-shamer les skinny :D."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33070dda-9b1a-47e9-befd-11666be20ae6",
                        "source_entry_id": "6c0cd047-0f9c-39ab-bad6-3aba27e9ff48",
