        "fr-extract.jsonl": [
            {
                "entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                "word": "égalitariste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f5e53861-b725-4f37-a404-2b9c4fd86fac",
                        "entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                        "tags": [
                            "plural"
                        ],
                        "form": "égalitaristes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e3ed552-df01-370f-b504-31107c15761d",
                        "entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                        "glosses": [
                            "Relatif à l’égalitarisme, qui prône l’égalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b104808c-b54b-4e0b-b856-3f1a37fa1ffc",
                                "sense_id": "6e3ed552-df01-370f-b504-31107c15761d",
                                "text": "Le scandale, c'est qu'un système déconsidéré par son obésité, son impotence et sa doctrine puisse ainsi continuer de sévir. La faute majeure fut aux origines, dans la déviation égalitariste, de supprimer la sélection et l'émulation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0110122-ba35-4e3b-a963-a4aac6725204",
                        "source_entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                        "source_sense_id": "6e3ed552-df01-370f-b504-31107c15761d",
                        "target_lang_word": "egalitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d433104a-7c97-3852-864c-eda169a387df",
                                        "entry_id": "741ed398-03d1-3573-8b9d-23dca84b8112",
                                        "glosses": [
                                            "Characterized by social equality and equal rights for all people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ef7362-6c12-4ab4-8e45-d470f33cfec4",
                                                "sense_id": "d433104a-7c97-3852-864c-eda169a387df",
                                                "text": "Ladies of yesteryear toured world capitals in sedate linen dresses, but such priggish frumpery hardly presents Americans as the carefree, egalitarian, and sensuous people the viewers of dubbed Baywatch episodes have come to expect."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "egalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560ec99e-cce4-3ab1-9c90-df3c4cc7651c",
                                        "entry_id": "5a9128fa-97e0-39ad-a2c7-cfd2ee9a2af2",
                                        "glosses": [
                                            "A person who accepts or promotes social equality and equal rights for all people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10d7f56-ac81-48a8-8067-43804e139949",
                                                "sense_id": "560ec99e-cce4-3ab1-9c90-df3c4cc7651c",
                                                "text": "The Greeks have been variously represented: as aristocrats or democrats, as unravished brides of quietness or sexual misfits in need of a therapist's couch, as narcissists or altruists, as protoracists or open-minded egalitarians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc4d5c42-8c79-425c-b1d9-810df3b2133b",
                        "source_entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                        "source_sense_id": "6e3ed552-df01-370f-b504-31107c15761d",
                        "target_lang_word": "equalitarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad2b843-c1ae-3ccf-8e23-9d66767ce53e",
                                        "entry_id": "cc693d10-ee9f-37b0-8cdb-b65656a0f55b",
                                        "glosses": [
                                            "Characterized by social equality and equal rights for all people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe7395c-e2b8-47a9-b1fd-761a5530bbb4",
                                                "sense_id": "8ad2b843-c1ae-3ccf-8e23-9d66767ce53e",
                                                "text": "There was more than one way, however, in which the principles embodied in the cosmological conception of the Chain of Being could be used as weapons against social discontent and especially against all equalitarian movements."
                                            },
                                            {
                                                "example_id": "95fcd145-0541-4446-ab1a-d67dcb2cf876",
                                                "sense_id": "8ad2b843-c1ae-3ccf-8e23-9d66767ce53e",
                                                "text": "Later it became the fashion to decry the militias, and therefore to pretend that the faults which were due to lack of training and weapons were the result of the equalitarian system. Actually, a newly raised draft of militia was an undisciplined mob not because the officers called the privates 'Comrade' but because raw troops are always an undisciplined mob."
                                            },
                                            {
                                                "example_id": "8d3b26ec-c13d-4493-8f6a-19e23bcf3067",
                                                "sense_id": "8ad2b843-c1ae-3ccf-8e23-9d66767ce53e",
                                                "text": "In the increasingly equalitarian Britain of the postwar years, Britain's monarchy found itself subject to a questioning, scarcely articulated, of the utility of an expensive royal household."
                                            },
                                            {
                                                "example_id": "ca2c58ab-07c8-4f2e-b130-f3ebb30470db",
                                                "sense_id": "8ad2b843-c1ae-3ccf-8e23-9d66767ce53e",
                                                "text": "I keep using the term monogamus ^([sic]) as opposed to \"marriage\" because I feel that the marital institution is anti-gay in that it is not equalitarian as it now exists for heterosexuals...so it could not conceivably by equalitarian for us gay people."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "equalitarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d56d0260-7626-3fb7-b445-440b5321cf3f",
                                        "entry_id": "f9793162-d845-3749-ad80-34d962caba91",
                                        "glosses": [
                                            "A person who accepts or promotes the view of equalitarianism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38bf1652-8dc8-4d35-93a7-f117f00a9f5f",
                        "source_entry_id": "ed6a5274-ccc5-3626-b243-fcdc46210654",
                        "source_sense_id": "6e3ed552-df01-370f-b504-31107c15761d",
