                        "examples": [
                            {
                                "example_id": "88956bb8-751f-43c4-8f0a-354be8ba8159",
                                "sense_id": "1442ab7d-38e2-301e-bc1e-f52fccac7dd1",
                                "text": "Een greep uit het aanbod van eten en drinken dat vanuit caravans, party- en bedoeïenententen aan de man wordt gebracht: maïssoep, couscous, wentelteefjes, weedcake, yoghurt met muesli, pitabroodjes, verse fruitdrankjes en voor de liefhebber een vertrouwd pilsje."
                            },
                            {
                                "example_id": "cbc4fa4d-167d-435a-9324-459eb306913d",
                                "sense_id": "1442ab7d-38e2-301e-bc1e-f52fccac7dd1",
                                "text": "Geen irritante geluidjes meer als je een berichtje binnenkrijgt op je mobiel - maar wel een walmpje spek. Dat kan met een nieuwe app met opzetstukje die in Japan wordt gemaakt: de Scentee. Ze hebben nog veel meer geuren, zoals koffie, een kaneelbroodje, aardbei, jasmijn, apple en ..maïssoep. Zit je neus verstopt? Dan kan je ook kiezen voor een LED-lampje dat gaat branden."
                            }
                        ]
                    }
