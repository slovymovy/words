                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db430bb5-c63c-4fa0-a772-fd37bc297428",
                                "sense_id": "cacb905c-2440-304c-aa17-cea85612ca63",
                                "text": "Odstępstwem od typowej dla polszczyzny jest też oksytoneza, czyli akcentowanie ostatniej sylaby."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e47ec4-34a8-435a-a551-e58d69aca472",
                        "source_entry_id": "9d68e8cd-2d9e-391c-ae7a-bfb57953e221",
                        "source_sense_id": "0de368b3-92f9-3a11-945f-bf159b250f3f",
                        "target_lang_word": "dissent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To disagree; to withhold assent. Construed with from (or, formerly, to)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "612d3015-6b42-4de1-8057-8e0644ba280c",
                                                "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                                "text": "Where a trustee refuses either to assent or dissent, the Court will itself exercise his authority."
                                            },
                                            {
                                                "example_id": "45f12739-12b0-4e96-84ac-a5a55ca759a7",
                                                "sense_id": "aadbda02-3ae4-3d99-a381-15d94e5abc16",
                                                "text": "Those who openly dissented from the acts which the King had carried through the Parliament."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To differ from, especially in opinion, beliefs, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3c8a5a7-d464-432e-be75-8317f713aee4",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "Some are so eristical and teasty, that they will not ... bear with any that dissent."
                                            },
                                            {
                                                "example_id": "98a1a6b0-cac1-45ea-b6c6-34647b3a03cf",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "Natural reason dictates, that motion ought to be assigned to the bodies, which in kind and essence most agree with those bodies which do undoubtedly move, and rest to those which most dissent from them."
                                            },
                                            {
                                                "example_id": "d55aef83-c903-443c-ac1e-b2eacfb42065",
                                                "sense_id": "52bd54b7-6168-36a4-9b59-2245c39a1830",
                                                "text": "If the public dissent from our views, we say that they ought to concur with us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eefbc0a1-375c-32bd-9346-ef098ae6e3c4",
                                        "entry_id": "091aab4a-a325-3954-9973-cbc913c2f9a0",
                                        "glosses": [
                                            "To be different; to have contrary characteristics."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38728c2-052d-4126-aeed-78370138086c",
                                                "sense_id": "eefbc0a1-375c-32bd-9346-ef098ae6e3c4",
                                                "text": "it was wholly unlawful, in any thing to dissent from him"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dissent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "Disagreement with the ideas, doctrines, decrees, etc. of a political party, government or religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b07425-f362-4a99-9326-990450390a33",
                                                "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                                "text": "ethnopolitical dissent"
                                            },
                                            {
                                                "example_id": "1f45b40e-35b1-459a-84eb-5ffd42bad480",
                                                "sense_id": "a2ca0b88-7976-3956-a89d-f132c2bcbc4d",
                                                "text": "A system that suppresses dissent is fault-intolerant, ignorant and fragile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4347768-1063-3ee8-828a-18f6996681dc",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "An act of disagreeing with, or deviating from, the views and opinions of those holding authority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ccebdd5-b7c3-3861-8c0d-753ab544e2fb",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "A separate opinion filed in a case by judges who disagree with the outcome of the majority of the court in that case"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "022592c8-791a-3948-997f-d519ed204c98",
                                        "entry_id": "acdd4bed-9c4f-33e5-b8a5-65cd2a115c58",
                                        "glosses": [
                                            "A violation that arises when disagreement with an official call is expressed in an inappropriate manner such as foul language, rude gestures, or failure to comply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19665d2-656b-4c3a-9dea-3b0349fc57c4",
                                                "sense_id": "022592c8-791a-3948-997f-d519ed204c98",
                                                "text": "City had been woeful, their anger at their own inertia summed up when Samir Nasri received a booking for dissent, and they did not have a shot on target until the 66th minute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c7ef7e7-af1e-461d-b69e-483dfb87c89a",
                        "source_entry_id": "9d68e8cd-2d9e-391c-ae7a-bfb57953e221",
                        "source_sense_id": "cacb905c-2440-304c-aa17-cea85612ca63",
                        "target_lang_word": "Abweichung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abweichung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "die Nichterfüllung einer Regelmäßigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cba916-f00d-41cc-8263-1588d7303b25",
                                                "sense_id": "8330e810-4b79-35b2-af0e-f994f265ecf2",
                                                "text": "Eine Abweichung vom Zeitplan steht außer Frage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                        "entry_id": "417f3af5-9080-356e-949e-b85a5ee3735a",
                                        "glosses": [
                                            "Verletzung einer grammatischen Regel oder Verstoß gegen eine geltende Sprachnorm oder -konvention"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c0ead03-7860-40f2-93f4-51b0c01f2544",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Abweichungen können auf jeder grammatischen oder stilistischen Ebene erfolgen."
                                            },
                                            {
                                                "example_id": "8ac7f817-e59b-4bb9-a64f-0b4a1163d06a",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„Riffaterres kontextuelle Stilauffassung setzt einen Stilbegriff voraus, der nur der Abweichung von der Lesererwartung Stilcharakter zuerkennt.“"
                                            },
                                            {
                                                "example_id": "c6c5138a-c674-4478-9879-b76843d56da2",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "Über das »Österreichische«: „Sah man in der Betonung der Abweichungen nach 1945 noch die Möglichkeit, eine identitätsstiftende antideutsche Haltung zu demonstrieren, sieht Professor Koppensteiner heute eher ein Imageproblem vorherrschen.“"
                                            },
                                            {
                                                "example_id": "732a125b-8602-497e-922a-5bac6ef74872",
                                                "sense_id": "9a3de50f-8317-323e-aa79-31edd29b2460",
                                                "text": "„In der Schreibpraxis gibt es jedoch Abweichungen davon, die insbesondere den Bereich der Behörden betreffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
