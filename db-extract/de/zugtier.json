                    {
                        "form_id": "c065a10f-2213-4d09-a07b-bba019de1f1b",
                        "entry_id": "9cab9e29-15e6-3490-89c3-de35c94f0ab0",
                        "tags": [
                            "accusative",
                            "plural"
