                        "cross_references": [
                            {
                                "target_word": "kindje",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f65b7c7f-aa9d-3d49-ad64-32bbf63d9798",
                                        "entry_id": "50e50d7a-e480-30f0-a4d6-307f5d70b3e0",
                                        "glosses": [
                                            "verkleinwoord enkelvoud van het zelfstandig naamwoord kind"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b8598d-f3f7-4e85-b54a-1ef46f9e65a2",
                                                "sense_id": "f65b7c7f-aa9d-3d49-ad64-32bbf63d9798",
                                                "text": "Haar houding tegenover Marens geheim is honderdtachtig graden gedraaid: het kindje is nu een wonder, een smeltkroes waarin al hun problemen zullen verbranden en verdwijnen."
                                            },
                                            {
                                                "example_id": "4ef14f43-db33-4123-a123-58e4c8ef9d4a",
                                                "sense_id": "f65b7c7f-aa9d-3d49-ad64-32bbf63d9798",
                                                "text": "Heeft Maren enig idee van de vreselijke angst, de hoeveelheid bloed en de geluiden die er bij een bevalling komen kijken? Weet ze hoezeer haar lichaam zich zal verzetten? Maren lijkt vastbesloten het kindje haar geduchte wil op te leggen, alsof ze - net als het hermetisch afgesloten wezen in haar - immuun is voor lijden en de streken die de buitenwereld kan leveren."
                                            },
                                            {
                                                "example_id": "74db85fa-82f1-4d5d-af23-11d623ebae60",
                                                "sense_id": "f65b7c7f-aa9d-3d49-ad64-32bbf63d9798",
                                                "text": "Ze tast in haar zak naar het miniatuurkindje, en in gedachten ziet ze zichzelf omdraaien, met het piepkleine kindje op haar uitgestrekte hand om het terug te geven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
