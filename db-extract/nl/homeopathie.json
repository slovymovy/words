        "nl-extract.jsonl": [
            {
                "entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                "word": "homeopathie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                        "entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                        "glosses": [
                            ": een alternatieve geneeswijze die oorspronkelijk werd geformuleerd door Samuel Hahnemann en voor het eerst gepubliceerd in 1796"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84255bca-4e83-4885-ab87-4cc70984c56e",
                                "sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                                "text": "\"Homeopathie is niet effectiever dan placebo\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b76a1134-90b9-42c4-8f4a-b39216caebb4",
                        "source_entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                        "source_sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                        "target_lang_word": "Homöopathie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Homöopathie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                        "entry_id": "925dc7b3-0055-3ebf-a3d8-c1b07bd32ca4",
                                        "glosses": [
                                            "alternative Behandlungsmethode, bei der Substanzen, von denen bekannt ist oder angenommen wird, sie könnten bei gesunden Menschen der Krankheit ähnelnde Symptome hervorrufen, in starker Verdünnung verabreicht werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf00432f-22df-463a-b61b-74a2fbecd6d8",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "Die Homöopathie ist eine Behandlungsmethode der Alternativmedizin."
                                            },
                                            {
                                                "example_id": "9e986b38-476e-43e3-abf3-e43c65997f69",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„2005 führte die Universität Bern die wohl umfassendste und seriöseste Untersuchung zum Thema Homöopathie durch und heraus kam: nichts.“"
                                            },
                                            {
                                                "example_id": "9d9882e6-d466-4bdd-a972-6a0c707bddf4",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Zahlreichen Wissenschaftlern zufolge wirkt die Homöopathie nur im Rahmen des Placebo-Effektes.“"
                                            },
                                            {
                                                "example_id": "da0ba0d7-1648-4d4e-b89a-3f13d1049a59",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Die Wirkstoffe, die in der Homöopathie eingesetzt werden, sind in hoher Konzentration häufig giftig.“"
                                            },
                                            {
                                                "example_id": "e58d8abb-0581-4a1b-a2e4-28e4306ed610",
                                                "sense_id": "d8f77f5c-ca01-3678-a17d-c96d172d9628",
                                                "text": "„Aus pharmakologischer Sicht ist das Prinzip der Homöopathie nicht haltbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dafea02e-4a00-4941-973b-3f6f19313f4d",
                        "source_entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                        "source_sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                        "target_lang_word": "homeopathy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeopathy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                        "entry_id": "08bb784e-1744-39d3-b9a1-b9b7b196b210",
                                        "glosses": [
                                            "A system of treating diseases with small amounts of substances which, in larger amounts, would produce the observed symptoms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faea31d7-827e-4062-bbb1-80a341cb68ac",
                                                "sense_id": "fda0b378-f6a0-3690-968f-875e777b1fd5",
                                                "text": "I am sure that if doctors (for instance) were first taught how to use some of the other methods of homeopathy effectively, particularly the therapeutics and organ-based methods, they would be much more able to incorporate these into their practices […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d5b1cc1-0a11-4e61-8d4c-ba06f21e93d7",
                        "source_entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                        "source_sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                        "target_lang_word": "homéopathie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homéopathie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f07ea05f-e08d-3a2c-8670-cc0d08436437",
                                        "entry_id": "f88d7d19-d5f5-3108-a825-52831b9d15c5",
                                        "glosses": [
                                            "Méthode qui consiste à traiter une personne malade par l’ingestion d’une dose infinitésimale mais dynamisée de la substance qui, à dose bien plus élevée, donnerait à une personne saine des symptômes analogues à ceux de la maladie (« principe de similitude »)."
                                        ],
                                        "tags": [
                                            "Pseudo-sciences",
                                            "Médecine non conventionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9b76a43-8aae-49ac-a337-17d25887a70b",
                                                "sense_id": "f07ea05f-e08d-3a2c-8670-cc0d08436437",
                                                "text": "La conclusion est claire : l’homéopathie n’est rien d’autre que du bonbon placebo. Comme nous l’a expliqué le biochimiste Jean-René Dufort, on trouve autant d’arsenic dans ces bonbons qu’il y en a dans un verre d’eau ordinaire."
                                            },
                                            {
                                                "example_id": "88296759-2e94-4107-a2f6-3a6a5786cdd1",
                                                "sense_id": "f07ea05f-e08d-3a2c-8670-cc0d08436437",
                                                "text": "Mais, à l’époque, au sein de ce courant qu’on qualifiera de holisme idéologique, l’homéopathie est, de loin, la tendance la plus importante. Moins répandue en France qu’aux États-Unis et en Allemagne au XIXᵉ siècle, elle revient rapidement sur le devant de la scène dans les années 1920."
                                            },
                                            {
                                                "example_id": "5f3b29e2-aad8-4cd1-b486-3333d90f35d9",
                                                "sense_id": "f07ea05f-e08d-3a2c-8670-cc0d08436437",
                                                "text": "En outre, l’homéopathie peut avoir un effet nocif en retardant la consultation d’un médecin ou dissuadant le patient de rechercher les soins médicaux appropriés, qui seront basés sur des preuves scientifiques, et en fragilisant finalement la confiance des patients et du public envers la démarche scientifique fondée sur les preuves."
                                            },
                                            {
                                                "example_id": "d15a38db-7393-4f98-846c-381009bc5a26",
                                                "sense_id": "f07ea05f-e08d-3a2c-8670-cc0d08436437",
                                                "text": "« Cette rémunération étant assez importante pour certaines pharmacies, vitales pour certaines d’entre-elles, c’est un mauvais message envoyé aux pharmaciens et à tout le secteur. Lorsque nous allions négocier les conventions ces dernières années, il était prévu que l’on puisse bien gagner notre vie sur la vente d’homéopathie. Et quelques années après, on nous coupe l’herbe sous le pied », a-t-il regretté dans les colonnes du quotidien Le Réveil Normand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fead2e3-0cf7-3559-9449-0624daa8a378",
                                        "entry_id": "f88d7d19-d5f5-3108-a825-52831b9d15c5",
                                        "glosses": [
                                            "Chose, mesure, quantité insuffisante, inutile et/ou inefficace."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a50fecd-2d77-4b50-9241-54fa4149bafc",
                                                "sense_id": "0fead2e3-0cf7-3559-9449-0624daa8a378",
                                                "text": "M. Pierre Mauger. « Il ne faut pas seulement porter un diagnostic ! Il faut aussi trouver le remède ! »\nM. le ministre d'État, ministre du commerce extérieur. « Nous y venons tout doucement. »\nM. Pierre Meulier. « C'est de l'homéopathie ! »"
                                            },
                                            {
                                                "example_id": "02c7825f-566f-41a1-9177-d4fc86edb96b",
                                                "sense_id": "0fead2e3-0cf7-3559-9449-0624daa8a378",
                                                "text": "Peut-on, notamment, faire fond sur l'outil fiscal pour conserver dans ces zones les médecins qui les quittent ? Évidemment non ! L'homéopathie politique trouve ici ses limites."
                                            },
                                            {
                                                "example_id": "a99a0a19-274c-4f26-88c7-e74e9ab3a0d9",
                                                "sense_id": "0fead2e3-0cf7-3559-9449-0624daa8a378",
                                                "text": "On ne peut rester dans l’homéopathie ou le symbolique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d98eb9d-b769-4dcd-a4f7-f7b1a2a8c510",
                        "source_entry_id": "123c914f-97f2-37b1-b448-aac8f7e14efa",
                        "source_sense_id": "c94c15ab-7297-36f8-896b-0f452e3fb8b2",
                        "target_lang_word": "homeopatía",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homeopatía",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                        "entry_id": "4ab02723-f028-3a7c-a379-98799f0329ff",
                                        "glosses": [
                                            "Método curativo que aplica, en dosis mínimas, substancias que en cantidad mayor producirían efectos o afecciones semejantes a las que se combaten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc2ed53f-0138-48d1-8845-de16d3885fc0",
                                                "sense_id": "bd6b919e-76b9-30e6-906a-159b491eaac4",
                                                "text": "Capaz que no le hizo gracia al de la farmacia\nCuando dije que yo defiendo a muerte a la eutanasia\nDecía que si todos se morían, se fundía\nY me tiró con un frasco de homeopatía"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
