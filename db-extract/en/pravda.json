                        ]
                    },
                    {
                        "sense_id": "35a30590-91ee-32a1-a000-ba274d62bc68",
                        "entry_id": "4b255d74-f119-3f2c-9022-62d931f67463",
                        "glosses": [
                            "Pravda.ru, a privately owned Russian news website established in 1999."
                        ],
                        "tags": [],
                        "examples": [
