                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f576661d-d7fb-3899-9a69-f28de2c46b56",
                        "entry_id": "7357474f-24fb-3e34-903f-469a521a359f",
                        "glosses": [
                            "(le verbe est réciproque, le pronom est transitif direct) Se sentir de nouveau attirés l’un vers l’autre."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "344b93d8-fd81-4937-86a5-6a3cdda4b95c",
                                "sense_id": "f576661d-d7fb-3899-9a69-f28de2c46b56",
                                "text": "Malgré les années de séparation, ils se rattiraient encore."
                            }
                        ]
                    },
                    {
                        "sense_id": "52ed23d3-5700-3b74-a630-72a117193f0b",
                        "entry_id": "7357474f-24fb-3e34-903f-469a521a359f",
                        "glosses": [
                            "(le verbe est réfléchi, le pronom est transitif indirect) Attirer de nouveau vers soi."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "ab7bf23a-7fe5-489c-9b35-4d7650640fe8",
                                "sense_id": "52ed23d3-5700-3b74-a630-72a117193f0b",
                                "text": "Vous allez vous rattirer des ennuis si vous continuez."
                            }
                        ]
                    },
                    {
                        "sense_id": "aaa28ab8-0527-31a6-a8c5-15b1eafd2293",
                        "entry_id": "7357474f-24fb-3e34-903f-469a521a359f",
                        "glosses": [
