                    {
                        "sense_id": "2439043b-ae91-3b40-8987-87fb7f52b647",
                        "entry_id": "210abd43-58a0-30f3-b95b-bc3d77eb49f6",
                        "glosses": [
                            "Bewijs van gedeeltelijke storting op een aandeel of obligatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a74947ec-17a5-4c0a-891f-499f64d962f0",
                                "sense_id": "2439043b-ae91-3b40-8987-87fb7f52b647",
                                "text": "Fagron beperkte het verlies tot 0,12 procent bij een slotkoers van 7,76 euro. De specialist van magistrale bereiding voor apothekers rondde zijn publieke kapitaalverhoging met 88,265 miljoen euro af. Ruim 94,62 procent van de nieuwe aandelen konden direct worden geplaatst, op de overige werd ingeschreven door de kopers van scrips. Eerder plaatste het bedrijf ook al nieuwe aandelen bij institutionele beleggers."
                            },
                            {
                                "example_id": "c754b0c8-ab36-4484-9eee-bbe409bc262a",
                                "sense_id": "2439043b-ae91-3b40-8987-87fb7f52b647",
                                "text": "De niet verpatste aandelen worden nu omgezet in ‘scrips’ (niet-uitgeoefende voorkeursrechten), die woensdag via een private plaatsing verkocht worden."
                            },
                            {
                                "example_id": "2fc03e22-c572-4b59-8480-11b6272b416c",
                                "sense_id": "2439043b-ae91-3b40-8987-87fb7f52b647",
                                "text": "Meer dan 95 procent van de aandeelhouders maakten van hun rechten gebruik om nieuwe titels bij te kopen. De resterende effecten werden verkocht aan de inschrijvers op scrips."
                            }
                        ]
                    }
