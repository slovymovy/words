                                        "glosses": [
                                            "A polygon with five sides and five angles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93b35459-95de-4f85-83a2-2ec2d7ddc3ca",
                                                "sense_id": "8fe8fc8a-afb8-3f2a-9ee6-7729bcdcf205",
                                                "text": "Imagine a vast sheet of paper on which straight Lines, Triangles, Squares, Pentagons, Hexagons, and other figures, instead of remaining fixed in their places, move freely about, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41548a52-b375-373d-afb4-67ab9e2155a9",
                                        "entry_id": "0b17f6e2-35a5-37a3-b55a-4e494fb59f02",
                                        "glosses": [
                                            "A fort with five bastions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7410bd3-08a1-498a-ab50-b63a89bc3567",
                        "source_entry_id": "0b1dd05f-320a-31aa-8b26-5d6172fa6f28",
                        "source_sense_id": "36229c71-c7ea-37e0-9ba2-6c957d45bd95",
