                "senses": [
                    {
                        "sense_id": "6be3a352-5669-3596-8ef1-0b86c427476e",
                        "entry_id": "c3c748ba-5026-32d3-be5e-7fa96df31c4a",
                        "glosses": [
                            "to spread (on), to smear (with), to daub (with)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a07e7f7-0bae-4c2d-87e1-0c20f0d16d24",
                                "sense_id": "6be3a352-5669-3596-8ef1-0b86c427476e",
                                "text": "нама́зать хлеб ма́слом; нама́зать ма́сло на хлеб",
                                "translation": "to spread bread with butter; butter bread",
                                "english": "to spread bread with butter; butter bread"
                            },
                            {
                                "example_id": "6221fa97-188c-43ca-a5a6-d4168fd5f2b3",
                                "sense_id": "6be3a352-5669-3596-8ef1-0b86c427476e",
                                "text": "нама́зать ма́зью",
                                "translation": "to apply an ointment (to)",
                                "english": "to apply an ointment (to)"
                            },
                            {
                                "example_id": "99540b2c-a9db-446a-aa2c-3747fa0bec55",
                                "sense_id": "6be3a352-5669-3596-8ef1-0b86c427476e",
                                "text": "нама́зать губы",
                                "translation": "to put lipstick on",
                                "english": "to put lipstick on"
                            },
                            {
                                "example_id": "e6b61c2d-586f-49b3-8502-7540c3703193",
                                "sense_id": "6be3a352-5669-3596-8ef1-0b86c427476e",
                                "text": "Несмотря на то, что Хаджи-Мурат более суток ничего не ел, он съел только немного хлеба, сыра и, достав из-под кинжала ножичек, набрал мёду и намазал его на хлеб.",
                                "translation": "Though he had eaten nothing for more than twenty-four hours Hadji Murad ate only a little bread and cheese; then, drawing out a small knife from under his dagger, he spread some honey on a piece of bread.",
                                "english": "Though he had eaten nothing for more than twenty-four hours Hadji Murad ate only a little bread and cheese; then, drawing out a small knife from under his dagger, he spread some honey on a piece of bread."
                            }
                        ]
                    }
                ],
