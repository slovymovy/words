            "senses": [
                {
                    "sense_id": "44661af5-3f3d-34d6-a4b9-fbadea1790e2",
                    "sense_definition": "Сумка для ношения школьных учебников, тетрадей и письменных принадлежностей.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама купила сыну новый красивый <w>портфель</w> к первому сентября.",
                            "target_lang_translations": {
                                "en": "Mom bought her son a beautiful new <w>schoolbag</w> for the first of September.",
                                "de": "Die Mutter kaufte ihrem Sohn eine schöne neue <w>Schultasche</w> zum ersten September."
                            }
                        },
                        {
                            "text": "Ученик быстро собрал свой <w>портфель</w> и побежал домой.",
                            "target_lang_translations": {
                                "en": "The student quickly packed his <w>schoolbag</w> and ran home.",
                                "de": "Der Schüler packte schnell seinen <w>Schulranzen</w> und rannte nach Hause."
                            }
                        }
                    ],
                    "common_phrases": [
                        "школьный портфель",
                        "собрать портфель",
                        "тяжёлый портфель"
                    ],
                    "traits": [
