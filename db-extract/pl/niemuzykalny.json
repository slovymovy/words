                        "glosses": [
                            "taki, który nie ma zdolności muzycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd9c9db3-603a-454f-ab60-261dccfa4a22",
                                "sense_id": "91f7e054-8f38-3f9c-94a4-2d8f462b1b8e",
                                "text": "Ale słyszę, naprawdę słyszę rytm, a rymy same do mnie przybiegają. Mama się dziwi: przecież takie niemuzykalne dziecko!"
                            }
                        ],
