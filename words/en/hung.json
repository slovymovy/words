                    "sense_id": "3e114f98-26a4-36fe-87c3-047b148021c3",
                    "sense_definition": "Simple past and past participle of <w>hang</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <hung> her coat on the hook behind the door.",
                            "target_lang_translations": {
                                "ru": "Она <повесила> своё пальто на крючок за дверью.",
                                "es": "Ella <colgó> su abrigo en el gancho detrás de la puerta.",
                                "zh": "她把外套<w>挂</w>在了门后面的钩子上。"
                            }
                        },
                        {
                            "text": "The thick fog <hung> over the city all morning.",
                            "target_lang_translations": {
                                "ru": "Густой туман <висел> над городом всё утро.",
                                "es": "La espesa niebla <colgó> sobre la ciudad toda la mañana.",
                                "zh": "浓雾整个上午都<w>笼罩</w>着这座城市。"
                            }
