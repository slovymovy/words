                                        "glosses": [
                                            "Petit échassier limicole au bec arqué et au dessin de la tête caractéristique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47091dc6-f7b0-4076-b90f-9d4f8caf3fea",
                                                "sense_id": "1d636ffc-81a4-3111-889d-6b3669decf16",
                                                "text": "Le courlis corlieu a une fine raie centrale jaunâtre entourée de larges raies sombres de chaque côté de la calotte."
                                            },
                                            {
                                                "example_id": "5bdce3ba-474b-4a0e-918e-167aa8c35254",
                                                "sense_id": "1d636ffc-81a4-3111-889d-6b3669decf16",
                                                "text": "Le courlis corlieu (Numenius phaeopus) trouve des conditions d’hivernage optimales dans la mangrove."
                                            },
                                            {
                                                "example_id": "66ff8047-e8ac-4b7e-8388-824c77ab66e4",
                                                "sense_id": "1d636ffc-81a4-3111-889d-6b3669decf16",
                                                "text": "Des courlis corlieux sont marqués chaque année en Vendée durant leur stationnement prénuptial."
                                            }
                                        ]
