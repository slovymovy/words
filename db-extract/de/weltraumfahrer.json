                    {
                        "sense_id": "c7f4740c-aeaf-3bb5-8507-f85a08338868",
                        "entry_id": "33b1bf39-4b2c-3cd2-b9a0-e3f3b86b3be3",
                        "glosses": [
                            "eine Person, die selbst Weltraumfahrt betreibt, sich im Weltraum bewegt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "be2ed977-4a46-4217-8525-7ef3c45926e6",
                                "sense_id": "c7f4740c-aeaf-3bb5-8507-f85a08338868",
                                "text": "Im Jahr 1961 startete der erste Weltraumfahrer ins All."
                            },
                            {
                                "example_id": "def0bed6-4d0c-41b5-9f47-6671eccc631a",
                                "sense_id": "c7f4740c-aeaf-3bb5-8507-f85a08338868",
                                "text": "Hansrudi Wäscher, der Hauszeichner des Lehning-Verlages, erschafft den ritterlichen Helden Sigurd, den Weltraumfahrer Nick und den Sohn des Dschungels Tibor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "842e67a7-ba3c-4678-8f72-51b6146fac59",
                        "source_entry_id": "33b1bf39-4b2c-3cd2-b9a0-e3f3b86b3be3",
                        "source_sense_id": "c7f4740c-aeaf-3bb5-8507-f85a08338868",
                        "source_sense_description": "selten: eine Person, die selbst Weltraumfahrt betreibt, sich im Weltraum bewegt",
