                "senses": [
                    {
                        "sense_id": "b218f5ca-9bef-3632-8385-22a09fa8e60c",
                        "entry_id": "928c8a1a-8edb-33a3-b187-7f88d3471ab1",
                        "glosses": [
                            "ein Thermometer, das die Innentemperatur eines Backofens misst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a551125-bce6-4e82-a062-1d1e65528d91",
                                "sense_id": "b218f5ca-9bef-3632-8385-22a09fa8e60c",
                                "text": "Das Backofenthermometer ist nicht zu verwechseln mit dem Bratenthermometer, das zur Messung der Kerntemperatur von Speisen dient."
                            },
                            {
                                "example_id": "d9515a67-6a9b-4796-9fa4-67bea2491b20",
                                "sense_id": "b218f5ca-9bef-3632-8385-22a09fa8e60c",
                                "text": "Der GU Küchenratgeber „Niedrigtemperaturgaren“ wurde in eine Packung eingeschweißt zusammen mit einem (gut sichtbaren) Backofenthermometer als kostenloser Zugabe; zum Küchenratgeber „Kochen für Babys“ gibt es bunte Wärmesensor-Löffel gratis dazu."
                            }
                        ],
