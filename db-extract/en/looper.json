                ],
                "senses": [
                    {
                        "sense_id": "e340ba14-2771-3437-9691-8358777775f3",
                        "entry_id": "f2daa9ce-0afc-3cca-9c06-c31b1db5e5d6",
                        "glosses": [
                            "An instrument or tool, such as a bodkin, for forming a loop in yarn or cord, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "85219979-ae5c-37d3-aaaa-4134e48fa7d0",
                        "entry_id": "f2daa9ce-0afc-3cca-9c06-c31b1db5e5d6",
                        "glosses": [
                            "A moth having a caterpillar which arches its body into a loop in order to bring the back part of the body forward as it walks due to having fewer prolegs, including inchworms or measuring worms in the family Geometridae and some species in the family Noctuidae."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cea1a28b-ae8e-35b9-8274-ef6f637f797b",
                        "entry_id": "f2daa9ce-0afc-3cca-9c06-c31b1db5e5d6",
                        "glosses": [
                            "A (usually electronic) tool for creating music loops."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b1ff97ff-62da-30ec-88f7-6c5fb4613f5d",
                        "entry_id": "f2daa9ce-0afc-3cca-9c06-c31b1db5e5d6",
                        "glosses": [
                            "Synonym of blooper (“a fly ball that is weakly hit just over the infielders”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "630a1b27-9a48-4a69-bb05-546188f4f94c",
                                "sense_id": "b1ff97ff-62da-30ec-88f7-6c5fb4613f5d",
                                "text": "With one out and runners on second and third, Cavan Biggio hit a looper up the middle that eluded hustling shortstop Tim Anderson in short centre field."
                            }
                        ]
                    },
                    {
                        "sense_id": "499cbff7-6db0-3706-b9a7-1ad63919f2b9",
                        "entry_id": "f2daa9ce-0afc-3cca-9c06-c31b1db5e5d6",
                        "glosses": [
                            "A golf caddy"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ad8da175-18c6-4f9a-b176-b6cd175a28e1",
                                "sense_id": "499cbff7-6db0-3706-b9a7-1ad63919f2b9",
                                "text": "\"There ain't much to tell. I'm the king of the caddies, the greatest fucking looper who ever packed a bag.\""
                            },
                            {
                                "example_id": "970babc6-56af-4b1f-918f-51b2ac5f598c",
                                "sense_id": "499cbff7-6db0-3706-b9a7-1ad63919f2b9",
                                "text": "\"Carl Spackler: So I jump ship in Hong Kong and I make my way over to Tibet, and I get on as a looper at a course over in the Himalayas. Angie D’Annunzio: A looper? Carl Spackler: A looper, you know, a caddy, a looper, a jock.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "79abf562-6deb-35d8-82bb-05f599ed6041",
