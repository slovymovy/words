                    {
                        "translation_id": "125e1bcb-71a1-430e-bbd6-31d6bc11d360",
                        "source_entry_id": "1e8d2282-5254-30cb-89cb-6dcd093d1290",
                        "source_sense_id": "f9dd7af3-e7a6-3e2e-96ef-2b82e157a573",
                        "source_sense_description": "gevoelens koesterend dat men te na gekomen is",
                        "target_lang_word": "indigné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4bfe005-c6c2-3698-9647-0c7d5b8c46c4",
                                        "entry_id": "ff287c31-e356-308a-9e1e-5b51981962fd",
                                        "glosses": [
                                            "Qui montre de l’indignation face à quelque chose de mal ou d’injuste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbca17c4-77d8-40ed-8bcc-2fe2f0f0dc9e",
                                                "sense_id": "d4bfe005-c6c2-3698-9647-0c7d5b8c46c4",
                                                "text": "Et les dieux contre moi dès longtemps indignés."
                                            },
                                            {
                                                "example_id": "78b0aa65-2592-4ed4-9e21-783213da252a",
                                                "sense_id": "d4bfe005-c6c2-3698-9647-0c7d5b8c46c4",
                                                "text": "La colère peut être folle et absurde ; on peut être irrité à tort ; on n'est indigné que lorsqu'on a raison au fond par quelque côté."
                                            },
                                            {
                                                "example_id": "bf82ab3a-ae9c-4d9d-a59d-5f7865084684",
                                                "sense_id": "d4bfe005-c6c2-3698-9647-0c7d5b8c46c4",
                                                "text": "Les paroles indignées du lieutenant sur la conduite de ses poilus, les amplifications moins vertueuses mais ultra-séduisantes qu’y ajouta Lénac, mirent l’eau à la bouche des hommes de la 8ᵉ."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d700cb1-0ebe-3603-8aef-7c7982b61e62",
                                        "entry_id": "5ae4ac6d-fc4f-3bb8-8b79-60eee3f19338",
                                        "glosses": [
                                            "Personne qui ressent ou manifeste de l'indignation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceafc43-abec-4645-a691-538b1b2ed8be",
                                                "sense_id": "5d700cb1-0ebe-3603-8aef-7c7982b61e62",
                                                "text": "M. Chérouvier, que nous appelons, entre nous, selon les circonstances, Jérémias, ou l'Indigné de carrière, ou le Prophète de la Contrescarpe, à cause de son domicile, ou le Vain généreux (…) a publié, hier, dans Paris-Journal, un article de sa façon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36267f95-b5ce-3f5f-8382-bfda49f304ce",
                                        "entry_id": "5ae4ac6d-fc4f-3bb8-8b79-60eee3f19338",
                                        "glosses": [
                                            "Membre du mouvement des Indignés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48c11bb1-7d5f-4410-acd1-eb7289d0a8a4",
                                                "sense_id": "36267f95-b5ce-3f5f-8382-bfda49f304ce",
                                                "text": "Comme leurs homologues de Madrid ou New-York, les indignés suisses protestent contre le système financier."
                                            },
                                            {
                                                "example_id": "b3bdba2a-8d3f-4405-b7f9-940112830f56",
                                                "sense_id": "36267f95-b5ce-3f5f-8382-bfda49f304ce",
                                                "text": "Une indignée d’origine grecque a reçu mercredi un violent coup de pied au visage par un homme en civil après son interpellation par la police en marge d’une manifestation devant le siège de la banque Dexia, place Rogier."
                                            },
                                            {
                                                "example_id": "db9b5f66-27f5-437a-9fd3-a10503a625c7",
                                                "sense_id": "36267f95-b5ce-3f5f-8382-bfda49f304ce",
                                                "text": "« Ce faible engouement, on le vit au quotidien, reconnaît un Indigné qui tient à l’anonymat pour préserver le caractère collectif du mouvement. On s’est mobilisés à de nombreuses reprises depuis le mois de mai, mais le vrai démarrage se fait attendre »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec14709-8055-3d6f-89a9-e505c80948b3",
                                        "entry_id": "5ae4ac6d-fc4f-3bb8-8b79-60eee3f19338",
                                        "glosses": [
                                            "Partisan du mouvement de contestation Occupy Wall Street."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2c18192-862c-4986-bb15-2be592b214f5",
                                                "sense_id": "aec14709-8055-3d6f-89a9-e505c80948b3",
                                                "text": "Les manifestants, les Indignés, critiquent le système capitaliste financier et les inégalités économiques aux États-Unis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indigné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37fd2087-b7a4-3cf0-b757-f660b733546c",
                                        "entry_id": "d3ad7ece-b7f5-3798-84c1-bace77fa33fc",
                                        "glosses": [
                                            "Participe passé masculin singulier de indigner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b763436-ad4e-4e1a-94c0-f2156ea9ff9a",
                                                "sense_id": "37fd2087-b7a4-3cf0-b757-f660b733546c",
                                                "text": "« Nous avons le droit de chanter à propos de ce que nous avons traversé », estime Israël Katz, le ministre israélien des Affaires étrangères, qui s’est indigné du refus de cette chanson pour le concours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
