                        ],
                        "form": "das Abstraktum"
                    },
                    {
                        "form_id": "48946c88-f502-41fb-b7b6-b3c911657b08",
                        "entry_id": "79ab31df-05b7-3961-9836-9363b2db125a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Abstrakta"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b83cc20c-3492-3218-a63b-a67066840ab8",
                        "entry_id": "79ab31df-05b7-3961-9836-9363b2db125a",
                        "glosses": [
                            "etwas Abstraktes, abstrakte Idee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7048a2d-99cd-4c53-80a4-87285fc37a99",
                                "sense_id": "b83cc20c-3492-3218-a63b-a67066840ab8",
                                "text": "„Die Idee der „Freiheit des Willens” ist für Thomas Hobbes ein Abstraktum, ein Hirngespinst.“."
                            },
                            {
                                "example_id": "543418b8-87fe-4bf6-865f-9f2374714663",
                                "sense_id": "b83cc20c-3492-3218-a63b-a67066840ab8",
                                "text": "„Wobei man natürlich nicht außer acht lassen darf, daß es sich beim Menschen um ein Konkretum, bei der Freiheit hingegen um ein Abstraktum handelt.“"
                            },
                            {
                                "example_id": "bc67b2cf-ddaf-463d-9aec-f9c83019f5cf",
                                "sense_id": "b83cc20c-3492-3218-a63b-a67066840ab8",
                                "text": "„Es gibt da nämlich noch einen ominösen Mitspieler, der eigentlich gar nicht mitspielt und dennoch ständig im Stadion präsent ist: der zwölfte Mann, ein Abstraktum von vielfältiger Gestalt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e0a37164-464f-3177-9e3d-600ad37443dc",
                        "entry_id": "79ab31df-05b7-3961-9836-9363b2db125a",
                        "glosses": [
                            "Substantiv (Hauptwort), das Nicht-Gegenständliches bezeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e306a3-d9a9-4a4f-be1c-d9bb725cc0c0",
                                "sense_id": "e0a37164-464f-3177-9e3d-600ad37443dc",
                                "text": "„Höflichkeit, Stress, Sozialstaat“ sind Beispiele für Abstrakta."
                            },
                            {
                                "example_id": "a5ea3592-0b3f-4792-9e04-e82a3a264af7",
                                "sense_id": "e0a37164-464f-3177-9e3d-600ad37443dc",
                                "text": "Begriffe sind Abstrakta, aber auch andere Konzepte wie „Liebe“, „Grobheit“ etc."
                            },
                            {
                                "example_id": "cf61d368-e8b7-4692-abe5-43697e3d8639",
                                "sense_id": "e0a37164-464f-3177-9e3d-600ad37443dc",
                                "text": "„Vorweg muß vor der Annahme gewarnt werden, als seien Konkreta und Abstrakta von vornherein festgelegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4f280ed-c36c-4cc2-b986-02f66d60f574",
                        "source_entry_id": "79ab31df-05b7-3961-9836-9363b2db125a",
                        "source_sense_id": "b83cc20c-3492-3218-a63b-a67066840ab8",
                        "source_sense_description": "etwas Abstraktes, abstrakte Idee",
                        "target_lang_word": "abstraction",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstraction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36bbb5ad-dcdd-3741-b42b-46a637e230a3",
                                        "entry_id": "dee6ab66-dcaa-3b7b-a9f0-187d3886ec0f",
                                        "glosses": [
                                            "Opération par laquelle l’esprit isole un caractéristique d'un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41713aef-a8b7-3896-a361-398061002b24",
                                        "entry_id": "dee6ab66-dcaa-3b7b-a9f0-187d3886ec0f",
                                        "glosses": [
                                            "Idée générale créant un lien unitaire, par l'esprit, entre plusieurs réalités concrètes qui comportent un trait commun mais sont différentes dans le détail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6180b75c-aec7-4475-ad8f-c87c18891183",
                                                "sense_id": "41713aef-a8b7-3896-a361-398061002b24",
                                                "text": "Humanité, raison, vertu, savoir, blancheur, pesanteur, etc., sont des abstractions."
                                            },
                                            {
                                                "example_id": "584b9a2a-5fd0-41fe-9822-589e0d212f4d",
                                                "sense_id": "41713aef-a8b7-3896-a361-398061002b24",
                                                "text": "L'ouvrier, l'artisan, le mécanicien, le savant, l'écrivain, l'homme du commun, dans la vie quotidienne comme dans la sphère de leur activité propre, usent constamment d'abstractions. L'abstraction élimine, simplifie, processus sans lequel la pensée ne peut se fixer sur quelque objet."
                                            },
                                            {
                                                "example_id": "a4625330-119e-4b59-98d9-20206192d1c2",
                                                "sense_id": "41713aef-a8b7-3896-a361-398061002b24",
                                                "text": "Dans toute abstraction il reste un peu de réalité, comme dans le vide artificiel il reste toujours un peu d’ air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "683336e5-594f-38c5-8318-34dfff4ecf77",
                                        "entry_id": "dee6ab66-dcaa-3b7b-a9f0-187d3886ec0f",
                                        "glosses": [
                                            "Idée trop théorique tellement éloignée de la réalité qu'elle risque de donner lieu à des absurdités, à des non-sens ou à un résultat inutile."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac35db1-4bb9-4f03-8516-cb447f68c341",
                                                "sense_id": "683336e5-594f-38c5-8318-34dfff4ecf77",
                                                "text": "Si c'est de la sorte que Kaulbach entend le réalisme, nous aimons encore mieux les abstractions les plus nuageuses ou les imitations les plus archaïquement byzantines."
                                            },
                                            {
                                                "example_id": "fc4eddc3-25a9-47ca-89ff-d29b31db36cb",
                                                "sense_id": "683336e5-594f-38c5-8318-34dfff4ecf77",
                                                "text": "L'erreur provient de ce que Kautsky est bien plus un idéologue qu'un disciple de Marx ; il aime à raisonner sur des abstractions et croit avoir fait avancer une question lorsqu'il est parvenu à grouper des mots ayant une allure scientifique ; la réalité sous-jacente l'intéresse moins que le décor scolastique."
                                            },
                                            {
                                                "example_id": "699bb110-cca4-4837-a45c-a455b2153930",
                                                "sense_id": "683336e5-594f-38c5-8318-34dfff4ecf77",
                                                "text": "L’abstraction devient la puissance de réflexion, l’inaction une capacité à formuler les problèmes, l’inadaptation une polyvalence, l’indécision la certitude de l'incertain, la rhétorique un agir communicationnel, la complication la conscience de la complexité et l’achiffrisme s'évanouit dans l'usage commune d'une règle de trois appliquée à une langue des affaires qu'on apprend comme n'importe quelle langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f568e3ca-4b23-3887-9bbc-011bbfc2ae35",
                                        "entry_id": "dee6ab66-dcaa-3b7b-a9f0-187d3886ec0f",
                                        "glosses": [
                                            "Préoccupation, rêverie qui empêche un homme de penser aux choses dont on lui parle ou qu’il a sous les yeux."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e26e66e-b5c7-4750-a343-d2b214ba2e96",
                                                "sense_id": "f568e3ca-4b23-3887-9bbc-011bbfc2ae35",
                                                "text": "Cet homme est dans des abstractions continuelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
