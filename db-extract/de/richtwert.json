                "senses": [
                    {
                        "sense_id": "f6bb82da-f4a6-3068-ba7a-ec43fe31891b",
                        "entry_id": "e5bafd33-2d3f-3ee9-83df-ec4c776a3341",
                        "glosses": [
                            "Größe, an der sich jemand oder etwas orientiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9b890ba-9379-4712-a54b-41e439e96413",
                                "sense_id": "f6bb82da-f4a6-3068-ba7a-ec43fe31891b",
                                "text": "„Unser strategischer Schwerpunkt liegt heute zu fast zwei Dritteln des Umsatzes auf Märkten mit höchsten Technologie- und Qualitätsansprüchen, nämlich Mobilität und Energie und unsere Stahlerzeugungsstandorte gelten nach Milliardeninvestitionen allein in Umwelteinrichtungen als Richtwert für Umweltstandards und Ressourceneffizienz.“"
                            },
                            {
                                "example_id": "9cf97fa9-7d1a-4f68-b646-46d56250eafc",
                                "sense_id": "f6bb82da-f4a6-3068-ba7a-ec43fe31891b",
                                "text": "„Der Verfassungsgerichtshof möge überprüfen, ob der vergleichsweise niedrige Wiener Richtwert verfassungskonform ist.“"
                            },
                            {
                                "example_id": "3326bb40-67cb-4915-aa5e-41485aac9eb8",
                                "sense_id": "f6bb82da-f4a6-3068-ba7a-ec43fe31891b",
                                "text": "„Am Mittwoch sah es noch so aus, als würde die geplante Obergrenze tatsächlich nur eine Art Richtwert bleiben.“"
                            },
                            {
                                "example_id": "34702f4a-5416-4be0-8b77-42c762ba553e",
                                "sense_id": "f6bb82da-f4a6-3068-ba7a-ec43fe31891b",
                                "text": "„Wohlgemerkt, diese zwei Prozent sind ein Richtwert, keine Verpflichtung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
