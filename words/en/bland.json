            "senses": [
                {
                    "sense_id": "aa64f807-a3f4-31ae-9667-56e6d251dbdc",
                    "sense_definition": "Lacking in taste or flavor.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup was quite <w>bland</w> because the chef forgot to add any salt or spices.",
