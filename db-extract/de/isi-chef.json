                "senses": [
                    {
                        "sense_id": "2a1da21c-12c2-3c3e-a59b-3dd3bad6379f",
                        "entry_id": "6afd6baf-1cb1-3ccb-bbe6-040ebbc3d6d2",
                        "glosses": [
                            "Leiter des pakistanischen Geheimdienstes ISI"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c841825d-52eb-489c-9efa-2f8569e483e8",
                                "sense_id": "2a1da21c-12c2-3c3e-a59b-3dd3bad6379f",
                                "text": "„Nach der Auffindung und Ermordung bin Ladens 2011 in Abottabad ließ der ISI-Chef Ahmad Shuja Pasha allerdings verlautbaren, nichts von bin Ladens Präsenz gewusst zu haben.“"
                            },
                            {
                                "example_id": "0134ba34-b66f-41d9-a34f-8cf64c4a1832",
                                "sense_id": "2a1da21c-12c2-3c3e-a59b-3dd3bad6379f",
                                "text": "„Er wollte den ISI-Chef nicht warten lassen.“"
                            },
                            {
                                "example_id": "736c3389-45c4-475c-9503-710942fdd214",
                                "sense_id": "2a1da21c-12c2-3c3e-a59b-3dd3bad6379f",
                                "text": "„Nach dem Gespräch schüttelte Homer Barkin dem ISI-Chef die Hand - wenn auch weniger herzlich als zur Begrüßung - und wandte sich zum Gehen.“"
                            },
                            {
                                "example_id": "f66dcf53-8ace-4ddd-bbe3-d4542839f93a",
                                "sense_id": "2a1da21c-12c2-3c3e-a59b-3dd3bad6379f",
                                "text": "„1983 musste der ISI-Chef General Akhtar Abdur Rehman sämtliche Mitarbeiter des ISI in Quetta entlassen, weil sie in den Drogenhandel und den Verkauf der vom CIA gelieferten, eigentlich für die Mudschaheddin bestimmten Waffen verwickelt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
