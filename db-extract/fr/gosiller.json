                "senses": [
                    {
                        "sense_id": "a555a269-b6b0-3605-a5c1-26cc638b16a6",
                        "entry_id": "42dc0a47-0151-382b-8ad5-7f28b6a78f59",
                        "glosses": [
                            "On dit que l’eau-de-vie gosille quand, dans la distillation, elle passe mêlée de vin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "43fff165-b0b2-3da3-a81d-122db6359d5f",
                        "entry_id": "42dc0a47-0151-382b-8ad5-7f28b6a78f59",
                        "glosses": [
                            "Parler, raconter, dire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5828345d-7a62-47d5-b76a-3d073b59c2b1",
                                "sense_id": "43fff165-b0b2-3da3-a81d-122db6359d5f",
                                "text": "Il n'est ne pie ne calandre / Qui ne seust pas gosillier, / Ce qui me fet si merveillier."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1b074a6-b4a6-32e4-9555-0e9bee7f06a5",
                        "entry_id": "42dc0a47-0151-382b-8ad5-7f28b6a78f59",
                        "glosses": [
                            "Vomir"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6415f8-5a97-4bf9-9e41-7577b057b6ea",
                                "sense_id": "a1b074a6-b4a6-32e4-9555-0e9bee7f06a5",
                                "text": "aux pays de Papagosse où les chiens chient la poix, les chats gosillent le diamerdis, les femmes enceintes pissent un pucelage gros comme le bras, & les grenoüilles crachent les oysons touts cuits & farcis"
                            },
                            {
                                "example_id": "3143e76d-22df-4817-ac8e-d2b0d19798d9",
                                "sense_id": "a1b074a6-b4a6-32e4-9555-0e9bee7f06a5",
                                "text": "Mais non, plustost bouchez d'un mouchoir vos narines, / Et principalement ces beautez tant divines, / Ou bien fleurez un peu quelques fleurs de jardins, / De peur de goziller vos tripes et boudins."
                            },
                            {
                                "example_id": "c410adad-71f1-4f6e-a00b-0634cb01aaa2",
                                "sense_id": "a1b074a6-b4a6-32e4-9555-0e9bee7f06a5",
                                "text": "Aujourd’hui, ce sont les chansons de Chevalier, de Constantin Rossi ou de Lucienne Boyer qui passent à travers murs, poussées par la même machinerie qui les gosille ailleurs, sur les tables de bridge de la plaine Monceau ou sur les genoux des mondaines des avenues balayées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1303d15e-3019-49a0-8b6f-4c4d9655fa39",
                        "source_entry_id": "42dc0a47-0151-382b-8ad5-7f28b6a78f59",
                        "target_lang_word": "disgorge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgorge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                                        "entry_id": "a020f5d5-362e-3295-a021-183c3dc8273b",
                                        "glosses": [
                                            "To vomit or spew, to discharge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "170aa9fd-607a-45a4-b1b4-1d36cee3c87a",
                                                "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                                                "text": "1598-1600, Richard Hakluyt, The Principal Navigations, Voiages, Traffiques and Discoueries of the English Nation\nThis mountain when it rageth […] casteth forth huge stones, disgorgeth brimstone."
                                            },
                                            {
                                                "example_id": "5894a252-7f16-4dda-a28e-211989cd7d66",
                                                "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                                                "text": "They loudly laughed / To see his heaving breast disgorge the briny draught."
                                            },
                                            {
                                                "example_id": "1cf9c95a-a93f-4fb7-bd88-b619abd6151b",
                                                "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                                                "text": "GCN's local reporter needs help keeping up w/ the masses of information disgorged by our busy world."
                                            },
                                            {
                                                "example_id": "464deef3-7db6-4fa3-8cf3-d2c305f62c87",
                                                "sense_id": "1536a5ed-c3df-39a2-a3bc-bdf59cb5f8a7",
                                                "text": "The set disgorges most of its passengers at Waverley [Edinburgh], so finding a table seat in the front car isn't a problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd0943d2-2466-31b1-8a39-a6baeef7d375",
                                        "entry_id": "a020f5d5-362e-3295-a021-183c3dc8273b",
                                        "glosses": [
                                            "To surrender (stolen goods or money, for example) unwillingly."
                                        ],
