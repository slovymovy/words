                        "sense_id": "374228f4-5703-3a2b-bb67-d9c9af8ed7a1",
                        "entry_id": "786060fa-c35a-316d-9b48-972e83150587",
                        "glosses": [
                            "verfügbare Menge von Speisen für eine Person bei einer Mahlzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b6c3774-e773-4526-9a54-f3aded8e8d0e",
                                "sense_id": "374228f4-5703-3a2b-bb67-d9c9af8ed7a1",
                                "text": "„Die Essensrationen entsprachen diesem theoretischen Maximum, nicht der tatsächlichen Anzahl von Gefangenen.“"
                            },
                            {
                                "example_id": "2b3380dc-b1c5-4dc4-a1d2-3a11c0f97b23",
                                "sense_id": "374228f4-5703-3a2b-bb67-d9c9af8ed7a1",
                                "text": "„Juden bekommen nur die halbe Essensration, melden sie sich krank, bekommen sie gar nichts – wer nicht arbeitet, muss auch nicht essen, heißt es dann.“"
                            }
                        ],
