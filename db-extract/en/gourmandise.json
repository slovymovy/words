                    {
                        "form_id": "a1eec029-9190-4825-a13b-7bb867b36619",
                        "entry_id": "ddfde036-3147-316c-ad46-6a4c118d31a6",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "gourmandised"
                    },
                    {
                        "form_id": "1f0924d6-0730-418b-88a9-c4b1dcc353eb",
                        "entry_id": "ddfde036-3147-316c-ad46-6a4c118d31a6",
                        "tags": [
                            "past"
                        ],
                        "form": "gourmandised"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                        "entry_id": "ddfde036-3147-316c-ad46-6a4c118d31a6",
                        "glosses": [
                            "To eat food in a gluttonous manner; to gorge; to make a pig of oneself."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d4ea38e-8e1f-4f09-b7f3-9e699438e26b",
                                "sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                                "text": "I have long dream'd of such a kind of man, / So surfeit-swell'd, so old and so profane; / But, being awaked, I do despise my dream. / Make less thy body hence, and more thy grace; / Leave gormandizing; know the grave doth gape / For thee thrice wider than for other men."
                            },
                            {
                                "example_id": "35f65b2d-f89d-43bd-b4af-1205e3adf7f9",
                                "sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                                "text": "A benevolent old Surgeon sat once in our company, with a Patient fallen sick by gourmandising, whom he had just, too briefly in the Patient’s judgment, been examining."
                            },
                            {
                                "example_id": "946319fa-1b99-40e7-b548-d0e692eae8c0",
                                "sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                                "text": "Even as the envoys from Europe, Japan, Latin America and the United States gourmandised their way through the eight savoury courses served on silver plates and the two dessert courses brought in on plates of solid gold, their ears were bombarded by the multiple counterpoint and polyphony of sixteen bands in Mexico City's main square or Zócalo below."
                            },
                            {
                                "example_id": "d777514e-d464-4103-878b-21269668425f",
                                "sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                                "text": "[…] but there was no cream, no butter, no foie gras, no soufflés, no beef fillet steaks, no rich sauces or runny cheeses such as I had been gourmandising on for a whole week – not to mention the many bottles of champagne, wine and brandy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7081fa9e-d8e3-4daf-bb6e-67551bc8dca2",
                        "source_entry_id": "ddfde036-3147-316c-ad46-6a4c118d31a6",
                        "source_sense_id": "0bfcd411-4735-3d71-8fdd-67a94c0a9b65",
                        "source_sense_description": "to eat food in a gluttonous manner",
                        "target_lang_word": "se goinfrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se goinfrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                        "entry_id": "97ceddaa-4967-3157-8659-e0860eb6d106",
                                        "glosses": [
                                            "Manger avec excès ; manger comme un goinfre"
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009fcf20-cfd8-481e-9260-6c7a28cada5f",
                                                "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                                "text": "Quand tu t'es goinfré au Burger King de Versailles."
                                            },
                                            {
                                                "example_id": "2c26f9cd-fc74-483c-9927-7a435713036a",
                                                "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                                "text": "Ils préfèrent se saouler à la bière à 6 dollars, se goinfrer de burritos et parader avec tatouages et piercings en attendant Soundgarden et Metallica."
                                            },
                                            {
                                                "example_id": "e7d28807-81f7-49ea-821e-0e759231ae04",
                                                "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                                "text": "Nous nous interrompîmes pour le déjeuner auquel j’avais également invité son épouse, je me souviens qu’ils se goinfrèrent de canard et de crème fouettée, tandis que William, dont le père avait été gazé à Auschwitz, m’assassinait de son noir regard."
                                            },
                                            {
                                                "example_id": "b243cd68-30fc-438e-8474-d979e9d8c5fb",
                                                "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                                "text": "On continua à se goinfrer — c'était l'heure des petits fours —, à s’arsouiller bourgeoisement et à pétuner comme si de rien n'était."
                                            },
                                            {
                                                "example_id": "43874173-300d-4dfd-ad12-9b46a76b52a9",
                                                "sense_id": "c90f6057-6d18-360a-a285-ba1b8949f7c0",
                                                "text": "Mon père fut rattrapé par toutes ces années passées à se goinfrer de délicieuses pâtisseries grecques, et subit deux crises cardiaques en l’espace de quelques semaines. La seconde lui fut fatale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46052734-9077-3a5b-8046-f350082a7b1b",
                                        "entry_id": "97ceddaa-4967-3157-8659-e0860eb6d106",
                                        "glosses": [
                                            "Consommer avec excès"
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de54ba0-a166-4dbd-804b-f954b1183f2b",
                                                "sense_id": "46052734-9077-3a5b-8046-f350082a7b1b",
                                                "text": "Soit, mais que faire quand un jeune perd la notion du temps à force de se goinfrer de MMORPG, nom barbare qui désigne les jeux de rôle en ligne auxquels on prend part avec un maximum de compagnons virtuels ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10998ead-8100-38f2-aa67-328d59fdfcfb",
                                        "entry_id": "97ceddaa-4967-3157-8659-e0860eb6d106",
                                        "glosses": [
                                            "S'en mettre plein les poches ; soutirer un maximum d'argent ; griveler."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd2b7f96-a0c0-42ac-bbc3-3ff533242cf9",
                                                "sense_id": "10998ead-8100-38f2-aa67-328d59fdfcfb",
                                                "text": "J'ai pas l'intention de me goinfrer de la part de Riton."
                                            },
                                            {
                                                "example_id": "3b529bfc-85f8-4e3a-8bb5-ed1a6794faa5",
                                                "sense_id": "10998ead-8100-38f2-aa67-328d59fdfcfb",
                                                "text": "On arque vers l'entrée de cette citadelle conçue par Walt Disney et interprétée par des architectes bien décidés à se goinfrer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
