                ],
                "senses": [
                    {
                        "sense_id": "00f8f094-5e85-3fad-bdad-f76ba099352c",
                        "entry_id": "70cbbff3-b2cb-3251-9b6e-f89ac356e924",
                        "glosses": [
                            "гастрон. кондитерское изделие из слоёного теста в форме рогалика"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbb677e1-aaf0-40a7-a7e2-393c81156a93",
                                "sense_id": "00f8f094-5e85-3fad-bdad-f76ba099352c",
                                "text": "На столе стоял стакан сока и лежал завёрнутый круассан."
                            },
                            {
                                "example_id": "d850afc7-844c-4efb-ac64-a807c59bf513",
                                "sense_id": "00f8f094-5e85-3fad-bdad-f76ba099352c",
                                "text": "И опять они оживлённо и быстро говорили по-французски, и Лёня отрывисто бросал фразы через плечо или задавал ненужные вопросы: с какой начинкой ему взять круассан?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6353754d-1196-493f-ac6c-5ddf8e7e5937",
                        "source_entry_id": "70cbbff3-b2cb-3251-9b6e-f89ac356e924",
                        "source_sense_id": "00f8f094-5e85-3fad-bdad-f76ba099352c",
                        "target_lang_word": "croissant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
