                        "glosses": [
                            "A man who manufactures or uses glue."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "22fc3a15-a4eb-42e1-8888-cd15b2f77743",
                                "sense_id": "51d259a0-9bad-3438-855e-50c826f58b0d",
                                "text": "[H]e had despatched a brief note to Miss Darby by the omnipresent youngster Glue, — runner of errands, and mender of broken furniture by aid of effective glue-pot […] Miss Darby was just about starting off by herself when the young glueman arrived with Tom's note."
                            },
                            {
                                "example_id": "31e117dd-11fb-4df8-aea3-39760328e01b",
                                "sense_id": "51d259a0-9bad-3438-855e-50c826f58b0d",
                                "text": "Your pruned cheeks twitched / When we counted the coins / Using your still fingers to separate / The shiny from the copper / Which the glueman paid for the horse."
                            },
                            {
                                "example_id": "bb383017-259c-43f8-bb87-06f87fb8b454",
                                "sense_id": "51d259a0-9bad-3438-855e-50c826f58b0d",
                                "text": "They find the village of Chillingbourne being terrorised by the 'glueman', a nocturnal figure who pours glue into the hair of girls consorting with servicemen."
                            }
                        ]
                    }
