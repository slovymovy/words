                        ],
                        "form": "die Garnison"
                    },
                    {
                        "form_id": "d72eb693-3837-4f95-a3e8-9b52aa946e83",
                        "entry_id": "df6178e7-0986-3237-9b9c-f212bf2af132",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Garnisonen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                        "entry_id": "df6178e7-0986-3237-9b9c-f212bf2af132",
                        "glosses": [
                            "Ort, an dem militärische Truppen stationiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb110b78-409c-4b6b-900d-f3ba341ca8e6",
                                "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                                "text": "Während des Krieges musste sich zeigen, ob die Garnison den Angriffen des Gegners standhält."
                            },
                            {
                                "example_id": "e350887e-fc23-4a71-827c-9470b89ab666",
                                "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                                "text": "„Am 18. Juni fand die Siegesparade in Berlin statt und tags darauf fuhr das Regiment zurück in seine Garnison Koblenz, wo es feierlich empfangen wurde.“"
                            },
                            {
                                "example_id": "0b15f776-1e7d-4b91-b199-96196da1612c",
                                "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                                "text": "„Mich wunderte, dass er so leutselig war; in der Garnison war er stets unnahbar gewesen.“"
                            },
                            {
                                "example_id": "1fbebd3a-c720-4970-a66e-dd109f62a493",
                                "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                                "text": "„Das Militär der Garnison war an diesem Nachmittag erstaunlich wenig präsent; die meisten Soldaten hielten sich in ihren Kasernen auf und warteten, was kommen würde.“"
                            },
                            {
                                "example_id": "cbca9e52-0319-480a-8be8-55c1d24b1ae5",
                                "sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                                "text": "„Er schneidet ihre Garnisonen in den Küstenstädten vom überlebenswichtigen Nachschub mit Nahrungsmitteln ab, gewinnt durch erfolgreiche Attacken die Gefolgschaft weiterer Stämme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f86fb4f2-1377-3607-bb2d-4434f6e1a863",
                        "entry_id": "df6178e7-0986-3237-9b9c-f212bf2af132",
                        "glosses": [
                            "Gesamtheit der in [1] stationierten Truppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354bf325-bcf3-4715-ab56-d0bf09737bbf",
                                "sense_id": "f86fb4f2-1377-3607-bb2d-4434f6e1a863",
                                "text": "Die Garnison rüstete für die Schlacht."
                            },
                            {
                                "example_id": "6b746657-157d-4ce6-a53c-0f3434b0d13d",
                                "sense_id": "f86fb4f2-1377-3607-bb2d-4434f6e1a863",
                                "text": "„Die Festung, in der die Republik für gewöhnlich nur eine Garnison von hundert invaliden Slawoniern hielt, hatte damals eine Besatzung von zweitausend Albanesen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21747b94-d3c2-456a-b1ab-8e90cf5dccf3",
                        "source_entry_id": "df6178e7-0986-3237-9b9c-f212bf2af132",
                        "source_sense_id": "16379954-8e13-3409-9a62-35d8a9e591f1",
                        "source_sense_description": "Ort, an dem militärische Truppen stationiert sind",
                        "target_lang_word": "garrison",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garrison",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "757e5595-b555-354d-9323-ac25d398687f",
                                        "entry_id": "25740eea-b7ae-3df5-ba34-c04349e0b40e",
                                        "glosses": [
                                            "A permanent military post."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f433e36-2868-3f69-848d-310c33d99749",
                                        "entry_id": "25740eea-b7ae-3df5-ba34-c04349e0b40e",
                                        "glosses": [
                                            "The troops stationed at such a post."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f080d28-20cd-4e65-a6ce-9aa68b6ff340",
                                                "sense_id": "0f433e36-2868-3f69-848d-310c33d99749",
                                                "text": "My Lord the great Commander of the worlde, […]\nHath now in armes ten thouſand Ianiſaries, […]\nAnd for the expedition of this war,\nIf he thinke good, can from his garriſons,\nUUithdraw as many more to follow him."
                                            },
                                            {
                                                "example_id": "2e5efe36-7be4-4bcb-ab14-a79e058fc039",
                                                "sense_id": "0f433e36-2868-3f69-848d-310c33d99749",
                                                "text": "For a time, it was the only Royalist stronghold between London and Exeter, but it fell at last when a member of the garrison turned traitor and admitted the Parliamentary besiegers who destroyed it with gunpowder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5de51ae-9b63-3211-9e28-ba5432357424",
                                        "entry_id": "25740eea-b7ae-3df5-ba34-c04349e0b40e",
                                        "glosses": [
                                            "Occupants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c863a54d-ef8e-4a57-9b3d-5566a9bd5099",
                                                "sense_id": "b5de51ae-9b63-3211-9e28-ba5432357424",
                                                "text": "“I came down like a wolf on the fold, didn’t I ? Why didn’t I telephone ? Strategy, my dear boy, strategy. This is a surprise attack, and I’d no wish that the garrison, forewarned, should escape. …”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a474bd8c-9ccb-38b3-9d77-58d39226094b",
                                        "entry_id": "25740eea-b7ae-3df5-ba34-c04349e0b40e",
                                        "glosses": [
                                            "A military unit, nominally headed by a colonel, equivalent to a USAF support wing, or an army regiment."
                                        ],
                                        "tags": [
                                            "Space-Force",
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "garrison",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abcabf1d-c342-3657-ba53-3d1fee5c80c1",
                                        "entry_id": "d4d51ccd-1b4e-3dd1-a467-4f6f5e71523a",
                                        "glosses": [
                                            "To assign troops to a military post."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dbe9fc3-0cf8-4aa6-849b-0b0842218988",
                                                "sense_id": "abcabf1d-c342-3657-ba53-3d1fee5c80c1",
                                                "text": "Nor was he content with thus strongly garrisoning the fort, but he likewise added exceedingly to its strength by furnishing it with a formidable battery of quaker guns—rearing a stupendous flag-staff in the centre which overtopped the whole city—and moreover by building a great windmill on one of the bastions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44aeaf6d-571a-3562-8942-23d748c8bc6f",
                                        "entry_id": "d4d51ccd-1b4e-3dd1-a467-4f6f5e71523a",
                                        "glosses": [
                                            "To convert into a military fort."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8a80898-a6c5-355f-a2bd-82e48b54195f",
                                        "entry_id": "d4d51ccd-1b4e-3dd1-a467-4f6f5e71523a",
                                        "glosses": [
                                            "To occupy with troops."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa073738-bc4f-4c17-aa4d-a78b64224d63",
                                                "sense_id": "a8a80898-a6c5-355f-a2bd-82e48b54195f",
                                                "text": "'Establishing a land bridge through Mariupol to Crimea would take tens of thousands of troops. So would garrisoning eastern Ukraine.', http://www.economist.com/news/briefing/21615605-now-willing-use-russian-troops-more-or-less-openly-eastern-ukraine-vladimir-putin-has"
                                            }
