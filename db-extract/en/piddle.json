                ],
                "senses": [
                    {
                        "sense_id": "39c60e22-4f32-3bf2-8bcd-a61886b3867d",
                        "entry_id": "509774f8-2642-35ef-aeca-91c7398e743c",
                        "glosses": [
                            "Often followed by about or around: to act or work ineffectually and wastefully."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bd3e1bd5-e154-410a-8a7e-e76b3c23195c",
                                "sense_id": "39c60e22-4f32-3bf2-8bcd-a61886b3867d",
                                "text": "[…] neuer ceaſinge piddeling about theyr bowe and ſhaftes, when they be well, […]"
                            },
                            {
                                "example_id": "bd08e35c-058f-4816-aef7-c9546b77e143",
                                "sense_id": "39c60e22-4f32-3bf2-8bcd-a61886b3867d",
                                "text": "I watch Dag and Claire piddle about the desert[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4018e41-f4fc-3f73-9252-b42e8742190b",
                        "entry_id": "509774f8-2642-35ef-aeca-91c7398e743c",
                        "glosses": [
                            "Synonym of peck: to attack or eat with a beak."
                        ],
                        "tags": [
                            "intransitive",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2b1aa2e1-2b2f-4a0e-992c-056bdc4f7410",
                                "sense_id": "a4018e41-f4fc-3f73-9252-b42e8742190b",
                                "text": "As [Mahomet] was preaching... there commeth a doue flying towards him, & alighteth vpon his shoulder, and pidleth in his eare, looking for meate, hauing vsed her before to feede in his eare for the same purpose."
                            }
                        ]
                    },
                    {
                        "sense_id": "2748ad82-3fd1-39be-81ff-018496ffa2f4",
                        "entry_id": "509774f8-2642-35ef-aeca-91c7398e743c",
                        "glosses": [
                            "Synonym of nibble: to pick at or toy with one's food, to eat slowly or insubstantially."
                        ],
                        "tags": [
                            "Southern-US",
                            "intransitive",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "45c050cb-6d02-4e41-8601-2b106d00314f",
                                "sense_id": "2748ad82-3fd1-39be-81ff-018496ffa2f4",
                                "text": "Diseases... that make them eate nothing at all, or else they doe but piddle and trifle."
                            },
                            {
                                "example_id": "1bdaf6b3-3e31-4320-9d3d-94210cdf4813",
                                "sense_id": "2748ad82-3fd1-39be-81ff-018496ffa2f4",
                                "text": "As about seven seniors quietly eat meat patties, mashed potatoes and canned peaches, Newberry piddles with the food."
                            }
                        ]
                    },
                    {
                        "sense_id": "63ca2a89-5f63-37a6-abc2-86364d063dc7",
                        "entry_id": "509774f8-2642-35ef-aeca-91c7398e743c",
                        "glosses": [
                            "To urinate."
                        ],
                        "tags": [
                            "Australia",
                            "Namibia",
                            "South-Africa",
                            "UK",
                            "euphemistic",
                            "intransitive",
                            "reflexive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "46f3fffe-3456-4123-b02f-41a57df58cfc",
                                "sense_id": "63ca2a89-5f63-37a6-abc2-86364d063dc7",
                                "text": "Ha, ha, ha, Paddy shit in his breaches, ha, ha, ha, I shall laugh till I piddle myself."
                            }
                        ]
                    }
                ],
