                                "sense_id": "53a8c91e-782a-3a7e-afd5-2ac738c8cee3",
                                "text": "Ein Blankett ist ein weißes Ragout (fr.: blanc = weiß) aus hellem Fleisch, meist Kalb, Huhn oder Kaninchen."
                            }
                        ],
                        "sense_index_json": "\"2\""
