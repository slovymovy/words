                ],
                "senses": [
                    {
                        "sense_id": "5ce16556-5c11-3533-9c93-c62599de4e6c",
                        "entry_id": "e2a5a3c2-eda4-35f0-8862-5add7849dd18",
                        "glosses": [
                            "Hohlraum (zum Beispiel unter einem Blatt) zur Aufnahme von Luft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d72aa1e9-8862-4c57-98ea-2f1e57b83078",
                                "sense_id": "5ce16556-5c11-3533-9c93-c62599de4e6c",
                                "text": "„Die Atemhöhlen unter den Spaltöffnungen sind von neun Zellen umgeben.“"
                            },
                            {
                                "example_id": "0fe9364f-c0f3-4fca-9421-2789f7f2f4f6",
                                "sense_id": "5ce16556-5c11-3533-9c93-c62599de4e6c",
                                "text": "„Die Spaltöffnungen können in einigen Fällen mehr oder weniger tief eingesenkt sein, so daß eine äußere Atemhöhle entsteht (Abb. 152, 153, 154).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "45abce11-f5ad-31fb-b588-93b00438641d",
                        "entry_id": "e2a5a3c2-eda4-35f0-8862-5add7849dd18",
                        "glosses": [
                            "Hohlraum (am vorderen Teil von zum Beispiel Schnecke oder Krebs) zur Aufnahme von Sauerstoff aus Luft/Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202cd12e-9742-46c3-aafb-8ebe561915a9",
                                "sense_id": "45abce11-f5ad-31fb-b588-93b00438641d",
                                "text": "„Die Meeresschnecken mussten in Reusen lebend gefangen werden, dann wurde der kleine Drüsenkörper aus der Atemhöhle entfernt.“"
                            },
                            {
                                "example_id": "bc1d76e5-b8b8-49b9-8b64-a468b71fbbf5",
                                "sense_id": "45abce11-f5ad-31fb-b588-93b00438641d",
                                "text": "„Ein Epipodit an der Coxa des Maxillipeden liegt in der Atemhöhle und erzeugt den Atemwasserstrom.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                        "entry_id": "e2a5a3c2-eda4-35f0-8862-5add7849dd18",
                        "glosses": [
                            "Hohlraum, der nach Verschüttung durch eine Lawine zum Atmen bleibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b9737f-fb75-4eda-84f7-b3b8855e06e0",
                                "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                                "text": "„Ohne Atemhöhle besteht 35 Minuten nach dem Lawinenabgang keine Chance mehr.“"
                            },
                            {
                                "example_id": "793c4308-c151-4b33-9e33-c8476c244d07",
                                "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                                "text": "„Wie lange jemand überleben kann, hängt von der Größe der Atemhöhle, der Schneedichte und individuellen Faktoren ab […].“"
                            },
                            {
                                "example_id": "3bbededb-a15f-49a0-80a2-b44586dc88ce",
                                "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                                "text": "„[Rudi] Nadalet: [Der Verschüttete] sollte darauf achten, sich eine Atemhöhle zu schaffen, indem er sein Gesicht mit den Händen abschirmt.“"
                            },
                            {
                                "example_id": "c0d67a05-c96b-4a3d-b4f6-23067ade368a",
                                "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                                "text": "„Am wichtigsten ist es, die Hände vor das Gesicht zu halten, um einen Hohlraum für eine Atemhöhle zu schaffen.“"
                            },
                            {
                                "example_id": "0def6e17-dd85-4dfd-b487-a37e776718c2",
                                "sense_id": "f90bb081-7b58-3ff9-8d85-4761a0202bdf",
                                "text": "„Sobald man das Gefühl hat, dass die Bewegung der Schneemassen langsamer wird und man keine Sicht mehr nach »oben« hat, sollte man versuchen, sich mit den Händen eine Atemhöhle vor dem Gesicht zu schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
