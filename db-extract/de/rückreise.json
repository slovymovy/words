                    {
                        "form_id": "29037fa3-6c4f-482d-864e-d36eab555555",
                        "entry_id": "1ba472a3-74e2-38f7-a277-f88194e9dd24",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rückreisen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b580ef6-8bc5-3cfa-bb1e-f9bd8b6a30ea",
                        "entry_id": "1ba472a3-74e2-38f7-a277-f88194e9dd24",
                        "glosses": [
                            "Reise, die zurück zu dem Ort führt, von dem aus jemand aufgebrochen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0823750-9415-48c0-8c6e-bc75c42edcc5",
                                "sense_id": "4b580ef6-8bc5-3cfa-bb1e-f9bd8b6a30ea",
                                "text": "„Dessen Sehnsucht hält sich zwar in Grenzen, aber es bleibt ihm am Ende nichts anderes übrig, als sich langsam auf die Rückreise zu machen.“"
                            },
                            {
                                "example_id": "f98129f8-9ee0-4ded-a6e9-9505961a8f52",
                                "sense_id": "4b580ef6-8bc5-3cfa-bb1e-f9bd8b6a30ea",
                                "text": "„Doch zuvor will ich Ihnen von unserer Rückreise aus London erzählen.“"
                            },
                            {
                                "example_id": "b0a4851f-6540-4b50-a483-087bf8c5d961",
                                "sense_id": "4b580ef6-8bc5-3cfa-bb1e-f9bd8b6a30ea",
                                "text": "„Wir machen uns auf die langwierige Rückreise nach Litauen.“"
                            },
                            {
                                "example_id": "644ef7be-ac8f-4e89-a657-209c3794a1bf",
                                "sense_id": "4b580ef6-8bc5-3cfa-bb1e-f9bd8b6a30ea",
                                "text": "„Freiligrath also hatte während seiner Rückreise aus Köln bemerkt, dass der Rolandsbogen zusammengebrochen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78fa46d5-2abb-4786-bec7-19e0e6ddef4d",
                        "source_entry_id": "1ba472a3-74e2-38f7-a277-f88194e9dd24",
