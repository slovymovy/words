    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50a0a374-fd0c-398d-931d-f6a0bcac98ac",
                    "sense_definition": "Caractère ou disposition d'une personne portée à faire le mal ou à nuire à autrui.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a agi sans aucune raison valable, uniquement par pure <w>méchanceté</w>."
                        },
                        {
                            "text": "La <w>méchanceté</w> de ce personnage dans l'histoire choque profondément le lecteur."
                        }
                    ],
                    "synonyms": [
                        "mauvaiseté"
                    ],
                    "antonyms": [
                        "bonté",
                        "gentillesse",
                        "bienveillance"
                    ],
                    "common_phrases": [
                        "par pure méchanceté",
                        "faire preuve de méchanceté"
                    ]
                },
                {
                    "sense_id": "f36ec81b-0cc8-343e-bc05-7f2483eb4733",
                    "sense_definition": "Action malveillante commise dans le but de blesser, d'offenser ou de causer du tort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "acte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant toute son enfance, il aimait faire des <w>méchancetés</w> à son camarade."
                        },
                        {
                            "text": "Elle a fini par pardonner, mais elle n'oubliera jamais une telle <w>méchanceté</w>."
                        }
                    ],
                    "synonyms": [
                        "méchanterie"
                    ],
                    "antonyms": [
                        "gentillesse"
                    ],
                    "common_phrases": [
                        "faire des méchancetés"
                    ]
                },
                {
                    "sense_id": "87054eda-3de5-3dab-b3dd-443cb5642c59",
                    "sense_definition": "Parole désobligeante, blessante ou médisante dite dans l'intention de nuire ou de peiner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne peut pas s'empêcher de dire des <w>méchancetés</w> dès qu'il est contrarié."
                        },
                        {
                            "text": "Cette remarque n'était pas une maladresse, mais une véritable <w>méchanceté</w> intentionnelle."
                        }
                    ],
                    "synonyms": [
                        "méchanterie"
                    ],
                    "antonyms": [
                        "compliment"
                    ],
                    "common_phrases": [
                        "dire des méchancetés"
                    ]
                },
                {
                    "sense_id": "c6992866-0e23-3b95-9f65-8501210146cd",
                    "sense_definition": "Entêtement opiniâtre ou désobéissance rebelle chez un enfant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La gouvernante ne parvenait plus à supporter la <w>méchanceté</w> de ce jeune garçon têtu."
                        },
                        {
                            "text": "Dans ce vieux roman, la <w>méchanceté</w> de l'héritier indiscipliné désespérait ses parents."
