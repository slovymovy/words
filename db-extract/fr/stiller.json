                "senses": [
                    {
                        "sense_id": "bd162f50-56e3-305b-8d0e-b382080a6874",
                        "entry_id": "4b944646-2c7c-3a85-abe6-96512f0c8d44",
                        "glosses": [
                            "Tomber goutte à goutte."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "12259092-236a-466d-a90d-4cdff42d2d04",
                                "sense_id": "bd162f50-56e3-305b-8d0e-b382080a6874",
                                "text": "Votre sang si pur, notre otage,\nCoule mystiquement comme il coula littéral\nAu Golgotha, comme il stilla, non pas plus réel,\nMais littéral aussi, ce jour, dont le rituel\nRetient l'anniversaire cruel et lilial."
                            },
                            {
                                "example_id": "523ef031-d733-473f-bfc9-3bf739206f49",
                                "sense_id": "bd162f50-56e3-305b-8d0e-b382080a6874",
                                "text": "Elle stillait doucement de sous la glace : un quartz poli, qu’elle avait creusé en calice, la recueillait."
                            }
                        ]
                    },
                    {
                        "sense_id": "06b5da75-b9eb-3a8e-99b0-7f4ff81f5c9d",
                        "entry_id": "4b944646-2c7c-3a85-abe6-96512f0c8d44",
                        "glosses": [
                            "Faire tomber goutte à goutte. [Sur le même modèle que distiller lui aussi transitif.]"
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": []
                    }
