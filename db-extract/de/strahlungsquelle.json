                "senses": [
                    {
                        "sense_id": "f2709048-91b6-3bb0-a83b-bba4510523f3",
                        "entry_id": "8a80d8fc-1f14-3aba-931c-174783948c07",
                        "glosses": [
                            "etwas, das Strahlung aussendet/emittiert; von dem Strahlung ausgeht"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "37f543f9-61bb-4fb1-bf50-1128e4854fd2",
                                "sense_id": "f2709048-91b6-3bb0-a83b-bba4510523f3",
                                "text": "„Bei den Scans werden zuckerähnliche Moleküle mit Radionukliden versetzt, die als ungefährliche Strahlungsquelle genau im Körper verortbar sind. “"
                            },
                            {
                                "example_id": "61e4c554-b6f0-4a37-9632-938ee58bc592",
                                "sense_id": "f2709048-91b6-3bb0-a83b-bba4510523f3",
                                "text": "„Wie Brandereignise in Tunnels zeigen (Tauerntunnel) breitet sich ein Feuerereignis von Fahrzeug zu Fahrzeug in erster Linie durch Strahlungshitze aus, die Intensität von Wärmestrahlng nimmt mit dem Quadrat der Entfernung der Strahlungsquelle ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
