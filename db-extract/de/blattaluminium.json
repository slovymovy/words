                        "examples": [
                            {
                                "example_id": "af3bf1e0-ebdc-40a1-b512-3b146e485201",
                                "sense_id": "e0e051c7-b1f6-372a-be60-a4c8d2427d22",
                                "text": "„Blattaluminium ist gegen atmosphärische Einflüsse beständig.“"
                            },
                            {
                                "example_id": "4e6241e4-650b-47af-88fd-8a5c815ad5ec",
                                "sense_id": "e0e051c7-b1f6-372a-be60-a4c8d2427d22",
                                "text": "„Lieferbar ist das Blattaluminium in matter und hochglänzender Oberflächenbeschaffenheit und behält auch diesen Glanz wie seine silberweiße Farbe bei trockener Luft unverändert bei.“"
                            },
                            {
                                "example_id": "49e3dcee-65a0-47f8-b188-b400aad87149",
                                "sense_id": "e0e051c7-b1f6-372a-be60-a4c8d2427d22",
                                "text": "„Der bei der Herstellung von Blattaluminium sich ergebende Abfall wird zur Erzeugung von Aluminiumpulver benutzt, welches als Ersatz des Magnesiumpulvers (siehe S. 68) zur Herstellung von Blitzlichtmischungen dient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
