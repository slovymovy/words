                            {
                                "example_id": "7cdc44eb-0496-4e8f-83da-990b89d3a866",
                                "sense_id": "ff455e28-aaeb-391e-8d0f-a1d8db7f82a6",
                                "text": "Wat het gemeentelijk afvalbeheer betreft, is Molema tevreden met de ontvangst van de nieuwe verpakkingencontainer door de inwoners van Oldenzaal. In totaal zijn ongeveer 11.000 containers uitgezet. Op circa zeshonderd adressen is de bak geweigerd. De acceptatiegraad bedraagt daarmee 95 procent."
                            },
                            {
                                "example_id": "de271e59-bd40-4278-8a02-fbd67c6a167f",
                                "sense_id": "ff455e28-aaeb-391e-8d0f-a1d8db7f82a6",
                                "text": "Op de vraag waarom deze maatregelen niet twee weken geleden al werden ingevoerd, bij het vorige overleg tussen Berlijn en de deelstaten, antwoordde de bondskanselier dat de ‘acceptatiegraad’ toen nog niet zo groot was. Vooral het door haar gewilde ‘overnachtingsverbod’ voor inwoners van Duitse risicogebieden stuitte toen op weerstand."
                            }
                        ]
