{
    "word_family": [
        "deflate",
        "deflation",
        "deflationary"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef36626b-f122-3162-a675-aab063daf435",
                    "sense_definition": "Empty of air or gas that was previously inside.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cyclist had to stop because of a <w>deflated</w> tire.",
                            "target_lang_translations": {
                                "nl": "De fietser moest stoppen vanwege een <w>leeggelopen</w> band."
                            }
                        },
                        {
                            "text": "She tried to play with the <w>deflated</w> ball but it would not bounce.",
                            "target_lang_translations": {
                                "nl": "Ze probeerde met de <w>slappe</w> bal te spelen, maar hij stuiterde niet."
                            }
                        }
                    ],
                    "synonyms": [
                        "flat"
                    ],
                    "antonyms": [
                        "inflated"
                    ],
                    "common_phrases": [
                        "deflated tire",
                        "deflated balloon"
                    ],
                    "target_lang_definitions": {
                        "nl": "Leeggelopen of zonder lucht of gas dat er voorheen in zat."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "leeggelopen",
                                "target_lang_sense_clarification": "voor objecten die lucht hebben verloren"
                            },
                            {
                                "target_lang_word": "plat",
                                "target_lang_sense_clarification": "vaak gebruikt voor banden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09b1c952-ebd1-37f0-9e0c-a328dd81ea33",
                    "sense_definition": "Feeling disappointed or depressed after being hopeful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt very <w>deflated</w> after his project was rejected by the boss.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich erg <w>ontmoedigd</w> nadat zijn project door de baas was afgewezen."
                            }
                        },
                        {
                            "text": "The team left the stadium feeling <w>deflated</w> after their unexpected loss.",
                            "target_lang_translations": {
                                "nl": "Het team verliet het stadion met een <w>verslagen</w> gevoel na hun onverwachte verlies."
                            }
                        }
                    ],
                    "synonyms": [
                        "disappointed",
                        "discouraged",
                        "dejected"
                    ],
                    "antonyms": [
                        "encouraged",
                        "elated"
                    ],
                    "common_phrases": [
                        "feeling deflated"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich teleurgesteld of ontmoedigd voelen na hoopvol te zijn geweest."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ontmoedigd",
                                "target_lang_sense_clarification": "gevoel van verlies van motivatie"
                            },
                            {
                                "target_lang_word": "teleurgesteld",
                                "target_lang_sense_clarification": "gevoel na een tegenvaller"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7253bbfa-3f37-3e75-bcc2-832506eaded0",
                    "sense_definition": "Reduced in size, value, or importance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company reported a <w>deflated</w> profit margin this quarter.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf rapporteerde dit kwartaal een <w>verminderde</w> winstmarge."
                            }
                        },
                        {
                            "text": "The critic gave a <w>deflated</w> assessment of the actor's performance.",
                            "target_lang_translations": {
                                "nl": "De criticus gaf een <w>minder lovende</w> beoordeling van de acteerprestatie."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduced",
                        "diminished"
                    ],
                    "antonyms": [
                        "inflated",
                        "increased"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verminderd in omvang, waarde of belang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verminderd",
                                "target_lang_sense_clarification": "algemene afname"
                            },
                            {
                                "target_lang_word": "gereduceerd",
                                "target_lang_sense_clarification": "formeel, vaak in economische context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27b08de9-8960-382b-acfb-6d52f67e791b",
                    "sense_definition": "Adjusted downward to account for the effects of inflation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "economic_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists often look at <w>deflated</w> income to understand real purchasing power.",
                            "target_lang_translations": {
                                "nl": "Economen kijken vaak naar het <w>voor inflatie gecorrigeerde</w> inkomen om de reële koopkracht te begrijpen."
                            }
                        },
                        {
                            "text": "The report provides a <w>deflated</w> value of production to show true growth.",
                            "target_lang_translations": {
                                "nl": "Het rapport geeft een <w>gecorrigeerde</w> productiewaarde om de werkelijke groei te tonen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflated value"
                    ],
                    "target_lang_definitions": {
                        "nl": "Naar beneden bijgesteld om rekening te houden met inflatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gecorrigeerd voor inflatie",
                                "target_lang_sense_clarification": "economische term voor reële waarde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62cd0db5-83db-3cff-8471-eb30fe5dc184",
                    "sense_definition": "Experiencing a general decline in prices or economic activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "economic_adjustment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors are cautious about putting money into a <w>deflated</w> economy.",
                            "target_lang_translations": {
                                "nl": "Investeerders zijn voorzichtig met het steken van geld in een <w>deflatoire</w> economie."
                            }
                        },
                        {
                            "text": "The country struggled to recover from a long and <w>deflated</w> market period.",
                            "target_lang_translations": {
                                "nl": "Het land had moeite om te herstellen van een lange periode van <w>economische krimp</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deflated economy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Lijdend aan een algemene daling van prijzen of economische activiteit."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "deflatoir",
                                "target_lang_sense_clarification": "betrekking hebbend op economische krimp"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f21fa0b-4b9d-37d6-a092-0771e576d9d3",
                    "sense_definition": "Subsided or flattened, often used in geological or archaeological contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers found artifacts on the <w>deflated</w> sandy surface.",
                            "target_lang_translations": {
                                "nl": "De onderzoekers vonden artefacten op het <w>afgeplatte</w> zandige oppervlak."
                            }
                        },
                        {
                            "text": "Wind erosion created a <w>deflated</w> area where the soil had been blown away.",
                            "target_lang_translations": {
                                "nl": "Winderosie creëerde een <w>verlaagd</w> gebied waar de grond was weggeblazen."
                            }
                        }
                    ],
                    "synonyms": [
                        "flattened"
                    ],
                    "common_phrases": [
                        "deflated surface"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verlaagd of platgedrukt, vaak gebruikt in geologische context."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgeplat",
                                "target_lang_sense_clarification": "fysiek oppervlak dat lager is geworden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d11f61dc-0a2d-30cc-947a-528590de09ce",
                    "sense_definition": "Past tense and past participle of <w>deflate</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>deflated</w> the tires before storing the bike for winter.",
                            "target_lang_translations": {
                                "nl": "Hij <w>liet de banden leeglopen</w> voordat hij de fiets voor de winter opborg."
                            }
                        },
                        {
                            "text": "The company <w>deflated</w> its expectations after the poor sales report.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf <w>stelde zijn verwachtingen naar beneden bij</w> na het slechte verkooprapport."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'deflate' (lucht laten ontsnappen of verminderen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "liet leeglopen",
                                "target_lang_sense_clarification": "fysieke handeling"
                            },
                            {
                                "target_lang_word": "verlaagde",
                                "target_lang_sense_clarification": "figuurlijke handeling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}