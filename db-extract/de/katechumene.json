                "senses": [
                    {
                        "sense_id": "a41aa4ff-a700-3706-9a90-499f11d226ee",
                        "entry_id": "cd1bc822-2564-3670-b25d-3ce89ad62dec",
                        "glosses": [
                            "der Taufbewerber; jemand, der sich auf die Taufe (und damit die Aufnahme in die Kirche) vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02b947d-6990-4adb-90e8-43ce2102f80f",
                                "sense_id": "a41aa4ff-a700-3706-9a90-499f11d226ee",
                                "text": "„Der Zweite war Serenus, welcher den Feuertod starb, es folgten Heraclides und Heron, welche enthauptet wurden; der Eine von ihnen war noch Katechumene, der Andere Neophyt.“"
                            },
                            {
                                "example_id": "70f07cb9-f235-4a82-8e09-06fd13696937",
                                "sense_id": "a41aa4ff-a700-3706-9a90-499f11d226ee",
                                "text": "„Wie immer sitzen ganz vorn die Konfirmanden und die Katechumenen, die das schwierige Amt haben, Sprüche aus den Weissagungen aufzusagen und dann die Lichter am Weihnachtsbaum zu entzünden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ecdaa9-f8d9-46f1-95fd-5529fdf6e3fe",
                        "source_entry_id": "cd1bc822-2564-3670-b25d-3ce89ad62dec",
                        "source_sense_id": "a41aa4ff-a700-3706-9a90-499f11d226ee",
                        "target_lang_word": "catechumen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catechumen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fd06af8-8ec8-3608-b2b3-8f4c8b0c59df",
                                        "entry_id": "bb15056c-300c-3070-8381-c4338381e8ed",
                                        "glosses": [
                                            "A convert to Christianity under instruction before baptism; a young or recent Christian preparing for confirmation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b9c4508-c980-48f8-8554-3a24e9569e80",
                                                "sense_id": "7fd06af8-8ec8-3608-b2b3-8f4c8b0c59df",
                                                "text": "Here in this room an old man had killed and boiled a catechumen, had committed sodomy with a rat, had discussed a rodent nunhood with V., a future saint – depending which story you listened to."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1b0709a-0fbf-4325-ad10-ae05642446f2",
                        "source_entry_id": "cd1bc822-2564-3670-b25d-3ce89ad62dec",
                        "source_sense_id": "a41aa4ff-a700-3706-9a90-499f11d226ee",
                        "target_lang_word": "catéchumène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catéchumène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                        "entry_id": "0eedff68-2472-3ef9-b87b-e22888d85551",
                                        "glosses": [
                                            "Celui, celle qu'on instruit pour le ou la préparer au baptême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e98ccb9-5ed4-413e-86de-16ec66f8abec",
                                                "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                                "text": "Les quarante-huit catéchumènes adultes qui recevront le baptême à Pâques, étaient à la messe de La Bassée."
                                            },
                                            {
                                                "example_id": "23580b41-5558-4e92-9421-6c05e46be6ba",
                                                "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                                "text": "Plus de deux-mille-trois-cents catéchumènes recevront le baptême lors de la veillée pascale, à la grande joie de l’évêque de Hong-Kong et de la communauté catholique chinoise."
                                            },
                                            {
                                                "example_id": "dde91b43-52f3-4bca-b975-d4ceaf913a2e",
                                                "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                                "text": "Vous savez les détails de cette cérémonie : la bénédiction, la communion sous les deux espèces, l’onction de la paume des mains avec l’huile des catéchumènes, et enfin le saint sacrifice offert de concert avec l’évêque."
                                            },
                                            {
                                                "example_id": "208aa3e7-dc49-43cb-a5cd-3bf44bed8660",
                                                "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                                "text": "Le ciel en soit loué, je vis en bonne entente\nAvec le Père Duval, la calotte chantante,\nLui, le catéchumène, et moi, l'énergumène,\nIl me laisse dire « merde », je lui laisse dire « amen »"
                                            },
                                            {
                                                "example_id": "a0b4a17a-635d-48ad-91e7-918fe580ae81",
                                                "sense_id": "46f09063-af94-3138-81e4-5f6d7314fd4f",
                                                "text": "Nous est livré le canevas du premier enseignement chrétien, mais sous une forme narrative qui séduit aussi bien l'incroyant que le catéchumène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c2397f-1a2d-3580-a05d-7e64b8cfbe47",
                                        "entry_id": "0eedff68-2472-3ef9-b87b-e22888d85551",
                                        "glosses": [
                                            "Celui qui se prépare à des fonctions."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6e58c5d-faed-403c-b8f3-7d455436dee5",
                                                "sense_id": "60c2397f-1a2d-3580-a05d-7e64b8cfbe47",
                                                "text": "Ce catéchumène du Veau d’or se couchait tous les soirs à dix heures et demie, et se levait à cinq heures du matin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
