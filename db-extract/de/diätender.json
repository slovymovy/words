                ],
                "senses": [
                    {
                        "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                        "entry_id": "99881a90-ad5c-3533-8078-18eec8167381",
                        "glosses": [
                            "Person, die sich einer Diät unterzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c808043-51b4-4309-9e19-efa2a42604e4",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„In der Tat schaffen es nur ca. 20 – 30% der Diätenden, einen Gewichtsverlust über mehrere Jahre zu halten.“"
                            },
                            {
                                "example_id": "3a438a58-a386-4f90-9267-5e8ea65e149c",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„Ohne es zu merken, greifen da viele Diätende dann doch hin und wieder zur Schokolade oder zu einer anderen kalorienreichen Nervennahrung, die dann das Kalorienkonto im Nu wieder nach oben schnellen lassen.“"
                            },
                            {
                                "example_id": "a5f6be8d-f706-4747-9732-fcb84acccb88",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„In der Praxis zeigt sich, dass dies vielen Diätenden mit einer Low Carb Diät einfacher als mit anderen Ansätzen möglich ist.“"
                            },
                            {
                                "example_id": "c43b32a1-bbf1-4731-8f16-9e5bfcf2d460",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„Diese Vorgehensweise empfiehlt sich auch für Diätende, denn wer ständig auf alle Leckereien verzichtet, wird alsbald mit Heißhunger-Attacken zu kämpfen haben.“"
                            },
                            {
                                "example_id": "31e3a655-1eb3-431b-9469-9e2690da2a4d",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„Crash-Diäten sind auf lange Sicht schwer durchzuhalten und führen zu einer Gewichtszunahme, sobald der Diätende zu seiner normalen Ernährung zurückkehrt.“"
                            },
                            {
                                "example_id": "fee063a3-7586-4b4b-81cc-a1dfd3944140",
                                "sense_id": "db3631f5-4e15-3d5c-a210-e75c56c0eb6e",
                                "text": "„Dies versorgt den Körper mit allen notwendigen Nährstoffen und ermöglicht es dem Diätenden, sein Zielgewicht auf sichere und nachhaltige Weise zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
