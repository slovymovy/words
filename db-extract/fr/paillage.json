                                                "sense_id": "d2466055-a150-3668-87d8-b54a0c7edc3c",
                                                "text": "This mulching mower can easily be converted to a bagging mower."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a162a2-2731-3c99-a69b-3f3ba05d6bd1",
                                        "entry_id": "4d0bee1e-4903-329f-8cec-ecdf1211d1a1",
                                        "glosses": [
                                            "Used as a mulch."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbdf55fa-c8af-488f-a91d-0adb46f529ea",
                                                "sense_id": "74a162a2-2731-3c99-a69b-3f3ba05d6bd1",
                                                "text": "Compost is generally the best mulching material for the home garden."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mulching",
                                "target_lang_code": "en",
