{
    "word_family": [
        "experience",
        "experiential",
        "inexperienced"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f14ba3d-b037-3561-840c-176499a96f50",
                    "sense_definition": "Having knowledge or skill in a particular field from having done it for a long time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "skilled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is looking for an <w>experienced</w> manager to lead the new international team.",
                            "target_lang_translations": {
                                "ru": "Компания ищет <w>опытного</w> менеджера, чтобы возглавить новую международную команду."
                            }
                        },
                        {
                            "text": "As a highly <w>experienced</w> traveler, she knew exactly how to handle the flight delay.",
                            "target_lang_translations": {
                                "ru": "Как очень <w>бывалый</w> путешественник, она точно знала, что делать при задержке рейса."
                            }
                        }
                    ],
                    "synonyms": [
                        "practiced",
                        "seasoned",
                        "versed",
                        "qualified",
                        "veteran",
                        "accomplished",
                        "adept"
                    ],
                    "antonyms": [
                        "inexperienced",
                        "green"
                    ],
                    "common_phrases": [
                        "highly experienced",
                        "experienced professional",
                        "experienced traveler"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий знаниями или навыками в определенной области благодаря долгой практике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "имеющий большой опыт в работе или деле"
                            },
                            {
                                "target_lang_word": "бывалый",
                                "target_lang_sense_clarification": "много видавший и испытавший"
                            },
                            {
                                "target_lang_word": "искушённый",
                                "target_lang_sense_clarification": "хорошо знающий что-либо на практике, тонкий знаток"
                            },
                            {
                                "target_lang_word": "квалифицированный",
                                "target_lang_sense_clarification": "имеющий специальную подготовку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "323cc3a3-cb26-33ea-b70e-11d724917d93",
                    "sense_definition": "Having personally felt, undergone, or lived through something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "undergone",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>experienced</w> trauma left a lasting impact on his perspective of safety.",
                            "target_lang_translations": {
                                "ru": "<w>Пережитая</w> травма оставила неизгладимый след на его восприятии безопасности."
                            }
                        },
                        {
                            "text": "She shared the <w>experienced</w> joy of reaching the mountain summit after hours of climbing.",
                            "target_lang_translations": {
                                "ru": "Она поделилась <w>испытанной</w> радостью от достижения вершины горы после многочасового восхождения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "experienced joy",
                        "experienced pain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лично прочувствованный, пережитый или пройденный на собственном опыте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пережитый",
                                "target_lang_sense_clarification": "испытанный на себе (о чувствах, событиях)"
                            },
                            {
                                "target_lang_word": "испытанный",
                                "target_lang_sense_clarification": "познанный на практике"
                            },
                            {
                                "target_lang_word": "прочувствованный",
                                "target_lang_sense_clarification": "глубоко осознанный через эмоции"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9bfdc6fa-a4eb-3245-a0d6-eb392eaea994",
                    "sense_definition": "Past tense and past participle of <w>experience</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>experienced</w> some technical difficulties during the live broadcast yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время прямого эфира мы <w>испытали</w> некоторые технические трудности."
                            }
                        },
                        {
                            "text": "He had never <w>experienced</w> such kindness from a complete stranger before.",
                            "target_lang_translations": {
                                "ru": "Он никогда раньше не <w>встречал</w> такой доброты от совершенно незнакомого человека."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени глагола «испытывать» или «переживать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испытал",
                                "target_lang_sense_clarification": "прочувствовал или столкнулся с чем-либо"
                            },
                            {
                                "target_lang_word": "пережил",
                                "target_lang_sense_clarification": "прошел через какое-либо событие"
                            },
                            {
                                "target_lang_word": "столкнулся",
                                "target_lang_sense_clarification": "встретился с трудностями или ситуацией"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}