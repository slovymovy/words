                "senses": [
                    {
                        "sense_id": "5379e12e-f063-3ebc-a968-2aa23279fe1b",
                        "entry_id": "5eea773b-3af9-3f38-89fe-5005ee1e013c",
                        "glosses": [
                            "heftige, temperamentvolle, ungestüme, nachdrückliche Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca2fbb98-a52e-4769-93ea-acb38bc86070",
                                "sense_id": "5379e12e-f063-3ebc-a968-2aa23279fe1b",
                                "text": "Sie bekräftigte mit Vehemenz ihre Worte."
                            },
                            {
                                "example_id": "1918069a-dc1f-4051-8164-7937f796a654",
                                "sense_id": "5379e12e-f063-3ebc-a968-2aa23279fe1b",
                                "text": "Die Vehemenz der Sturmböen nahm zu."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "792c0386-4326-42af-8d65-003c47fb8f4e",
                        "source_entry_id": "5eea773b-3af9-3f38-89fe-5005ee1e013c",
                        "source_sense_id": "5379e12e-f063-3ebc-a968-2aa23279fe1b",
                        "source_sense_description": "heftige, temperamentvolle, ungestüme, nachdrückliche Art",
                        "target_lang_word": "vehemence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vehemence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                                        "glosses": [
                                            "An intense concentration, force or power."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6932b843-3f3b-4c39-b6ef-214af34b5cc3",
                                                "sense_id": "8d082d86-b5b5-328d-846f-571dfc0cb925",
                                                "text": "The bear attacked with vengeance and vehemence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                                        "glosses": [
                                            "A wild or turbulent ferocity or fury."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e0bf65-b4ca-4e5a-af10-ffe47b0cb83b",
                                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                                "text": "His response was bursting with hatred and vehemence."
                                            },
                                            {
                                                "example_id": "56872890-7fb8-4781-8000-4dbcac724b39",
                                                "sense_id": "54d10621-de6a-3fc9-8f58-922bf2a42bcb",
                                                "text": "This worrisome tendency was on display in recent weeks as Israelis reacted with striking vehemence to remarks by UN secretary general, Ban Ki-moon, and US ambassador to Israel, Daniel Shapiro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                                        "entry_id": "1ec7578f-e7f0-34f1-90ac-b043178381ab",
                                        "glosses": [
                                            "Eagerness, fervor, excessive strong feeling."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b8764be-3dc6-4df4-87ab-1d8f4973d5c3",
                                                "sense_id": "3563a946-0d7f-37fb-8f97-d493755b3106",
                                                "text": "I could not wonder at the vehemence of her care, her very soul was tenderness […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0d6ffb1-bd68-48bb-ac9f-53425b8ff148",
                        "source_entry_id": "5eea773b-3af9-3f38-89fe-5005ee1e013c",
                        "source_sense_id": "5379e12e-f063-3ebc-a968-2aa23279fe1b",
                        "source_sense_description": "heftige, temperamentvolle, ungestüme, nachdrückliche Art",
                        "target_lang_word": "véhémence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "véhémence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "287a7e14-46c6-37c1-a789-56eb1f2dcc87",
                                        "entry_id": "0818c2dd-808c-38f3-8d5f-de6910df4e1f",
                                        "glosses": [
                                            "Impétuosité, mouvement violent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc949c44-d07a-4fdf-955c-d24c5e1a2432",
                                                "sense_id": "287a7e14-46c6-37c1-a789-56eb1f2dcc87",
                                                "text": "Mais elle réprimait toute cette fougue, et la contrainte qu’elle s’imposait augmentait la véhémence de sa joie."
                                            },
                                            {
                                                "example_id": "fe14cd93-ecb3-45d3-9377-5ff0df32cc4b",
                                                "sense_id": "287a7e14-46c6-37c1-a789-56eb1f2dcc87",
                                                "text": "Nous prenons deux otages, le vieux maire, […] et le jeune curé, qui proteste avec véhémence, bien que les soldats aient encore, épinglé à la capote, les Sacré-Cœur distribués à Paray-le-Monial."
                                            },
                                            {
                                                "example_id": "f254be49-a668-443e-a2e3-2f1469f11fc6",
                                                "sense_id": "287a7e14-46c6-37c1-a789-56eb1f2dcc87",
                                                "text": "La soudaine irruption d’un ennemi prêt à l’offensive n’eut d’autre effet immédiat sur New York que d’accroître sa véhémence habituelle."
                                            },
                                            {
                                                "example_id": "2de6ea79-f1cb-4289-99b1-e1d063d32534",
                                                "sense_id": "287a7e14-46c6-37c1-a789-56eb1f2dcc87",
                                                "text": "Lors de la réunion d'équipe d'aujourd'hui, Jonathan a fait preuve d'une véhémence remarquable en défendant sa position sur le projet, démontrant ainsi son engagement et sa passion pour le travail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e2fa48-11f2-3371-b470-c6bb3a9b4226",
                                        "entry_id": "0818c2dd-808c-38f3-8d5f-de6910df4e1f",
                                        "glosses": [
                                            "Éloquence vigoureuse, accompagnée d’une action vive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
