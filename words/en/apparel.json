                {
                    "sense_id": "ef92d43e-ef17-38d1-9457-cb4a8dc3d247",
                    "sense_definition": "The equipment, furniture, and rigging of a ship, such as sails and anchors.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm damaged much of the ship's <w>apparel</w> during the voyage.",
                            "target_lang_translations": {
                                "ru": "Шторм повредил большую часть корабельной <w>оснастки</w> во время плавания.",
                                "de": "Der Sturm beschädigte während der Reise einen Großteil der <w>Takelage</w> des Schiffes."
                            }
                        },
                        {
                            "text": "Merchants provided the necessary <w>apparel</w> to make the vessel seaworthy.",
                            "target_lang_translations": {
                                "ru": "Купцы предоставили необходимое <w>снаряжение</w>, чтобы сделать судно пригодным к плаванию.",
                                "de": "Kaufleute stellten die nötige <w>Schiffsausrüstung</w> bereit, um das Schiff seetüchtig zu machen."
                            }
