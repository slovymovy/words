                "senses": [
                    {
                        "sense_id": "59944fb5-93d5-3abc-b540-60bdf7f60131",
                        "entry_id": "2b5cc9d9-fee0-3039-9dce-c4523470ef14",
                        "glosses": [
                            "het plantenrijk in een bepaalde streek of periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae444451-f86f-496c-90b1-833afc3be757",
                                "sense_id": "59944fb5-93d5-3abc-b540-60bdf7f60131",
                                "text": "Madagascar heeft een ontzettend rijke flora, met vele soorten die enkel daar voorkomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b725f1bf-3f94-45f4-9fd5-e6710b42cd4d",
                        "source_entry_id": "2b5cc9d9-fee0-3039-9dce-c4523470ef14",
                        "source_sense_id": "59944fb5-93d5-3abc-b540-60bdf7f60131",
                        "source_sense_description": "plantenrijk in een bepaalde streek of periode",
                        "target_lang_word": "Flora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                        "entry_id": "d45384e2-98dd-373e-92a6-a1d61bbfff70",
                                        "glosses": [
                                            "die Gesamtheit aller Pflanzen eines definierten Gebietes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321b9495-cb91-445f-a645-a5269f4ba6bc",
                                                "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                                "text": "Die tropische Flora weist eine außerordentliche Formenfülle auf."
                                            },
                                            {
                                                "example_id": "a4bce446-5b6b-4ceb-85af-f13df4e39238",
                                                "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                                "text": "„Kennzeichnend für diese einzigartige Naturlandschaft sind die zahlreichen Bäche, Flüsse, Stauseen sowie die großflächigen Laubwälder mit ihrer seltenen Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "3c53d0ad-babe-4f7c-b651-ba8a2664f239",
                                                "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                                "text": "„Dabei stimmt das nicht, in Island ist nur alles viel kleiner als anderswo, auch die Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "2453a43e-9971-4548-be20-b6a594042b45",
                                                "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                                "text": "„Obwohl sie größtenteils von Gletschern bedeckt und die umgebenden Fahrwasser im gesamten Winterhalbjahr zugefroren sind, gibt es dort eine reichhaltige Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "2634c4d6-dc41-45d8-a9f3-f73fa2aa5aac",
                                                "sense_id": "550da2b2-4dad-3179-be88-938e95321e16",
                                                "text": "„Eine Pflanze von zentraler Bedeutung für die ägyptische Kultur ist der Papyrus, der während der pharaonischen Zeit zur natürlichen Flora der ägyptischen Sumpflandschaften gehört, heute allerdings wildwachsend nicht mehr vorkommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9ff632b2-b602-39cf-ab23-779b84505fce",
                                        "entry_id": "d45384e2-98dd-373e-92a6-a1d61bbfff70",
                                        "glosses": [
                                            "Werk, in dem alle Pflanzen, die in einem bestimmten Gebiet vorkommen, verzeichnet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73515b0e-285d-4c5c-bb2a-6cc9dbff7647",
                                                "sense_id": "9ff632b2-b602-39cf-ab23-779b84505fce",
                                                "text": "Johannes Thals „Sylva hercynia“ war eine der ersten veröffentlichten Floren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Flora",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bad24252-ba39-328d-b506-d5ee1f5e3dd9",
                                        "entry_id": "893a6bda-cd41-350a-bd9b-be7e56b5c36e",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15128534-fb19-4f9e-a1be-937dea5f0a6f",
                                                "sense_id": "bad24252-ba39-328d-b506-d5ee1f5e3dd9",
                                                "text": "Flora und Fabian sind echt ein tolles Pärchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d9b5ed8-617f-4157-978f-0fa22f336899",
                        "source_entry_id": "2b5cc9d9-fee0-3039-9dce-c4523470ef14",
                        "source_sense_id": "59944fb5-93d5-3abc-b540-60bdf7f60131",
                        "source_sense_description": "plantenrijk in een bepaalde streek of periode",
                        "target_lang_word": "flora",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flora",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "780de0f2-c663-3ad5-bcc7-a169748a108d",
                                        "entry_id": "6f82e6a9-ad64-359b-b228-af56ec8283ce",
                                        "glosses": [
                                            "Plants considered as a group, especially those of a particular country, region, time, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d5d023b-3393-4931-8940-cf097e054de5",
                                                "sense_id": "780de0f2-c663-3ad5-bcc7-a169748a108d",
                                                "text": "Thirdly, I continue to attempt to interdigitate the taxa in our flora with taxa of the remainder of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc1d85c0-09f9-3bdf-8f62-8154043e78bc",
                                        "entry_id": "6f82e6a9-ad64-359b-b228-af56ec8283ce",
                                        "glosses": [
                                            "A book describing the plants of a country, region, time, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7071d126-765d-4c70-a3d2-bcc1db6f0061",
                                                "sense_id": "bc1d85c0-09f9-3bdf-8f62-8154043e78bc",
                                                "text": "He intended to publish a flora of the island, and drafted out a synonymic catalogue, into which he inserted from time to time elaborate descriptions drawn up from living specimens of the species which he was able to procure."
                                            },
                                            {
                                                "example_id": "b86e0f10-0f22-4f84-9daf-b11a739f96b0",
                                                "sense_id": "bc1d85c0-09f9-3bdf-8f62-8154043e78bc",
                                                "text": "Nowhere was the victory of Linnaeanism more complete than in Britain. When William Hudson's Flora Anglica, organized in the Linnaean manner, appeared in 1762, it displaced all previous floras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "444e9df9-a615-3e1b-bc3d-36e23673a51d",
                                        "entry_id": "6f82e6a9-ad64-359b-b228-af56ec8283ce",
                                        "glosses": [
                                            "The microorganisms that inhabit some part of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf7295c9-6d1f-45f6-adcc-ee9b1933ee92",
                                                "sense_id": "444e9df9-a615-3e1b-bc3d-36e23673a51d",
                                                "text": "gut flora, intestinal flora"
                                            },
                                            {
                                                "example_id": "972a0e2c-bb32-40ab-9ec5-bc3aa71828e8",
                                                "sense_id": "444e9df9-a615-3e1b-bc3d-36e23673a51d",
                                                "text": "The host effects upon the flora of both the small intestine and the large intestine must be examined."
                                            },
                                            {
                                                "example_id": "19ccd5be-435b-4eb3-b914-3fcb0a37d453",
                                                "sense_id": "444e9df9-a615-3e1b-bc3d-36e23673a51d",
                                                "text": "Approximately 3% of healthy adults harbor C. difficile in the intestinal tract. […] In contrast, the flora of the cecum is predominantly gram negative, with Bacteroides and Selenomonas being the major constituents."
                                            },
                                            {
                                                "example_id": "b09235a4-d8b7-41a7-9786-54a78e4b59a8",
                                                "sense_id": "444e9df9-a615-3e1b-bc3d-36e23673a51d",
                                                "text": "[…] Lactobacillus, Pseudomonas, Bifidobacterium, Eubacterium, Peptococcus, Peptostreptococcus, Bacteroides and Spirochetes that characterize the flora of the large intestine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e30338d-bb51-434f-a841-77723d8809f8",
                        "source_entry_id": "2b5cc9d9-fee0-3039-9dce-c4523470ef14",
                        "source_sense_id": "59944fb5-93d5-3abc-b540-60bdf7f60131",
                        "source_sense_description": "plantenrijk in een bepaalde streek of periode",
                        "target_lang_word": "flore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                        "entry_id": "fbe55dd8-ad42-3d0c-8a94-b99405413dd1",
                                        "glosses": [
                                            "Ensemble des plantes d’un pays, d’une région, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52803089-be55-4abe-9c69-1ce4c1576f73",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "Pendant ces excursions, la flore du pays avait été observée avec autant d'attention que la faune. Mais les végétaux étaient nécessairement moins variés que les animaux, […]."
                                            },
                                            {
                                                "example_id": "76b61d4d-ad9a-41a7-94eb-c6482d1aeeee",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "Heureusement que la flore de l'île vint à mon secours et me fourni les principaux élémens de ma matière médicale."
                                            },
                                            {
                                                "example_id": "a1c7f050-e3d4-4109-a6dd-928bb5ba9701",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "Le digne savant, émerveillé par la riche flore qu’il avait sous les yeux, avait tout oublié pour ne plus songer qu’à l’ample moisson qu’il pouvait faire."
                                            },
                                            {
                                                "example_id": "400c0b86-8f8e-480e-aaac-63762dd4b683",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "Charles Darwin les a visitées et en a décrit la flore et la faune dans la Croisière du Beagle qui faisait partie de ma bibliothèque de bord."
                                            },
                                            {
                                                "example_id": "413d9d7e-25d9-490a-aab0-f96378697488",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "L’endémisme est particulièrement développé dans trois sortes de flores : les flores isolées, les flores montagnardes, les flores insulaires."
                                            },
                                            {
                                                "example_id": "baa9d09b-c0cb-4031-836c-f68416fc84c7",
                                                "sense_id": "8c30e22d-b5fd-3d00-bd42-6fa5c181023d",
                                                "text": "Parmi la maigre littérature, en particulier francophone, concernant la malherbologie, il manquait une synthèse taxonomique sur la flore des champs cultivés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9836e8a3-f805-319c-b95e-eb89acde418f",
                                        "entry_id": "fbe55dd8-ad42-3d0c-8a94-b99405413dd1",
                                        "glosses": [
                                            "Livre contenant la description des plantes qui croissent naturellement dans un territoire géographique donné."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765e6560-22f2-4808-88ac-d391ba4afef6",
                                                "sense_id": "9836e8a3-f805-319c-b95e-eb89acde418f",
                                                "text": "Une nouvelle Flore portative, soigneusement faite, devenait donc indispensable. C'est ce pénible travail que M. Mérat a entrepris , et qu'il a exécuté d'une manière satisfaisante."
                                            },
                                            {
                                                "example_id": "e1f96cd0-924f-4ada-9428-77fc82539dee",
                                                "sense_id": "9836e8a3-f805-319c-b95e-eb89acde418f",
                                                "text": "Celui qui consulte les différentes flores françaises constate rapidement que l'accord est loin d'être général sur le nom scientifique attribué à telle espèce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e676133-efaa-3d95-86bf-08d08b7f8c43",
                                        "entry_id": "fbe55dd8-ad42-3d0c-8a94-b99405413dd1",
                                        "glosses": [
                                            "Décor sculpté qui figure des plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74652ef7-e041-402a-9eb0-ccc0b207729d",
                                                "sense_id": "0e676133-efaa-3d95-86bf-08d08b7f8c43",
                                                "text": "Ils […] débouchèrent dans une grande cour, […], au fond de laquelle s’étendait une vaste construction du XVIIᵉ siècle. Il n’y avait ni flore de pierre, ni sculptures, aucun porche animé, rien, sinon une façade de briques et de moëllons usés, […]."
                                            },
                                            {
                                                "example_id": "d7ff6515-e759-42ac-9455-5f1365be7f32",
                                                "sense_id": "0e676133-efaa-3d95-86bf-08d08b7f8c43",
                                                "text": "En Occident, on sait combien le règne végétal a inspiré l'art du moyen âge. Dans les cathédrales s'épanouit une flore de pierre aussi riche que la flore persane, aussi merveilleuse par les formes que celle-ci l'est par les couleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
