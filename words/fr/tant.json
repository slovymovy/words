{
    "word_family": [
        "autant",
        "pourtant",
        "tantinet",
        "tantôt"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "992be216-87e9-36ba-8211-8a746691d2ab",
                    "sense_definition": "Suivi de la préposition « de » : une si grande quantité ou un si grand nombre de.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a <w>tant</w> de choses à visiter dans cette ville historique."
                        },
                        {
                            "text": "Elle a reçu <w>tant</w> de messages pour son anniversaire qu'elle n'a pas pu tout lire."
                        }
                    ],
                    "synonyms": [
                        "tellement"
                    ],
                    "antonyms": [
                        "peu"
                    ],
                    "common_phrases": [
                        "tant de monde",
                        "tant de choses",
                        "tant de fois"
                    ]
                },
                {
                    "sense_id": "cd9e3d90-5388-3309-8d0c-f1aad4c1a4ed",
                    "sense_definition": "À un si haut degré, avec une telle intensité ou en si grande quantité (en modifiant un verbe).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>tant</w> travaillé cette semaine qu'il a besoin de repos."
                        },
                        {
                            "text": "Ce voyage <w>tant</w> attendu a finalement comblé toutes nos espérances."
                        }
                    ],
                    "synonyms": [
                        "tellement"
                    ],
                    "antonyms": [
                        "peu"
                    ],
                    "common_phrases": [
                        "tant attendu",
                        "tant aimé",
                        "tant et plus"
                    ]
                },
                {
                    "sense_id": "83c87555-0509-3acb-988b-b3e7dac37308",
                    "sense_definition": "Dans la construction corrélative « tant ... que » : aussi bien ... que, marquant une égalité d'inclusion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "correlation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle loi concerne <w>tant</w> les salariés que les employeurs."
                        },
                        {
                            "text": "Le projet a reçu des soutiens, <w>tant</w> en France qu'à l'étranger."
                        }
                    ],
                    "synonyms": [
                        "aussi bien"
                    ],
                    "common_phrases": [
                        "tant que"
                    ]
                },
                {
                    "sense_id": "07e0a97e-eea8-36b6-b92e-d172063af064",
                    "sense_definition": "À tel point, tellement (introduit généralement une explication ou une justification de la proposition principale).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avancions prudemment, <w>tant</w> la route était devenue glissante."
                        },
                        {
                            "text": "Elle ne reconnaissait plus les lieux, <w>tant</w> le paysage avait changé."
                        }
                    ],
                    "synonyms": [
                        "tellement"
                    ],
                    "common_phrases": [
                        "tant il est vrai",
                        "tant et si bien"
                    ]
                },
                {
                    "sense_id": "2b11ca9f-0d2b-3b05-bda2-b2e25fc58d9c",
                    "sense_definition": "Dans des constructions comparatives ou restrictives comme « pas tant ... que » : autant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "correlation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa réussite ne dépend pas <w>tant</w> de la chance que d'un travail constant."
                        },
                        {
                            "text": "Ce n'est pas <w>tant</w> le prix qui m'inquiète que la qualité du produit."
                        }
                    ],
                    "synonyms": [
                        "autant"
                    ],
                    "common_phrases": [
                        "pas tant que",
                        "non pas tant"
                    ]
                },
                {
                    "sense_id": "26770587-12e5-3daf-846e-b3aeefeeb9b4",
                    "sense_definition": "Sert à désigner une quantité, une part, un nombre ou une somme déterminée mais non spécifiée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous nous sommes mis d'accord pour verser <w>tant</w> par mois au propriétaire."
                        },
                        {
                            "text": "L'entreprise touche une commission de <w>tant</w> pour cent sur chaque vente réalisée."
                        }
                    ],
                    "common_phrases": [
                        "tant pour cent",
                        "soixante et tant"
                    ]
                }
            ]
        }
    ]
}