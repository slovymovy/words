                                "target_senses": [
                                    {
                                        "sense_id": "5348d17d-b25b-3c41-b4ec-79a63648ab41",
                                        "entry_id": "61df8c26-c064-32a7-b8e9-bfeb35f395da",
                                        "glosses": [
                                            "Processus par lequel le mode de vie, la langue etc. deviennent plus chinois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05aeb818-e055-4342-a4d7-bf90087e871b",
                                                "sense_id": "5348d17d-b25b-3c41-b4ec-79a63648ab41",
                                                "text": "Même les Tibétains au Tibet, malgré la sinisation endémique, ont encore droit à des radios Tibétaines."
                                            },
                                            {
                                                "example_id": "b70f50fb-8322-4033-98cd-1b6909627f4a",
                                                "sense_id": "5348d17d-b25b-3c41-b4ec-79a63648ab41",
                                                "text": "La présence massive de Chinois dans certaines régions en-dehors de la Chine peut renforcer la sinisation de ces régions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "791f251e-b3e7-4acb-b87d-c484f9e439dd",
                        "source_entry_id": "846fe1dc-4b62-3662-83f4-14824dd42c66",
