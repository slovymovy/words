                "forms": [
                    {
                        "form_id": "73d53cd2-99e3-4664-a54d-6029d5390fcc",
                        "entry_id": "47eb2aef-fa39-3186-93b5-02fd7469cc9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "cafs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37a840bb-edf0-3737-9687-e89a88c91d17",
                        "entry_id": "47eb2aef-fa39-3186-93b5-02fd7469cc9e",
                        "glosses": [
                            "A café."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "36c33eac-5b75-447a-a2e8-8943b025545d",
                                "sense_id": "37a840bb-edf0-3737-9687-e89a88c91d17",
                                "text": "Fourth on the list of the businesses my father and his brothers had owned was a caf on the corner of San Ignacio and Lamparilla in Old Havana."
                            }
                        ]
                    },
                    {
                        "sense_id": "83a0339b-1fdf-3228-8ab9-c8c22d914b46",
                        "entry_id": "47eb2aef-fa39-3186-93b5-02fd7469cc9e",
                        "glosses": [
                            "A cafeteria."
                        ],
                        "tags": [
                            "countable",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "e014f83a-e6fc-48c3-8768-2fee1d86e652",
                                "sense_id": "83a0339b-1fdf-3228-8ab9-c8c22d914b46",
                                "text": "There are plenty of restaurants to choose from when you're sick of the ol’ caf food."
                            },
                            {
                                "example_id": "e1470bff-581c-49ce-9676-c19b0ea85228",
                                "sense_id": "83a0339b-1fdf-3228-8ab9-c8c22d914b46",
                                "text": "Locked, empty classrooms on either side, other halls opening up to go down to the caf, two janitors' closets. Janitors' closets. Great. One was locked."
                            },
                            {
                                "example_id": "398b2425-3cd0-4605-a661-b712eb7b1f90",
                                "sense_id": "83a0339b-1fdf-3228-8ab9-c8c22d914b46",
                                "text": "One thing they shun is eating in the caf. alone. If you were not with a clique, you are strange. Why? I don't know. I heard the meat is processed and all the food is made by mixing powder with a measured amount of water."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a8003bd-ad98-3ae2-97b6-67cd905152b5",
                        "entry_id": "47eb2aef-fa39-3186-93b5-02fd7469cc9e",
                        "glosses": [
                            "A caffeinated coffee."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2b7abba3-8148-45bc-bc74-0f7d9919580d",
                                "sense_id": "9a8003bd-ad98-3ae2-97b6-67cd905152b5",
                                "text": "If you decide to cut coffee out completely, consider going down half a cup a day, week by week, if your withdrawal symptoms—headaches and irritability—are severe. Or, mix decaf with caf, increasing the quantity of decaf until you are down to all decaf."
                            }
                        ]
                    }
