                                        "entry_id": "eb3f964d-5521-338d-a618-5317e3d736fd",
                                        "glosses": [
                                            "Clothes that encircle the neck.",
                                            "The part of an upper garment (shirt, jacket, etc.) that fits around the neck and throat, especially if sewn from a separate piece of fabric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d43f3fc-a34e-4bea-85b6-2a04b7ae9cf2",
                                                "sense_id": "b89be5e6-480f-3ab9-919d-6e7c9ffcefe0",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street. He wore shepherd's plaid trousers and the swallow-tail coat of the day, with a figured muslin cravat wound about his wide-spread collar."
                                            },
