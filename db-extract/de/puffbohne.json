                                    {
                                        "sense_id": "4a6107b0-d7a5-3a82-b346-388b5fc655ac",
                                        "entry_id": "4d49b955-e82d-3990-bf55-4fd4649a68c0",
                                        "glosses": [
                                            "Variante de féverole."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31e3c676-0a43-4a9b-8d77-d8e969587dba",
                                                "sense_id": "4a6107b0-d7a5-3a82-b346-388b5fc655ac",
                                                "text": "A ce titre les légumineuses : luzerne, trèfle, féverolle, haricots et les crucifères : colza, chou, en profitent fort justement."
                                            }
                                        ]
                                    }
                                ]
