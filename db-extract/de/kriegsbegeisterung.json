                        "examples": [
                            {
                                "example_id": "f3a2ee7c-cd75-4f31-90f6-dcfb65606c4e",
                                "sense_id": "5b93aaa7-02ae-3f91-b4f4-577f5d4a00fb",
                                "text": "„Nach dem planmäßigen Ende des Sommerfestes kamen Kriegsgefahr und Kriegsbegeisterung auch in der Garnisonsstadt Hildesheim an.“"
                            },
                            {
                                "example_id": "fc846b8f-fe00-4d81-a8ad-be4856495d4a",
                                "sense_id": "5b93aaa7-02ae-3f91-b4f4-577f5d4a00fb",
                                "text": "„Auf die anfängliche Kriegsbegeisterung vieler junger Menschen reagierte Ehrenstein mit Aggressivität.“"
                            }
                        ],
