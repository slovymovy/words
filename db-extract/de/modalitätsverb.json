                "senses": [
                    {
                        "sense_id": "c77007b0-047f-3dc0-a6ff-b281e9186df9",
                        "entry_id": "6013d90b-eeab-3bd2-b259-e37398c63b30",
                        "glosses": [
                            "Gruppe von Verben, die mit anderen Verben zusammen das Prädikat bilden und im Unterschied zu Modalverben den Infinitiv mit zu anschließen. Sie dienen dem Ausdruck der Stellungnahme des Sprechers (der Modalität) zu dem, was geäußert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e4caee2-bd85-46d9-b148-79d932761e83",
                                "sense_id": "c77007b0-047f-3dc0-a6ff-b281e9186df9",
                                "text": "Zu den Modalitätsverben gehören im Deutschen „brauchen“, „bleiben“, „drohen“, „pflegen“ und andere."
                            },
                            {
                                "example_id": "e9ec2ab4-616a-4c51-9ad3-ab735e566a07",
                                "sense_id": "c77007b0-047f-3dc0-a6ff-b281e9186df9",
                                "text": "In dem Satz „Er braucht gar nicht mehr zu kommen“ ist \"braucht\" ein Modalitätsverb."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
