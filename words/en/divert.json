{
    "word_family": [
        "diversion",
        "divertissement",
        "diverter",
        "divertible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92bb08c4-aed3-3c7b-8d91-fa3ab9613ea0",
                    "sense_definition": "To cause someone or something to change direction or to turn aside from a particular course.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction crew had to <w>divert</w> traffic to a side street while they repaired the main road.",
                            "target_lang_translations": {
                                "ru": "Строительной бригаде пришлось <w>направить</w> движение в объезд по боковой улице, пока они ремонтировали главную дорогу."
                            }
                        },
                        {
                            "text": "The engineers worked quickly to <w>divert</w> the stream away from the residential area before the flood reached the houses.",
                            "target_lang_translations": {
                                "ru": "Инженеры быстро работали, чтобы <w>отвести</w> поток от жилого района до того, как наводнение достигнет домов."
                            }
                        }
                    ],
                    "synonyms": [
                        "offlead"
                    ],
                    "common_phrases": [
                        "divert traffic",
                        "divert a stream",
                        "divert resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять кого-либо или что-либо по другому пути или изменять направление движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "изменять направление потока или движения"
                            },
                            {
                                "target_lang_word": "направлять",
                                "target_lang_sense_clarification": "перенаправлять в другую сторону"
                            },
                            {
                                "target_lang_word": "отклонять",
                                "target_lang_sense_clarification": "заставлять изменить курс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15ff1a79-ac41-3c89-b6df-5dd670cc7e70",
                    "sense_definition": "To draw someone's attention away from something or to distract them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise outside was intended to <w>divert</w> attention from the secret meeting happening inside.",
                            "target_lang_translations": {
                                "ru": "Громкий шум снаружи был призван <w>отвлечь</w> внимание от секретной встречи, проходившей внутри."
                            }
                        },
                        {
                            "text": "Please do not let the minor details <w>divert</w> your attention from the primary goal of this project.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не позволяйте мелким деталям <w>отвлекать</w> ваше внимание от основной цели этого проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "offlead"
                    ],
                    "common_phrases": [
                        "divert attention",
                        "divert one's gaze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отвлекать чье-либо внимание от чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отвлекать",
                                "target_lang_sense_clarification": "переключать внимание на другой объект"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "например, взгляд или внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c44003c0-e0f4-3a01-93a0-972671ded27e",
                    "sense_definition": "To personally turn aside or deviate from a path or a topic of conversation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "change direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During our road trip, we decided to <w>divert</w> to see one of the famous historic palaces nearby.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки мы решили <w>отклониться</w> от маршрута, чтобы посмотреть один из знаменитых исторических дворцов неподалеку."
                            }
                        },
                        {
                            "text": "The speaker began to <w>divert</w> from the main topic, discussing his personal experiences instead of the data.",
                            "target_lang_translations": {
                                "ru": "Докладчик начал <w>отклоняться</w> от основной темы, обсуждая свой личный опыт вместо данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "divert from the path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сворачивать с пути или отклоняться от темы разговора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отклоняться",
                                "target_lang_sense_clarification": "от темы или заданного маршрута"
                            },
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "менять направление движения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "beafc57b-3ccd-381e-aa2f-02ae86053f55",
                    "sense_definition": "To entertain or amuse someone, often by taking their mind off more serious matters.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "entertainment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveling circus managed to <w>divert</w> the villagers for a few hours with their impressive acrobatics.",
                            "target_lang_translations": {
                                "ru": "Бродячему цирку удалось <w>развлечь</w> жителей деревни на несколько часов своими впечатляющими акробатическими номерами."
                            }
                        },
                        {
                            "text": "Despite the poor script, the actors' performances were enough to <w>divert</w> the audience throughout the evening.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохой сценарий, игры актеров было достаточно, чтобы <w>забавлять</w> публику на протяжении всего вечера."
                            }
                        }
                    ],
                    "common_phrases": [
                        "divert the mind"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Развлекать или забавлять кого-либо, помогая отвлечься от серьезных мыслей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развлекать",
                                "target_lang_sense_clarification": "занимать чем-то приятным"
                            },
                            {
                                "target_lang_word": "забавлять",
                                "target_lang_sense_clarification": "веселить или тешить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}