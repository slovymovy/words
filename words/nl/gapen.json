{
    "word_family": [
        "gaap",
        "gegaap",
        "gapend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "692cb11b-4192-3f1d-9db1-7100531cc5db",
                    "sense_definition": "heel diep inademen met de mond ver open, vaak door vermoeidheid of verveling",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysiologische handeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij moest <w>gapen</w> en trok een gek gezicht bij zijn poging het te onderdrukken.",
                            "target_lang_translations": {
                                "en": "He had to <w>yawn</w> and made a funny face in his attempt to suppress it."
                            }
                        },
                        {
                            "text": "Tijdens de lange film begon iedereen in de zaal luid te <w>gapen</w>.",
                            "target_lang_translations": {
                                "en": "During the long movie, everyone in the theater started to <w>yawn</w> loudly."
                            }
                        }
                    ],
                    "synonyms": [
                        "geeuwen"
                    ],
                    "common_phrases": [
                        "luid gapen",
                        "moeten gapen"
                    ],
                    "target_lang_definitions": {
                        "en": "to inhale deeply with the mouth wide open, often due to fatigue or boredom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yawn",
                                "target_lang_sense_clarification": "the physiological act of inhaling deeply"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c795af98-77c3-3831-928a-7b05e40ef8db",
                    "sense_definition": "een groot gat of een grote holte vertonen of wijd openstaan",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "openstaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>gaapte</w> een diepe wond in zijn arm na de val.",
                            "target_lang_translations": {
                                "en": "A deep wound <w>gaped</w> in his arm after the fall."
                            }
                        },
                        {
                            "text": "Voor de wandelaars <w>gaapte</w> een enorme afgrond in het berglandschap.",
                            "target_lang_translations": {
                                "en": "A huge abyss <w>yawned</w> before the hikers in the mountain landscape."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een gapende wond",
                        "een gapende afgrond"
                    ],
                    "target_lang_definitions": {
                        "en": "to show a large hole or cavity, or to stand wide open"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gape",
                                "target_lang_sense_clarification": "to be wide open, like a wound or abyss"
                            },
                            {
                                "target_lang_word": "yawn",
                                "target_lang_sense_clarification": "to present a wide opening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98e89e2b-f1ca-3398-afe9-6bfa68e4927c",
                    "sense_definition": "met open mond vol verwondering of verbazing ergens naar kijken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kijken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij stond te <w>gapen</w> bij dat bizarre monument midden op het plein.",
                            "target_lang_translations": {
                                "en": "She stood <w>gaping</w> at that bizarre monument in the middle of the square."
                            }
                        },
                        {
                            "text": "De toeristen stonden urenlang naar de prachtige architectuur te <w>gapen</w>.",
                            "target_lang_translations": {
                                "en": "The tourists stood <w>gaping</w> at the beautiful architecture for hours."
                            }
                        }
                    ],
                    "common_phrases": [
                        "staan te gapen"
                    ],
                    "target_lang_definitions": {
                        "en": "to look at something with an open mouth in wonder or amazement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gape",
                                "target_lang_sense_clarification": "to stare in wonder with an open mouth"
                            },
                            {
                                "target_lang_word": "gawk",
                                "target_lang_sense_clarification": "to stare stupidly or rudely"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5662fdf-8034-3448-b547-5dbd4c755094",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>gaap</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na drie grote <w>gapen</w> besloot hij eindelijk naar bed te gaan.",
                            "target_lang_translations": {
                                "en": "After three big <w>yawns</w>, he finally decided to go to bed."
                            }
                        },
                        {
                            "text": "Zij probeerde haar <w>gapen</w> te verbergen achter haar hand.",
                            "target_lang_translations": {
                                "en": "She tried to hide her <w>yawns</w> behind her hand."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of gaap"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural form of the noun 'yawn'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yawns",
                                "target_lang_sense_clarification": "plural of the act of yawning"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}