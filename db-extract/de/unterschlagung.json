                        "entry_id": "57716e37-9e35-3eac-8f0d-ee6cbec2260e",
                        "glosses": [
                            "rechtswidrige Aneignung fremden Eigentums, das sich bereits im eigenen Besitz befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "575161ce-bea2-4b4d-9688-4bd9f73c812e",
                                "sense_id": "98cab05f-214c-3e7b-bf22-8510c8cf5677",
                                "text": "„Gegen den Mann wird nun wegen Unterschlagung ermittelt.“"
                            },
                            {
                                "example_id": "b45fb162-f72d-4353-9f4c-dc1dd4339e5c",
                                "sense_id": "98cab05f-214c-3e7b-bf22-8510c8cf5677",
                                "text": "„Wegen Unterschlagung und Urkundenfälschung wird er verurteilt, kommt für zwölf Monate ins Gefängnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
