{
    "word_family": [
        "nature",
        "naturally",
        "naturalist",
        "naturalism",
        "naturalize",
        "unnatural",
        "supernatural"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "caed2a4f-f65b-338f-9412-18534647bc65",
                    "sense_definition": "Existing in or derived from nature; not made, caused, or processed by humankind.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national park is famous for its stunning <w>natural</w> beauty.",
                            "target_lang_translations": {
                                "ru": "Национальный парк славится своей потрясающей <w>природной</w> красотой.",
                                "zh": "这座国家公园以其令人惊叹的<w>自然</w>美景而闻名。"
                            }
                        },
                        {
                            "text": "We try to use <w>natural</w> light in the office as much as possible.",
                            "target_lang_translations": {
                                "ru": "Мы стараемся как можно больше использовать <w>естественное</w> освещение в офисе.",
                                "zh": "我们尽量在办公室里多利用<w>自然</w>光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "real"
                    ],
                    "antonyms": [
                        "artificial"
                    ],
                    "common_phrases": [
                        "natural resources",
                        "natural world",
                        "natural light",
                        "natural history"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в природе или полученный из неё; не созданный человеком",
                        "zh": "存在于自然界中或来源于自然；不是由人类制造、引起或加工的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "природный",
                                "target_lang_sense_clarification": "относящийся к природе"
                            },
                            {
                                "target_lang_word": "естественный",
                                "target_lang_sense_clarification": "не искусственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然的",
                                "target_lang_sense_clarification": "属于自然界的；非人工造成或加工的"
                            },
                            {
                                "target_lang_word": "天然的",
                                "target_lang_sense_clarification": "强调不是人造的，如自然光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c63aba37-8d65-35e5-95ec-7b9190348ac8",
                    "sense_definition": "Containing no artificial or man-made additives, especially regarding food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Natural</w> food is often considered healthier than processed alternatives.",
                            "target_lang_translations": {
                                "ru": "<w>Натуральная</w> еда часто считается более полезной, чем обработанные аналоги.",
                                "zh": "<w>天然</w>食品通常被认为比加工食品更健康。"
                            }
                        },
                        {
                            "text": "This juice is made from one hundred percent <w>natural</w> ingredients.",
                            "target_lang_translations": {
                                "ru": "Этот сок сделан из стопроцентно <w>натуральных</w> ингредиентов.",
                                "zh": "这种果汁是用百分之百<w>天然</w>的原料制成的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "processed",
                        "artificial"
                    ],
                    "common_phrases": [
                        "natural ingredients",
                        "natural flavor",
                        "natural food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий искусственных добавок, особенно в отношении еды",
                        "zh": "不含人工或人造成分，尤指食物中的添加剂。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натуральный",
                                "target_lang_sense_clarification": "настоящий, без добавок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天然的",
                                "target_lang_sense_clarification": "食品、原料等不含人工添加成分"
                            },
                            {
                                "target_lang_word": "纯天然的",
                                "target_lang_sense_clarification": "也用于食品语境，强调未经化学或工业处理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c832e75-713e-34aa-bbc1-ba19fb214b2b",
                    "sense_definition": "Happening or existing as expected; reasonable or normal in the circumstances.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expected",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>natural</w> to feel nervous before a big exam.",
                            "target_lang_translations": {
                                "ru": "<w>Естественно</w> нервничать перед важным экзаменом.",
                                "zh": "在大型考试前感到紧张是很<w>自然</w>的。"
                            }
                        },
                        {
                            "text": "Her anger was a <w>natural</w> reaction to the unfair treatment.",
                            "target_lang_translations": {
                                "ru": "Её гнев был <w>естественной</w> реакцией на несправедливое обращение.",
                                "zh": "她的愤怒是对这种不公平待遇的<w>自然</w>反应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reasonable",
                        "inevitable",
                        "understandable",
                        "normal"
                    ],
                    "antonyms": [
                        "strange",
                        "abnormal"
                    ],
                    "common_phrases": [
                        "natural consequence",
                        "natural reaction",
                        "perfectly natural"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или существующий как ожидалось; нормальный в данных обстоятельствах",
                        "zh": "在当时情况下如预期发生或存在的；合理或正常的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естественный",
                                "target_lang_sense_clarification": "закономерный, ожидаемый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然的",
                                "target_lang_sense_clarification": "符合常理、正常、可以理解"
                            },
                            {
                                "target_lang_word": "正常的",
                                "target_lang_sense_clarification": "强调反应或结果在情理之中"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05875e7e-2326-3a6b-8a59-69d3491c5f7e",
                    "sense_definition": "Present from birth; innate and not acquired or learned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "innate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a <w>natural</w> talent for playing the piano.",
                            "target_lang_translations": {
                                "ru": "У неё <w>врождённый</w> талант к игре на пианино.",
                                "zh": "她有弹钢琴的<w>天生</w>天赋。"
                            }
                        },
                        {
                            "text": "He is a <w>natural</w> leader who inspires everyone around him.",
                            "target_lang_translations": {
                                "ru": "Он <w>прирождённый</w> лидер, который вдохновляет всех вокруг.",
                                "zh": "他是个<w>天生的</w>领导者，能激励身边的每一个人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "innate",
                        "native",
                        "born",
                        "instinctive"
                    ],
                    "common_phrases": [
                        "natural talent",
                        "natural ability",
                        "natural leader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Присутствующий с рождения; врождённый, а не приобретённый",
                        "zh": "生来就有的；先天的，而不是后天获得或学来的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "врождённый",
                                "target_lang_sense_clarification": "о таланте или качестве"
                            },
                            {
                                "target_lang_word": "прирождённый",
                                "target_lang_sense_clarification": "о человеке (лидер, оратор)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天生的",
                                "target_lang_sense_clarification": "指能力、天赋等与生俱来的"
                            },
                            {
                                "target_lang_word": "与生俱来的",
                                "target_lang_sense_clarification": "较正式，指先天具备而非后天习得"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b53d4ce-9d18-336a-bb76-241d33b63693",
                    "sense_definition": "Caused by disease or old age rather than by an accident or violence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police confirmed that the elderly man died from <w>natural</w> causes.",
                            "target_lang_translations": {
                                "ru": "Полиция подтвердила, что пожилой мужчина умер от <w>естественных</w> причин.",
                                "zh": "警方证实，这位老人死于<w>自然</w>原因。"
                            }
                        },
                        {
                            "text": "She lived a long life and eventually died a <w>natural</w> death at home.",
                            "target_lang_translations": {
                                "ru": "Она прожила долгую жизнь и в конце концов умерла <w>естественной</w> смертью дома.",
                                "zh": "她活了很久，最终在家中<w>寿终正寝</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "natural causes",
                        "natural death"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызванный болезнью или старостью, а не несчастным случаем",
                        "zh": "由疾病或年老引起，而不是由事故或暴力造成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естественный",
                                "target_lang_sense_clarification": "о смерти или причинах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然的",
                                "target_lang_sense_clarification": "指死亡由疾病或衰老引起，而非事故或暴力"
                            },
                            {
                                "target_lang_word": "自然原因的",
                                "target_lang_sense_clarification": "用于“自然原因”“自然死亡”等固定说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbad8c16-2881-3127-a925-0f34d5f43efb",
                    "sense_definition": "Describing a musical note that is neither sharp nor flat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a wrong note here; it should be C <w>natural</w> instead of C sharp.",
                            "target_lang_translations": {
                                "ru": "Здесь неправильная нота; должно быть до <w>бекар</w> вместо до диез.",
                                "zh": "这里有个音符错了，应该是C<w>还原音</w>，不是升C。"
                            }
                        },
                        {
                            "text": "The composer indicated a B <w>natural</w> in the second measure.",
                            "target_lang_translations": {
                                "ru": "Композитор указал си <w>бекар</w> во втором такте.",
                                "zh": "作曲家在第二小节标出了B<w>还原音</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает музыкальную ноту, которая не является ни диезом, ни бемолем",
                        "zh": "形容一种既不是升音也不是降音的音符。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бекар",
                                "target_lang_sense_clarification": "название ноты без знаков альтерации"
                            },
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "без изменений тона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还原音",
                                "target_lang_sense_clarification": "音乐中指不升不降的音"
                            },
                            {
                                "target_lang_word": "本位音",
                                "target_lang_sense_clarification": "也可指带有还原记号的音高形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb2007d9-6bf7-3cf3-93ed-c3072dfe195b",
                    "sense_definition": "A person having an innate talent for a particular task or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "innate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He picked up the guitar and was a <w>natural</w> from the very first day.",
                            "target_lang_translations": {
                                "ru": "Он взял гитару и с первого же дня проявил себя как <w>самородок</w>.",
                                "zh": "他一拿起吉他，从第一天起就是个<w>天才型选手</w>。"
                            }
                        },
                        {
                            "text": "She is a <w>natural</w> at swimming and wins every race.",
                            "target_lang_translations": {
                                "ru": "Она <w>самородок</w> в плавании и выигрывает все заплывы.",
                                "zh": "她游泳很有<w>天赋</w>，每次比赛都能获胜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "a natural at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий врождённым талантом к какому-либо делу",
                        "zh": "指在某项任务或活动上具有天生才能的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самородок",
                                "target_lang_sense_clarification": "талантливый человек"
                            },
                            {
                                "target_lang_word": "талант",
                                "target_lang_sense_clarification": "одаренный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天才型选手",
                                "target_lang_sense_clarification": "指在某项活动上有天生才能的人"
                            },
                            {
                                "target_lang_word": "有天赋的人",
                                "target_lang_sense_clarification": "口语中指天赋很高的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "025c8373-5107-3945-ba34-251c6e2a8f4e",
                    "sense_definition": "A musical note that is neither sharp nor flat, or the symbol (♮) representing it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The musician forgot to play the <w>natural</w> and played a sharp instead.",
                            "target_lang_translations": {
                                "ru": "Музыкант забыл сыграть <w>бекар</w> и вместо этого сыграл диез.",
                                "zh": "那位音乐家忘了演奏<w>还原音</w>，结果弹成了升音。"
                            }
                        },
                        {
                            "text": "You need to write a <w>natural</w> next to that note to cancel the previous accidental.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно написать <w>бекар</w> рядом с этой нотой, чтобы отменить предыдущий знак альтерации.",
                                "zh": "你得在那个音符旁边写上<w>还原记号</w>，来取消前面的临时变音记号。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальный знак (♮), отменяющий действие диеза или бемоля",
                        "zh": "音乐中既不是升音也不是降音的音，或表示这种音的记号（♮）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бекар",
                                "target_lang_sense_clarification": "музыкальный символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "还原记号",
                                "target_lang_sense_clarification": "音乐中取消升号或降号的记号（♮），也可指相应的音"
                            },
                            {
                                "target_lang_word": "还原音",
                                "target_lang_sense_clarification": "指被还原后的音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99adbf17-156b-3205-996e-a4e8bf0b7a2b",
                    "sense_definition": "An Afro hairstyle in which the hair is not straightened or chemically treated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to stop using relaxers and wear her hair in a <w>natural</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила перестать использовать выпрямители и носить <w>естественную причёску</w>.",
                                "zh": "她决定不再使用直发膏，改留<w>自然卷发式</w>。"
                            }
                        },
                        {
                            "text": "Many women are embracing their texture and rocking a <w>natural</w>.",
                            "target_lang_translations": {
                                "ru": "Многие женщины принимают свою текстуру волос и носят <w>афро</w>.",
                                "zh": "很多女性开始接受自己头发的天然纹理，留起了<w>自然卷发式</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причёска в стиле афро, при которой волосы не выпрямляются",
                        "zh": "一种非裔发型，头发不被拉直，也不经过化学处理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "естественная причёска",
                                "target_lang_sense_clarification": "без химической обработки"
                            },
                            {
                                "target_lang_word": "афро",
                                "target_lang_sense_clarification": "стиль прически"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自然卷发式",
                                "target_lang_sense_clarification": "指不拉直、不做化学处理的非裔自然发型"
                            },
                            {
                                "target_lang_word": "天然非裔发型",
                                "target_lang_sense_clarification": "更具体地指非裔风格的天然卷发造型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "083ae2e7-9519-3302-8d51-864c47d31824",
                    "sense_definition": "An off-white colour, similar to that of undyed fabric.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted in a soft <w>natural</w> to make the room feel brighter.",
                            "target_lang_translations": {
                                "ru": "Стены были покрашены в мягкий <w>бежевый</w> цвет, чтобы комната казалась светлее.",
                                "zh": "墙面被刷成了柔和的<w>本白色</w>，让房间显得更明亮。"
                            }
                        },
                        {
                            "text": "She chose a dress in <w>natural</w> because it matched her accessories perfectly.",
                            "target_lang_translations": {
                                "ru": "Она выбрала платье <w>натурального</w> оттенка, потому что оно идеально сочеталось с её аксессуарами.",
                                "zh": "她选了一件<w>本白色</w>的连衣裙，因为它和她的配饰非常相配。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый цвет, похожий на цвет неокрашенной ткани",
                        "zh": "一种接近未染色布料颜色的灰白色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бежевый",
                                "target_lang_sense_clarification": "цвет"
                            },
                            {
                                "target_lang_word": "телесный",
                                "target_lang_sense_clarification": "цвет кожи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "本白色",
                                "target_lang_sense_clarification": "类似未经染色布料的偏白色"
                            },
                            {
                                "target_lang_word": "原白色",
                                "target_lang_sense_clarification": "偏米白、自然布色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "76329377-6646-360c-bc40-d07b34a3f4a0",
                    "sense_definition": "In a natural manner; naturally.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke <w>natural</w> and didn't try to hide his local accent.",
                            "target_lang_translations": {
