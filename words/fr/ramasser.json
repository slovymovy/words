            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b8812081-8fbf-3e3e-914f-3efdbad9e7e1",
                    "sense_definition": "Prendre ou relever ce qui est tombé ou se trouve par terre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'est penchée pour <w>ramasser</w> ses clés tombées par terre."
                        },
                        {
                            "text": "L'enfant <w>ramasse</w> ses crayons qui sont tombés sous la table de la classe."
                        }
                    ],
                    "common_phrases": [
                        "ramasser par terre"
                    ]
                },
                {
                    "sense_id": "b143b5e3-abf2-3535-a472-bf7ab6cb6304",
                    "sense_definition": "Cueillir ou récolter des produits de la nature ou des objets trouvés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En automne, nous allons dans la forêt pour <w>ramasser</w> des champignons comestibles."
                        },
                        {
                            "text": "Pendant les vacances d'été, les enfants adorent <w>ramasser</w> des coquillages sur la plage."
                        }
                    ],
                    "synonyms": [
                        "cueillir"
                    ],
                    "common_phrases": [
                        "ramasser des champignons",
                        "ramasser des coquillages"
                    ]
                },
                {
                    "sense_id": "ca7ece9a-5fc3-3456-8d69-6ffbd3947281",
                    "sense_definition": "Réunir, collecter ou regrouper des choses dispersées.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>ramasse</w> les copies des élèves dès que la sonnerie retentit."
                        },
                        {
                            "text": "Avant de ranger son bureau, il <w>ramasse</w> tous les papiers éparpillés."
                        }
                    ],
                    "synonyms": [
                        "rassembler"
                    ],
                    "common_phrases": [
                        "ramasser les copies",
                        "ramasser ses forces"
                    ]
                },
                {
                    "sense_id": "b1ff689f-f8dd-3b02-afb5-6237391a4342",
                    "sense_definition": "Tomber lourdement ou faire une mauvaise chute.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il courait trop vite sur le trottoir mouillé et s'est <w>ramassé</w> devant tout le monde."
                        },
                        {
                            "text": "Fais bien attention sur cette plaque de verglas pour ne pas te <w>ramasser</w>."
