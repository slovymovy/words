                        "cross_references": [
                            {
                                "target_word": "incest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                        "entry_id": "4392e647-aa72-36d2-98d6-d563acd769dd",
                                        "glosses": [
                                            "Sexual relations between close relatives, especially immediate family members and sometimes first cousins, usually considered taboo; in many jurisdictions, close relatives are not allowed to marry, and incest is a crime."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ce71985-0290-4d6a-b9e6-4360016934eb",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "Genetic problems caused by incest are thought to have plagued many royal families in the Middle Ages."
                                            },
                                            {
                                                "example_id": "d2244b1f-7004-4771-a464-a51d88f132aa",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "For a structuralist like Edmund Leach, the structure is the meaning. Genesis, for example, is about incest taboos; all the rest is noise and mystification."
                                            },
                                            {
                                                "example_id": "551561e0-edeb-4b0d-a142-9e931881b45d",
                                                "sense_id": "c3048d10-c9a2-3f60-9f3f-15146a4addb9",
                                                "text": "He was only Craster's whelp, an abomination born of incest, not the son of the King-beyond-the-Wall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                        "entry_id": "bc2bf782-ec3f-3fbe-a782-76c421bba786",
                                        "glosses": [
                                            "To engage in incestuous sexual intercourse."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0e04c54-4878-41bc-ae5b-aa51697e741d",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "I do not want anyone to feel that my lesbianism is a result of being incested."
                                            },
                                            {
                                                "example_id": "b99938c6-aec0-4596-af0f-dfd923a18f48",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "Her erotic transference ultimately devolved into a revelation that she had been consistently incested by her brother"
                                            },
                                            {
                                                "example_id": "bb0153e0-926c-432f-aec9-eb74518ce464",
                                                "sense_id": "ceb65d72-c1c3-3b2a-8d3e-5ebcc4c9eca4",
                                                "text": "[…] the most powerful of that bunch of immortal giants called Titans was Cronus, who “incested” with sister Rhea, who then birthed the Olympians (Zeus and his bunch) […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f0b692b-ad39-42dd-a06c-8aea80859a52",
                        "source_entry_id": "862a275b-267c-314b-a278-faf382df3eb4",
                        "source_sense_id": "88b2de8e-6d2f-3d4b-9685-8b5bc93a07ad",
