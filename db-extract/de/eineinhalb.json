                                "example_id": "d3fb0098-2961-4890-88d7-ea1823e0a7a5",
                                "sense_id": "5ab099b6-b9b0-325b-9d63-e17ee39ac56f",
                                "text": "Nach eineinhalb Jahren hat sich ihre Tochter wieder bei ihrer Mutter gemeldet."
                            },
                            {
                                "example_id": "b31ec7fa-73d8-4611-942c-3099b445aa7a",
                                "sense_id": "5ab099b6-b9b0-325b-9d63-e17ee39ac56f",
                                "text": "Vor eineinhalb Stunden habe ich zum letzen Mal etwas gegessen."
