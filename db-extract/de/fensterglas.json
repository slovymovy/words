                                    {
                                        "sense_id": "7a49bd54-bfaf-39a3-a325-f1b27a875e40",
                                        "entry_id": "24cec192-a836-3009-bd9c-e5be63d43b60",
                                        "glosses": [
                                            "helder, vlak glas dat geschikt is voor ramen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe99624e-e898-40b8-a676-48233f3ffb49",
                                                "sense_id": "7a49bd54-bfaf-39a3-a325-f1b27a875e40",
                                                "text": "'Ik zit me voor het vensterglas onnoemelijk te vervelen/Ik wou dat ik twee hondjes was, dan kon ik samen spelen', dat overigens abusievelijk aan hem werd toegeschreven."
                                            },
                                            {
                                                "example_id": "f90a163c-7e0d-4fb8-8324-78b5b3183199",
                                                "sense_id": "7a49bd54-bfaf-39a3-a325-f1b27a875e40",
                                                "text": "Australische televisiestations zonden beelden uit die door de ramen van het café waren gemaakt. Daarop waren mensen te zien met hun armen omhoog en hun handen tegen het vensterglas."
                                            },
                                            {
                                                "example_id": "61d42d0e-4e30-4468-b25d-c51f977b1b4d",
                                                "sense_id": "7a49bd54-bfaf-39a3-a325-f1b27a875e40",
                                                "text": "Nee, nee, nee, vensterglas is geen vloeistof die langzaam uitzakt als het maar lang genoeg in de raamsponning zit. Dat wordt wel vaak beweerd. Vlotjes legt Helen Czerski het misverstand uit in haar zeer informatieve en bij vlagen meeslepende boek over dagelijkse natuurkunde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
