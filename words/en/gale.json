    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6661513c-d4a2-34f9-8574-1626d38bda34",
                    "sense_definition": "A very strong wind, more than a breeze, less than a storm; number 7 through to 9 winds on the 12-step Beaufort scale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It's blowing a <w>gale</w> outside, so you should wear a heavy coat.",
                            "target_lang_translations": {
                                "ru": "На улице бушует <w>шторм</w>, так что тебе стоит надеть теплое пальто.",
                                "es": "Afuera sopla un <w>vendaval</w>, así que deberías ponerte un abrigo grueso."
                            }
                        },
                        {
                            "text": "Many parts of the boat were damaged in the <w>gale</w> during our voyage.",
                            "target_lang_translations": {
                                "ru": "Многие части лодки были повреждены во время <w>бури</w> в ходе нашего плавания.",
                                "es": "Muchas partes del barco sufrieron daños en el <w>temporal</w> durante nuestra travesía."
                            }
                        }
                    ],
                    "synonyms": [
                        "strong wind",
                        "tempest"
                    ],
                    "antonyms": [
                        "breeze"
                    ],
                    "common_phrases": [
                        "blowing a gale",
                        "gale force winds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильный ветер, сильнее бриза, но слабее шторма; ветер силой от 7 до 9 баллов по 12-балльной шкале Бофорта.",
                        "es": "Viento muy fuerte, mayor que una brisa pero menos que una tempestad o tormenta; vientos de fuerza 7 a 9 en la escala de Beaufort."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шторм",
                                "target_lang_sense_clarification": "сильный ветер"
                            },
                            {
                                "target_lang_word": "бу́ря",
                                "target_lang_sense_clarification": "сильный ветер большой разрушительной силы"
                            },
                            {
                                "target_lang_word": "поры́в ве́тра",
                                "target_lang_sense_clarification": "резкое движение воздуха"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vendaval",
                                "target_lang_sense_clarification": "viento fuerte e impetuoso"
                            },
                            {
                                "target_lang_word": "ventarrón",
                                "target_lang_sense_clarification": "viento que sopla con mucha fuerza"
                            },
                            {
                                "target_lang_word": "temporal",
                                "target_lang_sense_clarification": "viento muy fuerte, a menudo con oleaje"
                            },
                            {
                                "target_lang_word": "ventolera",
                                "target_lang_sense_clarification": "ráfaga o golpe de viento fuerte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6431f596-c609-37ed-9c0c-1b31e296ec03",
                    "sense_definition": "An outburst, especially of laughter.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "outburst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian's joke was met with a <w>gale</w> of laughter from the audience.",
                            "target_lang_translations": {
                                "ru": "Шутка комика была встречена <w>взрывом</w> смеха в зале.",
                                "es": "El chiste del humorista fue recibido con una <w>oleada</w> de risas del público."
                            }
                        },
                        {
                            "text": "A sudden <w>gale</w> of giggles erupted from the children's bedroom.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>приступ</w> хихиканья донесся из детской спальни.",
                                "es": "Un repentino <w>ataque</w> de risitas estalló en el dormitorio de los niños."
                            }
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "fit",
                        "peal"
                    ],
                    "common_phrases": [
                        "gale of laughter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Взрыв, сильный порыв, особенно смеха.",
                        "es": "Estallido o ataque repentino e intenso, especialmente de risa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взрыв",
                                "target_lang_sense_clarification": "бурное, внезапное проявление смеха"
                            },
                            {
                                "target_lang_word": "при́ступ",
                                "target_lang_sense_clarification": "резкое проявление чувства или смеха"
                            },
                            {
                                "target_lang_word": "вспы́шка",
                                "target_lang_sense_clarification": "внезапное проявление эмоций"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "ataque",
                                "target_lang_sense_clarification": "acceso súbito de risa"
                            },
                            {
                                "target_lang_word": "estallido",
                                "target_lang_sense_clarification": "manifestación ruidosa y súbita"
                            },
                            {
                                "target_lang_word": "oleada",
                                "target_lang_sense_clarification": "manifestación intensa de carcajadas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d619a81-5782-3910-9fbd-930f18b4b99c",
                    "sense_definition": "A light breeze.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A gentle <w>gale</w> rustled the leaves of the ancient oak tree.",
                            "target_lang_translations": {
                                "ru": "Легкий <w>ветерок</w> шелестел листьями векового дуба.",
                                "es": "Una suave <w>brisa</w> hizo crujir las hojas del viejo roble."
                            }
                        },
                        {
                            "text": "They enjoyed the cool evening <w>gale</w> blowing softly from the sea.",
                            "target_lang_translations": {
                                "ru": "Они наслаждались прохладным вечерним <w>бризом</w>, тихо дующим с моря.",
                                "es": "Disfrutaron del fresco <w>céfiro</w> nocturno que soplaba suavemente desde el mar."
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "zephyr"
                    ],
                    "antonyms": [
                        "hurricane"
                    ],
                    "common_phrases": [
                        "gentle gale"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in poetic or older contexts to mean a gentle breeze"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий ветерок, бриз (устаревшее или поэтическое значение).",
                        "es": "Brisa suave o ligera (uso arcaico o poético)."
                    },
