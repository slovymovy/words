        "fr-extract.jsonl": [
            {
                "entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                "word": "embrouillamini",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a98fba5d-01f3-4526-8079-746618a2b6d8",
                        "entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                        "tags": [
                            "plural"
                        ],
                        "form": "embrouillaminis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ace5e69c-6795-38a8-98fd-ee0d1c31b736",
                        "entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                        "glosses": [
                            "Situation très embrouillée."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "aae74b64-eddd-4ebe-bd22-3b2ab553e00c",
                                "sense_id": "ace5e69c-6795-38a8-98fd-ee0d1c31b736",
                                "text": "Ensuite, je retourne au Delamare, où je relis le poulet de Gueule de Bois, après quoi je réfléchis tranquillement un bon bout de temps, à cause que, d’une manière assez bizarre, je commence à m’y retrouver dans cet embrouillamini."
                            },
                            {
                                "example_id": "5aebe2cb-e9de-49c3-ac07-a0ae153d1875",
                                "sense_id": "ace5e69c-6795-38a8-98fd-ee0d1c31b736",
                                "text": "Le beurre n'étant plus du beurre, le lait n'étant plus du lait, le chocolat, et cætera et dans tout cet embrouillamini, le On dont on connaît ici l'identité — pour brouiller les pistes, il y en avait plusieurs — se dépiautait du goût."
                            },
                            {
                                "example_id": "027d32cc-ca7f-460c-a095-8feb25770aa6",
                                "sense_id": "ace5e69c-6795-38a8-98fd-ee0d1c31b736",
                                "text": "Sûrement qu'une merderie à dû survenir lors de son parcours pour qu'un fonctionnaire de Police se complaise dans l’embrouillamini des coups tordus."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1f0e662-7ed7-3aef-932d-3d456dd31da3",
                        "entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                        "glosses": [
                            "Mélange confus ; méli-mélo."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "43be28a1-3bef-4aed-87a9-ccda26e6ed76",
                                "sense_id": "a1f0e662-7ed7-3aef-932d-3d456dd31da3",
                                "text": "D’autres hordes, celles-là armées et toutes vêtues de gris, prendront la suite ici pendant près de cinq années, laissant à la lisière du sable et de la terre ferme des bunkers devenus avec le temps des abris pour défécations ou pour conjonctions illicites, et des embrouillaminis de fils de fer."
                            },
                            {
                                "example_id": "459585f3-9660-49d8-b6c7-44c09073adf1",
                                "sense_id": "a1f0e662-7ed7-3aef-932d-3d456dd31da3",
                                "text": "[…] je me demande parfois quelles erreurs auraient commises Fernando Pessoa, erreurs de correction et d’autre nature, avec tout cet embrouillamini d’hétéronymes, cela aurait donné lieu à une bagarre de tous les diables, je suppose."
                            },
                            {
                                "example_id": "4bd6b034-731c-419e-a1eb-6fb8e8ec8e84",
                                "sense_id": "a1f0e662-7ed7-3aef-932d-3d456dd31da3",
                                "text": "[…] ; l’œil les voit, mais les doigts ne peuvent pas les attraper, comme s’ils étaient enracinés dans sa poitrine en un embrouillamini de points lumineux ; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee08742d-af19-439b-8e1e-f79c63642b66",
                        "source_entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                        "target_lang_word": "muddle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca18546-2bb2-3372-9a9b-662ea0deb216",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To mix together, to mix up; to confuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99c6a05-1d7e-4973-b506-de0581cf3793",
                                                "sense_id": "4ca18546-2bb2-3372-9a9b-662ea0deb216",
                                                "text": "Young children tend to muddle their words."
                                            },
                                            {
                                                "example_id": "053e1fe6-b5a6-4c6c-acdf-3d479f8ca23c",
                                                "sense_id": "4ca18546-2bb2-3372-9a9b-662ea0deb216",
                                                "text": "I will not , to please hostile critics , muddle the argument by making it one of recondite learning , in which neither I nor my readers are strong . I try to lay before the reader reasons from which he can judge for himself"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeab22a2-1b2b-3755-91a4-99f796deda30",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To mash slightly for use in a cocktail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36562afa-cc86-46f6-901b-fd9a271d06ff",
                                                "sense_id": "eeab22a2-1b2b-3755-91a4-99f796deda30",
                                                "text": "He muddled the mint sprigs in the bottom of the glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ae69e6-3fe2-30b4-b8b9-9d7b03815afb",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To dabble in mud."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67de5a8-b1d5-4a3d-a8ef-3ac50c9e0013",
                                                "sense_id": "b6ae69e6-3fe2-30b4-b8b9-9d7b03815afb",
                                                "text": "c. 1721-1722, Jonathan Swift, The Progress of Marriage\nYoung ducklings foster'd by a hen;\nBut, when let out, they run and muddle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed1c7441-7bc8-3aa4-8991-fcfc94144bbe",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To make turbid or muddy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e6c47f-538a-4906-80a3-79004733349c",
                                                "sense_id": "ed1c7441-7bc8-3aa4-8991-fcfc94144bbe",
                                                "text": "He did ill to Muddle the Water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3a5ecd6-57a7-3fd8-a24f-33addece75d5",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To think and act in a confused, aimless way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "394844a0-7266-3070-8195-e5fca3747531",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To cloud or stupefy; to render stupid with liquor; to intoxicate partially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59138ad6-a140-4515-8461-576ea6d23676",
                                                "sense_id": "394844a0-7266-3070-8195-e5fca3747531",
                                                "text": "Their old master Epicurus seems to have had his brains so muddled and confounded with them, that he scarce ever kept in the right way."
                                            },
                                            {
                                                "example_id": "1697552e-dec0-466a-a89a-610794b0aff5",
                                                "sense_id": "394844a0-7266-3070-8195-e5fca3747531",
                                                "text": "[…] I vvas for five Years often drunk, alvvays muddled, they carry'd me from Tavern to Tavern, to Alehouſes and Brandy Shops, and brought me acquainted vvith ſuch ſtrange Dogs!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c37cfdb0-d10e-3f5d-8c80-25e62390ce03",
                                        "entry_id": "514d8b41-3f00-3cc5-ab16-05799c67199e",
                                        "glosses": [
                                            "To waste or misuse, as one does who is stupid or intoxicated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf01c4dd-5312-4fa1-8b9b-fe0c6df80c37",
                                                "sense_id": "c37cfdb0-d10e-3f5d-8c80-25e62390ce03",
                                                "text": "They muddle it [money] away without method or object, and without having anything to show for it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20f26e82-a2eb-3909-8314-73df5a75b1d9",
                                        "entry_id": "7556bc98-a3df-300e-a019-5f30c1609fca",
                                        "glosses": [
                                            "A mixture; a confusion; a garble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97a9373-4642-40bf-99cf-bdb4e4be6cad",
                                                "sense_id": "20f26e82-a2eb-3909-8314-73df5a75b1d9",
                                                "text": "The muddle of nervous speech he uttered did not have much meaning."
                                            },
                                            {
                                                "example_id": "0d3888e2-e061-4ad2-bf3e-7553c2764ec5",
                                                "sense_id": "20f26e82-a2eb-3909-8314-73df5a75b1d9",
                                                "text": "As a result, no single party or coalition immediately gained enough parliamentary seats to govern, thrusting Spain into a familiar political muddle and giving new life to Prime Minister Pedro Sánchez, who only days ago seemed moribund."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b3a8d9-4d45-3c9c-b8a4-ca6c47dcaf6e",
                                        "entry_id": "7556bc98-a3df-300e-a019-5f30c1609fca",
                                        "glosses": [
                                            "A mixture of crushed ingredients, as prepared with a muddler."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06c45731-2639-3004-a38b-27e9f0ec5d02",
                                        "entry_id": "7556bc98-a3df-300e-a019-5f30c1609fca",
                                        "glosses": [
                                            "A muddy mess."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28255d2d-a1bd-401e-8df3-d428c41b990f",
                                                "sense_id": "06c45731-2639-3004-a38b-27e9f0ec5d02",
                                                "text": "I must drive as quick with a thunder-rain pelting in my face, and the roads in a muddle, and the horses starting—I can’t call it shying, I have ’em too well in hand,—at every flash, just as quick as if it was a fine hard road, and fine weather."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "muddle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "372d284d-512d-33d2-9c8f-acb30a671d8c",
                                        "entry_id": "6d0c1e1a-b27a-3240-a8d3-1af754cac61e",
                                        "glosses": [
                                            "A servant's attendant; underservant."
                                        ],
                                        "tags": [
                                            "India",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a991052-542d-423b-9c65-f82cb4433e79",
                                                "sense_id": "372d284d-512d-33d2-9c8f-acb30a671d8c",
                                                "text": "We bought a few rugs and odds and ends and our sitting room looks quite European; then we have a bedroom with 2 beds and a dressing room, also a corridor for the muddles and servants."
                                            },
                                            {
                                                "example_id": "35b113cd-bd68-4f3f-8deb-1006ed44a173",
                                                "sense_id": "372d284d-512d-33d2-9c8f-acb30a671d8c",
                                                "text": "I have an ayah (or lady's maid), and a tailor (for the ayahs cannot work); and A—84 has a boy: also two muddles—one to sweep my room, and another to bring water."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d2ebd5-e067-43cc-8da3-262efb5b5167",
                        "source_entry_id": "8fe4b1e8-3769-3a75-8201-a2c6f82c5c41",
                        "target_lang_word": "scramble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scramble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To move hurriedly to a location, especially by using all limbs against a surface."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf92de2-dca6-4156-95f6-003dbf75cee6",
                                                "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                                "text": "As half-time approached Fabregas had another chance to give Barcelona the lead. He collected an incisive Messi pass and this time beat Cech, who required Cole to scramble back and clear the ball off the line."
                                            },
                                            {
                                                "example_id": "950d70b9-e8d4-433a-bae6-8c4392c10ebb",
                                                "sense_id": "4f68858b-c696-3737-bc2f-3f98c0159913",
                                                "text": "When I saw the coffin I knew that I was respited, for, as I judged, there was space between it and the wall behind enough to contain my little carcass; and in a second I had put out the candle, scrambled up the shelves, half-stunned my senses with dashing my head against the roof, and squeezed my body betwixt wall and coffin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b88c059-5346-39f1-a3b6-76a12cf6a762",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To proceed to a location or an objective in a disorderly manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "012881f6-0a81-3226-9b63-d470d4168610",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To thoroughly combine and cook as a loose mass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0008b1a-5779-47fb-848f-ad437fd190f6",
                                                "sense_id": "012881f6-0a81-3226-9b63-d470d4168610",
                                                "text": "I scrambled some eggs with spinach and cheese."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "454150ce-14b1-3840-bf85-f989b39d39ba",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To process telecommunication signals to make them unintelligible to an unauthorized listener."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fa3f2f4-b923-33ff-a18d-69d691d5e7d4",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To quickly deploy (vehicles, usually aircraft) to a destination in response to an alert, usually to intercept an attacking enemy."
                                        ],
                                        "tags": [
                                            "also",
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6226d6b0-f25e-4abb-b09d-ace01289539c",
                                                "sense_id": "0fa3f2f4-b923-33ff-a18d-69d691d5e7d4",
                                                "text": "But on April 13 it 'scrambled' a rake of Mk 2s and dual-braked 'Black 5' 45212 to start its lucrative summer money-spinner two days later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03e6e381-b01c-3f04-8ba5-d0e091be9a49",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To be quickly deployed in this manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de05be76-b695-4d65-b9a9-b90007c6b673",
                                                "sense_id": "03e6e381-b01c-3f04-8ba5-d0e091be9a49",
                                                "text": "As the planes scrambled, four of his veterans went up: Tom Lanphier, Rex Barber, Joe Moore and Jim McLanahan. They had waited with other Lightnings at 30,000 feet and dived on a formation of eleven Zeroes far below, working in pairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109a81dd-e96a-3b93-a01c-b628557e7b12",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To partake in motocross."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e443cae0-0c01-3949-b550-c4dc3e7eff1f",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To ascend rocky terrain as a leisure activity."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9266984-e583-39b5-8090-7049246df4fa",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To gather or collect by scrambling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28dc113a-0764-493d-af13-24f5444f1a06",
                                                "sense_id": "a9266984-e583-39b5-8090-7049246df4fa",
                                                "text": "They say we are a scatter'd nation: / I cannot tell, but we have scrambled up / More wealth by far than those that brag of faith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc23502-a9ad-3ec6-ac3e-fcafb66b8419",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To struggle eagerly with others for something thrown upon the ground; to go down upon all fours to seize something; to catch rudely at what is desired."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc2e6c40-8e0d-4e64-bb6b-baa64629f38d",
                                                "sense_id": "6cc23502-a9ad-3ec6-ac3e-fcafb66b8419",
                                                "text": "Of other care they little reck'ning make, / Then how to ſcramble at the ſhearers feaſt,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f4695a-d475-3ce5-a9be-9d773b569d00",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To throw something down for others to compete for in this manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a403d7cb-2216-405e-b18c-a1f7d719ebb8",
                                                "sense_id": "17f4695a-d475-3ce5-a9be-9d773b569d00",
                                                "text": "[…] Father Boniface standing on the verandah of the Monastery on a Sunday afternoon “scrambling” lollies to the kids […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "624bc014-25ae-3f02-bcfe-4fa06636c2a6",
                                        "entry_id": "232f4cce-58ce-3d37-baec-c3af99dad41e",
                                        "glosses": [
                                            "To permute parts of a twisty puzzle (especially, Rubik's Cube) until it is ready to be solved from scratch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scramble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44ffdd1c-8e03-336d-83a7-7037485542c5",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A rush or hurry, especially making use of the limbs against a surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97c8604f-3961-4f40-bdaf-29eb3a0935e8",
                                                "sense_id": "44ffdd1c-8e03-336d-83a7-7037485542c5",
                                                "text": "a last-minute scramble to the finish line"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1547a7c-bc64-366d-9563-50e99acee0db",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "An emergency defensive air force mission to intercept attacking enemy aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5b0e983-94cf-4448-9e5c-88ec3e82d7ce",
                                                "sense_id": "e1547a7c-bc64-366d-9563-50e99acee0db",
                                                "text": "1984, Steve Harris, \"Aces High\", Iron Maiden, Powerslave.\nThere goes the siren that warns of the air raid / Then comes the sound of the guns sending flak / Out for the scramble we've got to get airborne / Got to get up for the coming attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b08d6484-93e2-3264-8295-2d0bc5a20e0e",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A motocross race."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82f83c66-cdf4-3675-99fa-4cb16be2e0e5",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "Any frantic period of competitive activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7673e1da-f1ce-4a74-935c-55a172399a96",
                                                "sense_id": "82f83c66-cdf4-3675-99fa-4cb16be2e0e5",
                                                "text": "And the Leeds defence, led by the impressive Alex Bruce, was also in determined mood. Jonathan Howson had to clear a Sebastien Squillaci effort off his line and Becchio was also in the right place to hack clear after a goalmouth scramble."
                                            },
                                            {
                                                "example_id": "706f691f-da3b-49ae-8460-eff80a83cd94",
                                                "sense_id": "82f83c66-cdf4-3675-99fa-4cb16be2e0e5",
                                                "text": "[I]n the 575 days since [Oscar] Pistorius shot dead his girlfriend Reeva Steenkamp, there has been an unseemly scramble to construct revisionist histories, to identify evidence beneath that placid exterior of a pugnacious, hair-trigger personality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f07d0fc7-53ec-3b8d-9ed7-017262e98b7d",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "An impromptu maneuver or run by a quarterback, attempting to gain yardage or avoid being tackled behind the line of scrimmage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1afd186-89d9-315c-b748-06079f77a349",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A statistic used in assessing a player's short game, consisting of a chip or putt from under 50 yards away that results in requiring one putt or less on the green."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f743d2bb-a6ad-351b-95c1-719b9d660be9",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A variant of golf in which each player in a team tees off on each hole, and the players decide which shot was best. Every player then plays their second shot from within a club length of where the best ball has come to rest, and the procedure is repeated until the hole is finished."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac0b0fa8-4037-37e3-941d-746e69e10cf1",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A dish (meal) involving scrambled eggs and a hodgepodge of complementary ingredients, usually closer to a casserole than to an omelette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32305c4-645f-4f1f-bf5d-1d788babe198",
                                                "sense_id": "ac0b0fa8-4037-37e3-941d-746e69e10cf1",
                                                "text": "The diner's menu features \"the farmer's scramble\" (under all-day breakfast) and \"the fisherman's fricassee\" (under dinner entrees)."
                                            },
                                            {
                                                "example_id": "3ac93852-5e4d-4e72-a5e0-1cbee64d9d8e",
                                                "sense_id": "ac0b0fa8-4037-37e3-941d-746e69e10cf1",
                                                "text": "Near-synonym: hash"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1772545-5d18-3651-a35a-d18c413ebed2",
                                        "entry_id": "a8bad4cb-b213-314b-ad97-8342cc7371ef",
                                        "glosses": [
                                            "A venue where enslaved people were auctioned during the Atlantic slave trade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
