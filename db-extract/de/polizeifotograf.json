                "senses": [
                    {
                        "sense_id": "fb2c223b-1509-3138-ba25-dd551ea5b587",
                        "entry_id": "853b2281-1cd7-3e32-a90a-8efee5c70d29",
                        "glosses": [
                            "Fotograf, der für die Polizei arbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29a9042b-b06f-44e6-8a1d-07a1fe5d53a6",
                                "sense_id": "fb2c223b-1509-3138-ba25-dd551ea5b587",
                                "text": "„Von nun an werde ich jeden, der mit dem Fall zu tun hat, als Verdächtigen betrachten, vom Polizeifotografen bis zum Pathologen, und als Erstes brauche ich eine Liste all dieser Leute.“"
                            },
                            {
                                "example_id": "d9941caf-034c-4392-8081-aebfddc91f59",
                                "sense_id": "fb2c223b-1509-3138-ba25-dd551ea5b587",
                                "text": "„Vusi Ndabeni traf den Polizeifotografen am Cat & Moose Youth Hostel and Backpackers Inn und bat die Mitarbeiterin, ihm noch einmal Oliver Sands zu holen.“"
                            },
                            {
                                "example_id": "a1eacf5a-5d0c-4a40-90ba-d6386c60ea75",
                                "sense_id": "fb2c223b-1509-3138-ba25-dd551ea5b587",
                                "text": "„Die Polizeifotografen schossen noch immer Bilder aus allen Winkeln; Lee schrieb weiter in sein Notizbuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
