                "senses": [
                    {
                        "sense_id": "bb3a7af4-2f63-352a-8460-699fe52ac466",
                        "entry_id": "e9e61a2f-261f-3681-919d-48592145063c",
                        "glosses": [
                            "Eigenschaft von Wörtern, zusammen auftreten zu können (kollokabel zu sein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2093e07-e6b0-4b53-80c6-5a10180b8f80",
                                "sense_id": "bb3a7af4-2f63-352a-8460-699fe52ac466",
                                "text": "„Im Hinblick auf [9] (syntagmatische Relationen) wird auf der Ebene des Textkorpus die Kollokabilität, d.h. die kotextuelle Relation zwischen lexikalischen Ausdrücken untersucht.“"
                            },
                            {
                                "example_id": "fd45d95d-97cc-4cd8-b045-c3a3e31908bc",
                                "sense_id": "bb3a7af4-2f63-352a-8460-699fe52ac466",
                                "text": "„Nach den Normen der Kollokabilität sind jedoch bestimmte Verknüpfungen von Wörtern in der englischen Gegenwartssprache nicht akzeptabel.“"
                            },
                            {
                                "example_id": "467684e1-1c9e-4832-9633-d1b85ed648c3",
                                "sense_id": "bb3a7af4-2f63-352a-8460-699fe52ac466",
                                "text": "Ich bin unsicher über die Kollokabilität von »fett«, mit »Kuss« und »Bankkonto« ist sie gegeben, ich kann jemandem einen fetten Kuss geben, und mir ein fettes Bankkonto wünschen, aber kann ich auch mit jemandem fett sein, so wie ich mit jemandem dick sein kann?"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
