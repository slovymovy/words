                "forms": [
                    {
                        "form_id": "8555716a-ff10-4fe8-96c4-eed4c9c0253a",
                        "entry_id": "e907344e-2c2f-3dfc-a08b-6522ec574897",
                        "tags": [
                            "plural"
                        ],
                        "form": "litharges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13213463-48c6-34d3-ab01-0d5c16015f96",
                        "entry_id": "e907344e-2c2f-3dfc-a08b-6522ec574897",
                        "glosses": [
                            "Monoxyde de plomb fondu et cristallisé en lames."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "e4866ddf-3fea-4401-90cc-f9aa4d24a172",
                                "sense_id": "13213463-48c6-34d3-ab01-0d5c16015f96",
                                "text": "Les minerais préparés étaient, depuis la reprise moderne des travaux jusqu'en 1817 , fondus à la mine au moyen de fours à manche ; on y coupelait aussi le plomb pour argent et l'on trouve encore un moulin pour le broyage des litharges."
                            },
                            {
                                "example_id": "475c83a6-7185-4d36-81d2-9818332a097d",
                                "sense_id": "13213463-48c6-34d3-ab01-0d5c16015f96",
                                "text": "La solution de plombite de soude se prépare en faisant bouillir de l'eau contenant 0,1 de potasse ou de soude caustique , 0,15 de litharge."
                            },
                            {
                                "example_id": "b0507180-0edd-4501-8be6-d5bb7ba81512",
                                "sense_id": "13213463-48c6-34d3-ab01-0d5c16015f96",
                                "text": "Il n’est malheureusement que trop aisé de falsifier des boissons telles que le vin, le cidre, l’eau-de-vie. Le marchand, enfermé dans son cellier, compose secrètement ces mixtions, y coule la litharge, ou par avarice ou par ignorance."
                            },
                            {
                                "example_id": "42ad3c6a-9bbe-49ef-bdc3-5ae15578efda",
                                "sense_id": "13213463-48c6-34d3-ab01-0d5c16015f96",
                                "text": "Ancien nom du protoxyde de plomb demi-vitreux."
                            }
                        ]
                    }
                ],
