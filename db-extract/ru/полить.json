                "senses": [
                    {
                        "sense_id": "b30bde99-4521-3f29-ba77-549a91000b29",
                        "entry_id": "0e1e499b-c829-37dc-b063-6b49baf8230f",
                        "glosses": [
                            "смочить струёй воды или какой-либо жидкости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e906f4-2f4a-44b5-9670-fb871180ce54",
                                "sense_id": "b30bde99-4521-3f29-ba77-549a91000b29",
                                "text": "Нарезав, полил уксусом, обильно посыпал солью, посыпал перцем, пустил ещё ложку горчицы и, приготовив забористый салат, поставил на стол для закуски."
                            }
                        ]
                    },
                    {
                        "sense_id": "97f6fcb8-3196-3534-967e-5f996ca6c2e1",
                        "entry_id": "0e1e499b-c829-37dc-b063-6b49baf8230f",
                        "glosses": [
                            "начать лить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbddd537-2063-47df-80b1-05c8d82b6c2a",
                                "sense_id": "97f6fcb8-3196-3534-967e-5f996ca6c2e1",
                                "text": "Полил дождь, загудел ветер, а потом первый мороз сковал землю."
                            }
                        ]
                    }
                ],
