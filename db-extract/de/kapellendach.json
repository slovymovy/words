                "senses": [
                    {
                        "sense_id": "6f6c674e-a94a-3f6e-b4d5-c488b47b5a1a",
                        "entry_id": "39018d6d-ea35-394a-8b82-dcc841dc4579",
                        "glosses": [
                            "obere bauliche Abdeckung eines Kapellengebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2074067-cd89-47e3-99e9-ff5aa14332be",
                                "sense_id": "6f6c674e-a94a-3f6e-b4d5-c488b47b5a1a",
                                "text": "„Das Kapellendach sowie die Wandflächen des Verwaltungsgebäudes wurden mit vorbewitterten Zinkblechen der Firma Rheinzink in Doppel-Stehfalzdeckung ausgeführt.“"
                            },
                            {
                                "example_id": "308690c5-92b1-4dce-bd68-0feacae8ff8c",
                                "sense_id": "6f6c674e-a94a-3f6e-b4d5-c488b47b5a1a",
                                "text": "„Auf dem Kapellendach sitzend, mit seinen dürren Knochen klappernd, suche er laut klagend nach dem verschütteten Zugang zu seinem Labor, wo er mit Leichen und Jungfrauen schaurige Versuche angestellt haben soll.“"
                            },
                            {
                                "example_id": "c9c3e76b-41f6-4d8d-bf66-b2d296dc3536",
                                "sense_id": "6f6c674e-a94a-3f6e-b4d5-c488b47b5a1a",
                                "text": "„Mit der Figur des Gargoyle – der größten, die über dem Kapellendach thront – sind die Arbeiten jetzt abgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
