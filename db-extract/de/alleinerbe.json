                    {
                        "translation_id": "f180db0d-65d6-429a-b36f-a786a66fce58",
                        "source_entry_id": "103741b8-853a-3ab8-929b-439f285ad942",
                        "source_sense_id": "3e520a15-b30e-3a4a-aec9-ac8d97c02082",
                        "source_sense_description": "Person, auf die das gesamte Vermögen des Erblassers mit dem Erbfall übergeht",
                        "target_lang_word": "légataire universel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "légataire universel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06431eea-ae6d-3a77-a35a-92e8bad1d1db",
                                        "entry_id": "1a307d77-3c5b-3afd-87ec-437fe70ccd28",
                                        "glosses": [
                                            "Personne qui reçoit la totalité d’un héritage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db0d139c-3237-4014-94b7-4e3f5db02bea",
                                                "sense_id": "06431eea-ae6d-3a77-a35a-92e8bad1d1db",
                                                "text": "[…], je m'empresse de t'annoncer qu'un certain monsieur Desperriers, natif de Digoin, département de l'Allier, France, vient de décéder, sans enfants, […], et qu'avant son décès, par testament rédigé en bonne et due forme, tu peux m'en croire, je l'ai minuté moi-même, il a institué sa légataire universelle une certaine demoiselle Adèle Desperriers, sa parente éloignée."
                                            },
                                            {
                                                "example_id": "c04812e1-2433-48dc-941e-c1f1bbbbb8fd",
                                                "sense_id": "06431eea-ae6d-3a77-a35a-92e8bad1d1db",
                                                "text": "Je constitue pour mon héritier et légataire universel Pierre de St. Luc, capitaine actuellement à bord du brick « Le Zéphyr » en expédition au Brézil pour mon compte."
                                            },
                                            {
                                                "example_id": "b5fe59ac-4b11-49df-83f5-a6205f9f06f4",
                                                "sense_id": "06431eea-ae6d-3a77-a35a-92e8bad1d1db",
                                                "text": "Celui d’entr’eux qui pleurerait serait déshérité, et, au contraire celui qui rirait du meilleur cœur, serait son principal héritier et son légataire universel."
                                            },
                                            {
                                                "example_id": "e3ae789e-f8ca-4bd3-8e0c-766175a178b4",
                                                "sense_id": "06431eea-ae6d-3a77-a35a-92e8bad1d1db",
                                                "text": "— Comme il y a trois réservataires, la part de Mlle Forut se trouve seulement réduite à la quotité disponible, c'est-à-dire au quart. Mme Rezeau aurait d'ailleurs très bien pu léguer expressément à Mlle Salomé cette quotité disponible : cela revenait au même. Elle a certainement voulu, en l'instituant légataire universelle, exprimer autre chose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
