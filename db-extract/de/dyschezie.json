                                "target_senses": [
                                    {
                                        "sense_id": "8871f04a-8df8-375a-83db-1cc8ada8845c",
                                        "entry_id": "eaccc500-03bb-38c5-a72c-a51616a9e34c",
                                        "glosses": [
                                            "Difficult or painful defecation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9077ec-c590-4fa7-8441-e442252a6820",
                                                "sense_id": "8871f04a-8df8-375a-83db-1cc8ada8845c",
                                                "text": "The diagnostic criteria for infant dyschezia are at least 10 minutes of straining and crying before successful passage of soft stools in an otherwise healthy infant less than six months of age."
                                            },
                                            {
                                                "example_id": "68ea5cc0-02d9-4cee-9e85-e96dcc4959b4",
                                                "sense_id": "8871f04a-8df8-375a-83db-1cc8ada8845c",
                                                "text": "Infant dyschezia can be tough to watch as a parent, but it’s a normal and temporary phase in your baby’s development."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
