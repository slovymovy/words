                ],
                "senses": [
                    {
                        "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                        "entry_id": "5a0cd940-239f-306b-8f1c-00c6d62113b8",
                        "glosses": [
                            "Dokument (als Papier oder Datei), welche(s) für einen Arbeitnehmer vom Arbeitgeber zur Lohnauszahlung erstellt wird, damit der Arbeitnehmer diese Auszahlung kontrollieren kann; es enthält regelmäßig den Bruttolohn, Abgaben und Steuern sowie den Nettolohn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31698d2a-182b-48e1-89cc-34ee88cd71ba",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "„Unsere Software für die Lohnabrechnung streikt, der Techniker ist schon gerufen.“"
                            },
                            {
                                "example_id": "c873d22e-e41c-401d-9330-d525628e6abc",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "Durch den Tarifabschluss werde ich 200 Euro mehr auf der nächsten Lohnabrechnung sehen."
                            },
                            {
                                "example_id": "bbbb5a0b-81a0-4f1b-a939-006cb4501c4c",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "„Der Verdienst für Überstunden kann, muss aber nicht, mit der nächsten Lohnabrechnung ausgezahlt werden.“"
                            },
                            {
                                "example_id": "f455c30e-3647-4148-856d-68525a02edc2",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "„Als Rentner kann man sich von einem Unternehmen einstellen lassen, als ganz regulärer Arbeitnehmer, also mit Lohnabrechnung, Urlaubsanspruch und Fortzahlung im Krankheitsfall.“"
                            },
                            {
                                "example_id": "c4ac84b7-617f-4aaa-aed8-79f58411372e",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "[Gebäudereiniger:] „'Da gab es Kollegen, die haben bis zu drei Monate auf ihr Geld gewartet. Und haben zum Teil die Stunden auch nicht bezahlt gekriegt', sagt der Mitarbeiter. '70 bis 80 Prozent der Lohnabrechnungen haben nicht gestimmt.'“"
                            },
                            {
                                "example_id": "91482fcc-bf3b-476f-ae32-8c986ecdadcd",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "„Haben sich die Tarifparteien einer Branche auf einen Mindestlohn geeinigt, greift hier das Arbeitnehmer-Entsendegesetz. Und mit ihm Mindestarbeitsbedingungen - eine korrekte Lohnabrechnung gehört zwingend dazu […]“"
                            },
                            {
                                "example_id": "3da209ba-dab5-464a-8870-6af57baec604",
                                "sense_id": "9c1304f6-1099-3dca-8065-7a52f72b99b3",
                                "text": "„Beim Geld hört der Spaß auf - das geht Helga Schavoir schon seit Jahren so, wenn sie ihre monatliche Lohnabrechnung anschaut. Denn beim Gehalt wird die 63-Jährige klar benachteiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
