{
    "word_family": [
        "hosiery",
        "hosier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3b9796e-76fe-3340-ad2a-0fc12db4c60b",
                    "sense_definition": "A flexible tube conveying water or other fluid.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tube_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I used the garden <w>hose</w> to water the flowers in the backyard.",
                            "target_lang_translations": {
                                "ru": "Я использовал садовый <w>шланг</w>, чтобы полить цветы на заднем дворе.",
                                "zh": "我用花园<w>软管</w>给后院的花浇水。"
                            }
                        },
                        {
                            "text": "The firefighters quickly connected the heavy <w>hose</w> to the hydrant.",
                            "target_lang_translations": {
                                "ru": "Пожарные быстро подсоединили тяжелый <w>рукав</w> к гидранту.",
                                "zh": "消防员迅速将沉重的<w>水龙带</w>连接到消防栓上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pipe",
                        "tube",
                        "tubing"
                    ],
                    "common_phrases": [
                        "garden hose",
                        "fire hose",
                        "rubber hose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гибкая труба для подачи воды или другой жидкости.",
                        "zh": "用于输送水或其他液体的柔性管子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шланг",
                                "target_lang_sense_clarification": "садовый, технический"
                            },
                            {
                                "target_lang_word": "рукав",
                                "target_lang_sense_clarification": "пожарный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "软管",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "水龙带",
                                "target_lang_sense_clarification": "消防专用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a867cf24-7e38-3880-a418-ef80af5461bc",
                    "sense_definition": "A stocking-like garment worn on the legs; pantyhose or women's tights.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a new pair of sheer <w>hose</w> to wear with her dress.",
                            "target_lang_translations": {
                                "ru": "Она купила новую пару тонких <w>чулок</w>, чтобы надеть их с платьем.",
                                "zh": "她买了一双新的薄<w>长筒袜</w>来搭配她的裙子。"
                            }
                        },
                        {
                            "text": "Nurses often wear support <w>hose</w> to keep their legs comfortable during long shifts.",
                            "target_lang_translations": {
                                "ru": "Медсестры часто носят компрессионные <w>чулки</w>, чтобы ноги не уставали во время долгих смен.",
                                "zh": "护士经常穿压力<w>长筒袜</w>，以保持双腿在长时间轮班时的舒适感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stockings",
                        "tights",
                        "pantyhose"
                    ],
                    "common_phrases": [
                        "pair of hose",
                        "support hose"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чулочное изделие, надеваемое на ноги; чулки или колготки.",
                        "zh": "穿在腿上的袜类服装，如长筒袜或连裤袜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чулки",
                                "target_lang_sense_clarification": "предмет одежды"
                            },
                            {
                                "target_lang_word": "колготки",
                                "target_lang_sense_clarification": "женские"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长筒袜",
                                "target_lang_sense_clarification": "服装"
                            },
                            {
                                "target_lang_word": "连裤袜",
                                "target_lang_sense_clarification": "女性服装"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f2415c6-68f2-3113-be50-4e26a7c95ce8",
                    "sense_definition": "Close-fitting trousers or breeches, reaching to the knee, worn by men in the past.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor wore a velvet doublet and <w>hose</w> for the Renaissance play.",
                            "target_lang_translations": {
                                "ru": "Актер был одет в бархатный камзол и <w>шоссы</w> для пьесы эпохи Возрождения.",
                                "zh": "演员在文艺复兴时期的戏剧中穿着天鹅绒上衣和<w>紧身裤</w>。"
                            }
                        },
                        {
                            "text": "In medieval illustrations, men are frequently depicted wearing colorful <w>hose</w>.",
                            "target_lang_translations": {
                                "ru": "На средневековых иллюстрациях мужчины часто изображены в разноцветных <w>шоссах</w>.",
                                "zh": "在中世纪的插图中，男性经常被描绘成穿着色彩鲜艳的<w>紧身裤</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "breeches"
                    ],
                    "common_phrases": [
                        "doublet and hose"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Облегающие штаны или бриджи до колен, которые мужчины носили в прошлом.",
                        "zh": "古代男性穿着的紧身裤或及膝短裤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоссы",
                                "target_lang_sense_clarification": "исторический термин"
                            },
                            {
                                "target_lang_word": "штаны-чулки",
                                "target_lang_sense_clarification": "историческая одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧身裤",
                                "target_lang_sense_clarification": "历史服装"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc57aa1a-7912-3b81-a32a-aaa135fd62ca",
                    "sense_definition": "To water, wash, or spray something with a hose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tube_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>hose</w> down the muddy car before scrubbing it.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>помыть из шланга</w> грязную машину, прежде чем тереть её.",
                                "zh": "在擦洗之前，我们需要先用软管把满是泥的汽车<w>冲洗</w>干净。"
                            }
                        },
                        {
                            "text": "He <w>hosed</w> the garden thoroughly because it had been a very hot day.",
                            "target_lang_translations": {
                                "ru": "Он тщательно <w>полил из шланга</w> сад, потому что день был очень жарким.",
                                "zh": "因为那天天气非常热，他彻底地<w>浇灌</w>了花园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spray",
                        "wash",
                        "water"
                    ],
                    "common_phrases": [
                        "hose down",
                        "hose off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поливать, мыть или обдавать что-либо водой из шланга.",
                        "zh": "用软管喷水冲洗或浇灌某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поливать из шланга",
                                "target_lang_sense_clarification": "растения, сад"
                            },
                            {
                                "target_lang_word": "мыть из шланга",
                                "target_lang_sense_clarification": "машину, двор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲洗",
                                "target_lang_sense_clarification": "用软管清洁"
                            },
                            {
                                "target_lang_word": "浇灌",
                                "target_lang_sense_clarification": "用软管浇水"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0522f331-4f5a-36c4-a1ac-0755ce8f20a5",
                    "sense_definition": "To trick, deceive, or treat someone unfairly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slang_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I feel like I got <w>hosed</w> on that deal at the car dealership.",
                            "target_lang_translations": {
                                "ru": "У меня такое чувство, что меня <w>надули</w> с этой сделкой в автосалоне.",
                                "zh": "我觉得我在那家汽车经销商的交易中被<w>坑</w>了。"
                            }
                        },
                        {
                            "text": "The team was <w>hosed</w> by a bad call from the referee in the final minute.",
                            "target_lang_translations": {
                                "ru": "Команду <w>засудили</w> из-за ошибки арбитра на последней минуте.",
                                "zh": "球队在最后一分钟因为裁判的一次误判而被<w>坑</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cheat",
                        "trick",
                        "swindle"
                    ],
                    "common_phrases": [
                        "get hosed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обмануть, провести или поступить с кем-то несправедливо.",
                        "zh": "欺骗、坑害或不公平地对待某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надуть",
                                "target_lang_sense_clarification": "обмануть"
                            },
                            {
                                "target_lang_word": "обмануть",
                                "target_lang_sense_clarification": "поступить нечестно"
                            },
                            {
                                "target_lang_word": "кинуть",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坑",
                                "target_lang_sense_clarification": "口语，欺骗"
                            },
                            {
                                "target_lang_word": "欺骗",
                                "target_lang_sense_clarification": "不公平对待"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5d8c76a-ae2f-3e12-b2d3-a32aa269ae40",
                    "sense_definition": "To break or destroy a computer system or software, especially by wiping files.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Installing that corrupt driver completely <w>hosed</w> my operating system.",
                            "target_lang_translations": {
                                "ru": "Установка этого поврежденного драйвера окончательно <w>угробила</w> мою операционную систему.",
                                "zh": "安装那个损坏的驱动程序彻底<w>搞坏</w>了我的操作系统。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>hose</w> the server when you update the configuration files.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>положить</w> сервер при обновлении файлов конфигурации.",
                                "zh": "更新配置文件时要小心，不要把服务器<w>弄瘫</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "ruin",
                        "destroy"
                    ],
                    "antonyms": [
                        "fix",
                        "repair"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сломать или разрушить компьютерную систему или программное обеспечение.",
                        "zh": "弄坏或破坏计算机系统或软件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угробить",
                                "target_lang_sense_clarification": "систему, программу"
                            },
                            {
                                "target_lang_word": "сломать",
                                "target_lang_sense_clarification": "компьютерный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞坏",
                                "target_lang_sense_clarification": "计算机系统"
                            },
                            {
                                "target_lang_word": "弄瘫",
                                "target_lang_sense_clarification": "使系统无法运行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f32cea3e-4a74-3228-9ca9-72145f8d51f3",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hose</w> has lived in this neighborhood for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хоуз</w> живет в этом районе уже более двадцати лет.",
                                "zh": "<w>霍斯</w>先生在这个社区已经住了二十多年了。"
                            }
                        },
                        {
                            "text": "We are looking for a record of a Sarah <w>Hose</w> in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы ищем запись о Саре <w>Хоуз</w> в архивах.",
                                "zh": "我们正在档案中寻找萨拉·<w>霍斯</w>的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хоуз",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霍斯",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d38e3127-f318-3582-8d18-281c12e11111",
                    "sense_definition": "A village in Leicestershire, England.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Hose</w> during their trip to England.",
                            "target_lang_translations": {
                                "ru": "Они посетили небольшую деревню <w>Хоуз</w> во время поездки в Англию.",
                                "zh": "他们在英国旅行期间参观了<w>霍斯</w>这个小村庄。"
                            }
                        },
                        {
                            "text": "The parish council meeting was held in the <w>Hose</w> village hall.",
                            "target_lang_translations": {
                                "ru": "Заседание приходского совета проходило в деревенском зале <w>Хоуз</w>.",
                                "zh": "教区议会会议在<w>霍斯</w>村政厅举行。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в Лестершире, Англия.",
                        "zh": "英国莱斯特郡的一个村庄。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хоуз",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "霍斯",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}