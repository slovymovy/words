                    {
                        "translation_id": "5b4bb761-a6e7-413e-9184-f5f507b05fba",
                        "source_entry_id": "8bb65edf-5c57-3fec-883d-52cc75b83dd8",
                        "source_sense_id": "628f6631-d355-388e-8169-59ff875df23d",
                        "target_lang_word": "tayer",
