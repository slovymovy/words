                                        "glosses": [
                                            "The smallest, outermost toe on human feet."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a25db26-3c52-44b4-84f7-a3ca08614d91",
                                                "sense_id": "574296bd-f279-36ca-9fc3-ad7f55540ffc",
                                                "text": "[…]Esther hobbled, blowing gasps of pain, her pinky toe stubbed."
                                            },
                                            {
                                                "example_id": "7b671de5-6d67-42cd-9ba9-2bee0a4b9129",
                                                "sense_id": "574296bd-f279-36ca-9fc3-ad7f55540ffc",
                                                "text": "One of these visits included a winter Camping trip I dreamed up, which turned into a minor disaster for me because I caught frostbite and had to have my right pinky toe amputated two weeks later."
                                            },
                                            {
                                                "example_id": "38554b06-e497-4df0-b265-d79f0ae4260c",
                                                "sense_id": "574296bd-f279-36ca-9fc3-ad7f55540ffc",
                                                "text": "Over the next six days I had three more operations. The last one lasting 12 hours. The doctors had used my stomach muscle to replace the lost foot tissue. They sewed the blood vessels together. They also moved the pinky toe to the place of my missing fourth toe."
                                            }
                                        ]
                                    }
                                ]
