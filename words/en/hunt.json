{
    "word_family": [
        "hunter",
        "hunting",
        "huntsman",
        "huntress"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3444f1f-72b0-350a-bce0-dd0ff6f7d3fa",
                    "sense_definition": "To find or search for an animal in the wild with the intention of killing it for meat or sport.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lions <w>hunt</w> zebras on the open savannah to feed their pride.",
                            "target_lang_translations": {
                                "ru": "Львы <w>охотятся</w> на зебр в открытой саванне, чтобы прокормить свой прайд.",
                                "zh": "狮子在开阔的草原上<w>狩猎</w>斑马以喂养它们的狮群。"
                            }
                        },
                        {
                            "text": "He likes to <w>hunt</w> for deer in the forest during the autumn season.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>охотиться</w> на оленей в лесу в осенний сезон.",
                                "zh": "他喜欢在秋季去森林里<w>打猎</w>鹿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stalk",
                        "chase",
                        "track"
                    ],
                    "common_phrases": [
                        "hunt for food",
                        "hunt game",
                        "go hunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преследовать диких животных с целью добычи или спорта.",
                        "zh": "在野外寻找并捕杀动物以获取肉食或作为运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охо́титься",
                                "target_lang_sense_clarification": "преследовать добычу"
                            },
                            {
                                "target_lang_word": "лови́ть",
                                "target_lang_sense_clarification": "добывать (рыбу, зверей)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狩猎",
                                "target_lang_sense_clarification": "捕杀野生动物"
                            },
                            {
                                "target_lang_word": "打猎",
                                "target_lang_sense_clarification": "进行狩猎活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8a660ad-8c37-3b56-8f16-d53b468f6afe",
                    "sense_definition": "To try to find something or someone by looking carefully.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verb_search",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to <w>hunt</w> for my keys because I lost them somewhere in the house.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>поискать</w> свои ключи, потому что я потерял их где-то в доме.",
                                "zh": "我得<w>寻找</w>我的钥匙，因为我把它们弄丢在屋里的某个地方了。"
                            }
                        },
                        {
                            "text": "The detectives continue to <w>hunt</w> for clues at the crime scene.",
                            "target_lang_translations": {
                                "ru": "Детективы продолжают <w>искать</w> улики на месте преступления.",
                                "zh": "侦探们继续在犯罪现场<w>搜寻</w>线索。"
                            }
                        }
                    ],
                    "synonyms": [
                        "search",
                        "seek",
                        "look for",
                        "scour"
                    ],
                    "common_phrases": [
                        "hunt for a job",
                        "hunt for clues",
                        "house hunting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытаться найти что-то или кого-то, тщательно осматривая места.",
                        "zh": "通过仔细寻找来试图找到某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иска́ть",
                                "target_lang_sense_clarification": "заниматься поисками"
                            },
                            {
                                "target_lang_word": "разы́скивать",
                                "target_lang_sense_clarification": "вести активные поиски"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "寻找",
                                "target_lang_sense_clarification": "搜寻某物"
                            },
                            {
                                "target_lang_word": "搜寻",
                                "target_lang_sense_clarification": "积极地寻找"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a88e33bd-b504-31e6-af81-ddd9e5e481f9",
                    "sense_definition": "To pursue someone relentlessly in order to capture them or drive them away.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_pursue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police promised to <w>hunt</w> down the criminal responsible for the robbery.",
                            "target_lang_translations": {
                                "ru": "Полиция пообещала <w>разыскать</w> преступника, ответственного за ограбление.",
                                "zh": "警方承诺一定会<w>追捕</w>到那名抢劫案的罪犯。"
                            }
                        },
                        {
                            "text": "They were <w>hunted</w> from their homes by the invading army.",
                            "target_lang_translations": {
                                "ru": "Вторгшаяся армия <w>выгнала</w> их из собственных домов.",
                                "zh": "他们被入侵的军队<w>驱逐</w>出了家园。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pursue",
                        "chase",
                        "track down"
                    ],
                    "antonyms": [
                        "flee",
                        "escape"
                    ],
                    "common_phrases": [
                        "hunt down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотступно преследовать кого-либо с целью поимки или изгнания.",
                        "zh": "紧追不舍以抓捕或驱逐某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пресле́довать",
                                "target_lang_sense_clarification": "гнаться за кем-либо"
                            },
                            {
                                "target_lang_word": "высле́живать",
                                "target_lang_sense_clarification": "искать по следам"
                            },
                            {
                                "target_lang_word": "трави́ть",
                                "target_lang_sense_clarification": "преследовать (перен.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追捕",
                                "target_lang_sense_clarification": "追赶并抓捕"
                            },
                            {
                                "target_lang_word": "搜捕",
                                "target_lang_sense_clarification": "搜寻并抓捕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b77ce287-513b-3f1a-bfd7-5a3bd901c79a",
                    "sense_definition": "To oscillate or fluctuate around a desired speed or position due to instability in a machine or system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine began to <w>hunt</w> for the correct idle speed after the cold start.",
                            "target_lang_translations": {
                                "ru": "После холодного запуска обороты двигателя начали <w>плавать</w> в поиске холостого хода.",
                                "zh": "冷启动后，发动机开始<w>振荡</w>以寻找正确的怠速。"
                            }
                        },
                        {
                            "text": "If the governor is too sensitive, the mechanism will <w>hunt</w> continuously without settling.",
                            "target_lang_translations": {
                                "ru": "Если регулятор слишком чувствителен, механизм будет непрерывно <w>рыскать</w>, не стабилизируясь.",
                                "zh": "如果调速器过于敏感，该机构将持续<w>摆动</w>而无法稳定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oscillate",
                        "fluctuate"
                    ],
                    "antonyms": [
                        "stabilize"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical jargon in engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Колебаться вокруг заданного значения из-за нестабильности системы (технический термин).",
                        "zh": "指机器或系统因不稳定而在目标速度或位置附近波动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ры́скать",
                                "target_lang_sense_clarification": "совершать неустойчивые движения"
                            },
                            {
                                "target_lang_word": "колеба́ться",
                                "target_lang_sense_clarification": "быть нестабильным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "振荡",
                                "target_lang_sense_clarification": "系统不稳定导致的波动"
                            },
                            {
                                "target_lang_word": "摆动",
                                "target_lang_sense_clarification": "数值在目标值附近不稳定"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "92e4898d-4aeb-3ddd-843b-dc288d5f5bb2",
                    "sense_definition": "The act of chasing wild animals to catch or kill them.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hunt</w> lasted for several hours before they finally caught the fox.",
                            "target_lang_translations": {
                                "ru": "<w>Охота</w> длилась несколько часов, прежде чем они наконец поймали лису.",
                                "zh": "<w>狩猎</w>持续了几个小时，他们最终抓住了那只狐狸。"
                            }
                        },
                        {
                            "text": "He enjoyed the thrill of the <w>hunt</w> more than the actual catch.",
                            "target_lang_translations": {
                                "ru": "Он наслаждался азартом <w>охоты</w> больше, чем самой добычей.",
                                "zh": "他享受<w>狩猎</w>带来的刺激感，胜过最终的捕获。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chase",
                        "pursuit",
                        "stalking"
                    ],
                    "common_phrases": [
                        "on the hunt",
                        "thrill of the hunt",
                        "fox hunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс преследования диких животных с целью их поимки или отстрела.",
                        "zh": "追捕野生动物以进行捕获或杀戮的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охо́та",
                                "target_lang_sense_clarification": "действие, занятие"
                            },
                            {
                                "target_lang_word": "ло́вля",
                                "target_lang_sense_clarification": "добыча животных или рыбы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狩猎",
                                "target_lang_sense_clarification": "狩猎活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b6ba41e-7265-3450-b4f4-12033dfa7133",
                    "sense_definition": "An organization of people or a group of animals devoted to hunting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>hunt</w> gathers every Saturday morning during the season.",
                            "target_lang_translations": {
                                "ru": "Местный <w>охотничий клуб</w> собирается каждое субботнее утро в течение сезона.",
                                "zh": "当地的<w>狩猎队</w>在狩猎季节的每周六早上集合。"
                            }
                        },
                        {
                            "text": "Members of the <w>hunt</w> wore traditional red coats for the event.",
                            "target_lang_translations": {
                                "ru": "Члены <w>охотничьего клуба</w> надели традиционные красные сюртуки для этого события.",
                                "zh": "<w>狩猎队</w>的成员们穿着传统的红色外套参加了活动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "join the hunt",
                        "master of the hunt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация людей или группа животных, занимающихся охотой.",
                        "zh": "专门从事狩猎活动的团体或组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охо́тничий клуб",
                                "target_lang_sense_clarification": "организация"
                            },
                            {
                                "target_lang_word": "охо́та",
                                "target_lang_sense_clarification": "группа участников (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狩猎队",
                                "target_lang_sense_clarification": "狩猎组织"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7e57ed8c-8bcb-3941-9831-3ccee5604a14",
                    "sense_definition": "An English surname originating as an occupation for a hunter.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hunt</w> has been our neighbor for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хант</w> был нашим соседом более двадцати лет.",
                                "zh": "<w>亨特</w>先生做我们的邻居已经二十多年了。"
                            }
                        },
                        {
                            "text": "The <w>Hunt</w> family reunion will be held in the park this summer.",
                            "target_lang_translations": {
                                "ru": "Воссоединение семьи <w>Хант</w> пройдет в парке этим летом.",
                                "zh": "<w>亨特</w>家族聚会将于今年夏天在公园举行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от названия профессии охотника.",
                        "zh": "源自猎人职业的英语姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хант",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亨特",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c52ffe2d-76d7-3692-81d6-098adf929faf",
                    "sense_definition": "A male given name transferred from the surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_given",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Hunt</w> is coming to the meeting later this afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Хант</w> придет на встречу сегодня во второй половине дня.",
                                "zh": "<w>亨特</w>今天下午晚些时候会来参加会议。"
                            }
                        },
                        {
                            "text": "We named our son <w>Hunt</w> after his grandfather.",
                            "target_lang_translations": {
                                "ru": "Мы назвали нашего сына <w>Хант</w> в честь его дедушки.",
                                "zh": "我们以他祖父的名字为我们的儿子取名为<w>亨特</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, образованное от фамилии.",
                        "zh": "源自姓氏的男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хант",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亨特",
                                "target_lang_sense_clarification": "名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e3c2fd1-5cf6-37b0-bac4-86cf3cb09588",
                    "sense_definition": "A place name for various locations in the United States, such as communities in Ohio and Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in <w>Hunt</w> to refuel during their road trip across Texas.",
                            "target_lang_translations": {
                                "ru": "Они остановились в <w>Ханте</w>, чтобы заправиться во время поездки по Техасу.",
                                "zh": "他们在穿越德克萨斯州的公路旅行中，在<w>亨特</w>停下来加油。"
                            }
                        },
                        {
                            "text": "The small community of <w>Hunt</w> is known for its quiet atmosphere.",
                            "target_lang_translations": {
                                "ru": "Небольшое сообщество <w>Хант</w> известно своей спокойной атмосферой.",
                                "zh": "<w>亨特</w>这个小社区以其宁静的氛围而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название различных населенных пунктов в США.",
                        "zh": "美国境内某些地点的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хант",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "亨特",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}