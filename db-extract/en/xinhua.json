                "senses": [
                    {
                        "sense_id": "3d2a8c20-5d8d-3e02-a8f6-4e1035aa14ab",
                        "entry_id": "5a9996b4-41a6-3bcf-a21d-41e31ca9a004",
                        "glosses": [
                            "A district of Shijiazhuang, Hebei, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf3a60b-03bc-4784-860d-f32abbf4dde2",
                                "sense_id": "3d2a8c20-5d8d-3e02-a8f6-4e1035aa14ab",
                                "text": "In a move hailed by some as a step towards promoting business morality and branded as basically Orwellian by others, the country’s first community credit and reputation file system was launched in the Xinhua district of Shijiazhuang, Hebei province, on March 20, according to a report run in China Youth Daily June 9."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f5de3a0-8cfb-305b-bcd2-ed84619b6910",
                        "entry_id": "5a9996b4-41a6-3bcf-a21d-41e31ca9a004",
                        "glosses": [
                            "A district of Pingdingshan, Henan, China."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4282a20c-29c2-37bc-92ea-6f1e3ade4d6d",
                        "entry_id": "5a9996b4-41a6-3bcf-a21d-41e31ca9a004",
                        "glosses": [
                            "A town in Shennongjia, Hubei, China."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84c1e139-40cf-30dd-b2e1-01d0c95ac020",
                        "entry_id": "5a9996b4-41a6-3bcf-a21d-41e31ca9a004",
                        "glosses": [
                            "Ellipsis of Xinhua News Agency (新华社), the New China News Agency (新华通讯社); the government news agency of the People's Republic of China: XNA."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "02c734e9-25bf-40c5-b912-47376e83f92e",
                                "sense_id": "84c1e139-40cf-30dd-b2e1-01d0c95ac020",
                                "text": "China's official news agency said Saturday it will adopt the Chinese Pinyin phonetic alphabet beginning Jan. 1, when Peking will become Beijing (pronounced bay-jing) and the agency Xinhua instead of Hsinhua."
                            },
                            {
                                "example_id": "e7299fdf-0130-4a2f-bb65-4d387471ad0e",
                                "sense_id": "84c1e139-40cf-30dd-b2e1-01d0c95ac020",
                                "text": "The “Hsinhua News Agency,” in a wire report from Canton, said that “Yeh Chien-ying, accompanied by Wang Cheng, member of the politburo, has visited Chuhai and other places in Kwangtung province.”"
                            },
                            {
                                "example_id": "0c5e4747-624f-4832-be00-846385b43c0c",
                                "sense_id": "84c1e139-40cf-30dd-b2e1-01d0c95ac020",
                                "text": "The explosion took place at the Xinxing Coal Mine in Hegang City, in Heilongjiang province, according to the official Xinhua news agency."
                            },
                            {
                                "example_id": "38e7e3b8-3423-480d-aad3-ebf57190afa1",
                                "sense_id": "84c1e139-40cf-30dd-b2e1-01d0c95ac020",
                                "text": "While in Lhasa, Xi visited a monastery and \"inspected ethnic religion\" and Tibetan cultural heritage protection, according to Xinhua."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4683c42b-a3a6-3af5-adbe-b280bc8b06ec",
                "word": "Xinhua",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ebc87699-f569-3438-8836-adba824b90a3",
                        "entry_id": "4683c42b-a3a6-3af5-adbe-b280bc8b06ec",
                        "glosses": [
                            "A county of Loudi, Hunan, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a805cff-2832-4c9d-9d5f-a99d568c7c2c",
                                "sense_id": "ebc87699-f569-3438-8836-adba824b90a3",
                                "text": "Chen Tianhua [1875-1905] was a young man from Xinhua district in Hunan province."
                            },
                            {
                                "example_id": "d38a1f8a-afdc-4c1f-b969-21dc2b82eb84",
                                "sense_id": "ebc87699-f569-3438-8836-adba824b90a3",
                                "text": "By official decree, Langtang is a contented place, a town of 82,000 spread across 24 villages in Hunan Province where extreme poverty has been eliminated, crime is under control and schools are prospering.[…]\nBut the people of Langtang experience a different reality. Incomes, while rising, remain stubbornly low, around $1,500 a year in the surrounding villages of Xinhua County, compared with the national average of $2,500 in rural areas."
                            }
                        ]
                    },
                    {
                        "sense_id": "09ad6b58-7c6b-3256-a9f6-e04631cdf48a",
                        "entry_id": "4683c42b-a3a6-3af5-adbe-b280bc8b06ec",
                        "glosses": [
                            "Alternative form of Sinhua (Taiwan)"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "a90d2654-a2b7-432a-a409-e69a4d81cec8",
                                "sense_id": "09ad6b58-7c6b-3256-a9f6-e04631cdf48a",
                                "text": "On the face of it, Tainan is ethnically homogeneous. Almost everyone, it seems, is descended from Han Chinese who came to Taiwan two or more centuries ago. That's what most people believe, anyhow. The leaders of the Xinhua-based Siraya Culture Association think otherwise, arguing that many Tainan folk are indigenous even if they don't know it.[...]You won't hear Siraya spoken in Xinhua, but here are a few words to impress - or baffle - the locals: tabe is hello; tatalag means welcome; alid means god, while alilid means to thank."
                            },
                            {
                                "example_id": "3995a2fb-650c-40ec-9e80-230090c4164b",
                                "sense_id": "09ad6b58-7c6b-3256-a9f6-e04631cdf48a",
                                "text": "Harris grew up in Florida. “There were always snakes around, and I was always very interested in them,” he says. Seeing any snake in Florida was noteworthy, he remembers, but when he goes out herping in the woodlands of Tainan City’s Xinhua District, “with a decent flashlight, you might see a dozen individuals of seven different species. And more than half of them would be venomous.”"
                            },
                            {
                                "example_id": "30f9a7fc-68f2-4c3c-9206-80f613ce8a00",
                                "sense_id": "09ad6b58-7c6b-3256-a9f6-e04631cdf48a",
                                "text": "The Tainan City Government is banking on a nearly completed fruit and vegetable market in Xinhua District becoming not only a comfortable environment for shopping but also a tourist magnet."
                            }
                        ]
                    }
                ],
