                ],
                "senses": [
                    {
                        "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                        "entry_id": "8010f6e4-530c-3358-8d08-d944178e609b",
                        "glosses": [
                            "Flüssigkeit mit dem Geruch des Lavendels, die mit einem Gerät in feinsten Teilchen versprüht, zerstäubt wird, um etwas gut riechen zu lassen; Spray mit Lavendelduft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8107f159-f473-4a3e-8c77-d98fd4032c08",
                                "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                                "text": "„Die Sitze waren mit weißen Baumwolltüchern abgedeckt, die Luft mit Lavendelspray aufgefrischt worden.“"
                            },
                            {
                                "example_id": "a2ce1f91-ce1b-4e17-b333-17158f652f10",
                                "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                                "text": "„Ein Spritzer Lavendelspray auf das Hotelbett lässt uns schneller einschlafen und ist etwas, das man problemlos mitnehmen kann.“"
                            },
                            {
                                "example_id": "a7bd37a8-5f48-486f-84df-4823e61ccbc4",
                                "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                                "text": "„Im ganzen Raum hängt der Geruch von Lavendelspray, das den abgestandenen Zigarettengestank nicht recht übertünchen kann.“"
                            },
                            {
                                "example_id": "68a9b26d-3e59-40f8-b91a-e0c0cea753f8",
                                "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                                "text": "„Und gerade in unserer völlig überfüllten Wohnung brauche ich besonders dringend zwei gemütliche Quadratmeter, die nach beruhigendem Lavendelspray duften.“"
                            },
                            {
                                "example_id": "e1a457f3-6e8d-4345-99cf-a8b5d4296932",
                                "sense_id": "b756b9ed-ada2-3697-856b-7024bffce0d7",
                                "text": "„Alles ist ordentlich und sauber, durch das Haus schwebt ein Geruch von Putzmitteln und das synthetische Aroma eines Lavendelsprays.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
