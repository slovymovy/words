                "senses": [
                    {
                        "sense_id": "218769b1-0d2e-3352-809f-d0aeb12edd46",
                        "entry_id": "539653fd-4428-34c1-b18f-f981033dcced",
                        "glosses": [
                            "Donner un caractère teuton à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5397b3-8c64-4351-b1c2-aae9dd911a89",
                                "sense_id": "218769b1-0d2e-3352-809f-d0aeb12edd46",
                                "text": "Ils faisaient même à la Lorraine l'honneur de la teutoniser, honneur dont nos Leuçois ne sont pas très-jaloux."
                            },
                            {
                                "example_id": "ac058915-cd9d-4821-8b56-60f9dc41581c",
                                "sense_id": "218769b1-0d2e-3352-809f-d0aeb12edd46",
                                "text": "Quant au radical Lov. c'est la quadrature du cercle! Nous l’abandonnons aux étymologistes, ils peuvent le celtiquer, le krimniser, le latiniser, le teutoniser, le romaniser et le wallonniser, mais nous croyons qu’ils n'en feront jamais rien sortir sortir que le loup."
                            },
                            {
                                "example_id": "a03ba863-8fcb-4aed-93df-ffc46fe9da90",
                                "sense_id": "218769b1-0d2e-3352-809f-d0aeb12edd46",
                                "text": "Jouez le jeu de la FFVL avant de vous teutoniser."
                            }
                        ]
                    }
