                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f36cdd-65fe-4a95-ae1c-df0415896518",
                                "sense_id": "6b0d1403-f668-39f0-85d5-bca6c7199252",
                                "text": "„Ist der Machtkampf zwischen der Politik und den Internetkonzernen also schon entschieden, bevor er überhaupt begonnen hat?“"
                            },
                            {
                                "example_id": "03e72ac1-ef38-4e50-ac61-2c91fbc3b7d9",
                                "sense_id": "6b0d1403-f668-39f0-85d5-bca6c7199252",
                                "text": "„Wie kann die digitale Wirtschaft ausgebaut werden, ohne die bürgerlichen Freiheitsrechte zu verkaufen und die Menschen monopolartigen Internetkonzernen auszuliefern?“"
                            }
                        ],
