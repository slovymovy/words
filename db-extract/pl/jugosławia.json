                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d2f7eb5-fc87-356d-8392-cbd2c1ea8310",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe in the Balkans, now split into 6 countries: Bosnia and Herzegovina, Croatia, North Macedonia, Montenegro, Serbia, and Slovenia.",
                                            "The Socialist Federal Republic of Yugoslavia, a communist state which existed from 1945 to 1992."
                                        ],
                                        "tags": [
                                            "historical",
                                            "specific"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f70b9f6c-beee-33ea-afa1-985f1ffd1eee",
                                        "entry_id": "714be8a2-da04-3d72-a223-42a8aee982d8",
                                        "glosses": [
                                            "A former country in Southeast Europe, a rump state formed by Serbia and Montenegro after 1992; in full, Federal Republic of Yugoslavia."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a057d30-f368-438c-8031-cfa07540ffe4",
                                                "sense_id": "f70b9f6c-beee-33ea-afa1-985f1ffd1eee",
                                                "text": "Yugoslavia’s President, Slobodan Milosevic, has rejected all efforts at meaningful diplomacy and, in violation of his own previous commitments, has ratcheted up his military campaign against the innocent civilians of Kosovo."
                                            }
                                        ]
                                    },
