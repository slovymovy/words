                        "cross_references": []
                    },
                    {
                        "translation_id": "080f23bc-189c-4a5a-abb2-eb52f78f2c05",
                        "source_entry_id": "bd32dac4-c5f0-3439-9ef0-4c46c6ff51aa",
                        "source_sense_id": "e18e41fa-2824-3041-a9db-f1ff7d5dd3f3",
                        "source_sense_description": "geringer geistiger Wert, nur der Unterhaltung dienend",
                        "target_lang_word": "simplicité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simplicité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "48440acc-6c91-3405-bae8-2587245efbdb",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Qualité de ce qui n’est pas composé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543f069e-38fe-4a36-b62e-23a02cb94e27",
                                                "sense_id": "48440acc-6c91-3405-bae8-2587245efbdb",
                                                "text": "Le lendemain, j’ai vu la chambre dans la simplicité de la lumière du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Caractère de ce qui n’est pas compliqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d3b6040-1f13-4e81-b72c-814dcc5790c7",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Le mécanisme de ce cylindre, quoique de la dernière simplicité, ne fut d'abord que très-embrouillé dans ma tête; mais, en attendant que mes premières idées se nettoyassent, je fus si aise de les avoir eues, que j'en tressaillis, […]."
                                            },
                                            {
                                                "example_id": "b5466bc1-a1c5-438f-b522-e9c4ee82b520",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Quels termes saurai-je trouver, suffisamment simples dans leur sublimité, — suffisamment sublimes dans leur simplicité, — pour la simple énonciation de mon thème ?"
                                            },
                                            {
                                                "example_id": "58aa93c5-0aab-42b2-8983-4a356cbec685",
                                                "sense_id": "37a71f43-a819-3c02-a011-05c997b66536",
                                                "text": "Même s’ils en font rêver plus d’un, tout le monde n’investit pas des tracteurs high-tech. À tous ceux qui recherchent la simplicité et l’efficacité avant tout, cet essai est fait pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Caractère de ce qui est sans apprêt, sans recherche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d06f1ecf-1b1e-4f73-ab8d-1e6d261697d2",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "Il est d’une grande simplicité dans ses vêtements, dans ses manières, dans son langage."
                                            },
                                            {
                                                "example_id": "5819cdd9-d672-417a-8c4a-46d6ae134118",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "Cet écrivain a une grande simplicité de style."
                                            },
                                            {
                                                "example_id": "723a11f8-5dcc-4da7-8e8d-35564f4096fb",
                                                "sense_id": "1f112eee-cc45-317e-a5b4-cf6eec2acbe7",
                                                "text": "D'ailleurs, j'aime rappeler que la simplicité n'est nullement absence de profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Qualité de ce qui est sans détours, sans déguisement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbee7f22-9a16-4bb7-8778-74b43a0b88ca",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Pendant un moment, la morgue germanique lutta en lui avec la simplicité anglaise, et aussi avec sa bienveillance naturelle et sa loquacité, et elle eut le dessous."
                                            },
                                            {
                                                "example_id": "15d29628-0ada-4d50-bb4e-c174dd9aec9e",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "La simplicité d’un enfant."
                                            },
                                            {
                                                "example_id": "e1c77d9c-8045-42ee-938e-9173ca876e15",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Simplicité de cœur."
                                            },
                                            {
                                                "example_id": "9925e14d-2e8d-4e78-8595-61d7bc9afac2",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "Aimable simplicité."
                                            },
                                            {
                                                "example_id": "39b3541b-a7d6-4e47-b7b2-ab85128f0e84",
                                                "sense_id": "2d468048-1754-3a32-b216-60a6fbdd94d8",
                                                "text": "La simplicité a deux sœurs : la grâce et la dignité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                        "entry_id": "edea1c99-c964-3fe1-be09-a9b5d2682c9e",
                                        "glosses": [
                                            "Naïveté, trop grande facilité à croire, à se laisser tromper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a19e09f-d971-4290-ab41-c5acbcb4ab03",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "Je ne vis jamais une si grande simplicité."
                                            },
                                            {
                                                "example_id": "51af5216-dacc-4751-ab77-75d563b31b82",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "C’est une grande simplicité de croire cela."
                                            },
                                            {
                                                "example_id": "1b4abbb6-e5ba-4ef7-8ecb-164ede338496",
                                                "sense_id": "a941a0fa-6759-383f-ae7f-281edbea2876",
                                                "text": "Il y a de la simplicité dans son cas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
