                                    {
                                        "sense_id": "a34ed9a8-f9da-306b-8160-299e44b9a010",
                                        "entry_id": "e93cfbb5-c97f-3d69-b406-6c1b2b11844b",
                                        "glosses": [
                                            "город на Тайване, столица частично признанной Китайской Республики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c54670b3-5ac9-466f-93e3-0b18f1b3949e",
                                                "sense_id": "a34ed9a8-f9da-306b-8160-299e44b9a010",
                                                "text": "Поездка через весь остров из столицы, Тайбэя, во второй по величине город Гаосюн (протяженность маршрута ― 345 километров) занимает всего полтора часа, почти в три раза меньше, чем прежде."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edc685f6-2618-390b-b32c-18bb8a1b94e1",
                                        "entry_id": "e93cfbb5-c97f-3d69-b406-6c1b2b11844b",
                                        "glosses": [
                                            "перен. полит. правительство Китайской Республики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febbddf1-0414-451e-8e00-edba9733b8fb",
                                                "sense_id": "edc685f6-2618-390b-b32c-18bb8a1b94e1",
                                                "text": "Председатель КНР Си Цзиньпинь активно поддерживает диалог с Тайбэем, поскольку надеется войти в историю в качестве объединителя китайских земель."
                                            }
                                        ]
