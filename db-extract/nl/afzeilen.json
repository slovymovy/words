                        "examples": [
                            {
                                "example_id": "9c38b749-acba-417c-88c8-dc6bf18b0adb",
                                "sense_id": "cd42b623-acfb-3f1d-b36d-32522823ca84",
                                "text": "Soms komt er na de voorstelling een zwakzinnige op me afzeilen met de woorden: “Wat was het vanavond weer geweldig somber!” Voorheen informeerde ik of de persoon in kwestie dan niet gelachen had. Meestal bleek zulks wel het geval. Tegenwoordig doe ik er het zwijgen toe. Hoezeer mijn levensvisie ook mag verschillen van die van Toon Hermans, op de planken ben ik een komiek. Van onbegrip zie ik de humor niet meer in."
                            }
                        ]
                    }
