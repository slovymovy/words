                    {
                        "sense_id": "b93cf662-14f7-3eff-8aaa-c57fbc0afceb",
                        "entry_id": "273f447f-f248-3502-b00f-4c69db14a228",
                        "glosses": [
                            "Informationsblatt, das ausgehängt wird"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "28cc1407-ebc6-4f57-8bfe-39d6a6624be6",
                                "sense_id": "b93cf662-14f7-3eff-8aaa-c57fbc0afceb",
                                "text": "„Die Affichen sind mit hochtrabenden Namen unterfertigt, ›Hochschule für geheime Wissenschaften‹, ›Gelehrte Gesellschaft für okkultes Wissen‹ und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34753a3e-b130-476e-856e-f562e3462f5b",
                        "source_entry_id": "273f447f-f248-3502-b00f-4c69db14a228",
                        "source_sense_id": "b93cf662-14f7-3eff-8aaa-c57fbc0afceb",
                        "source_sense_description": "Informationsblatt, das ausgehängt wird",
                        "target_lang_word": "афиша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "афиша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ac45ed-7c98-339f-ab43-849d2f685bd1",
                                        "entry_id": "d416bb4f-d74e-3f55-bc5f-c14a6fa91367",
                                        "glosses": [
                                            "вывешиваемое на видном месте объявление о предстоящих мероприятиях (спектакль, концерт, лекция и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b4bc205-db43-4624-a584-bcda47695035",
                                                "sense_id": "a0ac45ed-7c98-339f-ab43-849d2f685bd1",
                                                "text": "На афише была нарисована воздушная женщина в розовом трико верхом на белой лошади, без седла и уздечки, а вокруг мечутся и скачут рыжие тигры с оскалившимися зубами."
                                            },
                                            {
                                                "example_id": "2e266f21-e043-480b-ac1f-8bbb28fda990",
                                                "sense_id": "a0ac45ed-7c98-339f-ab43-849d2f685bd1",
                                                "text": "Они [художники] расклеили по городу самодельные афиши, извещающие о том, что в Русском музее открыта выставка древних фресок."
                                            },
                                            {
                                                "example_id": "2bec0dd2-f15b-4a67-b8ff-d0a0434e124d",
                                                "sense_id": "a0ac45ed-7c98-339f-ab43-849d2f685bd1",
                                                "text": "На любую печатную продукцию, включая почтовые открытки, афиши футбольных матчей или концертов, нужен был разрешительный штамп цензуры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
