                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0195fbb5-ca6d-46fa-be92-a2a490611e7a",
                                "sense_id": "17eb8360-a5d6-34f6-9870-bb8aa1cba7ec",
                                "text": "Maak er appelmoes bij en een witloofsla met muizenoren (veldsla), noten en een sprenkel porto (plus olie en azijn)."
                            }
                        ]
                    },
                    {
                        "sense_id": "de18a177-1431-373f-b19d-622c79d64561",
                        "entry_id": "ff8bb368-9ec2-37b0-aa1f-dddc52d88e0a",
                        "glosses": [
                            "kleine hoeveelheid die ergens op gestrooid wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00283738-a475-4176-ba53-3629f24f4a7a",
                                "sense_id": "de18a177-1431-373f-b19d-622c79d64561",
                                "text": "Voeg een eetlepel avocado-olie en de geroosterde sesamolie, de uien en een sprenkel zout toe en bak ongeveer drie minuten of tot de uien zacht zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "36e64448-388b-36e1-9d30-61ef1eb08eef",
                        "entry_id": "ff8bb368-9ec2-37b0-aa1f-dddc52d88e0a",
