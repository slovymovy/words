                    {
                        "sense_id": "a5445ae6-f3e6-3198-9629-39e1be2c2c6c",
                        "entry_id": "9aa60084-50dc-3349-b465-9042da8e6958",
                        "glosses": [
                            "Cumin noir ou nigelle cultivée, plante annuelle du genre Nigella."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d91c38-7324-494c-9deb-5224cef0e9db",
                                "sense_id": "a5445ae6-f3e6-3198-9629-39e1be2c2c6c",
                                "text": "Der Echte Schwarzkümmel stammt ursprünglich aus Asien, aber auch bei uns kann man ihn anbauen.",
                                "translation": "Le vrai cumin noir est originaire d'Asie, mais on peut aussi le cultiver chez nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "54e2531d-41cd-3913-b7c3-67fe1796f558",
                        "entry_id": "9aa60084-50dc-3349-b465-9042da8e6958",
                        "glosses": [
                            "Graines de nigelle cultivée, utilisées comme épices en cuisine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2908e9cc-4e7f-42b4-869a-79d881a93b3c",
                                "sense_id": "54e2531d-41cd-3913-b7c3-67fe1796f558",
                                "text": "Als Gewürz kennt man die kleinen Samenkörner des Schwarzkümmels von Fladenbroten oder von orientalischen Gerichten.",
                                "translation": "Les petites graines de cumin noir sont connues comme épice dans les galettes ou les plats orientaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f259a34-fd4d-3b43-9df2-f79cb822f399",
                        "entry_id": "9aa60084-50dc-3349-b465-9042da8e6958",
                        "glosses": [
                            "Graines de Elwendia persica, utilisées comme épices en cuisine."
                        ],
                        "tags": [],
                        "note": "Malgré leur nom similaire, il s'agit bien de deux épices différentes",
