        "fr-extract.jsonl": [
            {
                "entry_id": "258f010d-2dda-33c4-9a4a-0d34ce73836f",
                "word": "ironiquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "743f8bdc-8e1f-3cc0-9b9a-c7657376eff5",
                        "entry_id": "258f010d-2dda-33c4-9a4a-0d34ce73836f",
                        "glosses": [
                            "D’une manière ironique ; avec ironie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fc9797-c7b7-4450-8880-7cd36632ed5d",
                                "sense_id": "743f8bdc-8e1f-3cc0-9b9a-c7657376eff5",
                                "text": "Racine fait parler ironiquement Axiane à Taxile, quand elle lui dit : Approche, puissant roi, grand monarque de l’Inde, On parle ici de toi."
                            },
                            {
                                "example_id": "56c1dd7c-1d7e-4bf9-a1e5-c0c45af1c7cc",
                                "sense_id": "743f8bdc-8e1f-3cc0-9b9a-c7657376eff5",
                                "text": "Elle est d’ailleurs, souvent critiquée ironiquement dans les commentaires sur la page Facebook des Hommen."
                            },
                            {
                                "example_id": "954ca49a-82e4-4da1-80e5-4d07dfecdd3a",
                                "sense_id": "743f8bdc-8e1f-3cc0-9b9a-c7657376eff5",
                                "text": "Pour la première fois depuis sa prestation de serment, une impression de solitude le glaça : celle d’être un aveugle tâtonnant parmi les voyants, si cordiaux, si prévenants, alors que, tout autour de lui, s’exhibaient ironiquement les letchis maraudés, les tourterelles braconnées, les chars en surcharge, les bœufs en divagation, les bébélés cueillis sur l’étendoir de la voisine, les cacas déposés en lieux interdits."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aff14ff7-f47e-4b22-a0f0-70fa38edd0e6",
                        "source_entry_id": "258f010d-2dda-33c4-9a4a-0d34ce73836f",
                        "source_sense_id": "743f8bdc-8e1f-3cc0-9b9a-c7657376eff5",
