        "fr-extract.jsonl": [
            {
                "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                "word": "goudronné",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "053d2734-55b1-4ed5-bb34-918f2efb7f30",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "goudronnés"
                    },
                    {
                        "form_id": "7fbb73c5-d682-44d4-a7ab-8229171a2fa2",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "goudronnée"
                    },
                    {
                        "form_id": "2592954d-75cf-41fe-a5f0-26acef6ca03c",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "goudronnées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "glosses": [
                            "Qui est recouvert de goudron."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9722486-68f5-443d-b785-f946ea47c9b5",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "L’immense radeau, couvert d’un toit goudronné que supportent des colonnes de bois, est relié à l’île charmante de Croissy par deux passerelles […]"
                            },
                            {
                                "example_id": "6fa053f3-0173-4d7a-8c97-993d6c72ff99",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "Les murs étaient en carreaux de plâtre, en pavés de grès et de bois, en boîtes de fer-blanc, le toit en carton et en toile goudronnée, les fenêtres garnies de vitres en papier, en bois, en feuilles de zinc et même en verre."
                            },
                            {
                                "example_id": "3563721e-a266-47eb-b677-107558d3ac10",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "[…] ; auprès d'elles, s’élève encore un cajibi boche, de bouleau non équarri et de papier goudronné.... Tout cela est triste, mortellement triste…"
                            },
                            {
                                "example_id": "65467b89-0c23-4bf9-847b-406ea4d3270f",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "Il voyait le toit de papier goudronné, les murs de rondins et de planches, des piles de gros bois, d’énormes troncs couchés entre les branchages, mais toujours pas de charrette."
                            },
                            {
                                "example_id": "f0c3e886-c045-4520-b9b1-2902952c11a1",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "L’usine […] était également outillée pour transformer le papier d’emballage en papier goudronné, entoilé, armé, huilé et paraffiné, à usage industriel."
                            },
                            {
                                "example_id": "c0599f9e-2026-49a5-b512-3be1211684de",
                                "sense_id": "f4ba77f9-e0c4-3738-bd2d-90c3832f45a0",
                                "text": "Les hommes entrèrent dans la salorge où l’on servait du café sur le fond goudronné d’une ancienne barque de pêche devenue table."
                            }
                        ]
                    },
                    {
                        "sense_id": "a63c6517-adeb-36b7-9637-2aec977179ab",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "glosses": [
                            "Qui est couvert d’asphalte, de bitume ou de l’un de ses composés."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "9732efd9-6bbb-4785-83e7-ad3a88d03b72",
                                "sense_id": "a63c6517-adeb-36b7-9637-2aec977179ab",
                                "text": "Avant 1987, la route pavée en provenance de Stephenville s'arrêtait à Lourdes, tandis que ses prolongements vers La Grand’Terre au sud et L’Anse-à-Canards au nord n'étaient que des chemins de terre, parfois goudronnés, toujours pleins d'ornières."
                            }
                        ]
                    },
                    {
                        "sense_id": "35f7d690-4513-3ca4-8384-9f8e471c4d80",
                        "entry_id": "5906a842-cc38-3b24-ad37-d13d981c2cc1",
                        "glosses": [
                            "Très sombre, comme tanné."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f04836f6-e40e-4dcb-ae9a-fd72d4ee2782",
                                "sense_id": "35f7d690-4513-3ca4-8384-9f8e471c4d80",
                                "text": "Ses pieds sont des cornes dures, écaillées, ses mains des battoirs raboteux, sa peau goudronnée et nuancée de mille plaies et trouée de mille crevasses."
                            },
                            {
                                "example_id": "30d5a949-fb4c-4ffa-8f51-816907b4ad46",
                                "sense_id": "35f7d690-4513-3ca4-8384-9f8e471c4d80",
                                "text": "C’était un vieux marin, basané, goudronné, qui avait doublé trois fois le cap Horn et neuf fois le cap de Bonne-Espérance, et qui avait horreur de la terre autant que les chats ont horreur de l’eau froide."
                            }
                        ]
                    }
                ],
