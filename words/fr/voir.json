    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4a6f5c1-3e8a-3ea6-a3b4-72cafc33d732",
                    "sense_definition": "Percevoir des objets ou des êtres par les yeux et le sens de la vue.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le balcon, nous pouvons <w>voir</w> la mer et les montagnes au loin."
                        },
                        {
                            "text": "Sans mes lunettes, je ne <w>vois</w> pas très bien les panneaux sur la route."
                        }
                    ],
                    "synonyms": [
                        "apercevoir",
                        "distinguer"
                    ],
                    "common_phrases": [
                        "voir clair",
                        "voir de loin"
                    ]
                },
                {
                    "sense_id": "84071567-659d-3300-965e-35f7674333d6",
                    "sense_definition": "Comprendre intellectuellement, se rendre compte d'une situation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comprehension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>vois</w> exactement ce que tu veux expliquer avec cet exemple."
                        },
                        {
                            "text": "Elle a enfin compris son erreur et <w>voit</w> la solution à adopter."
                        }
                    ],
                    "synonyms": [
                        "comprendre"
                    ]
                },
                {
                    "sense_id": "0b9bc247-3893-37bc-ae3a-abd95d60eb38",
                    "sense_definition": "Rencontrer une personne, s'entretenir avec elle ou la fréquenter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vais <w>voir</w> mes grands-parents ce week-end pour leur anniversaire."
                        },
                        {
                            "text": "Nous nous <w>voyons</w> souvent au café après les heures de travail."
                        }
                    ]
                },
                {
                    "sense_id": "c7fabe12-6b08-3a57-a82d-6158bd4b1c0e",
                    "sense_definition": "Consulter un médecin ou un autre praticien professionnel.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "consultation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as beaucoup de fièvre, tu devrais aller <w>voir</w> un médecin aujourd'hui."
                        },
                        {
                            "text": "Le patient souhaite <w>voir</w> un spécialiste pour ses douleurs articulaires."
                        }
                    ],
                    "common_phrases": [
                        "voir un médecin",
                        "voir un spécialiste"
                    ]
                },
                {
                    "sense_id": "8f187dfd-afc2-361c-a318-432c49a209c9",
                    "sense_definition": "Examiner une question, y réfléchir avant de prendre un parti.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reflexion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>verrons</w> plus tard comment organiser les vacances de cet été."
                        },
                        {
                            "text": "Il faut d'abord <w>voir</w> les détails du contrat avant de signer."
                        }
                    ],
                    "common_phrases": [
                        "on verra"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "47143b71-2df5-3663-a2fd-1b4170dbcc6e",
                    "sense_definition": "Particule employée après un verbe à l'impératif pour insister ou renforcer une demande.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Montre <w>voir</w> ce que tu caches derrière ton dos !"
                        },
                        {
                            "text": "Écoute <w>voir</w> ce qu'il a à dire avant de prendre une décision."
                        }
                    ],
                    "common_phrases": [
                        "viens voir",
                        "écoute voir",
                        "dis voir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier et oral"
                        }
                    ]
                }
            ]
        }
    ]
