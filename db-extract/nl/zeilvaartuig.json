                "translations": [
                    {
                        "translation_id": "bd84577f-4659-4e3d-8c46-e69ec5d33ef3",
                        "source_entry_id": "a4bc9bc6-782b-3fe1-bcef-7a4f8744e966",
                        "source_sense_id": "df97e272-360d-31e3-8be9-ce072f2872e0",
                        "source_sense_description": "een zeilboot of zeilschip",
                        "target_lang_word": "Segelboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segelboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                        "entry_id": "81f4829d-95a2-3701-bb28-66e27620c63d",
                                        "glosses": [
                                            "ein Sportboot, das in erster Linie durch Windkraft angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82facca3-107f-48b3-ac11-4b70b3d1f32e",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "Segelboote benutzen Segel, um die Energie des Windes in Fahrt umzusetzen."
                                            },
                                            {
                                                "example_id": "d418a89c-c2d4-4c66-bf07-3f0929d82e08",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Derweil überholt die MS Regina ein kleines Segelboot, ein Einmaster aus Holz mit einem blendend-weißen Segel, in dem ein Mann und eine Frau, beide in unserem Alter, sitzen.“"
                                            },
                                            {
                                                "example_id": "7ef90544-3981-4b91-b5a5-922299383e4f",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Sie schlug die Augen auf und fand sich auf den Planken eines Segelboots, auf Philips Mantel, der sie vor Flugsand schützte, vor Wassertropfen und Insekten.“"
                                            },
                                            {
                                                "example_id": "184a345a-1df5-4e31-9744-fc40c6476650",
                                                "sense_id": "10e9795d-f2d0-37c6-bb50-bcf9e5e57469",
                                                "text": "„Ein Segelboot jagte über den Sund, eine weiße, sonnengefüllte Schwinge in dem vielen Blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9da353f-3f6c-46fe-a6f2-efe3d2a2b99f",
                        "source_entry_id": "a4bc9bc6-782b-3fe1-bcef-7a4f8744e966",
                        "source_sense_id": "df97e272-360d-31e3-8be9-ce072f2872e0",
                        "source_sense_description": "een zeilboot of zeilschip",
                        "target_lang_word": "Segelschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segelschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33bc8e50-8ae0-3955-a748-f720b72e72f1",
                                        "entry_id": "bdb85833-0cff-3d60-854f-4159f85717de",
                                        "glosses": [
                                            "Schiff, das mit Hilfe seiner Segel durch den Wind angetrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5beb7c46-c2f2-4316-82eb-0850469e0993",
                                                "sense_id": "33bc8e50-8ae0-3955-a748-f720b72e72f1",
                                                "text": "Die Gorch Fock ist ein berühmtes Segelschiff."
                                            },
                                            {
                                                "example_id": "610b28e6-b73a-4bd3-9d0a-a1ac02035f8c",
                                                "sense_id": "33bc8e50-8ae0-3955-a748-f720b72e72f1",
                                                "text": "„Und da Seeleute für Segelschiffe in den siebziger Jahren des 19. Jahrhunderts bereits Mangelware waren, konnten gute Matrosen sich durchaus ein Schiff ihrer Wahl suchen.“"
                                            },
                                            {
                                                "example_id": "98fa22e4-a0c6-4470-8f2c-4b5fa9158f6f",
                                                "sense_id": "33bc8e50-8ae0-3955-a748-f720b72e72f1",
                                                "text": "„Aber die alten Reisenden, die auf Segelschiffen die Welt durchquerten, waren mindestens genauso dramatisch, glaubten an Monster und rachsüchtige Göttinnen und die Unendlichkeit einer Welt, die sie nicht verstanden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
