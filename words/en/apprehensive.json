        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e602083d-74ad-3e39-9949-b1f4aa34868f",
                    "sense_definition": "Anxious, fearful, or uneasy about what may happen in the future.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fear_and_anxiety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt extremely <w>apprehensive</w> about the upcoming job interview.",
                            "target_lang_translations": {
                                "ru": "Она испытывала крайнее <w>беспокойство</w> по поводу предстоящего собеседования.",
                                "de": "Sie war extrem <w>besorgt</w> wegen des bevorstehenden Vorstellungsgesprächs."
                            }
                        },
                        {
                            "text": "Many citizens are <w>apprehensive</w> about the future of the economy.",
                            "target_lang_translations": {
                                "ru": "Многие граждане с <w>тревогой</w> смотрят на будущее экономики.",
                                "de": "Viele Bürger blicken mit <w>Beklommenheit</w> auf die Zukunft der Wirtschaft."
                            }
                        }
                    ],
                    "synonyms": [
                        "anxious",
                        "fearful",
                        "uneasy",
                        "concerned"
                    ],
                    "antonyms": [
                        "confident",
                        "assured",
                        "unconcerned"
                    ],
                    "common_phrases": [
                        "apprehensive about the future",
                        "feel apprehensive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывающий тревогу, опасение или страх перед тем, что может произойти в будущем.",
                        "de": "Ängstlich, besorgt oder unruhig in Bezug auf zukünftige Ereignisse."
                    },
                    "translations": {
