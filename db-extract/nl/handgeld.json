                    },
                    {
                        "sense_id": "7ca4e832-68cc-3f76-92df-8e39bb5be068",
                        "entry_id": "41f596e9-9f37-3a80-aacc-1754110f74bd",
                        "glosses": [
                            "een niet officieel vastgelegde transactie (met zwartgeld)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716aadd4-e7f5-4692-9358-1f72778e09bf",
                                "sense_id": "7ca4e832-68cc-3f76-92df-8e39bb5be068",
                                "text": "Advocaat Bram Moszkowicz, die door de rechter en een commissie van collega's schuldig bevonden is aan het aannemen van handgeld en het oplichten van de belastingdienst, acht zichzelf een 'slachtoffer van karaktermoord'."
                            },
                            {
                                "example_id": "ad7a7f43-1604-4e9f-a031-955f57e12d18",
                                "sense_id": "7ca4e832-68cc-3f76-92df-8e39bb5be068",
                                "text": "De laatste betekenis is ‘handgeld’. Bij het afsluiten van een koop- of huurcontract was het lang gebruikelijk om iemand onderhands een bedrag te geven. Ook hierbij sprak men lang van steekpenningen."
                            }
                        ]
                    }
