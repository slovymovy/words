                                "example_id": "721c6884-a9a8-43ee-ad68-27535ae0c308",
                                "sense_id": "2b552fd1-1c95-314e-a491-46e44c470ad3",
                                "text": "„Zwei junge Burschen hockten auf einem Haufen Schädel und Beckenknochen und grinsten hämisch herüber.“"
                            },
                            {
                                "example_id": "a29c0c64-a15c-4579-9c5d-fa42e99f71f4",
                                "sense_id": "2b552fd1-1c95-314e-a491-46e44c470ad3",
                                "text": "„Es fanden sich Brustkörbe, Beckenknochen, Schenkelknochen, Schulterblätter - und mehr kleine Schädel, als ich zählen konnte.“"
                            }
                        ],
