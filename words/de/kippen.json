                {
                    "sense_id": "6ecad06f-f9ed-37bd-9b82-9a818b6d5761",
                    "sense_definition": "Etwas in eine schräge Position bringen oder anwinkeln, ohne dass es vollständig umfällt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "neigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn es im Zimmer zu warm wird, kannst du einfach das Fenster <w>kippen</w>."
                        },
                        {
                            "text": "Wenn du die Kiste <w>kippst</w>, läuft das ganze Wasser an der Seite heraus."
                        }
                    ],
