{
    "word_family": [
        "doodlopen",
        "doodloper"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a7242a74-8cae-3032-9cf2-e0ba261c7e3b",
                    "sense_definition": "gezegd van een weg of pad dat aan het einde nergens op aansluit, waardoor men niet verder kan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_weg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dief vluchtte per ongeluk een <w>doodlopende</w> straat in en werd daar klemgereden.",
                            "target_lang_translations": {
                                "en": "The thief accidentally fled into a <w>dead-end</w> street and was cornered there."
                            }
                        },
                        {
                            "text": "Aan het einde van deze <w>doodlopende</w> weg staat een prachtig oud landhuis.",
                            "target_lang_translations": {
                                "en": "At the end of this <w>dead-end</w> road stands a beautiful old country house."
                            }
                        }
                    ],
                    "antonyms": [
                        "doorgaand"
                    ],
                    "common_phrases": [
                        "doodlopende straat",
                        "doodlopende weg",
                        "doodlopend steegje"
                    ],
                    "target_lang_definitions": {
                        "en": "said of a road or path that does not connect to anything at the end, making it impossible to continue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead-end",
                                "target_lang_sense_clarification": "of a street or path"
                            },
                            {
                                "target_lang_word": "blind",
                                "target_lang_sense_clarification": "of an alley or road"
                            },
                            {
                                "target_lang_word": "no-through",
                                "target_lang_sense_clarification": "of a road"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5edcfee9-ca18-3544-a087-ce23d5bb4cf8",
                    "sense_definition": "gezegd van een situatie, proces of ontwikkeling die geen perspectief biedt of niet tot een resultaat leidt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De onderhandelingen tussen de twee partijen bleken uiteindelijk een <w>doodlopend</w> spoor te zijn.",
                            "target_lang_translations": {
                                "en": "The negotiations between the two parties ultimately proved to be a <w>dead-end</w> track."
                            }
                        },
                        {
                            "text": "Zonder nieuwe investeringen bevindt het bedrijf zich in een <w>doodlopende</w> situatie.",
                            "target_lang_translations": {
                                "en": "Without new investments, the company finds itself in a <w>dead-end</w> situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitzichtloos",
                        "vruchteloos"
                    ],
                    "antonyms": [
                        "veelbelovend"
                    ],
                    "common_phrases": [
                        "doodlopend spoor",
                        "doodlopende weg",
                        "doodlopende discussie"
                    ],
                    "target_lang_definitions": {
                        "en": "said of a situation, process, or development that offers no perspective or does not lead to a result"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead-end",
                                "target_lang_sense_clarification": "of a situation or career"
                            },
                            {
                                "target_lang_word": "blind",
                                "target_lang_sense_clarification": "of an alley or track in a figurative sense"
                            },
                            {
                                "target_lang_word": "futile",
                                "target_lang_sense_clarification": "leading to no result"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1f8d1b4d-7408-3c31-9073-02684794263c",
                    "sense_definition": "onvoltooid deelwoord van <w>doodlopen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het project is langzaam <w>doodlopend</w> door een gebrek aan motivatie bij de vrijwilligers.",
                            "target_lang_translations": {
                                "en": "The project is slowly <w>fizzling out</w> due to a lack of motivation among the volunteers."
                            }
                        },
                        {
                            "text": "Met een <w>doodlopend</w> proces als resultaat moesten we weer helemaal opnieuw beginnen.",
                            "target_lang_translations": {
                                "en": "With a <w>stalling</w> process as a result, we had to start all over again."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'doodlopen' (to come to a dead end or fizzle out)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fizzling out",
                                "target_lang_sense_clarification": "gradually ending without result"
                            },
                            {
                                "target_lang_word": "stalling",
                                "target_lang_sense_clarification": "coming to a halt"
                            },
                            {
                                "target_lang_word": "dying out",
                                "target_lang_sense_clarification": "losing momentum"
                            }
                        ]
                    }
                }
            ]
        }
    ]
