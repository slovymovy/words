{
    "word_family": [
        "skin",
        "skinniness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "984da532-4b05-343b-9f4f-7dd6635ac825",
                    "sense_definition": "Very thin, especially in a way that is unattractive or shows a lack of strength.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her recent weight loss has made her look <w>skinny</w> rather than slender.",
                            "target_lang_translations": {
                                "ru": "Из-за недавней потери веса она стала выглядеть <w>тощей</w>, а не стройной.",
                                "zh": "她最近瘦下来之后，看起来不是苗条，而是<w>瘦巴巴的</w>。"
                            }
                        },
                        {
                            "text": "He was a <w>skinny</w> boy who looked like he needed a good meal.",
                            "target_lang_translations": {
                                "ru": "Он был <w>худым</w> мальчиком, который выглядел так, будто ему нужно хорошо поесть.",
                                "zh": "他是个<w>瘦巴巴的</w>男孩，看起来像是需要好好吃一顿饭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thin"
                    ],
                    "antonyms": [
                        "fat"
                    ],
                    "common_phrases": [
                        "skinny legs",
                        "skinny kid",
                        "tall and skinny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень худой, особенно если это выглядит непривлекательно или указывает на слабость.",
                        "zh": "非常瘦，尤其是瘦得不太好看，或显得缺乏力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тощий",
                                "target_lang_sense_clarification": "очень худой, часто с негативным оттенком"
                            },
                            {
                                "target_lang_word": "худой",
                                "target_lang_sense_clarification": "имеющий мало жира или мышц"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "瘦巴巴的",
                                "target_lang_sense_clarification": "非常瘦，常带贬义，显得不健康或不好看"
                            },
                            {
                                "target_lang_word": "干瘦的",
                                "target_lang_sense_clarification": "瘦而显得缺乏气色或力量"
                            },
                            {
                                "target_lang_word": "瘦骨嶙峋的",
                                "target_lang_sense_clarification": "形容人极瘦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8cf9250-0528-3747-9b50-ef2e6ad8fa40",
                    "sense_definition": "Designed to fit very closely to the body, especially of clothing.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a pair of <w>skinny</w> jeans to wear with her new boots.",
                            "target_lang_translations": {
                                "ru": "Она купила <w>обтягивающие</w> джинсы, чтобы носить их с новыми ботинками.",
                                "zh": "她买了一条<w>紧身</w>牛仔裤，好搭配她的新靴子。"
                            }
                        },
                        {
                            "text": "I do not find <w>skinny</w> trousers very comfortable to wear all day.",
                            "target_lang_translations": {
                                "ru": "Я не нахожу <w>узкие</w> брюки очень удобными для ношения весь день.",
                                "zh": "我觉得<w>紧身</w>裤子穿一整天不太舒服。"
                            }
                        }
                    ],
                    "antonyms": [
                        "loose",
                        "baggy"
                    ],
                    "common_phrases": [
                        "skinny jeans",
                        "skinny fit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно облегающий тело (об одежде).",
                        "zh": "设计得非常贴身的，尤指衣服。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтягивающий",
                                "target_lang_sense_clarification": "плотно прилегающий к телу"
                            },
                            {
                                "target_lang_word": "узкий",
                                "target_lang_sense_clarification": "не широкий, тесный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧身",
                                "target_lang_sense_clarification": "衣服贴身、穿起来很紧"
                            },
                            {
                                "target_lang_word": "修身",
                                "target_lang_sense_clarification": "版型贴合身体线条"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d8c3f61-83a5-3a6f-a1ab-264500bdaf56",
                    "sense_definition": "Of food or drink, containing fewer calories or less fat than the standard version.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would like a <w>skinny</w> latte with sugar-free syrup, please.",
                            "target_lang_translations": {
                                "ru": "Я хотел бы <w>обезжиренный</w> латте с сиропом без сахара, пожалуйста.",
                                "zh": "请给我来一杯加无糖糖浆的<w>低脂</w>拿铁。"
                            }
                        },
                        {
                            "text": "People often order a <w>skinny</w> margarita to reduce their sugar intake.",
                            "target_lang_translations": {
                                "ru": "Люди часто заказывают <w>низкокалорийную</w> маргариту, чтобы потреблять меньше сахара.",
                                "zh": "人们常常点<w>低卡</w>玛格丽塔来减少糖分摄入。"
                            }
                        }
                    ],
                    "antonyms": [
                        "full-fat"
                    ],
                    "common_phrases": [
                        "skinny latte",
                        "skinny cappuccino",
                        "skinny milk"
                    ],
                    "target_lang_definitions": {
                        "ru": "О еде или напитках: содержащий меньше калорий или жира, чем обычная версия.",
                        "zh": "指食物或饮料比普通版本含更少热量或脂肪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезжиренный",
                                "target_lang_sense_clarification": "с низким содержанием жира (обычно о молочных продуктах)"
                            },
                            {
                                "target_lang_word": "низкокалорийный",
                                "target_lang_sense_clarification": "содержащий мало калорий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "低脂",
                                "target_lang_sense_clarification": "脂肪含量较低，常用于奶类或咖啡饮品"
                            },
                            {
                                "target_lang_word": "低卡",
                                "target_lang_sense_clarification": "热量较低"
                            },
                            {
                                "target_lang_word": "脱脂",
                                "target_lang_sense_clarification": "不含或几乎不含脂肪，常用于乳制品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0c3f305-d050-3fa1-8dff-18556368bcf5",
                    "sense_definition": "Without any clothes on; nude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers went <w>skinny</w> dipping in the lake under the moonlight.",
                            "target_lang_translations": {
                                "ru": "Подростки пошли купаться <w>нагишом</w> в озере при лунном свете.",
                                "zh": "那些青少年在月光下到湖里去<w>裸泳</w>。"
                            }
                        },
                        {
                            "text": "We decided to swim <w>skinny</w> because we did not have our swimsuits.",
                            "target_lang_translations": {
                                "ru": "Мы решили искупаться <w>голышом</w>, потому что у нас не было купальников.",
                                "zh": "因为我们没带泳衣，所以决定<w>光着身子</w>游泳。"
                            }
                        }
                    ],
                    "antonyms": [
                        "clothed"
                    ],
                    "common_phrases": [
                        "skinny dipping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "chiefly used in the phrase 'skinny dipping'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Без одежды; обнажённый.",
                        "zh": "没有穿衣服的；赤裸的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагишом",
                                "target_lang_sense_clarification": "без одежды (наречие)"
                            },
                            {
                                "target_lang_word": "голый",
                                "target_lang_sense_clarification": "не одетый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "裸泳",
                                "target_lang_sense_clarification": "不穿衣服地下水游泳，常用于“裸泳”这个说法"
                            },
                            {
                                "target_lang_word": "光着身子",
                                "target_lang_sense_clarification": "没有穿衣服"
                            },
                            {
                                "target_lang_word": "裸体",
                                "target_lang_sense_clarification": "赤裸、没穿衣服"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "58752b25-d66a-3d7e-8046-e9cf371fc2ba",
                    "sense_definition": "Confidential information or the latest news about a person or situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She called her friend to get the <w>skinny</w> on the latest office rumors.",
                            "target_lang_translations": {
                                "ru": "Она позвонила подруге, чтобы узнать <w>подноготную</w> последних офисных слухов.",
                                "zh": "她给朋友打电话，想打听一下最近办公室流言的<w>内幕</w>。"
                            }
                        },
                        {
                            "text": "Here is the <w>skinny</w> on what really happened at the meeting yesterday.",
                            "target_lang_translations": {
                                "ru": "Вот <w>подробности</w> того, что на самом деле произошло на вчерашнем собрании.",
                                "zh": "这就是昨天会议上到底发生了什么的<w>实情</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the skinny",
                        "get the skinny"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конфиденциальная информация или последние новости о человеке или ситуации.",
                        "zh": "关于某人或某种情况的内部消息，或最新情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подноготная",
                                "target_lang_sense_clarification": "скрытые подробности или истинное положение дел"
                            },
                            {
                                "target_lang_word": "подробности",
                                "target_lang_sense_clarification": "детали дела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内幕",
                                "target_lang_sense_clarification": "不公开的真实情况或内部消息"
                            },
                            {
                                "target_lang_word": "实情",
                                "target_lang_sense_clarification": "事情真实的经过或情况"
                            },
                            {
                                "target_lang_word": "消息",
                                "target_lang_sense_clarification": "最新的消息或情况，口语常用"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "200bfb9e-939d-30f8-8bba-2321b91dffe1",
                    "sense_definition": "To make something smaller or reduce the amount of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>skinnying</w> down its workforce to cut costs.",
                            "target_lang_translations": {
                                "ru": "Компания <w>сокращает</w> штат сотрудников, чтобы снизить расходы.",
                                "zh": "公司正在<w>缩减</w>员工人数以削减成本。"
                            }
                        },
                        {
                            "text": "We need to <w>skinny</w> the list of options before making a final decision.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>сократить</w> список вариантов перед принятием окончательного решения.",
                                "zh": "在做最终决定之前，我们需要先<w>精简</w>一下备选方案名单。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "skinny down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать что-либо или сокращать количество чего-либо.",
                        "zh": "使某物变小，或减少某事物的数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "уменьшать объем или количество"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "снижать расходы или количество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缩减",
                                "target_lang_sense_clarification": "减少数量、规模或篇幅"
                            },
                            {
                                "target_lang_word": "精简",
                                "target_lang_sense_clarification": "去掉不必要的部分，使更少更简"
                            },
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "口语里指削减、压缩"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}