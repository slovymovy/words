                    "frequency": "Low",
                    "semantic_group_id": "model",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar wees op de <w>aardbol</w> waar de oceaan ligt.",
                            "target_lang_translations": {
