                        "examples": [
                            {
                                "example_id": "62486250-ded7-4ac8-8d0c-3a2b847c1b8b",
                                "sense_id": "8df58fbb-0327-33b4-92aa-9220790e9d54",
                                "text": "De soldaat was gekleed in een blauwige jas van fabriekslaken, droeg geen ransel en sjako, had een verband om zijn hoofd en een Franse patroontas over zijn schouder."
                            },
                            {
                                "example_id": "9d0c9f32-96d8-4b00-ab58-299626bb1e88",
                                "sense_id": "8df58fbb-0327-33b4-92aa-9220790e9d54",
                                "text": "De wagen werd schoongemaakt en mogelijk werden daarbij heel wat vingerafdrukken gewist. In de koffer van de auto werd, naast enkele persoonlijke spullen, een patroontas gevonden vergelijkbaar met de patroontassen van de politie."
                            }
                        ]
