                                        "entry_id": "1ff4b918-3033-32dd-b939-b89b9f2cce99",
                                        "glosses": [
                                            "A colorful perching duck that has a red bill, large white crescent above the eye and reddish face, Aix galericulata."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21687d83-0c8b-4032-b733-f4473825bfc7",
                                                "sense_id": "d0977b69-5ca8-3c47-a299-b7fb54509995",
                                                "text": "Mandarin ducks usually pair for life. In Asia they are thought to be a symbol of love and good luck. Mandarin ducks feed mainly on insects, snails, fish, plants and seeds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
