                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd97dfc1-c71c-445c-918a-7f85f7c62547",
                                "sense_id": "44fdcc4a-1c41-3167-8013-169b6db09b0c",
                                "text": "„Wo Niedersachsentum nur annähernd ähnliche Kulturbedingungen findet wie das Baltentum, erinnert es an dieses.“"
                            },
                            {
                                "example_id": "97d9f914-dbe9-4ba8-b4a0-b64572c219b2",
                                "sense_id": "44fdcc4a-1c41-3167-8013-169b6db09b0c",
                                "text": "„Und wenn Hannover mit besonderer Animosität sich der Zusammenarbeit mit Dahlemer 'Radikalen' versagte, dann hat das mit dem bäuerlichen Niedersachsentum zu tun, das noch immer die politischen Erfahrungen von 1866 in ungutem Gedächtnis behielt.“"
                            },
                            {
                                "example_id": "d94d1559-3fa3-4ff3-b26c-ae90eb1ded9a",
                                "sense_id": "44fdcc4a-1c41-3167-8013-169b6db09b0c",
                                "text": "„Lebenslustige Liberale werfen ihm sein mangelndes Schillern, sein sprödes Niedersachsentum vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
