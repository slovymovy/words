                        ],
                        "form": "сма́зках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ed9586fa-30fe-3fdc-80e9-d64e33f4ed0a",
                        "entry_id": "9647dd8a-efcb-3e56-bc42-b9fef92c645b",
                        "glosses": [
                            "действие по значению гл. смазывать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d9a732-9bcd-4f67-8257-a65b75f52550",
                                "sense_id": "ed9586fa-30fe-3fdc-80e9-d64e33f4ed0a",
                                "text": "Смазка подшипников производится через пресс-маслёнку."
                            }
                        ]
                    },
                    {
                        "sense_id": "340ea4d5-e87a-335e-9c7c-31e546752fff",
                        "entry_id": "9647dd8a-efcb-3e56-bc42-b9fef92c645b",
                        "glosses": [
                            "субстанция, наносимая на трущиеся поверхности с целью снижения трения или предохранения от коррозии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387b660a-f00f-4bbe-adb9-f5da25f4aeda",
                                "sense_id": "340ea4d5-e87a-335e-9c7c-31e546752fff",
                                "text": "Лыжная смазка наносится на сухие и чистые лыжи при комнатной температуре."
                            },
                            {
                                "example_id": "c3b8b2d2-d935-489a-a056-257dd56dd404",
                                "sense_id": "340ea4d5-e87a-335e-9c7c-31e546752fff",
                                "text": "Освободите ружьё от упаковки и удалите защитную смазку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "564037c2-a390-4c4b-84d6-7dfc48e71c77",
                        "source_entry_id": "9647dd8a-efcb-3e56-bc42-b9fef92c645b",
                        "source_sense_description": "действие",
                        "target_lang_word": "lubrication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lubrication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4b78387-4a2d-3433-b084-dcbba7ecec2c",
                                        "entry_id": "fa0695ea-1d23-3dd1-a6ce-c49726ad3aab",
                                        "glosses": [
                                            "The application of a substance (lubricant) between moving surfaces in contact in order to reduce friction and minimize heating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "524b3fac-1812-4c68-b673-e7e4bf3dda49",
                                                "sense_id": "e4b78387-4a2d-3433-b084-dcbba7ecec2c",
                                                "text": "Valve and cylinder lubrication is by atomised oil delivered by mechanical lubricators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01df43b0-1c6b-419b-9885-4dabda2c371a",
                        "source_entry_id": "9647dd8a-efcb-3e56-bc42-b9fef92c645b",
                        "source_sense_description": "субстанция",
                        "target_lang_word": "lubricant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lubricant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d502c14-8579-3438-bbf4-795a56110a21",
                                        "entry_id": "87fb0472-b5a4-3464-b1fa-195b4b8bce20",
                                        "glosses": [
                                            "A substance used to reduce friction between objects or surfaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61b8058e-53dc-42a3-bd25-aca9d2d7b286",
                                                "sense_id": "2d502c14-8579-3438-bbf4-795a56110a21",
                                                "text": "Before you apply the lubricant, be sure the chain gets a good cleaning with a stiff bristle brush and a good rub down in clean rags or shop towels."
                                            },
                                            {
                                                "example_id": "9009ffc3-53d3-4c59-9b94-b006ffad3921",
                                                "sense_id": "2d502c14-8579-3438-bbf4-795a56110a21",
                                                "text": "She'd come back from the hangar with Clint and some shop towels for Bendix's wound."
                                            },
                                            {
                                                "example_id": "fbaf71af-46dc-4330-afeb-ac3a6a358fba",
                                                "sense_id": "2d502c14-8579-3438-bbf4-795a56110a21",
                                                "text": "Food-grade lubricants are made for meat and poultry and other food-processing equipment. These lubricants are generally registered with the National Sanitary Foundation (NSF)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dddd3b9a-af60-3ccd-aea6-659b742ff487",
                                        "entry_id": "87fb0472-b5a4-3464-b1fa-195b4b8bce20",
                                        "glosses": [
                                            "A personal lubricant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
