                        "glosses": [
                            "Gebäude, in dem sich eine Klinik befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5f1577-b7dd-49ea-a266-0c6da1496bb7",
                                "sense_id": "ae8f2c9c-e69d-376d-9906-5d00e7a8a4ee",
                                "text": "„Beide gingen ihm langsam hinterher, während Dick, nun befriedigt, in den hinteren Teil des Gartens trottete, wo sich das Dach des Klinikgebäudes als Silhouette vor dem Sternenhimmel über der hohen Steinmauer abzeichnete.“"
                            },
                            {
                                "example_id": "3ab4e6c2-dd01-4a65-b529-b78be2910403",
                                "sense_id": "ae8f2c9c-e69d-376d-9906-5d00e7a8a4ee",
                                "text": "„Als ich vor der Biegung, die an dem grauen Klinikgebäude vorbeiführte, das Gas wegnahm, bot sich mir freie Sicht sowohl nach vorne als auch nach hinten; und um ein Haar hätte ich kehrtgemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
