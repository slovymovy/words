                ],
                "senses": [
                    {
                        "sense_id": "0e7c3502-a289-348e-83e9-0e7b96a8977f",
                        "entry_id": "4fa4d2af-d886-3b2c-8d26-e9465ebc73ed",
                        "glosses": [
                            "рег., спец. небольшая рукоятка какого либо орудия (ножа, лопаты и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67fcb326-af0a-4941-9a11-58de32f93877",
                                "sense_id": "0e7c3502-a289-348e-83e9-0e7b96a8977f",
                                "text": "Здесь как в клинке, так и к черену кольца приделаны, которыми сей нож вместо штыка к фузейному дулу прикрепить можно."
                            },
                            {
                                "example_id": "9033fd0e-8cb6-4be5-a7e6-674de71585f5",
                                "sense_id": "0e7c3502-a289-348e-83e9-0e7b96a8977f",
                                "text": "Шпажной Цех, которые к шпагам ефесы и черены делают."
                            },
                            {
                                "example_id": "436bf981-843f-4aed-808a-6225c72fc580",
                                "sense_id": "0e7c3502-a289-348e-83e9-0e7b96a8977f",
                                "text": "Ножи военные и охотничьи бывали прямые, с серебряным или рыбьего зуба с череном с одной стороны, либо обоюдоострые."
                            }
                        ]
                    }
