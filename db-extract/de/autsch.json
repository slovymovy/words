                                        ]
                                    },
                                    {
                                        "sense_id": "08cb2fbc-c18d-3a16-81e4-9040287b087a",
                                        "entry_id": "73ea1e7e-c78b-31ec-990f-2f8166cb7c44",
                                        "glosses": [
                                            "An expression of disappointment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0d7164-b1bc-42a1-b89b-f17bfb423c99",
                                                "sense_id": "08cb2fbc-c18d-3a16-81e4-9040287b087a",
                                                "text": "Ouch, I really wanted to do that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd944fb-13dc-3e1d-89d6-8b4eabf029c4",
                                        "entry_id": "73ea1e7e-c78b-31ec-990f-2f8166cb7c44",
                                        "glosses": [
                                            "Expressing surprise at the high price of something."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b3f29c-244c-41a0-a9df-403c0670bbb6",
                                                "sense_id": "2fd944fb-13dc-3e1d-89d6-8b4eabf029c4",
                                                "text": "Ouch, one hundred thousand dollars for a car! I could never afford that!"
                                            }
