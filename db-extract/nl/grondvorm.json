                            {
                                "example_id": "2e1b2031-a4a6-438d-afc8-89c291511514",
                                "sense_id": "cd5049de-c79b-3b33-94e1-4cc6569e1023",
                                "text": "Elk werkwoord heeft een grondvorm waarvan andere vormen worden afgeleid.",
                                "translation": "Every verb has a basic form from which other forms are derived.",
                                "english": "Every verb has a basic form from which other forms are derived."
                            }
                        ]
                    },
                    {
                        "sense_id": "d59b5e41-c3fd-3173-853e-accf9aba27c0",
                        "entry_id": "c54c99d1-9f6b-30a5-85ed-6470c1d67b3f",
                        "glosses": [
                            "primitive form"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "27d68518-449a-4149-afb5-995706b3c975",
                                "sense_id": "d59b5e41-c3fd-3173-853e-accf9aba27c0",
                                "text": "De regelgeving op het platteland laat ook niet veel andere opties open. Wie wil bouwen in het landschap, moet zich houden aan de grondvorm van het aloude boerenhuis.",
                                "translation": "The regulations in rural areas also do not leave many other options open. Anyone who wants to build in the landscape must adhere to the primitive form of the ancient farmhouse.",
                                "english": "The regulations in rural areas also do not leave many other options open. Anyone who wants to build in the landscape must adhere to the primitive form of the ancient farmhouse."
                            }
                        ]
