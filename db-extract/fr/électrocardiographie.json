        "fr-extract.jsonl": [
            {
                "entry_id": "cac0189e-8d19-3537-ac60-b36f1425c1dd",
                "word": "électrocardiographie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9ea16f64-b8d8-4910-bd46-93c2ca62f594",
                        "entry_id": "cac0189e-8d19-3537-ac60-b36f1425c1dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "électrocardiographies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "322d9937-045f-35e6-b500-e270c1e1b601",
                        "entry_id": "cac0189e-8d19-3537-ac60-b36f1425c1dd",
                        "glosses": [
                            "Examen médical de l’activité électrique du cœur réalisé grâce à un électrocardiographe et visualisé sur un électrocardiogramme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c645f99-2e7a-4c3f-823e-12700833cd27",
                                "sense_id": "322d9937-045f-35e6-b500-e270c1e1b601",
                                "text": "L’électrocardiographie est une technique peu coûteuse, rapide et indolore permettant de surveiller l’appareil cardiocirculatoire, de détecter les troubles du rythme et de prévenir l’infarctus du myocarde."
                            },
                            {
                                "example_id": "8fb1b2bd-118f-4d81-ab02-e7a8bd4af93e",
                                "sense_id": "322d9937-045f-35e6-b500-e270c1e1b601",
                                "text": "A partir de cet âge, un examen clinique pointu du médecin, et une électrocardiographie (Ecg), sont conseillés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbf4cae0-7644-47dd-b514-7b0c4fed91f1",
                        "source_entry_id": "cac0189e-8d19-3537-ac60-b36f1425c1dd",
                        "source_sense_id": "322d9937-045f-35e6-b500-e270c1e1b601",
                        "target_lang_word": "Elektrokardiographie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektrokardiographie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                        "entry_id": "31cca8dc-8b13-3b88-9bf1-655754c05901",
                                        "glosses": [
                                            "diagnostisches Verfahren der Aufzeichnung von Elektrokardiogrammen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f287e3-2d3e-40ee-a829-6a16cf31129d",
                                                "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                                "text": "Mittels der Elektrokardiographie können elektrische Vorgänge am Herzen und somit Funktionsstörungen des Organs aufgezeichnet bzw. sichtbar gemacht werden."
                                            },
                                            {
                                                "example_id": "39f26e3b-06c2-4ece-829c-bb64adde3ebe",
                                                "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                                "text": "Bei der Elektrokardiographie (EKG) werden die elektrischen Aktivitäten des Herzens abgeleitet und in Form von Kurven im Elektrokardiogramm (auch EKG) aufgezeichnet."
                                            },
                                            {
                                                "example_id": "2243699c-0a92-4e82-9a7a-857fc331ca6a",
                                                "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                                "text": "Eine obligate Elektrokardiographie zeigt meist verbreiterte Kammerkomplexe (QRS-Komplex), gelegentlich aber auch schmale Kammerkomplexe, sowie unzusammenhängende Vorhof- und Kammererregungen."
                                            },
                                            {
                                                "example_id": "fa83a5e0-2b9c-4212-af66-20d2f1b265bc",
                                                "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                                "text": "Anschließend wandte sich Holter der Elektrokardiographie zu, da die Oberflächenpotentiale des Herzens zehnfach stärker sind als die des Gehirns."
                                            },
                                            {
                                                "example_id": "e8bd8bda-4419-4bed-8165-98a980952595",
                                                "sense_id": "a1cc757b-d4d0-366e-919c-fe591ba995a7",
                                                "text": "Zusammen mit seinem Bruder, dem Mediziner Werner Hollmann wurden neue Erfassungsmethoden der Elektrokardiographie entwickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
