                        "examples": [
                            {
                                "example_id": "a82fe64d-dd53-47b7-8bdf-d2430323070b",
                                "sense_id": "d68732ca-f46e-363f-b04d-702549b9d58c",
                                "text": "Oui, vous savez ces boules de branches sèches qu’on voit passer sur une route dans les westerns, ça s’appelle des « tumbleweeds »."
                            },
                            {
                                "example_id": "16477c55-241c-4686-bea3-2b14cc981108",
                                "sense_id": "d68732ca-f46e-363f-b04d-702549b9d58c",
                                "text": "Les tumbleweeds (virevoltants, pour nos amis québécois), c’est joli dans les films, quand l’un d’entre eux traverse une route déserte pour accentuer la sensation d’immensité."
                            },
                            {
                                "example_id": "a1e26c97-b958-43d9-b2d6-820bd0017a34",
                                "sense_id": "d68732ca-f46e-363f-b04d-702549b9d58c",
                                "text": "Je ressemble à un de ces buissons qui traversent en boule les plaines de l’Ouest américain que l’on appelle les tumbleweeds."
                            }
                        ]
                    }
