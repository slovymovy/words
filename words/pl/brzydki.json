                {
                    "sense_id": "f4c927c6-e346-3c02-ab24-62e66e73b1e8",
                    "sense_definition": "Moralnie naganny, niezgodny z przyjętymi normami zachowania.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To był bardzo <w>brzydki</w> gest z twojej strony wobec przyjaciela.",
                            "target_lang_translations": {
                                "ru": "Это был очень <w>некрасивый</w> жест с твоей стороны по отношению к другу.",
                                "de": "Das war ein sehr <w>hässlicher</w> Zug von dir gegenüber deinem Freund.",
                                "en": "That was a very <w>mean</w> gesture on your part toward a friend.",
                                "zh": "你对朋友做出这样的举动，实在太<w>不体面</w>了。"
                            }
                        },
                        {
                            "text": "Nauczyciel zwrócił uwagę uczniowi za używanie <w>brzydkich</w> słów.",
                            "target_lang_translations": {
                                "ru": "Учитель сделал замечание ученику за использование <w>скверных</w> слов.",
                                "de": "Der Lehrer ermahnte den Schüler wegen der Verwendung <w>hässlicher</w> Wörter.",
                                "en": "The teacher scolded the student for using <w>bad</w> words.",
                                "zh": "老师因那个学生使用<w>难听</w>的字眼而批评了他。"
                            }
                        }
