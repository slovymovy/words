                                                "sense_id": "28d2e52b-a490-3371-ab64-2f654410a92b",
                                                "text": "Morgen fliege ich nach Vietnam."
                                            },
                                            {
                                                "example_id": "ed16fbda-ec8a-4673-b052-5c5a573fa773",
                                                "sense_id": "28d2e52b-a490-3371-ab64-2f654410a92b",
                                                "text": "Hanoi ist die Hauptstadt von Vietnam."
