                                        "entry_id": "c61c27ee-17c8-3ebe-a5d9-4dba366fc3f4",
                                        "glosses": [
                                            "A surgical procedure used to construct or reconstruct a vaginal canal and mucous membrane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6f96b8-11cb-44b7-a42a-7d99bfb9d104",
                                                "sense_id": "7be9d938-3422-352b-b492-3c01c95aa75e",
                                                "text": "Although a functional vaginoplasty is performed in a single stage, further feminization of the mons pubis can be performed at a second surgical stage."
                                            }
                                        ]
