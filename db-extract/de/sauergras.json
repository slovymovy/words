                    {
                        "translation_id": "3dbe168d-e6b1-4561-af9f-29c0119ba260",
                        "source_entry_id": "760db5b8-1bd0-3892-8145-51f85df4e24e",
                        "source_sense_id": "6172b383-ed1e-35ea-8f64-e6e71bfab22a",
