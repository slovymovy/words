                "senses": [
                    {
                        "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                        "entry_id": "227c243b-9fa5-3ed5-96f1-f8d083519c5c",
                        "glosses": [
                            "positives Bild junger deutscher Frauen in den 1950er und 60er Jahren in den USA; heute auch: besonders positive Wahrnehmung talentierter oder schon versierter junger Frauen in ihrer Branche, beispielsweise als Autorinnen oder Schauspielerinnen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86dc0bbd-4450-4a3b-8c92-d496e75dff5a",
                                "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                                "text": "Alle wollten hören, wie es dem „Frauleinwunder“ in New York ergangen war, dem ersten deutschen Model, das in die USA geholt worden war. Das alles machte mich ziemlich nervös, ich war diesen Trubel um meine Person nicht gewöhnt."
                            },
                            {
                                "example_id": "2507c2ea-2563-4410-a026-3fa2aa27f13a",
                                "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                                "text": "Der Frauenüberschuß [nach 1945] – der zu Mythen wie der »Trümmerfrau« und etwas später dem »Fräuleinwunder« führte – war kriegsbedingt und baute sich auch der Rückkehr der Kriegsgefangenen nur ganz allmählich, bis in die 1990er Jahre ab."
                            },
                            {
                                "example_id": "1a02ef8d-9a71-47c1-9d4a-08dfe0e6c5ad",
                                "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                                "text": "Die blonde Schwedin [und Schriftstellerin Liza Merklund], die seit etwa zwölf Jahren als cooles Fräuleinwunder und als heißer Krimi-Exportschlager in skandinavischen Medien firmiert, musste jetzt ungewohnt kleinlaut zugeben, dass sie es mit den Tatsachen nicht so genau nimmt wie gern von ihr behauptet."
                            },
                            {
                                "example_id": "41bde45c-f5ab-49e0-bd19-3bf93a897139",
                                "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                                "text": "Für ihr Debüt „Axolotl Roadkill“ musste Helene Hegemann viel Häme und Kritik einstecken, andere feierten die junge Autorin als Fräuleinwunder."
                            },
                            {
                                "example_id": "dfb41676-1c49-4123-bf77-810f3e854cb6",
                                "sense_id": "970ad722-905a-3b86-a6a1-e8b66800ddc8",
                                "text": "Immer mehr junge deutsche Profi-Golferinnen setzen sich auf der lukrativen amerikanischen LPGA-Tour durch. [Beispielsweise Caroline Masson aus Gladbeck oder Sandra Gal aus Leichlingen.] Ab Januar wird dieses Kontingent weiter wachsen. Was fast schon einem kleinen Fräuleinwunder gleichkommt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
