                "senses": [
                    {
                        "sense_id": "5829018e-51a5-35aa-8d80-4fd4ab015e6c",
                        "entry_id": "03728703-d098-3c95-b3c3-a343ca44c1a2",
                        "glosses": [
                            "Mixgetränk aus Apfelkorn und Wodka"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "756055ef-12e6-4d24-89a4-030953ab6e79",
                                "sense_id": "5829018e-51a5-35aa-8d80-4fd4ab015e6c",
                                "text": "„Appletini oder auch Apple Martini, ist ein international bekannter Cocktail und gehört zu der Gruppe Shortdrinks.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82fd4cb2-d36a-427a-a697-b4dc3eec31fd",
                        "source_entry_id": "03728703-d098-3c95-b3c3-a343ca44c1a2",
                        "source_sense_id": "5829018e-51a5-35aa-8d80-4fd4ab015e6c",
                        "source_sense_description": "Mixgetränk aus Apfelkorn und Wodka",
                        "target_lang_word": "appletini",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appletini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63ede00c-612c-3067-9b99-6bada44de4b3",
                                        "entry_id": "090e1d5a-6491-3573-bded-7c7fa4a473ec",
                                        "glosses": [
                                            "A cocktail of vodka and either apple juice, apple cider, or apple liqueur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "182cb7f9-6eaf-4846-bde9-2c6c6a38035e",
                                                "sense_id": "63ede00c-612c-3067-9b99-6bada44de4b3",
                                                "text": "It was all downhill from there. Now you've got the pickletini, the appletini, the choclatini, and even—good heavens—the bacontini. As different types of alcohol were used in place of gin, that began to shift the name too. In addition to the vodkatini, there's the sakitini, the whiskitini (more commonly known as a smokey martini, but I'm on a roll, here), and the taqini. If you substitute beer for the gin, you've got a mantini."
                                            },
                                            {
                                                "example_id": "c8ea972e-6172-4419-841c-87c360deb889",
                                                "sense_id": "63ede00c-612c-3067-9b99-6bada44de4b3",
                                                "text": "“Ooh, somebody's been working out.” “Oh, are you kidding? I practically live at the gym.” “Oh. [giggles] I'm called Vespertina.” “Well, I call you adorable. Girlfriend, that costume is to die for. Barkeep, two appletinis, s'il vous plait.”"
                                            },
                                            {
                                                "example_id": "339e2226-e09f-4eed-aa89-d420988ffbcb",
                                                "sense_id": "63ede00c-612c-3067-9b99-6bada44de4b3",
                                                "text": "Today so many almost ridiculous versions of this drink exist that some drink menus actually have a special martini page. Varieties include the appletini, hazeltini, cherry martini, Cajun martini, habanero martini, pometini, chocolatini, and even a bacontini! Lest it be buried forever in this avalanche of new \"exoticatinis,\" here is a classic recipe from a very old bartender's manual."
                                            },
                                            {
                                                "example_id": "767b36fc-fc86-4dc9-9396-4e75f7a834a0",
                                                "sense_id": "63ede00c-612c-3067-9b99-6bada44de4b3",
                                                "text": "\"I don't know what you like, so I brought a variety,\" he said. \"We have appletinis, berrytinis, even a bananatini, and, of course, the highly coveted chocotini. I've heard it gives women orgasms.\" He winked. \"Oh ! I'll be careful with that one.\" \"Let's find a place to sit and get to know each other,\" Cory said, leading her to a high table surrounded by stools."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
