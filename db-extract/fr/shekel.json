                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c381d39-f945-3ba9-bbe7-dfb1ccd85328",
                        "entry_id": "56284be8-9b68-3d61-96b8-c8a9a8798779",
