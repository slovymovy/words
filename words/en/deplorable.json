{
    "word_family": [
        "deplore",
        "deplorably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4aa43d95-df9d-30a8-872b-d9d916e48071",
                    "sense_definition": "Deserving strong condemnation; shockingly bad or wretched.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were living in <w>deplorable</w> conditions without access to clean water or heat.",
                            "target_lang_translations": {
                                "zh": "孩子们生活在<w>糟糕的</w>环境中，无法获得清洁的饮用水或取暖设施。"
                            }
                        },
                        {
                            "text": "His <w>deplorable</w> behavior at the meeting caused everyone to lose respect for him.",
                            "target_lang_translations": {
                                "zh": "他在会议上<w>令人震惊的</w>表现让所有人都对他失去了尊重。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pathetic",
                        "miserable",
                        "pitiful"
                    ],
                    "common_phrases": [
                        "deplorable conditions",
                        "deplorable state"
                    ],
                    "target_lang_definitions": {
                        "zh": "指极其糟糕、令人无法接受或应受强烈谴责的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "形容情况或质量极差。"
                            },
                            {
                                "target_lang_word": "令人震惊的",
                                "target_lang_sense_clarification": "形容程度严重到令人难以置信。"
                            },
                            {
                                "target_lang_word": "可悲的",
                                "target_lang_sense_clarification": "形容境况凄惨或行为卑劣。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e398c979-9964-316d-a7a0-3cc0b3bb47f3",
                    "sense_definition": "Worthy of compassion or sorrow; lamentable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community was deeply affected by the <w>deplorable</w> loss of the historic library in the fire.",
                            "target_lang_translations": {
                                "zh": "那座历史悠久的图书馆在火灾中被毁，这一<w>令人遗憾的</w>损失深深影响了整个社区。"
                            }
                        },
                        {
                            "text": "She found herself in a <w>deplorable</w> situation after losing her job and home in the same month.",
                            "target_lang_translations": {
                                "zh": "在同一个月里失去工作和住所后，她陷入了<w>悲惨的</w>境地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lamentable",
                        "regrettable",
                        "sorrowful",
                        "tragic",
                        "woeful"
                    ],
                    "common_phrases": [
                        "deplorable situation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指令人遗憾、悲伤或值得同情的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人遗憾的",
                                "target_lang_sense_clarification": "指事情的结果让人感到惋惜。"
                            },
                            {
                                "target_lang_word": "悲惨的",
                                "target_lang_sense_clarification": "指境遇令人同情或悲伤。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d87ccc69-9da5-34a2-8b24-ed54cfcbc5b1",
                    "sense_definition": "A person or thing that is to be deplored.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "bad_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house was filled with broken furniture and other <w>deplorables</w> that needed to be thrown away.",
                            "target_lang_translations": {
                                "zh": "老房子里堆满了破旧家具和其他需要扔掉的<w>废弃物</w>。"
                            }
                        },
                        {
                            "text": "He viewed the neglected ruins as mere <w>deplorables</w> of a forgotten era.",
                            "target_lang_translations": {
                                "zh": "他将这些被遗弃的废墟视为那个被遗忘时代的<w>可鄙之物</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指应受谴责的人或物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "应受谴责之物",
                                "target_lang_sense_clarification": "指需要被清理或废弃的破旧物品。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71c3767d-eb5c-31c7-b510-18047d29217d",
                    "sense_definition": "A term used to describe supporters of Donald Trump.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "political_term",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The political commentator discussed how the candidate's base, often labeled as <w>deplorables</w>, remained loyal.",
                            "target_lang_translations": {
                                "zh": "政治评论员讨论了该候选人的基本盘——那些常被贴上<w>不可救药者</w>标签的人——是如何保持忠诚的。"
                            }
                        },
                        {
                            "text": "Many voters reclaimed the label of <w>deplorables</w> as a badge of honor during the election cycle.",
                            "target_lang_translations": {
                                "zh": "在选举周期中，许多选民将“<w>不可救药者</w>”这一标签重新定义为一种荣誉勋章。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used primarily in United States political discourse."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美国政治术语，指唐纳德·特朗普的支持者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不可救药者",
                                "target_lang_sense_clarification": "指被政治对手贴上标签的特定选民群体。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}