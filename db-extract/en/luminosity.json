            {
                "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                "word": "luminosity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9ef9fe4f-74b5-4afa-9f00-39955ba35be4",
                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "tags": [
                            "plural"
                        ],
                        "form": "luminosities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85962a4a-ab73-3bf2-9159-409db78092c6",
                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "glosses": [
                            "the state of being luminous, or a luminous object; brilliance or radiance"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "08621518-7f8a-344b-a6d9-dea9e381c9a4",
                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "glosses": [
                            "the ratio of luminous flux to radiant flux at the same wavelength; the luminosity factor"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                        "entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "glosses": [
                            "The rate at which a star radiates energy in all directions."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ace6c75d-b8bd-4f29-b208-d83e04520753",
                                "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                                "text": "We recognize the same pattern as in the left panel, with dM stars being much less frequent flarers than dMe stars of similar luminosity."
                            },
                            {
                                "example_id": "8db37e63-8f5b-4bb0-9fcd-fbc59c624a23",
                                "sense_id": "444edf01-d860-3f54-9f04-d5100024b10e",
                                "text": "We derive rotation periods, photometric activity indices, flaring energies, mass loss rates, gyrochronological ages, X-ray luminosities and consider implications for the planetary magnetospheres and habitability."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66be3411-7608-466e-a9e7-33f7d9fa5b23",
                        "source_entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "source_sense_description": "state of being luminous",
                        "target_lang_word": "luminosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29f37e3b-aee7-356f-8d5e-ee6b9d55559d",
                                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                                        "glosses": [
                                            "Qualité de ce qui est lumineux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4eae170-1981-4418-96df-cd3e9426fb8d",
                                                "sense_id": "29f37e3b-aee7-356f-8d5e-ee6b9d55559d",
                                                "text": "Les paramètres numériques de dérawtisation (luminosité, facteur de contraste, saturation des teintes, netteté, accentuation, filtres, etc.) ont été testés comparativement, avant leur sélection définitive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0853025e-e74c-31bd-9f0f-7b682186fe18",
                                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                                        "glosses": [
                                            "Énergie rayonnée par unité de temps par un astre, mesurée en watt, en erg par seconde ou en luminosité solaire."
                                        ],
                                        "tags": [],
                                        "note": "à ne pas confondre avec l’intensité lumineuse",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d69a1f2-4be4-350c-af45-33f13526d4a8",
                                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                                        "glosses": [
                                            "Taux d’évènements qu’un détecteur est susceptible d’enregistrer."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ca827e0-058a-4632-810a-3dccfac6ff4c",
                                                "sense_id": "7d69a1f2-4be4-350c-af45-33f13526d4a8",
                                                "text": "Le nombre de collisions qui se produisent lors d’une réaction particulière entre particules élémentaires est alors simplement l’intégrale de la luminosité multipliée par la section efficace (exprimée en cm²) pour cette réaction, ce qui donne une expression de sa probabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b36a1bf-e067-3613-83bd-8591d9884597",
                                        "entry_id": "f97d2b5c-b450-34cb-b9d5-4db85e2da14f",
                                        "glosses": [
                                            "Caractère d’une couleur qui produit sur l’œil une sensation lumineuse de niveau élevé. Note : le terme clarté est employé pour un objet coloré et le terme luminosité pour une source de lumière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54a01c93-7473-4ae3-b226-974a868e61ac",
                        "source_entry_id": "a34151c5-1f32-38d3-82c2-262f5645ef12",
                        "source_sense_description": "state of being luminous",
                        "target_lang_word": "Helligkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helligkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b8a495a-d5ca-33f1-8cfb-8e374ba02f84",
                                        "entry_id": "0fcad35d-2143-38c2-bc2b-40defdbeed1a",
                                        "glosses": [
                                            "Vorhandensein von Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f5c03b7-b446-4c39-a2c3-4e1a80e99b18",
                                                "sense_id": "6b8a495a-d5ca-33f1-8cfb-8e374ba02f84",
                                                "text": "Im Tagesrhythmus wechseln sich Helligkeit und Dunkelheit ab."
                                            },
                                            {
                                                "example_id": "8e5daa6e-1c7b-401d-8721-31fb728ba767",
                                                "sense_id": "6b8a495a-d5ca-33f1-8cfb-8e374ba02f84",
                                                "text": "„Im Westen stand die Sonne schon tief über dem Sumpf, doch bis die Dunkelheit anbrach, konnten sie noch mit zwei Stunden Helligkeit rechnen.“"
                                            },
                                            {
                                                "example_id": "60233754-508f-4060-9477-d53b3a3eb73c",
                                                "sense_id": "6b8a495a-d5ca-33f1-8cfb-8e374ba02f84",
                                                "text": "„Die Helligkeit nahm zu.“"
                                            },
                                            {
                                                "example_id": "f0b8cc78-ccfe-4076-a531-29866c585560",
                                                "sense_id": "6b8a495a-d5ca-33f1-8cfb-8e374ba02f84",
                                                "text": "„Die Helligkeit mußte meinen Triumph noch vergrößern und mich ihre Demütigung und Beschämung noch mehr genießen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc724413-f4bb-3994-a1df-f68677c45896",
                                        "entry_id": "0fcad35d-2143-38c2-bc2b-40defdbeed1a",
                                        "glosses": [
                                            "Stärke des Lichts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0428bae2-867c-4251-9023-be92ea59b87d",
                                                "sense_id": "bc724413-f4bb-3994-a1df-f68677c45896",
                                                "text": "Die Helligkeit reichte gerade noch aus, um die Straßennamen zu entziffern."
                                            },
                                            {
                                                "example_id": "c74b3416-f57e-482e-97f8-99c2c387be22",
                                                "sense_id": "bc724413-f4bb-3994-a1df-f68677c45896",
                                                "text": "„Die durch eine Kombination von Sonnenstrahlen und Schnee erzeugte Helligkeit des Bildeindrucks erinnert an einen geradezu überirdischen Glanz.“"
                                            },
                                            {
                                                "example_id": "5caa8915-4f06-4d04-b8b6-ade54f88062a",
                                                "sense_id": "bc724413-f4bb-3994-a1df-f68677c45896",
                                                "text": "„Es brannte kein Licht, aber von draußen kam noch genug Helligkeit herein.“"
                                            },
                                            {
                                                "example_id": "c9968a1d-533f-4363-b4b8-caf52fe952ae",
                                                "sense_id": "bc724413-f4bb-3994-a1df-f68677c45896",
                                                "text": "„Der Juli mit seiner permanenten Helligkeit überstrahlte noch alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
