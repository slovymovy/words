                        "glosses": [
                            "Geld der öffentlichen Hand zur Unterstützung einer bestimmten Sache"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "4adfd896-9db5-4e75-915b-d29d8393320e",
                                "sense_id": "e771bc36-659c-3360-8794-a72297c44ca9",
                                "text": "„Deutsche Filme entstehen durch öffentliche Fördergelder, und auch in diesen Gremien sitzen Kirchenvertreter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
