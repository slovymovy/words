                },
                {
                    "sense_id": "3f71e8a6-362c-3540-ab4c-f42338802801",
                    "sense_definition": "Rompre la bonne entente ou provoquer une dispute entre des personnes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une vieille querelle d'héritage a suffi à <w>brouiller</w> ces deux frères.",
                            "target_lang_translations": {
                                "en": "An old inheritance quarrel was all it took to <w>estrange</w> these two brothers.",
                                "ru": "Давней ссоры из-за наследства хватило, чтобы <w>рассорить</w> этих двух братьев.",
                                "de": "Ein alter Erbstreit reichte schon aus, um diese beiden Brüder zu <w>entzweien</w>.",
                                "es": "Una vieja disputa por una herencia bastó para <w>enemistar</w> a estos dos hermanos.",
                                "zh": "一场陈年的遗产纠纷就足以<w>离间</w>这两兄弟。"
                            }
                        },
                        {
                            "text": "Il refuse de parler de politique pour ne pas se <w>brouiller</w> avec ses voisins.",
                            "target_lang_translations": {
                                "en": "He refuses to talk about politics so as not to <w>fall out</w> with his neighbours.",
                                "ru": "Он отказывается говорить о политике, чтобы не <w>поссориться</w> с соседями.",
                                "de": "Er weigert sich, über Politik zu sprechen, um <w>sich</w> nicht mit seinen Nachbarn zu <w>zerstreiten</w>.",
                                "es": "Se niega a hablar de política para no <w>enemistarse</w> con sus vecinos.",
                                "zh": "他拒绝谈论政治，免得和邻居<w>闹翻</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "désunir",
                        "diviser"
                    ],
                    "antonyms": [
                        "rapprocher",
                        "réconcilier"
                    ],
                    "common_phrases": [
                        "se brouiller avec"
                    ],
                    "target_lang_definitions": {
                        "en": "To break a friendly relationship or cause a quarrel between people.",
                        "ru": "Разрушать дружеские отношения или вызывать ссору между людьми.",
                        "de": "Eine gute Beziehung zwischen Menschen beenden oder einen Streit zwischen ihnen auslösen.",
                        "es": "Romper una buena relación entre personas o provocar una riña entre ellas.",
                        "zh": "破坏人与人之间的友好关系，或引起争执。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "alienate",
                                "target_lang_sense_clarification": "friends or allies"
                            },
                            {
                                "target_lang_word": "estrange",
                                "target_lang_sense_clarification": "family members or close friends"
                            },
                            {
                                "target_lang_word": "divide",
                                "target_lang_sense_clarification": "people or communities"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рассорить",
                                "target_lang_sense_clarification": "друзей, близких людей"
                            },
                            {
                                "target_lang_word": "поссорить",
                                "target_lang_sense_clarification": "соседей, знакомых"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entzweien",
                                "target_lang_sense_clarification": "Freunde oder Familie"
                            },
                            {
                                "target_lang_word": "entfremden",
                                "target_lang_sense_clarification": "Verwandte oder enge Freunde"
                            },
                            {
                                "target_lang_word": "sich zerstreiten",
                                "target_lang_sense_clarification": "mit Nachbarn oder Bekannten"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enemistar",
                                "target_lang_sense_clarification": "amigos o familiares"
                            },
                            {
                                "target_lang_word": "malquistar",
                                "target_lang_sense_clarification": "vecinos o conocidos"
                            },
                            {
                                "target_lang_word": "desavenir",
                                "target_lang_sense_clarification": "parejas o familias"
                            }
                        ],
                        "zh": [
                            {
