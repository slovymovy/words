                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e92840c-37c2-45b6-9db3-54e71baa617a",
                                                "sense_id": "5f3f0449-b6f6-3274-bae4-5c74bab5f1b3",
                                                "text": "Bero ist ein tapferer Pikenier."
                                            },
                                            {
                                                "example_id": "58070db1-223d-4951-a2ee-08a75eb8eb08",
                                                "sense_id": "5f3f0449-b6f6-3274-bae4-5c74bab5f1b3",
                                                "text": "„Neben den Pikenieren und von diesen geschützt, kam eine weitaus geringere Zahl von Hakenbüchsenschützen zum Einsatz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91db019e-0dd5-43df-9301-cb81ca40a7de",
                        "source_entry_id": "0e004df4-902f-31ae-8a58-059d6e3166f4",
                        "source_sense_id": "aa0cceb2-bfb3-3182-b1c8-d36e6723597f",
                        "target_lang_word": "pikeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pikeman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d0d46e-c1ed-3690-94bd-d8b5b7e64bb3",
                                        "entry_id": "ad2b7ac0-0f74-3245-937f-ea9f92b6cc1e",
                                        "glosses": [
                                            "A soldier armed with a pike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6a6721-4218-44d8-a7cb-ccf3e3cfe8c7",
                                                "sense_id": "e2d0d46e-c1ed-3690-94bd-d8b5b7e64bb3",
                                                "text": "Vitellius comming on couragiouſly with his pikemen and his harquebuſiers , deuided into two wings, charged them fiercely"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785e26f8-8732-31f7-9d0e-506f14a9b843",
                                        "entry_id": "ad2b7ac0-0f74-3245-937f-ea9f92b6cc1e",
                                        "glosses": [
                                            "A person who operates a turnpike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2477ddd0-cd7b-4051-a9ba-407cbd6d3729",
                                                "sense_id": "785e26f8-8732-31f7-9d0e-506f14a9b843",
                                                "text": "Then there was the music of the rattling harness, and the ring of the horses' feet on the hard road, and the glare of the two bright lamps through the steaming hoar frost, over the leaders' ears, into the darkness; and the cheery toot of the guard's horn, to warn some drowsy pikeman or the ostler at the next change ; and the looking forward to daylight — and last but not least, the delight of returning sensation in your toes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75ace4d9-6d5c-3abd-b1d0-38414c8a16e6",
                                        "entry_id": "ad2b7ac0-0f74-3245-937f-ea9f92b6cc1e",
                                        "glosses": [
                                            "A miner who works with a pick."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16cf750b-73bd-4158-a1cb-54a567e2120b",
                                                "sense_id": "75ace4d9-6d5c-3abd-b1d0-38414c8a16e6",
                                                "text": "“My missus told it me at the pit-head, when she brought me my breakfast,” said a pikeman to his comrade, and he struck a vigorous blow at the broad seam on which he was working."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
