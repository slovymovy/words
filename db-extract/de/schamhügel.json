                ],
                "senses": [
                    {
                        "sense_id": "1cf9af37-3ccf-31ef-89a0-b57207d7d591",
                        "entry_id": "682f8ea0-e0d8-3e8e-bcec-dfe83be02322",
                        "glosses": [
                            "leichte Erhebung über dem weiblichen Schambein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f179fc7d-5cf7-456e-ba6f-3dd920beb306",
                                "sense_id": "1cf9af37-3ccf-31ef-89a0-b57207d7d591",
                                "text": "„Eine leuchtende Blässe, wie Blütenstaub, das Negativ des Badeanzugs vom letzten Sommer, hob ihren überraschend üppigen Schamhügel hervor.“"
                            },
                            {
                                "example_id": "fbe6b314-967f-4745-936e-8df368d76a84",
                                "sense_id": "1cf9af37-3ccf-31ef-89a0-b57207d7d591",
                                "text": "„Seit der frenetischen Hochzeit pflegte sie sich, wo sie auch saß oder stand, heftig am Schamhügel zu kratzen, den die Allergien seitdem bevorzugten, nachdem der vergeblich angeheiratete Regisseur daraus keinen Feldherrnhügel gemacht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
