{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "478eeca9-7fea-39fc-bb7b-28505f9ee7cd",
                    "sense_definition": "Op dit moment; in de huidige tijd.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <nou> echt geen tijd om naar je verhaal te luisteren.",
                            "target_lang_translations": {
                                "en": "I really don't have time <now> to listen to your story.",
                                "ru": "У меня <сейчас> правда нет времени слушать твою историю.",
                                "it": "Non ho proprio tempo <w>adesso</w> di ascoltare la tua storia."
                            }
                        },
                        {
                            "text": "Wat is er <nou> eigenlijk precies aan de hand in die straat?",
                            "target_lang_translations": {
                                "en": "What is <now> actually going on in that street?",
                                "ru": "Что <сейчас> на самом деле происходит на этой улице?",
                                "it": "Che cosa sta succedendo esattamente <w>ora</w> in quella strada?"
                            }
                        }
                    ],
                    "synonyms": [
                        "nu"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele variant van 'nu'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At this moment; in the current time.",
                        "ru": "В данный момент; сейчас (разговорный вариант).",
                        "it": "In questo momento; nel tempo presente (variante informale di 'nu')."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "at the present time"
                            },
                            {
                                "target_lang_word": "currently",
                                "target_lang_sense_clarification": "at this time"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "в настоящее время"
                            },
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "в данный момент"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ora",
                                "target_lang_sense_clarification": "al momento presente"
                            },
                            {
                                "target_lang_word": "adesso",
                                "target_lang_sense_clarification": "in questo momento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4424a888-f892-3948-9e9d-c8ebdc4a3962",
                    "sense_definition": "Drukt ongeduld of een dringende aansporing uit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Schiet <nou> toch eens op, we komen nog te laat!",
                            "target_lang_translations": {
                                "en": "Hurry up <now>, we're going to be late!",
                                "ru": "Поторапливайся <же>, мы опоздаем!",
                                "it": "Sbrigati <w>un po'</w>, faremo tardi!"
                            }
                        },
                        {
                            "text": "Doe <nou> niet zo vervelend tegen je kleine broertje.",
                            "target_lang_translations": {
                                "en": "Don't be so annoying <now> to your little brother.",
                                "ru": "<Ну> не будь таким вредным по отношению к младшему брату.",
                                "it": "<w>Dai</w>, non essere così fastidioso con tuo fratello minore."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kom nou",
                        "ga nou",
                        "hou nou op"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses impatience or urgent encouragement.",
                        "ru": "Выражает нетерпение или настоятельную просьбу.",
                        "it": "Esprime impazienza o un sollecito urgente."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "now",
                                "target_lang_sense_clarification": "indicating urgency or command"
                            },
                            {
                                "target_lang_word": "come on",
                                "target_lang_sense_clarification": "encouragement or impatience"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "побуждение к действию"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "dai",
                                "target_lang_sense_clarification": "esortazione o impazienza"
                            },
                            {
                                "target_lang_word": "su",
                                "target_lang_sense_clarification": "incitamento a fare in fretta"
                            },
                            {
                                "target_lang_word": "insomma",
                                "target_lang_sense_clarification": "esclamazione di impazienza"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de97a67-cfd0-3014-881c-8d18af6ee001",
                    "sense_definition": "Geeft een relativering, berusting of nadruk aan in een bewering.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is <nou> eenmaal hoe de regels hier werken.",
                            "target_lang_translations": {
                                "en": "That is <just> how the rules work here.",
                                "ru": "Так <уж> здесь работают правила.",
                                "it": "È <w>semplicemente</w> così che funzionano le regole qui."
                            }
                        },
                        {
                            "text": "Het is <nou> ook weer niet zo erg als je denkt.",
                            "target_lang_translations": {
                                "en": "It is not <really> as bad as you think.",
                                "ru": "Это <же> не так плохо, как ты думаешь.",
                                "it": "Non è <w>poi</w> così male come pensi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nou eenmaal"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates relativization, resignation, or emphasis in a statement.",
                        "ru": "Придает оттенок смирения, констатации факта или смягчения.",
                        "it": "Indica relativizzazione, rassegnazione o enfasi in un'affermazione."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just",
                                "target_lang_sense_clarification": "indicating resignation or simple fact"
                            },
                            {
                                "target_lang_word": "simply",
                                "target_lang_sense_clarification": "emphasizing a fact"
                            },
                            {
                                "target_lang_word": "really",
                                "target_lang_sense_clarification": "used for emphasis"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "уж",
                                "target_lang_sense_clarification": "констатация факта (nou eenmaal)"
                            },
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "смягчение или очевидность"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "proprio",
                                "target_lang_sense_clarification": "usato per enfasi"
                            },
                            {
                                "target_lang_word": "ormai",
                                "target_lang_sense_clarification": "indica rassegnazione o dato di fatto"
                            },
                            {
                                "target_lang_word": "semplicemente",
                                "target_lang_sense_clarification": "per sottolineare un fatto"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "47e82ec9-3c14-3f65-978e-dee1ffd9762d",
                    "sense_definition": "Wordt gebruikt om een zin te beginnen, iemand aan te sporen of een gesprek af te ronden.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Nou>, vertel me de waarheid dan maar meteen.",
                            "target_lang_translations": {
                                "en": "<Well>, then just tell me the truth immediately.",
                                "ru": "<Ну>, расскажи мне правду прямо сейчас.",
                                "it": "<w>Beh</w>, allora dimmi subito la verità."
                            }
                        },
                        {
                            "text": "<Nou>, laten we dan maar snel naar huis gaan.",
                            "target_lang_translations": {
                                "en": "<Well>, let's just go home quickly then.",
                                "ru": "<Ну>, давай тогда поскорее пойдем домой.",
                                "it": "<w>Allora</w>, andiamo a casa in fretta."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nou en",
                        "nou ja",
                        "nou goed"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to start a sentence, encourage someone, or wrap up a conversation.",
                        "ru": "Используется для начала фразы, побуждения или завершения разговора.",
                        "it": "Usato per iniziare una frase, incoraggiare qualcuno o concludere una conversazione."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "discourse marker"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "вводное слово"
                            },
                            {
                                "target_lang_word": "итак",
                                "target_lang_sense_clarification": "подведение итога"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "beh",
                                "target_lang_sense_clarification": "interiezione per iniziare un discorso"
                            },
                            {
                                "target_lang_word": "allora",
                                "target_lang_sense_clarification": "usato per introdurre una frase o trarre conclusioni"
                            },
                            {
                                "target_lang_word": "bene",
                                "target_lang_sense_clarification": "usato per avviare o chiudere un discorso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92fd08aa-45f2-3ab3-a59d-03ab78edb112",
                    "sense_definition": "Drukt verbazing, ongeloof of verontwaardiging uit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Nou>! Dat had ik totaal niet verwacht van hem.",
                            "target_lang_translations": {
                                "en": "<Well>! I totally didn't expect that from him.",
                                "ru": "<Ну>! Я совсем не ожидал этого от него.",
                                "it": "<w>Ma dai</w>! Non me lo sarei mai aspettato da lui."
                            }
                        },
                        {
                            "text": "<Nou> moe, ik wist niet dat het zo hard waaide.",
                            "target_lang_translations": {
                                "en": "<Well> I never, I didn't know it was blowing so hard.",
                                "ru": "<Надо же>, я не знал, что ветер такой сильный.",
                                "it": "<w>Roba da matti</w>, non sapevo che tirasse così tanto vento."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nou moe",
                        "nou breekt mijn klomp"
                    ],
                    "target_lang_definitions": {
                        "en": "Expresses surprise, disbelief, or indignation.",
                        "ru": "Выражает удивление, недоверие или возмущение.",
                        "it": "Esprime sorpresa, incredulità o indignazione."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "exclamation of surprise or indignation"
                            },
                            {
                                "target_lang_word": "gee",
                                "target_lang_sense_clarification": "expression of surprise"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ну и ну",
                                "target_lang_sense_clarification": "сильное удивление"
                            },
                            {
                                "target_lang_word": "надо же",
                                "target_lang_sense_clarification": "изумление"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ma dai",
                                "target_lang_sense_clarification": "espressione di incredulità o sorpresa"
                            },
                            {
                                "target_lang_word": "accidenti",
                                "target_lang_sense_clarification": "esclamazione di stupore o disappunto"
                            },
                            {
                                "target_lang_word": "ma pensa",
                                "target_lang_sense_clarification": "espressione di meraviglia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "539a7c0d-79da-3d30-a060-bf749598ba55",
                    "sense_definition": "Drukt twijfel of aarzeling uit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Nou>, ik weet het nog niet zo zeker hoor.",
                            "target_lang_translations": {
                                "en": "<Well>, I'm not so sure about that.",
                                "ru": "<Ну>, я в этом еще не так уверен.",
                                "it": "<w>Mah</w>, non ne sono ancora così sicuro."
                            }
                        },
                        {
                            "text": "<Nou>... misschien kunnen we het beter morgen doen.",
                            "target_lang_translations": {
                                "en": "<Well>... maybe we'd better do it tomorrow.",
                                "ru": "<Ну>... может быть, нам лучше сделать это завтра.",
                                "it": "<w>Beh</w>... forse è meglio se lo facciamo domani."
                            }
