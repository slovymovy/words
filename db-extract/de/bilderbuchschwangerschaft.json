                "senses": [
                    {
                        "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                        "entry_id": "b939e185-be7a-31c6-838a-fb7f7b26edea",
                        "glosses": [
                            "völlig problemloser Verlauf des Austragens eines Kindes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b647f96-cf86-4e56-8ca7-c0e7231d78d9",
                                "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                                "text": "Nach Bilderbuchschwangerschaft und Kaiserschnitt nimmt Rosi drei Jahre Elternzeit und genießt jeden Augenblick."
                            },
                            {
                                "example_id": "0bfda567-0be2-4ec1-997f-a75b643bf69b",
                                "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                                "text": "Meine Frau hatte eine Bilderbuchschwangerschaft. Nach 9 Monaten brachte sie uns eine gesunde Tochter zur Welt."
                            },
                            {
                                "example_id": "7e3ba9ee-21c8-41d7-a56d-9673c63de07d",
                                "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                                "text": "Meine erste Schwangerschaft war eine „Bilderbuchschwangerschaft“."
                            },
                            {
                                "example_id": "4b8755bf-ed05-446e-a91d-1afcd52af561",
                                "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                                "text": "Mit 30 wurde ich schwanger und wir waren sehr glücklich darüber. Es war eine Bilderbuchschwangerschaft. Ich habe in der Zeit der Schwangerschaft gearbeitet und mir ging es einfach nur gut."
                            },
                            {
                                "example_id": "acff743c-bf7c-44ba-9441-b1c9b74ed53c",
                                "sense_id": "2d6e0f55-13ad-3260-a3ac-7b60efd66109",
                                "text": "Sicher, Zwillinge erforderten zusätzliche Aufmerksamkeit, aber ansonsten waren anscheinend alle überzeugt, dass ich geradezu eine Bilderbuchschwangerschaft hinlegte."
                            }
                        ],
