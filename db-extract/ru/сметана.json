                                                "example_id": "97ebcbaa-e493-41c1-bbb5-53a596113b5d",
                                                "sense_id": "0307e3b0-23d9-3f80-a4da-69ab2502a877",
                                                "text": "Skoro idziesz do sklepu, to kup dwie śmietany."
