{
    "word_family": [
        "chiming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bd6df65-6d27-3a80-895e-b1552f73aecb",
                    "sense_definition": "to make the clear, ringing sound of a bell or a similar device",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The microwave <w>chimed</w> to indicate that it was done cooking.",
                            "target_lang_translations": {
                                "ru": "Микроволновка <w>пропищала</w>, сигнализируя о завершении работы.",
                                "zh": "微波炉<w>鸣响</w>了，提示烹饪结束。"
                            }
                        },
                        {
                            "text": "I got up for lunch as soon as the wall clock began <w>chiming</w> noon.",
                            "target_lang_translations": {
                                "ru": "Я встал обедать, как только настенные часы начали <w>отбивать</w> полдень.",
                                "zh": "挂钟刚开始<w>敲响</w>正午，我就起身去吃午饭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peal",
                        "toll",
                        "ringer"
                    ],
                    "common_phrases": [
                        "clock began chiming",
                        "chime the hours"
                    ],
                    "target_lang_definitions": {
                        "ru": "издавать чистый, звонкий звук колокола или аналогичного устройства",
                        "zh": "发出像钟声一样清脆、响亮的声音"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "издавать металлический звук"
                            },
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "о часах или приборах"
                            },
                            {
                                "target_lang_word": "пробить",
                                "target_lang_sense_clarification": "о часах, указывающих время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸣响",
                                "target_lang_sense_clarification": "指钟表或设备发出声音"
                            },
                            {
                                "target_lang_word": "敲响",
                                "target_lang_sense_clarification": "指钟表报时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d083e9ab-0913-3c9c-bd83-9b639ee654e6",
                    "sense_definition": "to agree or correspond with something else",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The other lab's results <w>chimed</w> with mine, so I knew we were on the right track.",
                            "target_lang_translations": {
                                "ru": "Результаты другой лаборатории <w>совпали</w> с моими, так что я понял, что мы на верном пути.",
                                "zh": "另一间实验室的结果与我的<w>吻合</w>，所以我知道我们的方向是对的。"
                            }
                        },
                        {
                            "text": "His views on the project <w>chime</w> with the rest of the team's opinions.",
                            "target_lang_translations": {
                                "ru": "Его взгляды на проект <w>согласуются</w> с мнением остальной команды.",
                                "zh": "他对这个项目的看法与团队其他人的意见很<w>一致</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chime with",
                        "chime in with"
                    ],
                    "target_lang_definitions": {
                        "ru": "согласовываться или соответствовать чему-либо",
                        "zh": "与某事相符或一致"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соответствовать",
                                "target_lang_sense_clarification": "быть в соответствии"
                            },
                            {
                                "target_lang_word": "согласовываться",
                                "target_lang_sense_clarification": "совпадать по смыслу"
                            },
                            {
                                "target_lang_word": "перекликаться",
                                "target_lang_sense_clarification": "иметь сходство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吻合",
                                "target_lang_sense_clarification": "指观点或结果一致"
                            },
                            {
                                "target_lang_word": "一致",
                                "target_lang_sense_clarification": "指意见或看法相同"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51bf4ac0-61ac-3d2d-a665-1d14f1e55aaf",
                    "sense_definition": "to cause something to sound in harmony or to play a tune on bells",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmiths would <w>chime</w> their sounding hammers in a rhythmic pattern.",
                            "target_lang_translations": {
                                "ru": "Кузнецы ритмично <w>ударяли</w> своими звонкими молотами.",
                                "zh": "铁匠们有节奏地<w>敲击</w>着他们那发出清脆声响的锤子。"
                            }
                        },
                        {
                            "text": "The bell ringer began to <w>chime</w> a traditional melody for the wedding.",
                            "target_lang_translations": {
                                "ru": "Звонарь начал <w>вызванивать</w> традиционную свадебную мелодию.",
                                "zh": "敲钟人开始为婚礼<w>鸣奏</w>一首传统乐曲。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chime sounding hammers"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "transitive use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "заставлять что-либо звучать гармонично или исполнять мелодию на колоколах",
                        "zh": "使某物发出和谐的声音，或用钟演奏乐曲"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызванивать",
                                "target_lang_sense_clarification": "исполнять мелодию на колоколах"
                            },
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "ритмично ударять, извлекая звук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敲击",
                                "target_lang_sense_clarification": "指有节奏地敲打发出声音"
                            },
                            {
                                "target_lang_word": "鸣奏",
                                "target_lang_sense_clarification": "指用钟演奏旋律"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5227853-8a10-3765-ac04-40b128f481f4",
                    "sense_definition": "to utter or recite something harmoniously or rhythmically",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children would <w>chime</w> his childish verse during their afternoon games.",
                            "target_lang_translations": {
                                "ru": "Дети хором <w>распевали</w> его детские стишки во время дневных игр.",
                                "zh": "孩子们在下午玩耍时会<w>齐声吟诵</w>他写的童谣。"
                            }
                        },
                        {
                            "text": "The choir began to <w>chime</w> the ancient lyrics in perfect unison.",
                            "target_lang_translations": {
                                "ru": "Хор начал <w>вторить</w> древним текстам в унисон.",
                                "zh": "合唱团开始完美地<w>齐声吟诵</w>古老的歌词。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chime childish verse"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "произносить или декламировать что-либо гармонично или ритмично",
                        "zh": "和谐或有节奏地吟诵某物"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вторить",
                                "target_lang_sense_clarification": "ритмично повторять"
                            },
                            {
                                "target_lang_word": "распевать",
                                "target_lang_sense_clarification": "декламировать нараспев"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "齐声吟诵",
                                "target_lang_sense_clarification": "指多人节奏一致地朗读"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "963c50bd-d0c4-311c-b8c0-b8113d2018d0",
                    "sense_definition": "to make a simple or repetitive correspondence of sounds, such as in rhyming",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the same tune it shall not always <w>chime</w> throughout the poem.",
                            "target_lang_translations": {
                                "ru": "В стихотворении не всегда должно <w>созвучать</w> одно и то же настроение.",
                                "zh": "整首诗不应总是以同样的调子<w>押韵</w>。"
                            }
                        },
                        {
                            "text": "The poet struggled to make the final lines <w>chime</w> without sounding forced.",
                            "target_lang_translations": {
                                "ru": "Поэт изо всех сил старался заставить последние строки <w>рифмоваться</w> естественно.",
                                "zh": "诗人费尽心思让最后几行<w>押韵</w>，同时又不显得生硬。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "создавать простое или повторяющееся соответствие звуков, например, в рифме",
                        "zh": "产生简单或重复的声音对应，如押韵"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созвучать",
                                "target_lang_sense_clarification": "гармонировать по звуку"
                            },
                            {
                                "target_lang_word": "рифмоваться",
                                "target_lang_sense_clarification": "о звуковом сходстве окончаний"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "押韵",
                                "target_lang_sense_clarification": "指词句末尾声音和谐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7f1463e-b0e7-3f15-9d19-36fb003c5572",
                    "sense_definition": "the clear, ringing sound made by a bell or similar instrument",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The copier gave a <w>chime</w> to indicate that it had finished printing.",
                            "target_lang_translations": {
                                "ru": "Копир издал <w>звуковой сигнал</w>, чтобы показать, что печать окончена.",
                                "zh": "复印机发出了一声<w>提示音</w>，表示打印已完成。"
                            }
                        },
                        {
                            "text": "The soft <w>chime</w> of the clock echoed through the quiet hallway.",
                            "target_lang_translations": {
                                "ru": "Тихий <w>звон</w> часов эхом разносился по пустому коридору.",
                                "zh": "时钟柔和的<w>钟声</w>在安静的走廊里回荡。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ding-dong",
                        "peal",
                        "toll"
                    ],
                    "common_phrases": [
                        "give a chime",
                        "soft chime"
                    ],
                    "target_lang_definitions": {
                        "ru": "чистый, звонкий звук, издаваемый колоколом или подобным инструментом",
                        "zh": "钟或类似乐器发出的清脆响声"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "протяжный звук металла"
                            },
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "звуковой сигнал устройства"
                            },
                            {
                                "target_lang_word": "перезвон",
                                "target_lang_sense_clarification": "череда звуков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钟声",
                                "target_lang_sense_clarification": "钟发出的声音"
                            },
                            {
                                "target_lang_word": "提示音",
                                "target_lang_sense_clarification": "设备发出的电子铃声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ed25ac6-aa28-3a3f-a69d-a05ece27e608",
                    "sense_definition": "a musical instrument or set of bells that produces sound when struck",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sylvia was a <w>chime</w> player in the school orchestra.",
                            "target_lang_translations": {
                                "ru": "Сильвия играла на <w>колокольчиках</w> в школьном оркестре.",
                                "zh": "西尔维娅是学校管弦乐队的<w>排钟</w>手。"
                            }
                        },
                        {
                            "text": "Hugo had a recording of someone playing the <w>chimes</w> against a background of surf noise.",
                            "target_lang_translations": {
                                "ru": "У Хьюго была запись игры на <w>колокольчиках</w> на фоне шума прибоя.",
                                "zh": "雨果有一段录音，背景是海浪声，伴随着<w>排钟</w>的演奏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bell",
                        "carillon",
                        "glockenspiel"
                    ],
                    "common_phrases": [
                        "chime player",
                        "set of chimes"
                    ],
                    "target_lang_definitions": {
                        "ru": "музыкальный инструмент или набор колокольчиков, издающих звук при ударе",
                        "zh": "一种打击乐器或一组受击发声的钟"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колокольчики",
                                "target_lang_sense_clarification": "ударный музыкальный инструмент"
                            },
                            {
                                "target_lang_word": "карильон",
                                "target_lang_sense_clarification": "набор колоколов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排钟",
                                "target_lang_sense_clarification": "打击乐器"
                            },
                            {
                                "target_lang_word": "钟琴",
                                "target_lang_sense_clarification": "小型打击乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e62823a4-56b7-3799-83b8-6991baaf0f09",
                    "sense_definition": "a small bell or ringing device that is part of a larger machine or object",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor had stuffed a wad of gum into the <w>chime</w> of his doorbell.",
                            "target_lang_translations": {
                                "ru": "Профессор залепил жвачкой <w>звонок</w> своей двери.",
                                "zh": "教授往他家<w>门铃</w>里塞了一团口香糖。"
                            }
                        },
                        {
                            "text": "The technician repaired the internal <w>chime</w> of the old telephone.",
                            "target_lang_translations": {
                                "ru": "Техник починил внутренний <w>звонок</w> старого телефона.",
                                "zh": "技术员修理了那部旧电话内部的<w>铃声装置</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buzzer",
                        "alarm"
                    ],
                    "common_phrases": [
                        "doorbell chime"
                    ],
                    "target_lang_definitions": {
                        "ru": "небольшой колокольчик или звуковое устройство, являющееся частью более сложного механизма",
                        "zh": "作为大型机器或物体一部分的小铃铛或发声装置"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонок",
                                "target_lang_sense_clarification": "устройство в двери или телефоне"
                            },
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "деталь механизма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "门铃",
                                "target_lang_sense_clarification": "门上的发声装置"
                            },
                            {
                                "target_lang_word": "铃声装置",
                                "target_lang_sense_clarification": "机器内部的发声部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc1277f6-cfcc-39b0-bbc3-27d21ddd37f4",
                    "sense_definition": "one single ringing component from a set of chimes",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peter removed the C sharp <w>chime</w> from its mounting to clean the dust.",
                            "target_lang_translations": {
                                "ru": "Питер снял <w>колокольчик</w> ноты до-диез с крепления, чтобы очистить его от пыли.",
                                "zh": "彼得把升C调的<w>钟管</w>从支架上拆下来清理灰尘。"
                            }
                        },
                        {
                            "text": "Each individual <w>chime</w> must be tuned perfectly to the correct pitch.",
                            "target_lang_translations": {
                                "ru": "Каждый отдельный <w>колокольчик</w> должен быть идеально настроен на нужную высоту звука.",
                                "zh": "每一个<w>钟管</w>都必须精准调音至正确的音高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "один отдельный звенящий элемент из набора колокольчиков",
                        "zh": "排钟中单个的发声组件"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колокольчик",
                                "target_lang_sense_clarification": "отдельный элемент инструмента"
                            },
                            {
                                "target_lang_word": "трубка",
                                "target_lang_sense_clarification": "в подвесных колокольчиках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钟管",
                                "target_lang_sense_clarification": "排钟的单个金属管"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b50c51a4-0049-33c3-a5c7-6fbc1fc09a28",
                    "sense_definition": "a small hammer or tool used to strike a bell",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Strike the bell with the brass <w>chime</w> hanging on the chain next to it.",
                            "target_lang_translations": {
                                "ru": "Ударьте в колокол латунным <w>молоточком</w>, висящим на цепочке рядом.",
                                "zh": "用挂在旁边链子上的黄铜<w>钟锤</w>敲击钟。"
                            }
                        },
                        {
                            "text": "The ancient clock used a mechanical <w>chime</w> to hit the large gong.",
                            "target_lang_translations": {
                                "ru": "В старинных часах использовался механический <w>молоточек</w> для удара по большому гонгу.",
                                "zh": "古老的时钟使用一个机械<w>钟锤</w>来敲击大锣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clapper",
                        "dinger"
                    ],
                    "common_phrases": [
                        "brass chime"
                    ],
                    "target_lang_definitions": {
                        "ru": "маленький молоточек или инструмент, используемый для удара по колоколу",
                        "zh": "用于敲击钟的小锤或工具"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоточек",
                                "target_lang_sense_clarification": "инструмент для удара"
                            },
                            {
                                "target_lang_word": "язычок",
                                "target_lang_sense_clarification": "внутри колокола"
                            }
                        ],
                        "zh": [
                            {
