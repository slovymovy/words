                        "examples": [
                            {
                                "example_id": "6a9e9179-b319-4546-a59c-2109b64d52bd",
                                "sense_id": "8e7f2f45-2852-3d0d-9aff-a11aa27685f6",
                                "text": "„Unterwegs in den Wäldern sammelte er für Veronika Blumen und Erdbeeren, oder er trug Kirschen und anderes Frühobst in einem Binsenkörbchen, das sie selbst mit kunstfertiger Hand geflochten hatte, von Aarau zur Hard.“"
                            },
                            {
                                "example_id": "19369398-bcd5-4730-b861-3f526c37c371",
                                "sense_id": "8e7f2f45-2852-3d0d-9aff-a11aa27685f6",
                                "text": "„‚Wem können wir ein glückliches Leben garantieren?‘ fragt er, ‚Moses wurde im Binsenkörbchen ausgesetzt und war später der große Führer des israelitischen Volkes.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
