                ],
                "senses": [
                    {
                        "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                        "entry_id": "89d9b870-92c2-3ee1-bd86-872c336043e8",
                        "glosses": [
                            "Frisur für Männer, bei der die Haare vorne kurz und hinten lang sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4367423-f67b-4399-869a-eeb9c88cdecf",
                                "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                                "text": "Er trug in den 80er Jahren häufig eine Vokuhila."
                            },
                            {
                                "example_id": "6ea89120-c9c6-4d29-9463-ea0d8df4c444",
                                "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                                "text": "„Die Vokuhila ist von den Ärzten besungen, als Nackenspoiler, Kicker- oder Manta-Matte bezeichnet und veräppelt worden.“"
                            },
                            {
                                "example_id": "65510a7d-f1ee-4f61-8f16-e430dd5d89cb",
                                "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                                "text": "„Paul Breitner wurde durch seinen Afro unvergesslich, Günter Netzer durch seine Matte und die Vokuhila zu Rudi Völlers Zeiten hat etwa in den Niederlanden den Ausdruck ‚duitse mat‘ (Deutsche Matte) geprägt.“"
                            },
                            {
                                "example_id": "72ddae9f-2112-4f11-92c3-ec3d4917b698",
                                "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                                "text": "„‚Remember the Mullet‘, lautet Perettis zweiter Merksatz. Mullet ist auf deutsch der ‚Vokuhila‘. (Für die, die sich nicht mehr an die achtziger Jahre erinnern: das war ein Haarschnitt, bei dem die Seiten und der Pony kurz, das Haar hinten aber lang ausfielen.)“"
                            },
                            {
                                "example_id": "22c604c5-842e-484e-bb74-2acc8db7a9e7",
                                "sense_id": "3c24c129-7fc7-381e-9008-cfc3dbe01f8c",
                                "text": "„Die Truppe wurde angeführt von einem kleinwüchsigen Zirkusdirektor, der mit seinem angegrauten Vokuhila und seinen dicken Goldketten einem Sexstreifen der 70er Jahre entsprungen zu sein schien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
