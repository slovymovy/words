                "forms": [
                    {
                        "form_id": "9a8711bb-3306-4d38-83ac-4a12e988ba23",
                        "entry_id": "5fa6f7ab-4fa0-30be-9f66-de797c47baa7",
                        "tags": [
                            "plural"
                        ],
                        "form": "panspermies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8713b079-0064-3e42-8e22-27161d61c9c0",
                        "entry_id": "5fa6f7ab-4fa0-30be-9f66-de797c47baa7",
                        "glosses": [
                            "Théorie qui affirmait la dissémination en tous lieux de germes et de spores, toujours prêts à se développer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8fb019b-d889-404a-bf92-0261d607622b",
                                "sense_id": "8713b079-0064-3e42-8e22-27161d61c9c0",
                                "text": "La doctrine des germes préexistans régnait à ce moment presque sans partage. Comment concilier les faits nouveaux avec cette théorie ? Bonnet consacra à la solution de ce problème de longues méditations qui aboutirent à une exagération nouvelle, à la panspermie, théorie bizarre qui admet l’existence constante et la diffusion universelle de germes partout présens et toujours prêts à se développer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bceaeeab-3355-398c-8a9c-deb7cbdf6403",
                        "entry_id": "5fa6f7ab-4fa0-30be-9f66-de797c47baa7",
                        "glosses": [
                            "Hypothèse spéculative selon laquelle la vie se propage dans l’univers via des météorites ou poussières cosmiques."
                        ],
                        "tags": [
                            "Astrobiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1fea7d23-f573-4498-92e6-4138b4935b22",
                                "sense_id": "bceaeeab-3355-398c-8a9c-deb7cbdf6403",
                                "text": "L’idée de la panspermie fit son apparition dès le début du Vᵉ siècle avant notre ère avec le philosophe grec Anaxagore (c. –510-c. –428), mais elle n’acquit vraiment le statut d’une hypothèse scientifique qu’avec les travaux du chimiste suédois Svante Arrhenius (1859-1927), au début du XXᵉ siècle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68256018-ca2d-4ed9-b166-e5bfab8e5e28",
                        "source_entry_id": "5fa6f7ab-4fa0-30be-9f66-de797c47baa7",
                        "target_lang_word": "panspermia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panspermia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34f5028e-5c65-34d3-bfa7-9cecd9975db0",
                                        "entry_id": "797e5458-acf2-309a-a406-d77bc381359c",
                                        "glosses": [
                                            "The hypothesis that microorganisms may transmit life from outer space to habitable bodies; or the process of such transmission."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91997018-a38c-49f4-a9b2-fda0292d3919",
                                                "sense_id": "34f5028e-5c65-34d3-bfa7-9cecd9975db0",
                                                "text": "Lederberg's ideas were tinged with Cold War paranoia. In his hands, panspermia came to resemble horizontal gene transfer on a cosmic scale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
