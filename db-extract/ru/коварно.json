                                                "sense_id": "b9a54b9e-7295-37e2-831d-be6e39956f67",
                                                "text": "Phoebe lay down by me, and ask'd me archly if, now that I had seen the enemy, and fully considered him, I was still afraid of him?",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
