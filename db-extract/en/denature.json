                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbc62e23-96f9-4ebd-99ea-a04558e8b463",
                                                "sense_id": "bc8a8570-48d8-37fc-bc8c-626343fcc52f",
                                                "text": "Mit seiner ständigen Nörgelei vergällte er ihr die Freude an der Theateraufführung."
                                            },
                                            {
                                                "example_id": "3449d8a0-32eb-41e8-a649-03f580913a0f",
                                                "sense_id": "bc8a8570-48d8-37fc-bc8c-626343fcc52f",
                                                "text": "„Auch sonst vergällen ihm die neuen Untertanen das Leben.“"
                                            }
