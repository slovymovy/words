                ],
                "senses": [
                    {
                        "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                        "entry_id": "8a5318c0-579b-395b-93d7-a3a6ed5e4bad",
                        "glosses": [
                            "fortwährender Beschuss durch von einem oder mehreren Luftfahrzeugen (Flugzeuge, Hubschrauber, Drohnen) aus abgeworfene Bomben und/oder durch schwere Artillerie auf einen ausgedehnten (zumeist, aber nicht ausschließlich urbanen) Bereich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ed151e-576b-4399-9d7f-d88769924dc9",
                                "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                                "text": "„Luftbilder zeigten Landschaften wie nach einem Flächenbombardement.“"
                            },
                            {
                                "example_id": "ef29dce6-c542-427a-bdfb-eef4d9c6bc2f",
                                "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                                "text": "„Das wahllose Flächenbombardement ausschließlich ziviler Ziele bewegte sich nahe an der Grenze zum Kriegsverbrechen.“"
                            },
                            {
                                "example_id": "feb6db71-8fc1-4ba4-bcb5-2d150f73a2c5",
                                "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                                "text": "„Halle blieb von verheerenden Flächenbombardements verschont - eine große Ausnahme.“"
                            },
                            {
                                "example_id": "56e95e05-5c3e-43e6-b26c-cf6accd2daa1",
                                "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                                "text": "„Gernika allerdings war die erste Stadt Europas, die Opfer eines Flächenbombardements wurde.“"
                            },
                            {
                                "example_id": "54722c98-4408-433a-9617-155de57e495c",
                                "sense_id": "5354c930-960b-31d1-9f43-d39b9870e53f",
                                "text": "„Auch das Flächenbombardement, bei dem Tausende umgekommen sein sollen, ist nicht belegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
