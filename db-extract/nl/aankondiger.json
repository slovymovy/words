                                        "entry_id": "11dbbfeb-737a-3471-a636-d829474e261e",
                                        "glosses": [
                                            "A messenger, especially one bringing important news."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c48caae5-43b2-4592-bc87-2875b08bae05",
                                                "sense_id": "c29cbb99-dc5c-3636-ad64-bc23cfe12e9e",
                                                "text": "The herald blew his trumpet and shouted that the King was dead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22d596cd-0b0c-3129-933c-53d48aebcc85",
                                        "entry_id": "11dbbfeb-737a-3471-a636-d829474e261e",
                                        "glosses": [
                                            "A harbinger, giving signs of things to come."
                                        ],
                                        "tags": [],
