                                        "sense_id": "a726b9d2-556e-3654-a944-e795ead06f32",
                                        "entry_id": "6ca0ffd2-4aad-3ada-a73c-db187b72b39b",
                                        "glosses": [
                                            "A terrorist bomb attack on an aeroplane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4a21e12-37b4-4f0e-9f7d-9bc2e7a8d4fc",
                                                "sense_id": "a726b9d2-556e-3654-a944-e795ead06f32",
                                                "text": "So is it not prudent to install metal detectors in airports to try to prevent Lockerbies and Oklahoma Cities?"
                                            },
                                            {
                                                "example_id": "d0bc00bd-0e20-4851-861c-4a317add3294",
                                                "sense_id": "a726b9d2-556e-3654-a944-e795ead06f32",
                                                "text": "Complete bag matching on originating flights would not prevent another Lockerbie and was implemented because it was feasible and minimized delays. Nail clippers on board an aircraft were not permitted for a time,..."
                                            },
                                            {
                                                "example_id": "56bf8273-f1cd-446a-9aac-b697eb0129f7",
                                                "sense_id": "a726b9d2-556e-3654-a944-e795ead06f32",
                                                "text": "The hidden book - written by Abdullah Azzam - was discovered after they swooped to arrest the monster days before his plan to stage seven Lockerbies."
                                            }
