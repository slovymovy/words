                        "cross_references": [
                            {
                                "target_word": "come to a head",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac734bdf-ae9e-384c-b864-108ce3cf2769",
                                        "entry_id": "7f27cf33-b943-3b22-88fb-d4f730bfb729",
                                        "glosses": [
                                            "To rapidly reach a turning point or climax."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26be4680-939c-418b-bdcc-b1cb98ad17ed",
                                                "sense_id": "ac734bdf-ae9e-384c-b864-108ce3cf2769",
                                                "text": "The escalating crisis between England and her American colonies came to a head when fighting broke out in 1775."
                                            },
                                            {
                                                "example_id": "38e7175c-3c53-44aa-afb9-2205d3837f65",
                                                "sense_id": "ac734bdf-ae9e-384c-b864-108ce3cf2769",
                                                "text": "In retrospect, it was small wonder that Railtrack found its finances under pressure, as with ever increasing demand there was an inevitable effect on infrastructure renewals. Matters came to a head with the Hatfield accident on October 17 2000, when there was a high-speed derailment as a result of deferred track maintenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de281309-88a9-3c21-abae-227e3c853a60",
                                        "entry_id": "7f27cf33-b943-3b22-88fb-d4f730bfb729",
                                        "glosses": [
                                            "To suddenly reveal itself, having lain latent for a time."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c9c6637-efe2-47d0-8658-32b31ec4510a",
                                                "sense_id": "de281309-88a9-3c21-abae-227e3c853a60",
                                                "text": "His festering anger came to a head after the incident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ecc0c6-e746-3d0e-8a23-4d6bcb42c073",
                                        "entry_id": "7f27cf33-b943-3b22-88fb-d4f730bfb729",
                                        "glosses": [
                                            "To suddenly become mature or perfected, having been inchoate or imperfectly formed."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
