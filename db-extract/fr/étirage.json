                "senses": [
                    {
                        "sense_id": "993c1c57-6f41-3cef-b4c1-cba463920587",
                        "entry_id": "762a5230-4a56-3f3f-87b9-70bb383a060e",
                        "glosses": [
                            "Action d’étirer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7becc6-2d7b-4351-84b0-be9be3b66cd1",
                                "sense_id": "993c1c57-6f41-3cef-b4c1-cba463920587",
                                "text": "Méthode de production des récipients en PET en deux étapes : les récipients sont fabriquées par étirage-soufflage à partir des préformes en PET préchauffées qui sont produites séparément par injection de la matière première. […] À peu près 80% des récipients en PET sont produits globalement par cette méthode (réchauffage-étirage-soufflage)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c37c37d9-28a7-3cef-a889-cadc45965f33",
                        "entry_id": "762a5230-4a56-3f3f-87b9-70bb383a060e",
                        "glosses": [
                            "Action de façonner des métaux en fils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66adcc21-8e74-4542-b1f6-9fc9c778b914",
                                "sense_id": "c37c37d9-28a7-3cef-a889-cadc45965f33",
                                "text": "Bannis de Lyon en 1420, les juifs s'établirent à Trévoux (Ain) et y formèrent de puissantes confréries, s'occupant principalement de l'étirage de l'or et de l'argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7b55c46-de08-358a-b77d-cad36d72abf2",
                        "entry_id": "762a5230-4a56-3f3f-87b9-70bb383a060e",
                        "glosses": [
                            "Opération qui a pour but de faire glisser les filaments les uns sur les autres afin de réduire la section des fils en les allongeant."
                        ],
                        "tags": [
                            "Industrie textile"
                        ],
                        "examples": [
                            {
                                "example_id": "6912aa2c-b78b-48d4-a8ac-7125fc8b48b5",
                                "sense_id": "f7b55c46-de08-358a-b77d-cad36d72abf2",
                                "text": "Un fil obtenu par un étirage difficile, c'est-à-dire avec excès de torsion, sera sec, cassant et sans élasticité. Obtenu par un étirage trop facile, le fil sera sans résistance, vrilleux et irrégulier."
                            }
                        ]
                    }
                ],
