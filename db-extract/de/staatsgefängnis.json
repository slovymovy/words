                        "examples": [
                            {
                                "example_id": "75b5810d-7712-4e76-af3d-38cb2f20458e",
                                "sense_id": "98a68798-e93b-3a0e-bf93-b4b4098d28c7",
                                "text": "„Der Mann, der dich angeschossen hat, ist im Gefängnis gestorben. Im Staatsgefängnis von Louisiana.“"
                            },
                            {
                                "example_id": "4857121f-60f1-43f6-8af5-3c4739cca485",
                                "sense_id": "98a68798-e93b-3a0e-bf93-b4b4098d28c7",
                                "text": "„Staatsgefängnis? Was zum Teufel hast du getan?“"
                            },
                            {
                                "example_id": "d7df3c8b-bf8c-4051-b951-5a8f09d14ea2",
                                "sense_id": "98a68798-e93b-3a0e-bf93-b4b4098d28c7",
                                "text": "„Nashs Verurteilungen reichten zurück bis auf das Jahr 1926, und sie umfassten Haftstrafen im Staatsgefängnis von Texas wegen Unzucht mit Minderjährigen, bewaffneten Raubes, Körperverletzung ersten Grades und Nötigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
