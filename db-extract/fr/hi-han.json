                        "source_entry_id": "75035516-77df-39d3-9e73-3e3f33f6a8ba",
                        "source_sense_id": "68a32aca-59fd-333f-b426-a24cf7dc2ccd",
                        "target_lang_word": "hee haw",
                        "target_lang_code": "en",
