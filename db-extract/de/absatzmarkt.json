                ],
                "senses": [
                    {
                        "sense_id": "52c813bb-e543-3067-bb20-de793b209472",
                        "entry_id": "1fbb7fb6-75b8-3f8f-9620-39ea9874c981",
                        "glosses": [
                            "Nachfrager und Anbieter umfassender Markt; Markt, auf dem Waren und Dienstleistungen verkauft (abgesetzt) werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e277344-f7b9-41be-bb97-f2611cdf80e8",
                                "sense_id": "52c813bb-e543-3067-bb20-de793b209472",
                                "text": "„Die Industriestaaten der Welt nutzen Afrika als kostengünstigen Rohstofflieferanten, lukrativen Absatzmarkt und nicht zuletzt als gigantische Müllhalde schwer zu entsorgender Wohlstandsprodukte.“"
                            },
                            {
                                "example_id": "08395576-7077-44be-89d1-e5118991c012",
                                "sense_id": "52c813bb-e543-3067-bb20-de793b209472",
                                "text": "„Länder wie China, Russland oder Indien haben große Teile Afrikas bereits als Absatzmarkt, Billiglohnland oder Lieferant für Rohstoffe entdeckt.“"
                            },
                            {
                                "example_id": "27a2dfdc-5db1-4d0f-a2dd-6552db650297",
                                "sense_id": "52c813bb-e543-3067-bb20-de793b209472",
                                "text": "„Damit vergrößerte sich der Absatzmarkt für Druckerzeugnisse in jiddischer Sprache beträchtlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
