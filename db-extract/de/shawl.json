                "senses": [
                    {
                        "sense_id": "f08f5906-7b33-3ccb-828e-5865139096f9",
                        "entry_id": "86b004fc-48b5-3822-b8e6-15a474e24e49",
                        "glosses": [
                            "langes, schmales Tuch, das man sich um den Hals legt, Halstuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a00c904b-7a16-464b-bf52-e27ed410c7a1",
                                "sense_id": "f08f5906-7b33-3ccb-828e-5865139096f9",
                                "text": "„Man hilft ihr ein- und aussteigen. Man breitet ihr Decken, Tücher und Shawls unter.“"
                            },
                            {
                                "example_id": "3dbbedb5-68b4-4d07-9c6c-83f799ab90c5",
                                "sense_id": "f08f5906-7b33-3ccb-828e-5865139096f9",
                                "text": "„Sie trug eine Sommerhose – aus indischer Seide? – purpurn und weit über weißen Stiefeln, einen schwarzen geschlossenen Sweater und einen Shawl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "be63106c-769f-335a-8d49-1b75637ca243",
                        "entry_id": "86b004fc-48b5-3822-b8e6-15a474e24e49",
                        "glosses": [
                            "breites Tuch, das man über den Schultern trägt, Schultertuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b956ce2a-b750-411f-ae96-14a3aa85f3a0",
                                "sense_id": "be63106c-769f-335a-8d49-1b75637ca243",
                                "text": "„Man hilft ihr ein- und aussteigen. Man breitet ihr Decken, Tücher und Shawls unter.“"
                            },
                            {
                                "example_id": "145fc391-4cae-48a3-a1d4-cef6d4cf3e67",
                                "sense_id": "be63106c-769f-335a-8d49-1b75637ca243",
                                "text": "„Sie trug eine Sommerhose – aus indischer Seide? – purpurn und weit über weißen Stiefeln, einen schwarzen geschlossenen Sweater und einen Shawl.“"
                            },
                            {
                                "example_id": "4772a604-e88d-4437-aefd-adb55b047cc3",
                                "sense_id": "be63106c-769f-335a-8d49-1b75637ca243",
                                "text": "„Prinzessin Marja warf sich einen Shawl um die Schultern, um dem Ankömmling entgegenzueilen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
