                        ],
                        "form": "Denemarkens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                        "entry_id": "c49f21ab-1660-32a6-9037-66f0e313356c",
                        "glosses": [
                            "een Scandinavisch land in Noord-Europa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e59fe041-0111-4dec-ae9e-9c7f137a102d",
                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                "text": "Hij heeft vier jaar in Denemarken gewoond en spreekt dus goed Deens."
                            },
                            {
                                "example_id": "e355f2f7-2079-4e29-9e69-12a3f23ed8f2",
                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                "text": "Kopenhagen is de hoofdstad van Denemarken."
                            },
                            {
                                "example_id": "bfc25130-8225-47c2-9339-cee4abed7629",
                                "sense_id": "50497247-688a-3556-9b51-90d17ca49087",
                                "text": "Denemarken ook nauwelijks, in de pers hadden ze het uitgebreid gehad over de gemoedelijke verhouding tussen de Deense bevolking en de Duitse gasten. De koning en de regering van Denemarken zaten nog op hun plaats en de samenwerking leek uitstekend te functioneren binnen de Germaanse verbroedering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58221ba9-2371-4bf8-b100-8eba1845548b",
                        "source_entry_id": "c49f21ab-1660-32a6-9037-66f0e313356c",
                        "source_sense_id": "50497247-688a-3556-9b51-90d17ca49087",
