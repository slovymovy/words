                {
                    "sense_id": "7a9d4a47-1dd2-3977-9201-56553eb8533c",
                    "sense_definition": "Verkorte vorm van <w>eens</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kom <w>is</w> hier, ik moet je iets laten zien.",
                            "target_lang_translations": {
                                "en": "<w>Just</w> come here, I need to show you something.",
                                "ru": "Иди<w>-ка</w> сюда, я должен тебе кое-что показать.",
                                "de": "Komm <w>mal</w> her, ich muss dir etwas zeigen."
                            }
                        },
                        {
                            "text": "Luister <w>is</w> goed naar wat ik te zeggen heb.",
                            "target_lang_translations": {
                                "en": "<w>Just</w> listen carefully to what I have to say.",
                                "ru": "Послушай<w>-ка</w> внимательно то, что я скажу.",
                                "de": "Hör <w>mal</w> gut zu, was ich zu sagen habe."
                            }
