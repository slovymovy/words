                                        "sense_id": "a6180078-af85-3546-a2c5-b0f6e90f48dc",
                                        "entry_id": "fee876e4-1f1f-3571-aaef-9f604dd66ca9",
                                        "glosses": [
                                            "A country bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
