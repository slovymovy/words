                        "sense_id": "6ece3e25-291e-3fa4-aa34-7de6eb132209",
                        "entry_id": "68914eec-a027-3b5f-8e96-77a656483068",
                        "glosses": [
                            "Information présentée comme contrebalançant celle provenant d’autres médias, accusée d’être incomplète, imprécise, erronée ou mensongère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9fa378b-6300-40e1-aebb-0c1defdce50e",
                                "sense_id": "6ece3e25-291e-3fa4-aa34-7de6eb132209",
                                "text": "« Breizh-info », malgré qu’il soit animé par plusieurs militants de droite et d’extrême droite, comme bon nombre de sites de ré-information, se présente comme un média indépendant, « traitant de l’actualité bretonne et internationale sans concession » selon ses dires."
                            },
                            {
                                "example_id": "4c122647-77e0-412a-ab9e-84ce9cf27769",
                                "sense_id": "6ece3e25-291e-3fa4-aa34-7de6eb132209",
                                "text": "De nombreuses attaques ont eu lieu ces derniers mois contre les sites de ré-information, accusés de véhiculer des thèses « complotistes » ou tout simplement de fausses informations."
                            }
                        ]
                    }
