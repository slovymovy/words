                    {
                        "translation_id": "26f339a0-e066-472b-bfd1-47f32d24df76",
                        "source_entry_id": "4fc67ecb-7e32-3eea-95b7-05874f128019",
                        "source_sense_description": "to feel or express compassion or sympathy",
                        "target_lang_word": "соболе́зновать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
