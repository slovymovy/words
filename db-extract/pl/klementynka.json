                    },
                    {
                        "translation_id": "f77b570f-fcc1-46e9-befc-300441f5fd82",
                        "source_entry_id": "33e8d385-ade6-3df9-984b-3723d7a78e64",
                        "source_sense_id": "9156b4e2-296f-31b4-adb5-d4f578f8015f",
                        "target_lang_word": "clémentine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clémentine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9388d496-6226-3500-a7e3-78ad648332f6",
                                        "entry_id": "47d33738-87b3-3a32-a974-eb18b80b5f5c",
                                        "glosses": [
                                            "Fruit comestible du clémentinier, semblable à une petite orange sans pépins et qui appartient à la famille des agrumes. Sont aussi parfois vendus sous cette appellation des tangors de petite taille, divers hybrides de mandariniers comme les clémenvillas ainsi que des satsumas (Citrus unshiu) et des hybrides de satsuma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6683e52a-5a3c-4fc7-9754-174266afb7e5",
                                                "sense_id": "9388d496-6226-3500-a7e3-78ad648332f6",
                                                "text": "La clémentine tend à remplacer la mandarine sur les marchés, et les variétés sont de plus en plus nombreuses."
                                            },
                                            {
                                                "example_id": "42d4b966-9ba9-4731-87b6-d93b79169843",
                                                "sense_id": "9388d496-6226-3500-a7e3-78ad648332f6",
                                                "text": "Bébé dépiautait une clémentine."
                                            },
                                            {
                                                "example_id": "b2cd50fb-2991-46f2-bb1c-94d885d5e9e4",
                                                "sense_id": "9388d496-6226-3500-a7e3-78ad648332f6",
                                                "text": "Pendant ce temps, épluchez et hachez les clémentines."
                                            }
                                        ]
                                    }
                                ]
                            },
