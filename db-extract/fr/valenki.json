                                            {
                                                "example_id": "f0d1bca4-cb1d-4288-829d-f47c9bd2dfe4",
                                                "sense_id": "eec86855-1990-3004-bd24-a7217143fae8",
                                                "text": "— Эй ты, валенок!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
