                                                "sense_id": "7d836619-89ed-3007-a0b9-459a18cdc5c7",
                                                "text": "Een dodelijk verkeersongeval, dodelijke gassen."
                                            },
                                            {
                                                "example_id": "11951119-1e62-492b-b87a-600a8e62a994",
                                                "sense_id": "7d836619-89ed-3007-a0b9-459a18cdc5c7",
                                                "text": "De afgelopen tien jaar hebben zwarte beren in heel Amerika slechts tien dodelijke ongevallen veroorzaakt, waarvan acht in Alaska."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082b86c4-b0e7-3f41-87b0-c8701b1fb5e9",
                                        "entry_id": "76fc600d-a671-3c64-b023-f6ec329be218",
