                    },
                    {
                        "translation_id": "aad7ddf7-050c-4811-a093-b0d4e6584f14",
                        "source_entry_id": "4ca18a14-aec0-3f97-9988-5c914c7505cb",
                        "source_sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                        "target_lang_word": "Charpie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Charpie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                        "entry_id": "62e03c12-cbc5-3bd9-b1be-5fccc3a36ced",
                                        "glosses": [
                                            "bis ins 20. Jahrhundert benutztes Wundverbandsmaterial aus zerzupftem Leinen oder Baumwollstoff"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89774993-b4ac-4039-b54f-8422d8c23ec3",
                                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                                "text": "„[…] diese wurde möglichst sorgfältig entfernt und die Wunde darauf mit Charpie ausgefüllt und verschlossen.“"
                                            },
                                            {
                                                "example_id": "c0b25c75-395a-429c-bbe5-93148bf96390",
                                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                                "text": "„Beide waren bedeutende Patriotinnen, zupften während der Kriege Charpie und spielten für vaterländische Kassen.“"
                                            },
                                            {
                                                "example_id": "27b978ff-b15e-43da-97ac-4595217701c7",
                                                "sense_id": "048be0f8-e6ce-393c-bcb7-479a345b1420",
                                                "text": "„Diejenigen aber, die den allgemeinen Gang der Dinge zu verstehen suchten und mit Heroismus und opferwilliger Selbsthingabe an ihm teilnehmen wollten, waren die nutzlosesten Mitglieder der Gesellschaft; sie sahen alles verkehrt und alles, was sie für nützlich hielten und daher taten, erwies sich als nutzloser Unfug, wie etwa die Regimenter Pierres und Mamonows, die plündernd durch die russischen Dörfer zogen, und die Charpie, die von den Damen gezupft wurde und nie bis zu den Verwundeten kam, und dergleichen mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e42748cd-8a83-4c85-bae2-51fc37de40ad",
                        "source_entry_id": "4ca18a14-aec0-3f97-9988-5c914c7505cb",
                        "source_sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                        "target_lang_word": "sharpja",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "048f8ade-79dd-4ef5-9280-481ed84595e2",
                        "source_entry_id": "4ca18a14-aec0-3f97-9988-5c914c7505cb",
                        "source_sense_id": "64942e18-e59f-35b0-aa06-f2abcb1ca1a0",
                        "target_lang_word": "charpie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charpie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                        "entry_id": "de391aeb-2222-38f6-a599-20ddf168f806",
                                        "glosses": [
                                            "Amas de petits fils tirés d’une toile usée que l’on a coupée par morceaux, et qui sert à panser les plaies, les ulcères."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "113ffa5a-0cd6-49dd-89d2-f8e056543457",
                                                "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                                "text": "Plaie douloureuse et non mortelle, […], murmura la belle et savante chirurgienne ; passe-moi du baume et prépare de la charpie, Gillonne."
                                            },
                                            {
                                                "example_id": "27c96750-23ec-49cc-ac32-7ffe96b57e65",
                                                "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                                "text": "[…] déjà dans la journée du vendredi l’ambulance du grand quartier général s’y était établie, des caissons de charpie y avaient été déballés, de même que des appareils et des médicaments […]"
                                            },
                                            {
                                                "example_id": "243a8dc1-ebd8-4f33-83d0-68cc69c385bb",
                                                "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                                "text": "Le docteur fit, avec un mouchoir, un peu de charpie qu’il étendit sur les plaies après les avoir lavées."
                                            },
                                            {
                                                "example_id": "7a1c6c0c-2c1f-4c0d-9bb0-8619a732676b",
                                                "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                                "text": "Et voilà que c’est sur les talons des soldats qu’elle marche à présent, cette foule ! Elle emboîte le pas aux régiments, elle acclame des colonels dont les épaulettes sont encore grasses du sang de Décembre — et elle crie « À mort ! » contre nous qui voulons boucher avec de la charpie le pavillon des clairons !\nOh ! c’est la plus grande désillusion de ma vie."
                                            },
                                            {
                                                "example_id": "d51a2d37-40ea-4972-b4ee-d9fb54761f3a",
                                                "sense_id": "60bc656a-4601-302c-85c5-c33ab4f13b45",
                                                "text": "Maman pleurait à chaudes larmes en pansant mon sauveteur avec du beurre frais et cette bonne charpie dont elle avait toujours une petite provision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03e841c-f4b6-3130-bbf9-24e04c1f620d",
                                        "entry_id": "de391aeb-2222-38f6-a599-20ddf168f806",
                                        "glosses": [
                                            "Matériel réduit en morceaux."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29dc7fea-cc9c-4240-84b6-d9aa9beaff2a",
                                                "sense_id": "b03e841c-f4b6-3130-bbf9-24e04c1f620d",
                                                "text": "Nous nous étendîmes tous deux sur un lit improvisé… que je quittai pour lui laisser plus de place, à lui, le pauvre ! qui avait le cou en charpie, la peau en lambeaux, et qui se recroquevillait dans l’unique drap qu’on nous avait abandonné, les camarades ayant pris l’autre."
                                            },
                                            {
                                                "example_id": "af04dd35-4920-4794-9c51-9152c117998a",
                                                "sense_id": "b03e841c-f4b6-3130-bbf9-24e04c1f620d",
                                                "text": "Le bulldozer avançait mètre après mètre, laissant derrière lui une charpie de gravats."
                                            }
                                        ]
                                    }
                                ]
                            },
