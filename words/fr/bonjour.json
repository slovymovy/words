{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "a97d2140-a369-3955-8ca8-22fbce6312ed",
                    "sense_definition": "Formule de salutation employée pendant la journée lorsqu'on aborde ou rencontre quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bonjour</w>, comment allez-vous ce matin ?"
                        },
                        {
                            "text": "<w>Bonjour</w> tout le monde, j'espère que vous avez passé un bon week-end."
                        }
                    ],
                    "synonyms": [
                        "salut",
                        "coucou"
                    ],
                    "antonyms": [
                        "au revoir"
                    ],
                    "common_phrases": [
                        "bonjour tout le monde",
                        "bonjour madame"
                    ]
                },
                {
                    "sense_id": "706270c8-6e4c-3ac2-863b-eefe995c9db3",
                    "sense_definition": "Exclamation familière et souvent ironique pour souligner un désagrément, une difficulté ou une situation catastrophique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "S'il commence à pleuvoir sur cette route glissante, alors <w>bonjour</w> les dégâts !"
                        },
                        {
                            "text": "Elle a oublié ses clés au bureau, alors <w>bonjour</w> la galère pour rentrer."
                        }
                    ],
                    "common_phrases": [
                        "bonjour les dégâts"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "40d3d2e3-f5b4-3645-834c-cd8f904c51eb",
                    "sense_definition": "Formule employée pour prendre congé de quelqu'un au cours de la journée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bien le <w>bonjour</w> chez vous, et portez-vous bien jusqu'à notre prochaine rencontre."
                        },
                        {
                            "text": "Il salua l'assistance d'un geste poli et lança : « <w>Bonjour</w>, messieurs ! » avant de partir."
                        }
                    ],
                    "common_phrases": [
                        "bien le bonjour"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7e87b1e0-358c-370f-a0bf-627ce43e28e8",
                    "sense_definition": "Salutation, souhait de bonne journée adressé ou transmis à une personne.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "salutation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de passer le <w>bonjour</w> à tes parents quand tu les verras."
                        },
                        {
                            "text": "Il m'a adressé un petit <w>bonjour</w> chaleureux de la main en passant devant la fenêtre."
                        }
                    ],
                    "common_phrases": [
                        "passer le bonjour"
                    ]
                }
            ]
        }
    ]
}