                                "target_senses": [
                                    {
                                        "sense_id": "69e7a8e7-62b3-3d4a-bb98-7e90cb16c461",
                                        "entry_id": "4426a508-5378-3c00-8128-9eb288833427",
                                        "glosses": [
                                            "Especially of a series of ideas, letters, words, etc.: intended to help in remembering."
                                        ],
