                    {
                        "translation_id": "162c2ce9-6932-45a5-9719-0110bd4cddcb",
                        "source_entry_id": "93ee45da-66ef-3eb7-a82a-60babd761c4e",
                        "source_sense_description": "action of a locomotive or train leaving the rails along which it runs",
                        "target_lang_word": "Entgleisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
