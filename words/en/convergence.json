                    "frequency": "Low",
                    "semantic_group_id": "physiology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor tested the patient's <w>convergence</w> by moving a finger toward their nose.",
                            "target_lang_translations": {
                                "ru": "Врач проверил <w>конвергенцию</w> пациента, поднося палец к его носу."
