                ],
                "senses": [
                    {
                        "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                        "entry_id": "cc6e8722-00bd-3c3f-9af5-2b4c1ca0d071",
                        "glosses": [
                            "Genre de plantes poacées (graminées), où l’on distingue la flouve odorante (Anthoxanthum odoratum)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66ec194-d977-4ff0-bc1d-4da0cedf129b",
                                "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                                "text": "Je crois que tu es forte en botanique ; je te montre une flouve, tu ne sais pas ce que c’est ; une avoine, un trèfle, tu ne sais pas ce que c’est ; tu ne connais même pas les herbes de ton pays."
                            },
                            {
                                "example_id": "dfd50062-533e-47bf-b92e-0d43894b958e",
                                "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                                "text": "Il avait couru dans les prés, parmi les flouves et les phléoles tremblantes."
                            },
                            {
                                "example_id": "2bcebd9a-ed8d-4e2a-ac7c-49d20cb191b3",
                                "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                                "text": "Tout à ces pensées réjouissantes, il traversait d'un pas égal la grande lande d'où montait la tendre haleine de la bruyère en fleurs et de la flouve odorante et, comme à cet endroit découvert, la brise est parfois un peu forte, il marchait vers le « White-Wall », pour s'y abriter un peu."
                            },
                            {
                                "example_id": "7c18195e-7522-48fc-aa53-aa4a9a235595",
                                "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                                "text": "Les vallons, perdus ou pas perdus, sentaient la flouve, le foin et le caille-lait."
                            },
                            {
                                "example_id": "065bfa9b-8895-42a4-9156-078714189017",
                                "sense_id": "510b43f7-d1ef-3cc6-b988-03235962e132",
                                "text": "Une flouve est une plante monocotylédone qui donne au foin son odeur particulière et agréable."
                            }
                        ]
                    }
                ],
