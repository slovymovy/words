                ],
                "senses": [
                    {
                        "sense_id": "b920ecc3-3b04-3c43-a9cf-7abd7321596c",
                        "entry_id": "8c24bae2-c963-393a-894d-1dd37f003534",
                        "glosses": [
                            "Gebiet, in dem nur die gewerblich-industrielle Nutzung zugelassen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cf75fd-2ca7-47a5-9123-90a72061ae25",
                                "sense_id": "b920ecc3-3b04-3c43-a9cf-7abd7321596c",
                                "text": "„Für ihre etwa anderthalb Kilometer lange Wanderung über das flache Land bis hin zum Gewerbegebiet brauchten sie genau zweitausenddreihundertunddreiundfünfzig Schritte.“"
                            },
                            {
                                "example_id": "ec9656bd-9188-4fa6-ab8a-f7ca1b9f8618",
                                "sense_id": "b920ecc3-3b04-3c43-a9cf-7abd7321596c",
                                "text": "„Nun sitzt Aggarwal in seinem Eckbüro im Langenthaler Gewerbegebiet, an dem die Züge zwischen Bern und Zürich vorbeirauschen, und erzählt, wie er zu einem der grössten Importeure indischer Lebensmittel in der Schweiz wurde.“"
                            },
                            {
                                "example_id": "0cc4efb1-07d2-46fd-9268-58c1d8cccca1",
                                "sense_id": "b920ecc3-3b04-3c43-a9cf-7abd7321596c",
                                "text": "„Nach dem Essen wurden wir in das Gewerbegebiet kutschiert, wo Chanels Ateliers untergebracht waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
