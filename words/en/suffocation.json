                        "die of suffocation",
                        "signs of suffocation",
                        "risk of suffocation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние сильного кислородного голодания, приводящее к потере сознания или смерти; асфиксия."
                    },
                    "translations": {
