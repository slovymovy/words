                                "ru": "Хотите кофе? — Нет, <w>спасибо</w>.",
                                "zh": "要喝点咖啡吗？——不用了，<w>谢谢</w>。",
                                "nl": "Wil je koffie? — Nee, <w>bedankt</w>.",
                                "pl": "Czy chcesz kawy? — Nie, <w>dziękuję</w>.",
                                "de": "Möchtest du einen Kaffee? — Nein, <w>danke</w>.",
                                "fr": "Voulez-vous du café ? — Non, <w>merci</w>.",
                                "it": "Vuoi un po' di caffè? — No, <w>grazie</w>.",
                                "cs": "Dáš si kávu? — Ne, <w>díky</w>.",
                                "tr": "Kahve ister misin? — Hayır, <w>teşekkür ederim</w>.",
                                "es": "¿Quieres un poco de café? — No, <w>gracias</w>."
