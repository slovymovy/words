                        "cross_references": [
                            {
                                "target_word": "педа́ль",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45319114-0e9d-36ba-9227-7828cf91fd83",
                                        "entry_id": "b7768830-e913-3ce3-9ea8-288a1795fb66",
                                        "glosses": [
                                            "управляющий или приводной о́рган какого-либо устройства, подножка или рычаг, нажимаемый ступнёй"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77eae30b-da50-4707-bc60-0a9341f669b2",
                                                "sense_id": "45319114-0e9d-36ba-9227-7828cf91fd83",
                                                "text": "Шофёр передвинул эту рукоятку, нажал ногой педаль, и машина тронулась."
                                            },
                                            {
                                                "example_id": "7de2134a-fc9f-43cd-a1c2-2aa8ba87c1db",
                                                "sense_id": "45319114-0e9d-36ba-9227-7828cf91fd83",
                                                "text": "За ширмой ― дверь, ведущая на лестницу, а подальше у той же стены ― блестящая белая печка и старинный умывальник, с баком, с клювастым краном: нажмешь ногой на медную педаль, и из крана прыщет тонкий фонтанчик."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5581524f-4478-3fc3-91cd-02dc0f38df45",
                                        "entry_id": "b7768830-e913-3ce3-9ea8-288a1795fb66",
                                        "glosses": [
                                            "муз. то же, что педальная клавиатура"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0d60af-d538-4487-a657-055304d06518",
                                                "sense_id": "5581524f-4478-3fc3-91cd-02dc0f38df45",
                                                "text": "Во всяком случае, этот сильный бас на мануале, при отсутствии такового на педали, весьма противоестественен и как бы рассчитан на недавнюю педальную технику французских органистов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
