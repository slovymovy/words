                "senses": [
                    {
                        "sense_id": "c5719cfb-4c7b-313f-b32b-0534b4015e6a",
                        "entry_id": "79157196-b727-3dd6-9430-8c512bb6572d",
                        "glosses": [
                            "deutscher Intellektueller in der Mitte des 19. Jahrhunderts, der einer bestimmten Auslegung der Philosophie von Georg Wilhelm Friedrich Hegel ^(→ WP) folgte"
                        ],
                        "tags": [
                            "Philosophiegeschichte",
                            "meist kollektiver Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0d91a7ef-8b49-481f-ae37-a91a78ee3b9b",
                                "sense_id": "c5719cfb-4c7b-313f-b32b-0534b4015e6a",
                                "text": "„Die Junghegelianer waren eine locker organisierte Gruppierung. Zu ihr gezählt werden u. a. Strauß, Feuerbach, Bruno Bauer, Edgar Bauer, Echtermeyer, Ruge, Hess und Köppen. Aber auch Rutenberg, Ludwig Buhl, Meyen, Nauwerck, Gustav Julius, Prutz und Stirner sowie Marx und Engels standen dieser eine Zeitlang nahe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
