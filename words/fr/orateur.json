            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90a6701f-fa83-3257-a30c-294acee097f0",
                    "sense_definition": "Personne qui prononce un discours en public ou qui maîtrise l'art de l'éloquence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eloquence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce ministre est un brillant <w>orateur</w> capable de captiver une foule entière pendant des heures."
                        },
                        {
                            "text": "Chaque <w>orateur</w> disposait de dix minutes pour exposer ses arguments devant le public."
                        }
                    ],
                    "synonyms": [
                        "tribun",
                        "rhéteur",
                        "conférencier"
                    ],
                    "common_phrases": [
                        "brillant orateur",
                        "talent d'orateur"
                    ]
                },
                {
                    "sense_id": "2b4fa77b-bec6-335f-b857-864daf2ab05a",
                    "sense_definition": "Président d'une assemblée délibérante, particulièrement de la Chambre des communes au Canada.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>orateur</w> de la Chambre a rappelé les députés à l'ordre après de vives protestations."
                        },
                        {
                            "text": "Après le scrutin, le nouvel <w>orateur</w> a remercié l'assemblée pour sa confiance."
                        }
                    ],
                    "synonyms": [
                        "président"
                    ],
                    "common_phrases": [
                        "élection de l'orateur"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Canada"
                        }
                    ]
                },
                {
                    "sense_id": "a54f00f1-c151-3472-ae41-7334c69b2461",
                    "sense_definition": "Auteur ou prédicateur de sermons et d'oraisons funèbres religieuses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bossuet était un <w>orateur</w> sacré réputé pour la solennité de ses oraisons funèbres."
                        },
                        {
                            "text": "Le prêtre s'est révélé être un <w>orateur</w> inspiré lors de la cérémonie commémorative."
                        }
                    ],
                    "synonyms": [
