                    },
                    {
                        "translation_id": "3d4b8e11-def5-45f1-b163-23b119291284",
                        "source_entry_id": "07085e84-a467-3e87-a299-c84ca3d79c0a",
                        "source_sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                        "source_sense_description": "spiritisme",
                        "target_lang_word": "spiritualism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiritualism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b2bf5e3-21d7-3a2a-9422-ddf50dbc9b13",
                                        "entry_id": "42d44a8c-64c9-3180-8812-276d808630e2",
                                        "glosses": [
                                            "A doctrine, opposing materialism, that claims transcendency of the divine being, the altogether spiritual character of reality and the value of inwardness of consciousness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6016185a-5e53-4f30-b5f0-b598a058ac5d",
                                                "sense_id": "6b2bf5e3-21d7-3a2a-9422-ddf50dbc9b13",
                                                "text": "What is called spiritualism should, I think, be called a mental species of materialism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f54ce5-fc5b-389f-8489-bedac4cacc98",
                                        "entry_id": "42d44a8c-64c9-3180-8812-276d808630e2",
                                        "glosses": [
                                            "A belief that the dead communicate with the living, especially through a medium. Used in a broader sense than spiritism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07779a7-a9fa-4cef-9fdb-8fbd0ba41b29",
                                                "sense_id": "87f54ce5-fc5b-389f-8489-bedac4cacc98",
                                                "text": "I wish it were possible to impress this truth upon people who rush into spiritualism from curiosity, or who try \"table rapping\" or some similar phenomenon \"for fun\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0ea163d-0271-330b-9419-0957c434bd10",
                                        "entry_id": "42d44a8c-64c9-3180-8812-276d808630e2",
                                        "glosses": [
                                            "The quality or state of being spiritual."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
