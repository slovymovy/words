                    {
                        "sense_id": "2bd6c37c-9d51-3746-aa92-ee856a5b268f",
                        "entry_id": "dd100f6a-3b6d-3f87-9b39-2bbe467cbf65",
                        "glosses": [
                            "Without interruption."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9354cff2-65b2-46b4-ad66-93900338badb",
                                "sense_id": "2bd6c37c-9d51-3746-aa92-ee856a5b268f",
                                "text": "They adopted the singular, though in their case probably advantageous, decision to continue each to have a separate place of abode, in order that each might work uninterruptedly, […]"
                            },
                            {
                                "example_id": "f267a351-fafc-46c8-b117-c718e674f0a8",
                                "sense_id": "2bd6c37c-9d51-3746-aa92-ee856a5b268f",
                                "text": "Speed downhill was not allowed to exceed 77½ m.p.h., then, after a 63 m.p.h. slowing through Creil, the more gradual rise to Gannes was climbed at between 75 and 79 m.p.h. uninterruptedly."
                            },
                            {
                                "example_id": "667eb6ab-982d-48eb-b527-70181faaf1dd",
                                "sense_id": "2bd6c37c-9d51-3746-aa92-ee856a5b268f",
                                "text": "Save for the three brief ¼-mile descents, before Bakewell, Monsal Dale and Miller's Dale, the line is climbing uninterruptedly at round about 1 in 100 for 9 miles from Rowsley almost to Miller's Dale, [...]."
                            }
                        ]
                    }
                ],
                "translations": [
