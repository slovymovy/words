                                                "text": "farming implements"
                                            },
                                            {
                                                "example_id": "aa7ca7d9-951a-4169-9e0e-5a9ec30aafb3",
                                                "sense_id": "455339c2-74f2-3d39-9168-b477b30a0e97",
                                                "text": "agricultural implements"
                                            },
                                            {
                                                "example_id": "a3342dad-75da-4dae-9e5a-a918e925a3bd",
                                                "sense_id": "455339c2-74f2-3d39-9168-b477b30a0e97",
                                                "text": "They carried an assortment of gardening implements in the truck."
                                            },
                                            {
                                                "example_id": "e00e6c44-aaed-44a7-8c05-cf8427a12a43",
                                                "sense_id": "455339c2-74f2-3d39-9168-b477b30a0e97",
                                                "text": "A man dreamt as follows: He saw two boys struggling—barrel-maker’s boys, to judge by the implements lying around."
                                            }
