                "senses": [
                    {
                        "sense_id": "882d9738-fcdf-3868-bc85-78a8ad0acb6f",
                        "entry_id": "2c22446a-8d60-3335-8f30-d948841a24db",
                        "glosses": [
                            "Grafschaft im Norden Englands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b6d7780-43d4-43aa-bf3b-37064e85bc9d",
                                "sense_id": "882d9738-fcdf-3868-bc85-78a8ad0acb6f",
                                "text": "„Lovecrafts Großvater väterlicherseits, George Lovecraft, war mit Helen Allgood verheiratet, und durch sie meinte Lovecraft, mit den Musgraves von Eden Hall in Cumberland verwandt zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0f0e95a3-5829-3d46-85e3-5c94fbb0d3d6",
                        "entry_id": "2c22446a-8d60-3335-8f30-d948841a24db",
                        "glosses": [
                            "Ort im US-Bundesstaat Maryland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11a6932-711d-4918-8e8c-bf11e5ec143f",
                                "sense_id": "0f0e95a3-5829-3d46-85e3-5c94fbb0d3d6",
                                "text": "„Keiner sagte etwas, dann wurde plötzlich allerlei Widerspruch laut. Der war gar kein Sattler, der war Schuhmacher, rief einer, und dem ha'm sie nie'ne Schuld nachweisen können. Und ein anderer: Der hat doch nie in der Wildnis gelebt, der hat'n Laden gehabt, mitten im Zentrum von Cumberland, Maryland.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
