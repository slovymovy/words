                ],
                "senses": [
                    {
                        "sense_id": "ffeae061-84d1-35b6-aa54-d5686f1858d5",
                        "entry_id": "f0f55238-50ea-3140-856d-004d8d272035",
                        "glosses": [
                            "Stéthoscoper, ausculter avec un stéthoscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c45de55-da40-4248-a051-0dc134995c96",
                                "sense_id": "ffeae061-84d1-35b6-aa54-d5686f1858d5",
                                "text": "I was examined, stethoscoped, asked questions, gazed at.",
                                "translation": "J'ai été examiné, stéthoscopé, interrogé, observé."
                            },
                            {
                                "example_id": "bbbd7fed-0451-4dff-80d0-745f4ab9f8ef",
                                "sense_id": "ffeae061-84d1-35b6-aa54-d5686f1858d5",
                                "text": "“Mr. Clute,” he said, when he had thumped him and stethoscoped him and tried all his tests, “you are a remarkable man. You have a body like a steel engine and a constitution like a horse. How many years did I give you?”",
                                "translation": "« Mr. Clute », dit-il après qu'il l'ai frappé puis stéthoscopé. Vous avez un corps comme un moteur en acier et la constitution d'un cheval. Combien d'années vous ai-je donné ?"
                            }
                        ]
                    }
                ],
                "translations": [],
