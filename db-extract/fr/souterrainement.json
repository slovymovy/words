                "forms": [],
                "senses": [
                    {
                        "sense_id": "334d3ae2-d6b8-3e2d-b768-038d9a416fcf",
                        "entry_id": "141c2ecc-9330-3c81-83ee-324d3a893257",
                        "glosses": [
                            "D’une manière souterraine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76763c83-72ec-4d7e-b33e-31cdd91fa375",
                                "sense_id": "334d3ae2-d6b8-3e2d-b768-038d9a416fcf",
                                "text": "Du niveau du Saint-Laurent [dans une mine], nous sommes passés souterrainement au fond du puits Saint-Pierre,"
                            },
                            {
                                "example_id": "6a9a8e4a-458e-4df8-84db-f5f1e0d8b34f",
                                "sense_id": "334d3ae2-d6b8-3e2d-b768-038d9a416fcf",
                                "text": "[…] Philoctète : magnifique et puant, cet infirme a donné jusqu’à son arc sans condition : mais souterrainement, on peut être sûr qu’il attend sa récompense."
                            },
                            {
                                "example_id": "5368168c-ba92-43b4-8341-07dc833e096b",
                                "sense_id": "334d3ae2-d6b8-3e2d-b768-038d9a416fcf",
                                "text": "La source émane d’un gros bloc décroché de la falaise, qui jouxte une grotte ayant servi de refuge à un chef gaulois opposé à Rome. À l’intérieur de ce monolithe, dans la nuit des origines, des centaines de veines travaillent souterrainement à ramener les eaux infiltrées sur la nappe originelle."
                            }
                        ]
                    }
