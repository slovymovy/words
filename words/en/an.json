                                "ru": "<w>Если</w> это никому не вредит, делай что хочешь.",
                                "nl": "<w>Als</w> het niemand schaadt, doe wat je wilt.",
                                "pl": "<w>Jeśli</w> nikomu to nie szkodzi, rób co chcesz.",
                                "de": "<w>Wenn</w> es niemandem schadet, tu, was du willst.",
                                "fr": "<w>Si</w> cela ne fait de mal à personne, faites ce que vous voulez.",
                                "it": "<w>Se</w> non nuoce a nessuno, fai ciò che vuoi.",
                                "cs": "<w>Pokud</w> to nikomu neublíží, dělej, co chceš.",
                                "tr": "<w>Eğer</w> kimseye zarar vermiyorsa, istediğini yap.",
                                "es": "<w>Si</w> no daña a nadie, haz lo que quieras.",
                                "zh": "<w>若</w>不伤害任何人，随你去做吧。"
                            }
