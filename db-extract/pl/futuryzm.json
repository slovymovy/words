                                        "sense_id": "c17210d9-5396-30c1-a79e-715f8db32046",
                                        "entry_id": "7b88692e-51a3-3c43-86eb-9554c5bb4cc3",
                                        "glosses": [
                                            "Movimiento artístico y literario vanguardista, creado a comienzos del siglo XX, que buscaba incorporar los avances de la ciencia y la técnica en una nueva concepción estética opuesta a convenciones tradicionales."
                                        ],
                                        "tags": [],
