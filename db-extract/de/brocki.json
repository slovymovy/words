                "senses": [
                    {
                        "sense_id": "224d3b2d-add4-3980-962c-730cf9e72a40",
                        "entry_id": "f38d42de-ff46-39dd-8732-760ffd1a4a94",
                        "glosses": [
                            "clipping of Brockenhaus"
                        ],
                        "tags": [
                            "Switzerland",
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "colloquial",
                            "feminine",
                            "neuter",
