                        "entry_id": "03d841db-00ff-34b1-a586-fade1731b716",
                        "glosses": [
                            "Science qui a pour objet l’étude des matériaux qui composent le globe terrestre et de l’ordre suivant lequel ces matériaux ont été disposés dans le temps et dans l’espace."
                        ],
                        "tags": [
                            "Sciences de la Terre"
                        ],
                        "examples": [
                            {
                                "example_id": "bc06ebfd-b88d-40cc-bbc7-901e78e5beb0",
                                "sense_id": "e2a18111-e127-3425-9518-e872af936d41",
                                "text": "Traité, professeur de géologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bf6656f-000b-47ee-80a2-fe51692eedf0",
                        "source_entry_id": "03d841db-00ff-34b1-a586-fade1731b716",
                        "source_sense_id": "e2a18111-e127-3425-9518-e872af936d41",
