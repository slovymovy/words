                "senses": [
                    {
                        "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                        "entry_id": "16416711-fb41-3e34-a06f-8779332a0a9a",
                        "glosses": [
                            "Notwendigkeit, an einer Hochschule zu Lehrveranstaltungen eingeschrieben zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95d606f3-5dc7-4830-97ee-d4870335f399",
                                "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                                "text": "„Auf Antrag von Studierenden von Bachelor- und Masterstudien sind diese aus besonderen Gründen von der Inskriptionspflicht für ein oder für mehrere Semester zu befreien (Beurlaubung).“"
                            },
                            {
                                "example_id": "f6ff191b-9c3f-4531-ae95-55ab33be3e3b",
                                "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                                "text": "„Statt der verpflichtenden Voranmeldung gibt es jetzt eine vorgezogene Inskriptionspflicht.“"
                            },
                            {
                                "example_id": "8664204a-6abc-4153-a094-22182e32f7ee",
                                "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                                "text": "„Trotz vorverlegter Inskriptionspflicht: Etwa gleichbleibende Studienbeginner.“"
                            },
                            {
                                "example_id": "084be804-615b-4789-b6f7-28e6042688bc",
                                "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                                "text": "„Den Studierenden soll das Leben allerdings nicht nur schwerer gemacht werden, es gibt auch einige Erleichterungen: Beispielsweise dürfen Studenten von nun an Anträge auf Beurlaubung und Erlass der Studiengebühren bis Ende der Inskriptionspflicht stellen – das ist länger als bisher.“"
                            },
                            {
                                "example_id": "6cde5640-671d-47ac-b826-ccc148c57950",
                                "sense_id": "5afc5138-1f42-3585-b11f-95adba6bbf0f",
                                "text": "„Studierende von Studiengängen seien auf Antrag aus besonderen Gründen von der Inskriptionspflicht für ein oder mehrere Semester zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
