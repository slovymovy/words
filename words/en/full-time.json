{
    "word_family": [
        "full-timer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11b00b9e-5ae0-3e36-bb05-eb4079c3a158",
                    "sense_definition": "Involving the standard number of hours for a specific activity, especially a job.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "employment_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is looking for a <w>full-time</w> job after graduating from university.",
                            "target_lang_translations": {
                                "ru": "Она ищет работу на <w>полный рабочий день</w> после окончания университета.",
                                "zh": "大学毕业后，她正在找一份<w>全职</w>工作。"
                            }
                        },
                        {
                            "text": "Being a parent is a <w>full-time</w> commitment that requires a lot of energy.",
                            "target_lang_translations": {
                                "ru": "Быть родителем — это <w>круглосуточная</w> обязанность, требующая много энергии.",
                                "zh": "为人父母是一项需要投入大量精力的<w>全职</w>责任。"
                            }
                        }
                    ],
                    "antonyms": [
                        "part-time"
                    ],
                    "common_phrases": [
                        "full-time job",
                        "full-time employment",
                        "full-time student"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный со стандартным количеством часов для определенной деятельности, особенно работы.",
                        "zh": "指从事某项活动（特别是工作）时，达到标准工作时长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "о рабочем дне или ставке"
                            },
                            {
                                "target_lang_word": "на полную ставку",
                                "target_lang_sense_clarification": "о занятости"
                            },
                            {
                                "target_lang_word": "с полным рабочим днем",
                                "target_lang_sense_clarification": "о графике работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全职",
                                "target_lang_sense_clarification": "指工作时间为标准全天候的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "504e9dc9-5f6d-30f8-99cd-2b23b27ebfa6",
                    "sense_definition": "For the entire amount of time normally required for a task or position.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "employment_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to work <w>full-time</w> to save money for a new car.",
                            "target_lang_translations": {
                                "ru": "Он решил работать <w>полный рабочий день</w>, чтобы накопить денег на новую машину.",
                                "zh": "为了攒钱买新车，他决定<w>全职</w>工作。"
                            }
                        },
                        {
                            "text": "Many people work <w>full-time</w> while also trying to study in the evenings.",
                            "target_lang_translations": {
                                "ru": "Многие люди работают <w>на полную ставку</w>, одновременно пытаясь учиться по вечерам.",
                                "zh": "许多人一边<w>全职</w>工作，一边尝试在晚上学习。"
                            }
                        }
                    ],
                    "antonyms": [
                        "part-time"
                    ],
                    "common_phrases": [
                        "work full-time",
                        "employed full-time"
                    ],
                    "target_lang_definitions": {
                        "ru": "В течение всего времени, обычно требуемого для выполнения задачи или должности.",
                        "zh": "指在完成某项任务或担任某职位时，投入了通常要求的全部时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный рабочий день",
                                "target_lang_sense_clarification": "работать на полную ставку"
                            },
                            {
                                "target_lang_word": "на полную ставку",
                                "target_lang_sense_clarification": "о режиме работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "全职",
                                "target_lang_sense_clarification": "指以全职方式进行某项活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}