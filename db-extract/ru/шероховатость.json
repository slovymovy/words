                        "source_sense_id": "6d28bd24-3b48-3725-8174-cfb3a7504f85",
                        "target_lang_word": "Griffigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8734d600-cb23-4275-be65-c5f549473d45",
                        "source_entry_id": "1ef2472e-aa41-3539-9c7e-63bded0f16e7",
                        "source_sense_id": "6d28bd24-3b48-3725-8174-cfb3a7504f85",
                        "target_lang_word": "rugosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rugosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d2a7a006-078f-3740-9889-1a340baed317",
                                        "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                                        "glosses": [
                                            "État d’une surface raboteuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                        "entry_id": "c40aaef9-ecc7-3304-8b4c-16cb7db49c0c",
                                        "glosses": [
                                            "Petite aspérité que présente cette surface."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4444eefa-a587-4176-aac1-712b0ad99ca9",
                                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                                "text": "Le front pointu, mal caché par des cheveux plats, rares, et qui tombaient comme des filaments de verre soufflé, couronnait par des rugosités rougeâtres une face grimaude."
                                            },
                                            {
                                                "example_id": "f43d729d-87df-46b4-ab03-edbcc93768bc",
                                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                                "text": "Autour du foyer, sur trois faces seulement, pour laisser au cuisinier la libre approche de la marmite, des bancs de bois s’équilibraient sur les rugosités du plancher calleux comme la peau d’une monstrueuse orange, à l’aide de tessons de pots ou de fragments de brique."
                                            },
                                            {
                                                "example_id": "72044e12-b44e-4428-b1e5-b9c08e2db97e",
                                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                                "text": "Le stylet rencontre des rugosités du plancher orbital vers son angle externe."
                                            },
                                            {
                                                "example_id": "cba91465-8aab-4638-b71b-927bf19d31f4",
                                                "sense_id": "70686710-ee97-3e17-aea7-415cb44b6f7b",
                                                "text": "La lueur de leurs cigarettes brillait sur les rugosités mordorées du goulot de la bouteille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a29f1bb8-0594-4d0a-b570-53dcce051a92",
                        "source_entry_id": "1ef2472e-aa41-3539-9c7e-63bded0f16e7",
                        "source_sense_id": "6d28bd24-3b48-3725-8174-cfb3a7504f85",
                        "target_lang_word": "aspérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a032552b-c10e-3139-8bb9-9308cda676ff",
                                        "entry_id": "2fdfb03c-214b-3c4e-a09e-9c9db7bd2abe",
                                        "glosses": [
                                            "Qualité de ce qui est raboteux, inégal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b73198-b05e-40d3-b314-f110644b921d",
                                                "sense_id": "a032552b-c10e-3139-8bb9-9308cda676ff",
                                                "text": "Les aspérités d'un sol fait de roches de formation primitive se trahissaient par des chocs multipliés qui secouaient les traîneaux, et, par contrecoup, les voyageurs."
                                            },
                                            {
                                                "example_id": "7ade76cf-1585-42e3-8cc5-eff3d9dedaeb",
                                                "sense_id": "a032552b-c10e-3139-8bb9-9308cda676ff",
                                                "text": "La torsion régularise le diamètre du fil et elle tend à disposer les aspérités des fibres dans le sens transversal; donc plus un fil est tordu,, plus le coefficient de frottement est faible, …."
                                            },
                                            {
                                                "example_id": "dff90967-d205-4e7e-ada6-31fd4e4c3b9e",
                                                "sense_id": "a032552b-c10e-3139-8bb9-9308cda676ff",
                                                "text": "Ton dos a des aspérités"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53e84bda-fb99-3508-b858-84b75a59b37e",
                                        "entry_id": "2fdfb03c-214b-3c4e-a09e-9c9db7bd2abe",
                                        "glosses": [
                                            "Manque de douceur, d'harmonie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a27df82e-3f01-4e01-a7e0-1b2c890bec94",
                                                "sense_id": "53e84bda-fb99-3508-b858-84b75a59b37e",
                                                "text": "L’aspérité du caractère. Les aspérités du style."
                                            },
                                            {
                                                "example_id": "db276f21-c97b-485d-98ac-b46f974bb177",
                                                "sense_id": "53e84bda-fb99-3508-b858-84b75a59b37e",
                                                "text": "Les aspérités d'un verre dues aux frottements d'un essuie-vaisselle ou d'un dépôt de calcaire sur la paroi donneront, si l'on y incorpore une boisson gazeuse, un filet montant de bulles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22eab991-28b4-4baf-b209-58d7248104e6",
                        "source_entry_id": "1ef2472e-aa41-3539-9c7e-63bded0f16e7",
                        "source_sense_id": "6d28bd24-3b48-3725-8174-cfb3a7504f85",
                        "target_lang_word": "âpreté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "âpreté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90b6bd30-4165-348f-a7e7-bc7ba369ac09",
                                        "entry_id": "f8d83e65-394c-3212-8bfd-1a1487a32abf",
                                        "glosses": [
                                            "Qualité de ce qui est âpre. Rudesse désagréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4b2cf3-d0ef-4d65-9880-290bccbfc545",
                                                "sense_id": "90b6bd30-4165-348f-a7e7-bc7ba369ac09",
                                                "text": "Le tannin, qui vient de la rafle, des pépins et des pellicules donne de l’âpreté ; c'est à ce principe qu'il faut rapporter la plus ou moins longue conservation du vin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                        "entry_id": "f8d83e65-394c-3212-8bfd-1a1487a32abf",
                                        "glosses": [
                                            "Dureté, brutalité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e21d2fe5-3e54-4a70-97bd-9a503b0e7455",
                                                "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                                "text": "La société Serco, choisie pour bercer les passagers entre Londres en Edimbourg, gère, entre autres, les fourgons cellulaires britanniques, des prisons, des centres de rétention et des foyers de demandeurs d’asile. Sa réputation d’âpreté au gain et d’opacité est détestable."
                                            },
                                            {
                                                "example_id": "66c42677-ce56-4378-91f7-a048f49ec894",
                                                "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                                "text": "L’âpreté des chemins rend les communications difficiles dans ce pays-là."
                                            },
                                            {
                                                "example_id": "78174119-0702-48e0-8a15-b47e8cfe4cf1",
                                                "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                                "text": "L’âpreté de son humeur, de son esprit le rend insociable."
                                            },
                                            {
                                                "example_id": "de2ea210-ceca-4ba6-bcdf-ee95d69c5b95",
                                                "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                                "text": "L’âpreté d’une réprimande."
                                            },
                                            {
                                                "example_id": "8ddf8677-9054-4714-b482-96de9a4051e8",
                                                "sense_id": "db9e0e3e-0ac7-3b6b-8c1e-28c1faf9c720",
                                                "text": "L’âpreté d’une discussion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
