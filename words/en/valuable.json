            "senses": [
                {
                    "sense_id": "e2f4159e-d1f5-37b7-9375-8f97f6aeb17f",
                    "sense_definition": "Worth a lot of money.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "monetary_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays a collection of <w>valuable</w> ancient coins.",
                            "target_lang_translations": {
                                "ru": "В музее выставлена коллекция <w>ценных</w> древних монет.",
                                "zh": "博物馆展出了一批<w>贵重的</w>古代钱币。"
                            }
                        },
                        {
                            "text": "She keeps her most <w>valuable</w> jewelry in a secure safe.",
                            "target_lang_translations": {
                                "ru": "Она хранит свои самые <w>ценные</w> украшения в надежном сейфе.",
                                "zh": "她把最<w>贵重的</w>首饰都锁在保险柜里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expensive",
                        "precious"
                    ],
                    "antonyms": [
                        "worthless"
                    ],
                    "common_phrases": [
                        "valuable asset",
                        "valuable item",
                        "valuable property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стоящий больших денег.",
                        "zh": "指价值很高，值很多钱的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценный",
                                "target_lang_sense_clarification": "имеющий высокую стоимость"
                            },
                            {
                                "target_lang_word": "дорогостоящий",
                                "target_lang_sense_clarification": "стоящий дорого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昂贵的",
                                "target_lang_sense_clarification": "价格高昂的"
                            },
                            {
                                "target_lang_word": "贵重的",
                                "target_lang_sense_clarification": "价值高且珍贵的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb95016a-02aa-3ca9-af64-b6535abc2f2e",
                    "sense_definition": "Very helpful, important, or useful.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My teacher gave me some <w>valuable</w> advice about preparing for the exam.",
                            "target_lang_translations": {
                                "ru": "Мой учитель дал мне несколько <w>ценных</w> советов по подготовке к экзамену.",
                                "zh": "老师就备考给了我一些<w>宝贵的</w>建议。"
                            }
                        },
                        {
                            "text": "Working on this project was a <w>valuable</w> experience for the whole team.",
                            "target_lang_translations": {
                                "ru": "Работа над этим проектом стала <w>ценным</w> опытом для всей команды.",
                                "zh": "参与这个项目对整个团队来说都是一次<w>宝贵的</w>经历。"
                            }
                        }
                    ],
                    "synonyms": [
                        "useful",
                        "helpful"
                    ],
                    "antonyms": [
                        "worthless"
                    ],
                    "common_phrases": [
                        "valuable lesson",
                        "valuable contribution",
                        "valuable resource",
                        "valuable information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень полезный, важный или нужный.",
                        "zh": "指非常有帮助、重要或有用的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценный",
                                "target_lang_sense_clarification": "важный, значимый"
                            },
                            {
                                "target_lang_word": "полезный",
                                "target_lang_sense_clarification": "приносящий пользу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝贵的",
                                "target_lang_sense_clarification": "极有价值的，常用于抽象事物"
                            },
                            {
                                "target_lang_word": "有益的",
                                "target_lang_sense_clarification": "能带来好处的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c531bae-39c2-3d6a-b41c-c6e4d298b424",
                    "sense_definition": "A personal possession, such as jewelry or electronics, that is worth a lot of money.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "monetary_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure you lock all your <w>valuables</w> in the hotel safe before leaving.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вы заперли все свои <w>ценности</w> в сейфе отеля перед уходом.",
                                "zh": "离开前请务必将所有<w>贵重物品</w>锁在酒店保险箱里。"
                            }
                        },
                        {
                            "text": "The insurance policy covers the loss of cash and other <w>valuables</w>.",
                            "target_lang_translations": {
                                "ru": "Страховой полис покрывает потерю наличных денег и других <w>ценностей</w>.",
                                "zh": "保险单涵盖了现金及其他<w>贵重物品</w>的损失。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "personal valuables",
                        "stolen valuables",
                        "keep valuables safe"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личная вещь, имеющая высокую материальную стоимость.",
                        "zh": "指个人拥有的贵重物品，如珠宝或电子产品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценности",
                                "target_lang_sense_clarification": "дорогие вещи"
                            },
                            {
                                "target_lang_word": "драгоценности",
                                "target_lang_sense_clarification": "украшения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贵重物品",
                                "target_lang_sense_clarification": "价值高的个人财物"
                            },
                            {
                                "target_lang_word": "财物",
                                "target_lang_sense_clarification": "财产和物品"
                            }
                        ]
                    }
                }
