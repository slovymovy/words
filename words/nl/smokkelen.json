{
    "word_family": [
        "smokkel",
        "smokkelaar",
        "smokkelwaar"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05732a92-67a5-3814-bc2e-0b75cdf54a67",
                    "sense_definition": "Goederen of personen illegaal en in het geheim over een grens vervoeren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "smokkelen_illegaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De douane ontdekte dat zij gevaarlijke stoffen probeerden te <w>smokkelen</w>.",
                            "target_lang_translations": {
                                "en": "Customs discovered that they were trying to <w>smuggle</w> dangerous substances."
                            }
                        },
                        {
                            "text": "Mensen die goederen <w>smokkelen</w> riskeren een hoge gevangenisstraf.",
                            "target_lang_translations": {
                                "en": "People who <w>smuggle</w> goods risk a long prison sentence."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluiken"
                    ],
                    "common_phrases": [
                        "goederen smokkelen",
                        "over de grens smokkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Transport goods or people illegally and secretly across a border."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smuggle",
                                "target_lang_sense_clarification": "to import/export illegally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f680b3f-1496-3abc-b0b7-9008e01ec5ea",
                    "sense_definition": "Regels of afspraken op een stiekeme manier omzeilen of versoepelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde met de regels te <w>smokkelen</w> om sneller klaar te zijn.",
                            "target_lang_translations": {
                                "en": "He tried to <w>bend the rules</w> to finish faster."
                            }
                        },
                        {
                            "text": "Tijdens zijn dieet besloot hij af en toe te <w>smokkelen</w> met wat chocolade.",
                            "target_lang_translations": {
                                "en": "During his diet, he decided to <w>cheat</w> occasionally with some chocolate."
                            }
                        }
                    ],
                    "common_phrases": [
                        "met de tijd smokkelen",
                        "met de regels smokkelen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "In figuurlijke zin gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Secretly bypass or bend rules or agreements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cheat",
                                "target_lang_sense_clarification": "on a diet or rules"
                            },
                            {
                                "target_lang_word": "bend the rules",
                                "target_lang_sense_clarification": "bypass regulations"
                            },
                            {
                                "target_lang_word": "fudge",
                                "target_lang_sense_clarification": "manipulate slightly or bend limits"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}