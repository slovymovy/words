                ],
                "senses": [
                    {
                        "sense_id": "a00558cb-4dd6-3814-b643-2017996337d6",
                        "entry_id": "50f1aa0b-4470-3be1-b63d-b183540fa2d6",
                        "glosses": [
                            "in zichtzelf tegenstrijdig; gericht op onverenigbare zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9dc574a-b548-443a-9072-e85c7587051d",
                                "sense_id": "a00558cb-4dd6-3814-b643-2017996337d6",
                                "text": "Hij begreep dit door het smartelijk gevoel van gespletenheid dat hij op dat moment onderging."
                            },
                            {
                                "example_id": "50d57ef9-312e-4f90-92dc-8ab6f51abb9f",
                                "sense_id": "a00558cb-4dd6-3814-b643-2017996337d6",
                                "text": "Dat leidt tot een bepaalde gespletenheid, stelt D66-fractievoorzitter Rob Jetten. \"Je verdedigt het compromis dat is gesloten in de coalitie, maar je moet ook niet vergeten je eigen verhaal te vertellen.\" En in dat eigen verhaal van D66 zit ook iets dubbels, vertelt Jetten. \"Radicaal en redelijk in een. Wij willen debatten openen waar andere partijen misschien nog niet aan toe zijn. Maar wel met een onderbouwd verhaal.\""
                            },
                            {
                                "example_id": "14835322-4f16-46c2-8166-4ec07105e5fc",
                                "sense_id": "a00558cb-4dd6-3814-b643-2017996337d6",
                                "text": "Ondertussen bemoeiden kunstenaars, ambtenaren, commissies en ministers zich met het ontwerp, ook vaak zonder echt enthousiasme. De Centrale Commissie voor Oorlogs- of Vredesgedenktekens, opgericht om wildgroei aan monumenten te voorkomen, vond het ontwerp te groot voor de drukke Dam. Door de gespletenheid van obelisk en muur miste het bovendien \"de klaarheid en zeggingskracht die van het nationale monument mogen en moeten worden verlangd\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71f49be1-7c3f-49b6-821d-b5d4b828e73d",
                        "source_entry_id": "50f1aa0b-4470-3be1-b63d-b183540fa2d6",
                        "source_sense_id": "a00558cb-4dd6-3814-b643-2017996337d6",
                        "source_sense_description": "in zichtzelf tegenstrijdig; gericht op onverenigbare zaken",
                        "target_lang_word": "schizophrenia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schizophrenia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "A psychiatric diagnosis denoting a persistent, often chronic, mental illness characterised by abnormal perception, thinking, behavior and emotion, often marked by delusions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b870f5d5-1e72-4c08-8957-5c1e8dc2a667",
                                                "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                                "text": "Increasing data suggests that regular marijuana use in adolescence may also be a risk factor for developing very serious psychotic disorders, especially schizophrenia."
                                            },
                                            {
                                                "example_id": "79af51a4-86ad-498c-9300-702400386956",
                                                "sense_id": "8ff748fe-557d-3d02-a8fd-f94c01e1be44",
                                                "text": "In 1995, 2% of schizophrenia diagnoses in the country were associated with cannabis use disorder. In 2000, it increased to around 4%. Since 2010, that figure increased to 8%, the study found."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a03d3e6-40ab-3554-8ab4-e2f3fced0f74",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "A condition in which a person is supposed to have several distinct personalities; dissociative identity disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "proscribed",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecf09cc-4711-435d-80e9-9192af7fc15f",
                                                "sense_id": "0a03d3e6-40ab-3554-8ab4-e2f3fced0f74",
                                                "text": "You have enough money to afford schizophrenia for a while. Especially if the personality B dreams up things that personality A makes practical, financially advantageous use of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                        "entry_id": "814dbabd-478d-3fbe-9f80-af0e99d48c02",
                                        "glosses": [
                                            "Any condition in which disparate or mutually exclusive activities coexist; a lack of decision between options."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61dc42fc-e2c6-4433-87fe-c80c9b8ee6f4",
                                                "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                                "text": "[O]ne can understand how the cultural disorientation which beset the African Continent has confused Africa's political behaviour, creating a political schizophrenia that made nation-building impossible."
                                            },
                                            {
                                                "example_id": "09dab65f-8a90-425f-93d4-d8e6a0be6db3",
                                                "sense_id": "b5f17ada-8b09-379a-bc1c-56d1ff397b1f",
                                                "text": "Nevertheless, a certain amount of schizophrenia pertains to the study of World Englishes as New Englishes, for while new Englishes are regarded as valid varieties in their own right, the description and delineation of them in linguistic terms is conducted through the gaze of native-speaker norms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
