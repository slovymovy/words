                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf23123-34e1-4d34-92fb-8efdfdaa9d23",
                                "sense_id": "3bfa0bbb-b6e4-3e25-8936-124070df975a",
                                "text": "„Bill hasste die beschissenen Sechziger, und da waren sie, direkt vor seiner Nase. Lange Haare, Batik-T-Shirt und ein so blödes Lächeln, dass man den Kerl am liebsten dumm und dämlich geprügelt hätte.“"
                            },
                            {
                                "example_id": "9f27f42f-7f03-4690-ac73-f343b567a1f2",
                                "sense_id": "3bfa0bbb-b6e4-3e25-8936-124070df975a",
                                "text": "„Ein Batik-T-Shirt, eine weite Flatterhose, Hosenbeine über die Schienbeine hochgerollt und Hanfsandalen mit Lederriechem um die Fußknöchel.“"
                            },
                            {
                                "example_id": "0fbc9e17-1c98-43a6-a579-f07130b7d96a",
                                "sense_id": "3bfa0bbb-b6e4-3e25-8936-124070df975a",
                                "text": "„Neben Hanfläden gab es hier Geschäfte, in denen man Schallplatten kaufen konnte, Batik-T-Shirts und Cable-Car-Modelle zum Aufziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
