                ],
                "senses": [
                    {
                        "sense_id": "3d00fa5d-43fe-3f01-962d-db7d485f4361",
                        "entry_id": "4ea4ed3c-98b8-33ef-b10d-d58b2c371861",
                        "glosses": [
                            "zoals nog nooit eerder is gebeurd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60a7d335-3bcf-4320-8360-3c1008abb754",
                                "sense_id": "3d00fa5d-43fe-3f01-962d-db7d485f4361",
                                "text": "De ongekende nauwkeurigheid van de nieuwe atoomklok verbaasde iedereen."
                            },
                            {
                                "example_id": "f48390bb-b526-477c-afb5-6abf03c3cf5f",
                                "sense_id": "3d00fa5d-43fe-3f01-962d-db7d485f4361",
                                "text": "De tweede termijn van de Amerikaanse president Donald Trump is begonnen met een ongekende aanval op de wetenschap."
                            },
                            {
                                "example_id": "2f3351c6-52f9-4547-9443-2f18a9607bb9",
                                "sense_id": "3d00fa5d-43fe-3f01-962d-db7d485f4361",
                                "text": "In 2010 bereikte het geweld in Irak opnieuw een ongekende hoogte. Dat kwam de toenmalige Amerikaanse president Obama slecht uit. De Amerikaanse militairen uit Irak terugtrekken was immers een van zijn verkiezingsbeloftes geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "608e2a24-432b-3125-b3e6-fc40567ac732",
                        "entry_id": "4ea4ed3c-98b8-33ef-b10d-d58b2c371861",
                        "glosses": [
                            "nog niet gekend; onbekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb0733f-83d8-4ff4-a633-96b4777f4dcf",
                                "sense_id": "608e2a24-432b-3125-b3e6-fc40567ac732",
                                "text": "In 2024 rapporteerden onderzoekers van de STAR Collaboration bij de Relativistic Heavy Ion Collider (RHIC) van Brookhaven National Laboratory in New York over het kortstondig creëren van een toen ongekend zware antimateriekern, genaamd antihyperwaterstof-4."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a08a5ecd-48f1-41b3-83ec-fb1e557f1d41",
                        "source_entry_id": "4ea4ed3c-98b8-33ef-b10d-d58b2c371861",
                        "target_lang_word": "inédit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inédit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99c17c92-2d78-3ff2-99e6-97ff7bd55549",
                                        "entry_id": "f19ea711-d9bc-3fc6-a8a6-f89b7a361338",
                                        "glosses": [
                                            "Qui n’a pas été imprimé ou publié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf438dc9-ea2f-41ce-8edb-6e0a36ca6930",
                                                "sense_id": "99c17c92-2d78-3ff2-99e6-97ff7bd55549",
                                                "text": "Poème inédit, Histoire inédite. - Œuvres inédites."
                                            },
                                            {
                                                "example_id": "838e3b0e-fd46-49d1-88e8-facfeec325ff",
                                                "sense_id": "99c17c92-2d78-3ff2-99e6-97ff7bd55549",
                                                "text": "Cet ouvrage est demeuré inédit, est encore inédit."
                                            },
                                            {
                                                "example_id": "276ba267-9b08-40da-865e-0b46633e65c3",
                                                "sense_id": "99c17c92-2d78-3ff2-99e6-97ff7bd55549",
                                                "text": "Je ne voulus pas emprunter à Gilberte la Fille aux yeux d’Or puisqu’elle le lisait. Mais elle me prêta, le dernier soir que je passai chez elle, un livre qui me produisit une impression assez vive et mêlée. C’était un volume du journal inédit des Goncourt."
                                            },
                                            {
                                                "example_id": "210ce380-8891-4879-8d50-f11d6fa2b404",
                                                "sense_id": "99c17c92-2d78-3ff2-99e6-97ff7bd55549",
                                                "text": "une œuvre restée en grande partie inédite du vivant d’un auteur inclassable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4580ecc0-84c1-3f2c-bf04-9a5707301d69",
                                        "entry_id": "f19ea711-d9bc-3fc6-a8a6-f89b7a361338",
                                        "glosses": [
                                            "Auteur dont l’œuvre n’a pas encore été publiée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb38b747-01ba-4407-993b-e9ab2abd4052",
                                                "sense_id": "4580ecc0-84c1-3f2c-bf04-9a5707301d69",
                                                "text": "Moréas (les Syrtes, les Cantilènes), Vignier (Centon), de Régnier (les Lendemains, Apaisement, les Sites), Viélé-Griffin (Cueille d’avril, les Cygnes), montrèrent la marche aux jeunes encore inédits et la cohorte sainte, le bataillon sacré grossit tous les jours, valeureux et digne de tels chefs de file."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27d839a4-4199-3e07-95db-a09d718750e4",
                                        "entry_id": "f19ea711-d9bc-3fc6-a8a6-f89b7a361338",
                                        "glosses": [
                                            "Nouveau ; inusité ; qui n’a pas de précédent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ddeeb66-fed1-42ac-bae5-ac517ce4b6c8",
                                                "sense_id": "27d839a4-4199-3e07-95db-a09d718750e4",
                                                "text": "Spectacle inédit. - Toilette inédite."
                                            },
                                            {
                                                "example_id": "518009e1-0ca9-4e55-ae27-390fac3dd210",
                                                "sense_id": "27d839a4-4199-3e07-95db-a09d718750e4",
                                                "text": "On comprend que le gouvernement veut envoyer le signal qu’il est prêt aux grands moyens, et même aux très grands moyens, pour enfin casser l’épidémie, en prenant une mesure inédite."
                                            },
                                            {
                                                "example_id": "9fa47918-7105-4e94-a610-c2ba12b300b1",
                                                "sense_id": "27d839a4-4199-3e07-95db-a09d718750e4",
                                                "text": "Chargée d’une mission inédite, la CIIVISE a adopté une organisation conforme aux standards institutionnels du genre avec des ajustements résultant du caractère inédit de sa mission."
                                            },
                                            {
                                                "example_id": "a00c5fec-5786-4738-9545-41b49130784c",
                                                "sense_id": "27d839a4-4199-3e07-95db-a09d718750e4",
                                                "text": "Sa marque est inédite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inédit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bafd77c7-ae03-3746-9a91-00a211547f87",
                                        "entry_id": "cd858cd0-8f0e-361d-81db-ea18d035ff38",
                                        "glosses": [
                                            "Ce qui n'est pas édité, imprimé, diffusé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce8e336-4aa6-4f58-9a40-09c8c7507323",
                                                "sense_id": "bafd77c7-ae03-3746-9a91-00a211547f87",
                                                "text": "À ma mort on trouverait des inédits dans mes tiroirs, une méditation sur la mer, une comédie en un acte, quelques pages érudites et sensibles sur les monuments d’Aurillac, de quoi faire une plaquette qui serait publiée par les soins de mes anciens élèves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c652e81c-9203-39c8-bbd1-76f58be6bfee",
                                        "entry_id": "cd858cd0-8f0e-361d-81db-ea18d035ff38",
                                        "glosses": [
                                            "Ce qui est nouveau, qui ne fut jamais fait, jamais pratiqué auparavant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a77a37e-56bf-4a6f-8ce8-0b42bd34588f",
                                                "sense_id": "c652e81c-9203-39c8-bbd1-76f58be6bfee",
                                                "text": "Ainsi, lors de la crise des banlieues, l’inédit ne réside pas dans la révolte, mais dans la rupture avec ses formes établies. Les assaillants n’écoutent plus personne, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e98096-c1c5-3a09-a513-9742532790fe",
                                        "entry_id": "cd858cd0-8f0e-361d-81db-ea18d035ff38",
                                        "glosses": [
                                            "Cheval de course n'ayant jamais couru auparavant."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
