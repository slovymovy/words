                    }
                ],
                "senses": [
                    {
                        "sense_id": "50be1f85-57f9-3070-93ad-ad84bc45e5c9",
                        "entry_id": "b394e639-52f2-36c9-b884-f8f30fe6e13c",
                        "glosses": [
                            "fettarmes, helles Fleisch vom jungen Rind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab6e97c-6fa9-418c-b268-742c74bc27c0",
                                "sense_id": "50be1f85-57f9-3070-93ad-ad84bc45e5c9",
                                "text": "Ein richtiges Wiener Schnitzel muss aus Kalbfleisch sein."
                            },
                            {
                                "example_id": "87911628-07b6-4914-a88e-686092a4cfa1",
                                "sense_id": "50be1f85-57f9-3070-93ad-ad84bc45e5c9",
                                "text": "„Kalbsleberwurst enthält einen Anteil von mindestens 15 % Kalbfleisch oder entsehntem Jungrindfleisch. Seit Anfang 2010 muss Kalbsleberwurst in Deutschland auch einen Anteil Kalbsleber enthalten.“"
                            },
                            {
                                "example_id": "26a28b2f-a977-4bec-8075-3944e0d212f3",
                                "sense_id": "50be1f85-57f9-3070-93ad-ad84bc45e5c9",
                                "text": "„Sie kommen mit freigiebigen Händen, bringen kleine Geschenke mit, Kalbfleisch und Kekse, natürlich Süßes für die Kinder, sogar ein fünfjähriges Pferd; und nicht zuletzt Post, die seit drei oder vier Wochen unten in Bæ gelegen hat, beim Gemeindevorsteher, der grüßen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81852312-d2b3-458d-930d-311a9aa7e2e0",
                        "source_entry_id": "b394e639-52f2-36c9-b884-f8f30fe6e13c",
                        "source_sense_id": "50be1f85-57f9-3070-93ad-ad84bc45e5c9",
                        "source_sense_description": "Gastronomie: fettarmes, helles Fleisch vom jungen Rind",
                        "target_lang_word": "veal",
