                "senses": [
                    {
                        "sense_id": "114d41ca-44a7-3eaa-8fda-534d9cff5e7f",
                        "entry_id": "8ea45b9e-4078-3502-a27b-4b9354e83b6c",
                        "glosses": [
                            "To dissociate atoms or molecules into electrically charged species; to be thus dissociated."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6e4a541-f6d4-44f9-8469-fe7150f9f8f6",
                        "source_entry_id": "8ea45b9e-4078-3502-a27b-4b9354e83b6c",
                        "source_sense_id": "114d41ca-44a7-3eaa-8fda-534d9cff5e7f",
                        "source_sense_description": "to dissociate atoms or molecules into electrically charged species",
                        "target_lang_word": "ioniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ioniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68f43378-5233-3b17-8ac3-c21c69123284",
                                        "entry_id": "efd2ddf3-5274-3356-9a6f-cfbb46d62a34",
                                        "glosses": [
                                            "Provoquer l’ionisation d’un élément."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eb8ba03-19db-4791-9efb-c2f922db845b",
                                                "sense_id": "68f43378-5233-3b17-8ac3-c21c69123284",
                                                "text": "Or une ionisation indépendante des deux réactifs eût voulu que le même bromure, le tertiaire par exemple, s’ionisât plus vite que les deux autres, […]."
                                            },
                                            {
                                                "example_id": "76da25c4-7916-42ca-8fcd-c4ed44350dd6",
                                                "sense_id": "68f43378-5233-3b17-8ac3-c21c69123284",
                                                "text": "Pour rendre conducteur un espace qui ne l’est pas, on peut donc songer soit à ioniser un gaz, soit, si l’on peut dire, à \"électroniser un vide\"."
                                            },
                                            {
                                                "example_id": "85663cca-e185-4ced-b406-eaea9c7cd891",
                                                "sense_id": "68f43378-5233-3b17-8ac3-c21c69123284",
                                                "text": "Il avait conclu que les rayons X chargeaient (« ionisaient », en termes savants) l'air dans l’ampoule et que ces charges venaient donc annuler celles de l’électroscope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "153d4148-8b60-4af3-81cf-022406c9bace",
                        "source_entry_id": "8ea45b9e-4078-3502-a27b-4b9354e83b6c",
                        "source_sense_id": "114d41ca-44a7-3eaa-8fda-534d9cff5e7f",
                        "source_sense_description": "to dissociate atoms or molecules into electrically charged species",
                        "target_lang_word": "ionisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ionisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                        "entry_id": "0d212d99-83d9-3b41-9c93-4a054244e1ef",
                                        "glosses": [
                                            "ein oder mehrere Elektronen zu einem Atom oder Molekül hinzufügen oder entfernen und damit den elektrischen Ladungszustand verändern"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b278651-6e2b-4151-b4ca-02a394f7616a",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "„Diese energetischen geladenen Teilchen können das Zählgas eines Detektors, eine Art moderner Geigerzähler, ionisieren.“"
                                            },
                                            {
                                                "example_id": "cdc129cf-410f-4de3-aeff-876d5685158c",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Dagegen werden wir Neutronenstrahlen, die sehr wohl ionisieren, nicht als ionisierende Strahlung bezeichnen, weil ihre Hauptwirkung im Anstoßen von Atomkernen besteht, die ihrerseits ionisieren; die Ionisation ist dann ein sekundärer Prozess."
                                            },
                                            {
                                                "example_id": "bc20cc92-5183-4149-9ffa-58ae6f9bcdab",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Bei Strahlung ionisieren Alpha- und Betateilchen die Atome der von ihnen durchquerten Substanzen und erzeugen meist Kationen."
                                            },
                                            {
                                                "example_id": "cd018799-37e2-45a8-a280-b1325d1c1c36",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Auch Gammastrahlen können Atome ionisieren."
                                            },
                                            {
                                                "example_id": "698e17c7-3c3f-44e8-8e49-f1c471e3c6dd",
                                                "sense_id": "a1555265-a837-3a58-a7f5-3f3aa177f7a5",
                                                "text": "Die Gasatome vermögen durch ihre eigene kinetische Energie andere durch Stoß zu ionisieren (Stoßionisation)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
