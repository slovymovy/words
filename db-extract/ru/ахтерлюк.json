                        "glosses": [
                            "морск. погреб на судне для хранения мокрой провизии, а также вина и уксуса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466d3c54-a2aa-4f95-87ea-5be805c7193c",
                                "sense_id": "19f0a7b0-1740-3b7f-b9fb-1d0539a8d1f4",
