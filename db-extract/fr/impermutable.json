                        "examples": [
                            {
                                "example_id": "f6dcea81-d7a3-4af2-bc3a-9c0d83e1b509",
                                "sense_id": "92857024-d5d3-3b55-8b42-b402d72b80c5",
                                "text": "Il démontra que la loi de 1810 établissait au profit du concessionnaire un droit impermutable. (Note : L’édition originale (1869) utilise le mot incommutable, qui a en droit un sens que n’a pas impermutable, possible erreur de correction.)"
                            },
                            {
                                "example_id": "cacb88d0-7db9-40f4-a0bd-51f60736d63c",
                                "sense_id": "92857024-d5d3-3b55-8b42-b402d72b80c5",
                                "text": "Ici, l’adjectif sera impermutable, la sonorité des mètres sagement graduée, la pensée souvent parée d’un Symbole, - voile qui se déchirera à la fin-..."
                            },
                            {
                                "example_id": "7d7f2fec-45fb-4f8a-b12e-c70970f6240e",
                                "sense_id": "92857024-d5d3-3b55-8b42-b402d72b80c5",
                                "text": "Lorsque la première voyelle est impermutable, la seconde peut disparaître"
                            }
                        ]
