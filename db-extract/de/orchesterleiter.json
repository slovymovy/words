                ],
                "senses": [
                    {
                        "sense_id": "231a30c9-65d6-334e-a1d3-38146983c11a",
                        "entry_id": "116c4108-6d95-336f-862e-e23f8c057cdc",
                        "glosses": [
                            "jemand, der ein Orchester leitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3257331-99d0-4b29-8fd1-e0e20a18b2fd",
                                "sense_id": "231a30c9-65d6-334e-a1d3-38146983c11a",
                                "text": "„‚Die Leute beurteilen Lady Gaga oft nach ihrem durchgeknallten Aussehen, aber sie macht gute Musik‘, sagte der Orchesterleiter der ‚Südwest Presse‘ (Mittwoch).“"
                            },
                            {
                                "example_id": "df7ebbdd-e1a4-43d1-a31e-304019f3dec0",
                                "sense_id": "231a30c9-65d6-334e-a1d3-38146983c11a",
                                "text": "„Und Marlene Dietrich bekam durch ihn einen jungen Stiefpapa: Bacharach begleitete sie auf ihrer großen Welttournee von 1958-1961 als Pianist und Orchesterleiter und verhalf ihr zu einer weiteren Karriere in ihrem Leben.“"
                            },
                            {
                                "example_id": "31ec4ca0-5ee3-4cf7-8a61-a5d2d46d2ed0",
                                "sense_id": "231a30c9-65d6-334e-a1d3-38146983c11a",
                                "text": "„Und Thielemann selbst erkannte jetzt in Dresden: ›Die wechselnden Orchesterleiter haben den Klang in Dresden nicht umgekrempelt. […]‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
