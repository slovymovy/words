                "senses": [
                    {
                        "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                        "entry_id": "12d991fa-2c98-3fd7-b0a4-2e27395de352",
                        "glosses": [
                            "weibliche Person in einer Mannschaftssportart, die in einem Spiel die spielentscheidende Aktion hat (beispielsweise ein Tor geschossen/einen Korb geworfen/einen Elfmeter gehalten hat) oder die über die gesamte Spielzeit oder sogar über ein Turnier herausragend für den Erfolg der Mannschaft war"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "aebb599d-f4e1-4fad-919f-6470fafbd7e2",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Fußball:] „Matchwinnerin im Spiel gegen die Niederlande war Laura Österberg Kalmari, die beide finnische Treffer per Kopf erzielte.“"
                            },
                            {
                                "example_id": "2a880748-add0-4ec6-b70b-6a3a2ae99daa",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Fußball:] „Die Verteidigerin brillierte gegen die Türkei mit zwei Treffern und war damit die Matchwinnerin.“"
                            },
                            {
                                "example_id": "8cb523c8-725d-47c7-ba03-5a42a9143e17",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Fußball:] „Lyons Matchwinnerin war Delphine Cascarino.“"
                            },
                            {
                                "example_id": "d307c698-c630-4ef9-a1cc-b6a5a5d99e08",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Fußball:] „Hier wurde dann Ingrid Hjelmseth zur Matchwinnerin, denn sie konnte die ersten beiden Elfmeter der Däninnen halten.“"
                            },
                            {
                                "example_id": "145ee8af-c807-4296-8f72-0c47f89e8ff4",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Fußball:] „Doch Berger ließ sich nicht aus der Ruhe bringen: Die Matchwinnerin des Viertelfinal-Elfmeterschießen-Krimis gegen Kanada wehrte den von Putellas nach rechts geschossenen Ball mit beiden Fäusten stark ab.“"
                            },
                            {
                                "example_id": "16f40d0f-0dfb-4421-96a1-4768ffc4908b",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Olympische Spiele 2024, Teamwettbewerb Frauen, Tischtennis: …] „Kaufmann wurde beim 3:0 (11:6, 11:7, 11:7) gegen die Weltranglisten-22. Akula wie gegen die USA zur Matchwinnerin.“"
                            },
                            {
                                "example_id": "c999be69-44ff-4542-ad35-0ad52a207e05",
                                "sense_id": "5382b715-fc0b-3240-a01c-db1e0d15c474",
                                "text": "[Schlagzeile:] „Als Nachrückerin zur Matchwinnerin: Deutschland dank Annett Kaufmann im Viertelfinale“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
