{
    "word_family": [
        "gratis",
        "gratuitously",
        "gratuitousness",
        "gratuity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2bdf26e9-93ac-3864-bb95-7df4e619ed9e",
                    "sense_definition": "Done or provided without a good reason; unnecessary or unjustified.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was criticized by many reviewers for its excessive and <w>gratuitous</w> violence.",
                            "target_lang_translations": {
                                "ru": "Фильм подвергся критике многих рецензентов за чрезмерное и <w>бессмысленное</w> насилие."
                            }
                        },
                        {
                            "text": "He made a <w>gratuitous</w> remark about her appearance that offended everyone in the room.",
                            "target_lang_translations": {
                                "ru": "Он сделал <w>беспричинное</w> замечание по поводу её внешности, которое оскорбило всех в комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncalled-for",
                        "unjustified",
                        "groundless",
                        "baseless",
                        "unfounded",
                        "unnecessary"
                    ],
                    "common_phrases": [
                        "gratuitous violence",
                        "gratuitous remark",
                        "gratuitous insult"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный или предоставленный без веской причины; излишний или неоправданный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспричинный",
                                "target_lang_sense_clarification": "не имеющий под собой оснований или поводов"
                            },
                            {
                                "target_lang_word": "необоснованный",
                                "target_lang_sense_clarification": "не подкрепленный объективными причинами"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "излишний и не имеющий разумной цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05230f4-7ba4-35b6-9074-be0528885739",
                    "sense_definition": "Given or done free of charge; voluntary and without payment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The organization provides <w>gratuitous</w> legal advice to low-income families in the city.",
                            "target_lang_translations": {
                                "ru": "Организация предоставляет <w>безвозмездную</w> юридическую помощь малообеспеченным семьям города."
                            }
                        },
                        {
                            "text": "She offered a <w>gratuitous</w> service to help the community rebuild after the storm.",
                            "target_lang_translations": {
                                "ru": "Она предложила <w>бесплатную</w> помощь, чтобы помочь местным жителям восстановиться после шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "free",
                        "gratis"
                    ],
                    "antonyms": [
                        "onerous"
                    ],
                    "common_phrases": [
                        "gratuitous service",
                        "gratuitous help"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern contexts to mean simply 'free of charge'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставляемый или выполняемый бесплатно; добровольный и не требующий оплаты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безвозмездный",
                                "target_lang_sense_clarification": "не требующий никакой оплаты или компенсации"
                            },
                            {
                                "target_lang_word": "бесплатный",
                                "target_lang_sense_clarification": "предоставляемый без взимания платы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}