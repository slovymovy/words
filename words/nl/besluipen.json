    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a2b6897-6cd1-304b-9ab4-31d475ada045",
                    "sense_definition": "stil en heimelijk naar iets of iemand toegaan zodat die het niet merkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "besluipen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat <w>besloop</w> het vogeltje om het te kunnen vangen.",
                            "target_lang_translations": {
                                "en": "The cat <w>stalked</w> the little bird in order to catch it."
                            }
                        },
                        {
                            "text": "De jager probeerde de hinde voorzichtig te <w>besluipen</w> in het bos.",
                            "target_lang_translations": {
                                "en": "The hunter tried to carefully <w>sneak up on</w> the doe in the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "besluipen",
                        "sluipen naar"
                    ],
                    "common_phrases": [
                        "een prooi besluipen",
                        "iemand ongemerkt besluipen"
                    ],
                    "target_lang_definitions": {
                        "en": "to approach something or someone quietly and secretly so that they do not notice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stalk",
                                "target_lang_sense_clarification": "to approach prey or a person stealthily"
                            },
                            {
                                "target_lang_word": "sneak up on",
                                "target_lang_sense_clarification": "to approach someone without being seen or heard"
                            },
                            {
                                "target_lang_word": "creep up on",
                                "target_lang_sense_clarification": "to move slowly and quietly towards someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dedb92a-7bb7-3b04-bb25-73713e5df462",
                    "sense_definition": "iemand voortdurend lastigvallen of kwellen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lastigvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gedachte aan zijn fouten bleef hem de hele nacht <w>besluipen</w>.",
                            "target_lang_translations": {
                                "en": "The thought of his mistakes continued to <w>haunt</w> him all night."
                            }
                        },
                        {
                            "text": "Zij voelde zich door angst <w>beslopen</w> toen ze alleen in het donker liep.",
                            "target_lang_translations": {
                                "en": "She felt fear <w>creeping over</w> her as she walked alone in the dark."
                            }
                        }
                    ],
                    "synonyms": [
                        "belagen",
                        "hinderen",
                        "lastigvallen"
                    ],
                    "common_phrases": [
                        "door angst beslopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to constantly bother, haunt, or torment someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haunt",
                                "target_lang_sense_clarification": "of thoughts or feelings, to stay in the mind"
                            },
                            {
                                "target_lang_word": "creep over",
                                "target_lang_sense_clarification": "of a feeling, to gradually start to affect someone"
                            },
                            {
                                "target_lang_word": "beset",
                                "target_lang_sense_clarification": "to trouble or threaten persistently"
                            }
                        ]
                    }
                }
            ]
        }
    ]
