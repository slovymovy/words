                "senses": [
                    {
                        "sense_id": "5ceafad1-004d-3b70-b56d-c6801304fc51",
                        "entry_id": "7abcce4e-bbb4-3dbb-84d1-ec822381ea71",
                        "glosses": [
                            "Capuchon en pointe dont se servent certains ordres religieux tels les capucins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ec0351-9d21-4476-a519-c0d719f0d1d7",
                                "sense_id": "5ceafad1-004d-3b70-b56d-c6801304fc51",
                                "text": "Padre Pugnaccio, le crâne hors du capuce, montait les escaliers du dôme Saint-Pierre, entre deux dévotes enveloppées de mantilles, …."
                            },
                            {
                                "example_id": "9a56242b-6562-4766-aa22-4cbd4322a228",
                                "sense_id": "5ceafad1-004d-3b70-b56d-c6801304fc51",
                                "text": "Foin des duchesses et des courtisanes, des bourgeoises et des bergères ! qui dit femme dit tracasseries, mécomptes ou aventures maussades. Je les hais de la coiffe au patin, et je vais me confire en chasteté comme un moinillon en sa capuce."
                            },
                            {
                                "example_id": "5481fe7f-9022-42c3-92a8-afd866a3e38f",
                                "sense_id": "5ceafad1-004d-3b70-b56d-c6801304fc51",
                                "text": "On lui posa sur la tête un capuce terminé par une croix à huit branches, le visage étant recouvert d’un voile noir, et dans les mains une icône du Sauveur."
                            }
                        ]
                    },
