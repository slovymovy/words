                ],
                "senses": [
                    {
                        "sense_id": "1622682b-581e-3236-b859-0cf83b9b1706",
                        "entry_id": "17d97e66-bad1-3071-a03c-7896594972ed",
                        "glosses": [
                            "религ. титулование монаха, иеромонаха, также иерея, священника"
                        ],
                        "tags": [
                            "обычно в сочетании с притяж. местоимением"
                        ],
                        "examples": [
                            {
                                "example_id": "4404ad34-254a-4bd6-addd-722aa8660846",
                                "sense_id": "1622682b-581e-3236-b859-0cf83b9b1706",
                                "text": "Его преподобие имел такое мнение, что всякий доктор и всякий лекарь должен быть неминуемо колдун и что весь корпус медиков есть не что иное, как сатанино сонмище, попущенное гневом Божиим на пагубу человеческого рода."
                            },
                            {
                                "example_id": "5ef12c78-4b70-4b32-b46c-2a109319d2b5",
                                "sense_id": "1622682b-581e-3236-b859-0cf83b9b1706",
                                "text": "Вот так и вся земля тут запустеет, ваше преподобие."
                            }
                        ]
                    },
                    {
                        "sense_id": "88ac6051-d1ba-320c-9376-0cb97d877832",
                        "entry_id": "17d97e66-bad1-3071-a03c-7896594972ed",
                        "glosses": [
                            "устар., святость, праведность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9d2cf11-22cf-44f4-b7a3-0801d0fbcbab",
                                "sense_id": "88ac6051-d1ba-320c-9376-0cb97d877832",
                                "text": "Образ Божий состоит, по объяснению Апостола Павла, в правде и в преподобии истины."
                            }
                        ]
                    }
