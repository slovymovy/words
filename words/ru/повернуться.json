{
    "word_family": [
        "поворот",
        "поворотный",
        "поворачивать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b82d3bde-e3b8-3ae6-a47f-217893989eaf",
                    "sense_definition": "Изменить положение тела или предмета вращением вокруг своей оси.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>повернулся</w> ко мне, чтобы что-то сказать."
                        },
                        {
                            "text": "Машина резко <w>повернулась</w> направо на перекрестке."
                        }
                    ],
                    "synonyms": [
                        "поворотиться"
                    ],
                    "common_phrases": [
                        "повернуться кругом",
                        "повернуться спиной"
                    ]
                },
                {
                    "sense_id": "623c039a-b22c-3027-8985-91b370e611b1",
                    "sense_definition": "Принять неожиданный оборот, получить иное развитие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дело <w>повернулось</w> совсем не так, как мы ожидали."
                        },
                        {
                            "text": "Ситуация <w>повернулась</w> в нашу пользу после долгих переговоров."
                        }
                    ],
                    "synonyms": [
                        "обернуться"
                    ],
                    "common_phrases": [
                        "дело повернулось"
                    ]
                },
                {
                    "sense_id": "e712d9b7-01a8-3d22-8b19-096f0ca0ccf9",
                    "sense_definition": "Изменить отношение к кому-либо или показать себя с другой стороны.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После ссоры он <w>повернулся</w> к друзьям совсем другой стороной."
                        },
                        {
                            "text": "Он <w>повернулся</w> к нам лицом только тогда, когда ему понадобилась помощь."
                        }
                    ]
                },
                {
                    "sense_id": "085aa6c4-ed83-36c1-a7aa-32b6b1b59768",
                    "sense_definition": "Потерять разум, сойти с ума.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Кажется, он совсем <w>повернулся</w> на этой идее."
                        },
                        {
                            "text": "От такой жары можно <w>повернуться</w>."
                        }
                    ],
                    "synonyms": [
                        "чокнуться"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "разговорное выражение"
                        }
                    ]
                },
                {
                    "sense_id": "1cac875b-ec2a-327b-a340-f198193edca3",
                    "sense_definition": "Чрезмерно увлечься кем-либо или чем-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>повернулся</w> на коллекционировании старых монет."
                        },
                        {
                            "text": "Она <w>повернулась</w> на здоровом питании и ни о чем другом не говорит."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение"
                        }
                    ]
                }
            ]
        }
    ]
}