                                        "entry_id": "92774b62-e6b4-3994-aaa5-cd397560cc2a",
                                        "glosses": [
                                            "Chaque petite drupe qui constitue un fruit composé de plusieurs drupes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016f5653-944a-4dfa-be2a-136f2b40b146",
                                                "sense_id": "631b64bb-bed6-38c2-9fff-b461d85a3f6c",
                                                "text": "Dans la framboise ou la mûre, chacun des petits grains est en fait une petite drupe appelée drupéole."
                                            },
                                            {
                                                "example_id": "f338d593-bba8-4ac5-9fbd-3b3f85114899",
                                                "sense_id": "631b64bb-bed6-38c2-9fff-b461d85a3f6c",
                                                "text": "Durant la maturation outre les facteurs de stérilité dépendant de la plante interviennent, une série de facteurs externes et internes, accidentels ou autres, pour empêcher la maturation des drupéoles."
                                            }
                                        ]
                                    }
