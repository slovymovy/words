    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "98d6e11d-7aec-3cd8-8458-f61b5e751341",
                    "sense_definition": "A vessel such as a plate for holding or serving food, often flat with a depressed region in the middle.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tableware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed the ceramic <w>dish</w> carefully in the center of the table.",
                            "target_lang_translations": {
                                "ru": "Она осторожно поставила керамическое <w>блюдо</w> в центр стола."
                            }
                        },
                        {
                            "text": "Please put the butter in a small <w>dish</w> for the guests.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи масло в небольшую <w>тарелочку</w> для гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "plate"
                    ],
                    "common_phrases": [
                        "serving dish",
                        "ceramic dish",
                        "butter dish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд, такой как тарелка, для хранения или подачи еды, часто плоский с углублением посередине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таре́лка",
                                "target_lang_sense_clarification": "обычная плоская или глубокая"
                            },
                            {
                                "target_lang_word": "блю́до",
                                "target_lang_sense_clarification": "большая тарелка для подачи"
                            },
                            {
                                "target_lang_word": "ми́ска",
                                "target_lang_sense_clarification": "глубокая посуда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef2b63ec-8fdf-3b1f-9520-304b7132da81",
                    "sense_definition": "Tableware, including cutlery and crockery, that needs to be washed after a meal.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "tableware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is your turn to <w>wash</w> the <w>dishes</w> after dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня твоя очередь мыть <w>посуду</w> после ужина."
                            }
                        },
                        {
                            "text": "The sink was full of <w>dirty</w> <w>dishes</w> from the party.",
                            "target_lang_translations": {
                                "ru": "Раковина была полна грязной <w>посуды</w> после вечеринки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wash the dishes",
                        "dirty dishes",
                        "do the dishes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Столовые приборы и посуда, которые необходимо мыть после еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посу́да",
                                "target_lang_sense_clarification": "совокупность тарелок, чашек и т.д."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44390c2d-981b-33a4-ba6e-ec1246a417f9",
                    "sense_definition": "A specific type of prepared food or a particular recipe.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This vegetable <w>dish</w> is filling and easily made with fresh ingredients.",
                            "target_lang_translations": {
                                "ru": "Это овощное <w>блюдо</w> очень сытное и легко готовится из свежих ингредиентов."
                            }
                        },
                        {
                            "text": "My favorite <w>main</w> <w>dish</w> at this restaurant is the grilled salmon.",
                            "target_lang_translations": {
                                "ru": "Моё любимое основное <w>блюдо</w> в этом ресторане — лосось на гриле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "main dish",
                        "side dish",
                        "signature dish",
                        "pasta dish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный вид приготовленной пищи или конкретный рецепт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блю́до",
                                "target_lang_sense_clarification": "приготовленное кушанье"
                            },
                            {
                                "target_lang_word": "ку́шанье",
                                "target_lang_sense_clarification": "еда, яство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c17bb6d4-9434-3c9a-b6c7-8c0d14f0ea6e",
                    "sense_definition": "The amount of food contained in a dish.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ate a large <w>dish</w> of stew before heading out to work.",
                            "target_lang_translations": {
                                "ru": "Он съел большую <w>порцию</w> рагу перед тем, как отправиться на работу."
                            }
                        },
                        {
                            "text": "Would you like another <w>dish</w> of ice cream for dessert?",
                            "target_lang_translations": {
                                "ru": "Хотите ещё одну <w>порцию</w> мороженого на десерт?"
                            }
                        }
                    ],
                    "synonyms": [
                        "dishful",
                        "plateful"
                    ],
                    "common_phrases": [
                        "dish of ice cream",
                        "dish of stew"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество еды, содержащееся в одной тарелке или порции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порция",
                                "target_lang_sense_clarification": "количество еды"
                            },
                            {
                                "target_lang_word": "тарелка",
                                "target_lang_sense_clarification": "содержимое тарелки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b5077d5-d636-3e8c-8334-f9b1354067c8",
                    "sense_definition": "A type of antenna with a concave shape similar to a bowl, used for signals.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We installed a <w>satellite</w> <w>dish</w> on the roof to get more channels.",
                            "target_lang_translations": {
                                "ru": "Мы установили спутниковую <w>тарелку</w> на крыше, чтобы ловить больше каналов."
                            }
                        },
                        {
                            "text": "The large radar <w>dish</w> rotated slowly to scan the horizon.",
                            "target_lang_translations": {
                                "ru": "Большая радарная <w>антенна</w> медленно вращалась, сканируя горизонт."
                            }
                        }
                    ],
                    "common_phrases": [
                        "satellite dish",
                        "radar dish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип антенны вогнутой формы, похожей на чашу, используемый для приема сигналов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "таре́лка",
                                "target_lang_sense_clarification": "спутниковая или параболическая антенна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea74d675-b6e4-3d2e-904f-e38b9c5f9800",
                    "sense_definition": "Information shared about the personal lives of others; gossip.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gossip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine is full of the latest <w>dish</w> on Hollywood celebrities.",
                            "target_lang_translations": {
                                "ru": "Журнал полон последних <w>сплетен</w> о голливудских знаменитостях."
                            }
                        },
                        {
                            "text": "She gave us all the <w>inside</w> <w>dish</w> about the office romance.",
                            "target_lang_translations": {
                                "ru": "Она рассказала нам все <w>подробности</w> офисного романа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inside dish",
                        "latest dish"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for gossip"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация о личной жизни других людей; сплетни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплетни",
                                "target_lang_sense_clarification": "слухи о ком-то"
                            },
                            {
                                "target_lang_word": "слухи",
                                "target_lang_sense_clarification": "непроверенная информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cdb29e-fbe5-371c-94ec-7f500d2bd6bf",
                    "sense_definition": "A person who is considered very sexually attractive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attractiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone at the party agreed that the new actor was <w>quite</w> <w>a</w> <w>dish</w>.",
                            "target_lang_translations": {
                                "ru": "Все на вечеринке согласились, что новый актер — настоящий <w>красавчик</w>."
                            }
                        },
                        {
                            "text": "He was known as a real <w>dish</w> back in his college days.",
                            "target_lang_translations": {
                                "ru": "В студенческие годы он был известен как настоящий <w>красавец</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "babe",
                        "fox"
                    ],
                    "common_phrases": [
                        "quite a dish",
                        "real dish"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated slang for an attractive person"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который считается очень сексуально привлекательным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "о женщине"
                            },
                            {
                                "target_lang_word": "красавчик",
                                "target_lang_sense_clarification": "о мужчине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7056f68b-c90c-3b5c-9009-38b34f17ba05",
                    "sense_definition": "The home plate in the game of baseball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "baseball",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The catcher waited at the <w>dish</w> for the runner to arrive.",
                            "target_lang_translations": {
                                "ru": "Кэтчер ждал на <w>базе</w>, пока прибежит раннер."
                            }
                        },
                        {
                            "text": "He pounded the <w>dish</w> with his bat before the first pitch.",
                            "target_lang_translations": {
                                "ru": "Он постучал битой по <w>базе</w> перед первой подачей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "at the dish",
                        "behind the dish"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "baseball jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Домашняя база в игре бейсбол."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "база",
                                "target_lang_sense_clarification": "в бейсболе"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "домашняя база"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9173b987-b50c-30e3-8492-a9eda1451e2d",
                    "sense_definition": "To put food into a container or containers for serving.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you help me <w>dish</w> <w>up</w> the soup for the guests?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты помочь мне <w>разлить</w> суп для гостей?"
                            }
                        },
                        {
                            "text": "She began to <w>dish</w> the pasta into individual bowls.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>раскладывать</w> пасту по отдельным мискам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dish up",
                        "dish out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскладывать еду по тарелкам или контейнерам для подачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскладывать",
                                "target_lang_sense_clarification": "еду по тарелкам"
                            },
                            {
                                "target_lang_word": "накладывать",
                                "target_lang_sense_clarification": "порции еды"
                            }
                        ]
                    }
