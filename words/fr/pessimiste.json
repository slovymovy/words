{
    "word_family": [
        "pessimisme"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b65d9617-9ee7-3c29-a3dd-8a0c8ba8a6d5",
                    "sense_definition": "Qui est enclin à voir le mauvais côté des choses ou à prévoir une issue défavorable aux événements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il reste très <w>pessimiste</w> quant aux chances de réussite de ce nouveau projet."
                        },
                        {
                            "text": "Les analystes financiers ont présenté une vision <w>pessimiste</w> de la situation économique actuelle."
                        }
                    ],
                    "synonyms": [
                        "défaitiste",
                        "morose",
                        "négatif"
                    ],
                    "antonyms": [
                        "optimiste"
                    ],
                    "common_phrases": [
                        "vision pessimiste",
                        "scénario pessimiste",
                        "prévisions pessimistes"
                    ]
                },
                {
                    "sense_id": "a2a47589-0ab4-3bd1-a6e0-73efd743c76f",
                    "sense_definition": "Qui a rapport au pessimisme en tant que doctrine philosophique ou vision générale du monde.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette doctrine <w>pessimiste</w> considère la souffrance comme inhérente à l'existence humaine."
                        },
                        {
                            "text": "Le professeur a analysé les thèses <w>pessimistes</w> développées dans cet essai classique."
                        }
                    ],
                    "antonyms": [
                        "optimiste"
                    ],
                    "common_phrases": [
                        "philosophie pessimiste",
                        "doctrine pessimiste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "379dced6-a72b-34dd-8631-265d978a5995",
                    "sense_definition": "Personne qui a naturellement tendance à voir les aspects négatifs de toute situation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon frère est un éternel <w>pessimiste</w> qui craint toujours le pire."
                        },
                        {
                            "text": "Les <w>pessimistes</w> affirment souvent que le plan échouera avant même de commencer."
                        }
                    ],
                    "synonyms": [
                        "défaitiste"
                    ],
                    "antonyms": [
                        "optimiste"
                    ],
                    "common_phrases": [
                        "éternel pessimiste"
                    ]
                },
                {
                    "sense_id": "fc44d4b3-7c6f-3df9-94fc-22022e92392f",
                    "sense_definition": "Philosophe ou penseur qui professe et défend le pessimisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Schopenhauer est souvent considéré comme le plus célèbre des <w>pessimistes</w> modernes."
                        },
                        {
                            "text": "Ce penseur se revendique ouvertement comme un <w>pessimiste</w> intransigeant."
                        }
                    ],
                    "antonyms": [
                        "optimiste"
                    ]
                }
            ]
        }
    ]
