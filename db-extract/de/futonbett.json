                "senses": [
                    {
                        "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                        "entry_id": "4e97bab7-5929-3b26-bb0d-9859033bf105",
                        "glosses": [
                            "Bett mit niedrigem Rahmengestell und relativ fester Matratze; in Anlehnung an das japanische Bett: Futon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60055ee0-8d4e-45e2-9aed-1dabc503fbc6",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "In seiner Studentenbude steht außer einem Schreibtisch und einem Schrank nur noch ein Futonbett."
                            },
                            {
                                "example_id": "ea9d1e62-3cc2-4fb4-ac82-bb857d7d9fe8",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "Das Futonbett ist das am häufigsten verwendete Bett überhaupt."
                            },
                            {
                                "example_id": "42050ed7-3461-4677-8f2d-212279f3656d",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Über seinem Futonbett mit den vielen Kissen drehte sich ein Planetenmobile, das er vor Jahren in der Schule gebastelt hatte.“"
                            },
                            {
                                "example_id": "ff2d3dc0-aa33-4405-86fb-277c8dc6c70d",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Mit einem Gähnen schwang ich mich von meinem Futonbett, zog die Vorhänge beiseite und erhaschte einen Blick auf den sattgrünen Garten vor dem Haus.“"
                            },
                            {
                                "example_id": "cd1e365b-7772-460f-b2b2-b21a3f909988",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Dort gibt's zwei Mahlzeiten und ein Futonbett ab etwa 8000 ¥ pro Person; teilweise wird auch einfaches Mittagessen zubereitet.“"
                            },
                            {
                                "example_id": "8f5e5590-60b8-42a5-826a-bab492549830",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Ein Zimmer im Obergeschoss verfügt über ein Futonbett und Sitzbänke, die sich als Klappsofa entpuppen (was besonders ideal für junge Familien ist).“"
                            },
                            {
                                "example_id": "665ba763-3faf-4090-8658-4bbc0fa219a8",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Das Futonbett war mit schwarzen Bettlaken bezogen, die Bettdecken und Kissen waren wieder in Zebra-Optik gehalten.“"
                            },
                            {
                                "example_id": "e670cf91-005c-4d7d-8d09-623d941441f6",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Und da sein Futonbett zu niedrig ist, um einen Koffer darunterzuschieben, wird er wohl den Platz auf dem Schrank genutzt haben.“"
                            },
                            {
                                "example_id": "1da830a7-8cba-4503-89fa-30a9e5f2e8ef",
                                "sense_id": "0abb3931-82c0-3572-87a8-b19766cdd13a",
                                "text": "„Das Bett, ein flaches Futonbett, ist mit meiner damaligen Lieblingsbettwäsche bezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4f11075-c1be-4e15-b68f-f6ed1687cf51",
                        "source_entry_id": "4e97bab7-5929-3b26-bb0d-9859033bf105",
