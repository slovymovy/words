{
    "word_family": [
        "slijm",
        "slijmen",
        "slijmbal",
        "slijmerd",
        "slijmerigheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71d5883a-e5ae-3771-be7a-2b4dd78a7b70",
                    "sense_definition": "bedekt of besmeurd met een plakkerige, vloeibare substantie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "textuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De visser hield de <w>slijmerige</w> vis stevig vast voordat hij hem terug in het water gooide.",
                            "target_lang_translations": {
                                "en": "The fisherman held the <w>slimy</w> fish firmly before throwing it back into the water."
                            }
                        },
                        {
                            "text": "Na de regenbui zaten er overal <w>slijmerige</w> sporen van slakken op het tuinpad.",
                            "target_lang_translations": {
                                "en": "After the rain shower, there were <w>slimy</w> snail trails everywhere on the garden path."
                            }
                        }
                    ],
                    "synonyms": [
                        "glibberig",
                        "viskeus"
                    ],
                    "antonyms": [
                        "droog"
                    ],
                    "common_phrases": [
                        "slijmerige sporen",
                        "slijmerige substantie"
                    ],
                    "target_lang_definitions": {
                        "en": "covered or smeared with a sticky, liquid substance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slimy",
                                "target_lang_sense_clarification": "covered in slime or mucus"
                            },
                            {
                                "target_lang_word": "slippery",
                                "target_lang_sense_clarification": "difficult to hold because of a wet or oily surface"
                            },
                            {
                                "target_lang_word": "mucous",
                                "target_lang_sense_clarification": "relating to or covered with mucus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6ca2c7a-6ea1-3a7c-940e-3d66fd2bc31f",
                    "sense_definition": "op een overdreven en onoprechte manier vriendelijk of vleiend om iets te bereiken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vertrouw die <w>slijmerige</w> verkoper niet, want hij geeft me te veel complimentjes.",
                            "target_lang_translations": {
                                "en": "I don't trust that <w>slimy</w> salesman because he gives me too many compliments."
                            }
                        },
                        {
                            "text": "Met zijn <w>slijmerige</w> gedrag probeert hij bij de directeur in een goed blaadje te komen.",
                            "target_lang_translations": {
                                "en": "With his <w>smarmy</w> behavior, he is trying to get into the director's good books."
                            }
                        }
                    ],
                    "synonyms": [
                        "vleiend",
                        "onderdanig",
                        "stroperig"
                    ],
                    "antonyms": [
                        "oprecht",
                        "kortaf"
                    ],
                    "common_phrases": [
                        "slijmerig gedrag",
                        "slijmerige vent"
                    ],
                    "target_lang_definitions": {
                        "en": "friendly or flattering in an exaggerated and insincere way to achieve something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slimy",
                                "target_lang_sense_clarification": "insincere and unpleasant in a way that suggests dishonesty"
                            },
                            {
                                "target_lang_word": "obsequious",
                                "target_lang_sense_clarification": "excessively obedient or attentive to an ingratiating degree"
                            },
                            {
                                "target_lang_word": "sycophantic",
                                "target_lang_sense_clarification": "behaving in an obsequious way in order to gain advantage"
                            },
                            {
                                "target_lang_word": "smarmy",
                                "target_lang_sense_clarification": "ingratiating and wheedling in a way that is perceived as insincere"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}