        "ru-extract.jsonl": [
            {
                "entry_id": "8883a2ed-e859-3fd3-8703-915609b889d9",
                "word": "форте",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c251640-bce1-3d90-99b5-46d4356c58f4",
                        "entry_id": "8883a2ed-e859-3fd3-8703-915609b889d9",
                        "glosses": [
                            "муз. громко, в полную силу звука"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3642bdd9-60c8-4667-892e-e5d7dfc2c861",
                                "sense_id": "1c251640-bce1-3d90-99b5-46d4356c58f4",
                                "text": "— Форте... форте! Напирайте! // И когда нужно петь fоrtе, жирное лицо регента выражает сильный испуг и даже ужас."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab4a46f5-7179-44eb-bcc6-02477b5fd75b",
                        "source_entry_id": "8883a2ed-e859-3fd3-8703-915609b889d9",
                        "source_sense_id": "1c251640-bce1-3d90-99b5-46d4356c58f4",
                        "target_lang_word": "forte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a988db5-730f-3a1b-8dfd-835a7e263ec3",
                                        "entry_id": "405b708a-f137-3c75-a99f-fa020b091ca4",
                                        "glosses": [
                                            "A strength or talent; a strong point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d4e7945-93db-48e0-b5a9-ed1f6ac51c15",
                                                "sense_id": "4a988db5-730f-3a1b-8dfd-835a7e263ec3",
                                                "text": "He writes respectably, but poetry is not his forte."
                                            },
                                            {
                                                "example_id": "6fe1db3f-193f-4a33-81f3-fef360f796be",
                                                "sense_id": "4a988db5-730f-3a1b-8dfd-835a7e263ec3",
                                                "text": "Between ourselves, the country is rather triste, and you have given me positively a sensation; yet my forte is not the Arcadian: however, I will do my petit possible to console you for the loss of le beau Lindor, who was my predecessor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04e5e0f3-ef7d-38ff-8f5d-d413290f230d",
                                        "entry_id": "405b708a-f137-3c75-a99f-fa020b091ca4",
                                        "glosses": [
                                            "The strong part of a sword blade, close to the hilt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
