                        "entry_id": "256e93ad-902e-3faa-bee4-b6afa3d19e3c",
                        "glosses": [
                            "Resembling rope in appearance or texture, used especially of muscles that are thick or hard to the touch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49988c9-19f6-43d7-939b-c4a1fdd9257b",
                                "sense_id": "e5fa62e6-bfc8-31e8-8d17-f5a4474cff9f",
                                "text": "Myofascial Syndrome\nHence, myofascial pain is usually associated with a taut band, indicating a \"ropey\" thickening of muscle tissue."
                            }
                        ]
                    },
                    {
                        "sense_id": "939d01cf-8c35-31f0-840f-a84c5d5cc4b8",
                        "entry_id": "256e93ad-902e-3faa-bee4-b6afa3d19e3c",
                        "glosses": [
                            "Capable of forming rope-like or thread-like structures."
                        ],
                        "tags": [],
                        "examples": []
                    },
