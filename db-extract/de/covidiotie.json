                ],
                "senses": [
                    {
                        "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                        "entry_id": "4593b22c-47ec-3646-802e-9986dd2cee61",
                        "glosses": [
                            "Verhalten einer Gruppe von Menschen im Zusammenhang mit der Coronapandemie, das derjenige, der es so bezeichnet, ablehnt und nicht nachvollziehbar findet"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "65f453fd-335a-4be0-b5a2-efc09964b905",
                                "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                                "text": "„Wer es ausspricht, fordert damit unausgesprochen ein Ende der Diskussion, nach dem Motto: Mit Verschwörungstheoretikern, rechten Spinnern, Maskenverweigerern und Leugnern der Virus-Realität ist jeder Diskurs sinnlos; die einzig sinnvolle staatliche Antwort auf „Covidiotie“ können nur Versammlungs- und Demonstrationsverbote sein. Oder?“"
                            },
                            {
                                "example_id": "7709e4c0-7d65-448e-bdd6-52c10da2e3a7",
                                "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                                "text": "„Es ist vollkommen nachvollziehbar, dass der Schlüssel zur Bewältigung dieser Pandemie neben den medizinischen Möglichkeiten wie Behandlung und Impfung in der Kontaktreduktion liegt. Wer dies leugnet, ist tatsächlich der Covidiotie anheim gefallen.“"
                            },
                            {
                                "example_id": "08779b10-111a-481d-8190-95ecba3e8ecc",
                                "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                                "text": "„Skepsis ist dennoch nicht abgeschafft; nicht jede Kritik an Maßnahmen ist bereits Covidiotie oder Corona-Leugnung. Andererseits sollte die oberste Regel unseres Verhaltens doch die Rücksicht auf andere sein.“"
                            },
                            {
                                "example_id": "5788cbc2-4947-43a0-9ba2-10569c99b077",
                                "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                                "text": "„Was nicht vorbei ist: die Covidiotie der Regierung und die Quälerei der Bevölkerung, insbesondere der Kinder.“"
                            },
                            {
                                "example_id": "fc661385-44d5-4d6e-bc52-c5a5336b8776",
                                "sense_id": "83e5106b-1c33-37da-9e85-72783373c006",
                                "text": "„Soweit das möglich ist, werde ich im Haus bleiben. Ich setze darauf, dass wir statt der zahlreichen Covidiotien die Chance für eine \"Diskussionsorgie\" bekommen, wie Angela Merkel das in Deutschland genannt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
