                ],
                "senses": [
                    {
                        "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                        "entry_id": "74ac493b-265f-33ad-a68e-0fbebdc78530",
                        "glosses": [
                            "der sich zuerst über etwas Äußernde"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "5f8aaa80-9313-4cc7-84c4-d70948863fa8",
                                "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                                "text": "„Erstberichterstatter und Mitberichte haben sich weder über den Inhalt ihrer Referate und ihrer Leitsätze verständigt, noch eine stoffliche Aufteilung verabredet.“"
                            },
                            {
                                "example_id": "e3548682-4799-4ef5-993b-f6e3520949c2",
                                "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                                "text": "„Der Erstberichterstatter Ernst Friesenhahn nahm sich dieser Themen besonders an.“"
                            },
                            {
                                "example_id": "7fb8081f-afe3-4988-85ac-4832ca49f8a2",
                                "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                                "text": "„Hofmann ging stärker als der Erstberichterstatter auf die verfassungs-, begriffs- und theoriegeschichtliche Entwicklung der Grundpflichten ein.“"
                            },
                            {
                                "example_id": "3c30b8aa-b510-4694-b9c4-d919042d102e",
                                "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                                "text": "„Bald zeigte sich jedoch, daß die Erstberichterstatter die Begebenheiten auf der Tagung weit übertrieben oder schlicht falsch gedeutet hatten.“"
                            },
                            {
                                "example_id": "1a4b6678-f44b-438e-92d1-42e9c68b761f",
                                "sense_id": "43c777c1-416d-3c24-8a5c-227756d1bc75",
                                "text": "„Dies zeigt, daß Hermodor in seinem Referat nicht nur inhaltlich andere Akzente setzt, sondern auch andere Termini für die Prinzipien Platons verwendet und damit als Erstberichterstatter nicht in Frage kommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                        "entry_id": "74ac493b-265f-33ad-a68e-0fbebdc78530",
                        "glosses": [
                            "Hauptbegutachter einer Dissertation"
                        ],
                        "tags": [
                            "Germany",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "e48f4d26-6883-4e2d-9fab-5c7a392c164c",
                                "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                                "text": "„Die Erstberichterstatterin beziehungsweise der Erstberichterstatter ist in der Regel Mitglied des Prüfungsausschusses; sie beziehungsweise er kann ihm auch dann angehören, wenn keine Mitgliedschaft bei der Fakultät mehr besteht.“"
                            },
                            {
                                "example_id": "d06ba4e9-843d-4623-8065-4974f54db483",
                                "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                                "text": "„Vor dem endgültigen Druck der Dissertation beziehungsweise des Auszuges gemäß Abs. 4 Satz 1 Buchst. b ist die letzte Druckprobe samt dem Manuskript dem Erstberichterstatter vorzulegen.“"
                            },
                            {
                                "example_id": "b99939ec-1f61-46c4-b234-425120cdda6d",
                                "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                                "text": "„Die Betreuerin beziehungsweise der Betreuer fungiert dabei als Erstberichterstatter/in.“"
                            },
                            {
                                "example_id": "3cd18366-b927-45c2-b679-b7f99241f801",
                                "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                                "text": "„So die konzise Darstellung des Themas durch den Erstberichterstatter Dölle, der die Dissertation als ‚talentvolle, anregende Arbeit‘ lobte.“"
                            },
                            {
                                "example_id": "ab7d26c2-8299-4da9-a653-28f1556cb93b",
                                "sense_id": "61ce217f-30d2-3e5d-9522-3d8e379e0663",
                                "text": "„Erstberichterstatter ist in diesen Fällen durchweg ein Universitätsprofessor.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
