                        "glosses": [
                            "Qui déteste ou qui a peur des champignons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e63f28-0958-44c1-9b7c-8a38275679f1",
                                "sense_id": "d741489a-3ec2-3704-ade1-a05c71dba98e",
                                "text": "Leur livre se propose de diviser l’humanité en deux camps : d’un côté, les peuples « mycophobes », qui abhorrent les champignons, comme les Anglo-Saxons ; de l’autre, les « mycophiles », qui les adorent, comme les Slaves."
                            }
                        ]
