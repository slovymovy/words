                                        "entry_id": "f9bd6e3c-f6b8-3753-8346-1f4d8b36c3e1",
                                        "glosses": [
                                            "proprietà di alcuni materiali di assumere resistenza nulla al passaggio di corrente elettrica se si trovano al di sotto di una certa temperatura critica"
                                        ],
