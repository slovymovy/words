                        ],
                        "examples": [
                            {
                                "example_id": "9ab2a73d-a6bd-418d-945e-896ec83a617b",
                                "sense_id": "90538b6e-38fc-3618-bbc6-8677712edad5",
                                "text": "Der arabische Scimitar oder „Krummsäbel“ oder der chinesische Dao sind einschneidig und gebogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "caa6289c-dace-369e-830d-2e5e4ec2898c",
                        "entry_id": "b7e37b58-a951-3f5e-a9d5-73a3b4b90090",
                        "glosses": [
                            "Lungenvenenfehlmündung"
                        ],
                        "tags": [
                            "kurz"
                        ],
                        "examples": [
                            {
                                "example_id": "84c47002-89d9-41fd-9c8a-0fa22fd4067a",
                                "sense_id": "caa6289c-dace-369e-830d-2e5e4ec2898c",
                                "text": "Das Scimitar Syndrom ist eine seltene Form einer partiellen Fehlmündung der rechten Lungenvene in das rechte Atrium des Herzens oder in die Zuflüsse ins rechte Atrium."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f3867e82-7f53-3c43-8a71-7a44eec9953a",
                        "entry_id": "b7e37b58-a951-3f5e-a9d5-73a3b4b90090",
                        "glosses": [
                            "Gattung der ausgestorbenen Säbelzahnkatzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cce1370-c420-46cf-906e-3bf4e2fc4d06",
                                "sense_id": "f3867e82-7f53-3c43-8a71-7a44eec9953a",
                                "text": "Diese auch als Scimitar-Cat – Dolchkatze - bezeichnete Art hatte um die zehn Zentimeter lange, gekrümmte und mit messerscharfen Zacken besetzte Eckzähne."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
