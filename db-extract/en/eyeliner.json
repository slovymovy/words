                                            {
                                                "example_id": "0bf0505b-299e-4e42-ba17-1202b0637629",
                                                "sense_id": "e016fdc6-d4fc-362e-805e-d7584c9c29b2",
                                                "text": "Le tableau qui suit montre l’évolution de chaque type de bateau (chalutier, crevettier, ligneur, thonier), entre 1993 et 1997."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92ed90bc-8756-3170-850c-c4f73cf604da",
                                        "entry_id": "058372c6-15b1-38fd-bf9f-06c3c9c932b0",
                                        "glosses": [
                                            "Crayon destiné à souligner le contour des yeux."
