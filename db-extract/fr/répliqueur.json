                        "examples": [
                            {
                                "example_id": "069cea11-6047-437e-ad79-7088a2da04d4",
                                "sense_id": "914e5c08-83d2-3351-9cfa-b73c1bfe4326",
                                "text": "Elsa est une grande répliqueuse dans l’âme : elle veut toujours avoir le dernier mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "befdadfc-5b64-3433-adca-236f7ca61633",
                        "entry_id": "238853ea-b93e-345f-ab9b-f9ac5d3b3453",
                        "glosses": [
                            "Machine qui réplique quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31c244c-2dce-4cb2-85f6-3d6b432c2948",
                                "sense_id": "befdadfc-5b64-3433-adca-236f7ca61633",
                                "text": "Un répliqueur de mémoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed3e8f91-b4b0-36b3-833b-6402b6e85060",
                        "entry_id": "238853ea-b93e-345f-ab9b-f9ac5d3b3453",
                        "glosses": [
                            "Entreprise qui fait des répliques de véhicules historiques ou hors de production."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aebc05f-8e34-4a28-b1ea-2b8be08f6c27",
                                "sense_id": "ed3e8f91-b4b0-36b3-833b-6402b6e85060",
                                "text": "PGO est un répliqueur qui jette son dévolu et sa passion sur la Cobra et la Porsche 356 Speedster, rendue célèbre par James Dean."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c25b7e7b-5047-4219-ba5a-6fdbf30b154d",
                        "source_entry_id": "238853ea-b93e-345f-ab9b-f9ac5d3b3453",
