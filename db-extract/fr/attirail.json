                                "target_senses": [
                                    {
                                        "sense_id": "d1f92f2b-1ab8-3ff2-9207-cc85a13203be",
                                        "entry_id": "2cb58343-11ec-38a6-9a64-5632c3827594",
                                        "glosses": [
                                            "amontoado de coisas desconexas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2572b5d3-d13c-490a-80e0-8bfc6c208278",
                                                "sense_id": "d1f92f2b-1ab8-3ff2-9207-cc85a13203be",
                                                "text": "Com a parafernália dos equipamentos moderníssimos de comunicação, as férias mudaram."
                                            }
                                        ]
