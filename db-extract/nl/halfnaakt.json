                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d6b7fc-0743-42e1-930a-3e6878b682d8",
                                "sense_id": "04ca29b8-82ba-3ce5-92af-fd9f07cd83d1",
                                "text": "Khadija (32), moeder van vier kinderen, maatschappelijk werkster zonder betaalde baan, draagt een donkerblauwe boerka. Alleen haar ogen zijn zichtbaar. Voor haar zou het ook als pesten voelen als ze zich niet meer zou mogen kleden als zij wil. „Ik begrijp het niet”, zegt ze. „Vrouwen mogen toch ook halfnaakt lopen? Wie doe ik er kwaad mee? Soms zou ik mensen wel willen toeschreeuwen: weet je wel hoe aardig ik ben?”"
                            }
                        ]
                    }
