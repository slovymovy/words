{
    "word_family": [
        "retrigger",
        "trigger-happy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ff257a6-d7f7-3907-a549-6b77164dea7a",
                    "sense_definition": "A small lever on a gun that is pulled by the finger to fire it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier kept his finger on the <w>trigger</w> while watching the door.",
                            "target_lang_translations": {
                                "ru": "Солдат держал палец на <w>спусковом крючке</w>, наблюдая за дверью.",
                                "zh": "士兵盯着门口时，手指一直放在<w>扳机</w>上。"
                            }
                        },
                        {
                            "text": "He aimed carefully at the target and slowly pulled the <w>trigger</w>.",
                            "target_lang_translations": {
                                "ru": "Он тщательно прицелился в мишень и медленно нажал на <w>спусковой крючок</w>.",
                                "zh": "他仔细瞄准目标，慢慢扣动了<w>扳机</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pull the trigger",
                        "squeeze the trigger",
                        "finger on the trigger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой рычаг на оружии, на который нажимают пальцем для выстрела.",
                        "zh": "枪械上用手指扣动以进行射击的小杠杆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спусковой крючок",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "курок",
                                "target_lang_sense_clarification": "разговорное, часто употребляемое"
                            },
                            {
                                "target_lang_word": "спуск",
                                "target_lang_sense_clarification": "краткая форма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扳机",
                                "target_lang_sense_clarification": "枪械部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f44f3c4-ac4f-3298-b75c-bf43bb24056a",
                    "sense_definition": "An event or situation that causes something else to start or happen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stress is often a major <w>trigger</w> for severe headaches.",
                            "target_lang_translations": {
                                "ru": "Стресс часто является главным <w>триггером</w> сильных головных болей.",
                                "zh": "压力往往是导致严重头痛的主要<w>诱因</w>。"
                            }
                        },
                        {
                            "text": "The court ruling was the <w>trigger</w> for protests across the country.",
                            "target_lang_translations": {
                                "ru": "Решение суда стало <w>толчком</w> для протестов по всей стране.",
                                "zh": "法院的裁决成为了全国抗议活动的<w>导火索</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cause"
                    ],
                    "common_phrases": [
                        "trigger for",
                        "main trigger",
                        "common trigger"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие или ситуация, которые вызывают начало чего-либо другого.",
                        "zh": "导致某事发生或开始的事件或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "побуждение к действию"
                            },
                            {
                                "target_lang_word": "триггер",
                                "target_lang_sense_clarification": "пусковой механизм"
                            },
                            {
                                "target_lang_word": "импульс",
                                "target_lang_sense_clarification": "стимул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱因",
                                "target_lang_sense_clarification": "导致结果的原因"
                            },
                            {
                                "target_lang_word": "导火索",
                                "target_lang_sense_clarification": "引发事态的起因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dd16a9e-07db-3a20-b7bb-f086e2ee9e0e",
                    "sense_definition": "A stimulus, such as a smell or sound, that causes a person to relive a past trauma or feel strong distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loud noises can be a <w>trigger</w> for veterans suffering from PTSD.",
                            "target_lang_translations": {
                                "ru": "Громкие звуки могут стать <w>триггером</w> для ветеранов, страдающих от ПТСР.",
                                "zh": "巨大的噪音可能会成为患有创伤后应激障碍的退伍军人的<w>触发点</w>。"
                            }
                        },
                        {
                            "text": "She learned to identify every emotional <w>trigger</w> that caused her panic attacks.",
                            "target_lang_translations": {
                                "ru": "Она научилась определять каждый эмоциональный <w>триггер</w>, вызывавший у неё панические атаки.",
                                "zh": "她学会了识别每一个导致她恐慌发作的情绪<w>触发点</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional trigger",
                        "trigger warning"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in psychology or internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражитель (звук, запах), вызывающий переживание прошлой травмы или сильный стресс.",
                        "zh": "一种刺激（如气味或声音），会使人重温过去的创伤或感到强烈的痛苦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триггер",
                                "target_lang_sense_clarification": "психология"
                            },
                            {
                                "target_lang_word": "раздражитель",
                                "target_lang_sense_clarification": "внешний стимул"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触发点",
                                "target_lang_sense_clarification": "心理学用语"
                            },
                            {
                                "target_lang_word": "刺激源",
                                "target_lang_sense_clarification": "引起心理反应的因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2233ce60-1c28-3038-9705-df601e5cf289",
                    "sense_definition": "A procedure in a database that automatically executes when a specific action, like an update or insertion, occurs.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The database administrator set up a <w>trigger</w> to log all changes to the user table.",
                            "target_lang_translations": {
                                "ru": "Администратор базы данных настроил <w>триггер</w> для регистрации всех изменений в таблице пользователей.",
                                "zh": "数据库管理员设置了一个<w>触发器</w>，用于记录用户表的所有更改。"
                            }
                        },
                        {
                            "text": "This <w>trigger</w> ensures that data integrity is maintained after every deletion.",
                            "target_lang_translations": {
                                "ru": "Этот <w>триггер</w> обеспечивает целостность данных после каждого удаления.",
                                "zh": "这个<w>触发器</w>确保了每次删除操作后数据完整性都能得到维护。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процедура в базе данных, автоматически выполняемая при определенном действии.",
                        "zh": "数据库中在特定操作（如更新或插入）发生时自动执行的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "триггер",
                                "target_lang_sense_clarification": "базы данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触发器",
                                "target_lang_sense_clarification": "数据库技术"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9511d3df-8494-32e6-ba9e-02738fcdab04",
                    "sense_definition": "To make something happen suddenly or cause a process to start.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain <w>triggered</w> a massive landslide in the valley.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь <w>спровоцировал</w> мощный оползень в долине.",
                                "zh": "大雨在山谷中<w>引发</w>了大规模的山体滑坡。"
                            }
                        },
                        {
                            "text": "His controversial remarks <w>triggered</w> a fierce debate among the audience.",
                            "target_lang_translations": {
                                "ru": "Его спорные замечания <w>вызвали</w> ожесточенные споры среди аудитории.",
                                "zh": "他充满争议的言论在观众中<w>引发</w>了激烈的辩论。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cause",
                        "precipitate",
                        "initiate",
                        "set off"
                    ],
                    "common_phrases": [
                        "trigger a reaction",
                        "trigger a crisis",
                        "trigger an alarm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать что-то внезапно или запустить процесс.",
                        "zh": "使某事突然发生或启动某个过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спровоцировать",
                                "target_lang_sense_clarification": "вызвать реакцию"
                            },
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "стать причиной"
                            },
                            {
                                "target_lang_word": "запустить",
                                "target_lang_sense_clarification": "начать процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引发",
                                "target_lang_sense_clarification": "导致发生"
                            },
                            {
                                "target_lang_word": "触发",
                                "target_lang_sense_clarification": "启动过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c042194c-da0e-3000-8723-e40b3a44c902",
                    "sense_definition": "To activate a device or system, or to become active.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoke from the kitchen <w>triggered</w> the fire alarm immediately.",
                            "target_lang_translations": {
                                "ru": "Дым с кухни немедленно <w>активировал</w> пожарную сигнализацию.",
                                "zh": "厨房冒出的烟雾立刻<w>触发</w>了火灾警报。"
                            }
                        },
                        {
                            "text": "The security camera <w>triggers</w> whenever it detects movement.",
                            "target_lang_translations": {
                                "ru": "Камера наблюдения <w>срабатывает</w> всякий раз, когда обнаруживает движение.",
                                "zh": "监控摄像头只要检测到移动就会<w>触发</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "activate",
                        "set off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести устройство или систему в действие или сработать.",
                        "zh": "启动设备或系统，或使其进入工作状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сработать",
                                "target_lang_sense_clarification": "об устройстве"
                            },
                            {
                                "target_lang_word": "активировать",
                                "target_lang_sense_clarification": "включить"
                            },
                            {
                                "target_lang_word": "привести в действие",
                                "target_lang_sense_clarification": "механизм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触发",
                                "target_lang_sense_clarification": "使装置工作"
                            },
                            {
                                "target_lang_word": "启动",
                                "target_lang_sense_clarification": "使系统运行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37517c02-8af1-34a7-8db3-2832bf8b9695",
                    "sense_definition": "To cause a strong negative emotional reaction in someone, often by reminding them of past trauma.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Violent scenes in movies can <w>trigger</w> painful memories for some viewers.",
                            "target_lang_translations": {
                                "ru": "Сцены насилия в фильмах могут <w>спровоцировать</w> болезненные воспоминания у некоторых зрителей.",
                                "zh": "电影中的暴力场景可能会<w>触动</w>一些观众痛苦的回忆。"
                            }
                        },
                        {
                            "text": "He gets <w>triggered</w> easily when people talk about politics.",
                            "target_lang_translations": {
                                "ru": "Он легко <w>заводится</w>, когда люди говорят о политике.",
                                "zh": "当人们谈论政治时，他很容易被<w>触动</w>情绪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "push someone's buttons"
                    ],
                    "common_phrases": [
                        "get triggered",
                        "easily triggered"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызвать сильную негативную эмоциональную реакцию, часто напоминая о травме.",
                        "zh": "引起某人强烈的负面情绪反应，通常是因为勾起了过去的创伤回忆。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задеть",
                                "target_lang_sense_clarification": "за живое"
                            },
                            {
                                "target_lang_word": "спровоцировать",
                                "target_lang_sense_clarification": "эмоционально"
                            },
                            {
                                "target_lang_word": "триггерить",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触动",
                                "target_lang_sense_clarification": "引起情绪波动"
                            },
                            {
                                "target_lang_word": "刺激",
                                "target_lang_sense_clarification": "引起负面反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e8b7815-7ca0-3c0e-b65f-67ccaaa9cbd5",
                    "sense_definition": "To detonate an explosive device or fire a weapon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spies used a mobile phone signal to <w>trigger</w> the bomb.",
                            "target_lang_translations": {
                                "ru": "Шпионы использовали сигнал мобильного телефона, чтобы <w>привести в действие</w> бомбу.",
                                "zh": "间谍们利用手机信号<w>引爆</w>了炸弹。"
                            }
                        },
                        {
                            "text": "A remote control was used to <w>trigger</w> the explosion from a safe distance.",
                            "target_lang_translations": {
                                "ru": "Пульт дистанционного управления использовался, чтобы <w>инициировать</w> взрыв с безопасного расстояния.",
                                "zh": "人们使用遥控器在安全距离外<w>引爆</w>了炸药。"
                            }
                        }
                    ],
                    "synonyms": [
                        "detonate",
                        "fire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести в действие взрывное устройство или выстрелить из оружия.",
                        "zh": "引爆爆炸装置或开火。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привести в действие",
                                "target_lang_sense_clarification": "бомбу"
                            },
                            {
                                "target_lang_word": "подорвать",
                                "target_lang_sense_clarification": "взорвать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "引爆",
                                "target_lang_sense_clarification": "使爆炸"
                            },
                            {
                                "target_lang_word": "触发",
                                "target_lang_sense_clarification": "启动装置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}