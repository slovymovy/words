                                                "example_id": "cd38435d-5a84-4d74-ae0e-fd41ffdfe06b",
                                                "sense_id": "372173ed-0c08-3d5a-b8d0-78ae3a22744b",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            },
                                            {
                                                "example_id": "e50b9364-825d-4e66-8bbe-7d73a7526098",
                                                "sense_id": "372173ed-0c08-3d5a-b8d0-78ae3a22744b",
                                                "text": "„Leonardo beobachtete die Vögel bei ihrer Technik, mit weit ausgebreiteten Flügeln langsam abzusinken und entwarf einen Fallschirm in Form einer viereckigen Pyramide, […].“"
                                            },
                                            {
                                                "example_id": "3ed4120b-d936-4f93-9cf6-651953953af5",
                                                "sense_id": "372173ed-0c08-3d5a-b8d0-78ae3a22744b",
                                                "text": "„Die Wale verfügen über eine Technik, ihre Lunge fast vollständig zu entleeren und sie kollabieren zu lassen.“"
                                            },
                                            {
                                                "example_id": "9bb99930-e688-4fc3-838d-e4846128dd9a",
                                                "sense_id": "372173ed-0c08-3d5a-b8d0-78ae3a22744b",
                                                "text": "„Das entspricht haargenau der Technik des modernen Sachbuchs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e6d59023-e02b-357a-8983-136f7de11681",
                                        "entry_id": "7b440782-50ba-32ee-8dff-8718e22b18d4",
                                        "glosses": [
                                            "ohne Plural:"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7657ad35-0770-3b0b-a705-fdcb9b2f4f12",
                                        "entry_id": "7b440782-50ba-32ee-8dff-8718e22b18d4",
                                        "glosses": [
                                            "Gesamtheit aller Mittel, um die Erkenntnisse der Naturwissenschaften für den Menschen nutzbar zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50b571e-cc1b-4b0e-8d0c-2267071f3873",
                                                "sense_id": "7657ad35-0770-3b0b-a705-fdcb9b2f4f12",
                                                "text": "Die Technik ist Bestandteil des Fortschritts."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e533d838-4ad3-3807-a2a8-825dcb6c4346",
                                        "entry_id": "7b440782-50ba-32ee-8dff-8718e22b18d4",
                                        "glosses": [
                                            "technische Gerätschaften für die Produktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387efbf0-d2aa-4605-859f-48c8c2700490",
                                                "sense_id": "e533d838-4ad3-3807-a2a8-825dcb6c4346",
                                                "text": "In der Abfüllhalle steht neueste Technik."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0bd3d30f-eb78-340d-a96e-3de8aa964c38",
                                        "entry_id": "7b440782-50ba-32ee-8dff-8718e22b18d4",
                                        "glosses": [
                                            "technischer Aufbau eines Geräts oder einer Maschine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5edba6b-a250-4b6c-b864-7ddde3519b94",
                                                "sense_id": "0bd3d30f-eb78-340d-a96e-3de8aa964c38",
                                                "text": "Die Technik dieses Geräts ist kompliziert."
                                            },
                                            {
                                                "example_id": "d24967ae-13f5-4b25-a1e4-706c6b6418e2",
                                                "sense_id": "0bd3d30f-eb78-340d-a96e-3de8aa964c38",
                                                "text": "„Apple hatte die Technik, bei der die Ohrhörer per Funk und nicht per Kabel miteinander verbunden sind, mit seinen Kopfhörern massentauglich gemacht und zu einem Milliardengeschäft ausgebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2d0546ba-db74-34ca-9c3a-974e204c823a",
                                        "entry_id": "7b440782-50ba-32ee-8dff-8718e22b18d4",
                                        "glosses": [
                                            "Gruppe von Technikern, die zusammen arbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "007b7d3c-e4fb-45ec-a0ba-7e36b0042e14",
                                                "sense_id": "2d0546ba-db74-34ca-9c3a-974e204c823a",
                                                "text": "Da müssen wir wohl die Technik holen."
                                            },
                                            {
                                                "example_id": "7d0fad7c-43e6-4f8a-a5d9-c0fc1d568c28",
                                                "sense_id": "2d0546ba-db74-34ca-9c3a-974e204c823a",
                                                "text": "Ich muss jetzt mal die Technik rufen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
