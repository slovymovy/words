                        "entry_id": "71561256-200b-3cab-9e7e-7f59de0f5cf4",
                        "glosses": [
                            "van elektromagnetische straling, net buiten het gebied van het spectrum dat met het menselijk oog zichtbaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b494b08-4537-43c2-9fd6-476e7778236e",
                                "sense_id": "c4a44f7a-50a3-3e18-9785-2759f695f04e",
                                "text": "De ozonlaag beschermt tegen de ultraviolette stralen van de zon."
                            }
                        ]
