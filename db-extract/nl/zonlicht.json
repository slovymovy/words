                "senses": [
                    {
                        "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                        "entry_id": "b2cf64a8-7794-30ca-9c5f-45683eccad47",
                        "glosses": [
                            "de zichtbare elektromagnetische straling van de ster waarrond onze aarde draait"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad973495-fe64-4eba-a5b1-148a9089eb1c",
                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                "text": "De vlaggen van de VOC-schepen hadden de neiging in het felle zonlicht van de tropen te verbleken."
                            },
                            {
                                "example_id": "787de8ca-31c6-48c8-89d9-97aed51f2021",
                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                "text": "De mannen dragen allemaal een rode sjerp over hun brede borstkas, en de kleur weerkaatst het winterse zonlicht als een serpentine van bloed."
                            },
                            {
                                "example_id": "43a7af04-c994-4cbf-b737-df98628745d8",
                                "sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                                "text": "Terwijl ze in de met zonlicht gevlekte schaduw staat, trekt het geluid van splinterend hout haar aandacht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61ccfea0-8a44-4a36-8616-525cabcfa01a",
                        "source_entry_id": "b2cf64a8-7794-30ca-9c5f-45683eccad47",
                        "source_sense_id": "06913118-09ac-306f-a8ae-2cf43367e3e1",
                        "source_sense_description": "de zichtbare elektromagnetische straling van de ster waarrond onze aarde draait",
                        "target_lang_word": "Sonnenlicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonnenlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                        "entry_id": "0691f35d-6f00-36a3-8c38-14b3130ab432",
                                        "glosses": [
                                            "von der Sonne ausgestrahltes Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f9a30f-d65a-4e91-8987-70c2ab3606c6",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "Schmetterlinge spielen im Sonnenlicht."
                                            },
                                            {
                                                "example_id": "9ebeea33-9baf-4b29-973e-0c5f9f2658eb",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "„Im grellen Sonnenlicht auf der Straße vor dem Geschäft wirkt alles wie ein absurder Traum, und wir schweigen.“"
                                            },
                                            {
                                                "example_id": "f809cfb0-dd90-48d3-aac7-89c1a7fe4b7f",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "„Auf der Anhöhe stand eine Gruppe kleiner Birken, und das Sonnenlicht spielte auf ihren seidigen Kätzchen.“"
                                            },
                                            {
                                                "example_id": "5a0a1291-55cf-4a53-b631-22c0e65edf32",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "„Das grelle Sonnenlicht wurde durch eine blasse Glühbirne und die Flamme des Seelenlichts ersetzt.“"
                                            },
                                            {
                                                "example_id": "d8508ea4-6fe2-4e77-94c5-a711e33212f9",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "„Lieber besuchte sie Orte, die im Sonnenlicht strahlten und von gesunder Energie strotzten.“"
                                            },
                                            {
                                                "example_id": "083f82e2-5bae-4c4e-9e96-666ad3911a7f",
                                                "sense_id": "8badc4d8-db25-37f5-bb93-ab1175b24f3c",
                                                "text": "„Das Sonnenlicht erfüllte das Zimmer mit einem Frieden, wie man ihn aus Zimmern der frühen Kindheit kennt – ein Sonnenlicht, das man später nur noch in Träumen findet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "602a3ce1-9315-4090-8e55-2ba311fbd512",
                        "source_entry_id": "b2cf64a8-7794-30ca-9c5f-45683eccad47",
