                        "examples": [
                            {
                                "example_id": "715f8551-e760-40c5-a1d5-85739ce25232",
                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                "text": "Die Konfirmandinnen besuchen regelmäßig den Konfirmationsunterricht und während der gesamten Konfirmandenzeit den Gottesdienst der Kirchengemeinde."
                            },
                            {
                                "example_id": "e1ce99ea-22aa-48a4-8d9c-c2a07ae28984",
                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                "text": "„Elses Brüder reisten zur Feier an, was bedeutete, dass Klaus in der Badewanne schlafen musste und die Konfirmandin unterm Tisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
