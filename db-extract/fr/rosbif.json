        "fr-extract.jsonl": [
            {
                "entry_id": "a31462ff-94a3-351c-9c41-ef4275a57314",
                "word": "rosbif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e0901908-929c-4773-8987-d65945896599",
                        "entry_id": "a31462ff-94a3-351c-9c41-ef4275a57314",
                        "tags": [
