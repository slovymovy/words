                        "examples": [
                            {
                                "example_id": "13abfa8a-2469-4684-9475-45c0880991a7",
                                "sense_id": "235937bc-4f47-3550-881d-1d37b53b6c8d",
                                "text": "Een kleine groep vertrok daarheen, onder leiding van Dom Tholens als superior en pater Van den Biesen als kellenaar (econoom). De oorlog doorkruiste echter de plannen voor een nieuw klooster."
                            },
                            {
                                "example_id": "99bd8d1b-35f6-44f7-b2d0-2d02bfd5b2a8",
                                "sense_id": "235937bc-4f47-3550-881d-1d37b53b6c8d",
                                "text": "(…) hij herstelde de oude stichting in het gewezen capucienen-klooster van Dendermonde, en smaakte de voldoening aldaar als monnik en als superior te sterven."
                            }
                        ]
