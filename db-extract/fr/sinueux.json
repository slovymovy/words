                        ]
                    },
                    {
                        "translation_id": "a650394a-a65b-4107-9fc7-08e005802acd",
                        "source_entry_id": "6fe3bfeb-63ad-3962-aa23-4a5a34470c47",
                        "target_lang_word": "kurvenreich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurvenreich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                        "entry_id": "d6616b15-7b6a-3b3b-a433-4f30c384197e",
                                        "glosses": [
                                            "viele Kurven (= Richtungswechsel) aufweisend"
                                        ],
                                        "tags": [
                                            "Verkehrswesen",
                                            "auf Straße bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09f96d6-7f99-4f8a-a399-92a7c2d68581",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "[Am Deutschen Eck, dem Zusammenfluss von Rhein und Mosel,] „startet der beliebte Mosel-Radweg entlang des kurvenreichen Verlaufs der Mosel.“"
                                            },
                                            {
                                                "example_id": "43ba6116-48cf-4e9f-a4e7-8a2da0ace7bf",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "Das kurvenreiche Flusstal mit dem sagenumwobenen Loreley-Felsen, seinen terrassierten Weinbergen, den malerischen Fachwerkstädten und den zahlreichen Burgen machen das Mittelrheintal zu einer einzigartigen Kulturlandschaft."
                                            },
                                            {
                                                "example_id": "84f9f321-2a93-43b2-8f69-948ce9dc7d43",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "„Überall im [Mississippi-]Delta wurden im vergangenen Jahrhundert gebaggert, um Schiffen den kurvenreichen Weg über den Mississippi zu ersparen,“ […]"
                                            },
                                            {
                                                "example_id": "73a94b1e-d193-4fef-baaf-a4626ccd0e2c",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "„Der Bachverlauf [des Mühlbachs] wird um bis zu 50 Meter verschoben und das neue Bachbett kurvenreicher geführt, als das bestehende. »Der Bach wird natürlicher sein als heute«, sagte Stadtpräsident Urs Marti auf Anfrage.“"
                                            },
                                            {
                                                "example_id": "c3886d0e-b04a-41f5-837e-d6982aeb389b",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "[…] „an der deutschen Grenze wird die High-Tech-Trasse“ [aus Brixen über Kufstein] „in die alte kurvenreiche Bahnstrecke Richtung Norden münden.“"
                                            },
                                            {
                                                "example_id": "3e729828-6b3f-465c-b55d-fb94aa62553d",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "„Die etwa 10 km durch die Darialischlucht (auch Darielschlucht / Darielpass genannt) vom Grenzübergang Dariali sind kurvenreich und atemberaubend.“"
                                            },
                                            {
                                                "example_id": "3935d470-bd17-4682-829a-7d0b4423cd13",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "„Zumindest war die Straße gepflastert, zwar schmal und kurvenreich, aber immerhin gepflastert. […]“"
                                            },
                                            {
                                                "example_id": "9897e083-8f7e-47df-add7-15e06ebf138f",
                                                "sense_id": "c822d590-c37f-39da-ba65-9ccd687f9551",
                                                "text": "[Motorradrennen:] „Tom Lüthi war auf der kurvenreichen Strecke in Austin als 19. einen Hauch schneller als der Italiener Franco Morbidelli“ […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "94c6e1f6-b763-36bf-a493-7282859d23a4",
                                        "entry_id": "d6616b15-7b6a-3b3b-a433-4f30c384197e",
                                        "glosses": [
                                            "große Brüste und einen ausgeprägten Po habend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9ed5a70-51fa-4b73-913b-dec4fbd24a13",
                                                "sense_id": "94c6e1f6-b763-36bf-a493-7282859d23a4",
                                                "text": "[Das Cover des neuen Playboy] „zeigt Model und Trans-Frau Giuliana Farfalla (21), die kurvenreich für den Fotografen des Männer-Magazins posiert.“"
                                            },
                                            {
                                                "example_id": "06015a5f-7506-4987-bc76-ae176b9d8d15",
                                                "sense_id": "94c6e1f6-b763-36bf-a493-7282859d23a4",
                                                "text": "[Schlagzeile:] „Mehr Hormone – Kurvenreiche Frauen sind fruchtbarer“"
                                            },
                                            {
                                                "example_id": "04d0236e-0d96-4b11-9908-1419a3493223",
                                                "sense_id": "94c6e1f6-b763-36bf-a493-7282859d23a4",
                                                "text": "„Lara Croft bediente [im Computerspiel] ‚Tomb Raider‘ das romantische Bild einer echten Amazone. Kämpferisch, unerschrocken, stark, hübsch - und extrem kurvenreich.“"
                                            },
                                            {
                                                "example_id": "42b38333-8d63-4b87-b21b-89685c3b5121",
                                                "sense_id": "94c6e1f6-b763-36bf-a493-7282859d23a4",
                                                "text": "[Natalie] „wiegt 49 Kilo, ihre Anatomie ist nicht sehr kurvenreich,“ […]"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2cf90c7b-e74b-4f41-91a1-01ef6e3f1579",
                        "source_entry_id": "6fe3bfeb-63ad-3962-aa23-4a5a34470c47",
                        "target_lang_word": "sinuous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinuous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Having curves in alternate directions; meandering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6dac33e-3a12-4cf6-9cd7-2cd96694f814",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "We followed every bend of the sinuous river."
                                            },
                                            {
                                                "example_id": "fbe0df2f-9b98-486c-b4f8-f342f203b44e",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "[W]hen a transverse, or, within certain limits, an oblique impulse, impinges laterally upon a continuous mountain range, two movements of vibration are communicated; the one, a wave transmitted along and in the line of the axis, the other a transverse wave, which causes the axial line to sway laterally, and transmit a quam prox. horizontal transverse wave, along from one end to the other; like the sinuous movement which travels along a long rope when, hanging suspended between two points at the same level, it is jerked suddenly at one end, transversely to its length."
                                            },
                                            {
                                                "example_id": "9f2e6131-1534-47c4-8a9e-50e5f89548ed",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "[A] peculiar luminous and sinuous marking appeared on the unillumined half of the inner planet, and almost simultaneously a faint dark mark of a similar sinuous character was detected upon a photograph of the Martian disc."
                                            },
                                            {
                                                "example_id": "5b5112fb-086a-4342-ada8-3dad8a69cc11",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "The way through the wood was shorter, but it was also sinuous. He missed his way, and, as a direct consequence, missed his train."
                                            },
                                            {
                                                "example_id": "d522a7df-7a28-497d-8b23-4ce62f35a001",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "My own apprehension rose again to a superlative pitch as we swept down from St. Neots at all but 110 m.p.h. towards those sinuous curves round the bank of the Ouse near Offord, and were almost on to them before we suddenly braked."
                                            },
                                            {
                                                "example_id": "18b07ee4-52cd-4291-a2a6-c4276ea0ef9d",
                                                "sense_id": "b59b8fe6-89d4-3f80-bdcf-aa6f7b61dc75",
                                                "text": "This is the perfect climbing tree: wrought by two centuries of good London living, its sinuous spread presents any number of routes into the canopy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Moving gracefully and in a supple manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c0af63-8a71-44c5-9184-1f9f2939a672",
                                                "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                                "text": "We were entranced by her sinuous dance."
                                            },
                                            {
                                                "example_id": "9be37e6d-e2e2-4d18-8ef7-93c718e26f85",
                                                "sense_id": "bf1e64d9-141a-3b3a-a560-45c2d985521c",
                                                "text": "Once a dark, clumsy tapir stared at us from a gap in the bushes, and then lumbered away through the forest; once, too, the yellow, sinuous form of a great puma whisked amid the brushwood, and its green, baleful eyes glared hatred at us over its tawny shoulder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa2afba3-340a-3cc8-ad82-3cead4b8abf8",
                                        "entry_id": "a3aed96e-a901-3a31-9a31-e7ecabc66e8d",
                                        "glosses": [
                                            "Morally crooked; shifty."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83b60e8a-bb2c-4ced-b5eb-f9da367aab74",
                                                "sense_id": "fa2afba3-340a-3cc8-ad82-3cead4b8abf8",
                                                "text": "On 16 December 1999, Lanny Davis, one of the President's more sinuous apologists, was asked on an MSNBC chat show to address the issue and replied that Ms. Broaddrick had been adjudged unreliable by the FBI."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
