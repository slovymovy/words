                                                "example_id": "c54a513c-1021-4b1a-990b-989ba9fa4db8",
                                                "sense_id": "9076f3d6-02fa-379f-ab44-b3b011b897fc",
                                                "text": "Die Arnika wurde früher bei vielen Leiden als Heilmittel eingesetzt."
                                            }
                                        ],
