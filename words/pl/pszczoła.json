                    "frequency": "Low",
                    "semantic_group_id": "owady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trzmiele to duże, włochate <w>pszczoły</w> szanowane za swoją pracowitość."
                        },
                        {
                            "text": "Wiele dzikich <w>pszczół</w> jest zagrożonych wyginięciem z powodu zmian klimatycznych."
