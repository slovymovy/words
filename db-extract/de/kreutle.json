                ],
                "senses": [
                    {
                        "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                        "entry_id": "df10eb21-f3eb-3a29-a2cd-cd751d86aad7",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f0dbf5-565c-4626-a157-533135b12067",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Frau Kreutle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1bc666e8-db87-4853-802b-839e2e4310d9",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Herr Kreutle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f252ff04-a089-40b1-af73-7148a1186a83",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Die Kreutles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0b2b404e-4c0e-43d4-b11a-5cf02ed5b6e6",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Der Kreutle trägt nie die Pullover, die die Kreutle ihm strickt."
                            },
                            {
                                "example_id": "611831f7-f19e-4597-b15c-62cc2c05e72e",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kreutle kommt, geht der Herr Kreutle.“"
                            },
                            {
                                "example_id": "5c00f574-0ba2-425f-96e2-f5f634a074c1",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Kreutle kommt und geht."
                            },
                            {
                                "example_id": "aca6738b-319d-48c7-a829-aff8d98ed967",
                                "sense_id": "9fbe1ca8-a587-3f4f-98b3-57a5fad4cbb1",
                                "text": "Kreutles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
