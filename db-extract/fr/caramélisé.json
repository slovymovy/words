                        "glosses": [
                            "Couvert de caramel ou transformé en caramel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74af31c2-6cbe-4bb3-9891-e6e58397c810",
                                "sense_id": "d01a1e47-2994-3946-86bf-8f23c8503a2f",
                                "text": "Si vous voulez du pop-corn caramélisé, saupoudrez les pop-corn d’environ un ½ verre de sucre et remuez sans arrêt, sur feu doux, jusqu’à ce que le pop-corn soit bien enrobé de caramel. Dégustez !"
                            },
                            {
                                "example_id": "9fb344ff-f8f7-487d-9637-86127c38834e",
                                "sense_id": "d01a1e47-2994-3946-86bf-8f23c8503a2f",
                                "text": "Le vinaigre de cidre, la moutarde et l’oignon caramélisé permettent d’obtenir un glaçage si savoureux que vous aurez du mal à croire qu’il n'y a pas de tomates."
                            }
                        ]
