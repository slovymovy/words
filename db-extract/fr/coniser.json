                "senses": [
                    {
                        "sense_id": "44b6e796-21b8-3621-9a1f-11fd1a48fc26",
                        "entry_id": "afb36643-e6d2-3b08-87c3-b8f64e7849b6",
                        "glosses": [
                            "Enlever un petit morceau, en forme de cône, du col de l’utérus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649215fb-6ad6-4155-9950-a5b4014c78ef",
                                "sense_id": "44b6e796-21b8-3621-9a1f-11fd1a48fc26",
                                "text": "Votre gynéco semble bien pressée de vous \"coniser\"."
                            },
                            {
                                "example_id": "6adb9d5d-49c5-4fdf-b118-521b6ff0b98c",
                                "sense_id": "44b6e796-21b8-3621-9a1f-11fd1a48fc26",
                                "text": "Parfois le col de l'utérus peut être touché et le médecin doit le « coniser », à savoir en retirer la partie affectée."
                            },
                            {
                                "example_id": "226b0a3d-941d-4d28-9315-dda372dd7a1c",
                                "sense_id": "44b6e796-21b8-3621-9a1f-11fd1a48fc26",
                                "text": "Je me fais donc coniser pour la première fois mercredi et j'ai très peur."
                            }
                        ]
                    }
