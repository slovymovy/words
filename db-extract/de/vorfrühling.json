                ],
                "senses": [
                    {
                        "sense_id": "992fcef9-7ee2-35a7-9be7-a66695133a67",
                        "entry_id": "a861bcdb-0a0c-3390-96e2-d3e6c4afa7d5",
                        "glosses": [
                            "Zeit, in der sich in Vegetation oder Wetter der Frühling ankündigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d43333a-b524-46a5-b710-6c2bf25b7f9d",
                                "sense_id": "992fcef9-7ee2-35a7-9be7-a66695133a67",
                                "text": "„Ich sehe durchs Scherenfernrohr, sehe die Schützengräben der Franzosen, dahinter Pont à Mousson, die zerschossene Stadt, die Mosel, die durch die Landschaft des Vorfrühlings weich und träge sich schlängelt.“"
                            },
                            {
                                "example_id": "e712bd34-f988-40d4-b78c-4360fb8af0b3",
                                "sense_id": "992fcef9-7ee2-35a7-9be7-a66695133a67",
                                "text": "„Aber im Vorfrühling von 1990 war der Straßenzustand in Mecklenburg-Vorpommern miserabel, und wir kamen nur langsam voran.“"
                            },
                            {
                                "example_id": "fed954ea-416c-4d88-a151-7a5d689a8097",
                                "sense_id": "992fcef9-7ee2-35a7-9be7-a66695133a67",
                                "text": "„Aber dieser Vorfrühling täuscht.“"
                            },
                            {
                                "example_id": "12191919-13fa-41fa-84d1-4f74306e5e46",
                                "sense_id": "992fcef9-7ee2-35a7-9be7-a66695133a67",
                                "text": "„Im Vorfrühling 1942 brach die Menschenjagd im Getto, bisher systematisch betrieben, plötzlich ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
