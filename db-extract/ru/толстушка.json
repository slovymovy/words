                                "target_senses": [
                                    {
                                        "sense_id": "17ea0caf-83e1-37aa-abe6-3dc5464d838b",
                                        "entry_id": "480d04c3-94a5-33d8-bf45-ee809d1a3081",
                                        "glosses": [
                                            "Containing, composed of, or consisting of fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f53b6f-2ce9-4fa8-be7a-f61624b53046",
                                                "sense_id": "17ea0caf-83e1-37aa-abe6-3dc5464d838b",
                                                "text": "fatty tissues"
                                            },
                                            {
                                                "example_id": "8b0a3abf-9212-47b8-9270-30d7bbb83167",
                                                "sense_id": "17ea0caf-83e1-37aa-abe6-3dc5464d838b",
                                                "text": "fatty meats"
                                            },
                                            {
                                                "example_id": "061b21b3-46ff-4247-ae80-c9513245a7c0",
                                                "sense_id": "17ea0caf-83e1-37aa-abe6-3dc5464d838b",
                                                "text": "Then in the case of excisions you have all kinds of secondary changes, pigmentary disturbances, modifications of the passions, alterations in the secretion of fatty tissue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de19bddb-7771-3eba-a242-6c27a15918f3",
                                        "entry_id": "480d04c3-94a5-33d8-bf45-ee809d1a3081",
                                        "glosses": [
                                            "Containing, composed of, or consisting of fat.",
                                            "Sometimes, especially, containing excess fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f227ed60-138b-47a3-90bb-0076197688ff",
                                                "sense_id": "de19bddb-7771-3eba-a242-6c27a15918f3",
                                                "text": "fatty liver"
                                            },
                                            {
                                                "example_id": "202b2934-0400-4f72-ac45-9c97e4c7b064",
                                                "sense_id": "de19bddb-7771-3eba-a242-6c27a15918f3",
                                                "text": "fatty pancreas"
                                            },
                                            {
                                                "example_id": "5931006a-3691-49c6-bc37-73c45ab490d7",
                                                "sense_id": "de19bddb-7771-3eba-a242-6c27a15918f3",
                                                "text": "That means eating fruits and vegetables and cutting back on fatty foods."
                                            },
                                            {
                                                "example_id": "06c70e2e-d002-4024-938f-fcfade832073",
                                                "sense_id": "de19bddb-7771-3eba-a242-6c27a15918f3",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1110a17e-dc27-356b-9e58-d5a449ee7d65",
                                        "entry_id": "480d04c3-94a5-33d8-bf45-ee809d1a3081",
                                        "glosses": [
                                            "Like fat; greasy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea65fa26-5e06-3567-b8c2-a0b8511a6a86",
                                        "entry_id": "480d04c3-94a5-33d8-bf45-ee809d1a3081",
                                        "glosses": [
                                            "Of or related to fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd57ae88-139a-4c40-b145-b4d2ced5ef18",
                                                "sense_id": "ea65fa26-5e06-3567-b8c2-a0b8511a6a86",
                                                "text": "fatty acid"
                                            },
                                            {
                                                "example_id": "e888a910-6b71-4aa2-85ff-99bad09e6d6c",
                                                "sense_id": "ea65fa26-5e06-3567-b8c2-a0b8511a6a86",
                                                "text": "fatty alcohol"
                                            },
                                            {
                                                "example_id": "e57d9f59-bfb1-493b-ad21-deda2d7fede2",
                                                "sense_id": "ea65fa26-5e06-3567-b8c2-a0b8511a6a86",
                                                "text": "1849, Hippocrates (Translated by Francis Bacon), Of the Epidemics, Book II, Section 1.\nOn the sixth, stools black, fatty, viscid, fetid; slept, more collected."
                                            },
                                            {
                                                "example_id": "9dce079f-78b1-47f8-bca5-49626b37e9cc",
                                                "sense_id": "ea65fa26-5e06-3567-b8c2-a0b8511a6a86",
                                                "text": "[…]which had a greasy and fatty surface like cold broth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603ddfb4-d05d-38b1-8ac0-506d8ca0a522",
                                        "entry_id": "480d04c3-94a5-33d8-bf45-ee809d1a3081",
                                        "glosses": [
                                            "Literally or figuratively large."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9beebf3-5f30-4ef7-9f90-131c0edeb2d7",
                                                "sense_id": "603ddfb4-d05d-38b1-8ac0-506d8ca0a522",
                                                "text": "Be careful of the taxi drivers out there though, I've heard they sell you drugs, drop you off at your hotel and then dob you in to the Thai Police to get a fatty reward!"
                                            },
                                            {
                                                "example_id": "b3ed8182-fe77-48b5-b201-160ede38d3cf",
                                                "sense_id": "603ddfb4-d05d-38b1-8ac0-506d8ca0a522",
                                                "text": "Instead of going my normal route (ordering the book through the store, checking it out in person, and then ordering it online so I could get a fatty discount) I impulsively bought the book."
                                            },
                                            {
                                                "example_id": "3aaced74-a35d-4abc-ba85-a8a15f41b133",
                                                "sense_id": "603ddfb4-d05d-38b1-8ac0-506d8ca0a522",
                                                "text": "I'm trying to get a fatty project done in a couple of hours right now."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fatty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14ca0027-818d-3947-8a60-40e50c17a93d",
                                        "entry_id": "bbdc22c8-80d9-3181-a0ad-21391c3be1b6",
                                        "glosses": [
                                            "An obese person."
                                        ],
