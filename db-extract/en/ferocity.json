                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                        "entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
                        "glosses": [
                            "The condition of being ferocious."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c4dd118e-df55-4fe8-9006-a102e4722ddd",
                                "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                                "text": "Near-synonyms: fierceness, furiousness, fury, vehemence, violence"
                            },
                            {
                                "example_id": "b38f2749-f5d7-4208-bfa6-3f65ce2074a6",
                                "sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                                "text": "Nearly a year later, in the month of October, 18—, London was startled by a crime of singular ferocity and rendered all the more notable by the high position of the victim."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15fac121-939f-45e3-a77d-c9ff5c7b1072",
                        "source_entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
                        "source_sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                        "source_sense_description": "The condition of being ferocious",
                        "target_lang_word": "acharnement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acharnement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Action d’un animal qui s’attache opiniâtrement à sa proie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253ecfcb-d547-4176-b895-e39274e0cbf9",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "L’acharnement d’un loup, d’un animal carnassier."
                                            },
                                            {
                                                "example_id": "e140f73f-f419-4e93-b687-46c7fa97198a",
                                                "sense_id": "630a1d56-8b5b-34ac-b904-db0f5e1b7608",
                                                "text": "Un jeune bouledogue, entre autres, se distinguait par son acharnement ; cramponné par les crocs à l’échine de l’ours, … il ne lâchait point."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Fureur opiniâtre avec laquelle des animaux, ou des hommes, se battent les uns contre les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fc9b02-d74a-46cc-8770-803f81e0d890",
                                                "sense_id": "0e1ff280-cdf6-3bd1-a6fc-f4f44e501122",
                                                "text": "L’acharnement de deux dogues l’un contre l’autre. - Ces deux animaux, ces deux hommes se sont battus avec acharnement. - On se battit avec acharnement durant tout le jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Animosité opiniâtre qu’on a contre quelqu’un."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ab0ecb-0cb3-4005-9a17-0fb848b29e4f",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Le même esprit d’acharnement contre les malheureux Espagnols semblait s’être emparé de tout le pays."
                                            },
                                            {
                                                "example_id": "7b8c4742-96d4-4528-9caf-5fa126d008b0",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Nulle part, l’école de Clermont n’a autant de détracteurs qu’à Clermont même et l’acharnement de ceux-ci n’est pas petit."
                                            },
                                            {
                                                "example_id": "b45d2ab7-eea1-4b66-bab4-30495d814189",
                                                "sense_id": "0b9b4cce-79b4-3f78-b5d6-064a1c6a4dfd",
                                                "text": "Deux d’entre elles sont héritées du passé: une assistance, le plus souvent impuissante, et l’euthanasie d’une part, l’acharnement thérapeutique et les soins palliatifs d’autre part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Opiniâtreté."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b295316-6928-4317-8f5a-ab679cb3b6fb",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                                            },
                                            {
                                                "example_id": "db76de56-3cd0-49c5-b4b4-6af9a0140fb5",
                                                "sense_id": "39e7b27f-99e2-3a07-bc38-59e20a1c0b82",
                                                "text": "Ces docteurs confondent, par un grossier sophisme, un idéal qui, en tant que non changeant, peut par pure métaphore être qualifié de mort, avec les hommes, les êtres charnels qui embrassent cet idéal, lesquels, en cet embrassement, peuvent être si peu morts qu’ils se battront avec acharnement pour le défendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee6bd241-372c-3a67-a2cb-421c26de074b",
                                        "entry_id": "ab7656fb-6e2f-3fa4-9ca4-a5f16b7c9e9b",
                                        "glosses": [
                                            "Éreintage."
                                        ],
                                        "tags": [
                                            "Relations internationales"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fad133af-430e-4784-8270-6560528209c5",
                        "source_entry_id": "aad2dfbe-393f-36b2-b684-f7740c9e02fb",
                        "source_sense_id": "d2d14bfa-3c67-3c8e-b988-2ad4e10fc18f",
                        "source_sense_description": "The condition of being ferocious",
                        "target_lang_word": "Grausamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grausamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                                        "entry_id": "cc812c6e-2059-3d70-99b5-28f450c1d5fc",
                                        "glosses": [
                                            "ein menschlicher Charakterzug, der durch die Neigung gekennzeichnet ist, ohne Skrupel, Zurückhaltung oder Reue zu zerstören, zu verletzen oder zu töten, und dadurch bei Mitmenschen Grauen hervorruft."
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09cc0d5d-372d-41b4-8005-14370bf1194e",
                                                "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                                                "text": "„Anderer Not geringachten ist Grausamkeit und findet sich bei denen, welche dergleichen nicht selbst fürchten zu müssen glauben; daß sich aber jemand über die Not anderer ohne alle Ursache freuen sollte, scheint mir fast unmöglich.“"
                                            },
                                            {
                                                "example_id": "b317ead4-e775-4cd4-be5f-48890fce9ae7",
                                                "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                                                "text": "„Coens menschenverachtende Grausamkeit gegenüber den indigenen Völkern wurde heftig angegriffen.“"
                                            },
                                            {
                                                "example_id": "098d9ed5-9679-4fca-9cdb-67e61fefc799",
                                                "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                                                "text": "„Für diese Art von Grausamkeit war sie zu geradlinig und viel zu gutherzig.“"
                                            },
                                            {
                                                "example_id": "1d615669-1335-47ca-aee0-fd8135f3d0fb",
                                                "sense_id": "e20b61b2-02da-33f5-a086-c0c1c30976e8",
                                                "text": "„Grausamkeit ist Luxus für Müßiggänger, wie Rauschgifte und seidene Hemden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                        "entry_id": "cc812c6e-2059-3d70-99b5-28f450c1d5fc",
                                        "glosses": [
                                            "eine Handlung, gekennzeichnet durch skrupelloses, gnadenloses und zerstörerisches Vorgehen, die Schrecken oder Grauen hervorruft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfec286-d5e7-4410-9062-ff3dd1484e7e",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "Die Grausamkeit gegen Tiere nimmt immer erschreckendere Maße an."
                                            },
                                            {
                                                "example_id": "c0612009-4f4f-4917-84af-01137a1d197e",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "Er hat diese Grausamkeiten angeordnet."
                                            },
                                            {
                                                "example_id": "2d8d9849-8622-4619-8866-4c90ddb47cbf",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "„Die Folgen der Grausamkeiten spürt Elisa bis heute, trotz jahrelanger Psychotherapie.“"
                                            },
                                            {
                                                "example_id": "7e9058a6-487c-4c6a-b962-e9188c03b72b",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "„Vor Jahren hatten sie sich in ein paar Fälle verbissen, die an Grausamkeit kaum zu überbieten waren.“"
                                            },
                                            {
                                                "example_id": "289e2055-f990-4120-b7c5-38e52d0ad7a8",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "„Die Amerikaner ließen Grausamkeiten wie in Prag oder im Ostsudetenland nicht zu.“"
                                            },
                                            {
                                                "example_id": "9e4837f1-0152-498f-838b-1ec7f2f3cdba",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "„Nur wer alle Grausamkeiten kennt, kann sie überleben.“"
                                            },
                                            {
                                                "example_id": "afebc04d-8adf-48d6-a03d-c3d66cbd694c",
                                                "sense_id": "306a739d-2311-3253-b7f2-a9417dc56c56",
                                                "text": "„Phallusautomaten sind neu für Juliette, vom Theater der Grausamkeiten ist sie hingerissen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
