                    "sense_definition": "Verhoogde tafel of balie in een café waar drankjes worden geschonken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bar_counter",
                    "name_type": "no",
                    "examples": [
