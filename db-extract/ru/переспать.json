                ],
                "senses": [
                    {
                        "sense_id": "25c563c3-e63f-3b7f-8c22-70a0e4d8790b",
                        "entry_id": "bd0058ed-d7aa-38f0-a208-78cab320f50a",
                        "glosses": [
                            "находиться долгое время в состоянии сна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd1ec4c6-d991-4512-9343-e976530b1e94",
                                "sense_id": "25c563c3-e63f-3b7f-8c22-70a0e4d8790b",
                                "text": "Ночь спал тревожно, с бредом, вероятно, потому, что переспал днем."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ae4fe6d-3b94-3268-a784-ec351983ebf8",
                        "entry_id": "bd0058ed-d7aa-38f0-a208-78cab320f50a",
                        "glosses": [
                            "провести где-нибудь ночь; переночевать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "747f4e04-acde-490a-910b-45dbdf7c7bdf",
                                "sense_id": "6ae4fe6d-3b94-3268-a784-ec351983ebf8",
                                "text": "Ночь в лагере под Троицкой крепостью переспали благополучно."
                            }
                        ]
                    },
                    {
                        "sense_id": "cebef739-9f5a-356c-ab22-f2b4a2c5fab3",
                        "entry_id": "bd0058ed-d7aa-38f0-a208-78cab320f50a",
                        "glosses": [
                            "переждать что-либо, находясь в состоянии сна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5dd6d3-90f4-4d4f-bbf9-afe84f05cf57",
                                "sense_id": "cebef739-9f5a-356c-ab22-f2b4a2c5fab3",
                                "text": "А теперь соснуть бы часок-другой… жару переспать!"
                            }
                        ]
                    },
                    {
                        "sense_id": "c387d82e-b553-32ab-bab8-f14465f395ef",
                        "entry_id": "bd0058ed-d7aa-38f0-a208-78cab320f50a",
                        "glosses": [
                            "перен., вступить в половую связь, в интимные отношения с кем-либо"
                        ],
                        "tags": [
                            "+ с + твор. п."
                        ],
                        "examples": [
                            {
                                "example_id": "bc7879a9-65e8-4786-b665-ea964dc3b0d1",
                                "sense_id": "c387d82e-b553-32ab-bab8-f14465f395ef",
                                "text": "Про него рассказывали, что он страшный бабник, переспал со многими женщинами из села."
                            }
                        ]
                    }
                ],
