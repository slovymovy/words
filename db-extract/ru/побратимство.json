                "senses": [
                    {
                        "sense_id": "501e04f0-3b8c-375f-9372-4535246196db",
                        "entry_id": "46e9a702-810c-38c1-ad62-7951a0d37386",
                        "glosses": [
                            "старинный славянский обычай закрепления дружбы приравниванием её к братским отношениям, сопровождающийся определённым обрядом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c62985-08c4-4be5-bd77-2629792e4531",
                                "sense_id": "501e04f0-3b8c-375f-9372-4535246196db",
                                "text": "Нравственная связь богатырей, выражаемая обрядом побратимства, скрепляется дружбой и родством их коней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e263fec-29e2-4cf5-b356-210f56c73117",
                        "source_entry_id": "46e9a702-810c-38c1-ad62-7951a0d37386",
                        "source_sense_id": "501e04f0-3b8c-375f-9372-4535246196db",
                        "target_lang_word": "Blutsbrüderschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutsbrüderschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "466efb97-1ae8-3792-be75-8a9cc2423e87",
                                        "entry_id": "fde4103e-149e-3123-a556-3f040dc833f9",
                                        "glosses": [
                                            "symbolischer Akt, bei dem zwei männliche Personen ihre tiefe Verbundenheit durch Vermischung von Blut ausdrücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faa65e04-dc77-4cb1-9a31-3d8969190fe3",
                                                "sense_id": "466efb97-1ae8-3792-be75-8a9cc2423e87",
                                                "text": "„Mit Uwe schloß ich im Wäldchen Blutsbrüderschaft.“"
                                            },
                                            {
                                                "example_id": "c5013d9a-8c4c-4189-8187-0381f4f8b69e",
                                                "sense_id": "466efb97-1ae8-3792-be75-8a9cc2423e87",
                                                "text": "„Die Blutsbrüderschaft als Form der geistigen Verwandtschaft war in vielen europäischen Gesellschaften verbreitet, beispielsweise in den germanischen und slawischen.“"
                                            },
                                            {
                                                "example_id": "79116047-6d29-42cc-bbf9-58796b30a8a5",
                                                "sense_id": "466efb97-1ae8-3792-be75-8a9cc2423e87",
                                                "text": "„Der »edle Wilde« aber bewunderte den deutschen Old Shatterhand, schloss mit ihm Blutsbrüderschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c84150a-a648-45e9-b9ac-68f3cb0953d7",
                        "source_entry_id": "46e9a702-810c-38c1-ad62-7951a0d37386",
                        "source_sense_id": "501e04f0-3b8c-375f-9372-4535246196db",
                        "target_lang_word": "fraternisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fraternisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                                        "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                                        "glosses": [
                                            "Action de fraterniser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29ff5629-a917-4676-b1fb-a3cc88088e81",
                                                "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                                                "text": "Ils se montrèrent timides même, et il fallut des présents, de bons services, une fraternisation quotidienne, un long commerce d’amitiés, pour les acclimater à bord."
                                            },
                                            {
                                                "example_id": "de4c5998-3b9c-43aa-959c-ebc677d5d98b",
                                                "sense_id": "6893b742-e88b-3161-b918-30761831b121",
                                                "text": "Les cas de fraternisation de tranchée à tranchée n’ont pas été rares pendant la guerre, ils auraient été plus fréquents sans les officiers qui veillaient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e1bb64-47a6-3b00-8e8e-32f689c9185a",
                                        "entry_id": "bc086e99-13ec-35b5-a38e-0e9c1d6c8813",
                                        "glosses": [
                                            "Union fraternelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d30802e-eb9d-4529-a8f8-4f2a43a5a261",
                                                "sense_id": "a1e1bb64-47a6-3b00-8e8e-32f689c9185a",
                                                "text": "Les chinois, les arabes, les habitants de l’Inde, de l’Égypte, les Hottentots, les Indiens, les Lapons, et mille autres peuples et peuplades attestent cette malédiction jetée sur tout ce qui s’isole, sur tout ce qui ne coopère pas à la fraternisation universelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
