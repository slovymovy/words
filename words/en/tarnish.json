{
    "word_family": [
        "tarnishable",
        "untarnished"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8204c8c3-8bd9-3742-8cfe-8e66a2434a3e",
                    "sense_definition": "To damage, soil, or ruin a reputation, image, or status.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "damage_reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was deeply worried that the scandal would <w>tarnish</w> his reputation in the community.",
                            "target_lang_translations": {
                                "ru": "Он был глубоко обеспокоен тем, что этот скандал может <w>запятнать</w> его репутацию в обществе."
                            }
                        },
                        {
                            "text": "The greed shown by a few players threatens to <w>tarnish</w> the image of the entire sport.",
                            "target_lang_translations": {
                                "ru": "Жадность, проявленная несколькими игроками, угрожает <w>очернить</w> имидж всего вида спорта."
                            }
                        }
                    ],
                    "synonyms": [
                        "sully",
                        "taint",
                        "blemish",
                        "damage"
                    ],
                    "antonyms": [
                        "enhance",
                        "improve"
                    ],
                    "common_phrases": [
                        "tarnish his reputation",
                        "tarnish the image"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить ущерб, пачкать или портить репутацию, имидж или статус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пятнать",
                                "target_lang_sense_clarification": "позорить, бесчестить репутацию"
                            },
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "навлекать позор, выставлять в неблаговидном свете"
                            },
                            {
                                "target_lang_word": "омрачать",
                                "target_lang_sense_clarification": "портить впечатление или репутацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fa5dd0f-eb07-3b92-b11d-459660c0000d",
                    "sense_definition": "To lose luster or discolor, especially as a result of exposure to air or moisture.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "oxidation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not store the silver properly, it will quickly <w>tarnish</w> and lose its shine.",
                            "target_lang_translations": {
                                "ru": "Если хранить серебро неправильно, оно быстро <w>потемнеет</w> и потеряет свой блеск."
                            }
                        },
                        {
                            "text": "The copper roof began to <w>tarnish</w> after years of exposure to the damp sea air.",
                            "target_lang_translations": {
                                "ru": "Медная крыша начала <w>окисляться</w> после многих лет воздействия влажного морского воздуха."
                            }
                        }
                    ],
                    "synonyms": [
                        "discolor",
                        "oxidize",
                        "corrode"
                    ],
                    "antonyms": [
                        "polish",
                        "shine"
                    ],
                    "common_phrases": [
                        "prevent from tarnishing",
                        "begin to tarnish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять блеск или изменять цвет, особенно в результате воздействия воздуха или влаги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тускнеть",
                                "target_lang_sense_clarification": "утрачивать яркость и блеск"
                            },
                            {
                                "target_lang_word": "окисляться",
                                "target_lang_sense_clarification": "покрываться налетом от воздействия воздуха"
                            },
                            {
                                "target_lang_word": "темнеть",
                                "target_lang_sense_clarification": "терять первоначальный светлый оттенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1cc933d-3341-370b-89fb-d4307358eced",
                    "sense_definition": "To lose its original brightness, appeal, or attraction; to become dull.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lose_luster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over time, even the most exciting novelties can <w>tarnish</w> with daily familiarity.",
                            "target_lang_translations": {
                                "ru": "Со временем даже самые захватывающие новинки могут <w>поблекнуть</w> из-за повседневного привыкания."
                            }
                        },
                        {
                            "text": "Her initial enthusiasm began to <w>tarnish</w> as the routine of the job set in.",
                            "target_lang_translations": {
                                "ru": "Ее первоначальный энтузиазм начал <w>угасать</w>, когда началась рабочая рутина."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade",
                        "dull",
                        "wither"
                    ],
                    "antonyms": [
                        "flourish"
                    ],
                    "common_phrases": [
                        "tarnish with time"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять первоначальную яркость, привлекательность или притягательность; становиться скучным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тускнеть",
                                "target_lang_sense_clarification": "утрачивать силу проявления, слабеть"
                            },
                            {
                                "target_lang_word": "меркнуть",
                                "target_lang_sense_clarification": "терять былую привлекательность или интерес"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "постепенно исчезать (об энтузиазме, чувствах)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c653183-7902-3229-9612-2e33a58c7f3e",
                    "sense_definition": "To weaken or harm a trademark's reputation by using a similar mark in an inappropriate or degrading context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_trademark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company sued the competitor, claiming the parody would <w>tarnish</w> their famous trademark.",
                            "target_lang_translations": {
                                "ru": "Компания подала в суд на конкурента, утверждая, что пародия может <w>дискредитировать</w> их известный товарный знак."
                            }
                        },
                        {
                            "text": "Using a similar logo on low-quality goods can easily <w>tarnish</w> a brand's established value.",
                            "target_lang_translations": {
                                "ru": "Использование похожего логотипа на некачественных товарах может легко <w>подорвать</w> устоявшуюся ценность бренда."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilute"
                    ],
                    "common_phrases": [
                        "tarnish a trademark"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослаблять или наносить вред репутации товарного знака путем использования аналогичного знака в неподобающем или унижающем контексте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "наносить вред репутации бренда или товарного знака"
                            },
                            {
                                "target_lang_word": "дискредитировать",
                                "target_lang_sense_clarification": "подрывать доверие к товарному знаку"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f7b0b37-5b02-32e3-9321-ff8a28d90a01",
                    "sense_definition": "A dullness, discoloration, or thin layer of corrosion on a metal surface.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "oxidation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a special cloth to remove the dark <w>tarnish</w> from the antique silver spoons.",
                            "target_lang_translations": {
                                "ru": "Она использовала специальную ткань, чтобы удалить темный <w>налет</w> со старинных серебряных ложек."
                            }
                        },
                        {
                            "text": "Limiting the use of silver to special occasions might invite <w>tarnish</w> unless the pieces are protected.",
                            "target_lang_translations": {
                                "ru": "Редкое использование серебра только по особым случаям может привести к его <w>потускнению</w>, если изделия не защищены."
                            }
                        }
                    ],
                    "synonyms": [
                        "discoloration",
                        "patina",
                        "rust"
                    ],
                    "antonyms": [
                        "shine",
                        "luster"
                    ],
                    "common_phrases": [
                        "remove the tarnish",
                        "layer of tarnish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклость, изменение цвета или тонкий слой коррозии на металлической поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потускнение",
                                "target_lang_sense_clarification": "утрата блеска металлической поверхности"
                            },
                            {
                                "target_lang_word": "налет",
                                "target_lang_sense_clarification": "тонкий слой окисления на металле"
                            },
                            {
                                "target_lang_word": "окисление",
                                "target_lang_sense_clarification": "химическое изменение поверхности металла"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}