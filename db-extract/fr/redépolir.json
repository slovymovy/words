                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11fc2e8f-aa6d-451f-8156-6161a17c63b5",
                                "sense_id": "2b1af318-3462-30db-a664-8caa86691feb",
                                "text": "Je pense soit redépolir une deuxième fois la plaque de verre pour uniformiser l'ensemble, ou alors utiliser de la pâte à diamant pour atténuer les marques de séparation."
                            },
                            {
                                "example_id": "5d1d6414-7ecc-40f3-a088-07555f222a13",
                                "sense_id": "2b1af318-3462-30db-a664-8caa86691feb",
                                "text": "Perso ma couche de peinture de fond, je la ferais à la polyurethane, sinon acrylique revernie, et redépolir de la même façon avant d'entamer une réa, simple précaution"
                            }
                        ]
