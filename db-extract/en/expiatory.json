                        "entry_id": "a0d1ff4c-947f-3bfc-8437-ac02a67b6923",
                        "glosses": [
                            "Of or pertaining to expiation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e583b76-60e0-40e8-85d0-45d452e88099",
                                "sense_id": "4ca855be-1eeb-30f7-9d38-d3145f9143b4",
                                "text": "18 January 1549, Hugh Latimer, Sermon of the Plough\nThey would have us saved by a daily oblation propitiatory; by a sacrifice expiatory, or remissory."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1408966-3203-454c-8620-913dbf6a34f2",
                        "source_entry_id": "a0d1ff4c-947f-3bfc-8437-ac02a67b6923",
                        "source_sense_id": "4ca855be-1eeb-30f7-9d38-d3145f9143b4",
                        "source_sense_description": "of or pertaining to expiation",
                        "target_lang_word": "expiatoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expiatoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "524637b1-777a-3855-aa79-dd0d8dc05844",
                                        "entry_id": "1b1fc708-adea-3674-a34c-7d914c44eca1",
                                        "glosses": [
                                            "Qui est destiné à une expiation religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83335e3e-14dc-4a73-b48d-9588b0f1c8b8",
                                                "sense_id": "524637b1-777a-3855-aa79-dd0d8dc05844",
                                                "text": "Nul doute que le dieu pur , Apollon , ne s'entoure surtout de purificateurs. Le sang d'un monstre l'a souillé. Il lui faut, à lui comme à un être mortel, des cérémonies expiatoires."
                                            },
                                            {
                                                "example_id": "42170624-f104-415a-91fa-3a36841f7527",
                                                "sense_id": "524637b1-777a-3855-aa79-dd0d8dc05844",
                                                "text": "Dans la Tartarie , après les dispositions purificatrices , les ablutions , vient l'onction avec la substance même de l'offrande la plus pure , les nouveaux époux accomplissent un pèlerinage expiatoire."
                                            },
                                            {
                                                "example_id": "e5a77a4d-3dff-4aab-95a2-c78f711bb3f8",
                                                "sense_id": "524637b1-777a-3855-aa79-dd0d8dc05844",
                                                "text": "Imite-nous, ô Chef des sacrés promontoires,\nEt buvons sans pâlir aux temps expiatoires."
                                            },
                                            {
                                                "example_id": "17a0b7f7-08dc-4e1a-9478-0a8a719a38b8",
                                                "sense_id": "524637b1-777a-3855-aa79-dd0d8dc05844",
                                                "text": "Et cette culpabilité, parfois extrême, peur être apaisée, voire complètement « blanchie », par des manœuvres masochiques telles que les pénitences ou autres restrictions expiatoires visant à l’autopunition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
