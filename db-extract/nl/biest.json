                "forms": [],
                "senses": [
                    {
                        "sense_id": "60d5aa6c-82f5-3faf-b7d3-297e18f972d0",
                        "entry_id": "5d71d4dc-106f-33e8-8188-405648d840a0",
                        "glosses": [
                            "beest, colostrum, beestings"
                        ],
                        "tags": [
                            "feminine",
                            "no-diminutive",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "180caa4f-b6f2-48f3-96b9-479716ad2a9d",
                                "sense_id": "60d5aa6c-82f5-3faf-b7d3-297e18f972d0",
                                "text": "Het pasgeboren kalf heeft de biest al op.",
                                "translation": "The newborn calf has already finished drinking the beestings.",
                                "english": "The newborn calf has already finished drinking the beestings."
                            },
                            {
                                "example_id": "2914ad74-10d5-4523-917f-9487e366cfc2",
                                "sense_id": "60d5aa6c-82f5-3faf-b7d3-297e18f972d0",
                                "text": "Deeze eerste Biest …, als meede de tweede, word altoos aan het jong geworpen kalf te drinken gegeven; dog de derde en vierde, enz. veel door de huislieden gebruikt, om met bijvoeging van meel, enz. pannekoeken en zelfs wafelen van te bakken…",
                                "translation": "These first beestings…, as well as the second, are always given to the newborn calf to drink; the third and fourth beestings etc., however, are heavily used by the farmers, with the addition of dough etc., to bake pancakes and even waffles…",
                                "english": "These first beestings…, as well as the second, are always given to the newborn calf to drink; the third and fourth beestings etc., however, are heavily used by the farmers, with the addition of dough etc., to bake pancakes and even waffles…"
                            },
                            {
                                "example_id": "788a4b11-77a3-4708-aff9-2b7f3b92721f",
                                "sense_id": "60d5aa6c-82f5-3faf-b7d3-297e18f972d0",
                                "text": "1808, Johannes le Francq van Berkhey, Natuurlyke historie van Holland, vol. 7, publ. P. H. Trap, page 164.\nDeze eerste melk is doorgaans … vettiger dan de gewone melk, ook walgachtig en geilzoet van smaak, en wordt biest genoemd…",
                                "translation": "This first milk is generally … greasier than normal milk, as well as disgusting and sickeningly sweet in taste, and it is called beest…",
                                "english": "This first milk is generally … greasier than normal milk, as well as disgusting and sickeningly sweet in taste, and it is called beest…"
                            }
                        ]
                    }
                ],
