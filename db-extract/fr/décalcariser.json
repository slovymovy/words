                "senses": [
                    {
                        "sense_id": "54c393e4-5177-31e7-8bdb-0fe8bfc48119",
                        "entry_id": "65ac74b7-3421-3070-82b3-31d6e3bcb1c3",
                        "glosses": [
                            "Débarrasser du calcaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c19d94e6-93da-43bc-887a-0b2a42ff0664",
                                "sense_id": "54c393e4-5177-31e7-8bdb-0fe8bfc48119",
                                "text": "C'est inouï tout ce qu'elle achète de choses à mon avis parfaitement superflues. Par exemple un appareil destiné à décalcariser l'eau destinée à la toilette."
                            },
                            {
                                "example_id": "88b8f963-bd3f-4ea3-bdbe-4f3d36e04522",
                                "sense_id": "54c393e4-5177-31e7-8bdb-0fe8bfc48119",
                                "text": "Rien de tel pour décalcariser une bouilloire que de la faire fonctionner avec du vinaigre dedans... efficacité garantie !"
                            },
                            {
                                "example_id": "ccd4d651-304f-49b8-9c76-d50973fb8334",
                                "sense_id": "54c393e4-5177-31e7-8bdb-0fe8bfc48119",
                                "text": "quelle solution pour tenter de décalcariser l'eau?"
                            },
                            {
                                "example_id": "c59b3168-889b-442e-a904-556b5038564d",
                                "sense_id": "54c393e4-5177-31e7-8bdb-0fe8bfc48119",
                                "text": "Un autre produit que j'utilise aussi, c'est le vinaigre blanc pour faire les vitres ou décalcariser ma bouilloire et ma cafetière."
                            }
                        ]
                    }
                ],
