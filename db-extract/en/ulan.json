                    {
                        "sense_id": "6f60836e-8522-30fa-ae55-b1e4ab7f9e5c",
                        "entry_id": "e8510b6b-2731-3b11-8543-c6284f8a3824",
                        "glosses": [
                            "A county of Haixi Mongol and Tibetan Autonomous Prefecture, Qinghai, China."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c18d6f-68b6-46c0-b5a4-5ee660932d5e",
                                "sense_id": "6f60836e-8522-30fa-ae55-b1e4ab7f9e5c",
                                "text": "Forestry, animal husbandry and sideline occupations have also grown vigorously. (Chachia) commune in Wulan County has swept away the conservative idea that it is hard to hold two sheep with one hand, has persisted in taking animal husbandry as the main occupation and combining animal husbandry with farming, has brought about tremendous development in both animal husbandry and agriculture, and has contributed both livestock and grain to the state."
                            },
                            {
                                "example_id": "903e9876-488d-436a-b8b5-c19651d6cc2b",
                                "sense_id": "6f60836e-8522-30fa-ae55-b1e4ab7f9e5c",
                                "text": "The lake is situated in Ulan county, Haixi autonomous prefecture, in western China’s Qinghai province. The blue skies reflected off the surface of the crystallised saline water have given it the name “Mirror of the Sky”, and it attracted millions of tourists in the first half of 2018."
                            }
                        ]
                    }
