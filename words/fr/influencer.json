            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab33e271-cc03-3901-9ca0-5c8885c10735",
                    "sense_definition": "Exercer une influence, une action déterminante ou un ascendant sur quelqu'un ou quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les médias peuvent facilement <w>influencer</w> l'opinion publique lors d'une élection importante."
                        },
                        {
                            "text": "Son professeur a beaucoup cherché à <w>influencer</w> son choix d'études supérieures."
                        }
                    ],
                    "synonyms": [
                        "conditionner",
                        "orienter"
                    ],
                    "common_phrases": [
                        "influencer une décision",
                        "influencer l'opinion publique",
                        "influencer le résultat"
                    ]
                },
                {
                    "sense_id": "35debbf2-113d-3295-8346-abc069ff4b80",
                    "sense_definition": "Regarder ou fixer quelqu'un avec insistance dans le but de l'impressionner ou de l'intimider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourquoi tu m'<w>influences</w> comme ça en me fixant, t'as un souci avec moi ?"
                        },
                        {
                            "text": "Dans la rue, certains passants essaient d'<w>influencer</w> les autres avec un regard provocateur."
                        }
                    ],
                    "synonyms": [
