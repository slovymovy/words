                "senses": [
                    {
                        "sense_id": "f1d77d9b-72a7-321e-9b96-68cba944290d",
                        "entry_id": "ef1e031f-85d1-38ca-bc92-f8f8ae59c20d",
                        "glosses": [
                            "exciting and absorbing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "143c0fb6-7995-4dcb-bdb1-9c8f19268050",
                                "sense_id": "f1d77d9b-72a7-321e-9b96-68cba944290d",
                                "text": "The Abbess had not miscalculated the effect of the yesterday's ceremony—she knew it was not binding, but its influence as a religious obligation was enthralling to a degree."
                            },
                            {
                                "example_id": "c8b450da-0eeb-4e84-b0f2-cab057f69911",
                                "sense_id": "f1d77d9b-72a7-321e-9b96-68cba944290d",
                                "text": "Glittering castles in Spain were shaping themselves out of the mists and rainbows of her lively fancy; adventures wonderful and enthralling were happening to her in cloudland—adventures that always turned out triumphantly and never involved her in scrapes like those of actual life."
                            },
                            {
                                "example_id": "990edf27-5833-45d8-9d97-6b9c2d96acf3",
                                "sense_id": "f1d77d9b-72a7-321e-9b96-68cba944290d",
                                "text": "Andre Santos equalised and the outstanding Theo Walcott put Arsenal ahead for the first time before Juan Mata's spectacular strike set up the finale for an enthralling encounter."
                            }
                        ]
                    }
                ],
