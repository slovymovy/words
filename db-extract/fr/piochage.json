                        "examples": [
                            {
                                "example_id": "06838971-6326-4aff-af53-8f60d1c275f7",
                                "sense_id": "76a456b5-3fbd-305c-83b1-195940d13731",
                                "text": "Le gardien entretient les espaces verts et s'occupe de la tonte, de la taille des haies, de l’élagage et du piochage des plates-bandes."
                            },
                            {
                                "example_id": "665b3795-2d6f-4fd1-98d8-0f0f037da8a7",
                                "sense_id": "76a456b5-3fbd-305c-83b1-195940d13731",
                                "text": "Le bezochage, qui n’était autre que le piochage ou labourage à bras du sol, s’effectuait au mois de mars, une fois la taille de la vigne achevée ; il tirait son nom de l’instrument qui servait à l’exécuter."
                            }
                        ]
                    },
