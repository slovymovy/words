                "senses": [
                    {
                        "sense_id": "1b010df1-677d-345e-89b1-4bde10ae7030",
                        "entry_id": "ae1b3bae-e877-38e3-aaba-a4f234248bde",
                        "glosses": [
                            "Qui est extérieur à la narration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f642cfac-2297-4a98-8f06-8ce2ff156705",
                                "sense_id": "1b010df1-677d-345e-89b1-4bde10ae7030",
                                "text": "Le narrateur omniscient est extradiégétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "84ca8688-baf2-3ad1-a8b9-07c1d7da56cc",
                        "entry_id": "ae1b3bae-e877-38e3-aaba-a4f234248bde",
                        "glosses": [
                            "Qui est extérieur à la diégèse, c’est-à-dire qui ne fait pas partie de l’action ou qui n’est pas lié aux événements dans une œuvre de fiction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463c85d8-89b8-4db1-84ef-792059ad2486",
                                "sense_id": "84ca8688-baf2-3ad1-a8b9-07c1d7da56cc",
                                "text": "Dans cette scène du film, la musique est un son extradiégétique car elle ne peut pas être entendue par les personnages ; c'est une musique d'ambiance pour le spectateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d1c217c-39b0-4004-8829-03f447f39b0a",
                        "source_entry_id": "ae1b3bae-e877-38e3-aaba-a4f234248bde",
                        "target_lang_word": "extradiegetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extradiegetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc885b0-8545-3ea9-81f6-fafa34053cb4",
                                        "entry_id": "f2e82da2-646c-3109-a9b2-7d57df4f5380",
                                        "glosses": [
                                            "External to the narrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3e5d33-9124-43fe-bc43-04b4f5c55096",
                                                "sense_id": "2fc885b0-8545-3ea9-81f6-fafa34053cb4",
                                                "text": "This voice-over functions very differently from the extradiegetic narrator of the radio soap opera however, who tended to impose ideological coherence on the text, as well as serve as spokesman for the products being sold."
                                            },
                                            {
                                                "example_id": "61eda844-3522-4e43-9032-1cbf7f9e47b6",
                                                "sense_id": "2fc885b0-8545-3ea9-81f6-fafa34053cb4",
                                                "text": "However, in this sequence Colleen's actions alone do not make her horrific. Rather, the extradiegetic music condemns her."
                                            },
                                            {
                                                "example_id": "71d1770a-f3e9-48b9-b953-2a20e3c4b74a",
                                                "sense_id": "2fc885b0-8545-3ea9-81f6-fafa34053cb4",
                                                "text": "Instead, an extradiegetic narrator renders detached testimony of the hero's traumatic story in the Thatcher era."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
