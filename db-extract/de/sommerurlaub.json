                ],
                "senses": [
                    {
                        "sense_id": "ac372f34-e335-3258-95b8-734137de0377",
                        "entry_id": "fd1b8a4a-c8eb-3612-9d23-58a4b1a7634e",
                        "glosses": [
                            "Urlaub, der im Sommer verbracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f78116a-2d69-40ae-bfab-01cf9ac7ee23",
                                "sense_id": "ac372f34-e335-3258-95b8-734137de0377",
                                "text": "„Diese mit einem Deutschen verheiratete Britin namens Gräfinghoff riet ihrer Schwester und deren zwei Kindern, den gerade begonnenen Sommerurlaub bei den Droëges umgehend abzubrechen - obwohl die drei eigentlich bis Mitte September hatten bleiben wollen.“"
                            },
                            {
                                "example_id": "9af58d8c-544f-4c45-bb2f-3f906fdd9da9",
                                "sense_id": "ac372f34-e335-3258-95b8-734137de0377",
                                "text": "„Achtzehn Jahre lang habe ich meinen Sommerurlaub am Strand der ostfriesischen Insel Langeoog verbracht.“"
                            },
                            {
                                "example_id": "845aa264-f74a-4c4e-b161-767f62749671",
                                "sense_id": "ac372f34-e335-3258-95b8-734137de0377",
                                "text": "„Mehrmals fährt die Familie von Rustschuk in den Sommerurlaub.“"
                            },
                            {
                                "example_id": "4ec0f8f7-da80-494d-b521-cfef3ebf15d4",
                                "sense_id": "ac372f34-e335-3258-95b8-734137de0377",
                                "text": "„Im Reisebüro an der Ecke, erzählt er, hätten Arbeiter und Handwerker früher ihren Sommerurlaub am Mittelmeer gebucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
