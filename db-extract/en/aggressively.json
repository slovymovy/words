                                    {
                                        "sense_id": "cb6cb906-8d54-34d6-872a-b66402042547",
                                        "entry_id": "b7ca9a76-eb5b-3dbb-aaaf-d567afdd808d",
                                        "glosses": [
                                            "geneigd om aan te vallen, het initiatief nemend en doordrijvend om een overwinning of resultaat te behalen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9de7117-e47a-4e16-8f2e-53ac963e410e",
                                                "sense_id": "cb6cb906-8d54-34d6-872a-b66402042547",
                                                "text": "Het elftal had een agressieve instelling."
                                            },
                                            {
                                                "example_id": "25045cdc-7c56-47c1-9e37-bd126a25b2a5",
                                                "sense_id": "cb6cb906-8d54-34d6-872a-b66402042547",
                                                "text": "Het politieke effect van een zo agressieve en onverwachte koersverandering in de Zweedse neutraliteitspolitiek zou op zich leiden tot een toegenomen internationaal oorlogsgevaar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9458ae8-36c6-3f47-bf81-aee570d26a3f",
                                        "entry_id": "b7ca9a76-eb5b-3dbb-aaaf-d567afdd808d",
                                        "glosses": [
                                            "op strijd belust, geneigd tot ruzie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d22938-d60d-4e43-b873-92fad003369d",
                                                "sense_id": "c9458ae8-36c6-3f47-bf81-aee570d26a3f",
                                                "text": "In Europa krijgen we slechts voorbeelden van uitgesproken extreme Amerikanen te zien, alleen maar uitingen van contrasten. Ze zijn ofwel supermooi met botox en nepborsten, of enorm dik en luidruchtig. De rednecks zijn agressief en gevaarlijk, anderen zijn juist weer oppervlakkig en overdreven vriendelijk in de supermarkt. Slimme puissant rijke ondernemers of kansloos verslaafd aan crack en fentanyl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c90fab82-fd79-3f51-b361-1267db9fd985",
                                        "entry_id": "b7ca9a76-eb5b-3dbb-aaaf-d567afdd808d",
                                        "glosses": [
                                            "andere stoffen of weefsels aantastend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21960a29-9e10-412d-86ab-bbe89f5f9976",
                                                "sense_id": "c90fab82-fd79-3f51-b361-1267db9fd985",
                                                "text": "dit is agressief spul, zeg"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0ffff93-b2ad-31df-861d-f9a4b3732ced",
                                        "entry_id": "b7ca9a76-eb5b-3dbb-aaaf-d567afdd808d",
                                        "glosses": [
                                            "zich snel verspreidend, snel groeiend, kwaadaardig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eced1dcc-221b-4ec6-8917-ea5b385317cb",
                                                "sense_id": "e0ffff93-b2ad-31df-861d-f9a4b3732ced",
                                                "text": "dit is een agressieve vorm van kanker"
                                            }
                                        ]
