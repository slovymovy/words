                                "target_lang_sense_clarification": "ironic lack of interest"
                            },
                            {
                                "target_lang_word": "who cares",
                                "target_lang_sense_clarification": "expressing that something is unimportant"
                            },
                            {
                                "target_lang_word": "fascinating",
                                "target_lang_sense_clarification": "used sarcastically to mean boring"
                            }
                        ]
                    }
                }
            ]
        },
