                "senses": [
                    {
                        "sense_id": "5b5e27fa-d240-3020-9b11-3ab7ec6d9c3b",
                        "entry_id": "f4d75a4f-c334-3154-a8f3-f461c0d2c670",
                        "glosses": [
                            "warzywo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb14302-d5a7-4639-91df-5c0aa1f4d0c6",
                                "sense_id": "5b5e27fa-d240-3020-9b11-3ab7ec6d9c3b",
                                "text": "Nie wiem, jak można jeść tylko jarzyny!"
                            },
                            {
                                "example_id": "57d60e48-6de3-419d-9328-f7c9f94ed3e0",
                                "sense_id": "5b5e27fa-d240-3020-9b11-3ab7ec6d9c3b",
                                "text": "Nawet wtedy, gdy ogólne warunki naturalne, przemysłowe i handlowe zostają spełnione, można uprawę jarzyn polnych polecić tylko w tym wypadku, gdy jest ona prowadzona umiarkowanie i jeśli do hodowli wybiera się takie rodzaje i gatunki, których zbiory nie przypadają równocześnie i to wtedy, kiedy rynek jest nimi przepełniony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bab3526b-ec6c-37e7-a93d-76084280b200",
                        "entry_id": "f4d75a4f-c334-3154-a8f3-f461c0d2c670",
                        "glosses": [
                            "danie z jarzyn (1.1)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "aec2484b-5dc3-3f1b-8783-9d1fa7f735ab",
                        "entry_id": "f4d75a4f-c334-3154-a8f3-f461c0d2c670",
                        "glosses": [
                            "nasiona jarzyn (1.1)"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "e54537c6-c291-3904-9416-771402d76dc8",
                        "entry_id": "f4d75a4f-c334-3154-a8f3-f461c0d2c670",
                        "glosses": [
                            "zboże jare"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "1bdb1c1f-f53e-47d6-b4b7-30025ac51dde",
                                "sense_id": "e54537c6-c291-3904-9416-771402d76dc8",
                                "text": "Grunta pojałowiały, spustoszały lasy / I w polu tego roku zupełnie chybiło; / Po nizinach wymokło, na wzgórkach spaliło; / Siana i źdźbła nie będzie, toż samo z jarzyną; / Cieszyłem się przynajmniej cokolwiek oźminą, / Alić się dowiaduję z listów ekonoma, / Że i te nie omłotne, sama tylko słoma"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
