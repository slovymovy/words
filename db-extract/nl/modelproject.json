                        "glosses": [
                            "project dat als voorbeeld moet dienen voor andere projecten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fde53c0-ccac-4313-b039-9b96158f9788",
                                "sense_id": "5a409fa0-720c-3b34-ba6c-d22278a07c0e",
                                "text": "De volgende kopers brachten geld mee, twee architectuurdiploma's en het plan de villa in een modelproject voor landelijk wonen te veranderen."
                            },
                            {
                                "example_id": "ea1af9c5-6925-46cd-b72a-b4c635606dde",
                                "sense_id": "5a409fa0-720c-3b34-ba6c-d22278a07c0e",
                                "text": "De Laotiaanse minister van Transport noemt de spoorlijn \"een modelproject van goede kwaliteit dat perfect en volgens plan is uitgevoerd\"."
                            },
                            {
                                "example_id": "2d27ad81-083a-4d05-8080-d41e3a3853c5",
                                "sense_id": "5a409fa0-720c-3b34-ba6c-d22278a07c0e",
                                "text": "Tineke Ceelen van Stichting Vluchteling, die het voedseluitgiftepunt in Athene financieel ondersteunt, is blij dat er tijdens het staatsbezoek zo veel aandacht is voor het migratieprobleem in Griekenland. Ze vindt wel dat Willem-Alexander en Máxima naar een \"modelproject\" zijn gegaan, waar alles goed geregeld is maar waar weinig vluchtelingen gebruik van kunnen maken."
                            }
                        ]
                    }
