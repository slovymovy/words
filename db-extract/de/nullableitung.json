                "senses": [
                    {
                        "sense_id": "820cf5f3-2347-3010-8535-da67e27709e8",
                        "entry_id": "b455fa4a-eba1-3aaf-8259-5b557e4ddaf7",
                        "glosses": [
                            "Umwandlung eines Wortes in eine andere Wortart ohne Veränderung des Stammmorphems und ohne Derivatem (Ableitungsmorphem), also durch Konversion"
                        ],
                        "tags": [
                            "Linguistik/Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "d6dfc94a-eb46-4943-9cae-f2d2525984b6",
                                "sense_id": "820cf5f3-2347-3010-8535-da67e27709e8",
                                "text": "Im Englischen gibt es viele Nullableitungen."
                            },
                            {
                                "example_id": "c6960379-c331-4fbb-ada4-60d027634cef",
                                "sense_id": "820cf5f3-2347-3010-8535-da67e27709e8",
                                "text": "„In diesem Fall spricht man meist von Nullableitung (…), aber auch andere Termini (‚Konversion‘, ‚implizite Ableitung‘ und andere) werden, meist mit schlechter Abgrenzung ihres Anwendungsbereichs, verwendet.“"
                            },
                            {
                                "example_id": "e30e75c7-a6ed-44c2-961c-c82b5130577b",
                                "sense_id": "820cf5f3-2347-3010-8535-da67e27709e8",
                                "text": "„Im letzteren Fall, »Nullableitung«, wird somit einfach die Endung des Zeitworts weggelassen und der Artikel hinzugefügt…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
