                                    {
                                        "sense_id": "658af774-f4c4-3505-b425-1a9898181a0c",
                                        "entry_id": "4be6eff3-4e25-370e-91f7-0485eb937af3",
                                        "glosses": [
                                            "The brown rat (Rattus norvegicus)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82500a29-137a-49e8-9cd4-fb4c1c30ac29",
                                                "sense_id": "658af774-f4c4-3505-b425-1a9898181a0c",
                                                "text": "The black rat [...] became extinct in Britain following the Roman withdrawal, only to reappear in Norman times. Thereafter the black rat prospered - until the arrival of the larger brown rat (also known as the sewer rat or Norway rat), which reached Britain at about the time of the Hanoverian succession in the eighteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc466f84-1df3-3d83-8264-fef8b9304870",
                                        "entry_id": "4be6eff3-4e25-370e-91f7-0485eb937af3",
                                        "glosses": [
                                            "A contemptible person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "36be9a47-8466-31f3-9eeb-ae841f7224bd",
                                        "entry_id": "4be6eff3-4e25-370e-91f7-0485eb937af3",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: Any rat that lives in sewers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6370024d-c2db-47d2-9697-77d907e2ed1f",
                        "source_entry_id": "f9986c26-aaf9-3f78-982f-3e1051fa71f1",
                        "source_sense_id": "bb559251-daba-37ea-b3f9-ac1903d36ab7",
                        "source_sense_description": "bruine rat, rioolrat, Rattus norvegicus",
                        "target_lang_word": "rat brun",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rat brun",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67d574e7-3a56-3b1b-841b-0504ac790f66",
                                        "entry_id": "f0befce6-567b-3a59-9cae-c0b04c661f9d",
                                        "glosses": [
                                            "Espèce de rat à répartition mondiale, gris-brun et plus grand que le rat noir."
                                        ],
                                        "tags": [
                                            "Glirologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5275eeea-c288-44b7-ae01-27e55cfbf94f",
                                                "sense_id": "67d574e7-3a56-3b1b-841b-0504ac790f66",
                                                "text": "Le rat surmulot, rat brun ou rat d'égout (rattus norvegicus) est un rongeur de la famille des muridés. Il mesure de 20 à 27 cm, plus la queue qui peut atteindre 22 cm… Son poids oscille entre 275 et 500 g."
                                            },
                                            {
                                                "example_id": "5bdeb6fd-ab50-4d2f-a9e2-a24fc4b0b04f",
                                                "sense_id": "67d574e7-3a56-3b1b-841b-0504ac790f66",
                                                "text": "Il s’est notamment avéré que ces campagnols cohabitaient avec des rats bruns, fait invraisemblable vu les relations prédatrices entre les deux espèces, et leurs comportements territoriaux incompatibles."
                                            },
                                            {
                                                "example_id": "e768e564-a6b6-4c4f-94e8-2a31a734d204",
                                                "sense_id": "67d574e7-3a56-3b1b-841b-0504ac790f66",
                                                "text": "À partir de 1720, on assiste à l’arrivée en Occident du rat brun, dit aussi rat gris ou surmulot (Rattus norvegicus). En provenance de Russie, il va supplanter peu à peu le rat noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
