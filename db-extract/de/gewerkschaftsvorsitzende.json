                ],
                "senses": [
                    {
                        "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                        "entry_id": "a050fc66-ef0b-394b-8fcb-9affb0513b7c",
                        "glosses": [
                            "Vorsitzende einer Gewerkschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56469550-c7f1-48ea-a1df-6faa74d53449",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Den öffentlichen Haushalten fehlte es an einer angemessenen finanziellen Ausstattung durch das Land, sagte die Gewerkschaftsvorsitzende Gabriele Kailing.“"
                            },
                            {
                                "example_id": "24fb424a-d411-4b68-9cd3-2aa3a8240b4e",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Die Belastung durch die Versorgung von Covid-19-Patienten sei auch über die Feiertage weiter angestiegen, sagte die Gewerkschaftsvorsitzende Susanne Johna den Zeitungen der Funke-Mediengruppe.“"
                            },
                            {
                                "example_id": "34c25915-788c-4961-b40f-8cd959350e0e",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„‚Diese Situation hat sich zuletzt weiter verschlechtert‘, so die Gewerkschaftsvorsitzende.“"
                            },
                            {
                                "example_id": "d1b9ba47-dca4-41da-a893-33d12f649d04",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Wenn es einen Einstellungsstopp gebe und keine neuen Projekte mehr am Standort begonnen würden, sei das ein Sterben auf Raten, so die Gewerkschaftsvorsitzende.“"
                            },
                            {
                                "example_id": "76d44701-4f1d-4fb8-8069-8f5248e3c612",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Die Gewerkschaftsvorsitzende setzt auf schnellere Gerichtsentscheidungen.“"
                            },
                            {
                                "example_id": "427e4b3a-d2a9-4508-bba3-a8092b7d7241",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Die Gewerkschaftsvorsitzende Fran Drescher teilte mit, dass man eine Abmachung aushandeln wollte, \"die ausreichend die Bedürfnisse der Künstler\" abdecken würde.“"
                            },
                            {
                                "example_id": "e1a31b3c-792d-4110-82cc-ef58fd482f96",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Ein solches Zentrum mache aber nur Sinn, wenn die jeweiligen Sicherheitsbehörden auf europäischer Ebene grenzüberschreitend austauschten und zusammenarbeiteten, so die stellvertretende Gewerkschaftsvorsitzende des Bezirks Bundespolizei.“"
                            },
                            {
                                "example_id": "cb3f9106-2f9e-4b57-acc5-edaf5e75cec6",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„Die stellvertretende Gewerkschaftsvorsitzende wechselt […] den Arbeitgeber.“"
                            },
                            {
                                "example_id": "cfab9473-53f3-4375-b7bf-bf1c9a89e2a2",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„‚Es wird nur dann mehr gebaut, wenn einfacher und damit günstiger gebaut wird‘, betont die Gewerkschaftsvorsitzende.“"
                            },
                            {
                                "example_id": "5e86112b-3df4-4a32-9f73-29170a98be61",
                                "sense_id": "d4dc6639-a213-3e79-a8de-3de297f814d9",
                                "text": "„‚Eine Vier-Tage-Woche mit vollem Lohnausgleich steht aktuell nicht auf der gewerkschaftlichen Forderungsliste‘, sagte die Gewerkschaftsvorsitzende Christiane Benner der Bild-Zeitung. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
