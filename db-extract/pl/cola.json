                                                "example_id": "d4983052-9485-454d-afb2-441f2a27e4e5",
                                                "sense_id": "56fba7b6-c353-3308-8910-fce24d246765",
                                                "text": "Und ich zahl' ihr eine Cola / Und wir gehen an den Strand - (deutsches Pop-Lied)"
                                            },
                                            {
                                                "example_id": "b7153854-fd23-43ea-affc-dc9cd4809458",
                                                "sense_id": "56fba7b6-c353-3308-8910-fce24d246765",
                                                "text": "Ich hätte gern eine Cola."
                                            },
                                            {
                                                "example_id": "de0bac09-d4c0-4d12-84cc-556df1d8b6ad",
                                                "sense_id": "56fba7b6-c353-3308-8910-fce24d246765",
                                                "text": "„Der Staatsanwalt trinkt Cola und ißt ein »Mars«, die Referendare nehmen Kaffee und Käsebrötchen auf ihre Essensmarken.“"
                                            },
                                            {
                                                "example_id": "42724318-27ed-4fea-a50d-a67f8f884951",
                                                "sense_id": "56fba7b6-c353-3308-8910-fce24d246765",
                                                "text": "„Ich bestellte ein Omelett und eine Cola und aß, während ich im Bett lag und fernsah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
