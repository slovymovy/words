                    },
                    {
                        "form_id": "b5aeb12f-1208-4a81-bb46-14c30e4e7bf7",
                        "entry_id": "b7731ebc-db5a-366a-81bd-007243fa719a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vergnügungsparks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                        "entry_id": "b7731ebc-db5a-366a-81bd-007243fa719a",
                        "glosses": [
                            "größeres Gelände mit einem vielfältigen Angebot zur Freizeitgestaltung und Unterhaltung für eine große Anzahl an Besuchern (zum Beispiel Fahrgeschäfte, Verkaufstände, besondere Darbietungen und so weiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d77100-0dcf-4478-8c5f-4dd0ec31b3e1",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„Die Ferien verbrachte Olof mit Golfspielen, und ein paar wenige Male im Jahr gingen sie alle zusammen in den Vergnügungspark oder in den Zoo.“"
                            },
                            {
                                "example_id": "ad42126e-0e2f-42e6-b410-fa989c0394c0",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„Herrn Bellamys großer Vergnügungspark mit allerlei Arten von Extrabelustigungen und einem großen Theater in der Mitte lag am Rande der Stadt.“"
                            },
                            {
                                "example_id": "209917f3-cd46-414f-8d38-c70bfdacac04",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„Doch dann fiel ihm ein, dass es einen Vergnügungspark voller Achterbahnen, Junkfood und Feuerwerk-Shows gab.“"
                            },
                            {
                                "example_id": "98051374-9d7d-496f-846f-64724876d3c1",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„In Kopenhagen gibt es mit dem Tivoli einen weltbekannten und beliebten Vergnügungspark, aber das ist schließlich auch in der Hauptstadt.“"
                            },
                            {
                                "example_id": "97285848-6d3e-4729-9b1f-528ee21fbb4e",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„Im größten überdachten Vergnügungspark der Welt kann man Fahrgeschäfte mit Dinos und Superhelden erleben.“"
                            },
                            {
                                "example_id": "f72c297d-565d-4f97-9213-0df35efc3d39",
                                "sense_id": "ae054dfd-31c7-3c76-8e28-8fd0dfd3701a",
                                "text": "„Gardaland, der größte Vergnügungspark Italiens, war das erste Unternehmen dieser Art am Gardasee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
