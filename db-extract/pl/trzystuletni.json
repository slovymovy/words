                "senses": [
                    {
                        "sense_id": "eefcb5a7-e156-3bfe-b054-8c321d0c47d2",
                        "entry_id": "0972c347-c59c-3605-8f28-f0d771db4a74",
                        "glosses": [
                            "mający trzysta lat"
