                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c941c7d9-5086-41a7-9fc7-16bd740f383b",
                                                "sense_id": "7d782597-4c47-3bb0-a7c9-1171dc2dab09",
                                                "text": "Le propylée occidental de l’agora romaine a été construit entre 19 et 11 av. J.-C., et possédait une rangée de quatre colonnes ioniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb05241-4a51-3293-bab5-808989ca589d",
                                        "entry_id": "f7971eca-417c-3460-9aae-1edab29c434f",
                                        "glosses": [
                                            "Entrée monumentale, porche ou vestibule situé à l’entrée d’un temple ou d’un lieu public."
