                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6122c1e-45be-3690-8ce6-7a93cb3b733a",
                        "entry_id": "66daea77-a86a-3392-a10b-afc63ecb6101",
                        "glosses": [
                            "Verletzung, bei der ein Körperteil (zum Beispiel eine Sehne oder ein Muskel) (teilweise) gerissen ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "031226ab-3ee4-3b25-b6f9-8938350bf2ec",
                        "entry_id": "66daea77-a86a-3392-a10b-afc63ecb6101",
                        "glosses": [
                            "(an einem Material angebrachte) Markierung, die als Vorlage / Leitfaden für weitere Bearbeitungsschritte dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55fdf48-74a7-48c8-acf2-bf38098f7a9d",
                                "sense_id": "031226ab-3ee4-3b25-b6f9-8938350bf2ec",
                                "text": "„Bei vielen Maschinen wird ein Teil der Kühlluft des Motors nach vorne auf die Schnittfläche geblasen, um Sägespäne zu entfernen, so dass der „Anriss“ sichtbar bleibt.“"
                            },
                            {
                                "example_id": "9a16c550-7273-4113-b75b-051cfbfa60d8",
                                "sense_id": "031226ab-3ee4-3b25-b6f9-8938350bf2ec",
                                "text": "„Einlasseckenhobel haben einen schmalen Hobelkörper. Durch das lange, offene Hobelmaul wird das Arbeiten am Anriss erleichtert.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
