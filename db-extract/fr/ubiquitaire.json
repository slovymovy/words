                "word": "ubiquitaire",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "76516413-b38c-46c5-8fd1-b6a149f6d393",
                        "entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "ubiquitaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "389a1460-2068-351e-b8e8-81c7562afc69",
                        "entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "glosses": [
                            "Qui possède ou semble posséder le don d’ubiquité ; qui est présent partout à la fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c57b654-c559-4d94-8093-271982eeae03",
                                "sense_id": "389a1460-2068-351e-b8e8-81c7562afc69",
                                "text": "Quand il est sorti de nous, le pauvre mot qui flottait auparavant dans les limbes ténébreux du Disponible, il devient aussitôt agile, vagabond et irréparable. Ubiquitaire par sa nature, il s’élance de tous les côtés à la fois, agissant avec la force plénière de son origine d’En Haut, car les mots ne sont pas de l’homme."
                            },
                            {
                                "example_id": "a987b6fa-f257-4288-9c5d-aed230974d93",
                                "sense_id": "389a1460-2068-351e-b8e8-81c7562afc69",
                                "text": "Il y avait pour eux tous, c’est clair, une noblesse du métier de chauffeur, dévorateur de grands espaces, être d’ici et d’ailleurs, ubiquitaire et souverain."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bbce31b-4e35-3b32-a49d-71ab6af3b05f",
                        "entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "glosses": [
                            "Que l’on trouve n’importe où."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "90ed52d4-3932-4840-845e-1cc5e184c100",
                                "sense_id": "0bbce31b-4e35-3b32-a49d-71ab6af3b05f",
                                "text": "Liée à certains cancers (rein, testicules, foie, pancréas, utérus), à des perturbations des systèmes hormonaux et immunitaires, ou encore à des problèmes cardiovasculaires et des troubles de la fertilité, la famille des PFAS – 14 000 membres au bas mot – constitue une menace ubiquitaire pour l’espèce humaine."
                            }
                        ]
                    },
                    {
                        "sense_id": "752c2008-b40e-339f-b5be-7793a2c01549",
                        "entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "glosses": [
                            "Qualifie un être vivant dont l’aire de répartition est très étendue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7549108a-a66f-30d7-a160-75a5eb9cb78f",
                        "entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "glosses": [
                            "Qualifie une molécule pouvant se trouver dans tous les différents types de cellules d'un être vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ce18bd7-1825-490f-af69-1fcadc7e39ec",
                                "sense_id": "7549108a-a66f-30d7-a160-75a5eb9cb78f",
                                "text": "Les facteurs de croissance FGF1 et FGF2 sont ubiquitaires et multifonctionnels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80b66be5-bcc2-44e9-9012-13938d6996a2",
                        "source_entry_id": "8e69fe64-2228-3358-9352-0a7cb08c2725",
                        "source_sense_id": "389a1460-2068-351e-b8e8-81c7562afc69",
                        "source_sense_description": "Qui possède ou semble posséder le don d’ubiquité.",
                        "target_lang_word": "ubiquitous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ubiquitous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e964613-b452-3006-b03e-85b348af8da5",
                                        "entry_id": "0b5237f7-dbd9-3199-8759-344579f92bec",
                                        "glosses": [
                                            "Being everywhere at once: omnipresent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31a7d3da-edd7-4dc0-ab7c-110bfafa8060",
                                                "sense_id": "0e964613-b452-3006-b03e-85b348af8da5",
                                                "text": "In Christianity, Hinduism, and Judaism, God is ubiquitous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308be6e5-7be5-38eb-8f32-790a92312c03",
                                        "entry_id": "0b5237f7-dbd9-3199-8759-344579f92bec",
                                        "glosses": [
                                            "Appearing to be everywhere at once; being or seeming to be in more than one location at the same time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508734df-94dc-4189-a1f2-7337a00648e5",
                                                "sense_id": "308be6e5-7be5-38eb-8f32-790a92312c03",
                                                "text": "One of the wild suggestions referred to, as at last coming to be linked with the White Whale in the minds of the superstitiously inclined, was the unearthly conceit that Moby Dick was ubiquitous; that he had actually been encountered in opposite latitudes at one and the same instant of time."
                                            },
                                            {
                                                "example_id": "89d428c4-d987-44a4-aea3-33d4848613b4",
                                                "sense_id": "308be6e5-7be5-38eb-8f32-790a92312c03",
                                                "text": "There is much sad evidence, too, of the spoliation and dereliction of vanished industry: tips, slag-heaps and derelict colliery-screens among which the ubiquitous, nomad mountain sheep graze unconcernedly."
                                            },
                                            {
                                                "example_id": "332d3f22-d45b-43cb-9648-0cc9eca5c792",
                                                "sense_id": "308be6e5-7be5-38eb-8f32-790a92312c03",
                                                "text": "This deed accomplished, life no longer suffers hopelessly under the terrible mutilations of ubiquitous disaster, battered by time, hideous throughout space; but with its horror visible still, its cries of anguish still tumultuous, it becomes penetrated by an all-suffusing, all-sustaining love, and a knowledge of its own unconquered power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc2de8a9-ecd6-3d22-8c72-8c73a338bcfe",
                                        "entry_id": "0b5237f7-dbd9-3199-8759-344579f92bec",
                                        "glosses": [
                                            "Widespread; very prevalent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
