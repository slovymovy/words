                "translations": [
                    {
                        "translation_id": "97e92c5f-0be3-4fc2-8739-ddfbe386937f",
                        "source_entry_id": "2be1137f-0f13-380a-a38b-4c0ca12489b8",
                        "source_sense_id": "50927903-33e6-33a3-a060-9dae0651743c",
                        "target_lang_word": "verbena",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbena",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a53e306e-2997-38aa-9def-979b5ffb75fa",
                                        "entry_id": "f7c7d2c0-a711-311e-8b76-c238253f30c0",
                                        "glosses": [
                                            "Verbena, a genus of herbaceous plants of which several species are extensively cultivated for the great beauty of their flowers; vervain."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "527f7818-ffb7-439e-9c14-663ab98aac49",
                                                "sense_id": "a53e306e-2997-38aa-9def-979b5ffb75fa",
                                                "text": "Linda pulled a piece of verbena and crumpled it, and held her hands to her mother. -"
                                            },
                                            {
                                                "example_id": "5228fc05-83d3-4c9e-a837-492b78399647",
                                                "sense_id": "a53e306e-2997-38aa-9def-979b5ffb75fa",
                                                "text": "Hidden behind a large stone urn full of verbena, Dottie watched as her enemy greeted Johnny at the door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ce2029a-5112-41c7-9c02-bb5b8a4eaf10",
                        "source_entry_id": "2be1137f-0f13-380a-a38b-4c0ca12489b8",
                        "source_sense_id": "50927903-33e6-33a3-a060-9dae0651743c",
                        "target_lang_word": "vervain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vervain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb21b7b6-3877-3910-a568-c8b90d78f969",
                                        "entry_id": "7284572b-a4ae-37a2-912c-288ebe08f7df",
                                        "glosses": [
                                            "Any herbaceous plant in the genus Verbena especially if used for medicinal purposes, primarily Verbena officinalis, common in Europe and formerly held to have medicinal properties."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe437d7-5b6e-4b27-9ba3-a6ceab87eab1",
                                                "sense_id": "cb21b7b6-3877-3910-a568-c8b90d78f969",
                                                "text": "The Yarrow, where-with-all he stops the wound-made gore:\nThe healing Tutsan then, and Plantan for a sore.\nAnd hard by them againe he holy Vervaine finds,\nWhich he about his head that hath the Megrim binds."
                                            },
                                            {
                                                "example_id": "277a8970-d076-4dfc-b6c3-5ad6343c9c54",
                                                "sense_id": "cb21b7b6-3877-3910-a568-c8b90d78f969",
                                                "text": "The candlesticks were surrounded by wreaths of vervain[.]"
                                            },
                                            {
                                                "example_id": "954d1865-72a5-4316-9963-c4f28b64c7b3",
                                                "sense_id": "cb21b7b6-3877-3910-a568-c8b90d78f969",
                                                "text": "Tobacco and the plant valerian are also considered to be anaphrodisiac in their effects, diminishing sexual inclination. Also vinegar, dried coriander, potassium bromide, cocaine, vervain, acid drinks, lemonade."
                                            },
                                            {
                                                "example_id": "7dc3315b-0607-4279-b150-772682254076",
                                                "sense_id": "cb21b7b6-3877-3910-a568-c8b90d78f969",
                                                "text": "There were bunches of wild garlic to keep out evil spirits, foxgloves for healing spells and hemlock and vervain for darker magic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4605fb72-4238-41cc-8557-f33fedf81293",
                        "source_entry_id": "2be1137f-0f13-380a-a38b-4c0ca12489b8",
                        "source_sense_id": "50927903-33e6-33a3-a060-9dae0651743c",
                        "target_lang_word": "Verbene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
