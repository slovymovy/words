                                            {
                                                "example_id": "9590c3b8-a258-46d8-b3f1-9dcf474de1bc",
                                                "sense_id": "6a9fcf7a-1e9a-358e-ade3-a9b89f3c24c1",
                                                "text": "With what different feelings did he now put foot in stirrup to the last time when he sprung to horse?"
