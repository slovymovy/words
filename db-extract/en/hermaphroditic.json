    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0f97ff8c-dee3-349b-9900-8708d2a0929b",
                "word": "hermaphroditic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0484fd5-6172-3d61-a7af-03710a1f4164",
                        "entry_id": "0f97ff8c-dee3-349b-9900-8708d2a0929b",
                        "glosses": [
                            "Of or pertaining to hermaphrodism; being a hermaphrodite."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c4ffa95d-6734-3a7b-bfe1-35995323b61c",
                        "entry_id": "0f97ff8c-dee3-349b-9900-8708d2a0929b",
                        "glosses": [
                            "Possessing the reproductive organs of both sexes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f94b6a6-9661-4742-a27c-5e234a981b21",
                        "source_entry_id": "0f97ff8c-dee3-349b-9900-8708d2a0929b",
                        "source_sense_description": "of or pertaining to hermaphrodism",
                        "target_lang_word": "hermaphrodite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hermaphrodite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c34092-33f4-3e21-bdb4-55fab17f1ff8",
                                        "entry_id": "0cb953fc-d222-305a-933f-1084f9b97768",
                                        "glosses": [
                                            "Qui possède à la fois des organes mâles et femelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea2bfc5-792e-45d1-984f-2acf47762d1d",
                                                "sense_id": "a6c34092-33f4-3e21-bdb4-55fab17f1ff8",
                                                "text": "Les mots de bissexuel et d’unisexuel, d’hermaphrodite et d’androgyne, de monoïque et de dioïque, de polygame et de dichogame… etc., n’atteignent guère jusqu’à la subtilité des distinctions qui demanderaient à être faites."
                                            },
                                            {
                                                "example_id": "58c3cac1-fa83-41b0-8a70-a1c4520a0149",
                                                "sense_id": "a6c34092-33f4-3e21-bdb4-55fab17f1ff8",
                                                "text": "Les escargots et les vers de terre sont hermaphrodites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8238b7c-8dc0-3841-8fc2-0d9c8ec9bdd2",
                                        "entry_id": "0cb953fc-d222-305a-933f-1084f9b97768",
                                        "glosses": [
                                            "Qualifie une fleur qui possède à la fois des étamines et un ou plusieurs pistils. Se dit aussi de la plante qui possède de telles fleurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2f3d52-ee3a-4a17-aa95-5796ec6c846a",
                                                "sense_id": "f8238b7c-8dc0-3841-8fc2-0d9c8ec9bdd2",
                                                "text": "Une dernière chose : le cognassier est hermaphrodite. Il se fait des fruits tout seul. Donc, tu n’as pas besoin de lui chercher une copine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hermaphrodite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e03c7bd3-96aa-3ba1-8e9f-b66e302c46ea",
                                        "entry_id": "834fd77b-eed2-397b-aad0-dd5eeef20835",
                                        "glosses": [
                                            "Être qui réunit certains caractères des deux sexes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16e73db3-5e84-4fa5-abe7-2922dc229c58",
                                                "sense_id": "e03c7bd3-96aa-3ba1-8e9f-b66e302c46ea",
                                                "text": "— Un homme de ce calibre peut-il exister ? balbutia le baron abasourdi, entraîné dans une région inconnue où l’interversion semblait être le seul régime admis.\n— Il existe, mon ami, et ce n’est pas même un hermaphrodite, pas même un impuissant, c’est un beau mâle de vingt et un ans, dont l’âme aux instincts féminins s’est trompée d’enveloppe."
                                            },
                                            {
                                                "example_id": "10120026-4ebb-40e8-96f1-373ebf0522b9",
                                                "sense_id": "e03c7bd3-96aa-3ba1-8e9f-b66e302c46ea",
                                                "text": "Mais en dehors de ces lieux d’expression, le silence reste généralement de mise. Qui connaît autour de soi un intersexe, un hermaphrodite, une femme XY, une petite fille « virilisée » à la naissance ? Personne. Et pourtant, il y en a dans notre entourage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e75195-b04b-3b47-a430-92ada47f0cb3",
                                        "entry_id": "834fd77b-eed2-397b-aad0-dd5eeef20835",
                                        "glosses": [
                                            "Personne qui présente un mélange de genres."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef002d35-7119-45ef-8c99-599e7a81309e",
                                                "sense_id": "f3e75195-b04b-3b47-a430-92ada47f0cb3",
                                                "text": "Les princes dont parle Machiavel ne sont proprement que des hermaphrodites de souverains et de particuliers; ils ne jouent le rôle de souverain que sur un trop petit théâtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a91031a-22c1-3164-887f-ebff5e714b06",
                                        "entry_id": "834fd77b-eed2-397b-aad0-dd5eeef20835",
                                        "glosses": [
                                            "Animal ou plante qui a les organes reproducteurs des deux sexes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd32ca4a-fd39-4e9a-b73d-b14b965c0a2d",
                                                "sense_id": "1a91031a-22c1-3164-887f-ebff5e714b06",
                                                "text": "L’androdiécie fonctionne de la même façon avec une fréquence de mâles égale à (f♂-2)/2(f♂–1), avec f♂ la fertilité mâle des hermaphrodites dans une population où les hermaphrodites s’allofécondent. En revanche, contrairement au cas précédent, l’autofécondation des hermaphrodites ne favorise pas directement la présence de mâles, […]."
                                            },
                                            {
                                                "example_id": "f4962923-4bf8-4a13-93e9-6cb1b27a3c7c",
                                                "sense_id": "1a91031a-22c1-3164-887f-ebff5e714b06",
                                                "text": "Les vers de terre et les escargots sont hermaphrodites."
                                            },
                                            {
                                                "example_id": "443f2c60-bc19-4690-91d7-c8cf94d53306",
                                                "sense_id": "1a91031a-22c1-3164-887f-ebff5e714b06",
                                                "text": "Le jasmin, la valériane, l’épine-vinette et un très grand nombre d’autres plantes sont hermaphrodites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ebe3947-69c5-3258-aba5-b1eeea66b17a",
                                        "entry_id": "834fd77b-eed2-397b-aad0-dd5eeef20835",
                                        "glosses": [
                                            "Certaines figures généralement couchées où se trouvent réunies et combinées les formes de l’homme et de la femme."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2645a849-18af-4143-9fe6-d8b3e5e51ecc",
                                                "sense_id": "9ebe3947-69c5-3258-aba5-b1eeea66b17a",
                                                "text": "L’Hermaphrodite du Louvre, du Vatican."
                                            },
                                            {
                                                "example_id": "375ae2c5-8cff-408e-a144-1b672571a6f5",
                                                "sense_id": "9ebe3947-69c5-3258-aba5-b1eeea66b17a",
                                                "text": "Ne demandez pas au gardien de salle pourquoi l’hermaphrodite a des couilles et des tétons. Cette question n’est pas de sa compétence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
