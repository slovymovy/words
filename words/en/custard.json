    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6d51240-457b-3b0e-a677-cafce855f6fb",
                    "sense_definition": "A sweet or savoury sauce made from milk or cream and eggs, thickened by heat and used in desserts or dishes like quiche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "custard_sauce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She poured warm <w>custard</w> over the apple pie before serving it.",
                            "target_lang_translations": {
                                "pl": "Przed podaniem polała szarlotkę ciepłym <w>sosem angielskim</w>."
                            }
                        },
                        {
                            "text": "The traditional recipe requires slowly heating eggs and cream to make a smooth <w>custard</w>.",
                            "target_lang_translations": {
                                "pl": "Tradycyjny przepis wymaga powolnego podgrzewania jajek i śmietanki, aby uzyskać gładki <w>krem</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "egg custard"
                    ],
                    "common_phrases": [
                        "egg custard",
                        "baked custard"
                    ],
                    "target_lang_definitions": {
                        "pl": "Słodki lub wytrawny sos/krem przygotowywany z mleka lub śmietanki i jajek, zagęszczany na ciepło, stosowany w deserach lub potrawach takich jak quiche."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "krem jajeczny",
                                "target_lang_sense_clarification": "tradycyjny krem na bazie mleka i żółtek"
                            },
                            {
                                "target_lang_word": "sos angielski",
                                "target_lang_sense_clarification": "płynny krem waniliowy na żółtkach (crème anglaise)"
                            },
                            {
                                "target_lang_word": "custard",
                                "target_lang_sense_clarification": "określenie zapożyczone z języka angielskiego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5e4f0e8-f620-3a60-9921-9ffb1d938a40",
                    "sense_definition": "A sweet sauce made from milk thickened with starch or custard powder rather than eggs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "custard_sauce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He prepared a bowl of instant <w>custard</w> using cornflour and milk.",
                            "target_lang_translations": {
                                "pl": "Przygotował miskę <w>budyniu</w> instant, używając mąki kukurydzianej i mleka."
                            }
                        },
                        {
                            "text": "Stir the <w>custard</w> continuously in the saucepan so it does not form lumps.",
                            "target_lang_translations": {
                                "pl": "Mieszaj <w>budyń</w> w rondelku bez przerwy, aby nie powstały grudki."
                            }
                        }
                    ],
                    "common_phrases": [
                        "custard powder"
                    ],
                    "target_lang_definitions": {
                        "pl": "Słodki sos lub deser przygotowywany z mleka zagęszczonego skrobią lub proszkiem budyniowym zamiast jajek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "budyń",
                                "target_lang_sense_clarification": "deser na bazie mleka i skrobi"
                            },
                            {
                                "target_lang_word": "sos budyniowy",
                                "target_lang_sense_clarification": "płynniejsza wersja budyniu do polewania"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
