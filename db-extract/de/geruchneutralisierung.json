                ],
                "senses": [
                    {
                        "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                        "entry_id": "6a6f0a4b-879e-37a9-8d56-ae2d18576b30",
                        "glosses": [
                            "das Beseitigen/Neutralisieren von wahrnehmbaren Gerüchen in der Luft"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4969284c-bf44-4b79-91b1-19740efb9845",
                                "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                                "text": "„Sie schützen vor Pollenflug und weitgehend vor Dieselabgasen. Integriert man in ihnen Beutel mit Aktivkohle, dann ist auch eine Geruchneutralisierung möglich.“"
                            },
                            {
                                "example_id": "a0b1eeed-88bc-4bf6-a4c7-d624665ac9a3",
                                "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                                "text": "„Da aber andererseits nach Inhalation des größten Teiles der übrigen der geprüften Geruchstoffe eine Minderung der Geruchintensität beobachtet wurde, glaubt R. W. Moncrieff auch in diesem Fall eine Geruchneutralisierung […] annehmen zu müssen […].“"
                            },
                            {
                                "example_id": "2ec6558c-2d7c-426a-896b-a900e3b8752c",
                                "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                                "text": "„Sie wünschen eine besonders schnelle und effektive Geruchneutralisierung? Dank modernster Ozonisierungsverfahren gelingt die Geruchsbeseitigung besonders schnell und effektiv.“"
                            },
                            {
                                "example_id": "d7463526-3f86-4526-aafa-a269360c7837",
                                "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                                "text": "„Die Gesellschaft bezweckt die Planung und Realisation sowie den Unterhalt von Anlagen und Geräten zur Geruchneutralisierung und Luftdesinfektion, sowie den Handel mit den dazugehörenden Geräten, Zubehör und Anlageteilen.“"
                            },
                            {
                                "example_id": "f2cc5138-9080-4180-896c-913b8ae8924f",
                                "sense_id": "df7c46cd-d9ff-300c-8f80-bea30b170973",
                                "text": "„Sie können bei uns die komplette Bandbreite einer Premium Aufbereitung abrufen oder aber auch nur einzelne, nach Ihrem Wunsch auszuführende Arbeitsgänge, wie Innenraumpflege, Geruchneutralisierung oder Lackaufbereitung, ausführen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
