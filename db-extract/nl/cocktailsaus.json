                "senses": [
                    {
                        "sense_id": "41f87b89-d443-366d-934b-224697ecec5d",
                        "entry_id": "68579d57-39fc-3686-b736-4d3e3cf50db7",
                        "glosses": [
                            "saus gemaakt van lobbig geslagen ongezoete room, ketchup, paprikapoeder, sherry, cognac, gembersiroop, citroensap, peper en zout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f4a761-8f62-403b-bb6a-b52bc2b36347",
                                "sense_id": "41f87b89-d443-366d-934b-224697ecec5d",
                                "text": "Pulled pork, shoarma of kroket. Met een beetje fantasie (of cocktailsaus) kun je overal wel een snack voor Koningsdag van maken. Al die extra standjes op de vrijmarkt leveren wel extra werk op voor de inspecteurs van de Nederlandse Voedsel- en Warenautoriteit."
                            },
                            {
                                "example_id": "bda97e60-9e64-4d10-9d9f-bc394e97a00e",
                                "sense_id": "41f87b89-d443-366d-934b-224697ecec5d",
                                "text": "Voor het lezersmenu kunnen de gasten terecht in de sfeervolle Jachtkamer, terwijl ook de Brasserie en Gelagkamer worden gebruikt. De verwelkoming is met een amuse: bitterbal van risotto met een cocktailsaus."
                            },
                            {
                                "example_id": "217912db-308a-4c8b-be3f-e8f0ea0f504b",
                                "sense_id": "41f87b89-d443-366d-934b-224697ecec5d",
                                "text": "We vinden het steeds leuker om ambachtelijk te barbecueën. De meesters van het vak, maar ook de hobbykoks, gaan dit jaar met verfijnde rooktechnieken aan de slag. Ook wijkt de standaard cocktailsaus vaker voor allerlei zelfgemaakte sausjes. Naast sausjes kun je ook allerlei bijgerechten bereiden in pannetjes op de grill."
                            }
                        ]
                    }
