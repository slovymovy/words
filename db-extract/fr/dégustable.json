                        "glosses": [
                            "Qui peut être dégusté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f71263-a274-41ae-bb1c-38c7731797ef",
                                "sense_id": "1354f45b-cef3-36fd-8955-ab62d9e914f9",
                                "text": "Le tableau doit sa fortune moins de correspondre à un sommet de l’académisme que d’être le premier nu absolument consommable. Huysmans parlera d’une « Vénus à la crème ». Voici l’idéal dégustable à la petite cuillère."
                            },
                            {
                                "example_id": "a138bfbe-7422-4a7f-838d-d2310f7bfe66",
                                "sense_id": "1354f45b-cef3-36fd-8955-ab62d9e914f9",
                                "text": "En collaboration avec le Centre national d’études spatiales (CNES) et la marque Mumm, il a ainsi conçu la toute première bouteille de champagne ouvrable, servable et dégustable en orbite."
                            },
                            {
                                "example_id": "d28d04f8-f0b4-431c-a981-f847b2972224",
                                "sense_id": "1354f45b-cef3-36fd-8955-ab62d9e914f9",
                                "text": "« Presque tout ce qui est en vente à la cave est dégustable au verre », précise Elisa Simon."
                            }
                        ]
                    }
