                                            {
                                                "example_id": "42a95e2d-2099-41b6-8ca8-dd7d631e78dc",
                                                "sense_id": "a98dbea9-3aeb-37d2-9919-6ede87c3954f",
                                                "text": "Wer sich während einer Seereise an Bord eines deutschen Schiffes außerhalb eines inländischen Hafens befindet, kann ein Testament durch mündliche Erklärung vor drei Zeugen nach § 2250 Abs. 3 errichten."
                                            },
                                            {
                                                "example_id": "35eafc00-89a5-4f7c-aacc-73fa73d61a81",
                                                "sense_id": "a98dbea9-3aeb-37d2-9919-6ede87c3954f",
                                                "text": "„Nach einer intensiven mündlichen Phase der Meinungsbildung zu verschiedenen Fragen des Lernens und der Schule konfrontierte die Versuchsleiterin die Klassen mit ihrer Meinung zur Schulpflicht…“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67309f77-507b-421e-ba2e-ecc08f1e8a5b",
                        "source_entry_id": "e63a948b-2f07-3804-956e-391d644325cb",
                        "source_sense_id": "bd843bb0-1f09-37f4-becb-de493df8dd6f",
                        "target_lang_word": "verbal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                        "entry_id": "d14a1007-431a-3b64-aec1-e21180e4db5c",
                                        "glosses": [
                                            "mit Worten, mit Hilfe der mündlichen oder schriftlichen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "886d568e-f02b-45bd-8fcc-16865d95403f",
                                                "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                                "text": "Es kam zu einer heftigen verbalen Auseinandersetzung."
                                            },
                                            {
                                                "example_id": "83f4167b-5dda-4657-b1d7-56e40f780b1f",
                                                "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                                "text": "„Der weise Hang zu verbaler Sparsamkeit betrifft selbst elementarste Höflichkeitsformeln.“"
                                            },
                                            {
                                                "example_id": "74aecfe1-cae8-45d8-944c-ab07953a7d29",
                                                "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                                "text": "„Bei der schriftlichen Erklärung handelt es sich zumeist um eine verbale Note“"
                                            },
                                            {
                                                "example_id": "8e7f553d-27d1-494a-b304-9af805100d31",
                                                "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                                "text": "„Da wird eine verbale Äußerung ersetzt oder, wenn sie hinzukommt, kommt sie wirklich nur noch hinzu.“"
                                            },
                                            {
                                                "example_id": "d13b7b62-ff85-488e-bba4-1de0629a559f",
                                                "sense_id": "b79800b3-fb7d-3027-a5aa-99f1b2ce1bfe",
                                                "text": "„In den ersten vier Jahren gibt es verbale Beurteilungen, Noten sind erst ab Klasse sieben Pflicht, dazwischen besteht Wahlfreiheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09a975af-edb6-3080-9498-84093f88a690",
                                        "entry_id": "d14a1007-431a-3b64-aec1-e21180e4db5c",
                                        "glosses": [
                                            "unter Beteiligung eines Verbs, nach Art eines Verbs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49677cf4-acc5-4c23-af5a-173e92a2c5d3",
                                                "sense_id": "09a975af-edb6-3080-9498-84093f88a690",
                                                "text": "In Erzählungen wird eher ein verbaler als ein nominaler Stil gepflegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
