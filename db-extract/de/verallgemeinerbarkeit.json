                ],
                "senses": [
                    {
                        "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                        "entry_id": "a9c18ff9-2b83-3049-a350-e009eaa5e709",
                        "glosses": [
                            "Möglichkeit zur Pauschalisierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f48fee6-ea85-42c8-bc3a-a6dfd4b6b7c9",
                                "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                                "text": "„Und Honneths Denken führt nach Ehrenberg weiter, weil es zwar vom Individuum ausgeht, aber auf der universalen Vernunft und der Verallgemeinerbarkeit ihrer Prinzipien beruht.“"
                            },
                            {
                                "example_id": "87ed429d-5022-4f1f-b36a-786ab7e1ac0d",
                                "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                                "text": "„Ganz einfach, sagen Schulmeisters Forscherkollegen: Seine Daten seien nicht repräsentativ, teilgenommen hätten ein paar Hundert Studenten aus einer Handvoll Studiengänge, die auch noch aufgrund der persönlichen Initiative ihrer Studiengangsleiter bei der Untersuchung mitgemacht hätten, da sei die Verallgemeinerbarkeit schon arg begrenzt.“"
                            },
                            {
                                "example_id": "fa151174-5a7b-4222-a5ed-bea0d341811b",
                                "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                                "text": "„Beide Leitbilder sind an die Grenzen der gesellschaftlichen Verallgemeinerbarkeit, Zukunfts- und Zustimmungsfähigkeit gestoßen.“"
                            },
                            {
                                "example_id": "735561ff-4d3c-47f5-a8d0-5d8a3322f1e8",
                                "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                                "text": "„Diese Ergebnisse müssen sicher sorgfältig auf ihre Verallgemeinerbarkeit hin geprüft werden. “"
                            },
                            {
                                "example_id": "7da5d18e-da52-42ce-be44-2c75f5350a66",
                                "sense_id": "8c4a067b-d675-3d07-9f50-f70746f5fb15",
                                "text": "„Wie beispielhaft für uns alle wäre das gewesen: Da setzt sich der Christian Enzensberger hin und versucht – so, wie er das gerade vermag – zusammenzutragen, was er bisher über seine Rolle als Professor für Anglistik, über seine und seiner Zunftgenossen Vorgehensweisen und Wirkungen, über ihren Arbeitsgegenstand Literatur in Werk und Funktion erfahren hat; um die Verallgemeinerbarkeit solcher Erfahrungen brauchte er sich keine Gedanken zu machen; die ergäbe sich von selbst für diejenigen, die sich in ähnlicher Lage befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
