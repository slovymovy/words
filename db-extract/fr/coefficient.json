                ],
                "senses": [
                    {
                        "sense_id": "99a5eba8-eb48-3d5a-9b32-7cfb9f6af0d4",
                        "entry_id": "e44b2b6b-1e46-33b5-a033-8739c69e66ba",
                        "glosses": [
                            "Efficient, qui produit un effet."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e4658cec-f984-4a48-b04b-e5c202161e23",
                                "sense_id": "99a5eba8-eb48-3d5a-9b32-7cfb9f6af0d4",
                                "text": "Il est, à certaines époques, des noms, des institutions, des pouvoirs à qui l’on prête tous les malheurs, à qui l’on dénie leurs talents, et qui servent de raison coefficiente aux sots."
                            }
                        ]
                    }
                ],
