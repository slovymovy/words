                ],
                "senses": [
                    {
                        "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                        "entry_id": "2f9ead46-ad96-3fc0-8b6d-bd5c9dc915de",
                        "glosses": [
                            "Dont la température interne est indépendante de celle de l’environnement, en parlant d’un animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27589a42-c945-41d9-8b5d-a5747009ac64",
                                "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                                "text": "Et ces résultats ne sont pas étonnants, selon les chercheurs, car ils suivent la règle de Bergmann. Ce principe, en zoologie, corrèle la température de l’environnement avec la masse du corps chez les animaux homéothermes – ceux dont la température reste constante."
                            },
                            {
                                "example_id": "be5236b8-cc10-4be7-b48d-5f4f94db49d9",
                                "sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                                "text": "Les mammifères sont homéothermes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "060aa097-c996-4790-a316-5e9479eaa68a",
                        "source_entry_id": "2f9ead46-ad96-3fc0-8b6d-bd5c9dc915de",
                        "source_sense_id": "b62ecf43-6db6-3cfc-9c77-71dc98d23420",
                        "target_lang_word": "homoiotherm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homoiotherm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc7bd40-3e40-34fc-9e12-7b21b9384662",
                                        "entry_id": "1d63112d-de59-3b1d-ad6d-d289d774a98e",
                                        "glosses": [
                                            "seine Körpertemperatur konstant haltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "691f64c5-8121-44ef-a3ce-d327c34a812a",
                                                "sense_id": "9dc7bd40-3e40-34fc-9e12-7b21b9384662",
                                                "text": "„Die Begriffe homoiotherm und endotherm werden of synonym gebracht, ebenso poikilotherm und ektotherm.“"
                                            },
                                            {
                                                "example_id": "31fcf849-58e4-4549-9be0-5b5211900c05",
                                                "sense_id": "9dc7bd40-3e40-34fc-9e12-7b21b9384662",
                                                "text": "„Igel, Fledermaus, Murmeltier, Hamster, Monotremen zeigen während ihres Winterschlafes physiologische Hypothermie, sie sind dann poikilo-, im Sommer aber homoiotherm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
