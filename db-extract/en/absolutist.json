                "senses": [
                    {
                        "sense_id": "4faced39-89a5-313d-94fb-ded7d7af0171",
                        "entry_id": "620bb1f5-ed37-38d6-b398-a44b061f1fb6",
                        "glosses": [
                            "Of or pertaining to absolutism; arbitrary; despotic; uncompromising."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4639d0be-300e-4c04-aeb3-8b6e2055126c",
                                "sense_id": "4faced39-89a5-313d-94fb-ded7d7af0171",
                                "text": "The best and the worst features of the communal regime are illustrated in the resistance of the Lombard cities to Frederic Barbarossa, the first Emperor who formulated and applied to Italy a scheme of absolutist government."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af7ee822-aa3f-48e7-a331-9a545cda153f",
                        "source_entry_id": "620bb1f5-ed37-38d6-b398-a44b061f1fb6",
                        "source_sense_id": "4faced39-89a5-313d-94fb-ded7d7af0171",
                        "source_sense_description": "of or pertaining to absolutism",
                        "target_lang_word": "absolutistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolutistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3187403c-7f93-3d73-a39f-bee2a82dbf4b",
                                        "entry_id": "cc237103-f51f-3ecb-a055-8bfbd902a504",
                                        "glosses": [
                                            "den Absolutismus betreffend, zum Absolutismus gehörend, in der Art des Absolutismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65724bb-2185-4a02-ad5b-ad67ba17acf8",
                                                "sense_id": "3187403c-7f93-3d73-a39f-bee2a82dbf4b",
                                                "text": "„Er war kein Demokrat, sondern ein barocker Mensch des 17. Jahrhunderts und Anhänger der absolutistischen Monarchie.“"
                                            },
                                            {
                                                "example_id": "48f69039-553e-46c3-b463-ca378c1c80a9",
                                                "sense_id": "3187403c-7f93-3d73-a39f-bee2a82dbf4b",
                                                "text": "„Die Jakobinerherrschaft zeigt, dass auch eine Demokratie vor Volksverführern nicht geschützt ist. Zumal in Krisensituationen können sie einen Massenrausch erzeugen und darüber einen Einfluss gewinnen, der dem eines absolutistischen Herrschers gleichkommt: so Lenin nach der demoralisierenden Niederlage der Russen bei Tannenberg 1914, so Hitler nach der Weltwirtschaftskrise und der Massenarbeitslosigkeit um 1930, so George W. Bush nach Nine Eleven, den Anschlägen vom 11. September 2001, die ja auch »von Männern gemacht« worden waren.“"
                                            },
                                            {
                                                "example_id": "17b9293a-2ace-4087-8756-74e2b5133dc2",
                                                "sense_id": "3187403c-7f93-3d73-a39f-bee2a82dbf4b",
                                                "text": "„Doch der britische Premierminister William Pitt, der befürchtete, dass König George III., der ohnehin absolutistische Neigungen hatte, sich mit den Einkünften aus Bengalen von der Kontrolle des britischen Parlaments emanzipieren könnte, lehnte den Plan ab, und Clive durfte die «Diwani» zunächst nicht übernehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
