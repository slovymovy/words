                        "source_sense_id": "90dc55b1-1f94-332d-9b67-ff320e3bd868",
                        "source_sense_description": "Glasscheibe in einem Fahrzeug, die nach hinten gerichtet ist",
                        "target_lang_word": "lunette arrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lunette arrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbc2a89d-14ef-340c-8ded-a8409a96210e",
                                        "entry_id": "2fb8294d-21e1-34a0-90b4-46855d56e678",
                                        "glosses": [
                                            "Fenêtre arrière d'un automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2364a1e-cc61-4d1c-a78e-e5b40d47d742",
                                                "sense_id": "cbc2a89d-14ef-340c-8ded-a8409a96210e",
                                                "text": "Mararu vit disparaître alors le visage en larmes de Wanda et sa petite main qui s'agitait à la lunette arrière."
                                            },
                                            {
                                                "example_id": "44e2f84e-9224-4526-8ef1-5804dde1eec6",
                                                "sense_id": "cbc2a89d-14ef-340c-8ded-a8409a96210e",
                                                "text": "Lucien hésita avant que les deux cartouches suivantes n’arrivent dans les tubes de son flingot juste à temps pour faire exploser la lunette arrière du véhicule qui s’évanouit dans la fumée, laissant sur le quai le moteur hors-bord marqué d’impacts de chevrotine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
