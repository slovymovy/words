                                        "glosses": [
                                            "ten, který je v určitém vztahu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc4cf9a-9dda-46a8-afe9-bb66f7048943",
                                                "sense_id": "96cfad93-964b-34c4-825d-6f27f91c99c0",
                                                "text": "V rejstříku knihy si lze u hesla vyhledat odpovídající stranu."
                                            }
