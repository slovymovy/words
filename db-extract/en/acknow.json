                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2f072189-edd0-451d-a9f8-187d11d8b579",
                                "sense_id": "5dcdff90-de05-3f26-921d-d2855451eda4",
                                "text": "You will not be acknown, sir; why, 'tis wise.\nThus do all gamesters, at all games, dissemble:\nNo man will seem to win."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4444434-a4b7-3512-a0be-dba1920dfbb7",
                        "entry_id": "b8a7ee50-9d55-3ff3-abe8-314ca4009e0e",
                        "glosses": [
                            "To acknowledge; confess (often with \\\"of\\\" or \\\"on\\\"), reveal, disclose, realize"
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "adaa624c-81d1-4c71-a9fa-00de975ab002",
                                "sense_id": "b4444434-a4b7-3512-a0be-dba1920dfbb7",
                                "text": "We say of a stubborn body that standeth still in the denying of his fault, This man will not acknowledge his fault, or, He will not be acknown of his fault."
                            },
                            {
                                "example_id": "40fcc8c1-43ac-401d-8b6b-3186ffd713aa",
                                "sense_id": "b4444434-a4b7-3512-a0be-dba1920dfbb7",
                                "text": "Three years in his employment a secret agent in the Post Office Department, who obtained for him the first knowledge of the star route frauds, and placed it at his disposal before it Acknown to be suspected by either the public or the Government."
                            }
                        ]
                    }
