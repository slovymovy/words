        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdbb9b9e-4b5b-3f05-bd94-3e3e633c7780",
                    "sense_definition": "A helpful act or a favor done for someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "favor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Could you do me a <w>solid</w> and pick up some milk on your way home?",
                            "target_lang_translations": {
                                "ru": "Не мог бы ты сделать мне <w>одолжение</w> и купить молока по дороге домой?"
