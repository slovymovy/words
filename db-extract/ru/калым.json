                        ],
                        "form": "калы́ме"
                    },
                    {
                        "form_id": "063c8a86-765b-4e00-8d99-a9bdd8681a17",
                        "entry_id": "6569a64a-d0a5-3903-8e8c-91fd70ce97f1",
                        "tags": [
                            "plural",
