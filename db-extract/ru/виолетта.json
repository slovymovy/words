                    {
                        "translation_id": "3b09cec9-f909-42e1-b732-918e344d7e21",
                        "source_entry_id": "7942cb6f-5840-3893-9e39-8d6e0c3c5da5",
                        "source_sense_id": "4e5c17c2-bcd5-3407-8862-82e6287dd827",
                        "source_sense_description": "Иноязычные аналоги",
