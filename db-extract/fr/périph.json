                        "glosses": [
                            "Boulevard périphérique."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2c123651-21fd-41b4-832e-bd2e68d29c55",
                                "sense_id": "ff73274c-3551-32fc-9c09-901226d844de",
                                "text": "Quand le scooter tombe,\nIl recouvre le périph\nDans d’impenetrables ténèbres.\nDe la fumée s'élève du teh\nAnd recouvre mes poumons.\nTout à coup, la vie prends un nouveau sens."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ee83b06-0c00-3386-aa26-54e0b7905906",
                        "entry_id": "d9e80cd5-11c5-331a-b3d3-30483a8fe475",
                        "glosses": [
                            "Boulevard périphérique de Paris."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "22e9e472-2699-4a27-8483-0c218fdf9817",
                                "sense_id": "6ee83b06-0c00-3386-aa26-54e0b7905906",
                                "text": "On les retrouve au kébab du coin, au bout de l'avenue Jean-Jaurès où une pancarte annonce : « Dernier kébab avant le périph », au Café de la musique du parc de la Villette, au café MK2 du quai de Seine."
                            },
                            {
                                "example_id": "a52cdb76-2114-4328-8a0f-586d1c1c8219",
                                "sense_id": "6ee83b06-0c00-3386-aa26-54e0b7905906",
                                "text": "D’ailleurs, regardez-les bien, les routards du début de la semaine : à la machine à café, dans le dur, le métro, sur le périph, une aire d’autoroute ou au bureau en face de vous."
                            }
                        ]
                    }
