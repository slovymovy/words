                        "sense_id": "765b7366-cefc-33bf-8c14-7f437a9de568",
                        "entry_id": "e034a430-de13-3db6-b110-a368ed78ce19",
                        "glosses": [
                            "Cytokine qui bloque l'angiogenèse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28c481df-bae4-416f-a4bd-2474c66ea62a",
                                "sense_id": "765b7366-cefc-33bf-8c14-7f437a9de568",
                                "text": "Ci-dessous, des informations plus détaillées sont données pour les thrombospondines, l’angiostatine, l’endostatine, le fragment hémopexine (PEX) de la métalloprotéase MMP2 et le facteur plaquettaire-4 (PF-4)."
                            },
                            {
                                "example_id": "5084b8ea-f558-439a-a072-39c8f4eb6472",
                                "sense_id": "765b7366-cefc-33bf-8c14-7f437a9de568",
                                "text": "D’autres traitements antiangiogéniques visent à l’inverse à renforcer les inhibiteurs naturels de l’angiogenèse telles que l’endostatine."
                            },
                            {
                                "example_id": "09589b5a-324c-4dbf-944b-ee4e646ce2cd",
                                "sense_id": "765b7366-cefc-33bf-8c14-7f437a9de568",
                                "text": "Le même effet est noté avec l’angiostatine et l’endostatine."
                            },
                            {
                                "example_id": "7cc735d5-9761-4382-9a10-337ae817acee",
                                "sense_id": "765b7366-cefc-33bf-8c14-7f437a9de568",
                                "text": "Parmi les plus importants figurent le PDGF, le TGF-β1, le VEGF, le FGF, l'EGF, le facteur 4, les angiopoïétines et les endostatines."
                            }
                        ]
                    }
