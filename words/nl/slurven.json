                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is onbeleefd om zo luidruchtig te <w>slurven</w> tijdens het eten van de soep.",
                            "target_lang_translations": {
                                "en": "It is impolite to <w>slurp</w> so noisily while eating soup."
                            }
                        },
                        {
                            "text": "De kinderen zaten gezellig warme chocolademelk te <w>slurven</w> na de wandeling.",
                            "target_lang_translations": {
