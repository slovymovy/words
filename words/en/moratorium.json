            "senses": [
                {
                    "sense_id": "b333e4c0-59ae-3af3-857c-353403635733",
                    "sense_definition": "A temporary official suspension or prohibition of an ongoing activity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suspension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to call for a <w>moratorium</w> on new deep-sea drilling operations."
                        },
                        {
                            "text": "Several countries have imposed a strict <w>moratorium</w> on commercial whaling."
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "interruption"
                    ],
                    "common_phrases": [
                        "impose a moratorium",
                        "call for a moratorium",
                        "moratorium on"
                    ]
                },
                {
                    "sense_id": "f7277171-0731-34fc-be5c-a9ba28732945",
                    "sense_definition": "A legally authorized period of delay in the performance of a legal obligation or payment of a debt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suspension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank offered a debt <w>moratorium</w> to help homeowners affected by the natural disaster."
