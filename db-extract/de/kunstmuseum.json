                "senses": [
                    {
                        "sense_id": "a46871d1-7e9a-361c-b5b9-c41c26163f3b",
                        "entry_id": "eac6be32-c50d-3e0d-a000-461e7eceae28",
                        "glosses": [
                            "Museum, das künstlerische Werke ausstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a4e9cda-e068-409b-93b3-997c00b59444",
                                "sense_id": "a46871d1-7e9a-361c-b5b9-c41c26163f3b",
                                "text": "Das einzige Kunstmuseum der Stadt hat montags geschlossen."
                            },
                            {
                                "example_id": "9f704ae9-0a3c-4ca9-89b3-61f433c02c6d",
                                "sense_id": "a46871d1-7e9a-361c-b5b9-c41c26163f3b",
                                "text": "„Die surrealen Bildwelten des Spaniers erkennen normalerweise sogar diejenigen auf Anhieb, die Besuche in Kunstmuseen für Zeitverschwendung halten.“"
                            },
                            {
                                "example_id": "7df7c520-0173-4886-8411-51ea11b16a6a",
                                "sense_id": "a46871d1-7e9a-361c-b5b9-c41c26163f3b",
                                "text": "„Da es in der Kirche zu feucht war, wurde das Bild in das staatliche Kunstmuseum in Kopenhagen ausgelagert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
