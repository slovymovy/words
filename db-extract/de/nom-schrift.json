                ],
                "senses": [
                    {
                        "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                        "entry_id": "6d52fd73-44af-3283-b916-c351f6efb016",
                        "glosses": [
                            "frühere Schrift der vietnamesischen Sprache, die aus chinesischen Schriftzeichen und ergänzend nach demselben Muster gebildeten eigenen Schriftzeichen bestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c36847-5a3a-4d75-ba1a-a2b35f4ad686",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Während der nächsten nahezu 1000 Jahre – vom 10. bis ins 20. Jahrhundert hinein – wurde viel der vietnamesischen Literatur, Philosophie, Geschichte, Gesetz, Medizin, Religion und Regierungspolitik in Nom-Schrift verfasst.“"
                            },
                            {
                                "example_id": "f3a35aa2-cd5a-4012-aaac-c8b5f4b138f4",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Erst im 13. Jahrhundert entstand in den Kreisen vietnamesischer Gelehrter ein national-vietnamesisches Schriftsystem, die sogenannte Nom-Schrift, die eng an das chinesische Schriftzeichensystem angelehnt war.“"
                            },
                            {
                                "example_id": "307abcc5-8243-44ad-b60f-5fbf3ef6d9eb",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Herrscher, Generäle und Dichter verfassten ihre Texte in der Nom-Schrift.“"
                            },
                            {
                                "example_id": "afb02f9b-f616-4c8e-ae86-56a23c3108e9",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Am Hof und in den Akademien benutzten die Gelehrten das chinesische Schriftsystem, ab dem 13. Jh. auch die Nom-Schrift.“"
                            },
                            {
                                "example_id": "040e3815-03f7-4e53-89a0-1838570974d7",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Die vierte neuzeitliche Periode der vietnamesischen Sprachgeschichte brachte den Höhepunkt der Nom-Schrift, sie war gleichzeitig aber auch durch das Aufkommen und die späte allmähliche Einführung einer Lateinschrift gekennzeichnet.“"
                            },
                            {
                                "example_id": "e1b4938e-4246-4cc4-b90f-2fbee8240936",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„Ausgenommen davon sind einige alte religiöse Werke und Liedersammlungen, die in der alten vietnamesischen, auf chinesischen Schriftzeichen basierenden, Nom-Schrift verfaßt sind […]“"
                            },
                            {
                                "example_id": "9d1280af-c5eb-4f9c-a723-77de7052f53a",
                                "sense_id": "6772c753-1b97-32fc-8b2a-a383e0a35b99",
                                "text": "„In der Nom-Schrift entstanden bereits im 13. Jahrhundert bedeutende Werke der vietnamesischen Literatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
