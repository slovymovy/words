                                    {
                                        "sense_id": "ec377776-6b28-3999-9885-f9c982f18b43",
                                        "entry_id": "52f82114-6679-30ea-b1ec-061f777c6165",
                                        "glosses": [
                                            "An amount of liquid that is dribbled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c5820f5-ca88-4b39-b255-78110ea1df30",
                                                "sense_id": "ec377776-6b28-3999-9885-f9c982f18b43",
                                                "text": "In dry weather, when plants are drawn out of the seed bed, and planted with a common dibber, receiving daily dribblings of water, many will perish, and all are materially injured."
                                            },
                                            {
                                                "example_id": "2aafe2b4-82fd-4d87-bfe9-e30d4a1dd0ac",
                                                "sense_id": "ec377776-6b28-3999-9885-f9c982f18b43",
                                                "text": "From the mouth you early observe a dribbling of saliva of a sticky nature and mixed with air, and of a disagreeable fetor […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa371ee3-9f59-3963-b8d1-9b28138ccdc5",
                                        "entry_id": "52f82114-6679-30ea-b1ec-061f777c6165",
                                        "glosses": [
                                            "The act of dribbling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17dc1211-52f4-4597-9268-2b06876be8bb",
                                                "sense_id": "fa371ee3-9f59-3963-b8d1-9b28138ccdc5",
                                                "text": "... dribbling skills. Depending on the purpose of dribbling, an athlete can use different dribbling techniques to accomplish his/her goals. There are four dribbling skills: (1) inside of the foot dribbling, (2) innerside of the instep dribbling[…]"
                                            }
                                        ]
                                    }
