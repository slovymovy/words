                        ],
                        "form": "die Männlichkeit"
                    },
                    {
                        "form_id": "03b3a6fe-cd72-4ba9-b8ee-1362d5a627a5",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Männlichkeit"
                    },
                    {
                        "form_id": "2c5df652-e36e-492f-8ebf-a3cee6be2f74",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Männlichkeit"
                    },
                    {
                        "form_id": "5262c162-970f-4b99-8128-61bfc702e2b0",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Männlichkeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8773fdc4-e14d-3551-98a9-2f5ceeae316e",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "glosses": [
                            "Fähigkeit zur Zeugung von Nachwuchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2707b0c-98e7-4bad-a3f8-7e293fdab54d",
                                "sense_id": "8773fdc4-e14d-3551-98a9-2f5ceeae316e",
                                "text": "Er hatte mit dem Alter seine Männlichkeit verloren."
                            },
                            {
                                "example_id": "9a49f73d-b94b-4c35-8e40-376d80bd5164",
                                "sense_id": "8773fdc4-e14d-3551-98a9-2f5ceeae316e",
                                "text": "„Alle Männlichkeit schwand, in Sekunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "glosses": [
                            "auf traditionellen Geschlechterrollen basierendes Wertebild, das Eigenschaften wie Stärke, Standhaftigkeit, Loyalität und Verlässlichkeit umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a8b0a4-76dc-43e7-86f8-5dd7b20d9a89",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "Vielen Männern fällt es schwer, ihre Männlichkeit zu behaupten."
                            },
                            {
                                "example_id": "3cc65996-bb8c-4488-b009-f298a5f7db5d",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "„Der Abstieg des Mackers ist daher eng verknüpft mit dem Strukturwandel der Männlichkeit.“"
                            },
                            {
                                "example_id": "9537f746-51f3-4577-a164-02fa567fb2fb",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "„Tom of Finland stellte dem ein kraft- und lustvolles Bild von Männlichkeit entgegen.“"
                            },
                            {
                                "example_id": "457fd0fb-99b3-485e-9268-5121ec7d50b0",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "„Er war vielmehr durchaus sehr beeindruckt von dem ganzen Getue um Männlichkeit und Härte.“"
                            },
                            {
                                "example_id": "3bf749b1-888b-4198-8b69-2fc93b25a99c",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "„Schon daraus könnte man den Schluß ziehn, daß an seiner Männlichkeit etwas nicht in Ordnung ist, denn Männlichkeit beweist sich nur dadurch, daß man, auf anderem Niveau, dasselbe Gleichgewicht wiedererlangt, das die Frau auf dem ihren besitzt.“"
                            },
                            {
                                "example_id": "f4099efa-4ce5-4802-b58f-7bb16ae137d6",
                                "sense_id": "6e06dbf0-77a8-3874-846d-920b95097584",
                                "text": "„Sein Verhalten widersprach den bei den Shona üblichen Maßstäben der Männlichkeit, und andere Kinder verspotteten ihn, weil er am Rock seiner Mutter hing.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "acafc5cb-7853-39d4-9855-77d4d5d5ffaf",
                        "entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "glosses": [
                            "Sammelbezeichnung für die Geschlechtsorgane des Mannes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "212d08d4-6350-496c-943c-aa8645370e1d",
                                "sense_id": "acafc5cb-7853-39d4-9855-77d4d5d5ffaf",
                                "text": "Der Ball traf ihn schmerzhaft in seine Männlichkeit."
                            },
                            {
                                "example_id": "c103b080-6236-4baf-8bec-d6725c5448d8",
                                "sense_id": "acafc5cb-7853-39d4-9855-77d4d5d5ffaf",
                                "text": "„Dann nestelte Nixblume an seinem Beinkleide und tastete an seine Männlichkeit, nahm dann einen Schluck Wein und flößte ihn ihm in den Mund.“"
                            },
                            {
                                "example_id": "b6655098-2f7f-4241-ada0-494320e33087",
                                "sense_id": "acafc5cb-7853-39d4-9855-77d4d5d5ffaf",
                                "text": "„Er öffnete seine Hosenklappe und brachte den aus zartestem Fleisch und feinsten Häutchen gefügten Zeugen seiner Männlichkeit zum Vorschein.“"
                            },
                            {
                                "example_id": "8a8b663a-2b06-462f-8c1d-ec9e9576c2bb",
                                "sense_id": "acafc5cb-7853-39d4-9855-77d4d5d5ffaf",
                                "text": "„Oder sie griffen Männer an und brachten die Männlichkeit zum Verschwinden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b98c67-7e08-47ec-b329-2196f75b0b10",
                        "source_entry_id": "877d7d8d-a36f-3990-be82-5ca32e21018a",
                        "source_sense_id": "8773fdc4-e14d-3551-98a9-2f5ceeae316e",
                        "source_sense_description": "Fähigkeit zur Zeugung von Nachwuchs",
                        "target_lang_word": "manliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                        "entry_id": "4b8adad8-91be-398b-b974-cf3a9f2addac",
                                        "glosses": [
                                            "The quality of being manly; the set of qualities, traits and abilities considered appropriate to men (as opposed to women or children); similarity to a man."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd4caf44-2dce-4b69-94be-a0b0c26babb8",
                                                "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                                "text": "Nought under Heaven so strongly doth allure\nThe Sense of Man, and all his Mind possess,\nAs Beauty’s lovely Bait, that doth procure\nGreat Warriors oft their Rigour to repress;\nAnd mighty Hands forget their Manliness,"
                                            },
                                            {
                                                "example_id": "ae47d119-5027-46f6-ad02-9236d059a209",
                                                "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                                "text": "With louder plaints the mother spoke her woes,\nAnd blessed the cot where every pleasure rose;\nAnd kissed her thoughtless babes with many a tear,\nAnd clasped them close, in sorrow doubly dear;\nWhilst her fond husband strove to lend relief\nIn all the silent manliness of grief."
                                            },
                                            {
                                                "example_id": "5e52c2fc-1ddc-4ea9-bd4e-b72a4a65d972",
                                                "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                                "text": "‘He he!’ simpered Brass, who, in his deep debasement, really seemed to have changed sexes with his sister, and to have made over to her any spark of manliness he might have possessed."
                                            },
                                            {
                                                "example_id": "89ce65d5-c686-4068-a9b7-440c342c0493",
                                                "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                                "text": "[…] there was in all their minds a mute questioning of deference and chivalry, of the Bank of England and the Indian Empire, of ringed fingers and lace, though to them all there was something in this of the essence of beauty, which called out the manliness in their girlish hearts, and made them, as they sat at table beneath their mother's eyes, honour her strange severity […]"
                                            },
                                            {
                                                "example_id": "bd6b6c43-f7df-454e-8b36-a043021d9e4c",
                                                "sense_id": "0ff9a84f-7cb8-38ef-97fb-a7ac1b37c24b",
                                                "text": "Yam stood for manliness, and he who could feed his family on yams from one harvest to another was a very great man indeed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cddd9c7-bd13-3673-a0e1-b67db98a9cd0",
                                        "entry_id": "4b8adad8-91be-398b-b974-cf3a9f2addac",
                                        "glosses": [
                                            "Male genitals."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "256ef22c-5576-4c27-a384-d9828a8133ca",
                                                "sense_id": "4cddd9c7-bd13-3673-a0e1-b67db98a9cd0",
                                                "text": "Dressed only in flip-flops and a fuzzy blue bathrobe, which would be long enough on the mayor of Munchkin Land but on me is literally indecent, I attack the mower in a yanking frenzy, flailing around until the dramatic conclusion, wherein the mower refuses to start even though it is confronted by the full extent of my manliness because my too-short robe has flapped open in a cloud of flying sweat and hurled profanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa6d46da-3d01-38f5-8c77-f3a524e02e12",
                                        "entry_id": "4b8adad8-91be-398b-b974-cf3a9f2addac",
                                        "glosses": [
                                            "Humanity, the quality of being human."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc758b1b-81d7-46b8-b8d9-e6e0ec46b6f4",
                                                "sense_id": "aa6d46da-3d01-38f5-8c77-f3a524e02e12",
                                                "text": "What might not have happened to men? What if cruelty had grown into a common passion? What if in this interval the race had lost its manliness, and had developed into something inhuman, unsympathetic, and overwhelmingly powerful? I might seem some old-world savage animal, only the more dreadful and disgusting for our common likeness—a foul creature to be incontinently slain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
