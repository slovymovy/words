                "senses": [
                    {
                        "sense_id": "1665cecc-23dc-3f98-a244-db6d9c017abd",
                        "entry_id": "395a5d9b-0919-319b-b5c7-890ab7eeb466",
                        "glosses": [
                            "Dormir, somnoler."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "bed45e4b-5ed9-4744-848a-e30b7f34f36a",
                                "sense_id": "1665cecc-23dc-3f98-a244-db6d9c017abd",
                                "text": "C’est l’estaminet où chacun possède une pipe avec son nom émaillé, une pipe de jour de l’an offerte par le garçon qui dormasse, d’invariable mémoire, le nez sur un journal et jette un piteux et traînant « voilà » quand on lui commande un nouveau bock."
                            },
                            {
                                "example_id": "3c8fbd3a-0e7a-45a1-b990-ce949bc134a9",
                                "sense_id": "1665cecc-23dc-3f98-a244-db6d9c017abd",
                                "text": "Or le bar était vide. Léon, à son comptoir dormassait, en chandail, tandis que sa chienne, près de lui, sur une chaise, veillait."
                            },
                            {
                                "example_id": "ab0e1aa5-b981-436f-b5ad-1ed6cf07aeda",
                                "sense_id": "1665cecc-23dc-3f98-a244-db6d9c017abd",
                                "text": "Toute la journée il demeurait étendu sur le lit, dans la maison Yahia, à rêvasser, à dormasser, une serviette humide sous la nuque;"
                            },
                            {
                                "example_id": "d1ba9f3c-5168-4267-b587-08398e68ab62",
                                "sense_id": "1665cecc-23dc-3f98-a244-db6d9c017abd",
                                "text": "Au lieu de dormasser derrière la grange, il se montre tous les jours au village, s'arrêtant, bavardant avec les commères :"
                            }
                        ]
                    }
                ],
