                ],
                "senses": [
                    {
                        "sense_id": "106b0c66-7a00-3bc3-b2a6-a882c50b4e9c",
                        "entry_id": "4e91c7dd-1f16-34c3-9f2b-1ae806090098",
                        "glosses": [
                            "постоянно внушая страх, угрожая, наказывая и т. п., сделать кого-либо робким, боязливым"
                        ],
                        "tags": [],
