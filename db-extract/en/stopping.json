                        "examples": [
                            {
                                "example_id": "92b17662-855c-4584-a502-08d89f8b77f9",
                                "sense_id": "957ff263-2b7b-3dd5-a0b3-1d3adff6cfe1",
                                "text": "an amalgam stopping"
                            },
                            {
                                "example_id": "2162c362-2dc4-445a-af4c-359758c7e481",
                                "sense_id": "957ff263-2b7b-3dd5-a0b3-1d3adff6cfe1",
                                "text": "curious antiquaries, sifting the ruins of time, when London is a grass-grown path and all those hurrying along the pavement this Wednesday morning are but bones with a few wedding rings mixed up in their dust and the gold stoppings of innumerable decayed teeth"
                            },
                            {
                                "example_id": "18dc7ff9-5218-424b-89d3-baeef7472ccc",
                                "sense_id": "957ff263-2b7b-3dd5-a0b3-1d3adff6cfe1",
                                "text": "Then one day a big stopping came out of one of my back teeth."
                            }
                        ]
                    },
