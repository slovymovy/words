{
    "word": "loswerken",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "d513c6d4-127d-3f4e-9205-c259d0cbac7e",
                "word": "loswerken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                        "entry_id": "d513c6d4-127d-3f4e-9205-c259d0cbac7e",
                        "glosses": [
                            "van iets dat het los komt te zitten en dus niet meer ergens aan vast zit of ergens contact mee maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af31e9b2-23bd-4687-9a1d-4ea8ce761c61",
                                "sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                                "text": "De CT200h illustreert de spreekwoordelijke Japanse betrouwbaarheid. Het komt weleens voor dat de stekker van de hoogspanningsaccu zich iets loswerkt. Een kwestie van goed vastzetten, maar laat dat wel door de Wegenwacht doen! Nooit de tank helemaal leeg rijden: dan moet de hybride-accu extern worden geladen, een tijdrovende bezigheid."
                            },
                            {
                                "example_id": "6b80f4ee-2f13-46d6-84bd-f6539991d0b9",
                                "sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                                "text": "Acht gebruikte bouten bleken bij onderzoek vijf millimeter lang, in plaats van de voorgeschreven drie millimeter. Ze waren ook niet van het juiste model, zodat ze zich konden loswerken. De dertig bouten die wel goed waren, bleken niet in staat het loszittende rompdeel aan het casco te klemmen toen het door de luchtstroom werd losgerukt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "959db374-6831-4e84-beca-1f2680118e45",
                        "source_entry_id": "d513c6d4-127d-3f4e-9205-c259d0cbac7e",
                        "source_sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                        "target_lang_word": "set free",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "set free",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                        "entry_id": "de6099d0-6c80-30c1-bca7-071393e466a8",
                                        "glosses": [
                                            "To release, to free, to give freedom to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f18b88e5-70a2-4fb4-98a9-442a244d3b3b",
                                                "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                                "text": "\"Well, you can tell Nan that she won't marry Peter Mallory with my consent. I'll never set her free to be another man's wife.\""
                                            },
                                            {
                                                "example_id": "67ac61bc-cd9b-422b-81da-fab74c421ad1",
                                                "sense_id": "bcd8ba9d-d695-33dd-8362-f2987f630825",
                                                "text": "Send it, send it / Just like it came to me / I'm gonna set it free / Send it, send it / You've got to let it go / Open up a window"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffff1cab-7a19-4202-9dd8-6b0fa775fd4b",
                        "source_entry_id": "d513c6d4-127d-3f4e-9205-c259d0cbac7e",
                        "source_sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                        "target_lang_word": "work loose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "610a2606-52f1-46cc-b43b-ce8873f94c89",
                        "source_entry_id": "d513c6d4-127d-3f4e-9205-c259d0cbac7e",
                        "source_sense_id": "4609508f-3c58-3274-b54d-212ece079384",
                        "target_lang_word": "loosen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loosen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To make loose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bcdb737-60c6-4fea-9260-926b6db0b1ec",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "to loosen a knot; to loosen one's grip / hold on something"
                                            },
                                            {
                                                "example_id": "5b7d13f7-b803-4e6a-8f58-2da46eee40e4",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "After the Thanksgiving meal, Bill loosened his belt."
                                            },
                                            {
                                                "example_id": "973abdcd-2c9d-489e-b3fe-a85da2944c7a",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "1626, Francis Bacon, Sylva Sylvarum: or A Naturall Historie, London: William Lee, Century 5, p. 111,\n[…] after a yeares Rooting, then Shaking doth the Tree good, by Loosening of the Earth […]"
                                            },
                                            {
                                                "example_id": "fe4df7d7-9f76-4967-97ba-f3229c16fe1f",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "In order to deal with deposits of soot on boiler-tubes while running, especially if poor coal is in use, locomotives are often now provided with blowers on the firebox back-plate which can be made to discharge a jet of high pressure steam towards the firebox tubeplates; this has the effect of loosening and blowing off the soot deposits."
                                            },
                                            {
                                                "example_id": "0b5b66e6-ed27-4e0b-93fb-45344921e853",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "[...] and on the Saturday heavy seas pounded the W.R. on its exposed coastal stretch between Dawlish and Teignmouth, loosening the ballast and forcing trains to proceed with extreme caution."
                                            },
                                            {
                                                "example_id": "94e20e5d-379b-466a-bfaf-4741fa5ddc89",
                                                "sense_id": "62bbd7c1-0b73-3605-8cb8-ac4b02a4b1e4",
                                                "text": "His days at the villa had loosened his body and freed his tenseness […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50d29430-a4cd-36ba-ba44-616b75d7026c",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To become loose."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73208dc-9b98-4409-943a-fe99a2950cfc",
                                                "sense_id": "50d29430-a4cd-36ba-ba44-616b75d7026c",
                                                "text": "Max caught Bigger’s shoulders in a tight grip; then his fingers loosened and he sank back to the cot […]"
                                            },
                                            {
                                                "example_id": "42f55907-80ee-401a-92b7-0e11f74e9751",
                                                "sense_id": "50d29430-a4cd-36ba-ba44-616b75d7026c",
                                                "text": "I noticed that my seatbelt had gradually loosened during the journey."
                                            },
                                            {
                                                "example_id": "cbf46e13-b764-4d08-9a46-629da44e9f75",
                                                "sense_id": "50d29430-a4cd-36ba-ba44-616b75d7026c",
                                                "text": "The subtile shower the earth hath softned so,\nAnd with the waues, the trees tost to and fro;\nThat the rootes loosen, and the tops downe sway,\nSo that whole Forrests quickly swimme away."
                                            },
                                            {
                                                "example_id": "cdcd1884-7023-49b3-ab4a-21f97c8c9f1e",
                                                "sense_id": "50d29430-a4cd-36ba-ba44-616b75d7026c",
                                                "text": "The sea scurvy is attended with an universal putrefaction, the teeth loosen, old wounds that had been healed again open […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b7c828-4979-3065-8522-8f957a539539",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To disengage (a device that restrains)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c0386c4-bb8b-46c7-8175-5d4ab2b243c4",
                                                "sense_id": "a9b7c828-4979-3065-8522-8f957a539539",
                                                "text": "At Liberty th’ unfetter’d Captive stands,\nAnd flings the loosen’d Shackles from his Hands."
                                            },
                                            {
                                                "example_id": "5c4d3e5b-e456-4958-a3e8-aa1e0be4c60c",
                                                "sense_id": "a9b7c828-4979-3065-8522-8f957a539539",
                                                "text": "He easily comprehended, that the noise which he had heard was occasioned by his having loosened a chain which attached the image to its pedestal."
                                            },
                                            {
                                                "example_id": "a9903ef4-2c5a-40fe-985b-051fc592a120",
                                                "sense_id": "a9b7c828-4979-3065-8522-8f957a539539",
                                                "text": "Her hair is drawn back under a heavy enamelled clasp. He loosens the clasp and lays it on the table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8732f634-2662-3427-9d9a-ecbf1b818ba8",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To become unfastened or undone."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbd623bf-b331-4eb9-98c3-49a426d15894",
                                                "sense_id": "8732f634-2662-3427-9d9a-ecbf1b818ba8",
                                                "text": "Immediately my Shackles loosened and fell away of themselves […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8683111-ab64-3c58-9bd4-09c899a3b3f9",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To free from restraint; to set at liberty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673610e5-0c49-4acc-8c17-519b0fb4821f",
                                                "sense_id": "e8683111-ab64-3c58-9bd4-09c899a3b3f9",
                                                "text": "This is an admirable Rule; a Painter ought to have it perpetually present in his Mind and Memory. […] it loosens his hands, and assists his understanding."
                                            },
                                            {
                                                "example_id": "dd1b18d0-8ffb-4f47-8f82-ba6b3382e648",
                                                "sense_id": "e8683111-ab64-3c58-9bd4-09c899a3b3f9",
                                                "text": "[…] Valancourt, willing to take a more extensive view of the enchanting country, into which they were about to descend, than he could do from a carriage, loosened his dogs, and once more bounded with them along the banks of the road."
                                            },
                                            {
                                                "example_id": "fa18ecde-fa66-4747-b498-eea655377479",
                                                "sense_id": "e8683111-ab64-3c58-9bd4-09c899a3b3f9",
                                                "text": "I thought you had more sense than […] to suppose that because you have fallen into a very common trouble, such as most men have to go through, you are loosened from all bonds of duty […]"
                                            },
                                            {
                                                "example_id": "1e73e5e7-ae71-4186-b94c-04b419f4ae0f",
                                                "sense_id": "e8683111-ab64-3c58-9bd4-09c899a3b3f9",
                                                "text": "The recollection loosened a throng of benumbed sensations—longings, regrets, imaginings, the throbbing brood of the only spring her heart had ever known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "990d11c8-ba79-3f42-b405-785cd67c293a",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To relieve (the bowels) from constipation; to promote defecation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "debf5084-991d-457f-8b9b-6aaf51a24864",
                                                "sense_id": "990d11c8-ba79-3f42-b405-785cd67c293a",
                                                "text": "1626, Francis Bacon, Sylva Sylvarum: or A Naturall Historie, London: William Lee, Century 1, p. 14,\n[…] Feare looseneth the Belly; because the Heat retiring inwards towards the Heart, the Gutts and other Parts are relaxed;"
                                            },
                                            {
                                                "example_id": "2c0c0be8-c8bc-4355-901f-51eba053ad00",
                                                "sense_id": "990d11c8-ba79-3f42-b405-785cd67c293a",
                                                "text": "[…] omitting the vehicle of water and honey, which is of a laxative power it selfe, the powder of some Loadstones in this dose doth rather constipate and binde, then purge and loosen the belly."
                                            },
                                            {
                                                "example_id": "d26fb4af-3c44-4fa0-8354-f04199931d12",
                                                "sense_id": "990d11c8-ba79-3f42-b405-785cd67c293a",
                                                "text": "When this Fruit [the guava] is eaten green it is binding, when ripe it is loosening."
                                            },
                                            {
                                                "example_id": "e98b89fe-8dac-46eb-b4be-2d748c917e83",
                                                "sense_id": "990d11c8-ba79-3f42-b405-785cd67c293a",
                                                "text": "Trying to control his breathing and the loosening of his bowels, he crouched still lower […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f828dbe2-6709-331c-b630-02ceb2d93dbc",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To create a breach or rift between (two parties)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd1c953-3200-487e-a7ae-55bcf60fb1e3",
                                                "sense_id": "f828dbe2-6709-331c-b630-02ceb2d93dbc",
                                                "text": "I had rather lose the battle than that sister\nShould loosen him and me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "039e3f44-c6cc-3ae6-a596-61845e811212",
                                        "entry_id": "576c0619-8687-384c-bd00-613e9bef7b28",
                                        "glosses": [
                                            "To sail away (from the shore)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87b9ad94-1d04-425b-b6d2-f3bea6f9069f",
                                                "sense_id": "039e3f44-c6cc-3ae6-a596-61845e811212",
                                                "text": "[…] after the .iiii. day of oure arryuall in Britayne, the eightene shyps that we spake of before, which hadde the horsemen to conuey ouer, loosened from the further hauen with a soft wynd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
