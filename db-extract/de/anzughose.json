                    {
                        "sense_id": "978a1553-9cc3-3971-9f21-1a6c9de57fac",
                        "entry_id": "32759caf-64d2-3825-90e9-a5abfff4782f",
                        "glosses": [
                            "Hose, die zu einem Anzug gehört"
                        ],
                        "tags": [
                            "Mode"
                        ],
                        "examples": [
                            {
                                "example_id": "0c36ae54-325b-4743-9006-82b5da530c88",
                                "sense_id": "978a1553-9cc3-3971-9f21-1a6c9de57fac",
                                "text": "„Er trägt ein blaues Jackett, eine schmale Krawatte, eine beige kurze Anzughose, dunkle Kniestrümpfe und edle Lederschuhe.“"
                            },
                            {
                                "example_id": "6e7a2ac9-4d83-45f8-a6e3-13cce914f0aa",
                                "sense_id": "978a1553-9cc3-3971-9f21-1a6c9de57fac",
                                "text": "„Für Schumann hat eine Jogginghose dort keinen Platz, er lebt in einem ‚Wohnanzug‘, meint er und trägt manchmal wochenlang dasselbe: Anzug oder weißes Hemd mit Anzughose und Schnürschuhen, das Ganze am liebsten ohne Socken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
