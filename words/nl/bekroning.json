                    "frequency": "VeryLow",
                    "semantic_group_id": "militair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten versterkten de <w>bekroning</w> van de loopgraaf om kogels tegen te houden.",
                            "target_lang_translations": {
