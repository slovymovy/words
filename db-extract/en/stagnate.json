                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0af0b25-f261-3c11-9fc9-11eb46477c96",
                        "entry_id": "4dc54018-1c88-37f0-8423-de04871685d8",
                        "glosses": [
                            "To cease motion, activity, or progress:",
                            "To cease to flow or run."
                        ],
                        "tags": [
                            "of water"
                        ],
                        "examples": [
                            {
                                "example_id": "42ebc552-0ae1-4141-b226-018e65ec84f5",
                                "sense_id": "b0af0b25-f261-3c11-9fc9-11eb46477c96",
                                "text": "If the water stagnates, algae will grow."
                            }
                        ]
                    },
                    {
                        "sense_id": "d18298ae-5cd1-3f19-aea8-1cc3b611fa47",
                        "entry_id": "4dc54018-1c88-37f0-8423-de04871685d8",
                        "glosses": [
                            "To cease motion, activity, or progress:",
                            "To be or become foul from standing."
                        ],
                        "tags": [
                            "of water"
                        ],
                        "examples": [
                            {
                                "example_id": "a89192eb-3b9d-46db-968a-6bd9bcbe865f",
                                "sense_id": "d18298ae-5cd1-3f19-aea8-1cc3b611fa47",
                                "text": "Air stagnates in a closed room."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8075a0f-9a01-3708-9f5d-890f6187443d",
                        "entry_id": "4dc54018-1c88-37f0-8423-de04871685d8",
                        "glosses": [
                            "To cease motion, activity, or progress:",
                            "To cease to develop, advance, or change; to become idle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb40f15-6787-4750-b8cb-cf16b508e27f",
                                "sense_id": "c8075a0f-9a01-3708-9f5d-890f6187443d",
                                "text": "Ready-witted tenderness […] never stagnates in vain lamentations while there is any room for hope."
                            },
                            {
                                "example_id": "f579a888-cdd8-437e-a436-bfa61565239e",
                                "sense_id": "c8075a0f-9a01-3708-9f5d-890f6187443d",
                                "text": "Listening to what others say, especially to what they teach, prevents our minds stagnating, thus promoting mental growth into old age."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc64a92d-6318-4135-b2fc-e172f85bfcd3",
                        "source_entry_id": "4dc54018-1c88-37f0-8423-de04871685d8",
                        "source_sense_description": "to cease activity",
                        "target_lang_word": "stagner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stagner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78f48390-1871-3bd7-8c73-9d335d03efbb",
                                        "entry_id": "f1a549e8-3464-3401-9fa2-f7fa1d128ae6",
                                        "glosses": [
                                            "Pour un liquide, ne pas bouger, rester inerte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7d7acb-b0fa-47d8-a1c6-19f5595be1aa",
                                                "sense_id": "78f48390-1871-3bd7-8c73-9d335d03efbb",
                                                "text": "Des racines coupées et des feuilles de betteraves, bouillant dans une marmite sur le feu, mêlaient leur parfum âcre à l’odeur de renfermé qui semblait stagner dans les encoignures."
                                            },
                                            {
                                                "example_id": "a4e954c0-67ec-4b16-8c7d-72bd486b3139",
                                                "sense_id": "78f48390-1871-3bd7-8c73-9d335d03efbb",
                                                "text": "Le seul exutoire des eaux du marais étant le Petit-Morin au pont de Saint-Prix, il apparaît évident que l'entretien de cette rivière (faucardage et curage) doit être régulier, sinon le drainage serait insuffisant et l'eau stagnerait sur les terres voisines, rendant ainsi toute culture impossible."
                                            },
                                            {
                                                "example_id": "b752191a-b222-4bc8-925d-58dc303426b1",
                                                "sense_id": "78f48390-1871-3bd7-8c73-9d335d03efbb",
                                                "text": "— Un relent d’encens stagnait dans la pièce, du jardin me parvenaient les trilles joyeuses d'un rossignol à la pleine lune, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4799249-8135-3342-85d4-399743c7ec11",
                                        "entry_id": "f1a549e8-3464-3401-9fa2-f7fa1d128ae6",
                                        "glosses": [
                                            "Ne pas évoluer, ne pas être en mouvement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54056595-5a0f-4212-8b4c-cb3fec266d15",
                                                "sense_id": "c4799249-8135-3342-85d4-399743c7ec11",
                                                "text": "Quand il ouvrait la bouche, sa parole surprenante semblait articulée par quelqu'un stagnant au fond d'une caverne obscure, tels on imagine les vagissements d'outre-tombe ; aussi la moindre chose qu'il disait produisait-elle une grande épouvante."
                                            },
                                            {
                                                "example_id": "496f680d-f8ec-4852-9024-ecf5a7b75679",
                                                "sense_id": "c4799249-8135-3342-85d4-399743c7ec11",
                                                "text": "Toutes les voies, même les plus iconoclastes, sont explorées pour sortir de l’impasse dans laquelle la physique contemporaine semble stagner."
                                            },
                                            {
                                                "example_id": "71e4a71b-ff49-4c3c-b310-8ec77a3372fd",
                                                "sense_id": "c4799249-8135-3342-85d4-399743c7ec11",
                                                "text": "M. Charest a-t-il l’intention de faire avancer le Québec dans la bonne direction ou va-t-il le faire stagner ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "606ea27b-6f52-4232-9ab2-737b7e0b897b",
                        "source_entry_id": "4dc54018-1c88-37f0-8423-de04871685d8",
                        "source_sense_description": "to cease activity",
                        "target_lang_word": "stagnieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stagnieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "238517e5-3414-33b5-8422-da626dd1cc65",
                                        "entry_id": "f607037c-289a-3f46-be86-98678e9838c5",
                                        "glosses": [
                                            "nicht fließen, nicht zirkulieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eab6975-e201-4871-8acf-d9f9af83e2b5",
                                                "sense_id": "238517e5-3414-33b5-8422-da626dd1cc65",
                                                "text": "„Nach 2001 wurder der Zuzug von Pakistanern in die USA politisch erschwert und stagniert seitdem.“"
                                            },
                                            {
                                                "example_id": "25da75a0-0dcc-48bd-979c-42faca81fb9c",
                                                "sense_id": "238517e5-3414-33b5-8422-da626dd1cc65",
                                                "text": "„Die CO2-Emissionen der Menschheit stagnieren derzeit bei 40 Milliarden Tonnen jährlich, viel zu viel, um eine Trendwende bei der kommenden Klimaüberhitzung auch nur einzuleiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b915480-b86b-3c61-8b8d-c56c4d9af343",
                                        "entry_id": "f607037c-289a-3f46-be86-98678e9838c5",
                                        "glosses": [
                                            "auf gleichem Niveau bleiben; sich nicht weiterentwickeln"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4ea478-f26f-46d0-aefb-c00e12c8d915",
                                                "sense_id": "5b915480-b86b-3c61-8b8d-c56c4d9af343",
                                                "text": "Die Verkaufszahlen stagnieren auf hohem Niveau."
                                            },
                                            {
                                                "example_id": "54aaac00-19b8-473d-b6d5-85618aa1d01a",
                                                "sense_id": "5b915480-b86b-3c61-8b8d-c56c4d9af343",
                                                "text": "[Nach einer finnischen Studie] stagnierte der Ausbau der Windenergie in Deutschland, „schrumpfte nach 2015 und blieb weit hinter dem übrigen Europa zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
