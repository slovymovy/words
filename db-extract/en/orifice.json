                                                "example_id": "79021931-d399-41f2-9e8e-07fc718501e0",
                                                "sense_id": "98dcc998-faa5-3996-b9bd-adb60bdea48b",
                                                "text": "Wir zwängten uns durch die schmale Öffnung hindurch."
