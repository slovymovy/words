                                    {
                                        "sense_id": "6184689c-a92d-35ae-aff4-e8cf1dfb7525",
                                        "entry_id": "422db01f-69b0-3a34-8375-03eaa30c96c8",
                                        "glosses": [
                                            "Genre de plantes de la famille des Asteraceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df09c033-44c8-460f-8e59-b315a7883134",
                                                "sense_id": "6184689c-a92d-35ae-aff4-e8cf1dfb7525",
                                                "text": "J’ai aussi comme tout le monde mes gourmandises préférées : les berces, par exemple ; le liondent ; ou le chardon des champs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "798a44ea-0442-4d1f-bea5-e13c34f932e6",
                        "source_entry_id": "9d5bd423-5a3a-3877-abc9-54634d05cfab",
                        "source_sense_id": "3d48d742-ca6d-3d9c-91d8-263eb835068e",
                        "source_sense_description": "flower of the genus Leontodon",
                        "target_lang_word": "Löwenzahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Löwenzahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                        "entry_id": "78f9650c-119d-3d32-adfc-ba4535a32041",
                                        "glosses": [
                                            "die Pflanzengattung Taraxacum aus der Familie der Korbblütler (Asteraceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a81b1b0-06c4-49f7-8d70-9cbd0a1a4509",
                                                "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                                "text": "Der Löwenzahn wächst überall im Garten."
                                            },
                                            {
                                                "example_id": "e2fb4966-48b7-4c09-9d54-514abf0eecd0",
                                                "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                                "text": "„Die auffällige Entwicklung von der Knospe bis zur Pusteblume, deren Samen schließlich vom Wind verweht werden, ließen den Löwenzahn zur Symbolblume für die Vergänglichkeit werden.“"
                                            },
                                            {
                                                "example_id": "93a845a7-e031-422a-beab-900b5f0ed177",
                                                "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                                "text": "„Der Löwenzahn. Symbol für die Auferstehung im Mittelalter. […]. Eine frühe Darstellung des Löwenzahns innerhalb einer Szene der Auferstehung findet sich im Evangeliar Ottos III. (Abb. 13).“"
                                            },
                                            {
                                                "example_id": "0a25a40b-6446-4dc4-9d62-7e4e7c78a7d1",
                                                "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                                "text": "„Auch wird der Löwenzahn als diejenige Wiesenpflanze bezeichnet, die als einzige resistent ist gegen Unkrautvernichtungsmittel. Sie erscheint demnach auch als Symbol des Widerstandes.“"
                                            },
                                            {
                                                "example_id": "aee2af0b-4bb5-4ff2-9768-11ab1afa4b1e",
                                                "sense_id": "aad65704-5a42-367f-af7a-35e39b23b6eb",
                                                "text": "„Als Parteisymbol wählte man eine der wohl schwedischsten Sommerblumen, den Löwenzahn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "541cae26-4656-374f-ac75-ef1f07ba918d",
                                        "entry_id": "78f9650c-119d-3d32-adfc-ba4535a32041",
                                        "glosses": [
                                            "Vertreter der Gattung [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0fd6add-ae15-4e7a-a4c7-a67b92c2c0ee",
                                                "sense_id": "541cae26-4656-374f-ac75-ef1f07ba918d",
                                                "text": "„Und der Löwenzahn, die Rosen und die Sonnenblumen senken still ihre Köpfe – wie die Mädchen, die um uns Einsame wissen.“"
                                            },
                                            {
                                                "example_id": "8d2bdb87-262d-4510-b288-6bedaf7733a1",
                                                "sense_id": "541cae26-4656-374f-ac75-ef1f07ba918d",
                                                "text": "„Ich hatte erwartet, den Garten halb zugewachsen vorzufinden, jetzt, wo sich niemand darum kümmerte, aber so war es nicht, die Kiefernhecke war schön und dicht, der Rasen frei von Löwenzahn, die Zitterpappel schlank und wohlfrisiert, auch wenn sie inzwischen ebenso hoch war wie die Fahnenstange.“"
                                            },
                                            {
                                                "example_id": "97a19fd5-44a4-410b-9dc5-3175b65da834",
                                                "sense_id": "541cae26-4656-374f-ac75-ef1f07ba918d",
                                                "text": "Der Löwenzahn blüht leuchtend gelb."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfd3c869-4607-3df1-9b19-4169d354b53f",
                                        "entry_id": "78f9650c-119d-3d32-adfc-ba4535a32041",
                                        "glosses": [
                                            "die Pflanzengattung Leontodon aus der Familie der Korbblütler (Asteraceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a5ffb6-1aee-488f-8bcb-625097812838",
                                                "sense_id": "bfd3c869-4607-3df1-9b19-4169d354b53f",
                                                "text": "„Im Unterschied zu den verbreitesten ‚echten‘ Löwenzahn-Arten Rauer Löwenzahn (Leontodon hispidus L.) und Herbst-Löwenzahn (Leontodon autumnalis L.), die von Juli bis Oktober blühen, gehört der Gemeine Löwenzahn zu den frühen Sommerblühern (April bis Juli).“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4145a061-42d7-3519-ba97-4b90a0d696c3",
                                        "entry_id": "78f9650c-119d-3d32-adfc-ba4535a32041",
                                        "glosses": [
                                            "Vertreter der Gattung [3]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e18605-3249-4e07-a124-282351162f8b",
                                                "sense_id": "4145a061-42d7-3519-ba97-4b90a0d696c3",
                                                "text": "Der Löwenzahn blüht leuchtend gelb."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "49620dd9-72f1-3776-ba9e-1e3335627414",
                                        "entry_id": "78f9650c-119d-3d32-adfc-ba4535a32041",
                                        "glosses": [
                                            "Zahn eines Löwen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9469c18a-63f7-490e-a97a-75a10c3d2522",
                                                "sense_id": "49620dd9-72f1-3776-ba9e-1e3335627414",
                                                "text": "„Tiger-, Panther- und Löwenzähne enthalten eine derartige Menge Magnesium, daß diese fleischfressenden wilden Tiere mit Leichtigkeit Tierknochen zermalmen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a7d7e35-604b-4ccd-ae77-16da9d9ecedc",
                        "source_entry_id": "9d5bd423-5a3a-3877-abc9-54634d05cfab",
