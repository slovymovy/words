                    {
                        "sense_id": "802e7959-5f3b-37a1-9302-527df15e3795",
                        "entry_id": "b2e5d7b1-3fb0-33a9-9129-6ec17011afbf",
                        "glosses": [
                            "kunstwerk of versiering gemaakt door hout of ander materiaal met een mes of beitel te bewerken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d521cad8-03c2-455f-8a45-f179824e60a1",
                                "sense_id": "802e7959-5f3b-37a1-9302-527df15e3795",
                                "text": "Met getijdenboeken, brevieren, gebedenboeken, losse miniaturen, paneelschilderijen, sculpturen, beeldsnijwerken, archiefstukken en edelsmeedkunst wordt het culturele klimaat van het hertogdom Gelre en omstreken geschetst."
                            },
                            {
                                "example_id": "2cf5386b-58d9-437b-881c-50d0085d4377",
                                "sense_id": "802e7959-5f3b-37a1-9302-527df15e3795",
                                "text": "De kast was in de zeventiende eeuw dan ook het belangrijkste meubelstuk. De bezitter gaf uiting aan zijn welvaart door de kostbaarheid van de gebruikte houtsoorten en de mate van bewerking. Vooral de destijds geliefde kussenkast, met afgeplatte 'diamantkoppen' op de deuren en soms ook nog versierd met beeldsnijwerk, is bekend gebleven."
                            }
                        ]
                    }
