                "senses": [
                    {
                        "sense_id": "d20e6d67-9ed2-37af-9b80-95a43af256d0",
                        "entry_id": "bab59a58-7120-3a18-8ecc-2cdca297ece0",
                        "glosses": [
                            "Vorsteher der Hofhaltung bei den fränkischen Königen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "037ee290-679a-4368-836d-d28bf2de5d4d",
                                "sense_id": "d20e6d67-9ed2-37af-9b80-95a43af256d0",
                                "text": "Die Hausmeier schwangen sich als Stellvertreter der fränkischen Könige allmählich zu den eigentlichen Herrschern auf."
                            },
                            {
                                "example_id": "5906106d-a492-4160-9d8f-b69a99399e60",
                                "sense_id": "d20e6d67-9ed2-37af-9b80-95a43af256d0",
                                "text": "„Weshalb mögen die karolingischen Hausmeier mit dem Griff nach der Krone gezögert haben?“"
                            },
                            {
                                "example_id": "1a406a8d-7fb0-4ecd-bb12-88941ac8203a",
                                "sense_id": "d20e6d67-9ed2-37af-9b80-95a43af256d0",
                                "text": "„Auch das Amt des Hausmeiers wurde, als Pippin, der Sohn Karl Martells, König wurde, verständlicherweise abgeschafft.“"
                            },
                            {
                                "example_id": "b3e98dd0-8011-45ea-b68c-926581999853",
                                "sense_id": "d20e6d67-9ed2-37af-9b80-95a43af256d0",
                                "text": "„Die Ruchlosigkeit der Hausmeier empörte sie keineswegs – und sie legten Anquetil beiseite, von der Albernheit seiner Betrachtungen abgestoßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
