                "senses": [
                    {
                        "sense_id": "d85869fa-b155-32fa-a0cf-64e3314d07d1",
                        "entry_id": "f953a0b4-c593-3fb6-817f-966d6efed876",
                        "glosses": [
                            "etwas, das einer höheren Macht geopfert wird, um von ihr etwas zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab215e1-4da6-4f92-ac0e-d37087067a03",
                                "sense_id": "d85869fa-b155-32fa-a0cf-64e3314d07d1",
                                "text": "„Kaum nachweisbar sind Opfergaben der einfachen Bevölkerung.“"
                            },
                            {
                                "example_id": "248b02a2-a77d-46fc-b020-fc2f3bbf6a52",
                                "sense_id": "d85869fa-b155-32fa-a0cf-64e3314d07d1",
                                "text": "„Schließlich kramte er sein Portemonnaie hervor und legte ein Bündel Scheine so behutsam auf das Waschbecken, als platziere er eine Opfergabe vor einem Schrein.“"
                            },
                            {
                                "example_id": "ea13d2b8-d531-499b-ab68-92fbe089f799",
                                "sense_id": "d85869fa-b155-32fa-a0cf-64e3314d07d1",
                                "text": "„Man muss also den Göttern Opfergaben bringen, wenn man Göttliches schauen oder in seinem Leben bedeutende Dinge erschaffen will.“"
                            },
                            {
                                "example_id": "c17ca108-f71a-46e0-afdf-6e436dd1f416",
                                "sense_id": "d85869fa-b155-32fa-a0cf-64e3314d07d1",
                                "text": "„Überhaupt sind keltische Opfergaben in Seen und Flüssen recht häufig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
