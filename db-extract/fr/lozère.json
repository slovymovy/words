                                "sense_id": "b898a0fb-7b21-3eed-b9b5-b81569f8742b",
                                "text": "La Lozère, hyper-rurale, et alors ?"
                            },
                            {
                                "example_id": "7e8e7275-e2d3-43ff-9b0f-2af7496ea7f2",
                                "sense_id": "b898a0fb-7b21-3eed-b9b5-b81569f8742b",
                                "text": "Ce n’était pas folichon, avec une centaine de personnes un dimanche à 16 h, reconnaît Laurent Suau, le maire du chef-lieu de la Lozère."
                            },
                            {
                                "example_id": "957b3b8d-4a22-4e15-928d-254b243a5d87",
                                "sense_id": "b898a0fb-7b21-3eed-b9b5-b81569f8742b",
                                "text": "Approche donc… Que je te présente à mon pays… Oui, mon garçon, Pradier est de la Lozère, comme moi."
                            }
                        ]
                    }
