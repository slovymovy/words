                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les divinités de la <w>fable</w> grecque possédaient souvent des faiblesses humaines."
                        },
                        {
                            "text": "Ce dictionnaire répertorie les héros célèbres et les monstres issus de la <w>fable</w> antique."
