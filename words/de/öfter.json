                    "frequency": "High",
                    "semantic_group_id": "haeufigkeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seit dem Umzug gehe ich viel <w>öfter</w> zu Fuß zur Arbeit als früher.",
                            "target_lang_translations": {
                                "en": "Since moving, I walk to work much <w>more often</w> than before."
                            }
                        },
                        {
                            "text": "Du solltest dir <w>öfter</w> eine Pause gönnen, um gesund zu bleiben.",
                            "target_lang_translations": {
                                "en": "You should treat yourself to a break <w>more often</w> to stay healthy."
                            }
