                "senses": [
                    {
                        "sense_id": "b2a9b1e2-743c-3de2-97d0-503a8f4fd8cb",
                        "entry_id": "ab34c80c-1323-368c-a61c-1a25d81553e5",
                        "glosses": [
                            "перекрестить кого-либо, произнося слова молитвы, напутствия, пожелания"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "287a87d8-356d-3222-be71-d5eba101df40",
                        "entry_id": "ab34c80c-1323-368c-a61c-1a25d81553e5",
                        "glosses": [
                            "выразить свое одобрение, доброжелательно направить на что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39046d1a-3436-4249-99fd-0b8a59f045d8",
                                "sense_id": "287a87d8-356d-3222-be71-d5eba101df40",
                                "text": "Бог, воскресив Сына Своего Иисуса, к вам первым послал Его благословить вас, отвращая каждого от злых дел ваших."
                            }
                        ]
                    },
                    {
                        "sense_id": "74dab83a-a178-3f52-a5ee-143c85b4e04e",
                        "entry_id": "ab34c80c-1323-368c-a61c-1a25d81553e5",
                        "glosses": [
                            "возблагодарить"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0814852f-cebb-46f1-9543-0ec6544569b8",
                        "source_entry_id": "ab34c80c-1323-368c-a61c-1a25d81553e5",
                        "target_lang_word": "bless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ca9599-39d9-302e-867e-b5812fe26997",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To make something holy by religious rite, sanctify."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccefe550-b914-3f29-9513-ad8a0b2b0b19",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To invoke divine favor upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab3318e1-2688-44f1-8ce0-26969ee84cc5",
                                                "sense_id": "ccefe550-b914-3f29-9513-ad8a0b2b0b19",
                                                "text": "In some countries, priests bless farm animals on St. Anthony's Day."
                                            },
                                            {
                                                "example_id": "cfbd98ba-235e-4136-91fd-88566d3d1a81",
                                                "sense_id": "ccefe550-b914-3f29-9513-ad8a0b2b0b19",
                                                "text": "In many families, a grace is said before dinner to give thanks for and bless the food."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd686dc2-9415-315f-bc96-697f249a5bf2",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To honor as holy, glorify; to extol for excellence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f9a4c6-a9e3-4f55-8f1d-d930534c1ace",
                                                "sense_id": "dd686dc2-9415-315f-bc96-697f249a5bf2",
                                                "text": "A Pſalme of Dauid. Bleſſe the Lord, O my ſoule: and all that is within me, bleſſe his holy Name."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bbf66ae-41d8-3d5e-abaa-0261220b9f13",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To esteem or account happy; to felicitate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85cfded1-4b0c-435c-a600-837df2f9df0d",
                                                "sense_id": "0bbf66ae-41d8-3d5e-abaa-0261220b9f13",
                                                "text": "And thou ſhalt ſweare, The Lord liueth, in Trueth, in Iudgement, and in Righteouſnes, and the nations ſhall bleſſe themſelues in him, and in him ſhall they glorie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c81828c-8471-3ff1-8210-b247e5c3b182",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To make the sign of the cross upon, so as to sanctify."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2628b1d4-61fc-464f-931f-5740a6e727a3",
                                                "sense_id": "3c81828c-8471-3ff1-8210-b247e5c3b182",
                                                "text": "the archbishop vsing certeine praiers, blessed the king"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "652ea8d2-2cd6-3e15-9803-6dbd0f9dcd92",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To wave; to brandish."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a05a517-98e2-46b7-b7ee-d033104729c8",
                                                "sense_id": "652ea8d2-2cd6-3e15-9803-6dbd0f9dcd92",
                                                "text": "And burning blades about their heads do blesse."
                                            },
                                            {
                                                "example_id": "f7f92c15-2033-4d94-98c8-1809330337da",
                                                "sense_id": "652ea8d2-2cd6-3e15-9803-6dbd0f9dcd92",
                                                "text": "Round his armed head his trenchant blade he blest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea7d554-09fe-3f9e-954d-d09fd9204da0",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To turn (a reference) into an object."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7b994df-db9d-3e19-9761-93adbc3ce1a4",
                                        "entry_id": "43cd01b2-b808-38db-8f00-dc0b28994ed0",
                                        "glosses": [
                                            "To secure, defend, or prevent from."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d071932d-43ca-4e0f-bca1-552496bfcdfd",
