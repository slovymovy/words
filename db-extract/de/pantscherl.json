                "senses": [
                    {
                        "sense_id": "22874008-11a6-38bb-93cc-dd9ee1744963",
                        "entry_id": "f23fd2b2-ff01-30b5-8d43-86ad684c02c9",
                        "glosses": [
                            "flüchtige (sexuelle) Beziehung"
                        ],
                        "tags": [
                            "Österreich, umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "1212f5b3-6bc4-41e0-8048-767eecb7c911",
                                "sense_id": "22874008-11a6-38bb-93cc-dd9ee1744963",
                                "text": "„Aber schon als Arnie das Pantscherl mit seiner Haushälterin gestand, hatten wir ihn wieder lieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "46ea6fd2-a885-3bac-b8c9-ee3ca1eaffbb",
                        "entry_id": "f23fd2b2-ff01-30b5-8d43-86ad684c02c9",
                        "glosses": [
                            "Partner in einer (kurzfristigen) Liebesbeziehung"
                        ],
                        "tags": [
                            "Österreich, umgangssprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "2cdcab11-3680-426b-9812-c5d7b7e651b1",
                                "sense_id": "46ea6fd2-a885-3bac-b8c9-ee3ca1eaffbb",
                                "text": "Er brachte sein Pantscherl sogar mit zur Weihnachtsfeier der Firma und ließ die Ehefrau daheim."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d197159c-b70d-48be-a336-6de811c3c0f1",
                        "source_entry_id": "f23fd2b2-ff01-30b5-8d43-86ad684c02c9",
                        "source_sense_id": "22874008-11a6-38bb-93cc-dd9ee1744963",
                        "source_sense_description": "flüchtige (sexuelle) Beziehung",
                        "target_lang_word": "dalliance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dalliance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d32e0dc-1724-3128-8f1e-eed30793f4e8",
                                        "entry_id": "0e86d8e1-3373-34df-a6c3-6f186c10e657",
                                        "glosses": [
                                            "Playful flirtation; amorous play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "904bedbe-ca3a-43c7-8636-21a30a94ec50",
                                                "sense_id": "1d32e0dc-1724-3128-8f1e-eed30793f4e8",
                                                "text": "As in the season of rutting (an uncouth phrase, by which the vulgar denote that gentle dalliance, which in the well-wooded forest of Hampshire, passes between lovers of the ferine kind),"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71826615-0cfc-3762-a176-811428eba475",
                                        "entry_id": "0e86d8e1-3373-34df-a6c3-6f186c10e657",
                                        "glosses": [
                                            "An episode of dabbling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef0dbaa7-9585-38b3-b66f-5f21cb752630",
                                        "entry_id": "0e86d8e1-3373-34df-a6c3-6f186c10e657",
                                        "glosses": [
                                            "A wasting of time in idleness or trifles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f46c85b-5fee-4ef4-8fc1-12dd62ce0e03",
                                                "sense_id": "ef0dbaa7-9585-38b3-b66f-5f21cb752630",
                                                "text": "But, with a gesture, she put a period to this dalliance—one shouldn't palter so on an empty stomach, she might almost have said."
                                            },
                                            {
                                                "example_id": "a368fc3f-a2d2-4333-96ad-bcbb706d7b48",
                                                "sense_id": "ef0dbaa7-9585-38b3-b66f-5f21cb752630",
                                                "text": "Quite a few minutes would be spun out, for instance, at the smallish town of Chirk, but to me the dalliance was generally worthwhile, except in wet weather, because of the increasing beauty of the wooded hill scenery thereabouts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b5e51f8-2331-3038-8035-6932c5a2066d",
                                        "entry_id": "0e86d8e1-3373-34df-a6c3-6f186c10e657",
                                        "glosses": [
                                            "A sexual relationship, not serious but often illicit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
