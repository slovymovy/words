                "senses": [
                    {
                        "sense_id": "6f81ff70-72a6-360c-a74b-a3c02a07808f",
                        "entry_id": "6c3aabde-6a01-3fb9-9830-76660ce84c30",
                        "glosses": [
                            "Donner un caractère périodique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8e4089b-553d-4948-aeca-6b00ef609a18",
                                "sense_id": "6f81ff70-72a6-360c-a74b-a3c02a07808f",
                                "text": "Parce que seule la vision longue permet de faire émerger les ruptures, les seuils, les inversions de tendance, de périodiciser des cheminements."
                            },
                            {
                                "example_id": "1a54c022-5b66-43b5-974b-811e3f9d3753",
                                "sense_id": "6f81ff70-72a6-360c-a74b-a3c02a07808f",
                                "text": "Avec la seconde question que nous avons retenue - l’idée fondatrice écartée -, nous devions repérer les opérateurs réels qui assurent les victoires et, en fonction d’eux, « périodiciser » celles-ci."
                            }
                        ]
                    }
