                "translations": [
                    {
                        "translation_id": "b9bb629a-0c7b-4d37-906e-6844d71a0f98",
                        "source_entry_id": "a565bee2-6f18-345a-9398-08144c26a5a7",
                        "source_sense_id": "f3d1438f-27e3-378b-a299-ebd59673aaaa",
                        "target_lang_word": "liberation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "The act of liberating or the state of being liberated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b205b989-2675-41de-b549-c2a6ed03ca54",
                                                "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                                "text": "The liberation of American slaves was accomplished by the Department of War, that of British slaves by the Exchequer."
                                            },
                                            {
                                                "example_id": "ae8a9c9a-0082-4fec-b4a7-a23c0e935c99",
                                                "sense_id": "a07f5e2e-5d60-393e-aafd-4a77f08555e9",
                                                "text": "People saw in the elders, who were closer to death, the manifestation of the divine force that was thought to achieve its full liberation at death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba17b8c1-7f0c-35d7-8733-9edfe2ccaabf",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "Synonym of conquest or theft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "ironic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf44f717-df6f-33c1-abd7-4a4eb69a73d3",
                                        "entry_id": "833c04c6-9d72-35c8-8d5a-339396c6a7f6",
                                        "glosses": [
                                            "The achievement of equal rights and status, particularly as seen as freedom from historic and structural oppression."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841a8f72-e75b-4369-96b6-c3720433f381",
                                                "sense_id": "cf44f717-df6f-33c1-abd7-4a4eb69a73d3",
                                                "text": "women's liberation... black liberation... gay liberation..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98f97209-5939-4e75-a320-5bafd1f46124",
                        "source_entry_id": "a565bee2-6f18-345a-9398-08144c26a5a7",
                        "source_sense_id": "f3d1438f-27e3-378b-a299-ebd59673aaaa",
                        "target_lang_word": "deliverance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliverance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "404cd4eb-69ad-32f2-89eb-23f876f4052b",
                                        "entry_id": "234aab89-0448-30b5-9062-ec6b5ed9f97c",
                                        "glosses": [
                                            "The act of setting free or extricating from danger, imprisonment, bondage, evil, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2ead99-8df4-41db-8fdf-b44722f2a03f",
                                                "sense_id": "404cd4eb-69ad-32f2-89eb-23f876f4052b",
                                                "text": "Now, another fella told me he had a sister who looked just fine\nInstead of being my deliverance, she had a strange resemblance\nTo a cat named Frankenstein."
                                            },
                                            {
                                                "example_id": "1a9c967c-a156-46e4-a3be-153c314656b8",
                                                "sense_id": "404cd4eb-69ad-32f2-89eb-23f876f4052b",
                                                "text": "Moses answered the people, \"Do not be afraid. Stand firm and you will see the deliverance the Lord will bring you today. The Egyptians you see today you will never see again."
                                            },
                                            {
                                                "example_id": "4cffcf2d-0b8a-4dc8-bc8b-706a2da03829",
                                                "sense_id": "404cd4eb-69ad-32f2-89eb-23f876f4052b",
                                                "text": "In an era when political leaders promise deliverance from decline through America’s purported preeminence in scientific research, the news that science is in deep trouble in the United States has been as unwelcome as a diagnosis of leukemia following the loss of health insurance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2625e9-87bc-3925-9456-4582c10e4fc2",
                                        "entry_id": "234aab89-0448-30b5-9062-ec6b5ed9f97c",
                                        "glosses": [
                                            "The act of delivering or conveying something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "738a59fe-b8fa-43f4-a0f1-8f75da03e9f4",
                                                "sense_id": "8d2625e9-87bc-3925-9456-4582c10e4fc2",
                                                "text": "\"We're right on schedule as far as the deliverance of those bins is concerned and everybody will have both of their bins ready to start both collections in early December,\" he said."
                                            },
                                            {
                                                "example_id": "3c42d2d6-990a-4a9e-af4e-6129f530b8bb",
                                                "sense_id": "8d2625e9-87bc-3925-9456-4582c10e4fc2",
                                                "text": "Voluntary contributions are no longer supplementary to the deliverance of basic education requirements in many primary schools - they are essential, according to a recent survey by the ACT Councils of Parents and Citizens Associations Inc."
                                            },
                                            {
                                                "example_id": "1a3a676e-8f83-4ca1-a5fe-8f9634ff7749",
                                                "sense_id": "8d2625e9-87bc-3925-9456-4582c10e4fc2",
                                                "text": "Huge non-recoupable advance, majors be vigilant / I excel in both content and deliverance"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182e5e56-9018-304a-98ce-aa5d80ff52be",
                                        "entry_id": "234aab89-0448-30b5-9062-ec6b5ed9f97c",
                                        "glosses": [
                                            "Delivery in childbirth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
