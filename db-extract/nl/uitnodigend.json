                        "source_sense_id": "ecd9d72f-b979-35b4-9ab1-236d4c16923b",
                        "source_sense_description": "prettig en comfortabel en daardoor verleidelijk om te gebruiken",
                        "target_lang_word": "lovely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
