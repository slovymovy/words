                "senses": [
                    {
                        "sense_id": "f6b3a566-263d-3db8-97a2-32cf1e4f66d5",
                        "entry_id": "dabaf9dd-c84a-3c1d-b5c6-a0a3bc27bc12",
                        "glosses": [
                            "Planté d’arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ad6b16d-d79c-41d3-aa6d-ef301a62d9b6",
                                "sense_id": "f6b3a566-263d-3db8-97a2-32cf1e4f66d5",
                                "text": "Dotée d’un terre-plein central arboré et fleuri, l’Avenue Louis-Bertrand créée en 1905 compte parmi les plus belles du Bruxelles."
                            },
                            {
                                "example_id": "b269aa75-b8b8-467e-abcf-0b63145034f4",
                                "sense_id": "f6b3a566-263d-3db8-97a2-32cf1e4f66d5",
                                "text": "Quand on sort du bâtiment d'autres Israéliens enveloppés errent sur le terre-plein arboré."
                            },
                            {
                                "example_id": "fdf1f442-0e6f-41a0-bcc8-27c0489c21ff",
                                "sense_id": "f6b3a566-263d-3db8-97a2-32cf1e4f66d5",
                                "text": "La préfecture du Rhône a alors été invitée à mettre à disposition son vaste parc arboré, situé en cœur de ville."
                            }
                        ]
                    }
                ],
