                        "examples": [
                            {
                                "example_id": "ea6903c0-440e-4d0a-bc97-b99228c38784",
                                "sense_id": "ac70cc1b-2b78-3670-806b-b5c182adf08a",
                                "text": "Он немно́го подожда́л, гля́дя вслед бра́ту. Почему́-то заприме́тил вдруг, что брат Ива́н идё́т ка́к-то раска́чиваясь и что у него́ пра́вое плечо́, е́сли сза́ди гляде́ть, ка́жется ни́же ле́вого.",
                                "translation": "He waited a little, looking after his brother. He suddenly noticed that Ivan swayed as he walked and that his right shoulder looked lower than his left.",
                                "english": "He waited a little, looking after his brother. He suddenly noticed that Ivan swayed as he walked and that his right shoulder looked lower than his left."
                            }
                        ]
                    }
