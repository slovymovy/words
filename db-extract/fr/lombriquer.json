                "senses": [
                    {
                        "sense_id": "cf9ed294-d53f-3176-8747-36dad5bc5328",
                        "entry_id": "5c034d2e-ba87-339e-918d-3c0b8a95e2ea",
                        "glosses": [
                            "Creuser comme un lombric."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a161bf-92f5-48a6-a660-ae08ab9a8158",
                                "sense_id": "cf9ed294-d53f-3176-8747-36dad5bc5328",
                                "text": "Œufants, lombriquez les tuyaux du temps!"
                            },
                            {
                                "example_id": "f2693f35-da5e-4ba0-8cd7-178a9725bd0d",
                                "sense_id": "cf9ed294-d53f-3176-8747-36dad5bc5328",
                                "text": "Hourrah, j’en ai fini de lombriquer la terre, annonce au maître que je pars pour Londres et la belle vie, et, ah oui, tiens, voici un shilling pour tes services"
                            }
                        ]
                    },
                    {
                        "sense_id": "10745bbe-fcb7-38e2-b7d6-bb6a806346f0",
                        "entry_id": "5c034d2e-ba87-339e-918d-3c0b8a95e2ea",
                        "glosses": [
                            "Se déplacer comme un lombric."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22a46213-ae41-4ef3-8585-d17a3ea65c80",
                                "sense_id": "10745bbe-fcb7-38e2-b7d6-bb6a806346f0",
                                "text": "Plutôt qu’il ne marche, il rampe, il « lombrique »."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f459f61-065b-3ff9-89d1-d17e30f34222",
                        "entry_id": "5c034d2e-ba87-339e-918d-3c0b8a95e2ea",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d97093c-3116-4427-a6e9-e153d0a17a17",
                                "sense_id": "7f459f61-065b-3ff9-89d1-d17e30f34222",
                                "text": "Je me tapote les deux oreillers + quelques coussins sup et je lombrique, lunettes sur le nez, livre sur les genoux, jusqu'à ce que la matinée cède le pas à l'aprem. Un luxe."
                            },
                            {
                                "example_id": "eefc6022-b5e8-4b27-9a4d-d750d3061983",
                                "sense_id": "7f459f61-065b-3ff9-89d1-d17e30f34222",
                                "text": "Allez les Verts et ne lombriquez pas s'il vous plait."
                            }
                        ]
                    }
