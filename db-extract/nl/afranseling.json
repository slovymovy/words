                        "examples": [
                            {
                                "example_id": "8d241ed0-f43c-478d-b1c4-fbbf214d1da3",
                                "sense_id": "83a63034-0beb-3195-9e22-0f494e32dacd",
                                "text": "De aanleiding van de afranseling is een mislukte drugsdeal. Daar zijn verdachten en slachtoffer het over eens."
                            },
                            {
                                "example_id": "eaec83eb-f1c3-44d6-9e35-700e1624f517",
                                "sense_id": "83a63034-0beb-3195-9e22-0f494e32dacd",
                                "text": "Een 84-jarige vrouw die na een zware afranseling in verpleeghuis Grootenhoek in Hellevoetsluis ernstig gewond raakte, heeft volgens haar familie onvoldoende medische zorg gekregen. De Inspectie voor de Gezondheidszorg en de politie doen inmiddels onderzoek naar de zaak."
                            }
                        ]
                    }
                ],
