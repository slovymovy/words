                    "sense_id": "88b51ae7-0bf7-3021-b8bb-dd9b33ae02ee",
                    "sense_definition": "Een vloeistof met een lekkere geur die mensen op hun huid of kleding doen om lekker te ruiken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "product",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kocht een duur flesje <w>parfum</w> voor haar verjaardag.",
                            "target_lang_translations": {
                                "en": "She bought an expensive bottle of <w>perfume</w> for her birthday.",
                                "ru": "Она купила дорогой флакон <w>духов</w> на свой день рождения.",
                                "pl": "Kupiła drogi flakon <w>perfum</w> na swoje urodziny.",
                                "de": "Sie kaufte ein teures Fläschchen <w>Parfüm</w> zu ihrem Geburtstag.",
                                "fr": "Elle a acheté un flacon de <w>parfum</w> coûteux pour son anniversaire.",
                                "it": "Ha comprato una costosa boccetta di <w>profumo</w> per il suo compleanno.",
                                "cs": "K narozeninám si koupila drahý flakonek <w>parfému</w>.",
                                "tr": "Doğum günü için pahalı bir şişe <w>parfüm</w> aldı.",
                                "es": "Ella compró un frasco caro de <w>perfume</w> para su cumpleaños.",
                                "zh": "她为自己的生日买了一瓶昂贵的<w>香水</w>。"
                            }
                        },
                        {
                            "text": "Welk <w>parfum</w> draag jij vandaag?",
                            "target_lang_translations": {
                                "en": "Which <w>perfume</w> are you wearing today?",
                                "ru": "Какие <w>духи</w> на тебе сегодня?",
                                "pl": "Jakich <w>perfum</w> dzisiaj używasz?",
                                "de": "Welches <w>Parfüm</w> trägst du heute?",
                                "fr": "Quel <w>parfum</w> portes-tu aujourd'hui ?",
                                "it": "Che <w>profumo</w> indossi oggi?",
                                "cs": "Jaký <w>parfém</w> máš dnes na sobě?",
                                "tr": "Bugün hangi <w>parfümü</w> kullanıyorsun?",
                                "es": "¿Qué <w>perfume</w> llevas puesto hoy?",
                                "zh": "你今天用了什么<w>香水</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "flesje parfum",
                        "parfum opdoen",
                        "duur parfum"
                    ],
                    "target_lang_definitions": {
                        "en": "A liquid with a pleasant scent applied to the skin or clothing to smell good.",
                        "ru": "Жидкость с приятным запахом, которую наносят на кожу или одежду, чтобы приятно пахнуть.",
                        "pl": "Płyn o przyjemnym zapachu, który ludzie nakładają na skórę lub ubranie, aby ładnie pachnieć.",
                        "de": "Eine Flüssigkeit mit einem angenehmen Duft, die auf Haut oder Kleidung aufgetragen wird, um gut zu riechen.",
                        "fr": "Un liquide à l'odeur agréable que l'on applique sur la peau ou les vêtements pour sentir bon.",
                        "it": "Un liquido con un odore gradevole che le persone applicano sulla pelle o sui vestiti per profumare.",
                        "cs": "Tekutina s příjemnou vůní, kterou lidé používají na kůži nebo oblečení, aby voněli.",
                        "tr": "İnsanların güzel kokmak için ciltlerine veya kıyafetlerine sürdükleri hoş kokulu sıvı.",
                        "es": "Un líquido con un aroma agradable que las personas aplican sobre su piel o ropa para oler bien.",
                        "zh": "一种带有宜人香气的液体，人们将其涂抹在皮肤或衣服上以使身体散发香味。"
                    },
