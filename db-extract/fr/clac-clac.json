                    {
                        "sense_id": "4603a168-5e29-3e7f-b797-54709c333f93",
                        "entry_id": "ca9f61f0-bed1-36d1-bbbb-af30f932c78b",
                        "glosses": [
                            "Bruit régulier de mécanique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "081c8e44-2116-463f-a5ee-fc9e1b7d5592",
                                "sense_id": "4603a168-5e29-3e7f-b797-54709c333f93",
                                "text": "Aux arrêts, dans les gares, tous les bruits du dehors – la sonnerie du télégraphe, le clac-clac rythmique du graisseur, […] –, tout cela vous arrive multiplié par le silence, rendu plus net par la nuit."
                            },
                            {
                                "example_id": "f7c5531d-68a3-4433-82a4-e377997d126c",
                                "sense_id": "4603a168-5e29-3e7f-b797-54709c333f93",
                                "text": "Elle s’énerve, parcourt de son petit pas rapide – clac-clac les chaussures à talons – toute la travée, puis celle qui la croise."
                            },
                            {
                                "example_id": "1fe4196d-979c-49f3-9c1f-1756947cdedf",
                                "sense_id": "4603a168-5e29-3e7f-b797-54709c333f93",
                                "text": "Les Rabinovitch arrivent ensuite dans le quartier polonais, où l'on entend aussi le clac-clac des métiers à tisser."
                            }
                        ]
                    }
                ],
