                ],
                "senses": [
                    {
                        "sense_id": "96883420-7537-3a83-9d10-c6a67e957b6a",
                        "entry_id": "c71ae683-7614-3b8a-a973-6da2e2c1d941",
                        "glosses": [
                            "Enlever le drap qui recouvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3f1ff82-f051-4524-a428-598e977cfb7c",
                                "sense_id": "96883420-7537-3a83-9d10-c6a67e957b6a",
                                "text": "Un homme enfariné, bonnet de coton sur la tête, dédrapait la voilure des ailes."
                            },
                            {
                                "example_id": "38347d52-88df-4e14-84c9-dcdb896666f3",
                                "sense_id": "96883420-7537-3a83-9d10-c6a67e957b6a",
                                "text": "Elle s'en drape et s'en dédrape dans le même mouvement, sans s'arrêter."
                            },
                            {
                                "example_id": "aaaaeee0-eb2b-4c22-8ee2-8a193fd6c5bd",
                                "sense_id": "96883420-7537-3a83-9d10-c6a67e957b6a",
                                "text": "Puis vient la troisième statue qu'elle doit dédraper, & là le mec parti quelques minutes plus tôt revient & elle ne dédrape finalement pas la statue."
                            }
                        ]
                    }
                ],
