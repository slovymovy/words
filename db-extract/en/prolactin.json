                    }
                ],
                "senses": [
                    {
                        "sense_id": "942d76ad-4576-309e-ac5c-469e8d646a27",
                        "entry_id": "e1362920-282e-3170-ba33-a1f5ae58146c",
                        "glosses": [
                            "A peptide gonadotrophic hormone secreted by the pituitary gland; it stimulates growth of the mammary glands and lactation in females."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a8375911-f4f6-429c-8df4-c35e315d6cd2",
                                "sense_id": "942d76ad-4576-309e-ac5c-469e8d646a27",
                                "text": "Men get a dose of the hormone prolactin after orgasm and this acts as a sedative."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceb9b0b9-9e61-43fb-bc95-d75b3002e44e",
                        "source_entry_id": "e1362920-282e-3170-ba33-a1f5ae58146c",
