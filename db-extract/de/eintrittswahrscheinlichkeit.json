                "senses": [
                    {
                        "sense_id": "4672b329-35a3-38d1-8c22-3743d7c64c2d",
                        "entry_id": "0751c8ba-1ffc-3329-b082-5553e7130f7d",
                        "glosses": [
                            "Möglichkeit/Chance/Risiko (zum Beispiel in Prozent ausgedrückt), dass etwas Bestimmtes geschieht (eintritt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df418658-2b7c-4a84-9226-d7e5061a208f",
                                "sense_id": "4672b329-35a3-38d1-8c22-3743d7c64c2d",
                                "text": "Eine Eintrittswahrscheinlichkeit von 0 bedeutet, dass das Ereignis nie eintreten wird."
                            },
                            {
                                "example_id": "36fdf513-d281-41df-a658-f9779251517c",
                                "sense_id": "4672b329-35a3-38d1-8c22-3743d7c64c2d",
                                "text": "„Die Bestimmungsgleichung für den erwarteten Kapitalwert von B kann nun um die mit den Eintrittswahrscheinlichkeiten von 0,4 und 0,6 gewichteten Bestimmungsgleichungen für den Kapitalwert von B1 ergänzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
