{
    "word_family": [
        "stylish",
        "stylist",
        "styling",
        "stylize",
        "restyle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6a5be54-488d-37e1-a23e-e2cc8098fe0f",
                    "sense_definition": "A particular way of dressing, grooming, or looking that is often considered attractive or fashionable.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner_fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She always dresses in a very modern <w>style</w>.",
                            "target_lang_translations": {
                                "ru": "Она всегда одевается в очень современном <w>стиле</w>.",
                                "zh": "她总是穿着非常现代的<w>风格</w>。"
                            }
                        },
                        {
                            "text": "Those old jeans are finally back in <w>style</w> this year.",
                            "target_lang_translations": {
                                "ru": "Эти старые джинсы в этом году наконец-то снова в <w>моде</w>.",
                                "zh": "那些旧牛仔裤今年终于又<w>流行</w>起来了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in style",
                        "out of style",
                        "sense of style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особая манера одеваться, причесываться или выглядеть, часто считающаяся привлекательной или модной.",
                        "zh": "一种特定的穿着、打扮或外貌方式，通常被认为是有吸引力或时尚的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "общая манера или образ"
                            },
                            {
                                "target_lang_word": "мода",
                                "target_lang_sense_clarification": "популярность, тренд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风格",
                                "target_lang_sense_clarification": "整体的打扮或外貌特征"
                            },
                            {
                                "target_lang_word": "时尚",
                                "target_lang_sense_clarification": "流行趋势或潮流"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31c7e0a9-a872-3941-975c-598f246ae361",
                    "sense_definition": "A specific manner of doing, creating, or presenting something, especially in art, architecture, or music.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "manner_fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral was built in the Gothic <w>style</w>.",
                            "target_lang_translations": {
                                "ru": "Собор был построен в готическом <w>стиле</w>.",
                                "zh": "这座大教堂是哥特式<w>风格</w>的建筑。"
                            }
                        },
                        {
                            "text": "Every teacher has a different teaching <w>style</w> in the classroom.",
                            "target_lang_translations": {
                                "ru": "У каждого учителя своя <w>манера</w> преподавания в классе.",
                                "zh": "每位老师在课堂上都有不同的教学<w>方式</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lifestyle",
                        "management style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный способ делать, создавать или представлять что-либо, особенно в искусстве, архитектуре или музыке.",
                        "zh": "做某事、创作或呈现某物的特定方式，尤指在艺术、建筑或音乐领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "направление в искусстве"
                            },
                            {
                                "target_lang_word": "манера",
                                "target_lang_sense_clarification": "индивидуальный способ действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风格",
                                "target_lang_sense_clarification": "艺术或创作的流派"
                            },
                            {
                                "target_lang_word": "方式",
                                "target_lang_sense_clarification": "做事或行动的特定方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9e6c22c-9df5-3b97-95ea-955b1c16b20e",
                    "sense_definition": "A quality of being fashionable, confident, and sophisticated; elegance or flair.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He handled the difficult situation with great <w>style</w> and grace.",
                            "target_lang_translations": {
                                "ru": "Он справился с трудной ситуацией с большим <w>шиком</w> и изяществом.",
                                "zh": "他以极大的<w>风度</w>和优雅处理了那个棘手的局面。"
                            }
                        },
                        {
                            "text": "She arrived at the party with <w>style</w> in a vintage car.",
                            "target_lang_translations": {
                                "ru": "Она прибыла на вечеринку с <w>шиком</w> на ретро-автомобиле.",
                                "zh": "她坐着一辆复古车，很有<w>格调</w>地抵达了派对。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "with style",
                        "have style",
                        "cramp my style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество, выражающееся в модности, уверенности и утонченности; элегантность.",
                        "zh": "一种时尚、自信和精致的品质；优雅或风度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шик",
                                "target_lang_sense_clarification": "особая элегантность и блеск"
                            },
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "наличие вкуса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "风度",
                                "target_lang_sense_clarification": "举止优雅且自信"
                            },
                            {
                                "target_lang_word": "格调",
                                "target_lang_sense_clarification": "具有品味和美感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a4279c3-155b-31db-a450-709c00c02939",
                    "sense_definition": "A distinctive manner of expression in writing or speech, characterized by the choice of words and sentence structure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner_fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author is known for his descriptive writing <w>style</w>.",
                            "target_lang_translations": {
                                "ru": "Автор известен своим описательным <w>стилем</w> письма.",
                                "zh": "这位作者以其描写性的写作<w>文风</w>而闻名。"
                            }
                        },
                        {
                            "text": "Her formal <w>style</w> of speaking made her seem very serious.",
                            "target_lang_translations": {
                                "ru": "Её официальная <w>манера</w> речи заставляла её казаться очень серьезной.",
                                "zh": "她正式的说话<w>语体</w>让她看起来非常严肃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "writing style",
                        "literary style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличительная манера выражения в письме или речи, характеризующаяся выбором слов и структурой предложений.",
                        "zh": "写作或演讲中独特的表达方式，以用词和句式结构为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "манера письма или речи"
                            },
                            {
                                "target_lang_word": "слог",
                                "target_lang_sense_clarification": "литературный стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文风",
                                "target_lang_sense_clarification": "写作的风格"
                            },
                            {
                                "target_lang_word": "语体",
                                "target_lang_sense_clarification": "语言表达的特定形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c49aef8-b00a-3d35-af7b-4960997e127a",
                    "sense_definition": "A formal title or term of address used for a person, especially a monarch or official.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was addressed by his full <w>style</w> and title during the ceremony.",
                            "target_lang_translations": {
                                "ru": "Во время церемонии к королю обращались, называя его полный <w>титул</w> и звание.",
                                "zh": "在仪式上，人们用国王完整的<w>尊称</w>和头衔来称呼他。"
                            }
                        },
                        {
                            "text": "Monarchs are often addressed with the <w>style</w> of Majesty.",
                            "target_lang_translations": {
                                "ru": "К монархам часто обращаются с <w>титулованием</w> \"Ваше Величество\".",
                                "zh": "君主通常被<w>尊称</w>为“陛下”。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный титул или форма обращения к человеку, особенно к монарху или должностному лицу.",
                        "zh": "用于称呼某人的正式头衔或称谓，尤指君主或官员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "титул",
                                "target_lang_sense_clarification": "официальное звание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头衔",
                                "target_lang_sense_clarification": "正式的职位或称号"
                            },
                            {
                                "target_lang_word": "尊称",
                                "target_lang_sense_clarification": "对尊贵者的正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0b1b900-99d2-34a9-b3f8-1eab1e91c3bf",
                    "sense_definition": "The narrow stalk in a flower that connects the ovary to the stigma.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pointed_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollen travels down the <w>style</w> to fertilize the plant.",
                            "target_lang_translations": {
                                "ru": "Пыльца проходит вниз по <w>столбику</w> для оплодотворения растения.",
                                "zh": "花粉顺着<w>花柱</w>向下移动以使植物受精。"
                            }
                        },
                        {
                            "text": "The botanist examined the length of the <w>style</w> under a microscope.",
                            "target_lang_translations": {
                                "ru": "Ботаник изучил длину <w>столбика</w> под микроскопом.",
                                "zh": "植物学家在显微镜下检查了<w>花柱</w>的长度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий стебелек цветка, соединяющий завязь с рыльцем.",
                        "zh": "花朵中连接子房和柱头的细长部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столбик",
                                "target_lang_sense_clarification": "ботанический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "花柱",
                                "target_lang_sense_clarification": "植物学专业术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a3acadd-33ef-3529-bfbc-19693122e08f",
                    "sense_definition": "An ancient writing instrument consisting of a sharp stick used for marking clay or wax tablets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pointed_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scribe used a bronze <w>style</w> to write on the wax tablet.",
                            "target_lang_translations": {
                                "ru": "Писец использовал бронзовое <w>стило</w>, чтобы писать на восковой табличке.",
                                "zh": "抄写员用一支青铜<w>铁笔</w>在蜡板上书写。"
                            }
                        },
                        {
                            "text": "Ancient Romans often wrote with a metal <w>style</w>.",
                            "target_lang_translations": {
                                "ru": "Древние римляне часто писали металлическим <w>стилем</w>.",
                                "zh": "古罗马人经常使用金属<w>铁笔</w>书写。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stylet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древний инструмент для письма в виде острой палочки для нанесения знаков на глиняные или восковые таблички.",
                        "zh": "一种古代书写工具，由尖头棍制成，用于在泥板或蜡板上刻字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стило",
                                "target_lang_sense_clarification": "инструмент для письма"
                            },
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "устаревшее название инструмента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铁笔",
                                "target_lang_sense_clarification": "古代刻写工具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eec846b7-5829-3d59-a217-715bb150f309",
                    "sense_definition": "To design, arrange, or shape something, especially hair or clothing, in a specific or fashionable way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "design_arrange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She asked the hairdresser to <w>style</w> her hair for the wedding.",
                            "target_lang_translations": {
                                "ru": "Она попросила парикмахера <w>уложить</w> ей волосы на свадьбу.",
                                "zh": "她请理发师为她的婚礼<w>造型</w>。"
                            }
                        },
                        {
                            "text": "The interior designer will <w>style</w> the room with modern furniture.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьера <w>оформит</w> комнату современной мебелью.",
                                "zh": "室内设计师将用现代家具来<w>设计</w>这个房间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "style hair",
                        "style an outfit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать дизайн, укладывать или придавать форму чему-либо, особенно волосам или одежде.",
                        "zh": "以特定或时尚的方式设计、安排或塑造某物，尤指头发或服装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укладывать",
                                "target_lang_sense_clarification": "о волосах"
                            },
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "создавать дизайн"
                            },
                            {
                                "target_lang_word": "стилизовать",
                                "target_lang_sense_clarification": "придавать черты стиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "造型",
                                "target_lang_sense_clarification": "设计外观或发型"
                            },
                            {
                                "target_lang_word": "设计",
                                "target_lang_sense_clarification": "对空间或物品进行布置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "034ac94a-84f8-3e81-b9ed-d46a13bf1efe",
                    "sense_definition": "To give a formal name or title to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>styled</w> himself as the leader of the new movement.",
                            "target_lang_translations": {
                                "ru": "Он <w>называл</w> себя лидером нового движения.",
                                "zh": "他自<w>称</w>为这场新运动的领导者。"
                            }
                        },
                        {
                            "text": "The pope is <w>styled</w> His Holiness in formal address.",
                            "target_lang_translations": {
                                "ru": "Папу Римского в официальном обращении <w>титулуют</w> Его Святейшеством.",
                                "zh": "教皇在正式称呼中被<w>尊称</w>为“圣座”。"
                            }
                        }
                    ],
                    "synonyms": [
                        "call",
                        "name",
                        "term",
                        "dub",
                        "designate",
                        "entitle"
                    ],
                    "common_phrases": [
                        "self-styled"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать официальное имя или титул кому-либо или чему-либо.",
                        "zh": "给予某人或某物正式的名称或头衔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "величать",
                                "target_lang_sense_clarification": "называть по титулу или имени-отчеству"
                            },
                            {
                                "target_lang_word": "титуловать",
                                "target_lang_sense_clarification": "присваивать титул"
                            },
                            {
                                "target_lang_word": "называть",
                                "target_lang_sense_clarification": "давать имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "称呼",
                                "target_lang_sense_clarification": "给予某种名号"
                            },
                            {
                                "target_lang_word": "冠以",
                                "target_lang_sense_clarification": "正式赋予头衔"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}