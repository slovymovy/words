                            },
                            {
                                "target_word": "array",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e868aa-bea7-385e-bb45-dc4d0ac25556",
                                        "entry_id": "9b9e1cdd-d8a1-33c7-9359-98a87340e292",
                                        "glosses": [
                                            "To clothe and ornament; to adorn or attire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec5bd872-ae68-4b1a-b59c-1e262ed13d78",
                                                "sense_id": "c0e868aa-bea7-385e-bb45-dc4d0ac25556",
                                                "text": "He was arrayed in his finest robes and jewels."
                                            },
                                            {
                                                "example_id": "c54ccd16-d792-40a3-b4c3-d172101ef99f",
                                                "sense_id": "c0e868aa-bea7-385e-bb45-dc4d0ac25556",
                                                "text": "In a long purple pall, whose ſkirt with gold, / Was fretted all about, ſhe was arayd, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eab9edb8-e2a5-3c24-ada4-1e24acae677e",
                                        "entry_id": "9b9e1cdd-d8a1-33c7-9359-98a87340e292",
                                        "glosses": [
                                            "To lay out in an orderly arrangement; to deploy or marshal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c97fa32-e00b-35b5-9daf-92f461509068",
                                        "entry_id": "9b9e1cdd-d8a1-33c7-9359-98a87340e292",
                                        "glosses": [
                                            "To set in order, as a jury, for the trial of a cause; that is, to call them one at a time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c8096b1-a2cf-4a03-8649-d77721db009f",
                                                "sense_id": "0c97fa32-e00b-35b5-9daf-92f461509068",
                                                "text": "Alſo, though there be no perſonal objection againſt the ſheriff, yet if he arrays the panel at the nomination, or under the direction of either party, this is good cauſe of challenge to the array."
                                            }
                                        ]
                                    }
                                ]
                            }
