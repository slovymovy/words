                "senses": [
                    {
                        "sense_id": "4b9b5429-f612-3078-b697-8d22ea159545",
                        "entry_id": "d1b654e5-f748-331a-b7fb-3c22cfa683cc",
                        "glosses": [
                            "Misfortune; detriment; harm; evilfare."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1fa8ed59-f4e3-4852-bb66-07254482d4cf",
                                "sense_id": "4b9b5429-f612-3078-b697-8d22ea159545",
                                "text": "According to a principle of weak benevolence, all except the deviant will, other things being equal, prefer the welfare of others to their illfare; according to a principle of strong benevolence, preferring the welfare of others to their illfare will guide conduct even when other things are not equal [...]"
                            },
                            {
                                "example_id": "6018b8e0-988b-4814-9039-33089e86e075",
                                "sense_id": "4b9b5429-f612-3078-b697-8d22ea159545",
                                "text": "The environment is an extremely important, although not the only, foundation for our welfare or illfare."
                            },
                            {
                                "example_id": "a21dc4ef-07fc-45ff-9f9f-a4097c1a0f03",
                                "sense_id": "4b9b5429-f612-3078-b697-8d22ea159545",
                                "text": "The opposite of the condition of social welfare is social illfare. Social illfare exists when human needs are not met, when social problems are not effectively managed, and when there are very limited opportunities for improving life chances."
                            },
                            {
                                "example_id": "2b50e596-e243-4911-8ccc-9bbaa1e8b85b",
                                "sense_id": "4b9b5429-f612-3078-b697-8d22ea159545",
                                "text": "Without the media, public concern over the illfare of Finnish children would not have been so widely discussed or examined."
                            }
                        ]
                    }
