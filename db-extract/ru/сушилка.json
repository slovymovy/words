                                    {
                                        "sense_id": "777ffd53-0392-3cd2-81a8-fe19002c44d6",
                                        "entry_id": "bcd44f57-f0c6-3d5e-b35d-b2e4b0f07ee2",
                                        "glosses": [
                                            "One who, or that which, dries; any device or facility employed to remove water or humidity, e.g. a desiccative"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4196145-3344-4cd1-b10b-95ccff233001",
                                                "sense_id": "777ffd53-0392-3cd2-81a8-fe19002c44d6",
                                                "text": "The sun and a northwesterly wind are great driers of the earth."
                                            },
                                            {
                                                "example_id": "e8d4dd00-1789-4bcb-a404-263e6d94196b",
                                                "sense_id": "777ffd53-0392-3cd2-81a8-fe19002c44d6",
                                                "text": "At that time, father, brother and I worked as night watchmen at the grain dryer. It was a large and complicated structure built out in the steppe. It consisted of a wooden tower with swinging shelves attached to the inside walls,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1349bc05-0954-328d-8d61-49e7210fee86",
                                        "entry_id": "bcd44f57-f0c6-3d5e-b35d-b2e4b0f07ee2",
                                        "glosses": [
                                            "Short for clothes dryer, tumble dryer"
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "570ae489-da59-3590-9e06-7b3dc5e73c96",
                                        "entry_id": "bcd44f57-f0c6-3d5e-b35d-b2e4b0f07ee2",
                                        "glosses": [
