                "senses": [
                    {
                        "sense_id": "84f5af18-1120-3a45-877d-a860562c36c9",
                        "entry_id": "01bdb9a0-d0c6-398e-be65-dcbd25462781",
                        "glosses": [
                            "Adjectif numéral ordinal correspondant au nombre 24. Qui est au rang dont le numéro est vingt-quatre (24)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "354a8fe8-5feb-4910-a7fe-26e0261d50ed",
                                "sense_id": "84f5af18-1120-3a45-877d-a860562c36c9",
                                "text": "C’est la vingt-quatrième fois que je traverse la Manche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c484cb0-824b-45ce-9026-92321881105b",
                        "source_entry_id": "01bdb9a0-d0c6-398e-be65-dcbd25462781",
                        "source_sense_id": "84f5af18-1120-3a45-877d-a860562c36c9",
                        "target_lang_word": "vierundzwanzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vierundzwanzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                        "entry_id": "c5462fbc-5315-35b7-a5de-ea7764a2bdf9",
                                        "glosses": [
                                            "nach dem oder der dreiundzwanzigsten kommend; in einer Reihenfolge an Stelle vierundzwanzig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c4de30-be08-4919-aee2-e48b5e85a06a",
                                                "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                                "text": "Der lateinische Buchstabe ‚X‘ ist der vierundzwanzigste Buchstabe des deutschen Alphabets."
                                            },
                                            {
                                                "example_id": "3b1e481e-693f-480d-821f-19939a38b446",
                                                "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                                "text": "Der kyrillische Vokalbuchstabe ‚У‘ ist der vierundzwanzigste Buchstabe des ukrainischen Alphabets."
                                            },
                                            {
                                                "example_id": "2be3d35c-88ab-4e08-9045-7ccda35e7328",
                                                "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                                "text": "Die Stunde (von althochdeutsch stunta ‚Stehen‘, ‚Aufenthalt‘, ‚feststehender Zeitpunkt‘, ‚kurzer Zeitraum‘, ‚Stunde‘) bezeichnet den vierundzwanzigsten Teil eines Tages."
                                            },
                                            {
                                                "example_id": "49f1d226-c595-4881-be52-34af10374220",
                                                "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                                "text": "Das vierundzwanzigste Türchen verdeutlicht den Sinngehalt eines Adventskalenders, nämlich das Erreichen von Heiligabend."
                                            },
                                            {
                                                "example_id": "95ab305f-38d1-4983-9a1f-e0c2e5df3c6e",
                                                "sense_id": "22408eb2-95fe-328c-9dca-56f4811d5320",
                                                "text": "Er war müde und hatte sämtliche Nöte des Lebens noch vor seinem vierundzwanzigsten Lebensjahre kennengelernt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
