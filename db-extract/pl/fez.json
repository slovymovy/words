                        "entry_id": "9fbd4a59-e7ae-305c-852c-48285deda5d9",
                        "glosses": [
                            "orientalne nakrycie głowy o kształcie ściętego stożka, wykonane z bordowego filcu i ozdobione czarnym frędzlem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30260893-c3ae-409d-af9f-f532d63214f3",
                                "sense_id": "957b991b-8005-3c7e-8a95-085c0d72b9a7",
                                "text": "Fezy noszą głównie mężczyźni w krajach muzułmańskich."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8efbe97e-77ef-4679-995f-91a3a09485a1",
