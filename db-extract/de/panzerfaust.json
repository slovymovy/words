                                "target_senses": [
                                    {
                                        "sense_id": "994f2237-f0d6-38c3-8a78-e570e1c0228f",
                                        "entry_id": "4eddca7f-8550-3cde-8f8d-bf84f17917a4",
                                        "glosses": [
                                            "A light, single-shot anti-tank grenade launcher developed in Germany in the latter stages of the Second World War."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bea435b-c016-4be6-9313-db6aa66eaaf6",
                                                "sense_id": "994f2237-f0d6-38c3-8a78-e570e1c0228f",
                                                "text": "Apparently the air raid had caught the Volkssturm soldier in the village as he was transporting a supply of six panzerfausts in a handcart to another unit. Klemment wished he would hand over the panzerfausts to them, because he knew the Americans had tanks, and Klemment's unit had nothing in their arsenal to stop the metal monsters."
                                            }
                                        ]
