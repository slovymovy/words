                "senses": [
                    {
                        "sense_id": "e43719e1-7710-3750-a40b-b086fcc95429",
                        "entry_id": "66248b08-425f-3544-b360-52df8321b98b",
                        "glosses": [
                            "A shop that sells cooked or prepared food ready for serving."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "53e8a3f9-1b99-4324-8c07-3bcceab5ddec",
                                "sense_id": "e43719e1-7710-3750-a40b-b086fcc95429",
                                "text": "Delis usually offer a broader, fresher menu than fast food chains."
                            },
                            {
                                "example_id": "be02df06-0b58-4ba4-90fc-e5d2c3479a9a",
                                "sense_id": "e43719e1-7710-3750-a40b-b086fcc95429",
                                "text": "The San Juan market is Mexico City's most famous deli of exotic meats, where an adventurous shopper can hunt down hard-to-find critters such as ostrich, wild boar and crocodile."
                            },
                            {
                                "example_id": "d2defda6-fc43-4fd3-bc5e-e40960dc666b",
                                "sense_id": "e43719e1-7710-3750-a40b-b086fcc95429",
                                "text": "Part of the 'western arcade' (as it's known) is lined with delis, cafes and other shops, giving it the feeling of a bazaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "346a2fee-e6dd-34e9-abfc-f7f2bd732971",
                        "entry_id": "66248b08-425f-3544-b360-52df8321b98b",
                        "glosses": [
                            "Food sold at a delicatessen."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7ffa29c-46ed-4c45-b52f-0cf0cd8d82e9",
                        "source_entry_id": "66248b08-425f-3544-b360-52df8321b98b",
                        "source_sense_description": "shop that sells cooked or prepared food ready for serving",
                        "target_lang_word": "гастроно́м",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гастроно́м",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "303a8f96-17ba-3056-8964-f55de6bd5930",
                                        "entry_id": "87a56377-59f3-365a-836e-39303d274350",
                                        "glosses": [
                                            "устар. знаток, любитель и ценитель изысканных блюд, человек, разбирающийся в тонкостях кулинарного искусства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6c5fa50-1405-4d2b-a79a-51e62ea543fc",
                                                "sense_id": "303a8f96-17ba-3056-8964-f55de6bd5930",
                                                "text": "Князь был большой гастроном и пил за столом только один рейнвейн высокой цены."
                                            },
                                            {
                                                "example_id": "3d9afcac-0b0c-4bf0-88cf-24497fa3445e",
                                                "sense_id": "303a8f96-17ba-3056-8964-f55de6bd5930",
                                                "text": "Обед, которым он попотчевал своего гостя, конечно, удовлетворил бы самого взыскательного гастронома."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "гастроно́м",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e0913a1f-bf4f-3a33-8df6-e48f45b12f23",
                                        "entry_id": "54e1fcd6-59a3-3ffa-b526-18a7a2a0c01c",
                                        "glosses": [
                                            "советск. продовольственный магазин высшей и первой категории с разнообразным ассортиментом пищевых товаров, то есть копченостей, икры, рыбы и мяса, консервов, в отличие от бакалейных и молочных товаров"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f482c5d0-e305-466c-a132-8dd05b6c3dc1",
                                                "sense_id": "e0913a1f-bf4f-3a33-8df6-e48f45b12f23",
                                                "text": "Я нырнул в ближайший магазин, оказавшийся гастрономом, походил вдоль прилавков, убедился в том, что сахар есть, выбор колбас и конфет не богат, но зато выбор так называемых рыбных изделий превосходит все ожидания."
                                            },
                                            {
                                                "example_id": "af8ddf85-74b3-4b61-b06b-cb231f6473fd",
                                                "sense_id": "e0913a1f-bf4f-3a33-8df6-e48f45b12f23",
                                                "text": "Они вместе заходили в гастроном на углу и выбирали себе два пирожных."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
