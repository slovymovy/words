                        "glosses": [
                            "zánět kloubů, artritida"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0531be5d-7790-4ca1-9ce5-b3f7426cb64d",
                                "sense_id": "b2daefcb-e3b9-3816-b717-50bacdfa395c",
                                "text": "Niet-infectieuze gewrichtsontstekingen zijn vaak chronisch en vallen doorgaans onder de noemer reuma.",
                                "translation": "Neinfekční záněty kloubů jsou často chronické a spadají pod revmatismus."
                            },
                            {
                                "example_id": "d41e17c1-26f0-4a8a-8cff-f2e2cec4e6c4",
                                "sense_id": "b2daefcb-e3b9-3816-b717-50bacdfa395c",
                                "text": "Vrouwen lijden veel vaker aan pijnlijke gewrichtsontstekingen dan mannen. De precieze oorzaak van reumatoïde artritis werd alsnog niet achterhaald.",
                                "translation": "Ženy trpí bolestivou artritidou daleko častěji než muži. Přesná příčina revmatického zánětu kloubů nebyla dosud určena."
                            }
                        ]
                    }
