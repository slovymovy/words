                                        "sense_id": "727fa572-49df-3498-bb47-08ab553fc567",
                                        "entry_id": "08a2bb36-ddc4-3a42-81be-a5c3fa06b924",
                                        "glosses": [
                                            "Synonym of ninetysomething: a person between 90 and 99 years old."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nonagenarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb19ff3-74c8-384e-9c58-05448ed5b38c",
                                        "entry_id": "ed7aa946-9fd2-3aee-b966-5c6ac17df1a3",
                                        "glosses": [
                                            "Of or related to ninetysomethings."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12fa7c33-29b1-4f80-a3dd-46adebba8535",
                                                "sense_id": "4bb19ff3-74c8-384e-9c58-05448ed5b38c",
                                                "text": "\"But what’s that got to do with your health and longevity?\" the neighbor inquired.\n\"Why,\" said the nonagenarian, \"I've spent most of my life in the open air.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da887590-c3bc-4d34-a019-2637eb942bca",
