                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b49b11c-c928-4496-b2df-0d974f7724b5",
                                                "sense_id": "5a44e8b6-d943-3956-a8eb-3536a50b88e1",
                                                "text": "The gang member got bladed in a fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b49ec595-4da8-334e-8c8f-20df4a3bcdea",
                                        "entry_id": "476ed076-412e-3be9-9270-c7b2bc0a640b",
