                ],
                "senses": [
                    {
                        "sense_id": "e2e5a260-30b3-3b45-9ea9-e02cc008835f",
                        "entry_id": "3d3937d5-dfd6-30eb-8cc7-8eff3862a85b",
                        "glosses": [
                            "synthetischer Süßstoff, der besonders für Diätgetränke verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55abe5e-9621-4770-ac5e-80fcc8d46915",
                                "sense_id": "e2e5a260-30b3-3b45-9ea9-e02cc008835f",
                                "text": "„Schon bei seiner Zulassung im Jahr 1982 hatte einer der bekanntesten Süßstoffe, Aspartam, einen schlechten Ruf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a3220b9-8ada-4f0d-b934-e3773532aad9",
                        "source_entry_id": "3d3937d5-dfd6-30eb-8cc7-8eff3862a85b",
                        "source_sense_id": "e2e5a260-30b3-3b45-9ea9-e02cc008835f",
                        "source_sense_description": "synthetischer Süßstoff, der besonders für Diätgetränke verwendet wird",
                        "target_lang_word": "aspartame",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspartame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                        "entry_id": "fb0bc7fc-d241-354e-b829-cd4cc2b152f0",
                                        "glosses": [
                                            "An artificial sweetener, the methyl ester of a dipeptide formed from aspartic acid and phenylalanine, used in many processed foods and beverages."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c38ca90f-ad28-469e-bc9a-0a43bb813b1d",
                                                "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                                "text": "Though reluctant to further expose him to aspartame, I had little trouble persuading Jamie's mother to carry out a double-blind trial in order to more rigorously document her son's aberrant response to aspartame."
                                            },
                                            {
                                                "example_id": "ac3ad3ce-e921-40fe-8284-79167b96f054",
                                                "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                                "text": "Caramel colors and aspartame\nPhosphoric acid, potassium\nNatural flavors, of course caffeine\nAnd now I'm jonesin' for MSG"
                                            },
                                            {
                                                "example_id": "96194ff2-b346-48d2-aece-5e9343332b3f",
                                                "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                                "text": "Aspartame, sold under the brand NutraSweet, was discovered accidentally by a scientist at Searle in 1965 who was testing new drugs for gastric ulcers and licked his fingers before picking up a piece of paper."
                                            },
                                            {
                                                "example_id": "f021f1e9-97e4-454f-980f-75b8bec693c8",
                                                "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                                "text": "In powdered form, aspartame is mixed with lactose, so a 1-gram packet contains 4 calories."
                                            },
                                            {
                                                "example_id": "f134853e-0953-490a-b94a-d5e741e820d2",
                                                "sense_id": "28774d59-8975-395f-9489-2b0a45af0607",
                                                "text": "Some examples of the sweeteners include aspartame, saccharin, sucralose and stevia. The W.H.O.’s announcement contradicts previous studies that have said these sweeteners don’t offer any health benefits but also do not cause harm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3363280-9e4a-41ac-95a7-19a29a1a0ddf",
                        "source_entry_id": "3d3937d5-dfd6-30eb-8cc7-8eff3862a85b",
                        "source_sense_id": "e2e5a260-30b3-3b45-9ea9-e02cc008835f",
                        "source_sense_description": "synthetischer Süßstoff, der besonders für Diätgetränke verwendet wird",
                        "target_lang_word": "aspartame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aspartame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d52edabb-a713-3a10-8496-c4885bfffddc",
                                        "entry_id": "302133f6-55e0-3cf4-97ab-6da5030cd69d",
                                        "glosses": [
                                            "Édulcorant artificiel dont les effets secondaires sont discutés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f4778c-2137-4bf8-8639-0c0abcb88655",
                                                "sense_id": "d52edabb-a713-3a10-8496-c4885bfffddc",
                                                "text": "L’aspartame est contre-indiqué lors de phénylcétonurie à cause de la phénylalanine, et chez les enfants de moins de 3 mois."
                                            },
                                            {
                                                "example_id": "27caf6c5-c965-43f6-a24d-358f7b303e8f",
                                                "sense_id": "d52edabb-a713-3a10-8496-c4885bfffddc",
                                                "text": "Parmi les édulcorants, le plus utilisé par l’industrie agroalimentaire est l’aspartame, une poudre blanche dont le pouvoir sucrant est environ 200 fois supérieur à celui du sucre."
                                            },
                                            {
                                                "example_id": "22b9e2cb-0573-416b-82a0-8d7ea5770339",
                                                "sense_id": "d52edabb-a713-3a10-8496-c4885bfffddc",
                                                "text": "Pire, une anxiété anormale a également été observée chez les enfants et petits-enfants des souris mâles exposées à l’aspartame – seule la lignée paternelle a été analysée dans cette étude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95fb7ecc-33b2-3dd1-afd0-094cc786e9c8",
                                        "entry_id": "302133f6-55e0-3cf4-97ab-6da5030cd69d",
                                        "glosses": [
                                            "Dose d’aspartame se présentant sous forme de gélule, de dosette ou de pilule."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f803c18-0fe9-4ff8-aeba-19d785b63b2c",
                                                "sense_id": "95fb7ecc-33b2-3dd1-afd0-094cc786e9c8",
                                                "text": "Je mets trois aspartames dans mon café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
