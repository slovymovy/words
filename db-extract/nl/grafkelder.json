                        "glosses": [
                            "gedeeltelijk onder de grond liggend gemetseld graf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "383e609b-32a7-45a1-8f54-af2447812c2a",
                                "sense_id": "4cb24694-306b-3ba7-a9fd-9ab0157262af",
                                "text": "Rond deze skeletten is in Delft een flinke discussie ontstaan. Sinds 2010 lis het bestuur van de Nieuwe Kerk bezig met een grootschalige renovatie. Daarbij wordt ook verbouwd: de koninklijke grafkelder van de Oranjes wordt uitgebreid, en daarnaast is het plan een souterrain te bouwen onder het schip, de ‘voorzieningenkelder’: 500 vierkante meter voor vergaderzalen, keuken, wc’s, garderobe."
                            },
                            {
                                "example_id": "95bca038-55a7-4f11-b18f-507643397c66",
                                "sense_id": "4cb24694-306b-3ba7-a9fd-9ab0157262af",
                                "text": "Almelo maakt zich op voor de uitvaart van Adolph graaf van Rechteren Limpurg. De op 88-jarige leeftijd overleden Heer van Almelo wordt morgen bijgezet in de grafkelder van de familie aan de Gravenallee. Het verkeer op de Van Rechteren Limpurgsingel wordt daarvoor stilgelegd."
                            }
                        ]
                    }
