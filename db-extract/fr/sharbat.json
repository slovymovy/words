                    {
                        "sense_id": "ad3afd1c-3200-3f42-b7a0-6be8760983a5",
                        "entry_id": "3cafd68b-4deb-3974-bed0-493fe2865506",
                        "glosses": [
                            "Boisson sucrée d’origine arabe, populaire en Asie occidentale et en Asie du Sud, et préparée à base de fruits ou de pétales de fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d68242-4d27-46b8-b512-b776de07cf33",
                                "sense_id": "ad3afd1c-3200-3f42-b7a0-6be8760983a5",
                                "text": "Ce sont des commerçants voyageurs qui ont importé le concept du sharbat de Perse en Europe, en y ajoutant du sucre pour l’adoucir un peu."
                            },
                            {
                                "example_id": "fab1349e-5a56-470a-b36c-204cda30bbb1",
                                "sense_id": "ad3afd1c-3200-3f42-b7a0-6be8760983a5",
                                "text": "Il s'agit d’une jarre utilisée pour boire du sharbat, une boisson sucrée à base de fruits et d’herbes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0cdd3b0-9001-47e5-96eb-26170003b0ec",
                        "source_entry_id": "3cafd68b-4deb-3974-bed0-493fe2865506",
                        "source_sense_id": "ad3afd1c-3200-3f42-b7a0-6be8760983a5",
                        "target_lang_word": "sharbat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sharbat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7925b4-ae2b-39d2-a3f7-3647ce7d3596",
                                        "entry_id": "d8654665-f388-38e1-995a-df3547cb831d",
                                        "glosses": [
                                            "A West and South Asian sweet drink prepared from fruits or flower petals; a sherbet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590cebbf-1ad6-44c1-9036-50fcdd893db6",
                                                "sense_id": "0c7925b4-ae2b-39d2-a3f7-3647ce7d3596",
                                                "text": "The Arabs brought sugarcane, mulberries, and citrus fruits (along with many things that have nothing to do with granita), and innumberable recipes for sharbat, their sweetened, aromatic drinks flavored with fruits, blossoms, and spices, and often chilled with mountain snow."
                                            },
                                            {
                                                "example_id": "fe00a704-dbf8-43c3-9390-58d7cbfc4906",
                                                "sense_id": "0c7925b4-ae2b-39d2-a3f7-3647ce7d3596",
                                                "text": "Ka found the general lack of interest liberating. This is why he went into the snack bar on the corner of Little Kâzimbey Avenue and Kâzim Karabekir Avenue, and ordered himself a cinnamon sharbat, and he drank it with relish."
                                            },
                                            {
                                                "example_id": "7349bb86-9b86-4bca-bda3-f30094cc4b48",
                                                "sense_id": "0c7925b4-ae2b-39d2-a3f7-3647ce7d3596",
                                                "text": "When Mrs. Dwivedi had no longer felt like standing there tracking Chellam's progress in the punishing heat, she’d come indoors, ordered her cook to make her a tall glass of iced sharbat, and telephoned Amma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
