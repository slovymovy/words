                    "frequency": "High",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maître a décidé de <w>punir</w> les élèves qui ne faisaient pas leurs devoirs."
                        },
                        {
                            "text": "Les parents ont préféré <w>punir</w> leur fils en le privant de sortie ce week-end."
                        }
                    ],
                    "synonyms": [
                        "corriger",
                        "réprimander"
                    ],
                    "antonyms": [
                        "récompenser"
                    ],
                    "common_phrases": [
                        "punir un enfant",
                        "être puni",
                        "punir sévèrement"
                    ]
                },
                {
                    "sense_id": "caeccb3e-9f22-341f-96eb-f0c9d80108ac",
                    "sense_definition": "Frapper d'une peine légale ou réglementaire une infraction, un acte répréhensible ou son auteur.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a voulu <w>punir</w> cette fraude par une lourde amende financière."
                        },
                        {
                            "text": "Ce genre d'infraction routière est toujours <w>puni</w> par un retrait immédiat de permis."
                        }
                    ],
                    "common_phrases": [
                        "punir par la loi",
                        "punir d'une amende"
                    ]
                },
                {
                    "sense_id": "d4999306-be7d-3767-b052-6fc2bfb6bbf4",
                    "sense_definition": "Faire subir les conséquences fâcheuses ou douloureuses d'une erreur, d'une imprudence ou d'un excès.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a été rapidement <w>puni</w> de sa négligence lors du match décisif."
                        },
                        {
                            "text": "Elle fut bien <w>punie</w> d'avoir accordé une confiance aveugle à cet inconnu."
