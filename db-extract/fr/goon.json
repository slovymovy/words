                        ],
                        "examples": [
                            {
                                "example_id": "ed700a51-874a-4011-8b4c-b15eebf4524b",
                                "sense_id": "130c3b16-813d-3c9c-8b32-749f3cf1f0f9",
                                "text": "Les Canadiens de Montréal utiliseront un goon pour imposer le respect contre Toronto."
