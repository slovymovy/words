                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5aba330-af9f-3334-b4fa-510524580206",
                        "entry_id": "cf6d2592-5d40-3510-a3f3-86270cb6c4a7",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34778560-4cb6-4f98-91d1-63183bdaf19e",
                                "sense_id": "a5aba330-af9f-3334-b4fa-510524580206",
                                "text": "„Noch vor diesem Dorf lenkte Voland den Citroën allerdings auf eine zwischen dichtem Gebüsch verborgene Schotterzufahrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54bd8874-76f7-4ef3-bd58-dfcf6b73c7c1",
                        "source_entry_id": "cf6d2592-5d40-3510-a3f3-86270cb6c4a7",
                        "source_sense_id": "ec4b41bd-3ddf-3128-b794-fd93f8302006",
                        "source_sense_description": "Fahrzeughersteller",
                        "target_lang_word": "Citroën",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Citroën",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "902acd70-c8bf-3f7a-bcbf-f295231c05e2",
                                        "entry_id": "0b3060ec-c553-3e66-994d-a277e95fd3e9",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Citroën",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                        "entry_id": "099e5e9c-6095-3d2b-8858-4b98df3ccbf7",
                                        "glosses": [
                                            "Constructeur français d’automobiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c739cc6-bf12-4ab6-a323-40b19c14fd77",
                                                "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                                "text": "On aurait ainsi sacrifié dix mille morts par an pour ne pas désespérer Billancourt, Renault, Peugeot, Citroën et le CAC 40 ! J’entends bien ces cyniques raisons."
                                            },
                                            {
                                                "example_id": "beb4803c-caca-4fc6-b832-6dba9977ee73",
                                                "sense_id": "5f1cde5e-ecad-343f-b56d-ca77548b1590",
                                                "text": "Pour un gars chez qui tout est deuch du bouton de sonnette au pommeau de douche, il n’y a que les morceaux de sucre qui ne sont pas estampillés Citroën."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Citroën",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                        "entry_id": "5de0253a-1793-3a29-90ff-c80c3d8bff87",
                                        "glosses": [
                                            "Automobile vendue sous cette marque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e32f8b1-244f-4f61-8e23-4891593f5f86",
                                                "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                                "text": "Les ressorts de la Citroën s'affaissèrent sous le poids d'Antoinette, et elle dut s'y prendre à trois fois avant de démarrer le moteur."
                                            },
                                            {
                                                "example_id": "f426345e-b061-4d78-a327-2fd0ce9372fd",
                                                "sense_id": "ac3828f3-8bc3-3189-8f6a-8385f0243ef8",
                                                "text": "On dirait qu’elle se rend à un rallye automobile, avec sa Citroën traction faux cabriolet dotée d’un moteur 4 cylindres à soupapes en tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5302875-8231-48e6-a0b6-15fd4e8c940b",
                        "source_entry_id": "cf6d2592-5d40-3510-a3f3-86270cb6c4a7",
                        "source_sense_id": "ec4b41bd-3ddf-3128-b794-fd93f8302006",
                        "source_sense_description": "Fahrzeughersteller",
                        "target_lang_word": "Σιτροέν",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Σιτροέν",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "db54ea81-ef17-34e8-953b-dfe4ac7d775c",
                                        "entry_id": "aea7659e-6c2f-3206-8c78-ef5be0bce834",
                                        "glosses": [
                                            "επώνυμο (ανδρικό ή γυναικείο)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e850f4f-d27c-357c-b2cd-97aa7bf9337a",
                                        "entry_id": "aea7659e-6c2f-3206-8c78-ef5be0bce834",
                                        "glosses": [
                                            "μάρκα γαλλικών αυτοκινήτων"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "656f9ea7-557a-4500-a745-975ff5fae21d",
                                                "sense_id": "2e850f4f-d27c-357c-b2cd-97aa7bf9337a",
                                                "text": "※ Στη νοσταλγία των φίφτις αυτοί αντέταξαν την επικαιρότητα των έιτις. Στις υπερπαραγωγές της «Σιτροέν» αυτοί έβαλαν ένα «Φολκσβάγκεν» να πέφτει κάτω, ανοίγοντας μια τρύπα. Στις μπανιέρες και τα αυτόματα πλυντήρια της εποχής της Πέγκυ Σου αυτοί έβαλαν τη μέση αγγλίδα νοικοκυρά να πανικοβάλλεται με την κορούλα της, Μάργκαρετ, που τρώει την τάδε μάρκα μπιζελιών και ονειρεύεται όταν μεγαλώσει να γίνει πρωθυπουργός. (Τσχυδρόμος, τεύχη 45-48, 1991, σελ. 61)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
