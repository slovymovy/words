                    {
                        "sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                        "entry_id": "efbdcff6-3bf2-3ba7-95b3-bcecee3ae7fb",
                        "glosses": [
                            "Self-important, pompous; arrogant or egotistical."
                        ],
                        "tags": [
                            "US",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "230f572f-231c-43d1-ac11-6b6c7cc57592",
                                "sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                                "text": "It's only a matter of time before some highfalutin developer builds a huge hotel and ruins the scenery."
                            },
                            {
                                "example_id": "b2d27eef-817a-4be1-a252-6e1ea1853627",
                                "sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                                "text": "That one Cajun that moved to Austin is too highfalutin to come back to Livingston Parish. He's over there with that mean bread lady!"
                            },
                            {
                                "example_id": "7c396126-9883-49d5-9d98-6fe53227a789",
                                "sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                                "text": "His speech was very highfalutin."
                            },
                            {
                                "example_id": "dd50a5e8-9df3-44c3-afc7-e621f9581e28",
                                "sense_id": "f9a808ed-2402-307a-9127-d45ea7d40cf5",
                                "text": "There’s been a spate of stories lately about how Cruz’s rhetoric is more hifalutin than everybody else’s. He uses lots of big words and dependent clauses."
                            }
                        ]
                    }
                ],
                "translations": [
