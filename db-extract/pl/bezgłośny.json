                                    },
                                    {
                                        "sense_id": "cf1b58f9-453f-3919-85f5-42a28c1a514f",
                                        "entry_id": "2f7e607a-3163-3f76-a2ae-fe202102cbe3",
                                        "glosses": [
                                            "Eigenschaft eines Lautes, der ohne Schwingung der Stimmlippen (Stimmbänder) artikuliert wird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4baa861d-ad68-4dd9-9f91-7aaccab2ed84",
                                                "sense_id": "cf1b58f9-453f-3919-85f5-42a28c1a514f",
                                                "text": "Stimmlos werden im Deutschen gebildet: Affrikaten sowie diejenigen Plosive ([p, t, k, ʔ]) und Frikative ([f, s, ʃ, ç, x, h]), bei denen die Stimmbänder nicht schwingen."
                                            },
                                            {
                                                "example_id": "9476dcb8-5927-453b-bc9e-f6ef873b74fd",
                                                "sense_id": "cf1b58f9-453f-3919-85f5-42a28c1a514f",
                                                "text": "Phonologisch gesehen gehört stimmlos zur Opposition von stimmlos - stimmhaft."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
