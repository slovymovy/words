                                        "entry_id": "6b1fc174-fd6f-3634-9952-469e3264536e",
                                        "glosses": [
                                            "The wife of a maharajah; approximately, a queen consort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "233fa180-b2cd-48ed-ae60-3e8ce086a5b1",
                                                "sense_id": "296701c2-c928-310b-91b7-fe9de5839a74",
                                                "text": "Nonetheless, for many years afterward, she was often referred to as maharani, though that eventually gave way to the less glamorous but more respectful title of rajmata, the equivalent of queen mother."
                                            }
                                        ]
                                    }
