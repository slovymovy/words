                    {
                        "translation_id": "28fd7dbd-3490-418f-a625-4821d9c121f1",
                        "source_entry_id": "c35ca190-cf59-3dbf-ac29-ec1d4f752f0b",
                        "source_sense_id": "c788a351-36ef-30f7-950b-c413c1cb5a69",
                        "source_sense_description": "kleine Stange mit Wimpel, die der Banderillero in den Nacken des Stiers stößt",
                        "target_lang_word": "banderille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banderille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd54e603-143d-3369-9f4b-f65229d38262",
                                        "entry_id": "466dd772-36c1-37a5-9d70-d5c45537ada5",
                                        "glosses": [
                                            "Bâton d’environ 80 cm de long terminé par un harpon et orné de petites bandes multicolores, que l’on plante, dans les courses de taureaux, dans le cou de la bête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3e4dc50-4289-4380-bc42-3167b41b7027",
                                                "sense_id": "bd54e603-143d-3369-9f4b-f65229d38262",
                                                "text": "Il se secoue furieusement comme un taureau piqué de banderilles."
                                            },
                                            {
                                                "example_id": "952b6ef9-7a7e-4bfd-8574-630607dd5304",
                                                "sense_id": "bd54e603-143d-3369-9f4b-f65229d38262",
                                                "text": "Entraînée de cape en pique, de pique en homme qui se métamorphose en cape, d’homme en banderille, de banderille en estoc et d’estoc en poignard, la grosse bête n’est bientôt plus qu’un monticule de chair fumante."
                                            },
                                            {
                                                "example_id": "6b60beaa-cd46-4bfb-bc0a-200f51eb6d68",
                                                "sense_id": "bd54e603-143d-3369-9f4b-f65229d38262",
                                                "text": "Elle était comme ça, la mort, pensa-t-il. Elle pouvait parfois se contenter d'une banderille avant de s'en retourner à d'autres occupations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b87f9d-fb34-37ee-abf1-9d4cc2b0ae6c",
                                        "entry_id": "466dd772-36c1-37a5-9d70-d5c45537ada5",
                                        "glosses": [
                                            "Attaque, physique ou verbale."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259d9d29-27ef-4e89-a36b-90ea55535858",
                                                "sense_id": "78b87f9d-fb34-37ee-abf1-9d4cc2b0ae6c",
                                                "text": "Gorbatchev préfère évoquer les tensions en URSS et les problèmes des partis frères en Pologne et en Hongrie, plutôt que d’attaquer de front la direction du SED. Puis, souriant, il plante la première banderille."
                                            }
                                        ]
                                    }
                                ]
