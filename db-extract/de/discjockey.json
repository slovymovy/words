                    {
                        "sense_id": "718c52f9-d949-3864-9446-bed8c5e2c64d",
                        "entry_id": "e750e0fd-200c-3c1c-8267-4254ef472bfb",
                        "glosses": [
                            "Person, die (vor allem in Diskotheken) vor einem Publikum Musiktitel abspielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03452030-126b-4bad-bb51-60d4d1be9b77",
                                "sense_id": "718c52f9-d949-3864-9446-bed8c5e2c64d",
                                "text": "Alle Mädchen in der Dorfdisco waren in den Discjockey verknallt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "13b62ea6-7967-3582-928f-7b8ba4affbd6",
                        "entry_id": "e750e0fd-200c-3c1c-8267-4254ef472bfb",
                        "glosses": [
                            "Person, die Musik mithilfe eines Mischpults mischt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab0cb7ba-cb98-4e24-95aa-1f834df09b58",
                                "sense_id": "13b62ea6-7967-3582-928f-7b8ba4affbd6",
                                "text": "Er ist Discjockey, also er nennt dich DJ Megatrend, und ist eigentlich schon recht erfolgreich, wenn man mal seine Clips auf YouTube ansieht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4a8a68c3-98b9-3145-a93a-3d1c2bc72565",
                        "entry_id": "e750e0fd-200c-3c1c-8267-4254ef472bfb",
                        "glosses": [
                            "im Rundfunk oder Fernsehen tätige Person, die das Musikprogramm organisiert und moderiert"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "0bd516ea-40f2-4695-919b-8b18f926e634",
                                "sense_id": "4a8a68c3-98b9-3145-a93a-3d1c2bc72565",
                                "text": "Ilja Richter war ja in den 70ern als Discjockey im Fernsehen unterwegs."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "400587c9-0230-40c4-8e1e-2b9420e0f6e6",
                        "source_entry_id": "e750e0fd-200c-3c1c-8267-4254ef472bfb",
                        "source_sense_id": "718c52f9-d949-3864-9446-bed8c5e2c64d",
                        "source_sense_description": "Person, die (vor allem in Diskotheken) vor einem Publikum Musiktitel abspielt",
                        "target_lang_word": "disc jockey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disc jockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "967958ba-a77e-38ca-bbaa-2743b1d7e4fe",
                                        "entry_id": "eb130297-893d-30da-8e14-158a024cfd0b",
                                        "glosses": [
                                            "A person who conducts a radio program of recorded music combined with talk, news, commercials, weather, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ba7ec38-67f3-40f4-a67e-6ed58a5a585c",
                                                "sense_id": "967958ba-a77e-38ca-bbaa-2743b1d7e4fe",
                                                "text": "The show he produced first aired on WJMR, a white-owned New Orleans radio station. The show's disc jockey used the name “Poppa Stoppa” and played what would then be called “race music,” the term given to any music produced by African American artists."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cf6e2b7-6fdd-318f-9add-3ff605db3512",
                                        "entry_id": "eb130297-893d-30da-8e14-158a024cfd0b",
                                        "glosses": [
                                            "A person who plays, and sometimes mixes, recorded music at nightclubs, dances, parties, or some other social event; and/or as a backup musician for spoken word, or hip hop performers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f69648d-f19e-4618-97e2-d73325187fa3",
                                                "sense_id": "6cf6e2b7-6fdd-318f-9add-3ff605db3512",
                                                "text": "The disc jockey played brilliant music at the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
