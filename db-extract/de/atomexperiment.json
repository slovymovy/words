                "senses": [
                    {
                        "sense_id": "f9bb46a0-60e9-3959-b4ee-1a4503cd9796",
                        "entry_id": "d77d80af-be34-33cd-9dd6-4481d7846f9c",
                        "glosses": [
                            "Zündung eines atomaren Sprengsatzes zu Testzwecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e587367-047b-4c7c-8111-0181af9d660a",
                                "sense_id": "f9bb46a0-60e9-3959-b4ee-1a4503cd9796",
                                "text": "„In Tschernobyl war nach einem Atomexperiment ein Reaktor in die Luft geflogen.“"
                            },
                            {
                                "example_id": "84dc7881-d9bb-4072-b441-ecd578bd9d41",
                                "sense_id": "f9bb46a0-60e9-3959-b4ee-1a4503cd9796",
                                "text": "„Die IAEO vermutet dort einen Standort für iranische Atomexperimente, ihre Kontrolleure hatten jedoch nie Zugang.“"
                            },
                            {
                                "example_id": "3d35a62c-1b70-4328-bbf8-fe7981935f9e",
                                "sense_id": "f9bb46a0-60e9-3959-b4ee-1a4503cd9796",
                                "text": "„So etwa 1995, als sie auf einen Balkon der französischen Botschaft in Rom kletterte und dort ein spontanes Konzert gab, um gegen die Atomexperimente vor dem Pazifikatoll Mururoa zu protestieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
