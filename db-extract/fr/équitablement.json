                        "source_entry_id": "1ae807fc-bd4e-3ee3-a42e-93189477893c",
                        "source_sense_id": "0936975a-0fd0-3c93-b714-9c91e8588217",
                        "target_lang_word": "fairly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fairly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30c1376f-6026-3f07-bd86-9b64673464cb",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "In a fair manner; fair; not biased or skewed or favouring a certain party"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14d5de7-1945-4af2-acd9-37982ec4b99a",
                                                "sense_id": "30c1376f-6026-3f07-bd86-9b64673464cb",
                                                "text": "A jury is expected to ensure that the accused is fairly judged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf90a210-72a6-39e9-8810-bdcc962bfd47",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Favorably; auspiciously; commodiously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f50afb4-e383-4829-9c0f-8104cff0792f",
                                                "sense_id": "cf90a210-72a6-39e9-8810-bdcc962bfd47",
                                                "text": "a town fairly situated for foreign trade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130bf230-958f-3fd4-a24f-650eda48cc47",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Honestly; properly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "210bc651-8a2f-4d51-9588-b519d3ed18dc",
                                                "sense_id": "130bf230-958f-3fd4-a24f-650eda48cc47",
                                                "text": "Consumer laws aim to have consumers fairly treated."
                                            },
                                            {
                                                "example_id": "f53d7ce9-d6b8-4064-8cec-59a846b4f844",
                                                "sense_id": "130bf230-958f-3fd4-a24f-650eda48cc47",
                                                "text": "10. You will be civil and attentive to passengers, giving proper assistance to ladies and children getting in or out, and never start the car before passengers are fairly received or landed."
                                            },
                                            {
                                                "example_id": "1bc1081c-2b3f-4072-9c03-132e39834dec",
                                                "sense_id": "130bf230-958f-3fd4-a24f-650eda48cc47",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too.[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2617c130-8907-3ec4-bc5a-6387ea19494e",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Softly; quietly; gently."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b47b1ece-999f-357f-b288-57cdcf86b09f",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Partly, not fully; somewhat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf0b464-a081-4d93-acc8-ea61dba26383",
                                                "sense_id": "b47b1ece-999f-357f-b288-57cdcf86b09f",
                                                "text": "The weather this weekend will be fairly dry."
                                            },
                                            {
                                                "example_id": "3a12ab48-8bb8-42ae-ac5a-4b1031a4eda6",
                                                "sense_id": "b47b1ece-999f-357f-b288-57cdcf86b09f",
                                                "text": "My hopes wa'n't disappointed. I never saw clams thicker than they was along them inshore flats. I filled my dreener in no time, and then it come to me that 'twouldn't be a bad idee to get a lot more, take 'em with me to Wellmouth, and peddle 'em out. Clams was fairly scarce over that side of the bay and ought to fetch a fair price."
                                            },
                                            {
                                                "example_id": "752582b5-b8eb-4852-8141-fea86bd6caa2",
                                                "sense_id": "b47b1ece-999f-357f-b288-57cdcf86b09f",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices). It was used to make kerosene, the main fuel for artificial lighting after overfishing led to a shortage of whale blubber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b30da7c4-0533-3b02-a381-4491efcb3915",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Almost; practically."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140ea9e9-fab6-40b9-95ad-f36cabbe51cf",
                                                "sense_id": "b30da7c4-0533-3b02-a381-4491efcb3915",
                                                "text": "We quadrilled, waltzed, and conversed, in all of which my clever partner excelled; and her charms, combined with the excellent champagne I imbibed, fairly dazzled my imagination."
                                            },
                                            {
                                                "example_id": "53b35f19-b4a8-4807-b841-bf89e264bc24",
                                                "sense_id": "b30da7c4-0533-3b02-a381-4491efcb3915",
                                                "text": "Betty grew so nervous and frightened, that she fairly bawled to her colleague, Moggy, and told her she would not stay in the room unless she sat up all night with her."
                                            },
                                            {
                                                "example_id": "da6cf2c5-73f2-47e5-83d2-50ed9cab832b",
                                                "sense_id": "b30da7c4-0533-3b02-a381-4491efcb3915",
                                                "text": "I remember the sudden drop in the note of the station bell, as we roar through, perhaps with 16 coaches; sweep up to milepost 9½, and then, with increasing thunder from the exhaust, fairly rush the fells at Milnthorpe at the foot of the climb to Grayrigg, until the steady thunderous beat re-echoes past Mosedale Hall, still at 40 m.p.h."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef347b51-17db-3239-be83-a69dbc10431a",
                                        "entry_id": "c49af43a-fb3c-397f-9e8f-187cb3ec3ec7",
                                        "glosses": [
                                            "Of handwriting: neatly and legibly."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a713c7-8a4d-48dc-8579-2102268dad31",
                                                "sense_id": "ef347b51-17db-3239-be83-a69dbc10431a",
                                                "text": "That Pen, which now writes blottingly, might be well made at first, and will write fairly again […]"
                                            },
                                            {
                                                "example_id": "cd2eeb90-8231-4139-8982-0ab26d551afa",
                                                "sense_id": "ef347b51-17db-3239-be83-a69dbc10431a",
                                                "text": "I was at the Mathematical School, where the Maſter taught his Pupils after a Method ſcarce imaginable to us in Europe. The Propoſition and Demonſtration were fairly written on a thin Wafer, with Ink compoſed of a Cephalick Tincture. This the Student was to ſwallow upon a faſting Stomach, and for three days following eat nothing but Bread and Water. As the Wafer digeſted, the Tincture mounted to his Brain, bearing the Propoſition along with it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
