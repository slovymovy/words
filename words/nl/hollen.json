                                "target_lang_sense_clarification": "to move or act with great violence or intensity"
                            },
                            {
                                "target_lang_word": "run riot",
                                "target_lang_sense_clarification": "to behave in a noisy and uncontrolled way"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28e2f090-8719-321c-a93d-959fdd88e1c1",
                    "sense_definition": "iemand voor de gek houden of met iemand sollen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "misleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet niet zo met die oude man <w>hollen</w>, dat verdient hij niet.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>mess with</w> that old man like that; he doesn't deserve it."
                            }
                        },
                        {
                            "text": "Ze probeerden met de nieuwe stagiair te <w>hollen</w> door hem onmogelijke opdrachten te geven.",
                            "target_lang_translations": {
                                "en": "They tried to <w>tease</w> the new intern by giving him impossible assignments."
                            }
                        }
                    ],
                    "synonyms": [
                        "sollen"
                    ],
                    "common_phrases": [
                        "met iemand hollen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Voornamelijk in specifieke regio's of verouderd gebruik"
                        }
                    ],
                    "target_lang_definitions": {
