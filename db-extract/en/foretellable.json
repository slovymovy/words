                        "glosses": [
                            "Able to be foretold; predictable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e8995c2-089e-442c-abc5-88cfab05deef",
                                "sense_id": "d78f5da3-ce13-3554-9ab9-dad2c4646504",
                                "text": "It was the one positively predictable thing, foretellable for ten or for ten thousand years by a simple mathematical calculation."
                            },
                            {
                                "example_id": "4daea69c-46a7-4b51-a110-8285d4f812e1",
                                "sense_id": "d78f5da3-ce13-3554-9ab9-dad2c4646504",
                                "text": "I remember how my entire life seemed to me to be foretellable, if only I could somehow decipher that cycle."
                            },
                            {
                                "example_id": "68c21e88-22ea-42a9-98ff-69f3988dfd0a",
                                "sense_id": "d78f5da3-ce13-3554-9ab9-dad2c4646504",
                                "text": "Quickly it taught him to prophesy, to leap over knowledge and wisdom straight into the fire and the glamor of things foretellable."
                            }
                        ]
                    }
                ],
