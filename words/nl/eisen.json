                            "comment": "plural of noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'eis' (requirement or demand)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demands",
                                "target_lang_sense_clarification": "forceful requests"
                            },
                            {
                                "target_lang_word": "requirements",
                                "target_lang_sense_clarification": "necessary conditions"
                            },
                            {
                                "target_lang_word": "criteria",
                                "target_lang_sense_clarification": "standards for judgment"
                            }
                        ]
                    }
                }
            ]
        }
    ]
