                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e980b5dd-de7d-39f3-abef-4260c0b0a672",
                                        "entry_id": "8c26e06c-3c91-37e4-a099-cdfaf9839484",
                                        "glosses": [
                                            "einfach gehalten, nicht sehr aufwändig gestaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c27cdd-8642-4f16-9c57-7045b5f8cb75",
                                                "sense_id": "e980b5dd-de7d-39f3-abef-4260c0b0a672",
                                                "text": "„Die Kritiker waren enttäuscht, da ihre Linie unverändert elegant und schlicht war.“"
                                            },
                                            {
                                                "example_id": "83cb0939-3ccc-4e62-8938-d21a218d0e25",
                                                "sense_id": "e980b5dd-de7d-39f3-abef-4260c0b0a672",
                                                "text": "So hatte man den Tisch der Magenleidenden, den Tisch der Nierenbankerotteure, den Tisch der Nervösen, den Tisch der stärker Nervösen, den Tisch der schon ein wenig Blöden, den Tisch der schlicht Blöden, den Tisch der absolut Blöden, den Tisch der aussichtslos Blöden (die mußten am meisten bezahlen). (Hermann Harry Schmitz, Im Sanatorium, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "5c7534ce-5863-4670-b338-99d32f8f0baf",
                                                "sense_id": "e980b5dd-de7d-39f3-abef-4260c0b0a672",
                                                "text": "Zum kleinen Schwarzen: Es ist nicht nur ein Kleid. Es ist ein Statement. Coco Chanel stellt es vor 90 Jahren in der Vogue vor. Mit den Worten: \"Dieses schlichte Kleid wird eine Art Uniform für Frauen mit Geschmack werden\"."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "schlicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4c3354a-f74f-370f-8a8e-91f0f2ec5f2f",
                                        "entry_id": "1b6e71e8-8083-3f3e-8ef3-86c366b76ee5",
                                        "glosses": [
                                            "betont das Gesagte ohne eine eigentliche eigene Bedeutung zu haben"
                                        ],
                                        "tags": [
                                            "emotional",
                                            "verstärkend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a0cafe-c4a6-478e-bfba-8adc864fe0b7",
                                                "sense_id": "c4c3354a-f74f-370f-8a8e-91f0f2ec5f2f",
                                                "text": "„Die Entwicklungsgeschichte des modernen Menschen ist mit rund 160000 Jahren schlicht zu kurz, um voneinander unterscheidbare Subspezies hervorzubringen.“"
                                            },
                                            {
                                                "example_id": "e09a6a25-5755-4b15-a5ef-28d24846dfae",
                                                "sense_id": "c4c3354a-f74f-370f-8a8e-91f0f2ec5f2f",
                                                "text": "„Manchmal nutzen die Täter schlicht das Telefon, um den IT-Support einer Organisation zu beschwatzen und so weitere Passwörter und Zugang zu Firmengeheimnissen zu erlangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
