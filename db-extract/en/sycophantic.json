                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ae6a438-d041-44dc-ab5a-cf20d3ab29dc",
                                                "sense_id": "267c3ef1-1b27-3a86-b869-4afb6ada5283",
                                                "text": "De kruiperige boekhouder durfde zijn baas er niet op te wijzen dat het bedrijf grote verliezen aan het lijden was."
                                            },
                                            {
                                                "example_id": "c545e29a-d4bb-47c3-8e64-980db1e14d55",
                                                "sense_id": "267c3ef1-1b27-3a86-b869-4afb6ada5283",
                                                "text": "De kruiperige lakei zei altijd ja en amen tegen de koning."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cee64fd6-83b5-4bc9-9da9-8bb8451e8020",
                        "source_entry_id": "751001c7-3616-3923-996d-3bff88129649",
                        "source_sense_id": "e8e251b2-2021-359b-94d3-103b1524b313",
                        "source_sense_description": "obsequious, flattering, toadying",
                        "target_lang_word": "vleierig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
