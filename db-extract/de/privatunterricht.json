                ],
                "senses": [
                    {
                        "sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                        "entry_id": "8fc730ea-e3d1-3995-bd0b-edff9a318f47",
                        "glosses": [
                            "privat initiierter (und gegebenenfalls bezahlter) Unterricht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d41dfe8e-8702-4fb3-8e2d-a4f0b2bc8872",
                                "sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                                "text": "„Zuvor musste er auf die Aufnahmeprüfung in die Sexta vorbereitet werden, was im Privatunterricht des Vaters geschehen sollte.“"
                            },
                            {
                                "example_id": "943eafc4-6437-4041-80a7-c72116654952",
                                "sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                                "text": "„Stattdessen erhielt er Privatunterricht von Simón Rodríguez und Andrés Bello, die beide später mit gesellschaftsanalytischen Schriften bekannt wurden.“"
                            },
                            {
                                "example_id": "2b25cd9f-6446-4460-a7e5-640127eb4e2d",
                                "sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                                "text": "„Ostilio Ricci erteilte nicht nur Privatunterricht, er war vor allem Lehrer an der Florentiner Kunstakademie.“"
                            },
                            {
                                "example_id": "fbf336d1-30c4-45a8-b6a0-a1b38c2a1fbe",
                                "sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                                "text": "„Hier und später in Lüthorst erteilte der Pastor den Söhnen seiner Schwester Privatunterricht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b97e5e6a-36e3-42d5-b7a7-9af73887f333",
                        "source_entry_id": "8fc730ea-e3d1-3995-bd0b-edff9a318f47",
                        "source_sense_id": "8b12d4dd-9571-36b5-81c8-dab983fb2110",
                        "source_sense_description": "privat initiierter (und gegebenenfalls bezahlter) Unterricht",
                        "target_lang_word": "cours particulier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cours particulier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1cb08c3-bc36-3ee4-a668-7920e2728ce6",
                                        "entry_id": "480ed62d-65c9-3068-ad09-e5a48f541593",
                                        "glosses": [
                                            "Leçon donnée à une personne ou un petit groupe de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b7cab55-24c8-48e9-a498-8487e2ebdfbb",
                                                "sense_id": "a1cb08c3-bc36-3ee4-a668-7920e2728ce6",
                                                "text": "Je dois donner un cours particulier. Les yeux verts de Robbie se firent inquisiteurs. — Un cours particulier ? A qui ? Mon cœur se mit à battre un peu plus fort, et je me retins de sourire bêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c897aaba-8656-3759-bc57-4c3c86c8f012",
                                        "entry_id": "480ed62d-65c9-3068-ad09-e5a48f541593",
                                        "glosses": [
                                            "Enseignement supplémentaire spécial d’une matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc873fe-4f63-43da-b7ed-d35c182dffde",
                                                "sense_id": "c897aaba-8656-3759-bc57-4c3c86c8f012",
                                                "text": "Cet ouvrage est un « cours particulier », ce qui signifie qu’il ne s'adresse pas à tous, mais à chacun, et qu’il n’est pas systématique, encore moins exhaustif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
