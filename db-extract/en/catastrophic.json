                    {
                        "translation_id": "367a8f15-8e52-4f0d-8f5b-ac8702078a47",
                        "source_entry_id": "089a245d-ec3d-3462-b480-3d87af67e976",
                        "source_sense_description": "of or pertaining to a catastrophe",
                        "target_lang_word": "catastrophique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
