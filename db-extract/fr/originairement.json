        "fr-extract.jsonl": [
            {
                "entry_id": "51382df4-1a93-376e-ae7c-ed8cfc7844a1",
                "word": "originairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                        "entry_id": "51382df4-1a93-376e-ae7c-ed8cfc7844a1",
                        "glosses": [
                            "Dans l’origine ; primitivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b12f11-8581-416d-a370-cfcfe9206020",
                                "sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                                "text": "Quand La Fontaine a retrouvé chez Boccace des sujets qui étaient originairement français, il n’a fait que reprendre notre bien."
                            },
                            {
                                "example_id": "d9e884e1-18c9-4048-9be8-d31571e1c652",
                                "sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                                "text": "La loi salique en son titre XLVI nous décrit minutieusement les rites formalistes de l'institution, rites antérieurs aux invasions, semble-t-il ; ces rites rapprochent aussi l’affatomie des legs et du testament, alors que les Germains ignorent les actes à cause de mort originairement."
                            },
                            {
                                "example_id": "aa98b4ef-52ca-4e1e-8b5c-0f2aa73f37e3",
                                "sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                                "text": "L’opinion la plus singulière d’Anaximandre est d’avoir pensé qu’originairement les hommes ont été poissons, …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f220b14-4a3c-4d87-acde-b76759670bd0",
                        "source_entry_id": "51382df4-1a93-376e-ae7c-ed8cfc7844a1",
                        "source_sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                        "target_lang_word": "at first",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "at first",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                        "entry_id": "52c99269-5db6-32a4-a475-ff570ad2ec3e",
                                        "glosses": [
                                            "Initially; at the start; originally."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a940420a-616d-4ff1-bf9d-bda455bd4485",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "If at first you don't succeed, try, try again."
                                            },
                                            {
                                                "example_id": "66ea4230-535a-496a-a004-b4ad7ee71359",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "The work was hard at first, but soon I got used to it."
                                            },
                                            {
                                                "example_id": "71a8c124-1787-4e19-9971-6b19450f82a5",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "d506e39e-580b-4075-97e3-42fae6d47cff",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "This year of 1905 also saw the completion of the electrification of the Underground, which certainly improved the atmosphere, and made travelling easier and more comfortable, although, at first, not too reliable."
                                            },
                                            {
                                                "example_id": "9bc049a6-21a3-4d48-a519-a4442f6f2457",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "At first I was afraid, I was petrified / Kept thinking I could never live without you by my side"
                                            },
                                            {
                                                "example_id": "8c3c234f-bc82-42b1-a64c-392b6c7022fd",
                                                "sense_id": "4c77cded-2566-37fe-8142-620cd48e1ea4",
                                                "text": "KIRA: Look, Dukat, I know you're angry, but maybe you ought to think about what you're proposing. I mean, you can't go to war against the whole Klingon Empire with one bird of prey.\nDUKAT: Why not? Your people fought against us for fifty years with much less sophisticated weaponry than this. And you beat us.\nKIRA: It's not the same. The Bajoran people were united. We were all fighting for the same goal. You and your crew would be out there alone.\nDUKAT: Maybe at first, but perhaps our actions would inspire others to join the struggle!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21dc6e3f-ee4c-455e-965d-e7780cc4d6a6",
                        "source_entry_id": "51382df4-1a93-376e-ae7c-ed8cfc7844a1",
                        "source_sense_id": "97ac93f4-a947-3680-a873-dfae286ea3e0",
                        "target_lang_word": "originally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "originally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "As it was in the beginning; at first."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3d66e37-82ce-4e15-869e-f6f7d6cd2e25",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "Originally, this paper was white, but over the years it has yellowed with age."
                                            },
                                            {
                                                "example_id": "af10b5cb-60e7-4daf-8e5b-63bc093f8653",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "There are 36 known praenomina, though there may originally have been more."
                                            },
                                            {
                                                "example_id": "a43b0e92-06ba-4da6-9f72-96a918009c9c",
                                                "sense_id": "9d963c0f-d257-3170-a48d-91af7103fa05",
                                                "text": "The little green men were clearly professional soldiers by their bearing, carried Russian weapons, and wore Russian combat fatigues, but they had no identifying insignia. Vladimir Putin originally denied they were Russian soldiers; that April, he confirmed they were."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                        "entry_id": "9157079e-624d-3ee9-b135-0d6d2deeb4ea",
                                        "glosses": [
                                            "In an original manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2f3562-9390-4bae-80bf-d57d71676d16",
                                                "sense_id": "ae720122-c444-30ab-985d-c8379b5d9818",
                                                "text": "They had to think originally to come up with those creative ideas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
