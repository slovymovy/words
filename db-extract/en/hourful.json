                "senses": [
                    {
                        "sense_id": "80f1cef1-31ef-3ad3-aa1b-906849984b40",
                        "entry_id": "bc9efb38-cf6d-3637-986f-99661b1272ee",
                        "glosses": [
                            "Enough to last an hour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7080e5-70df-4298-9bcd-ea522244c40e",
                                "sense_id": "80f1cef1-31ef-3ad3-aa1b-906849984b40",
                                "text": "The silver tufts of grass have fed the air with hourfuls of mealy ferine smells and hot-backed buzzards, eagles and vultures must have chased their murderous shadows through the bush"
                            },
                            {
                                "example_id": "708f26e2-cc3d-4559-9440-651dd0489436",
                                "sense_id": "80f1cef1-31ef-3ad3-aa1b-906849984b40",
                                "text": "Hills to the north and to the south shut in all the dampness and shut out hoursful of sun."
                            },
                            {
                                "example_id": "d1c6f523-1dd5-4590-954f-8d66d209b6e4",
                                "sense_id": "80f1cef1-31ef-3ad3-aa1b-906849984b40",
                                "text": "Arriving about 1 A.M. at Locknan's Station, a few log and timber huts near a creek well feathered with white oak and American elm, hickory and black walnut, we found beds and snatched an hourful of sleep."
                            },
                            {
                                "example_id": "f59cd0fd-64c6-4bd1-b510-5dffcc109bed",
                                "sense_id": "80f1cef1-31ef-3ad3-aa1b-906849984b40",
                                "text": "A German professor always gives good measure, a full hourful, pressed down, shaken together, and running over; no period of preliminary meditation on what he shall say and of casual conversation at the end, as often in America."
                            }
                        ]
                    }
