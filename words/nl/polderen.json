{
    "word_family": [
        "polder",
        "poldermodel"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea3a6dd1-d40d-3679-9e02-2c3f637eeb74",
                    "sense_definition": "Compromissen sluiten en naar consensus streven via overleg, vooral in de politiek of het bedrijfsleven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek-overleg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politici moeten lang <w>polderen</w> om een nieuw akkoord te bereiken.",
                            "target_lang_translations": {
                                "ru": "Политикам приходится долго <w>вести переговоры</w>, чтобы достичь нового соглашения."
                            }
                        },
                        {
                            "text": "In Nederland is <w>eindeloos</w> <w>polderen</w> een bekende methode om grote problemen samen op te lossen.",
                            "target_lang_translations": {
                                "ru": "В Нидерландах <w>бесконечный поиск компромиссов</w> — известный метод совместного решения крупных проблем."
                            }
                        }
                    ],
                    "synonyms": [
                        "onderhandelen",
                        "samenwerken"
                    ],
                    "common_phrases": [
                        "eindeloos polderen",
                        "samen polderen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искать компромисс и консенсус путем переговоров, особенно в политике или бизнесе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести переговоры для достижения консенсуса",
                                "target_lang_sense_clarification": "о поиске компромисса путем обсуждений (полдеринг)"
                            },
                            {
                                "target_lang_word": "искать компромисс",
                                "target_lang_sense_clarification": "путем долгих переговоров"
                            },
                            {
                                "target_lang_word": "полдерить",
                                "target_lang_sense_clarification": "термин для обозначения голландской модели переговоров"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79899893-3a29-304b-abe9-a85b837f4c3f",
                    "sense_definition": "Het aanleggen, onderhouden en beheren van polders.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waterbeheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>polderen</w> vereist veel kennis over waterbeheer en dijken.",
                            "target_lang_translations": {
                                "ru": "<w>Обустройство польдеров</w> требует больших знаний в области управления водными ресурсами и дамб."
                            }
                        },
                        {
                            "text": "Door het slimme <w>polderen</w> bleef het drooggelegde land altijd veilig.",
                            "target_lang_translations": {
                                "ru": "Благодаря грамотному <w>управлению польдерами</w> осушенная земля всегда оставалась в безопасности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Specifiek voor de Nederlandse/Vlaamse waterbouwcontext"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создание, обслуживание и управление польдерами (осушенными участками земли)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осушать и обустраивать польдеры",
                                "target_lang_sense_clarification": "в контексте водного хозяйства"
                            },
                            {
                                "target_lang_word": "управлять польдерами",
                                "target_lang_sense_clarification": "поддержание и защита осушенных земель"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}