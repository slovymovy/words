                                    {
                                        "sense_id": "980680d1-36f6-3540-8214-2306e715a080",
                                        "entry_id": "8b24b446-90bb-3d84-9b7d-1dff2292ebe2",
                                        "glosses": [
                                            "Instrument biface ou uniface servant à la coiffure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3d557af-6ded-4623-afc4-e56fee2cef7b",
                                                "sense_id": "980680d1-36f6-3540-8214-2306e715a080",
                                                "text": "Une brosse à cheveux ne doit, pas plus qu’une brosse à dents, être prêtée à autrui."
                                            },
                                            {
                                                "example_id": "7c63f79d-6c7c-48e9-aacf-5e17d83e09dd",
                                                "sense_id": "980680d1-36f6-3540-8214-2306e715a080",
                                                "text": "— Eh bien, je vais me ramoner avec la poignée de votre brosse à cheveux et l’inonder d’un tel déluge de mouille que vous ne pourrez vous coiffer aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03907caa-ebf4-4fc2-90da-871cd532dec1",
                        "source_entry_id": "3e715257-cbd7-3183-afbf-d4a9c14f61b5",
