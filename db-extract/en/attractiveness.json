                    },
                    {
                        "translation_id": "10e96568-ce17-4238-a31a-886444ae6660",
                        "source_entry_id": "ed6dc435-7692-36be-ad3f-a3b1c8d5b8b1",
                        "source_sense_description": "state of being attractive or engaging",
                        "target_lang_word": "Anziehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anziehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "546c1152-55c0-3b7b-b003-9fcaf4fc4810",
                                        "entry_id": "554a146d-b9e7-3515-a428-77c281e840dc",
                                        "glosses": [
                                            "die Kraft eines Körpers, einen anderen Körper zu sich hin zu bewegen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3526c8c6-61f6-4d59-a22b-8a82a174d45c",
                                                "sense_id": "546c1152-55c0-3b7b-b003-9fcaf4fc4810",
                                                "text": "„Newton, der das vortreffliche Gesetz der Anziehung entdeckt hat, welches vor den glücklichsten Versuch angesehen werden muß, den der menschliche Verstand in der Erkenntnis der Natur noch getan hat, lehret die Anziehungskräfte der Planeten, die Monde um sich haben, finden und bestimmt des Jupiters, des größten unter allen Planeten, seine etwas gringer als den tausendsten Teil der Anziehungskraft der Sonne.“"
                                            },
                                            {
                                                "example_id": "b9ea2d3c-4f78-42ff-a08c-de227b4e8abe",
                                                "sense_id": "546c1152-55c0-3b7b-b003-9fcaf4fc4810",
                                                "text": "Zwischen der Erde und dem Mond besteht eine gegenseitige Anziehung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                        "entry_id": "554a146d-b9e7-3515-a428-77c281e840dc",
                                        "glosses": [
                                            "Attraktivität, die von etwas oder jemandem auf einen Menschen ausgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377034d0-33ee-49f1-afbd-8bb33cd299a4",
                                                "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                                "text": "Am Ziel, der Südspitze Südamerikas angekommen, hat die Erde für die beiden Langzeitreisenden nichts von ihrer Anziehung verloren."
                                            },
                                            {
                                                "example_id": "02d5b0fc-34d9-48ce-843b-44e8f45f221e",
                                                "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                                "text": "Dating ist eine gute Flirt-Möglichkeit, um bereits in kürzester Zeit Sympathien oder eine sexuelle Anziehung zwischen zwei Personen festzustellen."
                                            },
                                            {
                                                "example_id": "fd3d5d05-ee0f-4887-8a78-5afddeea9da2",
                                                "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                                "text": "„Alkohol ist überall im Norden ein Reizthema, zwischen magnetischer Anziehung und Verteufelung gibt es hier selten einen vernünftigen Mittelweg.“"
                                            },
                                            {
                                                "example_id": "59ebec73-49d4-44c6-9825-60df4796bf49",
                                                "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                                "text": "„Wie jeder weiß, hat Licht eine enorme Anziehung auf sämtliche nachtaktive Insekten, von Mücken über Fliegen und Nachtfalter.“"
                                            },
                                            {
                                                "example_id": "d714cae4-4d5f-4b52-a95d-fe15e99bc52d",
                                                "sense_id": "a6c2e9eb-e7ba-3881-8411-bc0ec1f395aa",
                                                "text": "„So ziehen sich Bewunderung und Skepsis, Anziehung und Abstoßung durch alle Äußerungen, ohne jeden Abstrich aber nennt er die »Iphigenie« und den »Torquato Tasso« die »zwei in ihren Gattungen vollkommensten Meisterwerke, die unsre Sprache aufzuweisen hat«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21233a50-18b4-4708-83bf-03a6d36a0957",
                        "source_entry_id": "ed6dc435-7692-36be-ad3f-a3b1c8d5b8b1",
                        "source_sense_description": "state of being attractive or engaging",
                        "target_lang_word": "Anziehungskraft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anziehungskraft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                        "entry_id": "e3c46e40-31b1-3fa7-975c-1b440d3fae88",
                                        "glosses": [
                                            "anziehend wirkende, auf einen Punkt gerichtete Kraft"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09b3645b-edcb-4cb6-9d71-f8354c91ed1a",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "Auf dem Mond und auf der Erde erfährt der gleiche Körper unterschiedliche Anziehungskräfte."
                                            },
                                            {
                                                "example_id": "6d88752e-8301-4e02-b2c2-c499f2f75655",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "[Chemie: …:] „Beim Lösen eines Salzes muss zunächst die Gitterenergie aufgewendet werden, um die Anziehungskräfte zwischen den Ionen im Kristallgitter zu überwinden und die Ionen voneinander zu trennen.“"
                                            },
                                            {
                                                "example_id": "c7a3945e-b4a9-4004-9390-0cb5b35cd0a0",
                                                "sense_id": "b4084005-57ae-399f-8478-befe9dd5640d",
                                                "text": "Ob die elektromagnetische Wechselwirkung eine Anziehungskraft ist, hängt von dem Vorzeichen der Ladung ab, durch die sie erzeugt wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                        "entry_id": "e3c46e40-31b1-3fa7-975c-1b440d3fae88",
                                        "glosses": [
                                            "Eigenschaft, Interesse zu erwecken, zu faszinieren"
                                        ],
                                        "tags": [
                                            "in Bezug auf Menschen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d42e2b1a-3355-41db-96c2-460fcede6300",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "Eine große, leuchtende Werbetafel hat eine gewisse Anziehungskraft."
                                            },
                                            {
                                                "example_id": "16032bd8-e95f-4407-aaa5-652b86cbd9fa",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Hätte Hitler nur bramarbasiert, ohne irgendwelche greifbaren Ergebnisse vorzuweisen, dann hätte Enttäuschung seine Anziehungskraft natürlich rasch schwinden lassen.“"
                                            },
                                            {
                                                "example_id": "b9267ad6-a914-4791-a9ce-16f5f3649756",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Vor allem auf Frauen, die von ihren Männern geschlagen werden, übt Awra Amba eine magische Anziehungskraft aus.“"
                                            },
                                            {
                                                "example_id": "c384dc7f-80bc-46d3-b10e-ed8a1b756b47",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Auch Martin spürte diese sonderbare Anziehungskraft.“"
                                            },
                                            {
                                                "example_id": "a3965562-e4d7-46ec-b808-24d350e4e980",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Allerdings ließ die Anziehungskraft des jungen Mannes eine Weile später nach.“"
                                            },
                                            {
                                                "example_id": "04171baf-cbba-4654-879d-1617bb8d9fad",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Zachäus ist von der Anziehungskraft Jesu begeistert.“"
                                            },
                                            {
                                                "example_id": "e22dabe4-e75c-49e1-b0a7-d85100862eb3",
                                                "sense_id": "d69d7927-5ad9-3f91-99db-89f8258e088b",
                                                "text": "„Durch die Anziehungskraft von künstlichem Licht auf Insekten sterben allein in Deutschland schätzungsweise pro Sommer 100 Milliarden Individuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c37f24d2-34db-45bc-ba8d-a62a78a0a437",
                        "source_entry_id": "ed6dc435-7692-36be-ad3f-a3b1c8d5b8b1",
