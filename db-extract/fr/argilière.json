                                "example_id": "1449d0ab-1bde-4dfc-9762-c7e187593530",
                                "sense_id": "1440b523-6506-39d6-bd66-99a2a8449076",
                                "text": "C’est une argilière. L’eau est bonne, ça, on ne peut pas dire, claire, pas trop fraîche. Il y en a pas mal. Mais c’est là-bas."
                            }
                        ]
