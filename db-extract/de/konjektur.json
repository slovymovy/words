                                "target_senses": [
                                    {
                                        "sense_id": "bd8cc11b-d9b0-35cc-83ea-c08c53cadfc5",
                                        "entry_id": "b49c64f7-97e8-34b1-89b5-e96ec224c815",
                                        "glosses": [
                                            "een waarschijnlijke waarheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89be447a-e5b6-49d6-82cf-9772c186b4c5",
                                                "sense_id": "bd8cc11b-d9b0-35cc-83ea-c08c53cadfc5",
                                                "text": "Een vermoeden is een bewering waarvan men denkt dat deze waar is, zonder daarvan zeker te zijn."
                                            },
                                            {
                                                "example_id": "4a106fee-b472-4479-baac-63e32ffff910",
                                                "sense_id": "bd8cc11b-d9b0-35cc-83ea-c08c53cadfc5",
                                                "text": "Mijn vermoeden zou zijn dat u zijn gezelschap kunt waarderen. Hij is een eminent geleerde.'"
                                            },
                                            {
                                                "example_id": "53b25c94-b6e9-48a3-aa72-4f9772dc8699",
                                                "sense_id": "bd8cc11b-d9b0-35cc-83ea-c08c53cadfc5",
                                                "text": "Minister Micky Adriaansens van Economische Zaken wil dat eenmanszaken hun vestigingsadres straks volledig kunnen afschermen in het Handelsregister van de Kamer van Koophandel (KVK). Ondernemers moeten als alternatief dan wel een postadres registreren. KVK schermt nu al op verzoek af bij een vermoeden van dreiging."
                                            },
                                            {
                                                "example_id": "911ee5ea-719d-4bd1-987a-967d61e8a93e",
                                                "sense_id": "bd8cc11b-d9b0-35cc-83ea-c08c53cadfc5",
                                                "text": "Het was zo'n onschuldige opmerking dat van iedereen in de kamer alleen Oscar en Ingeborg onraad vermoedden en elkaar snel een waarschuwende blik toewierpen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250fa5ab-e9a2-3c1a-8921-f3d724a5c0aa",
                                        "entry_id": "b49c64f7-97e8-34b1-89b5-e96ec224c815",
                                        "glosses": [
                                            "een stelling zonder bewijs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0db56c-8bfe-40c1-adcd-92bfc870e282",
                                                "sense_id": "250fa5ab-e9a2-3c1a-8921-f3d724a5c0aa",
                                                "text": "In de wiskunde is een vermoeden een wiskundige uitspraak waarvan wiskundigen denken dat deze waar is, terwijl er nog geen sluitend bewijs voor gevonden is."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vermoeden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4b87a1bb-9f3f-3fd6-bca9-c42265018971",
                                        "entry_id": "23e91f11-48e7-3460-8823-af763361572a",
                                        "glosses": [
                                            "een gedachte koesteren waarvan men niet zeker is maar die een zekere waarschijnlijkheid inhoudt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0bc3d4-94b2-44e4-a7ea-04576bb5f38e",
                                                "sense_id": "4b87a1bb-9f3f-3fd6-bca9-c42265018971",
                                                "text": "Resistentie werd vermoed in ten minste een aantal gevallen."
                                            },
                                            {
                                                "example_id": "7cbb0ad0-2dba-4b36-8f96-3707e37539d1",
                                                "sense_id": "4b87a1bb-9f3f-3fd6-bca9-c42265018971",
                                                "text": "De stank deed vermoeden dat er vroeger duidelijk te veel was gerookt in de kamer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
