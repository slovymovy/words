                ],
                "senses": [
                    {
                        "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                        "entry_id": "21ecd0e6-876f-3dbb-a2f9-45ba6e74f641",
                        "glosses": [
                            "Froschlurch aus der Gattung Bufotes innerhalb der Familie der Kröten"
                        ],
                        "tags": [
                            "Bufonidae"
                        ],
                        "examples": [
                            {
                                "example_id": "a72dd5c8-1e27-45b6-a606-c210e3fea33b",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Wechselkröten zählen zu den wanderfreudigsten Amphibien.“"
                            },
                            {
                                "example_id": "ceed4009-f914-4b85-be4b-d4cec973390c",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Die Wechselkröte wird auf der Roten Liste als stark gefährdete Art eingestuft.“"
                            },
                            {
                                "example_id": "95d93b1b-bd1a-439c-8ef0-decd3b5150ce",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Wie die Kreuzkröte, war auch die Wechselkröte als typische Pionierart vom Mangel an Laichmöglichkeiten im Trockenjahr 2012 betroffen.“"
                            },
                            {
                                "example_id": "86204fef-0b7c-4077-b909-565a1b77bb7d",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Als wärmeliebende Art pflanzt sich die Wechselkröte in Mitteleuropa gewöhnlich erst Mitte April und im Mai fort, wenn die Wassertemperaturen mindestens 12°C betragen.“"
                            },
                            {
                                "example_id": "3d89aa92-cff4-4ad4-bda9-13f69b5789c2",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Wechselkröte wird im Terrarium 28 Jahre alt“"
                            },
                            {
                                "example_id": "7b5e1c21-b074-4f48-ba37-a9679a3941b0",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "„Die Wechselkröte ist im Vergleich zur Kreuzkröte durchaus auch tagaktiv (sowohl rufend als auch am Laichgewässer).“"
                            },
                            {
                                "example_id": "ab270107-8416-46ca-b7e3-061ee9bf612e",
                                "sense_id": "c3cc7e6a-8d2f-35c4-bfea-0c5f45d89eef",
                                "text": "Die Wechselkröte (Bufotes viridis) gehört zu den seltenen Amphibien Deutschlands. Sie gilt laut der Roten Liste in Schleswig-Holstein von 2019 als vom Aussterben bedroht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
