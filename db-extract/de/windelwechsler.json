                "senses": [
                    {
                        "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                        "entry_id": "795b0303-47d3-3528-9ae3-83bed71c883f",
                        "glosses": [
                            "eine männliche Person, die Windeln wechselt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd201a1-8f26-4bfc-8a3c-009fb5b9da3e",
                                "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                                "text": "„Prinz Charles wird als fröhlicher Windelwechsler porträtiert, die schöne Diana als erschöpfte, aber glückliche Mutter.“"
                            },
                            {
                                "example_id": "9fd6e6fb-f2f3-44b6-846a-5278c233beb3",
                                "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                                "text": "„Sichtermann jedenfalls beschreibt aus eigener Erfahrung höchst anschaulich, wie man sich als ‚Forschungsassistent‘ des eigenen Sohns, als noch auf der Toilette ‚unter Aufsicht‘ stehender Erwachsener, als Windelwechsler, Bodenkriecher und Lastenträger so fühlt.“"
                            },
                            {
                                "example_id": "c15ed3f2-35cb-4935-802f-f9afa12a4e1b",
                                "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                                "text": "„Ernährer sollen sie [die Männer] sein, doch heutzutage eben auch Windelwechsler, Liebhaber und am besten alles auf einmal.“"
                            },
                            {
                                "example_id": "f5007ad6-ff56-474a-8067-ab9417a8ada0",
                                "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                                "text": "„Woraufhin aus Di Fabio zuerst ein profilierter Windelwechsler wurde und dann ein Mensch, der von seinem Schreibtisch aus für Kinder, Kinder, Kinder wirbt.“"
                            },
                            {
                                "example_id": "50cfb554-9a2a-4188-9f16-9963b8f8cada",
                                "sense_id": "d7881901-65ce-3eaf-aecb-b8bccf5cd052",
                                "text": "„Im Laufe der Jahre wurde mein Mann aber zum perfekten Windelwechsler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
