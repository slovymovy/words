                            {
                                "example_id": "b822948e-f95e-43f4-a4f4-0ac336f2980b",
                                "sense_id": "5ccf00e5-692e-3f65-9593-22ba6696f8d5",
                                "text": "Plusieurs commentateurs ont évoqué le danger d’une « vietnamisation » du Parlement où, confronté à une guérilla permanente, le nouveau gouvernement pourrait se trouver incapable de faire adopter les réformes économiques nécessaires, notamment les plus impopulaires."
                            },
                            {
                                "example_id": "07958b7e-26a5-4449-8570-a13b5e1e001d",
                                "sense_id": "5ccf00e5-692e-3f65-9593-22ba6696f8d5",
                                "text": "Dans le cadre d’Iraqi Freedom, la plupart des analystes prédisaient certes une victoire militaire américaine, mais le très temporaire épisode de « la vietnamisation » du conflit irakien en souligne les ambiguïtés."
                            },
                            {
                                "example_id": "d3459ab8-6b53-40d9-9a0c-4918d1b23471",
                                "sense_id": "5ccf00e5-692e-3f65-9593-22ba6696f8d5",
                                "text": "On a pu parler de dékhmèrisation ou de vietnamisation du Cambodge."
                            }
                        ]
