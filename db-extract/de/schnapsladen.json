                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b317967-1720-46e1-badc-da9fd7020c74",
                                "sense_id": "a59127c9-ff45-3da4-80ba-b1695133021f",
                                "text": "„Boccia war ein Kleinganove, der den Fehler beging, einen Schnapsladen zu überfallen, der einem Freund von Genovese gehörte.“"
                            },
                            {
                                "example_id": "77b1b042-a465-4751-8c5a-2998c089f990",
                                "sense_id": "a59127c9-ff45-3da4-80ba-b1695133021f",
                                "text": "„Worden erinnert sich noch gut an den Morgen, als er bei seinem Eintreffen im Büro den Bericht eines Vorfalls im Eastern District auf dem Schreibtisch fand, den Überfall auf einen Schnapsladen in der Greenmount Avenue.“"
                            },
                            {
                                "example_id": "8022b184-9458-434d-8848-ef03483a7a1f",
                                "sense_id": "a59127c9-ff45-3da4-80ba-b1695133021f",
                                "text": "„Ich verschob meine Antwort — ebenfalls verschlüsselt — bis nach der feierlichen Eröffnung des Schnapsladens, zu der, so der General, auch Claude kommen würde.“"
                            },
                            {
                                "example_id": "5cff7b10-6dc0-4f28-a5da-ec9d365f587c",
                                "sense_id": "a59127c9-ff45-3da4-80ba-b1695133021f",
                                "text": "„Sie ist in den District gefahren und hat welche in diesem gottverdammten Schnapsladen ausgestellt.“"
                            },
                            {
                                "example_id": "71d59038-ea14-48dc-8e98-811710970812",
                                "sense_id": "a59127c9-ff45-3da4-80ba-b1695133021f",
                                "text": "„Auf dem Rückweg zum Friedhof halte ich an einem Schnapsladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
