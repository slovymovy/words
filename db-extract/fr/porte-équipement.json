                        "source_sense_id": "40d66253-eadf-3da5-acc3-c510325f961d",
                        "target_lang_word": "deck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0481e595-5699-371e-ba30-27d1f16d8d1f",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "Any raised flat surface that can be walked on: a balcony; a porch; a raised patio; a flat rooftop."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24bfe0dd-4873-3654-97b7-ffc43572509d",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The floorlike covering of the horizontal sections, or compartments, of a ship or boat. Small vessels have only one deck; larger ships have two or three decks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18a13e26-d456-40e8-8603-6c087166ccb1",
                                                "sense_id": "24bfe0dd-4873-3654-97b7-ffc43572509d",
                                                "text": "Holonyms: watercraft, vessel, vessel"
                                            },
                                            {
                                                "example_id": "56c88b6e-8051-407c-860c-42c0312a4b82",
                                                "sense_id": "24bfe0dd-4873-3654-97b7-ffc43572509d",
                                                "text": "to swab the deck"
                                            },
                                            {
                                                "example_id": "6c0af8df-0aa1-41cf-a608-675695eeace8",
                                                "sense_id": "24bfe0dd-4873-3654-97b7-ffc43572509d",
                                                "text": "Carried somehow, somewhither, for some reason, on these surging floods, were these travelers,[…]. Even such a boat as the Mount Vernon offered a total deck space so cramped as to leave secrecy or privacy well out of the question, even had the motley and democratic assemblage of passengers been disposed to accord either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458fc920-437f-30d3-b474-9df40291a5ad",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A main aeroplane surface, especially of a biplane or multiplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f811ff1b-0e95-35ed-b97d-48087d27f3e5",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A pack or set of playing cards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eef6a217-abed-3b44-b703-ef25959eebf1",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A set of cards owned by each individual player and from which they draw when playing."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "704ad2af-8520-3bdd-9ac1-b40a13f5bf9e",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A headline consisting of one or more full lines of text; especially, a subheadline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cefb82bd-dd34-4312-a03e-b4d10b5c3d06",
                                                "sense_id": "704ad2af-8520-3bdd-9ac1-b40a13f5bf9e",
                                                "text": "If there's a strapline or subdeck, write these after the main deck and don't use the same words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "773f27d3-a7db-3e7e-b8f1-648c9af14069",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "Ellipsis of slide deck: a set of slides for a presentation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7286024-450a-44c3-a997-802bc631e7ea",
                                                "sense_id": "773f27d3-a7db-3e7e-b8f1-648c9af14069",
                                                "text": "Navigate to the location where your PowerPoint deck is stored and select it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bda4fb8f-35e2-373a-8a12-2fc7d354db3b",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A collection of cards (pages or forms) in systems such as WML (Wireless Markup Language) and HyperCard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cdd490-a253-4942-97b5-90b5460be331",
                                                "sense_id": "bda4fb8f-35e2-373a-8a12-2fc7d354db3b",
                                                "text": "The interaction model of WAP, originally developed for mobile phones to interact with information services in a web-like way, was based on Apple's HyperCard, and instead of pages, the user interacted with a deck of cards, which were interlinked by a scripting language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0662b7-760e-3c66-8633-92722b1f5221",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A heap or store."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35397a53-d3ca-43df-b1bc-cbe6f451b654",
                                                "sense_id": "ff0662b7-760e-3c66-8633-92722b1f5221",
                                                "text": "A paper-blurrer, who on all occasions, / For all times, and all season, hath such trinkets / Ready in the deck"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02134163-9f89-3da3-8f23-a4f145a94460",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "A folded paper used for distributing illicit drugs."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4021411f-b840-48f2-84b5-0b4afb297757",
                                                "sense_id": "02134163-9f89-3da3-8f23-a4f145a94460",
                                                "text": "Defendant placed the decks in his pocket and, after driving out of the city, gave one to Shore. While still in the car, Shore snorted half of the deck. When they returned to defendant's home, defendant handed Shore a second deck of heroin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The floor."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12b55ae5-d3cf-471c-9071-c6348ac6f495",
                                                "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                                "text": "We hit the deck as bullets began to fly."
                                            },
                                            {
                                                "example_id": "adec9054-2d98-4ebf-9574-8211496ca281",
                                                "sense_id": "d40d27ee-cbca-3242-ae7e-4040053c0023",
                                                "text": "Williams fell to the deck. Following a lengthy check, he was replaced by Connor Roberts due to a suspected concussion - a scenario well explained by the stadium's staff over the PA system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b64c6ca0-228a-36af-9a22-88bf1423304f",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The bottom of a water body."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4d0f19f-6837-48c6-a08b-71aea2c61675",
                                                "sense_id": "b64c6ca0-228a-36af-9a22-88bf1423304f",
                                                "text": "Wily carp are quickly put on their guard by tight lines cutting through the water, so another common measure is to use a back lead to keep the line on the deck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b645ec87-f9b5-3593-b335-3827c1cf477f",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The stage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d66de65-08ab-37be-83dd-818de4d27992",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "Ellipsis of tape deck."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3588ba30-5166-4cb1-9857-7c7f432c20a5",
                                                "sense_id": "5d66de65-08ab-37be-83dd-818de4d27992",
                                                "text": "The general operating procedure for recording a tape is basically the same as for playing it. After you insert the tape in the deck, you fast forward it to the end and then completely rewind it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69e2f767-b5d1-3ffe-b0c8-9dee0b031d36",
                                        "entry_id": "60faa494-66cd-3319-a633-3625894cffdc",
                                        "glosses": [
                                            "The multiset of graphs formed from a single graph by deleting a single vertex in all possible ways."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "deck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc354342-2b10-384b-9d1c-e83db35cd575",
                                        "entry_id": "c71d5501-e577-377a-89d1-b907fbe5f82b",
                                        "glosses": [
                                            "To furnish with a deck, as a vessel."
                                        ],
