                "senses": [
                    {
                        "sense_id": "d7a439c5-b58e-3527-a9ae-a1f9ba270088",
                        "entry_id": "57a72a52-3f81-36f8-8923-93b0827055dc",
                        "glosses": [
                            "Not purple, not having purple as its color."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "64aaaf67-d09e-4628-a1ff-e11d43c4f549",
                                "sense_id": "d7a439c5-b58e-3527-a9ae-a1f9ba270088",
                                "text": "Befuddled, Edell looked to see other Keshiri dancing onto the streets, dressed in black with their faces painted in a variety of unpurple hues."
                            },
                            {
                                "example_id": "fae6829b-1cc7-43ec-b518-dea8918d4d34",
                                "sense_id": "d7a439c5-b58e-3527-a9ae-a1f9ba270088",
                                "text": "He used his unpurple arm to pull his purple arm around my shoulder."
                            }
                        ]
                    },
                    {
                        "sense_id": "155e5bac-b134-37e7-a944-48dd80474802",
                        "entry_id": "57a72a52-3f81-36f8-8923-93b0827055dc",
                        "glosses": [
                            "Not ornate; not being purple prose or poetry."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3b52df84-2c82-4279-915c-c42a9836cd2b",
                                "sense_id": "155e5bac-b134-37e7-a944-48dd80474802",
                                "text": "Thus, in his most recent report to the President, Charles E. Wilson (whose prose is probably quite unpurple when left alone) manages in the first two sentences to allude to \"America's military might,\" \"a mighty America,\" […]"
                            },
                            {
                                "example_id": "3941fb25-2903-4095-a587-cb59a2102bf6",
                                "sense_id": "155e5bac-b134-37e7-a944-48dd80474802",
                                "text": "Subsequently Cooper became press agent for the Tammen-Bonfils circus and acquired the sawdust lore which he utilized effectively in a lean, hard-hitting, entirely unpurple style for many of his popular magazine stories."
                            },
                            {
                                "example_id": "41856485-50d2-4f20-b74e-b8971a7ea504",
                                "sense_id": "155e5bac-b134-37e7-a944-48dd80474802",
                                "text": "[…] is as unpurple prose as can be found anywhere."
                            }
                        ]
                    }
                ],
