                                "target_lang_word": "tight-knit",
                                "target_lang_sense_clarification": "referring to a closely integrated group or collaboration"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57303e08-9d94-3604-afeb-235c87ca380d",
                    "sense_definition": "behorend tot het innerlijk of de binnenkant",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "innerlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij sprak haar <w>innige</w> overtuiging uit dat alles uiteindelijk goed zou komen.",
                            "target_lang_translations": {
                                "en": "She expressed her <w>profound</w> conviction that everything would turn out well in the end."
                            }
                        },
                        {
                            "text": "Zijn <w>innige</w> wens was om ooit nog eens terug te keren naar zijn geboorteland.",
                            "target_lang_translations": {
                                "en": "His <w>innermost</w> wish was to return to his native country one day."
                            }
                        }
                    ],
                    "synonyms": [
