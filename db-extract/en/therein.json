                        "sense_id": "26396419-adc7-3126-bd65-44e9110a3a32",
                        "entry_id": "44f309e5-69f5-3143-bcfc-e4395c067444",
                        "glosses": [
                            "in that; in that place; in him/her/it."
                        ],
                        "tags": [
