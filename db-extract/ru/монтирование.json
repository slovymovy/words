                                        "examples": [
                                            {
                                                "example_id": "7d85a443-94d7-4be0-9879-1491746690be",
                                                "sense_id": "ddf43e2d-141d-388a-9f00-a2e51cd572e3",
                                                "text": "The Empire State Building was once the world's tallest erection."
                                            },
                                            {
                                                "example_id": "17a354fb-85be-4035-a33d-e5c290875843",
                                                "sense_id": "ddf43e2d-141d-388a-9f00-a2e51cd572e3",
                                                "text": "If any serious number of deck erections have been left unfaired, these percentages will be too low."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ffa406e-5d12-3ded-aaa6-59eee0e42d66",
                                        "entry_id": "2b0d8f1b-65bb-3466-876d-e9f00092f3db",
                                        "glosses": [
                                            "Formal approval and official establishment of an institution such as a society or a monastery by higher church authorities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e17269-3e89-4d8e-a265-f81ac63f00fa",
                                                "sense_id": "3ffa406e-5d12-3ded-aaa6-59eee0e42d66",
                                                "text": "There is some obscurity attaching to the only other one of those alleged erections of parishes, the case of Foot Dee, near Aberdeen."
                                            },
                                            {
                                                "example_id": "44815e9d-d91f-42e2-b4f2-e1a71016ec77",
                                                "sense_id": "3ffa406e-5d12-3ded-aaa6-59eee0e42d66",
                                                "text": "If the erection of a society is made with pontifical authority, then the society is one of pontifical legal status from its inception."
                                            },
                                            {
                                                "example_id": "1e353c3f-6095-4f0a-82ce-98a51be85f3b",
                                                "sense_id": "3ffa406e-5d12-3ded-aaa6-59eee0e42d66",
                                                "text": "Concerns for its usefulness to the particular church and the institute should be seriously considered by the diocesan bishop and the major superior before the canonical erection of a house takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f65de27-6a15-3103-82a1-077d94818348",
                                        "entry_id": "2b0d8f1b-65bb-3466-876d-e9f00092f3db",
                                        "glosses": [
                                            "The physiological process by which erectile tissue, such as a penis or clitoris, becomes erect by being engorged with blood."
