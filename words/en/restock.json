{
    "word_family": [
        "stock",
        "stocker",
        "overstock",
        "understock"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "351dd00d-1382-36f8-a93b-e86cba9377e2",
                    "sense_definition": "To stock something again, especially by replenishing a supply of goods.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "replenish_stock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store employees worked overnight to <w>restock</w> the shelves before the morning rush.",
                            "target_lang_translations": {
                                "zh": "店员们通宵工作，在早高峰前给货架<w>补货</w>。"
                            }
                        },
                        {
                            "text": "We need to <w>restock</w> our refrigerator because we ran out of milk and eggs.",
                            "target_lang_translations": {
                                "zh": "我们的牛奶和鸡蛋吃完了，需要给冰箱<w>补充</w>点吃的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "replenish",
                        "resupply"
                    ],
                    "antonyms": [
                        "deplete"
                    ],
                    "common_phrases": [
                        "restock shelves",
                        "restock the inventory"
                    ],
                    "target_lang_definitions": {
                        "zh": "重新备货，补充（商品、物资等）的存货"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "补货",
                                "target_lang_sense_clarification": "最常用，指补充货物或存量"
                            },
                            {
                                "target_lang_word": "重新进货",
                                "target_lang_sense_clarification": "商业采购中指再次采购备货"
                            },
                            {
                                "target_lang_word": "补充",
                                "target_lang_sense_clarification": "指补充生活用品或存粮等"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5707c62-e788-3cac-9fdc-b84aeacf37a2",
                    "sense_definition": "The act or process of stocking again.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "replenish_stock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will carry out a <w>restock</w> of the vending machine every Friday.",
                            "target_lang_translations": {
                                "zh": "我们每周五都会对自动售货机进行一次<w>补货</w>。"
                            }
                        },
                        {
                            "text": "The warehouse manager scheduled a complete <w>restock</w> after the busy holiday season.",
                            "target_lang_translations": {
                                "zh": "在忙碌的假日季过后，仓库经理安排了一次全面的<w>补货</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "replenishment",
                        "resupply"
                    ],
                    "antonyms": [
                        "depletion"
                    ],
                    "common_phrases": [
                        "awaiting restock",
                        "complete restock"
                    ],
                    "target_lang_definitions": {
                        "zh": "补货，重新进货的行为或过程"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "补货",
                                "target_lang_sense_clarification": "指补充存货的行动"
                            },
                            {
                                "target_lang_word": "重新进货",
                                "target_lang_sense_clarification": "商业上的再次进货行动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}