                "senses": [
                    {
                        "sense_id": "f78de6a5-2bae-3bf2-80e2-e36c5d9bd27e",
                        "entry_id": "1265d2d6-9a34-340a-b86d-2eb62e48a0b4",
                        "glosses": [
                            "forma żeńska od: adiutant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a5b1c3-92e8-49aa-ad35-9e7895bd6eff",
                                "sense_id": "f78de6a5-2bae-3bf2-80e2-e36c5d9bd27e",
                                "text": "Kobiety uczestniczyły w powstaniu styczniowym, pełniąc funkcje łączniczek, zwiadowczyń, kurierek, adiutantek, sanitariuszek."
                            },
                            {
                                "example_id": "e3a05894-84ea-42a1-a3a4-bc330ebbf368",
                                "sense_id": "f78de6a5-2bae-3bf2-80e2-e36c5d9bd27e",
                                "text": "Nawet siostry Stelli, które zawsze okazywały jej prawdziwą sympatię, teraz, widocznie zrażone zepchnięciem ich w półfinale do roli adiutantek Magdy, uśmiechały się do niej z przymusem i nieszczerze"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
