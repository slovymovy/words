                        "glosses": [
                            "Assimiler par anabolisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffbfa52d-f418-486f-a107-d51757f7b9c2",
                                "sense_id": "1fd67fe8-1b87-3db1-8efd-84f9019338ef",
                                "text": "Rappelons que la poule peut pondre son propre poids d’œufs en 5 à 6 semaines seulement, et que si on évalue à 55 g environ le poids moyen d'un œuf, on s'aperçoit que l'animal doit anaboliser presque quotidiennement 5 g de calcaire pour la coquille, 31 g d'albumen et 18 g de jaune, soit encore 7 g de protéines, 6 g de lipides et 0,5 g de glucides."
                            }
                        ]
