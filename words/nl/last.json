                        "pl": [
                            {
                                "target_lang_word": "spawa",
                                "target_lang_sense_clarification": "forma czasownika „spawać” w 3. os. lp. lub 2. os. lp."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e5e0d5-51e5-3888-ad9a-d1b6d14d3be7",
