                                                "example_id": "3e445257-411d-4368-8c15-c40ff22de49b",
                                                "sense_id": "a55ca503-d4d5-3b91-af23-c75cf4c761cd",
                                                "text": "Cet homme a été grêlé."
                                            }
                                        ]
                                    },
