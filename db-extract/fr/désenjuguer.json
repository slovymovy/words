                "senses": [
                    {
                        "sense_id": "f2ac69d2-c716-3fbc-8e6b-6e5a3a949cc2",
                        "entry_id": "45ed8f40-350e-3750-bce4-f391837010d7",
                        "glosses": [
                            "Libérer du joug."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82197faf-dad2-4fd6-bd26-03085a10fe65",
                                "sense_id": "f2ac69d2-c716-3fbc-8e6b-6e5a3a949cc2",
                                "text": "Surtout, on ne peut les changer de côté, les contrarier, les désenjuguer, car alors ils tirent de travers et sont incapables de travailler."
                            },
                            {
                                "example_id": "9cbf2718-a4bd-4544-b1eb-8007cefc395f",
                                "sense_id": "f2ac69d2-c716-3fbc-8e6b-6e5a3a949cc2",
                                "text": "Des bœufs désenjugués"
                            },
                            {
                                "example_id": "33fe8848-d846-4fb4-b95d-e53aa69393bc",
                                "sense_id": "f2ac69d2-c716-3fbc-8e6b-6e5a3a949cc2",
                                "text": "Aujourd’hui, il serait plus juste de dire, que personne ne pèse autant sur l’écrivain qui cherche à se désenjuguer, que cette infâme inquisition qui se redéploie depuis les Yalta et \" Yallah ! \" du partage du monde, où l’on cherche à institutionnaliser la paranoïa des prédateurs de la planète et la persécutite de leurs rémoras qui ont la dent interminable."
                            }
                        ]
                    }
