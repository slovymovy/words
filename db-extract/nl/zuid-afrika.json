                                        "glosses": [
                                            "Staat an der Südspitze Afrikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2392f9f3-8cbf-4b4b-a5dd-18acabfab93c",
                                                "sense_id": "ca7a505e-e591-35ba-b28b-217d51b294b1",
                                                "text": "„Südafrika beheimatet mehr als 20.000 verschiedene Pflanzen, etwa 10 Prozent aller bekannten Pflanzenarten der Welt.“"
                                            },
                                            {
                                                "example_id": "ab0b9031-da37-4cb1-8479-2f764f2edf8a",
                                                "sense_id": "ca7a505e-e591-35ba-b28b-217d51b294b1",
                                                "text": "Pretoria ist die Hauptstadt von Südafrika."
                                            },
                                            {
                                                "example_id": "162758ee-17b1-43f7-a904-772b0f764843",
                                                "sense_id": "ca7a505e-e591-35ba-b28b-217d51b294b1",
                                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e18e8f2d-f768-3d90-9768-7c1ac86c6128",
                                        "entry_id": "5d11dd1d-e21d-3cb1-98e4-7fba2f0c853f",
                                        "glosses": [
                                            "Bezeichnung für den südlichen Teil des afrikanischen Kontinents"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
