                "senses": [
                    {
                        "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                        "entry_id": "4c22bd0b-dfdd-37fb-bab7-6aaea0ad655e",
                        "glosses": [
                            "Halle eines Hotels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8404cd13-80b2-42cd-acb9-848cec4d3d5f",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "Vanessa fand die Sitzgelegenheiten in der Hotelhalle sehr bequem."
                            },
                            {
                                "example_id": "98b06e9b-671d-40d4-b657-a14f92a2129d",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "„Die Hotelhalle war gerade über mir, und das Fenster stand offen.“"
                            },
                            {
                                "example_id": "a6c9b63a-cc36-42d9-9722-0a47e9bcdbfe",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "„Sie hatte in der Hotelhalle gestanden, die keine Halle war, sondern nur ein Empfangsraum mit einer dunkelbraunen geprägten Tapete, die aussah, als sei sie aus Leder.“"
                            },
                            {
                                "example_id": "e7020db6-6c21-4e9a-bcf6-dd6dcbab105c",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "„In der Hotelhalle küssten Pam und Barbara Rudi mehrmals auf die Wange und wünschten eine gute Nacht.“"
                            },
                            {
                                "example_id": "98e95bc9-ef89-43cc-8bc6-1a1f79ee29a8",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "„Er legte das Blatt auf den Zeitungstisch der Hotelhalle und zog sich in sein Zimmer zurück.“"
                            },
                            {
                                "example_id": "7f795ec1-ccaa-400d-b520-4da1d775734c",
                                "sense_id": "b8762ef7-e09b-34ff-8a4c-68adb6af36c7",
                                "text": "„Die Polizisten drängen sich vor der verschlossenen Tür von 8G, und Marla und Tyler eilen hinunter in die Hotelhalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
