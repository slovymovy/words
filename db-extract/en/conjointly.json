                                "sense_id": "b0aaefb8-b492-3ec7-ad8f-643586e00a15",
                                "text": "Elytra a little longer than wide conjointly, finely striate, intervals with a row of moderately coarse elongate punctures each bearing a semierect hair, surface subgranularly alutaceous."
                            },
                            {
                                "example_id": "c9b55dda-86fd-4c9e-96e7-37441743fba7",
                                "sense_id": "b0aaefb8-b492-3ec7-ad8f-643586e00a15",
                                "text": "The folkland, the national fund, was administered and conveyed conjointly by the king and the witan."
                            }
                        ]
                    }
