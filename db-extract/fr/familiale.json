                    {
                        "sense_id": "6cf46230-6092-3f92-85eb-43a00b4397b4",
                        "entry_id": "840c43b2-521c-3566-9844-046a30cc935f",
                        "glosses": [
                            "Voiture familiale."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "c89c434f-a358-4a9c-af38-d8c47cac0b6d",
                                "sense_id": "6cf46230-6092-3f92-85eb-43a00b4397b4",
                                "text": "Beaucoup de véhicules, citadines et familiales, compactes, berlines, breaks ou SUV, devront s'acquitter du tarif standard de 30 euros par mois."
                            },
                            {
                                "example_id": "95bf16c4-b95b-4ec7-8a09-56e620e35a41",
                                "sense_id": "6cf46230-6092-3f92-85eb-43a00b4397b4",
                                "text": "Les Compactes, les Familiales et les Routières sont progressivement remplacées par des SUV (jusqu’à 40 % de SUV parmi les VT immatriculés en 2022)."
                            }
                        ]
                    },
                    {
                        "sense_id": "287d5283-00e8-3bd8-b585-5cc5bc81ee22",
                        "entry_id": "840c43b2-521c-3566-9844-046a30cc935f",
                        "glosses": [
                            "Bombe de gaz lacrymogène grand format."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7976ddec-2330-428e-bee5-bcaa49c378aa",
                                "sense_id": "287d5283-00e8-3bd8-b585-5cc5bc81ee22",
                                "text": "Quand le SO parle d’une familiale, ce n’est pas d'une Kangoo dont il est question, mais d’une bombe de gaz lacrymogène de grand format, idéale pour gazer La Manif pour tous. La familiale, est, dans les faits, un piège un con, car le camarde chargé de l’utiliser en vaporise à tout va, sur les adversaires comme sur les camardes."
                            }
                        ]
                    }
