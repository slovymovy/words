                        "glosses": [
                            "Personne ayant un besoin maladif de boire des boissons toxiques (en particulier de l’alcool) lors de crises intermittentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8964596-63c4-4bf9-ab1e-edb9e4c02cb6",
                                "sense_id": "f949e8f4-3389-3935-ba19-d2aee721a319",
                                "text": "Le dipsomane, lorsqu’il se sent abattu, triste, irritable et sans appétit, sait souvent qu’il va boire beaucoup trop, et peut en prévenir son entourage."
                            },
                            {
                                "example_id": "495d07fa-815b-4fd2-a5f0-d997abb3a5a3",
                                "sense_id": "f949e8f4-3389-3935-ba19-d2aee721a319",
                                "text": "Les dipsomanes ajouteront encore au dernier moment une dose de cognac."
                            }
                        ]
