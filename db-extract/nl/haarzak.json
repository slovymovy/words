                "senses": [
                    {
                        "sense_id": "18463c08-8915-380a-9bad-522952277f3a",
                        "entry_id": "ec583a7f-ad98-3201-ade2-432df0ed5f96",
                        "glosses": [
                            "kleine flesvormige holte in de huid met de wortel van een haar\\nIn deze betekenis wordt vaak het verkleinwoord \\\"haarzakje\\\" gebruikt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afde8a5-9f07-4df6-81d6-ad5f54a4e4c9",
                                "sense_id": "18463c08-8915-380a-9bad-522952277f3a",
                                "text": "Een folliculitis is een ontsteking van de haarzakjes."
                            },
                            {
                                "example_id": "a0f5ff1e-ef34-4632-b942-42d05079a555",
                                "sense_id": "18463c08-8915-380a-9bad-522952277f3a",
                                "text": "Bij het proces dat elektrolyse wordt genoemd wordt een kleine elektrische stoom opgewekt, die een chemische reactie opwekt die het haarzakje vernietigd [sic!]. (…) Wel kunnen hiermee ook haren met een anders gevormde haarzak worden behandeld."
                            }
                        ]
                    },
                    {
                        "sense_id": "39ddd89b-0560-33fa-9ca9-237c62670b1a",
                        "entry_id": "ec583a7f-ad98-3201-ade2-432df0ed5f96",
                        "glosses": [
                            "net of buidel die voorkomt dat hoofdhaar in de weg hangt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1f77947-e56a-4e3f-9ccf-f4c893d50823",
                                "sense_id": "39ddd89b-0560-33fa-9ca9-237c62670b1a",
                                "text": "Een chirurg moet tijdens het opereren een haarzak dragen."
                            },
                            {
                                "example_id": "4327a6f4-5985-41f9-8db6-fd2e0dd54dc5",
                                "sense_id": "39ddd89b-0560-33fa-9ca9-237c62670b1a",
                                "text": "Rond 1820 volgen politieagenten in Utrecht bepaald niet de laatste mode. Het hoofd der politie draagt een groen jasje, een klein hoedje en een enorme haarzak met grote strik."
                            }
                        ]
                    },
                    {
                        "sense_id": "09566a44-0220-32f5-a037-e073e13a5da4",
                        "entry_id": "ec583a7f-ad98-3201-ade2-432df0ed5f96",
                        "glosses": [
                            "iemand die graag ruzie maakt of hebberig is"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "214fb789-ff36-486f-8c9a-97a3f24bf4ff",
                                "sense_id": "09566a44-0220-32f5-a037-e073e13a5da4",
                                "text": "⧖ Hij vond daar ook Thomas, een' goê kennis van hem, een eersten guit en onverbeterlijken haarzak. Luistert, en gij zult vernemen of die Thomas ooit één goê streek uit zijn koker gehaald heeft."
                            }
                        ]
                    }
