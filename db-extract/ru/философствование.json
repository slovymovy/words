                "senses": [
                    {
                        "sense_id": "02476193-fe12-3090-98be-33db7aa8a395",
                        "entry_id": "3316cfb9-38ab-30df-9691-6670bc776754",
                        "glosses": [
                            "philosophizing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfa9f62c-6863-4691-83f4-c88a350df82b",
                                "sense_id": "02476193-fe12-3090-98be-33db7aa8a395",
                                "text": "Удово́льствие Рыжо́ва состоя́ло в исполне́нии своего́ до́лга, а вы́сший духо́вный комфо́рт — филосо́фствование о вы́сших вопро́сах ми́ра духо́вного и об отраже́нии зако́нов того́ ми́ра в явле́ниях и в су́дьбах отде́льных люде́й и це́лых царств и наро́дов.",
                                "translation": "Ryzhov’s pleasure consisted in fulfilling his duty, and his highest spiritual comfort in philosophizing about the highest questions of the spiritual world and about the reflection of the laws of that world in phenomena and in the destinies of particular persons and of entire kingdoms and peoples.",
                                "english": "Ryzhov’s pleasure consisted in fulfilling his duty, and his highest spiritual comfort in philosophizing about the highest questions of the spiritual world and about the reflection of the laws of that world in phenomena and in the destinies of particular persons and of entire kingdoms and peoples."
                            }
                        ]
                    }
                ],
