                    }
                ],
                "translations": [
                    {
                        "translation_id": "be6b6373-0014-44c0-bfbf-269b787149d6",
                        "source_entry_id": "7d1c8e56-ae48-39c0-92d2-9cf4db4cdab2",
                        "source_sense_id": "6f9dcd81-fbb3-3b43-8a43-c88b2d5923ce",
                        "target_lang_word": "fondeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30d34e86-519a-394b-912e-3a1e3471ad6a",
                                        "entry_id": "67d38851-5eba-3e40-b707-5fdb436cbeea",
                                        "glosses": [
                                            "Personne qui dirige une fonderie."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d2c1cde-a42a-481e-9d93-daa4c9c9590f",
                                                "sense_id": "30d34e86-519a-394b-912e-3a1e3471ad6a",
                                                "text": "Aussi les Mores portent toujours des balances , & rebutent les pièces qui ne sont pas de poids: il faut les remettre à la fonte , ce qui produit des sommes considérables aux Juifs, qui sont les seuls monnoyeurs & fondeurs de ce Pays."
                                            },
                                            {
                                                "example_id": "2280f638-4416-4226-9549-2e202192a732",
                                                "sense_id": "30d34e86-519a-394b-912e-3a1e3471ad6a",
                                                "text": "Nous avons fait usage du fourneau ordinaire de fondeurs, avec cette différence que ce fourneau étoit recouvert d'un dôme en terre cuite pour concentrer la chaleur."
                                            },
                                            {
                                                "example_id": "ce128949-3360-4172-ba68-459e754096e5",
                                                "sense_id": "30d34e86-519a-394b-912e-3a1e3471ad6a",
                                                "text": "Il y a lieu de remarquer que le coke lavé peut, pour certaines provenances, apporter dans le haut-fourneau ou dans le cubilot des fondeurs, plus de soufre et de phosphore que la des cokes même très cendreux , des cokeries minières françaises."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aa7ead5-b899-3ab9-99c9-0e6b9e9e4f58",
                                        "entry_id": "67d38851-5eba-3e40-b707-5fdb436cbeea",
                                        "glosses": [
                                            "Ouvrier ou artisan qui fond les canons, les cloches, les statues de bronze, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7478dc50-8afd-4ac7-8f9d-90992ce0b5a3",
                                                "sense_id": "3aa7ead5-b899-3ab9-99c9-0e6b9e9e4f58",
                                                "text": "Il existait dans la collégiale de Huy plusieurs ouvrages de dinanderie ; si les fondeurs sont restés inconnus, nous possédons au moins quelques renseignements sur leurs travaux à l'époque où ceux—ci ont été affectés à l'église."
                                            },
                                            {
                                                "example_id": "17b17af4-7818-4f00-ba52-f94847303c85",
                                                "sense_id": "3aa7ead5-b899-3ab9-99c9-0e6b9e9e4f58",
                                                "text": "Les « maisons-ateliers » du quartier Mu seraient celles d’un fondeur, d’un graveur de sceaux et d’un potier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62ddc9c-966f-3e30-8fb8-1878026950e2",
                                        "entry_id": "67d38851-5eba-3e40-b707-5fdb436cbeea",
                                        "glosses": [
                                            "Sportif qui pratique le ski de fond ou la course de fond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d71a1e-85f5-407e-824b-1d29ea0c5b69",
                                                "sense_id": "a62ddc9c-966f-3e30-8fb8-1878026950e2",
                                                "text": "L'hiver, qui frappe au portillon, éveille des envies de ski. […]. On parle là des godilleurs ou des fondeurs du dimanche, mais pas seulement."
                                            },
                                            {
                                                "example_id": "e6d607d6-078d-4678-8b6f-261a25837712",
                                                "sense_id": "a62ddc9c-966f-3e30-8fb8-1878026950e2",
                                                "text": "Les fondeurs québécois ont brillé de tous leurs feux à la Coupe du monde de ski de fond de Ruka qui s’est conclue dimanche, en Finlande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f538f0b-c845-33c4-bda9-756824a383f7",
                                        "entry_id": "67d38851-5eba-3e40-b707-5fdb436cbeea",
                                        "glosses": [
                                            "Société fabricant des puces électroniques, comme des microprocesseurs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
