                        ],
                        "form": "acrimonieuse"
                    },
                    {
                        "form_id": "eccd8331-ec36-41ec-a1e6-5a7b88ccd327",
                        "entry_id": "62f8c8d1-696c-3385-a778-4a7f6062580f",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "acrimonieuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                        "entry_id": "62f8c8d1-696c-3385-a778-4a7f6062580f",
                        "glosses": [
                            "Qui a de l’acrimonie, de l’aigreur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3b6bbce-c34a-4711-bdbd-2d8fb878a8ab",
                                "sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                                "text": "Il appartient à un genre d’hommes qui ont la mémoire des chiffres, qui mettent la main sur leur cœur quand ils mentent et qui ont soif l’après-midi, ce qui est un signe de mauvais estomac et de caractère acrimonieux."
                            },
                            {
                                "example_id": "fdb45868-37b7-4db4-bf34-5b234ed3ef42",
                                "sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                                "text": "[…] alors que des passages improvisés de cette allocution prennent un ton acrimonieux et que bien d’autres interventions confirment un solide ressentiment."
                            },
                            {
                                "example_id": "2749530d-5bd4-466f-aba5-dc3e5975c04f",
                                "sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                                "text": "Ce que ne montre pas la sculpture c’est la relation acrimonieuse entre les deux hommes : Tycho le Danois riche, dodu, arrogant avec ses vêtements extravagants et son nez métallique ; Kepler l’Allemand pusillanime, renfermé, mystique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3557821-1ad9-419c-bfde-2932aa8fad99",
                        "source_entry_id": "62f8c8d1-696c-3385-a778-4a7f6062580f",
                        "source_sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                        "target_lang_word": "ungehalten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungehalten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                        "entry_id": "1c8b3701-0023-3254-aaea-8d0f0f6a119a",
                                        "glosses": [
                                            "seinem Unwillen nachgebend; wütend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f015de-177b-43b8-a294-1f84aa0be086",
                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "Der Mann war sehr ungehalten bezüglich der Verhaltensweise des Verkäufers und hat ihm das entsprechend zum Ausdruck gebracht."
                                            },
                                            {
                                                "example_id": "86472ef4-ea89-41e9-90e6-d943bfc98860",
                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "„Wenn es eine offizielle Liste gäbe, wer auf Call-Center- Anrufe am ungehaltensten reagiert, dann stünde Sachsen-Anhalt auf Platz 2 und schlecht gelaunte Berliner wären auf Platz 1.“"
                                            },
                                            {
                                                "example_id": "dd990be0-38d6-4ace-a80f-d937ab30d572",
                                                "sense_id": "01e653f9-5ed7-3a24-a084-f48b36131e19",
                                                "text": "„Der Berufungswerber wurde von Major K auf dieses ungewöhnliche Anhaltemanöver angesprochen und der Berufungswerber war über die Anhaltung sichtlich nicht erfreut und eher ungehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                        "entry_id": "1c8b3701-0023-3254-aaea-8d0f0f6a119a",
                                        "glosses": [
                                            "nicht gehalten, nicht vorgetragen"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b0a4dd7-46df-481a-b2ae-a2b1b1de0857",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Allerdings hatte er im Moment andere Sorgen, schließlich musste er seine ungehaltene Rede geistig gerade noch einmal umschreiben.“"
                                            },
                                            {
                                                "example_id": "bdcfb979-7540-4b11-8ba1-82c3ce4ac03e",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Silke Göttsch hat sein ungehaltenes Referat gemeinsam mit Candy Sauer hier ediert […].“"
                                            },
                                            {
                                                "example_id": "073458e3-0c12-4312-a07d-f3eeb4858363",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Prompt kehrte er wieder um, die ZEIT druckte seine «ungehaltene Rede». Ein kleines, stolzes Vermächtnis hatte Schmidt vortragen wollen, konstruktiv, pädagogisch, aber nicht ohne Spitzen.“"
                                            },
                                            {
                                                "example_id": "ddf57906-9a78-497a-9272-48af4a27c37d",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Papst Benedikt XVI. hatte in seiner aufgrund der Proteste einer Gruppe von Professoren nicht gehaltenen, keineswegs aber ungehaltenen Rede zur Eröffnung des akademischen Jahres an der römischen Universität »Sapienza« (Januar 2008) keine Gelegenheit zu sagen, was er wollte […].“"
                                            },
                                            {
                                                "example_id": "ef732640-4304-412b-966b-57ed7018a854",
                                                "sense_id": "bb4572df-f1a2-34a6-a375-bce464c96439",
                                                "text": "„Den Inhalt Ihrer ungehaltenen Rede dürfen Sie jetzt nicht vortragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df20e4b1-3718-4681-9e55-2257d5ffdd26",
                        "source_entry_id": "62f8c8d1-696c-3385-a778-4a7f6062580f",
                        "source_sense_id": "218d5b4c-ee11-3e74-8104-81f3d79c93d9",
                        "target_lang_word": "acrimonious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrimonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5c8327f-d5ee-3e63-9001-f88446ae4ee8",
                                        "entry_id": "1320af40-db25-3c1c-a05b-57958ac21669",
                                        "glosses": [
                                            "Harsh and sharp, or bitter and not pleasant to the taste; acrid, pungent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8af7c03b-3664-44fd-a82c-2868f361aa7d",
                                                "sense_id": "b5c8327f-d5ee-3e63-9001-f88446ae4ee8",
                                                "text": "The old man […] began to suffer in the body as well as the mind. He had formed the determination of setting out in person for Dumfriesshire, when, after having been dogged, peevish, and snappish to his clerks and domestics, to an unusual and almost intolerable degree, the acrimonious humours settled in a hissing-hot fit of the gout, which is a well-known tamer of the most froward spirits, […]"
                                            },
                                            {
                                                "example_id": "b640be3c-7dfa-45cb-9675-e232a1009260",
                                                "sense_id": "b5c8327f-d5ee-3e63-9001-f88446ae4ee8",
                                                "text": "[I]t is sufficiently evident from the physiology of man, that boils and eruptions cannot be produced in perfectly healthy persons through the action of water, since water is a matter the most conceivably mild, and since boils produce a feeling always painful, and more or less acrimonious and corrosive, which can only be caused by acrid corrosive matters, or by biting animalculae which form the boil."
                                            },
                                            {
                                                "example_id": "2225c02d-ed36-4c90-b73a-e55156a82640",
                                                "sense_id": "b5c8327f-d5ee-3e63-9001-f88446ae4ee8",
                                                "text": "Sanguinarina, as procured from the sulphate, is a yellowish gray powder without odor, and almost without taste. A slight acrimonious impression is developed after a time upon the tongue from the partial solubility of the alkaloid in saliva."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                        "entry_id": "1320af40-db25-3c1c-a05b-57958ac21669",
                                        "glosses": [
                                            "Angry, acid, and sharp in delivering argumentative replies: bitter, mean-spirited, sharp in language or tone."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33de7f50-e2da-4a5e-a8f7-0a9f9942a44d",
                                                "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                                "text": "Theſe points are diſcuſſed with the ability and learning which diſtinguiſh the Right Reverend Author's [Samuel Horsley's] publications, but not without acrimonious expreſſions of contempt and indignation againſt his opponent [Joseph Priestley]."
                                            },
                                            {
                                                "example_id": "7157e33c-c4c5-4f13-b286-4a56cc5fb8e1",
                                                "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                                "text": "Lord Aberdeen is indignant that he is described as the tool of Russia, and to prove his independence, vows that he has, when Secretary of State, written very \"acrimonious\" despatches against that Power. Secretaries of State ought never to write \"acrimonious\" despatches. […] If the letters of Lord Aberdeen to the \"foreign conspirators,\" who are his correspondents at Paris and elsewhere, had been a little more acrimonious as regards Russia, affairs might have been better, […]"
                                            },
                                            {
                                                "example_id": "320d63a3-81aa-450e-850c-3aa0f8fdce14",
                                                "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                                "text": "Let us impress upon those members of the Council who were so vehemently acrimonious in their denunciation of the licentiousness of the Vernacular Press, almost to the verge of betraying the least little soupcon of personal feeling, that we are not pleading, in the noble words of one of the greatest of Englishmen, 'for the introduction of licence, but we only oppose licensing.'"
                                            },
                                            {
                                                "example_id": "34f0e178-c742-4a04-b236-99acd6a83b86",
                                                "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                                "text": "That would be a way more acrimonious custody battle than the one my parents had over me."
                                            },
                                            {
                                                "example_id": "5f8ac843-8d37-42c5-aa87-c14d353bed15",
                                                "sense_id": "5261fde5-9257-3996-9fce-9e6128794270",
                                                "text": "A forensic lip-reader has examined the CCTV and, according to her transcript, the conversation between you appears acrimonious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
