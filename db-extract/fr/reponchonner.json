                "senses": [
                    {
                        "sense_id": "f99b0ff9-bdc0-3e6e-9209-8029296c09e0",
                        "entry_id": "6b433ea4-6793-3b24-ae8c-faf608dc71cc",
                        "glosses": [
                            "Remettre de la teinture dans un bain épuisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6eb0bea-f471-4b7f-b65f-1fc3e8665a3d",
                                "sense_id": "f99b0ff9-bdc0-3e6e-9209-8029296c09e0",
                                "text": "Lorsque le renouvellement du bain est nécessaire, on enlève les soies, on les met sur un baillard, on incline la barque, on jette environ la moitié du bain et l'on reponchonne, en termes de teinturier , c'est-à-dire qu'on remet dans la barque autant de bain qu'on en a ôté du premier,…"
                            },
                            {
                                "example_id": "8e2fe442-c792-4b20-888c-e68d84bd916b",
                                "sense_id": "f99b0ff9-bdc0-3e6e-9209-8029296c09e0",
                                "text": "Le bain doit être saturé à froid et reponchonné de temps en temps avec une solution bouillante et concentrée d'alun."
                            },
                            {
                                "example_id": "d14f10d8-c287-4b71-843d-cb24e59bbae1",
                                "sense_id": "f99b0ff9-bdc0-3e6e-9209-8029296c09e0",
                                "text": "Sites cotons sont secs, on reponchonne avec 1 litre de bain pour chaque kilogramme de coton passé. S'ils sont simplement essorés, on reponchonne avec 1/2 litre de bain préparé avec concentration double."
                            }
                        ]
                    }
                ],
