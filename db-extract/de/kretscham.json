                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "70a65554-d05a-4246-8026-1118a3a72b89",
                                "sense_id": "862ac5d5-5cdc-3f35-a7b0-aa2d97021da4",
                                "text": "Wir gehen in den Kretscham ein Bier trinken."
                            },
                            {
                                "example_id": "cee20cb4-516b-41f7-a068-3118a00873dd",
                                "sense_id": "862ac5d5-5cdc-3f35-a7b0-aa2d97021da4",
                                "text": "„Die Häuschen und Gehöfte gruppieren sich um eine Asphaltstraße, die sich hinter dem Dorfteich gabelt: ein ehemaliges Gutsdorf mit Försterei ohne eigene Kirche und Kretscham.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
