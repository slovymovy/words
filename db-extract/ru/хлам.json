                "senses": [
                    {
                        "sense_id": "7895129b-9856-3673-8482-718f245ea5f7",
                        "entry_id": "cea01712-0939-37a3-b3dc-682186723295",
                        "glosses": [
                            "собир. негодные, ломаные, старые вещи"
                        ],
                        "tags": [
                            "мн. нет"
                        ],
                        "examples": [
                            {
                                "example_id": "fd85ab36-f932-4745-9816-3e9f49979dbc",
                                "sense_id": "7895129b-9856-3673-8482-718f245ea5f7",
                                "text": "Убрать хлам."
                            },
                            {
                                "example_id": "3140e6d4-d707-4895-89c9-70818f620ca4",
                                "sense_id": "7895129b-9856-3673-8482-718f245ea5f7",
                                "text": "В углу навалены были драницы, вёдра и всякий хлам."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6944047-9b68-3d37-bfa8-9d480921a6c4",
                        "entry_id": "cea01712-0939-37a3-b3dc-682186723295",
                        "glosses": [
                            "собир., разг., пренебр. недоброкачественный товар"
                        ],
                        "tags": [
                            "мн. нет"
                        ],
                        "examples": [
                            {
                                "example_id": "7db0653e-c57c-4940-9657-519e595fa838",
                                "sense_id": "f6944047-9b68-3d37-bfa8-9d480921a6c4",
                                "text": "Торговать хламом."
                            }
                        ]
                    },
                    {
                        "sense_id": "9672e1fc-229b-3460-a64f-137c16e48df5",
                        "entry_id": "cea01712-0939-37a3-b3dc-682186723295",
                        "glosses": [
                            "собир., перен., разг., пренебр. о ком-чём-нибудь ненужном, не имеющем никакой ценности, бесполезном, вредном"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc84cd4-c0aa-4793-a3eb-1fed6e634560",
                                "sense_id": "9672e1fc-229b-3460-a64f-137c16e48df5",
                                "text": "Кажется бы, довольно и двух великих ям с великими хламами? Ведь живые народы, которые ушли от этих развалин, не идут к ним обратно и не мечтают о реставрировании великого исторического мусора?"
                            }
                        ]
                    }
