                {
                    "sense_id": "3b576241-6b24-3f5a-b984-14a0a7ff3d09",
                    "sense_definition": "The propeller of an aircraft or boat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "propeller_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot noticed a small crack in the left <w>prop</w> during his pre-flight inspection.",
                            "target_lang_translations": {
                                "ru": "Во время предполетного осмотра пилот заметил небольшую трещину на левом <w>винте</w>."
