                "senses": [
                    {
                        "sense_id": "8b81a7c5-591e-35d2-a4c1-05f57422ead0",
                        "entry_id": "b51d71c9-544c-3a12-acdc-ddc226b2fb22",
                        "glosses": [
                            "Verbindung mit Selen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7af435ea-b7ba-4e09-a2ac-8b307259e3df",
                                "sense_id": "8b81a7c5-591e-35d2-a4c1-05f57422ead0",
                                "text": "„Um als Donoren für Selenoproteine genutzt werden zu können, muss Selen aus allen Vorstufen in Selenid umgewandelt werden, was nicht für jede Selenverbindung möglich ist.“"
                            },
                            {
                                "example_id": "cb1551fd-a7c3-4d2b-ad5d-363aca8d1a90",
                                "sense_id": "8b81a7c5-591e-35d2-a4c1-05f57422ead0",
                                "text": "„Selenverbindungen haben auch die physiologische Funktion, die Toxizität von Schwermetallionen, wie Quecksilber, Blei, Cadmium und Arsen, zu verringern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
