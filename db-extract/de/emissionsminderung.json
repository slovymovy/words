                ],
                "senses": [
                    {
                        "sense_id": "f15bd3b6-4c8d-3b79-8069-7a299f9f84d1",
                        "entry_id": "5f58aa53-e640-38a0-9bab-76bcfaf7f227",
                        "glosses": [
                            "Verringerung des Ausstoßes von Gasen, Stoffen, Teilchen, Schallwellen oder Strahlung in die Umwelt"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "b2056e35-0d1b-4867-8ee0-24853ec9267a",
                                "sense_id": "f15bd3b6-4c8d-3b79-8069-7a299f9f84d1",
                                "text": "„Im Genehmigungsverfahren, das üblicherweise über das Baurecht mit maschinentechnischem Anhang nach dem BImSchG abläuft, kommen die Vorschriften für die Emissionsminderung im Abgas zum Tragen, wie sie in der TA-Luft sowie in der 27. BImSchV geregelt sind.“"
                            },
                            {
                                "example_id": "a3e9b124-012f-4872-9b0f-5d4c2b07be94",
                                "sense_id": "f15bd3b6-4c8d-3b79-8069-7a299f9f84d1",
                                "text": "„Deutliche Emissionsminderungen können durch die Verwendung lösemittelarmer oder -freier Lacke, erreicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                        "entry_id": "5f58aa53-e640-38a0-9bab-76bcfaf7f227",
                        "glosses": [
                            "Verringerung des Ausstoßes von klimaschädlichen Gasen, wie CO₂, Methan, Lachgas, in die Atmosphäre"
                        ],
                        "tags": [
                            "Klima",
                            "im Speziellen"
                        ],
                        "examples": [
                            {
                                "example_id": "d4b386b0-4b21-48e9-94f4-3498ddcd0210",
                                "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                                "text": "„Wenn die Emissionsminderungen im selben Tempo wie bisher weitergehen, würde das gesetzlich festgelegte Ziel bis 2030 verfehlt, die Emissionen lägen dann im Jahr 2030 um 190 Millionen Tonnen CO₂ höher als geplant, warnt Prof. Hans-Martin Henning, Vorsitzender des Expertenrats für Klimafragen bei der Vorstellung des Berichts in Berlin.“"
                            },
                            {
                                "example_id": "d0841ade-1f88-4cd2-bbab-581815961c85",
                                "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                                "text": "„»In diesem für den Klimaschutz kritischen Jahrzehnt spiegeln die aktuellen Pläne der Unternehmen in keinerlei Weise die Dringlichkeit für sofortige drastische Emissionsminderungen wieder«.“"
                            },
                            {
                                "example_id": "b030573e-0fda-44af-a2cc-1035b54a1998",
                                "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                                "text": "„Mit dieser Emissionsminderung von 38 Prozent im Vergleich zu 1990 hätte Deutschland also das gesetzte Klimaziel verfehlt.“"
                            },
                            {
                                "example_id": "5c401e97-86fc-4295-9c6a-1f873b7fc4da",
                                "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                                "text": "„Ein weiter Schlüssel zur Emissionsminderung ist der Stopp von Lebensmittelverschwendung.“"
                            },
                            {
                                "example_id": "c38353da-df3f-4d2f-b795-1275f6618a9d",
                                "sense_id": "eabbede4-f539-34d4-828d-ecd0db1b8c2d",
                                "text": "„»Schon um das bestehende EU-Ziel einer Emissionsminderung von 40 Prozent bis 2030 zu erreichen, müssten alle 27 EU-Staaten ihre Klimaschutzanstrengungen ab sofort nahezu verdreifachen«, rechnet Kempf vor.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
                ],
