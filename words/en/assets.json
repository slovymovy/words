                            {
                                "target_lang_word": "преимущества",
                                "target_lang_sense_clarification": "сильные стороны"
                            },
                            {
                                "target_lang_word": "ценный ресурс",
                                "target_lang_sense_clarification": "о людях или вкладе"
                            }
