                "senses": [
                    {
                        "sense_id": "e906ec25-e4e4-349d-bb4b-491711c12b53",
                        "entry_id": "92d5c346-c505-3a61-8c85-9f5aad523c7f",
                        "glosses": [
                            "устар. уроженец одной с кем-либо страны"
