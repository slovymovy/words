    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b138d99-3f42-34b1-b7a6-79e30d47b499",
                    "sense_definition": "Поговорить легко и непринужденно в течение некоторого времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "разговор",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <w>поболтать</w> о жизни за чашкой горячего чая.",
                            "target_lang_translations": {
                                "en": "We decided to <w>chat</w> about life over a cup of hot tea."
                            }
                        },
                        {
                            "text": "Друзья встретились в парке, чтобы <w>поболтать</w> немного о последних новостях.",
                            "target_lang_translations": {
                                "en": "The friends met in the park to <w>have a chat</w> about the latest news."
                            }
                        }
                    ],
                    "synonyms": [
                        "поговорить",
                        "побеседовать"
                    ],
                    "common_phrases": [
                        "поболтать о жизни",
                        "поболтать немного"
                    ],
                    "target_lang_definitions": {
                        "en": "To talk in a light, casual, and relaxed manner for a period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to chat",
                                "target_lang_sense_clarification": "general term for informal conversation"
                            },
                            {
                                "target_lang_word": "to have a chat",
                                "target_lang_sense_clarification": "idiomatic expression for spending time talking"
                            },
                            {
                                "target_lang_word": "to have a chinwag",
                                "target_lang_sense_clarification": "informal, British English for a friendly chat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a85a6151-69e2-3c1c-8063-c70b32acb9f3",
                    "sense_definition": "Совершать движения чем-либо из стороны в сторону или вверх-вниз в течение некоторого времени.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "движение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребенок сидел на высоком стуле и <w>поболтал</w> ногами от радости.",
                            "target_lang_translations": {
                                "en": "The child sat on the high chair and <w>dangled</w> his legs with joy."
                            }
                        },
                        {
                            "text": "Он <w>поболтал</w> ложкой в стакане, чтобы сахар быстрее растворился.",
                            "target_lang_translations": {
                                "en": "He <w>stirred</w> the spoon in the glass so the sugar would dissolve faster."
                            }
                        }
                    ],
                    "synonyms": [
                        "покачать",
                        "потрясти"
                    ],
                    "common_phrases": [
                        "поболтать ногами",
                        "поболтать ложкой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To move something back and forth or up and down for a period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to dangle",
                                "target_lang_sense_clarification": "specifically for legs or limbs hanging loosely"
                            },
                            {
                                "target_lang_word": "to swing",
                                "target_lang_sense_clarification": "moving something back and forth"
                            },
                            {
                                "target_lang_word": "to stir",
                                "target_lang_sense_clarification": "specifically for moving a spoon in a liquid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
