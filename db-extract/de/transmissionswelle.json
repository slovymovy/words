                ],
                "senses": [
                    {
                        "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                        "entry_id": "48bc7c5b-e34b-336c-b82e-9ab5fb4f7648",
                        "glosses": [
                            "Antriebswelle zur Kraftübertragung in Transmissionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac615b17-4bca-45a5-91ed-60b620272dd5",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„Die Ölstände in den Original-Gleitlagern der Transmissionswellen wollen ebenso regelmäßig überprüft und ergänzt werden wie die Fettschmierungen in Bohrmaschine, Pumpe und Haspeln.“"
                            },
                            {
                                "example_id": "a3c6893d-e7cf-4ed9-91cb-cd2faf78fc14",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„Die Transmissionswelle wurde dem Förderverein von der Familie Drese geschenkt.“"
                            },
                            {
                                "example_id": "2f74687d-cb6a-4a35-9c18-38198ada8cf5",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„Pferde oder Ochsen trieben anstelle von Wind- oder Wasserkraft eine Transmissionswelle an und machten damit unabhängig von deren zeitlichen Angeboten (Pausen bei Windstille oder Wassermangel im Mühlenteich).“"
                            },
                            {
                                "example_id": "bbe026b4-5e84-425a-b5a6-be9ee2d6aa80",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„Unter der Decke dreht sich die Transmissionswelle und treibt die auf den Tischen montierten Werkzeuge an. “"
                            },
                            {
                                "example_id": "6b8d9e80-6efb-45d4-b53c-9c23d6685d10",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„In der Scheune sieht man den „Heukran“, der früher ebenfalls durch das Wasserrad mit einer Transmissionswelle angetrieben wurde.“"
                            },
                            {
                                "example_id": "3bb5b76e-ceea-43ee-bb3c-be7af2781f5d",
                                "sense_id": "05ef0b96-4ab6-3f49-a4e6-e898ff89f7b3",
                                "text": "„Jedes Flachriemenrad auf der Transmissionswelle dreht sich also 88-mal je Minute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
