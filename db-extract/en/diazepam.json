                "senses": [
                    {
                        "sense_id": "fad1cf65-b580-3fa6-8484-7bb56e752020",
                        "entry_id": "d6ea2685-fe47-3a87-a89c-735f211bfbf0",
                        "glosses": [
                            "A tranquilizing muscle relaxant drug (trademark Valium) used mainly to relieve anxiety."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9204d664-9120-44d2-9156-7c3e42410094",
                                "sense_id": "fad1cf65-b580-3fa6-8484-7bb56e752020",
                                "text": "2001: The most effective anti-anxiety drugs (tranquillizers) are the benzodiazepines, epitomized by diazepam (Valium®). — Leslie Iversen, Drugs: A Very Short Introduction (Oxford 2001, p. 57)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63db6c83-b2f2-4e66-a902-1910c5aa8a09",
                        "source_entry_id": "d6ea2685-fe47-3a87-a89c-735f211bfbf0",
