{
    "word_family": [
        "anoint"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "69966851-c965-3ffd-bc06-6c425772fcd8",
                    "sense_definition": "A smooth, oily substance applied to the skin of the body for healing or cosmetic purposes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_ointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed an antibiotic <w>ointment</w> to help prevent an infection.",
                            "target_lang_translations": {
                                "de": "Der Arzt verschrieb eine antibiotische <w>Salbe</w>, um einer Infektion vorzubeugen.",
                                "zh": "医生开了一种抗生素<w>软膏</w>以帮助预防感染。"
                            }
                        },
                        {
                            "text": "She gently applied a soothing herbal <w>ointment</w> to her dry skin.",
                            "target_lang_translations": {
                                "de": "Sie trug vorsichtig eine beruhigende Kräuter<w>salbe</w> auf ihre trockene Haut auf.",
                                "zh": "她把具有舒缓作用的草本<w>药膏</w>轻轻涂在干燥的皮肤上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "salve",
                        "unguent"
                    ],
                    "common_phrases": [
                        "antibiotic ointment",
                        "soothing ointment",
                        "apply an ointment"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine geschmeidige, ölige Substanz, die zur Heilung oder Pflege auf die Haut aufgetragen wird.",
                        "zh": "涂抹于皮肤上以起到治疗或美容作用的光滑油状物质。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Salbe",
                                "target_lang_sense_clarification": "halbfeste Zubereitung zur äußerlichen Anwendung"
                            },
                            {
                                "target_lang_word": "Wundsalbe",
                                "target_lang_sense_clarification": "speziell zur Wundheilung"
                            },
                            {
                                "target_lang_word": "Balsam",
                                "target_lang_sense_clarification": "pflegende oder lindernde Salbe"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "药膏",
                                "target_lang_sense_clarification": "涂抹于皮肤的治疗性膏状药物"
                            },
                            {
                                "target_lang_word": "软膏",
                                "target_lang_sense_clarification": "医学上的半固体外用制剂"
                            },
                            {
                                "target_lang_word": "油膏",
                                "target_lang_sense_clarification": "油质的膏状物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36086d47-1122-3013-aa59-e5f795dee3d3",
                    "sense_definition": "A sacred oil or fragrant substance used to anoint someone, especially in religious rituals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_ointment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest used a sacred <w>ointment</w> during the baptism ceremony.",
                            "target_lang_translations": {
                                "de": "Der Priester verwendete während der Tauffeier ein heiliges <w>Salböl</w>.",
                                "zh": "牧师在洗礼仪式中使用了神圣的<w>圣油</w>。"
                            }
                        },
                        {
                            "text": "In ancient times, holy <w>ointment</w> was reserved exclusively for consecrating kings and altars.",
                            "target_lang_translations": {
                                "de": "In der Antike war heiliges <w>Salböl</w> ausschließlich der Weihe von Königen und Altären vorbehalten.",
                                "zh": "在古代，圣洁的<w>膏油</w>专门用于祝圣君王和祭坛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unguent"
                    ],
                    "common_phrases": [
                        "holy ointment",
                        "sacred ointment"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein heiliges Öl oder eine duftende Substanz, die besonders bei religiösen Ritualen zur Salbung verwendet wird.",
                        "zh": "在宗教仪式中用于行涂油礼的圣油或芳香物质。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Salböl",
                                "target_lang_sense_clarification": "geweihtes oder rituelles Öl zur Salbung"
                            },
                            {
                                "target_lang_word": "Salbe",
                                "target_lang_sense_clarification": "in historischem oder theologischem Kontext"
                            },
                            {
                                "target_lang_word": "Balsam",
                                "target_lang_sense_clarification": "duftendes, weihevolles Harzgemisch"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣油",
                                "target_lang_sense_clarification": "宗教仪式中用于涂抹祝圣的香油"
                            },
                            {
                                "target_lang_word": "膏油",
                                "target_lang_sense_clarification": "宗教或古代仪式上行涂油礼用的油"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}