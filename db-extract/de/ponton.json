                "senses": [
                    {
                        "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                        "entry_id": "ece3937a-f317-351b-ac5a-4efc81274806",
                        "glosses": [
                            "breiter, flacher Kahn oder geschlossener Schwimmkörper für bewegliche Brücken, Landungsstellen und viele andere Zwecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e90b8f-d9ed-4341-b8f2-841bc9a8259f",
                                "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                                "text": "Ein Jachthafen kann nach Heids Vorstellung entstehen, wenn mehrere Pontons mit Stegen verbunden werden."
                            },
                            {
                                "example_id": "8c561a3c-06d8-4dac-b459-4c1055ddaf64",
                                "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                                "text": "3430 Meter Brückenlänge sollen auf Schwimmkörpern lagern, die aus einzelnen Pontons bestehen, aus Stahlbeton gefertigt, vorgespannt, jeweils 100 Meter, lang, 16 Meter breit und fünf Meter hoch."
                            },
                            {
                                "example_id": "e4d89911-9993-4854-adde-985247269969",
                                "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                                "text": "Zum Baden springt man eben in den Pool oder schwimmt zu einem der riesigen Pontons hinüber, die zu jedem Schiff gehören."
                            },
                            {
                                "example_id": "8b8679f7-193e-4816-8957-5f235fb5e3e5",
                                "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                                "text": "„Daß der alte Grams noch jemanden mit in den Tod gerissen hatte, war auf dem Ponton ebenfalls unbemerkt geblieben, so blitzschnell mußte der Angriff erfolgt sein.“"
                            },
                            {
                                "example_id": "6e668c88-0665-409e-b886-aee91bdbd754",
                                "sense_id": "4f3ec76e-1dc5-33fa-b42b-8ae9d7e4015c",
                                "text": "„1971 lagen wir einsam an einem Ponton in einem Becken des ziemlich leeren Handelshafens. Den Ponton haben wir wiedergefunden, sonst kaum etwas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
