                        "sense_id": "f1a7794b-01cb-3f90-af96-c3c7719fb08a",
                        "entry_id": "d409796e-f2f8-3260-b8cd-c4ef45d0acda",
                        "glosses": [
                            "One who takes part in an antimasque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03280af3-b39b-4bcc-b6f5-04ed757da917",
                                "sense_id": "f1a7794b-01cb-3f90-af96-c3c7719fb08a",
                                "text": "The dauncers, masquers, antimasquers, and musicians did befor hand practice in the place where they were to present the masque, and the sceanes were artfully prepared (by Inigo Jones) att the lower end of the banquetting house, and all things were in readyness."
                            },
                            {
                                "example_id": "9b010726-2133-427a-ad51-6a5142cb32c3",
                                "sense_id": "f1a7794b-01cb-3f90-af96-c3c7719fb08a",
                                "text": "Next came a still more popular part—the antimasquers or comic and satirical part."
                            },
                            {
                                "example_id": "4d2d6549-cafd-432e-8c1f-b76dce0491e0",
                                "sense_id": "f1a7794b-01cb-3f90-af96-c3c7719fb08a",
                                "text": "But Sabrina is no antimasquer. Instead, she introduces this alternative mode of signification into the masque proper, where she becomes moreover a necessary ally in the reunification of the aristocratic family."
                            },
                            {
                                "example_id": "dfb08868-5c2b-4b82-8b44-ac81c7ab3849",
                                "sense_id": "f1a7794b-01cb-3f90-af96-c3c7719fb08a",
                                "text": "This downward metamorphosis serves to justify the low place of the antimasquers in the social scheme and to underscore how limited their social contribution must be."
                            }
                        ]
                    }
                ],
