                "senses": [
                    {
                        "sense_id": "9c886259-ebdd-39dd-9304-1ceec65ffeaf",
                        "entry_id": "66344de2-ff40-3be7-a97a-2d4a5a71b0f5",
                        "glosses": [
                            "Acronym of stay-at-home mom/mum/mother."
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a125fe39-c327-4042-b03b-f5baad662484",
                                "sense_id": "9c886259-ebdd-39dd-9304-1ceec65ffeaf",
                                "text": "I've been thinking recently about the importance of taking my job as a SAHM seriously."
                            },
                            {
                                "example_id": "386e70f6-d2f4-4abd-946c-c0bac28c2421",
                                "sense_id": "9c886259-ebdd-39dd-9304-1ceec65ffeaf",
                                "text": "I took our son everywhere with me, and frankly, that is one of the best parts of being a SAHM: when you have your child with you and you're both involved in some outside activities, you not only have more bonding time, but your child is exposed to a wide range of real-world activities and people […]"
                            },
                            {
                                "example_id": "376a3947-802d-4177-845a-e50f32143661",
                                "sense_id": "9c886259-ebdd-39dd-9304-1ceec65ffeaf",
                                "text": "In the most radical cases, a SAHM might suffer from all these maladies at once, and her life becomes a Sisyphean struggle to maintain body, home, children and community work, according to unimpeachable standards."
                            }
                        ]
                    }
