                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Небольшой посёлок <w>Хрустальный</w> находится в Приморском крае среди лесов.",
                            "target_lang_translations": {
                                "en": "The small settlement of <w>Khrustalny</w> is located in Primorsky Krai among the forests."
                            }
                        },
                        {
                            "text": "Они решили отправиться на экскурсию в посёлок <w>Хрустальный</w> ранним утром.",
                            "target_lang_translations": {
