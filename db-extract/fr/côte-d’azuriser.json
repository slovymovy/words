                ],
                "senses": [
                    {
                        "sense_id": "b43c8716-4ec7-35ea-9066-795b4d6e33d7",
                        "entry_id": "3b0aac29-e420-344f-8850-12eddb87f6c5",
                        "glosses": [
                            "Donner un caractère rappelant la Côte d’Azur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7054ef08-7a03-408c-990c-85b2e0576e38",
                                "sense_id": "b43c8716-4ec7-35ea-9066-795b4d6e33d7",
                                "text": "Trop populaire, trop prolétaire, trop immigrée, aux yeux de nombreux élus de tous bords, Marseille devrait, forcément, se «côte-d'azuriser»"
                            },
                            {
                                "example_id": "c481eaf8-d6c9-4974-aad8-e6814c2b9a98",
                                "sense_id": "b43c8716-4ec7-35ea-9066-795b4d6e33d7",
                                "text": "Je pense que ce serait un triste destin pour la Corse de se « cote-d'azuriser »."
                            },
                            {
                                "example_id": "263f2049-d13f-4268-9d94-f2f7365de425",
                                "sense_id": "b43c8716-4ec7-35ea-9066-795b4d6e33d7",
                                "text": "J’adore cette ville qui est restée \"voyou\", qui ne s’est pas \"côte-d’azurisée\"."
                            }
                        ]
                    }
