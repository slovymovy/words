                        "entry_id": "e0f6cfe4-42d3-3750-8e97-1f95acab5b99",
                        "glosses": [
                            "Tätigkeiten, um eine optimale psychologische und physische Verfassung vor einem Training oder einem Wettkampf herzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b418819b-34ab-42f9-b99a-a12409b93367",
                                "sense_id": "9185578a-8a03-3b55-83c1-815005c7f515",
                                "text": "Es gibt verschiedene Techniken zur Aufwärmung, da es von der gewählten Sportart und persönlichen Faktoren abhängt."
                            },
                            {
                                "example_id": "31596930-1cf3-4675-bf16-ddf2866eae2d",
                                "sense_id": "9185578a-8a03-3b55-83c1-815005c7f515",
                                "text": "Die Aufwärmung vor dem Sportunterricht, Training oder Wettkampf ist wichtig, weil dadurch das Herzkreislaufsystem und die Muskeln besser durchblutet werden und sich entspannen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a104177d-d82b-4cef-a4ed-a2784339303c",
