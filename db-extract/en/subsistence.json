                    {
                        "translation_id": "49b9d175-ea71-446d-a7dc-25ff376d2921",
                        "source_entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "source_sense_description": "means of support",
                        "target_lang_word": "Auskommen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auskommen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75473ab2-90d6-329b-a70c-e3dcc1989a9d",
                                        "entry_id": "5866f26a-6eb7-3baa-acbd-6c9eb87b4858",
                                        "glosses": [
                                            "finanzielle oder materielle Mittel zur Deckung der täglichen Bedürfnisse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39cec6b0-7d3d-4b5c-b991-c485e12e7bb9",
                                                "sense_id": "75473ab2-90d6-329b-a70c-e3dcc1989a9d",
                                                "text": "Die Eltern des Studenten ermöglichten ihm ein bescheidenes Auskommen."
                                            },
                                            {
                                                "example_id": "7b17d84c-041a-4c0b-80b1-7eebf5513861",
                                                "sense_id": "75473ab2-90d6-329b-a70c-e3dcc1989a9d",
                                                "text": "„Sie waren zwar bei weitem nicht reich, aber sie hatten ihr gutes Auskommen, weil sie auf jeden Pfennig achteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63780fcd-bcd2-37cf-8f14-8a43fca3dcbc",
                                        "entry_id": "5866f26a-6eb7-3baa-acbd-6c9eb87b4858",
                                        "glosses": [
                                            "Art und Weise des Zusammenlebens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d93bb1a-6539-419e-82a6-9f590ba7c4c2",
                                                "sense_id": "63780fcd-bcd2-37cf-8f14-8a43fca3dcbc",
                                                "text": "Mit diesem Menschen gibt es kein Auskommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7e10f60-ebbe-484f-9993-8cecc41ce90c",
                        "source_entry_id": "7bd73276-e3a4-3f5d-9c71-fca5beb4d722",
                        "source_sense_description": "means of support",
                        "target_lang_word": "Lebensunterhalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lebensunterhalt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b6cfc9b-a2d8-3f63-888e-6a918ce20642",
                                        "entry_id": "b4976869-3a87-38ed-be20-15149da49d64",
                                        "glosses": [
                                            "die finanziellen Mittel, die nötig sind, um das Leben zu sichern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2230d736-9a3f-4b7f-b0bc-cafed6b6be6e",
                                                "sense_id": "2b6cfc9b-a2d8-3f63-888e-6a918ce20642",
                                                "text": "„Ich verdiente meinen Lebensunterhalt damit, den Deutschen ihre besten Stücke einzuseifen: als Autowäscher in einer Waschstraße.“"
                                            },
                                            {
                                                "example_id": "c61ab370-cd0b-42d9-bd7a-a07e6e00218f",
                                                "sense_id": "2b6cfc9b-a2d8-3f63-888e-6a918ce20642",
                                                "text": "„Durch Pferdewetten suchte er ihrer beider Lebensunterhalt zu sichern.“"
                                            },
                                            {
                                                "example_id": "878e4be3-b4e5-4b4c-b909-dc0ab507ce03",
                                                "sense_id": "2b6cfc9b-a2d8-3f63-888e-6a918ce20642",
                                                "text": "„Im Juli 2012 wurde der Lebensunterhalt von etwa 800 Roma-Familien gefährdet, als die Polizei von Tirana einen Verwaltungsakt umsetzte, der das Sammeln von Abfall und anderen wiederverwendbaren Materialien verbot, und ihre Fahrzeuge und andere Ausrüstungsgegenstände beschlagnahmte.“"
                                            },
                                            {
                                                "example_id": "7f3ebd3f-8cbe-4791-86cd-0b2a8f6c5523",
                                                "sense_id": "2b6cfc9b-a2d8-3f63-888e-6a918ce20642",
                                                "text": "„Ab da ging es, was den Lebensunterhalt anging, bergauf, ab da konnte ich von den Büchern leben, ohne Nebenarbeiten annehmen zu müssen, dies war etwa mein siebzigstes Buchwerk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
