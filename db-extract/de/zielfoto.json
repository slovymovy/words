                        "glosses": [
                            "Fotografie, die beim Zieleinlauf der Wettkämpfer geschossen wird, um im Zweifelsfall zu entscheiden, wer welche Platzierung erreicht hat"
                        ],
                        "tags": [],
                        "examples": [
