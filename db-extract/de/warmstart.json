                "senses": [
                    {
                        "sense_id": "ffe3dc2b-2337-3ade-a8c8-30e507336fde",
                        "entry_id": "a80ec2ae-6066-33c1-8358-7f5ab3546594",
                        "glosses": [
                            "Starten eines bereits aufgewärmten Verbrennungsmotors"
                        ],
                        "tags": [
                            "Kraftfahrzeugtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "c17a7687-bf05-420c-90a4-9c4e78d2fb97",
                                "sense_id": "ffe3dc2b-2337-3ade-a8c8-30e507336fde",
                                "text": "„Kraftstoffe mit einem niedrigeren 10-%-Punkt neigen zu größeren Problemen beim Warmstart.“"
                            },
                            {
                                "example_id": "cf20e503-e955-47e3-a756-90950437b82f",
                                "sense_id": "ffe3dc2b-2337-3ade-a8c8-30e507336fde",
                                "text": "„Beim Ford ergab der Warmstart fünf Prozent weniger Kohlenwasserstoff- und Stickoxid-Ausstoß und sogar 30 Prozent weniger Kohlenmonoxyd-Emission als bei einem Kaltstart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41150705-0d40-35a2-97a1-bdbab77cdcfd",
                        "entry_id": "a80ec2ae-6066-33c1-8358-7f5ab3546594",
                        "glosses": [
                            "erneutes Hochfahren (Booten) eines Computersystems"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "2f2f1161-b70e-4989-aae2-963d4116403d",
                                "sense_id": "41150705-0d40-35a2-97a1-bdbab77cdcfd",
                                "text": "„Ein manueller Warmstart kann immer ausgelöst werden, es sei denn, die CPU fordert Urlöschen an.“"
                            },
                            {
                                "example_id": "de59cc7c-bfc1-4e98-aaff-8fb9990bbc03",
                                "sense_id": "41150705-0d40-35a2-97a1-bdbab77cdcfd",
                                "text": "„Der Reset tritt mit elektronischen Systemen auf – und kann verschiedene Formen haben: den Warmstart (Reboot), den Hardware Reset und den Kaltstart.“"
                            },
                            {
                                "example_id": "fd826c5d-a1cd-46c3-92ee-c9da40f9794f",
                                "sense_id": "41150705-0d40-35a2-97a1-bdbab77cdcfd",
                                "text": "„Welche Meldungen bei einem Warmstart auf dem Bildschirm erscheinen ist abhängig vom BIOS, welches auf der Computerplatine verwendet wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b188831b-2c57-4117-ad92-ed8902c22467",
                        "source_entry_id": "a80ec2ae-6066-33c1-8358-7f5ab3546594",
                        "source_sense_id": "41150705-0d40-35a2-97a1-bdbab77cdcfd",
                        "target_lang_word": "reboot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reboot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1861a3c-2db6-392e-ae82-363f3cb77e5f",
                                        "entry_id": "1856c0a8-2c1a-3ac4-b700-0c4e8e72c3db",
                                        "glosses": [
                                            "An instance of rebooting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ab8670d-410f-3c64-941c-ddb02f9076ba",
                                        "entry_id": "1856c0a8-2c1a-3ac4-b700-0c4e8e72c3db",
                                        "glosses": [
                                            "A fresh start."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8312649-771f-4afb-a045-f4e2c875072c",
                                                "sense_id": "3ab8670d-410f-3c64-941c-ddb02f9076ba",
                                                "text": "That’s why we don’t just need a bailout. We need a reboot. We need a build out. We need a buildup. We need a national makeover."
                                            },
                                            {
                                                "example_id": "392b5395-d8f3-46fa-9650-f6dc519a0385",
                                                "sense_id": "3ab8670d-410f-3c64-941c-ddb02f9076ba",
                                                "text": "Other reboots of beloved restaurants, like the Four Seasons, have failed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5cec13a-a6c9-3ad5-a1ae-c1fab0ab6be3",
                                        "entry_id": "1856c0a8-2c1a-3ac4-b700-0c4e8e72c3db",
                                        "glosses": [
                                            "The restarting of a series' storyline, discarding all previous continuity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15e63609-c8f8-3b03-bb06-095f523c0b31",
                                        "entry_id": "1856c0a8-2c1a-3ac4-b700-0c4e8e72c3db",
                                        "glosses": [
                                            "The restarting of a series' storyline without discarding previous continuity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "227bb4f3-b708-4179-9960-587f359ff338",
                                                "sense_id": "15e63609-c8f8-3b03-bb06-095f523c0b31",
                                                "text": "HBO Max has issued a straight-to-series order for “Pretty Little Liars: Original Sin,” a reboot of the original Freeform series... “We’re such huge fans of what I. Marlene King and her iconic cast created, we knew that we had to treat the original series as #CANON\""
                                            },
                                            {
                                                "example_id": "d58d5c75-5d80-4716-9bca-31966efcc86f",
                                                "sense_id": "15e63609-c8f8-3b03-bb06-095f523c0b31",
                                                "text": "As well as Ari Parker’s starring role, the reboot will introduce three characters played by people of colour, with Sara Ramirez, Karen Pittman and Sarita Choudhury to join the quartet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reboot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "005c8089-683e-3eeb-8bf3-970709e3dd06",
                                        "entry_id": "33e03d6d-24d4-388f-b1be-ad2eb255d5e5",
                                        "glosses": [
                                            "To execute a computer's boot process, effectively resetting the computer and causing the operating system to reload, commonly after a system failure."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32504a81-a11c-494c-86d6-80982c1a81bf",
                                                "sense_id": "005c8089-683e-3eeb-8bf3-970709e3dd06",
                                                "text": "We need to reboot the system after installing these updates."
                                            },
                                            {
                                                "example_id": "d3e8be7e-7b9b-4b31-8d66-baba95f117e3",
                                                "sense_id": "005c8089-683e-3eeb-8bf3-970709e3dd06",
                                                "text": "The system reboots every weekend after updates are installed."
                                            },
                                            {
                                                "example_id": "537fb916-02cd-42d0-9287-b1ee2b4fc1e8",
                                                "sense_id": "005c8089-683e-3eeb-8bf3-970709e3dd06",
                                                "text": "NASA is once again trying to reboot the Hubble Space Telescope, agency officials said. The telescope’s instruments have been shut down since the end of September, when a router that formats science data for transmission to the ground had an electrical failure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4614d28d-2c6e-356f-98d3-52cee2609d19",
                                        "entry_id": "33e03d6d-24d4-388f-b1be-ad2eb255d5e5",
                                        "glosses": [
                                            "To start afresh."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46603f75-c226-44e0-a5ef-11eddff21665",
                                                "sense_id": "4614d28d-2c6e-356f-98d3-52cee2609d19",
                                                "text": "They rebooted the TV series, but it's even worse than the original."
                                            },
                                            {
                                                "example_id": "382f35d5-b043-4559-90cb-b73a991ab56b",
                                                "sense_id": "4614d28d-2c6e-356f-98d3-52cee2609d19",
                                                "text": "What are the first steps to rebooting your business?"
                                            },
                                            {
                                                "example_id": "15139514-057c-4e22-899f-054f97a56851",
                                                "sense_id": "4614d28d-2c6e-356f-98d3-52cee2609d19",
                                                "text": "As the Republican National Convention kicks off Monday, Donald Trump has a tremendous opportunity to rebrand and reboot his campaign, to make it look and feel more professional and less petulant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ab719a9-63ac-3973-bd18-853a6e108d70",
                                        "entry_id": "33e03d6d-24d4-388f-b1be-ad2eb255d5e5",
                                        "glosses": [
                                            "Restart; to return to an initial configuration or state."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd84feb1-a6d0-42cf-9595-e5ebaabb091c",
                                                "sense_id": "8ab719a9-63ac-3973-bd18-853a6e108d70",
                                                "text": "Egg farmers do this to reboot birds' internal clocks so they start laying valuable eggs faster and, crucially, at the same time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
