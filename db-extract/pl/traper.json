                                        "sense_id": "78b206af-bfe6-35b3-8b68-5f4c56d59240",
                                        "entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                                        "glosses": [
                                            "One who traps animals; one who makes a business of trapping animals, for their pelts, meat, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bb1c47-902c-47f9-aeed-005e970e1459",
                                                "sense_id": "78b206af-bfe6-35b3-8b68-5f4c56d59240",
                                                "text": "The trapper is amazed and disturbed because he sees that this wild man has been freeing all the animals from his traps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9d46dff-4ea7-3674-aba6-fdd0360da27b",
                                        "entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                                        "glosses": [
                                            "A worker (usually a child) who opens and shuts a door in a gallery or level of a mine, to manage ventilation and access."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b294198-146e-3d1e-af21-3b8cc24dec4f",
                                        "entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                                        "glosses": [
                                            "An ornamental covering for a horse. See trapping and caparison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cb2970d-6b4e-3b8d-ae5c-dac7c7869048",
                                        "entry_id": "ce7e9c61-3c76-3ff5-b691-f01f66b4fb96",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
