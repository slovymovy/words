                                    {
                                        "sense_id": "4db2b571-de7a-32ba-9787-b04e04772926",
                                        "entry_id": "b85da3fd-8d3a-3f23-b444-7864862f819e",
                                        "glosses": [
                                            "The vulva or vagina of a trans man, or the neovagina of a detransitioned man."
                                        ],
                                        "tags": [],
