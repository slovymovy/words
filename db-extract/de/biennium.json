                ],
                "senses": [
                    {
                        "sense_id": "d51925ad-9689-3e66-8a8a-f648c74e44aa",
                        "entry_id": "3c9a9f4a-568e-3f1e-9b5b-52bf0faf9b7a",
                        "glosses": [
                            "zwei Jahre dauernder Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ae51ac-8ce0-4f7d-949d-8711894fc090",
                                "sense_id": "d51925ad-9689-3e66-8a8a-f648c74e44aa",
                                "text": "„Die Elementarschule war in drei Biennien eingeteilt, wobei das erste Biennium für das Anschauungs-, das zweite Biennium für das Begriffs- und das dritte Biennium für das Urteilsvermögen des Schülers zu sorgen hatte.“"
                            },
                            {
                                "example_id": "c4a4ad83-73be-4b3a-a066-9e6ed0dd45f4",
                                "sense_id": "d51925ad-9689-3e66-8a8a-f648c74e44aa",
                                "text": "Seine Ehe hielt nur ein Biennium."
                            },
                            {
                                "example_id": "d82b83ba-4148-41f4-aff1-7dea7d17950b",
                                "sense_id": "d51925ad-9689-3e66-8a8a-f648c74e44aa",
                                "text": "„In den sechs Jahren seiner Amtszeit gelang es ihm, das Konzerthaus als fortschrittliches Unternehmen mit europäischem Ruf zu führen, Schwerpunktprogramme zu setzen und im Biennium vielbeachtete Musikfeste innerhalb der Wiener Festwochen zu organisieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                        "entry_id": "3c9a9f4a-568e-3f1e-9b5b-52bf0faf9b7a",
                        "glosses": [
                            "zweijährige Gehaltsvorrückung nach dem Dienstalter in Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ffdaf20-a021-40a6-8255-91b50adf8ec2",
                                "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                                "text": "„Öffentlich Bedienstete haben in Österreich einen Anspruch auf einen Gehaltssprung alle zwei Jahre, genannt Biennium.“"
                            },
                            {
                                "example_id": "f3422f09-15ec-4d71-80e2-f647545d02ad",
                                "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                                "text": "„Dem gegenüber gibt es für besondere Forschungsleistungen keine Anerkennung durch den Dienstgeber (mit Ausnahme des Bienniums für das Doktorat und das eineinhalbfache Biennium für die Habilitation).“"
                            },
                            {
                                "example_id": "0b7ad043-5e09-4d69-a0f9-6514737b9c28",
                                "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                                "text": "„Man musste froh sein, dass man mit einer Wahrungszulage wenigstens bis zum nächsten Biennium das bisherige Gehalt weiterbekommt!“"
                            },
                            {
                                "example_id": "d94663c9-38ca-4c93-9502-f8ff0df8a267",
                                "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                                "text": "„Überdies sei in diesen Fällen immer ein sogenannter ‚Rösselsprung‘ angewendet worden, d.h. diese Arbeitnehmer seien gleichzeitig in diejenige nächsthöhere Gehaltsstufe vorgerückt, deren Differenz zum bisherigen Einkommen zumindest ein Biennium der neuen Verwendungsgruppe betragen habe.“"
                            },
                            {
                                "example_id": "23e6c023-d9b6-4b58-b6a1-a92f931c8db0",
                                "sense_id": "8b5a475c-e8aa-327e-a33e-af9684c3c100",
                                "text": "„Dies allerdings nur anlässlich einer Vollendung eines Besoldungsdienstalters von weiteren zwei Jahren – damit wird klargestellt, dass bei jenen Bediensteten, die unmittelbar nach der Überleitung ab März 2015 sofort eine kleine Daz erhalten, die Verbesserung des Besoldungsdienstalters erst mit dem nächsten Biennium erfolgen soll, also bei Anfall der großen Daz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
