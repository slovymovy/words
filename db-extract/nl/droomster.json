                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5d9fc1-a681-4731-812a-1935d5825f5f",
                                "sense_id": "fbfe6108-9c74-39b3-b63d-c7924915f0dc",
                                "text": "Een droomster die vaak depressief is geweest en zich daaraan nu ontworstelt, droomt dat een blauwe vogel zich losmaakt uit iets zwaars en donkers en dan omhoog vliegt."
                            }
                        ]
                    },
                    {
                        "sense_id": "bff27619-c899-3ad8-b621-db3658a0c8ae",
                        "entry_id": "8b31ecdc-4711-363d-8a02-9049bb9d34f7",
                        "glosses": [
                            "vrouw met een beperkte zin voor de werkelijkheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef6cb3fc-f8be-4394-af33-d11e529e93d1",
                                "sense_id": "bff27619-c899-3ad8-b621-db3658a0c8ae",
                                "text": "Metarey neemt hem onder zijn vleugels, kijkt welwillend toe hoe hij verliefd wordt op zijn beide dochters -eerst op de labiele droomster Christian, later op de mysterieuze, cynische Clara- en zorgt dat hij de beste opleiding krijgt die geld kan kopen."
                            }
                        ]
                    }
