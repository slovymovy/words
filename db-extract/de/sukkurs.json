                        ],
                        "examples": [
                            {
                                "example_id": "540e02df-2d8a-495b-9acc-8230aa62796f",
                                "sense_id": "1e7e026d-fb85-3e59-a29b-e5865e101d77",
                                "text": "„Der Kanton Zürich kämpft zwar noch dafür […], scheint aber kaum Sukkurs von anderen Kantonen zu bekommen.“"
                            },
                            {
                                "example_id": "09b1121b-bbac-4e99-8604-376baaec5ba3",
                                "sense_id": "1e7e026d-fb85-3e59-a29b-e5865e101d77",
                                "text": "„Gordon, als er sah, daß er nicht durchdränge, wandte sich um Sukkurs an Rosa.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "55e6f607-59f3-32b7-9cd9-1ec4f5b3c1b2",
                        "entry_id": "f333f7ab-dbfe-3bdc-ae8b-da9e220b9cde",
                        "glosses": [
                            "diejenigen, die die Unterstützung gewähren/leisten"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "ddb58513-ceba-451a-850e-21f1eccf2193",
                                "sense_id": "55e6f607-59f3-32b7-9cd9-1ec4f5b3c1b2",
                                "text": "„Der Sukkurs sammelt sich vorerst in Ljeschnitza, wo er von allen drey Orten in einer Stunde und einer Minute eintrifft.“ (1825)"
                            }
                        ],
                        "sense_index_json": "\"2\""
