                "senses": [
                    {
                        "sense_id": "d9bdbaee-a3c7-3a4e-ba99-f2bc892d9b02",
                        "entry_id": "95668d83-6362-3a2a-829d-4e85598a2125",
                        "glosses": [
                            "Promulguer (une loi) tout en la suspendant simultanément ou presque."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "80c61d18-e84e-4ced-8651-0fca7ef08db9",
                                "sense_id": "d9bdbaee-a3c7-3a4e-ba99-f2bc892d9b02",
                                "text": "Après pour le reste faire revoter les lois sous Sarkozy, les susmulguer (promulgation suspension) sous Chirac, ou retarder le travail du parlement quand on s’appelle Mitterrand en période de cohabitation c’est pour moi du pareil au même."
                            },
                            {
                                "example_id": "18373702-0687-449a-9a9d-1fb7a9492b18",
                                "sense_id": "d9bdbaee-a3c7-3a4e-ba99-f2bc892d9b02",
                                "text": "Droit dans ses bottes, Dominique de Villepin rendait coup pour coup avant de voir son projet « susmulgué » par le Président de la République."
                            },
                            {
                                "example_id": "d00aacb4-07c3-4e69-bf6c-b44c0f147f88",
                                "sense_id": "d9bdbaee-a3c7-3a4e-ba99-f2bc892d9b02",
                                "text": "Depuis que nous avons susmulgué mon CPE, d’étranges discours fleurissent dans les journaux télévisés."
                            }
                        ]
                    }
                ],
