                                            {
                                                "example_id": "706829da-8ab2-4350-8925-597ff29c5448",
                                                "sense_id": "1bca313c-950c-3458-9419-5f1fe6e7edcf",
                                                "text": "„Eine Messung ergab, dass sämtliche Stadttore bis auf das ehemalige Jakobstor auf einer Kreisbahn mit dem Mittelpunkt auf dem Katschhof, einer Freifläche zwischen dem Oktagon des Doms und dem Rathaus, angeordnet waren.“"
                                            }
                                        ],
