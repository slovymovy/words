                        "examples": [
                            {
                                "example_id": "5817e373-26f3-45d5-a0e5-70f986f1e073",
                                "sense_id": "30736f93-c61c-3a34-9e8e-ba4302f77a6a",
                                "text": "Cette maison est bâtie dans une grenouillère."
                            },
                            {
                                "example_id": "8373a73c-1460-4c48-bffa-4ad52131eb06",
                                "sense_id": "30736f93-c61c-3a34-9e8e-ba4302f77a6a",
                                "text": "Ce jardin est une grenouillère."
                            }
