                ],
                "senses": [
                    {
                        "sense_id": "dcc820a2-62fe-3ff5-a11d-502afbb49ef3",
                        "entry_id": "9f010909-54b4-34fe-951e-80ab87f7bde8",
                        "glosses": [
                            "tytuł szlachecki pochodzenia hiszpańskiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7bb5724-6eb0-484a-a040-7b0b5a61c031",
                                "sense_id": "dcc820a2-62fe-3ff5-a11d-502afbb49ef3",
                                "text": "Pielgrzymi przybywali tysiącami, by go zobaczyć – wieśniacy, duchowni, kardynałowie, papieże, książęta i grandowie – zmierzali z całej Italii, z Francji i z Polski"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abde2d41-d144-4354-8f74-fd50a11223cb",
                        "source_entry_id": "9f010909-54b4-34fe-951e-80ab87f7bde8",
                        "source_sense_id": "dcc820a2-62fe-3ff5-a11d-502afbb49ef3",
                        "target_lang_word": "grandee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3b2c34d-1cb5-3e51-8228-0d28af059980",
                                        "entry_id": "3bbc1ab8-7803-3566-94ed-f76d27351eb5",
                                        "glosses": [
                                            "A high-ranking nobleman in Spain or Portugal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9a6226c-a102-4d2d-8afd-5ec5dc7e2258",
                                                "sense_id": "c3b2c34d-1cb5-3e51-8228-0d28af059980",
                                                "text": "Grandees of Spain are of two sorts, this Honour being sometimes personal, sometimes hereditary. The first, the King bids be covered themselves; the second, themselves and Heirs for ever. This is all the Ceremony in making a Grandee, neither do any other priviledges belong to it; so that it is but a Chimerical and Airy Honour, without any profit; they which marry the Heiress of a Family of a Grandee of Spain, that is such hereditarily, become Grandees in right of their Wives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35aabd74-d8c5-3beb-825c-968e053654c3",
                                        "entry_id": "3bbc1ab8-7803-3566-94ed-f76d27351eb5",
                                        "glosses": [
                                            "A person of high rank."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c213bfa-65bc-4e84-9ab0-7c4f4032aa18",
                                                "sense_id": "35aabd74-d8c5-3beb-825c-968e053654c3",
                                                "text": "I indicated a chair, and he sat down. This grandee was the grandson of an American of considerable note in his day, and not wholly forgotten yet,—a man who came so near being a great man that he was quite generally accounted one while he lived."
                                            },
                                            {
                                                "example_id": "bd9c2b49-d661-4213-b2dc-4f39b60a8882",
                                                "sense_id": "35aabd74-d8c5-3beb-825c-968e053654c3",
                                                "text": "Whereupon most did desist; but some, secreting their cigars in the hollow of their hands, took whiffs by stealth, and blushed to find it fame; while others, who were such grandees and big pots that their own convenience was the first and foremost desideratum, continued to smoke with lordliness and indifference."
                                            },
                                            {
                                                "example_id": "438b3f23-55ae-47a0-b7c4-5a26333c7c37",
                                                "sense_id": "35aabd74-d8c5-3beb-825c-968e053654c3",
                                                "text": "For some DSA grandees, like NYC chapter co-chair Bianca Cunningham, socialism means a planned economy that replaces market capitalism."
                                            },
                                            {
                                                "example_id": "73bb7a6f-fdeb-4242-b044-4952d3cb2d34",
                                                "sense_id": "35aabd74-d8c5-3beb-825c-968e053654c3",
                                                "text": "It is hard to see a good ending to the story of Peng Shuai, a Chinese tennis champion who on November 2nd accused a former Communist Party grandee more than twice her age of subjecting her to a coercive sexual relationship."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
