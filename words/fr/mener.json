                },
                {
                    "sense_id": "05a57527-0058-3234-b6eb-35aff808ad1c",
                    "sense_definition": "Influencer fortement quelqu'un, le diriger selon sa volonté ou le manipuler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son patron autoritaire cherche constamment à le <w>mener</w> à sa guise."
                        },
                        {
                            "text": "Ce conseiller habile parvient facilement à <w>mener</w> son entourage selon sa volonté."
                        }
                    ],
                    "synonyms": [
                        "dominer",
                        "influencer",
                        "manipuler"
                    ],
                    "common_phrases": [
                        "mener à sa guise"
                    ]
                }
            ]
        }
    ]
