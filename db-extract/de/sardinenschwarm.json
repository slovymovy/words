                "senses": [
                    {
                        "sense_id": "4465ace8-a135-366f-a37b-fb5683e6cf89",
                        "entry_id": "ee57de5a-6159-3b78-95ff-6f7bc6ec525a",
                        "glosses": [
                            "Schar von Sardinen; Gruppe von Sardinen, deren Mitglieder sich untereinander nicht individuell kennen, die aber gemeinsam einen Superorganismus bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35429c35-c8cf-43d8-a18e-cda94ac09bbf",
                                "sense_id": "4465ace8-a135-366f-a37b-fb5683e6cf89",
                                "text": "„Die Riesenhaftigkeit der Sardinenschwärme zeugt davon, wie groß der Überlebensspielraum bemessen ist.“"
                            },
                            {
                                "example_id": "e0aa3677-3c6c-4640-bed8-2008e8e258b3",
                                "sense_id": "4465ace8-a135-366f-a37b-fb5683e6cf89",
                                "text": "„Doch nun warnen Forscher im Journal \"PNAS\", dass ein neuer Kollaps der Sardinenschwärme bevorsteht.“"
                            }
                        ],
