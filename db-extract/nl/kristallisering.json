                "senses": [
                    {
                        "sense_id": "1842e00e-f8ff-310f-9af3-54e9f544bbcd",
                        "entry_id": "bf3a3ed8-0f01-3f2b-a94e-7e923b5a498d",
                        "glosses": [
                            "proces waarbij een vaste stof met spontaan gevormde symmetrieën ontstaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67989b02-3788-445e-8b57-850756dca5bb",
                                "sense_id": "1842e00e-f8ff-310f-9af3-54e9f544bbcd",
                                "text": "Het water stroomt in het apparaat langs twee positief geladen platen, waardoor de- kalk- en magnesiumdeeltjes tot heel kleine kristallen worden omgevormd. Bij verwarming van het water treedt geen verdere kristallisering meer op."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebc5c3ac-71ac-3836-b474-a5353d003b6b",
                        "entry_id": "bf3a3ed8-0f01-3f2b-a94e-7e923b5a498d",
                        "glosses": [
                            "proces waarin iets een duidelijke vast vorm krijgt, of het resultaat van zo'n proces"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c1e39371-c91f-480c-81d3-a029c6d3e059",
                                "sense_id": "ebc5c3ac-71ac-3836-b474-a5353d003b6b",
                                "text": "De overheersende tegenstelling in de politiek tussen conservatieven en liberalen bleef wel herkenbaar, maar kristalliseerde vooreerst bij lange na niet in duidelijke partijvorming, niet in het parlement en zeker ook niet daarbuiten. Dit nog afgezien van het feit dat de religieuze factor zo'n kristallisering in louter conservatieven en liberalen nagenoeg onmogelijk maakte."
                            }
                        ]
                    }
