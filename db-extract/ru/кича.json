                "senses": [
                    {
                        "sense_id": "43a894eb-a572-35c9-8af3-b2b103cc1e32",
                        "entry_id": "f22cb58f-3145-3ff3-8bb5-6fde21f07965",
                        "glosses": [
                            "крим. жарг. место лишения свободы, тюрьма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b669e355-e664-4cb1-bdc4-0999f8cb573c",
                                "sense_id": "43a894eb-a572-35c9-8af3-b2b103cc1e32",
                                "text": "— Эх, Тихонов, миляга мой расчудесный, если бы ты только знал, как мне неохота лезть в кичу по‑новому!"
                            },
                            {
                                "example_id": "6be37e49-7c14-4444-8a16-b7c2945eeb10",
                                "sense_id": "43a894eb-a572-35c9-8af3-b2b103cc1e32",
                                "text": "Сразу спрашивали, когда я с кичи откинулся и когда ссучиться успел."
                            }
                        ]
                    }
                ],
