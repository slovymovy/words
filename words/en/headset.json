                {
                    "sense_id": "f308fbb9-3c56-3b3d-8dce-8da2d2646fdd",
                    "sense_definition": "A pair of headphones or earphones, typically with an attached microphone, used for communication or listening to audio.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The customer service representative wore a wireless <w>headset</w> to talk to clients while typing.",
