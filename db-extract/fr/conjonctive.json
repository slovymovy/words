                        ],
                        "examples": [
                            {
                                "example_id": "199976fb-08ce-484d-96a5-8cd692642c62",
                                "sense_id": "03716d96-443c-36e0-876b-c2ec1e7f6ad3",
                                "text": "La locution conjonctive « parce que » produit un effet magique."
                            }
                        ]
                    }
