                                                "sense_id": "a0b1c6f9-769a-34fc-a73e-97b6da7dd2a0",
                                                "text": "Asking him for money is a waste of time: he won't give you any."
                                            },
                                            {
                                                "example_id": "97a62195-7bd0-4d2c-8814-c216d673bea5",
                                                "sense_id": "a0b1c6f9-769a-34fc-a73e-97b6da7dd2a0",
                                                "text": "Sit and try for the big kill.\nA waste of time, sitting still."
