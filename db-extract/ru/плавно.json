                                            {
                                                "example_id": "683419e4-fdfb-4b57-845d-953bbe7957b9",
                                                "sense_id": "18063cb4-231d-3af9-bed8-17867fcaf632",
                                                "text": "Quand vous soulèverez ce meuble, allez-y bien en douceur."
                                            },
                                            {
                                                "example_id": "6523dbca-4acc-4a90-be10-a8cec2a5bf77",
                                                "sense_id": "18063cb4-231d-3af9-bed8-17867fcaf632",
                                                "text": "Il cherche à traiter en douceur cette affaire difficile."
                                            },
                                            {
                                                "example_id": "363bb05d-6b90-41fe-9e75-503e5c896b22",
                                                "sense_id": "18063cb4-231d-3af9-bed8-17867fcaf632",
                                                "text": "Prendre les choses en douceur. — Ne point se formaliser de ce qu’il peut y avoir de désobligeant dans les procédés ou les discours d’autrui."
                                            },
                                            {
                                                "example_id": "7c8a3f70-a091-477e-9d16-70354020015b",
                                                "sense_id": "18063cb4-231d-3af9-bed8-17867fcaf632",
                                                "text": "C’est pourquoi je vous conseille cette stratégie de diminution en douceur avec des substituts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
