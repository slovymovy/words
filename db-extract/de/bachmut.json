                                        "glosses": [
                                            "A city, the administrative centre of Bakhmut Raion, Donetsk Oblast, Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee434290-1c36-457a-a676-6dfcb8d7ebc1",
                                                "sense_id": "c79dd29f-3af0-3b1d-af31-92c8c99ac8e1",
                                                "text": "Moscow also appeared to be building up forces and increasing its military efforts on the eastern Donbas front around the key town of Bakhmut."
                                            },
                                            {
                                                "example_id": "0a85bbd4-05d7-4449-8466-ce547c1b3321",
                                                "sense_id": "c79dd29f-3af0-3b1d-af31-92c8c99ac8e1",
                                                "text": "The armoured unit has been operating for months in defence of Bakhmut city, but incomer Danill, a junior tank commander, has yet to see the fierce combat there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876ac4ec-a13d-3670-8d91-89e7d110a67c",
