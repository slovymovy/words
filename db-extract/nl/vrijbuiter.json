                    {
                        "sense_id": "d96f61a6-ffd8-3db1-acd5-aca8be50a8df",
                        "entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
                        "glosses": [
                            "een zeerover die niet zijn buit grotendeels zoals een kaper aan de staat afstond, maar vrijelijk op de markt verkocht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0274730-cadf-496d-9189-ab2435829bcb",
                                "sense_id": "d96f61a6-ffd8-3db1-acd5-aca8be50a8df",
                                "text": "Kapers werden vaak vrijbuiters als hun dat uitkwam, zodat het verschil niet zo groot was."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ee17da4-3a08-30ee-b785-293e6e888ee1",
                        "entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
                        "glosses": [
                            "iemand die niet vies is van een beetje avontuur, een avonturier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c27f59-3f0e-4407-bf7e-ad605facf571",
                                "sense_id": "1ee17da4-3a08-30ee-b785-293e6e888ee1",
                                "text": "Oh, die? Dat was altijd al een vrijbuiter!"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f1f4d87-0e75-3057-89f4-815e2b6d2a4c",
                        "entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
                        "glosses": [
                            "een klassieke, houten zeilboot"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d681190c-49bc-4614-955b-0c897d082d42",
                        "source_entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
                        "source_sense_id": "d96f61a6-ffd8-3db1-acd5-aca8be50a8df",
                        "source_sense_description": "een zeerover",
                        "target_lang_word": "Freibeuter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freibeuter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0ad185c-fc84-309d-b024-0bfc6b256615",
                                        "entry_id": "8e02dce3-3ebd-33d7-9183-cf2ac1c6d6e7",
                                        "glosses": [
                                            "ein Kaperfahrer, der von einer Regierung per Kaperbrief die Erlaubnis bekommt, feindliche Schiffe auf hoher See aufzubringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709ba0c0-e1d5-474c-8ac8-dcf63601cfb6",
                                                "sense_id": "b0ad185c-fc84-309d-b024-0bfc6b256615",
                                                "text": "„…denn solche wollten wir von nun an sein und keine Freibeuter, die wir in Wirklichkeit gewesen waren.“"
                                            },
                                            {
                                                "example_id": "4e032422-da68-400d-9c4b-e41b22ab17c1",
                                                "sense_id": "b0ad185c-fc84-309d-b024-0bfc6b256615",
                                                "text": "„Der einzige Unterschied zwischen einem Piraten und einem Freibeuter ist der Kaperbrief Seiner Majestät, die auch einen großen Anteil des Gewinns kassiert.“"
                                            },
                                            {
                                                "example_id": "804f9fbc-e889-4f66-bf60-dfadb79119e5",
                                                "sense_id": "b0ad185c-fc84-309d-b024-0bfc6b256615",
                                                "text": "„Zahllose Geschichten über diese blutrünstigen Freibeuter waren während langer Wachen auf See erzählt und immer wieder genüsslich ausgewalzt worden.“"
                                            },
                                            {
                                                "example_id": "cae4a1b0-dbcb-46fd-aa9c-7cb3c29196db",
                                                "sense_id": "b0ad185c-fc84-309d-b024-0bfc6b256615",
                                                "text": "„Die meisten Häftlinge waren Freibeuter, es gab aber auch ein paar Soldaten und einige Zivilisten, die in der Chesapeake Bay aufgelesen worden waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1567e4ec-4b70-42ad-8a7c-7c47945f16b4",
                        "source_entry_id": "f125baa1-5dae-3028-afdb-d0a231ddbb13",
