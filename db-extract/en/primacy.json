                        "entry_id": "08aab4e8-4e29-31eb-b63d-5b41caaab71e",
                        "glosses": [
                            "The state or condition of being prime or first, as in time, place, rank, etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5269d1e3-3d65-4c13-8c57-3f625f936811",
                                "sense_id": "3730fd9e-cfd0-3b66-a967-d1f862deb1b2",
                                "text": "I am reading Nick Sousanis’ PhD dissertation-as-a-comic Unflattening. It debunks the primacy of word over image in Western culture and suggests that the two are equal partners in meaning-making."
                            }
                        ]
                    },
                    {
                        "sense_id": "e64d0e09-f824-381f-9e26-2d60354ec9dd",
                        "entry_id": "08aab4e8-4e29-31eb-b63d-5b41caaab71e",
                        "glosses": [
                            "Excellence; supremacy."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "920da6cb-1ccc-328d-bfe1-12e67f720fd9",
                        "entry_id": "08aab4e8-4e29-31eb-b63d-5b41caaab71e",
                        "glosses": [
                            "The office, rank, or character of a primate, it being the chief ecclesiastical station or dignity in a national church."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "40c37a91-6639-4952-8bd9-5f2f3bc5533c",
                                "sense_id": "920da6cb-1ccc-328d-bfe1-12e67f720fd9",
                                "text": "Ecumenical Patriarch Bartholomew of Constantinople, who holds a primacy of honor in Eastern Orthodoxy, emphasized the many areas of agreement between Pope Francis and himself in response to the social concerns of the day."
                            }
                        ]
                    },
                    {
                        "sense_id": "575afbcf-6bfc-3b4d-8311-aca51b1d0094",
                        "entry_id": "08aab4e8-4e29-31eb-b63d-5b41caaab71e",
                        "glosses": [
                            "The office or dignity of an archbishop."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
