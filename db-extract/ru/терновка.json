                "senses": [
                    {
                        "sense_id": "d5fd8eb0-09f0-3336-8a79-55b5b0ab28ca",
                        "entry_id": "f64c13a1-d3f1-311e-b84a-f36aa60dcbe4",
                        "glosses": [
                            "наливка из терновника"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cb01db2-755c-4816-a954-28feb9720fde",
                                "sense_id": "d5fd8eb0-09f0-3336-8a79-55b5b0ab28ca",
                                "text": "Какой угодно нынче наливки? Терновки или сливянки? ― И той, и другой, если позволите."
                            },
                            {
                                "example_id": "3c71678e-0f71-4c9a-8389-0ac1b41dc2dc",
                                "sense_id": "d5fd8eb0-09f0-3336-8a79-55b5b0ab28ca",
                                "text": "Терновка, вишневка, дулевка, рябиновка и другие наливки на домашнем хлебном вине, изредка вина сикийское, монастырийское и волошское услаждали неразборчивый вкус так же, как позже вина венгерские, рейнские и французские."
                            }
                        ]
                    }
