                    {
                        "sense_id": "455c2b9d-7440-3f8c-b78d-dc297a754388",
                        "entry_id": "f63066df-317b-3d4d-9801-9a7560878ab5",
                        "glosses": [
                            "affluent neglect"
                        ],
