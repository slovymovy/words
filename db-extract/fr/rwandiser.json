                "senses": [
                    {
                        "sense_id": "188313fe-0d50-3f65-833d-9fa996f1077f",
                        "entry_id": "44e9c1b8-1f22-3ce2-bc85-4a314fd08a89",
                        "glosses": [
                            "Donner un caractère rwandais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "403cad40-1a32-49f3-982a-1ed0b3faa30e",
                                "sense_id": "188313fe-0d50-3f65-833d-9fa996f1077f",
                                "text": "Selon lui, les libéraux ambitionnent d'«ivoiriser», de «burundiser» ou de «rwandiser» le Sénégal, mais ils n'y parviendront pas."
                            },
                            {
                                "example_id": "c8ed3f6b-fa5f-4353-9fe9-a8bf32b1af36",
                                "sense_id": "188313fe-0d50-3f65-833d-9fa996f1077f",
                                "text": "Des tribalistes primaires veulent «rwandiser» le Cameroun."
                            },
                            {
                                "example_id": "bbaba280-d021-42d1-8097-9efbf0cb72c9",
                                "sense_id": "188313fe-0d50-3f65-833d-9fa996f1077f",
                                "text": "Attention sénégalais les toukouleurs risquent de rwandiser votre pays."
                            }
                        ]
                    }
