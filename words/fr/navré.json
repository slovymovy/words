                    "frequency": "Low",
                    "semantic_group_id": "tristesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle avait un regard <w>navré</w> en découvrant les dégâts causés par la tempête."
                        },
                        {
                            "text": "Face à cette injustice cruelle, son cœur resta profondément <w>navré</w> durant des semaines."
                        }
                    ],
                    "synonyms": [
