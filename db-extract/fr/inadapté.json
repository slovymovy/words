                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fae3ef23-e1b0-3db7-ada2-07ae0990c611",
                                        "entry_id": "04f6c4f4-44e8-384e-8c41-7794ab5c6a78",
                                        "glosses": [
                                            "An ill-fitting garment."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0492607a-b301-4790-a2c7-201f2fe047e3",
                                                "sense_id": "fae3ef23-e1b0-3db7-ada2-07ae0990c611",
                                                "text": "Mr Toots’s legs shake under him; and though he is splendidly dressed, he feels misfits, and sees wrinkles, in the masterpieces of Burgess and Co., and wishes he had put on that brightest pair of boots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ba275d8-a233-3d50-9d9d-052e420bee3e",
                                        "entry_id": "04f6c4f4-44e8-384e-8c41-7794ab5c6a78",
                                        "glosses": [
                                            "A failure to fit well; unsuitability, disparity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a79ca6f-8955-4b69-bbd3-ee36e431a1ad",
                                                "sense_id": "3ba275d8-a233-3d50-9d9d-052e420bee3e",
                                                "text": "And the fact that Christianity's Jesus is the resurrected Christ makes a vital point about the misfit between the Jesus whose teachings we have excavated and the Church which came after him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f62dccc-5ae0-3aae-97a3-51e77e52bec0",
                                        "entry_id": "04f6c4f4-44e8-384e-8c41-7794ab5c6a78",
                                        "glosses": [
                                            "A badly adjusted person; someone unsuitable or set apart because of their habits, behaviour etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5183394-4325-4787-820e-267674c88e8c",
                                                "sense_id": "3f62dccc-5ae0-3aae-97a3-51e77e52bec0",
                                                "text": "Do you ever feel like a misfit?\nEverything inside you is dark and twisted\nOh, but it's okay to be different\n'Cause baby, so am I"
                                            },
                                            {
                                                "example_id": "9ab8cbaf-ab94-46ac-aabb-0f325b888e39",
                                                "sense_id": "3f62dccc-5ae0-3aae-97a3-51e77e52bec0",
                                                "text": "Just to be on the safe side, the Kremlin has also banned any of Putin's serious critics from standing. Three unelectable misfits have been allowed to mount token challenges."
                                            },
                                            {
                                                "example_id": "1c940485-37a8-492a-b0cb-4f1ad6e4c533",
                                                "sense_id": "3f62dccc-5ae0-3aae-97a3-51e77e52bec0",
                                                "text": "She was very unhappy in Iraq and a misfit in the Army."
                                            },
                                            {
                                                "example_id": "5db2328e-27fb-4f97-8652-b216f4ec64f0",
                                                "sense_id": "3f62dccc-5ae0-3aae-97a3-51e77e52bec0",
                                                "text": "The MBA was a misfit when stuck in a meeting with the programmers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misfit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5f9b3cf-557d-3b85-9d98-94fcddae07fe",
                                        "entry_id": "77f8c4a1-ef7f-3376-b78e-ba5a658a4335",
