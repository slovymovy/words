                        "entry_id": "b8057eba-a8bf-37f5-94bb-4eb90ad3607f",
                        "glosses": [
                            "Person, die ein Schisma ausgelöst hat/in eine Glaubensspaltung involviert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f322353-c4cf-4701-8d1d-b1e6e579baba",
                                "sense_id": "9d9f998b-e0e7-3a02-bba9-32f4cbacb9b1",
                                "text": "Das Abendland war kirchlich gespalten und der Papst bekämpfte den Kaiser als Schismatiker."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fe039337-2f6a-337c-887e-0643b27987e6",
                        "entry_id": "b8057eba-a8bf-37f5-94bb-4eb90ad3607f",
                        "glosses": [
                            "Anhänger einer Glaubensgemeinschaft, die sich von einer etablierten Glaubensgemeinschaft abgespalten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58d3986-f35b-4606-b551-fe905d9d8488",
                                "sense_id": "fe039337-2f6a-337c-887e-0643b27987e6",
                                "text": "Ein Schismatiker konnte sich bekehren und einen Eid schwören, dem Schisma nicht länger anzugehören."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
