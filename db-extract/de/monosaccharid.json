                ],
                "senses": [
                    {
                        "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                        "entry_id": "8fd0e6cd-aba9-3df9-a0c6-da4a4d12cdfd",
                        "glosses": [
                            "eine organisch-chemische Verbindung, welche mindestens drei Kohlenstoffatome, eine Carbonylfunktion und mindestens eine Hydroxygruppe enthält; ein Polyhydroxycarbonyl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15fee43f-dc3b-48db-9d91-e8ab86ff7afd",
                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                "text": "Glucose, der Traubenzucker, ist einer der bekanntesten Vertreter der Monosaccharide."
                            },
                            {
                                "example_id": "dbcc5f63-c21b-408f-b54c-36b7955f7f49",
                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                "text": "„Das am weitesten verbreitete Monosaccharid ist Glucose.“"
                            },
                            {
                                "example_id": "b237e213-f25b-4f81-93e7-dcf49c7a3e8c",
                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                "text": "„Die auch als Fruchtzucker bezeichnete Fructose ist ein weiteres, in süßen Früchten und im Honig vorkommendes Monosaccharid.“"
                            },
                            {
                                "example_id": "f5897d01-b167-4723-8ce5-2413cd5da6d8",
                                "sense_id": "ecaac5a2-9f21-398f-9314-7a6d4feceb90",
                                "text": "„Man unterscheidet einfache, nicht weiter spaltbare Monosaccharide (z. B. Traubenzucker, Fruchtzucker) und Disaccharide, die aus zwei Monosacchariden zusammengesetzt sind (z. B. Rohrzucker, Rübenzucker, Milchzucker, Malzzucker).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a92ca67-998c-42a3-96b1-7f6a776d96b6",
