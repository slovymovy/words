                                        "examples": [
                                            {
                                                "example_id": "b07b87e9-5d0e-4ac2-894c-9e3d02d0fbe2",
                                                "sense_id": "f3970760-3177-3bf4-97e7-64e34cce4f43",
                                                "text": "„Erzählte Tochter Graciela auch, der Präsident und Papa habe Tränen in den Augen gehabt, als die ‚Electra‘ der paraguayanischen Luftlinie Münchner Boden berührte, so besann sich der seit 19 Jahren eisern amtierende Präsident angesichts des schwergewichtigen Begrüßungskommandos (Bayerns Ministerpräsident Alfons Goppel als Bundesratspräsident und Außenminister Walter Scheel) schnell jenes Anliegens, das ihn in die Bundesrepublik geführt hat.“"
                                            },
                                            {
                                                "example_id": "81c70e07-a4e5-46d4-8379-88053a2f128c",
                                                "sense_id": "f3970760-3177-3bf4-97e7-64e34cce4f43",
                                                "text": "„Zur Sicherheit nahm Weber die paraguayanische Staatsbürgerschaft an.“"
                                            },
                                            {
                                                "example_id": "1c43fa84-0e22-4397-894c-fa589b43ff50",
                                                "sense_id": "f3970760-3177-3bf4-97e7-64e34cce4f43",
                                                "text": "„Der Strom ist dort sehr breit, durch verschiedene Inseln in mehr oder weniger seichte Arme getheilt, und bietet nur längs der paraguayanischen Batterie ein verhältnißmäßig schmales Fahrwasser dar.“"
                                            },
                                            {
                                                "example_id": "0ba8e37b-a22f-482b-b948-77d4bee0d8e2",
                                                "sense_id": "f3970760-3177-3bf4-97e7-64e34cce4f43",
                                                "text": "„Damals hatte er nach Zeitungsberichten angeblich einen bolivianischen Pass, heute soll er laut ‚Kurier‘ österreichischer und paraguayanischer Staatsbürger sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
