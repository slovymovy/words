                "senses": [
                    {
                        "sense_id": "042c9427-a6c7-3697-9c7c-5d74ecff0062",
                        "entry_id": "54e154fd-b7b3-3904-8bad-6b6d6e60c312",
                        "glosses": [
                            "Variante orthographique de Adventskalender, calendrier de l’Avent."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0b67a4d5-fa4a-481d-9928-1478d6a123d0",
                                "sense_id": "042c9427-a6c7-3697-9c7c-5d74ecff0062",
                                "text": "Eines der Zeichen ist der Adventkalender, der von einem gewissen Gerhard Lang ‚erfunden‘ worden sein soll."
                            },
                            {
                                "example_id": "c2b332b5-f681-47f4-a75b-b73432f22618",
                                "sense_id": "042c9427-a6c7-3697-9c7c-5d74ecff0062",
                                "text": "Hinter jedem geöffneten Fenster sollte – wenn der Adventkalender seinen Namen zu Recht trägt – ein vorweihnachtlicher Gedanke, eine Anregung zum sorgfältigen Umgang miteinander oder auch ein Hinweis auf Heiligenfeste im Advent stehen.“"
                            }
                        ]
                    }
                ],
