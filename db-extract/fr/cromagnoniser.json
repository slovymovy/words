                "senses": [
                    {
                        "sense_id": "1fc90f68-6ee1-382d-82d9-e727f1a8fd1e",
                        "entry_id": "5aa87f5a-1c17-379d-a43e-abb232c7fad0",
                        "glosses": [
                            "Donner des caractéristiques rappelant l’homme de Cro-Magnon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a1767a5-8785-4d38-a73a-a55b9aa912cb",
                                "sense_id": "1fc90f68-6ee1-382d-82d9-e727f1a8fd1e",
                                "text": "Mon homme est à moi pas besoin de se cromagnoniser pour que je le sache."
                            },
                            {
                                "example_id": "a9bb873c-8a62-401a-819c-33eb74cab517",
                                "sense_id": "1fc90f68-6ee1-382d-82d9-e727f1a8fd1e",
                                "text": "D'ailleurs avoir un mec comme Tony à ses côtés depuis près de 4 ans, tu finis par prendre des habitudes et te cromagnoniser."
                            },
                            {
                                "example_id": "d58a49c4-5247-4d5b-bc50-6bc49c709b17",
                                "sense_id": "1fc90f68-6ee1-382d-82d9-e727f1a8fd1e",
                                "text": "Rien qu'en lisant votre prose, j'ai envie de cromagnoniser à mort."
                            }
                        ]
                    }
