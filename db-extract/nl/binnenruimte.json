                        "glosses": [
                            "ruimte binnen een gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c79a0a84-f5c6-4095-b823-e62589a9179a",
                                "sense_id": "3c2baca2-f002-3f06-b67c-902a6ae3c5c9",
                                "text": "De PVV-leider kwam terug op het dringend advies dat het kabinet geeft om per direct een mondkapje te dragen op veel meer plekken in heel Nederland. Volgens Wilders melden veel media niet dat het alleen om publieke binnenruimtes gaat, dus niet buiten."
                            },
                            {
                                "example_id": "cd72b8fa-baaf-4d64-a5aa-b4cb8fed1284",
                                "sense_id": "3c2baca2-f002-3f06-b67c-902a6ae3c5c9",
                                "text": "Maandag kwam het dringende advies om ze te dragen in onder meer drukke winkels in Amsterdam, Rotterdam en Den Haag. Later kwam daar Eindhoven bij en het advies werd landelijk uitgebreid naar alle binnenruimten, behalve scholen. Weer een dag later gold dat advies alsnog voor scholen."
                            }
                        ]
                    }
