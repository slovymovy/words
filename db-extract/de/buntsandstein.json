                ],
                "senses": [
                    {
                        "sense_id": "919baae7-45a6-361d-8f12-9f97e2b8416b",
                        "entry_id": "12e90fd9-079b-34db-a52b-44fbe39dfa41",
                        "glosses": [
                            "eine durch meist rötliche Sandsteine gekennzeichnete Abfolge geologischer Schichten der Unteren Trias von Mitteleuropa"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "02c27b9d-bf62-4f3f-9905-2dd444a6849e",
                                "sense_id": "919baae7-45a6-361d-8f12-9f97e2b8416b",
                                "text": "„Der Frankenwald hat für den Buntsandstein kein Sedimentmaterial geliefert; denn die ihn aufbauenden Gesteine sind zu feinkörnig und zu feldspatarm, als dass sie die sehr groben Arkosen des Buntsandsteins geliefert haben könnten.“"
                            },
                            {
                                "example_id": "589a761c-e780-4194-bcd4-c151565eef35",
                                "sense_id": "919baae7-45a6-361d-8f12-9f97e2b8416b",
                                "text": "„Die Lange Anna ist ein 47 Meter hoher Brandungspfeiler im äußersten Nordwesten der deutschen Nordseeinsel Helgoland. Er ist etwa 25.000 Tonnen schwer, aus rotem Buntsandstein […].“"
                            },
                            {
                                "example_id": "8837fb4b-ca07-46be-9ac5-f9e603cb1865",
                                "sense_id": "919baae7-45a6-361d-8f12-9f97e2b8416b",
                                "text": "„Heute ist die Bezeichnung Buntsandstein jedoch nur mehr für die untere der drei lithostratigraphischen Gruppen der Germanischen Trias gültig, nicht mehr jedoch als Begriff für die Zeiteinheit der Untertrias.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "056a844d-d0bf-3249-b3b6-21f5f842d5c9",
                        "entry_id": "12e90fd9-079b-34db-a52b-44fbe39dfa41",
                        "glosses": [
                            "als Baustein verwendeter Sandstein aus dieser Abfolge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eadbde48-d61b-4738-b10f-30ea6dcd9515",
                                "sense_id": "056a844d-d0bf-3249-b3b6-21f5f842d5c9",
                                "text": "„Denn der »Stein«, den die beiden Schüler entdeckten, war ein keltischer Menhir, eine Stele aus Buntsandstein, die in der Hallstattzeit einen Grabhügel gekrönt hatte.“"
                            },
                            {
                                "example_id": "813a7ec4-748d-4adb-9ecf-b8f60dc33dd1",
                                "sense_id": "056a844d-d0bf-3249-b3b6-21f5f842d5c9",
                                "text": "„Lediglich versteckt hinter einer Baumgruppe steht eine größere Ruine aus Buntsandstein, die von Efeu und Brombeeren überrankt wird. Dies muß das Haus sein, das der Professor beschrieben hat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
