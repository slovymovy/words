                "translations": [
                    {
                        "translation_id": "4e87ac1d-93c0-4748-b088-22cfc0b5ee2f",
                        "source_entry_id": "fb1e6933-723f-377e-9d33-c52c9a08d9f7",
                        "source_sense_description": "of hair: to form into a mass of curls",
                        "target_lang_word": "kräuseln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kräuseln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05233219-2545-3be0-afe9-0d9ac20c9525",
                                        "entry_id": "f085f3e2-c475-3ede-9b40-4e1fe12428aa",
                                        "glosses": [
                                            "sich ringeln und spitzig werden, etwas zarte Wellen entstehen lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed515e6-fda1-41cd-afdc-324fa1a50658",
                                                "sense_id": "05233219-2545-3be0-afe9-0d9ac20c9525",
                                                "text": "Dieses Haarpflege-System verstärkt die Locken und verhindert, dass die Haare sich kräuseln."
                                            },
                                            {
                                                "example_id": "2366af0a-94aa-4ea6-ad5d-cd88c0a50b8f",
                                                "sense_id": "05233219-2545-3be0-afe9-0d9ac20c9525",
                                                "text": "Die Oberfläche des Sees kräuselt sich im Wind."
                                            },
                                            {
                                                "example_id": "3d7b9bd1-08e2-4f5f-a1cc-b2c0477025ff",
                                                "sense_id": "05233219-2545-3be0-afe9-0d9ac20c9525",
                                                "text": "Da plötzlich schimmert ein See durch die zitternde, wellenschlagende Luft, kühle Winde scheinen sein Wasser zu kräuseln - eine Täuschung, es ist die Fata-Morgana, die ihr Spiegelbild zeigt. (Quelle: Gerhard Rohlfs - Quer durch Afrika / 6. Kapitel: Ankunft in Fesan)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5431d0ca-d038-3db1-b4bd-ab3cb6570c9e",
                                        "entry_id": "f085f3e2-c475-3ede-9b40-4e1fe12428aa",
                                        "glosses": [
                                            "etwas in lockere Falten legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c934728-2a4a-42f9-be09-a79a99d7d9a8",
                                                "sense_id": "5431d0ca-d038-3db1-b4bd-ab3cb6570c9e",
                                                "text": "Sie kräuselte ihre Lippen in Aufregung."
                                            },
                                            {
                                                "example_id": "36f5884e-c3a3-442b-9bd0-5916a8b1f8e7",
                                                "sense_id": "5431d0ca-d038-3db1-b4bd-ab3cb6570c9e",
                                                "text": "Zunächst soll man die Teigblätter kräuseln und dann mit der Joghurt-Sauce beträufeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a94eb109-9600-4682-a51f-7d2b61fedf79",
