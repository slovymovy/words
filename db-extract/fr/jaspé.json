                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a4c77da-563a-3d8c-92cd-e3c9b09ba4c9",
                                        "entry_id": "4c035a15-7370-3501-b692-be79a831bbfa",
                                        "glosses": [
                                            "Streaked; variegated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034417c0-b2c1-4269-8dc3-2a8f712f103c",
                                                "sense_id": "3a4c77da-563a-3d8c-92cd-e3c9b09ba4c9",
                                                "text": "He, too, like the advancing Guard and the ground on which he knelt, was patterned jaspé in black shadow and silvery white."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaspé",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfb8b2d-8adb-36f1-b8b6-57c82bace90c",
                                        "entry_id": "5e55fa4a-7abc-35b6-94b8-77646f96818e",
                                        "glosses": [
                                            "A shaded, plainweave type of cloth, embroidered or similarly printed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b641b5d-d725-4924-a043-0bc17945f439",
                                                "sense_id": "6cfb8b2d-8adb-36f1-b8b6-57c82bace90c",
                                                "text": "Jaspé is mainly used for curtains and bedspreads."
                                            },
                                            {
                                                "example_id": "eab64c80-05d3-4add-b667-56664912f550",
                                                "sense_id": "6cfb8b2d-8adb-36f1-b8b6-57c82bace90c",
                                                "text": "The stripes in the last fabric in this collection emulate jaspé. The tecnique used to produce real jaspé stripes is lengthy: the warps are measured, tied to resist the dye in some places, and then put into a dyebath and the dye fixed; the warp is then dried and taken to the loom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
