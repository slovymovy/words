                        {
                            "text": "Voici exactement <w>ce</w> dont nous avons besoin pour ce travail."
                        }
                    ],
                    "common_phrases": [
                        "ce qui",
                        "ce que",
                        "ce dont"
                    ]
                }
            ]
        },
