                "senses": [
                    {
                        "sense_id": "b794e58e-c4a9-3352-b367-f1a9be0bab11",
                        "entry_id": "2dac105e-29b0-34c0-9082-d5dd47494a3d",
                        "glosses": [
                            "jemand, auf dessen fachkundige Aussage, Auskunft man sich beziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f75d776-aeb9-47a4-8baa-e98933a3980d",
                                "sense_id": "b794e58e-c4a9-3352-b367-f1a9be0bab11",
                                "text": "„Befragt, woher sie die Gewißheit nehmen, daß ein bestimmtes Land unbedenklich sei, verweisen die Reiseunternehmen auf ihre Gewährsmänner am Ort. Die, heißt es, könnten die Situation recht gut einschätzen.“"
                            },
                            {
                                "example_id": "7b63e9e4-27ee-452c-828f-cb9f4cb08869",
                                "sense_id": "b794e58e-c4a9-3352-b367-f1a9be0bab11",
                                "text": "„Auch wenn Kyot ein mündlicher Gewährsmann wäre, dürfte sich der Provenzale in französischer Sprache mit Wolfram unterhalten haben.“"
                            },
                            {
                                "example_id": "4ea9c49f-35fa-4e1c-9237-f65bbedd6e4f",
                                "sense_id": "b794e58e-c4a9-3352-b367-f1a9be0bab11",
                                "text": "„Ich setzte großes Vertrauen in beide Gewährsleute, aber diese Sache klang zu verrückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
