                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "536e0e34-938b-4a4f-b650-0c2cd8a7877d",
                                "sense_id": "39e2045a-81cc-3865-8485-306d60389a2c",
                                "text": "Everton require at least 3 goals in the second leg to avoid elimination from the FA Cup."
                            },
                            {
