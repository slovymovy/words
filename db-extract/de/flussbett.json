                        "form": "die Flussbette"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                        "entry_id": "ff91fd18-54f7-3ce4-95c9-963f749d3a48",
                        "glosses": [
                            "Vertiefung im Boden, in der sich ein größeres Fließgewässer fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae3558d0-ed23-48c6-94f8-7261b1efa54b",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "Um den Hamburger Hafen auch für große Containerschiffe erreichbar zu machen, soll das Flussbett der Elbe weiter ausgebaggert werden."
                            },
                            {
                                "example_id": "2acb4596-793c-4534-a8dc-ad9ed7d91807",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Zur Schneeschmelze verwandelt sich das jetzt reglose Flussbett in einen Strom, der alles mitreißt, was er zu fassen bekommt.“"
                            },
                            {
                                "example_id": "07e2b31a-c2ff-41c3-8443-669e1afc13b7",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Es entstanden breite, aus zahlreichen Kiesbänken und verflochtenen Rinnsalen bestehende verwilderte Flussbetten, wie sie heute aus subpolaren oder hochalpinen Gebieten bekannt sind.“"
                            },
                            {
                                "example_id": "93b72fc7-1b99-4af9-a6c9-8cefcf57bcda",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Sie fuhren langsam zwischen den großen Bäumen an dem hohen Ufer entlang, das hier steil zu dem steinigen Flussbett abfiel.“"
                            },
                            {
                                "example_id": "fea77473-9c90-41b3-a0ab-1dd3a93390cd",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Céleste starrte auf das felsige Flussbett, das im Licht der Sterne aussah wie ein kochender, aschgrauer See.“"
                            },
                            {
                                "example_id": "e537ad36-9958-451c-884c-1ea11ae60d9c",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Damit der Abfluss gesichert ist, sollen die Flussbette ohne Bäume und Sträucher aufrechterhalten werden.“"
                            },
                            {
                                "example_id": "fd2368b3-c3cc-4a23-acc2-a93c4550c6f5",
                                "sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                                "text": "„Die Flußbette in der Lombardei, die beständig mit Schlamm und Steinen angefüllt werden, sind mehr oder weniger über der Ebene erhoben, und man kann beinahe sagen, daß sie auf einer Mauer sich befinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a57c97f-e11f-4a94-8079-ae3c3fca93e9",
                        "source_entry_id": "ff91fd18-54f7-3ce4-95c9-963f749d3a48",
                        "source_sense_id": "3a994ccd-7b70-33ae-a940-c5cad8f0b0a9",
                        "source_sense_description": "Vertiefung im Boden, in der sich ein größeres Fließgewässer fortbewegt",
                        "target_lang_word": "riverbed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riverbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb6c2684-b1e3-3bee-af00-aa10376468f6",
                                        "entry_id": "f2dc556a-3d1f-3405-8aca-119323129cc6",
                                        "glosses": [
                                            "The path where a river runs, or where a river once ran; the bottom earthen part of a river, not including the riverbanks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7e9cd1c-3c13-42d1-afb8-0e2216b17c40",
                                                "sense_id": "eb6c2684-b1e3-3bee-af00-aa10376468f6",
                                                "text": "Near-synonyms: streambed, creekbed"
                                            },
                                            {
                                                "example_id": "6ce784c4-b306-4844-9ec2-1a5f67285453",
                                                "sense_id": "eb6c2684-b1e3-3bee-af00-aa10376468f6",
                                                "text": "The Hang En tour involves a difficult daylong trek over limestone mountain paths and along riverbeds to the remote indigenous village of Ban Doong."
                                            },
                                            {
                                                "example_id": "863251f8-a74b-4962-96d7-ac9d1b276a7d",
                                                "sense_id": "eb6c2684-b1e3-3bee-af00-aa10376468f6",
                                                "text": "Detailed laser surveys carried out by Network Rail revealed that fast-flowing water on the River Eden has caused parts of the riverbed to wash away, posing a risk to the viaduct foundations."
                                            },
                                            {
                                                "example_id": "7cb88beb-bab1-4157-992c-fd8a9aece01a",
                                                "sense_id": "eb6c2684-b1e3-3bee-af00-aa10376468f6",
                                                "text": "Potential signs of microbial life were found in a rock sample collected by the rover in 2024 from an ancient dry riverbed on Mars' Jezero Crater -- an area of rocky outcrops on the edges the Neretva Vallis, a river valley carved by water rushing to the canyon billions of years ago, NASA officials announced in a press conference on Wednesday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
