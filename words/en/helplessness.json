{
    "word_family": [
        "help",
        "helper",
        "helpful",
        "helpfully",
        "helpfulness",
        "helpless",
        "helplessly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ef55f0b-a7a5-3669-b6ef-563e50775a9f",
                    "sense_definition": "The state or condition of being unable to defend, care for, or help oneself.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small child was left in a state of complete <w>helplessness</w> after getting lost in the crowd.",
                            "target_lang_translations": {
                                "es": "El niño pequeño quedó en un estado de completa <w>indefensión</w> tras perderse entre la multitud."
                            }
                        },
                        {
                            "text": "Severe injuries often result in prolonged periods of physical <w>helplessness</w> for patients.",
                            "target_lang_translations": {
                                "es": "Las lesiones graves a menudo resultan en períodos prolongados de <w>invalidez</w> física para los pacientes."
                            }
                        }
                    ],
                    "synonyms": [
                        "powerlessness",
                        "impotence",
                        "vulnerability"
                    ],
                    "antonyms": [
                        "strength",
                        "independence"
                    ],
                    "common_phrases": [
                        "state of helplessness"
                    ],
                    "target_lang_definitions": {
                        "es": "Estado o condición de no poder defenderse, cuidarse o valerse por uno mismo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "indefensión",
                                "target_lang_sense_clarification": "falta de defensa o amparo"
                            },
                            {
                                "target_lang_word": "desamparo",
                                "target_lang_sense_clarification": "situación de abandono o falta de ayuda"
                            },
                            {
                                "target_lang_word": "vulnerabilidad",
                                "target_lang_sense_clarification": "condición de fragilidad o riesgo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69203bdc-1918-3286-9c24-ace6121f6b3b",
                    "sense_definition": "An overwhelming feeling of inadequacy, despair, or lack of control over a situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was overwhelmed by a sense of <w>helplessness</w> as the floodwaters continued to rise.",
                            "target_lang_translations": {
                                "es": "Se vio abrumada por una sensación de <w>impotencia</w> a medida que las aguas de la inundación seguían subiendo."
                            }
                        },
                        {
                            "text": "Watching his friend suffer caused him a deep feeling of <w>helplessness</w> and grief.",
                            "target_lang_translations": {
                                "es": "Ver sufrir a su amigo le provocó un profundo sentimiento de <w>impotencia</w> y dolor."
                            }
                        }
                    ],
                    "synonyms": [
                        "despair",
                        "hopelessness"
                    ],
                    "antonyms": [
                        "confidence"
                    ],
                    "common_phrases": [
                        "sense of helplessness",
                        "feeling of helplessness",
                        "learned helplessness"
                    ],
                    "target_lang_definitions": {
                        "es": "Sentimiento abrumador de incapacidad, desesperación o falta de control sobre una situación."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "impotencia",
                                "target_lang_sense_clarification": "sentimiento de no poder hacer nada ante una situación"
                            },
                            {
                                "target_lang_word": "desesperanza",
                                "target_lang_sense_clarification": "pérdida de esperanza y desánimo"
                            },
                            {
                                "target_lang_word": "indefensión",
                                "target_lang_sense_clarification": "sensación de falta de control o recursos psicológicos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}