                        "entry_id": "cef84450-852d-3722-b432-931684a7f2af",
                        "glosses": [
                            "The use of a monetary standard based upon two different metals, traditionally gold and silver usually in a fixed ratio of values."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ace74b06-a83c-46c5-9b28-8daaa5e11baf",
                                "sense_id": "a6bd9fe3-f7c1-3ed2-99eb-9bb584b9be58",
                                "text": "As in China, bi-metallism exacerbated rural unrest in Nguyen Vietnam."
                            }
                        ]
                    }
                ],
                "translations": [
