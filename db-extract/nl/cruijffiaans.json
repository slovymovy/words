                        "glosses": [
                            "of or pertaining to Dutch football player Johan Cruyff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b0303c-8de8-4d3c-998e-6d9c74905806",
                                "sense_id": "6662bb05-1c20-31b8-af75-593c820cfc9a",
                                "text": "In de A-selectie van mijn club DEVJO was Cruijffiaans juichen, met trappelsprongetje en arm in de lucht, even goed voor een wissel.",
                                "translation": "In the first team of my club DEVJO, a Cruijffian celebration, with a jump and an arm in the air, was as good as being substituted.",
                                "english": "In the first team of my club DEVJO, a Cruijffian celebration, with a jump and an arm in the air, was as good as being substituted."
                            }
                        ]
                    },
                    {
                        "sense_id": "76ab45dd-d197-32e6-aeb5-ce0cbc1d0465",
                        "entry_id": "ff6f904e-1cb2-30bf-9319-ea887454dc80",
                        "glosses": [
                            "of or pertaining to the unique way of speaking by Dutch football player Johan Cruyff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27593920-a257-434b-85b3-147db300f213",
                                "sense_id": "76ab45dd-d197-32e6-aeb5-ce0cbc1d0465",
                                "text": "Ik geef u daarom het volgende cruijffiaanse advies mee: verzwijg alles waar u later spijt van zult krijgen.",
                                "translation": "I therefore give you the following Cruijffian advice: conceal everything you will later regret.",
                                "english": "I therefore give you the following Cruijffian advice: conceal everything you will later regret."
                            }
                        ]
                    }
