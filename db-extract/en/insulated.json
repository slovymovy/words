                ],
                "senses": [
                    {
                        "sense_id": "e926fa44-f5d3-3ab6-803b-01e3b4341f9c",
                        "entry_id": "67288cad-d18e-329d-9735-87388da1776c",
                        "glosses": [
                            "Protected from heat, cold, noise etc, by being surrounded with an insulating material."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee03b6e0-3ff4-329d-9420-23e940ee956a",
                        "entry_id": "67288cad-d18e-329d-9735-87388da1776c",
                        "glosses": [
                            "Placed or set apart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f8b237-8d98-4c27-887d-5ca2034c0417",
                                "sense_id": "ee03b6e0-3ff4-329d-9420-23e940ee956a",
                                "text": "an insulated house or column"
                            },
                            {
                                "example_id": "dfc773ca-01d5-4499-9384-e5ef4dce7704",
                                "sense_id": "ee03b6e0-3ff4-329d-9420-23e940ee956a",
                                "text": "the special and insulated situation of the Jews"
                            }
                        ]
                    },
                    {
                        "sense_id": "050cbe7c-94ba-3f88-a949-804f3430ff02",
                        "entry_id": "67288cad-d18e-329d-9735-87388da1776c",
                        "glosses": [
                            "Isolated or separated from other conducting materials, or sources of electricity."
                        ],
                        "tags": [
                            "of an electrically conducting material"
                        ],
                        "examples": [
                            {
                                "example_id": "bb82f3f6-278f-411a-a2c1-bd65458c58bd",
                                "sense_id": "050cbe7c-94ba-3f88-a949-804f3430ff02",
                                "text": "Early insulated wires were covered in silk rather than plastic."
                            },
                            {
                                "example_id": "5b67fdcd-ea1d-4872-b97d-2550d84eb051",
                                "sense_id": "050cbe7c-94ba-3f88-a949-804f3430ff02",
                                "text": "Speed by now was now down to 25 m.p.h., but that universal tool, the insulated screwdriver, with its business end gingerly applied to the relay coil, enabled us to keep going as far as Grantham, where a more permanent remedy could be effected."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebd6a899-16d1-3ca2-98b3-9937fd012166",
                        "entry_id": "67288cad-d18e-329d-9735-87388da1776c",
                        "glosses": [
                            "Situated at so great a distance as to be beyond the effect of gravitation; said of stars supposed to be so far apart that the effect of their mutual attraction is undetectable."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21b835b6-4d34-4fe8-9610-80a037b7b334",
                        "source_entry_id": "67288cad-d18e-329d-9735-87388da1776c",
                        "source_sense_description": "protected",
                        "target_lang_word": "geschützt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geschützt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                        "entry_id": "7f210399-f4a5-3e65-b367-5931f3b3b136",
                                        "glosses": [
                                            "gefeit, immun, nicht anfällig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7435c61e-0418-4961-b6b9-e3f2ab64b50c",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Aber die polizeilich und gerichtlich geschützte Ehre deutscher Politiker blieb unangetastet.“"
                                            },
                                            {
                                                "example_id": "116aff08-9ee5-4bf6-8c0d-5dd2e41dd7af",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Schmidt spricht als Mitglied einer privilegierten und geschützten Klasse, der er aufgrund seiner Verdienste mit Recht angehört.“"
                                            },
                                            {
                                                "example_id": "3c0d0fa3-c8fb-4d2d-856b-a2eb0e87169a",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Man sucht einen geschützten Platz auf dem Deck, wo man möglichst lange Nacht und Meer geniessen kann.“"
                                            },
                                            {
                                                "example_id": "6c2d4291-24e8-4e7e-aca9-f5e4e1610e9a",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Die Stiftung für Konsumentenschutz hebt insbesonders hervor, dass die meisten Geräte, gerade im Geschäftsbereich, kaum je für Kopien urheberrechtlich geschützter Werke gebraucht werden.“"
                                            },
                                            {
                                                "example_id": "b3f00429-1e76-4bfe-88c4-2990c89aee15",
                                                "sense_id": "c07f5ad4-34ce-35ae-a984-81320e62190a",
                                                "text": "„Die Rade de Brest ist ein relativ geschützter Einschnitt in die Küste der Bretagne, der nur durch eine schmale Zufahrt, den „Goulet de Brest“, mit dem übrigen Atlantik verbunden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
