                        "cross_references": [
                            {
                                "target_word": "Leierkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fd10048-e30d-360c-b1ef-2c57fe9cec80",
                                        "entry_id": "e848dc71-39a6-3ef1-959f-7b3ed46339eb",
                                        "glosses": [
                                            "kleinere, von einer Person leicht zu transportierende und oft mit einem Fahrgestell versehene Drehorgel"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b693969-e2fb-4e5a-bbc5-a8cba84cbaac",
                                                "sense_id": "8fd10048-e30d-360c-b1ef-2c57fe9cec80",
                                                "text": "Der Leierkasten ist ein altes Musikinstrument."
                                            },
                                            {
                                                "example_id": "84d1a8a3-222f-4f45-8fe7-25dd08206e08",
                                                "sense_id": "8fd10048-e30d-360c-b1ef-2c57fe9cec80",
                                                "text": "Auf dem Leierkasten saß ein Kapuzineräffchen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf50dd5d-439d-42fd-a984-243a7a6c43e2",
                        "source_entry_id": "34af5d4d-a8f0-3bde-b689-559a88c26ab2",
                        "source_sense_id": "8ddd1c7a-4785-3115-9525-44ec869649e3",
                        "source_sense_description": "een mechanisch bediend of automatisch spelend orgel, meestal op straat spelend",
                        "target_lang_word": "barrel organ",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barrel organ",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "471cf5b6-7cf8-3086-8247-f69ae4359106",
                                        "entry_id": "e3bd9b5f-9460-39aa-bb97-a373f71cca91",
                                        "glosses": [
                                            "A musical instrument in which air from a bellows is admitted to a set of pipes by means of pins inserted into a revolving barrel (typically turned by a crank), originating in France."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b055dc-c998-44c1-bd46-fb607d94bf95",
                                                "sense_id": "471cf5b6-7cf8-3086-8247-f69ae4359106",
                                                "text": "Poor Mrs. Cranch was bulky, and, breathing asthmatically, had the additional motive for making her remarks unexceptionable and giving them a general bearing, that even her whispers were loud and liable to sudden bursts like those of a deranged barrel-organ."
                                            },
                                            {
                                                "example_id": "fe9e65e4-fb8f-4302-b2e6-076cc470262f",
                                                "sense_id": "471cf5b6-7cf8-3086-8247-f69ae4359106",
                                                "text": "Ragged children played in the road, and an old barrel-organ was grinding out a vulgar tune."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95166072-1906-4d6d-b848-fd895d055b47",
                        "source_entry_id": "34af5d4d-a8f0-3bde-b689-559a88c26ab2",
                        "source_sense_id": "8ddd1c7a-4785-3115-9525-44ec869649e3",
                        "source_sense_description": "een mechanisch bediend of automatisch spelend orgel, meestal op straat spelend",
                        "target_lang_word": "orgue de Barbarie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orgue de Barbarie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                        "entry_id": "727d19f1-6bf5-38bc-bc11-3d1ce1408d14",
                                        "glosses": [
                                            "Appareil mécanique qui produit de la musique à partir de cartes perforées, dans des tuyaux d’orgue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b215aa4-67bf-4acb-9ca8-a8f58638ca49",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Il signala à leur attention un orgue de Barbarie, dont il se mit, en leur honneur, à tourner la manivelle. Les sons étaient assez agréables, mais le mécanisme paraissait endommagé."
                                            },
                                            {
                                                "example_id": "935c80e6-4082-4520-90e8-6777e664dc95",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Ces vieux sages consommés ne s’émouvaient de rien. Le monde était pour eux un orgue de Barbarie qui se répète."
                                            },
                                            {
                                                "example_id": "708f1b29-ab94-4167-a2f4-6d78083070de",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "Là-bas, dans le fond, Blagsmith tournait sa manivelle avec autant de quiétude que s’il eût joué le Yankie Doodle sur un orgue de Barbarie."
                                            },
                                            {
                                                "example_id": "54594796-4516-4774-ad0f-46a4ca6b0c84",
                                                "sense_id": "ff244705-9eb5-39f7-8da4-243852687bbd",
                                                "text": "On entendait les sons pleurards de l’orgue de Barbarie, arrivant par bouffées, avec le vent ; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
