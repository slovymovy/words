            {
                "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                "word": "vestibular",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "45791e01-4f73-411c-bb7c-5141fc5cf4bf",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more vestibular"
                    },
                    {
                        "form_id": "48be45dc-5646-440f-9e30-df12d0a17bbf",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most vestibular"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc284047-4b83-3726-a070-955c0d63f180",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "glosses": [
                            "Of or pertaining to a vestibule in a building (or railway coach)."
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "a55909dd-3c1f-41f1-8036-6ba423bd3328",
                                "sense_id": "cc284047-4b83-3726-a070-955c0d63f180",
                                "text": "[…]while the outer world was fenced off by the interposed atrium or vestibular cloister,[…]."
                            },
                            {
                                "example_id": "af4526ac-9cef-49a2-99df-8e577d1562fb",
                                "sense_id": "cc284047-4b83-3726-a070-955c0d63f180",
                                "text": "Originally, it was intended that the stock should be vestibular throughout, but when the drawings were submitted to the Prince of Wales, he cut out this feature, saying that a railway journey afforded one of the very few occasions when he was able to enjoy absolute privacy—a feature which the vestibule would tend to abolish."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ae2b571-2916-35d3-8d50-253a5cf5f0d7",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "glosses": [
                            "Of, pertaining to, or functioning as a vestibule (body cavity)."
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "41f4a688-a239-3c01-91de-3760bde91ef1",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "glosses": [
                            "Of or pertaining to the vestibule of the inner ear and the perception of body position, balance and movement."
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "93d4d364-8548-4806-85b6-35b5099aa99b",
                                "sense_id": "41f4a688-a239-3c01-91de-3760bde91ef1",
                                "text": "vestibular impulse"
                            },
                            {
                                "example_id": "d19b9c79-76ea-4b9e-a8f3-5f48443d9df3",
                                "sense_id": "41f4a688-a239-3c01-91de-3760bde91ef1",
                                "text": "Ampulla of the perpendicular semicircular canal, receiving a fasciculus from the superior branch of the vestibular nerve[…]."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae013861-5771-38fb-9c77-4ec50d351038",
                        "entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "glosses": [
                            "Of or pertaining to the surface of a tooth that is directed outward toward the vestibule of the mouth, including the buccal and labial surfaces, and opposite the lingual (or oral) surface."
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3600d4ec-f3cc-437a-94a7-1491689ecd00",
                        "source_entry_id": "2e796f6e-d165-32b5-99cc-23f303f84a37",
                        "source_sense_description": "building",
                        "target_lang_word": "vestibulär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestibulär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04edfa51-5502-36fa-ac45-2d7701d646e3",
                                        "entry_id": "0055c1e5-6101-3beb-b252-aec77748381e",
                                        "glosses": [
                                            "den Gleichgewichtssinn betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7e4d4f-0a3a-4665-96d6-e539cf14c45d",
                                                "sense_id": "04edfa51-5502-36fa-ac45-2d7701d646e3",
                                                "text": "„Das Motorfliegen erfordert ein beträchtliches navigatorisches Wissen und Können bzw. […] vestibuläre Belastbarkeit, Raumorientierungsvermögen und ein feinmotorisches Gespür für den Umgang mit der Maschine.“"
                                            },
                                            {
                                                "example_id": "44a35674-82ef-4308-8bf2-e572367e43b7",
                                                "sense_id": "04edfa51-5502-36fa-ac45-2d7701d646e3",
                                                "text": "Das Lernen geschieht auf der Basis von vestibulären, kinästhetischen und motor-efferenten Signalen, die aus aktiven oder passiven Eigenbewegungen des Akteurs im Raum resultieren."
                                            },
                                            {
                                                "example_id": "8ec9a3d0-7cc4-41f2-ac36-61538edc4531",
                                                "sense_id": "04edfa51-5502-36fa-ac45-2d7701d646e3",
                                                "text": "Vestibulär evozierte myogene Potentiale dienen vor allem der selektiven und seitenspezifischen Funktionsbestimmung des Sacculus eines der Gleichgewichtsorgane."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "67ffb35d-d032-3215-a9d8-5c89a4a9d19b",
                                        "entry_id": "0055c1e5-6101-3beb-b252-aec77748381e",
                                        "glosses": [
                                            "den Mundvorhof betreffend"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22a59102-e93b-4866-a3b1-a8e357c121c0",
                                                "sense_id": "67ffb35d-d032-3215-a9d8-5c89a4a9d19b",
                                                "text": "Die Richtungsangabe vestibulär bezieht sich auf den Mundvorhof."
                                            },
                                            {
                                                "example_id": "00cdbe67-cc16-4fcb-8967-5c6abb68e279",
                                                "sense_id": "67ffb35d-d032-3215-a9d8-5c89a4a9d19b",
                                                "text": "\"Die Defektdeckung vestibulär erfolgte mit einem freien palatinalen Schleimhauttransplantat.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "080945ae-d26a-378c-a6e9-488979d04680",
                                        "entry_id": "0055c1e5-6101-3beb-b252-aec77748381e",
                                        "glosses": [
                                            "die Außenseite des Zahnes oder der Zähne betreffend, Sammelbegriff für bukkal (bei Backenzähnen) beziehungsweise labial (bei Frontzähnen)"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39b38c52-02e0-4805-8605-b826109edf21",
                                                "sense_id": "080945ae-d26a-378c-a6e9-488979d04680",
                                                "text": "Die Backenzähne wiesen vestibulär Säureschäden auf."
                                            },
                                            {
                                                "example_id": "e4aab7ec-2328-4b5d-ab8a-889f7f6697f2",
                                                "sense_id": "080945ae-d26a-378c-a6e9-488979d04680",
                                                "text": "Glattflächenkaries ist ein Kariesbefall der mittleren und inzisalen bzw. dem okklusalen Drittel der Glattflächen, meist vestibulär."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "27a49006-f209-30ca-aa03-e954aa5cddf9",
                                        "entry_id": "0055c1e5-6101-3beb-b252-aec77748381e",
                                        "glosses": [
                                            "das Vestibül, die Eingangshalle betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
