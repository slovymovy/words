                {
                    "sense_id": "851cbd0a-1542-325e-98ac-443eecad363d",
                    "sense_definition": "To disturb, disconcert, or cause someone to feel uneasy or hesitant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disturb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult questions did not <w>faze</w> the experienced politician during the live interview.",
                            "target_lang_translations": {
                                "zh": "在现场采访中，那些棘手的问题并没有让这位经验丰富的政治家感到<w>不安</w>。"
                            }
                        },
                        {
                            "text": "She remained calm and nothing seemed to <w>faze</w> her during the high-pressure presentation.",
                            "target_lang_translations": {
                                "zh": "她保持冷静，在高压的演讲过程中，似乎没有任何事情能让她<w>动摇</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "daunt",
                        "perturb",
                        "disconcert",
                        "rattle"
                    ],
                    "antonyms": [
                        "encourage",
                        "embolden"
                    ],
                    "common_phrases": [
                        "nothing fazes",
                        "not fazed by"
                    ],
                    "target_lang_definitions": {
                        "zh": "使人感到不安、困扰或动摇。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……不安",
                                "target_lang_sense_clarification": "指让某人感到心神不宁或焦虑。"
                            },
                            {
                                "target_lang_word": "使……动摇",
                                "target_lang_sense_clarification": "指让某人失去信心或改变原有的坚定态度。"
                            },
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "指造成心理上的负担或混乱。"
                            }
                        ]
                    }
                }
            ]
        }
