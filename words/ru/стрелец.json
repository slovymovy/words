                    "sense_id": "33fde384-55ba-3e3c-bc00-4a7e608a3c06",
                    "sense_definition": "Военнослужащий постоянного пехотного войска в Русском государстве XVI—XVII веков, вооружённый пищалью или ружьём.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждый московский <w>стрелец</w> нёс службу в полку и получал жалованье от государства.",
                            "target_lang_translations": {
                                "en": "Every Moscow <w>strelitz</w> served in a regiment and received a salary from the state."
                            }
                        },
                        {
                            "text": "Во время городского парада вооружённый <w>стрелец</w> стоял на охране кремлёвских ворот.",
                            "target_lang_translations": {
                                "en": "During the city parade, an armed <w>strelitz</w> stood guard at the Kremlin gates."
                            }
                        }
                    ],
                    "synonyms": [
                        "ратник"
                    ],
                    "common_phrases": [
                        "московский стрелец",
                        "бунт стрельцов"
                    ],
                    "target_lang_definitions": {
                        "en": "A soldier of the standing infantry units in the Russian state during the 16th–17th centuries, armed with firearms."
                    },
                    "translations": {
