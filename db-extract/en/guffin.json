                            {
                                "example_id": "87f0b950-c914-4de0-a3db-50fa693d9aeb",
                                "sense_id": "1ee1755f-888b-3d59-b619-6a4637d1c1d5",
                                "text": "I used to swallow all that stuff, but I'm not such a guffin now."
                            },
                            {
                                "example_id": "ebf3d5d1-7caf-4700-9910-ecbeb4fe7591",
                                "sense_id": "1ee1755f-888b-3d59-b619-6a4637d1c1d5",
                                "text": "“You must have been a silly little guffin,” said Sinclair."
                            },
                            {
                                "example_id": "aa2ab705-2141-4e00-9828-f29bde1d72de",
                                "sense_id": "1ee1755f-888b-3d59-b619-6a4637d1c1d5",
                                "text": "She did not like Archibald. She said she liked big, manly men. Behind his back she not infrequently referred to him as a 'gaby'; sometimes even as that 'guffin'."
                            }
                        ]
