                    {
                        "translation_id": "95a826c4-84c8-4940-8b4e-21c44a207a87",
                        "source_entry_id": "f4a3cebb-9de1-320c-aedb-d686fc497cc7",
                        "source_sense_id": "353c00cc-32b3-3810-a71d-319d85ce3f00",
