                        "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                        "entry_id": "071d43a1-b694-3d7b-965a-7523c93fb09a",
                        "glosses": [
                            "The act or state of desisting; cessation."
                        ],
                        "tags": [
                            "countable",
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "49530794-b3a9-4b06-a2ed-2871839e64bf",
                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                "text": "If the writings now sent be seriously perused concerning the common defence, besieging of Bantam, their desistance from the trade of Moluccas, Amboyna, and Banda, their complaints against Declell, and answers to the writings of the Dutch, are confident that the advantage will not appear so great."
                            },
                            {
                                "example_id": "c7679fca-c6a2-483e-b409-5a568f07f392",
                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                "text": "This entire decisive desistance from the accustomed resort, has the effect in a few days, to weaken the appetite."
                            },
                            {
                                "example_id": "ad2c85be-1300-47f3-aecc-c7becca38f65",
                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                "text": "In 1767, the crown for the first time set forward claims on the territory and revenues of India; but the Company purchased its desistance by a subsidy equivalent to ten or twelve millions of francs."
                            },
                            {
                                "example_id": "eebbf07f-cac5-4764-9b9f-37113a45b29f",
                                "sense_id": "3daa17ee-9965-3a61-9856-b6cde32a1740",
                                "text": "[O]n one side she was defended by the wall of the room and on the other rendered inaccessible by Miriam's mother, who clung to her with a quickly-rooted fidelity, showing no symptom of desistance."
                            }
                        ]
                    }
                ],
