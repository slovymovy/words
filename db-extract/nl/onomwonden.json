                    {
                        "sense_id": "b162be1b-940b-3813-b7b1-ab605489da48",
                        "entry_id": "6ec6ea00-29ec-3408-90ff-d48efd379c1b",
                        "glosses": [
                            "zonder er doekjes om te winden, zonder het proberen te verbergen of te verzachten, zonder smoesjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7887ddaf-e80d-446f-a32c-e068f3740d45",
                                "sense_id": "b162be1b-940b-3813-b7b1-ab605489da48",
                                "text": "Festivalkenner Kennedy O'Connor beschreef dit onomwonden als volgt: \"De tekst van het liedje was tamelijk belachelijk, met een refrein waarin de luisteraar wordt aangemoedigd om elk uur een bloem te plukken en daarbij te 'ding-a-dongen, zelfs als je geliefde er van-door, door, door is'.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02bca004-c3a8-490f-b98a-3a0be02fd90e",
                        "source_entry_id": "6ec6ea00-29ec-3408-90ff-d48efd379c1b",
                        "source_sense_id": "b162be1b-940b-3813-b7b1-ab605489da48",
                        "target_lang_word": "above-board",
