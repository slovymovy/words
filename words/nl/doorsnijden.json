{
    "word_family": [
        "snijden",
        "doorsnijding",
        "doorsnede",
        "snede",
        "snijder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4dfd7b5-55be-3926-8142-3e774f5b39c3",
                    "sense_definition": "Met een mes of scherp voorwerp in twee stukken snijden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "snijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij pakte een scherp mes en <w>sneed</w> het touw voorzichtig <w>door</w>.",
                            "target_lang_translations": {
                                "en": "He took a sharp knife and carefully <w>cut through</w> the rope."
                            }
                        },
                        {
                            "text": "De bakker heeft het versgebakken brood netjes <w>doorgesneden</w> voor de lunch.",
                            "target_lang_translations": {
                                "en": "The baker neatly <w>cut</w> the freshly baked bread <w>in two</w> for lunch."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorknippen"
                    ],
                    "common_phrases": [
                        "het touw doorsnijden",
                        "in tweeën doorsnijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To cut something into two pieces using a knife or sharp object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cut through",
                                "target_lang_sense_clarification": "to divide completely with a blade"
                            },
                            {
                                "target_lang_word": "sever",
                                "target_lang_sense_clarification": "to divide completely or separate by cutting"
                            },
                            {
                                "target_lang_word": "cut in two",
                                "target_lang_sense_clarification": "to slice completely into two parts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acba208d-b9c6-33aa-9c94-1e75fd665a28",
                    "sense_definition": "Dwars door een landschap of gebied lopen of stromen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kruisen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brede rivier <w>doorsnijdt</w> de historische stad van oost naar west.",
                            "target_lang_translations": {
                                "en": "The wide river <w>traverses</w> the historic city from east to west."
                            }
                        },
                        {
                            "text": "Een moderne snelweg <w>doorsneed</w> het rustige landschap van de vallei.",
                            "target_lang_translations": {
                                "en": "A modern highway <w>cut through</w> the tranquil landscape of the valley."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het landschap doorsnijden",
                        "de stad doorsnijden"
                    ],
                    "target_lang_definitions": {
                        "en": "To run, flow, or pass straight across a landscape, area, or city."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "traverse",
                                "target_lang_sense_clarification": "to cross or run across a territory or area"
                            },
                            {
                                "target_lang_word": "cut through",
                                "target_lang_sense_clarification": "of a river or road, to pass across an area"
                            },
                            {
                                "target_lang_word": "intersect",
                                "target_lang_sense_clarification": "to divide or cross through a space"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4f56553-2e12-3280-96f0-8ec628e342bc",
                    "sense_definition": "Ononderbroken doorgaan met snijden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "snijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok <w>sneed</w> maar <w>door</w> totdat alle groenten klaar waren voor de soep.",
                            "target_lang_translations": {
                                "en": "The chef just <w>kept cutting</w> until all the vegetables were ready for the soup."
                            }
                        },
                        {
                            "text": "Je moet even <w>doorsnijden</w>, want de gasten arriveren over een kwartier.",
                            "target_lang_translations": {
                                "en": "You need to <w>cut faster</w>, because the guests arrive in fifteen minutes."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To continue cutting without interruption, or to cut quickly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "keep cutting",
                                "target_lang_sense_clarification": "to continue slicing or chopping without stopping"
                            },
                            {
                                "target_lang_word": "cut faster",
                                "target_lang_sense_clarification": "to hurry up while slicing or chopping"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}