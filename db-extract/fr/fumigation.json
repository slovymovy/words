                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c0fd84f-e759-3582-a3c9-30a78ea82faa",
                        "entry_id": "92297206-e814-3a6c-8d6d-8b19a94ba176",
                        "glosses": [
                            "Action d’appliquer un médicament, sous forme de fumée, de vapeur ou de gaz, à quelque partie du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94dd1b1e-2d1e-4e96-a3c6-91a61bf2be15",
                                "sense_id": "8c0fd84f-e759-3582-a3c9-30a78ea82faa",
                                "text": "Fumigations sulfureuses. - Fumigations aromatiques. - Fumigations aqueuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7a2d062-6539-3217-88ac-3f0372ef058c",
                        "entry_id": "92297206-e814-3a6c-8d6d-8b19a94ba176",
                        "glosses": [
                            "Action d’exposer à la fumée, à la vapeur certaines substances pour désinfecter certains lieux ou certains objets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ead0df84-37a5-4077-902f-1c78b111516f",
                                "sense_id": "c7a2d062-6539-3217-88ac-3f0372ef058c",
                                "text": "À Sixaola, les passages des avions ont lieu aux heures les moins chaudes, pour éviter la dispersion de la fumigation."
                            },
                            {
                                "example_id": "e410edbb-8a36-4bd2-908c-a8d7ce1c8e10",
                                "sense_id": "c7a2d062-6539-3217-88ac-3f0372ef058c",
                                "text": "Quelques fumigations opportunément et soigneusement faites, et tout vibrion est anéanti."
                            },
                            {
                                "example_id": "9c749533-23be-42fa-9544-f4aa8a37aabd",
                                "sense_id": "c7a2d062-6539-3217-88ac-3f0372ef058c",
                                "text": "Locaux et matériel doivent être tenus dans le plus grand état de propreté au moyen de fumigations préalables et de lavages répétés."
                            }
                        ]
                    }
                ],
