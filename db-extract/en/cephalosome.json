                        "glosses": [
                            "The anterior region or head of insects and other arthropods; the anterior of the cephalothorax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ab0578-cbdb-483d-988f-f4196696fa22",
                                "sense_id": "d72c6a4c-e0dc-3e11-8040-e0e44d5ced8e",
                                "text": "we would suggest that the head of Arthropoda be termed the Cephalosome"
                            },
                            {
                                "example_id": "012e5c76-1cc4-4825-9d87-9ed054516526",
                                "sense_id": "d72c6a4c-e0dc-3e11-8040-e0e44d5ced8e",
                                "text": "Curiously enough, when the oral appendages are removed from the cephalosome, the articular foramina for the mandibles appear to be directly continuous with the row of articular foramina for the peræopods and gnathopods."
                            }
