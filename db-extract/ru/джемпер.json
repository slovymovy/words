                "senses": [
                    {
                        "sense_id": "6a93704d-7293-33c2-afbb-de7ae820469f",
                        "entry_id": "7d48db41-9deb-3cf9-abd3-28661a40ea7c",
                        "glosses": [
                            "тонкий вязаный свитер без воротника (обычно с круглым вырезом на груди) и без застёжек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4932dc-02b5-48b8-8aff-c4269267e66f",
                                "sense_id": "6a93704d-7293-33c2-afbb-de7ae820469f",
                                "text": "На ней был полосатый джемпер с короткими рукавами и глубоким вырезом на груди."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "554a86d7-86d0-4f4a-ac33-450e6380d992",
                        "source_entry_id": "7d48db41-9deb-3cf9-abd3-28661a40ea7c",
                        "source_sense_id": "6a93704d-7293-33c2-afbb-de7ae820469f",
                        "target_lang_word": "Pullover",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pullover",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                        "entry_id": "13abb8ac-85cc-3ffe-b3c2-b9e889403fd4",
                                        "glosses": [
                                            "langärmeliges Kleidungsstück, das den Oberkörper bedeckt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f361c8-d571-4aea-a50b-e47a187d527f",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "Er zog sich einen warmen Pullover an."
                                            },
                                            {
                                                "example_id": "093edf0b-1810-410c-be24-c82cadaf319e",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Zitternd vor Kälte schlüpfte Nikki in einen schwarzen Rock, einen khakifarbenen Pullover und in ihre Wildlederstiefel.“"
                                            },
                                            {
                                                "example_id": "25005ac3-cd29-4398-b684-ba44fe25ea07",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Ich riss mir die albernen Clownskleider herunter, zog einen Pullover Hugos über, sein Geruch besänftigte mich ein wenig, und rief Arnfrieds WG an.“"
                                            },
                                            {
                                                "example_id": "3fbae342-0876-4d6a-bac4-7198416fe6a2",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Der Pullover erwies sich als Corpus delicti, als der Chor ein abruptes Ende fand und nahm.“"
                                            },
                                            {
                                                "example_id": "f0a88269-620f-4222-bb4e-328372e219b5",
                                                "sense_id": "3f98c738-2378-3ae5-a153-d1fb690a1a89",
                                                "text": "„Er stand auf, zog einen anderen Pullover und seinen Cordanzug an und verließ das Zimmer – nicht ohne Mund und Rachen mit Odol gespült zu haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a99d5566-23a3-4315-990e-b8f33d326959",
                        "source_entry_id": "7d48db41-9deb-3cf9-abd3-28661a40ea7c",
                        "source_sense_id": "6a93704d-7293-33c2-afbb-de7ae820469f",
                        "target_lang_word": "Jumper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jumper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "644776d9-1bfa-30d5-9f7b-818441715eae",
                                        "entry_id": "ef43c77f-35a5-3545-b0a4-6dd2ccb46aae",
                                        "glosses": [
                                            "Kleidungsstück für Frauen, das einem Pullover ähnelt"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be5e9e2-fedd-4ee8-ac6c-0d06029987e5",
                                                "sense_id": "644776d9-1bfa-30d5-9f7b-818441715eae",
                                                "text": "„Herausfordernd mit den Brüsten unter dem straff gezogenen Jumper wippend, drehte sie sich heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
