                "senses": [
                    {
                        "sense_id": "c60e0dc6-04c2-32f3-b75a-acd87a3d888a",
                        "entry_id": "7e6922ec-a6f4-31ff-bd8f-4d77f6e1663c",
                        "glosses": [
                            "Celle qui coud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8950165-0ea7-4c1d-bb29-a92acef9d548",
                                "sense_id": "c60e0dc6-04c2-32f3-b75a-acd87a3d888a",
                                "text": "Peter Fox était né au début du siècle d’un père anglais qu’il n’avait pas connu, qui avait disparu laissant sa femme en couches sans la moindre explication, sans un penny, pas plus qu’il était explicable qu’il eût épousé par étourderie une petite couseuse creusoise peu de mois auparavant, au prétexte honorable qu’elle portait un embryon de lui et que ces choses-là se faisaient."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cd74a7f-c820-30ba-a0c8-9149016f26f8",
                        "entry_id": "7e6922ec-a6f4-31ff-bd8f-4d77f6e1663c",
                        "glosses": [
                            "Couturière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83f2880c-6e3b-4d4c-81c8-7b5787d440c5",
                                "sense_id": "9cd74a7f-c820-30ba-a0c8-9149016f26f8",
                                "text": "D’ailleurs, en quoi les besoins d’une tisseuse au métier mécanique sont-ils plus grands que ceux d’une dentelière ? ou les besoins d’une mécanicienne (employée à la machine à coudre) plus grands que ceux de la couseuse à la main ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d874610-bee0-3895-a3f6-88a81e6e2020",
                        "entry_id": "7e6922ec-a6f4-31ff-bd8f-4d77f6e1663c",
                        "glosses": [
                            "Machine servant à coudre les cahiers d’un livre au fil textile."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5805d18c-b53b-42dd-91fb-5439d8c62b0a",
                        "source_entry_id": "7e6922ec-a6f4-31ff-bd8f-4d77f6e1663c",
                        "source_sense_id": "c60e0dc6-04c2-32f3-b75a-acd87a3d888a",
                        "source_sense_description": "Celle qui coud",
                        "target_lang_word": "Näherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Näherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                        "entry_id": "71dd254c-d039-35b5-8a89-c77a5505c859",
                                        "glosses": [
                                            "weibliche Person, die (meist beruflich) näht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c520b11f-c3da-4266-ac57-d8c94a4aba39",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "Er brachte seine kaputten Hemden zur Näherin."
                                            },
                                            {
                                                "example_id": "6edb511c-d8ee-4f17-b526-6daa5bffe864",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Mama arbeitet nicht mehr in der Produktion, sie hat eine Stelle als Näherin in einem der Kinderheime bekommen.“"
                                            },
                                            {
                                                "example_id": "06ccdf99-321f-46b5-9723-58c0f0fae5cb",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Die Näherin war schon bestellt, der Heiratsvertrag war aufgesetzt, da bekam der Bauer einen Schlaganfall und starb, ohne wieder zu sich gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "57f95e8d-906c-4ee3-a054-86141dbd1d88",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                                            },
                                            {
                                                "example_id": "90520402-8762-40f6-9f50-60d4bfe2a176",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Offiziell war er der Singer-Ausbilder für die vielen Näherinnen der Region.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
