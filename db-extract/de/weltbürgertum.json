                "senses": [
                    {
                        "sense_id": "06cdbb4b-ebd0-3046-a990-923cccf2a544",
                        "entry_id": "0ce22fc1-381a-3733-aec2-a01cfe381ee7",
                        "glosses": [
                            "eine Gesinnung, die sich besonders über nationale und ständische Gebundenheit erhebt und sich in erster Linie der universalen menschlichen Gesellschaft verpflichtet fühlt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49742f09-361c-4abb-899e-999522350945",
                                "sense_id": "06cdbb4b-ebd0-3046-a990-923cccf2a544",
                                "text": "„Weltbürgertum äußerte sich bereits in der hellenistisch-römischen Geistigkeit und wurde von Kynikern, Epikureern und Stoikern gelehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17bfc104-581e-4fde-bba8-9e73d662c6a2",
                        "source_entry_id": "0ce22fc1-381a-3733-aec2-a01cfe381ee7",
                        "source_sense_id": "06cdbb4b-ebd0-3046-a990-923cccf2a544",
                        "target_lang_word": "cosmopolitanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmopolitanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                                        "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                                        "glosses": [
                                            "The idea that all of humanity belongs to a single moral community."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82f790e8-88ba-4c68-878c-bf531c13728c",
                                                "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                                                "text": "The philosophy of cosmopolitanism underlies theories of global citizenship. Cosmopolitanism is the ability to balance a local and global identity. A cosmopolitan individual engages meaningfully with different cultures and feels at home in the world."
                                            },
                                            {
                                                "example_id": "77c1bcfe-3c53-41fd-a97e-4bd261ec4e1a",
                                                "sense_id": "ea9cc41c-dfc3-3974-bdf5-269bfec547b5",
                                                "text": "To present the world anthropologies project (WA), this article explores the existence of three kinds of anthropological cosmopolitanisms and cosmopolitics: imperial, liberal, and radical."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a88b5e7d-7b88-30df-81d4-5353d3471e73",
                                        "entry_id": "4a471713-ea04-3247-a519-0ab1ac2119f8",
                                        "glosses": [
                                            "The quality of being cosmopolitan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6346d4b6-ff69-4192-9701-1def4936c995",
                        "source_entry_id": "0ce22fc1-381a-3733-aec2-a01cfe381ee7",
                        "source_sense_id": "06cdbb4b-ebd0-3046-a990-923cccf2a544",
