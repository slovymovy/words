                ],
                "senses": [
                    {
                        "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                        "entry_id": "7c33530e-803e-314b-8d2c-5bfea08fcd9b",
                        "glosses": [
                            "Schiff, das für Ausflüge genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47bd2f00-cbfe-4638-9135-4b2b7e66aef5",
                                "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                                "text": "Auf dem Rhein und manchen anderen Flüssen verkehren kleine und große Ausflugsschiffe."
                            },
                            {
                                "example_id": "2830391e-747e-453f-902a-f6649392a783",
                                "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                                "text": "„Das Ausflugsschiff, das jene schicksalhafte Reise unternahm, war mit amerikanischen Dollar gekauft worden.“"
                            },
                            {
                                "example_id": "ada68149-ba17-41c2-89a0-9ebf9b1b4868",
                                "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                                "text": "„Sie zeigen Arbeiterinnen, die auf einem Weinberg pausieren, den Rheinfall bei Schaffhausen, die Seilbahn bei Rüdesheim, ein Blick von einem Ausflugsschiff.“"
                            },
                            {
                                "example_id": "b7b6d82c-966a-4078-a574-4af957c4f4b7",
                                "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                                "text": "„Frachtschiffe tuckerten zum Be- oder Entladen in Richtung Hafen, die ersten Ausflugsschiffe waren auch schon wieder unterwegs.“"
                            },
                            {
                                "example_id": "7b3adde5-9da2-44d5-8004-2b93b780eaba",
                                "sense_id": "be65940d-d3c0-3209-8ebe-30ef64d14a96",
                                "text": "„Deshalb habe ich mich an ein Fenster der Wohnung gesetzt und hinab auf die Mosel und auf die Ausflugsschiffe geschaut, und so habe ich die vierzig Minuten bis zur großen Überraschung hinter mich gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
