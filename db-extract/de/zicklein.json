                "senses": [
                    {
                        "sense_id": "d0b26209-3cc4-3cd3-9cae-d8f9f5a341d6",
                        "entry_id": "4427b125-f960-3725-bc4e-702a90cec73a",
                        "glosses": [
                            "Chevreau, le petit de la chèvre."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "98e2dc96-587b-43c7-9e40-befb0af96486",
                                "sense_id": "d0b26209-3cc4-3cd3-9cae-d8f9f5a341d6",
                                "text": "Die Zicke hatte zwei Zicklein.",
                                "translation": "La chèvre a deux chevreaux."
                            },
                            {
                                "example_id": "d5d9537d-73f7-4fc9-9fa6-19363ca395e7",
                                "sense_id": "d0b26209-3cc4-3cd3-9cae-d8f9f5a341d6",
                                "text": "Geh mal etwas frisches Gras pflücken und halte es den kleinen Zicklein hin. Vielleicht trauen sie sich zu dir heran und lassen sich streicheln.",
                                "translation": "Va cueillir de l'herbe fraîche et tends-la aux petits chevreaux. Peut-être oseront-ils s'approcher de toi et se laisseront-ils caresser."
                            }
                        ]
                    }
                ],
