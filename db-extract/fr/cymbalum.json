                        "entry_id": "3a0ac639-b3fe-33f7-8920-3433de2d75aa",
                        "glosses": [
                            "Instrument de musique à cordes frappées d’origine hongroise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd20907-60d0-40fd-a59a-e8834df5375c",
                                "sense_id": "cf1ada17-806d-36dc-9c7a-fa6cda09e44a",
                                "text": "Les joueurs de cymbalum sont appelés des cymbalistes."
                            },
                            {
                                "example_id": "338fbd65-bf4e-481a-acd7-7a60899de4ae",
                                "sense_id": "cf1ada17-806d-36dc-9c7a-fa6cda09e44a",
                                "text": "Le cymbalum est signalé en Roumanie à la fin du XVIIIᵉ siècle : il fait alors partie de l’ensemble de « musique de chambre » de la cour du prince valaque Alexandru Ipsilanti."
                            }
                        ]
                    }
                ],
