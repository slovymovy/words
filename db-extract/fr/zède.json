                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49375b6a-a186-4f90-be0b-b7fab45a0fbb",
                                                "sense_id": "c886109a-76bc-3769-bd8d-6ee38f99ac08",
                                                "text": "I'm going to go get some zeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8af0ea82-0c1d-36a0-9fde-4708a1e4b805",
                                        "entry_id": "6785ac3d-f6ab-37fc-b9f8-a10ba5054504",
                                        "glosses": [
                                            "A zombie."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee3f5b9-e2af-47a0-bd22-a1d0dddc1506",
                                                "sense_id": "8af0ea82-0c1d-36a0-9fde-4708a1e4b805",
                                                "text": "A horde of zeds began to shuffle into the shopping mall."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edbb283e-2ca0-3f2a-97f7-f93d7e2df86e",
                                        "entry_id": "99994290-243f-3a7a-b48c-e3d96c25692d",
                                        "glosses": [
                                            "To sleep or nap. (Compare zzz, catch some z's.)"
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18728766-956e-4f78-ab7a-895b335db5f2",
                                                "sense_id": "edbb283e-2ca0-3f2a-97f7-f93d7e2df86e",
                                                "text": "Zedding hogs. Sleep sippers and spitters. Look at 'em cooking in their own snoring heat. One nose after another."
                                            },
                                            {
                                                "example_id": "5620997d-fe96-4c6e-87c5-24da6e8412fe",
                                                "sense_id": "edbb283e-2ca0-3f2a-97f7-f93d7e2df86e",
                                                "text": "I guess I must have zedded, for I find a police officer, the same one that nicked me, shaking me."
                                            },
                                            {
                                                "example_id": "ef66b793-bbaa-400c-b583-c219406b95f5",
                                                "sense_id": "edbb283e-2ca0-3f2a-97f7-f93d7e2df86e",
                                                "text": "\"Zedding away.\" \"God, I was having the most awful dream. That you'd got lost by the sea and I couldn't find you and something was chasing me, me and Evie.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2864fba0-0677-3e40-8ab1-21fff4a8d590",
                                        "entry_id": "99994290-243f-3a7a-b48c-e3d96c25692d",
                                        "glosses": [
                                            "To zigzag; to move with sharp alternating turns."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a10bc4a1-a3e2-4bdf-8f9c-acfd2d6306ae",
                                                "sense_id": "2864fba0-0677-3e40-8ab1-21fff4a8d590",
                                                "text": "We were zedding hell-bells up the hill towards Cervione, with a bank of road metal and a precipice on our left..."
                                            },
                                            {
                                                "example_id": "60164eb2-cabe-4f94-82dc-8b11096f147b",
                                                "sense_id": "2864fba0-0677-3e40-8ab1-21fff4a8d590",
                                                "text": "Licking his lips, his hand zedded on my thigh and he commented, penetratingly, that it wasn't pussy, but that driving the unmade road wasn't at all bad."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
