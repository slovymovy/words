                "senses": [
                    {
                        "sense_id": "32a42166-fa3d-372a-a011-ed3fe3bab96b",
                        "entry_id": "25b92b41-cbbb-3252-b32b-47303ea1a5f8",
                        "glosses": [
                            "действ. прич. прош. вр. от проиграть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "d1eb2ab1-aad8-4f2b-a082-b7c1d7cf5d77",
                                "sense_id": "32a42166-fa3d-372a-a011-ed3fe3bab96b",
                                "text": "Я вспоминаю прои́гранный Спиро Хетовичу спор о месте гибели де Лонга."
                            },
                            {
                                "example_id": "3f754a6e-f2ff-4091-9873-eb013260faea",
                                "sense_id": "32a42166-fa3d-372a-a011-ed3fe3bab96b",
                                "text": "Он надевал доспехи и, клонясь под их тяжестью, выходил на ристалище, на бой, жестокий, беспощадный и заранее прои́гранный."
                            }
                        ]
                    }
