        "fr-extract.jsonl": [
            {
                "entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                "word": "biocarburant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "477fd542-9b5d-4a91-9ce8-75dcb74e4bda",
                        "entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "biocarburants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "glosses": [
                            "Carburant constitué en tout ou partie de dérivés industriels obtenus après transformation de produits issus de l’agriculture."
                        ],
                        "tags": [
                            "Bioénergie",
                            "Raffinage"
                        ],
                        "examples": [
                            {
                                "example_id": "e2243dab-b50b-4be0-8f1d-f3701052eec8",
                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                "text": "Les biocarburants au banc d’essai"
                            },
                            {
                                "example_id": "09c1c9e4-ee08-425b-a5e8-a427a0071304",
                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                "text": "La loi de finances pour 2006 avait repoussé au 1ᵉʳ janvier 2010 l’instauration de la TGAP dans les DOM, en raison de l’absence d’unité de production de biocarburants."
                            },
                            {
                                "example_id": "1bb0af1c-71ee-4af3-b4aa-966c6a81cd2c",
                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                "text": "Pour commencer, il faudrait produire suffisamment de matières premières afin d'obtenir des biocarburants en quantités équivalentes à notre consommation d'énergie fossile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89bd3da8-a496-4a6a-aac7-190de0c945d6",
                        "source_entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "source_sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "target_lang_word": "Biokraftstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biokraftstoff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                                        "entry_id": "efdfd585-f8a3-304b-9ace-93058fd1e4da",
                                        "glosses": [
                                            "Kraftstoff, der aus nachwachsenden Rohstoffen hergestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba68335-4fc0-46cc-b8fa-ae58d3dcd41d",
                                                "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                                                "text": "„Absatz von Biokraftstoffen geht deutschlandweit deutlich zurück.“"
                                            },
                                            {
                                                "example_id": "70522eb8-5326-4fb6-ba99-66b6d52102b7",
                                                "sense_id": "d7b23b70-4071-3499-8355-f93671e5f099",
                                                "text": "„Die Produktion von Biokraftstoff, der aus Palmöl, Weizen, Mais oder Zuckerrüben hergestellt wird, führt zu massiven Entwaldungen in Südostasien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92b2f899-0b75-4b18-a4a3-b617351dcedc",
                        "source_entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "source_sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "target_lang_word": "Biosprit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biosprit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                                        "entry_id": "47cf2398-6b2d-36c3-ba89-7d603e5952cf",
                                        "glosses": [
                                            "Treibstoff oder Kraftstoff, der nicht aus Erdöl oder Ölsand gewonnen wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a055e4ad-cc6d-4d2f-849b-2570f2f3f6b0",
                                                "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                                                "text": "Der Schein trügt beim Biosprit, dass dieser gut für die Umwelt sei."
                                            },
                                            {
                                                "example_id": "81f582ba-ac57-4427-a42a-ed9a6cfc6693",
                                                "sense_id": "8b0c1b57-0b02-3380-8a55-05991876ec3f",
                                                "text": "„Allerdings boykottiert ebendiese Mehrheit auch den neuen Biosprit, schert sich kein bisschen um Ökostrom und dreht durch, wenn die jährliche Heizkostenabrechnung zwanzig Euro teurer ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10d79566-614f-4914-81bd-c5b44b03d0dc",
                        "source_entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "source_sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "target_lang_word": "Biotreibstoff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "259b4b1b-0714-4f1d-8984-9489bafe1c89",
                        "source_entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "source_sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "target_lang_word": "biofuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biofuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                                        "glosses": [
                                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                                            },
                                            {
                                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd768892-b951-46c0-aa32-de5c1eae3249",
                        "source_entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                        "source_sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                        "target_lang_word": "bahan bakar nabati",
