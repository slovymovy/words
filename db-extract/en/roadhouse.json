                "senses": [
                    {
                        "sense_id": "da74408e-f805-3c52-be0f-8da6342bf05e",
                        "entry_id": "fd65250c-18f7-3c4e-8fc8-50772fa6c341",
                        "glosses": [
                            "An inn or similar establishment situated beside a road beyond the jurisdiction of a town or city. In the centuries before motor vehicles, such inns were places for travellers to stop at night during multi-day journeys, besides being public houses for their local countryfolk."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "2e03d4fd-ed02-4b20-b91d-03430b7e4330",
                                "sense_id": "da74408e-f805-3c52-be0f-8da6342bf05e",
                                "text": "Near-synonym: coaching inn (often synonymous, historically)"
                            },
                            {
                                "example_id": "62c0456e-77b0-422e-aab1-7f3d3011dd3a",
                                "sense_id": "da74408e-f805-3c52-be0f-8da6342bf05e",
                                "text": "The pub was a classic 1930s 'roadhouse'. To the railway's official mindset, it might as well have been an opium den in Victorian London."
                            }
                        ]
                    },
                    {
                        "sense_id": "76a0f968-c54e-3eca-9631-1e4375b421f2",
