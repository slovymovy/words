                "senses": [
                    {
                        "sense_id": "3fc1011b-2d04-379c-9e48-52764b364745",
                        "entry_id": "cda09003-552d-3abc-a423-a782dc3f226d",
                        "glosses": [
                            "żyjący/mający miejsce w starożytnym Egipcie lub pochodzący/wywodzący się z niego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0403c6ea-0b43-469e-9223-25a721e9c78a",
                                "sense_id": "3fc1011b-2d04-379c-9e48-52764b364745",
                                "text": "Staroegipscy faraonowie byli uważani za bogów."
                            },
                            {
                                "example_id": "6e68c3eb-b51e-4cff-abfc-aaa960388a21",
                                "sense_id": "3fc1011b-2d04-379c-9e48-52764b364745",
                                "text": "Staroegipskie metody balsamowania zwłok okazały się niezwykle skuteczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1c1eb9b-8274-42eb-9234-f848841a2c4a",
                        "source_entry_id": "cda09003-552d-3abc-a423-a782dc3f226d",
                        "source_sense_id": "3fc1011b-2d04-379c-9e48-52764b364745",
                        "target_lang_word": "altägyptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altägyptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6fd65bb-9901-33d3-99a5-c2a37a66b5b1",
                                        "entry_id": "103581f5-c77e-324b-ac47-dfb935197707",
                                        "glosses": [
                                            "das Ägypten beziehungsweise die Ägypter des Altertums (das alte Ägypten, die alten Ägypter) betreffend; aus dem alten Ägypten, von den alten Ägyptern stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0d4c703-d6d9-4cc7-b210-f7276ac5a7de",
                                                "sense_id": "b6fd65bb-9901-33d3-99a5-c2a37a66b5b1",
                                                "text": "„Im Oktober 2010, ein Jahr nach den altägyptischen Hieroglyphen und gemeinsam mit den Zeichen der altindischen Brahmi-Schrift, sind die Emojis in den internationalen Zeichenstandard Unicode aufgenommen worden. Seither grüßen, grinsen und zwinkern sie uns aus allen erdenklichen Online-Botschaften entgegen […]“"
                                            },
                                            {
                                                "example_id": "21c2a81f-bad5-4e4a-a95b-8d98147e2bec",
                                                "sense_id": "b6fd65bb-9901-33d3-99a5-c2a37a66b5b1",
                                                "text": "„Im Einzugsbereich der altägyptischen Reichshauptstadt Memphis erstreckt sich über Dutzende von Kilometern und parallel zum Verlauf des Nils eine gewaltige Nekropole. Die Totenstadt war nahezu während der gesamten 3000-jährigen pharaonischen Geschichte in Benutzung.“"
                                            },
                                            {
                                                "example_id": "633a2118-10c9-46f1-89c3-0a823080a6a8",
                                                "sense_id": "b6fd65bb-9901-33d3-99a5-c2a37a66b5b1",
                                                "text": "„Archäologen haben in der Nekropole neben hunderten Sarkophagen und Gräbern bereits die Werkstatt von Mumienmachern sowie ein 16 Meter langes altägyptisches Totenbuch entdeckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33a3c576-bed0-4182-aecc-15628f97804e",
                        "source_entry_id": "cda09003-552d-3abc-a423-a782dc3f226d",
                        "source_sense_id": "3fc1011b-2d04-379c-9e48-52764b364745",
