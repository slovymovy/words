                "senses": [
                    {
                        "sense_id": "aa785764-e6c1-3e76-ba43-2f3831a914cc",
                        "entry_id": "813f0461-422b-364f-b246-5e0470464135",
                        "glosses": [
                            "Vorausschau auf die wirtschaftliche Gesamtlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a990581-7a73-4669-9919-7d795e8ce631",
                                "sense_id": "aa785764-e6c1-3e76-ba43-2f3831a914cc",
                                "text": "„Die bislang enttäuschend ausgefallene Konjunkturerholung veranlasste die Fed dazu, ihren Konjunkturausblick nach unten zu korrigieren.“"
                            },
                            {
                                "example_id": "728383de-2c3d-484a-b0e5-2e8352697f2d",
                                "sense_id": "aa785764-e6c1-3e76-ba43-2f3831a914cc",
                                "text": "„Marktprognosen und Konjunkturausblicke verschleiern die Fakten – deswegen hält Buffett beides für Zeitverschwendung und teilweise sogar gefährlich.“"
                            },
                            {
                                "example_id": "c318c7eb-86c0-4607-9b04-c2a9c73c28b3",
                                "sense_id": "aa785764-e6c1-3e76-ba43-2f3831a914cc",
                                "text": "„Die Credit Suisse AG rät angesichts des Konjunkturausblicks zu Aktien mit indirektem Bezug zum Konsumsektor in den Schwellenländern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
