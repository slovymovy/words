                    {
                        "translation_id": "5396e75f-3fda-4624-99e9-864cc4b8863b",
                        "source_entry_id": "d941667f-21ca-37cf-b730-ef9475d89e14",
                        "source_sense_id": "c71f4629-033b-3a72-9649-0c286f321dc8",
                        "source_sense_description": "een instrument om vochtigheid van de lucht te meten",
                        "target_lang_word": "higrómetro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "higrómetro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "161e1d1a-3135-3f70-bcdb-f4b3db68fa91",
                                        "entry_id": "a671da53-a872-35bc-9f96-1d0663fda881",
                                        "glosses": [
                                            "Dispositivo que se usa para cuantificar la humedad de la atmósfera o de otros gases. Puede ser de absorción, mediante substancias químicas que, luego de absorber, exhalan la humedad, o eléctrico, constituido por dos electrodos arrollados en espiral. La unidad de medida se expresa en porcentaje: %."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03d2553b-e01f-464b-b75a-5b5d4eed91ba",
                                                "sense_id": "161e1d1a-3135-3f70-bcdb-f4b3db68fa91",
                                                "text": "Cuando compramos un aire acondicionado muchas veces pasamos por alto muchas de las funciones que estos equipos traen incorporadas; una consola de aire acondicionado no sólo nos brinda la posibilidad de contrarrestar las altas temperaturas que sufrimos durante los meses de verano. Muchos de los equipos de aire acondicionado poseen un higrómetro, éste es un instrumento primordial que se emplea para medir la humedad del ambiente; posee a su vez un órgano sensible que se encuentra constituido por materiales orgánicos que cambian la longitud de su volumen cuando la humedad del ambiente varía. Antes de que los higrómetros existieran en las consolas de aires acondicionados, se utilizaban para confeccionarlos, membranas de animales, cabellos, fibras textiles, madera y otros materiales de tipo artificial. […] Los higrómetros de aire acondicionado poseen un higrostato, que son los encargados de medir mediante un sistema de palancas los cambios de longitud que se llevan a cabo. Los higrómetros del aire acondicionado también suelen denominarse higrómetros de condensación y los mismos se basan en el hecho de que el vapor de agua realiza su condensación sobre cuerpos fríos; manteniendo una cápsula fría, y haciendo que el vapor de agua pase por ella, éste se condensa. El higrómetro mide la temperatura a que este fenómeno se produce y conociendo la temperatura de ambiente se puede determinar la humedad"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
