                                            "countable",
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bcd18a9-25b1-3134-b00a-dd3ec19fdef3",
                                        "entry_id": "50454636-f18b-36a9-b10c-3c9ad8be1540",
                                        "glosses": [
                                            "The act of nursing or rearing."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec23b9f7-88b9-4733-9637-23b685e6fac2",
                                                "sense_id": "8bcd18a9-25b1-3134-b00a-dd3ec19fdef3",
                                                "text": "I lou'd her moſt, and thought to ſet my reſt / On her kind nurcery, [...]",
                                                "translation": "I loved her [Cordelia] most, and thought to set to spend my retirement relying / On her kind nursing, …",
                                                "english": "I loved her [Cordelia] most, and thought to set to spend my retirement relying / On her kind nursing, …"
                                            }
