                "translations": [
                    {
                        "translation_id": "b53c3c54-75f5-4264-8c44-ba3f0353500d",
                        "source_entry_id": "d85f565d-66fd-31d7-8974-8e6335df27ab",
                        "source_sense_id": "7125d6fe-1297-368b-a12f-700b818cbe94",
