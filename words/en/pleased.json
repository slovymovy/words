            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "181ae457-0992-389d-86c9-25eca9e69a4e",
                    "sense_definition": "Feeling or showing pleasure and satisfaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>pleased</w> to meet you at last.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то <w>рад</w> встретиться с вами.",
                                "zh": "终于见到你，我感到很<w>高兴</w>。",
                                "nl": "Ik ben eindelijk <w>blij</w> u te ontmoeten.",
                                "pl": "Jest mi bardzo <w>miło</w> cię wreszcie poznać.",
                                "de": "Ich bin <w>froh</w>, Sie endlich kennenzulernen.",
                                "fr": "Je suis <w>ravi</w> de vous rencontrer enfin.",
                                "it": "Sono <w>lieto</w> di conoscerti finalmente.",
                                "cs": "Jsem <w>rád</w>, že vás konečně poznávám.",
                                "tr": "Sizinle sonunda tanıştığıma <w>memnun oldum</w>.",
                                "es": "Estoy <w>contento</w> de conocerte por fin."
                            }
                        },
                        {
                            "text": "She was <w>pleased</w> with her good exam results.",
                            "target_lang_translations": {
                                "ru": "Она была <w>довольна</w> своими хорошими результатами экзаменов.",
                                "zh": "她对自己的优异考试成绩感到很<w>满意</w>。",
                                "nl": "Ze was <w>tevreden</w> met haar goede examenresultaten.",
                                "pl": "Była <w>zadowolona</w> ze swoich dobrych wyników egzaminu.",
                                "de": "Sie war <w>zufrieden</w> mit ihren guten Prüfungsergebnissen.",
                                "fr": "Elle était <w>satisfaite</w> de ses bons résultats aux examens.",
                                "it": "Era <w>contenta</w> dei suoi buoni risultati agli esami.",
                                "cs": "Byla <w>spokojená</w> se svými dobrými výsledky u zkoušek.",
                                "tr": "İyi sınav sonuçlarından dolayı <w>memnundu</w>.",
                                "es": "Ella estaba <w>satisfecha</w> con sus buenos resultados en los exámenes."
                            }
                        }
                    ],
                    "synonyms": [
                        "happy",
                        "satisfied",
                        "content",
                        "glad"
                    ],
                    "antonyms": [
                        "displeased",
                        "unhappy"
                    ],
                    "common_phrases": [
                        "pleased to meet you",
                        "pleased with",
                        "pleased to hear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выражающий удовольствие и удовлетворение.",
                        "zh": "感到或表现出快乐和满足。",
                        "nl": "Een gevoel van tevredenheid of blijdschap ervaren of tonen.",
                        "pl": "Odczuwanie lub okazywanie zadowolenia, satysfakcji lub radości.",
                        "de": "Ein Gefühl von Freude, Zufriedenheit oder Erleichterung empfindend.",
                        "fr": "Qui ressent ou exprime du plaisir, de la joie ou de la satisfaction.",
                        "it": "Che prova o manifesta piacere, soddisfazione o contentezza.",
                        "cs": "Pocit nebo projev potěšení a spokojenosti.",
                        "tr": "Memnuniyet veya mutluluk hissetme veya gösterme durumu.",
                        "es": "Que siente o muestra alegría, satisfacción o complacencia."
