                                "example_id": "6e856701-5781-4393-94b1-d2ba71e272e8",
                                "sense_id": "0407b280-c3e1-338d-a0a2-d1e50f0e2577",
                                "text": "„Dieses Hauptwerk soll längs der Escarpe mit einer cannelierten, hinten überwölbten Mauer umgeben, im Innern mit einem tüchtigen Reduit versehen und auf der dem regelmäßigen Angriff nicht ausgesetzten Seite nur gegen einen coup demain gesichert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
