                    {
                        "form_id": "0a7abace-683d-4ab3-950d-c7b22e055c0d",
                        "entry_id": "3fca782c-2a2e-3b9b-974c-f5d8bdc73cae",
                        "tags": [
                            "past"
                        ],
                        "form": "indoctrinated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8788f54-7d82-3a48-806d-d769b1e829ae",
                        "entry_id": "3fca782c-2a2e-3b9b-974c-f5d8bdc73cae",
                        "glosses": [
                            "To teach (a person) with a biased, one-sided or uncritical ideology; to brainwash."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                        "entry_id": "3fca782c-2a2e-3b9b-974c-f5d8bdc73cae",
                        "glosses": [
                            "To teach and instill (something, to a person) in a biased, one-sided way."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d791ceba-dfc7-461a-aa97-94a1ed2ef859",
                                "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                                "text": "[...] it was beyond their hope to indoctrinate Marxism-Leninism-Mao's \"thought\" into the mind of young generation. The young generation does not care about Communism."
                            },
                            {
                                "example_id": "ef890efe-885f-4f5d-8480-49b2b92ab646",
                                "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                                "text": "[They] attempt to further indoctrinate Christian values into local communities by first distorting the substance of the traditional rituals and then imputing another set of values to them."
                            },
                            {
                                "example_id": "daee680c-ba0d-4724-88d4-631aefd2c601",
                                "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                                "text": "She […] felt uncomfortable that she was to her mind 'pushing Christian values'. Apparently lurking beneath her discomfort was a sense that she was required to indoctrinate Christian values in a search for conformity rather than teaching to promote autonomy, which she regarded as her professional commitment."
                            },
                            {
                                "example_id": "8010734d-f0ad-426a-a68d-cbaccf28cd31",
                                "sense_id": "959e97b3-6f3b-30b9-a4ec-a8181140df15",
                                "text": "Further still, there were other little boys and girls whose parents DID know about the history [of the show promoting racism] who may have surely taken the time to infuse and indoctrinate it into the next generation."
                            }
                        ]
                    },
                    {
                        "sense_id": "3df11d7a-2ee7-3b4d-9e66-db4281b78fea",
                        "entry_id": "3fca782c-2a2e-3b9b-974c-f5d8bdc73cae",
                        "glosses": [
                            "To teach; to instruct."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8ee2f7b-96da-4280-80cb-5e572b144ef6",
                        "source_entry_id": "3fca782c-2a2e-3b9b-974c-f5d8bdc73cae",
