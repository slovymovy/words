                ],
                "senses": [
                    {
                        "sense_id": "77ad0d74-3daf-33d3-b080-b57c1ba83dd9",
                        "entry_id": "d226251a-c306-38a7-8973-b53760d60723",
                        "glosses": [
                            "Enlever son caractère afghan à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896d32db-6c35-45e5-9321-a1452f7b4d67",
                                "sense_id": "77ad0d74-3daf-33d3-b080-b57c1ba83dd9",
                                "text": "10 ans d'Afghanistan auront profondément marqué une génération de soldats. Faut-il aujourd'hui « désafghaniser » l'armée de terre ?"
                            },
                            {
                                "example_id": "7ae5223b-0bb8-4b08-b23d-d4e37863dfd0",
                                "sense_id": "77ad0d74-3daf-33d3-b080-b57c1ba83dd9",
                                "text": "Certains de nos voisins, dont le Pakistan, ont clairement cherché à \" désafghaniser \" notre pays, à le dépouiller de son caractère national et de son identité historique."
                            },
                            {
                                "example_id": "5431d9cb-ca60-4f24-b93b-1044bf83d79d",
                                "sense_id": "77ad0d74-3daf-33d3-b080-b57c1ba83dd9",
                                "text": "Elle précise aussi que « les pays occidentaux ne doivent pas « désafghaniser » l'évolution et que d'éventuelles négociations avec les Taliban ne relèvent pas de la responsabilité de l’OTAN, mais des autorités afghanes »."
                            }
                        ]
                    }
