                        "foreign climates",
                        "northern climates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный регион Земли, выделяемый по своим погодным условиям.",
                        "zh": "指地球上以天气状况为特征的特定区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "края",
