        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27498318-55ee-3ecf-8851-f6dbc487a4a4",
                    "sense_definition": "Wie of wat niet meer door anderen wordt gevolgd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "last_one",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wanneer jullie weggaan, moet de <w>laatste</w> het licht uitdoen.",
                            "target_lang_translations": {
                                "ru": "Когда будете уходить, <w>последний</w> должен выключить свет.",
                                "en": "When you leave, the <w>last person</w> must turn off the lights.",
                                "pl": "Kiedy będziecie wychodzić, <w>ostatni</w> musi zgasić światło.",
                                "de": "Wenn ihr geht, muss der <w>Letzte</w> das Licht ausmachen.",
                                "fr": "Quand vous partirez, le <w>dernier</w> devra éteindre la lumière.",
                                "it": "Quando ve ne andate, l'<w>ultimo</w> deve spegnere la luce.",
                                "cs": "Až budete odcházet, ten <w>poslední</w> musí zhasnout světlo.",
                                "tr": "Gittiğinizde, <w>sonuncu</w> ışığı kapatmalı.",
                                "es": "Cuando os vayáis, el <w>último</w> debe apagar la luz."
                            }
                        },
                        {
                            "text": "Hij kwam als <w>laatste</w> binnen bij de vergadering.",
                            "target_lang_translations": {
                                "ru": "Он вошел на собрание <w>последним</w>.",
                                "en": "He entered the meeting <w>last</w>.",
                                "pl": "Wszedł na spotkanie jako <w>ostatni</w>.",
                                "de": "Er kam als <w>Letzter</w> zur Besprechung.",
                                "fr": "Il est entré en <w>dernier</w> à la réunion.",
                                "it": "È entrato alla riunione per <w>ultimo</w>.",
                                "cs": "Na schůzi přišel jako <w>poslední</w>.",
                                "tr": "Toplantıya <w>en son</w> o girdi.",
                                "es": "Él entró el <w>último</w> a la reunión."
                            }
                        }
                    ],
