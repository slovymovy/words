    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "14cbbad2-7ef7-3c4a-b263-dfe0bcebf8e4",
                    "sense_definition": "Producing powerful feelings or strong, clear images in the mind.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>vivid</w> memory of my first day at school.",
                            "target_lang_translations": {
                                "ru": "У меня сохранилось <w>я́ркое</w> воспоминание о моем первом дне в школе.",
                                "pl": "Mam <w>żywe</w> wspomnienie mojego pierwszego dnia w szkole."
                            }
                        },
                        {
                            "text": "The author gave a <w>vivid</w> description of the beautiful landscape.",
                            "target_lang_translations": {
                                "ru": "Автор дал <w>живо́е</w> описание красивого пейзажа.",
                                "pl": "Autor przedstawił <w>plastyczny</w> opis pięknego krajobrazu."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "graphic",
                        "detailed",
                        "realistic",
                        "distinct"
                    ],
                    "antonyms": [
                        "vague",
                        "fuzzy",
                        "unclear",
                        "hazy"
                    ],
                    "common_phrases": [
                        "vivid memory",
                        "vivid imagination",
                        "vivid dream",
                        "vivid description",
                        "vivid recollection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сильные чувства или четкие образы в сознании",
                        "pl": "Wywołujący silne uczucia lub wyraźne obrazy w umyśle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живо́й",
                                "target_lang_sense_clarification": "о воображении, воспоминаниях или интересе"
                            },
                            {
                                "target_lang_word": "я́ркий",
                                "target_lang_sense_clarification": "о впечатлениях, описаниях или снах"
                            },
                            {
                                "target_lang_word": "отчётливый",
                                "target_lang_sense_clarification": "ясный, хорошо различимый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "żywy",
                                "target_lang_sense_clarification": "o wspomnieniach, wyobraźni lub opisach"
                            },
                            {
                                "target_lang_word": "wyrazisty",
                                "target_lang_sense_clarification": "o opisach lub wspomnieniach"
                            },
                            {
                                "target_lang_word": "plastyczny",
                                "target_lang_sense_clarification": "o opisach pobudzających wyobraźnię"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49db283f-1e90-3791-a6ed-3969e18a6cba",
                    "sense_definition": "Having or producing very bright, intense, and distinct colors.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "visual_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with flowers of <w>vivid</w> red and yellow.",
                            "target_lang_translations": {
                                "ru": "Сад был полон цветов <w>я́рких</w> красных и желтых оттенков.",
                                "pl": "Ogród był pełen kwiatów o <w>jaskrawych</w> odcieniach czerwieni i żółci."
                            }
                        },
                        {
                            "text": "She wore a <w>vivid</w> blue dress that stood out in the crowd.",
                            "target_lang_translations": {
                                "ru": "На ней было <w>насы́щенное</w> синее платье, которое выделялось в толпе.",
                                "pl": "Miała na sobie <w>nasyconą</w> niebieską sukienkę, która wyróżniała się w tłumie."
                            }
                        }
                    ],
                    "synonyms": [
                        "bright",
                        "brilliant",
                        "intense",
                        "colorful",
                        "vibrant"
                    ],
                    "antonyms": [
                        "dull",
                        "pale",
                        "faded",
                        "drab"
