                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0956db39-e19e-4b77-b0d5-fed79fdfc1cc",
                                "sense_id": "719068a8-7a53-370d-a4d8-ed6625ee0d8f",
                                "text": "The purest literary talent appears at one time great, at another time small, but character is of a stellar and undiminishable greatness."
                            },
                            {
                                "example_id": "d97b314b-74e6-40f4-818e-af7a2c561ddb",
                                "sense_id": "719068a8-7a53-370d-a4d8-ed6625ee0d8f",
                                "text": "1957, J. D. Salinger, \"Zooey\", in, 1961, Franny and Zooey, 1991 LB Books edition, page 52,\n[…] could have disfigured or coarsened his his bounteous good looks in a day or a second. But what was undiminishable […] was an authentic esprit superimposed over his entire face […]"
                            }
                        ]
                    }
