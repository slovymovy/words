                "translations": [
                    {
                        "translation_id": "0c83b885-4ea1-448e-b295-ebcce54413ff",
                        "source_entry_id": "86934c89-269d-3d82-be6e-8a4032d96f0c",
                        "source_sense_id": "c9465136-f047-3ec1-9596-521afe27024b",
                        "source_sense_description": "beschwerliche Lage, Situation",
                        "target_lang_word": "trouble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trouble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1148f4d6-1ea3-3fb7-b297-b60a877b8abf",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A distressing or dangerous situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e14807-2bc0-4dcd-8034-e819c4c92c03",
                                                "sense_id": "1148f4d6-1ea3-3fb7-b297-b60a877b8abf",
                                                "text": "He was in trouble when the rain started."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A difficulty, problem, condition, or action contributing to such a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e26cb915-64aa-427c-831a-25256c2f2db5",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "The trouble was a leaking brake line."
                                            },
                                            {
                                                "example_id": "34c66b71-3813-43c4-85d3-fc0efd5db363",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "The bridge column magnified the trouble with a slight tilt in the wrong direction."
                                            },
                                            {
                                                "example_id": "1b379515-2be1-44e9-889c-09c9b214b862",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "Lest the fiend […] some new trouble raise."
                                            },
                                            {
                                                "example_id": "2a704036-ad79-4750-9c30-58233e0b0e77",
                                                "sense_id": "0e9d6a9c-6132-31bd-98d0-ad7d918b8cf9",
                                                "text": "Foul whisperings are abroad; unnatural deeds / Do breed unnatural troubles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1556e72c-a9d9-3d4e-bc43-bf7941536724",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "A person liable to place others or themselves in such a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "251d154a-dc1c-4f9e-9fd3-f92e1821240c",
                                                "sense_id": "1556e72c-a9d9-3d4e-bc43-bf7941536724",
                                                "text": "’Cause I knew you were trouble when you walked in\nSo shame on me no-ow"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2611545-76f8-3f8e-a168-d1717ecccad5",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "The state of being troubled, disturbed, or distressed mentally; unease, disquiet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21cabb79-9ad6-4ad5-8c6b-59f2942395ae",
                                                "sense_id": "d2611545-76f8-3f8e-a168-d1717ecccad5",
                                                "text": "Yet oft when sundown skirts the moor\n⁠An inner trouble I behold,\n⁠A spectral doubt which makes me cold,\nThat I shall be thy mate no more, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Objectionable feature of something or someone; problem, drawback, weakness, failing, or shortcoming."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df34105b-616c-4814-8961-d3efdce03655",
                                                "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                                "text": "Your trouble is that you quit too readily."
                                            },
                                            {
                                                "example_id": "7c01496b-28c1-4a36-8bbc-e69faba5fd63",
                                                "sense_id": "35538dbe-02e1-3c5a-a884-216a6d170270",
                                                "text": "The trouble with that suggestion is that we lack the funds to put it in motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Violent or turbulent occurrence or event; unrest, disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116dea0c-70c6-4e55-b95a-50f636a0c4c6",
                                                "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                                "text": "the troubles in Northern Ireland"
                                            },
                                            {
                                                "example_id": "7dc29a1e-daee-4dd2-99db-2387464997b0",
                                                "sense_id": "cf0a52de-c4be-33b0-b5ea-ac7a1b4ea674",
                                                "text": "“I don’t know how you and the ‘head,’ as you call him, will get on, but I do know that if you call my duds a ‘livery’ again there’ll be trouble. It’s bad enough to go around togged out like a life saver on a drill day, but I can stand that ’cause I'm paid for it. What I won’t stand is to have them togs called a livery. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Efforts taken or expended, typically beyond the normal required."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc34156-d002-4560-839f-05b44c182d5d",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "It’s no trouble for me to edit it."
                                            },
                                            {
                                                "example_id": "fda9f9d6-3d1f-45f1-a0b8-5436cbd77db1",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "She never took the trouble to close them."
                                            },
                                            {
                                                "example_id": "970406ab-a0ce-47df-b37a-e895f4f2b862",
                                                "sense_id": "d05f5fde-0d96-3302-b4b9-43f73624fbeb",
                                                "text": "Indeed, by the report of our elders, this nervous preparation for old age is only trouble thrown away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a6763fa-d6e4-3df4-8f49-bdd0e69c8ff0",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Difficulty in doing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63486427-ebb3-42f9-928c-5ec62f773158",
                                                "sense_id": "1a6763fa-d6e4-3df4-8f49-bdd0e69c8ff0",
                                                "text": "She has trouble eating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24d3be10-abfc-3ffe-ab7d-7b9fc7bea13a",
                                        "entry_id": "ff9b649b-79e7-3ee5-8960-d61a2cfa06bb",
                                        "glosses": [
                                            "Health problems, ailment, generally of some particular part of the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4334b51f-6892-43a8-a391-e899a18206d5",
                                                "sense_id": "24d3be10-abfc-3ffe-ab7d-7b9fc7bea13a",
