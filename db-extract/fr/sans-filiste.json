                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c219fcb-f729-3b5c-a6a6-e062adbe2502",
                        "entry_id": "66b1b866-4780-3e36-9960-4c343a920b9e",
                        "glosses": [
                            "Technicien de la télégraphie sans fil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748f0334-1344-497e-877e-c63aeaa263aa",
                                "sense_id": "5c219fcb-f729-3b5c-a6a6-e062adbe2502",
                                "text": "À dix heures quinze, le sans-filiste du yacht radiographiait ces mots : « Mettons cap sur Nikolaïa […] »"
                            },
                            {
                                "example_id": "e90930f8-90b2-4fa2-b3d5-85baecbaca91",
                                "sense_id": "5c219fcb-f729-3b5c-a6a6-e062adbe2502",
                                "text": "Poète ! reprocha doucement Hardy, mais vous êtes sur les mêmes ondes que la nuit de mai, comme diraient les sans-filistes."
                            },
                            {
                                "example_id": "93c8d086-7431-4726-a6a5-c8ec45ad91c2",
                                "sense_id": "5c219fcb-f729-3b5c-a6a6-e062adbe2502",
                                "text": "Ce bachelier savait l’allemand ; il se chargeait de traduire le communiqué de Nauen, que notre Sans-Filiste prenait lettre à lettre."
                            }
                        ]
                    },
                    {
                        "sense_id": "e14d226c-b8a4-3712-90b8-1ad93d56faa8",
                        "entry_id": "66b1b866-4780-3e36-9960-4c343a920b9e",
                        "glosses": [
                            "Amateur de télégraphie sans fil ou de téléphonie sans fil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a91f64b-781d-4054-b9f2-07b0be73c35f",
                                "sense_id": "e14d226c-b8a4-3712-90b8-1ad93d56faa8",
                                "text": "Mon père, peintre et professeur de dessin était aussi un sans-filiste passionné. Il avait réussi à capter le son, je dis bien le son, sur son poste de radio à lampe en ondes ultracourtes."
                            }
                        ]
                    }
                ],
