                                "example_id": "cf06c336-8a69-498e-8f7c-2f6288337d5a",
                                "sense_id": "ea3998a6-390b-399a-9e0f-1a79d6a322f1",
                                "text": "What happens to a protocol after it is prereviewed? Opin. After a protocol is prereviewed, the investigator submits a modified or unmodified protocol that must be processed for formal review by the IACUC."
                            },
                            {
                                "example_id": "28538b96-c393-411f-a18f-f69a883d9f13",
                                "sense_id": "ea3998a6-390b-399a-9e0f-1a79d6a322f1",
                                "text": "As one of the largest producers of genetically modified (GM) seeds in the country, Monsanto has been vilified by activists who describe GM products as 'frankenfood.'"
                            }
                        ]
                    }
