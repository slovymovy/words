                        "sense_id": "0fef2c9c-00ae-3873-ae28-fb9fd53f596b",
                        "entry_id": "3b366743-3785-39f2-b95a-55a0f7de93d2",
                        "glosses": [
                            "jedno z małżonków w stosunku do drugiego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0c5f667-3714-4e60-8e84-c00aadfaa432",
                                "sense_id": "0fef2c9c-00ae-3873-ae28-fb9fd53f596b",
                                "text": "Standardowa formuła podziękowania współmałżonkowi wypowiadana przez jubilatów nawiązywała literalnie do tej, którą wygłaszano w czasie ślubu cywilnego."
                            },
                            {
                                "example_id": "99d6385e-6f3f-4dfd-bc27-eeb1a2f18f40",
                                "sense_id": "0fef2c9c-00ae-3873-ae28-fb9fd53f596b",
                                "text": "W przypadku małżeństwa oraz innych współwłaścicieli gospodarstwa rolnego nadaje się jeden numer identyfikacyjny osobie, na którą współmałżonek lub współposiadacz wyrazili zgodę."
                            }
                        ],
