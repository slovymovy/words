                                                "sense_id": "1090372d-feaa-37b8-8ab8-7e37b14d501d",
                                                "text": "C’est un maître dans l’art du contrepet et on a du mal à le suivre !"
                                            },
                                            {
                                                "example_id": "6a9d5f81-0410-40cd-84f5-cd589f828539",
                                                "sense_id": "1090372d-feaa-37b8-8ab8-7e37b14d501d",
                                                "text": "Les Français ont ’un art du contrepet’: c’est un jeu de coterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef0c241-cfa3-3f02-ba7e-23888fb04f19",
                                        "entry_id": "15fa56a0-da76-330d-825a-056f5a174076",
                                        "glosses": [
                                            "Contrepèterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d2eb07-b2c0-4c50-b4cc-069ac2de059a",
                                                "sense_id": "cef0c241-cfa3-3f02-ba7e-23888fb04f19",
                                                "text": "Il adore faire des contrepets."
                                            }
                                        ]
                                    }
                                ]
                            }
