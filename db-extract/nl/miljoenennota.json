                "senses": [
                    {
                        "sense_id": "c6e4fa41-c597-332c-9d15-84441ee06408",
                        "entry_id": "3abd8621-192d-3d88-92e9-8c37fbb748d0",
                        "glosses": [
                            "de begroting van de Nederlandse rijksoverheid ingediend door de minister van Financiën op de derde dinsdag van september"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8160fd4-92cc-4c19-8807-1432bdce8b03",
                                "sense_id": "c6e4fa41-c597-332c-9d15-84441ee06408",
                                "text": "Normaal stelt de Nederlandse premier de rijksbegroting voor op Prinsjesdag. Deze valt telkens de derde dinsdag van september. Het is een plechtige aangelegenheid. Het staatshoofd, nu dus koning Willem Alexander, houdt er voor de verzamelde Staten-Generaal de Troonrede. Daarna legt de regering uit welk beleid ze het komende jaar zal voeren, en stelt ze de begroting en de zogenaamde ‘miljoenennota’ - een toelichting bij die begroting - voor."
                            },
                            {
                                "example_id": "dfcf92f7-49b2-4044-b463-dad7daaebc5d",
                                "sense_id": "c6e4fa41-c597-332c-9d15-84441ee06408",
                                "text": "De overheid kwam in 2015 ruim 12 miljard euro tekort, 3 miljard minder dan in 2014. Daarmee voldoet Nederland voor het derde achtereenvolgende jaar aan de 3-procentnorm van Brussel. Het tekort is wel iets lager uitgekomen dan werd aangenomen. De Miljoenennota van een half jaar geleden ging nog uit van 2,2 procent en de recente maartraming van het Centraal Planbureau (CPB) van 1,9 procent."
                            }
                        ]
                    }
