                    {
                        "sense_id": "4532132d-8647-33ec-b056-937b5cb7a3c6",
                        "entry_id": "edf211a3-fde4-3957-9c2b-744f54e921f2",
                        "glosses": [
                            "A form of fine-grained quartz that is nearly transparent or has a milky translucence; it fractures conchoidally."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9c094d05-3bd4-4045-b24f-18aaecc92ef2",
                                "sense_id": "4532132d-8647-33ec-b056-937b5cb7a3c6",
                                "text": "Although there are dozens of different types of gems, among the best known and most important are […] . (Common gem materials not addressed in this article include amber, amethyst, chalcedony, garnet, lazurite, malachite, opals, peridot, rhodonite, spinel, tourmaline, turquoise and zircon.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1fdabf8-ce41-4e9b-8bbc-ba5a76a6429c",
                        "source_entry_id": "edf211a3-fde4-3957-9c2b-744f54e921f2",
                        "source_sense_id": "4532132d-8647-33ec-b056-937b5cb7a3c6",
