                            {
                                "example_id": "5ab2bc8d-e085-4646-8d8f-a562b1a7ab09",
                                "sense_id": "e64e3a94-a073-34e0-a3f4-2e5427cfafaf",
                                "text": "Je suis ton Amadis,\nMa levrette,\nMa civette,\nMa friquette,\nSois douce ou non,\nJe trouverai tout bon."
                            }
                        ]
                    },
                    {
                        "sense_id": "54f3e19e-cfad-3606-a24b-20c992775eb5",
                        "entry_id": "ad079cc6-242a-3093-9e7b-54fb1837fa68",
                        "glosses": [
                            "Femelle du moineau friquet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bebc24de-b8e1-4351-b7bc-1ee4542a34a9",
                                "sense_id": "54f3e19e-cfad-3606-a24b-20c992775eb5",
                                "text": "Il vit des acheteurs payer les moineaux à très-bas prix ; il se hasarda à demander combien valait la paire. « Deux sous les friquets et un sou les friquettes », répondit le marchand."
                            }
                        ]
                    }
