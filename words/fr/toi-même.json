                    "semantic_group_id": "insistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu veux que ce soit bien fait, fais-le <w>toi-même</w>."
                        },
                        {
                            "text": "Tu devrais réparer ton vélo <w>toi-même</w> au lieu de payer un réparateur."
                        }
                    ],
