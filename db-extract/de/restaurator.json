                ],
                "senses": [
                    {
                        "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                        "entry_id": "be51b1f8-6741-38db-8844-6c188075bb07",
                        "glosses": [
                            "Person, die aufgrund ihrer Ausbildung dazu in der Lage ist Restaurierungsarbeiten fachgerecht durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd2720da-f900-4ba7-85dc-0e519c4897ec",
                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                "text": "„In der Werkstätte von Restaurator Thomas Frankl geht es nun darum, die Holzsärge von Schimmel zu reinigen, die Substanz zu erhalten und die Bemalungen und Beschläge zu konservieren.“"
                            },
                            {
                                "example_id": "bab2b25a-9ed3-4e74-8a4d-27d8c1f1b379",
                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                "text": "„Ihr Verkauf brachte dem Restaurator aus Niederbayern mehr als eine halbe Million Euro - bis ihm ein Kunsthistoriker auf die Spur kam.“"
                            },
                            {
                                "example_id": "6fe2e874-9bab-4f4d-b1e5-f8565dbede4f",
                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                "text": "„Museumsrundgang, Obergeschoss, der Restaurator geleitet durch die hohen Hallen wie ein Fremdenführer.“"
                            },
                            {
                                "example_id": "38ac797e-6670-4dbb-b5bc-3aeb001f8ae0",
                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                "text": "„Als Restaurator von Orgeln verdiente er sein täglich Brot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbafb19e-690c-44da-b701-8b96eca2857c",
                        "source_entry_id": "be51b1f8-6741-38db-8844-6c188075bb07",
                        "source_sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                        "source_sense_description": "Person, die aufgrund ihrer Ausbildung dazu in der Lage ist Restaurierungsarbeiten fachgerecht durchzuführen",
                        "target_lang_word": "restorer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restorer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                                        "entry_id": "db70dbe0-4ef7-3e99-a458-574356cd2c9a",
                                        "glosses": [
                                            "Something or someone that restores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bbe14d-338d-45a0-b13c-d035297d5ee6",
                                                "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                                                "text": "Slightly mesmerized by this accomplishment, Rita asked, \"Are you a chair mender?\" \"I'm the best carver, joiner, and expert furniture restorer in this country. So what about it?\" \"If you really are a good restorer - you'll have to wait a minute, though. I'm only looking after the place for the owner at present. I'll have to consult her.\""
                                            },
                                            {
                                                "example_id": "18a92356-e311-4634-845c-662a43a1f9d8",
                                                "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nInside its exhibit hall, behind panes of glass, in a white-lit lab, a team of restorers works on an ancient Byzantine floor: 44 square yards of stone shards rescued from Lot’s Cave Monastery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e39a98d-cb27-4988-a6b6-ffb267a7f5ff",
                        "source_entry_id": "be51b1f8-6741-38db-8844-6c188075bb07",
                        "source_sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                        "source_sense_description": "Person, die aufgrund ihrer Ausbildung dazu in der Lage ist Restaurierungsarbeiten fachgerecht durchzuführen",
                        "target_lang_word": "restaurateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "restaurateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                        "entry_id": "0045172c-5621-3cbc-a083-de0eb451b672",
                                        "glosses": [
                                            "Celui qui répare, qui rétablit."
                                        ],
                                        "tags": [],
                                        "note": "Il s’emploie surtout au figuré et ne se dit guère, au sens propre, qu’en parlant des villes, des monuments publics ou des œuvres d’art",
                                        "examples": [
                                            {
                                                "example_id": "b9fd7768-845f-4c23-8f09-ae532e3c59ba",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Après avoir enlevé la bronzine pour la remplacer par de la dorure, les restaurateurs découvrent la polychromie originelle."
                                            },
                                            {
                                                "example_id": "4161944c-80c8-44e7-a6ff-bb714016d8dc",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Avec ses recettes, Lamberti est devenu le patriarche des restaurateurs de peinture."
                                            },
                                            {
                                                "example_id": "d46fdc80-b380-4cd8-8abb-4b6d793c8fc6",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "[…] un petit vieillard vêtu d’une houppelande […] surveillait son restaurateur, un peintre occupé à réparer des tableaux."
                                            },
                                            {
                                                "example_id": "e553d5bb-ac4f-4924-a4d1-2002be72af68",
                                                "sense_id": "363be921-875e-3898-ac84-6056a295efb5",
                                                "text": "Voilà l'ancien révolutionnaire, député de la Convention sous Robespierre, enrôlé sous la bannière de l’auteur du coup d’État du 2 décembre, restaurateur d'une monarchie !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8841286f-de29-3e5a-84e9-87f998f9d64d",
                                        "entry_id": "0045172c-5621-3cbc-a083-de0eb451b672",
                                        "glosses": [
                                            "Celui qui tient un restaurant, s’occupe de le gérer ou préparer les repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162063de-6602-4383-9ebe-1ca77f9051f3",
                                                "sense_id": "8841286f-de29-3e5a-84e9-87f998f9d64d",
                                                "text": "Trévise, quant à elle, est formelle, c’est à la signora Alba, épouse du restaurateur Campeol, que revient la conception, dans les années 1960, de l’actuel tiramisu : la finaude sut transformer une erreur, du mascarpone versé par inadvertance dans un sabayon, en recette miraculeuse enrichie au cacao et au café."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "restaurateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23582c20-caff-3ec1-ae01-49ce84606a2f",
                                        "entry_id": "54113d1a-dc70-3d21-9e33-bead03c32dd4",
                                        "glosses": [
