                        "translation_id": "c5c1a0b6-4376-476f-8e4e-475ae447ab12",
                        "source_entry_id": "815a905a-4428-3f08-afb0-6ca99a723df3",
                        "source_sense_id": "f63f210c-fc80-3c6b-8316-c8c7e4fe2b62",
                        "source_sense_description": "quality of being ingenious",
                        "target_lang_word": "ingéniosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ingéniosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                        "entry_id": "30e14e33-ed27-39b6-8ef6-95c6890ace32",
                                        "glosses": [
                                            "Qualité qui fait qu’une personne est ingénieuse, adroite, inventive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45ad5858-aced-45c5-addb-d428997b83dc",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] puis il avait remonté les crêts par un des milles^([sic]) sentiers que l’ingéniosité des contrebandiers leur fait sans cesse frayer à travers ces prés-bois et ces boqueteaux de sapins."
                                            },
                                            {
                                                "example_id": "77deaf63-764d-42b4-8835-834599900f4c",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "[…] la préoccupation qui, chez les hommes, semble dominer toutes les autres, c’est celle de la vitesse obtenue soit par leurs propres moyens, soit par des instruments, et des appareils de locomotion, au perfectionnement desquels ils appliquent le meilleur de leur ingéniosité et de leurs facultés inventives."
                                            },
                                            {
                                                "example_id": "01624a39-86a4-4fc1-a206-1dfc535d930d",
                                                "sense_id": "0af2b0a2-f929-3499-9139-16e49b6a6710",
                                                "text": "Rappelons seulement que la harira, soupe marocaine très spécifique est, quand elle est réussie, un chef-d’œuvre de l’ingéniosité des femmes de cette contrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "282da64f-211e-4795-a38f-bbddd2c5581f",
                        "source_entry_id": "815a905a-4428-3f08-afb0-6ca99a723df3",
                        "source_sense_id": "f63f210c-fc80-3c6b-8316-c8c7e4fe2b62",
                        "source_sense_description": "quality of being ingenious",
                        "target_lang_word": "Einfallsreichtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfallsreichtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                        "entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                                        "glosses": [
                                            "Vorhandensein vieler Einfälle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844a60da-80cd-4b87-b078-b6bc87b2a92a",
                                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                                "text": "„Nur wird fantasievoller und witziger geschimpft - und man hat den Eindruck, dem Einfallsreichtum der Schimpfenden sind keine Grenzen gesetzt.“"
                                            },
                                            {
                                                "example_id": "80e67d5a-65d7-481b-9bc1-70e41380840f",
                                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                                "text": "„Was sie auszeichnete, war einzig ein gewisser Einfallsreichtum an Verwahrlosung, der sich bis auf die Straßen und in die Hinterhöfe fortsetzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2af19bf0-4cb9-4f61-8af0-2bca0a62a693",
                        "source_entry_id": "815a905a-4428-3f08-afb0-6ca99a723df3",
                        "source_sense_id": "f63f210c-fc80-3c6b-8316-c8c7e4fe2b62",
                        "source_sense_description": "quality of being ingenious",
                        "target_lang_word": "Findigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Findigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                        "entry_id": "307d745d-c1ee-3ec3-b62f-7539219a7d4f",
                                        "glosses": [
                                            "die Eigenschaft, findig zu sein"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6436fd17-3589-4896-9f9e-6862ae958d06",
                                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                                "text": "„Am meisten faszinierte ihn die Findigkeit der Arbeiter beim Diebstahl.“"
                                            },
                                            {
                                                "example_id": "1508c1f2-2775-4645-88b3-ff20fa5692c1",
                                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                                "text": "„Das alles soll in diesem kurzen Strich stecken, auch der für seine Tüchtigkeit, seine Findigkeit und Fertigkeit gerühmte Fischer, dem vor keinem Wetter bange war, der zu viel trank, zugleich aber über einen unstillbaren Wissensdurst verfügte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
