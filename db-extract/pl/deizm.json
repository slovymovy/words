                                        "sense_id": "ae2e7028-e6e1-360a-b733-697464a6c4a3",
                                        "entry_id": "74a6e4b1-c16f-3720-af35-2767909ef7b0",
                                        "glosses": [
                                            "Evren’i başlangıçta yaratan, fakat işleyişine müdahale etmeyen bir tanrının varlığını savunan felsefî görüş."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d90d1fd-d54c-44d3-812e-af11d6c26710",
                                                "sense_id": "ae2e7028-e6e1-360a-b733-697464a6c4a3",
                                                "text": "Vahiy aracılığıyla indiği iddia edilen her türlü dînî bilgiye karşı çıkan deizm, belli bir dînî bilginin herkeste doğuştan olduğunu ya da akılla elde edebileceğini iddia eder."
                                            }
                                        ]
