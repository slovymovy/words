                    {
                        "translation_id": "eb22ea79-d65e-449e-8ddf-7704acf66635",
                        "source_entry_id": "d3ac40c4-a5c7-3deb-8c2c-4164ef1dbeaf",
                        "source_sense_id": "a3654965-0028-36ae-98b2-92d4822cfe51",
                        "source_sense_description": "japanisches Fleischspießchen meist aus Hühnerfleisch: Yakitori",
                        "target_lang_word": "Yakitori",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yakitori",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9272014f-1f92-38bc-9510-b20fdccb1b26",
                                        "entry_id": "a0b3d4f3-209a-389e-89a1-3dd27a6ed3b2",
                                        "glosses": [
                                            "gebratenes oder gegrilltes Fleischspießchen (besonders mit Hühnerfleisch), typischerweise mit Teriyaki-Soße serviert"
                                        ],
                                        "tags": [
                                            "japanische Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8048ef12-8108-4247-ac4e-211e94ef53be",
                                                "sense_id": "9272014f-1f92-38bc-9510-b20fdccb1b26",
                                                "text": "„Sie genoss Sashimi, Wantan (gefüllte Reisteigbeutel gedämpft im Bambuskorb) und Yakitori (gebratene Filetstücke am Zitronengrasspieß) und zeigte sich rundum zufrieden […].“"
                                            },
                                            {
                                                "example_id": "3cf569ab-e21d-44ce-98ff-3c00a46dbf9c",
                                                "sense_id": "9272014f-1f92-38bc-9510-b20fdccb1b26",
                                                "text": "„Sobald der Rost superheiss ist, die Yakitoris schön braun grillen, immer wieder mit der übriggebliebenen Marinade beträufeln, und aufpassen, daß das Huhn nicht zu trocken wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fdfa44c-3856-433a-b460-cdc89b16f7e0",
                        "source_entry_id": "d3ac40c4-a5c7-3deb-8c2c-4164ef1dbeaf",
                        "source_sense_id": "a3654965-0028-36ae-98b2-92d4822cfe51",
                        "source_sense_description": "japanisches Fleischspießchen meist aus Hühnerfleisch: Yakitori",
                        "target_lang_word": "yakitori",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yakitori",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                        "entry_id": "79de8077-15ae-3b28-bcd2-1b03d24957eb",
                                        "glosses": [
                                            "Brochette de volaille grillée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0107fe6-ead1-4f3c-b472-dac82d111e09",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "Admirer le feu d’artifice une bière à la main en grignotant des yakitoris et des graines de soja sans se faire bousculer par la foule, c’est un luxe extraordinaire."
                                            },
                                            {
                                                "example_id": "9d1449b1-f072-472d-9b61-4c0ce93c6801",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "– Je peux passer te prendre à quelle heure ce soir ? Je t’achèterai des yakitori."
                                            },
                                            {
                                                "example_id": "69333455-1bd1-40aa-a652-8be5c7bdfa2b",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "J’ouvre le réfrigérateur. Il n’y a pas grand-chose ; fromage, pains tranchés, saucisses. Je n’aime pas ces produits. Je veux manger une soupe de miso, du poisson grillé, des yakitoris, des sashimis."
                                            },
                                            {
                                                "example_id": "9177f51e-59ce-416f-abc0-7d9ef5310d4d",
                                                "sense_id": "27de20f4-a416-38a0-b3c8-ed58604eddab",
                                                "text": "Pareil pour les yakitoris, des brochettes de légumes et de poulet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
