                ],
                "senses": [
                    {
                        "sense_id": "eaed664d-4f32-339c-8044-bc88a9ab7019",
                        "entry_id": "7dbd626c-955e-3470-a06d-40329653c953",
                        "glosses": [
                            "met een gordel omgeven, omringen, omdoen"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "7242a36e-5ac8-412f-9f1e-b458e59e64c4",
                                "sense_id": "eaed664d-4f32-339c-8044-bc88a9ab7019",
                                "text": "'t Zijn vijftig jaren dan, sints met beschroomde stoutheid\nuw jonkheid zich omgordde, om de eêlste vrucht der oudheid\naan d' Amsterl gâ te slaan met zijner zonen bloem, ..."
                            },
                            {
                                "example_id": "e1ff53c5-f41c-44ed-af25-22569bf7a73c",
                                "sense_id": "eaed664d-4f32-339c-8044-bc88a9ab7019",
                                "text": "Ik liet mijn blik waren over het landgoed dat het hotel omgordde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed7f940c-51a6-4917-be34-3f03e6b6978b",
                        "source_entry_id": "7dbd626c-955e-3470-a06d-40329653c953",
                        "source_sense_id": "eaed664d-4f32-339c-8044-bc88a9ab7019",
                        "source_sense_description": "met een gordel omgeven",
                        "target_lang_word": "ceindre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceindre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42462358-b361-38c9-aba6-c48f98f234ef",
                                        "entry_id": "e195e1b4-4b39-3be6-9fb2-6afe672ce98b",
                                        "glosses": [
                                            "Entourer ; environner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a8a8841-4aaa-4766-83c7-a6ec4763ef08",
                                                "sense_id": "42462358-b361-38c9-aba6-c48f98f234ef",
                                                "text": "Pendant que le « grand frisé » s’occupe du déjeuner, nous allons promener les enfants dans les allées de tilleuls qui ceignent les débris des vieilles tours de garde du château."
                                            },
                                            {
                                                "example_id": "f8da0230-c9b5-4213-a3ff-051c7ad8a500",
                                                "sense_id": "42462358-b361-38c9-aba6-c48f98f234ef",
                                                "text": "Cette zone forestière correspond à la région humide des nuages qui ceignent les flancs du pic pendant la majeure partie de l’année et qui se dissipent généralement le soir pour reparaître peu après le lever du soleil."
                                            },
                                            {
                                                "example_id": "477fef70-6c82-479c-9cb6-d2adafd3cb63",
                                                "sense_id": "42462358-b361-38c9-aba6-c48f98f234ef",
                                                "text": "Là, un chef d’équipe les comptait, pointait sur un carnet de mystérieux chiffres et ceignait ensuite la pile d’un film de plastique transparent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4776a6ce-d84a-349c-97ef-0c61c9955f1e",
                                        "entry_id": "e195e1b4-4b39-3be6-9fb2-6afe672ce98b",
                                        "glosses": [
                                            "Serrer et entourer quelque partie du corps, en parlant d’une chose."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c59081-71e9-44cb-b977-c79562160c57",
                                                "sense_id": "4776a6ce-d84a-349c-97ef-0c61c9955f1e",
                                                "text": "Et, embrassant son ami, il s’habilla, ceignit son épée, sortit de la chambre, descendit aux écuries, […]."
                                            },
                                            {
                                                "example_id": "bda6eaf1-826e-474f-8dae-704dd726154c",
                                                "sense_id": "4776a6ce-d84a-349c-97ef-0c61c9955f1e",
                                                "text": "Marions nos mains, toi qui, monarque éphémère, ceins la couronne de papier doré, […]."
                                            },
                                            {
                                                "example_id": "3eb93cdb-e138-4de2-9355-f194d70a8606",
                                                "sense_id": "4776a6ce-d84a-349c-97ef-0c61c9955f1e",
                                                "text": "Cela intéressait vivement notre maître d’hôtel pourtant, car le voici ceint de son blanc tablier, la mine souriante, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf1e7807-8095-4bd6-a511-0b840ba42473",
                        "source_entry_id": "7dbd626c-955e-3470-a06d-40329653c953",
                        "source_sense_id": "eaed664d-4f32-339c-8044-bc88a9ab7019",
                        "source_sense_description": "met een gordel omgeven",
                        "target_lang_word": "ceñir",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceñir",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b438fe95-551a-3e6c-a559-43fb749d19ca",
                                        "entry_id": "75c5ac81-a3be-3463-9fb6-584563e2b2e2",
                                        "glosses": [
                                            "Rodear y ajustar al cuerpo —especialmente a la cintura— el vestido u otra cosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02a7617b-99ab-47ea-99f4-21a046ca17a0",
                                                "sense_id": "b438fe95-551a-3e6c-a559-43fb749d19ca",
                                                "text": "sus mujeres, excesivamente maquilladas, con sus vestidos de flores demasiado ceñidos y sus escarpines de grueso tacón."
                                            },
                                            {
                                                "example_id": "d78dd56a-0817-4cfb-9be0-86b398624f1c",
                                                "sense_id": "b438fe95-551a-3e6c-a559-43fb749d19ca",
                                                "text": "Esa noche me entregué a ti, nada más que por sentirte ciñéndome la cintura."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7cf8da7-d8db-3725-bb37-31d2ae9ecbb0",
                                        "entry_id": "75c5ac81-a3be-3463-9fb6-584563e2b2e2",
                                        "glosses": [
