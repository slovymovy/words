                ],
                "senses": [
                    {
                        "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                        "entry_id": "89186ed4-c5c5-30d8-bd59-a655d417c16f",
                        "glosses": [
                            "überwölbter langgezogener Verbindungsraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c38ae41-ea02-4e9e-bee9-28d2ed37c224",
                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                "text": "Der Zugang zur Wohnung erfolgt über einen Laubengang."
                            },
                            {
                                "example_id": "44198d17-af94-4ca3-9439-e025a13afebe",
                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                "text": "„Er gab nun die Blumen auf und schritt auf einen der beiden Laubengänge zu, die den großen Parkgarten flanierten und von der Höhe bis fast an den Fuß des Schloßhügels herniederstiegen.“"
                            },
                            {
                                "example_id": "4756faf5-b4db-4cc7-830a-b58831384539",
                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                "text": "„Als er sich schließlich von den Kaufständen des Laubenganges entfernt hatte und auf den freien Platz getreten war, wagten die Trödler nicht, ihm dorthin zu folgen, sie schienen an den Saum des Ovals gebannt.“"
                            },
                            {
                                "example_id": "5368f6a5-90ef-4022-99ec-121189a87a66",
                                "sense_id": "9eece403-983d-349b-8ff1-faa402b160fd",
                                "text": "„Als Bouvard am Laubengang vorbeiging, entdeckte er unter den Zweigen eine Dame aus Gips.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
