        "fr-extract.jsonl": [
            {
                "entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                "word": "cataclysme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "827cc44e-bd23-47b0-8636-79133a5739bb",
                        "entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                        "tags": [
                            "plural"
                        ],
                        "form": "cataclysmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b21f5b9-c0e1-3443-91fe-9e2658550cbe",
                        "entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                        "glosses": [
                            "Bouleversement physique produit par un tremblement de terre, une inondation, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ebbf4b2-0285-4a08-974c-ad2a64758ee5",
                                "sense_id": "0b21f5b9-c0e1-3443-91fe-9e2658550cbe",
                                "text": "Et puis, si aucun cataclysme soudain n’a décisivement transformé l’aspect naturel des choses, d’un seul coup, depuis un siècle, il est cependant vrai qu’au ralenti une catastrophe inéluctable impose à cette partie de la France, cette fatale loi d’impermanence."
                            },
                            {
                                "example_id": "80643bdb-d45c-4795-953c-dd3cffe7892f",
                                "sense_id": "0b21f5b9-c0e1-3443-91fe-9e2658550cbe",
                                "text": "Nous avons une bonne dizaine d'années devant nous pour contrer les effets toxiques des prédictions des millénaristes, des bonimenteurs religieux et des prophètes de malheur de toutes sortes qui prédisent un grand cataclysme pour l'an 2000."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb46bb8a-0f66-3d5f-8664-a6993ae9203f",
                        "entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                        "glosses": [
                            "Grand bouleversement dans un État."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "48a04792-8cba-4117-9162-72bcf08293e2",
                                "sense_id": "cb46bb8a-0f66-3d5f-8664-a6993ae9203f",
                                "text": "Il ne pouvait cependant échapper à un homme réfléchi que les cataclysmes fondent sur une nation avec la soudaineté de la tempête en mer calme."
                            },
                            {
                                "example_id": "221b905d-3f63-41f6-ba39-19c4badfbc5f",
                                "sense_id": "cb46bb8a-0f66-3d5f-8664-a6993ae9203f",
                                "text": "Parmi les causes, il convient de mentionner la Grande Peste (1348-1351), sorte de cataclysme hiroshimesque qui a ébranlé tout l'Occident médiéval."
                            },
                            {
                                "example_id": "9046bb15-024d-4965-abea-fe9902e04c1f",
                                "sense_id": "cb46bb8a-0f66-3d5f-8664-a6993ae9203f",
                                "text": "Un cataclysme. C’est ainsi que la presse allemande décrit, à juste titre, l’issue des élections législatives du 24 septembre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9b7589a-9245-4013-b8c2-09c74ba76a07",
                        "source_entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                        "target_lang_word": "Naturkatastrophe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naturkatastrophe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2cb41f-723c-3c29-907b-3935ee6825e7",
                                        "entry_id": "8046dd63-7a57-3725-bfb9-dd813ca7a807",
                                        "glosses": [
                                            "durch Naturgewalten und nicht durch Menschen verursachte Katastrophe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628f9cc6-f44b-44be-ac7b-0917941d7ddc",
                                                "sense_id": "bb2cb41f-723c-3c29-907b-3935ee6825e7",
                                                "text": "„Daten über Naturkatastrophen zeigen, dass ihre Zahl tendenziell zunimmt.“"
                                            },
                                            {
                                                "example_id": "fd469bd1-164a-4f03-aba5-d772e291f1e6",
                                                "sense_id": "bb2cb41f-723c-3c29-907b-3935ee6825e7",
                                                "text": "„Produziert in einem derartigen Telegrammstil, erweckt es vielleicht den Eindruck, als hätte ich mitten in einer Naturkatastrophe gesteckt, und meine Freunde wollten wissen, ob ich sie überlebte.“"
                                            },
                                            {
                                                "example_id": "82b874cc-e778-471f-bd79-192368a26f31",
                                                "sense_id": "bb2cb41f-723c-3c29-907b-3935ee6825e7",
                                                "text": "„Nun hat es geregnet und es wird klar: Eine reine Naturkatastrophe waren die Feuer nicht.“"
                                            },
                                            {
                                                "example_id": "da760c8f-8d31-45a9-b255-fbf368296bac",
                                                "sense_id": "bb2cb41f-723c-3c29-907b-3935ee6825e7",
                                                "text": "„Naturkatastrophen, Erd- und Seebeben wurden von ihren Gewalten hervorgerufen, Inseln, die Kontinenten glichen, ließen sie auftauchen und versinken, Wirtschaft und Reiche verwandelten sie in einem Nu in Asche und Wüsteneien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62797441-99f5-4479-b710-24d7cecea997",
                        "source_entry_id": "0d268738-6f10-3bf5-8312-4c0b904b4ec7",
                        "target_lang_word": "cataclysm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cataclysm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                                        "entry_id": "b7eb7760-9267-3fad-aff6-590401f2e7b6",
                                        "glosses": [
                                            "A sudden, violent event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8aba164-c5af-4a0b-a156-02e045890bc6",
                                                "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                                                "text": "While the disaster capitalism complex does not deliberately scheme to create cataclysms on which it feeds (though Iraq may be a notable exception), there is plenty of evidence that its component industries work very hard indeed to make that current disastrous trends continue unchallenged."
                                            },
                                            {
                                                "example_id": "6329643c-ef7d-46fa-ae98-4ed9b37a158e",
                                                "sense_id": "e28909ca-11e0-3540-8ac5-d00a97f9f288",
                                                "text": "Judging by the sedimentary composition of the crust, it appears that Altaaya once possessed an atmosphere thick enough to support some form of liquid. What cataclysm stripped the atmosphere and left the planet to freeze is not currently known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0f760c-a468-346a-9b97-83c411c0d441",
                                        "entry_id": "b7eb7760-9267-3fad-aff6-590401f2e7b6",
                                        "glosses": [
                                            "A sudden and violent change in the earth's crust."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d809a72-f0b1-3b17-ae54-17b0fb27962e",
                                        "entry_id": "b7eb7760-9267-3fad-aff6-590401f2e7b6",
                                        "glosses": [
                                            "A great flood."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
