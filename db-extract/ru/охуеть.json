                ],
                "senses": [
                    {
                        "sense_id": "0878ee1e-2ea6-39a2-96cf-6684b3ae1ff6",
                        "entry_id": "aee7e3d7-3b26-3821-bd9c-a9843d3f5566",
                        "glosses": [
                            "обсц. испытать сильные чувства (удивления, восторга, зависти, злобы, ненависти, растерянности и т. п.)"
                        ],
                        "tags": [
                            "от чего либо."
                        ],
                        "examples": [
                            {
                                "example_id": "f7f9419b-c313-4d26-8f32-e520a5f39e64",
                                "sense_id": "0878ee1e-2ea6-39a2-96cf-6684b3ae1ff6",
                                "text": "Весь вагон охуел от холода!"
                            },
                            {
                                "example_id": "4bb8b56b-d045-44b6-b756-5ed359cbe72e",
                                "sense_id": "0878ee1e-2ea6-39a2-96cf-6684b3ae1ff6",
                                "text": "Наступил кризис, и многие, конечно, охуели от такого расклада."
                            },
                            {
                                "example_id": "92fa5e13-a582-4090-b270-29f734482ec8",
                                "sense_id": "0878ee1e-2ea6-39a2-96cf-6684b3ae1ff6",
                                "text": "Старший администратор (типичная блондинка) стоит на табуретке и кисточкой красит дежурный огнетушитель в розовый цвет. Я и то охуел, представляю как охуеет от такого антуража пожарный инспектор."
                            },
                            {
                                "example_id": "49859817-dd37-4d90-bad3-1dcbf5229c57",
                                "sense_id": "0878ee1e-2ea6-39a2-96cf-6684b3ae1ff6",
                                "text": "Я от счастья охуел, — // Что за наваждение: // Прыгнула на ху́й пизда // Без предупреждения!"
                            }
                        ]
                    },
                    {
                        "sense_id": "564dc9df-9c77-3947-be6e-4d0351d396b7",
                        "entry_id": "aee7e3d7-3b26-3821-bd9c-a9843d3f5566",
                        "glosses": [
                            "обсц. начать вести себя неадекватно; обнаглеть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3deb75c-5503-4379-8b46-2f86e6dae0fd",
                                "sense_id": "564dc9df-9c77-3947-be6e-4d0351d396b7",
                                "text": "А он как будто меня не слышит: «Ну, ты даёшь. Ты что, совсем охуела? У нас же секретность. У нас режимное предприятие. Какого хера ты притащила её сюда?»"
                            },
                            {
                                "example_id": "05b1ae63-a3b0-4daa-b445-06c2b390bc12",
                                "sense_id": "564dc9df-9c77-3947-be6e-4d0351d396b7",
                                "text": "Прищепина трясло в приступе эпилептической злобы: — Охуел, «душара»! «Дедушку», блядь, не уважать!"
                            }
                        ]
                    }
