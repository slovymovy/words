                ],
                "senses": [
                    {
                        "sense_id": "eea86d14-b60d-3db8-8a65-92eb9f1a1fe3",
                        "entry_id": "f5ee8759-f24d-3508-ad37-3e81e9e564ce",
                        "glosses": [
                            "Donner à ferme ; donner à cens."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4e114342-9c75-41f5-af3c-f0602a7c3d5e",
                                "sense_id": "eea86d14-b60d-3db8-8a65-92eb9f1a1fe3",
                                "text": "Le roi en effet autorise les consuls a acenser les fossés, à les faire cultiver pour compenser un peu les dépenses qu’ils avaient engagées en achetant divers biens pour les construire."
                            },
                            {
                                "example_id": "78c384f2-b7d4-4de1-9f0a-631bd9e03508",
                                "sense_id": "eea86d14-b60d-3db8-8a65-92eb9f1a1fe3",
                                "text": "Ils demanderont qu'il soit permis aux seigneurs d'acenser leurs domaines avec deniers d'entrée, de consentir au rachat et diminution des champarts, cens et devoirs, en se retenant une modique censive."
                            },
                            {
                                "example_id": "c57f8704-c77a-49b1-bb6e-a170585d8ddd",
                                "sense_id": "eea86d14-b60d-3db8-8a65-92eb9f1a1fe3",
                                "text": "Ne pouvant les accenser, il les donne à ferme (ad collogium); mais qu'il s' agisse d'une forme de contrat ou d'une autre, la redevance principale est de la même nature."
                            },
                            {
                                "example_id": "69114f40-4f94-40f7-8761-8589314b30ce",
                                "sense_id": "eea86d14-b60d-3db8-8a65-92eb9f1a1fe3",
                                "text": "En 1523, elle reçut l'autorisation d'accenser ses biens communs et, en 1526, de construire hors les murs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b79f9f0b-425b-3121-8e9c-8c11fa6b8620",
