                                        "entry_id": "98431537-5664-3f58-b154-40bf55bcf22b",
                                        "glosses": [
                                            "A group of friends, regardless of gender. Often the lads."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "Ireland",
                                            "Northern-England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36c94d1-a894-4bb5-9859-d918d21dd1f2",
                                                "sense_id": "60f947b9-708b-3224-b6db-9870510509c6",
                                                "text": "Me and the lads have had a meeting in the bar and decided it's first-class family entertainment."
                                            },
                                            {
                                                "example_id": "f7ab22c5-63a8-4c25-ad90-52501ec7aace",
                                                "sense_id": "60f947b9-708b-3224-b6db-9870510509c6",
                                                "text": "I loved saying lads . . . like I was a comrade . . . like I was one of them ... me and the lads . . . alright lads, eh ... Italy, no problem ."
                                            }
                                        ]
                                    }
                                ]
