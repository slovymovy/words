                                        "sense_id": "6e508ea0-6860-31be-9213-143b5e0f26ab",
                                        "entry_id": "5cd254ae-e4e9-3bd4-a934-42af1b8ad984",
                                        "glosses": [
                                            "die Existenz zweier Pole, also zweier Punkte mit entgegengesetzten Eigenschaften"
                                        ],
                                        "tags": [
                                            "geography",
                                            "no-plural",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "888ce4e2-c255-4d6a-a8b3-4a359dfac6bd",
                                                "sense_id": "6e508ea0-6860-31be-9213-143b5e0f26ab",
                                                "text": "Beim Einlegen der Batterie ist die Polarität (der elektrischen Ladung) zu beachten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6fafbf2-af42-3969-8ae9-395e1f3289cd",
                                        "entry_id": "5cd254ae-e4e9-3bd4-a934-42af1b8ad984",
                                        "glosses": [
                                            "ein Verhältnis zweier entgegengesetzter, in Wechselwirkung miteinander stehender Pole; Gegensätzlichkeit"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e48faef-62c8-4eb5-bb7d-644ad4c6ee04",
                                                "sense_id": "b6fafbf2-af42-3969-8ae9-395e1f3289cd",
                                                "text": "„In ihrer Dankesrede warnte Kronauer angesichts der aktuellen Polarität von USA und Europa vor einer \"mitreißenden Simplifizierung der Welt\".“"
                                            },
                                            {
                                                "example_id": "b194bdb3-19fa-48ee-9206-90ac1b74337c",
                                                "sense_id": "b6fafbf2-af42-3969-8ae9-395e1f3289cd",
                                                "text": "„Gerade diese Polarität zwischen intersubjektivem Wissen und subjektiver Gewißheit will Frisch in seiner Komödie aufzeigen, er demonstriert diese Polarität an der Geometrie einerseits und der Liebe andererseits.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0d17cecb-385b-3e3d-9087-7c7d17853cd2",
                                        "entry_id": "5cd254ae-e4e9-3bd4-a934-42af1b8ad984",
                                        "glosses": [
                                            "eine involutorische Korrelation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f27855-df1d-4da4-9bd6-2f9297d3e580",
                                                "sense_id": "0d17cecb-385b-3e3d-9087-7c7d17853cd2",
                                                "text": "„Eine Polarität heißt hyperbolisch, falls sie selbstkonjugierte Punkte (und damit gleichwertig selbstkonjugierte Geraden) hat, sonst heißt sie elliptisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
