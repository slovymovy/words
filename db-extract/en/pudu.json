                                    {
                                        "sense_id": "fe49c3b9-22a3-32fd-a2da-d6c976233eed",
                                        "entry_id": "b3865787-40fc-3d80-a553-13faf887ff58",
                                        "glosses": [
                                            "Genre de petit cervidé d'Amérique du sud dont il existe deux espèces : le Pudu mephistophiles et le Pudu puda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "078d2e5b-6023-4939-b200-1220816e3639",
                                                "sense_id": "fe49c3b9-22a3-32fd-a2da-d6c976233eed",
                                                "text": "Le pudu est le plus petit cervidé du monde."
                                            },
                                            {
                                                "example_id": "80d7d190-4134-47ca-9769-78e673ee6d33",
                                                "sense_id": "fe49c3b9-22a3-32fd-a2da-d6c976233eed",
                                                "text": "Dans le parc national Queulat, par exemple (170 km au nord de Puerto Aisen), on pourra voir le pudu, le plus petit cerf du monde dans son habitat naturel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
