                                "ru": "Двенадцать месяцев <w>составляют</w> полный календарный год.",
                                "tr": "On iki ay tam bir takvim yılını <w>oluşturur</w>.",
                                "de": "Zwölf Monate <w>bilden</w> ein volles Kalenderjahr.",
                                "nl": "Twaalf maanden <w>vormen</w> een volledig kalenderjaar.",
                                "pl": "Dwanaście miesięcy <w>stanowi</w> pełny rok kalendarzowy.",
                                "fr": "Douze mois <w>constituent</w> une année civile complète.",
                                "it": "Dodici mesi <w>costituiscono</w> un anno solare completo.",
                                "cs": "Dvanáct měsíců <w>tvoří</w> celý kalendářní rok.",
                                "es": "Doce meses <w>constituyen</w> un año natural completo.",
                                "zh": "十二个月<w>构成</w>完整的一年。"
                            }
                        },
                        {
                            "text": "Women <w>constitute</w> the majority of the workforce in this sector.",
                            "target_lang_translations": {
                                "ru": "Женщины <w>составляют</w> большинство рабочей силы в этом секторе.",
                                "tr": "Kadınlar bu sektördeki iş gücünün çoğunluğunu <w>teşkil etmektedir</w>.",
                                "de": "Frauen <w>machen</w> in diesem Sektor die Mehrheit der Arbeitskräfte aus.",
                                "nl": "Vrouwen <w>maken</w> de meerderheid van de beroepsbevolking in deze sector <w>uit</w>.",
                                "pl": "Kobiety <w>stanowią</w> większość siły roboczej w tym sektorze.",
                                "fr": "Les femmes <w>constituent</w> la majorité de la main-d'œuvre dans ce secteur.",
                                "it": "Le donne <w>costituiscono</w> la maggioranza della forza lavoro in questo settore.",
                                "cs": "Ženy <w>tvoří</w> většinu pracovní síly v tomto sektoru.",
                                "es": "Las mujeres <w>constituyen</w> la mayoría de la fuerza laboral en este sector.",
                                "zh": "女性<w>构成</w>了该行业劳动力的主体。"
                            }
                        },
                        {
                            "text": "Does this single error <w>constitute</w> a failure of the entire system?",
                            "target_lang_translations": {
                                "ru": "<w>Представляет</w> ли собой эта единственная ошибка сбой всей системы?",
                                "tr": "Bu tek hata tüm sistemin başarısızlığı anlamına mı <w>gelir</w>?",
                                "de": "Stellt dieser einzelne Fehler ein Versagen des gesamten Systems <w>dar</w>?",
                                "nl": "Vormt deze enkele fout een falen van het gehele systeem?",
                                "pl": "Czy ten pojedynczy błąd <w>stanowi</w> awarię całego systemu?",
                                "fr": "Cette erreur unique <w>constitue-t-elle</w> une défaillance de tout le système ?",
                                "it": "Questo singolo errore <w>rappresenta</w> un fallimento dell'intero sistema?",
                                "cs": "<w>Představuje</w> tato jediná chyba selhání celého systému?",
                                "es": "¿Este único error <w>supone</w> un fallo de todo el sistema?",
                                "zh": "这一个错误是否<w>构成</w>了整个系统的失败？"
                            }
                        }
                    ],
