                "senses": [
                    {
                        "sense_id": "0409f752-6e72-3391-a219-b68742094726",
                        "entry_id": "bb3f5cd8-3c08-36ed-9e8d-29c6d0149381",
                        "glosses": [
                            "Disziplinarmaßnahme (nach §§ 380, 390 ZPO; § 89 FamFG; §§ 51, 70 StPO; §§ 177, 178 GVG), welche dazu dient, Ungehorsam und Ungebühr einer Person in einem Verfahren zu ahnden, und welche zum Tragen kommt, wenn das angeordnete Ordnungsgeld nicht eingetrieben werden kann"
                        ],
                        "tags": [
                            "deutsches Prozessrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "207049de-b45d-48b7-b012-9a188be391cf",
                                "sense_id": "0409f752-6e72-3391-a219-b68742094726",
                                "text": "Verstößt der Schuldner trotz Androhung des Ordnungsmittels gegen seine Verpflichtung aus dem Urteil, kann das Gericht ein Ordnungsgeld oder ersatzweise Ordnungshaft festsetzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ed400123-d532-30ca-9622-3c2a3206c34c",
                        "entry_id": "bb3f5cd8-3c08-36ed-9e8d-29c6d0149381",
                        "glosses": [
                            "Ordnungsmittel nach § 890 ZPO, mit dem eine Duldung oder Unterlassung des Schuldners erzwungen wird, nachdem dieser einer Verpflichtung zur Duldung oder Unterlassung zuwidergehandelt hat und ein Ordnungsgeld nicht beigetrieben werden konnte"
                        ],
                        "tags": [
                            "deutsches Zwangsvollstreckungsrecht nach ZPO"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
