                    {
                        "sense_id": "b0ea145e-8b1c-3f36-9527-5f2f917a6b89",
                        "entry_id": "8554dabb-d75d-3296-9519-a93f02ec6056",
                        "glosses": [
                            "Objet manufacturé désigné comme œuvre d’art."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "f255846d-9cde-401d-bafd-6c34d409cd9b",
                                "sense_id": "b0ea145e-8b1c-3f36-9527-5f2f917a6b89",
                                "text": "Aussi remarquable sont les références à l’art contemporain occidental et leurs réinterprétations. Chen Zen, Huang Yong Ping et Wang Du attirent l’idée duchampienne du ready-made et la pratique de l’installation du côté de l’allégorie politique, critique ou satirique, pour commenter l’état du monde, sans illusions."
                            },
                            {
                                "example_id": "e434951e-13e5-4539-9c58-688bcb1f6684",
                                "sense_id": "b0ea145e-8b1c-3f36-9527-5f2f917a6b89",
                                "text": "Roue de bicyclette (1913) est le premier ready-made réalisé par Marcel Duchamp."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "456d11ea-cebb-4145-bcdd-443f9fd40bfc",
                        "source_entry_id": "8554dabb-d75d-3296-9519-a93f02ec6056",
                        "source_sense_id": "b0ea145e-8b1c-3f36-9527-5f2f917a6b89",
                        "target_lang_word": "Objet trouvé",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
