                ],
                "senses": [
                    {
                        "sense_id": "4b027232-c2d2-3bb3-aa9b-600c59807da2",
                        "entry_id": "51eb3a59-15db-3682-89a1-38da71e2520d",
                        "glosses": [
                            "Qui est garni de baleines. Se dit surtout des corsets et des cols."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6de2e07-2fa1-414d-aaf3-cebe790ce90c",
                                "sense_id": "4b027232-c2d2-3bb3-aa9b-600c59807da2",
                                "text": "Elle portait une robe de chaly vert tendre dont le dessin imitait des branches de corail ; ses manches étaient immenses et désastreusement soutenues à l’intérieur par des ronds de crin baleinés, qui les empêchaient de perdre un pouce de leur ampleur."
                            },
                            {
                                "example_id": "2bdb5a5e-32b6-4596-b5ab-1aabf14573ca",
                                "sense_id": "4b027232-c2d2-3bb3-aa9b-600c59807da2",
                                "text": "Au lieu d’une femme de quarante-cinq ans découragée, j’avais devant moi une femme de quarante ans fringante, le menton haut sous le col baleiné qui cachait les secrets du cou."
                            },
                            {
                                "example_id": "cd2d98db-5080-4bbc-b79b-a222f7b0bc4b",
                                "sense_id": "4b027232-c2d2-3bb3-aa9b-600c59807da2",
                                "text": "Quelques-unes même s’obstinèrent à garder des cols baleinés."
                            },
                            {
                                "example_id": "79083d40-73c9-43d8-a29e-2ca6374f44f0",
                                "sense_id": "4b027232-c2d2-3bb3-aa9b-600c59807da2",
                                "text": "Elles croyaient devoir manifester leur dévotion par l’extravagance de leurs toilettes ; elles portaient des corsages en taffetas changeant, à manches gigot, avec des guimpes baleinées ; leurs jupes balayaient le plancher."
                            }
                        ]
                    }
