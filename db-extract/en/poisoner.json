                    {
                        "translation_id": "44b701c9-0563-46d7-84f7-f97030095e1e",
                        "source_entry_id": "93380069-fbe5-3de2-ab34-9c8c9904d86b",
                        "source_sense_id": "d833101a-1fec-3521-b405-b8a6ac1ed903",
                        "source_sense_description": "person who poisons something or someone",
                        "target_lang_word": "empoisonneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empoisonneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98a7e9c5-39b4-37c0-942d-6e414e0f4b05",
                                        "entry_id": "f2e5f3eb-5f4f-33b3-9576-ad320f27d75b",
                                        "glosses": [
                                            "Celui qui empoisonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "563676a9-b00f-4824-8cfc-459263d50619",
                                                "sense_id": "98a7e9c5-39b4-37c0-942d-6e414e0f4b05",
                                                "text": "Catherine de Médicis était seule, […] la tête posée sur sa main encore remarquablement belle, grâce au cosmétique que lui fournissait le Florentin René, qui réunissait la double charge de parfumeur et d’empoisonneur de la reine mère."
                                            },
                                            {
                                                "example_id": "862ebb55-4d29-4f7f-bd6e-ac483c9f058a",
                                                "sense_id": "98a7e9c5-39b4-37c0-942d-6e414e0f4b05",
                                                "text": "Les magistrats acquirent bientôt la conviction que l’empoisonneur était... une empoisonneuse : la propre mère du petit Henri, Charlotte Lamarche."
                                            },
                                            {
                                                "example_id": "1a0e8546-48ca-4c2e-a7c6-37f0910c9879",
                                                "sense_id": "98a7e9c5-39b4-37c0-942d-6e414e0f4b05",
                                                "text": "Ah ! l’argent, cet argent pourrisseur, empoisonneur, qui desséchait les âmes, en chassait la bonté, la tendresse, l’amour des autres !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "573acb69-499d-32dd-997d-ea8052adbc6d",
                                        "entry_id": "f2e5f3eb-5f4f-33b3-9576-ad320f27d75b",
                                        "glosses": [
                                            "Mauvais cuisinier."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5eff12a-141f-3a61-a364-2a8c21a9845e",
                                        "entry_id": "f2e5f3eb-5f4f-33b3-9576-ad320f27d75b",
                                        "glosses": [
                                            "Homme qui débite une doctrine pernicieuse."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88658109-03a8-404b-ad01-a91573aedbeb",
                                                "sense_id": "f5eff12a-141f-3a61-a364-2a8c21a9845e",
                                                "text": "Nicole traitait les auteurs dramatiques d’empoisonneurs publics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a430439d-8ccb-4f3f-95bd-cd5fdbaa9007",
                        "source_entry_id": "93380069-fbe5-3de2-ab34-9c8c9904d86b",
                        "source_sense_id": "d833101a-1fec-3521-b405-b8a6ac1ed903",
