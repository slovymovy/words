                    },
                    {
                        "translation_id": "4464c5d7-a916-46ba-bdf2-9fbcba6b00c8",
                        "source_entry_id": "4259d98f-6fe7-3832-a2c5-5154d39fbf58",
                        "source_sense_id": "9fa2aec3-5e39-352d-af04-3b1caaa1a01c",
                        "source_sense_description": "Kaffeebohnen",
                        "target_lang_word": "zrnková káva",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "18727142-c855-4aca-8732-3365bb5294e8",
                        "source_entry_id": "4259d98f-6fe7-3832-a2c5-5154d39fbf58",
                        "source_sense_id": "933db57d-9725-30fb-b2d4-36a42b06b69b",
                        "source_sense_description": "Getränk, aus Kaffeebohnen hergestellt",
                        "target_lang_word": "café",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd2b8af6-4d51-3b9c-a8ec-f917a38f2bf2",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Graines de caféier, ou poudre formée de ces grains torréfiés et moulus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6071898b-4932-49e8-80a0-73487422b4e8",
                                                "sense_id": "fd2b8af6-4d51-3b9c-a8ec-f917a38f2bf2",
                                                "text": "On ajoute quelquefois, après le grillage, un peu de beurre pour lustrer les cossettes et leur donner l’aspect du café brûlé."
                                            },
                                            {
                                                "example_id": "899e00c6-3753-491c-b2f5-5ee55e5cb055",
                                                "sense_id": "fd2b8af6-4d51-3b9c-a8ec-f917a38f2bf2",
                                                "text": "Le café est la graine de plusieurs espèces de caféiers, arbrisseaux, arbustes ou arbres constituant le genre Coffea, de la famille des Rubiacées-Cofféées."
                                            },
                                            {
                                                "example_id": "73877fd1-d08f-4229-a4f2-8b3a2b30b181",
                                                "sense_id": "fd2b8af6-4d51-3b9c-a8ec-f917a38f2bf2",
                                                "text": "Les producteurs n’utilisent aucun produit chimique et emploient comme engrais du fumier, de l’écalure de café et du tourteau de ricin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e0975fc-6a66-3a8e-8c26-65e7a586729b",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Caféier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b37b7dc-548b-4bf1-8e20-c7e466edcb07",
                                                "sense_id": "9e0975fc-6a66-3a8e-8c26-65e7a586729b",
                                                "text": "Aux Antilles, comme en Arabie, la culture du café prospère surtout dans les terrains placés sur le penchant des collines, et qui reçoivent des eaux de sources où sont arrosés par les eaux pluviales."
                                            },
                                            {
                                                "example_id": "6a108fdb-c28f-42bf-8842-466a5396f4ca",
                                                "sense_id": "9e0975fc-6a66-3a8e-8c26-65e7a586729b",
                                                "text": "Caféine. — Existe dans beaucoup de plantes, café, thé, cola, maté, guarana."
                                            },
                                            {
                                                "example_id": "331d2f24-992a-4414-b017-21a2fd8eebb7",
                                                "sense_id": "9e0975fc-6a66-3a8e-8c26-65e7a586729b",
                                                "text": "Lorsque les Hollandais volaient des plants de café aux Arabes pour établir une concurrence dans les plantations de la Compagnie des Indes orientales en Indonésie, ou que Pierre Poivre acclimatait sur l’île Maurice la muscade chapardée à Batavia, la frénésie des gains était telle que certains pensaient que la fin justifie tous les moyens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Boisson, généralement bue chaude, de couleur noir-brun, réalisée à partir de cette poudre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e023f7ba-6349-4ac8-b361-ec703948d477",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Quant au café, il procure une fièvre admirable ! Il entre dans le cerveau comme une ménade. À son attaque, l’imagination court échevelée, elle se met à nu, elle se tord, elle est comme une pythonisse ; et, dans ce paroxysme inspirateur, un poète jouit de ses facultés centuplées ; mais c’est l’ivresse de la pensée comme le vin amène l’ivresse du corps."
                                            },
                                            {
                                                "example_id": "00b6c3f3-d12b-4e85-bb33-7af763520e96",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Ils aiment bien vivre après avoir bien travaillé ; un verre de vin ou de cognac ne leur fait pas peur, et ils se paient assez souvent le café, le pousse-café et le reste."
                                            },
                                            {
                                                "example_id": "7091b215-faf7-4f59-a16d-f00be8f4bc2c",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Hyacinthe ne prenait pas de café, qu’il appelait avec mépris un breuvage de concierge."
                                            },
                                            {
                                                "example_id": "11229a88-57a7-474a-a460-7337beb8ff0b",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Elle prépara le café devant son amie, avec un grand soin, en versant l’eau bouillante goutte à goutte. Et dès qu’il en eut passé la valeur d’une tasse, elle ne voulut rien entendre : elle servit Catherine Chotard ; il fallut que celle-ci bût le premier café passé, qui est toujours le meilleur."
                                            },
                                            {
                                                "example_id": "c18fd828-046a-4788-824d-585b1f4000cd",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Aujourd’hui, je médite ; je me rappelle avoir été frappé, partout où je suis allé, d’apercevoir dans les débits, dès la première heure du matin, des masses de gens, hommes ou femmes, corsant leur café par des rasades d’eau-de-vie."
                                            },
                                            {
                                                "example_id": "f3e24b67-c36b-40dc-8885-0458d7a6accc",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Le café est un breuvage qui fait dormir quand on n’en prend pas."
                                            },
                                            {
                                                "example_id": "a4628a95-eb1e-4331-984f-dac22b72c548",
                                                "sense_id": "5c7d2d86-f98b-3119-a580-9abb6776558b",
                                                "text": "Mamie boit du thé noir au petit déjeuner, du thé parfumé à la bergamote. Même si je ne trouve pas ça terrible, ça a toujours l’air plus gentil que le café, qui est une boisson de méchant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fcf76ce-89a7-395a-9326-be45a5e47d58",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Portion, servie dans une tasse, de cette boisson pour une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4decae71-d0ad-4f65-a9d9-b99b0a577f08",
                                                "sense_id": "1fcf76ce-89a7-395a-9326-be45a5e47d58",
                                                "text": "J’éloignai de mes lèvres son mauvais café – le café trop noir et trop amer qu’on déguste à Londres dans des tasses moins grandes que des œufs de pluvier […]"
                                            },
                                            {
                                                "example_id": "d92ad8da-5cec-4472-a478-205373695a62",
                                                "sense_id": "1fcf76ce-89a7-395a-9326-be45a5e47d58",
                                                "text": "Je prends un café et nous partons."
                                            },
                                            {
                                                "example_id": "2b090015-b874-4a41-abfa-315d50da8552",
                                                "sense_id": "1fcf76ce-89a7-395a-9326-be45a5e47d58",
                                                "text": "Contrairement à une idée préconçue, un expresso allongé sera plus excitant qu’un café serré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Établissement, lieu public où l’on consomme des boissons plutôt non alcoolisées."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69623942-37ab-4cae-bfe2-452bd2041454",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "J'allais me morfondre, le reste de l'après-midi, dans le café de Féré, au Pont Saint-Michel; j'y demeurai jusqu'à la nuit."
                                            },
                                            {
                                                "example_id": "ab735f3b-0855-417c-a36c-9af88694190f",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "Un mandoliniste grattait son instrument comme dans un café de province où les habitués sont demeurés de mœurs paisibles."
                                            },
                                            {
                                                "example_id": "5caf4e73-b8c6-4398-81d0-52b9e09310f6",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "Tous les soirs, sa besogne achevée, Helmy venait s’attabler à un petit café proche de la maison de Nazira."
                                            },
                                            {
                                                "example_id": "236aa4ee-2e09-486f-a780-5bc5c81eaf9e",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            },
                                            {
                                                "example_id": "a2a01ddb-a20f-4445-ba60-b0bc7479401d",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "Ce fut, en ce temps de relative splendeur, qu’un soir de bombe, à Montparnasse, il cueillit Geneviève à une table de café."
                                            },
                                            {
                                                "example_id": "e0e52805-9a63-4214-9ee2-40438765ded4",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "Inquiets, certains clients quittent le café mais, à peine sortis, s’arrêtent derrière la vitre pour contempler une dernière fois le soulographe."
                                            },
                                            {
                                                "example_id": "e1d618e4-f614-4e93-9474-c0258b710dc0",
                                                "sense_id": "27b7987d-1492-3d62-91a2-3e51333da368",
                                                "text": "C’est, par exemple, dans un café, ce qui nous permet de distinguer la conversation qui a lieu autour de la table de la rumeur de la pièce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be5d8475-e1b9-35f1-903a-d5914e59b249",
                                        "entry_id": "fed0ac9d-e53b-3212-8678-058cfa56b031",
                                        "glosses": [
                                            "Moment où l’on prend le café après le repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc8b0abd-4fe3-46d3-ba37-a7084a352a19",
                                                "sense_id": "be5d8475-e1b9-35f1-903a-d5914e59b249",
                                                "text": "Ne m’attendez pas pour dîner, je viendrai seulement au café."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fda8a27-dbb0-3143-9c5a-e95c124a3a7e",
                                        "entry_id": "28b00742-40ae-3ae7-8697-e092e2abfb87",
                                        "glosses": [
                                            "De la couleur des grains de café. #462E01"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e90a159-5794-466e-bcf3-a8a5d356ffab",
                                                "sense_id": "6fda8a27-dbb0-3143-9c5a-e95c124a3a7e",
                                                "text": "C’est une simple lame de marbre, couleur café, posée debout, avec une très longue épitaphe en latin."
                                            },
                                            {
                                                "example_id": "8e392264-fc5e-441c-bb6b-43a6d3caa828",
                                                "sense_id": "6fda8a27-dbb0-3143-9c5a-e95c124a3a7e",
                                                "text": "J’aime ta couleur café. Tes cheveux café. Ta gorge café. J’aime quand pour moi tu danses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
