                    },
                    {
                        "translation_id": "ca8797d7-00af-4508-8afd-9619ba81b4e6",
                        "source_entry_id": "c72c66dd-50bd-3a53-9a42-f0c7682d082c",
                        "source_sense_id": "975c328f-d911-37eb-a9b0-bc2849444c48",
                        "target_lang_word": "carbon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20acb00c-b5c2-36fb-9de5-b4dd98e7eb03",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "The chemical element (symbol C) with an atomic number of 6. It can be found in pure form for example as graphite, a black, shiny and very soft material, or diamond, a colourless, transparent, crystalline solid and the hardest known material."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b72dae20-cf0a-466c-83de-5a5a5f508297",
                                                "sense_id": "20acb00c-b5c2-36fb-9de5-b4dd98e7eb03",
                                                "text": "All life as we know it has carbon as the backbone of many of its molecules; carbon’s tetravalence gives it special importance in biochemical molecular bonds."
                                            },
                                            {
                                                "example_id": "680e1f5a-fb04-4c32-9045-167744733203",
                                                "sense_id": "20acb00c-b5c2-36fb-9de5-b4dd98e7eb03",
                                                "text": "Carbon is the most common element in our bodies—indeed, in all living things on earth."
                                            },
                                            {
                                                "example_id": "8e576762-21e9-45d6-a590-2c27c0220f1f",
                                                "sense_id": "20acb00c-b5c2-36fb-9de5-b4dd98e7eb03",
                                                "text": "Fans will pump air through the alkaline stream, which causes carbon dioxide to form solid calcium carbonate, the material from which seashells are formed, which will look like a fine sand, as well as dissolved bicarbonate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8c2e10b-5fe4-377c-a9f2-36b3fc489b98",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "An atom of this element, in reference to a molecule containing it."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463088f4-ff1d-41d6-9bdf-e0ee1b5bbe8a",
                                                "sense_id": "f8c2e10b-5fe4-377c-a9f2-36b3fc489b98",
                                                "text": "A methane molecule is made up of a single carbon with four hydrogens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6a85a5-5cd0-3763-883b-a45afb1faf52",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "A sheet of carbon paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810e218f-005f-43cc-bb78-981119f04804",
                                                "sense_id": "7c6a85a5-5cd0-3763-883b-a45afb1faf52",
                                                "text": "He stepped back and opened his bag and took out a printed pad of D.O.A. forms and began to write over a carbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f82141e-7714-3c10-93f6-003baf8d96b3",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "A carbon copy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa6e5b73-8801-418f-a3d7-fd2e4e306cd4",
                                                "sense_id": "0f82141e-7714-3c10-93f6-003baf8d96b3",
                                                "text": "Please provide me with a carbon of your form."
                                            },
                                            {
                                                "example_id": "bdddd75b-7aea-4b23-b149-78c740ffa958",
                                                "sense_id": "0f82141e-7714-3c10-93f6-003baf8d96b3",
                                                "text": "Press firmly: you are making a carbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b85fd958-9ebf-37e6-9469-7eb3f9f90f34",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "A fossil fuel that is made of impure carbon such as coal or charcoal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d926bb3-6a16-3304-ba31-83f4e4ecd610",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "Soot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e217ea-a184-499b-87e1-12a2d6c6493d",
                                                "sense_id": "7d926bb3-6a16-3304-ba31-83f4e4ecd610",
                                                "text": "Every morning she cleaned the carbon from the lamp chimneys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc090bac-a80f-391e-92a4-19fa1c04b240",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "Soot.",
                                            "Especially, hardened soot as a caked-on deposit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed23711-aa18-4fc9-aba4-0c10fa87ed6c",
                                                "sense_id": "cc090bac-a80f-391e-92a4-19fa1c04b240",
                                                "text": "When you overhaul an engine, you need to remove the carbon from around the valve seats. The carbon buildup can be extensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5272e3f-7908-3ef8-b7af-adc1cc56d5fe",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "Ellipsis of carbon dioxide."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7d9dac-d7e2-4697-a3ec-1824ce347b18",
                                                "sense_id": "e5272e3f-7908-3ef8-b7af-adc1cc56d5fe",
                                                "text": "carbon neutral"
                                            },
                                            {
                                                "example_id": "132507c7-5f8c-4379-9c52-2ed45cbd7aaa",
                                                "sense_id": "e5272e3f-7908-3ef8-b7af-adc1cc56d5fe",
                                                "text": "carbon capture"
                                            },
                                            {
                                                "example_id": "692c258f-d4d1-4fbc-9ae1-4e24deb6fcb9",
                                                "sense_id": "e5272e3f-7908-3ef8-b7af-adc1cc56d5fe",
                                                "text": "If Alberta’s reserves are a carbon bomb, this global expansion of tar sands and oil shale exploitation amounts to an escalating emissions arms race, the unlocking of a subterranean cache of weapons of mass ecological destruction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde8931e-02af-39df-9f4d-5b6fac4dd791",
                                        "entry_id": "bb2f425d-e0f3-32d8-9349-353fcc9b9616",
                                        "glosses": [
                                            "A carbon rod or pencil used in an arc lamp."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "551c6936-f3d1-453b-987b-f0def777b6b8",
                                                "sense_id": "dde8931e-02af-39df-9f4d-5b6fac4dd791",
                                                "text": "To trim an arc lamp, first remove the old carbons and carefully and thoroughly wipe the carbon rods, holders, &c. with a clean, dry rag."
                                            }
