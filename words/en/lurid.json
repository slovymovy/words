{
    "word_family": [
        "luridly",
        "luridness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bdab57ee-b3bb-3485-ba8d-51f14eaf59c1",
                    "sense_definition": "Describing something in a way that is overly sensational, shocking, or graphic, especially regarding violence or sex.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper published <w>lurid</w> details about the crime that shocked the entire community.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала <w>кричащие</w> подробности преступления, которые потрясли всю общественность."
                            }
                        },
                        {
                            "text": "He avoided reading the <w>lurid</w> headlines about the celebrity scandal.",
                            "target_lang_translations": {
                                "ru": "Он старался не читать <w>сенсационные</w> заголовки о скандале со знаменитостью."
                            }
                        }
                    ],
                    "synonyms": [
                        "sensational",
                        "graphic",
                        "shocking"
                    ],
                    "common_phrases": [
                        "lurid details"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно сенсационный, шокирующий или смакующий непристойные либо жестокие подробности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "сенсационный, вульгарный"
                            },
                            {
                                "target_lang_word": "сенсационный",
                                "target_lang_sense_clarification": "скандальный, привлекающий внимание подробностями"
                            },
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "пугающий, шокирующий"
                            },
                            {
                                "target_lang_word": "страшный",
                                "target_lang_sense_clarification": "леденящий душу, шокирующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4a360e6-2b70-39f7-a609-d9cc0008cbce",
                    "sense_definition": "Exaggerated and overly dramatic in style or tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensational",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was criticized for its <w>lurid</w> portrayal of historical events.",
                            "target_lang_translations": {
                                "ru": "Фильм раскритиковали за <w>мелодраматичное</w> изображение исторических событий."
                            }
                        },
                        {
                            "text": "Her <w>lurid</w> account of the argument made it sound much worse than it actually was.",
                            "target_lang_translations": {
                                "ru": "Её <w>преувеличенный</w> рассказ о ссоре представил всё гораздо хуже, чем было на самом деле."
                            }
                        }
                    ],
                    "synonyms": [
                        "melodramatic",
                        "theatrical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преувеличенный, неестественно драматичный и напыщенный по тону или стилю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мелодраматичный",
                                "target_lang_sense_clarification": "излишне драматизированный, напыщенный"
                            },
                            {
                                "target_lang_word": "преувеличенный",
                                "target_lang_sense_clarification": "сгущающий краски, гиперболизированный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c42a99-c82a-342f-b41a-94a15de8bae0",
                    "sense_definition": "Having a ghastly, pale, or unnatural appearance, often referring to light or color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city was bathed in the <w>lurid</w> glow of the neon signs at night.",
                            "target_lang_translations": {
                                "ru": "Ночью город купался в <w>зловещем</w> сиянии неоновых вывесок."
                            }
                        },
                        {
                            "text": "A <w>lurid</w> light flickered from the dying fire in the dark room.",
                            "target_lang_translations": {
                                "ru": "<w>Мертвенный</w> свет мерцал от угасающего огня в тёмной комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "ghastly",
                        "wan",
                        "pale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий зловещий, мертвенный, тусклый или неестественный оттенок (о свете, цвете или лице)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мертвенно-бледный",
                                "target_lang_sense_clarification": "болезненно или жутко бледный"
                            },
                            {
                                "target_lang_word": "бледный",
                                "target_lang_sense_clarification": "тусклый, нездоровый"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "о неестественном, пугающем свете"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eefd8270-1b58-35c9-949f-cb83d56e7ed1",
                    "sense_definition": "Having a bright, often unnatural or sickly yellow color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky turned a <w>lurid</w> yellow before the massive storm hit the coast.",
                            "target_lang_translations": {
                                "ru": "Небо приобрело <w>ядовито-жёлтый</w> оттенок перед тем, как мощный шторм обрушился на побережье."
                            }
                        },
                        {
                            "text": "She painted the walls a <w>lurid</w> shade that looked quite strange in the daylight.",
                            "target_lang_translations": {
                                "ru": "Она выкрасила стены в <w>кричащий</w> оттенок, который при дневном свете выглядел довольно странно."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий яркий, ядовитый или неестественно желтоватый оттенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желтоватый",
                                "target_lang_sense_clarification": "нездорового желтого оттенка"
                            },
                            {
                                "target_lang_word": "ядовито-жёлтый",
                                "target_lang_sense_clarification": "резкий, неестественно яркий жёлтый цвет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa4a57f7-10e1-3a60-a250-cfc97fdcdcb8",
                    "sense_definition": "Having a brownish color with a reddish tint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The autumn leaves had a <w>lurid</w> hue that stood out against the grey sky.",
                            "target_lang_translations": {
                                "ru": "Осенние листья имели <w>багровый</w> оттенок, выделявшийся на фоне серого неба."
                            }
                        },
                        {
                            "text": "He admired the <w>lurid</w> petals of the exotic flower in the garden.",
                            "target_lang_translations": {
                                "ru": "Он любовался <w>бурыми</w> лепестками экзотического цветка в саду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий бурый, коричневато-красный или багровый оттенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурый",
                                "target_lang_sense_clarification": "коричневато-красный, тускло-рыжий"
                            },
                            {
                                "target_lang_word": "багровый",
                                "target_lang_sense_clarification": "густо-красный с темным оттенком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}