                        "entry_id": "1dad11da-112c-34d9-a2f3-9890165b4431",
                        "glosses": [
                            "een geur die lijkt op die van een baby maar niet wordt veroorzaakt door een baby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c33caaf-ad6b-4c2a-8cf7-db3b77ba06c2",
                                "sense_id": "0bd5406d-6bbe-3f35-9479-8585de1be530",
                                "text": "Ik maak het pakje open. Een zachte babygeur kringelt naar buiten. Mij goed. In de ingrediëntenlijst staan verder ook geen parabenen. Tenslotte zijn parabenen de nieuwe vijand."
                            }
