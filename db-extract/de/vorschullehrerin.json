                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0a243fc-32fb-4298-bd2e-f0504756873b",
                                "sense_id": "88598a3a-2294-312b-a831-26055fc77fb3",
                                "text": "„Ich habe das Schulwesen sowohl von oben als wissenschaftliche Hilfskraft bei der Beaufsichtigung von Referendaren als auch von unten als Vorschullehrerin kennen gelernt.“"
                            },
                            {
                                "example_id": "f17b04e8-348e-43ac-a132-028f5f63f816",
                                "sense_id": "88598a3a-2294-312b-a831-26055fc77fb3",
                                "text": "„Karen McDougal und Donald Trump lernten sich 2006 in der Playboy Villa in Los Angeles kennen: er filmte gerade eine Episode seiner Show ‚The Apprentice‘, die ehemalige Vorschullehrerin war ein paar Jahre zuvor zum ‚Playmate des Jahres‘ gewählt worden.“"
                            },
                            {
                                "example_id": "6efca2e2-fcb7-4f6d-b612-5c86e027c476",
                                "sense_id": "88598a3a-2294-312b-a831-26055fc77fb3",
                                "text": "„Die ehemalige Vorschullehrerin und nun zur prominenten Schauspielerin gewordene junge Frau reagiert auf all die Projektionen mit erstaunlicher Ruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
