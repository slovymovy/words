    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc851167-1bc0-3ae5-bd6c-cfea922814bd",
                "word": "Mordor",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                        "entry_id": "fc851167-1bc0-3ae5-bd6c-cfea922814bd",
                        "glosses": [
                            "An area of peril, darkness, or evil, which people fear to visit or explore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb57f64-a968-49eb-ac16-2f9c9969d24f",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "It is a “Mordor” sort of anthropology, dark rather than light, swampland rather than solid ground."
                            },
                            {
                                "example_id": "86c9a69b-0869-45b2-87ac-7d8738883a53",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "Nevertheless, this book is about the truth, the good and the bad, so I will tread into the forbidden territory, the Mordor of motherhood."
                            },
                            {
                                "example_id": "288f2c19-1df4-4d09-8e63-42c83ba59244",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "“OK, can we go back now?” asked their guide and expert on the underground, whose restless eyes implied that he was on the edge of panic. “I for one am not venturing a step further into this Mordor.”"
                            },
                            {
                                "example_id": "a45a4830-1398-4ebf-ae75-7997bc302b1e",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "It’s impossible to find harmony in an outfit when you have to schlep five kilos of kit with you in order to manage the post-workout transformation. Of course, I could change at work. But this would entail using the office showers. And I would sooner venture into Mordor."
                            },
                            {
                                "example_id": "50723682-6c76-4a82-bb20-ed49a1f07ad0",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "“I fled from Moscow, which has turned into Mordor.[…]”"
                            },
                            {
                                "example_id": "83e112b9-2cc3-46cd-90d4-02337263916f",
                                "sense_id": "b35b8b44-e860-3cc5-acb9-6b382727f892",
                                "text": "They are out in nature for hours a day – despite the fact that the weather’s terrible (we’re talking Mordor from October to March)."
                            }
                        ]
                    },
                    {
                        "sense_id": "237e6366-c839-3e2e-8e35-f54c16f88f2a",
                        "entry_id": "fc851167-1bc0-3ae5-bd6c-cfea922814bd",
                        "glosses": [
                            "Russia."
                        ],
