                    "frequency": "Middle",
                    "semantic_group_id": "anatomie_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chat utilise ses longs <w>ongles</w> pour attraper les souris dans la grange."
                        },
                        {
                            "text": "Le rapace maintient fermement sa proie entre ses redoutables <w>ongles</w>."
