                "senses": [
                    {
                        "sense_id": "5874b96c-2888-35a7-b382-93eb8b693fcf",
                        "entry_id": "d8619659-c07d-3173-9372-8bd685c19c5a",
                        "glosses": [
                            "Mauer aus Beton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34122cdc-e432-44df-adfc-e5523415deed",
                                "sense_id": "5874b96c-2888-35a7-b382-93eb8b693fcf",
                                "text": "„Sie erhellte einen halben Hektar Rollfeld und den nächstgelegenen Unterstand fünfzig Meter neben der Startbahn, der sich als eine zerschossene Betonmauer entpuppte.“"
                            },
                            {
                                "example_id": "404ce9d4-1bdd-4df2-af39-ad36659276ad",
                                "sense_id": "5874b96c-2888-35a7-b382-93eb8b693fcf",
                                "text": "„Das Ganze war hinten und an den Seiten von einer Betonmauer umgeben.“"
                            },
                            {
                                "example_id": "ff62039a-c9b4-40a8-a79f-3fc945ec30dc",
                                "sense_id": "5874b96c-2888-35a7-b382-93eb8b693fcf",
                                "text": "„Durch die Grüne Linie, die Palästina teilte, wurde das israelische Jerusalem vom Rest des Landes weitgehend abgetrennt und lag am Rande eines schmalen Korridors; ein Gürtel aus verfallenen Häusern, Stacheldrahtzäunen, Betonmauern und Minenfeldern teilte die Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
