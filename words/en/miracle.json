{
    "word_family": [
        "miraculous",
        "miraculously",
        "miracle worker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02e2fa74-afc0-32e8-8b1f-f084c054cae3",
                    "sense_definition": "An event that appears inexplicable by the laws of nature and so is held to be supernatural in origin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "supernatural_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people believe that his sudden recovery was a <w>miracle</w>.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что его внезапное выздоровление было <w>чудом</w>.",
                                "es": "Mucha gente cree que su recuperación repentina fue un <w>milagro</w>."
                            }
                        },
                        {
                            "text": "It would take a <w>miracle</w> to finish this project on time.",
                            "target_lang_translations": {
                                "ru": "Потребуется <w>чудо</w>, чтобы закончить этот проект вовремя.",
                                "es": "Haría falta un <w>milagro</w> para terminar este proyecto a tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "marvel",
                        "wonder"
                    ],
                    "common_phrases": [
                        "perform a miracle",
                        "believe in miracles",
                        "work a miracle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, которое кажется необъяснимым с точки зрения законов природы и считается сверхъестественным по происхождению.",
                        "es": "Un suceso que parece inexplicable por las leyes de la naturaleza y que se considera de origen sobrenatural."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "сверхъестественное явление"
                            },
                            {
                                "target_lang_word": "диво",
                                "target_lang_sense_clarification": "удивительное событие (устар./разг.)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "milagro",
                                "target_lang_sense_clarification": "suceso sobrenatural"
                            },
                            {
                                "target_lang_word": "prodigio",
                                "target_lang_sense_clarification": "suceso extraordinario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1730fd0c-9e7d-34ea-af25-af9c87fb18c7",
                    "sense_definition": "A fortunate outcome that prevails despite overwhelming odds against it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "supernatural_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>miracle</w> that nobody was hurt in the car accident.",
                            "target_lang_translations": {
                                "ru": "Это <w>чудо</w>, что никто не пострадал в автомобильной аварии.",
                                "es": "Es un <w>milagro</w> que nadie resultara herido en el accidente de coche."
                            }
                        },
                        {
                            "text": "We won the game by a <w>miracle</w> in the final seconds.",
                            "target_lang_translations": {
                                "ru": "Мы выиграли игру <w>чудом</w> на последних секундах.",
                                "es": "Ganamos el partido de <w>milagro</w> en los últimos segundos."
                            }
                        }
                    ],
                    "synonyms": [
                        "wonder"
                    ],
                    "antonyms": [
                        "disaster",
                        "tragedy"
                    ],
                    "common_phrases": [
                        "it is a miracle",
                        "by a miracle",
                        "minor miracle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Счастливый исход, который происходит вопреки огромным трудностям или низкой вероятности.",
                        "es": "Un resultado afortunado que ocurre a pesar de tener todas las probabilidades en contra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "счастливая случайность"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "milagro",
                                "target_lang_sense_clarification": "suerte inesperada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51d32efa-834d-323b-b613-2f350d18d64d",
                    "sense_definition": "An awesome and exceptional example of something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new bridge is a <w>miracle</w> of modern engineering.",
                            "target_lang_translations": {
                                "ru": "Новый мост — это <w>чудо</w> современной инженерии.",
                                "es": "El nuevo puente es una <w>maravilla</w> de la ingeniería moderna."
                            }
                        },
                        {
                            "text": "The human eye is often described as a <w>miracle</w> of nature.",
                            "target_lang_translations": {
                                "ru": "Человеческий глаз часто описывают как <w>чудо</w> природы.",
                                "es": "El ojo humano se describe a menudo como un <w>milagro</w> de la naturaleza."
                            }
                        }
                    ],
                    "synonyms": [
                        "masterpiece",
                        "marvel"
                    ],
                    "common_phrases": [
                        "miracle of engineering",
                        "miracle of nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потрясающий и исключительный пример чего-либо.",
                        "es": "Un ejemplo asombroso y excepcional de algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чудо",
                                "target_lang_sense_clarification": "выдающийся образец"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "maravilla",
                                "target_lang_sense_clarification": "ejemplo excepcional"
                            },
                            {
                                "target_lang_word": "milagro",
                                "target_lang_sense_clarification": "logro asombroso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e13309db-6090-3316-ad50-5f2d8f297ef4",
                    "sense_definition": "A female given name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My classmate <w>Miracle</w> is coming to the party tonight.",
                            "target_lang_translations": {
                                "ru": "Моя одноклассница <w>Миракл</w> придет сегодня вечером на вечеринку.",
                                "es": "Mi compañera de clase <w>Miracle</w> vendrá a la fiesta esta noche."
                            }
                        },
                        {
                            "text": "They decided to name their daughter <w>Miracle</w> after the difficult birth.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать дочь <w>Миракл</w> после тяжелых родов.",
                                "es": "Decidieron llamar a su hija <w>Miracle</w> después del difícil parto."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "es": "Nombre propio femenino."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миракл",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Miracle",
                                "target_lang_sense_clarification": "nombre propio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "706f1ef5-b6e6-33f9-82f0-d30edd1267d5",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Miracle</w> signed the legal documents yesterday morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Миракл</w> подписал юридические документы вчера утром.",
                                "es": "El Sr. <w>Miracle</w> firmó los documentos legales ayer por la mañana."
                            }
                        },
                        {
                            "text": "I have never met anyone with the last name <w>Miracle</w> before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не встречал никого с фамилией <w>Миракл</w>.",
                                "es": "Nunca antes había conocido a nadie con el apellido <w>Miracle</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "es": "Apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Миракл",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Miracle",
                                "target_lang_sense_clarification": "apellido"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0df50d98-f44c-36eb-8f4b-7da19dc82ab8",
                    "sense_definition": "To affect by a miracle; to work a miracle upon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The healer claimed to have <w>miracled</w> the sick man back to health.",
                            "target_lang_translations": {
                                "ru": "Целитель утверждал, что <w>чудом вернул</w> больному здоровье.",
                                "es": "El curandero afirmó haber <w>hecho un milagro</w> para devolverle la salud al hombre enfermo."
                            }
                        },
                        {
                            "text": "She felt as if she had been <w>miracled</w> out of the dangerous situation.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя так, словно её <w>чудом вытащили</w> из опасной ситуации.",
                                "es": "Se sentía como si la hubieran sacado de la situación peligrosa por <w>milagro</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воздействовать чудом; совершить чудо над кем-то.",
                        "es": "Afectar mediante un milagro; realizar un milagro sobre alguien o algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сотворить чудо",
                                "target_lang_sense_clarification": "воздействовать магической силой"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hacer un milagro",
                                "target_lang_sense_clarification": "obrar milagrosamente"
                            },
                            {
                                "target_lang_word": "obrar un milagro",
                                "target_lang_sense_clarification": "realizar un acto sobrenatural"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}