                            {
                                "example_id": "eac2894b-3290-4f24-95fd-1114637cfa4c",
                                "sense_id": "c5514395-d4e7-3b3a-8d94-a24ee3adf77c",
                                "text": "Я ка́к-нибудь спра́влюсь",
                                "translation": "I’ll make it out somehow (or other).",
                                "english": "I’ll make it out somehow (or other)."
                            }
                        ]
                    },
                    {
                        "sense_id": "4644cdfb-d60c-3a0b-865b-ba9b68967ecf",
                        "entry_id": "09e0b9b0-0f0b-3e33-b129-c1a4cd4ac0fc",
                        "glosses": [
                            "sometime"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bcb34c51-7d63-40e7-ad67-19942078ff17",
                                "sense_id": "4644cdfb-d60c-3a0b-865b-ba9b68967ecf",
                                "text": "Зайди́те ко мне ка́к-нибудь!",
                                "translation": "Drop in and see me sometime!",
                                "english": "Drop in and see me sometime!"
                            }
                        ]
                    }
                ],
