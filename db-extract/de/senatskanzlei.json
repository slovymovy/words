                "senses": [
                    {
                        "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                        "entry_id": "3e78f297-7c5c-3829-889d-9fef205f9e2e",
                        "glosses": [
                            "„Behörde, die administrative und Stabsfunktionen für den Regierungschef“ wahrnimmt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "2166d6bf-fac8-41fb-906e-37de40989d40",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Betrieben wird das Netz durch die ABL Social Federation GmbH, so die Senatskanzlei.“"
                            },
                            {
                                "example_id": "2918e2b9-ea35-41b7-a496-b68563660569",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Chebli ist in der Berliner Senatskanzlei Staatssekretärin für Bürgerschaftliches Engagement und Internationales.“"
                            },
                            {
                                "example_id": "65af7f23-1c02-44b6-9b5f-8086456d835c",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Neue Initiativen kommen aus der Senatskanzlei nicht, wenn man die geplante neue Landesbibliothek ausklammert.“"
                            },
                            {
                                "example_id": "d57d05d2-f5ec-4ca9-ae62-c38f881a848c",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Es handle sich um das ‚zentrale Berliner Infrastrukturprojekt‘, sagte er nach Angaben der Senatskanzlei.“"
                            },
                            {
                                "example_id": "dcfd1a4d-7627-4b28-a189-cef1837f1e65",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„In der Senatskanzlei koordinieren vier Mitarbeiter einer ‚digitalen Leitstelle‘ ressortübergreifend digitale Pilotprojekte und arbeiten an einer Strategie für die Gesamtstadt.“"
                            },
                            {
                                "example_id": "d819bab4-fae4-46c1-9645-4e359c6c5886",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Damit würde der Bund seine Unterstützung nach Berechnung der Hamburger Senatskanzlei von derzeit 4,7 Milliarden auf rund 1,3 Milliarden Euro pro Jahr senken.“"
                            },
                            {
                                "example_id": "9e7d6771-e021-455c-af63-44a02019b5c3",
                                "sense_id": "8968ad62-7903-34af-9eb2-8047eab84e1d",
                                "text": "„Michael Müller betonte, der Chef der Senatskanzlei müsse über alle Themenfelder einen Überblick haben und wie Gaebler eine ‚hohe Kompetenz‘ aufweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
