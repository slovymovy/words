                "senses": [
                    {
                        "sense_id": "aaefc16e-2538-392d-ad67-217d1130ede5",
                        "entry_id": "65838ade-8875-32b9-b690-6ffa7b9dd013",
                        "glosses": [
                            "Rede, die bei einer Beerdigung für einen Verstorbenen gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1073ec15-e000-4434-b46b-61a5a0f5a3b5",
                                "sense_id": "aaefc16e-2538-392d-ad67-217d1130ede5",
                                "text": "„Lipschütz hielt gewöhnlich bei verstorbenen Emigranten die Leichenreden.“"
                            },
                            {
                                "example_id": "e50de272-5f67-4792-b8c3-e5ebfaa9218d",
                                "sense_id": "aaefc16e-2538-392d-ad67-217d1130ede5",
                                "text": "„Indessen begann der Methodistenprediger mit leiser, zitternder Stimme seine Leichenrede über der Asche der von seiner eigenen Hand schändlich Gemordeten.“"
                            },
                            {
                                "example_id": "2c3d198d-eb83-4f79-9440-98359406a7fb",
                                "sense_id": "aaefc16e-2538-392d-ad67-217d1130ede5",
                                "text": "„Ohne Zweifel, unser Pastor hatte diese Leichenrede verfaßt; und jetzt wollte er sie bei mir probieren.“"
                            },
                            {
                                "example_id": "1f6607cd-9d6c-4b31-b4c9-9830e3c9aa11",
                                "sense_id": "aaefc16e-2538-392d-ad67-217d1130ede5",
                                "text": "„Sie leidet unter Syphilis, daher ihre Leichenrede das Motto hat: Die Syphilis, juchhe, tut mir in allen Knochen weh.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
