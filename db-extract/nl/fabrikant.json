                    {
                        "sense_id": "417a6042-a190-3cc2-b20c-62ff52cf4ced",
                        "entry_id": "28bb5e40-8b8e-3873-8d05-4e4c3861c054",
                        "glosses": [
                            "een eigenaar of ondernemer van een fabriek."
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "f3ecb17e-3ef3-428a-bad1-a6443b10c938",
                                "sense_id": "417a6042-a190-3cc2-b20c-62ff52cf4ced",
                                "text": "LG is de fabrikant van de LG Nexus 4, het nieuwe vlaggenschip van Google op smartphonegebied."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70d5ac91-9aae-459c-9047-c77599de3208",
                        "source_entry_id": "28bb5e40-8b8e-3873-8d05-4e4c3861c054",
                        "source_sense_id": "417a6042-a190-3cc2-b20c-62ff52cf4ced",
                        "target_lang_word": "Hersteller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hersteller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                        "entry_id": "1e284e49-ba4c-3c4a-8ae0-9f76c079c2ad",
                                        "glosses": [
                                            "Unternehmen, das bestimmte Artikel herstellt (produziert)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b38771f5-b087-4f07-9067-283e26feda2c",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "Ersatzteile hierfür gibt es nur direkt beim Hersteller."
                                            },
                                            {
                                                "example_id": "c01b8427-ea6c-4fac-9a8b-08829d51b27b",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Als die Staatsanwältin nach dem Hersteller fragt, fährt der Beamte mit dem Zeigefinger über den Pistolenlauf und wischt das Blut weg.“"
                                            },
                                            {
                                                "example_id": "e74a42dd-4656-47ed-8a46-b23050dab1ea",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Der Airbus A321neo mit neuen Triebwerken des Herstellers CFM International hat von Hamburg aus seinen erfolgreichen Erstflug absolviert.“"
                                            },
                                            {
                                                "example_id": "ee39c7a0-3693-47e9-915e-ff17ec098af4",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„So kam die global ausgreifende Chronik nicht zuletzt wegen der lokalen Vernetzung ihrer Mitarbeiter, Hersteller und Financiers zustande.“"
                                            },
                                            {
                                                "example_id": "50d56e7e-3a47-42a6-8267-7ce43382754c",
                                                "sense_id": "34e50181-ee60-3b5e-beaf-77e558801409",
                                                "text": "„Aus Anlass des aktuellen Jubiläums lancierten die Hersteller nun ein Herrenparfüm, über das wir, so hofften sie, dann schreiben würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b083ff89-3818-49c9-b2fe-2ef44209556b",
                        "source_entry_id": "28bb5e40-8b8e-3873-8d05-4e4c3861c054",
                        "source_sense_id": "417a6042-a190-3cc2-b20c-62ff52cf4ced",
