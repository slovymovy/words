                "senses": [
                    {
                        "sense_id": "c4782497-f097-3fcb-bfc8-bfaf2872d4b4",
                        "entry_id": "a0f9874f-7a7e-3687-9f82-d1cab7ad4d09",
                        "glosses": [
                            "nah und flach am Boden wachsendes Kraut mit fünfzähligen, zitronengelben Blüten und kleinen, eiförmigen bis rundlichen, ganzrandigen Blättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4515fc4a-e38f-474d-bc3a-24ac8e036345",
                                "sense_id": "c4782497-f097-3fcb-bfc8-bfaf2872d4b4",
                                "text": "In der Volksmedizin wird das Pfennigkraut bei Husten, Rheuma, Durchfall und äußerlich bei Wunden verwendet."
                            },
                            {
                                "example_id": "3a19adc2-534d-424c-be2e-fb16ab4f2966",
                                "sense_id": "c4782497-f097-3fcb-bfc8-bfaf2872d4b4",
                                "text": "Das Pfennigkraut ist ein ausgezeichneter Bodendecker und wird deshalb auch gerne in Gärten angepflanzt."
                            },
                            {
                                "example_id": "7fbe7ab1-a6ec-409c-8658-eead3a952926",
                                "sense_id": "c4782497-f097-3fcb-bfc8-bfaf2872d4b4",
                                "text": "Im Schatten gedeiht das Pfennigkraut zwar auch, ist dort aber weniger blühfreudig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
