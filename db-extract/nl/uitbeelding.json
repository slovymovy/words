        "nl-extract.jsonl": [
            {
                "entry_id": "918e2dbf-dd0c-364a-a293-fa39f7e5168a",
                "word": "uitbeelding",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "16acb89d-d0dd-42a0-b061-89d95a7d74b1",
                        "entry_id": "918e2dbf-dd0c-364a-a293-fa39f7e5168a",
                        "tags": [
                            "plural"
                        ],
                        "form": "uitbeeldingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d82581b-d32a-315e-bbd5-b64450823090",
                        "entry_id": "918e2dbf-dd0c-364a-a293-fa39f7e5168a",
                        "glosses": [
                            "iets dat weergeeft wat zintuigelijk niet waarneembaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "655da462-7789-4457-97b6-b995c7698d00",
                                "sense_id": "0d82581b-d32a-315e-bbd5-b64450823090",
                                "text": "Een hiëroglief, zei de retor, is de uitbeelding van iets dat niet zintuiglijk waarneembaar is, en dat eigenschappen bezit die gelijk zijn aan die van het uitgebeelde."
                            },
                            {
                                "example_id": "8f8e2a1d-742c-425f-9a79-bfff7cfa3872",
                                "sense_id": "0d82581b-d32a-315e-bbd5-b64450823090",
                                "text": "\"Dat is een beetje wat er mis is in ons land op dit moment: hooggeplaatste individuen proberen verdeeldheid te zaaien, door te doen alsof deze discussie over onze vlag gaat, alsof de vlag iets anders is dan wat het echt is - dat wil zeggen een uitbeelding waar wij voor staan: diversiteit, vreedzaam demonstreren, het recht op vrijheid van meningsuiting. Het is eigenlijk ironisch.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "602d3246-e6d5-4ab4-824a-c9be46fb4e0a",
                        "source_entry_id": "918e2dbf-dd0c-364a-a293-fa39f7e5168a",
                        "source_sense_id": "0d82581b-d32a-315e-bbd5-b64450823090",
                        "source_sense_description": "iets dat weergeeft wat zintuigelijk niet waarneembaar is",
                        "target_lang_word": "portrayal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portrayal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be337732-0e81-3bf5-9f4f-a10239c5817f",
                                        "entry_id": "a2d5dbd3-8f6c-3474-870b-dc5ee29487f2",
                                        "glosses": [
                                            "The act of portraying."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                                        "entry_id": "a2d5dbd3-8f6c-3474-870b-dc5ee29487f2",
                                        "glosses": [
                                            "The result of portraying; a representation, description, or portrait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cdf6e7b-33ba-49db-b155-fb2124f694dd",
                                                "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                                                "text": "1866, Charlotte Yonge, The Dove in the Eagle's Nest\nHe had already designed the portrayal of his father as the old white king, and himself as the young white king, in a series of woodcuts illustrating the narrative which culminated in the one romance of his life, ..."
                                            },
                                            {
                                                "example_id": "4fd357dd-2d58-42be-b5b1-d6a062e215ec",
                                                "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                                                "text": "1909, Arnold Bennett, Literary Taste\nFor days afterwards you will not be able to look upon a child without recalling Lamb's portrayal of the grace of childhood."
                                            },
                                            {
                                                "example_id": "48fd8393-c593-4f0a-bc15-3f2f7755a0c8",
                                                "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                                                "text": "Dickens was the quintessential actor, luxuriating in the portrayal of his idiosyncratic characters. In contrast, more than a characterist, Poe was above all a wonderfully musical reader, […]"
                                            },
                                            {
                                                "example_id": "9677532b-0ab2-478e-85cd-92672f89cf13",
                                                "sense_id": "3eb64d9d-70f3-3412-afc5-80b60284c16c",
                                                "text": "Images of Dutchness in American visual culture and literature during the nineteenth century differed radically between portrayals of the Netherlands Dutch and those of the American Dutch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5239131f-539b-4448-8a44-f7093fa2f846",
                        "source_entry_id": "918e2dbf-dd0c-364a-a293-fa39f7e5168a",
                        "source_sense_id": "0d82581b-d32a-315e-bbd5-b64450823090",
                        "source_sense_description": "iets dat weergeeft wat zintuigelijk niet waarneembaar is",
                        "target_lang_word": "picture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "picture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c530bfd4-1f49-3475-98f3-8c0c184cc708",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A representation of anything (as a person, a landscape, a building) upon canvas, paper, or other surface, by drawing, painting, printing, photography, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2e86d9a-6b50-49c3-8f48-9a93269597dd",
                                                "sense_id": "c530bfd4-1f49-3475-98f3-8c0c184cc708",
                                                "text": "Orion hit a rabbit once; but though sore wounded it got to the bury, and, struggling in, the arrow caught the side of the hole and was drawn out.[…]. Ikey the blacksmith had forged us a spearhead after a sketch from a picture of a Greek warrior; and a rake-handle served as a shaft."
                                            },
                                            {
                                                "example_id": "f03c1a9f-6e22-4e24-b5fa-2f3e53f9461d",
                                                "sense_id": "c530bfd4-1f49-3475-98f3-8c0c184cc708",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca384c74-da35-3578-9284-a8a11a354bac",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "An image; a representation as in the imagination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a910672a-dcde-4e20-a5e6-7f8acdbba097",
                                                "sense_id": "ca384c74-da35-3578-9284-a8a11a354bac",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "e76e11a1-b14c-43a0-8927-9ef4b93fbe2b",
                                                "sense_id": "ca384c74-da35-3578-9284-a8a11a354bac",
                                                "text": "Prior to seeing him and meeting him, and hearing him speak, I had conjured up a picture of him in my mind, which actual contact with him proved to be an illusion. I had conceived of him[…]as being tall, commanding, and as the advance notices of him, a sliver-tongued orator. I found him, however, to be the opposite of my mental picture; short, squat, unpretentious[…]."
                                            },
                                            {
                                                "example_id": "709aa05b-f031-4c61-8963-4b3894f14a70",
                                                "sense_id": "ca384c74-da35-3578-9284-a8a11a354bac",
                                                "text": "My eyes make pictures when they are shut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f05a6b6-6929-36f8-9c5a-f2e4e73c1053",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A painting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4caea33-60ba-48ff-a13b-cf40c63448ca",
                                                "sense_id": "4f05a6b6-6929-36f8-9c5a-f2e4e73c1053",
                                                "text": "Here the stripped panelling was warmly gold and the pictures, mostly of the English school, were mellow and gentle in the afternoon light."
                                            },
                                            {
                                                "example_id": "d969f5db-46ca-4d6d-89dc-946c72fcddc6",
                                                "sense_id": "4f05a6b6-6929-36f8-9c5a-f2e4e73c1053",
                                                "text": "There was a picture hanging above the fireplace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A photograph."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb1867b7-a410-46ae-8d9e-a6972909e3fd",
                                                "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                                                "text": "I took a picture of the church."
                                            },
                                            {
                                                "example_id": "c103173d-8b3c-45a6-9283-7ed5adb60771",
                                                "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                                                "text": "It has not been used for many years, and although it was impracticable to photograph the engine in the small confines of the shed it was possible to obtain a picture of the plate which it still carries showing the former ownership."
                                            },
                                            {
                                                "example_id": "c7e807c6-d035-4791-b532-2e8be4518569",
                                                "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                                                "text": "Pictures of Lily made my life so wonderful / Pictures of Lily helped me sleep at night"
                                            },
                                            {
                                                "example_id": "9f00a8d7-6074-4ae9-818a-c2e2c4008cd1",
                                                "sense_id": "4e0e0f1c-d889-3f86-96bd-b67b3ff720b2",
                                                "text": "I've been looking so long at these pictures of you / That I almost believe that they're real"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0f8221-3bf8-3e81-9e0c-93e6633969cb",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A motion picture."
                                        ],
                                        "tags": [
                                            "India",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bffdd1cd-a141-4ca3-82b8-337dd46854fb",
                                                "sense_id": "ae0f8221-3bf8-3e81-9e0c-93e6633969cb",
                                                "text": "Casablanca is my all-time favorite picture."
                                            },
                                            {
                                                "example_id": "b1f95998-b218-4b21-98aa-27cb99ee410a",
                                                "sense_id": "ae0f8221-3bf8-3e81-9e0c-93e6633969cb",
                                                "text": "\"You make moving pictures. In jungles and places.\" \"That's me. And I've picked you for the lead in my next picture.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09bb187f-5fe5-348b-9058-4b1595446654",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "(\\\"the pictures\\\") Cinema (as a form of entertainment)."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "158dde46-f5a3-407f-a791-e8c536a7cec4",
                                                "sense_id": "09bb187f-5fe5-348b-9058-4b1595446654",
                                                "text": "Let's go to the pictures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79cbfb31-d0c7-36dc-aad0-1d6282f38677",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A paragon, a perfect example or specimen (of a category)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2250b365-a4b5-4657-ab60-d94ce16d87cd",
                                                "sense_id": "79cbfb31-d0c7-36dc-aad0-1d6282f38677",
                                                "text": "She's the very picture of health."
                                            },
                                            {
                                                "example_id": "e66b3dcd-95b5-42ae-8d77-e6f45293fccb",
                                                "sense_id": "79cbfb31-d0c7-36dc-aad0-1d6282f38677",
                                                "text": "Franklin Delano Roosevelt was in poor health for much of his presidency, even though his doctors, his family, and even journalists colluded to portray him as the picture of health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f7c0ca5-373c-3332-b5e7-b13a5e551cc5",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "An attractive sight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1076f643-c448-4757-88b0-53228bb2217b",
                                                "sense_id": "8f7c0ca5-373c-3332-b5e7-b13a5e551cc5",
                                                "text": "The garden is a real picture at this time of year."
                                            },
                                            {
                                                "example_id": "e19eb70b-683c-4c3b-88b4-70e2360b41aa",
                                                "sense_id": "8f7c0ca5-373c-3332-b5e7-b13a5e551cc5",
                                                "text": "it was heartening to see a young Indian football team Mata had invited to Manchester. His face was a picture when he listened to the little footballers sing a team song for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45bc4573-c8e6-3ef3-9916-772f8c1b4b3c",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "The art of painting; representation by painting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b5c04d-eaec-45eb-93f6-ae02e741b9b1",
                                                "sense_id": "45bc4573-c8e6-3ef3-9916-772f8c1b4b3c",
                                                "text": "any well-expressed image[…]either in picture or sculpture"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f4529d-607b-3645-a559-54c1f33aada6",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A figure; a model."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4fd92a8-eb89-4175-b19a-2983f9558b5e",
                                                "sense_id": "09f4529d-607b-3645-a559-54c1f33aada6",
                                                "text": "the young king's picture[…]in virgin wax"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4d87e7-7006-321d-9e3f-d85f71a23cc0",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "Situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4774fc35-5952-4543-bd20-e86e692b0cd4",
                                                "sense_id": "0d4d87e7-7006-321d-9e3f-d85f71a23cc0",
                                                "text": "The employment picture for the older middle class is not so good."
                                            },
                                            {
                                                "example_id": "a65c42a1-c1ed-4a0e-8cac-6d998980ab9f",
                                                "sense_id": "0d4d87e7-7006-321d-9e3f-d85f71a23cc0",
                                                "text": "You can't just look at the election, you've got to look at the big picture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c15f3afa-e542-3a64-8d97-eb877bb44b08",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A sample of an illegal drug."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f63a00-3163-4cc2-bcc7-088de9a49e8e",
                                                "sense_id": "c15f3afa-e542-3a64-8d97-eb877bb44b08",
                                                "text": "If you want me to buy your weed I’ll need a picture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d149e94e-12f9-3979-b531-d7e15443aa63",
                                        "entry_id": "adad8fef-bba5-33c7-9584-76053104ef4e",
                                        "glosses": [
                                            "A format string in the COBOL programming language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6b44a17-aff5-4438-9274-94420f0035f3",
                                                "sense_id": "d149e94e-12f9-3979-b531-d7e15443aa63",
                                                "text": "The COBOL restriction for the currency symbol in a picture string to be replaced by a single character currency symbol is a compromise solution."
                                            },
                                            {
                                                "example_id": "4fa540ac-e560-456b-8818-de8ff3fe1ebf",
                                                "sense_id": "d149e94e-12f9-3979-b531-d7e15443aa63",
                                                "text": "To recapitulate, the pictures we have considered so far are: X – any character A — alphabetic characters and the space character […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "picture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc51a846-e589-3da1-a5b6-f5be237f6b7b",
                                        "entry_id": "83b1c8aa-9677-3d9c-bd60-35887944a0b1",
                                        "glosses": [
                                            "To represent in or with a picture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e4e922-1695-4588-8b95-788c2c13e3a1",
                                                "sense_id": "dc51a846-e589-3da1-a5b6-f5be237f6b7b",
                                                "text": "while upon the shaded top of the box, drawn in perspective, the artist had pictured a plate with the beautifully executed, twin-lobed, brainlike, halved kernel of a walnut."
                                            },
                                            {
                                                "example_id": "2fefc67c-3adf-489e-9f02-804c81031934",
                                                "sense_id": "dc51a846-e589-3da1-a5b6-f5be237f6b7b",
                                                "text": "What is striking about the self portrait is that the patient had pictured herself as a much younger woman"
                                            },
                                            {
                                                "example_id": "9006fa40-e2a2-4306-8694-b87fb19d5e6d",
                                                "sense_id": "dc51a846-e589-3da1-a5b6-f5be237f6b7b",
                                                "text": "Anyone \"skilled in the art\" could see from their language that Lemp and Wightman had not invented or patented the invention their draftsman had pictured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ce4147-17f8-3844-957e-64d9e76a6eb4",
                                        "entry_id": "83b1c8aa-9677-3d9c-bd60-35887944a0b1",
                                        "glosses": [
                                            "To imagine or envision."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c62c6b-33e0-4454-8414-e308342ab7be",
                                                "sense_id": "91ce4147-17f8-3844-957e-64d9e76a6eb4",
                                                "text": "Picture yourself on a boat on a river / With tangerine trees and marmalade skies"
                                            },
                                            {
                                                "example_id": "a7a2d91e-7902-429d-9298-eb860ce993ff",
                                                "sense_id": "91ce4147-17f8-3844-957e-64d9e76a6eb4",
                                                "text": "If you can picture this—a day in December / Picture this—freezing cold weather / You got clouds on your lids and you'd be on the skids"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                        "entry_id": "83b1c8aa-9677-3d9c-bd60-35887944a0b1",
                                        "glosses": [
                                            "To depict or describe vividly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1394d8dd-92cb-4f4b-8719-67d70b35fe19",
                                                "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                                "text": "I had never found him so impossible to soften or to move. I tried this way and I tried that; I pictured his future in an English gaol; I described the sorrow of his mother when I came back with the news; I said everything to touch his heart, but all to no purpose."
                                            },
                                            {
                                                "example_id": "a3ef524f-0c5a-4799-8a68-5d88dce3be64",
                                                "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                                "text": "Drawing is picturing people, places, and things with line."
                                            },
                                            {
                                                "example_id": "e88a5dae-0d02-4425-b011-a33493e1fce2",
                                                "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                                "text": "Many rock paintings picture various species of fish."
                                            },
                                            {
                                                "example_id": "07a8fd23-4698-4257-90a1-ea6fb1076ed0",
                                                "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                                "text": "A plain, seemingly graceless stylist, his rather unpalatable movies, full of rabid, sloggingly orchestrated physical pain and psychic damage, picture crime as a monstrous, miasmal evil, divesting it of any glamour it ever had."
                                            },
                                            {
                                                "example_id": "07c2109a-2463-4c13-a8e3-3cee2950aadc",
                                                "sense_id": "e164084b-687c-38fb-86ac-301bd8adc016",
                                                "text": "The sketch pictured here takes in the whole scene."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
