                ],
                "senses": [
                    {
                        "sense_id": "19fe8aec-df3f-3114-be9e-24eca77ae836",
                        "entry_id": "20ed784a-7fce-3b22-9039-1faeb7e70098",
                        "glosses": [
                            "S’emballer tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be78922-9034-4611-b353-a1c148028cf8",
                                "sense_id": "19fe8aec-df3f-3114-be9e-24eca77ae836",
                                "text": "Cette même résistance provoque un échauffement et le phénomène peut s'auto-emballer jusqu'à provoquer un arc électrique permanent dans l'interrupteur qui finira par fondre / brûler."
                            },
                            {
                                "example_id": "8ae66997-4774-45e7-b5ab-9c1afbdda656",
                                "sense_id": "19fe8aec-df3f-3114-be9e-24eca77ae836",
                                "text": "Bizarrement, ici c'est l'explosivité du phénomène, sa capacité à s'auto-emballer qui assure la répétition du phénomène et sa pérennité dans le temps."
                            },
                            {
                                "example_id": "7b41c5b3-3a1f-4eff-9225-51ed426ab0df",
                                "sense_id": "19fe8aec-df3f-3114-be9e-24eca77ae836",
                                "text": "Surtout qu'à la longue, ton moteur pourrait s'auto-emballer et tourner avec sa propre huile, et là...gros dégats."
                            },
                            {
                                "example_id": "fa314856-47fc-4276-81f4-708d0a619c10",
                                "sense_id": "19fe8aec-df3f-3114-be9e-24eca77ae836",
                                "text": "Le 1.9DCi a un turbo de merde qui a tendance à claquer sans prévenir,aspirer toute l'huile moteur et s'auto-emballer."
                            }
                        ]
                    },
