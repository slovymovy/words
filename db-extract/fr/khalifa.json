                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acbe50a8-aac7-4f5c-9df2-662184183170",
                                "sense_id": "41bd966b-a24e-3442-bc3f-fe2a5b297ece",
                                "text": "L’écrivain et scénariste syrien Khaled Khalifa, auteur de plusieurs romans (Éloge de la haine, La mort est une corvée) l’ayant placé parmi les auteurs contemporains les plus reconnus de son pays, est décédé, samedi soir à Damas, à l’âge de 59 ans."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "713fa266-7aa3-368f-a42a-e9758c227193",
                "word": "khalifa",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9b91505-8663-418f-8f80-ff40ac37a724",
