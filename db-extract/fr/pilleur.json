                "senses": [
                    {
                        "sense_id": "4571fc92-f8ac-3bc7-8444-5cb1a0226709",
                        "entry_id": "e4755918-aad9-31ae-b65c-78c1a11153e7",
                        "glosses": [
                            "Celui qui pille, qui a l’habitude de piller."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d24d6d6b-c58e-414d-a348-0a225c488c3d",
                                "sense_id": "4571fc92-f8ac-3bc7-8444-5cb1a0226709",
                                "text": "Pilleur d’épaves."
                            },
                            {
                                "example_id": "0bae6576-fd95-46e2-bef7-6729d6b09a66",
                                "sense_id": "4571fc92-f8ac-3bc7-8444-5cb1a0226709",
                                "text": "Il regrette de n’avoir pas mis immédiatement à mort le pilleur de sarcophage, maintenant que tout espoir a disparu de retrouver la momie de Taa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a36fb81d-eec5-43de-af00-5a960db9aa44",
                        "source_entry_id": "e4755918-aad9-31ae-b65c-78c1a11153e7",
                        "source_sense_id": "4571fc92-f8ac-3bc7-8444-5cb1a0226709",
                        "target_lang_word": "Plünderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plünderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                        "entry_id": "32b88e11-397b-3207-97e4-3e19c46c9a74",
                                        "glosses": [
                                            "Person, die Sachen entwendet und dabei Gewalt anwendet/große Zerstörung hinterlässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf08cf5c-681d-40f7-bbc7-0c957c73043e",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "Nach dem Krieg wurden Plünderer mit dem Tode bestraft."
                                            },
                                            {
                                                "example_id": "03e18353-f856-422a-b597-e688b963e296",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Slawische und finnische Stämme leben in dieser dünn besiedelten Region; lohnende Ziele für Plünderer wie etwa Städte oder Klöster gibt es nicht.“"
                                            },
                                            {
                                                "example_id": "e59f32e6-fc8a-4e1b-810a-e0f774597556",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Auf Anmarschrouten von 500 und mehr Kilometern bewegten sich die Plünderer aus der Tiefe der Wildnis heraus, um die spanischen Vorposten und Bauerndörfer anzugreifen, in denen Großgrundbesitzer Haciendas betrieben und die Felder von Mestizen und versklavten Indios bestellen ließen.“"
                                            },
                                            {
                                                "example_id": "be35b11b-364c-4d7d-a537-fc2eda823c79",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Ich schaffe es einfach nicht, da hineinzuklettern und sie wie ein Plünderer zu durchstöbern; ich kehre um.“"
                                            },
                                            {
                                                "example_id": "1977cf66-6282-4e56-95a8-8c1832304087",
                                                "sense_id": "cad902a0-f752-3a3e-bcb3-06b8e7f4db6c",
                                                "text": "„Trotz der strengen Auflagen und ein oder zwei ziemlich heftiger Beispiele für Srafen, die der Kommodore verhängte, waren die Black Jokers in jener Nacht an Land nicht die einzigen Plünderer gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06e0ed87-ba3d-4e21-853a-86eae668a4d4",
                        "source_entry_id": "e4755918-aad9-31ae-b65c-78c1a11153e7",
                        "source_sense_id": "4571fc92-f8ac-3bc7-8444-5cb1a0226709",
                        "target_lang_word": "Räuber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Räuber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                        "entry_id": "7667820d-d322-3a87-9c39-a9ef51ecbbb6",
                                        "glosses": [
                                            "Person, die einer anderen Person rechtswidrig und unter Androhung oder auch Anwendung von Gewalt etwas wegnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a3a58a-2fac-4991-baad-a8ccaaddb0d4",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "Der Räuber wurde für seine Tat verurteilt."
                                            },
                                            {
                                                "example_id": "ddd64159-dc79-4829-84b0-b9aa94ef905e",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "„Damals war auch die Soldatensprache weitgehend identisch mit dem Jargon der Räuber.“"
                                            },
                                            {
                                                "example_id": "d1197242-335c-4446-ad94-90068f63b3f4",
                                                "sense_id": "1ba85373-a4a7-3fab-9aeb-aa9fb1899f88",
                                                "text": "„Am Ende sagt der Karl sich von den Räubern los.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e5f0953-4434-3f2c-883a-cdd9d236e508",
                                        "entry_id": "7667820d-d322-3a87-9c39-a9ef51ecbbb6",
                                        "glosses": [
                                            "spaßhaft (zu einem Kind) für Schelm, Schlingel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d96b37-cbe9-492e-9877-73a4b6a22ec8",
                                                "sense_id": "1e5f0953-4434-3f2c-883a-cdd9d236e508",
                                                "text": "Du kleiner Räuber, hast du mich schon wieder hereingelegt?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
