                "senses": [
                    {
                        "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                        "entry_id": "53bfa390-52e5-3211-be4e-51d08138cd7d",
                        "glosses": [
                            "eine große, kalte innerasiatische Sandwüste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c27a8e83-edea-4eb3-b23f-fa0bc1981e75",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Die große Sandwüste Taklamakan ist umgeben von den Gebirgen Tien Shan, Kunlun Shan und Karakorum."
                            },
                            {
                                "example_id": "53a879d2-721d-4ea6-a380-067c9cb3bb2d",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Die Taklamakan ist die zweitgrößten Sandwüste der Erde und hat Temperaturunterschiede von bis zu 70 Grad Celcius – an einem Tag."
                            },
                            {
                                "example_id": "4317c623-62dd-49f4-ae18-39d1c893a9e3",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Trotzdem zeugen in der Taklamakan im Nordwesten Chinas 4.000 Jahre alte Mumien und Geisterstädte von vergangenen Hochkulturen."
                            },
                            {
                                "example_id": "1fb6a418-a4f9-43d1-9f9f-9b18e0b359fb",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Sand aus der Taklamakan färbte schon Alpengletscher dunkel."
                            },
                            {
                                "example_id": "b2400b83-0700-4041-92ac-ddbfba0f1d0f",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Zwischen 1893 und 1897 erforschte Hedin das Hochgebirge des Pamir, bereiste in Xinjiang das Tarimbecken mit der Sandwüste Taklamakan, dem See Karakoshun und dem Bosten-See und erforschte schließlich Nord-Tibet."
                            },
                            {
                                "example_id": "ad10887f-2c72-41ac-a40a-9c24712f961d",
                                "sense_id": "3b2d2920-7448-3679-9194-a7cf293ff1e8",
                                "text": "Die Stadt liegt an der Fernstraße, die am Nordrand der Taklamakan entlang führt sowie an der parallel dazu verlaufenden Eisenbahnstrecke in Richtung Kashgar bzw. Urumqi."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
