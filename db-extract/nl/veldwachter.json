                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b8c03f8-188a-4dd4-aca5-61f66e589e12",
                                                "sense_id": "6e6a0a2a-2aec-3227-a356-fe252b008d24",
                                                "text": "The US is tempted to play the role of global gendarme because everyone knows that the UN, as it is, lacks the resources and capacity to fill this role."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76aa6e3e-1222-385d-9531-cbe09abc0269",
                                        "entry_id": "fd7546ee-9897-314e-b5e2-3e4d92adb9b6",
                                        "glosses": [
                                            "A rock pinnacle on a mountain ridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d5d4546-840c-49b1-ab10-92208a1b6622",
                                                "sense_id": "76aa6e3e-1222-385d-9531-cbe09abc0269",
                                                "text": "The previous attempts foundered when they tried to take this gendarme directly."
                                            },
                                            {
                                                "example_id": "311515a8-eae5-40eb-b0d0-6f7feff947ff",
                                                "sense_id": "76aa6e3e-1222-385d-9531-cbe09abc0269",
                                                "text": "The Arete starts easily, with several beautiful, loping pitches leading to a striking gendarme."
                                            },
                                            {
                                                "example_id": "d8620269-45b0-4e08-bf94-2010200bdf02",
                                                "sense_id": "76aa6e3e-1222-385d-9531-cbe09abc0269",
                                                "text": "Continuing to the main summit involves ascents of the gendarmes (the first being the owl-eared one referred to in the next route description) and 140-foot rappels down their south sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
