                                        "sense_id": "97e4f50e-392f-3c3e-a7de-8e23411e2084",
                                        "entry_id": "b9082697-dad4-3e97-8d4e-fc86630336f5",
                                        "glosses": [
                                            "A large amount."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
