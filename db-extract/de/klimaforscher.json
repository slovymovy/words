                "senses": [
                    {
                        "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                        "entry_id": "a5de44b6-0b44-3b94-9db5-0589e9cba502",
                        "glosses": [
                            "Wissenschaftler, der die Gesetzmäßigkeiten des Klimas erforscht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61274842-5131-4f20-bfe2-f3752b216466",
                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                "text": "Viele Klimaforscher warnen vor den Folgen der globalen Erwärmung."
                            },
                            {
                                "example_id": "9d303a8b-693e-43d8-a05f-411b56d1719c",
                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                "text": "„Es ist ein Rätsel, das die Klimaforscher bis heute umtreibt, auch wenn man nun einige Antworten hat: Von 1998 bis 2012 stockte die globale Erwärmung, und lange war nicht klar, was der Grund dafür gewesen sein könnte.“"
                            },
                            {
                                "example_id": "21105d5b-3a45-4fb4-be3a-8c871ec4ce4f",
                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                "text": "„Die Klimaforscher warnen, dass vor allem Trichlorfluormethan stark wirksam ist: Es heizt nicht nur das Klima auf, sondern zerstört zusätzlich die filternde Ozonschicht.“"
                            },
                            {
                                "example_id": "9f95ae5e-03e7-4a5f-a375-c569ad7f6673",
                                "sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                                "text": "„Klimaforscherinnen und Klimaforscher beschäftigen sich schon seit Jahren mit der Frage, bis wann die Welt bei Netto-Null-Emissionen ankommen muss, um den Klimawandel unter Kontrolle zu bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "582aadb3-7f77-419f-a8f4-347a78057772",
                        "source_entry_id": "a5de44b6-0b44-3b94-9db5-0589e9cba502",
                        "source_sense_id": "4b0a7ba6-920d-304f-ae34-843dd099c0e1",
                        "source_sense_description": "Wissenschaftler, der die Gesetzmäßigkeiten des Klimas erforscht",
                        "target_lang_word": "climatologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climatologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                        "entry_id": "e8a171e6-e9aa-3218-8014-1be8ba5cde51",
                                        "glosses": [
                                            "A person who studies, professes or practices climatology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "005c4aaa-1bab-4b52-8ffc-586eee8a9a9b",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "To most people, the huge ice sheets of Antarctica and Greenland are merely water that once was snow. To glaciologists and climatologists, they are storehouses of the Earth's former atmospheres."
                                            },
                                            {
                                                "example_id": "a593e730-ae90-43c9-9390-af4e02535adc",
                                                "sense_id": "5c5be25b-053e-36a7-a913-7a7674badfa5",
                                                "text": "“The lack of an agreement to phase out fossil fuels was devastating,” said Prof Michael Mann, a climatologist and geophysicist at the University of Pennsylvania in the US."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
