                                        "sense_id": "7d3543c4-08fa-3855-939c-be444da76d1c",
                                        "entry_id": "488b0301-a047-3963-91f6-404010be0ab2",
                                        "glosses": [
                                            "The branch of malacology dealing with cephalopods."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5620976b-82de-4424-944b-7eb74242757b",
                                                "sense_id": "7d3543c4-08fa-3855-939c-be444da76d1c",
                                                "text": "The region concerned is faunally a very rich one, but as its teuthology has been hitherto practically unknown, the fact that a number of its most common and characteristic species are undescribed need be in no way surprising."
                                            },
                                            {
                                                "example_id": "6c4147fe-6d39-4e8f-b18d-0249830ada92",
                                                "sense_id": "7d3543c4-08fa-3855-939c-be444da76d1c",
                                                "text": "Students of Teuthology today are fortunate to have a wealth of excellent references published in the past decade."
                                            }
                                        ]
                                    }
                                ]
                            }
