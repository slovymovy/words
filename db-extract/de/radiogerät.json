                ],
                "senses": [
                    {
                        "sense_id": "01a3cf42-2b36-3188-bd17-3ef7fc8d30a8",
                        "entry_id": "64755d55-2942-3659-a63c-7ead5e3b5bfd",
                        "glosses": [
                            "ein Gerät, mit dem man sich Radiosendungen anhören kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcb497cd-b0d4-44a4-a453-27266e26d805",
                                "sense_id": "01a3cf42-2b36-3188-bd17-3ef7fc8d30a8",
                                "text": "Da das Fernsehen kaputt war, verfolgten sie das Fußballspiel am Radiogerät."
                            },
                            {
                                "example_id": "56e31515-acd4-4808-93e2-96368f4daef3",
                                "sense_id": "01a3cf42-2b36-3188-bd17-3ef7fc8d30a8",
                                "text": "„Manche Nachrichten stammen aus dem Radio, obwohl der Besitz von Radiogeräten weiter offiziell verboten bleibt.“"
                            },
                            {
                                "example_id": "31b6d7f8-4316-4419-b467-211d88e37b3c",
                                "sense_id": "01a3cf42-2b36-3188-bd17-3ef7fc8d30a8",
                                "text": "„Das Radiogerät lieferte die Stimmen des Anklägers und der Zeugen, Stimmen, die sich in der Luft auflösten, und Sarale lieferte die dazugehörigen Bilder.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c3b3978-3726-4bc8-946c-c3babc86924f",
