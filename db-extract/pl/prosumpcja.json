                            {
                                "target_word": "prosumption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3932656a-c832-3a72-aa5a-04a613cb8d6f",
                                        "entry_id": "c2c28bd3-2f39-3b37-a070-433a1dc9559c",
                                        "glosses": [
                                            "The contribution to product development by end users."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ade656-afd9-40f1-aeba-fe3832f757b8",
                                                "sense_id": "3932656a-c832-3a72-aa5a-04a613cb8d6f",
                                                "text": "The chapter covers the review of approaches that have been developed by prosumption specialists to improve the integration between the production for use and production for sale."
                                            },
                                            {
                                                "example_id": "c43ed0c1-218f-48d7-86d7-f4c6756408e8",
                                                "sense_id": "3932656a-c832-3a72-aa5a-04a613cb8d6f",
                                                "text": "In fact they suggest that the rise of prosumption signals a new stage of capitalism in which it no longer makes sense to speak of workers as exploited."
                                            },
                                            {
                                                "example_id": "abad3b6b-4ca7-421a-8566-c07799fcf2e4",
                                                "sense_id": "3932656a-c832-3a72-aa5a-04a613cb8d6f",
                                                "text": "Although they did not have the concept until recently, sociologists, social theorists, and other students of society and the media have always focused, albeit unknowingly, on prosumption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
