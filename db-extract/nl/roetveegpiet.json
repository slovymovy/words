                        "glosses": [
                            "helper van Sinterklaas die zwarte vegen op zijn huid heeft aangebracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f408fa-e3fd-461a-96ab-03b85c6e75e0",
                                "sense_id": "91b225e6-00c5-30de-ac1b-ca7d7b2b6c4f",
                                "text": "Bij de sinterklaasintochten in de grote Brabantse steden zullen geen roetveegpieten meedoen. De organiserende comités in de steden houden vast aan traditionele pieten, die bruin, donkerbruin of zwart gekleurd zijn."
                            },
                            {
                                "example_id": "7751dba6-0b65-4ebf-99e1-1a7ab6ed0a14",
                                "sense_id": "91b225e6-00c5-30de-ac1b-ca7d7b2b6c4f",
                                "text": "Spaanse edellieden, roetveegpieten, Zwarte Pieten en regenboogpieten. Het uiterlijk van Piet staat nogal ter discussie. Toch is het niet zo dat Piet sinds zijn prille begin er altijd hetzelfde uit heeft gezien."
                            }
                        ]
                    }
