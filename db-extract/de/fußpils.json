                "senses": [
                    {
                        "sense_id": "7da99e25-ea4a-3e4e-8eda-762dca06c53c",
                        "entry_id": "712baf7d-24a0-3333-b2e5-8eacf1fa3059",
                        "glosses": [
                            "Bier oder bierhaltiges Getränk, das durch Einwohner und Touristen auf dem Weg zur oder von der Arbeit, zu einer Feier oder zwischen Aufenthaltsorten konsumiert wird; Wegbier"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "9b098eef-ed77-4a3e-9f70-bc766c1f94ab",
                                "sense_id": "7da99e25-ea4a-3e4e-8eda-762dca06c53c",
                                "text": "„Geht es von dort in den Club, ins Stadion oder ins Kino, greift man zum Wegbier, gern auch Fußpils genannt.“"
                            },
                            {
                                "example_id": "f0391fd7-e7a0-4e02-b115-a4b0c26b8e10",
                                "sense_id": "7da99e25-ea4a-3e4e-8eda-762dca06c53c",
                                "text": "„Und Partygänger bringen sich mit einem Wegbier, in Berlin gerne auch Fußpils genannt, in Schwung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
