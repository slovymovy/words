                ],
                "senses": [
                    {
                        "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                        "entry_id": "ec7faafd-bb3f-32f3-bae6-c6a90404bb8c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65da10e-0882-4d60-87aa-6cbac984a677",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Frau Ehrmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "acc385d8-cde8-44fc-b052-3b977924ff2d",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Herr Ehrmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7cfe6b82-ad47-4510-b551-3110c563d5cb",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Die Ehrmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ef6ade6e-9241-409a-a215-53a7002d2e34",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Der Ehrmann trägt nie die Schals, die die Ehrmann ihm strickt."
                            },
                            {
                                "example_id": "9f359ea4-1b03-405a-8fd7-86a813250c7b",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ehrmann kommt, geht der Herr Ehrmann.“"
                            },
                            {
                                "example_id": "00f0b70e-6f37-4b94-87d6-f62eabfb5029",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Ehrmann kommt und geht."
                            },
                            {
                                "example_id": "9447398e-0370-4548-bb4b-a20309ed9dc9",
                                "sense_id": "aea86e86-296b-37dd-ac12-a2055808c5ed",
                                "text": "Ehrmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
