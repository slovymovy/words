                "senses": [
                    {
                        "sense_id": "0c561edc-95a5-3948-a68c-fa0f6743c5a7",
                        "entry_id": "469ac013-8a94-3cd6-a209-00affff25c1e",
                        "glosses": [
                            "das öffentliche Zeigen von Macht und Stärke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e13d0af-401f-4b2b-88a5-9c1cb02841fe",
                                "sense_id": "0c561edc-95a5-3948-a68c-fa0f6743c5a7",
                                "text": "„Die Fahrt galt als Machtdemonstration im Inselstreit mit Japan — jetzt zieht Peking seinen Flugzeugträger aus dem Südchinesischen Meer ab.“"
                            },
                            {
                                "example_id": "0ececc46-a1da-4344-bf1d-72d4e45497c2",
                                "sense_id": "0c561edc-95a5-3948-a68c-fa0f6743c5a7",
                                "text": "„Solche Interventionen über große Entfernungen hinweg konnten natürlich nur sporadischer Art sein. Sie dienten allenfalls der Machtdemonstration und der Erringung von Kriegsbeute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
