                "senses": [
                    {
                        "sense_id": "7a3402d8-d3bb-38c2-a801-a9e186a503e8",
                        "entry_id": "88a68035-d66f-3a16-963e-270c6d560c47",
                        "glosses": [
                            "der Kopf eines Ochsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e5f9a3-82d4-4ef8-b7e3-4cad6ddaacc3",
                                "sense_id": "7a3402d8-d3bb-38c2-a801-a9e186a503e8",
                                "text": "„Thor steckte den Ochsenkopf an die Angel, warf sie von Bord und die Angel fuhr zu Grunde. […] Die Midgardschlange schnappte nach dem Ochsenkopf und die Angel haftete dem Wurm im Gaumen.“"
                            },
                            {
                                "example_id": "1a826618-ed24-4bc9-a29b-03fe0b4f249a",
                                "sense_id": "7a3402d8-d3bb-38c2-a801-a9e186a503e8",
                                "text": "„Sein Schild trug einen schwarzen Ochsenkopf, halb verwischt schon durch manchen Kampf und die prahlerische Devise: Cave, adsum (hüte dich, ich bin da)!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
