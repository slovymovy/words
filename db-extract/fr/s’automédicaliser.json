                ],
                "senses": [
                    {
                        "sense_id": "2be29168-66ce-3ed6-b90a-8b9b004a5b81",
                        "entry_id": "d1771d6b-40b8-31e4-bbd8-814436c3c5b3",
                        "glosses": [
                            "S’administrer des médicaments sans prescription médicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83baa30d-7799-4d3e-9ffe-88277e3f081c",
                                "sense_id": "2be29168-66ce-3ed6-b90a-8b9b004a5b81",
                                "text": "C’est pourquoi la plupart sont itinérants, ils diffusent leur pratique et leur savoir de cité en cité et les textes diététiques permettent de s’automédicaliser."
                            },
                            {
                                "example_id": "42ceeb6d-7743-4be1-83f0-fdbd84f8e390",
                                "sense_id": "2be29168-66ce-3ed6-b90a-8b9b004a5b81",
                                "text": "Ce type de produits pseudo-médicaux marche déjà très bien aux Etats-Unis, où les gens ont tendance à s’automédicaliser."
                            },
                            {
                                "example_id": "9fe0b35e-ffa3-4941-9726-c39b489fe944",
                                "sense_id": "2be29168-66ce-3ed6-b90a-8b9b004a5b81",
                                "text": "On a découvert que son avocate, que je rétribuais depuis des années, lui fournissait du Xanax pour s’automédicaliser."
                            }
                        ]
                    }
                ],
