                                "target_senses": [
                                    {
                                        "sense_id": "96319aa1-6986-30af-941d-241c1bf8e825",
                                        "entry_id": "99bbfee9-e003-3e5d-bff7-001e85deb7b0",
                                        "glosses": [
                                            "Variante de corbeau freux (oiseau)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9208d6-3909-4905-979e-9c22dc14af34",
                                                "sense_id": "96319aa1-6986-30af-941d-241c1bf8e825",
                                                "text": "J'ai vu plusieurs fois en été une volée de freux qui logeait et nichait depuis plus d'un siècle, à ce qu'on m'a assuré, dans des trous de rochers exposés au sud-ouest et où on ne pouvait atteindre à leurs nids que très difficilement et en se suspendant à des cordes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43dba548-eb53-433e-afa4-4369460c3f7c",
                        "source_entry_id": "000d19fd-95a4-37a5-8fa8-8040346b630c",
