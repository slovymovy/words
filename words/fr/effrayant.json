                {
                    "sense_id": "11032b5b-4e0d-3525-afad-c6b0ef458606",
                    "sense_definition": "Qui effraye ou impressionne par sa force, son intensité ou sa démesure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tempête a traversé la région avec une force tout simplement <w>effrayante</w>.",
                            "target_lang_translations": {
                                "en": "The storm swept across the region with sheer <w>terrifying</w> force.",
                                "ru": "Буря пронеслась по региону с поистине <w>ужасающей</w> силой.",
                                "de": "Der Sturm zog mit einer geradezu <w>erschreckenden</w> Wucht über die Region hinweg.",
                                "es": "La tormenta atravesó la región con una fuerza realmente <w>temible</w>.",
                                "zh": "暴风雨席卷了整个地区，力量简直<w>惊人</w>。"
                            }
                        },
                        {
                            "text": "Le véhicule roulait à une vitesse <w>effrayante</w> sur cette petite route de montagne.",
                            "target_lang_translations": {
                                "en": "The vehicle was driving at a <w>terrifying</w> speed along this narrow mountain road.",
                                "ru": "Машина ехала на <w>страшной</w> скорости по этой узкой горной дороге.",
                                "de": "Das Auto fuhr auf dieser schmalen Bergstraße mit <w>erschreckender</w> Geschwindigkeit.",
                                "es": "El vehículo circulaba a una velocidad <w>aterradora</w> por esta pequeña carretera de montaña.",
                                "zh": "车辆在这条狭窄的山路上以<w>惊人</w>的速度行驶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible"
                    ],
                    "common_phrases": [
                        "vitesse effrayante",
                        "force effrayante"
                    ],
                    "target_lang_definitions": {
                        "en": "Impressive or alarming because of its extreme force, intensity or speed.",
                        "ru": "Производящий сильное, порой тревожное впечатление своей силой, интенсивностью или скоростью.",
                        "de": "Durch besondere Kraft, Heftigkeit oder Geschwindigkeit beeindruckend und zugleich beunruhigend.",
                        "es": "Que impresiona o inquieta por una fuerza, intensidad o velocidad extremas.",
                        "zh": "因力量、强度或速度极大而令人震惊或不安的。"
                    },
