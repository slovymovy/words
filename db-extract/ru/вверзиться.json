                "senses": [
                    {
                        "sense_id": "7478de0b-d087-3dba-8ee1-762c6142bf25",
                        "entry_id": "941647d0-91b5-345d-ade9-90c06b905586",
                        "glosses": [
                            "разг. сниж. упасть во что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf47d5c4-c283-4d66-a2c1-d1fe91bf1e25",
                                "sense_id": "7478de0b-d087-3dba-8ee1-762c6142bf25",
                                "text": "То Солженицын, а то ― нечто противоположное, ― разберись. Только бы не вверзиться в дерьмо."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18adf07b-5a52-4ff2-916d-337c8537ac53",
                        "source_entry_id": "941647d0-91b5-345d-ade9-90c06b905586",
                        "source_sense_id": "7478de0b-d087-3dba-8ee1-762c6142bf25",
                        "target_lang_word": "πέφτω",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "πέφτω",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "28292a4d-4e93-3b4f-866f-4afd9459c0f9",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "μεταβάλλεται το υψόμετρο στο οποίο βρίσκομαι λόγω της βαρύτητας"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f0cd882-62bf-4fd5-a7ae-0aa09be49214",
                                                "sense_id": "28292a4d-4e93-3b4f-866f-4afd9459c0f9",
                                                "text": "αν το αφήσεις θα πέσει στο πάτωμα"
                                            },
                                            {
                                                "example_id": "cf27fafa-d4d2-44c6-afbc-9659f7f3fe33",
                                                "sense_id": "28292a4d-4e93-3b4f-866f-4afd9459c0f9",
                                                "text": "φόρα καμιά ζώνη γιατί έχεις αδυνατίσει και σου πέφτει το παντελόνι"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f237e92b-6d62-3f97-8a14-e851df42a4ea",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "μειώνεται η τιμή μου"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508c3f8a-cb1e-4efe-bbc7-87bbb1f34106",
                                                "sense_id": "f237e92b-6d62-3f97-8a14-e851df42a4ea",
                                                "text": "έπεσε η τιμή της βενζίνης για μια μέρα και μετά ανέβηκε πάλι"
                                            },
                                            {
                                                "example_id": "84128eb9-3af0-4d91-8802-a1d3ae3462a0",
                                                "sense_id": "f237e92b-6d62-3f97-8a14-e851df42a4ea",
                                                "text": "όλο το βράδυ φύσαγε και η θερμοκρασία (ή το θερμόμετρο) έπεσε κάτω από το μηδέν"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12653cfd-ff9b-3709-a4ee-3dfb5f134aef",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "ξαπλώνω"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93c5f0e1-3b96-45cd-88b5-abd9036b98a5",
                                                "sense_id": "12653cfd-ff9b-3709-a4ee-3dfb5f134aef",
                                                "text": "※ Δεν πρόφτασα να πέσω, κι ο ύπνος με κυρίεψε. (⌘ Μ. Καραγάτσης, Ο κίτρινος φάκελος)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b8a2ee-d670-3a76-bdd3-064bec045827",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "σκοτώνομαι (σε πόλεμο)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887a97ee-2e83-4432-96a6-83cb71b44728",
                                                "sense_id": "b6b8a2ee-d670-3a76-bdd3-064bec045827",
                                                "text": "Μα ήταν αποφασισμένοι να μην παραδοθούν, και να πέσουν πολεμώντας σαν παλικάρια. (Πηνελόπη Δέλτα, Για την πατρίδα)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7371ffcb-1714-30c4-887b-d8f08800128a",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "ορμώ σε κάποιον, χιμάω σε κάποιον, επιτίθεμαι σε κάποιον"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e1fbc6-a205-4186-b079-dffead487f32",
                                                "sense_id": "7371ffcb-1714-30c4-887b-d8f08800128a",
                                                "text": "μια κουβέντα είπα και πέσανε πάνω μου να με φάνε (μου επιτέθηκαν λεκτικά με σφοδρότητα)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1aa1e4c-3b2d-3abd-8459-57f0d918541f",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "ξεκολλάω, βγαίνω από τη θέση μου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e6d0949-7531-44f4-82bb-eff15dbc4e2f",
                                                "sense_id": "d1aa1e4c-3b2d-3abd-8459-57f0d918541f",
                                                "text": "είχανε αρχίσει να της πέφτουν τα μαλλιά εξαιτίας της χημειοθεραπείας"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39df60d9-ca6f-37d1-8ac8-9557509debbf",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "είμαι, βρίσκομαι (χρονικά ή τοπικά αντίστοιχα)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3135901a-d3b1-4b4d-af17-3de024da04ba",
                                                "sense_id": "39df60d9-ca6f-37d1-8ac8-9557509debbf",
                                                "text": "προς τα που πέφτει η Αλόννησος;"
                                            },
                                            {
                                                "example_id": "c31e7806-0c3a-49ce-a5aa-e134be72daae",
                                                "sense_id": "39df60d9-ca6f-37d1-8ac8-9557509debbf",
                                                "text": "φέτος το Πάσχα έπεσε νωρίς"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93138b4-5180-3c79-983c-6e172a9ba241",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "υποχωρώ, υποκύπτω"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6738905-8568-38fb-b88a-f6f125d87eac",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "σταματάω να λειτουργώ (λόγω βλάβης ή άλλου προβλήματος), διακόπτομαι"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea7c3fc-187f-4217-b555-9b198059d7d5",
                                                "sense_id": "e6738905-8568-38fb-b88a-f6f125d87eac",
                                                "text": "έπεσε το ρεύμα σε όλο το χωριό"
                                            },
                                            {
                                                "example_id": "48dd90a3-e31e-400a-ac1c-38ff89b3d12b",
                                                "sense_id": "e6738905-8568-38fb-b88a-f6f125d87eac",
                                                "text": "έπεσε η σύνδεσή μου (στο Διαδίκτυο) για τρίτη φορά απόψε"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0733ca-3396-314c-a76a-68f18b28d6cb",
                                        "entry_id": "cffc791e-aac5-3fcb-bfdf-35b7560fd053",
                                        "glosses": [
                                            "έχω κάποια ιδιότητα (μέγεθος, ηλικία, κοινωνική θέση κλπ) η οποία συγκρινόμενη με την αντίστοιχη ιδιότητα άλλου αποδεικνύεται ανεπαρκής ή υπερβολική"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289b4eb2-75fd-4ef0-aa10-b27a70754bdd",
                                                "sense_id": "5a0733ca-3396-314c-a76a-68f18b28d6cb",
                                                "text": "Αυτό το παντελόνι μού πέφτει λίγο μεγάλο."
                                            },
                                            {
                                                "example_id": "19af3aeb-de5f-415e-88e2-724e8abaaa69",
                                                "sense_id": "5a0733ca-3396-314c-a76a-68f18b28d6cb",
                                                "text": "Δεν της πέφτει μεγαλούτσικος ο αρραβωνιαστικός της;"
                                            },
                                            {
                                                "example_id": "fbdf3079-5fa2-48aa-8770-bcd8a8a279b9",
                                                "sense_id": "5a0733ca-3396-314c-a76a-68f18b28d6cb",
                                                "text": "Τι θα ήθελες να έχεις; Μερσεντές; Βολέψου με το Φιατάκι και πολύ σου πέφτει."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
