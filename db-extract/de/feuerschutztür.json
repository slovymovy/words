                "senses": [
                    {
                        "sense_id": "01f39f60-852d-3e73-a9c3-0c8856d591ae",
                        "entry_id": "2012e0ba-3007-33da-a3c6-ec0f0202bad5",
                        "glosses": [
                            "Feuerschutzabschluss: spezielle Tür, die selbsttätig schließt und im Brandfall das Passieren von Feuer verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f68ccb1b-c8eb-4939-8842-10d2909e3de4",
                                "sense_id": "01f39f60-852d-3e73-a9c3-0c8856d591ae",
                                "text": "„Feuerschutztüren sind nicht automatisch auch als Rauchschutztüren geeignet, geprüfte Feuerschutz-Drückergarnituren und Feuerschutzbänder sind aber auch für Rauchschutztüren geeignet.“"
                            },
                            {
                                "example_id": "b9808c89-eed0-4685-919f-855a9cc790c0",
                                "sense_id": "01f39f60-852d-3e73-a9c3-0c8856d591ae",
                                "text": "„Feuerschutztüren haben die Aufgabe, Wandöffnungen gegen das Durchdringen von Feuer zu sichern.“"
                            },
                            {
                                "example_id": "685b62bd-063d-43ff-a3d8-34cabbb9fcec",
                                "sense_id": "01f39f60-852d-3e73-a9c3-0c8856d591ae",
                                "text": "„Verwendbarkeitsnachweise von Feuerschutztüren (T 30 und T 90) werden über eine Allgemeine bauaufsichtliche Zulassung (AbZ) geführt.“"
                            },
                            {
                                "example_id": "63177c20-f4e9-46e7-a3da-fe0271de65f0",
                                "sense_id": "01f39f60-852d-3e73-a9c3-0c8856d591ae",
                                "text": "„Zur BAU 2015 präsentierte Hörmann neue Feuerschutztüren, die schon jetzt den Anforderungen der europäischen Produktnorm EN 16034 entsprechen. Mit deren Einführung wird der europaweite Verkauf der Feuerschutztüren möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
