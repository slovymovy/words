    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5843b9c2-434d-3aaf-a330-41cd40b66030",
                    "sense_definition": "Одновременно с каким-либо другим действием, попутно, пользуясь случаем.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "incidentally",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я иду в магазин и могу <w>заодно</w> купить хлеба.",
                            "target_lang_translations": {
                                "en": "I'm going to the store and can buy bread <w>while I'm at it</w>.",
                                "de": "Ich gehe in den Laden und kann <w>nebenbei</w> Brot kaufen."
                            }
                        },
                        {
                            "text": "Раз уж ты встал, закрой <w>заодно</w> и окно.",
                            "target_lang_translations": {
                                "en": "Since you're up, close the window <w>while you're at it</w>.",
                                "de": "Wenn du schon aufstehst, mach <w>bei der Gelegenheit</w> auch das Fenster zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "кстати"
                    ],
                    "common_phrases": [
                        "сделать заодно",
                        "купить заодно",
                        "захватить заодно"
                    ],
                    "target_lang_definitions": {
                        "en": "At the same time as another action, incidentally, taking the opportunity.",
                        "de": "Gleichzeitig mit einer anderen Handlung, nebenbei, bei der Gelegenheit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the same time",
                                "target_lang_sense_clarification": "simultaneously"
                            },
                            {
                                "target_lang_word": "while one is at it",
                                "target_lang_sense_clarification": "taking the opportunity"
                            },
                            {
                                "target_lang_word": "incidentally",
                                "target_lang_sense_clarification": "by the way"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "nebenbei",
                                "target_lang_sense_clarification": "bei einer anderen Gelegenheit"
                            },
                            {
                                "target_lang_word": "gleichzeitig",
                                "target_lang_sense_clarification": "im selben Moment"
                            },
                            {
                                "target_lang_word": "bei der Gelegenheit",
                                "target_lang_sense_clarification": "wenn man schon dabei ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0214f62-931a-3dd4-9f35-61153b8fc2a4",
                    "sense_definition": "Вместе, сообща, в полном согласии друг с другом.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "together",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы должны действовать <w>заодно</w>, чтобы добиться успеха.",
                            "target_lang_translations": {
                                "en": "We must act <w>in concert</w> to achieve success.",
                                "de": "Wir müssen <w>gemeinsam</w> handeln, um Erfolg zu haben."
                            }
                        },
                        {
                            "text": "В этом споре они были <w>заодно</w> с директором.",
                            "target_lang_translations": {
                                "en": "In this dispute, they were <w>at one</w> with the director.",
                                "de": "In diesem Streit waren sie <w>einer Meinung</w> mit dem Direktor."
                            }
                        }
                    ],
                    "synonyms": [
                        "вместе",
                        "сообща"
                    ],
                    "antonyms": [
                        "раздельно",
                        "порознь"
                    ],
                    "common_phrases": [
                        "быть заодно",
                        "действовать заодно"
                    ],
                    "target_lang_definitions": {
                        "en": "Together, jointly, in full agreement with each other.",
                        "de": "Gemeinsam, zusammen, in voller Übereinstimmung miteinander."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "together",
                                "target_lang_sense_clarification": "jointly"
                            },
                            {
                                "target_lang_word": "in concert",
                                "target_lang_sense_clarification": "acting jointly"
                            },
                            {
                                "target_lang_word": "at one",
                                "target_lang_sense_clarification": "in agreement"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gemeinsam",
