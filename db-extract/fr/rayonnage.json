                                    {
                                        "sense_id": "26b887db-4bfe-33ed-a7f3-5acb4bb347f0",
                                        "entry_id": "13761a4c-714e-389a-8532-9dbc6d889748",
                                        "glosses": [
                                            "een plank om iets op te zetten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fb444f3-9de1-42a1-836b-f8e1be4ffdae",
                                                "sense_id": "26b887db-4bfe-33ed-a7f3-5acb4bb347f0",
                                                "text": "Met mijn boodschappenlijst voor de komende maand in de aanslag stortte ik me op de schappen en na anderhalf uur duwde ik twee volle winkelwagens de supermarkt uit richting het postkantoor."
                                            },
                                            {
                                                "example_id": "ba23f863-c022-4bbc-81de-cf1a627da835",
                                                "sense_id": "26b887db-4bfe-33ed-a7f3-5acb4bb347f0",
                                                "text": "In veel winkels zijn ondertussen lege schappen te vinden. Vooral versproducten als zuivel, vlees, fruit en eieren zijn nog moeilijk te krijgen. Dat komt enerzijds doordat de blokkades het onmogelijk maken om de producten aan te vullen en anderzijds doordat de producten die nog beschikbaar zijn bederven en dus weggegooid moeten worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efe110ae-480d-44f1-8f33-c4f77fe265ab",
