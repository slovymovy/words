                "senses": [
                    {
                        "sense_id": "049795ec-51e8-352a-a997-64404ad22334",
                        "entry_id": "87cb0704-5d49-3d54-b09f-762c076a9ea6",
                        "glosses": [
                            "этногр. женск. к чилиец; жительница или уроженка Чили"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4192f135-97cd-4088-b06c-63d20624f8a8",
                                "sense_id": "049795ec-51e8-352a-a997-64404ad22334",
                                "text": "Узнав, что миссис Федерман ― чилийка, он решил ещё раз проявить догадливость, и обращаясь ко мне, я рядом с ней сидел, спросил ― «Вы, наверное, тоже из Чили, вы очень похожи на чилийца»."
                            }
                        ]
                    }
                ],
