{
    "word_family": [
        "naïf",
        "naïvement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0deeb38-ffc3-326a-b678-35053029a8c8",
                    "sense_definition": "Ingénuité et candeur d'une personne qui manifeste ses pensées ou émotions sans détour ni calcul.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "candeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant répondit à toutes les questions de l'adulte avec une grande <w>naïveté</w>."
                        },
                        {
                            "text": "Il a conservé une belle <w>naïveté</w> malgré les nombreuses épreuves de la vie."
                        }
                    ],
                    "synonyms": [
                        "candeur",
                        "ingénuité"
                    ],
                    "common_phrases": [
                        "avec naïveté",
                        "faire preuve de naïveté"
                    ]
                },
                {
                    "sense_id": "38158153-f7e2-30b9-b329-fdb5437ede13",
                    "sense_definition": "Crédulité excessive ou manque de discernement et de méfiance envers les autres.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "candeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les escrocs ont profité de sa <w>naïveté</w> pour lui soutirer toutes ses économies."
                        },
                        {
                            "text": "Croire que cette négociation serait facile relevait d'une coupable <w>naïveté</w>."
                        }
                    ],
                    "common_phrases": [
                        "payer sa naïveté",
                        "profiter de la naïveté"
                    ]
                },
                {
                    "sense_id": "7a15618a-6121-381e-a3b2-7ef0e9e1abfa",
                    "sense_definition": "Parole ou action candide qui révèle de l'ignorance ou un manque d'expérience.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "candeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune stagiaire a commis quelques <w>naïvetés</w> au cours de la réunion importante."
                        },
                        {
                            "text": "Tout le monde a souri avec indulgence en entendant cette touchante <w>naïveté</w>."
                        }
                    ],
                    "common_phrases": [
                        "dire des naïvetés"
                    ]
                },
                {
                    "sense_id": "46879ba0-740e-3570-a1f0-cd384b00af52",
                    "sense_definition": "Simplicité naturelle et sans artifice qui donne de la grâce et du charme à une œuvre ou un style.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le critique a salué la fraîcheur et la touchante <w>naïveté</w> de ce poème pastoral."
                        },
                        {
                            "text": "Ce tableau séduit immédiatement par la <w>naïveté</w> de ses couleurs et de ses formes."
                        }
                    ],
                    "common_phrases": [
                        "naïveté du style"
                    ]
                }
            ]
        }
    ]
}