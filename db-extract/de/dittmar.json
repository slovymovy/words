                ],
                "senses": [
                    {
                        "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                        "entry_id": "57da67ab-179b-368a-a61e-c29f6b1681c9",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40ef1265-d89f-4ad2-afaf-9bab059390b2",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Herr Dittmar wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5f1bbf80-3e69-4df9-ad36-0c88eefd8f2f",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Die Dittmars fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c875af6f-7119-4454-8f32-aaf53a8325c1",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Frau Dittmar ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1d9182f8-102d-4272-ace8-833d9614db9d",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Der Dittmar trägt nie die Schals, die die Dittmar ihm strickt."
                            },
                            {
                                "example_id": "4f32a043-bbfc-4d40-9f5f-b9f21ac5c950",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dittmar kommt, geht der Herr Dittmar.“"
                            },
                            {
                                "example_id": "7a99ed17-095b-46b8-8bd4-7426f50236e1",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Dittmar kommt und geht."
                            },
                            {
                                "example_id": "2dadabd0-9977-4d68-90a9-59c097748ad8",
                                "sense_id": "9e9136e5-43a9-3bab-958a-e8645332e63e",
                                "text": "Dittmars kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
