                        ],
                        "form": "по́цами"
                    },
                    {
                        "form_id": "98a7c4a3-3632-4b98-ab92-61e87266afce",
                        "entry_id": "26d33720-b404-3eda-830e-3b6318f927e9",
                        "tags": [
