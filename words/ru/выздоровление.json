                    "sense_definition": "Процесс восстановления здоровья после перенесенной болезни.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "здоровье",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Даже болеть приятно, когда знаешь, что есть люди, которые ждут твоего <w>выздоровления</w> как праздника.",
                            "target_lang_translations": {
                                "en": "It is even pleasant to be ill when you know there are people who await your <w>recovery</w> like a holiday."
                            }
                        },
                        {
                            "text": "Врач сказал, что для быстрого <w>выздоровления</w> пациенту нужен полный покой и правильное питание.",
                            "target_lang_translations": {
                                "en": "The doctor said that for a quick <w>recovery</w>, the patient needs complete rest and proper nutrition."
                            }
                        }
                    ],
                    "synonyms": [
                        "выздора́вливание",
                        "выздоровленье",
                        "поправка",
                        "излечение"
                    ],
                    "antonyms": [
                        "заболевание"
                    ],
                    "common_phrases": [
                        "полное выздоровление",
                        "процесс выздоровления"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of regaining health after an illness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "recovery",
                                "target_lang_sense_clarification": "A return to normal health."
                            },
                            {
                                "target_lang_word": "convalescence",
                                "target_lang_sense_clarification": "A gradual healing process after an illness or injury."
                            }
                        ]
                    }
                }
            ]
