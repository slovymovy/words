                "senses": [
                    {
                        "sense_id": "7efebd67-f0ea-388a-9c30-2f0942e84c9d",
                        "entry_id": "bdb7fcf8-3864-317a-8c3c-831c237627d9",
                        "glosses": [
                            "Frotter ou user avec une lime, ou comme avec une lime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f6f86f2-0e64-48c5-b3ee-7f760d999d00",
                                "sense_id": "7efebd67-f0ea-388a-9c30-2f0942e84c9d",
                                "text": "Le roi me tourna le dos d’un air bourru, en remontant ses chausses... et s’en alla sans doute limailler à son atelier de serrurerie."
                            },
                            {
                                "example_id": "56cac105-9668-4e8e-acd7-b815c2fd1946",
                                "sense_id": "7efebd67-f0ea-388a-9c30-2f0942e84c9d",
                                "text": "Depuis, l’Occident a largement creusé le gouffre : la science et les techniques ont partout proliféré pour limailler, éroder le monde ancien."
                            }
                        ]
                    }
