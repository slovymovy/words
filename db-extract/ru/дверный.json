                "senses": [
                    {
                        "sense_id": "74add5c3-4660-3168-bc3c-04ae7733e613",
                        "entry_id": "e8836e63-738f-3d29-a8ab-a7eeced23b50",
                        "glosses": [
                            "устар. то же, что дверной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac55fbd-e763-4dfb-aa63-8aa2b022c81c",
                                "sense_id": "74add5c3-4660-3168-bc3c-04ae7733e613",
                                "text": "Старинный дверный замок."
                            },
                            {
                                "example_id": "c2f70c58-486d-49f0-9e7d-ba3b9b21cd2b",
                                "sense_id": "74add5c3-4660-3168-bc3c-04ae7733e613",
                                "text": "Государь после покорения Дома Чень подарил Да-и царевне драгоценный дверный щит, принадлежавший Дому Чень."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0b74c0f-d024-3af3-804e-a9a05525ef57",
                        "entry_id": "e8836e63-738f-3d29-a8ab-a7eeced23b50",
                        "glosses": [
                            "является частью составных прилагательных 3-дверный, 5-дверный и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db7da37-4668-4bb5-9056-890e8e157de7",
                                "sense_id": "a0b74c0f-d024-3af3-804e-a9a05525ef57",
                                "text": "Первым в серийное производство пойдет 5-дверный хэтчбек."
                            }
                        ]
                    }
