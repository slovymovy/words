                ],
                "senses": [
                    {
                        "sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                        "entry_id": "1e3c437f-c633-3c42-b4a5-f7e8f1fcb744",
                        "glosses": [
                            "Propriété de quelque chose d’être en petit nombre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3836782-a229-4bff-9b15-6dda7ac15a56",
                                "sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                                "text": "[N]ous avions cent moyens de convaincre toute créature raisonnable que nous n’étions pas des pirates : notre cargaison, la route que nous tenions, la franchise avec laquelle nous nous montrions et nous étions entrés dans tel et tel port, la forme et la faiblesse de notre bâtiment, le nombre de nos hommes, la paucité de nos armes, la petite quantité de nos munitions, la rareté de nos vivres, n’était-ce pas là tout autant de témoignages irrécusables ?"
                            },
                            {
                                "example_id": "0fe525b6-b2c4-4e71-8ba9-e79cc18446d6",
                                "sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                                "text": "L’analyse rapide et limitée du système de santé tunisien, eu égard à la paucité des données statistiques, utilise le cadre conceptuel de l’OMS comme référence, elle identifie les points de force et les points de faiblesse et les principaux défis."
                            },
                            {
                                "example_id": "e3e92a4d-f321-4879-afde-c93b3d12d8aa",
                                "sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                                "text": "Cette association diffère essentiellement de l’association à Fragilaria crotonensis et Asterionella gracillima par l’abondance des Desmidiées et la paucité des diatomées […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32c304a8-216e-471d-8cf2-98e1a8881957",
                        "source_entry_id": "1e3c437f-c633-3c42-b4a5-f7e8f1fcb744",
                        "source_sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                        "target_lang_word": "Wenigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wenigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52a451e3-394d-363c-ba4c-c2d7e309cb1e",
                                        "entry_id": "7127dab5-5cd9-354d-9bdb-fbaabc4ce92d",
                                        "glosses": [
                                            "etwas sehr Wertloses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5541183d-506f-4436-8ad0-81dd0857dca0",
                                                "sense_id": "52a451e3-394d-363c-ba4c-c2d7e309cb1e",
                                                "text": "Möge er mit der Auskunft meiner Wenigkeit zufrieden sein."
                                            },
                                            {
                                                "example_id": "fbc8a9b7-15ac-4398-9872-6f0e2254f23e",
                                                "sense_id": "52a451e3-394d-363c-ba4c-c2d7e309cb1e",
                                                "text": "Es war nur ein Blick, eine Wenigkeit und sie war ihm verfallen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6173d3a-7e90-495c-8518-4183557c655b",
                        "source_entry_id": "1e3c437f-c633-3c42-b4a5-f7e8f1fcb744",
                        "source_sense_id": "6eba261f-66b7-356d-8283-b4b2caea8ed5",
                        "target_lang_word": "paucity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paucity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54fcd1e2-0d35-3a70-ba0c-0f28039a7d4a",
                                        "entry_id": "aa9b6359-a78c-3535-9162-9f96cb7e26e1",
                                        "glosses": [
                                            "Fewness in number; too few."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b9c33c7-8f14-408b-bfdc-6677def62054",
                                                "sense_id": "54fcd1e2-0d35-3a70-ba0c-0f28039a7d4a",
                                                "text": "But when I had crossed the threshold, I was astonished at the paucity of facts to be gleaned from the inmates themselves."
                                            },
                                            {
                                                "example_id": "64e7a97c-dca2-4c21-a5bc-ca1b8690126a",
                                                "sense_id": "54fcd1e2-0d35-3a70-ba0c-0f28039a7d4a",
                                                "text": "This paucity of trains helps to explain why electrification is not planned between Paris and Belfort."
                                            },
                                            {
                                                "example_id": "2221e5d1-7d28-4d18-ae9f-4e85eb675d32",
                                                "sense_id": "54fcd1e2-0d35-3a70-ba0c-0f28039a7d4a",
                                                "text": "Your tax refund might be late, owing to a paucity of number crunchers."
                                            },
                                            {
                                                "example_id": "382312fb-40f0-444b-9953-6f6a6b8b4431",
                                                "sense_id": "54fcd1e2-0d35-3a70-ba0c-0f28039a7d4a",
                                                "text": "I have always argued that despite my opposition to rail privatisation, I should be grateful that John Major won the 1992 election on a platform to sell off the railways, as otherwise my column would have disappeared given the paucity of things to write about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                        "entry_id": "aa9b6359-a78c-3535-9162-9f96cb7e26e1",
                                        "glosses": [
                                            "A smallness in size or amount that is insufficient; meagerness, dearth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc0b30a-50a6-49b2-8803-96169f92de8e",
                                                "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                                "text": "It cannot be denied it [the chameleon] is (if not the moſt of any) a very abſtemious animall, and ſuch as by reaſon of its frigidity, paucity of bloud, and latitancy in the winter (about which time the obſervations are often made) will long ſubſist without a viſible ſuſtentation."
                                            },
                                            {
                                                "example_id": "d5dfc12d-926d-4ac5-b08a-4be4f0591800",
                                                "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                                "text": "Now came shipwrecks and life in open boats, with the usual paucity of food."
                                            },
                                            {
                                                "example_id": "af5af18b-400f-4c83-8912-553a5ea1afa2",
                                                "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                                "text": "Here is where the paucity of our language is made manifest."
                                            },
                                            {
                                                "example_id": "fe1daedd-9b1e-4504-9dc3-d695a677e55d",
                                                "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                                "text": "Genteel America was handicapped by meagerness of soul, thinness of temper, paucity of talent."
                                            },
                                            {
                                                "example_id": "d7462def-6b32-4b02-a731-2e993cf3e279",
                                                "sense_id": "261a6b7f-518d-33f8-8d05-b0c6d23a2d8d",
                                                "text": "There are also texts that present more lengthy lists, of between ten and thirty examples, and in doing so include some less common terms. But, on the whole, there is at present a paucity of information about these terms."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
