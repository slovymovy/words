                        "entry_id": "488c1417-590d-3701-b59a-2eafea712112",
                        "glosses": [
                            "iemand die iets goed kan vertellen in een verhaal vorm; iemand die verhalen verzint en opschrijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fef9c15-4086-4e0c-9470-a334509ec755",
                                "sense_id": "0189502f-cf56-36f4-ad4f-b9e0a643ad22",
                                "text": "\"De werkelijkheid vond ze zelf vaak maar saai. Ze was een verhalenverteller pur sang, met een grote dosis ironie en zelfspot. Ik ben er trots op haar uitgever te zijn en ervaar haar overlijden als een groot verlies, zowel voor mij, voor de uitgeverij als voor de Nederlandse literatuur.\""
                            },
                            {
                                "example_id": "be334756-a380-436a-a016-a200c31acc45",
                                "sense_id": "0189502f-cf56-36f4-ad4f-b9e0a643ad22",
                                "text": "Erwin Kroll: weerman maar vooral verhalenverteller"
                            }
                        ]
                    }
