                                    {
                                        "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "halbrunde oder polygonale Altarnische in einem Tempel beziehungsweise einer Kirche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b00fa5-75a4-4f86-939f-ac1eb3d57977",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "Bei christlichen Kirchen zeigt die Apsis meist gen Osten."
                                            },
                                            {
                                                "example_id": "c99ca262-809e-4fa3-91e0-b46d631cc4f3",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "„Sie habe, so hieß es, die Apsis mit merkwürdigen Tönen erfüllt.“"
                                            },
                                            {
                                                "example_id": "3e8925b7-9ad6-4e87-932a-6e7093cd1526",
                                                "sense_id": "131a3c3c-b1e7-374b-b7f6-429eb53bae77",
                                                "text": "„Robert, der langsam in Richtung auf die Apsis durch die Leere des Längsraums geschritten war, sah sich unvermutet an der Stelle, wo ein breit ausladendes Querschiff die Raumanlage kreuzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e29be94-0da1-3116-bafd-2212576cd43a",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "in einem Zelt eine halbrunde Einbuchtung, Vertiefung in einer Wand, in der Gepäck verstaut werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de48ace4-4570-32f6-8911-1a6cde686725",
                                        "entry_id": "fe3e94ef-b741-3c04-b00e-590fd9c9f836",
                                        "glosses": [
                                            "Scheitelpunkt einer (elliptischen) Umlaufbahn eines Himmelskörpers"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2240830e-6bb3-4107-b73c-14505e6f3719",
                                                "sense_id": "de48ace4-4570-32f6-8911-1a6cde686725",
                                                "text": "Die Apsiden der Planetenbahnen nennt man Perihel und Aphel."
                                            }
