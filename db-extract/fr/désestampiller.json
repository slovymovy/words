                "senses": [
                    {
                        "sense_id": "90f5231c-174d-33a5-a1b0-031f3caa3fa5",
                        "entry_id": "cbea1da0-09a1-358b-8125-c3265b398a03",
                        "glosses": [
                            "Enlever l’estampille de."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4ae6410a-cdd8-4ee3-a903-6799d04baa84",
                                "sense_id": "90f5231c-174d-33a5-a1b0-031f3caa3fa5",
                                "text": "Nous avons au contraire déclaré à la Compagnie que nous n’admettrions aucun dégrèvement, mais elle est évidemment libre de faire désestampiller ses voitures."
                            },
                            {
                                "example_id": "9089f8c4-68a7-4305-b957-9cf39c176713",
                                "sense_id": "90f5231c-174d-33a5-a1b0-031f3caa3fa5",
                                "text": "Préserver le “secret” de notre existence n’est plus le but de notre vie, il s’agit au contraire de nous désestampiller, de nous défouler, d’exister !"
                            }
                        ]
                    }
