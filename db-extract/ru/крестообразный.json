                                    {
                                        "sense_id": "21ae16ea-9797-3cb2-8a23-7319801dbbaf",
                                        "entry_id": "98aa9a79-439b-3cdf-89b1-5257136759f5",
                                        "glosses": [
                                            "Any emblem in the shape of a cross."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfce4c6d-801c-4d7b-806f-463608c5b8b7",
                                                "sense_id": "21ae16ea-9797-3cb2-8a23-7319801dbbaf",
                                                "text": "Michael Eaton has discovered that if you visit its websites you will be warned: \"Royal Mail, the Royal Mail Cruciform and the colour red are registered trademarks of Royal Mail Group plc.\""
