                        "sense_id": "09997de5-9665-306f-be5d-ae1c9004f840",
                        "entry_id": "4443c569-8bc3-332b-bddd-16279ed06ec4",
                        "glosses": [
                            "Hydroxyde naturel de manganèse (Mn(OH)₂), à cristallisation hexagonale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f3bc199-3448-4e82-a90e-35cf1c164305",
                                "sense_id": "09997de5-9665-306f-be5d-ae1c9004f840",
                                "text": "La feitkneichite est un oxyde de manganèse formant de minces croûtes cristallines brun chocolat sur le minerai à pyrochroïte du Gonzen."
                            },
                            {
                                "example_id": "6c9a6b1e-cc5b-42ae-8562-116a9c28de46",
                                "sense_id": "09997de5-9665-306f-be5d-ae1c9004f840",
                                "text": "La birnessite, dont la structure est proche de celle de la pyrochroïte Mn(OH)₂, est alors obtenue."
                            },
                            {
                                "example_id": "f2b7320a-1f30-40c3-a0ca-772a7413d3f5",
                                "sense_id": "09997de5-9665-306f-be5d-ae1c9004f840",
                                "text": "La parenté morphologique entre les deux phases, pyrochroïte et birnessite, est évidente, ce qui laisse penser que l'oxydation procède effectivement in situ à l'état solide avec diffusion des ions K+ dans l'espace interfoliaire."
                            }
                        ]
                    }
                ],
