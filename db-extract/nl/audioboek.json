                        "source_sense_id": "82ae0c7c-caa2-31cf-855f-645bfc07eb2c",
                        "target_lang_word": "Hörbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
