                        "sense_id": "7b7b3212-d3cb-35b0-aead-c166721f2fe7",
                        "entry_id": "aa5a4efe-dc07-31eb-bac8-21f73f4e96fa",
                        "glosses": [
                            "een speciale schoen die je kunt vastklikken aan een ski"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "2020ede5-0f08-4e37-be36-4250ad6d0e3d",
                                "sense_id": "7b7b3212-d3cb-35b0-aead-c166721f2fe7",
                                "text": "“Mijn zusje heeft twee kinderen en ik zie van dichtbij hoe leuk dat is. Mijn nichtje heeft nu van die heel kleine skischoentjes... superschattig. Maar ik besef ook hoe groot de verantwoordelijkheid en de zorg is als je moeder wordt. Zo’n keuze moet je heel bewust maken."
                            }
                        ]
                    },
                    {
                        "sense_id": "4630f669-69d7-33b8-8def-bf25bb98fe5f",
                        "entry_id": "aa5a4efe-dc07-31eb-bac8-21f73f4e96fa",
                        "glosses": [
                            "schoen die geschikt is om mee door de sneeuw te lopen"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "35414bbf-35eb-432a-adf0-86a1be979424",
                                "sense_id": "4630f669-69d7-33b8-8def-bf25bb98fe5f",
                                "text": "Ze waren gekleed voor een uitstapje in tot de knieën reikende skibroeken, geitenwollen sokken, goed ingevette skischoenen en prachtige Noorse truien met een nawinternachtpatroon op de schouders."
                            }
                        ]
                    }
