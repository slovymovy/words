                        "sense_id": "ff396460-08ea-36ee-9595-ad2a19cfb860",
                        "entry_id": "1b56df54-25c5-3930-964a-af649b1c591d",
                        "glosses": [
                            "Fähigkeit, durchschloffen zu werden"
