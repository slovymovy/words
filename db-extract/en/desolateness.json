                "translations": [
                    {
                        "translation_id": "59bdd736-aa1f-4756-8cb9-57e7fd7eefcf",
                        "source_entry_id": "90d07944-60ac-3454-8395-2b9aa541e1cb",
                        "source_sense_id": "60c8f2c9-29bb-3364-92d1-27116f0818d7",
                        "source_sense_description": "Einöde, Ödnis",
                        "target_lang_word": "Einöde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einöde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f54c6a09-e142-387d-be02-26f7c5810712",
                                        "entry_id": "f1f33a7d-fcc3-3087-a202-d63b8b316a80",
                                        "glosses": [
                                            "einsame Gegend, abgelegener Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2952a43-9e5c-4670-aeea-57740b4e875f",
                                                "sense_id": "f54c6a09-e142-387d-be02-26f7c5810712",
                                                "text": "Er lebt hier in der Einöde."
                                            },
                                            {
                                                "example_id": "6104761a-ae83-4639-b5c6-9b63dd44f0b1",
                                                "sense_id": "f54c6a09-e142-387d-be02-26f7c5810712",
                                                "text": "„Unser Zug fährt jetzt irgendwo durch die ländliche Einöde.“"
                                            },
                                            {
                                                "example_id": "731e2934-c2b3-4b2c-8573-f4cdde56806f",
                                                "sense_id": "f54c6a09-e142-387d-be02-26f7c5810712",
                                                "text": "„Dies alles schoss mir durch den Kopf, als ich drei Wochen später in der Hunsrücker Einöde zusammen mit zehn Hausfrauen vor meiner Töpferscheibe saß.“"
                                            },
                                            {
                                                "example_id": "2d778a2b-74c2-47ce-898a-dc59a6760b5b",
                                                "sense_id": "f54c6a09-e142-387d-be02-26f7c5810712",
                                                "text": "„Er meinte leibhaft durch eine Einöde zu gehen, wo es weder Ziel noch Antwort gab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7a6779b-1858-31c5-a489-d56d3b4178e9",
                                        "entry_id": "f1f33a7d-fcc3-3087-a202-d63b8b316a80",
                                        "glosses": [
                                            "kleine Siedlung (kleiner als ein Dorf)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb18e8b5-f3a7-42f4-ad8b-b795882dcad6",
                                                "sense_id": "e7a6779b-1858-31c5-a489-d56d3b4178e9",
                                                "text": "„In aller Regel besitzen Weiler und Einöden wegen ihrer geringen Größe keine Straßennamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7649c465-0638-40f2-88c6-7f5066f39ac5",
                        "source_entry_id": "90d07944-60ac-3454-8395-2b9aa541e1cb",
                        "source_sense_id": "60c8f2c9-29bb-3364-92d1-27116f0818d7",
                        "source_sense_description": "Einöde, Ödnis",
                        "target_lang_word": "Ödnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ödnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                                        "entry_id": "4c7e19f5-c8d8-37a5-9b15-6e34f9dce3ca",
                                        "glosses": [
                                            "wenig belebte, unkultivierte Gegend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ec3642-b310-4b7a-9e77-2de143e6623f",
                                                "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                                                "text": "„Manchmal ist es auf diesem Teil der Strecke verlockend, in die Ödnis links oder rechts der Route 1 zu fahren, mit dem normalen Mietwagen.“"
                                            },
                                            {
                                                "example_id": "656922ae-e4c0-4212-9047-4ec39991326d",
                                                "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                                                "text": "„Eine flotte Geheimpolizistin (Karoline Herfurth) verschafft Beat eine Ahnung davon, dass es auch ein Leben außerhalb dieser gottlosen Ödnis gibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c0df0f-0253-424c-90d4-6b3b10aa2393",
                        "source_entry_id": "90d07944-60ac-3454-8395-2b9aa541e1cb",
                        "source_sense_id": "c92048b9-1e76-3d82-bb4d-2b99002876c4",
                        "source_sense_description": "Trostlosigkeit",
                        "target_lang_word": "Trostlosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trostlosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                        "entry_id": "2db0cc1c-0f0d-32eb-9235-39e8a6cc63a4",
                                        "glosses": [
                                            "Zustand/Eigenschaft, trostlos zu sein; schlechte, bedrückende Stimmung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d9713d2-a702-4e35-a8cd-703d3ad6a736",
                                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                                "text": "„Sie spürte eine erdrückende Trostlosigkeit und sah nervös ihre Schwester an, die ihre Reaktion beobachtete.“"
                                            },
                                            {
                                                "example_id": "9c959019-5057-4631-83eb-c409642a5f7d",
                                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                                "text": "„Der Wind würde dunkle, aus Scheinwahrheiten bestehende Wolken über den Himmel treiben, und angesichts der Trostlosigkeit großer Bereiche unserer eigenen Seele würde sich in uns wahrscheinlich eine tiefe Traurigkeit ausbreiten.“"
                                            },
                                            {
                                                "example_id": "a85857a3-2f96-4ab5-a9e3-8bf7084722b9",
                                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                                "text": "„Und wieder begann eine Nacht, die zweite, furchtbare Nacht, eine Mondnacht mit vielen kalten Sternen, mit der Trostlosigkeit eines klar gewölbten, unendlich stillen Firmamentes, von dem schwere Einsamkeit herniedersank.“"
                                            },
                                            {
                                                "example_id": "42c03f04-7a05-4bad-8321-678ea78f81a4",
                                                "sense_id": "2d0ded71-033b-3d91-9ad7-d1c2636d22a1",
                                                "text": "„Meine Trostlosigkeit wird noch dadurch verstärkt, dass ich ständig spüre, wie sehr Sie mir fehlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                                        "entry_id": "2db0cc1c-0f0d-32eb-9235-39e8a6cc63a4",
                                        "glosses": [
                                            "etwas, das trostlos ist oder wirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75131ad-e674-4208-ab77-4b4ea0389b11",
                                                "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                                                "text": "„Christine ließ Langeweile nicht zu, auch Trostlosigkeiten nicht, denn wenn etwas traurig und freudlos war, dann klagte sie den Missstand an.“"
                                            },
                                            {
                                                "example_id": "85bebb0d-ae74-45c3-96ef-ef7b96047141",
                                                "sense_id": "2c3d40ca-31d3-3f5b-9112-9c8bef62dcb7",
                                                "text": "„Viele Menschen unter uns warten auf den Trost der Frohen Botschaft in einem umfassenden Sinn; nicht auf ‚Vertröstung‘, sondern auf Hilfe im Ringen mit den vielen ‚Trostlosigkeiten‘ dieser Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
