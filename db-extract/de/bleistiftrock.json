                        "sense_id": "c0da3550-57a7-35b0-8c34-803de91e020a",
                        "entry_id": "15a813dd-6635-32ea-9ad4-6029d33a735f",
                        "glosses": [
                            "eng anliegender Damenrock mit geradem, schmalem Schnitt, dessen Saum gewöhnlich auf Höhe des Knies oder knapp darunter liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dc4c6be-33ee-41c6-b66a-5e52c150487e",
                                "sense_id": "c0da3550-57a7-35b0-8c34-803de91e020a",
                                "text": "„[…] Neben ihrem Schreibtisch steht ein Strauß mit blassrosa Pfingstrosen. Eine Dame im Bleistiftrock bringt ein Schälchen Obstsalat, akkurat gestapelt.“"
                            },
                            {
                                "example_id": "2b8785db-9d10-4c8e-924f-83f3af5efb76",
                                "sense_id": "c0da3550-57a7-35b0-8c34-803de91e020a",
                                "text": "„Eine vielleicht sechzigjährige Frau mit einem strengen grauen Dutt, in einem schwarzen Blazer und Bleistiftrock blinzelte uns durch die riesigen Gläser ihrer roten Cat-Eye-Brille entgegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
