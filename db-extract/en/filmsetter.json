                        "glosses": [
                            "A filmsetting machine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d148f854-b579-4a7b-9a17-e4c0c6520b0b",
                                "sense_id": "2cc00764-05ca-3680-a191-2fb0f334660b",
                                "text": "This provided an input speed that exceeded the capability of unscanned image filmsetters. Unscanned filmsetter devices use a moving matrix grid or a stationary character grid with electromechanical control of character selection for photographic recording."
                            },
                            {
                                "example_id": "4d82a074-553b-4e77-b80e-4be27ce67f1a",
                                "sense_id": "2cc00764-05ca-3680-a191-2fb0f334660b",
                                "text": "The first thing to remember about a filmsetter is that it is a camera and that its function is to present language in all its beauty, variety and intricacy."
                            },
                            {
                                "example_id": "b6dfaf64-9e02-4714-ac44-00e9484e19b4",
                                "sense_id": "2cc00764-05ca-3680-a191-2fb0f334660b",
                                "text": "With an accurate lay-out the bulk of the make-up can be done on the filmsetter."
                            }
                        ]
                    }
