                        ],
                        "examples": [
                            {
                                "example_id": "514b066c-7c09-41af-9e0e-1e93102dcdca",
                                "sense_id": "b7e730b5-8c05-38d0-a971-7cb02e12166e",
                                "text": "Le chirimoya, l'orgueil du Pérou, dont M. Markham compare le goût à de la quintessence de fraise, possède cet heureux mélange de douceur et d'acidité si agréable dans les pays tropicaux."
                            }
                        ]
