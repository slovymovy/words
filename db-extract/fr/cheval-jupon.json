                                    {
                                        "sense_id": "01149f0a-1fe0-3fc8-9fce-8b477de8009d",
                                        "entry_id": "5d9de4de-7001-3125-8a22-274ee8972590",
                                        "glosses": [
                                            "A topic about which someone loves to talk at great length."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1449566c-b2ba-4021-91bd-853a3b2e6c76",
                                                "sense_id": "01149f0a-1fe0-3fc8-9fce-8b477de8009d",
                                                "text": "Don't ask him about global warming: it's his favourite hobby horse, you'll never get away."
                                            },
                                            {
                                                "example_id": "03c1985b-ffeb-4dea-905c-30ae8a6d7364",
                                                "sense_id": "01149f0a-1fe0-3fc8-9fce-8b477de8009d",
                                                "text": "The squire was now on his hobby-horse, as we say; he had placed the old worn fur cap by his side on the sofa, leaving his bald head and grey hairs exposed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeb0aa86-8d48-3219-894a-df27611c68fe",
                                        "entry_id": "5d9de4de-7001-3125-8a22-274ee8972590",
                                        "glosses": [
                                            "A puppet-like costume used in some traditional dances and festivals that gives its wearer the appearance of a man on horseback."
                                        ],
