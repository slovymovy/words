    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b660a7bc-dbc0-32ca-92f3-cb2eb33c0d2f",
                    "sense_definition": "Het bij elkaar brengen of verzamelen van een grote hoeveelheid zaken op één plek.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opeenhoping_proces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De snelle <w>opeenhoping</w> van vuilnis veroorzaakte overlast in de straat. Default.",
                            "target_lang_translations": {
                                "en": "The rapid <w>accumulation</w> of trash caused a nuisance in the street."
                            }
                        },
                        {
                            "text": "Er ontstond een grote <w>opeenhoping</w> van mensen bij de ingang van het stadion.",
                            "target_lang_translations": {
                                "en": "A large <w>crowd</w> gathered at the entrance of the stadium."
                            }
                        }
                    ],
                    "synonyms": [
                        "ophoping",
                        "verzameling",
                        "opeenhoping"
                    ],
                    "common_phrases": [
                        "snelle opeenhoping",
                        "opeenhoping van mensen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act or process of bringing together or gathering a large amount of things in one place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accumulation",
                                "target_lang_sense_clarification": "process or act of gathering together"
                            },
                            {
                                "target_lang_word": "congestion",
                                "target_lang_sense_clarification": "crowding or buildup of people/vehicles"
                            },
                            {
                                "target_lang_word": "buildup",
                                "target_lang_sense_clarification": "gradual gathering or increase"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8290403e-67b4-3e28-b404-7b7e783035fb",
                    "sense_definition": "Een grote verzamelde stapel of massa van voorwerpen of stoffen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opeenhoping_massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er lag een enorme <w>opeenhoping</w> van bladeren in de hoek van de tuin.",
                            "target_lang_translations": {
                                "en": "There was a huge <w>pile</w> of leaves in the corner of the garden."
                            }
                        },
                        {
                            "text": "De <w>opeenhoping</w> van sneeuw blokkeerde de hele weg.",
                            "target_lang_translations": {
                                "en": "The <w>accumulation</w> of snow blocked the entire road."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoop",
                        "stapel",
                        "massa"
                    ],
                    "common_phrases": [
                        "enorme opeenhoping",
                        "opeenhoping van sneeuw"
                    ],
                    "target_lang_definitions": {
                        "en": "A large collected pile, mass, or heap of objects or substances."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "accumulation",
                                "target_lang_sense_clarification": "a mass of something piled up or collected"
                            },
                            {
                                "target_lang_word": "pile",
                                "target_lang_sense_clarification": "a large amount of objects stacked together"
                            },
                            {
                                "target_lang_word": "mass",
                                "target_lang_sense_clarification": "a large, dense quantity of material"
                            }
                        ]
                    }
                }
            ]
        }
    ]
