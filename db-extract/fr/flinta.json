            {
                "entry_id": "e64d1f4a-55d6-3312-a498-5b3236a2bceb",
                "word": "FLINTA",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e3b2cfe8-f4fe-3279-93cf-51f47debb8e8",
                        "entry_id": "e64d1f4a-55d6-3312-a498-5b3236a2bceb",
                        "glosses": [
                            "Sigle de femmes, lesbiennes, intersexes, non binaires, trans et agenres, utilisé pour désigner soit les personnes qui ne sont pas des hommes cis soit celles qui ont été assignées femme à la naissance."
                        ],
                        "tags": [
                            "Transitude",
                            "LGBTQ",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "6db8501f-805c-4428-9436-9041cd419eea",
                                "sense_id": "e3b2cfe8-f4fe-3279-93cf-51f47debb8e8",
                                "text": "Avec les préjugés que les personnes FLINTA véhiculent, nous prendrions le risque de nous faire dénoncer immédiatement à #MeToo."
                            },
                            {
                                "example_id": "99cd3c85-4935-44f5-bd33-da2a7397b791",
                                "sense_id": "e3b2cfe8-f4fe-3279-93cf-51f47debb8e8",
                                "text": "Fri-Son organise ce jeudi le premier salon FLINTA, une soirée dédiée à un public composé de femmes, lesbiennes, intersexes, non-binaires, transgenres et agenres. L’événement vise à inclure les minorités de genre dans un environnement bienveillant et sécurisé."
                            }
                        ]
                    }
                ],
