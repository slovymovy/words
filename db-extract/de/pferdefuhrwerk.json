                "senses": [
                    {
                        "sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                        "entry_id": "33e5f16d-70f0-3d82-a579-33ef5012aa11",
                        "glosses": [
                            "von Pferden gezogener Wagen, Karren, Kutsche, Droschke oder Schlitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a18fbe3-f9a7-4039-be94-0f9c63bfd247",
                                "sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                                "text": "Noch zu Beginn des letzten Jahrhunderts kam es regelmäßig in Städten zu Zusammenstößen von Pferdefuhrwerken und Automobilen."
                            },
                            {
                                "example_id": "a0a4f941-2da8-42b4-ab8c-94825baeea07",
                                "sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                                "text": "„Damals konntest du froh sein, wenn dich ein Pferdefuhrwerk mitnahm, das Briketts oder Kunstdünger vom Kleinbahnhof holte oder Kartoffeln hinbrachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2af482bc-a1cd-4445-8e77-7fd16ff496ea",
                        "source_entry_id": "33e5f16d-70f0-3d82-a579-33ef5012aa11",
                        "source_sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                        "source_sense_description": "von Pferden gezogener Wagen, Karren, Kutsche, Droschke oder Schlitten",
                        "target_lang_word": "horse-drawn vehicle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1e789105-88f3-4a63-8584-3fe2423c3581",
                        "source_entry_id": "33e5f16d-70f0-3d82-a579-33ef5012aa11",
                        "source_sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                        "source_sense_description": "von Pferden gezogener Wagen, Karren, Kutsche, Droschke oder Schlitten",
                        "target_lang_word": "horse and cart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horse and cart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eba20b6-9c80-38ea-b71b-355bc95cd75d",
                                        "entry_id": "8a89eb31-1a86-3279-a2fa-e0645bab08b8",
                                        "glosses": [
                                            "A cart, pulled by a horse and driven by a driver, used for transporting goods."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5cd8895-7314-4708-84c7-928f790b25d3",
                                                "sense_id": "5eba20b6-9c80-38ea-b71b-355bc95cd75d",
                                                "text": "But the village's growth was curbed by the cliffs that restricted onward exploration for visitors, while goods such as coal and lime, which had arrived by water, were being transported up the severe incline to the town of Lynton by horse and cart."
                                            },
                                            {
                                                "example_id": "e0527671-fe2f-49db-ba36-90b98f05d741",
                                                "sense_id": "5eba20b6-9c80-38ea-b71b-355bc95cd75d",
                                                "text": "In these years, all long-distance freight went by rail, with local cartage by the railway's horses and carts."
                                            },
                                            {
                                                "example_id": "f3329934-1c72-404d-8841-53cd9ba0ff31",
                                                "sense_id": "5eba20b6-9c80-38ea-b71b-355bc95cd75d",
                                                "text": "\"Our railways were developed to their fullest extent at a time when the horse and cart was the only means of feeding to and distributing from them. ... In order to provide for a large measure of rail participation in countrywide collection and delivery of small consignments—a task they were never particularly well suited to do, and which they did only because the horse and cart were worse—the railways sacrificed their main advantages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5870d9d0-0cca-4a4b-9a68-c7ece17c9d7e",
                        "source_entry_id": "33e5f16d-70f0-3d82-a579-33ef5012aa11",
                        "source_sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                        "source_sense_description": "von Pferden gezogener Wagen, Karren, Kutsche, Droschke oder Schlitten",
                        "target_lang_word": "voiture à chevaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d1c6066f-17bd-4a79-9a33-715ff87cf791",
                        "source_entry_id": "33e5f16d-70f0-3d82-a579-33ef5012aa11",
                        "source_sense_id": "8a7be4c0-6c46-3736-8dd0-daa866c8a1e6",
                        "source_sense_description": "von Pferden gezogener Wagen, Karren, Kutsche, Droschke oder Schlitten",
                        "target_lang_word": "calèche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calèche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                        "entry_id": "f4af6494-195d-3cd3-989f-3bcb3428a651",
                                        "glosses": [
                                            "Type de voiture hippomobile de promenade, à ressorts et à quatre roues, à quatre places en vis-à-vis, qui est ordinairement découverte et possède une capote repliable protégeant les places arrière."
                                        ],
                                        "tags": [],
                                        "note": "Le mot tend aujourd’hui à désigner indistinctement toute sorte de voiture hippomobile",
                                        "examples": [
                                            {
                                                "example_id": "6115a7d1-0892-40b9-b26f-4f8f20e8d7ca",
                                                "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                                "text": "Je te suppose riche, mon cher Guillaume. Tu montes dans ta calèche de voyage; ton valet de chambre occupe le siége; on attelle deux chevaux de poste."
                                            },
                                            {
                                                "example_id": "be6c741f-7d80-45e2-8f1d-4a4ffb1164f9",
                                                "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                                "text": "À ma prière, mon père m’a donné le plus joli attelage qu’il soit possible de voir à Paris : deux chevaux gris-pommelé et une calèche de la dernière élégance."
                                            },
                                            {
                                                "example_id": "a8f17d38-f8ad-4716-a940-5dd7e24154fd",
                                                "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                                "text": "Il doit être là-bas, près des écuries où l’on attelle les chevaux à la calèche."
                                            },
                                            {
                                                "example_id": "d558495e-4d02-467a-904d-ebbef138bb3f",
                                                "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                                "text": "La calèche choisie par le poète et louée pour un mois, était assez jolie, elle pouvait servir à quelques promenades."
                                            },
                                            {
                                                "example_id": "589b06e7-7c67-4fbe-af24-d731ccde6c17",
                                                "sense_id": "04f5243c-e01d-33f7-8853-5c27ebca8d1f",
                                                "text": "De tous les pays circonvoisins, des campagnes et des villes, malades et infirmes, paralytiques, culs-de-jatte et pieds-bots accouraient dans des carrioles, dans des calèches, sur des ânes, sur leurs moignons calleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "374fdffd-1b70-3ed3-85d4-bb5515e9bcd4",
                                        "entry_id": "f4af6494-195d-3cd3-989f-3bcb3428a651",
                                        "glosses": [
                                            "Ancienne coiffure de femme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a36ba708-9fa6-4645-87c8-f13cfad02207",
                                                "sense_id": "374fdffd-1b70-3ed3-85d4-bb5515e9bcd4",
                                                "text": "Ce qui s’appelait l’été dernier une calèche (chapeau de femme), cet hiver une capote, a repris le nom de calèche depuis que nos dames se promènent en voiture découverte ; une calèche a de la blonde ou du tulle au bord, comme l’année dernière, mais en plus grande quantité. Quelles fleurs ? me direz-vous. Des lilas, vous répondrai-je, des jacinthes, des roses, des bluets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
