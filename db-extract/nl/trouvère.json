                        "entry_id": "72373f86-d5ed-3c6f-91aa-5edbdda21bc6",
                        "glosses": [
                            "in het middeleeuws Noord-Frankrijk rondreizend dichter, en zanger van (minne-) liederen"
                        ],
                        "tags": [
                            "Middle-Ages",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f1922cd6-cc45-4aef-b1c5-62dc18502181",
                                "sense_id": "c2896d30-e5ab-356f-afee-db86b17732b9",
                                "text": "Jean Bodel (1165-1210), een trouvère die leefde in Arras, schreef het heldendicht \"Chanson des Saisnes\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7d96ec0-90ff-46a1-bc47-5f26ff72063d",
                        "source_entry_id": "72373f86-d5ed-3c6f-91aa-5edbdda21bc6",
                        "source_sense_id": "c2896d30-e5ab-356f-afee-db86b17732b9",
