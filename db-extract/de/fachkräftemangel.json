                    {
                        "sense_id": "7a9885dd-e0b2-31dc-b3b9-fc379ed97b6a",
                        "entry_id": "e8903ab0-e3a9-31d1-9ff3-1c5a01cc887a",
                        "glosses": [
                            "skills shortage"
