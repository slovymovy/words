                "senses": [
                    {
                        "sense_id": "9100468b-29dd-370e-95c1-5e38b7f40083",
                        "entry_id": "39ca7a03-4c66-3516-9e21-919eda50120f",
                        "glosses": [
                            "Qui a rapport à la pathogénie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e45c14a-28d2-4263-9eb8-e5cc4f8b6521",
                                "sense_id": "9100468b-29dd-370e-95c1-5e38b7f40083",
                                "text": "Quoi qu’il en soit, que le corset produise directement l’abaissement du foie ou augmente simplement cet abaissement, consécutif à l’entéroptose générale, l’influence pathogénique du corset ne saurait être contestée. Les lésions que l’on trouve à l’autopsie de femmes ayant porté des corsets très serrés en sont la preuve absolue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0657760c-6894-4569-af69-8e9511594073",
                        "source_entry_id": "39ca7a03-4c66-3516-9e21-919eda50120f",
                        "source_sense_id": "9100468b-29dd-370e-95c1-5e38b7f40083",
                        "target_lang_word": "pathogenetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pathogenetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f2eb4ae-54af-3eb8-adf2-e9d1bac11a82",
                                        "entry_id": "57af6251-f21d-361a-86ff-be3054a20f13",
                                        "glosses": [
                                            "auf die Entstehung und den Verlauf einer Krankheit (Pathogenese) bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff644a9-6b3c-4cd5-9b24-b9b12bbeb0ee",
                                                "sense_id": "9f2eb4ae-54af-3eb8-adf2-e9d1bac11a82",
                                                "text": "„Ob endokrine Dysfunktionen, psychische Faktoren und Infektion mit dem hefeartigen Pilz Pityrosporum ovale pathogenetisch bedeutsam sind, ist ungeklärt.“"
                                            },
                                            {
                                                "example_id": "ee0336e3-2425-447b-9fac-8bab878db3ee",
                                                "sense_id": "9f2eb4ae-54af-3eb8-adf2-e9d1bac11a82",
                                                "text": "„Als pathogenetisches Zwischenglied sind Schleimhautschädigungen und Infekte des Magen-Darm-Trakts zu erwähnen.“"
                                            },
                                            {
                                                "example_id": "81d78349-99b2-4ed3-bf05-ee12d84bb68a",
                                                "sense_id": "9f2eb4ae-54af-3eb8-adf2-e9d1bac11a82",
                                                "text": "„Das Sternchen bezeichnet Symptome, die pathogenetisch (also in der Prüfung aufgetreten) sind und klinisch bestätigt wurden, während der Ring für Symptome vorgesehen ist, die ausschließlich klinischen Ursprunges sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
