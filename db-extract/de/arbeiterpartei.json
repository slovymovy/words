                ],
                "senses": [
                    {
                        "sense_id": "8cfd26da-36bb-3f4b-b385-10382d80d95b",
                        "entry_id": "02965a84-76fa-3139-80e7-3b34470c23af",
                        "glosses": [
                            "Partei, deren Mitglieder Erwerbstätige sind und die deren Interessen vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045d5008-5659-4cd7-8086-6cec92c4330d",
                                "sense_id": "8cfd26da-36bb-3f4b-b385-10382d80d95b",
                                "text": "„In der 2. Hälfte des 19. Jahrhunderts kam es zur Bildung von Arbeiterparteien, nachdem eine Trennung von den fortschrittlichen bürgerlichen Parteien stattgefunden hatte.“"
                            },
                            {
                                "example_id": "b5ed917e-b91a-4f25-9e6a-f085d304f6a4",
                                "sense_id": "8cfd26da-36bb-3f4b-b385-10382d80d95b",
                                "text": "„Nach der bolschewistischen Revolution 1917 in Russland spaltete sich die gesamte politische Arbeiterbewegung in sozialistische und kommunistische Arbeiterparteien.“"
                            },
                            {
                                "example_id": "53bd3c72-2a4f-47b5-ab89-d0af7dbcc820",
                                "sense_id": "8cfd26da-36bb-3f4b-b385-10382d80d95b",
                                "text": "„Die Beteiligung der Arbeiterparteien an der Regierung, die Anerkennung der Gewerkschaften als Partner beim Abschluss von Tarifverträgen und die Mitbestimmung der Arbeiter in den Betrieben kennzeichnen den Anteil, den die Arbeiterschaft heute an der Gestaltung des staatlichen und wirtschaftlichen Lebens erlangt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
