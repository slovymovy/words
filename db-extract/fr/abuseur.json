                                                "example_id": "9516e849-ca51-4d41-be44-e8ccfa3b95ae",
                                                "sense_id": "7f392b90-c9d4-3afc-a249-0d44279ba425",
                                                "text": "abuser of my generosity"
                                            },
                                            {
                                                "example_id": "e1848037-440e-473d-97b1-45fe8ee7b19a",
                                                "sense_id": "7f392b90-c9d4-3afc-a249-0d44279ba425",
                                                "text": "Child sexual abusers are highly manipulative in their befriending of parents and children and are able to deceive all types of family."
                                            },
                                            {
                                                "example_id": "44a541f4-dfcc-4385-9b87-79767f96d660",
                                                "sense_id": "7f392b90-c9d4-3afc-a249-0d44279ba425",
                                                "text": "[The person] who was going to visit her with his wife had a physical resemblance to the abuser, so some of her inside children had a strong reaction of fear and revulsion to him. They were afraid to look at the face of the guest in case he was the abuser."
                                            },
                                            {
                                                "example_id": "a4eeef82-4bdc-463d-83be-75c374be17bc",
                                                "sense_id": "7f392b90-c9d4-3afc-a249-0d44279ba425",
                                                "text": "Ordinary people have already been face-swapped into videos for humorous or prank purposes and there is no reason to believe that abusers, harassers, stalkers, and blackmailers will not soon be face-swapping victims into compromising video as part of their arsenal."
                                            }
                                        ]
