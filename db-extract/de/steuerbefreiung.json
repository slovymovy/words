                "senses": [
                    {
                        "sense_id": "6f6dfe40-1852-37bd-91c5-452e1fe9b951",
                        "entry_id": "f116e0f4-3678-3f23-a140-4f78f01b0076",
                        "glosses": [
                            "Befreiung von der Pflicht zur Zahlung einer Steuer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69085b46-6819-41f0-949a-d074db15def4",
                                "sense_id": "6f6dfe40-1852-37bd-91c5-452e1fe9b951",
                                "text": "„Wenn der Bundestag das Jahressteuergesetz 2013 verabschiedet, findet sich darin auch die Steuerbefreiung für Elektroautos.“"
                            },
                            {
                                "example_id": "318adba9-88b1-4c0f-a492-dd1a191209a8",
                                "sense_id": "6f6dfe40-1852-37bd-91c5-452e1fe9b951",
                                "text": "„Statt der avisierten 200 Millionen Dollar an Steuereinnahmen flossen lediglich 27 Millionen in die Staatskasse – kein Wunder, wurden den Konzernen doch Steuerbefreiungen für die Dauer von bis zu dreißig Jahren gewährt.“"
                            }
                        ],
