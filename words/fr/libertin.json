{
    "word_family": [
        "libertinage",
        "libertiner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3b7729e-2012-380d-8de1-11134387edd8",
                    "sense_definition": "Personne qui s'adonne sans retenue aux plaisirs charnels et multiplie les conquêtes sans engagement sentimental.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce séducteur impénitent passe pour un <w>libertin</w> qui refuse tout engagement sérieux avec ses conquêtes."
                        },
                        {
                            "text": "Le personnage principal du roman est un redoutable <w>libertin</w> insensible aux sentiments d'autrui."
                        }
                    ],
                    "synonyms": [
                        "jouisseur",
                        "volage"
                    ]
                },
                {
                    "sense_id": "422ace4a-97ca-3c94-becd-ae270c54dafa",
                    "sense_definition": "Libre penseur qui refuse les dogmes religieux et s'affranchit de la morale établie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au dix-septième siècle, ce philosophe était considéré comme un <w>libertin</w> hostile aux dogmes de l'Église."
                        },
                        {
                            "text": "Les écrits de ce célèbre <w>libertin</w> revendiquaient une entière indépendance de pensée face au clergé."
                        }
                    ],
                    "synonyms": [
                        "libre penseur"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens philosophique et historique classique"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1673514-85d1-3a8c-9c3a-d19fa6b7f8fa",
                    "sense_definition": "Qui a rapport à la sensualité, à la volupté ou aux plaisirs érotiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur s'est rendu célèbre grâce à un roman <w>libertin</w> interdit par la censure."
                        },
                        {
                            "text": "Le couple a décidé d'assister discrètement à une soirée <w>libertine</w> organisée dans la capitale."
                        }
                    ],
                    "synonyms": [
                        "donjuanesque"
                    ],
                    "common_phrases": [
                        "roman libertin",
                        "soirée libertine"
                    ]
                },
                {
                    "sense_id": "7ae8bbf6-d863-37ab-86c6-fe496974cb35",
                    "sense_definition": "Qui mène une existence déréglée, affranchie des convenances morales et de la retenue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moeurs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il menait une vie <w>libertine</w> et dissipée qui inquiétait beaucoup les membres de sa famille."
                        },
                        {
                            "text": "Plusieurs jeunes aristocrates affichaient fièrement une conduite <w>libertine</w> à la cour du roi."
                        }
                    ],
                    "synonyms": [
                        "inconstant"
                    ],
                    "common_phrases": [
                        "vie libertine"
                    ]
                },
                {
                    "sense_id": "8b9f801e-1ed1-357c-9c35-10fd004b0e9a",
                    "sense_definition": "Qui s'écarte des règles et des contraintes ordinaires, indiscipliné ou vagabond.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pensee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son esprit <w>libertin</w> refusait de s'astreindre à la rigueur d'une argumentation méthodique."
                        },
                        {
                            "text": "Laissant libre cours à une imagination <w>libertine</w>, le poète inventait des mondes sans lois."
                        }
                    ],
                    "common_phrases": [
                        "esprit libertin"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare en français moderne"
                        }
                    ]
                }
            ]
        }
    ]
}