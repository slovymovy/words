{
    "word_family": [
        "répondant",
        "répondeur",
        "répondre"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "10f2f923-c7c1-33f2-8bf4-f4c37b79bdc9",
                    "sense_definition": "Parole ou écrit exprimé en retour à une question, une demande ou un message.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'attends votre <w>réponse</w> avec impatience pour confirmer notre rendez-vous de demain."
                        },
                        {
                            "text": "Le professeur a écouté ma question mais il n'a donné aucune <w>réponse</w>."
                        }
                    ],
                    "common_phrases": [
                        "attendre une réponse",
                        "donner une réponse",
                        "sans réponse"
                    ]
                },
                {
                    "sense_id": "2d30a8aa-c659-3b5a-8072-3d713b4e930f",
                    "sense_definition": "Parole vive ou spirituelle qui rétorque à une remarque ou à une provocation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa <w>réponse</w> pleine d'esprit a fait rire toute l'assemblée lors du débat."
                        },
                        {
                            "text": "Il cherchait une <w>réponse</w> cinglante mais il est resté complètement sans voix."
                        }
                    ],
                    "synonyms": [
                        "réplique",
                        "repartie",
                        "riposte"
                    ],
                    "common_phrases": [
                        "réponse cinglante",
                        "réponse vive"
                    ]
                },
                {
                    "sense_id": "afa05523-dfba-3ff9-988a-21023ad54480",
                    "sense_definition": "Réfutation ou riposte organisée face à une attaque, un reproche ou une contestation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a exigé l'exercice d'un droit de <w>réponse</w> après cet article diffamatoire."
                        },
                        {
                            "text": "Le ministre prépare une <w>réponse</w> ferme aux critiques formulées par l'opposition."
                        }
                    ],
                    "synonyms": [
                        "réplique",
                        "riposte"
                    ],
                    "common_phrases": [
                        "droit de réponse"
                    ]
                },
                {
                    "sense_id": "de1e9000-7aa4-3668-8e35-924d4c6d3613",
                    "sense_definition": "Réaction physiologique d'un organisme à un stimulus ou à un agent pathogène.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vaccin déclenche une forte <w>réponse</w> immunitaire qui protège efficacement le patient."
                        },
                        {
                            "text": "Ce nouveau médicament a causé une <w>réponse</w> allergique inattendue sur la peau."
                        }
                    ],
                    "common_phrases": [
                        "réponse immunitaire",
                        "réponse allergique"
                    ]
                }
            ]
        }
    ]
}