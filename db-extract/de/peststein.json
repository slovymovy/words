                "senses": [
                    {
                        "sense_id": "2eb09d0f-3e10-3633-94cf-fc932430ac62",
                        "entry_id": "c24913c7-8a0b-340d-aec3-db1572db76bc",
                        "glosses": [
                            "gehauener Stein, der an die Pestopfer erinnert und auf deren Gräbern stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a0d1ff-5738-490e-a301-c9e0bee806ba",
                                "sense_id": "2eb09d0f-3e10-3633-94cf-fc932430ac62",
                                "text": "„Dagegen würde ich den geschichtlichen Zusammenhang für den Peststein auf dem Mügelner Friedhof, der einen noch heute freigehaltenen Abschnitt als Begräbnisstätte der Pestleichen bezeichnen soll, eher für gewahrt erachten.“"
                            },
                            {
                                "example_id": "9bc71bda-690d-491c-805b-f0f93d2db67b",
                                "sense_id": "2eb09d0f-3e10-3633-94cf-fc932430ac62",
                                "text": "„Der letzte Inzeller Peststein aus dem 16.Jahrhundert wartet hier auf Euch.“"
                            },
                            {
                                "example_id": "19d4178d-a6e7-4671-b40a-0904a635da71",
                                "sense_id": "2eb09d0f-3e10-3633-94cf-fc932430ac62",
                                "text": "„Gemeint sind der Peststein und das Rinderpest-Bildl (auch Mühlmarterl genannt).“"
                            },
                            {
                                "example_id": "6db842e3-19d6-4579-90f2-d234d9be61a3",
                                "sense_id": "2eb09d0f-3e10-3633-94cf-fc932430ac62",
                                "text": "„Zwei Kreuzsteine zwischen Igelsreuth und Langenstadt von denen einer den Namen Peststein trägt, erinnern noch heute an die Zeit des \"Schwarzen Todes\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
