                ],
                "translations": [
                    {
                        "translation_id": "2b98a1af-cafc-494a-8c03-e111df930ee6",
                        "source_entry_id": "db662eb5-59d1-339d-a0b2-1289736e795d",
                        "source_sense_id": "a9ec8881-b06f-32b1-922b-13cecb858860",
                        "source_sense_description": "commerciële activiteiten",
                        "target_lang_word": "business",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "business",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92fdd8d4-161e-36d1-961f-8860c334a995",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "A specific commercial enterprise or establishment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cab66545-31ea-4bfc-a55d-612c86c5854c",
                                                "sense_id": "92fdd8d4-161e-36d1-961f-8860c334a995",
                                                "text": "I left my father's business."
                                            },
                                            {
                                                "example_id": "a5b18105-c5c6-41e5-8d5d-5916b2327f9f",
                                                "sense_id": "92fdd8d4-161e-36d1-961f-8860c334a995",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them, which is then licensed to related businesses in high-tax countries, is often assumed to be the preserve of high-tech companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f11938-d795-35e6-8c65-2e61898b39b1",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "A person's occupation, work, or trade."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c7ab82-b9c9-4cc8-a716-7d5cf08847a4",
                                                "sense_id": "62f11938-d795-35e6-8c65-2e61898b39b1",
                                                "text": "He is in the motor and insurance businesses."
                                            },
                                            {
                                                "example_id": "0368c6e4-3440-41e2-8491-ddc6ac5458c4",
                                                "sense_id": "62f11938-d795-35e6-8c65-2e61898b39b1",
                                                "text": "I'm going to Las Vegas on business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8053cee4-f459-345f-a64c-c85f7fba1f32",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Commercial, industrial, or professional activity."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f878c3a0-213e-4b1f-8e93-968a4f4c0df9",
                                                "sense_id": "8053cee4-f459-345f-a64c-c85f7fba1f32",
                                                "text": "He's such a poor cook, I can't believe he's still in business!"
                                            },
                                            {
                                                "example_id": "037e7b51-709d-4c74-b0a8-72ac6c839b6e",
                                                "sense_id": "8053cee4-f459-345f-a64c-c85f7fba1f32",
                                                "text": "We do business all over the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d7b16b4-b0e4-3730-b090-54a5c9664370",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "The volume or amount of commercial trade."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12646514-cf0b-40b0-96c9-b71e5eebc807",
                                                "sense_id": "3d7b16b4-b0e4-3730-b090-54a5c9664370",
                                                "text": "Business has been slow lately."
                                            },
                                            {
                                                "example_id": "4d5f8beb-f094-46ac-a6eb-100cd6064979",
                                                "sense_id": "3d7b16b4-b0e4-3730-b090-54a5c9664370",
                                                "text": "They did nearly a million dollars of business over the long weekend."
                                            },
                                            {
                                                "example_id": "019a287f-e1e6-47d5-b9f5-8bda90cd45cc",
                                                "sense_id": "3d7b16b4-b0e4-3730-b090-54a5c9664370",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result. If the bumf arrived electronically, the take-up rate was 0.1%. And for online adverts the “conversion” into sales was a minuscule 0.01%. That means about $165 billion was spent not on drumming up business, but on annoying people, creating landfill and cluttering spam filters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22659cef-270d-3463-9741-e00a3d8f2df8",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "One's dealings; patronage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b6bc1c-5398-456f-b2c6-ca14728a5825",
                                                "sense_id": "22659cef-270d-3463-9741-e00a3d8f2df8",
                                                "text": "I shall take my business elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d824bd39-8327-3270-acce-ff275f5baea0",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Private commercial interests taken collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59297981-700a-49e8-a331-d6d0561365fa",
                                                "sense_id": "d824bd39-8327-3270-acce-ff275f5baea0",
                                                "text": "This proposal will satisfy both business and labor."
                                            },
                                            {
                                                "example_id": "bc6642ae-be69-4b62-b9b5-ca27d12d82da",
                                                "sense_id": "d824bd39-8327-3270-acce-ff275f5baea0",
                                                "text": "Policing the relationship between government and business in a free society is difficult. Businesspeople have every right to lobby governments, and civil servants to take jobs in the private sector."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fa1086-f4a8-3ee7-914f-339c7c6a182b",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "The management of commercial enterprises, or the study of such management."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7fc6929-e370-456a-809f-bd3c38caedce",
                                                "sense_id": "04fa1086-f4a8-3ee7-914f-339c7c6a182b",
                                                "text": "I studied business at Harvard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592c64a9-d2a7-304c-b1ed-bc98b4734804",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "A particular situation or activity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96a6fef8-093c-42e8-8755-88dd1f496932",
                                                "sense_id": "592c64a9-d2a7-304c-b1ed-bc98b4734804",
                                                "text": "This UFO stuff is a mighty strange business."
                                            },
                                            {
                                                "example_id": "f0437ab0-198f-4684-a939-2dc7ca564893",
                                                "sense_id": "592c64a9-d2a7-304c-b1ed-bc98b4734804",
                                                "text": "The wolde ſome mayſter perhappes clowt ye / But as for me ye nede nat doute ye / For I had leuer be without ye / Then haue ſuche beſyneſſe aboute ye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f45fd16-d7cb-3966-a7dd-13a7f4aa8b88",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Any activity or objective needing to be dealt with; especially, one of a financial or legal matter."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee92462d-fc47-4e5b-ba3e-e8f72e303b6c",
                                                "sense_id": "2f45fd16-d7cb-3966-a7dd-13a7f4aa8b88",
                                                "text": "Our principal business here is to get drunk."
                                            },
                                            {
                                                "example_id": "76b0a5c3-586e-40c6-9f99-d1e81b37de0e",
                                                "sense_id": "2f45fd16-d7cb-3966-a7dd-13a7f4aa8b88",
                                                "text": "Let's get down to business."
                                            },
                                            {
                                                "example_id": "64ee818c-b9a4-4a1f-8ea1-7445136e6b0a",
                                                "sense_id": "2f45fd16-d7cb-3966-a7dd-13a7f4aa8b88",
                                                "text": "To know the naturall cause of Sense, is not very necessary to the business now in hand; and I have els-where written of the same at large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b53b7aa3-40a7-3aca-a04e-885ff5ab00dc",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Something involving one personally."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18b4fb7f-8e17-4506-b98a-1ee0f7c36a63",
                                                "sense_id": "b53b7aa3-40a7-3aca-a04e-885ff5ab00dc",
                                                "text": "That's none of your business."
                                            },
                                            {
                                                "example_id": "dd3f9957-f298-4f23-b6b7-a35765388d35",
                                                "sense_id": "b53b7aa3-40a7-3aca-a04e-885ff5ab00dc",
                                                "text": "My work is no business of yours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3ea35e-78b2-31ba-8de1-e8e9dbd207d8",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Matters that come before a body for deliberation or action."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16edfb27-be14-45a6-a720-29fca3f4292f",
                                                "sense_id": "cc3ea35e-78b2-31ba-8de1-e8e9dbd207d8",
                                                "text": "If that concludes the announcements, we'll move on to new business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02eba766-9742-3668-a7ae-a720587fdcfb",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Business class, the class of seating provided by airlines between first class and coach."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a8c6e2a-7ede-4c6a-ade4-a2a5102ce8cb",
                                                "sense_id": "02eba766-9742-3668-a7ae-a720587fdcfb",
                                                "text": "Gates, who always flew business or coach, didn't particularly like the high air fares Nishi was charging to Microsoft,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd3d6e7-9ce9-35cc-8d55-3856377ba3d7",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Ellipsis of stage business (“aspect of acting”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3bf57ea-9477-4306-a435-ddd99c10e5e2",
                                                "sense_id": "8bd3d6e7-9ce9-35cc-8d55-3856377ba3d7",
                                                "text": "The business with the hat is a fine example of the difficulty of distinguishing between 'natural' and 'formal' acting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb8d14d-d60f-3865-ae1e-32fe3eba3b37",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Hollywood, the entertainment industry."
                                        ],
                                        "tags": [
