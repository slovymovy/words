            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09e4f03a-de45-32f8-9cab-5ae466348e03",
                    "sense_definition": "Having sufficient skill, knowledge, ability, or qualifications to do something well.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>competent</w> skier and an expert snowboarder. ",
                            "target_lang_translations": {
                                "ru": "Он <w>умелый</w> лыжник и опытный сноубордист."
                            }
                        },
                        {
                            "text": "The company is looking for a <w>competent</w> professional to manage the new project.",
                            "target_lang_translations": {
                                "ru": "Компания ищет <w>компетентного</w> специалиста для управления новым проектом."
                            }
                        }
                    ],
                    "synonyms": [
                        "capable",
                        "skilled",
                        "proficient",
                        "able"
                    ],
                    "antonyms": [
                        "incompetent"
                    ],
                    "common_phrases": [
                        "highly competent",
                        "competent professional",
                        "competent authority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий достаточными навыками, знаниями или квалификацией для качественного выполнения работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "компетентный",
                                "target_lang_sense_clarification": "обладающий знаниями и опытом"
                            },
                            {
                                "target_lang_word": "квалифицированный",
                                "target_lang_sense_clarification": "имеющий профессиональную подготовку"
                            },
                            {
                                "target_lang_word": "умелый",
                                "target_lang_sense_clarification": "хорошо владеющий навыком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                    "sense_definition": "Having the legal jurisdiction or official authority to deal with a particular matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>competent</w> court shall be the Springfield Circuit Court for any disagreements arising from this contract.",
                            "target_lang_translations": {
                                "ru": "<w>Компетентным</w> судом для любых споров, возникающих из этого контракта, является окружной суд Спрингфилда."
                            }
                        },
                        {
                            "text": "You must submit your application to the <w>competent</w> authority in your home country.",
                            "target_lang_translations": {
                                "ru": "Вы должны подать заявление в <w>соответствующий</w> орган в вашей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "authorized",
                        "legitimate"
                    ],
                    "antonyms": [
                        "incompetent"
                    ],
                    "common_phrases": [
                        "competent court",
                        "competent jurisdiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий законной юрисдикцией или официальными полномочиями для решения определенного вопроса."
                    },
                    "translations": {
