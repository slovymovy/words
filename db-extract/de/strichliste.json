                    {
                        "sense_id": "3d2c235d-9b41-3e0d-8aea-688b46907076",
                        "entry_id": "e435bb4a-8680-3bae-bfab-e59bc4ae2d0d",
                        "glosses": [
                            "Liste, auf der für jede einzelne Beobachtung von Sachen/Vorgängen, die Gegenstand der Untersuchung sind, ein Strich gemacht wird, um ihre Häufigkeit festzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2d4268-688e-4a1d-bb32-3255079e6c54",
                                "sense_id": "3d2c235d-9b41-3e0d-8aea-688b46907076",
                                "text": "„Vom Bus aus konnte man ihn sehen, wie er auf einem Klappstuhl vorne an der Rheinbrücke saß und eine Strichliste führte.“"
                            },
                            {
                                "example_id": "1e3965dd-970b-4bb2-8a37-a089ed893678",
                                "sense_id": "3d2c235d-9b41-3e0d-8aea-688b46907076",
                                "text": "„Sehr bald wurde man sich bewusst, dass solche Strichlisten schon bei mäßig großen Zahlen unübersichtlich sind.“"
                            },
                            {
                                "example_id": "605ead0c-d4e6-479b-901d-b4e1d72ebb2e",
                                "sense_id": "3d2c235d-9b41-3e0d-8aea-688b46907076",
                                "text": "„Sie führten sogar eine Strichliste mit Jockeys (negative Rezensionen) und Künstlern (positive Rezensionen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
