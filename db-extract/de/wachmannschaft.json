                    {
                        "sense_id": "daebfe68-deb7-3aac-8ec5-858ba5b13a12",
                        "entry_id": "c6ff8aaf-45c3-315e-a28e-65951f9a3707",
                        "glosses": [
                            "Gruppe von Personen, die zur Bewachung eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961446f8-5540-4f93-b597-087a0903eaae",
                                "sense_id": "daebfe68-deb7-3aac-8ec5-858ba5b13a12",
                                "text": "„Auf die Häftlinge, die im Wasser trieben, soll nach dem Untergang von Minensuchbooten aus geschossen worden sein, die zur Rettung der Wachmannschaften und der beiden Schiffsbesatzungen eingesetzt worden waren.“"
                            },
                            {
                                "example_id": "20c59eed-91c8-44a4-a2e5-92eb0b9c1ede",
                                "sense_id": "daebfe68-deb7-3aac-8ec5-858ba5b13a12",
                                "text": "„Am Ende der Stromschnellen erwartete uns eine neue Wachmannschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
