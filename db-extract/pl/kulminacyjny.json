                        "cross_references": []
                    },
                    {
                        "translation_id": "b98a4f17-6e90-490d-8f19-ce6c7e82675d",
                        "source_entry_id": "bccb58af-6184-3fb3-8877-6162e4dfc7ab",
                        "source_sense_id": "f6f751ec-1289-3573-b6a3-645f3b740ca1",
                        "target_lang_word": "кульминационный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кульминационный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                        "entry_id": "d464a009-0a4c-3ca0-ba4d-e42e7f2cd8a2",
                                        "glosses": [
                                            "прил. к кульминация"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387fd818-43a7-4b02-98d9-344154a4e80f",
                                                "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                                "text": "Кульминационная точка (точка высшего подъема)."
                                            },
                                            {
                                                "example_id": "a0faa3c0-9f64-4a5e-b3e2-8fe0b5cccdbc",
                                                "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                                "text": "Это место есть кульминационный пункт, к которому устремляется взор, здесь все звуки притягиваются к тону с, где автор поставил знак пиано."
                                            },
                                            {
                                                "example_id": "538757e4-37f1-414d-bc5b-21c1b8ebcdce",
                                                "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                                "text": "В национальном развитии Франции кульминационный пункт (если не по содержательности, то по внутренней напряженности народной жизни и по широте ее внешнего захвата) представляет та эпоха (великой революции и наполеоновских войн), когда всего яснее выразилось всемирно-историческое значение этой страны."
                                            },
                                            {
                                                "example_id": "8dfed57f-4eb4-4bd0-afac-f8f6d32d25d7",
                                                "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                                "text": "По весьма убедительному объяснению Мюллера, в этом заключается даже причина, дающая возможность генетической классификации языков арийского корня, так что кульминационный период развития этого семейства языков падает на то время, когда общий всем арийцам коренной язык не распался еще на свои отрасли."
                                            },
                                            {
                                                "example_id": "4d057407-c78f-46d5-9c0d-605cde1b7d0d",
                                                "sense_id": "c3012886-1595-38f6-bd66-c80eaf1aea16",
                                                "text": "И черт знает, чего только там нет? Трансцендентально, кульминационный пункт интегрирующего начала. .. тьфу! И где ты научилась? Соня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
