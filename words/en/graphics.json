    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3008c7e0-4b68-37cb-a6ae-f8b3341bba21",
                    "sense_definition": "Visual images or designs displayed on a screen, especially by a computer or video game.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This game is really fun, but the <w>graphics</w> aren't very good.",
                            "target_lang_translations": {
                                "ru": "Эта игра очень увлекательная, но <w>гра́фика</w> в ней не очень хорошая.",
                                "zh": "这个游戏真的很好玩，但是<w>画面</w>不太好。"
                            }
                        },
                        {
                            "text": "Modern computers can render complex 3D <w>graphics</w> in real time.",
                            "target_lang_translations": {
                                "ru": "Современные компьютеры могут обрабатывать сложную 3D-<w>гра́фику</w> в реальном времени.",
                                "zh": "现代计算机可以实时渲染复杂的3D<w>图形</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visuals",
                        "imagery",
                        "pictures",
                        "artwork"
                    ],
                    "antonyms": [
                        "text"
                    ],
                    "common_phrases": [
                        "computer graphics",
                        "3D graphics",
                        "high-quality graphics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальные изображения или рисунки, отображаемые на экране, особенно в компьютерных играх или программах.",
                        "zh": "在屏幕上显示的视觉图像或设计，尤指计算机或视频游戏中的图像。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гра́фика",
                                "target_lang_sense_clarification": "компьютерная"
                            },
                            {
                                "target_lang_word": "изображе́ние",
                                "target_lang_sense_clarification": "картинка на экране"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "图形",
                                "target_lang_sense_clarification": "计算机生成的视觉元素"
                            },
                            {
                                "target_lang_word": "画面",
                                "target_lang_sense_clarification": "指游戏或视频的视觉表现效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2490a953-275d-3966-8a55-56847d5e788b",
                    "sense_definition": "The use of diagrams, drawings, or pictures to represent information or artistic ideas, often in print or media.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine hired a specialist to improve its layout and <w>graphics</w>.",
                            "target_lang_translations": {
                                "ru": "Журнал нанял специалиста для улучшения верстки и <w>гра́фики</w>.",
                                "zh": "这家杂志社聘请了一位专家来改善其排版和<w>图示</w>。"
                            }
                        },
                        {
                            "text": "She studied <w>graphics</w> and design at the local art college.",
                            "target_lang_translations": {
                                "ru": "Она изучала <w>гра́фику</w> и дизайн в местном художественном колледже.",
                                "zh": "她在当地的艺术学院学习<w>平面设计</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "illustrations",
                        "artwork",
                        "design"
                    ],
                    "common_phrases": [
                        "motion graphics",
                        "vector graphics",
                        "information graphics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование диаграмм, чертежей или рисунков для представления информации или художественных идей, часто в печати.",
                        "zh": "使用图表、绘图或图片来呈现信息或艺术构思，常见于印刷品或媒体中。"
                    },
                    "translations": {
