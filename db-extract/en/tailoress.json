                                "target_senses": [
                                    {
                                        "sense_id": "efb2c2aa-8fbf-3d6a-b38f-eeae3bb29465",
                                        "entry_id": "49a8f053-308d-3164-ab99-4b29a7463953",
                                        "glosses": [
                                            "Celle qui taille."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8502efa3-e308-3458-8ed2-6b58bb92a7f5",
                                        "entry_id": "49a8f053-308d-3164-ab99-4b29a7463953",
                                        "glosses": [
                                            "Celle qui taille des habits, qui fait des vêtements."
                                        ],
                                        "tags": [
                                            "Absolument",
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223e44a1-609b-474e-bab0-781f3c970472",
                                                "sense_id": "8502efa3-e308-3458-8ed2-6b58bb92a7f5",
                                                "text": "Deux sortes d’ouvrières travaillent aux costumes tant masculins que féminins ; la couturière proprement dite et la tailleuse. La couturière ne « fait » que les coiffes, tabliers, mouchoirs, cravates, etc. ; c’est la tailleuse qui confectionne le reste."
                                            },
                                            {
                                                "example_id": "51981fc7-bd22-40d8-a38d-eed5142f385c",
                                                "sense_id": "8502efa3-e308-3458-8ed2-6b58bb92a7f5",
                                                "text": "Les veuves des tailleurs qui continuent le métier de leurs époux sont mentionnées dans les registres de la communauté comme « tailleuses » : elles étaient mieux considérées par leurs pairs que les couturières."
                                            },
                                            {
                                                "example_id": "ea896a94-d72c-42e7-beeb-ce51662a3792",
                                                "sense_id": "8502efa3-e308-3458-8ed2-6b58bb92a7f5",
                                                "text": "Loë, 19 ans, tailleuse dame"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09a5ffbd-88a9-36c5-a580-92f3bf86ad77",
                                        "entry_id": "49a8f053-308d-3164-ab99-4b29a7463953",
                                        "glosses": [
                                            "Épouse d’un tailleur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "333a395a-fc40-347a-81f2-87b195905cef",
                                        "entry_id": "49a8f053-308d-3164-ab99-4b29a7463953",
                                        "glosses": [
                                            "Machine qui taille des engrenages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7af165f6-0f4f-4d7e-9810-7e3dcc6d68bf",
                                                "sense_id": "333a395a-fc40-347a-81f2-87b195905cef",
                                                "text": "C’est sans doute la machine la plus emblématique de l’entreprise Bernard, la tailleuse, qui réalise les engrenages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00f6210c-b74c-4ebe-a693-ac979ed8cfb4",
                        "source_entry_id": "8f4de5cb-8a57-3715-bbcd-1aff830bfbba",
                        "source_sense_id": "4ebd65d9-42bf-3964-accd-91b1ed19fc7c",
                        "source_sense_description": "female tailor",
                        "target_lang_word": "Schneiderin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneiderin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                        "entry_id": "13d98e71-ff5c-3c3f-894a-a82506320243",
                                        "glosses": [
                                            "weiblicher Schneider"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f275467-1ee5-40eb-b16d-5ee3cca638c3",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "Seine Mutter hat den Beruf der Schneiderin gelernt."
                                            },
                                            {
                                                "example_id": "ef332ae8-fdcd-4b4d-b460-76d1bf0ba52b",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Im Begleittext von Smith erfährt der Leser, dass es sich hier um eine in Armut geratene Schneiderin handelt, die […] ohne Unterstützung und Obdach die Betreuung eines fremden Kindes übernommen hat.“"
                                            },
                                            {
                                                "example_id": "097e5faf-5890-4a54-98f8-427814b14288",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Als ich, nach Aufforderung durch Serana, die Wohnung das erste Mal betreten hatte, hielt die Schneiderin mich fest.“"
                                            },
                                            {
                                                "example_id": "802d307c-dffd-48c0-a5c6-afcd8171f3c9",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Während die Schneiderin zuschnitt, begann ihre Tochter zu nähen; aber da eine allein nicht allzuviel leisten konnte, sagte ich der Frau, es wäre uns sehr recht, wenn sie uns noch eine weitere verschaffe, die französisch sprechen könne.“"
                                            },
                                            {
                                                "example_id": "41a7dbb7-755f-457f-b83d-6949c736707d",
                                                "sense_id": "449fe9a5-edf9-3434-847d-4da8af23f1d9",
                                                "text": "„Die meisten Kleider habe ich selbst ihr gekauft, sogar die Änderungen mit den Schneiderinnen besprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
