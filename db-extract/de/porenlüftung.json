                "senses": [
                    {
                        "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                        "entry_id": "4a338984-466c-30f0-8ee4-1760342eb95f",
                        "glosses": [
                            "Luftführung in und aus einem Raum über Poren in der Wand oder Decke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294cf290-66df-4ccd-aa51-9b7c295a3d26",
                                "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                                "text": "„Das Prinzip der Porenlüftung ist seit den 60er Jahren bekannt.“"
                            },
                            {
                                "example_id": "9b74f682-39e7-43ce-8a7e-c26f8cc9dbea",
                                "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                                "text": "„Die aktive Gebäudehülle beruht auf dem Prinzip der Porenlüftung, mit dem es möglich ist, die Dämmwirkung des Dämmmaterials um ein Vielfaches zu verbessern.“"
                            },
                            {
                                "example_id": "76d952fa-751e-45ab-acc4-b7a767e38471",
                                "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                                "text": "„Sind diese Varianten der Porenlüftung ohne Dämmung ausgeführt, ist eine Zuluftvorwärmung, in welcher Art auch immer, unerlässlich.“"
                            },
                            {
                                "example_id": "6f7c1b64-79a8-48a7-9156-6ffb9b2f4319",
                                "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                                "text": "„Die Porenlüftung ist ein Zuluftsystem mit garantierter ganzjähriger Zugluftfreiheit.“"
                            },
                            {
                                "example_id": "e486ee99-2d4b-4ecd-aa69-6c5f84d6f1a6",
                                "sense_id": "efb16179-32bb-3d8c-8b2c-a08ae94a375d",
                                "text": "„Die gemeinsame Halle mit einer in Mitteleuropa einzigartigen computergesteuerten Porenlüftung ist das Herz der gemeinsamen Qualitätssicherung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
