    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdea576e-f2cd-386b-aad3-0eb4da41390d",
                    "sense_definition": "Situated toward or located in the south.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cottage is located in the most <w>southerly</w> corner of the county.",
                            "target_lang_translations": {
                                "es": "La cabaña está ubicada en el rincón más <w>meridional</w> del condado."
                            }
                        },
                        {
                            "text": "We decided to move to a more <w>southerly</w> town to enjoy warmer winters.",
                            "target_lang_translations": {
                                "es": "Decidimos mudarnos a una ciudad más <w>al sur</w> para disfrutar de inviernos más cálidos."
                            }
                        }
                    ],
                    "common_phrases": [
                        "southerly latitude",
                        "most southerly point"
                    ],
                    "target_lang_definitions": {
                        "es": "Situado hacia el sur o ubicado en el sur."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "meridional",
                                "target_lang_sense_clarification": "perteneciente o relativo al sur"
                            },
                            {
                                "target_lang_word": "austral",
                                "target_lang_sense_clarification": "situado en el sur"
                            },
                            {
                                "target_lang_word": "del sur",
                                "target_lang_sense_clarification": "de la parte sur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fec1c3f3-8fb9-3930-bd03-e539bd63687b",
                    "sense_definition": "Blowing or coming from the south (especially of wind).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A warm <w>southerly</w> wind brought unseasonable temperatures across the coast.",
                            "target_lang_translations": {
                                "es": "Un cálido viento <w>del sur</w> trajo temperaturas inusuales a lo largo de la costa."
                            }
                        },
                        {
                            "text": "Sailors were delayed by the sudden arrival of strong <w>southerly</w> breezes.",
                            "target_lang_translations": {
                                "es": "Los marineros se retrasaron por la repentina llegada de fuertes brisas <w>del sur</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "southerly wind",
                        "southerly breeze",
                        "southerly gale"
                    ],
                    "target_lang_definitions": {
                        "es": "Que sopla o procede del sur (especialmente tratándose del viento)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "del sur",
                                "target_lang_sense_clarification": "que procede del sur"
                            },
                            {
                                "target_lang_word": "meridional",
                                "target_lang_sense_clarification": "proveniente del sur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1323d76-a2c1-3751-85bf-03597771667e",
                    "sense_definition": "Facing or moving toward the south.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship altered its heading and began a <w>southerly</w> voyage toward the tropics.",
                            "target_lang_translations": {
                                "es": "El barco cambió de rumbo e inició un viaje <w>hacia el sur</w> rumbo a los trópicos."
                            }
                        },
                        {
                            "text": "They chose a room with a <w>southerly</w> aspect to get more sunlight.",
                            "target_lang_translations": {
                                "es": "Eligieron una habitación con <w>orientación sur</w> para recibir más luz solar."
                            }
                        }
                    ],
                    "common_phrases": [
                        "southerly course",
                        "southerly direction"
                    ],
                    "target_lang_definitions": {
                        "es": "Orientado o que se dirige hacia el sur."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacia el sur",
                                "target_lang_sense_clarification": "en dirección al sur"
                            },
                            {
                                "target_lang_word": "orientado al sur",
                                "target_lang_sense_clarification": "con orientación al sur"
                            },
                            {
                                "target_lang_word": "rumbo al sur",
                                "target_lang_sense_clarification": "en dirección al sur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e8ae91e6-f6f3-3373-816a-8926506193a1",
                    "sense_definition": "Toward the south; in a southward direction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds began to fly <w>southerly</w> as the autumn chill arrived.",
                            "target_lang_translations": {
                                "es": "Las aves comenzaron a volar <w>hacia el sur</w> cuando llegó el frío otoñal."
                            }
                        },
                        {
                            "text": "We continued walking <w>southerly</w> until we reached the edge of the forest.",
                            "target_lang_translations": {
                                "es": "Seguimos caminando <w>hacia el sur</w> hasta llegar al borde del bosque."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hacia el sur; en dirección sur."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacia el sur",
                                "target_lang_sense_clarification": "en dirección sur"
                            },
                            {
                                "target_lang_word": "rumbo al sur",
                                "target_lang_sense_clarification": "en dirección sur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f039bf8-13c1-3d70-bb99-fae5cc3693e6",
                    "sense_definition": "From the south.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm was blowing <w>southerly</w> across the open plains.",
                            "target_lang_translations": {
                                "es": "La tormenta soplaba <w>desde el sur</w> a través de las llanuras abiertas."
                            }
                        },
                        {
                            "text": "Warm air drifted <w>southerly</w> over the mountains during the afternoon.",
                            "target_lang_translations": {
                                "es": "Aire cálido soplaba <w>desde el sur</w> sobre las montañas durante la tarde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Desde el sur."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desde el sur",
                                "target_lang_sense_clarification": "con origen en el sur"
                            },
                            {
                                "target_lang_word": "del sur",
                                "target_lang_sense_clarification": "procedente del sur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ec85ac84-cda5-3178-9458-e38d418ee28b",
                    "sense_definition": "A wind that blows from the south.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A strong <w>southerly</w> brought sudden rain showers to the harbor.",
                            "target_lang_translations": {
                                "es": "Un fuerte <w>viento del sur</w> trajo repentinos chubascos al puerto."
                            }
                        },
                        {
                            "text": "The sailors welcomed the mild <w>southerly</w> after days of harsh weather.",
                            "target_lang_translations": {
                                "es": "Los marineros agradecieron el suave <w>viento del sur</w> después de días de clima riguroso."
                            }
                        }
                    ],
                    "synonyms": [
