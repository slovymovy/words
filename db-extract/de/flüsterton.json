                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe55a872-9272-405e-854c-17442a0c4fa9",
                                "sense_id": "002e4645-8e8f-31aa-9649-3d1b3fdcf7a9",
                                "text": "„Die junge Frau mit dem ausrasierten Nacken erwiderte etwas im Flüsterton, worauf beide losprusteten.“"
                            },
                            {
                                "example_id": "b766c370-5ebc-46eb-b6b2-90c5094c36a1",
                                "sense_id": "002e4645-8e8f-31aa-9649-3d1b3fdcf7a9",
                                "text": "„Dann entschuldigten sie sich in spöttischem Flüsterton.“"
                            },
                            {
                                "example_id": "c311cea8-2f76-43b6-b833-fce8bdfb076f",
                                "sense_id": "002e4645-8e8f-31aa-9649-3d1b3fdcf7a9",
                                "text": "„Sie reden im Flüsterton.“"
                            },
                            {
                                "example_id": "a0ad2917-0f64-4f8d-9fe0-a232d691f70a",
                                "sense_id": "002e4645-8e8f-31aa-9649-3d1b3fdcf7a9",
                                "text": "„Beide Frauen sprechen mit gedämpfter Stimme weiter, Isolde fast im Flüsterton.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
