                                "sense_id": "701eb776-1350-3a6b-a2f2-ec43856f5452",
                                "text": "Hou jij ook van een glas gin?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da394e2d-f6a8-4189-826f-361a4c5823e4",
                        "source_entry_id": "50e73c0b-6959-3a93-a165-df98b5d41d40",
