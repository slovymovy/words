                "senses": [
                    {
                        "sense_id": "0db6568c-3419-36f1-981c-ade7184fc8f7",
                        "entry_id": "2d16f2bd-c5f1-304e-ba56-0e8bff97cf84",
                        "glosses": [
                            "действие по значению гл. соотнести"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1beb813d-516b-40fb-8144-fdad6d6b3102",
                                "sense_id": "0db6568c-3419-36f1-981c-ade7184fc8f7",
                                "text": "Профессия вождя — точное соотнесение обещаний с их выполнением!"
                            },
                            {
                                "example_id": "5a48ddcc-451f-428f-9638-ed308eb44027",
                                "sense_id": "0db6568c-3419-36f1-981c-ade7184fc8f7",
                                "text": ".. у каждой науки, в том числе истории, есть весьма точная система доказательств. Правда, у историков она довольно сложная, подчас громоздкая, т. к. требует соотнесения между собой многих фактов .."
                            }
                        ]
                    }
