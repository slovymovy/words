                    }
                ],
                "senses": [
                    {
                        "sense_id": "803b6f0d-8535-3d21-81da-d507916628f9",
                        "entry_id": "85c5c06a-4f65-32f9-9518-a78b351fdbc7",
                        "glosses": [
                            "Qui produit des fruits une fois par an."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9af3811-4443-4299-b7f8-dd1cc088f36d",
                                "sense_id": "803b6f0d-8535-3d21-81da-d507916628f9",
                                "text": "Le figuier femelle ou figuier domestique est bifère ou unifère."
                            }
                        ]
                    },
                    {
                        "sense_id": "48f93d12-85cc-3d02-9c4b-f5875da0eb4e",
                        "entry_id": "85c5c06a-4f65-32f9-9518-a78b351fdbc7",
                        "glosses": [
                            "Qui est produit une fois par an, en parlant de récolte ou de fruits."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "52070ab4-51fc-4a28-9b84-759d1f6ed8c5",
                                "sense_id": "48f93d12-85cc-3d02-9c4b-f5875da0eb4e",
                                "text": "La \"Ronde de Bordeaux\" est une petite figue noire unifère."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8d592d8-1917-382a-a0f2-639c6e905729",
                        "entry_id": "85c5c06a-4f65-32f9-9518-a78b351fdbc7",
                        "glosses": [
                            "Qualifie une structure algébrique munie d'élément neutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e84ff688-dd75-4474-87ec-c0eeaa53e52b",
                                "sense_id": "a8d592d8-1917-382a-a0f2-639c6e905729",
                                "text": "Ainsi l’algèbre est associative si le produit est associatif ; l’algèbre est commutative si le produit est commutatif ; l’algèbre est unifère si le produit possède un élément neutre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a26b0eea-aa5f-450d-8298-f661a868d9d6",
                        "source_entry_id": "85c5c06a-4f65-32f9-9518-a78b351fdbc7",
                        "source_sense_description": "avec un élément neutre",
                        "target_lang_word": "unitary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "175afba5-717d-346f-b3bc-cbcb56041617",
                                        "entry_id": "8d96d44e-ca00-32d3-b91b-64ba156569ce",
                                        "glosses": [
                                            "Having the quality of oneness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8fee7dd-a509-4999-bb69-24755bfbe8c9",
                                                "sense_id": "175afba5-717d-346f-b3bc-cbcb56041617",
                                                "text": "If yes–no questions are CPs containing a null yes–no question operator (a null counterpart of whether) in spec-CP, we can arrive at a unitary characterisation of questions as CPs with an interrogative specifier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8850f39a-a524-3ec7-b73f-4f46472163b2",
                                        "entry_id": "8d96d44e-ca00-32d3-b91b-64ba156569ce",
                                        "glosses": [
                                            "That concentrates power in a single body, rather than sharing it with more local bodies."
                                        ],
                                        "tags": [
                                            "of a system of government or administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e11c57df-507b-40b9-93f1-0b1ecb1cd914",
                                                "sense_id": "8850f39a-a524-3ec7-b73f-4f46472163b2",
                                                "text": "a unitary authority"
                                            },
                                            {
                                                "example_id": "66bc4bef-a3bf-4488-82f2-e7467a1754d7",
                                                "sense_id": "8850f39a-a524-3ec7-b73f-4f46472163b2",
                                                "text": "a unitary state"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d54f3ac-d9b5-3c67-beaf-811f58b61a2c",
                                        "entry_id": "8d96d44e-ca00-32d3-b91b-64ba156569ce",
                                        "glosses": [
                                            "That contains an identity element."
                                        ],
                                        "tags": [
                                            "of an algebra"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6243b089-a092-3a90-80a4-32277336e352",
                                        "entry_id": "8d96d44e-ca00-32d3-b91b-64ba156569ce",
                                        "glosses": [
                                            "Whose inverse is equal to its adjoint."
                                        ],
                                        "tags": [
                                            "of a matrix or operator"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad3b1af-4391-4e85-982c-b3ccfc044c0d",
                                                "sense_id": "6243b089-a092-3a90-80a4-32277336e352",
                                                "text": "The eigenvectors of an orthogonal or unitary operator, corresponding to different eigenvalues, are orthogonal."
                                            },
                                            {
                                                "example_id": "74d99e89-fe19-4e72-87ce-b91bc3e90b95",
                                                "sense_id": "6243b089-a092-3a90-80a4-32277336e352",
                                                "text": "In essence we are looking for some way to average the individual unitary matrices Uₖ. But a linear combination of unitary matrices does not remain unitary."
                                            },
                                            {
                                                "example_id": "79f857ca-1703-4aaa-bc3e-041d11e36073",
                                                "sense_id": "6243b089-a092-3a90-80a4-32277336e352",
                                                "text": "We then repeat the same procedure to the (d − 1) × (d − 1) block unitary matrix using (d − 2) two-level unitary matrices."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95b0efad-ad23-3b32-a2e1-ef92ad197fbb",
                                        "entry_id": "39cf4342-a5bd-333a-b17a-f91bcee481d8",
                                        "glosses": [
                                            "A unitary council."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73bc4773-5f2d-484a-8527-c1b01f032abe",
                                                "sense_id": "95b0efad-ad23-3b32-a2e1-ef92ad197fbb",
                                                "text": "Outside the metropolitan areas most councils (English and Welsh counties, London boroughs, Scottish and Welsh unitaries, and Northern Ireland districts) are now elected en bloc every four years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b534529-37ce-378f-830e-5e3e7247e65c",
                                        "entry_id": "39cf4342-a5bd-333a-b17a-f91bcee481d8",
                                        "glosses": [
                                            "A unitary matrix or operator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d584c4-31a8-49e8-b877-3aa5f6b587b1",
                                                "sense_id": "6b534529-37ce-378f-830e-5e3e7247e65c",
                                                "text": "1980, Michael Reed, Barry Simon, Methods of Modern Mathematical Physics, Volume 1: Functional Analysis, Revised and Expanded Edition page 243,\nSince ergodicity and mixing are expressible in terms of the induced Koopman unitaries they are not additional invariants."
                                            },
                                            {
                                                "example_id": "9e228f6a-42c0-42d7-81c7-0f41130aa013",
                                                "sense_id": "6b534529-37ce-378f-830e-5e3e7247e65c",
                                                "text": "Can unitaries in a unital C*-algebra with real rank zero be approximated by unitaries with finite spectrum?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
