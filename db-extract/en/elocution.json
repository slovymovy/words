                                "text": "perfect elocution"
                            },
                            {
                                "example_id": "e093e901-95cf-484a-bd26-77a0970c2b1d",
                                "sense_id": "a2a699d1-0cd5-39dd-bde4-57b0ed567e30",
                                "text": "elocution training"
                            },
                            {
                                "example_id": "be0891b1-98cd-416b-b397-cfc45042baca",
                                "sense_id": "a2a699d1-0cd5-39dd-bde4-57b0ed567e30",
                                "text": "study elocution"
                            },
                            {
                                "example_id": "c39914a0-0c93-4da6-9d23-dc66ff0ef9c9",
                                "sense_id": "a2a699d1-0cd5-39dd-bde4-57b0ed567e30",
                                "text": "She took elocution lessons to improve her public speaking."
                            },
                            {
                                "example_id": "a2ce2df6-9dac-47f8-b654-021bcd9a92ba",
                                "sense_id": "a2a699d1-0cd5-39dd-bde4-57b0ed567e30",
                                "text": "His elocution was precise and clear."
                            }
                        ]
                    }
