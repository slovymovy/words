                    "frequency": "High",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise cherche un informaticien très <w>compétent</w> pour diriger la nouvelle équipe technique."
                        },
                        {
                            "text": "Notre nouvelle collègue est particulièrement <w>compétente</w> et résout facilement tous les problèmes."
                        }
                    ],
                    "synonyms": [
