                "senses": [
                    {
                        "sense_id": "c14f53a6-da23-37dd-9344-ef7f3342b181",
                        "entry_id": "ace883b7-487a-31e6-988c-4ee782a2ba53",
                        "glosses": [
                            "iemand die een grote voorliefde voor intellectuele zaken aan de dag legt, maar sociaal en seksueel niet aantrekkelijk wordt gevonden"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "77cf3cc2-ae01-4e5b-837f-4016c9076c6a",
                                "sense_id": "c14f53a6-da23-37dd-9344-ef7f3342b181",
                                "text": "Ja, hij is een beetje een nerd, maar lang niet slecht als je hem beter leert kennen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f0a62ef-88c6-4f3a-a0c6-1a9b97b75162",
                        "source_entry_id": "ace883b7-487a-31e6-988c-4ee782a2ba53",
                        "source_sense_id": "c14f53a6-da23-37dd-9344-ef7f3342b181",
                        "source_sense_description": "iemand die sociaal en seksueel weinig in trek is en een grote voorliefde voor intellectuele zaken aan de dag legt",
                        "target_lang_word": "nerd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                        "entry_id": "4e31ebcc-eb12-32dc-8b23-1bf5e86be783",
                                        "glosses": [
                                            "A person who is intellectual but generally introverted."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44d85118-f1d3-4881-9d8c-ba2c46af2bfd",
                                                "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                                "text": "The bullies used to call him a nerd at school."
                                            },
                                            {
                                                "example_id": "e782a701-41dc-42cc-89c7-cc438568e41a",
                                                "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                                "text": "1953 Advertisement for \"Businessman's Lunch\", a play by Michael Quinn, in Patricia Brown, Gloria Mundi\nThey particularly enjoy making fun of one of their fellows who is not present, whom they consider a hopeless nerd – until, that is, they learn he is engaged to marry the boss's daughter."
                                            },
                                            {
                                                "example_id": "a36b3249-84c5-4846-9b64-62022a8e0bfe",
                                                "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                                "text": "I once found myself listening to a gay man who was saying wistfully, \"I wish there was someplace you could go, maybe a club, where only masculine men would be allowed in.\" […] Ever tactful, I did not point out to him that if such a place existed, he probably would not be allowed into it, for while he wasn't a campy sort he was too much of a nerd to meet his own specification."
                                            },
                                            {
                                                "example_id": "cd743f2e-b4a2-4f44-aaac-fbffd5878d68",
                                                "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                                "text": "\"We were all geeks and nerds, but he was unusually poorly adjusted,\" recalls Chess, now a mathematics professor at Hunter College."
                                            },
                                            {
                                                "example_id": "81658a23-6f52-441d-a7df-6287b021d77f",
                                                "sense_id": "6cdd2a3d-93b4-32ed-ad0c-34d73700736d",
                                                "text": "\"Yes, I am super nerd, and the whole room cracked up,\" Said Orszag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f96ec742-7fc2-3ddf-ad25-9994b95237da",
                                        "entry_id": "4e31ebcc-eb12-32dc-8b23-1bf5e86be783",
                                        "glosses": [
                                            "One who has an intense, obsessive interest in something."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33da2f71-68dc-4510-b6e9-c51609056cfb",
                                                "sense_id": "f96ec742-7fc2-3ddf-ad25-9994b95237da",
                                                "text": "a computer nerd"
                                            },
                                            {
                                                "example_id": "0cc63917-fce6-4ece-a72c-27ee52d4b60d",
                                                "sense_id": "f96ec742-7fc2-3ddf-ad25-9994b95237da",
                                                "text": "a comic-book nerd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0d2d6d-0f12-3760-b1d8-7f6feb6a5217",
                                        "entry_id": "4e31ebcc-eb12-32dc-8b23-1bf5e86be783",
                                        "glosses": [
                                            "A member of a subculture revolving around intellectualism, technology, video games, fantasy and science fiction, comic books and assorted media."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2c136ad-fd7c-3afa-ae5d-aafd17af6386",
                                        "entry_id": "4e31ebcc-eb12-32dc-8b23-1bf5e86be783",
                                        "glosses": [
                                            "One who is stupid and socially inept or unattractive; a social outcast."
                                        ],
                                        "tags": [
                                            "dated",
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d531077f-2ce9-4223-aa3d-31b2ffa32e70",
                                                "sense_id": "a2c136ad-fd7c-3afa-ae5d-aafd17af6386",
                                                "text": "ALICE: Prithee , what might a nerd be ?\nGLORIA: A nerd is an idiot or other person absurd."
                                            },
                                            {
                                                "example_id": "dc64da50-410b-4390-80f9-3bc7c2bb1b59",
                                                "sense_id": "a2c136ad-fd7c-3afa-ae5d-aafd17af6386",
                                                "text": "To much of the world, we in America are nerds. We don't understand the world we live in."
                                            },
                                            {
                                                "example_id": "c138d70b-fabe-4470-894e-34502616aceb",
                                                "sense_id": "a2c136ad-fd7c-3afa-ae5d-aafd17af6386",
                                                "text": "\"You're a nerd, Jake, a nerd. You're stupid. You're clumsy. You're dirt, Jake. You're nothing.\""
                                            },
                                            {
                                                "example_id": "1879fe80-c817-44d7-8537-bd6e5062d3f4",
                                                "sense_id": "a2c136ad-fd7c-3afa-ae5d-aafd17af6386",
                                                "text": "Nerds of the Old West"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
