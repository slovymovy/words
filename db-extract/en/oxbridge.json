                        "sense_id": "8117c931-1c2b-31d6-83e0-d58711c45e2e",
                        "entry_id": "8f9a4586-63db-3809-bbc1-ab3d2b5140a0",
                        "glosses": [
                            "The University of Oxford and the University of Cambridge collectively."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "a0058760-46af-498b-a8ec-2aacb4472149",
                                "sense_id": "8117c931-1c2b-31d6-83e0-d58711c45e2e",
                                "text": "On the previous night he had taken the manuscript out of a long neglected chest, containing old shooting jackets, old Oxbridge scribbling books, his old surplice, and battered cap and gown, and other memorials of youth, school, and home."
                            },
                            {
                                "example_id": "e435643c-6f03-4ad0-aec4-1d7a23ec5741",
                                "sense_id": "8117c931-1c2b-31d6-83e0-d58711c45e2e",
                                "text": "\"Of course she is clever,\" said Mrs. Pope. \"Or we shouldn't have sent her to Oxbridge. There she's doing quite well—quite well. Everyone says so. I don't know, of course, if Mr. Magnet will let her finish there.\""
                            },
                            {
                                "example_id": "bb31daa6-e591-4cbe-bbe1-238799d704ad",
                                "sense_id": "8117c931-1c2b-31d6-83e0-d58711c45e2e",
                                "text": "In another, he says: “Why has the BBC allowed the format of this programme to treat all other universities in the UK apart from Oxbridge as second class?”"
                            }
                        ]
                    }
