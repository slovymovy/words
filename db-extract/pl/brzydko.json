                        "examples": [
                            {
                                "example_id": "9eec6f37-7af3-45a2-95ca-a398da64ac48",
                                "sense_id": "b4236f82-1b64-39bb-8b8f-10570862d270",
                                "text": "Elżbieta zawsze przychodzi tak brzydko ubrana."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f6b95d12-4910-3d1a-99af-98e52f9149c8",
                        "entry_id": "162b4c26-e9af-3442-b137-422a36d58c77",
                        "glosses": [
                            "niegrzecznie, niekulturalnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66e0c9d-9c87-4177-a69c-c2fa113c3aa2",
                                "sense_id": "f6b95d12-4910-3d1a-99af-98e52f9149c8",
                                "text": "Musisz przyznać, że Rafał brzydko się zachował, nie puszczając ich przodem."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "ef0cc5b6-d506-3d3c-ad0d-f4d69d3f4626",
                        "entry_id": "162b4c26-e9af-3442-b137-422a36d58c77",
                        "glosses": [
                            "w sposób wulgaryzujący sferę ludzkiej płciowości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd26fcb-1387-4e8d-899b-3969e17db71e",
                                "sense_id": "ef0cc5b6-d506-3d3c-ad0d-f4d69d3f4626",
                                "text": "Proszę pani, Janek znowu brzydko pokazuje."
                            },
                            {
                                "example_id": "60e2ee3c-f3f8-44ec-ae56-e69d1974dbff",
                                "sense_id": "ef0cc5b6-d506-3d3c-ad0d-f4d69d3f4626",
                                "text": "Jakiś szczeniak wciąż brzydko bazgrze na murze od strony parkingu."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "dc3f7893-ddb7-3f0e-8349-adaa7d8c2250",
                        "entry_id": "162b4c26-e9af-3442-b137-422a36d58c77",
                        "glosses": [
                            "pochmurnie, deszczowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0a7ba66-4fdc-498a-be39-d4628e3cf516",
                                "sense_id": "dc3f7893-ddb7-3f0e-8349-adaa7d8c2250",
                                "text": "Było brzydko i siedzieliśmy cały czas w domu wczasowym."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
