                                        "glosses": [
                                            "ein meist einfarbiger, grober, oft auch imprägnierter Stoff aus Schafwolle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1479ab2b-8ebe-411b-b678-631c1278d8c7",
                                                "sense_id": "9b9ab981-a381-367c-8723-82e39ff35a76",
                                                "text": "Loden sind meist aus Schafwolle unter Zusatz von Kamelhaar gefertigt."
                                            },
                                            {
                                                "example_id": "85bb1ccb-d57f-4cf2-af89-f51ff5d4f983",
                                                "sense_id": "9b9ab981-a381-367c-8723-82e39ff35a76",
                                                "text": "Loden wird häufig für die Fertigung von Jäger- oder Trachtenkleidung verwendet."
                                            }
                                        ],
