                                    },
                                    {
                                        "sense_id": "25ddccef-0e7b-30d9-9f3a-15eca2bea2ee",
                                        "entry_id": "aa4b94b5-32da-3159-b428-a174c3c3e667",
                                        "glosses": [
                                            "seinen angewinkelten untergeschobenen Arm vom Arm eines anderen wegziehen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "eac67edd-b898-3a18-9ac6-74e440263205",
                                        "entry_id": "aa4b94b5-32da-3159-b428-a174c3c3e667",
                                        "glosses": [
                                            "glätten durch Aufhängen von etwas (beispielsweise eine Hose, Gardinen)"
                                        ],
                                        "tags": [
                                            "Stoffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec8034b8-83d5-4c4b-a3c0-a009aedf667b",
                                                "sense_id": "eac67edd-b898-3a18-9ac6-74e440263205",
                                                "text": "[Die] „Gardinen feucht aus der Maschine nehmen, gleich aufhängen und glatt streichen. Die Restfeuchte macht den Stoff schwer. So kann er sich beim trocknen knitterfrei aushängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "aushängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
