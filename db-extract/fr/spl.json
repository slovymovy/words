                        "glosses": [
                            "En France, forme de société mise à la disposition des collectivités locales pour la gestion de leurs services publics."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "414c74b4-21d7-46ff-a390-b271c48a53be",
                                "sense_id": "6a58f450-6d1d-3c09-9fb2-c8ce5948b7a8",
                                "text": "Ce jeudi, la Ville de Paris doit présenter sa nouvelle société publique locale funéraire (SPL)."
                            },
                            {
                                "example_id": "b5acc73d-7154-4da3-84a3-518f7ee2308f",
                                "sense_id": "6a58f450-6d1d-3c09-9fb2-c8ce5948b7a8",
                                "text": "Le régime juridique des SPL et des SPLA, sauf dispositions contraires, est identique à celui des sociétés d'économie mixte locales (SEML)."
                            },
                            {
                                "example_id": "0ffb510c-2893-4b5d-8f7a-45a31a5f40c3",
                                "sense_id": "6a58f450-6d1d-3c09-9fb2-c8ce5948b7a8",
                                "text": "La loi du 28 mai 2010 pour le développement des sociétés publiques locales, crée la société publique locale (SPL)."
                            }
                        ]
