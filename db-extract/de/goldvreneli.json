                            {
                                "example_id": "d96c7442-6779-4d76-aa9d-c92a4b2640a8",
                                "sense_id": "f30e72b4-1ee9-3e24-a2f3-a9ac08e98089",
                                "text": "„Goldvreneli sind in der Schweiz als Geschenke und Wettbewerbspreise populär.“"
                            },
                            {
                                "example_id": "c09904aa-4c0d-4fb9-99b9-37a7cb174500",
                                "sense_id": "f30e72b4-1ee9-3e24-a2f3-a9ac08e98089",
                                "text": "„Bei den Rohstoffen handelt es sich um eine traditionsreiche Anlageklasse. In der Schweiz galten zum Beispiel Goldbarren und «Goldvreneli» lange Zeit als zuverlässige Notgroschen und beliebte «Göttibatzen».“"
                            }
