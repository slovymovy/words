                                "example_id": "f9e78ea2-efde-4c49-a5be-039179162937",
                                "sense_id": "8d529e37-5140-3697-ace2-f62a6c2db804",
                                "text": "„Waffen hat dieses Volk vielerlei; doch wird auch hierin mehr auf Tauglichkeit als Schönheit gesehen.“"
                            },
                            {
                                "example_id": "50a66967-60ec-4bd8-a699-e46d3b515f4a",
                                "sense_id": "8d529e37-5140-3697-ace2-f62a6c2db804",
                                "text": "„Lessing hielt vollkommene Tauglichkeit zum Ideal für einen dramatischen Fehlgriff, denn ein Mensch ohne Lebenswirklichkeit sei auf der Bühne zu nichts nütze, außer um uns zu langweilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51c79c23-c6b1-4432-a2bd-51ae1a8ab4b7",
