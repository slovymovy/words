    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                "word": "unnecessarily",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bdbf2b77-ecaf-4c6d-abc4-e4cdd688d0dd",
                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more unnecessarily"
                    },
                    {
                        "form_id": "45c77670-3762-4120-91b8-374faa3c942c",
                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unnecessarily"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "glosses": [
                            "In an unnecessary way; not by necessity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4c1570-d3ce-453f-8bff-609f2da93627",
                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                "text": "He unnecessarily repeated much of what others had covered."
                            },
                            {
                                "example_id": "049bc9b1-4bde-43df-a288-2d0af478cb57",
                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                "text": "There be […] lords that can prate\nAs amply and unnecessarily\nAs this Gonzalo;"
                            },
                            {
                                "example_id": "5050b18a-adb8-4177-8bb9-1dbb658c3c33",
                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                "text": "Pray let not any-body unnecessarily be acquainted with this shocking affair;"
                            },
                            {
                                "example_id": "ca43e540-657a-487f-b4e8-c5ba1d232890",
                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                "text": "“Wait a moment,” said he, quite unnecessarily, for she could not have stirred;"
                            },
                            {
                                "example_id": "14286408-27b9-4c21-844b-f4766eec5389",
                                "sense_id": "c853d7a6-d085-3840-aa8e-37dd1e242d3e",
                                "text": "[…] they made good laws and kept the peace and saved good trees from being unnecessarily cut down,"
                            }
                        ]
                    },
                    {
                        "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                        "entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "glosses": [
                            "To an extent beyond what is needed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d8da69-692d-4183-a3f0-6f7fcaa91299",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "The food provided was unnecessarily generous, especially for an event meant to raise money for the hungry."
                            },
                            {
                                "example_id": "850834bd-aa6e-4893-a78e-9e57d7b23ddc",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "In the days of their [the Roman armies’] grandeur, when no enemy appeared capable of opposing them, their heavy armour was laid aside as unnecessarily burdensome, their laborious exercises were neglected as unnecessarily toilsome."
                            },
                            {
                                "example_id": "a2f1d25f-fa3e-466b-b5c9-cf1c4f1581ab",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "His absence was unnecessarily long."
                            },
                            {
                                "example_id": "18d387b7-5f98-48e3-b579-228c8258cbb4",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "About the turn of the century, the company had several ambitious and costly plans in hand—including direct lines to the West Country, South Wales and Birmingham—and so had no wish to incur additional expenditure unnecessarily."
                            },
                            {
                                "example_id": "42c799f1-6d96-4c28-bea3-50a941561a29",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "[…] it seemed that she used his name unnecessarily often,"
                            },
                            {
                                "example_id": "79466a47-61c9-499c-b307-3ad3acff4b6e",
                                "sense_id": "d45f9789-0995-35c6-8e98-95ae648c18e4",
                                "text": "The pregame crew then showed a pair of faux-Super Bowl ads, including an unnecessarily woke Cheez-It commercial and a Papa John’s ad that fully embraces Pizzagaters."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92d59865-0a06-4fc4-a807-2e3037120a25",
                        "source_entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "source_sense_description": "in an unnecessary way",
                        "target_lang_word": "onnodig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onnodig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aca48df7-d0c6-3199-8164-ae3cd09d148c",
                                        "entry_id": "4956025c-04e3-377b-bd9c-1fbd05509a95",
                                        "glosses": [
                                            "niet noodzakelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b3a6571-0b73-4226-8ffc-6ac30772d04b",
                                                "sense_id": "aca48df7-d0c6-3199-8164-ae3cd09d148c",
                                                "text": "Nu concludeert het gerechtshof dat het intrekken van het reeds gepubliceerde rapport onnodig is, omdat de inhoud ervan al bekend is."
                                            },
                                            {
                                                "example_id": "5134e7a0-1f3a-4ed3-a721-e1380af89cf0",
                                                "sense_id": "aca48df7-d0c6-3199-8164-ae3cd09d148c",
                                                "text": "Ik gebruikte de eerste paar weken natte doekjes om me ’s avonds op te frissen en het stof en zweet weg te vegen, maar vond de doekjes al snel te veel onnodig gewicht om met me mee te dragen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb0c5cb9-0f5b-4928-8db0-f674064c72ca",
                        "source_entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "source_sense_description": "in an unnecessary way",
                        "target_lang_word": "inutilement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inutilement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                        "entry_id": "eb335352-0374-3444-86de-fdf091289a9f",
                                        "glosses": [
                                            "Sans utilité, d’une manière inutile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b18a0f7-703d-4bcb-b4d1-38bc1925121c",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Combien de fois pria-t-il le Sauveur des âmes, en baisant la croix, que son sang répandu pour lui ne le fût pas inutilement !"
                                            },
                                            {
                                                "example_id": "553f3fb7-6937-4ec9-8749-ac82d417aaf7",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était le sort des Français de vaincre inutilement en Italie ; les journées d’Agnadel, de Fornoue, de Ravenne, de Marignan, de Cérisoles, en sont des témoignages immortels."
                                            },
                                            {
                                                "example_id": "a2ef0bb4-92b5-4768-9831-95da388996c5",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "Séparé des divisions qui avaient inutilement tenté de le joindre, le général Serrurier désespéra de recevoir du secours."
                                            },
                                            {
                                                "example_id": "1a16cc84-4cca-4ed1-802a-a7b1314a3a08",
                                                "sense_id": "f9b3ca5d-7bf7-322b-87c0-124d53766c64",
                                                "text": "C’était inutilement que la mer était ouverte aux troupes britanniques, puisque sur toutes les côtes de l’Amérique on se préparait à les repousser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50ac6fa5-eed5-420f-b2dd-abfab9e9dba3",
                        "source_entry_id": "133b5115-e38e-334a-b33b-d1449216dfea",
                        "source_sense_description": "in an unnecessary way",
                        "target_lang_word": "gratuitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratuitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                        "entry_id": "8945a733-8b06-35b0-98b4-fe471271ba90",
                                        "glosses": [
                                            "D’une manière gratuite, pour rien, sans rétribution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13234d3-bfe1-4d88-b97f-dd47d80b6e26",
                                                "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                                "text": "Les visiteurs peuvent venir y jouer gratuitement à des jeux en bois et des jeux bretons, passe-trappe, mikado géant, mölkki."
                                            },
                                            {
                                                "example_id": "3144a9da-4083-474e-9fa3-c932ea6e5d31",
                                                "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                                "text": "Les rebouteux et les rebouteuses étaient également tolérés et même protégés, pourvu dit un arrêt de 1732, qu'ils exercent leur profession gratuitement ce qu'il était, même à cette époque, bien difficile de croire."
                                            },
                                            {
                                                "example_id": "7a622ee9-79ca-4d63-884e-9e6955d6b789",
                                                "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                                "text": "Satan lui répondit : Est-ce gratuitement que Job craint Dieu ?"
                                            },
                                            {
                                                "example_id": "6e5c77e8-2dbf-490c-b0b5-d97e982f9a7f",
                                                "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                                "text": "Nous n'avons mangé gratuitement le pain de personne."
                                            },
                                            {
                                                "example_id": "d1d4d3c5-d2b4-44c0-8e82-45c521043931",
                                                "sense_id": "01307790-7803-33af-ac59-24bb7a3bba3b",
                                                "text": "Nous croyons que nos péchés nous sont remis gratuitement par la miséricorde divine à cause de Jésus-Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                                        "entry_id": "8945a733-8b06-35b0-98b4-fe471271ba90",
                                        "glosses": [
                                            "Sans fondement, sans motif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f0ea78e-2a5e-4dc1-bbf2-4720d405b3f6",
                                                "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                                                "text": "Je n'ai jamais offensé personne ; ils [mes ennemis] m’accablent gratuitement."
                                            },
                                            {
                                                "example_id": "9d859dd8-2fe4-40bb-99fd-15d8ed13474e",
                                                "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                                                "text": "Nul n'est mauvais gratuitement ; il faut qu’il y ait une raison qui détermine, et cette raison est toujours une raison d’intérêt."
                                            },
                                            {
                                                "example_id": "1261be8d-f521-4890-9716-37ae226fef89",
                                                "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                                                "text": "Cet homme si gratuitement célébré par le philosophe de Ferney, était à la tête de la cabale."
                                            },
                                            {
                                                "example_id": "22178c98-c0f4-43e1-b433-45ea2609c833",
                                                "sense_id": "70e178a2-dc40-3fe6-87eb-56943216103e",
                                                "text": "Ça ne ressemblait pas à Gilles d'aller chercher gratuitement les emmerdes, mais si une nana le chauffait, comme tout les mecs, il était parfaitement capable de devenir idiot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
