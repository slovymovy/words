                        "glosses": [
                            "iemand (vooral over meisjes) die makkelijk en vaak lacht of giebelt en daarom wat dom wordt gevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b4cbd2-a110-41ca-b658-1a56d3b84f01",
                                "sense_id": "710c9bea-b985-396d-940c-604d5321c9c2",
                                "text": ",,Deze show is voor mij heel speciaal, zegt de lachebek, die meermaals meedeed aan het Eurovisie Songfestival. ,,Op het podium staan met deze show voelt als een cadeautje. Voor mij, maar vooral voor de mensen in de zaal. Alle ervaringen komen in het theater bij elkaar. Natuurlijk wordt het ook spannend. Want ze leren mij nóg beter kennen. Maar dat past wel bij mij."
                            },
                            {
                                "example_id": "b7c53423-b3b5-405d-9fd1-77ecf40cb6c6",
                                "sense_id": "710c9bea-b985-396d-940c-604d5321c9c2",
                                "text": "‘Iedereen weet dat ik een lachebek ben. Ik was gisteren en eergisteren al en vandaag doe ik verder.’"
                            }
                        ]
                    }
