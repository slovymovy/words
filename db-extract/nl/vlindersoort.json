                        "examples": [
                            {
                                "example_id": "dded66c8-0ef4-47cf-aed0-81354647360e",
                                "sense_id": "65a5b48f-16f8-3106-87dc-a7562fa25da5",
                                "text": "Op een groot eiland kan de populatie groeien tot misschien wel duizenden exemplaren en de overleving van de vlindersoort is daarmee verzekerd."
                            },
                            {
                                "example_id": "28e4dcd8-2d30-452d-b874-8e9b0efeb650",
                                "sense_id": "65a5b48f-16f8-3106-87dc-a7562fa25da5",
                                "text": "Janzen en zijn medewerkers begonnen te vermoeden dat er onder de clownspakjes meer dan één vlindersoort schuilging."
                            },
                            {
                                "example_id": "44f7eab9-8f66-4269-b741-f670887b32b9",
                                "sense_id": "65a5b48f-16f8-3106-87dc-a7562fa25da5",
                                "text": "De vlindersoort 'het gentiaanblauwtje' is bijvoorbeeld afhankelijk van de blauwe plant gentiaan. Die staat ook onder druk door de stijging van de temperatuur. \"En als de gentiaan verdwijnt, dan verdwijnt ook het gentiaanblauwtje.\""
                            }
                        ]
                    }
