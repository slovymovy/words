            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d56ae56e-b6e0-3ca5-9b68-897b597ac7a1",
                    "sense_definition": "Broyer des aliments avec les dents avant de les avaler.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mastication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien <w>mâcher</w> chaque bouchée pour faciliter la digestion."
                        },
                        {
                            "text": "L'enfant <w>mâche</w> lentement son morceau de pain avant de boire."
                        }
                    ],
                    "synonyms": [
                        "mastiquer"
                    ],
                    "common_phrases": [
                        "mâcher du chewing-gum",
                        "mâcher lentement"
                    ]
                },
                {
                    "sense_id": "524b2ed2-0da0-3cbd-ab3e-dd3b1f1bb9ed",
                    "sense_definition": "Préparer un travail de manière à rendre la tâche facile pour quelqu'un d'autre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faciliter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a <w>mâché</w> le travail de ses élèves en fournissant un plan complet."
                        },
                        {
                            "text": "Je t'ai <w>mâché</w> le travail, tu n'as plus qu'à rédiger le rapport final."
                        }
                    ],
                    "common_phrases": [
                        "mâcher le travail"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Expression familière"
                        }
                    ]
                },
                {
                    "sense_id": "c2088ee5-b055-37e6-9bd7-10cc91df8259",
                    "sense_definition": "Articuler ou prononcer des paroles d'une manière confuse ou timide.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il était furieux et ne cessait de <w>mâcher</w> des reproches entre ses dents."
                        },
                        {
                            "text": "Intimidé par le jury, le candidat <w>mâchait</w> ses réponses et personne ne le comprenait."
                        }
                    ],
                    "common_phrases": [
                        "mâcher ses mots"
                    ]
                },
                {
                    "sense_id": "2b05abce-4303-3f4f-8b20-7d991551e527",
                    "sense_definition": "Serrer et agiter de manière répétée un objet entre les dents sans chercher à l'avaler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mastication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stressé par l'examen, l'étudiant <w>mâchait</w> le bout de son stylo en réfléchissant."
                        },
                        {
                            "text": "Le vieux marin restait silencieux, <w>mâchant</w> sa pipe éteinte avec nostalgie."
                        }
                    ]
                },
                {
                    "sense_id": "7932476a-1050-328d-be47-752e0a7db70f",
                    "sense_definition": "Abîmer, écraser ou endommager une matière par pression ou usure.",
