                "senses": [
                    {
                        "sense_id": "ff494673-68cf-3692-8a95-2e6d27413ad0",
                        "entry_id": "8181535a-20c8-3eae-8e07-7a39ff14b9e9",
                        "glosses": [
                            "iemand die zo sterk meeloopt in een bepaalde opvatting dat hij sommige dingen niet kan begrijpen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2e797cef-146f-43ec-bf1f-a4e7f6762b8c",
                                "sense_id": "ff494673-68cf-3692-8a95-2e6d27413ad0",
                                "text": "Hij verwoestte alle natuurlijke geluksgevoel. Hij verpandde zich aan Bismarck. Hij verried zichzelf. Hij werd een burgerlijke kwezel na op de barricaden ener goede revolutie te hebben gevochten."
                            }
                        ]
                    },
                    {
                        "sense_id": "4116f4f7-30db-37ec-8f84-45f1c457f38a",
                        "entry_id": "8181535a-20c8-3eae-8e07-7a39ff14b9e9",
                        "glosses": [
                            "overdreven vroom persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "2f34e5b6-fcea-4f7a-9bad-e0e787e62fd5",
                                "sense_id": "4116f4f7-30db-37ec-8f84-45f1c457f38a",
                                "text": "In beide romans spelen ongetrouwde vrouwen, gebarricadeerde maagden, en godvrezende kwezels een hoofdrol."
                            }
                        ]
                    },
                    {
                        "sense_id": "96aa70d1-9675-3a3f-a6a3-177ebfbbafcc",
                        "entry_id": "8181535a-20c8-3eae-8e07-7a39ff14b9e9",
                        "glosses": [
                            "vrouw die een gelofte van kuisheid heeft gedaan, maar niet tot een religieuze orde behoort"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "152e0522-b922-4f04-8efa-2a171ad808f4",
                                "sense_id": "96aa70d1-9675-3a3f-a6a3-177ebfbbafcc",
                                "text": "Zeg Kwezelken, wilde gy dansen!\nIk zal u geven een ei.\nWel neen ik, zeî dat Kwezelken,\nVan dansen ben ik vry;\n'k En kan niet dansen,\n'k En mag niet dansen,\nDansen is onze regel niet,\nBegyntjes of Kwezelkens dansen niet."
                            }
                        ]
                    }
                ],
