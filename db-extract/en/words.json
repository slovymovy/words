                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf95eae9-f6f6-3a6a-9511-c792d900fb7e",
                        "entry_id": "f39b1e96-e07c-316a-8811-27a7744e51f2",
                        "glosses": [
