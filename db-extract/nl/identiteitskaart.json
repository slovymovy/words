                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Personalausweis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f167a7df-c3eb-3407-80fa-a20e48c515fb",
                                        "entry_id": "9ca02771-9c1f-36ff-9960-09c2949f8dee",
                                        "glosses": [
                                            "amtlicher Ausweis mit Lichtbild, Unterschrift und Personalien des Inhabers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35bd05b3-f040-46e8-a8fb-3c6effb2c690",
                                                "sense_id": "f167a7df-c3eb-3407-80fa-a20e48c515fb",
                                                "text": "Ist dein Personalausweis noch gültig?"
                                            },
                                            {
                                                "example_id": "b8cbaba4-71fd-476f-9bc1-f1677ecb3156",
                                                "sense_id": "f167a7df-c3eb-3407-80fa-a20e48c515fb",
                                                "text": "„Unter rechtlichen Aspekten läßt sich die nationale Flagge vergleichen mit Personalausweis oder Paß.“"
                                            },
                                            {
                                                "example_id": "b684d00a-e0d7-49f1-82bc-86c2ca025e4f",
                                                "sense_id": "f167a7df-c3eb-3407-80fa-a20e48c515fb",
                                                "text": "„Ich muss meinen Personalausweis vorlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
