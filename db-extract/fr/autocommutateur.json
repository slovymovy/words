                                "target_senses": [
                                    {
                                        "sense_id": "04b4ed30-3346-3c93-8ffd-90867461b08e",
                                        "entry_id": "4538fd5f-b0c4-31a6-b2af-3d4cb74c5ecb",
                                        "glosses": [
                                            "Any equipment that establishes connections between telephones."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d7023120-8865-3d36-8f6c-2a83cc659672",
                                        "entry_id": "4538fd5f-b0c4-31a6-b2af-3d4cb74c5ecb",
                                        "glosses": [
                                            "The rooms or building housing such equipment (a central office, as it was termed by the Bell System)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6be37fcb-0c9c-33ff-97aa-c807c572fe4d",
                                        "entry_id": "4538fd5f-b0c4-31a6-b2af-3d4cb74c5ecb",
                                        "glosses": [
                                            "A local or locoregional network of such switched connections, of which a central office was the hub; the local company formed to create and maintain this network and its central office."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d1a4ec9-6c50-497e-bcb0-45d1a54d0f91",
                                                "sense_id": "6be37fcb-0c9c-33ff-97aa-c807c572fe4d",
                                                "text": "This valley didn't have a telephone exchange until 1903, when the leading citizens of this town invested in a company to establish one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "876ce5e7-5c14-32dc-933f-4d4fc7e4785f",
                                        "entry_id": "4538fd5f-b0c4-31a6-b2af-3d4cb74c5ecb",
                                        "glosses": [
                                            "The portion of a telephone number representing that network, among the other networks of the larger system: the central office code. In the North American Numbering Plan, this is the \\\"555\\\" portion of \\\"+1-212-555-6789\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2947489c-9a08-406c-88ad-05a0882f86a9",
                                                "sense_id": "876ce5e7-5c14-32dc-933f-4d4fc7e4785f",
                                                "text": "A: You can telephone him at 2719. B: What's the [telephone] exchange? A: LA6. I'm sorry, that's LA6-2719."
                                            },
                                            {
                                                "example_id": "50e6f6a7-e736-4f62-b228-fe81488afd46",
                                                "sense_id": "876ce5e7-5c14-32dc-933f-4d4fc7e4785f",
                                                "text": "Holonyms: telephone number, phone number"
                                            }
                                        ]
                                    }
                                ]
                            }
