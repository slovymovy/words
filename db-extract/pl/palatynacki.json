                                    {
                                        "sense_id": "e7e690aa-c9f1-3065-b6ca-7b7ecb43c47f",
                                        "entry_id": "d125da15-e3d4-3847-9f05-1219373894e1",
                                        "glosses": [
                                            "auf die Region Pfalz in Rheinland-Pfalz bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b292cea6-02d6-49e6-8810-e32e4a994e37",
                                                "sense_id": "e7e690aa-c9f1-3065-b6ca-7b7ecb43c47f",
                                                "text": "Ich habe noch einen pfälzischen Wein anzubieten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f04cc616-83e3-3dde-9499-7ceb1a6db8f1",
                                        "entry_id": "d125da15-e3d4-3847-9f05-1219373894e1",
                                        "glosses": [
                                            "auf die dort gesprochenen Dialekte, das Pfälzische, bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bcaf6fa-a13a-4401-8364-9edc1457b7eb",
                                                "sense_id": "f04cc616-83e3-3dde-9499-7ceb1a6db8f1",
                                                "text": "Er sprach pfälzisch, deshalb konnte ich ihn nur schwierig verstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
