                "senses": [
                    {
                        "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                        "entry_id": "5d02fc1d-5b72-3888-8d9b-76b0c44fbd8b",
                        "glosses": [
                            "neunzehnter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd3a635c-b61d-4598-ac86-55a900ed732c",
                                "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                                "text": "Döbling wurde 1892 aus den ehemaligen Wiener Vororten Unterdöbling, Oberdöbling, Grinzing, Heiligenstadt, Nußdorf, Josefsdorf, Sievering und dem Kahlenbergerdorf gebildet."
                            },
                            {
                                "example_id": "cbc79d8c-6506-43c3-92b7-87636ab8c1e7",
                                "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                                "text": "Dem vor einem Jahr verstorbenen Entertainer Peter Alexander wurde gleich ein ganzer Platz in seinem Heimatbezirk Döbling gewidmet."
                            },
                            {
                                "example_id": "4c22e3b2-6684-421c-952f-d0866c1e2054",
                                "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                                "text": "Man sah einander zum dritten Mal bei Mahlers Antrittsbesuch, den er wenige Tage später in Almas Elternhaus auf der Hohen Warte, im Wiener Nobelbezirk Döbling, abstattete."
                            },
                            {
                                "example_id": "02ece18c-4107-4053-8eb7-f437ab4af95d",
                                "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                                "text": "Der Wertheimstein-Park in Wien-Döbling wurde von Lepolds Tochter Franziska testamentarisch der Öffentlichkeit vermacht."
                            },
                            {
                                "example_id": "51b1bdb1-6d02-4d81-a21b-8d56149789aa",
                                "sense_id": "56f12fd1-aa21-3f5f-ab3d-785a0d21ff0a",
                                "text": "Besonders in Döbling wurden kurzfristig Straßen überschwemmt, auch Hagelkörner mit bis zu zwei Zentimeter Durchmesser gingen nieder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
