                ],
                "senses": [
                    {
                        "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                        "entry_id": "34a803da-f381-363a-97ee-c8b19f78f542",
                        "glosses": [
                            "Abschnitt eines vordefinierten Teils eines Studiums, oft auch offiziell anerkannt und mit einem Sammelzeugnis amtlich bestätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd67ac4-c726-4633-aefa-1b24d431fc0d",
                                "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                                "text": "Da ihm wegen einer Prüfung der erste Studienabschnitt noch fehlt, kann er frühestens in sechs Monaten die Diplomarbeit abgeben."
                            },
                            {
                                "example_id": "7c909455-8239-4868-a3f7-f623652d9168",
                                "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                                "text": "Da Eva den ersten Studienabschnitt der Elektrotechnik abgeschlossen hatte, wurde sie besser bezahlt als Johannes."
                            },
                            {
                                "example_id": "4c6e8b9a-0a83-4ac5-a625-ac65272e3091",
                                "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                                "text": "Zahlreiche weitere Daten können für die Standortwahl herangezogen werden, zum Beispiel die Anteile der nicht bestandenen Prüfungen im ersten und zweiten Studienabschnitt oder das Angebot an Modellstudiengängen in der Humanmedizin."
                            },
                            {
                                "example_id": "22de522a-3de3-49bd-ace9-7bd34c0ee7c8",
                                "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                                "text": "Insbesondere schreibt die neue Approbationsordnung mindestens 56 Stunden Seminare mit klinischen Bezügen im vorklinischen Studienabschnitt vor."
                            },
                            {
                                "example_id": "f2a5da20-1abc-4905-9919-20fa116bf641",
                                "sense_id": "6dad338e-c766-399a-ac7b-0a72b12082c9",
                                "text": "„Im übrigen ist nicht erkennbar, warum der Beschwerdeführer, der - unter Außerachtlassung der im Gesetz enthaltenen, oben beschriebenen Beweisregel - die Auffassung vertritt, auch bei ordentlichen Hörern des ersten Studienabschnittes könne man sich ohne Beibringung der im Gesetz geforderten Nachweise darauf berufen, das Studium werde ernsthaft und zielstrebig betrieben, der Meinung ist, sein Sohn, der seit der Erstinskription an der Universität Wien keine einzige Prüfung absolviert hat, habe das ordentliche Studium ernsthaft und zielstrebig betrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
