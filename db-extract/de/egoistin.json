                                "target_senses": [
                                    {
                                        "sense_id": "e0b6a372-1d51-3345-bddd-cb18f70a09fd",
                                        "entry_id": "55b6243d-638b-3236-af94-337a53eec020",
                                        "glosses": [
                                            "individuo che ha [solo] un amore e/o brama per la \\\"propria persona\\\", per i propri e per gli altrui beni soltanto per sé stesso, che non tiene conto delle altrui esigenze"
                                        ],
