                        "examples": [
                            {
                                "example_id": "afe1c9fe-cceb-42d3-b875-fe60e68c11b4",
                                "sense_id": "b01fe547-9520-39d5-a4bd-5f9c13192c6d",
                                "text": "„Gemeinsam tranken sie nach der Vertragsunterzeichnung ein Cüpli und schwelgten nostalgisch im Fussball der sechziger Jahre.“"
                            },
                            {
                                "example_id": "a624c544-b3a4-414b-a472-232d5e089601",
                                "sense_id": "b01fe547-9520-39d5-a4bd-5f9c13192c6d",
                                "text": "„Mit anderen Freiwilligen kümmern sie sich um Künstler und verkaufen während der Spiele Cüpli – Bier gibt es im Salon Erika keines.“"
                            },
                            {
                                "example_id": "a02bdf73-629d-4d1a-b37e-61f6fffd6bf6",
                                "sense_id": "b01fe547-9520-39d5-a4bd-5f9c13192c6d",
                                "text": "„das Cüpli ist ein Glas Champagner, kein Sekt oder Prosecco!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
