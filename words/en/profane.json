{
    "word_family": [
        "profanation",
        "profanatory",
        "profanely",
        "profaneness",
        "profanity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b15f74a8-f27d-39cc-80c8-054f49c7a29f",
                    "sense_definition": "Using swear words or vulgar language; irreverent toward religious or sacred topics.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irreverent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee warned the player after he shouted <w>profane</w> words across the pitch.",
                            "target_lang_translations": {
                                "ru": "Судья сделал предупреждение игроку после того, как тот выкрикнул <w>бранные</w> слова через всё поле."
                            }
                        },
                        {
                            "text": "Parents complained about the <w>profane</w> language used frequently throughout the movie.",
                            "target_lang_translations": {
                                "ru": "Родители жаловались на <w>нецензурную</w> лексику, которая часто звучала на протяжении всего фильма."
                            }
                        }
                    ],
                    "synonyms": [
                        "irreverent",
                        "vulgar",
                        "obscene"
                    ],
                    "antonyms": [
                        "religious",
                        "faithful"
                    ],
                    "common_phrases": [
                        "profane language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сквернословный, матерный или непочтительный к религиозным и священным темам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквернословный",
                                "target_lang_sense_clarification": "о речи или выражениях"
                            },
                            {
                                "target_lang_word": "нецензурный",
                                "target_lang_sense_clarification": "о лексике или словах"
                            },
                            {
                                "target_lang_word": "богохульный",
                                "target_lang_sense_clarification": "оскверняющий святыни, кощунственный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d55da31-67ba-35a8-9311-71d12abf7ee1",
                    "sense_definition": "Relating to non-religious or secular matters; worldly rather than sacred.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "secular",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian studied both religious texts and <w>profane</w> literature from the Renaissance period.",
                            "target_lang_translations": {
                                "ru": "Историк изучал как религиозные тексты, так и <w>светскую</w> литературу эпохи Возрождения."
                            }
                        },
                        {
                            "text": "In sociology, the distinction between the sacred and the <w>profane</w> is central to understanding human culture.",
                            "target_lang_translations": {
                                "ru": "В социологии различие между сакральным и <w>профанным</w> играет центральную роль в понимании человеческой культуры."
                            }
                        }
                    ],
                    "synonyms": [
                        "secular",
                        "temporal",
                        "worldly"
                    ],
                    "antonyms": [
                        "sacred",
                        "holy",
                        "spiritual"
                    ],
                    "common_phrases": [
                        "sacred and profane"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светский, мирской; не имеющий отношения к религии или культу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светский",
                                "target_lang_sense_clarification": "нерелигиозный"
                            },
                            {
                                "target_lang_word": "мирской",
                                "target_lang_sense_clarification": "земной, противопоставленный священному"
                            },
                            {
                                "target_lang_word": "профанный",
                                "target_lang_sense_clarification": "в философии и религиоведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d7ec957-e697-30b0-88a2-da21a0aa13b3",
                    "sense_definition": "Showing active disrespect, contempt, or irreverence toward religious or sacred things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irreverent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>profane</w> remarks about the ancient temple offended the local worshipers.",
                            "target_lang_translations": {
                                "ru": "Его <w>кощунственные</w> замечания о древнем храме оскорбили местных верующих."
                            }
                        },
                        {
                            "text": "The author faced heavy criticism for his openly <w>profane</w> attitudes toward revered traditions.",
                            "target_lang_translations": {
                                "ru": "Автор столкнулся с жёсткой критикой за своё открыто <w>святотатственное</w> отношение к почитаемым традициям."
                            }
                        }
                    ],
                    "synonyms": [
                        "blasphemous",
                        "impious",
                        "ungodly"
                    ],
                    "antonyms": [
                        "orthodox",
                        "sacrosanct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий открытое неуважение, презрение или непочтительность к религии и святыням."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богохульный",
                                "target_lang_sense_clarification": "выражающий святотатство"
                            },
                            {
                                "target_lang_word": "кощунственный",
                                "target_lang_sense_clarification": "оскорбляющий чувства верующих или традиции"
                            },
                            {
                                "target_lang_word": "нечестивый",
                                "target_lang_sense_clarification": "лишенный благочестия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "319e0ec4-a605-3371-8db1-0ef909fe9a4c",
                    "sense_definition": "Ritually impure, defiled, or treated without the sanctity required of a holy place or object.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "secular",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They believed that allowing outsiders into the shrine would render it completely <w>profane</w>.",
                            "target_lang_translations": {
                                "ru": "Они верили, что допуск чужаков в святилище сделает его совершенно <w>осквернённым</w>."
                            }
                        },
                        {
                            "text": "Ancient laws forbade touching the altar with unclean hands, lest it become <w>profane</w>.",
                            "target_lang_translations": {
                                "ru": "Древние законы запрещали прикасаться к алтарю нечистыми руками, чтобы он не стал <w>нечистым</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unholy",
                        "unhallowed",
                        "unsanctified"
                    ],
                    "antonyms": [
                        "holy",
                        "sacred"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритуально нечистый, осквернённый или лишённый священного статуса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нечестивый",
                                "target_lang_sense_clarification": "нечистый, греховный"
                            },
                            {
                                "target_lang_word": "осквернённый",
                                "target_lang_sense_clarification": "лишившийся святости"
                            },
                            {
                                "target_lang_word": "несвященный",
                                "target_lang_sense_clarification": "не освящённый ритуалом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bc17b611-f825-3f42-b533-892d3b4bc6c0",
                    "sense_definition": "To violate, disrespect, or treat something sacred with contempt; to desecrate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "defile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vandals managed to <w>profane</w> the historic chapel by painting graffiti over the altar.",
                            "target_lang_translations": {
                                "ru": "Вандалы умудрились <w>осквернить</w> историческую часовню, разрисовав алтарь граффити."
                            }
                        },
                        {
                            "text": "Many elders felt that turning the old cemetery into a parking lot would <w>profane</w> the site.",
                            "target_lang_translations": {
                                "ru": "Многие старейшины считали, что превращение старого кладбища в парковку <w>осквернит</w> это место."
                            }
                        }
                    ],
                    "synonyms": [
                        "desecrate",
                        "defile",
                        "unhallow"
                    ],
                    "antonyms": [
                        "consecrate",
                        "sanctify"
                    ],
                    "common_phrases": [
                        "profane the name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осквернять, порочить или относиться к священным вещам с презрением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осквернять",
                                "target_lang_sense_clarification": "попирать святыню"
                            },
                            {
                                "target_lang_word": "порочить",
                                "target_lang_sense_clarification": "бесчестить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d98dcc9-8607-352f-9a36-7de169c2bdd6",
                    "sense_definition": "To debase, abuse, or put something valuable to an unworthy use.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics accused the commercial network of attempting to <w>profane</w> the solemn ceremony for profit.",
                            "target_lang_translations": {
                                "ru": "Критики обвинили коммерческую телесеть в попытке <w>опошлить</w> торжественную церемонию ради наживы."
                            }
                        },
                        {
                            "text": "He felt that singing trivial songs would <w>profane</w> the true spirit of serious artistic music.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что исполнение легкомысленных песенок <w>обесценит</w> подлинный дух серьёзного музыкального искусства."
                            }
                        }
                    ],
                    "synonyms": [
                        "degrade",
                        "demean",
                        "pervert",
                        "misuse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Унижать, опошлять или использовать что-либо возвышенное и ценное в недостойных целях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опошлять",
                                "target_lang_sense_clarification": "сводить к низменному"
                            },
                            {
                                "target_lang_word": "профанировать",
                                "target_lang_sense_clarification": "искажать или опошлять идею, учение"
                            },
                            {
                                "target_lang_word": "обесценивать",
                                "target_lang_sense_clarification": "умалять значимость"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd317993-3538-3cac-91cf-ae6d906a5b8b",
                    "sense_definition": "A person who is not initiated into religious rites, a secret society, or a sacred order.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uninitiated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sacred mysteries were carefully guarded so that no <w>profane</w> could ever witness them.",
                            "target_lang_translations": {
                                "ru": "Священные мистерии тщательно охранялись, чтобы ни один <w>непосвящённый</w> не мог стать их свидетелем."
                            }
                        },
                        {
                            "text": "Guards stood outside the inner sanctuary to turn away any wandering <w>profane</w>.",
                            "target_lang_translations": {
                                "ru": "Стражники стояли у входа во внутреннее святилище, чтобы прогонять любого забредшего <w>профана</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used outside historical, religious, or fraternal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не посвящённый в религиозные таинства, тайные общества или священный орден."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непосвящённый",
                                "target_lang_sense_clarification": "человек вне ордена или таинств"
                            },
                            {
                                "target_lang_word": "профан",
                                "target_lang_sense_clarification": "в контексте мистерий и тайных обществ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d19c6ac1-2e36-3a3a-bf17-4ffca0648303",
                    "sense_definition": "A person who is not a member of Freemasonry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uninitiated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lodge doors remained firmly closed to any <w>profane</w> during the ritual proceedings.",
                            "target_lang_translations": {
                                "ru": "Двери ложи оставались наглухо закрытыми для любого <w>профана</w> во время ритуальных действий."
                            }
                        },
                        {
                            "text": "He lived as a <w>profane</w> until he was finally accepted and initiated by the local lodge.",
                            "target_lang_translations": {
                                "ru": "Он жил как <w>непосвящённый</w>, пока его наконец не приняли и не инициировали в местную ложу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, не состоящий в масонской ложе (не масон)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "профан",
                                "target_lang_sense_clarification": "немасон"
                            },
                            {
                                "target_lang_word": "непосвящённый",
                                "target_lang_sense_clarification": "не принадлежащий к масонству"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}