                "senses": [
                    {
                        "sense_id": "7b2bd614-d41a-3be5-bbdf-842d9b138ace",
                        "entry_id": "ff8e7bcc-304d-3a90-9564-eedf242d3fe8",
                        "glosses": [
                            "wool of a certain kind of goats (Capra hircus angorensis); somtimes extented to wool of certain kinds of sheep or rabbits"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "1b69db2a-32d6-4f14-bce7-28c4bbdc1ecb",
                                "sense_id": "7b2bd614-d41a-3be5-bbdf-842d9b138ace",
                                "text": "Angorawolle ist eine besonders weiche Wolle, oft auch Mohair genannt. Sie wird aus den langen feinen Haaren des Angoraschafs, der Angoraziege sowie des Angorakaninchens gesponnen."
                            },
                            {
                                "example_id": "1ff415f4-eca9-4d01-b660-cf9db5360aeb",
                                "sense_id": "7b2bd614-d41a-3be5-bbdf-842d9b138ace",
                                "text": "1909, Meyers Großes Konversations-Lexikon, vol. 19, p. 550, s.v. Tiftik (bolding changed into italics)",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "aea3eaab-5efe-41d7-8e70-5c2e0f37f73b",
                                "sense_id": "7b2bd614-d41a-3be5-bbdf-842d9b138ace",
                                "text": "Angorawolle, Kämelwolle […], Kamelot, Mohair, Tiftik, […] ist das Haarkleid der Angoraziege (Capra hircus angorensis L.), […] Die Verwendung der Angorawolle ist eine sehr umfangreiche; […]"
                            }
                        ]
                    }
                ],
