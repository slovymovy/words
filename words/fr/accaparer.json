{
    "word_family": [
        "accaparement",
        "accapareur",
        "accapareuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92bfdf31-5c2c-3ffd-9276-e7d98cbbe241",
                    "sense_definition": "S'emparer entièrement d'une personne, d'un objet ou d'un droit de manière exclusive et sans partage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclusivite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant toute la soirée, cet invité bavard n'a cessé d'<w>accaparer</w> la parole devant le groupe."
                        },
                        {
                            "text": "Ne laisse pas ton collègue <w>accaparer</w> tout le matériel indispensable pour notre projet commun."
                        }
                    ],
                    "synonyms": [
                        "monopoliser",
                        "confisquer"
                    ],
                    "antonyms": [
                        "partager"
                    ],
                    "common_phrases": [
                        "accaparer la parole",
                        "accaparer l'attention"
                    ]
                },
                {
                    "sense_id": "9264a2fe-01af-3b76-8315-1a9ee2f6d93b",
                    "sense_definition": "Prendre tout le temps, absorber l'énergie ou occuper totalement l'esprit de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit_temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses nouvelles responsabilités professionnelles finissent par <w>accaparer</w> tout son temps libre."
                        },
                        {
                            "text": "Ce dossier difficile <w>accapare</w> nos esprits depuis le début de la semaine."
                        }
                    ],
                    "synonyms": [
                        "absorber",
                        "mobiliser",
                        "préoccuper"
                    ],
                    "antonyms": [
                        "libérer"
                    ],
                    "common_phrases": [
                        "accaparer tout le temps",
                        "accaparer les esprits"
                    ]
                },
                {
                    "sense_id": "4f420c54-af03-3653-b7a8-70a519f3353a",
                    "sense_definition": "Acheter ou retenir une marchandise en grande quantité pour créer une pénurie et en maîtriser le cours.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En période de crise, certains marchands tentent d'<w>accaparer</w> les denrées pour faire monter les prix."
                        },
                        {
                            "text": "Cette grande société est accusée de vouloir <w>accaparer</w> le marché des céréales."
                        }
                    ],
                    "synonyms": [
                        "thésauriser",
                        "monopoliser"
                    ],
                    "antonyms": [
                        "distribuer"
                    ],
                    "common_phrases": [
                        "accaparer les denrées",
                        "accaparer le marché"
                    ]
                }
            ]
        }
    ]
}