                "senses": [
                    {
                        "sense_id": "14307cd6-5bf6-3e7b-a4d8-21f574d7236b",
                        "entry_id": "5891f8b7-582d-3281-b392-53ca0705a0b3",
                        "glosses": [
                            "A shallow basin, sometimes ornamental, filled with water for wild birds to drink from or in which to bathe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9e40f4a2-80ab-3432-a8bc-d647372a9f80",
                        "entry_id": "5891f8b7-582d-3281-b392-53ca0705a0b3",
                        "glosses": [
                            "Random, inconsequential amounts of residual water on a roof membrane."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc394d45-24c4-3ac5-8711-1e2249b6ba44",
                        "entry_id": "5891f8b7-582d-3281-b392-53ca0705a0b3",
                        "glosses": [
                            "A light or superficial wash of the body, using a sink or similar."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "38bc6e3f-161a-4a0b-ba67-9263e4c1a95d",
                                "sense_id": "dc394d45-24c4-3ac5-8711-1e2249b6ba44",
                                "text": "Hardly an hour had gone by, barely time to drink a cold sarsaparilla and take a birdbath in a bowl of water, but Kincaid had gotten into more trouble, Angie reflected."
                            },
                            {
                                "example_id": "c2f13bb5-640e-47ac-ab35-cbc23fa48ac5",
                                "sense_id": "dc394d45-24c4-3ac5-8711-1e2249b6ba44",
                                "text": "“And if a person happens not to be on the block at shower time?” Ty pinched the bridge of his nose.“It’s birdbath time,” Ralph pointed at the sink before remembering Ty was blind."
                            },
                            {
                                "example_id": "acb84fc6-1c60-48dd-90c8-137b13742ea7",
                                "sense_id": "dc394d45-24c4-3ac5-8711-1e2249b6ba44",
                                "text": "There was nowhere for us to wash and to prepare ourselves for work and school, so I decided to drive to a nearby gas station. We took a quick birdbath, washed our faces, and brushed our teeth."
                            }
                        ]
                    }
                ],
