                "senses": [
                    {
                        "sense_id": "50135816-62ea-308c-9705-dd5de3442af7",
                        "entry_id": "3b1ea8a8-a0d8-30e5-a01b-eef47bc4d016",
                        "glosses": [
                            "Action de majorer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bec543f-4d9c-4b4d-b626-900b07ac9b27",
                                "sense_id": "50135816-62ea-308c-9705-dd5de3442af7",
                                "text": "Ces marchandises ont subi une majoration, ont été l’objet de plusieurs majorations successives."
                            },
                            {
                                "example_id": "37db22ef-1608-48c5-aa84-b9fab430c647",
                                "sense_id": "50135816-62ea-308c-9705-dd5de3442af7",
                                "text": "Tout d’abord, la majoration des prix de la tonne de cristal produite par la Verrerie Cristallerie d’Arques appraraît encore plus lissée et les deux chocs pétroliers ne sont absolument pas décélables sur ce graphique."
                            },
                            {
                                "example_id": "90c4e170-9d01-4780-bd2b-7c091e5717ab",
                                "sense_id": "50135816-62ea-308c-9705-dd5de3442af7",
                                "text": "La majoration d’un mémoire d’entrepreneur."
                            },
                            {
                                "example_id": "b3e0cfea-a7a4-47f4-9005-94754b86f4b1",
                                "sense_id": "50135816-62ea-308c-9705-dd5de3442af7",
                                "text": "La majoration trouvée permet d’affirmer la convergence de la série."
                            }
                        ]
                    }
                ],
