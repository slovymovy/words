                        "entry_id": "331c5b79-3721-3037-885d-26e7956e2153",
                        "glosses": [
                            "Moniale de l’ordre des Frères prêcheurs fondé par Dominique de Guzmán au xiiiᵉ siècle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80a2fb84-4c29-4782-9f3c-460e799accbc",
                                "sense_id": "c464ee2c-1c16-3925-91a3-f65761451091",
                                "text": "Dès qu’elle sait épeler, ses parents la mettent en pension dans un couvent de Dominicaines, situé près de Bruxelles."
                            },
                            {
                                "example_id": "b33931d9-d86b-41a4-9822-56ecce65a5b1",
                                "sense_id": "c464ee2c-1c16-3925-91a3-f65761451091",
                                "text": "En 1866, le père Lataste fonde les dominicaines de Béthanie, ordre contemplatif constitué en partie d’anciennes prisonnières ou prostituées dont le passé est ignoré des autres religieuses."
                            }
                        ]
                    }
