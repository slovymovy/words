                        "cross_references": [
                            {
                                "target_word": "go crazy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5af9103-92f0-3464-afd4-1db94b7a80b9",
                                        "entry_id": "848ef4cd-279f-3ff7-a251-ff251a2272b6",
                                        "glosses": [
                                            "To suddenly behave irrationally; to go mad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147c0b9c-7cc5-4c55-a295-0bf75b2e683e",
                                                "sense_id": "f5af9103-92f0-3464-afd4-1db94b7a80b9",
                                                "text": "The night Santa went crazy\nThe night Kris Kringle went nuts\nNow you can't hardly walk around the North Pole\nWithout steppin' in reindeer guts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6f6d8ff-bdf9-3a74-89d8-3e23fe9d66a7",
                                        "entry_id": "848ef4cd-279f-3ff7-a251-ff251a2272b6",
