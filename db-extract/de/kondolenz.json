                                        "glosses": [
                                            "Comfort, support or sympathy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fd03d18-7392-4599-a1b2-a110e4a59c87",
                                                "sense_id": "8e444be4-6b94-302e-b0f0-60a7a9bc4974",
                                                "text": "There was not much to do after the accident but offer what condolence I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58d6d08a-7503-3703-85e0-45b645652027",
                                        "entry_id": "991ff690-89bf-3bae-a797-52e07b04bdb8",
                                        "glosses": [
                                            "An expression of comfort, support, or sympathy offered to the family and friends of somebody who has died."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c94f933f-7be8-4b55-9e1c-24667e34b983",
                                                "sense_id": "58d6d08a-7503-3703-85e0-45b645652027",
                                                "text": "I sent her a card expressing my condolences after her mother passed away."
                                            }
                                        ]
                                    }
                                ]
                            }
