                        "source_sense_id": "19134560-e9d6-3404-a243-0aaae2413b62",
                        "source_sense_description": "model dat gebruikt wordt om diverse bedrijfsaspecten in kaart te brengen en te beheren",
                        "target_lang_word": "business model",
                        "target_lang_code": "en",
