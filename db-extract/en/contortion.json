                    {
                        "translation_id": "d72a0220-70dd-4e14-9cd8-8184cd1e09ac",
                        "source_entry_id": "1372d2be-1bcf-3ace-ab5f-130950d2a8ae",
                        "source_sense_description": "the act of contorting",
                        "target_lang_word": "contorsión",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contorsión",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c34472-3fca-3fd0-b610-9a0292cd24cd",
                                        "entry_id": "05cc4238-8a72-31d8-b38b-80f2d0f5b2e8",
                                        "glosses": [
                                            "Proceso y resultado de mover, encoger, torcer o doblar de manera voluntaria o involuntaria el cuerpo o parte de él, hacia posiciones anormales, forzadas y a veces grotescas."
                                        ],
                                        "tags": [],
