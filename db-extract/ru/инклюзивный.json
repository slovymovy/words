                                        "entry_id": "ffa38ff5-f40c-379e-b073-12bf5d9b66d6",
                                        "glosses": [
                                            "Including the extremes as well as the area between."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "352c237d-f947-4c17-b9aa-91b401e1c5e8",
                                                "sense_id": "7905a15b-8665-3a46-9404-6635ca2da856",
                                                "text": "numbers 1 to 10 inclusive"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c2f585-ce3d-3834-9ab5-49eb8db220af",
                                        "entry_id": "ffa38ff5-f40c-379e-b073-12bf5d9b66d6",
                                        "glosses": [
                                            "Of, or relating to the first-person plural pronoun when including the person being addressed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "280f75e2-9013-4346-a921-1fcecc49009d",
                                                "sense_id": "c5c2f585-ce3d-3834-9ab5-49eb8db220af",
                                                "text": "The pronoun in \"If you want, we could go back to my place for coffee\" is an inclusive \"we\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "971ded88-a839-33cf-9b6c-25bc82c89f48",
                                        "entry_id": "ffa38ff5-f40c-379e-b073-12bf5d9b66d6",
                                        "glosses": [
                                            "Including or accepting those belonging to a particular group."
                                        ],
