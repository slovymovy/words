                "senses": [
                    {
                        "sense_id": "53386d72-8f31-3514-94bf-2b4000bf44bb",
                        "entry_id": "2daa16f4-b240-3f7b-8ab0-88a9d7ea3a9b",
                        "glosses": [
                            "Tanz- und Festveranstaltung am Ende einer Veranstaltung, zum Beispiel am Ende eines Tanzkurses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcede58-d69f-4d8c-88f4-7da3178dc6ab",
                                "sense_id": "53386d72-8f31-3514-94bf-2b4000bf44bb",
                                "text": "Das Ende eines Tanzkurses wird mit einem Abschlussball begangen."
                            },
                            {
                                "example_id": "9b8e0a6d-ff8a-4971-a48c-bd1e8eaf43f5",
                                "sense_id": "53386d72-8f31-3514-94bf-2b4000bf44bb",
                                "text": "„Das Mädchen, dem ich vorgeschlagen würde, mit mir den Abschlussball zu machen, könnte einen Lachanfall bekommen.“"
                            },
                            {
                                "example_id": "0993185e-d765-4642-a87a-84e025f7139b",
                                "sense_id": "53386d72-8f31-3514-94bf-2b4000bf44bb",
                                "text": "„Im letzten Jahr auf der Highschool gingen Philip und Marty Weich mit Betty Rogow und Joan Gelfman, zwei hübschen Cousinen, aus; die beiden waren auch ihre Partnerinnen beim Abschlussball.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
