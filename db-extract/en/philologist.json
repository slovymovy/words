                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "028891aa-f06f-429d-80ce-3f8e73aa7d34",
                        "entry_id": "09b50a2d-a5f5-3bac-8db3-39f9ec6e71f9",
