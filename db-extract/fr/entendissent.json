        "fr-extract.jsonl": [
            {
                "entry_id": "8bd259e6-783e-35f0-a366-41a6a049a7a7",
                "word": "entendissent",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "975d6b04-461e-440d-912e-363ef357741c",
