                ],
                "senses": [
                    {
                        "sense_id": "25d820cc-3f53-3985-b133-f0dd4ecb44df",
                        "entry_id": "115f8155-05ec-35ea-9d74-23394cfcc342",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным горшок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b67b967-2b0d-4b2d-8a6b-4b12899d8132",
                                "sense_id": "25d820cc-3f53-3985-b133-f0dd4ecb44df",
                                "text": "«Да то, — говорю, — полагаю, что не завелась ли там на твое место тоже какая-нибудь пирожная мастерица, горшечная пагубница»."
                            },
                            {
                                "example_id": "c39837e2-736d-4ab6-b13e-5b787ee9943b",
                                "sense_id": "25d820cc-3f53-3985-b133-f0dd4ecb44df",
                                "text": "В колхозах района неудовлетворительно организована пропаганда применения горшечной рассады овощных культур, квадратно-гнездового и квадратного способа сева и посадок."
                            }
                        ]
                    }
