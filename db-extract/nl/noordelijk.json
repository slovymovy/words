                ],
                "senses": [
                    {
                        "sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
                        "entry_id": "b4ed1c44-3ded-3248-9eb3-689fd85165de",
                        "glosses": [
                            "wat betreft het noorden, in het noorden gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ff4f4c-b5c5-4ac0-9608-6725548356e0",
                                "sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
                                "text": "De noordelijkste staat van de Verenigde Staten is Alaska."
                            },
                            {
                                "example_id": "f3612a0c-ba89-452a-86e3-8fe0ac1689f6",
                                "sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
                                "text": "Ik kon me nauwelijks voorstellen dat het landschap nog mooier kon worden, maar hoe noordelijker ik kwam hoe indrukwekkender de uitzichten werden."
                            },
                            {
                                "example_id": "2c64fdbe-5c0f-4802-87c4-78e82fec6e72",
                                "sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
                                "text": "Ik daalde af naar het laatste dal, liep een drassig bos in en bereikte na bijna zes maanden eindelijk de grenspalen, de noordelijke Terminus genoemd, op de grens met Canada."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2aa96b7-2f1a-4edc-a631-f153fd1bf8b2",
                        "source_entry_id": "b4ed1c44-3ded-3248-9eb3-689fd85165de",
                        "source_sense_id": "e4209d38-6e87-35b8-ab30-09237474b55a",
