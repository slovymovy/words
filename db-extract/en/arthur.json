                                                "sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
                                                "text": "Pan Artur ma firmę remontowo-budowlaną w Legnicy."
                                            },
                                            {
                                                "example_id": "49ee20d8-b83b-4a8a-a077-e09efce81f1d",
                                                "sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
