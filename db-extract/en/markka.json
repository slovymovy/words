                                                "sense_id": "01fcbc85-ee1b-384f-bbbc-a16dcb1edcf8",
                                                "text": "Echter Sago wird aus dem Mark von Palmen gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c321a090-963b-307b-af25-d6dce1023c41",
                                        "entry_id": "c9913a71-1575-35d1-8d27-9da9ef2ac6a6",
                                        "glosses": [
                                            "Püree meist aus Gemüse oder Obst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d723083-61a2-41a6-ae79-888142adc47f",
                                                "sense_id": "c321a090-963b-307b-af25-d6dce1023c41",
                                                "text": "Mark von Paprika und Tomaten wird in der südländischen Küche sehr verbreitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0360f8-1cf3-3374-82fd-824f5a2e0b07",
                                        "entry_id": "78d88c7f-d4c8-3682-a44b-898998a1aac6",
