                                        "sense_id": "99e080d7-0dac-3076-96b8-2c703cacc791",
                                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                                        "glosses": [
                                            "Action de griller, manière d’apprêter certains morceaux de viande ou de poisson en les grillant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bf1ff39-dbca-456c-97a5-6fc39e32d10d",
                                                "sense_id": "99e080d7-0dac-3076-96b8-2c703cacc791",
                                                "text": "Mettre des tranches de filet de bœuf à la grillade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cd9e418-4556-34ea-ab4f-8892dcb1ddc3",
                                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                                        "glosses": [
                                            "Action de griller, manière d’apprêter certains morceaux de viande ou de poisson en les grillant.",
                                            "Se dit aussi de personnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d51583-f0fb-4404-b7b6-5fb0522e928e",
                                                "sense_id": "5cd9e418-4556-34ea-ab4f-8892dcb1ddc3",
                                                "text": "Non, non, j’ai pris sur-le-champ la résolution d’aider à quelque bonne œuvre, comme à la grillade d’une sorcière, à un combat judiciaire ou à quelque service pareil, et voilà pourquoi je suis ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                                        "entry_id": "f9b33fdc-d404-3674-872f-29347b112ede",
                                        "glosses": [
                                            "Ces viandes et ces poissons grillés."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15bce340-47f1-4cdb-bebf-d284d0008b31",
                                                "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                                                "text": "Ce soir les hommes ont allumé un brasier et nous avons dîné de succulentes grillades, merguez et côtes d'agneau. Nous avons même bu un verre de boulaouane, mais discrètement."
                                            },
                                            {
                                                "example_id": "5f87bb37-c690-4120-85c0-391b805e0c77",
                                                "sense_id": "d61d4c02-e424-30eb-9b58-24cca865801c",
                                                "text": "Grillade d’agneau, de porc. Grillade de saumon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
