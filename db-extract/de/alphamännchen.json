                        ],
                        "examples": [
                            {
                                "example_id": "7f74c5cc-69f5-4279-9576-464c9680e1d3",
                                "sense_id": "11926f23-f8a1-38e2-b821-658fe96aa7b2",
                                "text": "Das Territorium des Rudels wird vom Alphamännchen durch seinen Duft markiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a0483dfc-1e22-35d3-9ec1-955f99c70ee8",
                        "entry_id": "36b7b46f-0c3e-32e8-8f13-70d929fb3b53",
                        "glosses": [
                            "Führungsperson, die sich (übertrieben) machtbewusst zeigt"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "600b9f3b-9e71-4a2a-8a3f-f8582dbfbe7f",
                                "sense_id": "a0483dfc-1e22-35d3-9ec1-955f99c70ee8",
                                "text": "Weil dem die Fifa in Gutsherrenart regierenden Blatter bei der Wada aber in Richard Pound ein weiteres Alphamännchen gegenüberstand, wurde der Konflikt über die Länge von Regelsperren bei Dopingvergehen unnötig dramatisiert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "113d1781-3f11-4704-ac53-f73aedd292a0",
                        "source_entry_id": "36b7b46f-0c3e-32e8-8f13-70d929fb3b53",
                        "source_sense_id": "11926f23-f8a1-38e2-b821-658fe96aa7b2",
                        "source_sense_description": "Verhaltensbiologie: das dominante männliche Tier in einem Rudel",
                        "target_lang_word": "alpha male",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alpha male",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "967ebf3c-b3d0-3739-87e7-4a93ab1f4e53",
                                        "entry_id": "7b4f5a53-ff6c-3308-93ce-a4a8b0cde6fe",
                                        "glosses": [
                                            "The dominant male in a group of animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                        "entry_id": "7b4f5a53-ff6c-3308-93ce-a4a8b0cde6fe",
                                        "glosses": [
                                            "A dominant, assertive, protective, oftentimes successful, leadership-type man or male."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "662417fc-acad-481d-9ddb-4677d2d5573a",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "Alpha male investing Aggressive stock-picker on the prowl for less risky financial plan Stanley Richards may have been a latecomer to investing, but he's made up for lost time by aggressively buying"
                                            },
                                            {
                                                "example_id": "c6e7fb79-3864-4f3e-81db-31c3d07e581a",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "This alpha-male status gives him the highest opportunity to mate with many of the best genetic examples of the females in his liking"
                                            },
                                            {
                                                "example_id": "210c94d4-a5c9-46dc-a305-73037f139725",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "The alpha male, is lucky in this regard, since he has a gang and while he must protect them all"
                                            },
                                            {
                                                "example_id": "a1958e5d-ddc3-4bca-8cab-102972913f88",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "Nadal is supposedly the alpha male in any slugfest. But Rosol's forehand shots were being sent towards the Majorcan at 93mph plus, and his was the fastest serve at 134mph."
                                            },
                                            {
                                                "example_id": "84504bea-3f1d-4b7a-914e-f2f9a22f8869",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "Fàbregas is having a lapse in form and Costa seems so preoccupied with alpha-male aggro it possibly distracts him from the rather more important task of beating the opposition goalkeeper."
                                            },
                                            {
                                                "example_id": "002cd6a3-837d-4a67-997b-09d21c1e32a8",
                                                "sense_id": "1ee4d532-8f4d-36e7-9ada-f1419d3b5691",
                                                "text": "Maybe the supposed human alpha male is a combination of disgruntled male wish fulfilment and borderline-pseudoscientific justification for resorting to bullying, intimidation and generally all-round unpleasant behaviour by men hoping to impose their will on a world they find too complex and unnerving so revert to their baser instincts to get what they want, despite knowing deep down they don’t deserve it and shouldn’t have it?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "alpha male",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2066ff1d-3316-3bea-94ff-664b828409c0",
                                        "entry_id": "4837c89d-e846-319d-aebd-76849b00b774",
                                        "glosses": [
                                            "Exhibiting the characteristics of a dominant male; dominant, assertive, and protective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504e5e4d-417f-4888-9f89-c93adac9fd1d",
                                                "sense_id": "2066ff1d-3316-3bea-94ff-664b828409c0",
                                                "text": "You don't get more alpha male than this, I thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11ec3b6b-8f41-4399-a776-01602aba17a8",
                        "source_entry_id": "36b7b46f-0c3e-32e8-8f13-70d929fb3b53",
                        "source_sense_id": "11926f23-f8a1-38e2-b821-658fe96aa7b2",
                        "source_sense_description": "Verhaltensbiologie: das dominante männliche Tier in einem Rudel",
                        "target_lang_word": "mâle alpha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mâle alpha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61f7a5ee-8db8-33b8-8da5-261c23440903",
                                        "entry_id": "4d6d164f-e708-3533-a444-bc89a5973e80",
                                        "glosses": [
                                            "Mâle du plus haut rang, mais non pas forcément complètement dominant, dans un groupe d’animaux sociaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a74b44a6-f91c-4aac-b959-6ed61879e59b",
                                                "sense_id": "61f7a5ee-8db8-33b8-8da5-261c23440903",
                                                "text": "En général, les plus forts des mâles l’emportent, et il s’établit alors une hiérarchie plus ou moins stable, en fonction de laquelle l’individu dominant (dit « alpha » par les éthologistes) a, en général, priorité sans qu’il y ait de nouveaux combats, dans toutes les circonstances où des ressources alimentaires ou des partenaires sexuels sont en jeu. Périodiquement cependant, le mâle alpha est défié par de jeunes mâles arrivant à maturité, et l’un de ceux-ci finit par lui ravir sa position. (En fait, les éthologistes sont de nos jours d’avis qu’il n’y a pas de dominance généralisée : le mâle alpha d’un groupe de singes peut par exemple être prioritaire pour toute sorte de nourriture, mais non en ce qui concerne les femelles « en chaleur »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfcc000-d23a-3fff-94c3-1572af801ebc",
                                        "entry_id": "4d6d164f-e708-3533-a444-bc89a5973e80",
                                        "glosses": [
                                            "Homme attirant ayant une attitude dominante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508614d3-5bec-498d-8917-b2b982e714c9",
                                                "sense_id": "3dfcc000-d23a-3fff-94c3-1572af801ebc",
                                                "text": "Florilège : « Si je devais m’évaluer, je dirais que je suis la meilleure vendeuse d’Europe », « Mon premier mot n’était pas “mommy”, mais “money” », « Je suis le mâle alpha de la vente »… Pour exister, ils surjouent l’assurance jusqu’au ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8267d9bd-b04c-4102-9c30-5d9507c99e9c",
                        "source_entry_id": "36b7b46f-0c3e-32e8-8f13-70d929fb3b53",
