                ],
                "senses": [
                    {
                        "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                        "entry_id": "2c82358c-c49c-3c49-93e6-25efe788806d",
                        "glosses": [
                            "przypadkowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "571bf994-a1a6-4320-a921-777655b93107",
                                "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                                "text": "Myślę, że należy wreszcie skończyć z niezamierzonym wyniszczaniem rodzin i zacząć realizować obietnice wyborcze"
                            },
                            {
                                "example_id": "3fc3b109-74b7-415c-ae6d-fc5ab5d6794c",
                                "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                                "text": "Oburzyć się na tak obcesowe zachowanie Polaka? Na prowokację tak uproszczoną, że graniczącą z niezamierzonym humorem"
                            },
                            {
                                "example_id": "df33f5c2-7151-476c-8631-cffcb9834f56",
                                "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                                "text": "Pojawiła się nowa, szokująca teoria na temat genezy AIDS. Epidemia jest niezamierzonym, ubocznym skutkiem masowych szczepień przeciwko paraliżowi dziecięcemu (choroba Heinego-Medina), którym poddano tysiące Afrykańczyków w latach pięćdziesiątych — twierdzi angielski dziennikarz Edward Hopper"
                            },
                            {
                                "example_id": "17d0a490-be78-4704-854b-c52ed3363ca2",
                                "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                                "text": "Papież namaścił Karolowingów; Karolowingowie w odpłacie wdzięczności wszystkie korony do niezamierzonych czasów od stolicy apostolskiéj zależnymi uczynili"
                            },
                            {
                                "example_id": "8a1ffce2-7e43-43eb-9b4b-320d1bb8eaef",
                                "sense_id": "06b5214d-9a39-3596-9696-8e1b7d1d01ea",
                                "text": "Twój rozsądek każe mi mieć w tobie ufność niezamierzoną"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3902ff22-cc8c-35e0-9f61-e0e578f968bf",
                        "entry_id": "2c82358c-c49c-3c49-93e6-25efe788806d",
                        "glosses": [
