                "senses": [
                    {
                        "sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "glosses": [
                            "pocisk artyleryjski zawierający metalowe odłamki, które rozpryskują się podczas wybuchu zapalnika czasowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00b3624-043f-4598-8e6f-7a52899d70ba",
                                "sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                                "text": "Kiedy mój starszy brat wrócił z wojny miał na czole srebrną gwiazdkę a pod gwiazdką przepaść / to odłamek szrapnela trafił go pod Verdun…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f831977b-a59c-417f-b0fe-b6aa60f3df3f",
                        "source_entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "source_sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "target_lang_word": "shrapnel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrapnel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c761b16-8221-3152-91c0-4389785e2fce",
                                        "entry_id": "018795e3-a204-31ac-8fb2-e0c138869e4f",
                                        "glosses": [
                                            "An anti-personnel artillery shell used in World War I which carries a large number of individual bullets or balls close to the target and then ejects them to allow them to continue along the shell's trajectory and strike the target individually."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10899308-814d-30d5-a0b9-912683e32345",
                                        "entry_id": "018795e3-a204-31ac-8fb2-e0c138869e4f",
                                        "glosses": [
                                            "The bullets or balls from the aforementioned type of artillery shell."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17bccad0-ef1b-3cc8-a336-9b72ac7075e7",
                                        "entry_id": "018795e3-a204-31ac-8fb2-e0c138869e4f",
                                        "glosses": [
                                            "Any shot, fragments, or debris thrown out by an exploding shell, bomb, or landmine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a458c67-c57d-3f93-a79a-3559be4f4179",
                                        "entry_id": "018795e3-a204-31ac-8fb2-e0c138869e4f",
                                        "glosses": [
                                            "Debris."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51403bc-962a-4ac1-9f5d-80aabe0e5485",
                                                "sense_id": "1a458c67-c57d-3f93-a79a-3559be4f4179",
                                                "text": "The dog ate my sandwich, and there was shrapnel all over the place from him tearing open the bag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e44871-c9ce-3327-ab1f-14f1eaa9f5b8",
                                        "entry_id": "018795e3-a204-31ac-8fb2-e0c138869e4f",
                                        "glosses": [
                                            "Loose change."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39efe353-0d03-4b34-a217-c186bae51575",
                                                "sense_id": "a6e44871-c9ce-3327-ab1f-14f1eaa9f5b8",
                                                "text": "I was waiting in the queue, looking at the board / Wondering whether to have a burger or chips / Or what the shrapnel in my back pocket could afford"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "585030e1-3dc5-4727-b42a-3f80a36437b2",
                        "source_entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "source_sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "target_lang_word": "shrapnel shell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e0abf1e1-11a7-4524-bc6c-433ca3e8c462",
                        "source_entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "source_sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "target_lang_word": "šrapnel",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "732850f1-074b-4f24-a707-e13abd799a8c",
                        "source_entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "source_sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "target_lang_word": "shrapnel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shrapnel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00bf3378-7d19-36cb-845e-af96dc568f5f",
                                        "entry_id": "a77a2a6a-d805-34ae-a285-c1857c86b5c6",
                                        "glosses": [
                                            "Obus d’artillerie qui explose au-dessus de sa cible en libérant de nombreux fragments meurtriers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9426ee8e-b166-4241-a115-c7e0b6fe6cb9",
                                                "sense_id": "00bf3378-7d19-36cb-845e-af96dc568f5f",
                                                "text": "Le capitaine Ouzeley vient de faire à Woolwich, l’essai d’une nouvelle machine infernale qui a été déclarée par les officiers-généraux et les ingénieurs présens aux expériences, d'un effet plus prompt et plus infaillible que les bombes de Shrapnell et les fusées de Congrève. il est étonnant que le gouvernement qui par la supériorité de sa marine, paraît le plus intéressé à étouffer ces horribles inventions, soit la plus empressé à les multiplier."
                                            },
                                            {
                                                "example_id": "23852210-1463-4d0d-ae85-8fcf65c30470",
                                                "sense_id": "00bf3378-7d19-36cb-845e-af96dc568f5f",
                                                "text": "En revanche, l'effet du tir à shrapnels contre des buts abrités fut relativement médiocre, et il est à craindre que le tir à shrapnels contre des buts dominants et à couvert ne produise des résultats encore plus défavorables, quand l'artillerie ne sera pas en état de régler son tir."
                                            },
                                            {
                                                "example_id": "4e712d58-4d5c-4858-aaa3-d883b997f2ea",
                                                "sense_id": "00bf3378-7d19-36cb-845e-af96dc568f5f",
                                                "text": "Mais les effets acoustiques des shrapnels, au moment de l’explosion, sont en revanche très étranges et très curieux.\nComme l’on sait, les shrapnels n’explosent pas à percussion mais ils sont réglés à retardement grâce à une mèche qui s'allume automatiquement au moment de la déflagration et qui continue pendant la trajectoire du projectile, communiquant ensuite le feu à l’explosif, lorsque le shrapnel est à quelques mètres de la cible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "229a829e-efbd-3ad6-809a-d4091b586c37",
                                        "entry_id": "a77a2a6a-d805-34ae-a285-c1857c86b5c6",
                                        "glosses": [
                                            "Fragment de bombe qui explose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad624748-a7e2-4219-aa28-9430c4190ba5",
                                                "sense_id": "229a829e-efbd-3ad6-809a-d4091b586c37",
                                                "text": "Lardé de shrapnells au bras et à la cuisse, il se couchait sur le dos (…). Quand j’ai r’çu ma ferraille, j’ai dit : « Aux abatis, ça va. Rien dans l’buffet, ça colle. »"
                                            },
                                            {
                                                "example_id": "7cc0cde4-dfe4-43dd-b92f-6b4c98f2d708",
                                                "sense_id": "229a829e-efbd-3ad6-809a-d4091b586c37",
                                                "text": "Tapis en des tranchées, les soldats des deux camps tuent et meurent sans se voir. Le meurtre est impersonnel ; sa cause est un shrapnel, une balle dont l’auteur est un X qu’on ne connaîtra jamais et qui, de son côté, ne saura jamais qui a reçu le projectile qu’il a envoyé."
                                            },
                                            {
                                                "example_id": "7349d2fe-76e9-477c-a50b-127463854b4d",
                                                "sense_id": "229a829e-efbd-3ad6-809a-d4091b586c37",
                                                "text": "On lui a expliqué que de telles bombes projettent des shrapnels à une vitesse vingt fois supérieure à celle du son : si on est trop près, on meurt avant même d'avoir entendu quoi que ce soit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d6a7d2f-aa91-489d-9bc0-05323cdf7c4d",
                        "source_entry_id": "7cfbb240-4090-3284-a282-6ae50cddb82e",
                        "source_sense_id": "87b3ca0c-b680-360b-ae99-fb5d2af84cdf",
                        "target_lang_word": "Schrapnell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrapnell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d84b8bc-907a-3bae-8874-3159dd2d71b6",
                                        "entry_id": "bc30a82b-a6e8-3c76-a22b-e26bd19c2d4d",
                                        "glosses": [
                                            "Artilleriegeschoss, mit Kugeln versehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57421d1c-c9e3-4ed0-a13f-e5b53254d1a9",
                                                "sense_id": "5d84b8bc-907a-3bae-8874-3159dd2d71b6",
                                                "text": "„Haben wir nicht, als im Feld der Tod unser Kamerad war, der bei uns hockte in Schützengräben und Unterständen, in zerschossenen Dörfern und Wäldern, im Hagel der Schrapnelle und unterm Licht der Sterne, geschworen mit heiligem Ernst, daß der Krieg nur einen Sinn haben kann: den Aufbruch der Jugend?“"
                                            },
                                            {
                                                "example_id": "c9e4f873-e92f-4310-a889-1549c1c25cb1",
                                                "sense_id": "5d84b8bc-907a-3bae-8874-3159dd2d71b6",
                                                "text": "„Als Nick aus dem Ort herausgekommen war, waren in einiger Höhe rechts über einem der zerstörten Häuser drei Schrapnelle explodiert; seither hatte es keinen Beschuss mehr gegeben.“"
                                            },
                                            {
                                                "example_id": "5edeb4c0-176a-4491-8e76-63964a5adc6f",
                                                "sense_id": "5d84b8bc-907a-3bae-8874-3159dd2d71b6",
                                                "text": "„Mir schien es auch, als ob Schrapnelle herüberkämen.“"
                                            },
                                            {
                                                "example_id": "e7554073-897a-4b05-aa29-9dc3598dcf24",
                                                "sense_id": "5d84b8bc-907a-3bae-8874-3159dd2d71b6",
                                                "text": "„Auf den Straßen lagen Menschen- und Pferdeleichen, Opfer von Schrapnellen, ganze Stadtteile standen in Flammen, und es war längst keine Rede mehr davon, die Feuerbrände zu löschen angesichts der durch Artillerie und Bomben beschädigten städtischen Wasserwerke.“"
                                            }
