                ],
                "senses": [
                    {
                        "sense_id": "d94ecc07-b6ed-3f42-b0d2-ceb0cd843e3d",
                        "entry_id": "58d89583-ae72-3371-b665-0e4323ca8d79",
                        "glosses": [
                            "Ensemble des gros animaux visibles à l'œil nu (de plus de 80 mm) d'un milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6161294f-c39e-4fe2-9da9-eb8de91e72a9",
                                "sense_id": "d94ecc07-b6ed-3f42-b0d2-ceb0cd843e3d",
                                "text": "Si la génétique a mis les projecteurs sur la mégafaune de l'âge de glace, \"l'heure des petits mammifères pourrait bientôt sonner\", a ainsi souligné Alfred Roca, de l'université américaine de l'Illinois, dans un commentaire publié en marge de l'étude."
                            },
                            {
                                "example_id": "bf6ebeec-4fd2-400b-913a-191f5b69ca51",
                                "sense_id": "d94ecc07-b6ed-3f42-b0d2-ceb0cd843e3d",
                                "text": "Si vous apercevez un animal en difficulté, c’est l’observatoire pour la conservation de la mégafaune marine (Pelagis), basé à La Rochelle, qu’il faut contacter en priorité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "262437fb-c9a6-43e4-b998-b24e414b40db",
                        "source_entry_id": "58d89583-ae72-3371-b665-0e4323ca8d79",
                        "source_sense_id": "d94ecc07-b6ed-3f42-b0d2-ceb0cd843e3d",
                        "target_lang_word": "megafauna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megafauna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af55b342-0b54-3d3f-a4ff-e3ec7e988ced",
                                        "entry_id": "b47e7a87-54ef-3b66-9c6d-8761857b3744",
                                        "glosses": [
                                            "The large animals of a given region or time, considered as a group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1e1f601-710d-4525-8d4d-8333f72015f7",
                                                "sense_id": "af55b342-0b54-3d3f-a4ff-e3ec7e988ced",
                                                "text": "The extinction of the Pleistocene megafauna had ended there long before it had in Europe, and so a \"broad spectrum\" of food collecting had been going on for some time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1e93d3-7ebf-39ac-bb98-5233c042bf90",
                                        "entry_id": "b47e7a87-54ef-3b66-9c6d-8761857b3744",
                                        "glosses": [
                                            "A treatise on such a group of large animals."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
