                        "examples": [
                            {
                                "example_id": "96592fc1-f769-44f5-8e93-763086a6b0a8",
                                "sense_id": "c322e1e3-8434-38c9-8dbc-f271ca59d973",
                                "text": "„Kaum ein Verkehrsunglück hat die französische Nation so sehr bewegt wie der Absturz der prestigeträchtigen Airbus-Maschine.“"
                            },
                            {
                                "example_id": "49cc7e8d-06c1-47b9-9a36-1b09a4dd394a",
                                "sense_id": "c322e1e3-8434-38c9-8dbc-f271ca59d973",
                                "text": "„Die jüngsten Verkehrsunglücke zeigen, dass der Mensch sich als Lenker und Steuermann raushalten sollte – auch wenn das vielen nicht gefällt.“"
                            }
                        ],
