    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd09a8e1-e17d-3ac9-b916-8a2765141690",
                    "sense_definition": "État d'inactivité forcée d'une personne apte au travail qui ne trouve pas d'emploi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis la fermeture de l'usine, de nombreux ouvriers se retrouvent au <w>chômage</w>."
                        },
                        {
                            "text": "Le ministre a présenté les derniers chiffres du taux de <w>chômage</w> lors d'une conférence de presse."
                        }
                    ],
                    "synonyms": [
                        "chômedu",
                        "chomdu"
                    ],
                    "common_phrases": [
                        "taux de chômage",
                        "être au chômage",
                        "chômage technique"
                    ]
                },
                {
                    "sense_id": "8a02a2c9-a430-393a-8ba7-f5df84ce74ba",
                    "sense_definition": "Indemnité financière versée à une personne privée d'emploi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après avoir perdu son emploi, il touche le <w>chômage</w> en attendant de retrouver un poste."
                        },
                        {
                            "text": "Elle doit renouveler son inscription pour conserver son droit au <w>chômage</w> ce mois-ci."
                        }
                    ],
                    "synonyms": [
                        "chômedu",
                        "chomdu"
                    ],
                    "common_phrases": [
                        "toucher le chômage",
                        "droit au chômage"
                    ]
                },
                {
                    "sense_id": "86bb4411-28c5-35a5-850a-ab32d421b32c",
                    "sense_definition": "Interruption légale ou convenue du travail lors d'un jour férié ou de repos.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>chômage</w> dominical permet aux employés de se reposer et de passer du temps en famille."
                        },
                        {
                            "text": "La loi prévoit le <w>chômage</w> obligatoire pour certaines fêtes religieuses ou nationales."
                        }
                    ],
                    "common_phrases": [
                        "chômage dominical"
                    ]
                },
                {
                    "sense_id": "638f4913-2bc8-33d3-969b-c1aadc132df4",
                    "sense_definition": "Période d'interruption de la navigation sur une voie d'eau ou un canal pour des travaux d'entretien.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>chômage</w> annuel du canal permet d'effectuer des réparations indispensables sur les écluses."
                        },
                        {
                            "text": "Toutes les péniches sont à l'arrêt pendant le <w>chômage</w> programmé de la voie navigable."
                        }
                    ]
                }
            ]
        }
    ]
