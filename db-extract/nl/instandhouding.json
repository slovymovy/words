                    {
                        "translation_id": "8792f49d-38a0-41b7-ad0b-07cdc8a17f8b",
                        "source_entry_id": "93fd0191-8aea-30e3-9ce2-e0096f6540bc",
                        "source_sense_id": "d1675bcd-61bb-3793-a9e6-a3f79b392d62",
                        "target_lang_word": "preservation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preservation",
