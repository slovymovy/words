                            {
                                "example_id": "be938793-0609-417b-8bba-badc1fcd4bc7",
                                "sense_id": "d687ef71-d88f-32f8-bcde-7989a81c2ceb",
                                "text": "„Im Waadtland wurde eine Schneeschuh-Läuferin von einer Lawine getötet.“"
                            },
