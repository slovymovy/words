                                "sense_id": "4247fc95-eeb9-3203-8f27-1c93af397ac1",
                                "text": "Chabots[:] Or three chabots gu."
                            },
                            {
                                "example_id": "80ede76c-ad14-41e4-b98b-b12bbd793d08",
                                "sense_id": "4247fc95-eeb9-3203-8f27-1c93af397ac1",
                                "text": "Over all an escutcheon of pretence : 1 and 4 , Gules, nine mascles conjoined or, 3, 3, 3 (Rohan); 2 and 3, Or, three chabots hauriant gules (Chabot)."
                            },
                            {
                                "example_id": "27c62593-5296-4a4a-a8ff-d93a08d545e5",
                                "sense_id": "4247fc95-eeb9-3203-8f27-1c93af397ac1",
                                "text": "\"Or, three chabots gules” is the crest of a French family of the name of Chabot."
                            },
                            {
                                "example_id": "c6f549d1-c475-4c18-940e-22e0cc4d8943",
                                "sense_id": "4247fc95-eeb9-3203-8f27-1c93af397ac1",
                                "text": "Arms : Gules three gemels gold on a quarter silver three chabots erect gules."
                            }
                        ]
                    }
