                        "examples": [
                            {
                                "example_id": "d1a7595a-ecaa-4484-905d-dcaa6ded3614",
                                "sense_id": "e5c1ecfe-10c9-393a-8253-d3102642390d",
                                "text": "Straten in Utrecht zijn verlaten. Veel winkels zijn gesloten en mensen blijven binnen. De mensen die op straat te vinden zijn voelen zich angstig: 'Dit doet iets met je veiligheidsgevoel.'"
                            },
                            {
                                "example_id": "bd9edc92-5668-495d-bcd2-788b202fef25",
                                "sense_id": "e5c1ecfe-10c9-393a-8253-d3102642390d",
                                "text": "In het gebied rond Park Spoor Noord voeren drugsbendes hun strijd op straat. De politie start daarom met systematische identiteitscontroles en gaat extra patrouilleren in de straten. Ook breiden ze het cameratoezicht uit. De maatregelen zijn tijdelijk. Totdat het veiligheidsgevoel van Antwerpenaren in de buurt is versterkt."
                            }
                        ]
                    }
