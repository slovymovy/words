                                        "entry_id": "9d528770-6a8b-37b1-bc05-1d82fe88142b",
                                        "glosses": [
                                            "The ability or practice of tolerating; an acceptance of or patience with the beliefs, opinions or practices of others; a lack of bigotry."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4edc1fd-3bff-489e-9448-17d3f01df2fa",
                                                "sense_id": "ea3ca0f5-d2e0-39d9-8fda-f3fbd1e87419",
                                                "text": "Both [Ze'ev] Jabotinsky and [David] Ben-Gurion also wrote songs of praise to the Ottoman Empire, its tolerance toward ethnic minorities in general — and to Jews in particular — as well as to the democratic changes it was undergoing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61abd875-75f5-3004-a6bf-571742ed3c55",
                                        "entry_id": "9d528770-6a8b-37b1-bc05-1d82fe88142b",
                                        "glosses": [
                                            "The ability of the body (or other organism) to resist the action of a poison, to cope with a dangerous drug or to survive infection by an organism."
                                        ],
