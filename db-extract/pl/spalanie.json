                            {
                                "target_word": "burning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08e2e09c-9724-3fe9-bc0b-b1313972a081",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "So hot as to seem to burn (something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f3e5ca8-a3e1-4f5e-b6b0-7e621585b6a8",
                                                "sense_id": "08e2e09c-9724-3fe9-bc0b-b1313972a081",
                                                "text": "the burning sun"
                                            },
                                            {
                                                "example_id": "82cff62d-2c97-499e-af4f-c21d7c1c8d55",
                                                "sense_id": "08e2e09c-9724-3fe9-bc0b-b1313972a081",
                                                "text": "The desert storm was riding in its strength; the travellers lay beneath the mastery of the fell simoom. Whirling wreaths and columns of burning wind, rushed around and over them."
                                            },
                                            {
                                                "example_id": "6c40f5da-5fc6-41e3-bd80-22a860b1b1c8",
                                                "sense_id": "08e2e09c-9724-3fe9-bc0b-b1313972a081",
                                                "text": "Hot summer streets and the pavements are burning, I sit around / Trying to smile, but the air is so heavy and dry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaaaa2aa-ce84-3864-af66-3bc79f1e9527",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Feeling very hot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d4672e-31b7-41bb-b29f-6f6644327b29",
                                                "sense_id": "aaaaa2aa-ce84-3864-af66-3bc79f1e9527",
                                                "text": "burning skin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a607e63-f59a-38f1-9cbd-bd9ecf6df056",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Feeling great passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8692ec1d-dad7-4bbb-8960-eecdba4e11ab",
                                                "sense_id": "7a607e63-f59a-38f1-9cbd-bd9ecf6df056",
                                                "text": "her burning heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84b910e-6131-3c0c-9c7c-fce995be9550",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Consuming; intense; inflaming; exciting; vehement; powerful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37dafd10-0de0-4f5b-99bc-9d1b6ed69702",
                                                "sense_id": "e84b910e-6131-3c0c-9c7c-fce995be9550",
                                                "text": "burning zeal"
                                            },
                                            {
                                                "example_id": "6876ed86-9518-443a-bc0b-3a80531cfb97",
                                                "sense_id": "e84b910e-6131-3c0c-9c7c-fce995be9550",
                                                "text": "a burning passion"
                                            },
                                            {
                                                "example_id": "919c1cc7-0ffd-4bd6-aac0-ea8b0174a1fe",
                                                "sense_id": "e84b910e-6131-3c0c-9c7c-fce995be9550",
                                                "text": "like a young hound upon a burning scent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d777f59f-c551-3ad0-81ba-49d7de858388",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Being keenly discussed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50e919b-8d7d-4101-a77c-d93c817ff50a",
                                                "sense_id": "d777f59f-c551-3ad0-81ba-49d7de858388",
                                                "text": "a burning question; a burning issue"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b57c03e-a2dd-3f25-a9c7-b80fa00678de",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "On fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9e2aa90-05fc-4585-b5b0-1584389e0b38",
                                                "sense_id": "6b57c03e-a2dd-3f25-a9c7-b80fa00678de",
                                                "text": "The driver remained at his post, while telling fireman Jim Nightall to get down on the track and run back to uncouple the burning wagon from the rest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "burning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e24bd56f-6018-3a2c-9c57-98e6994e0d41",
                                        "entry_id": "e361b40c-da2e-33f5-9f3d-cd2ebd498db0",
                                        "glosses": [
                                            "The act by which something burns or is burned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5343d453-f1cb-4815-9ad4-8e49a03b0643",
                                                "sense_id": "e24bd56f-6018-3a2c-9c57-98e6994e0d41",
                                                "text": "It gives a fine delineation of the burnings of shame, disappointed ambition, and vengeance[…]"
                                            },
                                            {
                                                "example_id": "ca0c4d2d-36cf-4050-99f0-18cbf3562def",
                                                "sense_id": "e24bd56f-6018-3a2c-9c57-98e6994e0d41",
                                                "text": "The propriety of the dissolution, too, was speedily seen in the improved state of the public peace: for twelve years we hear little of Orange riots, and nothing of such burnings and wreckings as those of Maghera, Maghery, and Annahagh."
                                            },
                                            {
                                                "example_id": "98ca922c-d6fe-4fd3-ad6a-26a518aa1e1c",
                                                "sense_id": "e24bd56f-6018-3a2c-9c57-98e6994e0d41",
                                                "text": "The suspect is the 21-year-old son of a St. Landry Parish sheriff’s deputy and may have been influenced by “black metal” music and its “associated history with church burnings,” the state fire marshal’s office said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20a6649d-4fa9-359a-977e-82b7af843ec7",
                                        "entry_id": "e361b40c-da2e-33f5-9f3d-cd2ebd498db0",
                                        "glosses": [
                                            "A fire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca7836f-d715-4e5b-a9a3-1551c79b167a",
                                                "sense_id": "20a6649d-4fa9-359a-977e-82b7af843ec7",
                                                "text": "The burnings continued all day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03cbc485-8f55-3325-a128-0d20ea4d54fa",
                                        "entry_id": "e361b40c-da2e-33f5-9f3d-cd2ebd498db0",
                                        "glosses": [
                                            "purposefully remove certain number of coins in circulation, by sending it to a public address where the private keys cannot be obtained (called burn address, eater address or black hole), usually should be available on the blockchain for anyone to review such a transaction. It’s a one-way address with no ability to reverse the transaction or withdraw the coins. For all practical purposes, the asset no longer exists (it has been “burned”). The act of burning effectively removes tokens from the available supply."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a6c5356-37ca-3035-b9cb-9a2a4236f780",
                                        "entry_id": "e361b40c-da2e-33f5-9f3d-cd2ebd498db0",
                                        "glosses": [
                                            "A fiery pain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6311b9e2-b3f4-46fb-97a5-20f47b6ccd7b",
                        "source_entry_id": "88248531-55a8-3111-9930-9c5bc8806f22",
                        "source_sense_id": "a1300519-b9d8-3f8f-b7e6-083e3aa028a0",
                        "target_lang_word": "brûlage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brûlage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7de921c8-e942-3af1-8449-a4778238d190",
                                        "entry_id": "fe70dfab-d1d2-3149-b3e8-e31a4dd426ac",
                                        "glosses": [
                                            "Action de brûler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8f61e9-0dea-4341-afb0-fa080ead5ac6",
                                                "sense_id": "7de921c8-e942-3af1-8449-a4778238d190",
                                                "text": "La technique de récolte du coton laisse la plante en place, avec une quantité importante de matière végétale en partie lignifiée à détruire par brûlage, ou à réduire en brins courts pour favoriser l'enfouissement et la décomposition dans le sol."
                                            },
                                            {
                                                "example_id": "dae711c7-ae21-42d5-a674-830cdf93a977",
                                                "sense_id": "7de921c8-e942-3af1-8449-a4778238d190",
                                                "text": "En France, les déchets verts font partie des déchets ménagers, dont le brûlage à l’air libre est interdit par l’article 84 (circulaire du 9 août 1978) du Règlement sanitaire départemental type (RSDT)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d818740-70f7-395d-a5f5-9bf376d83564",
                                        "entry_id": "fe70dfab-d1d2-3149-b3e8-e31a4dd426ac",
                                        "glosses": [
                                            "Destruction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba23d5a6-5697-4025-a460-ba508b25709e",
                                                "sense_id": "0d818740-70f7-395d-a5f5-9bf376d83564",
                                                "text": "— Eh bien ! j’aime cela ! s’écria Josépha, qui se leva pleine d’enthousiasme. C’est un brûlage général ! C’est sardanapale ! c’est grand ! c’est complet !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
