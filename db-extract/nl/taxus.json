                                                "example_id": "e5475115-fae9-4c2f-b9be-8809e6c15349",
                                                "sense_id": "5ec5422d-a5e9-3778-b239-d24b692222bb",
                                                "text": "In unserem Garten stehen mehrere Eiben."
