                    }
                ],
                "senses": [
                    {
                        "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                        "entry_id": "02cf2537-fe83-3b53-91c9-81af50e7beaa",
                        "glosses": [
                            "ein Volk, das im östlichen Himalaja in Indien, Bhutan sowie Nepal lebt"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "084c824d-8fe2-4812-a0d9-9cc64503bf19",
                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                "text": "„Das ist um so auffallender, weil diese Ahnen den Lepcha die Sämereien vermittelten und die Anweisungen zum Pflanzen gaben, welches ja vorwiegend Frauenarbeit ist.“"
                            },
                            {
                                "example_id": "8aec5f36-b4d4-4211-8584-f3eac76284f6",
                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                "text": "„Die an die Lepcha grenzenden Kumpa Rong oder Kumpa Lepcha kamen (mit dem Raja von Sikhim) aus Tibet.“"
                            },
                            {
                                "example_id": "cb361ab1-472e-4250-b599-0df6fb47a9f6",
                                "sense_id": "1419f760-9af4-3977-aa97-85d58f2065c4",
                                "text": "„Die mit Kupferdraht umwickelten Versteifungshölzer am Griff findet man häufig bei Bogen der Lepcha, die Kugeln verschossen oder zum Zielschießen verwendet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                        "entry_id": "02cf2537-fe83-3b53-91c9-81af50e7beaa",
                        "glosses": [
                            "Angehöriger des gleichnamigen Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea5c129-d955-4c75-895b-b1865bc1cf43",
                                "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                                "text": "„So erzählte ein Lepcha: »Das Urelternpaar hieß Ti-gung-a-thik und Ni-gung-a-ngal. […]«“"
                            },
                            {
                                "example_id": "32fd459b-ef26-4ac4-ae67-8b0352072570",
                                "sense_id": "e4227071-0bdd-3e98-90ea-a5d23bb97704",
                                "text": "„Ein Lepcha geht mit einer Last von 140 Pfund auf dem Rücken langsam und sicher, ohne alle Furcht darüber hin.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
