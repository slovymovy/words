                        "examples": [
                            {
                                "example_id": "e13e2458-54dd-4f74-bb4c-3c110765d965",
                                "sense_id": "9d7d622a-4de4-3a58-b38f-282234bc5719",
                                "text": "Een etiket ergens opplakken is iets een naam geven."
                            }
                        ]
