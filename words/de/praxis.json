    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "000a9432-fd44-3b5f-984c-c94a40224853",
                    "sense_definition": "Räume, in denen ein niedergelassener Arzt, Zahnarzt, Therapeut oder Jurist arbeitet und Patienten beziehungsweise Klienten empfängt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Zahnarzt hat viele schöne Blumen in der <w>Praxis</w> stehen."
                        },
                        {
                            "text": "Vor der Untersuchung muss sich jeder Patient am Empfang der <w>Praxis</w> anmelden."
                        }
                    ],
                    "synonyms": [
                        "Arztpraxis",
                        "Behandlungsraum",
                        "Ordination"
                    ],
                    "common_phrases": [
                        "in die Praxis gehen",
                        "eine Praxis eröffnen"
                    ]
                },
                {
                    "sense_id": "4957b9a8-84d3-3471-b61a-80948b23c690",
                    "sense_definition": "die tatsächliche, praktische Anwendung oder Durchführung von Ideen und Regeln im Gegensatz zur bloßen Theorie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Theorie klingt der Plan einfach, aber in der <w>Praxis</w> gibt es Probleme."
                        },
                        {
                            "text": "In der <w>Praxis</w> kommt diese seltene Krankheit bei jüngeren Menschen glücklicherweise kaum vor."
                        }
                    ],
                    "antonyms": [
                        "Theorie"
                    ],
                    "common_phrases": [
                        "in der Praxis",
                        "Theorie und Praxis"
                    ]
                },
                {
                    "sense_id": "07533b9c-d6f6-36a9-87b5-527b16af51c9",
                    "sense_definition": "durch praktische berufliche Tätigkeit oder Übung erworbene Kenntnis und Fertigkeit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für diese verantwortungsvolle Stelle im Krankenhaus bringt die Ärztin bereits langjährige <w>Praxis</w> mit."
                        },
                        {
                            "text": "Bei deiner bisherigen beruflichen <w>Praxis</w> sollte dich die neue Firma auf jeden Fall einstellen."
                        }
                    ],
                    "synonyms": [
                        "Erfahrung"
                    ],
                    "common_phrases": [
                        "berufliche Praxis",
                        "langjährige Praxis"
                    ]
                },
                {
                    "sense_id": "cd64add1-fa0c-33d1-9bbb-07db28115168",
                    "sense_definition": "die eingeführte, allgemein übliche Vorgehensweise oder Gewohnheit in einem bestimmten Bereich",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In vielen großen Unternehmen ist es gängige <w>Praxis</w>, die ersten Bewerbungsgespräche online durchzuführen."
                        },
                        {
                            "text": "Diese fragwürdige geschäftliche <w>Praxis</w> wurde nach heftiger Kritik der Kunden sofort eingestellt."
                        }
                    ],
                    "common_phrases": [
                        "gängige Praxis",
                        "übliche Praxis"
                    ]
                },
                {
                    "sense_id": "5868674f-c762-3c68-b98e-8822b13dfd02",
                    "sense_definition": "die reguläre Sprechstunde oder Öffnungszeit eines Arztes oder Juristen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir öffnen die Eingangstür für Patienten immer eine halbe Stunde vor Beginn der <w>Praxis</w>."
                        },
                        {
                            "text": "Während der regulären <w>Praxis</w> kann der Arzt aus Zeitgründen keine privaten Telefonate entgegennehmen."
                        }
                    ],
                    "synonyms": [
                        "Praxiszeiten",
                        "Sprechstunde"
                    ],
                    "common_phrases": [
                        "während der Praxis"
                    ]
                }
            ]
        }
    ]
}