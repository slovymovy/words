        "fr-extract.jsonl": [
            {
                "entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                "word": "piétaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "156a4565-d1ab-4b1c-a951-1a0ce242ad98",
                        "entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "tags": [
                            "plural"
                        ],
                        "form": "piétailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                        "entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "glosses": [
                            "Infanterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b482644-fdf7-4f7e-8a3d-0c987a3aa651",
                                "sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                                "text": "Le pape Jean veut me faire étrécir mon armée à quatre mille chevaliers et quinze mille hommes de piétaille."
                            },
                            {
                                "example_id": "049a6ee4-ca1c-490e-a680-e83206adfac2",
                                "sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                                "text": "— Comment ces cons-là pourront-ils jamais comprendre la vieille chanson française, qui est chanson de piéton et de piétaille."
                            },
                            {
                                "example_id": "19e124f2-6206-4fc7-827b-48f4849dd4a0",
                                "sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                                "text": "Nous autres, piétaille, nous montions le guet, vigilants tant entre nous que vis-à-vis du reste du monde."
                            },
                            {
                                "example_id": "b5e985c7-e47b-4e80-9a09-768e737e5351",
                                "sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                                "text": "Chiites et Palestiniens seront voisins ou même mêlés, dans ces banlieues populeuses de la Quarantaine, Nabaa, Chiah, Borj Brajneh, véritables bouillons de culture révolutionnaire où les organisations de gauche recruteront sans peine la piétaille des futurs combats."
                            }
                        ]
                    },
                    {
                        "sense_id": "09c9174c-2a8f-3612-bff1-401d06321aaf",
                        "entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "glosses": [
                            "Groupe de piétons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4020a6d4-f62e-434f-b680-656e5331991f",
                                "sense_id": "09c9174c-2a8f-3612-bff1-401d06321aaf",
                                "text": "Le village approchait. Les équipages devenaient plus nombreux. La piétaille naviguait en deux files de chaque côté de la route."
                            },
                            {
                                "example_id": "291bcb04-8100-4037-9591-c150a2afbf6b",
                                "sense_id": "09c9174c-2a8f-3612-bff1-401d06321aaf",
                                "text": "Quant aux Croisades, tant de piétaille, de valets de chevaux, de ribauds, de pieuses veuves et de filles perdues se sont égaillés sur les routes à la suite de leur seigneur que nous pouvons tous nous flatter d’avoir participé par quelque ancêtre à l’une de ces équipées sublimes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b30cc5d-2b29-32f7-a960-dcbfb603c519",
                        "entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "glosses": [
                            "Personnes de condition modeste, subalterne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9977ecc-1538-47b8-be20-87742e913a61",
                                "sense_id": "5b30cc5d-2b29-32f7-a960-dcbfb603c519",
                                "text": "Après ces notables et cette aristocratie de la Kolomna viennent une piétaille et un menu fretin extraordinaires."
                            },
                            {
                                "example_id": "7708a5b8-330e-4653-88c2-73e571bb4efe",
                                "sense_id": "5b30cc5d-2b29-32f7-a960-dcbfb603c519",
                                "text": "Il est évident que chaque peuple ne peut également porter dans l'histoire la responsabilité de ce devenir : il y a des peuples élus, et une piétaille que le philosophe peut tenir pour négligeable."
                            },
                            {
                                "example_id": "93e05c6e-2542-41f6-b044-33cfb2961eca",
                                "sense_id": "5b30cc5d-2b29-32f7-a960-dcbfb603c519",
                                "text": "Jérôme laissa planer le doute sur son remplacement, jusqu'à ce que des guerres clandestines éclatent, chaque créa espérant secrètement le job. Puis il recruta un ancien pote de fac, la piétaille continua de valser."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca630482-4709-4f08-9f2d-d67cc84e2d00",
                        "source_entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "source_sense_id": "cd2da325-9b6b-3f3e-bca7-dde8b2a0787b",
                        "source_sense_description": "Infanterie",
                        "target_lang_word": "Fußvolk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußvolk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b333602-050d-3018-90c4-adb54940a006",
                                        "entry_id": "dc83b019-b97c-352a-928c-2922ee9f4216",
                                        "glosses": [
                                            "zu Fuß kämpfende Einheiten"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93771bf6-ecbc-41e2-a55b-26f89adb110e",
                                                "sense_id": "6b333602-050d-3018-90c4-adb54940a006",
                                                "text": "Nach der gewalttätigen Rassisten-Kundgebung in Charlottesville entfernen immer mehr Städte in südlichen US-Bundesstaaten Statuen, die an den Bürgerkrieg erinnern. Generäle müssen ebenso dran glauben wie das Fußvolk."
                                            },
                                            {
                                                "example_id": "934f879d-fbc2-47d5-8b1e-fa1f4717ada5",
                                                "sense_id": "6b333602-050d-3018-90c4-adb54940a006",
                                                "text": "Das gemeine Fußvolk – im Krieg wie im Frieden - hatte die größten Strapazen und bekam dafür den kleinsten Lohn."
                                            },
                                            {
                                                "example_id": "bcfff13d-67d3-4095-a5f9-1bf8ea18898d",
                                                "sense_id": "6b333602-050d-3018-90c4-adb54940a006",
                                                "text": "[Der Theologe Konstantin Sacher:] „Er [der Schriftsteller Mosebach] ergötzt sich […] an der Logik, mit der alle Kriegstreiber ihr Fußvolk in den Tod schicken. Stirb fürs Vaterland! Es ist ein Ehrentod! Stirb für Allah! Stirb für Gott!“"
                                            },
                                            {
                                                "example_id": "07a54360-b243-4e4b-b474-bb65650802e4",
                                                "sense_id": "6b333602-050d-3018-90c4-adb54940a006",
                                                "text": "„Vom Fußvolk hielt er weniger, und die Kosaken waren ihm mehr Räuber als Soldaten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6eac690-0a5c-3eeb-9977-5e95c579819f",
                                        "entry_id": "dc83b019-b97c-352a-928c-2922ee9f4216",
                                        "glosses": [
                                            "zu Fuß gehende Leute"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f93925a-ff2a-4aba-b21e-379f63868184",
                                                "sense_id": "c6eac690-0a5c-3eeb-9977-5e95c579819f",
                                                "text": "Krakau als Stadt, ja eine ganze Region stellte sich in den Dienst der sechstägigen Veranstaltung [dem Weltjugendtag]. Eine Stadt stand still für Fußvolk und Radler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8e96205c-26d2-3bfb-958d-b7502c193ae9",
                                        "entry_id": "dc83b019-b97c-352a-928c-2922ee9f4216",
                                        "glosses": [
                                            "Tiere, die sich nur zu Fuße fortbewegen können"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac8509e-4d79-4e79-a3b2-93ed9171ee47",
                                                "sense_id": "8e96205c-26d2-3bfb-958d-b7502c193ae9",
                                                "text": "Kühe gehören zum Fußvolk."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                        "entry_id": "dc83b019-b97c-352a-928c-2922ee9f4216",
                                        "glosses": [
                                            "niedere Angehörige einer Hierarchie"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0560ba-07a7-4328-91a2-d34230b1d8fc",
                                                "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                                "text": "Die Fluggesellschaften schotten ihre besondere Klientel vom Fußvolk ab, am Boden und in der Luft."
                                            },
                                            {
                                                "example_id": "84e3c375-1a6a-4e23-8f57-72cc939916d0",
                                                "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                                "text": "In Fritz Härings Wirtshaus mit Biergarten [am Starnberger See] mischt sich der Geldadel unters Fußvolk, als ganz normale Menschen."
                                            },
                                            {
                                                "example_id": "e1566f94-e4f5-4e62-b898-c4ecd2341855",
                                                "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                                "text": "[…] zu einem Wahlkampf gehört neben einem hieb- und stichfesten Wahlprogramm, dass ein Politiker vor allem das Fußvolk von sich überzeugt."
                                            },
                                            {
                                                "example_id": "d28a280b-ac34-45f1-a883-0c0603708324",
                                                "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                                "text": "[…] Es [Pegida] ist das Fußvolk der AfD, ihre Bodentruppe."
                                            },
                                            {
                                                "example_id": "8fe4413b-6018-4527-a845-c28b04f3d0bb",
                                                "sense_id": "8e1df210-d5b3-33da-ab41-fc9894ce6675",
                                                "text": "„Es ist Khomeini gelungen, die mehr als 100.000 Geistlichen im Iran zu Parteikadern zu machen, die Moscheen zu Parteizentren und die Gläubigen zum Fußvolk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
