                        "entry_id": "1af79467-cf31-30bb-a22b-5692cd73e765",
                        "glosses": [
                            "Melissa officinalis L., roślina lecznicza o owłosionej łodydze i jajowatych liściach, kwitnąca na niebiesko lub różowo, mająca cytrynowym zapach, stosowana także jako przyprawa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15742e88-864e-4859-9633-b99ce8f90b6b",
                                "sense_id": "7f48a99e-3436-3e69-b2b8-52178f2f22e1",
                                "text": "Zasadziłam trochę melisy, będzie jak znalazł na choroby."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "220388af-1bc1-3a0a-af57-596db0189f91",
