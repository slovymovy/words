    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "933e0d51-6e3e-3042-bb55-1aadbe41f3e9",
                    "sense_definition": "Careful and economical with money or resources, avoiding waste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has always been <w>frugal</w> with his earnings, saving most of his salary for retirement.",
                            "target_lang_translations": {
                                "ru": "Он всегда был <w>бережлив</w> в отношении своих заработков, откладывая большую часть зарплаты на пенсию."
                            }
                        },
                        {
                            "text": "Being a <w>frugal</w> shopper, she always compares prices and uses coupons to save money.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>экономным</w> покупателем, она всегда сравнивает цены и использует купоны, чтобы сберечь деньги."
                            }
                        }
                    ],
                    "synonyms": [
                        "economical",
                        "thrifty",
                        "sparing",
                        "prudent"
                    ],
                    "antonyms": [
                        "extravagant",
                        "prodigal",
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "frugal shopper",
                        "frugal lifestyle",
                        "frugal habits"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бережливый и экономный в отношении денег или ресурсов, избегающий расточительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бережливый",
                                "target_lang_sense_clarification": "о человеке или образе жизни"
                            },
                            {
                                "target_lang_word": "экономный",
                                "target_lang_sense_clarification": "рационально использующий ресурсы"
                            },
                            {
                                "target_lang_word": "скромный",
                                "target_lang_sense_clarification": "в плане привычек и трат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe8dbcfc-5afb-3099-bd8e-bf6e39a26264",
                    "sense_definition": "Simple, plain, and costing very little, especially regarding food or a meal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of hiking, they sat down to a <w>frugal</w> meal of bread and cheese.",
                            "target_lang_translations": {
                                "ru": "После долгого дня похода они сели за <w>скромную</w> трапезу из хлеба и сыра."
                            }
                        },
                        {
                            "text": "The monk lived in a small room and ate a <w>frugal</w> breakfast every morning.",
                            "target_lang_translations": {
                                "ru": "Монах жил в маленькой комнате и каждое утро съедал <w>скудный</w> завтрак."
                            }
                        }
                    ],
                    "synonyms": [
                        "abstemious",
                        "sparing"
                    ],
                    "antonyms": [
                        "lavish"
                    ],
                    "common_phrases": [
                        "frugal meal",
                        "frugal breakfast",
                        "frugal fare"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простой, скромный и недорогой, особенно в отношении еды или трапезы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромный",
                                "target_lang_sense_clarification": "о еде или обстановке"
                            },
                            {
                                "target_lang_word": "скудный",
                                "target_lang_sense_clarification": "очень простой и ограниченный в количестве"
                            },
                            {
                                "target_lang_word": "простой",
                                "target_lang_sense_clarification": "без излишеств"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}