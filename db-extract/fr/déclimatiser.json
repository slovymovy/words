                ],
                "senses": [
                    {
                        "sense_id": "d4da86c3-7205-38c9-aa35-0bdb37c6ca58",
                        "entry_id": "03f3eab2-b733-31cf-ab3f-c45df659716e",
                        "glosses": [
                            "Faire quitter son climat pour un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10039c3-0bd8-42d2-8309-b31db421d28c",
                                "sense_id": "d4da86c3-7205-38c9-aa35-0bdb37c6ca58",
                                "text": "Plusieurs de ces soldats assuraient que la Vendée n’était pas encore détruite ; que Charrette avait encore plus de vingt mille hommes à sa suite ; que, pour parvenir à purger ce pays, il n’y avait pas d’autre moyen que de déclimatiser tous les habitants de Vendée, et d’y envoyer en place de nouvelles colonies, car autrement nous n’en viendrions jamais à bout."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3083ec2-f79e-3cd6-8113-b0172a0ba08a",
                        "entry_id": "03f3eab2-b733-31cf-ab3f-c45df659716e",
                        "glosses": [
                            "Dépayser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c87002f-1d27-44e5-90cb-e3ece265dead",
                                "sense_id": "b3083ec2-f79e-3cd6-8113-b0172a0ba08a",
                                "text": "Un coup encore, Anton, vous ne serez pas scandalisé, déclimatisé, dans nos avenues occidentales illuminées des prétentions et des mensonges commerciaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ff0739c-272c-3f5a-baa6-c42b306cf543",
                        "entry_id": "03f3eab2-b733-31cf-ab3f-c45df659716e",
                        "glosses": [
                            "Ne plus climatiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a43b8e0-6c75-4d10-8992-4ab238f469ee",
                                "sense_id": "5ff0739c-272c-3f5a-baa6-c42b306cf543",
                                "text": "Alors l’attente a commencé. Dans la moiteur d’un wagon déclimatisé."
                            }
                        ]
                    }
                ],
